Процедура ОткрытьФормуНастройкиПодписания(Организация, Пользователь) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("Пользователь", Пользователь);
	
	МодульМаркировкиКлиент().ОткрытьФормуНастройкиПодписания(ПараметрыФормы);
	
КонецПроцедуры

