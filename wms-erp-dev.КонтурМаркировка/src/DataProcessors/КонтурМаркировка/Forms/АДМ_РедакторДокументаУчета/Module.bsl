&НаСервере
Процедура Документ1СПриИзмененииНаСервере()
	
	ОписаниеДокумента1С = МодульОбъекта().ОписаниеДокумента1СВМаркировке(Документ1С);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеДокумента1С);
	
КонецПроцедуры

&НаСервере
Функция ОписаниеДокументаУчета() Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат МодульОбъекта().Новый_ДокументУчета();
	КонецЕсли;
	
	ОписаниеДокумента = МодульОбъекта().ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	ОписаниеДокументаУчета_ДобавитьИнформациюКоличествоКодов(ОписаниеДокумента);
	
	Возврат ОписаниеДокумента;
	
КонецФункции

&НаСервере
Функция ОписаниеКодовДокументаУчета(ПараметрыГруппировки = Неопределено)

	Результат = МодульОбъекта().ТаблицаКодовДокумента(ДокументУчета);
	ТаблицаКодов_ЗаполнитьКоличествоВложенныхКодов(Результат);
	
	Если ЗначениеЗаполнено(ПараметрыГруппировки) Тогда
		
		ПоляГруппировки = Новый Массив;
		
		Для Каждого ПолеГруппировки Из ПараметрыГруппировки Цикл
			
			Если ПолеГруппировки.Пометка Тогда
				ПоляГруппировки.Добавить(ПолеГруппировки.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		ПоляГруппировки = Перечисление_ПоляГруппировкиКодов();
	КонецЕсли;
	
	Результат.Свернуть(МодульОбъекта().СоединитьСтроку(ПоляГруппировки, ","), 
	МодульОбъекта().СоединитьСтроку(Перечисление_ИменаКолонокСчетчиков(), ","));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СброситьДатуПечатиКодовНаСервере(ПараметрыОтбора = Неопределено)

	Если НЕ ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = МодульОбъекта().ТаблицаКодовДокумента(ДокументУчета);
	
	Если ЗначениеЗаполнено(ПараметрыОтбора) Тогда
		ПараметрыОтбора_ВосстановитьТипы(ПараметрыОтбора);
		ТаблицаКодовДокумента = ТаблицаКодов.Скопировать(ПараметрыОтбора);
	КонецЕсли;
	
	КодыМаркировки = ТаблицаКодов.ВыгрузитьКолонку("КодМаркировки");
	
	Если ЗначениеЗаполнено(КодыМаркировки) Тогда
		МодульОбъекта().ОчиститьИнформациюОКодах(КодыМаркировки, "ДатаПечати");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьКодыДокументаВХранилище(ПараметрыОтбора = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат ПоместитьВоВременноеХранилище(МодульОбъекта().ТаблицаНовыхКодов(), ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
	ТаблицаКодов = МодульОбъекта().ТаблицаКодовДокумента(ДокументУчета);
	Если ЗначениеЗаполнено(ПараметрыОтбора) Тогда
		ПараметрыОтбора_ВосстановитьТипы(ПараметрыОтбора);
		ТаблицаКодов = ТаблицаКодов.Скопировать(ПараметрыОтбора);
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаКодов, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура РасформироватьАгрегатыВДокументеУчета(ПараметрыОтбора = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = МодульОбъекта().ТаблицаКодовДокумента(ДокументУчета);
	
	Если ЗначениеЗаполнено(ПараметрыОтбора) Тогда
		ПараметрыОтбора_ВосстановитьТипы(ПараметрыОтбора);
		ТаблицаКодов = ТаблицаКодов.Скопировать(ПараметрыОтбора);
	КонецЕсли;
	
	Для Каждого Стр Из ТаблицаКодов Цикл
		
		Если Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
			Продолжить;
		КонецЕсли;
		
		МодульОбъекта().КодыМаркировки_РасформироватьАгрегат(Стр.КлючКода);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОписаниеДокумента1СВМаркировке(Документ1С)
	
	Результат = НовоеОписаниеДокумента1С();
	
	Если ЗначениеЗаполнено(Документ1С) Тогда
		
		Результат.Документ1С 		= Документ1С;
		Результат.ТипДокумента 		= Документ1С.Метаданные().Имя;
		Результат.ВерсияДанных1С 	= ЗначениеРеквизитаОбъектаЛок(Документ1С, "ВерсияДанных");
		
		Результат.КлючДокумента1С 		= МодульОбъекта().КлючОбъекта1С(Документ1С);
		Результат.ТипКлючаДокумента1С 	= МодульОбъекта().ТипКлючаОбъекта1С(Документ1С);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НовоеОписаниеДокумента1С()
	
	Результат = Новый Структура;
	Результат.Вставить("Документ1С");
	Результат.Вставить("ВерсияДанных1С");
	Результат.Вставить("ТипДокумента");
	Результат.Вставить("КлючДокумента1С");
	Результат.Вставить("ТипКлючаДокумента1С");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПереформироватьТранспортныеАгрегаты(ДокументУчета, ПараметрыОтбора, ИспользоватьВложенныеКоды)
	
	ИспользоватьSSCC18 = МодульОбъекта().НастройкиМодуля().ИспользоватьSSCC18;
	
	ТаблицаКодов = МодульОбъекта().КодыДокументов_Прочитать(ДокументУчета);
	МодульОбъекта().ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Если ЗначениеЗаполнено(ПараметрыОтбора) Тогда
		ПараметрыОтбора_ВосстановитьТипы(ПараметрыОтбора);
		ТаблицаКодов = ТаблицаКодов.Скопировать(ПараметрыОтбора);
	КонецЕсли;
	
	Если ИспользоватьВложенныеКоды Тогда
		МодульОбъекта().ДобавитьВсеВложенныеКодыВТаблицуКодов(ТаблицаКодов);
		МодульОбъекта().ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	КонецЕсли;
	
	ДлинаКода18 = 18;
	ЛидирующиеНули = "00";
	ДлинаКодаПереформирования = 18;
	Если ИспользоватьSSCC18 Тогда
		ДлинаКодаПереформирования = 20;
	КонецЕсли;
	
	СтрокиДляЗаписи = Новый Массив;
	ОтборТранспортныхКодов = Новый Структура("ТипШтрихкода", Перечисления.КонтурМаркировка_ТипыШтрихкодов.SSCC);
	
	Для Каждого Стр Из ТаблицаКодов.НайтиСтроки(ОтборТранспортныхКодов) Цикл
		
		Если СтрДлина(Стр.КодМаркировки) = ДлинаКодаПереформирования Тогда
			
			Если ИспользоватьSSCC18 Тогда
				НовыйКодАгрегата = Прав(Стр.КодМаркировки, ДлинаКода18);
			Иначе
				НовыйКодАгрегата = ЛидирующиеНули + Стр.КодМаркировки;
			КонецЕсли;
			
			Стр.КодМаркировки = НовыйКодАгрегата;
			Стр.ПолныйКод = НовыйКодАгрегата;
			
			СтрокиДляЗаписи.Добавить(Стр);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(СтрокиДляЗаписи) Тогда
		ТекстСообщения = НСтр("ru='Не найдены подходящие коды для переформирования.'");
		МодульОбъекта().СообщитьПользователюЛок(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	НоваяТаблицаКодов = ТаблицаКодов.Скопировать(СтрокиДляЗаписи);
	НоваяТаблицаКодов.ЗаполнитьЗначения("", "ХешСуммаКодаМаркировки");
	МодульОбъекта().ТаблицаКодов_ЗаписатьВсюИнформацию(НоваяТаблицаКодов);
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьЭтапыМаркировкиНаСервере()
	
	ЭтапыМаркировки.Очистить();
	
	Если Не ЗначениеЗаполнено(МаршрутМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеМаршрута = МодульОбъекта().МаршрутМаркировки_Прочитать(МаршрутМаркировки);
	Для Каждого Стр Из ОписаниеМаршрута.ЭтапыМаркировки Цикл
		ЗаполнитьЗначенияСвойств(ЭтапыМаркировки.Добавить(), Стр);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОписаниеДокументаУчета_ДобавитьИнформациюКоличествоКодов(ОписаниеДокумента)
	
	ОписаниеДокумента.ТоварыДокумента.Колонки.Добавить("КоличествоКодов");
	
	КоличествоКодовДокумента = МодульОбъекта().КодыДокументов_КоличествоКодовПоСтрокам(ОписаниеДокумента.Ссылка);
	
	Для Каждого Стр Из ОписаниеДокумента.ТоварыДокумента Цикл
		
		СтрКоличество = КоличествоКодовДокумента.Найти(Стр.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		
		Если ЗначениеЗаполнено(СтрКоличество) Тогда
			Стр.КоличествоКодов = СтрКоличество.Количество;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаКодов_ЗаполнитьКоличествоВложенныхКодов(ТаблицаКодов)
	
	ТаблицаКодов_ДобавитьКолонкиСчетчиков(ТаблицаКодов);
	
	ТаблицаВложенныхКодов = ТаблицаКодов.Скопировать();
	МодульОбъекта().ДобавитьВсеВложенныеКодыВТаблицуКодов(ТаблицаВложенныхКодов);
	
	Индексы = ТаблицаВложенныхКодов.Индексы.Добавить("КлючАгрегата");
	
	Для Каждого Стр Из ТаблицаКодов Цикл
		
		Если Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаКодов_ЗаполнитьВложенныеКодыАгрегата(Стр, Стр.КлючКода, ТаблицаВложенныхКодов);
		
	КонецЦикла;
	
	ТаблицаВложенныхКодов.Индексы.Удалить(Индексы);
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаКодов_ЗаполнитьВложенныеКодыАгрегата(ВерхнеУровневыйАгрегат, КлючТекущегоАгрегата, ТаблицаКодов)

	ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата", КлючТекущегоАгрегата));
	
	Для Каждого Стр Из ВложенныеКоды Цикл

		Если Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
			ВерхнеУровневыйАгрегат.КоличествоВложенныхКИЗ = ВерхнеУровневыйАгрегат.КоличествоВложенныхКИЗ + 1;
		ИначеЕсли Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ГрупповаяУпаковка Тогда
			ВерхнеУровневыйАгрегат.КоличествоВложенныхКИГУ = ВерхнеУровневыйАгрегат.КоличествоВложенныхКИГУ + 1;
			ТаблицаКодов_ЗаполнитьВложенныеКодыАгрегата(ВерхнеУровневыйАгрегат, Стр.КлючКода, ТаблицаКодов);
		ИначеЕсли Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
			ВерхнеУровневыйАгрегат.КоличествоВложенныхКИТУ = ВерхнеУровневыйАгрегат.КоличествоВложенныхКИТУ + 1;
			ТаблицаКодов_ЗаполнитьВложенныеКодыАгрегата(ВерхнеУровневыйАгрегат, Стр.КлючКода, ТаблицаКодов);
		ИначеЕсли Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор Тогда
			ВерхнеУровневыйАгрегат.КоличествоВложенныхНаборов = ВерхнеУровневыйАгрегат.КоличествоВложенныхНаборов + 1;
			ТаблицаКодов_ЗаполнитьВложенныеКодыАгрегата(ВерхнеУровневыйАгрегат, Стр.КлючКода, ТаблицаКодов);
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаКодов_ДобавитьКолонкиСчетчиков(ТаблицаКодов)
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	Для Каждого ИмяКолонки Из Перечисление_ИменаКолонокСчетчиков() Цикл
		ТаблицаКодов.Колонки.Добавить(ИмяКолонки, ТипЧисло);
	КонецЦикла;
	
	ТаблицаКодов.ЗаполнитьЗначения(0, "КоличествоВложенныхКИТУ, КоличествоВложенныхКИГУ, КоличествоВложенныхКИЗ, КоличествоВложенныхНаборов");
	ТаблицаКодов.ЗаполнитьЗначения(1, "КоличествоКодов");
	
КонецПроцедуры

&НаСервере
Процедура ПараметрыОтбора_ВосстановитьТипы(ПараметрыОтбора)
	
	Если ПараметрыОтбора.Свойство("КлючСтрокиДокумента") 
		И ЗначениеЗаполнено(ПараметрыОтбора.КлючСтрокиДокумента)
		И ТипЗнч(ПараметрыОтбора.КлючСтрокиДокумента) <> Тип("УникальныйИдентификатор") Тогда
		
		ПараметрыОтбора.КлючСтрокиДокумента = Новый УникальныйИдентификатор(ПараметрыОтбора.КлючСтрокиДокумента);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДинамическиеСпискиСвязанныхРегистров()
	
	УстановитьОтборыДинамическихСписков();
	
	Для Каждого КлючЗначение Из Перечисление_СвязанныеРегистрыСведений() Цикл
		Элементы[КлючЗначение.Значение].Обновить();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборыДинамическихСписков()
	
	ВидСравненияРавно = ВидСравненияКомпоновкиДанных.Равно;
	СвязанныеРегистры = Перечисление_СвязанныеРегистрыСведений();
	
	ИмяДинамическогоСписка = СвязанныеРегистры.КоличествоКодовДокументов;
	МодульОбъекта().Форма_УстановитьОтборДинамическогоСписка(ЭтаФорма, ИмяДинамическогоСписка, "ДокументУчета", ВидСравненияРавно, ДокументУчета);
	
	ИмяДинамическогоСписка = СвязанныеРегистры.ДанныеФайлов;
	МодульОбъекта().Форма_УстановитьОтборДинамическогоСписка(ЭтаФорма, ИмяДинамическогоСписка
	, "Файл.ВладелецФайла"
	, ВидСравненияРавно
	, ДокументУчета);
	
	ИмяДинамическогоСписка = СвязанныеРегистры.СтатусыДокументовУчета;
	МодульОбъекта().Форма_УстановитьОтборДинамическогоСписка(ЭтаФорма, ИмяДинамическогоСписка
	, "ДокументУчета"
	, ВидСравненияРавно
	, ДокументУчета);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДанныеФайлаВХранилище(Файл)
	
	ОписаниеФайла = МодульОбъекта().Файл_Прочитать(Файл);
	
	Если ТипЗнч(ОписаниеФайла.ДанныеФайла) = Тип("Структура") И ОписаниеФайла.ДанныеФайла.Свойство("ТаблицаКодов") Тогда
		ДанныеФайла = ОписаниеФайла.ДанныеФайла.ТаблицаКодов;
	ИначеЕсли ТипЗнч(ОписаниеФайла.ДанныеФайла) = Тип("ТаблицаЗначений") Тогда
		ДанныеФайла = ОписаниеФайла.ДанныеФайла;
	Иначе
		ТекстОшибки = НСтр("ru='Неизвестный тип файла для просмотра таблицы значений'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Результат = ПоместитьВоВременноеХранилище(ДанныеФайла, ЭтаФорма.УникальныйИдентификатор);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СтатусыДокумента_СоздатьГруппуСтатусов(ИмяПоляТипСтатуса)
	
	// BSLLS:MagicNumber-off
	ОписаниеТипаСтрока_250 = МодульОбъекта().ОписаниеТипа_Строка(250);
	ОписаниеТипаСтрока_50 = МодульОбъекта().ОписаниеТипа_Строка(50);
	// BSLLS:MagicNumber-on
	ОписаниеТипаДата = МодульОбъекта().ОписаниеТипа_Дата();
	
	ИмяПоляДопИнформация = МодульОбъекта().ИмяПоляДопИнформация(ИмяПоляТипСтатуса);
	ИмяПоляДатаСтатуса = МодульОбъекта().ИмяПоляДатаСтатуса(ИмяПоляТипСтатуса);
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяПоляДатаСтатуса, ОписаниеТипаДата,, ИмяПоляДатаСтатуса));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяПоляТипСтатуса, ОписаниеТипаСтрока_50,, ИмяПоляТипСтатуса, Истина));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяПоляДопИнформация, ОписаниеТипаСтрока_250,, ИмяПоляДопИнформация, Истина));
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ПрефиксГруппыТипСтатуса = "ТипСтатуса_";
	
	ОбщаяГруппа = Элементы.Добавить(ПрефиксГруппыТипСтатуса + ИмяПоляТипСтатуса, Тип("ГруппаФормы"), Элементы.СтраницаСтатусыДокумента);
	ОбщаяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ОбщаяГруппа.Заголовок = ИмяПоляТипСтатуса;
	ОбщаяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ЭлементСтатус = Элементы.Добавить(ИмяПоляТипСтатуса, Тип("ПолеФормы"), ОбщаяГруппа);
	ЭлементСтатус.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСтатус.Заголовок = НСтр("ru='Статус'");
	ЭлементСтатус.РежимВыбораИзСписка = Истина;
	ЭлементСтатус.ПутьКДанным = ИмяПоляТипСтатуса;
	
	ЭлементДата = Элементы.Добавить(ИмяПоляДатаСтатуса, Тип("ПолеФормы"), ОбщаяГруппа);
	ЭлементДата.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементДата.Заголовок = НСтр("ru='Дата статуса'");
	ЭлементДата.ТолькоПросмотр = Истина;
	ЭлементДата.ПутьКДанным = ИмяПоляДатаСтатуса;
	
	ЭлементДопИнформация = Элементы.Добавить(ИмяПоляДопИнформация, Тип("ПолеФормы"), ОбщаяГруппа);
	ЭлементДопИнформация.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементДопИнформация.Заголовок = НСтр("ru='Доп.информация'");
	ЭлементДопИнформация.РежимВыбораИзСписка = Истина;
	ЭлементДопИнформация.ПутьКДанным = ИмяПоляДопИнформация;
	
	ЭлементСтатус.УстановитьДействие("ПриИзменении", "ДанныеСтатусаПриИзменении");
	ЭлементДопИнформация.УстановитьДействие("ПриИзменении", "ДанныеСтатусаПриИзменении");
	
КонецПроцедуры

Функция Новый_СтатусыДокумента()
	
	Результат = Новый Структура;
	
	Для Каждого КлючЗначение Из МодульОбъекта().Перечисление_ТипыСтатусов() Цикл
		
		Результат.Вставить(КлючЗначение.Ключ);
		Результат.Вставить(МодульОбъекта().ИмяПоляДатаСтатуса(КлючЗначение.Ключ));
		Результат.Вставить(МодульОбъекта().ИмяПоляДопИнформация(КлючЗначение.Ключ));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

