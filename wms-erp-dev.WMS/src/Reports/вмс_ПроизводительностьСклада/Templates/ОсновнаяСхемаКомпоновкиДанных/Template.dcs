	<totalField>
		<dataPath>KPI</dataPath>
		<expression>ВЫБОР
	КОГДА Сумма(ВЫЧИСЛИТЬВЫРАЖЕНИЕСГРУППИРОВКОЙМАССИВ("МАКСИМУМ(ВремяВМинутах)", "Операция"))=0 ТОГДА
		0
	ИНАЧЕ
