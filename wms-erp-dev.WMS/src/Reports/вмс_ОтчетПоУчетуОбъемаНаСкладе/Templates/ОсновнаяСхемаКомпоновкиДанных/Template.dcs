				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Свободный объем, %</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Шрифт</dcscor:parameter>
					<dcscor:value xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xsi:type="v8ui:Font" ref="style:TextFont" bold="true" italic="false" underline="false" strikeout="false" kind="StyleItem" scale="100"/>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ЧЦ=15; ЧДЦ=3</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	вмс_МестаХранения.Владелец КАК Склад,
	вмс_МестаХранения.Ссылка КАК Ячейка,
	вмс_ОперацияПоЯчейкамОстатки.Контейнер КАК Контейнер,
	вмс_ОперацияПоЯчейкамОстатки.Товар КАК Товар,
	вмс_ОперацияПоЯчейкамОстатки.Характеристика КАК Характеристика,
	&amp;ТекстЗанятыйОбъем КАК ЗанятыйОбъем,
	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК Количество,
	ВЫБОР
		КОГДА вмс_ОперацияПоЯчейкамОстатки.Ячейка.ЯчейкаБезразмерная
			ТОГДА 1000000
		ИНАЧЕ вмс_ОперацияПоЯчейкамОстатки.Ячейка.Объем
	КОНЕЦ КАК ОбъемЯчейка
ПОМЕСТИТЬ ОстаткиСОбъемом
ИЗ
	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(, ) КАК вмс_ОперацияПоЯчейкамОстатки
		ПО вмс_МестаХранения.Ссылка = вмс_ОперацияПоЯчейкамОстатки.Ячейка
ГДЕ
	ИСТИНА
	И вмс_МестаХранения.ЭтоГруппа = ЛОЖЬ
	И вмс_МестаХранения.ПометкаУдаления = ЛОЖЬ
	И вмс_МестаХранения.ТипЯчейки &lt;&gt; ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.Оператор)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОстаткиСОбъемом.Ячейка КАК Ячейка,
	СУММА(ЕСТЬNULL(ОстаткиСОбъемом.ЗанятыйОбъем, 0)) КАК ЗанятыйОбъем
ПОМЕСТИТЬ ЗанятыйОбъемЯчейки
ИЗ
	ОстаткиСОбъемом КАК ОстаткиСОбъемом

СГРУППИРОВАТЬ ПО
	ОстаткиСОбъемом.Ячейка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗанятыйОбъемЯчейки.Ячейка КАК Ячейка,
	ВЫБОР
		КОГДА ЗанятыйОбъемЯчейки.Ячейка.ЯчейкаБезразмерная
			ТОГДА 1000000
		ИНАЧЕ ЗанятыйОбъемЯчейки.Ячейка.Объем
	КОНЕЦ - ЕСТЬNULL(ЗанятыйОбъемЯчейки.ЗанятыйОбъем, 0) КАК СвободныйОбъем,
	ВЫБОР 
		КОГДА ЗанятыйОбъемЯчейки.Ячейка.Объем &lt;= 0 И ЗанятыйОбъемЯчейки.Ячейка.ЯчейкаБезразмерная = ЛОЖЬ 
			ТОГДА 0
	ИНАЧЕ
	(1 - ЕСТЬNULL(ЗанятыйОбъемЯчейки.ЗанятыйОбъем, 0) / 
		ВЫБОР
			КОГДА ЗанятыйОбъемЯчейки.Ячейка.ЯчейкаБезразмерная
				ТОГДА 1000000
			ИНАЧЕ ЗанятыйОбъемЯчейки.Ячейка.Объем
		КОНЕЦ) * 100
	КОНЕЦ КАК Процент
ПОМЕСТИТЬ СвободныйОбъемЯчейки
ИЗ
	ЗанятыйОбъемЯчейки КАК ЗанятыйОбъемЯчейки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОстаткиСОбъемом.Склад КАК Склад,
	ОстаткиСОбъемом.Ячейка КАК Ячейка,
	ОстаткиСОбъемом.Контейнер КАК Контейнер,
	ОстаткиСОбъемом.Товар КАК Товар,
	ОстаткиСОбъемом.Характеристика КАК Характеристика,
	ОстаткиСОбъемом.ЗанятыйОбъем КАК ЗанятыйОбъем,
	ОстаткиСОбъемом.Количество КАК Количество,
	ОстаткиСОбъемом.ОбъемЯчейка КАК ОбъемЯчейка,
	СвободныйОбъемЯчейки.СвободныйОбъем КАК СвободныйОбъем,
	СвободныйОбъемЯчейки.Процент КАК Процент
ИЗ
	ОстаткиСОбъемом КАК ОстаткиСОбъемом
		ЛЕВОЕ СОЕДИНЕНИЕ СвободныйОбъемЯчейки КАК СвободныйОбъемЯчейки
		ПО ОстаткиСОбъемом.Ячейка = СвободныйОбъемЯчейки.Ячейка</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
		<group>Ячейка</group>
	</totalField>
	<totalField>
		<dataPath>ЗанятыйОбъем</dataPath>
		<expression>Сумма(ЗанятыйОбъем)</expression>
		<group>Ячейка</group>
	</totalField>
	<totalField>
		<dataPath>СвободныйОбъем</dataPath>
		<expression>Максимум(СвободныйОбъем)</expression>
		<group>Ячейка</group>
	</totalField>
	<totalField>
		<dataPath>Процент</dataPath>
		<expression>Максимум(Процент)</expression>
		<group>Ячейка</group>
	</totalField>
	<parameter>
