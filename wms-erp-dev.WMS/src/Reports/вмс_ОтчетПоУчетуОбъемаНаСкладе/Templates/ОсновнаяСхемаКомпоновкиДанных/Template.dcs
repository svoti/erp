			<dataPath>СвободныйОбъем</dataPath>
			<field>СвободныйОбъем</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Свободный объем, м3</v8:content>
				</v8:item>
