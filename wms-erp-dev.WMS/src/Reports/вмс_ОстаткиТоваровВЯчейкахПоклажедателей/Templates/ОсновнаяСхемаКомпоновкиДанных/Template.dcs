			<dataPath>Упаковка</dataPath>
			<field>Упаковка</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	вмс_ОперацияПоЯчейкамОстатки.Товар КАК Товар,
	вмс_ОперацияПоЯчейкамОстатки.Характеристика КАК Характеристика,
	вмс_ОперацияПоЯчейкамОстатки.Серия КАК Серия,
	вмс_ОперацияПоЯчейкамОстатки.Партия КАК Партия,
	вмс_ОперацияПоЯчейкамОстатки.Качество КАК Качество,
	вмс_ОперацияПоЯчейкамОстатки.Ячейка.Владелец КАК Склад,
	вмс_ОперацияПоЯчейкамОстатки.Ячейка КАК Ячейка,
	вмс_ОперацияПоЯчейкамОстатки.Контейнер КАК Контейнер,
	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК КоличествоОстаток,
	вмс_ТоварыПоклажедателей.Контрагент КАК Контрагент,
	вмс_ТоварыПоклажедателей.Товар КАК Товар1,
	вмс_ТоварыПоклажедателей.Организация КАК Организация
ИЗ
	РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки КАК вмс_ОперацияПоЯчейкамОстатки
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.вмс_ТоварыПоклажедателей КАК вмс_ТоварыПоклажедателей
		ПО вмс_ОперацияПоЯчейкамОстатки.Товар = вмс_ТоварыПоклажедателей.Товар</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоОстаток</dataPath>
		<expression>Сумма(КоличествоОстаток)</expression>
	</totalField>
	<parameter>
		<name>Период</name>
