<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ячейка</dataPath>
			<field>Ячейка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Товар</dataPath>
			<field>Товар</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УчетныйПараметр2</dataPath>
			<field>УчетныйПараметр2</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Характеристика</dataPath>
			<field>Характеристика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УчетныйПараметр1</dataPath>
			<field>УчетныйПараметр1</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Качество</dataPath>
			<field>Качество</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоПлан</dataPath>
			<field>КоличествоПлан</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество учет</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Артикул</dataPath>
			<field>Артикул</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоФакт</dataPath>
			<field>КоличествоФакт</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Исполнитель</dataPath>
			<field>Исполнитель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контейнер</dataPath>
			<field>Контейнер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Партия</dataPath>
			<field>Партия</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	вмс_ВыборочнаяИнвентаризацияТовары.Ячейка КАК Ячейка,
	вмс_ВыборочнаяИнвентаризацияТовары.Контейнер КАК Контейнер,
	вмс_ВыборочнаяИнвентаризацияТовары.Товар КАК Товар,
	вмс_ВыборочнаяИнвентаризацияТовары.Характеристика КАК Характеристика,
	вмс_ВыборочнаяИнвентаризацияТовары.Партия КАК Партия,
	вмс_ВыборочнаяИнвентаризацияТовары.Серия КАК Серия,
	вмс_ВыборочнаяИнвентаризацияТовары.Качество КАК Качество,
	вмс_ВыборочнаяИнвентаризацияТовары.УчетныйПараметр1 КАК УчетныйПараметр1,
	вмс_ВыборочнаяИнвентаризацияТовары.УчетныйПараметр2 КАК УчетныйПараметр2,
	СУММА(вмс_ВыборочнаяИнвентаризацияТовары.КоличествоПлан) КАК КоличествоПлан,
	СУММА(вмс_ВыборочнаяИнвентаризацияТовары.КоличествоФакт) КАК КоличествоФакт,
	вмс_ВыборочнаяИнвентаризацияТовары.Артикул КАК Артикул,
	вмс_ВыборочнаяИнвентаризацияТовары.Исполнитель КАК Исполнитель
ИЗ
	Документ.вмс_ВыборочнаяИнвентаризация.Товары КАК вмс_ВыборочнаяИнвентаризацияТовары
ГДЕ
	вмс_ВыборочнаяИнвентаризацияТовары.Ссылка = &amp;Распоряжение
	И вмс_ВыборочнаяИнвентаризацияТовары.Товар &lt;&gt; ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	И вмс_ВыборочнаяИнвентаризацияТовары.Товар &lt;&gt; НЕОПРЕДЕЛЕНО

СГРУППИРОВАТЬ ПО
	вмс_ВыборочнаяИнвентаризацияТовары.Ячейка,
	вмс_ВыборочнаяИнвентаризацияТовары.Контейнер,
	вмс_ВыборочнаяИнвентаризацияТовары.Товар,
	вмс_ВыборочнаяИнвентаризацияТовары.Характеристика,
	вмс_ВыборочнаяИнвентаризацияТовары.Партия,
	вмс_ВыборочнаяИнвентаризацияТовары.Серия,
	вмс_ВыборочнаяИнвентаризацияТовары.Качество,
	вмс_ВыборочнаяИнвентаризацияТовары.УчетныйПараметр1,
	вмс_ВыборочнаяИнвентаризацияТовары.УчетныйПараметр2,
	вмс_ВыборочнаяИнвентаризацияТовары.Артикул,
	вмс_ВыборочнаяИнвентаризацияТовары.Исполнитель</query>
	</dataSet>
	<calculatedField>
		<dataPath>Расхождение</dataPath>
		<expression>КоличествоФакт - КоличествоПлан</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Расхождение</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>КоличествоФакт</dataPath>
		<expression>Сумма(КоличествоФакт)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоПлан</dataPath>
		<expression>Сумма(КоличествоПлан)</expression>
	</totalField>
	<totalField>
		<dataPath>Расхождение</dataPath>
		<expression>Сумма(Расхождение)</expression>
	</totalField>
