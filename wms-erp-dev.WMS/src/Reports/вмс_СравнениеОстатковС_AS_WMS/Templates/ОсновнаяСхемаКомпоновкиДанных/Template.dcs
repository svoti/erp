		<query>// Текст запроса адаптируется под конфигурацию в модуле объекта при компоновке результата
// Текст для отладки доступен в модуле

ВЫБРАТЬ
	&amp;ПолеНоменклатура КАК Товар,
	&amp;ПолеХарактеристика КАК Характеристика,
	&amp;ПолеСклад КАК Склад,
	&amp;ПолеНачальныйОстаток КАК НачальныйОстаток,
	&amp;ПолеПриход КАК Приход,
	&amp;ПолеРасход КАК Расход,
	&amp;ПолеКонечныйОстаток КАК КонечныйОстаток,
	0 КАК НачальныйОстатокАХ,
	0 КАК ПриходАХ,
	0 КАК РасходАХ,
	0 КАК КонечныйОстатокАХ,
	NULL КАК Ячейка
ПОМЕСТИТЬ ВТ
ИЗ
	РегистрНакопления.вмс_ОперацияПоЯчейкам.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , ) КАК ШаблоннаяТаблица

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	вмс_ОперацияПоЯчейкамОстаткиИОбороты.Товар,
	вмс_ОперацияПоЯчейкамОстаткиИОбороты.Характеристика,
	вмс_ОперацияПоЯчейкамОстаткиИОбороты.Ячейка.Владелец,
	0,
	0,
	0,
	0,
	вмс_ОперацияПоЯчейкамОстаткиИОбороты.КоличествоНачальныйОстаток,
	вмс_ОперацияПоЯчейкамОстаткиИОбороты.КоличествоПриход,
	вмс_ОперацияПоЯчейкамОстаткиИОбороты.КоличествоРасход,
	вмс_ОперацияПоЯчейкамОстаткиИОбороты.КоличествоКонечныйОстаток,
	вмс_ОперацияПоЯчейкамОстаткиИОбороты.Ячейка
ИЗ
	РегистрНакопления.вмс_ОперацияПоЯчейкам.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , ) КАК вмс_ОперацияПоЯчейкамОстаткиИОбороты
{ГДЕ
	вмс_ОперацияПоЯчейкамОстаткиИОбороты.КоличествоНачальныйОстаток}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.Товар КАК Товар,
	ВТ.Характеристика КАК Характеристика,
	ВТ.Склад КАК Склад,
	СУММА(ВТ.НачальныйОстаток) КАК НачальныйОстаток,
	СУММА(ВТ.Приход) КАК Приход,
	СУММА(ВТ.Расход) КАК Расход,
	СУММА(ВТ.НачальныйОстатокАХ) КАК НачальныйОстатокАХ,
	СУММА(ВТ.ПриходАХ) КАК ПриходАХ,
	СУММА(ВТ.РасходАХ) КАК РасходАХ,
	СУММА(ВТ.КонечныйОстатокАХ) КАК КонечныйОстатокАХ,
	СУММА(ВТ.КонечныйОстаток) КАК КонечныйОстаток,
	ВТ.Ячейка КАК Ячейка
ИЗ
	ВТ КАК ВТ

СГРУППИРОВАТЬ ПО
	ВТ.Товар,
	ВТ.Характеристика,
	ВТ.Склад,
	ВТ.Ячейка</query>
