 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//УстановитьОтборДинамическогоСписка(Склады,"Ссылка." + вмс_АдаптацияКонфигураций.ПолучитьИмяПараметраТипСклада(),вмс_АдаптацияКонфигураций.ПолучитьТипСкладаОптовый()); 
	
	АдаптироватьЗапросДинамическогоСписка(Элементы.Склады);
	
	ГруппаОтбора = Склады.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;
	
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка." + вмс_АдаптацияКонфигураций.ПолучитьИмяПараметраТипСклада());
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = вмс_АдаптацияКонфигураций.ПолучитьТипСкладаОптовый();
	
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПустоеЗначение");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = Истина;
	// ТУ_Кошелев 14.09.23 ++
	УстановитьНастройкиВидимостиЭлементов();
	// ТУ_Кошелев 14.09.23 --
КонецПроцедуры 

