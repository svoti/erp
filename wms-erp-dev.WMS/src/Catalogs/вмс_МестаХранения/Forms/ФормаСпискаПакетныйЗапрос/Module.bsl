&НаКлиенте
Процедура ВыполнитьКомандуБлокировки(Действие)

	СписокЯчеек = ПолучитьСписокЯчеек();
	Ответ = ВедетсяРаботаСЯчейками(СписокЯчеек);  
	
	Отказ = Ответ.ВедетсяРаботаСЯчейками ИЛИ Ответ.ПроводитсяИнвентаризацияЯчеек;
			
	Если Отказ Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Ответ.ТекстСообщения);
		ОО = Новый ОписаниеОповещения("ОбработчикВыполнитьДействиеБлокировки", ЭтаФорма, Новый Структура("СписокЯчеек, Действие, Ответ", СписокЯчеек, Действие, Ответ));
		ПоказатьВопрос(ОО, "Одна или несколько ячеек недоступны для изменения вида блокировки. Продолжить выполнение для всех доступных ячеек?", РежимДиалогаВопрос.ДаНет,,,"Внимание"); 
	Иначе
		ЗавершитьВыполнитьДействиеБлокировки(Новый Структура("СписокЯчеек, Действие, Ответ", СписокЯчеек, Действие, Ответ));		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбработчикВыполнитьДействиеБлокировки(Результат, ПараметрыОбработчика) Экспорт 
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПараметрыОбработчика.СписокЯчеек = вмс_РаботаСКоллекциями.ВычитаниеМассивов(ПараметрыОбработчика.СписокЯчеек, ПараметрыОбработчика.Ответ.НедоступныеЯчейки);
		ЗавершитьВыполнитьДействиеБлокировки(ПараметрыОбработчика);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗавершитьВыполнитьДействиеБлокировки(ПараметрыОбработчика) 

	ВыполнитьРазблокировкуЯчеек(ПараметрыОбработчика.СписокЯчеек);
	Если ПараметрыОбработчика.Действие <> "Разблокировать" Тогда			
		ВыполнитьБлокировкуЯчеек(ПараметрыОбработчика.СписокЯчеек, ПараметрыОбработчика.Действие);
	КонецЕсли;
	ОбновитьОтображениеЯчеек();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокЯчеек()

	ОбрабатываемыеЯчейки = Новый Массив;
	КвазиМестаХранения = ПолучитьКвазиМестаХранения();
	
	Если ЗначениеЗаполнено(Элементы.Список.ВыделенныеСтроки) Тогда
		ОбрабатываемыйМассив = ЗаполнитьОбрабатываемыйМассив(Элементы.Список.ВыделенныеСтроки); 
		Для Каждого ЭлемСписка Из ОбрабатываемыйМассив Цикл
			Если ЭлемСписка.ЭтоГруппа Тогда
				ОбрабатываемыеЯчейки = ОбработатьГруппуЭлементов(ОбрабатываемыеЯчейки, КвазиМестаХранения, ЭлемСписка.Ссылка);	
			Иначе
				Если ОбрабатываемыеЯчейки.Найти(ЭлемСписка.Ссылка) = Неопределено Тогда
					ОбрабатываемыеЯчейки.Добавить(ЭлемСписка.Ссылка);	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите одно или несколько мест хранения.");
		Возврат Неопределено;	
	КонецЕсли; 
	
	Возврат ОбрабатываемыеЯчейки; 
	
КонецФункции

&НаСервере
Функция ЗаполнитьОбрабатываемыйМассив(ЗНАЧ ВыделенныеСтроки)

    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	вмс_МестаХранения.Ссылка КАК Ссылка,
	               |	вмс_МестаХранения.ЭтоГруппа КАК ЭтоГруппа
	               |ИЗ
	               |	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	               |ГДЕ
	               |	вмс_МестаХранения.Ссылка В(&ВыделенныеСтроки)";
	Запрос.УстановитьПараметр("ВыделенныеСтроки", ВыделенныеСтроки);
	Результат = вмс_РаботаСКоллекциями.ЗагрузитьКвазиТаблицуЗначенийИзТаблицыЗначений(Запрос.Выполнить().Выгрузить());	
	Возврат Результат.Строки;
	
КонецФункции

&НаКлиенте
Функция ОбработатьГруппуЭлементов(ОбрабатываемыеЯчейки, КвазиМестаХранения, Группа)
	
	ЭлементыГруппы = вмс_РаботаСКоллекциями.НайтиСтрокиКвазиТаблицыЗначений(КвазиМестаХранения, Новый Структура("Родитель", Группа));
	Для Каждого ЭлемГруппы Из ЭлементыГруппы Цикл
		Если ЭлемГруппы.ЭтоГруппа Тогда
			ОбрабатываемыеЯчейки = ОбработатьГруппуЭлементов(ОбрабатываемыеЯчейки, КвазиМестаХранения, ЭлемГруппы.Ссылка);	
		Иначе
			Если ОбрабатываемыеЯчейки.Найти(ЭлемГруппы.Ссылка) = Неопределено Тогда
				ОбрабатываемыеЯчейки.Добавить(ЭлемГруппы.Ссылка);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОбрабатываемыеЯчейки;
	
КонецФункции

