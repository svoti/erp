&НаСервере
Процедура УстановитьОтборДинамическогоСписка(ДинамическийСписок, ИмяПоля, Значение, Использование = Истина, Применение = Неопределено)
	
	ЭлементыОтбора = ДинамическийСписок.Отбор.Элементы;
	
	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	НайденныйЭлемент = Неопределено;
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если ЭлементОтбора.ЛевоеЗначение = Поле Тогда
			НайденныйЭлемент = ЭлементОтбора;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайденныйЭлемент = Неопределено Тогда
		ЭлементОтбора = ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Поле;
	КонецЕсли;
	
	ЭлементОтбора.Использование = Использование;
	ЭлементОтбора.ПравоеЗначение = Значение;
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		
КонецПроцедуры  

&НаСервере
Функция АдаптироватьЗапросДинамическогоСписка(Список)
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	""<Без отбора>"" КАК Ссылка,
		|	ИСТИНА КАК ПустоеЗначение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СправочникСклады.Ссылка,
		|	ЛОЖЬ
		|ИЗ
		|	&ИмяСправочникаСклады КАК СправочникСклады";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ИмяСправочникаСклады","Справочник." + вмс_АдаптацияКонфигураций.ПолучитьИмяСправочникаСклады());
	
	СвойстваСписка.ТекстЗапроса                 = ТекстЗапроса;
	
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Список, СвойстваСписка);
	

КонецФункции // АдаптироватьЗапросДинамическогоСписка()

&НаСервере
Функция ПолучитьМассивСкладов()  
	
	МассивСкладов = Новый Массив;
	ИмяСправочника = вмс_АдаптацияКонфигураций.ПолучитьИмяСправочникаСклады();
	Иерархический = Метаданные.Справочники[ИмяСправочника].Иерархический;
	
	Выборка = Справочники[ИмяСправочника].Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		Если Иерархический И Выборка.ЭтоГруппа Тогда
			Продолжить;	
		КонецЕсли;
		МассивСкладов.Добавить(Выборка.Ссылка);		
	КонецЦикла;
		
	Возврат МассивСкладов;
	
КонецФункции

