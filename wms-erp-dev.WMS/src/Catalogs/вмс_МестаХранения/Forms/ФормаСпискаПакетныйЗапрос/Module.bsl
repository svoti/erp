Функция ПолучитьКвазиМестаХранения() 

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	вмс_МестаХранения.Ссылка КАК Ссылка,
	                      |	вмс_МестаХранения.Родитель КАК Родитель,
	                      |	вмс_МестаХранения.ЭтоГруппа КАК ЭтоГруппа
	                      |ИЗ
	                      |	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	                      |ГДЕ
	                      |	вмс_МестаХранения.ПометкаУдаления = ЛОЖЬ");
	Возврат вмс_РаботаСКоллекциями.ЗагрузитьКвазиТаблицуЗначенийИзТаблицыЗначений(Запрос.Выполнить().Выгрузить());
	
