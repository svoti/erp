    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	КатегорииЯчеекХранения.Ссылка КАК Ссылка,
	КатегорииЯчеекХранения.Родитель КАК Родитель
ПОМЕСТИТЬ ВТ
ИЗ
	Справочник.КатегорииЯчеекХранения КАК КатегорииЯчеекХранения
ГДЕ
	КатегорииЯчеекХранения.ПометкаУдаления = ЛОЖЬ

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ЗНАЧЕНИЕ(Справочник.КатегорииЯчеекХранения.ПустаяСсылка),
	NULL
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.Ссылка КАК Категория,
	ВТ.Родитель КАК Родитель
ИЗ
	ВТ КАК ВТ
