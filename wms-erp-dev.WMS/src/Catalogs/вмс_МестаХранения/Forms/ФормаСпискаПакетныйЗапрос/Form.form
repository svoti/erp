  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	вмс_ЗаблокированныеЯчейки.Ячейка КАК Ячейка,
	вмс_ЗаблокированныеЯчейки.ВидБлокировки КАК ВидБлокировки
ПОМЕСТИТЬ Заблокированные
ИЗ
	РегистрСведений.вмс_ЗаблокированныеЯчейки КАК вмс_ЗаблокированныеЯчейки

СГРУППИРОВАТЬ ПО
	вмс_ЗаблокированныеЯчейки.Ячейка,
	вмс_ЗаблокированныеЯчейки.ВидБлокировки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Заблокированные.Ячейка КАК Ячейка,
	МАКСИМУМ(ВЫБОР
			КОГДА Заблокированные.ВидБлокировки = ЗНАЧЕНИЕ(Перечисление.вмс_ВидыБлокировокЯчеек.Полная)
					ИЛИ Заблокированные.ВидБлокировки = ЗНАЧЕНИЕ(Перечисление.вмс_ВидыБлокировокЯчеек.Отбор)
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ) КАК БлокировкаОтбора,
	МАКСИМУМ(ВЫБОР
			КОГДА Заблокированные.ВидБлокировки = ЗНАЧЕНИЕ(Перечисление.вмс_ВидыБлокировокЯчеек.Полная)
					ИЛИ Заблокированные.ВидБлокировки = ЗНАЧЕНИЕ(Перечисление.вмс_ВидыБлокировокЯчеек.Размещение)
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ) КАК БлокировкаРазмещения
ПОМЕСТИТЬ Заблокированные2
ИЗ
	Заблокированные КАК Заблокированные

СГРУППИРОВАТЬ ПО
	Заблокированные.Ячейка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(Заблокированные2.БлокировкаОтбора, ЛОЖЬ) КАК БлокировкаОтбора,
	ЕСТЬNULL(Заблокированные2.БлокировкаРазмещения, ЛОЖЬ) КАК БлокировкаРазмещения,
	Справочниквмс_МестаХранения.Ссылка КАК Ссылка,
	Справочниквмс_МестаХранения.ПометкаУдаления КАК ПометкаУдаления,
	Справочниквмс_МестаХранения.Владелец КАК Владелец,
	Справочниквмс_МестаХранения.Родитель КАК Родитель,
	Справочниквмс_МестаХранения.ЭтоГруппа КАК ЭтоГруппа,
	Справочниквмс_МестаХранения.Код КАК Код,
	Справочниквмс_МестаХранения.Наименование КАК Наименование,
	Справочниквмс_МестаХранения.Приоритет КАК Приоритет,
	Справочниквмс_МестаХранения.ТипЯчейки КАК ТипЯчейки,
	Справочниквмс_МестаХранения.Объем КАК Объем,
	Справочниквмс_МестаХранения.Категория КАК Категория,
	Справочниквмс_МестаХранения.Предопределенный КАК Предопределенный,
	Справочниквмс_МестаХранения.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ВЫБОР
		КОГДА ЕСТЬNULL(Заблокированные2.БлокировкаОтбора, ЛОЖЬ) = ИСТИНА
				И ЕСТЬNULL(Заблокированные2.БлокировкаРазмещения, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.вмс_ВидыБлокировокЯчеек.Полная)
		ИНАЧЕ ВЫБОР
				КОГДА ЕСТЬNULL(Заблокированные2.БлокировкаОтбора, ЛОЖЬ) = ИСТИНА
					ТОГДА ЗНАЧЕНИЕ(Перечисление.вмс_ВидыБлокировокЯчеек.Отбор)
				ИНАЧЕ ВЫБОР
						КОГДА ЕСТЬNULL(Заблокированные2.БлокировкаРазмещения, ЛОЖЬ) = ИСТИНА
							ТОГДА ЗНАЧЕНИЕ(Перечисление.вмс_ВидыБлокировокЯчеек.Размещение)
						ИНАЧЕ НЕОПРЕДЕЛЕНО
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК ВидБлокировки
ИЗ
	Справочник.вмс_МестаХранения КАК Справочниквмс_МестаХранения
		ЛЕВОЕ СОЕДИНЕНИЕ Заблокированные2 КАК Заблокированные2
		ПО Справочниквмс_МестаХранения.Ссылка = Заблокированные2.Ячейка</queryText>
      <mainTable>Catalog.вмс_МестаХранения</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
