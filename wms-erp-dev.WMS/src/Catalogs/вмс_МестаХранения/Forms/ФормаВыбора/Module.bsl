&НаКлиенте
Процедура СкладыПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.Склады.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		УстановитьОтборПоСкладам(ТекущиеДанные.Ссылка);
	КонецЕсли;
КонецПроцедуры   


//======================================================================================================================

&НаСервере
Процедура УстановитьОтборПоСкладам(Склад)
	
	ИспользоватьОтбор = ТипЗнч(Склад) <> Тип("Строка");
	
	Если ИспользоватьОтбор Тогда
		СписокСкладов = вмс_РаботаСКоллекциями.ЗначениеВМассив(Склад);
	Иначе
		СписокСкладов = ПолучитьМассивСкладов();
	КонецЕсли;
	
	УстановитьОтборДинамическогоСписка(Список, "Владелец", СписокСкладов, Истина);

	
КонецПроцедуры
