&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьХранилищаЗначений();
	
	вмс_УправлениеСвойствамиСервер.ПриСозданииНаСервере(ЭтаФорма, ЭтаФорма.Объект, , "СтраницаСвойстваОперации");
	
	Элементы.ИмяФормы.КнопкаВыпадающегоСписка = Истина;
	СписокФормОперации = Элементы.ИмяФормы.СписокВыбора;
	СписокФормОперации.Очистить();
	СписокФормОперации.Добавить("ФормаОперацииПоЗаданиюКладовщику");
	
	Объект.ЗаданиеКладовщикуРаспоряжение = "Документ.вмс_ЗаданиеКладовщику";
	
	// ТУ_Алфимов 01.04.26 ++ 
	ДобавляемыеРеквизиты = Новый Массив();
	РеквизитТестовый = Новый РеквизитФормы("ЭтоИнвентаризация",Новый ОписаниеТипов("Булево"),,,Истина);
	ДобавляемыеРеквизиты.Добавить(РеквизитТестовый);
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	ГруппаДляРазмещения = ЭтотОбъект.Элементы.Найти("СтандартныеРеквизитыГруппа");
	НовЭлемент = Элементы.Добавить("ЭтоИнвентаризация", Тип("ПолеФормы"),ГруппаДляРазмещения);
	НовЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовЭлемент.Заголовок = "Это инвентаризация";
	НовЭлемент.ПутьКДанным = "Объект.ЭтоИнвентаризация";
	НовЭлемент.Видимость = Истина;
	// ТУ_Алфимов 01.04.26 --

	ЗаполнитьСписокКлассовОперации();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ЗагрузитьДанныеМетодов();
	
	//3.2.5 - Переход на отдельное хранилище данных
	//ДанныеСКД = ТекущийОбъект.ДанныеСКД.Получить();
	ДанныеСКД = Справочники.вмс_ИсточникиДанных.ИсточникДанных("ДанныеСКД", ТекущийОбъект.Ссылка);
	Если ТипЗнч(ДанныеСКД)=Тип("Структура") Тогда
		ТекущиеДанныеСКД = ПолучитьТекущиеДанныеСКД();
		Для Каждого ЭлементДанныхСКД Из ДанныеСКД Цикл
			ИмяСКД = ЭлементДанныхСКД.Ключ;
			Если ТекущиеДанныеСКД.Свойство(ИмяСКД) Тогда
				СохранитьСКД(ЭлементДанныхСКД.Значение, ЭтаФорма["АдресДанныеСКД" + ИмяСКД]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	
КонецПроцедуры

