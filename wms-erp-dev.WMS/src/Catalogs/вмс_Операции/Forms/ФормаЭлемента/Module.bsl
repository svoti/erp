&НаСервере
Функция ЗагрузитьЗначениеВХранилищеНаФорме(Имя, Значение)
	
	Перем АдресХранилища;
	
	СписокАдресовХранилищЗначений = ПолучитьСписокАдресовХранилищЗначений();
	
	СписокАдресовХранилищЗначений.Свойство(Имя, АдресХранилища);

	Если АдресХранилища <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(Значение, АдресХранилища);
	Иначе
		АдресХранилища = ПоместитьВоВременноеХранилище(Значение, ЭтаФорма.УникальныйИдентификатор);
		СписокАдресовХранилищЗначений.Вставить(Имя, АдресХранилища);
	КонецЕсли;
	
	Возврат АдресХранилища;
	
КонецФункции

&НаСервере
Функция ПолучитьЗначениеИзХранилищаНаФорме(Имя)
	
	АдресХранилища = ПолучитьАдресХранилищаНаФорме(Имя);
	Если ЗначениеЗаполнено(АдресХранилища) Тогда
		Возврат ПолучитьИзВременногоХранилища(АдресХранилища);
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьАдресХранилищаНаФорме(Имя)
	
	Перем АдресХранилища;
	
	ПолучитьСписокАдресовХранилищЗначений().Свойство(Имя, АдресХранилища);

	Возврат АдресХранилища;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокАдресовХранилищЗначений()
	
	ВсеРеквизитыФормы = ПолучитьРеквизиты();
	Для Каждого РеквизитФормы Из ВсеРеквизитыФормы Цикл
		Если РеквизитФормы.Имя = "СписокАдресовХранилищЗначений" Тогда
			Возврат ЭтаФорма.СписокАдресовХранилищЗначений;
		КонецЕсли;
	КонецЦикла;
	
	НовыеРеквизиты = Новый Массив;
	НовыеРеквизиты.Добавить(Новый РеквизитФормы("СписокАдресовХранилищЗначений", Новый ОписаниеТипов));
	ИзменитьРеквизиты(НовыеРеквизиты);
	
	ЭтаФорма.СписокАдресовХранилищЗначений = Новый Структура;
	Возврат ЭтаФорма.СписокАдресовХранилищЗначений;
	
КонецФункции

&НаСервере
Функция УдалитьХранищаНаФорме()
	
	СписокАдресовХранилищЗначений = ПолучитьСписокАдресовХранилищЗначений();
	
	Для Каждого АдресХранилищаЗначения Из СписокАдресовХранилищЗначений Цикл
		УдалитьИзВременногоХранилища(АдресХранилищаЗначения.Значение);
	КонецЦикла;
	
	СписокАдресовХранилищЗначений.Очистить();
	
КонецФункции

&НаСервере
Функция ЗаполнитьСписокКлассовОперации()
	
	СписокКлассов = Элементы.КлассОперации.СписокВыбора;
	
	СписокКлассов.Очистить();
	
	Для Каждого МетаданныеОбработки Из Метаданные.Обработки Цикл
		
		Если СтрНайти(МетаданныеОбработки.Имя, "вмс_СерверУправляемыйМодульОперацияПоЯчейкам") <> 1 Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектМодуляОперации = Обработки[МетаданныеОбработки.Имя].Создать();
		ЭтоСлужебныйМодуль = ОбъектМодуляОперации.ВыполнитьДействие(вмс_СерверУправляемыеОбработки.Действие("ЭтоСлужебныйМодуль"))=Истина;
		Если ЭтоСлужебныйМодуль Тогда
			Продолжить;
		КонецЕсли;
		
		СписокКлассов.Добавить(МетаданныеОбработки.ПолноеИмя(), МетаданныеОбработки.Синоним);
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(АдресКлассОперацииХранилище) И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		//3.2.5 - Переход на отдельное хранилище данных
		//ДанныеОбработкиКлассОперации = Объект.Ссылка.ПолучитьОбъект().УдалитьКлассОперацииХранилище.Получить();
		ДанныеОбработкиКлассОперации = Справочники.вмс_ИсточникиДанных.ИсточникДанных("КлассОперацииХранилище", Объект.Ссылка);
		Если ДанныеОбработкиКлассОперации <> Неопределено Тогда
			АдресКлассОперацииХранилище = ПоместитьВоВременноеХранилище(ДанныеОбработкиКлассОперации, УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресКлассОперацииХранилище) Тогда
		ИмяОбработки = ПодключитьВнешнююОбработку(АдресКлассОперацииХранилище);
		Если ЗначениеЗаполнено(ИмяОбработки) Тогда
			МетаданныеОбработки = ВнешниеОбработки.Создать(ИмяОбработки).Метаданные();
			СписокКлассов.Добавить(МетаданныеОбработки.ПолноеИмя(), МетаданныеОбработки.Синоним + " (внешняя)");
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЗагрузитьДанныеМетодов()
	
	Перем РаботаСXML, ОперацииПоЯчейкамКлиентСервер;
	
	РаботаСXML = вмс_РаботаСXMLКлиентСервер;
	ОперацииПоЯчейкамКлиентСервер = вмс_ОперацииПоЯчейкамКлиентСервер;
	
	Для Каждого СтрокаМетодаОперации Из Объект.МетодыОперации Цикл
		
		ОписаниеМетодаОперации = РаботаСXML.ПрочитатьТекстXMLУлучшенная(СтрокаМетодаОперации.Данные);
		Если ТипЗнч(ОписаниеМетодаОперации)<>Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеМетодаОперации.Свойство("ПолныйКод", СтрокаМетодаОперации.ТекстКодаМетода);
		
		ОписаниеМетода = ОперацииПоЯчейкамКлиентСервер.ПолучитьОписаниеМетода(СтрокаМетодаОперации.ТекстКодаМетода);
		Если ОписаниеМетода<>Неопределено Тогда
			СтрокаМетодаОперации.ЕстьОшибкиСинтаксиса = Ложь;
		Иначе
			СтрокаМетодаОперации.ЕстьОшибкиСинтаксиса = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Функция СохранитьДанныеМетодов()

	Перем РаботаСXML, ОперацииПоЯчейкамКлиентСервер;
	
	РаботаСXML = вмс_РаботаСXMLКлиентСервер;
	ОперацииПоЯчейкамКлиентСервер = вмс_ОперацииПоЯчейкамКлиентСервер;
	
	Для Каждого СтрокаМетодаОперации Из Объект.МетодыОперации Цикл
		
		ОписаниеМетодаОперации = ОперацииПоЯчейкамКлиентСервер.ПолучитьОписаниеМетода(СтрокаМетодаОперации.ТекстКодаМетода);
		Если ОписаниеМетодаОперации=Неопределено Тогда
			ОписаниеМетодаОперации = ОперацииПоЯчейкамКлиентСервер.НовоеОписаниеМетода();
			ОписаниеМетодаОперации.Имя = СтрокаМетодаОперации.ИмяМетода;
		КонецЕсли;
		ОписаниеМетодаОперации.ПолныйКод = СтрокаМетодаОперации.ТекстКодаМетода;
		
		СтрокаМетодаОперации.Данные = РаботаСXML.XMLСтрокаИзЗначенияУлучшенная(ОписаниеМетодаОперации);
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ТекстКодаМетодаПриИзменении(Элемент)
	
	Перем ОперацииПоЯчейкамКлиентСервер;
	
	ОперацииПоЯчейкамКлиентСервер = вмс_ОперацииПоЯчейкамКлиентСервер;

	СтрокаМетодаОперации = Элементы.МетодыОперации.ТекущиеДанные;
	ТекстКодаМетода = СтрокаМетодаОперации.ТекстКодаМетода;
	
	ОписаниеМетода = ОперацииПоЯчейкамКлиентСервер.ПолучитьОписаниеМетода(ТекстКодаМетода);
	
	Если ОписаниеМетода<>Неопределено Тогда
		СтрокаМетодаОперации.ИмяМетода = ОписаниеМетода.Имя;
		СтрокаМетодаОперации.ЕстьОшибкиСинтаксиса = Ложь;
	Иначе
		СтрокаМетодаОперации.ЕстьОшибкиСинтаксиса = Истина;
	КонецЕсли;
	
КонецПроцедуры

