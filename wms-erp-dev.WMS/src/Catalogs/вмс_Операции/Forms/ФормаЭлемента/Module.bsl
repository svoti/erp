&НаСервере
Функция ОперациОХРНаСервере(Значения)
	Если ТипЗнч(Значения) = Тип ("Структура") Тогда
		Если ЗначениеЗаполнено(Объект.ОтветственноеХранение.НайтиСтроки(Новый Структура("Операция",Значения.вмс_УслугиОтветственногоХранения))) Тогда
			Возврат Ложь;
		Иначе 
			Для Каждого Элемент из Значения.вмс_УслугиОтветственногоХранения Цикл
			Строка = Объект.ОтветственноеХранение.Добавить();
			Строка.Операция = Элемент; 
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значения) = Тип ("Массив") Тогда  
		Для Каждого Значение из Значения Цикл
			Если ЗначениеЗаполнено(Объект.ОтветственноеХранение.НайтиСтроки(Новый Структура("Операция",Значение.Ссылка))) Тогда 
				Продолжить
			Иначе
				Строка = Объект.ОтветственноеХранение.Добавить();
				Строка.Операция = Значение.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецФункции

