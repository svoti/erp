&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	вмс_УправлениеСвойствамиСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОперацияВладелец = Справочники.вмс_Операции.ПолучитьСсылку();
		ОбъектСправочника = РеквизитФормыВЗначение("Объект");
		ОбъектСправочника.УстановитьСсылкуНового(ОперацияВладелец);
	Иначе
		ОперацияВладелец = Объект.Ссылка;	
	КонецЕсли;
	
	Если СтрНайти(ТекущийОбъект.КлассОперации, "ВнешняяОбработка.") <> 1 Тогда
		//удалить неиспользуемую внешнюю обработку
		ТекущийОбъект.КлассОперацииХранилище = Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных("КлассОперацииХранилище", ОперацияВладелец, Неопределено);
	ИначеЕсли ЗначениеЗаполнено(АдресКлассОперацииХранилище) Тогда
		ТекущийОбъект.КлассОперацииХранилище = Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных("КлассОперацииХранилище", ОперацияВладелец, ПолучитьИзВременногоХранилища(АдресКлассОперацииХранилище));
	КонецЕсли;
	
	
	//3.2.5 - Переход на отдельное хранилище данных
	//ТекущийОбъект.ДанныеСКД = Новый ХранилищеЗначения(ПолучитьТекущиеДанныеСКД());
	//ТекущийОбъект.ХранилищеСКДЗаданияКладовщику = Новый ХранилищеЗначения(ПолучитьСКД(АдресДанныеСКДЗаданияКладовщику));
	
	ТекущийОбъект.ДанныеСКД = Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных("ДанныеСКД", ОперацияВладелец, ПолучитьТекущиеДанныеСКД());
	ТекущийОбъект.ХранилищеСКДЗаданияКладовщику = Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных("ХранилищеСКДЗаданияКладовщику", ОперацияВладелец, ПолучитьСКД(АдресДанныеСКДЗаданияКладовщику));
	
	
КонецПроцедуры

