&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаРаспоряжение(Имя, Представление)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_РаспоряженияОпераций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.вмс_РаспоряженияОпераций КАК вмс_РаспоряженияОпераций
	|ГДЕ
	|	НЕ вмс_РаспоряженияОпераций.ПометкаУдаления
	|	И вмс_РаспоряженияОпераций.РаспоряжениеКонфигуратор = &Имя";
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		СсылкаНаРаспоряжение = Выборка.Ссылка;
		Распоряжение = СсылкаНаРаспоряжение.ПолучитьОбъект();
		Если Распоряжение <> Неопределено Тогда
			Возврат СсылкаНаРаспоряжение;
		КонецЕсли;
	КонецЕсли;
	
	Распоряжение = Справочники.вмс_РаспоряженияОпераций.СоздатьЭлемент();
	Распоряжение.Заполнить(Неопределено);
	Распоряжение.Имя = Имя;
	Распоряжение.Наименование = Представление;
	Распоряжение.Записать();
	
	Возврат Распоряжение.Ссылка;
	
КонецФункции

