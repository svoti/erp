&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	вмс_ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтаФорма, Команда, Объект);
КонецПроцедуры

#КонецОбласти

#Область РаботасСКДЗаданияКладовщику

&НаКлиенте
Процедура РедактироватьСКДЗаданияКладовщику(Команда)
		
	Распоряжение = Объект.ЗаданиеКладовщикуРаспоряжение;
	
	Если Распоряжение <> "" Тогда
		ОО = Новый ОписаниеОповещения("СохранитьНастройкиРедактораЗаданийКладовщику",ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ФормаРедакторНастроекСКД", Новый Структура("СКД", АдресДанныеСКДЗаданияКладовщику),ЭтаФорма,,,,ОО);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран документ - основание");
	КонецЕсли;

КонецПроцедуры   

&НаСервере
Функция СохранитьНастройкиРедактораЗаданийКладовщику(АдресСхемыРедактора, ДополнительныеПараметры) Экспорт
	
	Если АдресСхемыРедактора = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СхемыКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыРедактора);
	АдресДанныеСКДЗаданияКладовщику = СохранитьСКД(СхемыКомпоновкиДанных, АдресДанныеСКДЗаданияКладовщику);
	ЭтаФорма.Модифицированность = Истина;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция СохранитьСКД(СхемаКомпоновки, АдресСКД)
	
	Если СхемаКомпоновки <> Неопределено Тогда
		Если ЗначениеЗаполнено(АдресСКД) Тогда
			ПоместитьВоВременноеХранилище(СхемаКомпоновки, АдресСКД);
		Иначе
			АдресСКД = ПоместитьВоВременноеХранилище(СхемаКомпоновки, ЭтаФорма.УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	Возврат АдресСКД;
	
КонецФункции

 &НаКлиенте
Процедура ПосмотретьСписокДокументовПоОперации(Команда)
	Если ЭтотОбъект.Модифицированность Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Есть не записанные изменения. Операция не может быть выполнена");
	ИначеЕсли ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТабДок = ПросмотрРезультатовДокументыНаСервере();
		ТабДок.Показать();
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран тип операции");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПросмотрРезультатовДокументыНаСервере()
	
	ВходящиеПараметры = Новый Структура();
	
	ТабДок = Справочники.вмс_Операции.ПолучитьДанныеПоРаспоряжению(Объект.Ссылка, ЭтотОбъект.Объект.Ссылка,ВходящиеПараметры, Истина);
		
	Возврат ТабДок;
	
КонецФункции

&НаСервере
Функция ПолучитьСКД(АдресСКД)
	
	Если ЗначениеЗаполнено(АдресСКД) Тогда
		СхемаКомпоновки = ПолучитьИзВременногоХранилища(АдресСКД);
		Возврат СхемаКомпоновки;
	КонецЕсли;
	
КонецФункции 

&НаСервере
Функция ПолучитьТекущиеДанныеСКД()
	
	ДанныеСКД = Новый Структура;
	ДанныеСКД.Вставить("ЗаданияКладовщику", ПолучитьСКД(АдресДанныеСКДЗаданияКладовщику));
	Возврат ДанныеСКД;
	
КонецФункции

#КонецОбласти

#Область KPI

&НаКлиенте
Функция ЗаполнитьСтраницуKPI()
	
	Если НЕ НормыKPIЗаполнены() Тогда
		ПеременныеКлиент.Вставить("KPIЗаполнен", Истина);
		ПеременныеКлиент.Вставить("НормыKPIИзменены", Ложь);
		
		ДатаУстановкиНормKPI = ТекущаяДата();
		
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ЗаполнитьНормыKPI();
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция НормыKPIЗаполнены()
	
	Возврат ПеременныеКлиент.Свойство("KPIЗаполнен") И ПеременныеКлиент.KPIЗаполнен;
	
КонецФункции

&НаСервере
Функция ЗаполнитьНормыKPI()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		НормыKPI.Загрузить(ПолучитьНормыKPI());
	Иначе
		НормыKPI.Очистить();
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьНормыKPI(Период=Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_НормыKPIСрезПоследних.Период КАК Период,
	|	вмс_НормыKPIСрезПоследних.Операция КАК Операция,
	|	вмс_НормыKPIСрезПоследних.Единица КАК Единица,
	|	вмс_НормыKPIСрезПоследних.КоличествоМинут КАК КоличествоМинут,
	|	вмс_НормыKPIСрезПоследних.КоличествоЕдиниц КАК КоличествоЕдиниц
	|ИЗ
	|	РегистрСведений.вмс_НормыKPI.СрезПоследних(&Период, Операция = &Операция) КАК вмс_НормыKPIСрезПоследних
	|ГДЕ
	|	вмс_НормыKPIСрезПоследних.КоличествоМинут <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Единица";
	Запрос.УстановитьПараметр("Операция", Объект.Ссылка);
	Если Период=Неопределено Тогда
		Запрос.УстановитьПараметр("Период", ДатаУстановкиНормKPI);
	Иначе
		Запрос.УстановитьПараметр("Период", Период);
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	НормыKPIПоЗапросу = РезультатЗапроса.Выгрузить();
	
	Возврат НормыKPIПоЗапросу;
	
КонецФункции

&НаКлиенте
Функция ЗаписатьНормыKPI()
	
	Если НормыKPIЗаполнены() И ПеременныеКлиент.НормыKPIИзменены Тогда
		ЗаписатьНормыKPIНаСервере();
		ПеременныеКлиент.НормыKPIИзменены = Ложь;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЗаписатьНормыKPIНаСервере()
	
	НормыKPIПоЗапросу = ПолучитьНормыKPI(ДатаУстановкиНормKPI-1);

	НаборЗаписей = РеквизитФормыВЗначение("НормыKPI");
	ТаблицаНормKPI = НаборЗаписей.Выгрузить();
	
	Отбор = Новый Структура("Единица");
	Для Каждого НормаKPIПоЗапросу Из НормыKPIПоЗапросу Цикл
		ЗаполнитьЗначенияСвойств(Отбор, НормаKPIПоЗапросу);
		НайденныеНормыKPI = ТаблицаНормKPI.НайтиСтроки(Отбор);
		Если НайденныеНормыKPI.Количество()=0 Тогда
			//норма удалена, запишем в регистр нулевую норму
			НормаKPI = ТаблицаНормKPI.Добавить();
			ЗаполнитьЗначенияСвойств(НормаKPI, Отбор);
			НормаKPI.КоличествоМинут = 0;
			НормаKPI.КоличествоЕдиниц = 1;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого НормаKPI Из ТаблицаНормKPI Цикл
		НормаKPI.Период = ДатаУстановкиНормKPI;
		НормаKPI.Операция = Объект.Ссылка;
	КонецЦикла;
	
	НаборЗаписей.Отбор.Период.Установить(ДатаУстановкиНормKPI);
	НаборЗаписей.Отбор.Операция.Установить(Объект.Ссылка);
	НаборЗаписей.Загрузить(ТаблицаНормKPI);
	НаборЗаписей.Записать();
	
КонецФункции

&НаКлиенте
Процедура ДатаУстановкиНормKPIПриИзменении(Элемент)
	
	ЗаполнитьНормыKPI();
	
КонецПроцедуры

&НаКлиенте
Процедура НормыKPIПриИзменении(Элемент)
	
	Модифицированность = Истина;
	ПеременныеКлиент.НормыKPIИзменены = Истина;
	
КонецПроцедуры


#КонецОбласти

#Область МетодыОперации

&НаКлиенте
Процедура МетодыОперацииПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Перем ОперацииПоЯчейкамКлиентСервер;
	
	ОперацииПоЯчейкамКлиентСервер = вмс_ОперацииПоЯчейкамКлиентСервер;

	Отказ = Истина;
	
	ОписаниеМетода = ОперацииПоЯчейкамКлиентСервер.НовоеОписаниеМетода();
	ОписаниеМетода.Директива = "НаКлиенте";
	ОписаниеМетода.Имя = ПолучитьИмяНовогоМетода();
	ОписаниеМетода.Код = "Возврат 0;";
	ПолныйКодМетода = ОперацииПоЯчейкамКлиентСервер.ПолучитьПолныйКодМетода(ОписаниеМетода);
	
	СтрокаМетодаОперации = Объект.МетодыОперации.Добавить();
	СтрокаМетодаОперации.ИмяМетода = ОписаниеМетода.Имя;
	СтрокаМетодаОперации.ТекстКодаМетода = ПолныйКодМетода;
	
	Элементы.МетодыОперации.ТекущаяСтрока = СтрокаМетодаОперации.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяНовогоМетода()
	
	Возврат ПолучитьИмяНовогоЭлемента("НовыйМетод", Объект.МетодыОперации, "ИмяМетода");
	
КонецФункции

&НаКлиенте
Процедура ПараметрыОперацииПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	ИмяНовогоПараметра = ПолучитьИмяНовогоПараметра();
	
	ПараметрОперации = Объект.ПараметрыОперации.Добавить();
	ПараметрОперации.Имя = ИмяНовогоПараметра;
	ПараметрОперации.НаФронтенде = Истина;
	
	Если Копирование Тогда
		
		ПараметрОперацииИсточник = Элементы.ПараметрыОперации.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(ПараметрОперации, ПараметрОперацииИсточник, , "Имя");
		
	КонецЕсли;
	
	Элементы.ПараметрыОперации.ТекущаяСтрока = ПараметрОперации.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяНовогоПараметра()
	
	Возврат ПолучитьИмяНовогоЭлемента("Параметр", Объект.ПараметрыОперации, "Имя");
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяНовогоЭлемента(ПрефиксЭлемента, ВсеЭлементы, ПолеИмениЭлемента)
	
	ЗарегистрированныеИменаЭлементов = Новый Соответствие;
	
	Для Каждого Элемент Из ВсеЭлементы Цикл
		ЗарегистрированныеИменаЭлементов[ВРЕГ(СокрЛП(Элемент[ПолеИмениЭлемента]))] = Истина;
	КонецЦикла;
	
	НомерЭлемента = 1;
	Пока Истина Цикл
		
		ИмяНовогоЭлемента = ПрефиксЭлемента + Формат(НомерЭлемента, "ЧГ=0");
		Если ЗарегистрированныеИменаЭлементов[ВРЕГ(ИмяНовогоЭлемента)] <> Истина Тогда
			Возврат ИмяНовогоЭлемента;
		КонецЕсли;
		
		НомерЭлемента = НомерЭлемента + 1;
		
	КонецЦикла;
	
КонецФункции

#КонецОбласти

//Для того, чтобы получить серверную форму, например, для добавления новых элементов формы
&НаСервере
Функция СлужебнаяФункцияВызовСервера(ПрограммныйКод, ДополнительныеПараметры=Неопределено) Экспорт
	Возврат вмс_ОбщегоНазначенияСервер.СлужебнаяФункцияВызовСервераНаФорме(ЭтаФорма, ПрограммныйКод, ДополнительныеПараметры);
КонецФункции

#КонецОбласти









