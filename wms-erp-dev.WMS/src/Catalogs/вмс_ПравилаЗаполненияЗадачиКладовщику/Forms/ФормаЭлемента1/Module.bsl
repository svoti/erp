#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция РедактироватьСКД(ИмяСКД)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяСКД", ИмяСКД);
	ОО = Новый ОписаниеОповещения("ОбработчикРедактированияСКД", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("ОбщаяФорма.ФормаРедакторСКД", Новый Структура("СКД", ЭтаФорма["АдресДанныеСКД" + ИмяСКД]), ЭтаФорма, ,,, ОО);
	
КонецФункции

&НаСервере
Функция ОбработчикРедактированияСКД(АдресСхемыРедактора, ДополнительныеПараметры) Экспорт
	
	Если АдресСхемыРедактора = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяСКД = ДополнительныеПараметры.ИмяСКД;
	СхемыКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыРедактора);
	СохранитьСКД(СхемыКомпоновкиДанных, ЭтаФорма["АдресДанныеСКД" + ИмяСКД]);
	ЭтаФорма.Модифицированность = Истина;
	
	Если ИмяСКД="Товары" Тогда
		Объект.ЗаполнятьПлан = Истина;
		ОпределитьИспользование_Товары_ЗаполнятьПоПринятым(СхемыКомпоновкиДанных);
	КонецЕсли;
	
	УправлениеЭлементамиФормы();
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОпределитьИспользование_Товары_ЗаполнятьПоПринятым(СхемыКомпоновкиДанных);
	
	Попытка
		Запрос = СхемыКомпоновкиДанных.НаборыДанных[0].Запрос;
	Исключение
		Запрос = "";
	КонецПопытки;
	
	Объект.Товары_ЗаполнятьПоПринятым = СтрНайти(Запрос, "&ТаблицаПринятыхТоваров") > 0;
	Возврат Объект.Товары_ЗаполнятьПоПринятым;
	
КонецФункции

&НаСервере
Функция ПолучитьТекущиеДанныеСКД()
	
	ДанныеСКД = Новый Структура;
	ДанныеСКД.Вставить("Основания", ПолучитьСКД(АдресДанныеСКДОснования));
	ДанныеСКД.Вставить("Шапки", ПолучитьСКД(АдресДанныеСКДШапки));
	ДанныеСКД.Вставить("Товары", ПолучитьСКД(АдресДанныеСКДТовары));
	ДанныеСКД.Вставить("КодыМаркировки", ПолучитьСКД(АдресДанныеСКДКодыМаркировки));
	ДанныеСКД.Вставить("ЗаданияКладовщику", ПолучитьСКД(АдресДанныеСКДЗаданияКладовщику));
	
	Возврат ДанныеСКД;
	
КонецФункции

&НаСервере
Функция СохранитьСКД(СхемаКомпоновки, АдресСКД)
	
	Если СхемаКомпоновки <> Неопределено Тогда
		Если ЗначениеЗаполнено(АдресСКД) Тогда
			ПоместитьВоВременноеХранилище(СхемаКомпоновки, АдресСКД);
		Иначе
			АдресСКД = ПоместитьВоВременноеХранилище(СхемаКомпоновки, ЭтаФорма.УникальныйИдентификатор);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат АдресСКД;
	
КонецФункции

&НаСервере
Функция ПолучитьСКД(АдресСКД)
	
	Если ЗначениеЗаполнено(АдресСКД) Тогда
		СхемаКомпоновки = ПолучитьИзВременногоХранилища(АдресСКД);
		Возврат СхемаКомпоновки;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеТестирования()
	
	Если ЭтоАдресВременногоХранилища(АдресДанныеТестирования) Тогда
		СохраненныеДанныеТестирования = ПолучитьИзВременногоХранилища(АдресДанныеТестирования);
	КонецЕсли;
	
	ДанныеТестирования = Новый Структура;
	ДанныеТестирования.Вставить("Регистратор");
	ДанныеТестирования.Вставить("Распоряжение");
	
	Если ТипЗнч(СохраненныеДанныеТестирования)=Тип("Структура") Тогда
		Для Каждого Поле Из ДанныеТестирования Цикл
			
			Если СохраненныеДанныеТестирования.Свойство(Поле.Ключ) Тогда
				ДанныеТестирования.Вставить(Поле.Ключ, СохраненныеДанныеТестирования[Поле.Ключ]);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат ДанныеТестирования;
	
КонецФункции

&НаСервере
Функция ЗаполнитьДанныеТестирования()
	
	ДанныеТестирования = ПолучитьДанныеТестирования();
	
	ЭтаФорма.ТестированиеРегистратор = ДанныеТестирования.Регистратор;
	ЭтаФорма.ТестированиеРаспоряжение = ДанныеТестирования.Распоряжение;
	
КонецФункции

&НаСервере
Функция ПоместитьДанныеТестированияВХранилище()
	
	ДанныеТестирования = ПолучитьДанныеТестирования();
	
	ДанныеТестирования.Регистратор = ЭтаФорма.ТестированиеРегистратор;
	ДанныеТестирования.Распоряжение = ЭтаФорма.ТестированиеРаспоряжение;
	
	Если ЭтоАдресВременногоХранилища(АдресДанныеТестирования) Тогда
		ПоместитьВоВременноеХранилище(ДанныеТестирования, АдресДанныеТестирования);
	Иначе
		АдресДанныеТестирования = ПоместитьВоВременноеХранилище(ДанныеТестирования, УникальныйИдентификатор);
	КонецЕсли;
	
КонецФункции

// ТУ_Алфимов 20.08.25 ++
&НаСервере
Функция ПолучитьСписокДокументовКонфигурации()
	
	Перем Строка;
	
	СписокДокументов = Новый СписокЗначений;
	ДопустимыеИменаТабличныхЧастей = Новый Массив;
	
	// ТУ_Мовчан 12.12.23 ++
	ИменаТабличныхЧастей = вмс_АдаптацияКонфигураций.ПолучитьИмяТабличнойЧасти();
	Если Тип("Массив") = ТипЗнч(ИменаТабличныхЧастей) Тогда
		Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
			ДопустимыеИменаТабличныхЧастей.Добавить(ИмяТабличнойЧасти);
		КонецЦикла;
	Иначе
		ДопустимыеИменаТабличныхЧастей.Добавить(ИменаТабличныхЧастей);
	КонецЕсли;
	// ТУ_Мовчан 12.12.23 --
	//ДопустимыеИменаТабличныхЧастей.Добавить(вмс_АдаптацияКонфигураций.ПолучитьИмяТабличнойЧасти()); 
	ДопустимыеИменаТабличныхЧастей.Добавить(вмс_АдаптацияКонфигураций.ПолучитьИмяТабличнойЧастиПродукция());
	ДопустимыеИменаТабличныхЧастей.Добавить("ДокументыОтгрузки"); //Маршрутные листы  
	
	Для каждого Строка Из Метаданные.Документы Цикл
		Если ЗначениеЗаполнено(Строка.ТабличныеЧасти) Тогда
			
			Для каждого ТабличнаяЧасть Из Строка.ТабличныеЧасти Цикл
				Если ДопустимыеИменаТабличныхЧастей.Найти(ТабличнаяЧасть.Имя) <> Неопределено Тогда
					СписокДокументов.Добавить(Строка.ПолноеИмя(), Строка.Синоним);
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокДокументов;
	
КонецФункции 

&НаСервере
Процедура РаспоряжениеКонфигураторПриИзмененииСервер()
	спрОбъект = РеквизитФормыВЗначение("Объект");
	СКДДокументы = спрОбъект.ПолучитьСКДДокументы(); 
	АдресСКДДокументы = СохранитьСКД(СКДДокументы, АдресСКДДокументы);
КонецПроцедуры 

&НаСервере
Функция СформироватьНаименование()
	МетаданныеРаспоряжения = Метаданные.НайтиПоПолномуИмени(Объект.РаспоряжениеКонфигуратор);
	Объект.Наименование = Строка(Объект.ОперацияНазначение);
	Если МетаданныеРаспоряжения <> Неопределено Тогда
		Объект.Наименование = Объект.Наименование + " (" + Строка(МетаданныеРаспоряжения) + ")";
	КонецЕсли;
