#Область ОбработчикиСобытийФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначениеКопирования = Неопределено;
	Если Параметры.Свойство("ЗначениеКопирования", ЗначениеКопирования) И ЗначениеЗаполнено(ЗначениеКопирования) Тогда
		ПриЧтенииНаСервере(ЗначениеКопирования);
	КонецЕсли;
	
	ЗаполнитьДанныеТестирования(); 
	
	УправлениеЭлементамиФормы();
	
	Объект.ЗаданиеКладовщикуРаспоряжение = "Документ.вмс_ЗаданиеКладовщику";
	
	вмс_УправлениеСвойствамиСервер.ПриСозданииНаСервере(ЭтаФорма, ЭтаФорма.Объект, , "СтраницаДополнительно");
	
	//СтруктураНастройкиПолей = Справочники.вмс_ПравилаЗаполненияЗадачиКладовщику.СтруктураНастройкиПолей(Объект);
	//Справочники.вмс_НастройкиПолейЗадания.ПриСозданииФормы(ЭтаФорма, СтруктураНастройкиПолей);
	
	вмс_НастройкиПолейЗаданияСервер1.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	вмс_УправлениеСвойствамиКлиент.ПриОткрытии(ЭтаФорма, Отказ); 
	
	вмс_НастройкиПолейЗаданияКлиент1.ПриОткрытии(ЭтаФорма, Отказ, ДанныеОбъектаНастройкиПолейЗадания(Истина));
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	вмс_ПараметрыПриложения["КлиентскиеПеременные"].Удалить(ЭтаФорма);
	вмс_УправлениеСвойствамиКлиент.ПриЗакрытии(ЭтаФорма, ЗавершениеРаботы);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	//3.2.5 - Переход на отдельное хранилище данных
	//ДанныеСКД = ТекущийОбъект.ДанныеСКД.Получить();
	ДанныеСКД = Справочники.вмс_ИсточникиДанных.ИсточникДанных("ХранилищеДанныеСКД", ТекущийОбъект.Ссылка);
	
	Если ТипЗнч(ДанныеСКД)=Тип("Структура") Тогда
		ТекущиеДанныеСКД = ПолучитьТекущиеДанныеСКД();
		Для Каждого ЭлементДанныхСКД Из ДанныеСКД Цикл
			ИмяСКД = ЭлементДанныхСКД.Ключ;
			Если ТекущиеДанныеСКД.Свойство(ИмяСКД) Тогда
				СохранитьСКД(ЭлементДанныхСКД.Значение, ЭтаФорма["АдресДанныеСКД" + ИмяСКД]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//3.2.5 - Переход на отдельное хранилище данных
	//АдресДанныеТестирования = ПоместитьВоВременноеХранилище(ТекущийОбъект.Тестирование.Получить(), УникальныйИдентификатор);
	АдресДанныеТестирования = ПоместитьВоВременноеХранилище(Справочники.вмс_ИсточникиДанных.ИсточникДанных("ХранилищеТестирование", ТекущийОбъект.Ссылка), УникальныйИдентификатор);
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//3.2.5 - Переход на отдельное хранилище данных
	//ТекущийОбъект.ДанныеСКД = Новый ХранилищеЗначения(ПолучитьТекущиеДанныеСКД());
	//
	//ПоместитьДанныеТестированияВХранилище();
	//ТекущийОбъект.Тестирование = Новый ХранилищеЗначения(ПолучитьДанныеТестирования());
	//ТекущийОбъект.ХранилищеСКДТовары = Новый ХранилищеЗначения(); // совместимость
	//ТекущийОбъект.ХранилищеСКДДокументы = Новый ХранилищеЗначения(ПолучитьСКД(АдресСКДДокументы));
	//ТекущийОбъект.ХранилищеСКДЗаданияКладовщику = Новый ХранилищеЗначения(ПолучитьСКД(АдресДанныеСКДЗаданияКладовщику));
	//ТекущийОбъект.ХранилищеСКДОснований = Новый ХранилищеЗначения(ПолучитьСКД(АдресДанныеСКДОснования));
	//ТекущийОбъект.ХранилищеСКДШапкиДокумента = Новый ХранилищеЗначения(ПолучитьСКД(АдресДанныеСКДШапки));
	//
	//3.2.5 - Переход на отдельное хранилище данных
	
	Если НЕ ТекущийОбъект.ЭтоНовый() Тогда
		
		вмс_УправлениеСвойствамиСервер.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
		
		ПравилоВладелец = ТекущийОбъект.Ссылка;
		ПоместитьДанныеТестированияВХранилище();
		ТекущийОбъект.ХранилищеТестирование 					= Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных(
														"ХранилищеТестирование", ПравилоВладелец, ПолучитьДанныеТестирования());
		ТекущийОбъект.ХранилищеСКДТовары 			= Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных(
														"ХранилищеСКДТовары", ПравилоВладелец, Новый ХранилищеЗначения(Неопределено));
		ТекущийОбъект.ХранилищеСКДДокументы 		= Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных(
														"ХранилищеСКДДокументы", ПравилоВладелец, ПолучитьСКД(АдресСКДДокументы));
		ТекущийОбъект.ХранилищеСКДЗаданияКладовщику = Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных(
														"ХранилищеСКДЗаданияКладовщику", ПравилоВладелец, ПолучитьСКД(АдресДанныеСКДЗаданияКладовщику));
		ТекущийОбъект.ХранилищеСКДОснований 		= Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных(
														"ХранилищеСКДОснований", ПравилоВладелец, ПолучитьСКД(АдресДанныеСКДОснования));
		ТекущийОбъект.ХранилищеСКДШапкиДокумента 	= Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных(
														"ХранилищеСКДШапкиДокумента", ПравилоВладелец, ПолучитьСКД(АдресДанныеСКДШапки));
		ТекущийОбъект.ХранилищеДанныеСКД 			= Справочники.вмс_ИсточникиДанных.СохранитьИсточникДанных(
														"ХранилищеДанныеСКД", ПравилоВладелец, ПолучитьТекущиеДанныеСКД());
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЗаписьНового", ТекущийОбъект.ЭтоНовый());
	
КонецПроцедуры  

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Объект.РежимФормированияЗаданий=0 Тогда
		Если НЕ ЗначениеЗаполнено(Объект.РаспоряжениеКонфигуратор) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не указано распоряжение";
			Сообщение.ПутьКДанным = "Объект.РаспоряжениеКонфигуратор";
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

