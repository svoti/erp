		Объект.РежимФормированияЗаданий = 0;
		Объект.ЗаполнятьПлан = Истина;
	Иначе
		Объект.РежимФормированияЗаданий = 2;
		Объект.ЗаполнятьПлан = Ложь;
	КонецЕсли;
	
	СформироватьНаименование();
	
	РаспоряжениеКонфигураторПриИзмененииСервер();
	//УстановитьНастройкиСКДДокументовЗаданияКладовщику(Объект.ЗаданиеКладовщикуРаспоряжение);
	УстановитьНастройкиСКДОснованияПоУмолчаниюНаСервере();
	УстановитьНастройкиСКДШапкиПоУмолчаниюНаСервере(Объект.ОперацияНазначение);
	УстановитьНастройкиСКДТоварыПоУмолчаниюНаСервере();
	УправлениеЭлементамиФормы();
		
КонецПроцедуры

