&НаСервере
Функция ТестированиеПолучитьДанныеНаСервере()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбщегоНазначения.СообщитьПользователю("Необходимо записать правило");
		Возврат Новый Структура;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Правило = РеквизитФормыВЗначение("Объект");
	Правило.ХранилищеДанныеСКД = Справочники.вмс_ИсточникиДанных.ИсточникДанных("ХранилищеДанныеСКД", Объект.Ссылка);
	
	//////////////////////////////////////////////////////
	Если ЗначениеЗаполнено(ТестированиеРегистратор) Тогда
		Распоряжения = вмс_ФормированиеЗаданийКладовщикам.ПолучитьРаспоряженияДляФормированияЗадачиПоПравилу(Правило, ТестированиеРегистратор);
	Иначе
		Распоряжения = Новый Массив;
		Распоряжения.Добавить(ТестированиеРаспоряжение);
	КонецЕсли;
	ТаблицаРаспоряжений = вмс_РаботаСКоллекциями.ЗначениеВТаблицуЗначений(Распоряжения, "Ссылка");
	
	//////////////////////////////////////////////////////
	ТаблицаПлана = вмс_ФормированиеЗаданийКладовщикам.ПолучитьТаблицуПланПоРаспоряжению(Правило, Распоряжения);
	
	//////////////////////////////////////////////////////
	ТаблицаШапок = вмс_ФормированиеЗаданийКладовщикам.ПолучитьТаблицуШапокЗаданийПоРаспоряжению(Правило, Распоряжения, ТаблицаПлана);
	
	//////////////////////////////////////////////////////
	Если ТаблицаРаспоряжений <> Неопределено Тогда
		Результат.Вставить("Распоряжения", РаботаССКД.ВывестиТаблицуЗначенийВТабличныйДокумент(ТаблицаРаспоряжений));
	КонецЕсли;
	
	Если ТаблицаШапок <> Неопределено Тогда
		Результат.Вставить("Шапки", РаботаССКД.ВывестиТаблицуЗначенийВТабличныйДокумент(ТаблицаШапок));
	КонецЕсли;
	
	Если ТаблицаПлана <> Неопределено Тогда
		Результат.Вставить("План", РаботаССКД.ВывестиТаблицуЗначенийВТабличныйДокумент(ТаблицаПлана));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РедактироватьСКДЗаданияКладовщику(Команда)
	
	Распоряжение = Объект.ЗаданиеКладовщикуРаспоряжение;
	
	Если Распоряжение <> "" Тогда
		ОО = Новый ОписаниеОповещения("СохранитьНастройкиРедактораЗаданийКладовщику",ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ФормаРедакторНастроекСКД", Новый Структура("СКД", АдресДанныеСКДЗаданияКладовщику),ЭтаФорма,,,,ОО);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран документ - основание");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СохранитьНастройкиРедактораЗаданийКладовщику(АдресСхемыРедактора, ДополнительныеПараметры) Экспорт
	
	Если АдресСхемыРедактора = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СхемыКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыРедактора);
	АдресДанныеСКДЗаданияКладовщику = СохранитьСКД(СхемыКомпоновкиДанных, АдресДанныеСКДЗаданияКладовщику);
	ЭтаФорма.Модифицированность = Истина;
	
	Возврат Истина;
	
КонецФункции  

