&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	спрОбъект = РеквизитФормыВЗначение("Объект");   
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		СКДТовары = Параметры.ЗначениеКопирования.ХранилищеСКДТовары.Получить();
		СКДДокументы = Параметры.ЗначениеКопирования.ХранилищеСКДДокументы.Получить();
	Иначе
		СКДТовары = спрОбъект.ХранилищеСКДТовары.Получить();
		СКДДокументы = спрОбъект.ХранилищеСКДДокументы.Получить();
	КонецЕсли;

	ЭтотОбъект.АдресСКДТовары = СохранитьСКД(СКДТовары, АдресСКДТовары); 
	АдресСКДДокументы = СохранитьСКД(СКДДокументы, АдресСКДДокументы);
	
	Элементы.РаспоряжениеКонфигуратор.СписокВыбора.Очистить();
	вмс_РаботаСКоллекциями.ДобавитьЭлементыКоллекции(Элементы.РаспоряжениеКонфигуратор.СписокВыбора, ПолучитьСписокДокументовКонфигурации()); 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ЭтотОбъект.Объект.РаспоряжениеКонфигуратор <> "" Тогда
		ИнициализацияСекцииПросмотраРезультатов();
	КонецЕсли;               
	
	Операция = ЭтотОбъект.Объект.ОперацияДляПросмотраРезультата;  
	
КонецПроцедуры

&НаКлиенте
Процедура РаспоряжениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	РаспоряжениеОбработкаВыбораСервер(ВыбранноеЗначение);   
	
	ИнициализацияСекцииПросмотраРезультатов();
КонецПроцедуры 

&НаСервере
Процедура РаспоряжениеОбработкаВыбораСервер(ВыбранноеЗначение)
	ЭтотОбъект.Объект.РаспоряжениеКонфигуратор = ВыбранноеЗначение;	
	ЭтотОбъект.Объект.Наименование = Строка(Метаданные.НайтиПоПолномуИмени(ВыбранноеЗначение));
	
	спрОбъект = РеквизитФормыВЗначение("Объект");
	
	СКДТовары = спрОбъект.ПолучитьСКДСпискаТоваровДокумента(Ложь); 
	АдресСКДТовары = СохранитьСКД(СКДТовары, АдресСКДТовары);                    
	
	СКДДокументы = спрОбъект.ПолучитьСКДДокументы(Ложь); 
	АдресСКДДокументы = СохранитьСКД(СКДДокументы, АдресСКДДокументы);    
КонецПроцедуры 
	
&НаСервере
Функция ПолучитьСписокДокументовКонфигурации()
	
	Перем Строка;
	
	СписокДокументов = Новый СписокЗначений;
	ДопустимыеИменаТабличныхЧастей = Новый Массив;
	
	// ТУ_Мовчан 12.12.23 ++
	ИменаТабличныхЧастей = вмс_АдаптацияКонфигураций.ПолучитьИмяТабличнойЧасти();
	Если Тип("Массив") = ТипЗнч(ИменаТабличныхЧастей) Тогда
		Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
			ДопустимыеИменаТабличныхЧастей.Добавить(ИмяТабличнойЧасти);
		КонецЦикла;
	Иначе
		ДопустимыеИменаТабличныхЧастей.Добавить(ИменаТабличныхЧастей);
	КонецЕсли;
	// ТУ_Мовчан 12.12.23 --
	//ДопустимыеИменаТабличныхЧастей.Добавить(вмс_АдаптацияКонфигураций.ПолучитьИмяТабличнойЧасти()); 
	ДопустимыеИменаТабличныхЧастей.Добавить(вмс_АдаптацияКонфигураций.ПолучитьИмяТабличнойЧастиПродукция());
	ДопустимыеИменаТабличныхЧастей.Добавить("ДокументыОтгрузки"); //Маршрутные листы  
	
	Для каждого Строка Из Метаданные.Документы Цикл
		Если ЗначениеЗаполнено(Строка.ТабличныеЧасти) Тогда
			
			Для каждого ТабличнаяЧасть Из Строка.ТабличныеЧасти Цикл
				Если ДопустимыеИменаТабличныхЧастей.Найти(ТабличнаяЧасть.Имя) <> Неопределено Тогда
					СписокДокументов.Добавить(Строка.ПолноеИмя(), Строка.Синоним);
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокДокументов;
	
КонецФункции
   
&НаКлиенте
Процедура ИнициализацияСекцииПросмотраРезультатов()
	Массив = Новый Массив(); 
	Массив.Добавить(Тип(СтрЗаменить(ЭтотОбъект.Объект.РаспоряжениеКонфигуратор, "Документ", "ДокументСсылка"))); 
	ТипыРаспоряжений = Новый ОписаниеТипов(Массив);
	
	Элементы.Документ.ОграничениеТипа = ТипыРаспоряжений; 
	Документ = ТипыРаспоряжений.ПривестиЗначение(Документ); 	                           
КонецПроцедуры

