&НаСервере
Функция ПросмотрРезультатовДокументыНаСервере()
	ВходящиеПараметры = Новый Структура(); 
	Если Оператор <> Справочники.вмс_НастройкиОператора.ПустаяСсылка() Тогда
		ВходящиеПараметры.Вставить("Оператор", Оператор);
	КонецЕсли;
	
	ТабДок = Справочники.вмс_РаспоряженияОпераций.ПолучитьДанныеПоРаспоряжению(Операция, ЭтотОбъект.Объект.Ссылка, ВходящиеПараметры, Истина);   
		
	Возврат ТабДок;
КонецФункции

