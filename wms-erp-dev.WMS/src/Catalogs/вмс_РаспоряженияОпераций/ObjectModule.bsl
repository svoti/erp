Функция ПолучитьПервуюЧастьЗапросаТовары(ПсевдонимТаблицы, ИмяТаблицы, ДобавитьПсевдонимПоля, СтандартныеРеквизиты, РеквизитыСПсевдонимами)    
	Текст = "ВЫБРАТЬ";
	Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
		Текст = Текст + Символы.ПС + Символы.Таб + ПсевдонимТаблицы + "." + Реквизит;
		Если ДобавитьПсевдонимПоля Тогда
			Текст = Текст + " КАК " + Реквизит + ",";
		Иначе
			Текст = Текст + ",";
		КонецЕсли;
	КонецЦикла;  
	
	Если РеквизитыСПсевдонимами <> Неопределено Тогда
		Для Каждого Реквизит Из РеквизитыСПсевдонимами Цикл
			Текст = Текст + Символы.ПС + Символы.Таб + ПсевдонимТаблицы + "." + Реквизит.Значение;
			Если ДобавитьПсевдонимПоля Тогда
				Текст = Текст + " КАК " + Реквизит.Ключ + ",";
			Иначе
				Текст = Текст + ",";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Текст = Лев(Текст, СтрДлина(Текст) - 1); //Убрать запятую
	
	Если ДобавитьПсевдонимПоля Тогда
		Текст = Текст + Символы.ПС + "ПОМЕСТИТЬ " + ПсевдонимТаблицы;
	КонецЕсли;
	
	Текст = Текст + Символы.ПС + "ИЗ";
	Текст = Текст + Символы.ПС + Символы.Таб + ИмяТаблицы + " КАК " + ПсевдонимТаблицы;   
	
	Возврат Текст;
КонецФункции	

Функция ПолучитьВторуюЧастьЗапросаТовары(ПсевдонимТаблицы, СтандартныеРеквизиты, РеквизитыСПсевдонимами, Условия)    
	Текст = "ВЫБРАТЬ";
	Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
		Если Реквизит = "Количество" Тогда
			Текст = Текст + Символы.ПС + Символы.Таб + "СУММА(" + ПсевдонимТаблицы + ".Количество)"; 
		Иначе
			Текст = Текст + Символы.ПС + Символы.Таб + ПсевдонимТаблицы + "." + Реквизит;  
		КонецЕсли; 
		
		Если Реквизит = "Номенклатура" Тогда
			Текст = Текст + " КАК Товар,";
		Иначе
			Текст = Текст + " КАК " + Реквизит + ",";
		КонецЕсли;
	КонецЦикла;
	
	Если РеквизитыСПсевдонимами <> Неопределено Тогда
		Для Каждого Реквизит Из РеквизитыСПсевдонимами Цикл
			Текст = Текст + Символы.ПС + Символы.Таб + ПсевдонимТаблицы + "." + Реквизит.Значение;
			Текст = Текст + " КАК " + Реквизит.Ключ + ",";
		КонецЦикла;
	КонецЕсли;
		
	Текст = Лев(Текст, СтрДлина(Текст) - 1); //Убрать запятую
	
	Текст = Текст + Символы.ПС + "ИЗ";
	Текст = Текст + Символы.ПС + Символы.Таб + ПсевдонимТаблицы + " КАК " + ПсевдонимТаблицы;   
	
	Если Условия <> Неопределено Тогда                                                                                                                     
		Текст = Текст + Символы.ПС + "ГДЕ"; 
		Текст = Текст + Символы.ПС + Условия;
	КонецЕсли;  
	
	Текст = Текст + Символы.ПС + "СГРУППИРОВАТЬ ПО"; 
	Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
		Если Реквизит <> "Количество" Тогда
			Текст = Текст + Символы.ПС + Символы.Таб + ПсевдонимТаблицы + "." + Реквизит + ",";
		КонецЕсли;
	КонецЦикла;
	
	Если РеквизитыСПсевдонимами <> Неопределено Тогда
		Для Каждого Реквизит Из РеквизитыСПсевдонимами Цикл
			Текст = Текст + Символы.ПС + Символы.Таб + ПсевдонимТаблицы + "." + Реквизит.Значение + ",";
		КонецЦикла;
	КонецЕсли;
	
	Текст = Лев(Текст, СтрДлина(Текст) - 1); //Убрать запятую
	
	Возврат Текст;
КонецФункции

