Функция ПолучитьТаблицыЗапросаОстатковБезПустыхКолонок(ОбщаяТаблицаЗапроса, ПоляСПустымиЗначениями)

	РК = вмс_РаботаСКоллекциями;
	
	ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамКлиентСервер.ИспользуемыеТоварныеПоля();
	РК.ВычестьМассив(ТоварныеПоляМассив, "Упаковка");

	ПустойТовар = вмс_ОбщегоНазначенияВызовСервера.ПолучитьПустуюСсылкуНаТовар();
	ПустаяЯчейка = ПредопределенноеЗначение("Справочник.вмс_МестаХранения.ПустаяСсылка");
	ПустойКонтейнер = ПредопределенноеЗначение("Справочник.вмс_Контейнеры.ПустаяСсылка");

	ПустыеЗначенияПолей = Новый Соответствие;
	ПустыеЗначенияПолей["Ячейка"] = ПустаяЯчейка;
	ПустыеЗначенияПолей["Товар"] = ПустойТовар;
	ПустыеЗначенияПолей["Контейнер"] = Неопределено;
	
	ПоляСПустымиЗначениямиМассив = РК.ЗначениеВМассив(ПоляСПустымиЗначениями, , Ложь);
	
	КоличествоПолейСПустымиЗначениями = ПоляСПустымиЗначениямиМассив.Количество();
	КоличествоКомбинаций = pow(2, КоличествоПолейСПустымиЗначениями)-1;
	
	ТаблицыЗапроса = Новый Массив;
	Для НомерКомбинации=0 По КоличествоКомбинаций-1 Цикл
		СписокКолонокМассив = Новый Массив;
		Разряды = РК.РазложитьЧислоНаРазряды(НомерКомбинации, 2, КоличествоПолейСПустымиЗначениями);
		Для НомерПоля=0 По КоличествоПолейСПустымиЗначениями-1 Цикл
			Если Разряды[НомерПоля]=0 Тогда
				Поле = ПоляСПустымиЗначениямиМассив[НомерПоля];
				Если Поле="Товар" Тогда
					// добавим товар со всеми товарными полями
					РК.ДобавитьЭлементыКоллекции(СписокКолонокМассив, ТоварныеПоляМассив);
				Иначе
					СписокКолонокМассив.Добавить(Поле);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		СписокКолонок = РК.МассивВСтроку(СписокКолонокМассив);
		ТаблицаЗапроса = ОбщаяТаблицаЗапроса.СкопироватьКолонки(СписокКолонок);
		ТаблицыЗапроса.Добавить(ТаблицаЗапроса);
	КонецЦикла;
	
	Для Каждого СтрокаЗапроса Из ОбщаяТаблицаЗапроса Цикл
		
		НомерКомбинации = 0;
		МножительРазряда = 1;
		Для НомерПоля=0 По КоличествоПолейСПустымиЗначениями-1 Цикл
			Поле = ПоляСПустымиЗначениямиМассив[НомерПоля];
			Если СтрокаЗапроса[Поле]=ПустыеЗначенияПолей[Поле] Тогда
				НомерКомбинации = НомерКомбинации + МножительРазряда;
			КонецЕсли;
			МножительРазряда = МножительРазряда * 2;
		КонецЦикла;
		
		Если НомерКомбинации > КоличествоКомбинаций-1 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаЗапроса = ТаблицыЗапроса[НомерКомбинации].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаЗапроса, СтрокаЗапроса);
		
	КонецЦикла;
	
	Возврат ТаблицыЗапроса;
	
КонецФункции
