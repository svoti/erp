Функция ПолучитьДанныеИзБД(Запрос, ДополнительныеПараметры=Неопределено) Экспорт
	
	Перем РК, ОЯ, ПУ;
	
	РК = вмс_РаботаСКоллекциями;
	ОЯ = вмс_ОперацииПоЯчейкамСервер;
	ПУ = вмс_ПартионныйУчетСервер;
	
	Если ТипЗнч(ДополнительныеПараметры)=Тип("Структура") Тогда
		Если ДополнительныеПараметры.Свойство("ДокументОперации") Тогда
			ДокументОперации = ДополнительныеПараметры.ДокументОперации;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("Дата") Тогда
			Дата = ДополнительныеПараметры.Дата;
		КонецЕсли;
	КонецЕсли;
	
	Если РК.ЭтоКвазиТаблицаЗначений(Запрос.ТаблицаЗапросаОстатковТоваровВЯчейках) Тогда
		Запрос.ТаблицаЗапросаОстатковТоваровВЯчейках = РК.ВыгрузитьКвазиТаблицуЗначенийВИстиннуюТаблицуЗначений(Запрос.ТаблицаЗапросаОстатковТоваровВЯчейках);
		РК.ТипизироватьТаблицуЗначений(Запрос.ТаблицаЗапросаОстатковТоваровВЯчейках);

		Запрос.ТаблицаЗапросаОстатковКонтейнеровВЯчейках = РК.ВыгрузитьКвазиТаблицуЗначенийВИстиннуюТаблицуЗначений(Запрос.ТаблицаЗапросаОстатковКонтейнеровВЯчейках);
		РК.ТипизироватьТаблицуЗначений(Запрос.ТаблицаЗапросаОстатковКонтейнеровВЯчейках);

		Запрос.ТаблицаЗапросаОстатковТоваровВКонтейнерах = РК.ВыгрузитьКвазиТаблицуЗначенийВИстиннуюТаблицуЗначений(Запрос.ТаблицаЗапросаОстатковТоваровВКонтейнерах);
		РК.ТипизироватьТаблицуЗначений(Запрос.ТаблицаЗапросаОстатковТоваровВКонтейнерах);

		Запрос.ТаблицаЗапросаМестоположенийКонтейнеров = РК.ВыгрузитьКвазиТаблицуЗначенийВИстиннуюТаблицуЗначений(Запрос.ТаблицаЗапросаМестоположенийКонтейнеров);
		РК.ТипизироватьТаблицуЗначений(Запрос.ТаблицаЗапросаМестоположенийКонтейнеров);
	КонецЕсли;

	МассивКонтейнеров = Новый Массив;
	РК.ДобавитьЭлементыКоллекции(МассивКонтейнеров, РК.ВыгрузитьЗначенияКолонкиКоллекции(Запрос.ТаблицаЗапросаМестоположенийКонтейнеров, "Контейнер"));
	РК.ДобавитьЭлементыКоллекции(МассивКонтейнеров, РК.ВыгрузитьЗначенияКолонкиКоллекции(Запрос.ТаблицаЗапросаОстатковКонтейнеровВЯчейках, "Контейнер"));
	ДополнительныеПараметрыПолученияМестоположенийКонтейнеров = Новый Структура;
	ДополнительныеПараметрыПолученияМестоположенийКонтейнеров.Вставить("ИсключитьРегистраторы", ДокументОперации);
	ДополнительныеПараметрыПолученияМестоположенийКонтейнеров.Вставить("Дата", Дата);
	ТаблицаМестоположенийКонтейнеров = ПУ.ПолучитьМестоположенияКонтейнеров(МассивКонтейнеров, ДополнительныеПараметрыПолученияМестоположенийКонтейнеров);

	ТаблицаЗапросаОстатковТоваровВЯчейках = Запрос.ТаблицаЗапросаОстатковТоваровВЯчейках.Скопировать();
	РК.ДобавитьЭлементыКоллекции(ТаблицаЗапросаОстатковТоваровВЯчейках, Запрос.ТаблицаЗапросаОстатковКонтейнеровВЯчейках);
	ТаблицаОстатковТоваровВЯчейках = ПолучитьТаблицуОстатковВЯчейках(ТаблицаЗапросаОстатковТоваровВЯчейках, ДополнительныеПараметры);
	
	ТаблицаОстатковТоваровВКонтейнерах = ПолучитьТаблицуОстатковВКонтейнерах(Запрос.ТаблицаЗапросаОстатковТоваровВКонтейнерах, ДополнительныеПараметры);
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаОстатковТоваровВЯчейках", ТаблицаОстатковТоваровВЯчейках);
	Результат.Вставить("ТаблицаМестоположенийКонтейнеров", ТаблицаМестоположенийКонтейнеров);
	Результат.Вставить("ТаблицаОстатковТоваровВКонтейнерах", ТаблицаОстатковТоваровВКонтейнерах);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуОстатковВЯчейках(ОбщаяТаблицаЗапроса, ДополнительныеПараметры)
	
	РК = вмс_РаботаСКоллекциями;
	ОЯ = вмс_ОперацииПоЯчейкамСервер;

	ПараметрыПолученияОстатков = Новый Структура;
	ПараметрыПолученияОстатков.Вставить("ИспользуемыеПоля", "Контейнер");
	Если ТипЗнч(ДополнительныеПараметры)=Тип("Структура") Тогда
		Если ДополнительныеПараметры.Свойство("ДокументОперации") Тогда
			ПараметрыПолученияОстатков.Вставить("ТекущиеДокументы", ДополнительныеПараметры.ДокументОперации);
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("Дата") Тогда
			ПараметрыПолученияОстатков.Вставить("Дата", ДополнительныеПараметры.Дата);
		КонецЕсли;
	КонецЕсли;

	ТаблицыЗапроса = ПолучитьТаблицыЗапросаОстатковБезПустыхКолонок(ОбщаяТаблицаЗапроса, "Товар, Ячейка, Контейнер");
	
	ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамКлиентСервер.ИспользуемыеТоварныеПоля();
	РК.ВычестьМассив(ТоварныеПоляМассив, "Упаковка");

	СписокКолонокМассив = Новый Массив;
	РК.ДобавитьЭлементыКоллекции(СписокКолонокМассив, ТоварныеПоляМассив);
	РК.ДобавитьЭлементыКоллекции(СписокКолонокМассив, "Ячейка, Контейнер, Количество");

	ОбщаяТаблицаОстатковТоваровВЯчейках = РК.НоваяТаблицаЗначений(СписокКолонокМассив);
	Для Каждого ТаблицаЗапроса Из ТаблицыЗапроса Цикл
		Если ТаблицаЗапроса.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыПолученияОстатков.Вставить("Товары", ТаблицаЗапроса);
		ТаблицаОстатковТоваровВЯчейках = ОЯ.ПолучитьТаблицуОстатковВЯчейкахЧерезСтруктуру(ПараметрыПолученияОстатков);
		РК.ДобавитьЭлементыКоллекции(ОбщаяТаблицаОстатковТоваровВЯчейках, ТаблицаОстатковТоваровВЯчейках);
	КонецЦикла;
	
	Возврат ОбщаяТаблицаОстатковТоваровВЯчейках;
	
КонецФункции

