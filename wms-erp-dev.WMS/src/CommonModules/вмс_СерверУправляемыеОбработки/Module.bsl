КонецФункции

Функция ПолучитьИмяМодуляОбработки(ПараметрыОбработки, Модуль) Экспорт

	ЭлементМодуляМассив = ПараметрыОбработки.МодулиОбработки.НайтиСтроки(Новый Структура("Модуль", Модуль));
	
	Если ЭлементМодуляМассив.Количество() > 0 Тогда
		
		Возврат ЭлементМодуляМассив[0].ИмяМодуля;
		
	КонецЕсли;
	
КонецФункции

Функция ЭтоСлужебныйМодуль(знач Модуль) Экспорт
	
	Если ТипЗнч(Модуль)=Тип("Строка") Тогда
		ИмяМодуля = Модуль;
		Модуль = Обработки[ИмяМодуля].Создать();
	КонецЕсли;
	
	Попытка
		Результат = Модуль.ВыполнитьДействие(Действие("ПроверитьЭтоСлужебныйМодуль"));
	Исключение
	КонецПопытки;
	
	Возврат Результат=Истина;
	
КонецФункции

Функция НовыйОписаниеОповещения(ИмяПроцедуры, ПараметрыОбработки, Модуль, ДополнительныеПараметры=Неопределено, ИмяПроцедурыОбработкиОшибки=Неопределено, МодульОбработкиОшибки=Неопределено) Экспорт
	
	Если ПараметрыОбработки.Идентификатор <> Неопределено Тогда
		ИмяМодуля = ПолучитьИмяМодуляОбработки(ПараметрыОбработки, Модуль);
	Иначе
		ИмяМодуля = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьИмяМенеджераОбъектаПоИмениТипа(вмс_ОбщегоНазначенияКлиентСервер.ПолучитьИмяОбъекта(Модуль));
	КонецЕсли;
	
	ОО = вмс_ОбщегоНазначенияКлиентСервер.НовыйОписаниеОповещения(ИмяПроцедуры, Неопределено, ДополнительныеПараметры, ИмяПроцедурыОбработкиОшибки, МодульОбработкиОшибки);
	ОО.Вставить("ИдентификаторОбработки", ПараметрыОбработки.Идентификатор);
	ОО.Вставить("ИмяМодуля", ИмяМодуля); //объект не получится сохранить в хранилище, сохраним имя объекта
	ОО.Вставить("ЭтоПередаточныйОбработчикОповещения", Ложь);
	Возврат ОО;
	
КонецФункции

Функция ВыполнитьОбработкуОповещенияПереопределенный(знач ОписаниеОповещения, Результат=Неопределено) Экспорт
	
	ОписаниеОповещения = вмс_РаботаСКоллекциями.СкопироватьСтруктуру(ОписаниеОповещения);
	
	Если ОписаниеОповещения.ИдентификаторОбработки <> Неопределено Тогда
		ПараметрыОбработки = ПараметрыОбработки(ОписаниеОповещения.ИдентификаторОбработки);
		ОписаниеОповещения.Модуль = ПолучитьМодульОбработки(ПараметрыОбработки, ОписаниеОповещения.ИмяМодуля);
	Иначе
		ОписаниеОповещения.Модуль = Вычислить(ОписаниеОповещения.ИмяМодуля);
	КонецЕсли;
	
	вмс_ОбщегоНазначенияКлиентСервер.ВыполнитьОбработкуОповещенияПереопределенный(ОписаниеОповещения, Результат);
	
КонецФункции

Функция ДействиеПередатьДанныеСеанса(Действие)
	
	ПараметрыОбработок = ПараметрыОбработок();
	
	ПараметрыОбработки = ПараметрыОбработки(Действие.ИдентификаторОбработки);
	ДанныеСеанса = вмс_ОбщегоНазначенияВызовСервера.ПолучитьДанныеСеанса();
	
	ДобавитьДействиеНаКлиенте(ПараметрыОбработки, "ПолучитьДанныеСеанса", ДанныеСеанса);
	
КонецФункции

Функция ЗавершитьРаботуОбработки(ПараметрыОбработки, Результат=Неопределено) Экспорт
	
	ПараметрыЗавершения = Новый Структура;
	ПараметрыЗавершения.Вставить("Отказ", Ложь);
	ПараметрыЗавершения.Вставить("Результат", Результат);
	ВыполнитьДействиеПереопределяемый(Действие("ПриЗавершенииРаботы", ПараметрыЗавершения, , ПараметрыОбработки));
	
	Если ПараметрыЗавершения.Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыОбработки.ФормаОткрыта Тогда
		ПараметрыОбработки.ФормаОткрыта = Ложь;
		ДобавитьДействиеНаКлиенте(ПараметрыОбработки, "Закрыть");
	КонецЕсли;

	Если ПараметрыОбработки.ОписаниеОповещенияПриЗакрытии <> Неопределено Тогда
		СостояниеВызываемойОбработки = СостояниеОбработки(ПараметрыОбработки.ОписаниеОповещенияПриЗакрытии.ИдентификаторОбработки);
		Если СостояниеВызываемойОбработки <> Неопределено Тогда
			ВыполнитьОбработкуОповещенияПереопределенный(ПараметрыОбработки.ОписаниеОповещенияПриЗакрытии, ПараметрыЗавершения.Результат);
		КонецЕсли;
	КонецЕсли;
	
	УдалитьОбработку(ПараметрыОбработки.Идентификатор);
	
КонецФункции

Функция ДобавитьДействиеНаКлиенте(ПараметрыОбработки, КодДействия, знач ПараметрыДействия=Неопределено) Экспорт
	
	ДействияНаКлиенте().Добавить(Действие(КодДействия, ПараметрыДействия, ПараметрыОбработки.Идентификатор));
	
КонецФункции

Функция ДействияНаКлиенте() Экспорт
	
	Возврат ПараметрыОбработок().РезультатДействия.ДействияНаКлиенте;
	
КонецФункции

Функция ДобавитьОшибкуДействия(ОписаниеОшибки) Экспорт
	
	РезультатДействия = ПараметрыОбработок().РезультатДействия;
	
	РезультатДействия.Ошибка = Истина;
	РезультатДействия.ОписанияОшибок.Добавить(ОписаниеОшибки);
	
КонецФункции

Функция ОшибкаДействия() Экспорт
	
	Возврат ПараметрыОбработок().РезультатДействия.Ошибка;
	
КонецФункции

Функция Действие(Источник, знач ПараметрыДействия=Неопределено, знач ИдентификаторОбработки=Неопределено, знач ПараметрыОбработки=Неопределено, МодульВызова=Неопределено) Экспорт
	
	Если ПараметрыОбработки <> Неопределено Тогда
		ИдентификаторОбработки = ПараметрыОбработки.Идентификатор;
	КонецЕсли;
	
	Сеанс = Новый Структура("НомерСеанса, НачалоСеанса");
	Если ТипЗнч(Источник)=Тип("Строка") Тогда
		Код = Источник;
	ИначеЕсли ТипЗнч(Источник)=Тип("Структура") Тогда
		Код = Источник.Код;
		Если ПараметрыДействия=Неопределено Тогда
			ПараметрыДействия = Источник.Параметры;
		КонецЕсли;
		
		Если ИдентификаторОбработки=Неопределено Тогда
			ИдентификаторОбработки = Источник.ИдентификаторОбработки;
		КонецЕсли;
		
		Если Источник.Свойство("Сеанс") Тогда
			ЗаполнитьЗначенияСвойств(Сеанс, Источник.Сеанс);
		КонецЕсли;
	КонецЕсли;
	
	Действие = Новый Структура;
	Действие.Вставить("Сеанс", Сеанс);
	Действие.Вставить("ИдентификаторОбработки", ИдентификаторОбработки);
	Действие.Вставить("ПараметрыОбработки", ПараметрыОбработки); //явная передача параметров обработки на случай если обработка еще не добавлена в пул обработок
	Действие.Вставить("Код", Код);
	Действие.Вставить("Параметры", ПараметрыДействия);
	Действие.Вставить("СтандартнаяОбработка", Истина);
	Действие.Вставить("ОбрабатыватьПосле", Ложь);
	Действие.Вставить("ОбработкаПосле", Ложь);
	Действие.Вставить("Обработано", Ложь);
	Действие.Вставить("Закончить", Истина);
	Действие.Вставить("МодульВызова", МодульВызова);
	Действие.Вставить("Результат");
	
	Возврат Действие;
	
КонецФункции

Функция УстановитьРезультатДействия(Действие, Результат=Неопределено) Экспорт
	
	Действие.Результат = Результат;
	Действие.Обработано = Истина;
	
	Возврат Действие.Результат;
	
КонецФункции

Функция ДействиеВыполняетсяПосле(Действие) Экспорт

	Если НЕ Действие.ОбработкаПосле Тогда
		Действие.ОбрабатыватьПосле = Истина;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция РезультатДействия(Результат=Неопределено) Экспорт
	
	Сеанс = Новый Структура("НомерСеанса, НачалоСеанса");
	
	РезультатДействия = Новый Структура;
	РезультатДействия.Вставить("Сеанс", Сеанс);
	РезультатДействия.Вставить("Результат", Результат);
	РезультатДействия.Вставить("РегистрацияНовыхОбработок", Новый Массив);
	РезультатДействия.Вставить("ДействияНаКлиенте", Новый Массив);
	РезультатДействия.Вставить("Ошибка", Ложь);
	РезультатДействия.Вставить("ОписанияОшибок", Новый Массив);
	
	Возврат РезультатДействия;
	
КонецФункции
