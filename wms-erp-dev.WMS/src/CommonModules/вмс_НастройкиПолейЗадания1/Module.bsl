//						Конструирование +
//

#Область Конструирование

Функция НовыеПараметрыКонструирования()
	
	ПараметрыКонструирования = Новый Структура;	
	ПараметрыКонструирования.Вставить("Начато", Ложь);
	ПараметрыКонструирования.Вставить("СтраницыВводаДанных", Новый Массив);
	ПараметрыКонструирования.Вставить("СборщикиДанных", Новый Массив);
	ПараметрыКонструирования.Вставить("НовыеЭлементы", Новый Массив);
	
	Возврат ПараметрыКонструирования;
	
КонецФункции

Функция ПараметрыКонструирования(Настройка)
	
	Возврат Настройка.ДополнительныеДанные.ПараметрыКонструирования;
	
КонецФункции

Функция ПараметрыПродолженияКонструирования(Настройка)
	
	ПараметрыКонструирования = ПараметрыКонструирования(Настройка);
	
	Если НЕ ПараметрыКонструирования.Начато Тогда
		ВызватьИсключение "Конструирование не начато";
	КонецЕсли;
	
	Возврат ПараметрыКонструирования;
	
КонецФункции

Функция НачатьКонструированиеЭлементов(Настройка) Экспорт
	
	ПараметрыКонструирования = ПараметрыКонструирования(Настройка);
	
	Если ПараметрыКонструирования.Начато Тогда
		ВызватьИсключение "Не завершено предыдущее конструирование";
	КонецЕсли;
	
	ПараметрыКонструирования.Начато = Истина;
	ПараметрыКонструирования.СтраницыВводаДанных.Очистить();
	ПараметрыКонструирования.СборщикиДанных.Очистить();
	ПараметрыКонструирования.НовыеЭлементы.Очистить();
	
	Возврат Истина;
	
КонецФункции

Функция КонструированиеСтраницыВводаДанных(Настройка, СтраницаВвода)

	ПараметрыКонструирования = ПараметрыКонструирования(Настройка);

	Если НЕ ПараметрыКонструирования.Начато Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачатьКонструированиеСтраницыВводаДанных(Настройка, СтраницаВвода);
	
	Возврат Истина;
		
КонецФункции

Функция НачатьКонструированиеСтраницыВводаДанных(Настройка, знач СтраницаВвода) Экспорт

	РК = вмс_РаботаСКоллекциями;

	ПараметрыКонструирования = ПараметрыПродолженияКонструирования(Настройка);
	
	Если ТипЗнч(СтраницаВвода)=Тип("Строка") Тогда
		ИмяСтраницы = СтраницаВвода;
		СтраницаВвода = СформироватьИмяСтраницыВводаДанных(СтраницаВвода);
	КонецЕсли;
	
	СтраницаВвода = Элемент(Настройка, СтраницаВвода, "ЭлементыВывода");
	Если СтраницаВвода=Неопределено Тогда
		ПараметрыКонструирования.Начато = Ложь;
		Если ИмяСтраницы <> Неопределено Тогда
			ВызватьИсключение "Не найдена страница ввода данных """ + ИмяСтраницы + """";
		Иначе
			ВызватьИсключение "Не указана страница ввода данных";
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыКонструирования.СтраницыВводаДанных.Добавить(СтраницаВвода.ПолноеИмя);
	
	РК.УстановитьЭлементыКоллекции(ПараметрыКонструирования.СборщикиДанных, ПолучитьСписокЗначенийСвойстваЭлемента(Настройка, СтраницаВвода, "СборщикиДанных"));

КонецФункции

Функция ЗакончитьКонструированиеСтраницыВводаДанных(Настройка, знач СтраницаВвода=Неопределено) Экспорт

	РК = вмс_РаботаСКоллекциями;

	ПараметрыКонструирования = ПараметрыПродолженияКонструирования(Настройка);
	СтраницыВводаДанных = ПараметрыКонструирования.СтраницыВводаДанных;
	Если СтраницыВводаДанных.Количество()=0 Тогда
		ВызватьИсключение "Не указана страница ввода данных";
		Возврат Ложь;
	КонецЕсли;
	
	Если СтраницаВвода=Неопределено Тогда
		ИмяСтраницы = СтраницыВводаДанных[СтраницыВводаДанных.Количество()-1];
	ИначеЕсли ТипЗнч(СтраницаВвода)=Тип("Строка") Тогда
		ИмяСтраницы = СформироватьИмяСтраницыВводаДанных(СтраницаВвода);
	Иначе
		ИмяСтраницы = Неопределено;
	КонецЕсли;
	
	Если ИмяСтраницы <> Неопределено Тогда
		ЭлементСтраницыВвода = Элемент(Настройка, ИмяСтраницы, "ЭлементыВывода");
	Иначе
		ЭлементСтраницыВвода = СтраницаВвода;
	КонецЕсли;
	
	СборщикиДанныхСтраницы = ПолучитьСписокЗначенийСвойстваЭлемента(Настройка, ЭлементСтраницыВвода, "СборщикиДанных");
	
	РК.ВычестьМассив(СтраницыВводаДанных, ЭлементСтраницыВвода.ПолноеИмя);
	
	ЭлементыСтраницВводаДанных = Элементы(Настройка, СтраницыВводаДанных, "ЭлементыВывода");
	
	СборщикиДанныхСтраниц = Новый Массив;
	Для Каждого ЭлементСтраницВводаДанных Из ЭлементыСтраницВводаДанных Цикл
		
		РК.ДобавитьЭлементыКоллекции(СборщикиДанныхСтраниц, ПолучитьСписокЗначенийСвойстваЭлемента(Настройка, ЭлементСтраницВводаДанных, "СборщикиДанных"));
		
	КонецЦикла;
	РК.УдалитьДублиВМассиве(СборщикиДанныхСтраниц);
	
	УдаляемыеСборщики = РК.ВычитаниеМассивов(СборщикиДанныхСтраницы, СборщикиДанныхСтраниц);
	
	РК.ВычестьМассив(ПараметрыКонструирования.СборщикиДанных, УдаляемыеСборщики);

КонецФункции

Функция КонструированиеЭлементаВывода(Настройка, ЭлементВывода)
	
	ПараметрыКонструирования = ПараметрыКонструирования(Настройка);

	Если НЕ ПараметрыКонструирования.Начато Тогда
		Возврат Ложь;
	КонецЕсли;

	ПараметрыКонструирования.НовыеЭлементы.Добавить(КлючЭлемента(ЭлементВывода));
	
КонецФункции

Функция КонструированиеСборщикаДанных(Настройка, СборщикДанных)

	ПараметрыКонструирования = ПараметрыКонструирования(Настройка);

	Если НЕ ПараметрыКонструирования.Начато Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыКонструирования.НовыеЭлементы.Добавить(КлючЭлемента(СборщикДанных));
	
	НачатьКонструированиеСборщиковДанных(Настройка, СборщикДанных);
	
	Возврат Истина;
	
КонецФункции

Функция НачатьКонструированиеСборщиковДанных(Настройка, знач СборщикиДанных) Экспорт

	ПараметрыКонструирования = ПараметрыПродолженияКонструирования(Настройка);
	
	Если ПараметрыКонструирования.СтраницыВводаДанных.Количество()=0 Тогда
		ПараметрыКонструирования.Начато = Ложь;
		ВызватьИсключение "Не указана страница ввода данных";
	КонецЕсли;
	
	РК = вмс_РаботаСКоллекциями;
	
	СборщикиДанных = РК.ЗначениеВМассив(СборщикиДанных);
	
	ДобавленныеСборщики = Новый Массив;
	Для Каждого СборщикДанных Из СборщикиДанных Цикл
		Если ТипЗнч(СборщикДанных)=Тип("Строка") Тогда
			ИмяСборщика = СборщикДанных;
		КонецЕсли;
		
		СборщикДанных = Элемент(Настройка, СборщикДанных, "СборщикиДанных");
		Если СборщикДанных=Неопределено Тогда
			ПараметрыКонструирования.Начато = Ложь;
			Если ИмяСборщика <> Неопределено Тогда
				ВызватьИсключение "Не найден сборщик данных """ + ИмяСборщика + """";
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыКонструирования.СборщикиДанных.Найти(СборщикДанных.ПолноеИмя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыКонструирования.СборщикиДанных.Добавить(СборщикДанных.ПолноеИмя);
		ДобавленныеСборщики.Добавить(СборщикДанных.ПолноеИмя);
	КонецЦикла;

	Для Каждого СтраницаВводаДанных Из ПараметрыКонструирования.СтраницыВводаДанных Цикл
		СтраницаВводаДанных = Элемент(Настройка, СтраницаВводаДанных, "ЭлементыВывода");
		СборщикиДанныхСтраницы = ПолучитьСписокЗначенийСвойстваЭлемента(Настройка, СтраницаВводаДанных, "СборщикиДанных");
		РК.ДобавитьЭлементыКоллекции(СборщикиДанныхСтраницы, ДобавленныеСборщики);
		УстановитьСвойствоЭлементов(Настройка, СтраницаВводаДанных, "СборщикиДанных", СборщикиДанныхСтраницы);
	КонецЦикла;
	
КонецФункции

Функция КонструированиеПоляДанных(Настройка, ПолеДанных)

	ПараметрыКонструирования = ПараметрыКонструирования(Настройка);

	Если НЕ ПараметрыКонструирования.Начато Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыКонструирования.СтраницыВводаДанных.Количество()=0 Тогда
		ПараметрыКонструирования.Начато = Ложь;
		ВызватьИсключение "Не указана страница ввода данных";
	КонецЕсли;

	УстановитьСвойстваЭлементов(Настройка, ПолеДанных, Новый Структура("Зависимый", Истина));
	
	ЗначенияЗаполненияСвойствПоляДанныхПоУмолчанию = ПолучитьЗначенияЗаполненияСвойствПоляДанныхПоУмолчанию(Настройка, ПолеДанных.Имя);
	Если ЗначенияЗаполненияСвойствПоляДанныхПоУмолчанию <> Неопределено Тогда
		УстановитьСвойстваЭлементов(Настройка, ПолеДанных, ЗначенияЗаполненияСвойствПоляДанныхПоУмолчанию);
	КонецЕсли;
	
	ПараметрыКонструирования.НовыеЭлементы.Добавить(КлючЭлемента(ПолеДанных));
	
	// в режиме конструирования добавим также элемент вывода поля
	Для Каждого СтраницаВводаДанных Из ПараметрыКонструирования.СтраницыВводаДанных Цикл
		ИмяЭлементаВывода = ПолучитьИмяНовогоЭлемента(Настройка.ЭлементыВывода, ПолеДанных.Имя, СтраницаВводаДанных);
		Если ИмяЭлементаВывода = ПолеДанных.Имя + "1" Тогда
			// для первого элемента не указывать индекс в имени
			ИмяЭлементаВывода = ПолеДанных.Имя;
		КонецЕсли;
		
		ЭлементВывода = ДобавитьЭлементВывода(Настройка, "ПолеФормы", "ПолеВвода", СтраницаВводаДанных, ИмяЭлементаВывода);
		УстановитьСвойстваЭлементов(Настройка, ЭлементВывода, Новый Структура("Зависимый, ПутьКДанным", Истина, ПолеДанных.ПолноеИмя));
	КонецЦикла;
	
	Для Каждого СборщикДанных Из ПараметрыКонструирования.СборщикиДанных Цикл
		ДобавитьПоляСборщикаДанных(Настройка, СборщикДанных, ПолеДанных);
	КонецЦикла;	
	
	Возврат Истина;
		
КонецФункции

Функция ПолучитьЗначенияЗаполненияСвойствПоляДанныхПоУмолчанию(Настройка, Имя)

	РК = вмс_РаботаСКоллекциями;
	
	ЗначенияЗаполненияСвойствПоляДанныхПоУмолчаниюНаСервере = вмс_НастройкиПолейЗаданияВызовСервера1.ПолучитьЗначенияЗаполненияСвойствПоляДанныхПоУмолчанию(Имя);
	Если ЗначенияЗаполненияСвойствПоляДанныхПоУмолчаниюНаСервере=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗначенияЗаполненияСвойствПоляДанныхПоУмолчанию = Новый Структура;
	Для Каждого ОписаниеСвойства Из РК.ЗначениеВМассив(Настройка.ДополнительныеДанные.СведенияОСвойствахПолейОбработки) Цикл
		ИмяСвойства = ОписаниеСвойства.ИмяСвойства;
		Если ЗначенияЗаполненияСвойствПоляДанныхПоУмолчаниюНаСервере.Свойство(ИмяСвойства) Тогда
			ЗначенияЗаполненияСвойствПоляДанныхПоУмолчанию.Вставить(ИмяСвойства, ЗначенияЗаполненияСвойствПоляДанныхПоУмолчаниюНаСервере[ИмяСвойства]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗначенияЗаполненияСвойствПоляДанныхПоУмолчанию;

КонецФункции

Функция ЗакончитьКонструированиеЭлементов(Настройка) Экспорт

	ПараметрыКонструирования = ПараметрыПродолженияКонструирования(Настройка);
	
	ПараметрыКонструирования.Начато = Ложь;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьСконструированныеЭлементы(Настройка) Экспорт
	
	Возврат Элементы(Настройка, ПараметрыКонструирования(Настройка).НовыеЭлементы);
	
КонецФункции

