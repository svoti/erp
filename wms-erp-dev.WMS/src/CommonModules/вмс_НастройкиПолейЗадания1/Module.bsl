Функция НоваяНастройка() Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ЭлементыВывода = РК.НоваяКоллекцияЗначений("Имя, ПолноеИмя, КлассЭлемента, ТипЭлемента, ВидЭлемента, Картинка, Родитель, Номер, Зависимый, Свойства, ДополнительныеДанные");
	РК.ДобавитьИндексКоллекции(ЭлементыВывода, "ПолноеИмя");
	РК.ДобавитьИндексКоллекции(ЭлементыВывода, "Родитель");

	ПоляДанных = РК.НоваяКоллекцияЗначений("Имя, ПолноеИмя, КлассЭлемента, ТипЭлемента, Картинка, Родитель, Номер, Зависимый, Свойства, ДополнительныеДанные");
	РК.ДобавитьИндексКоллекции(ПоляДанных, "ПолноеИмя");
	РК.ДобавитьИндексКоллекции(ПоляДанных, "Родитель");
	
	СборщикиДанных = РК.НоваяКоллекцияЗначений("Имя, ПолноеИмя, КлассЭлемента, Картинка, Родитель, Номер, Зависимый, Свойства, ДополнительныеДанные");
	РК.ДобавитьИндексКоллекции(СборщикиДанных, "ПолноеИмя");
	РК.ДобавитьИндексКоллекции(СборщикиДанных, "Родитель");
	
	СсылкиЭлементов = РК.НоваяКоллекцияЗначений("ЭлементИсточник, КлассЭлементаИсточника, ИмяСвойства, ЭлементПриемник, КлассЭлементаПриемника, СлабаяСсылка");
	РК.ДобавитьИндексКоллекции(СсылкиЭлементов, "ЭлементИсточник, КлассЭлементаИсточника");
	РК.ДобавитьИндексКоллекции(СсылкиЭлементов, "ЭлементИсточник, КлассЭлементаИсточника, ИмяСвойства");
	РК.ДобавитьИндексКоллекции(СсылкиЭлементов, "ЭлементПриемник, КлассЭлементаПриемника");
	
	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("ТипыЗначенийСвойствЭлементовИБ", ТипыЗначенийСвойствЭлементовИБ());
	ДополнительныеДанные.Вставить("СведенияОТипахЭлементовВывода", СведенияОТипахЭлементовВывода());
	ДополнительныеДанные.Вставить("СведенияОСвойствахПолейОбработки", СведенияОСвойствахПолейОбработки());
	ДополнительныеДанные.Вставить("СведенияОСвойствахСборщиковДанных", СведенияОСвойствахСборщиковДанных());
	ДополнительныеДанные.Вставить("СсылкиЭлементов", СсылкиЭлементов);
	ДополнительныеДанные.Вставить("ПараметрыКонструирования", НовыеПараметрыКонструирования());
	ДополнительныеДанные.Вставить("НастройкаИБ");
	ДополнительныеДанные.Вставить("ДополнительныеПоляКлючаЭлемента");
	
	Настройка = Новый Структура;
	Настройка.Вставить("ЭлементыВывода", ЭлементыВывода);
	Настройка.Вставить("ПоляДанных", ПоляДанных);
	Настройка.Вставить("СборщикиДанных", СборщикиДанных);
	Настройка.Вставить("ДополнительныеДанные", ДополнительныеДанные);
	
	Возврат Настройка;
	
КонецФункции

// для переходного периода
Функция ИспользоватьНовуюСистему() Экспорт
	
	Возврат Истина;
	
КонецФункции

Функция ТипПоляДанных(ТипЗначенияПоляДанных)
	
	Типы = ТипЗначенияПоляДанных.Типы();
	
	Если Типы.Количество()=1 Тогда
		Тип = Типы[0];
		ДанныеТипа = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьДанныеТипаОбъекта(Тип);
		ИмяТипа = ДанныеТипа.Имя;
		Если ИмяТипа="ТаблицаЗначений" Тогда
			Возврат "Таблица";
		КонецЕсли;
	КонецЕсли;
	
	Возврат "Поле";
	
КонецФункции

Функция ПолучитьИмяНовогоЭлемента(Элементы, знач Префикс=Неопределено, Родитель=Неопределено)
	
	РК = вмс_РаботаСКоллекциями;
	
	Если НЕ ЗначениеЗаполнено(Префикс) Тогда
		Префикс = "Элемент";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Родитель) Тогда
		ПолныйПрефикс = Родитель + "." + Префикс;
	Иначе
		ПолныйПрефикс = Префикс;
	КонецЕсли;
	ПолныйПрефикс = ВРЕГ(ПолныйПрефикс);
	
	НомерЭлемента = 1;
	ПоискПоПолномуИмени = Новый Структура("ПолноеИмя");
	Пока Истина Цикл
		НомерЭлементаСтрокой = Формат(НомерЭлемента, "ЧГ=0");
		ПоискПоПолномуИмени.ПолноеИмя = ПолныйПрефикс + НомерЭлементаСтрокой;
		Если РК.НайтиЭлементКоллекции(Элементы, ПоискПоПолномуИмени)=Неопределено Тогда
			Возврат Префикс + НомерЭлементаСтрокой;
		КонецЕсли;
		НомерЭлемента = НомерЭлемента + 1;
	КонецЦикла;
	
КонецФункции

Функция ПроверитьИмяЭлемента(Элементы, Имя, ПолноеИмя, ТекстОшибки="")
	
	РК = вмс_РаботаСКоллекциями;
	
	Если Не РК.ПроверитьИмяПрограммнойПеременной(Имя) Тогда
		ТекстОшибки = "Неверное имя";
	ИначеЕсли РК.НайтиЭлементКоллекции(Элементы, Новый Структура("ПолноеИмя", ПолноеИмя)) <> Неопределено Тогда
		ТекстОшибки = "Элемент с таким именем уже есть";
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	ВызватьИсключение(ТекстОшибки, , "ОшибкаИзмененияЭлементовНастройкиПолей");
	Возврат Ложь;
	
КонецФункции

Функция ТипыЗначенийСвойствЭлементовИБ()
	
	ТипыЗначенийСвойствЭлементовИБ = Новый Соответствие;
	Для Каждого Тип Из вмс_НастройкиПолейЗаданияВызовСервера1.ТипыЗначенийСвойствЭлементовИБ().Типы() Цикл
		ТипыЗначенийСвойствЭлементовИБ[Тип] = Истина;
	КонецЦикла;
	
	ТипыЗначенийСвойствЭлементовИБ[Тип("Неопределено")] = Истина;
	
	Возврат ТипыЗначенийСвойствЭлементовИБ;
	
КонецФункции

Функция СведенияОТипахЭлементовВывода()
	
	КФ = вмс_КонструкторФорм;

	СведенияОТипахЭлементовВывода = КФ.ПолучитьСведенияОТипахЭлементовФормы();
	
	ЗарегистрироватьВидЭлементаСтраницаСборщикаДанных(СведенияОТипахЭлементовВывода);
	
	УстановитьТипСвойстваПутьКДаннымЭлементовВывода(СведенияОТипахЭлементовВывода);
	
	Возврат СведенияОТипахЭлементовВывода;
	
КонецФункции

Функция ЗарегистрироватьВидЭлементаСтраницаСборщикаДанных(СведенияОТипахЭлементовВывода)

	КФ = вмс_КонструкторФорм;
	
	ТипЭлемента = "ГруппаФормы";
	ВидЭлемента = "СтраницаВводаДанных";
	ЗначениеВидЭлемента = Новый Структура("ТипЭлемента, ВидЭлемента, Представление", ТипЭлемента, ВидЭлемента, "Страница ввода данных"); // искуственное значение вида элемента

	КФ.СкопироватьТипЭлементаФормы(СведенияОТипахЭлементовВывода, ТипЭлемента, "Страница", ТипЭлемента, ВидЭлемента);
	СведенияОТипеЭлементаФормы = КФ.ПолучитьСведенияОТипеЭлементаФормы(СведенияОТипахЭлементовВывода, ТипЭлемента, ВидЭлемента);
	СведенияОТипеЭлементаФормы.Представление = "Группа - страница ввода данных";
	СведенияОТипеЭлементаФормы.ЗначениеСвойстваВидЭлемента = ЗначениеВидЭлемента;
	СвойствоВид = КФ.ПолучитьСвойствоЭлементаФормы(СведенияОТипахЭлементовВывода, ТипЭлемента, ВидЭлемента, "Вид");
	СвойствоВид.ЗначениеПоУмолчанию = ЗначениеВидЭлемента;
	СвойствоВид.СписокВыбора.Добавить(ЗначениеВидЭлемента, ЗначениеВидЭлемента.Представление);

	СведенияОТипахЭлементовВывода.ВидыЭлементовПоЗначениям[ЗначениеВидЭлемента] = ЗначениеВидЭлемента;
	
	СвойствоЭлемента = КФ.ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовВывода, "СборщикиДанных", "Сборщики данных", "КлассЭлементовНастройкиПолейЗадания.СборщикиДанных", "");
	СвойствоЭлемента.НесколькоЗначений = Истина;
	СвойствоЭлемента.ОбработчикУстановкиЗначения = вмс_ОбщегоНазначенияКлиентСервер.НовыйОписаниеОповещения("СтраницаВводаДанных_ПриУстановкеСборщиковДанных", вмс_НастройкиПолейЗадания1);
	
КонецФункции

Функция УстановитьТипСвойстваПутьКДаннымЭлементовВывода(СведенияОТипахЭлементовВывода)
	
	РК = вмс_РаботаСКоллекциями;
	
	Для Каждого СвойствоЭлемента Из РК.ПолучитьЭлементыКоллекции(СведенияОТипахЭлементовВывода.ТаблицаСвойствЭлементов) Цикл
		Если СвойствоЭлемента.ИмяСвойства="ПутьКДанным" Тогда
			СвойствоЭлемента.Тип = "КлассЭлементовНастройкиПолейЗадания.ПоляДанных";
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция СведенияОСвойствахПолейОбработки()
	
	РК = вмс_РаботаСКоллекциями;
	
	ИменаКолонок = "ИмяСвойства, Тип, ЗначениеПоУмолчанию, СписокВыбора, СистемноеСвойство, СлабаяСсылка, ОбработчикУстановкиЗначения";
	Свойства = РК.НоваяКоллекцияЗначений(ИменаКолонок);
	
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Имя", "Строка", ""));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Зависимый", "Булево", Ложь, , Истина));
	
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Синоним", "Строка", ""));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Ввод", "Булево", Истина));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "План", "Булево", Истина));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Сборка", "Булево", Истина));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Ресурс", "Булево", Ложь));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "ОбязательныйВвод", "Булево", Истина));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "ОбязательноеЗаполнение", "Булево", Истина));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "ТипЗначения", "ОписаниеТипов", Новый ОписаниеТипов));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "ПутьКДаннымЗаполнения", "Строка", ""));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "ПутьКДаннымСохранения", "Строка", ""));
	
	РК.ДобавитьИндексКоллекции(Свойства, "ИмяСвойства");
	
	Возврат Свойства;
	
КонецФункции

Функция СведенияОСвойствахСборщиковДанных()
	
	РК = вмс_РаботаСКоллекциями;
	
	ИменаКолонок = "ИмяСвойства, Тип, ЗначениеПоУмолчанию, СписокВыбора, НесколькоЗначений, СистемноеСвойство, СлабаяСсылка, ОбработчикУстановкиЗначения";
	Свойства = РК.НоваяКоллекцияЗначений(ИменаКолонок);
	
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Имя", "Строка", ""));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Зависимый", "Булево", Ложь, , , Истина));
	
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Тип", "Строка", "СборщикДанныхСтандартный", вмс_НастройкиПолейЗаданияВызовСервера1.СписокТиповСборщиков()));
	РК.ДобавитьЭлементКоллекции(Свойства, Новый Структура(ИменаКолонок, "Поля", "КлассЭлементовНастройкиПолейЗадания.ПоляДанных", "", , Истина, , Истина));
	
	РК.ДобавитьИндексКоллекции(Свойства, "ИмяСвойства");
	
