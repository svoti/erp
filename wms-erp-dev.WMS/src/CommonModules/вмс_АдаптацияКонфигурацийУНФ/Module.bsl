Функция КоэффициентУпаковки(Упаковка, Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УпаковкиСправочник.Коэффициент КАК Коэффициент                
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК УпаковкиСправочник
	|ГДЕ
	|	УпаковкиСправочник.Ссылка = &Упаковка И УпаковкиСправочник.Коэффициент <> 0";

	Запрос.УстановитьПараметр("Упаковка", Упаковка);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 1;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Коэффициент;

КонецФункции

