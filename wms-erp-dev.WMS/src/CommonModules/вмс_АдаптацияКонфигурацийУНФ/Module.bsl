Функция ПривязатьФотографиюКНоменклатуре(Номенклатура, ХранилищеФайла) Экспорт
	
	ДвоичныеДанные = ХранилищеФайла.Получить();
	АдресВременноеХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	// Создание карточки Файла в базе данных.
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов = Номенклатура;
	ПараметрыФайла.ИмяБезРасширения = Строка(Номенклатура);
	ПараметрыФайла.РасширениеБезТочки = "jpg";
	ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяДата(); 
	
	НачатьТранзакцию();
	
	Попытка	
		ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(
		ПараметрыФайла,
		АдресВременноеХранилище); 
		
		обНоменклатура = Номенклатура.ПолучитьОбъект();
		обНоменклатура.ФайлКартинки = ПрисоединенныйФайл;
		обНоменклатура.Записать(); 
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат Ложь;		
	КонецПопытки;
		
	Возврат Истина;
		
КонецФункции

Функция ПолучитьИменаРаспоряжений() Экспорт
	Результат = Новый Структура;
	
	Результат.Вставить("Поступление", Новый Массив);
	Результат.Вставить("Гибрид", Новый Массив);
	Результат.Вставить("Выбытие", Новый Массив);
	
	// Из распоряжений документов ПриходныйОрдер, РасходныйОрдер
	Результат.Поступление.Добавить("Документ.ПриходныйОрдер");
	Результат.Поступление.Добавить("Документ.ПриходнаяНакладная"); 	
	Результат.Поступление.Добавить("Документ.ОприходованиеЗапасов");
	Результат.Поступление.Добавить("Документ.ОтчетПереработчика");	//ТЧ Продукция и Отходы формируют приход на склад, Запасы - только по запасам, уже переданным в переработку, не влияют на склад 
	                                                       
	Результат.Гибрид.Добавить("Документ.КомплектацияЗапасов");      //Приход - номенклатура, количество (реквизит), расход - Товары (ТЧ)
	Результат.Гибрид.Добавить("Документ.ПеремещениеЗапасов");		//Передача в эксплуатацию, Перемещение, Возврат из эксплуатации - приход + расход, Списание на расходы - расход
	Результат.Гибрид.Добавить("Документ.СборкаЗапасов");			//Приход - ТЧ Продукция, Отходы, Расход - ТЧ Материалы
	Результат.Гибрид.Добавить("Документ.ПересортицаЗапасов");		//В одной ТЧ смешаны НоменклатураСписание и НоменклатураОприходование       
	Результат.Гибрид.Добавить("Документ.ЗаказПокупателя");			//ВидОперации МатериалыЗаказчика - Поступление, остальные ТЧ - Выбытие
	Результат.Гибрид.Добавить("Документ.ЗаказПоставщику");			//ВидОперации ЗаказНаЗакупку - Поступление, ЗаказНаПереработку - Поступление + Выбытие
	// Результат.Гибрид.Добавить("Документ.ПередачаТоваровМеждуОрганизациями"); //Передача в демо базе не включается т.к.
	// есть проведенные документы по организации, не тестировалась. Есть ТЧ ДобавленныеНаборы, судя по коду
	// разукомплектация делается автоматически
	
	Результат.Выбытие.Добавить("Документ.РасходныйОрдер");
	Результат.Выбытие.Добавить("Документ.СписаниеЗапасов");
	Результат.Выбытие.Добавить("Документ.РасходнаяНакладная");		//Расход - Запасы (Товары и услуги), ТЧ Подарки не меняет остатки по складу
	Результат.Выбытие.Добавить("Документ.ОтчетОПереработке");		//ТЧ Продукция и Отходы формируют расход по складу, Материалы не делает движений
	// Результат.Выбытие.Добавить("Документ.ПринятиеКУчетуВА");		//Не тестировалось, т.к. не складской учет
	
	Возврат Результат;
КонецФункции

