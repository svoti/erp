Функция ПолучитьСписокТоваровПоВводуСтроки(Текст) Экспорт
		Запрос = Новый Структура("Текст, Параметры");
		ЗапросТекст =
		"ВЫБРАТЬ ПЕРВЫЕ 10
		|	Номенклатура.Ссылка КАК Товар,
		|	ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, Значение(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
		|   Неопределено КАК ПредставлениеТовара
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО (Номенклатура.ТипНоменклатуры = ХарактеристикиНоменклатуры.Владелец
		|				ИЛИ Номенклатура.Ссылка = ХарактеристикиНоменклатуры.Владелец)
		|ГДЕ
		|	Номенклатура.ЭтоГруппа = ЛОЖЬ";   
		
		МассивПоиска = СтрРазделить(Текст, " ");
		Для каждого ЧастьСтроки Из МассивПоиска Цикл
			ЗапросТекст = ЗапросТекст + 
			"  И СТРНАЙТИ(Номенклатура.Ссылка.Код +"" ""+Номенклатура.Ссылка.Артикул +"" ""+Номенклатура.Ссылка.Наименование +"" ""+ ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка.Наименование, """"), """+ЧастьСтроки+""") >= 1"; 
		КонецЦикла;
		
		Запрос.Текст = ЗапросТекст;  
		Запрос.Параметры = Новый Структура("",);   

	Возврат Запрос;
КонецФункции
