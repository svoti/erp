Функция СтроковоеПредставлениеОстатковНаСкладе(Товар) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ТаблицаТоваров = РК.ЗначениеВТаблицуЗначений(Товар, "Номенклатура");
	КолонкаТовар = ТаблицаТоваров.Колонки.Найти("Товар");
	Если КолонкаТовар <> Неопределено Тогда
		КолонкаТовар.Имя = "Номенклатура";
	КонецЕсли;
		
	ИмяРегистраОсновногоУчета = "РегистрНакопления.ЗапасыНаСкладах";
	МетаданныеРегистра = Метаданные.НайтиПоПолномуИмени(ИмяРегистраОсновногоУчета);
	Если МетаданныеРегистра=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПоляСоединенияМассив = Новый Массив;
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		Если ТаблицаТоваров.Колонки.Найти(Измерение.Имя) <> Неопределено Тогда
			ПоляСоединенияМассив.Добавить(Измерение.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если ПоляСоединенияМассив.Найти("Номенклатура")=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПоляСоединения = РК.МассивВСтроку(ПоляСоединенияМассив);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ТаблицаТоваров_ТоварныеПоля КАК ТоварныеПоля
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ТоварныеПоля КАК ТоварныеПоля, 
	|	Остатки.Склад КАК Склад,
	|	Остатки.ВНаличииОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			(&ТоварныеПоля, 1) В
	|				(ВЫБРАТЬ
	|					&ТоварныеПоля,
	|					1
	|				ИЗ
	|					ТаблицаТоваров)) КАК Остатки";
	РК.ТипизироватьТаблицуЗначений(ТаблицаТоваров);
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	
	ПоляТаблицыТоваровМассив = Новый Массив;
	Для Каждого Поле Из ПоляСоединенияМассив Цикл
		ПоляТаблицыТоваровМассив.Добавить("ТаблицаТоваров." + Поле + " КАК " + Поле);
	КонецЦикла;
	ПоляТаблицыТоваров = РК.МассивВСтроку(ПоляТаблицыТоваровМассив);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТаблицаТоваров_ТоварныеПоля КАК ТоварныеПоля", ПоляТаблицыТоваров);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрНакопления.ТоварыНаСкладах", ИмяРегистраОсновногоУчета);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТоварныеПоля КАК ТоварныеПоля", ПоляСоединения);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТоварныеПоля", ПоляСоединения);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.Склад", "Остатки.СтруктурнаяЕдиница");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.ВНаличииОстаток", "Остатки.КоличествоОстаток");
	РезультатЗапроса = Запрос.Выполнить();
	
	ПредставлениеОстатков = "";
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПредставлениеОстатков = ПредставлениеОстатков + СтрШаблон("%1: %2 ед.", Выборка.Склад, Выборка.Остаток) + Символы.ПС;
	КонецЦикла;
	
	Возврат ПредставлениеОстатков;
		
КонецФункции
