// ТУ_Кошелев 12.12.24 - ОХР новая функция для проверки рабочей даты-времени
//Функция для УНФ
//
Функция ДатаВремяРабочее(ДатаСоВременем) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КалендарныеГрафики.ДеньВключенВГрафик КАК ДеньРабочий
	|ИЗ
	|	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
	|ГДЕ
	|	КалендарныеГрафики.ДатаГрафика = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	|;

	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), СЕКУНДА, РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ), &Дата, СЕКУНДА))
	|		МЕЖДУ Расписание.ВремяНачала И Расписание.ВремяОкончания
	|		И ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), СЕКУНДА, РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ), &Дата, СЕКУНДА)) <> ДАТАВРЕМЯ(1, 1, 1)
	|	КАК ВремяРабочее
	|ИЗ
	|	Справочник.ШаблоныЗаполненияГрафиковРабочегоВремени.РасписаниеРаботы КАК Расписание
	|ГДЕ
	|	Расписание.Ссылка.Наименование = ""Рабочий график Ответ Хранения""
	|	И Расписание.НомерДняЦикла = ДЕНЬНЕДЕЛИ(&Дата)
	|;

	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НЕ(ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), СЕКУНДА, РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ), &Дата, СЕКУНДА))
	|		МЕЖДУ Перерывы.ВремяНачала И Перерывы.ВремяОкончания)
	|		И ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), СЕКУНДА, РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ), &Дата, СЕКУНДА)) <> ДАТАВРЕМЯ(1, 1, 1)
	|	КАК ВремяРабочее
	|ИЗ
	|	Справочник.ШаблоныЗаполненияГрафиковРабочегоВремени.Перерывы КАК Перерывы
	|ГДЕ
	|	Перерывы.Ссылка.Наименование = ""Рабочий график Ответ Хранения""
	|	И Перерывы.НомерДня = ДЕНЬНЕДЕЛИ(&Дата)";
	Запрос.УстановитьПараметр("Дата", ДатаСоВременем);
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	ВремяРабочее = Ложь;
	
	Если РезультатЗапроса[0].Пустой() ИЛИ РезультатЗапроса[1].Пустой() ИЛИ РезультатЗапроса[2].Пустой() Тогда
		Возврат ВремяРабочее;
	Иначе
		ВыборкаДень = РезультатЗапроса[0].Выбрать();
		ВыборкаВремя = РезультатЗапроса[1].Выбрать();
		ВыборкаПерерыв = РезультатЗапроса[2].Выбрать();
		ВыборкаДень.Следующий();
		ВыборкаВремя.Следующий();
		ВыборкаПерерыв.Следующий();
		
		ВремяРабочее = ВыборкаДень.ДеньРабочий И ВыборкаВремя.ВремяРабочее И ВыборкаПерерыв.ВремяРабочее;
		Возврат ВремяРабочее;
	КонецЕсли;
КонецФункции


//
// Параметры:
//    ИдентификаторыЭлементов - идентификаторы элементов задаются в формате "<ИдентификаторРодителя1>\<ИдентификаторРодителя2>\<ИдентификаторЭлемента>"
// Возвращаемое значение:
//    ТаблицаЗначений - таблица элементов с колонками "Идентификатор, Ссылка"
//
Функция НайтиЭлементыИерархическогоСправочника(ИмяСправочника, знач ИдентификаторыЭлементов, ИмяРеквизитаПоиска="Наименование") Экспорт

	ТаблицаЭлементов = НайтиЭлементыИерархическогоСправочникаРасширенный(ИмяСправочника, ИдентификаторыЭлементов, ИмяРеквизитаПоиска);
	
	ТаблицаРезультата = ТаблицаЭлементов.Скопировать(Новый Структура("Найден, Дополнительный", Истина, Ложь), "Идентификатор, Ссылка, ЭтоГруппа");
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция НайтиЭлементыИерархическогоСправочникаРасширенный(ИмяСправочника, знач ИдентификаторыЭлементов, ИмяРеквизитаПоиска) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	МенеджерСправочника = Справочники[ИмяСправочника];
	ПустаяСсылка = МенеджерСправочника.ПустаяСсылка();
	ИмяТипаСсылки = "СправочникСсылка." + ИмяСправочника;

	ИдентификаторыЭлементов = РК.ЗначениеВМассив(ИдентификаторыЭлементов, , Ложь);
	
	ПоискПоИдентификатору = Новый Структура("Идентификатор");

	ТаблицаЭлементов = Новый ТаблицаЗначений;
	ТаблицаЭлементов.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаЭлементов.Колонки.Добавить("ЗначениеПоиска", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТаблицаЭлементов.Колонки.Добавить("ИдентификаторРодителя", Новый ОписаниеТипов("Строка"));
	ТаблицаЭлементов.Колонки.Добавить("Ссылка", Новый ОписаниеТипов(ИмяТипаСсылки));
	ТаблицаЭлементов.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	ТаблицаЭлементов.Колонки.Добавить("Родитель", Новый ОписаниеТипов(ИмяТипаСсылки));
	ТаблицаЭлементов.Колонки.Добавить("Найден", Новый ОписаниеТипов("Булево"));
	ТаблицаЭлементов.Колонки.Добавить("Дополнительный", Новый ОписаниеТипов("Булево"));
	
	ЭлементыДляОбработки = Новый Массив;
	Для Каждого ИдентификаторЭлемента Из ИдентификаторыЭлементов Цикл
		ПоискПоИдентификатору.Идентификатор = ИдентификаторЭлемента;
		Если ТаблицаЭлементов.НайтиСтроки(ПоискПоИдентификатору).Количество()=0 Тогда
			СтрокаЭлемента = ТаблицаЭлементов.Добавить();
			СтрокаЭлемента.Идентификатор = ИдентификаторЭлемента;
			
			ЭлементыДляОбработки.Добавить(СтрокаЭлемента);
		КонецЕсли;
	КонецЦикла;

	Пока ЭлементыДляОбработки.Количество() > 0 Цикл
		ЭлементыДляОбработкиСледующегоУровня = Новый Массив;
		Для Каждого СтрокаЭлемента Из ЭлементыДляОбработки Цикл
			ПозицияРазделителя = СтрНайти(СтрокаЭлемента.Идентификатор, "\", НаправлениеПоиска.СКонца);
			Если ПозицияРазделителя > 0 Тогда
				ИдентификаторРодителя = Лев(СтрокаЭлемента.Идентификатор, ПозицияРазделителя-1);
				СтрокаЭлемента.ИдентификаторРодителя = ИдентификаторРодителя;
				СтрокаЭлемента.ЗначениеПоиска = Прав(СтрокаЭлемента.Идентификатор, СтрДлина(СтрокаЭлемента.Идентификатор)-ПозицияРазделителя);
				
				ПоискПоИдентификатору.Идентификатор = ИдентификаторРодителя;
				Если ТаблицаЭлементов.НайтиСтроки(ПоискПоИдентификатору).Количество()=0 Тогда
					СтрокаЭлементаРодителя = ТаблицаЭлементов.Добавить();
					СтрокаЭлементаРодителя.Идентификатор = ИдентификаторРодителя;
					СтрокаЭлементаРодителя.Дополнительный = Истина;
					ЭлементыДляОбработкиСледующегоУровня.Добавить(СтрокаЭлементаРодителя);
				КонецЕсли;
			Иначе
				СтрокаЭлемента.ИдентификаторРодителя = "";
				СтрокаЭлемента.ЗначениеПоиска = СтрокаЭлемента.Идентификатор;
				СтрокаЭлемента.Родитель = ПустаяСсылка;
			КонецЕсли;
		КонецЦикла;
		
		ЭлементыДляОбработки = ЭлементыДляОбработкиСледующегоУровня;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПоиска.Идентификатор КАК Идентификатор,
	|	ТаблицаПоиска.ЗначениеПоиска КАК ЗначениеПоиска,
	|	ТаблицаПоиска.Родитель КАК Родитель
	|ПОМЕСТИТЬ ВТ_ТаблицаПоиска
	|ИЗ
	|	&ТаблицаПоиска КАК ТаблицаПоиска
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаПоиска.Идентификатор КАК Идентификатор,
	|	ТаблицаСправочника.Ссылка КАК Ссылка,
	|	ТаблицаСправочника.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.вмс_НастройкиПрограммы КАК ТаблицаСправочника
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаПоиска КАК ВТ_ТаблицаПоиска
	|		ПО (&ИмяРеквизитаПоиска = ВТ_ТаблицаПоиска.ЗначениеПоиска)
	|			И ТаблицаСправочника.Родитель = ВТ_ТаблицаПоиска.Родитель";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.вмс_НастройкиПрограммы", "Справочник." + ИмяСправочника);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяРеквизитаПоиска", "ТаблицаСправочника." + ИмяРеквизитаПоиска);
	
	ПоискПоИдентификаторуРодителя = Новый Структура("ИдентификаторРодителя");
	ПоискПоИдентификаторуРодителя.ИдентификаторРодителя = "";
	ТаблицаПоиска = ТаблицаЭлементов.Скопировать(ПоискПоИдентификаторуРодителя);
	Запрос.УстановитьПараметр("ТаблицаПоиска", ТаблицаПоиска);

	Пока ТаблицаПоиска.Количество() > 0 Цикл
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		ТаблицаПоиска.Очистить();
		Пока ВыборкаЗапроса.Следующий() Цикл
			ПоискПоИдентификатору.Идентификатор = ВыборкаЗапроса.Идентификатор;
			СтрокаЭлементаРодителя = ТаблицаЭлементов.НайтиСтроки(ПоискПоИдентификатору)[0];
			СтрокаЭлементаРодителя.Ссылка = ВыборкаЗапроса.Ссылка;
			СтрокаЭлементаРодителя.ЭтоГруппа = ВыборкаЗапроса.ЭтоГруппа;
			СтрокаЭлементаРодителя.Найден = Истина;
			
			ПоискПоИдентификаторуРодителя.ИдентификаторРодителя = ВыборкаЗапроса.Идентификатор;
			Для Каждого СтрокаЭлемента Из ТаблицаЭлементов.НайтиСтроки(ПоискПоИдентификаторуРодителя) Цикл
				СтрокаЭлемента.Родитель = ВыборкаЗапроса.Ссылка;
				СтрокаПоиска = ТаблицаПоиска.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПоиска, СтрокаЭлемента);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаЭлементов;
	
КонецФункции

Функция НайтиЭлементыГруппСправочника(ИмяСправочника, знач ТаблицаГрупп, ИмяРеквизитаПоиска) Экспорт

	ТаблицаЭлементов = Новый ТаблицаЗначений;
	ТаблицаЭлементов.Колонки.Добавить("Ссылка");
	ТаблицаЭлементов.Колонки.Добавить("Родитель");
	ТаблицаЭлементов.Колонки.Добавить("ЭтоГруппа");
	ТаблицаЭлементов.Колонки.Добавить("Идентификатор");
	ТаблицаЭлементов.Колонки.Добавить("ИдентификаторРодителя");
	
	Если ТаблицаГрупп.Количество()=0 Тогда
		Возврат ТаблицаЭлементов;
	КонецЕсли;
	
	РК = вмс_РаботаСКоллекциями;
	
	МенеджерСправочника = Справочники[ИмяСправочника];
	ПустаяСсылка = МенеджерСправочника.ПустаяСсылка();
	ИмяТипаСсылки = "СправочникСсылка." + ИмяСправочника;
	
	СсылкиГрупп = РК.ВыгрузитьЗначенияКолонкиКоллекции(ТаблицаГрупп, "Ссылка");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаСправочника.Ссылка КАК Ссылка,
	|	ТаблицаСправочника.Родитель КАК Родитель,
	|	ТаблицаСправочника.ЭтоГруппа КАК ЭтоГруппа,
	|	&ИмяРеквизитаПоиска КАК Наименование
	|ИЗ
	|	Справочник.вмс_НастройкиПрограммы КАК ТаблицаСправочника
	|ГДЕ
	|	ТаблицаСправочника.Родитель В(&СсылкиГрупп)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.вмс_НастройкиПрограммы", "Справочник." + ИмяСправочника);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяРеквизитаПоиска", "ТаблицаСправочника." + ИмяРеквизитаПоиска);
	Запрос.УстановитьПараметр("СсылкиГрупп", СсылкиГрупп);
	
	ПоискПоСсылке = Новый Структура("Ссылка");
	Пока СсылкиГрупп.Количество() > 0 Цикл
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		МассивЭлементовУровня = Новый Массив;
		СсылкиГрупп.Очистить();
		Пока ВыборкаЗапроса.Следующий() Цикл
			СтрокаЭлемента = ТаблицаЭлементов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЭлемента, ВыборкаЗапроса);
			
			ПоискПоСсылке.Ссылка = СтрокаЭлемента.Родитель;
			СтрокаГруппыМассив = ТаблицаГрупп.НайтиСтроки(ПоискПоСсылке);
			СтрокаГруппы = СтрокаГруппыМассив[0];
			СтрокаЭлемента.Идентификатор = СтрокаГруппы.Идентификатор + "\" + ВыборкаЗапроса.Наименование;
			СтрокаЭлемента.ИдентификаторРодителя = СтрокаГруппы.Идентификатор;
			Если СтрокаЭлемента.ЭтоГруппа Тогда
				СсылкиГрупп.Добавить(СтрокаЭлемента.Ссылка);
			КонецЕсли;
		КонецЦикла;
		ТаблицаГрупп = ТаблицаЭлементов;
	КонецЦикла;
	
	Возврат ТаблицаЭлементов;
	
КонецФункции

