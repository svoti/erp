Функция ПолучитьРеквизитыОбъектов(Объекты, СписокРеквизитов, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если ТипЗнч(Объекты) = Тип("Массив") Тогда
		МассивОбъектов = Объекты;
	Иначе
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объекты);
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ИспользоватьДополнительныеРеквизиты = Не ДополнительныеПараметры.Свойство("ИспользоватьДополнительныеРеквизиты") ИЛИ ДополнительныеПараметры.ИспользоватьДополнительныеРеквизиты = Истина;
	Иначе
		ИспользоватьДополнительныеРеквизиты = Истина;
	КонецЕсли;
	
	Если ТипЗнч(СписокРеквизитов) = Тип("Строка") ИЛИ ТипЗнч(СписокРеквизитов) = Тип("Массив") Тогда
		Если ТипЗнч(СписокРеквизитов) = Тип("Строка") Тогда
			СписокРеквизитовМассив = вмс_РаботаСКоллекциями.СтрокуВМассив(СписокРеквизитов);
		Иначе
			СписокРеквизитовМассив = СписокРеквизитов;
		КонецЕсли;
		
		СписокРеквизитовСтруктура = Новый Структура;
		Для Каждого Поле Из СписокРеквизитовМассив Цикл
			ЧастиПоля = вмс_РаботаСКоллекциями.СтрокуВМассив(Поле, " КАК ");
			Если ЧастиПоля.Количество() = 2 Тогда
				ИмяПоля = ЧастиПоля[0];
				ПсевдонимПоля = ЧастиПоля[1];
			Иначе
				ИмяПоля = ЧастиПоля[0];
				ПсевдонимПоля = СтрЗаменить(ИмяПоля, ".", "");
			КонецЕсли;
			СписокРеквизитовСтруктура.Вставить(ПсевдонимПоля, ИмяПоля);
		КонецЦикла;
	ИначеЕсли ТипЗнч(СписокРеквизитов) = Тип("Структура") Тогда
		СписокРеквизитовСтруктура = СписокРеквизитов;
	Иначе
		// Не ОК
		Возврат Неопределено;
	КонецЕсли;
		
	СписокРеквизитовМассив = вмс_РаботаСКоллекциями.ВыгрузитьЗначенияКолонкиКоллекции(СписокРеквизитовСтруктура, "Значение");
	
	ТекстШаблона =
	"ВЫБРАТЬ
	|	&ТекстПолей КАК ТекстПолей
	|ИЗ
	|	Справочник.Номенклатура КАК таблицаОбъекта
	|//{ЛЕВЫЕ_СОЕДИНЕНИЯ}
	|ГДЕ
	|	таблицаОбъекта.Ссылка В(&МассивОбъектов)";
	
	Связка = Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС + Символы.ПС;
	
	ТекстШаблонаСоединенияДополнительногоРеквизита =
	Символы.ПС +
	"ЛЕВОЕ СОЕДИНЕНИЕ ДополнительныеРеквизитыОбъектов КАК ДополнительныеРеквизитыОбъектов1
	|ПО таблицаОбъекта.Ссылка = ДополнительныеРеквизитыОбъектов1.Объект
	|И &ИмяРеквизита = ДополнительныеРеквизитыОбъектов1.ИмяСвойства";
	
	ТекстЗапроса = "";
	
	ДанныеПоТипамОбъектов = Новый Соответствие;
	МассивДанныхПоТипамОбъектов = Новый Массив;
	
	ИспользуютсяДополнительныеРеквизиты = Ложь;
	Для Каждого Объект Из МассивОбъектов Цикл
		
		ТипОбъекта = ТипЗнч(Объект);
		ДанныеПоТипуОбъектов = ДанныеПоТипамОбъектов[ТипОбъекта];
		Если ДанныеПоТипуОбъектов = Неопределено Тогда
			МетаДанныеОбъекта = МетаДанные.НайтиПоТипу(ТипОбъекта);
			ДанныеПоТипуОбъектов = Новый Структура;
			ДанныеПоТипуОбъектов.Вставить("МассивОбъектов", Новый Массив);
			ДанныеПоТипуОбъектов.Вставить("ИмяТаблицыИБ", "");
			ДанныеПоТипуОбъектов.Вставить("ИмяПараметра", "");
			ДанныеПоТипамОбъектов[ТипОбъекта] = ДанныеПоТипуОбъектов;
			
			Если МетаДанныеОбъекта <> Неопределено Тогда
				СписокДоступныхРеквизитовМассив = НайтиДоступныеРеквизитыОбъекта(МетаДанныеОбъекта, СписокРеквизитовМассив);
				СписокРеквизитовСтрока = "";
				ТекстСоединенийДополнительныхРеквизитов = "";
				СвязкаПолей = "," + Символы.ПС + Символы.Таб;
				НомерДопСвойства = 1;
				Для Каждого Поле Из СписокРеквизитовСтруктура Цикл
					ПсевдонимПоля = Поле.Ключ;
					Если СписокДоступныхРеквизитовМассив.Найти(Поле.Значение) = Неопределено Тогда
						Если ИспользоватьДополнительныеРеквизиты Тогда
							НомерДопСвойстваСтрокой = Формат(НомерДопСвойства, "ЧГ=0");
							ТаблицаДополнительногоРеквизита = "ДополнительныеРеквизитыОбъектов" + НомерДопСвойстваСтрокой;
							ИмяПоля = ТаблицаДополнительногоРеквизита +  ".ЗначениеСвойства";
							ТекстСоединенияДополнительногоРеквизита = ТекстШаблонаСоединенияДополнительногоРеквизита;
							ТекстСоединенияДополнительногоРеквизита = СтрЗаменить(ТекстСоединенияДополнительногоРеквизита, "ДополнительныеРеквизитыОбъектов1", ТаблицаДополнительногоРеквизита);
							ТекстСоединенияДополнительногоРеквизита = СтрЗаменить(ТекстСоединенияДополнительногоРеквизита, "&ИмяРеквизита", """" + Поле.Значение + """");
							ТекстСоединенийДополнительныхРеквизитов = ТекстСоединенийДополнительныхРеквизитов + ТекстСоединенияДополнительногоРеквизита;
							НомерДопСвойства = НомерДопСвойства + 1;
							ИспользуютсяДополнительныеРеквизиты = Истина; //возможно используются
						Иначе
							ИмяПоля = "NULL";
						КонецЕсли;
					Иначе
						ИмяПоля = "таблицаОбъекта." + Поле.Значение;
					КонецЕсли;
					
					СписокРеквизитовСтрока = СписокРеквизитовСтрока + СвязкаПолей + ИмяПоля + " КАК " + ПсевдонимПоля;
				КонецЦикла;
				СписокРеквизитовСтрока = Прав(СписокРеквизитовСтрока, СтрДлина(СписокРеквизитовСтрока)-СтрДлина(СвязкаПолей));
				
				ИмяТаблицыИБ = МетаДанныеОбъекта.ПолноеИмя();
				ИмяПараметра = "МассивОбъектов" + СтрЗаменить(ИмяТаблицыИБ, ".", "_");
				ТекстОбъекта = ТекстШаблона;
				ТекстОбъекта = СтрЗаменить(ТекстОбъекта, "&ТекстПолей КАК ТекстПолей", СписокРеквизитовСтрока);
				ТекстОбъекта = СтрЗаменить(ТекстОбъекта, "Справочник.Номенклатура", ИмяТаблицыИБ);
				ТекстОбъекта = СтрЗаменить(ТекстОбъекта, "&МассивОбъектов", "&" + ИмяПараметра);
				ТекстОбъекта = СтрЗаменить(ТекстОбъекта, "//{ЛЕВЫЕ_СОЕДИНЕНИЯ}", ТекстСоединенийДополнительныхРеквизитов);
				ТекстЗапроса = ТекстЗапроса + Связка + ТекстОбъекта;
				ДанныеПоТипуОбъектов.ИмяТаблицыИБ = ИмяТаблицыИБ;
				ДанныеПоТипуОбъектов.ИмяПараметра = ИмяПараметра;
				МассивДанныхПоТипамОбъектов.Добавить(ДанныеПоТипуОбъектов);
			КонецЕсли;
			
		КонецЕсли;
		
		ДанныеПоТипуОбъектов.МассивОбъектов.Добавить(Объект);
		
	КонецЦикла;
	
	Если ТекстЗапроса = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапроса = Прав(ТекстЗапроса, СтрДлина(ТекстЗапроса)-СтрДлина(Связка));
	
	Запрос = Новый Запрос;
	
	Если НЕ ИспользуютсяДополнительныеРеквизиты Тогда
		ИспользоватьДополнительныеРеквизиты = Ложь;
	КонецЕсли;
	
	Если ИспользоватьДополнительныеРеквизиты Тогда
		ЗапросПоДополнительнымРеквизитам = вмс_УправлениеСвойствамиСервер.ПолучитьЗапросПоДополнительнымРеквизитамОбъектов(МассивОбъектов, "ДополнительныеРеквизитыОбъектов");
		ТекстЗапроса = ЗапросПоДополнительнымРеквизитам.Текст + Символы.ПС + ";" + Символы.ПС + Символы.ПС + ТекстЗапроса;
		Для Каждого Параметр Из ЗапросПоДополнительнымРеквизитам.Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;

	Для Каждого ДанныеПоТипуОбъектов Из МассивДанныхПоТипамОбъектов Цикл
		Запрос.УстановитьПараметр(ДанныеПоТипуОбъектов.ИмяПараметра, ДанныеПоТипуОбъектов.МассивОбъектов);
	КонецЦикла;
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРеквизитов = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаРеквизитов;
	
КонецФункции

Функция ДополнитьТаблицуРеквизитамиОбъектов(Таблица, КолонкиОбъектов, СписокРеквизитов) Экспорт
	
	Если ТипЗнч(КолонкиОбъектов) = Тип("Массив") Тогда
		КолонкиОбъектовМассив = КолонкиОбъектов;
	Иначе
		КолонкиОбъектовМассив = вмс_РаботаСКоллекциями.СтрокуВМассив(КолонкиОбъектов, ",");
	КонецЕсли;
	
	Если ТипЗнч(СписокРеквизитов) = Тип("Массив") Тогда
		СписокРеквизитовМассив = СписокРеквизитов;
	Иначе
		СписокРеквизитовМассив = вмс_РаботаСКоллекциями.СтрокуВМассив(СписокРеквизитов, ",");
	КонецЕсли;
	
	МассивОбъектов = Новый Массив;
	Для Каждого КолонкаОбъектов Из КолонкиОбъектовМассив  Цикл
		ОбъектыКолонки = вмс_РаботаСКоллекциями.ВыгрузитьЗначенияКолонкиКоллекции(Таблица, КолонкаОбъектов);
		вмс_РаботаСКоллекциями.ДобавитьЭлементыКоллекции(МассивОбъектов, ОбъектыКолонки);
		Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
			Для Каждого Реквизит Из СписокРеквизитовМассив Цикл
				ИмяРеквизита = КолонкаОбъектов + Реквизит;
				Таблица.Колонки.Добавить(ИмяРеквизита);
			КонецЦикла; 
		КонецЕсли; 
	КонецЦикла;
	
	СписокРеквизитовЗапросаМассив = Новый Массив;
	СписокРеквизитовЗапросаМассив.Добавить("Ссылка");
	вмс_РаботаСКоллекциями.ДобавитьЭлементыКоллекции(СписокРеквизитовЗапросаМассив, СписокРеквизитовМассив);
	ТаблицаРеквизитов = ПолучитьРеквизитыОбъектов(МассивОбъектов, СписокРеквизитовЗапросаМассив);
	ТаблицаРеквизитов.Индексы.Добавить("Ссылка");
	
	Отбор = Новый Структура("Ссылка");
	Для Каждого Строка Из Таблица  Цикл
		Для Каждого КолонкаОбъектов Из КолонкиОбъектовМассив Цикл
			Отбор.Ссылка = Строка[КолонкаОбъектов];
			НайденныеРеквизиты = ТаблицаРеквизитов.НайтиСтроки(Отбор);
			Если НайденныеРеквизиты.Количество() > 0 Тогда
				НайденныеРеквизиты = НайденныеРеквизиты[0];
				Для Каждого Реквизит Из СписокРеквизитовМассив Цикл
					ИмяРеквизита = КолонкаОбъектов + Реквизит;
					Строка[ИмяРеквизита] = НайденныеРеквизиты[Реквизит];
				КонецЦикла; 
			Иначе
				Для Каждого Реквизит Из СписокРеквизитовМассив Цикл
					ИмяРеквизита = КолонкаОбъектов + Реквизит;
					Строка[ИмяРеквизита] = Неопределено;
				КонецЦикла; 
			КонецЕсли; 
		КонецЦикла;
	КонецЦикла; 
	
КонецФункции

Функция НайтиДоступныеРеквизитыОбъекта(знач МетаданныеОбъекта, ПроверяемыеВыражения) Экспорт
	
	Если ТипЗнч(МетаданныеОбъекта) = Тип("Строка") Тогда
		ПолноеИмяОбъектаМетаданных = МетаданныеОбъекта;
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъектаМетаданных);
	Иначе
		ПолноеИмяОбъектаМетаданных = МетаданныеОбъекта.ПолноеИмя();
	КонецЕсли;
	
	МассивДоступныхРеквизитов = Новый Массив;
	
	Если МетаданныеОбъекта = Неопределено Тогда 
		Возврат МассивДоступныхРеквизитов;
	КонецЕсли;
	
	МассивПроверяемыхВыражений = вмс_РаботаСКоллекциями.ЗначениеВМассив(ПроверяемыеВыражения, , Ложь);
	
	////////////////////////////////////////////////////////////////////////////////////////////
	ТаблицаПроверяемыхВыражений = Новый ТаблицаЗначений;
	ТаблицаПроверяемыхВыражений.Колонки.Добавить("Имя");
	ТаблицаПроверяемыхВыражений.Колонки.Добавить("ЧастьПути");
	ТаблицаПроверяемыхВыражений.Колонки.Добавить("ПутьДоЭтогоУровня");
	ТаблицаПроверяемыхВыражений.Колонки.Добавить("Уровень");

	МаксУровень = 0;
	Для Каждого ТекущееВыражение Из МассивПроверяемыхВыражений Цикл
		
		ЧастиПути = вмс_РаботаСКоллекциями.СтрокуВМассив(ТекущееВыражение, ".");
		ПутьДоЭтогоУровня = "";
		Для Уровень=0 По ЧастиПути.ВГраница() Цикл
			ЧастьПути = ЧастиПути[Уровень];
			ПутьДоЭтогоУровня = ПутьДоЭтогоУровня + ЧастьПути;
			СтрокаПроверяемогоВыражения = ТаблицаПроверяемыхВыражений.Добавить();
			СтрокаПроверяемогоВыражения.Имя = ТекущееВыражение;
			СтрокаПроверяемогоВыражения.ЧастьПути = ЧастьПути;
			СтрокаПроверяемогоВыражения.ПутьДоЭтогоУровня = ПутьДоЭтогоУровня;
			СтрокаПроверяемогоВыражения.Уровень = Уровень;
			МаксУровень = Макс(МаксУровень, Уровень);
			ПутьДоЭтогоУровня = ПутьДоЭтогоУровня + ".";
		КонецЦикла; 
		
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////////////////////
	ТаблицаДоступныхРеквизитов = Новый ТаблицаЗначений;
	ТаблицаДоступныхРеквизитов.Колонки.Добавить("Имя");
	ТаблицаДоступныхРеквизитов.Колонки.Добавить("Реквизит");
	ТаблицаДоступныхРеквизитов.Колонки.Добавить("Путь");
	ТаблицаДоступныхРеквизитов.Колонки.Добавить("Тип");
	
	Источники = Новый ТаблицаЗначений;
	Источники.Колонки.Добавить("Объект");
	Источники.Колонки.Добавить("Путь");
	Источники.Колонки.Добавить("Тип");
	
	ТипыИсточников = Новый Структура;
	ТипыИсточников.Вставить("МетаДанныеОбъекта", 0);
	ТипыИсточников.Вставить("Реквизит", 1);
	ТипыИсточников.Вставить("Тип", 2);
	ТипыИсточников.Вставить("ТабличнаяЧасть", 3);
	
	Источник = Источники.Добавить();
	Источник.Объект = МетаданныеОбъекта;
	Источник.Путь = "";
	Источник.Тип = ТипыИсточников.МетаДанныеОбъекта;
	
	МетаДанныеТипов = Новый Соответствие;
	
	Для Уровень=0 По МаксУровень Цикл
		
		СтрокиПроверяемыхВыражений = ТаблицаПроверяемыхВыражений.НайтиСтроки(Новый Структура("Уровень", Уровень));
		Если СтрокиПроверяемыхВыражений.Количество() = 0 Тогда
			Прервать;
		КонецЕсли; 
		
		/////////////////////////////////////////////////////////////////////
		// получение доступных реквизитов из источников
		
		Для Каждого Источник Из Источники Цикл
			
			Если Источник.Тип = ТипыИсточников.МетаДанныеОбъекта ИЛИ Источник.Тип = ТипыИсточников.ТабличнаяЧасть Тогда
				
				ПутьИсточника = ?(ЗначениеЗаполнено(Источник.Путь), Источник.Путь + ".", "");
				Объект = Источник.Объект;
				ЭтоСсылочныйТип = МетаДанные.Справочники.Содержит(Объект) ИЛИ МетаДанные.ПланыВидовХарактеристик.Содержит(Объект) ИЛИ МетаДанные.Документы.Содержит(Объект);
				Если Источник.Тип = ТипыИсточников.ТабличнаяЧасть ИЛИ ЭтоСсылочныйТип ИЛИ МетаДанные.Перечисления.Содержит(Объект) Тогда
					
					Если ЭтоСсылочныйТип Тогда
						ИмяРеквизита = "ВерсияДанных";
						СтрокаРеквизита = ТаблицаДоступныхРеквизитов.Добавить();
						СтрокаРеквизита.Имя = ИмяРеквизита;
						СтрокаРеквизита.Реквизит = Неопределено;
						СтрокаРеквизита.Путь = ПутьИсточника + ИмяРеквизита;
						СтрокаРеквизита.Тип = ТипыИсточников.Реквизит;
					КонецЕсли;
					
					Для Каждого Реквизит Из Объект.СтандартныеРеквизиты Цикл
						ИмяРеквизита = Реквизит.Имя;
						СтрокаРеквизита = ТаблицаДоступныхРеквизитов.Добавить();
						СтрокаРеквизита.Имя = ИмяРеквизита;
						СтрокаРеквизита.Реквизит = Реквизит;
						СтрокаРеквизита.Путь = ПутьИсточника + ИмяРеквизита;
						СтрокаРеквизита.Тип = ТипыИсточников.Реквизит;
					КонецЦикла; 
					
					Если Источник.Тип = ТипыИсточников.ТабличнаяЧасть ИЛИ ЭтоСсылочныйТип Тогда
						Для Каждого Реквизит Из Объект.Реквизиты Цикл
							СтрокаРеквизита = ТаблицаДоступныхРеквизитов.Добавить();
							СтрокаРеквизита.Имя = Реквизит.Имя;
							СтрокаРеквизита.Реквизит = Реквизит;
							СтрокаРеквизита.Путь = ПутьИсточника + Реквизит.Имя;
							СтрокаРеквизита.Тип = ТипыИсточников.Реквизит;
						КонецЦикла; 
					
						Если ЭтоСсылочныйТип Тогда
							Для Каждого Реквизит Из Объект.ТабличныеЧасти Цикл
								СтрокаРеквизита = ТаблицаДоступныхРеквизитов.Добавить();
								СтрокаРеквизита.Имя = Реквизит.Имя;
								СтрокаРеквизита.Реквизит = Реквизит;
								СтрокаРеквизита.Путь = ПутьИсточника + Реквизит.Имя;
								СтрокаРеквизита.Тип = ТипыИсточников.ТабличнаяЧасть;
							КонецЦикла;
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли; 
				
			ИначеЕсли Источник.Тип = ТипыИсточников.Реквизит Тогда
				
				ПутьИсточника = Источник.Путь;
				Типы = Источник.Объект.Тип.Типы();
				Для Каждого Тип Из Типы Цикл
					Источник = Источники.Добавить();
					Источник.Объект = Тип;
					Источник.Путь = ПутьИсточника;
					Источник.Тип = ТипыИсточников.Тип;
				КонецЦикла;
				
			ИначеЕсли Источник.Тип = ТипыИсточников.Тип Тогда
				
				ПутьИсточника = Источник.Путь;
				Тип = Источник.Объект;
				МетаДанныеТипаСтруктура = МетаДанныеТипов[Тип];
				Если МетаДанныеТипаСтруктура = Неопределено Тогда
					МетаДанныеТипа = МетаДанные.НайтиПоТипу(Тип);
					МетаДанныеТипаСтруктура = Новый Структура("Данные", МетаДанныеТипа);
					МетаДанныеТипов[Тип] = МетаДанныеТипаСтруктура;
				Иначе
					МетаДанныеТипа = МетаДанныеТипаСтруктура.Данные;
				КонецЕсли; 
				
				Если МетаДанныеТипа <> Неопределено Тогда
					
					Источник = Источники.Добавить();
					Источник.Объект = МетаДанныеТипа;
					Источник.Путь = ПутьИсточника;
					Источник.Тип = ТипыИсточников.МетаДанныеОбъекта;
						
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		/////////////////////////////////////////////////////////////////////
		// проверить выражения
		МассивРеквизитов = Новый Массив;
		Для Каждого СтрокаПроверяемогоВыражения Из СтрокиПроверяемыхВыражений Цикл
			НайденныеРеквизиты = ТаблицаДоступныхРеквизитов.НайтиСтроки(Новый Структура("Путь", СтрокаПроверяемогоВыражения.ПутьДоЭтогоУровня));
			Если НайденныеРеквизиты.Количество() > 0 Тогда
				вмс_РаботаСКоллекциями.ДобавитьЭлементыКоллекции(МассивРеквизитов, НайденныеРеквизиты);
			Иначе
				МассивУдаляемыхСтрок = ТаблицаПроверяемыхВыражений.НайтиСтроки(Новый Структура("Имя", СтрокаПроверяемогоВыражения.Имя));
				вмс_РаботаСКоллекциями.УдалитьЭлементыКоллекции(ТаблицаПроверяемыхВыражений, МассивУдаляемыхСтрок);
			КонецЕсли;
		КонецЦикла;
		
		/////////////////////////////////////////////////////////////////////
		//
		Если Уровень = МаксУровень Тогда
			Прервать;
		КонецЕсли; 
		
		/////////////////////////////////////////////////////////////////////
		// получить вложенные реквизиты
		Источники.Очистить();
		вмс_РаботаСКоллекциями.УдалитьДублиВМассиве(МассивРеквизитов);
		Для Каждого СтрокаРеквизита Из МассивРеквизитов Цикл
			Если СтрокаРеквизита.Реквизит <> Неопределено Тогда
				Источник = Источники.Добавить();
				Источник.Объект = СтрокаРеквизита.Реквизит;
				Источник.Путь = СтрокаРеквизита.Путь;
				Источник.Тип = СтрокаРеквизита.Тип;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаДоступныхРеквизитов.Очистить();
		
	КонецЦикла;
	
	ТаблицаПроверяемыхВыражений.Свернуть("Имя");
	МассивДоступныхРеквизитов = ТаблицаПроверяемыхВыражений.ВыгрузитьКолонку("Имя");
		
	Возврат МассивДоступныхРеквизитов;
	
КонецФункции

Функция ПолучитьДанныеТипаОбъекта(знач ТипОбъекта) Экспорт
	
	Если ТипЗнч(ТипОбъекта) = Тип("Строка") Тогда
		ИмяТипа = ТипОбъекта;
		Попытка
			ТипОбъекта = Тип(ИмяТипа);
		Исключение
			ТипОбъекта = Неопределено;
		КонецПопытки;
	Иначе
		ИмяТипа = вмс_ОбщегоНазначенияВызовСервера.ПолучитьИмяТипа(ТипОбъекта);
	КонецЕсли;
	
	МетаДанныеОбъекта = вмс_ОбщегоНазначенияСервер.ПолучитьМетаданныеОбъекта(ТипОбъекта);
	
	ЭтоТипОбъектаИБ = ИмяТипа <> Неопределено И (Найти(ИмяТипа, "Объект.") > 0 ИЛИ Найти(ИмяТипа, "НаборЗаписей.") > 0);
	ЭтоТипСсылкиОбъектаИБ =  ИмяТипа <> Неопределено И Найти(ИмяТипа, "Ссылка.") > 0;
	ЕстьМетаданныеОбъекта = МетаДанныеОбъекта <> Неопределено;
	
	ЭтоПеречисление = Ложь;
	СоответствиеЗначенийПоИмени = Новый Соответствие;
	
	Если МетаДанныеОбъекта <> Неопределено Тогда
		МенеджерОбъектов = вмс_ОбщегоНазначенияСервер.ПолучитьМенеджерОбъектов(ИмяТипа);
		Если МетаДанные.Перечисления.Содержит(МетаДанныеОбъекта) Тогда
			Для Каждого ЗначениеПеречисления Из МетаДанныеОбъекта.ЗначенияПеречисления Цикл
				СоответствиеЗначенийПоИмени[ВРЕГ(ЗначениеПеречисления.Имя)] = МенеджерОбъектов[ЗначениеПеречисления.Имя];
			КонецЦикла;
			ЭтоПеречисление = Истина;
		КонецЕсли;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Имя", ИмяТипа);
	Данные.Вставить("ЭтоТипОбъектаИБ", ЭтоТипОбъектаИБ);
	Данные.Вставить("ЭтоТипСсылкиОбъектаИБ", ЭтоТипСсылкиОбъектаИБ);
	Данные.Вставить("ЕстьМетаданныеОбъекта", ЕстьМетаданныеОбъекта);
	Данные.Вставить("ЭтоПеречисление", ЭтоПеречисление);
	Данные.Вставить("СоответствиеЗначенийПоИмени", СоответствиеЗначенийПоИмени);
	Данные.Вставить("МенеджерОбъектов", МенеджерОбъектов);
	Данные.Вставить("ТипОбъекта", ТипОбъекта);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьМенеджерОбъектов(Объект) Экспорт
	
	МенеджерОбъекта = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьМенеджерОбъектов(Объект);
	Если МенеджерОбъекта <> Неопределено Тогда
		Возврат МенеджерОбъекта;
	КонецЕсли;
	
	МенеджерОбъекта = ПолучитьМенеджерОбъектовБазы(Объект);
	Возврат МенеджерОбъекта;
	
КонецФункции

Функция ПолучитьМенеджерОбъектовБазы(Объект) Экспорт
	
	МетаданныеОбъекта = ПолучитьМетаДанныеОбъекта(Объект);
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();

	ЭлементыИмени = вмс_РаботаСКоллекциями.ЗначениеВМассив(ИмяОбъекта, ".", Ложь);
	Если ЭлементыИмени.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Имя1 = ЭлементыИмени[0];
	Имя2 = ЭлементыИмени[1];
	Если Имя1 = "Справочник" Тогда
		Имя1 = "Справочники";
	ИначеЕсли Имя1 = "Документ" Тогда 
		Имя1 = "Документы";
	ИначеЕсли Имя1 = "ПланВидовХарактеристик" Тогда 
		Имя1 = "ПланыВидовХарактеристик";
	ИначеЕсли Имя1 = "РегистрНакопления" Тогда 
		Имя1 = "РегистрыНакопления";
	ИначеЕсли Имя1 = "РегистрСведений" Тогда 
		Имя1 = "РегистрыСведений";
	ИначеЕсли Имя1 = "Перечисление" Тогда 
		Имя1 = "Перечисления";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Менеджер = Вычислить(Имя1 + "[""" + Имя2 + """]");
	Возврат Менеджер;
	
КонецФункции

Функция ПолучитьМетаданныеОбъекта(знач Объект) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = Тип("Массив") Тогда
		Объект = РК.МассивВСтроку(Объект, ".");
		ТипОбъекта = ТипЗнч(Объект);
	КонецЕсли;
	
	Если ТипОбъекта = Тип("Строка") Тогда
		ИмяОбъекта = Объект;
		ИмяОбъекта = СтрЗаменить(ИмяОбъекта, "Объект.", ".");
		ИмяОбъекта = СтрЗаменить(ИмяОбъекта, "Ссылка.", ".");
		ИмяОбъекта = СтрЗаменить(ИмяОбъекта, "НаборЗаписей.", ".");
		ИмяОбъекта = СтрЗаменить(ИмяОбъекта, "Object.", ".");
		ИмяОбъекта = СтрЗаменить(ИмяОбъекта, "Ref.", ".");
		ИмяОбъекта = СтрЗаменить(ИмяОбъекта, "RecordSet.", ".");
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = Тип("Тип") Тогда
		МетаданныеОбъекта = Метаданные.НайтиПоТипу(Объект);
	ИначеЕсли ТипОбъекта = Тип("ОбъектМетаданных") Тогда
		МетаданныеОбъекта = Объект;
	Иначе
		МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипОбъекта);
	КонецЕсли;
	
	Возврат МетаданныеОбъекта;
	
КонецФункции

Функция ПолучитьОбъектИБ(знач ТипОбъекта=Неопределено, пСсылка=Неопределено, пЭтоГруппа=Неопределено) Экспорт
	
	Перем Гуид, Ссылка, ЭтоГруппа, Объект;
	
	Если ТипОбъекта = Неопределено Тогда
		Если пСсылка = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ТипОбъекта = ТипЗнч(пСсылка);
	КонецЕсли;
	
	Если пСсылка <> Неопределено Тогда
		Если ТипЗнч(пСсылка) = Тип("Строка") Тогда
			Гуид = Новый УникальныйИдентификатор(пСсылка);
		ИначеЕсли ТипЗнч(пСсылка) = Тип("УникальныйИдентификатор") Тогда
			Гуид = пСсылка;
		Иначе
			Гуид = пСсылка.УникальныйИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
	МетаданныеОбъекта = ПолучитьМетаДанныеОбъекта(ТипОбъекта);
	Если МетаданныеОбъекта <> Неопределено Тогда
		
		Менеджер = ПолучитьМенеджерОбъектовБазы(МетаданныеОбъекта);
		Если Гуид <> Неопределено Тогда
			Ссылка = Менеджер.ПолучитьСсылку(Гуид);
		КонецЕсли;

		Если ТипЗнч(пЭтоГруппа) = Тип("Строка") Тогда
			ЭтоГруппа = XMLЗначение(Тип("Булево"), пЭтоГруппа);
		Иначе
			ЭтоГруппа = пЭтоГруппа = Истина;
		КонецЕсли;
		
		Если Ссылка <> Неопределено И НЕ Ссылка.Пустая() Тогда
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				// объект существует
				Если Метаданные.Справочники.Содержит(МетаданныеОбъекта) ИЛИ Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеОбъекта) Тогда
					Если Объект.ЭтоГруппа=ЭтоГруппа Тогда
						Возврат Объект;
					КонецЕсли;
				Иначе
					Возврат Объект;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// создаем новый объект
		Если Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
			Объект = Менеджер.СоздатьДокумент();
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеОбъекта) ИЛИ Метаданные.РегистрыНакопления.Содержит(МетаДанныеОбъекта) Тогда
			Объект = Менеджер.СоздатьНаборЗаписей();
		Иначе
			Если ЭтоГруппа Тогда
				Объект = Менеджер.СоздатьГруппу();
			Иначе
				Объект = Менеджер.СоздатьЭлемент();
			КонецЕсли;
		КонецЕсли;

		Если Ссылка <> Неопределено Тогда
			Объект.УстановитьСсылкуНового(Ссылка);
		КонецЕсли;
		
	ИначеЕсли Гуид <> Неопределено Тогда
		
		МетаданныеОбъекта = ПолучитьМетаДанныеОбъекта("Справочник.КвазиСсылки");
		Если МетаданныеОбъекта <> Неопределено Тогда
			Менеджер = ПолучитьМенеджерОбъектовБазы(МетаданныеОбъекта);
			Если ТипЗнч(ТипОбъекта) = Тип("Строка") Тогда
				// создаем квази объект
				ИмяТипаОбъекта = ТипОбъекта;
				ИмяТипаОбъекта = СтрЗаменить(ИмяТипаОбъекта, "Ссылка.", ".");
				ИмяТипаОбъекта = СтрЗаменить(ИмяТипаОбъекта, "Объект.", ".");
				Объект = вмс_ОбщегоНазначенияВызовСервера.ПолучитьОбъектКвазиСсылкиИБ(ИмяТипаОбъекта, Гуид);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции

Функция ПолучитьТаблицуИменТиповОбъектов(Объекты) Экспорт

	Перем РК;
	
	РК = вмс_РаботаСКоллекциями;
	
	Кэш = Новый Соответствие;
	
	ТаблицаИмен = РК.НоваяТаблицаЗначений("Объект, ИмяТипа, ЭтоКвазиТип");
	ТипКвазиСсылки = Тип("СправочникСсылка.КвазиСсылки");
	МассивОбъектов = РК.ЗначениеВМассив(Объекты, , Ложь);
	Для Каждого Объект Из МассивОбъектов Цикл
		
		ТипОбъекта = ТипЗнч(Объект);
		Если ТипОбъекта = ТипКвазиСсылки Тогда 
			ЭтоКвазиТип = Истина;
			ИмяТипа = Кэш[Объект];
			Если ИмяТипа = Неопределено Тогда
				ИмяТипа = Объект.ИмяТипа;
				Кэш[Объект] = Истина;
			КонецЕсли;
		Иначе
			ЭтоКвазиТип = Ложь;
			ИмяТипа = Кэш[ТипОбъекта];
			Если ИмяТипа = Неопределено Тогда
				МетаДанныеОбъекта = МетаДанные.НайтиПоТипу(ТипОбъекта);
				Если МетаДанныеОбъекта <> Неопределено Тогда
					ИмяТипа = МетаДанныеОбъекта.ПолноеИмя();
				Иначе
					ИмяТипа = "";
				КонецЕсли;
				Кэш[ТипОбъекта] = ИмяТипа;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаИмени = ТаблицаИмен.Добавить();
		СтрокаИмени.Объект = Объект;
		СтрокаИмени.ИмяТипа = ИмяТипа;
		СтрокаИмени.ЭтоКвазиТип = ЭтоКвазиТип;
		
	КонецЦикла;
	
	Возврат ТаблицаИмен;
	
КонецФункции

Функция ПолучитьТаблицуБлизостиЭлементов(Элементы) Экспорт
	
	Возврат ПолучитьТаблицуБлизостиЭлементов1(Элементы);
	
КонецФункции
	
Функция ПолучитьТаблицуБлизостиЭлементов1(Элементы) Экспорт

	Перем РК;
	
	РК = вмс_РаботаСКоллекциями;
	
	ТаблицаИменТиповОбъектов = ПолучитьТаблицуИменТиповОбъектов(Элементы);
	
	ТаблицаИменТипов = ТаблицаИменТиповОбъектов.Скопировать();
	ТаблицаИменТипов.Свернуть("ИмяТипа");
	ТаблицаИменТипов.Колонки.Добавить("ИмяПараметраЗапроса");
	ТаблицаИменТипов.Колонки.Добавить("МетаданныеОбъекта");
	
	МассивТипов = Новый Массив;
	Для Каждого СтрокаТипа Из ТаблицаИменТипов Цикл
		ИмяТипа = СтрЗаменить(СтрокаТипа.ИмяТипа, ".", "Ссылка.");
		МассивТипов.Добавить(Тип(ИмяТипа));
	КонецЦикла;
	Если МассивТипов.Количество() = 0 Тогда
		МассивТипов.Добавить(Тип("Число"));
	КонецЕсли;
	ТипКолонки = Новый ОписаниеТипов(МассивТипов);

	ИндексСтроки = ТаблицаИменТипов.Количество();
	Пока ИндексСтроки > 0 Цикл
		ИндексСтроки = ИндексСтроки - 1;
		СтрокаТипа = ТаблицаИменТипов[ИндексСтроки];
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(СтрокаТипа.ИмяТипа);
		Если МетаданныеОбъекта = Неопределено
			ИЛИ Не Метаданные.Справочники.Содержит(МетаданныеОбъекта) И Не Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеОбъекта) Тогда
			ТаблицаИменТипов.Удалить(СтрокаТипа);
			Продолжить;
		КонецЕсли;
		СтрокаТипа.МетаданныеОбъекта = МетаданныеОбъекта;
	КонецЦикла;

	ТекстШаблонаЗапросаПоОбъекту =
	"ВЫБРАТЬ
	|	ТаблицаОбъекта.Ссылка КАК Элемент,
	|	ТаблицаОбъекта.Родитель КАК Родитель,
	|	&ИмяТипа КАК ИмяТипа
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК ТаблицаОбъекта
	|ГДЕ
	|	ТаблицаОбъекта.Ссылка В(&МассивОбъектов)";
	
	Запрос = Новый Запрос;
	
	ТекстЗапросаПоОбъектам = "";
	СвязкаТекстовЗапросов = Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС + Символы.ПС;
	ПрефиксПараметра = "МассивОбъектов";
	НомерЗапроса = 1;
	МассивТипов = Новый Массив;
	Для Каждого СтрокаТипа Из РК.ВыгрузитьЭлементыКоллекцииВМассив(ТаблицаИменТипов) Цикл
		МассивТипов.Добавить(Тип(ИмяТипа));
		МетаданныеОбъекта = СтрокаТипа.МетаданныеОбъекта;
		Если Не МетаданныеОбъекта.Иерархический Тогда
			ТаблицаИменТипов.Удалить(СтрокаТипа);
			Продолжить;
		КонецЕсли;
		
		ИмяТаблицы = СтрокаТипа.ИмяТипа;
		НомерЗапросаСтрокой = Формат(НомерЗапроса, "ЧГ=0");
		ИмяПараметра = ПрефиксПараметра + НомерЗапросаСтрокой;
		ТекстЗапросаПоОбъекту = ТекстШаблонаЗапросаПоОбъекту;
		ТекстЗапросаПоОбъекту = СтрЗаменить(ТекстЗапросаПоОбъекту, "Справочник.вмс_МестаХранения", ИмяТаблицы);
		ТекстЗапросаПоОбъекту = СтрЗаменить(ТекстЗапросаПоОбъекту, "&ИмяТипа", """" + ИмяТаблицы + """");
		ТекстЗапросаПоОбъекту = СтрЗаменить(ТекстЗапросаПоОбъекту, "&" + ПрефиксПараметра, "&" + ИмяПараметра);
		Если ТекстЗапросаПоОбъектам <> "" Тогда
			ТекстЗапросаПоОбъектам = ТекстЗапросаПоОбъектам + СвязкаТекстовЗапросов;
		КонецЕсли;
		ТекстЗапросаПоОбъектам = ТекстЗапросаПоОбъектам + ТекстЗапросаПоОбъекту;

		МассивОбъектов = РК.ВыгрузитьЗначенияКолонкиКоллекции(ТаблицаИменТиповОбъектов.НайтиСтроки(Новый Структура("ИмяТипа", СтрокаТипа.ИмяТипа)), "Объект");
		Запрос.УстановитьПараметр(ИмяПараметра, МассивОбъектов);
		
		СтрокаТипа.ИмяПараметраЗапроса = ИмяПараметра;
		НомерЗапроса = НомерЗапроса + 1;
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапросаПоОбъектам;
	
	ТаблицаБлизости = Новый ТаблицаЗначений;
	ТаблицаБлизости.Колонки.Добавить("Элемент", ТипКолонки);
	ТаблицаБлизости.Колонки.Добавить("Предок", ТипКолонки);
	ТаблицаБлизости.Колонки.Добавить("ИмяТипа", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	ТаблицаБлизости.Индексы.Добавить("Предок");
	Для Каждого СтрокаОбъекта Из ТаблицаИменТиповОбъектов Цикл
		СтрокаБлизости = ТаблицаБлизости.Добавить();
		СтрокаБлизости.Элемент = СтрокаОбъекта.Объект;
		СтрокаБлизости.Предок = СтрокаОбъекта.Объект;
		СтрокаБлизости.ИмяТипа = СтрокаОбъекта.ИмяТипа;
	КонецЦикла;
	
	Пока ТаблицаИменТипов.Количество() > 0 Цикл
			
		РезультатЗапроса = Запрос.Выполнить();
		ТаблицаЭлементов = РезультатЗапроса.Выгрузить();
		Для Каждого СтрокаЭлемента Из ТаблицаЭлементов Цикл
			НайденныеСтрокиБлизости = ТаблицаБлизости.НайтиСтроки(Новый Структура("Предок", СтрокаЭлемента.Элемент));
			Для Каждого СтрокаБлизости Из НайденныеСтрокиБлизости Цикл
				НоваяСтрокаБлизости = ТаблицаБлизости.Добавить();
				НоваяСтрокаБлизости.Элемент = СтрокаБлизости.Элемент;
				НоваяСтрокаБлизости.Предок = СтрокаЭлемента.Родитель;
				НоваяСтрокаБлизости.ИмяТипа = СтрокаЭлемента.ИмяТипа;
			КонецЦикла;
		КонецЦикла;
		
		ИндексСтроки = ТаблицаИменТипов.Количество();
		Пока ИндексСтроки > 0 Цикл
			ИндексСтроки = ИндексСтроки - 1;
			СтрокаТипа = ТаблицаИменТипов[ИндексСтроки];
			МассивОбъектов = РК.ВыгрузитьЗначенияКолонкиКоллекции(ТаблицаЭлементов.НайтиСтроки(Новый Структура("ИмяТипа", СтрокаТипа.ИмяТипа)), "Родитель");
			Запрос.УстановитьПараметр(СтрокаТипа.ИмяПараметраЗапроса, МассивОбъектов);
			Если МассивОбъектов.Количество() = 0 Тогда
				ТаблицаИменТипов.Удалить(СтрокаТипа);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаБлизости.Свернуть("Элемент, Предок, ИмяТипа");
	Возврат ТаблицаБлизости;

КонецФункции

Функция ПолучитьТаблицуБлизостиЭлементов2(Элементы, МаксимальнаяГлубина=Неопределено) Экспорт
	
	Запрос = ПолучитьЗапросПоТаблицеБлизостиЭлементов(Элементы, МаксимальнаяГлубина);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаБлизостиЭлементов = РезультатЗапроса.Выгрузить();
	ТаблицаБлизостиЭлементов.Сортировать("Элемент, Уровень");
	Возврат ТаблицаБлизостиЭлементов;
	
КонецФункции

Функция ПолучитьЗапросПоТаблицеБлизостиЭлементов(Элементы, знач МаксимальнаяГлубина=Неопределено, ИмяВременнойТаблицы=Неопределено) Экспорт
	
	Перем РК;
	
	РК = вмс_РаботаСКоллекциями;
	
	Если МаксимальнаяГлубина = Неопределено Тогда
		МаксимальнаяГлубина = 20;
	КонецЕсли;
	
	МассивЭлементов = РК.ЗначениеВМассив(Элементы, , Ложь);
	ТаблицаТиповЭлементов = Новый ТаблицаЗначений;
	ТаблицаТиповЭлементов.Колонки.Добавить("Тип");
	ТаблицаТиповЭлементов.Колонки.Добавить("ИмяТипа");
	ТаблицаТиповЭлементов.Колонки.Добавить("Иерархический");
	
	ТаблицаЭлементов = Новый ТаблицаЗначений;
	ТаблицаЭлементов.Колонки.Добавить("Тип");
	ТаблицаЭлементов.Колонки.Добавить("Элемент");
	
	Для Каждого Элемент Из МассивЭлементов Цикл
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТаблицаТиповЭлементов.НайтиСтроки(Новый Структура("Тип", ТипЭлемента)).Количество() = 0 Тогда
			МетаданныеЭлемента = Метаданные.НайтиПоТипу(ТипЭлемента);
			Если МетаданныеЭлемента <> Неопределено Тогда
				СтрокаТипаЭлементов = ТаблицаТиповЭлементов.Добавить();
				СтрокаТипаЭлементов.Тип = ТипЭлемента;
				СтрокаТипаЭлементов.ИмяТипа = МетаданныеЭлемента.ПолноеИмя();
				СтрокаТипаЭлементов.Иерархический = (Метаданные.Справочники.Содержит(МетаданныеЭлемента) ИЛИ Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеЭлемента)) И МетаданныеЭлемента.Иерархический;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаЭлемента = ТаблицаЭлементов.Добавить();
		СтрокаЭлемента.Тип = ТипЭлемента;
		СтрокаЭлемента.Элемент = Элемент;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	ТекстШаблонаЗапросаОсновнойТаблицы =
	"ВЫБРАТЬ
	|	ТаблицаЭлементовИБ.Ссылка КАК Элемент,
	|	ТаблицаЭлементовИБ.Ссылка КАК Предок
	|ПОМЕСТИТЬ ВТБлизостиЭлементов0
	|ИЗ
	|	Справочник.Номенклатура КАК ТаблицаЭлементовИБ
	|ГДЕ
	|	ТаблицаЭлементовИБ.Ссылка В(&МассивЭлементов)";
	
	ТекстШаблонаЗапросаУровняДляТипаЭлементов =
	"ВЫБРАТЬ
	|	ВТБлизостиЭлементов0.Элемент КАК Элемент,
	|	ТаблицаЭлементовИБСледующегоУровня.Родитель КАК Предок
	|ПОМЕСТИТЬ ВТБлизостиЭлементов1
	|ИЗ
	|	ВТБлизостиЭлементов0 КАК ВТБлизостиЭлементов0
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТаблицаЭлементовИБСледующегоУровня
	|		ПО ВТБлизостиЭлементов0.Предок = ТаблицаЭлементовИБСледующегоУровня.Ссылка";
	
	ПустойСписок = ТаблицаТиповЭлементов.Количество() = 0;
	Если ПустойСписок Тогда
		ТекстШаблонаЗапросаТаблицыИтогаДляУровня =
		"ВЫБРАТЬ
		|	NULL КАК Элемент,
		|	NULL КАК Предок,
		|	0 КАК Уровень
		|ПОМЕСТИТЬ ВТИтог
		|ГДЕ
		|	ЛОЖЬ";
	Иначе
		ТекстШаблонаЗапросаТаблицыИтогаДляУровня =
		"ВЫБРАТЬ
		|	ВТБлизостиЭлементов0.Элемент,
		|	ВТБлизостиЭлементов0.Предок,
		|	0 КАК Уровень
		|ПОМЕСТИТЬ ВТИтог
		|ИЗ
		|	ВТБлизостиЭлементов0 КАК ВТБлизостиЭлементов0";
	КонецЕсли;
	
	ТекстЗапросаОсновнойТаблицы = "";
	ТекстШаблонаЗапросаУровняЭлементов = "";
	ТекстЗапросаУровнейЭлементов = "";
	ТекстЗапросаТаблицыИтога = ТекстШаблонаЗапросаТаблицыИтогаДляУровня;
	Если ИмяВременнойТаблицы <> Неопределено Тогда
		ТекстЗапросаТаблицыИтога = СтрЗаменить(ТекстЗапросаТаблицыИтога, "ВТИтог", ИмяВременнойТаблицы);
	Иначе
		ТекстЗапросаТаблицыИтога = СтрЗаменить(ТекстЗапросаТаблицыИтога, Символы.ПС + "ПОМЕСТИТЬ ВТИтог", "");
	КонецЕсли;
	
	Если ПустойСписок Тогда
		Запрос.Текст = ТекстЗапросаТаблицыИтога;
		Возврат Запрос;
	КонецЕсли;
	
	РазделительВременныхТаблиц = Символы.ПС + ";" + Символы.ПС + Символы.ПС;
	
	ПрефиксПараметраЗапроса = "МассивЭлементов";
	НомерТипа = 1;
	Для Каждого СтрокаТипаЭлементов Из ТаблицаТиповЭлементов Цикл
		
		ТекстЗапросаОсновнойТаблицыДляТипаЭлементов = ТекстШаблонаЗапросаОсновнойТаблицы;
		ТекстЗапросаОсновнойТаблицыДляТипаЭлементов = СтрЗаменить(ТекстЗапросаОсновнойТаблицыДляТипаЭлементов, "Справочник.Номенклатура", СтрокаТипаЭлементов.ИмяТипа);
		МассивЭлементовПоТипу = Новый Массив;
		СтрокиЭлементовПоТипу = ТаблицаЭлементов.НайтиСтроки(Новый Структура("Тип", СтрокаТипаЭлементов.Тип));
		Для Каждого СтрокаЭлементовПоТипу Из СтрокиЭлементовПоТипу Цикл
			МассивЭлементовПоТипу.Добавить(СтрокаЭлементовПоТипу.Элемент);
		КонецЦикла;
		ИмяПараметраЗапроса = ПрефиксПараметраЗапроса + Формат(НомерТипа, "ЧГ=0");
		ТекстЗапросаОсновнойТаблицыДляТипаЭлементов = СтрЗаменить(ТекстЗапросаОсновнойТаблицыДляТипаЭлементов, "&" + ПрефиксПараметраЗапроса, "&" + ИмяПараметраЗапроса);
		Если ТекстЗапросаОсновнойТаблицы <> "" Тогда
			ТекстЗапросаОсновнойТаблицыДляТипаЭлементов = СтрЗаменить(ТекстЗапросаОсновнойТаблицыДляТипаЭлементов, Символы.ПС + "ПОМЕСТИТЬ ВТБлизостиЭлементов0", "");
			ТекстЗапросаОсновнойТаблицы = ТекстЗапросаОсновнойТаблицы + Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС + Символы.ПС;
		КонецЕсли;
		Запрос.УстановитьПараметр(ИмяПараметраЗапроса, МассивЭлементовПоТипу);
		ТекстЗапросаОсновнойТаблицы = ТекстЗапросаОсновнойТаблицы + ТекстЗапросаОсновнойТаблицыДляТипаЭлементов;
		
		/////////////////////////////////////////////////////////////////////////////////
		Если СтрокаТипаЭлементов.Иерархический Тогда
			ТекстЗапросаУровняДляТипаЭлементов = ТекстШаблонаЗапросаУровняДляТипаЭлементов;
			ТекстЗапросаУровняДляТипаЭлементов = СтрЗаменить(ТекстЗапросаУровняДляТипаЭлементов, "Справочник.Номенклатура", СтрокаТипаЭлементов.ИмяТипа);
			Если ТекстШаблонаЗапросаУровняЭлементов <> "" Тогда
				ТекстЗапросаУровняДляТипаЭлементов = СтрЗаменить(ТекстЗапросаУровняДляТипаЭлементов, Символы.ПС + "ПОМЕСТИТЬ ВТБлизостиЭлементов1", "");
				ТекстШаблонаЗапросаУровняЭлементов = ТекстШаблонаЗапросаУровняЭлементов + Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС + Символы.ПС;
			КонецЕсли;
			ТекстШаблонаЗапросаУровняЭлементов = ТекстШаблонаЗапросаУровняЭлементов + ТекстЗапросаУровняДляТипаЭлементов;
		КонецЕсли;
		
		НомерТипа = НомерТипа + 1;
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + ТекстЗапросаОсновнойТаблицы;
	Если ТекстШаблонаЗапросаУровняЭлементов <> "" Тогда
		ИмяТаблицыТекущегоУровня = "ВТБлизостиЭлементов0";
		Для НомерУровня=1 По МаксимальнаяГлубина Цикл
			НомерУровняСтрокой = Формат(НомерУровня, "ЧГ=0");
			ТекстЗапросаУровняЭлементов = ТекстШаблонаЗапросаУровняЭлементов;
			ИмяТаблицыПредыдущегоУровня = ИмяТаблицыТекущегоУровня;
			ИмяТаблицыТекущегоУровня = "ВТБлизостиЭлементов" + НомерУровняСтрокой;
			ТекстЗапросаУровняЭлементов = СтрЗаменить(ТекстЗапросаУровняЭлементов, "ВТБлизостиЭлементов1", ИмяТаблицыТекущегоУровня);
			ТекстЗапросаУровняЭлементов = СтрЗаменить(ТекстЗапросаУровняЭлементов, "ВТБлизостиЭлементов0", ИмяТаблицыПредыдущегоУровня);
			Если ТекстЗапросаУровнейЭлементов <> "" Тогда
				ТекстЗапросаУровнейЭлементов = ТекстЗапросаУровнейЭлементов + РазделительВременныхТаблиц;
			КонецЕсли;
			ТекстЗапросаУровнейЭлементов = ТекстЗапросаУровнейЭлементов + ТекстЗапросаУровняЭлементов;
			
			ТекстЗапросаТаблицыИтогаДляУровня = ТекстШаблонаЗапросаТаблицыИтогаДляУровня;
			ТекстЗапросаТаблицыИтогаДляУровня = СтрЗаменить(ТекстЗапросаТаблицыИтогаДляУровня, "0 КАК Уровень", НомерУровняСтрокой + " КАК Уровень");
			ТекстЗапросаТаблицыИтогаДляУровня = СтрЗаменить(ТекстЗапросаТаблицыИтогаДляУровня, Символы.ПС + "ПОМЕСТИТЬ ВТИтог", "");
			ТекстЗапросаТаблицыИтогаДляУровня = СтрЗаменить(ТекстЗапросаТаблицыИтогаДляУровня, "ВТБлизостиЭлементов0", ИмяТаблицыТекущегоУровня);
			ТекстЗапросаТаблицыИтога = ТекстЗапросаТаблицыИтога + Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС + Символы.ПС + ТекстЗапросаТаблицыИтогаДляУровня;
		КонецЦикла;
		
		Запрос.Текст = Запрос.Текст + РазделительВременныхТаблиц + ТекстЗапросаУровнейЭлементов;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + РазделительВременныхТаблиц + ТекстЗапросаТаблицыИтога;
		
	Возврат Запрос;
		
КонецФункции

Функция ПолучитьТекстЗапросаПустыхСсылокТиповОбъектов(ИменаТиповОбъектов, ИмяВременнойТаблицы=Неопределено) Экспорт

	Перем РК;
	
	РК = вмс_РаботаСКоллекциями;
	
	МассивИменТиповОбъектов = РК.ЗначениеВМассив(ИменаТиповОбъектов, , Ложь);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	"""" КАК ИмяТипа,
	|	НЕОПРЕДЕЛЕНО КАК ПустаяСсылка
	|ПОМЕСТИТЬ ВТ
	|ГДЕ
	|	ЛОЖЬ";
	
	Если ЗначениеЗаполнено(ИмяВременнойТаблицы) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТ", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.ПС + "ПОМЕСТИТЬ ВТ", "");
	КонецЕсли;
	
	СвязкаПодзапросов = Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС + Символы.ПС;
	Для Каждого ИмяТипа Из МассивИменТиповОбъектов Цикл
		ТекстПодзапроса =
		"ВЫБРАТЬ
		|	""" + ИмяТипа + """ КАК ИмяТипа,
		|	ЗНАЧЕНИЕ(" + ИмяТипа + ".ПустаяСсылка) КАК ПустаяСсылка";
		ТекстЗапроса = ТекстЗапроса + СвязкаПодзапросов + ТекстПодзапроса;
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

