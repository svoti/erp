Функция ОпределитьЯвляетсяЛиВремяРабочим(ДатаСоВременем) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КалендариРасписаниеРаботы.НомерДня КАК НомерДня
	|ИЗ
	|	Справочник.Календари.РасписаниеРаботы КАК КалендариРасписаниеРаботы
	|ГДЕ
	|	ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), СЕКУНДА, РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ), &Дата, СЕКУНДА)) МЕЖДУ КалендариРасписаниеРаботы.ВремяНачала И КалендариРасписаниеРаботы.ВремяОкончания
	|	И ДЕНЬНЕДЕЛИ(&Дата) = КалендариРасписаниеРаботы.НомерДня";
	
	Запрос.УстановитьПараметр("Дата", ДатаСоВременем);
	РезультатЗапроса = Запрос.Выполнить();
		
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции 

