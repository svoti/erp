Функция ПолучитьРезультатПоискаТоваров(СтрокаПоиска, ДополнительныеПараметры=Неопределено) Экспорт
	
	Перем МассивПолейПоиска, ОграничитьВыборку;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ПоляПоиска = Неопределено;
		ДополнительныеПараметры.Свойство("ПоляПоиска", ПоляПоиска);
		Если ПоляПоиска <> Неопределено Тогда
			МассивПолейПоиска = вмс_РаботаСКоллекциями.ЗначениеВМассив(ПоляПоиска, , Ложь);
		КонецЕсли;
		
		ДополнительныеПараметры.Свойство("ОграничитьВыборку", ОграничитьВыборку);
	КонецЕсли;
	
	Если ТипЗнч(МассивПолейПоиска) <> Тип("Массив") ИЛИ МассивПолейПоиска.Количество() = 0 Тогда
		МассивПолейПоиска = Новый Массив; 
		МассивПолейПоиска.Добавить("Наименование");
		МассивПолейПоиска.Добавить("Код");
		МассивПолейПоиска.Добавить("Артикул");
	КонецЕсли;
	
	Если ТипЗнч(ОграничитьВыборку) <> Тип("Число") Тогда
		ОграничитьВыборку = 10;
	КонецЕсли;
	
	МассивСтрокПоиска = вмс_РаботаСКоллекциями.СтрокуВМассив(СтрокаПоиска, " ");
	КоличествоПоисков = МассивСтрокПоиска.Количество();
	
	СвязкаЗапросов = Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС + Символы.ПС;
	СвязкаПакетов = Символы.ПС + ";" + Символы.ПС + Символы.ПС;
	
	ТаблицаПоиска = Новый ТаблицаЗначений;
	ТаблицаПоиска.Колонки.Добавить("НомерПоиска", Новый ОписаниеТипов("Число"));
	ТаблицаПоиска.Колонки.Добавить("СтрокаПоиска", Новый ОписаниеТипов("Строка"));
	
	Запрос = Новый Запрос;
	Для НомерПоиска=1 По КоличествоПоисков Цикл
		СтрокаПоиска = "%" + МассивСтрокПоиска[НомерПоиска-1] + "%";
		СтрокаТаблицыПоиска = ТаблицаПоиска.Добавить();
		СтрокаТаблицыПоиска.НомерПоиска = НомерПоиска;
		СтрокаТаблицыПоиска.СтрокаПоиска = СтрокаПоиска;
		Запрос.УстановитьПараметр("СтрокаПоиска" + НомерПоиска, СтрокаПоиска);
	КонецЦикла;
	
	ТекстЗапроса = "";
	ТекстЗапроса = ТекстЗапроса +
	"ВЫБРАТЬ
	|	ТаблицаПоиска.НомерПоиска КАК НомерПоиска,
	|	ТаблицаПоиска.СтрокаПоиска КАК СтрокаПоиска
	|ПОМЕСТИТЬ ТаблицаПоиска
	|ИЗ
	|	&ТаблицаПоиска КАК ТаблицаПоиска" + СвязкаПакетов;
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////
	//
	//							Поиск товаров
	//
	
	ТекстШаблонаПоискПоПолю =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Товар,
	|	ТаблицаПоиска.НомерПоиска КАК НомерПоиска,
	|	&НомерПоля КАК НомерПоля
	|ПОМЕСТИТЬ ВТ_Товары1
	|ИЗ
	|	ТаблицаПоиска КАК ТаблицаПоиска
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО (ИСТИНА)
	|ГДЕ
	|	Номенклатура.Наименование ПОДОБНО ТаблицаПоиска.СтрокаПоиска";
	ТекстЗапросаПоТоварам = "";
	НомерПоля = 1;
	Для Каждого ПолеПоиска Из МассивПолейПоиска Цикл
		ТекстПоискПоПолю = ТекстШаблонаПоискПоПолю;
		ТекстПоискПоПолю = СтрЗаменить(ТекстПоискПоПолю, "Номенклатура.Наименование", "Номенклатура." + ПолеПоиска);
		ТекстПоискПоПолю = СтрЗаменить(ТекстПоискПоПолю, "&НомерПоля", НомерПоля);
		Если ТекстЗапросаПоТоварам <> "" Тогда
			ТекстЗапросаПоТоварам = ТекстЗапросаПоТоварам + СвязкаЗапросов;
			ТекстПоискПоПолю = СтрЗаменить(ТекстПоискПоПолю, Символы.ПС + "ПОМЕСТИТЬ ВТ_Товары", "");
		КонецЕсли;
		ТекстЗапросаПоТоварам = ТекстЗапросаПоТоварам + ТекстПоискПоПолю;
		НомерПоля = НомерПоля + 1;
	КонецЦикла;
	
	ТекстЗапросаПоТоварам = ТекстЗапросаПоТоварам + СвязкаПакетов;
	ТекстЗапросаПоТоварам = ТекстЗапросаПоТоварам +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Товары.Товар КАК Товар,
	|	ВТ_Товары.НомерПоля КАК НомерПоля
	|ПОМЕСТИТЬ ВТ_Товары2
	|ИЗ
	|	ВТ_Товары1 КАК ВТ_Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары2.Товар КАК Товар,
	|	ТаблицаПоиска.НомерПоиска КАК НомерПоиска,
	|	ВТ_Товары2.НомерПоля КАК НомерПоля
	|ПОМЕСТИТЬ ВТ_Товары3
	|ИЗ
	|	ТаблицаПоиска КАК ТаблицаПоиска
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Товары2 КАК ВТ_Товары2
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Товары1 КАК ВТ_Товары1
	|		ПО ТаблицаПоиска.НомерПоиска = ВТ_Товары1.НомерПоиска
	|			И (ВТ_Товары2.Товар = ВТ_Товары1.Товар)
	|			И (ВТ_Товары2.НомерПоля = ВТ_Товары1.НомерПоля)
	|ГДЕ
	|	ВТ_Товары1.Товар ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Товар КАК Товар,
	|	ВТ_Товары.НомерПоля КАК НомерПоля
	|ПОМЕСТИТЬ ВТ_Товары4
	|ИЗ
	|	ВТ_Товары1 КАК ВТ_Товары
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Товары.Товар,
	|	ВТ_Товары.НомерПоля
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Товары.НомерПоиска) = &КоличествоПоисков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Товары.Товар КАК Товар
	|ПОМЕСТИТЬ ВТ_Товары5
	|ИЗ
	|	ВТ_Товары4 КАК ВТ_Товары";
	
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаПоТоварам;
	Запрос.Текст = ТекстЗапроса;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТаблицаПоиска", ТаблицаПоиска);
	Запрос.УстановитьПараметр("КоличествоПоисков", КоличествоПоисков);
	Запрос.Выполнить();
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////
	//
	//							Поиск характеристик
	//
	
	ТекстЗапроса = "";
	
	ТаблицаПоискаХарактеристик = Запрос.МенеджерВременныхТаблиц.Таблицы["ВТ_Товары3"].ПолучитьДанные().Выгрузить();
	ТаблицаПоискаХарактеристик.Колонки.НомерПоиска.Имя = "ВариантПоиска";
	вмс_РаботаСКоллекциями.ИзменитьТипКолонкиТаблицыЗначений(ТаблицаПоискаХарактеристик, "ВариантПоиска", Неопределено);
	вмс_РаботаСКоллекциями.СвернутьКоллекциюЗначений(ТаблицаПоискаХарактеристик, "Товар, НомерПоля", "ВариантПоиска", "Строка");
	ТаблицаПоискаХарактеристик.Свернуть("Товар, ВариантПоиска");
	
	ТаблицаВариантовПоискаХарактеристик = ТаблицаПоискаХарактеристик.Скопировать();
	ТаблицаВариантовПоискаХарактеристик.Свернуть("ВариантПоиска");
	
	Для Каждого СтрокаПоискаХарактеристик Из ТаблицаПоискаХарактеристик  Цикл
		СтрокаВариантаПоискаХарактеристик = ТаблицаВариантовПоискаХарактеристик.НайтиСтроки(Новый Структура("ВариантПоиска", СтрокаПоискаХарактеристик.ВариантПоиска))[0];
		НомерВарианта = ТаблицаВариантовПоискаХарактеристик.Индекс(СтрокаВариантаПоискаХарактеристик) + 1;
		СтрокаПоискаХарактеристик.ВариантПоиска = НомерВарианта;
	КонецЦикла;
	вмс_РаботаСКоллекциями.ИзменитьТипКолонкиТаблицыЗначений(ТаблицаПоискаХарактеристик, "ВариантПоиска", Новый ОписаниеТипов("Число"));
	
	ТекстЗапроса = ТекстЗапроса +
	"ВЫБРАТЬ
	|	ТаблицаПоискаХарактеристик.Товар КАК Товар,
	|	ТаблицаПоискаХарактеристик.ВариантПоиска КАК ВариантПоиска
	|ПОМЕСТИТЬ ВТ_Товары6
	|ИЗ
	|	&ТаблицаПоискаХарактеристик КАК ТаблицаПоискаХарактеристик";
	Запрос.УстановитьПараметр("ТаблицаПоискаХарактеристик", ТаблицаПоискаХарактеристик);
	
	ТекстШаблонаВариантаПоискаХарактеристик =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Товары.Товар КАК Товар,
	|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
	|ИЗ
	|	ВТ_Товары6 КАК ВТ_Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО (ВТ_Товары.Товар.ВидНоменклатуры = ХарактеристикиНоменклатуры.Владелец
	|				ИЛИ ВТ_Товары.Товар = ХарактеристикиНоменклатуры.Владелец)
	|ГДЕ
	|	ВТ_Товары.ВариантПоиска = &НомерВарианта
	|	И &УсловияПоиска
	|";
	
	ТекстЗапросаПоХарактеристикам = "";
	НомерВарианта = 1;
	Для Каждого СтрокаВариантаПоискаХарактеристик Из ТаблицаВариантовПоискаХарактеристик Цикл
		НомераПоисков = вмс_РаботаСКоллекциями.СтрокуВМассив(СтрокаВариантаПоискаХарактеристик.ВариантПоиска);
		МассивУсловийПоиска = Новый Массив;
		Для Каждого НомерПоиска Из НомераПоисков Цикл
			МассивУсловийПоиска.Добавить("ХарактеристикиНоменклатуры.Наименование ПОДОБНО &СтрокаПоиска" + НомерПоиска);
		КонецЦикла;
		УсловияПоиска = вмс_РаботаСКоллекциями.МассивВСтроку(МассивУсловийПоиска, " И ");
		
		ТекстВариантаПоискаХарактеристик = ТекстШаблонаВариантаПоискаХарактеристик;
		ТекстВариантаПоискаХарактеристик = СтрЗаменить(ТекстВариантаПоискаХарактеристик, "&НомерВарианта", НомерВарианта);
		ТекстВариантаПоискаХарактеристик = СтрЗаменить(ТекстВариантаПоискаХарактеристик, "&УсловияПоиска", УсловияПоиска);
		Если ТекстЗапросаПоХарактеристикам <> "" Тогда
			ТекстЗапросаПоХарактеристикам = ТекстЗапросаПоХарактеристикам + СвязкаЗапросов;
		КонецЕсли;
		ТекстЗапросаПоХарактеристикам = ТекстЗапросаПоХарактеристикам + ТекстВариантаПоискаХарактеристик;
		НомерВарианта = НомерВарианта + 1;
	КонецЦикла;
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////
	//
	//							Общий запрос
	//
	
	ТекстЗапроса = ТекстЗапроса + СвязкаПакетов;
	ТекстЗапроса = ТекстЗапроса +
	"ВЫБРАТЬ
	|	ВТ_Товары.Товар КАК Товар,
	|	ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	ВТ_Товары5 КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО (ВТ_Товары.Товар.ВидНоменклатуры = ХарактеристикиНоменклатуры.Владелец
	|				ИЛИ ВТ_Товары.Товар = ХарактеристикиНоменклатуры.Владелец)";
	Если ТекстЗапросаПоХарактеристикам <> "" Тогда
		ТекстЗапроса = ТекстЗапроса + СвязкаЗапросов;
		ТекстЗапроса = ТекстЗапроса + ТекстЗапросаПоХарактеристикам;
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + СвязкаПакетов;
	ТекстЗапроса = ТекстЗапроса +
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|	ВТ.Товар,
	|	ВТ.Характеристика
	|ИЗ
	|	ВТ";
	
	Если ОграничитьВыборку > 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ ПЕРВЫЕ 10", "ВЫБРАТЬ ПЕРВЫЕ " + ОграничитьВыборку);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ ПЕРВЫЕ 10", "ВЫБРАТЬ");
	КонецЕсли;
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////
	//
	//							РЕЗУЛЬТАТ!!!
	//
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ПолучитьДанныеКвазиСсылокИБ(КвазиСсылкиИБ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КвазиСсылки.Ссылка КАК Ссылка,
	|	КвазиСсылки.ИмяТипа КАК ИмяТипа,
	|	КвазиСсылки.GUID КАК GUID,
	|	КвазиСсылки.Имя КАК Имя
	|ИЗ
	|	Справочник.КвазиСсылки КАК КвазиСсылки
	|ГДЕ
	|	КвазиСсылки.Ссылка В(&КвазиСсылкиИБ)";
	Запрос.УстановитьПараметр("КвазиСсылкиИБ", КвазиСсылкиИБ);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаКвазиСсылокИБ = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаКвазиСсылокИБ;
	
КонецФункции

#Область Алгоритмы

Функция ВыполнитьАлгоритм(АлгоритмСсылка, ВходящиеПараметры = Неопределено, ОшибкаВыполнения = Ложь,
	СообщениеОбОшибке = "") Экспорт
	Возврат вмс_ОбщегоНазначенияКлиентСервер.ВыполнитьАлгоритм(АлгоритмСсылка, ВходящиеПараметры, ОшибкаВыполнения,
		СообщениеОбОшибке)
КонецФункции

Функция ПолучитьСсылкуСправочникАлгоритмы(Алгоритм) Экспорт
	Если ТипЗнч(Алгоритм) = Тип("СправочникСсылка.вмс_Алгоритмы") Тогда
		Возврат Алгоритм;
	ИначеЕсли ТипЗнч(Алгоритм) = Тип("УникальныйИдентификатор") Тогда
		Возврат Справочники.вмс_Алгоритмы.ПолучитьСсылку(Алгоритм);
	ИначеЕсли ТипЗнч(Алгоритм) = Тип("Строка") Тогда
		Если Лев(Алгоритм, 5) = "GUID_" Тогда // БСП внеш. обработка
			СтрокаУИД = Сред(Алгоритм, 6);
			ref = Справочники.вмс_Алгоритмы.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаУИД));
			Возврат ?(ПустаяСтрока(ref.Наименование), Неопределено, ref);
		КонецЕсли;
		НайденПоНаименованию = Справочники.вмс_Алгоритмы.НайтиПоНаименованию(Алгоритм, Истина);
		Если НайденПоНаименованию = Неопределено Тогда
			Попытка
				ЧислоКод = Число(Прав(Алгоритм, 5));
				НайденПоКоду = Справочники.вмс_Алгоритмы.НайтиПоКоду(ЧислоКод);
				Если НайденПоКоду = Неопределено Тогда
					Возврат Неопределено;
				Иначе
					Возврат НайденПоКоду;
				КонецЕсли;
			Исключение
				Возврат Неопределено;
			КонецПопытки;
		Иначе
			Возврат НайденПоНаименованию;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

