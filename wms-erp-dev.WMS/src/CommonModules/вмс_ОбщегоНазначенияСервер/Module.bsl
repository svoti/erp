Функция ПолучитьТекущееВремя() Экспорт 
	Возврат УниверсальноеВремя(ТекущаяДатаСеанса()) - '19700101';
КонецФункции 

Функция ПолучитьТекущуюДату() Экспорт
	Возврат ТекущаяДатаСеанса();
КонецФункции

Функция ПолучитьТаблицуРезультатаЗапроса(знач Запрос) Экспорт
	
	КвазиЗапрос = Запрос;
	
	Запрос = Новый Запрос(КвазиЗапрос.Текст);
	Для Каждого Параметр Из КвазиЗапрос.Параметры Цикл
		Запрос.Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция СоздатьОбъектОбработки(ПутьКДаннымОбработки) Экспорт
	
	Префикс = "Обработка.";
	Если СтрНайти(ПутьКДаннымОбработки, Префикс)=1 Тогда
		ИмяОбработки = Прав(ПутьКДаннымОбработки, СтрДлина(ПутьКДаннымОбработки)-СтрДлина(Префикс));
		ОбъектОперации = Обработки[ИмяОбработки].Создать();
		Возврат ОбъектОперации;
	КонецЕсли;
	
	Префикс = "";
	ИмяОбработки = ВнешниеОбработки.Подключить(ПутьКДаннымОбработки);
	ОбъектОперации = ВнешниеОбработки.Создать(ИмяОбработки);

	Возврат ОбъектОперации;
	
КонецФункции


//3.2.5 ZAD-48:
Функция DecToAny(Знач тЗначение, тОснование) Экспорт
	
	тРезультат = "";
	
	Пока тЗначение > 0 Цикл
		тРезультат = Сред("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", тЗначение%тОснование + 1, 1) + тРезультат;
		тЗначение = Цел(тЗначение/тОснование) ;
	КонецЦикла;
	
	Возврат тРезультат; 
	
КонецФункции 

//3.2.5 ZAD-48:
Функция ПреобразоватьИзЛюбойВ10(Знач Значение="0",Нотация=36) Экспорт
	
	Если Нотация<=0 Тогда Возврат(0) КонецЕсли;
	Значение=СокрЛП(Значение);
	Если Значение="0" Тогда Возврат(0) КонецЕсли;
	Результат=0;
	Длина=СтрДлина(Значение);
	Для Х=1 По Длина Цикл
		М=1;
		Для У=1 По Длина-Х Цикл М=М*Нотация КонецЦикла;
		Результат=Результат+(Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",Сред(Значение,Х,1))-1)*М;
	КонецЦикла;  
	
	Результат =  Окр(Результат);
	Если Результат < 0 Тогда
	
		Результат = - Результат	
	
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

