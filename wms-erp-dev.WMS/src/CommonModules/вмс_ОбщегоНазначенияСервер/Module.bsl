Функция СправочникНайтиПоРеквизитуТЧ(ИмяСправочника, ИмяТч, ИмяРеквизита, ЗначениеРеквизита) Экспорт  
	ИмяТЧСокращенное = ИмяСправочника + ИмяТч;
	ИмяТЧПолное = "Справочник." + ИмяСправочника + "." + ИмяТЧ; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ " + 
	ИмяТЧСокращенное + "." + ИмяРеквизита + " КАК " + ИмяРеквизита + ", " +
	ИмяТЧСокращенное + "." + "Ссылка"     + " КАК " + "Ссылка" + 
	" ИЗ " + ИмяТЧПолное + " КАК " + ИмяТЧСокращенное +
	" ГДЕ " + ИмяТЧСокращенное + "." + ИмяРеквизита + " = " + ЗначениеРеквизита; 
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции 

Функция НайтиДопРеквизит(РеквизитНаименование, НаборСвойствНаименование) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|ГДЕ
	|	ДополнительныеРеквизитыИСведения.Наименование = &РеквизитНаименование  
	|	И ДополнительныеРеквизитыИСведения.НаборСвойств.Наименование = &НаборСвойствНаименование";
	Запрос.УстановитьПараметр("РеквизитНаименование", РеквизитНаименование);
	Запрос.УстановитьПараметр("НаборСвойствНаименование", НаборСвойствНаименование);
	
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Возврат Результат.Ссылка;
	КонецЦикла;
	Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка();
КонецФункции

