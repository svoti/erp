// { Мета данные объектов

Функция ПолучитьОписаниеМетаданныхОбъекта(Объект) Экспорт
	
	Если Объект = "" ИЛИ Объект = Неопределено Тогда
		МетаданныеОбъекта = Метаданные;
		ЭтоКонфигурация = Истина;
	Иначе
		МетаданныеОбъекта = ПолучитьМетаданныеОбъекта(Объект);
		Если МетаданныеОбъекта = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ЭтоКонфигурация = Ложь;
	КонецЕсли;
	
	Если ЭтоКонфигурация Тогда
		Описание = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОписанияМетаданныхКонфигурации();
	ИначеЕсли Метаданные.ОбщиеМодули.Содержит(МетаданныеОбъекта) Тогда
		Описание = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОписанияМетаданныхОбщихМодулей();
	Иначе
		Описание = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОписанияМетаданныхОбъектов();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Описание, МетаданныеОбъекта);
	
	Если ЭтоКонфигурация Тогда
		// сама конфигурация
		Описание.Вставить("ПолноеИмя", "");
	Иначе
		Описание.Вставить("ПолноеИмя", МетаданныеОбъекта.ПолноеИмя());
		ПреобразоватьКоллекцииМетаданныхРеквизитовВОписание(Описание);
		ПреобразоватьМетаданныеТабличныхЧастейВОписание(Описание);
	КонецЕсли;
	
	ПочиститьИПреобразоватьСтруктуруОписанияМетаданных(Описание);
	
	Возврат Описание;
	
КонецФункции

Функция ПолучитьОписанияМетаданныхОбъектов(ИменаОбъектов) Экспорт
	
	МассивИменОбъектов = вмс_РаботаСКоллекциями.ЗначениеВМассив(ИменаОбъектов);
	МассивОписанийМетаданныхОбъектов = Новый Массив;
	
	Для Каждого ИмяОбъекта Из МассивИменОбъектов Цикл
		ОписаниеМетаданныхОбъекта = ПолучитьОписаниеМетаданныхОбъекта(ИмяОбъекта);
		Если ОписаниеМетаданныхОбъекта <> Неопределено Тогда
			МассивОписанийМетаданныхОбъектов.Добавить(ОписаниеМетаданныхОбъекта);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивОписанийМетаданныхОбъектов;
	
КонецФункции

Функция ПреобразоватьКоллекцииМетаданныхРеквизитовВОписание(ОписаниеОбъекта)
	
	Перем Коллекция;
	
	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("СтандартныеРеквизиты");
	ИменаКоллекций.Добавить("Реквизиты");
	ИменаКоллекций.Добавить("Измерения");
	ИменаКоллекций.Добавить("Ресурсы");
	
	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		ОписаниеОбъекта.Свойство(ИмяКоллекции, Коллекция);
		Если Коллекция <> Неопределено Тогда
			Если ИмяКоллекции = "СтандартныеРеквизиты" Тогда
				ПолноеИмяКоллекции = ОписаниеОбъекта.ПолноеИмя + "." + "СтандартныйРеквизит";
			Иначе
				ПолноеИмяКоллекции = Неопределено;
			КонецЕсли;
			ОписаниеКоллекции = ПолучитьОписаниеКоллекцииРеквизитов(Коллекция, ПолноеИмяКоллекции);
			ОписаниеОбъекта.Вставить(ИмяКоллекции, ОписаниеКоллекции);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция ПолучитьОписаниеКоллекцииРеквизитов(Коллекция, ПолноеИмяКоллекции=Неопределено)
	
	ОписаниеКоллекции = Новый ТаблицаЗначений;
	ЗарегистрированныеПоляОписаний = Новый Соответствие;
	
	ОписанияРеквизитов = Новый Массив;
	Для Каждого Реквизит Из Коллекция Цикл
		ОписаниеРеквизита = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОписанияМетаданныхРеквизита();
		ЗаполнитьЗначенияСвойств(ОписаниеРеквизита, Реквизит);
		Если ОписаниеРеквизита.Свойство("Тип") Тогда
			ОписаниеТипа = Новый Массив;
			Для Каждого Тип Из ОписаниеРеквизита.Тип.Типы() Цикл
				ИмяТипа = вмс_ОбщегоНазначенияВызовСервера.ПолучитьИмяТипа(Тип);
				ОписаниеТипа.Добавить(ИмяТипа);
			КонецЦикла;
			ОписаниеРеквизита.Вставить("Тип", ОписаниеТипа);
		КонецЕсли;
		Если ПолноеИмяКоллекции <> Неопределено Тогда
			ПолноеИмя = ПолноеИмяКоллекции + "." + Реквизит.Имя;
		Иначе
			ПолноеИмя = Реквизит.ПолноеИмя();
		КонецЕсли;
		ОписаниеРеквизита.Вставить("ПолноеИмя", ПолноеИмя);
		ПочиститьИПреобразоватьСтруктуруОписанияМетаданных(ОписаниеРеквизита);
		ОписанияРеквизитов.Добавить(ОписаниеРеквизита);
		
		Для Каждого ПолеОписания Из ОписаниеРеквизита Цикл
			ИмяПоля = ПолеОписания.Ключ;
			Если ЗарегистрированныеПоляОписаний[ИмяПоля] <> Истина Тогда
				ОписаниеКоллекции.Колонки.Добавить(ИмяПоля);
				ЗарегистрированныеПоляОписаний[ИмяПоля] = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ОписаниеРеквизита Из ОписанияРеквизитов Цикл
		СтрокаКоллекции = ОписаниеКоллекции.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКоллекции, ОписаниеРеквизита);
	КонецЦикла;
	
	Возврат ОписаниеКоллекции;
	
КонецФункции

Функция ПреобразоватьМетаданныеТабличныхЧастейВОписание(ОписаниеОбъекта)

	ТабличныеЧасти = Неопределено;
	ОписаниеОбъекта.Свойство("ТабличныеЧасти", ТабличныеЧасти);
	Если ТабличныеЧасти = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеТабличныхЧастей = Новый Структура;
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		ОписаниеТабличнойЧасти = Новый Структура("Имя, Синоним, СтандартныеРеквизиты, Реквизиты");
		ЗаполнитьЗначенияСвойств(ОписаниеТабличнойЧасти, ТабличнаяЧасть);
		ОписаниеТабличнойЧасти.Вставить("ПолноеИмя", ТабличнаяЧасть.ПолноеИмя());
		ПреобразоватьКоллекцииМетаданныхРеквизитовВОписание(ОписаниеТабличнойЧасти);
		ОписаниеТабличныхЧастей.Вставить(ТабличнаяЧасть.Имя, ОписаниеТабличнойЧасти);
	КонецЦикла;
	
	ОписаниеОбъекта.Вставить("ТабличныеЧасти", ОписаниеТабличныхЧастей);
	Возврат Истина;
	
КонецФункции

Функция ПочиститьИПреобразоватьСтруктуруОписанияМетаданных(Описание)

	НеВалидныеТипы = Новый Массив;
	НеВалидныеТипы.Добавить(Тип("Неопределено"));
	НеВалидныеТипы.Добавить(Тип("КоллекцияОбъектовМетаданных"));
	НеВалидныеТипы.Добавить(Тип("КоллекцияЗначенийСвойстваОбъектаМетаданных"));
	
	НеПреобразовыватьТипы = Новый Массив;
	НеПреобразовыватьТипы.Добавить(Тип("Дата"));
	НеПреобразовыватьТипы.Добавить(Тип("Число"));
	НеПреобразовыватьТипы.Добавить(Тип("Булево"));
	НеПреобразовыватьТипы.Добавить(Тип("Строка"));
	НеПреобразовыватьТипы.Добавить(Тип("Структура"));
	НеПреобразовыватьТипы.Добавить(Тип("Массив"));
	НеПреобразовыватьТипы.Добавить(Тип("ТаблицаЗначений"));

	УдалитьПоля = Новый Массив;
	Для Каждого Поле Из Описание Цикл
		Значение = Поле.Значение;
		ТипЗначения = ТипЗнч(Значение);
		Если НеВалидныеТипы.Найти(ТипЗначения) <> Неопределено Тогда
			УдалитьПоля.Добавить(Поле.Ключ);
			Продолжить;
		КонецЕсли;
		
		Если НеПреобразовыватьТипы.Найти(ТипЗначения) = Неопределено Тогда
			ЗначениеСтрока = Строка(Значение);
			Описание.Вставить(Поле.Ключ, ЗначениеСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяПоля Из УдалитьПоля Цикл
		Описание.Удалить(ИмяПоля);
	КонецЦикла;
	
КонецФункции

