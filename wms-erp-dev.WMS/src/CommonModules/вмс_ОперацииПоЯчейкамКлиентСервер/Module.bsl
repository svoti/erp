Функция ЗарегистрироватьКлассОперации(ИмяОперации) Экспорт

	Перем РК, Классы, РаботаСXML, ОперацииПоЯчейкамВызовСервера;
	
	ОперацииПоЯчейкамВызовСервера = глОбщийМодуль("ОперацииПоЯчейкамВызовСервера");
	ОписаниеОперации = ОперацииПоЯчейкамВызовСервера.ПолучитьОписаниеОперации(ИмяОперации);
	Если ОписаниеОперации=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	Классы = вмс_КлассыОбъектов;
	РаботаСXML = глОбщийМодуль("РаботаСXMLКлиентСервер");
	
	Классы.Инициализировать();
	Класс = Классы.ЗарегистрироватьКласс("ОперацияПоЯчейкам_" + ИмяОперации);
	Классы.НаследоватьКласс("Базовый");
	
	Для Каждого СтрокаПараметра Из РК.ПолучитьЭлементыКоллекции(ОписаниеОперации.ПараметрыОперации) Цикл
		Классы.ДобавитьПоле(СтрокаПараметра.Имя, , СтрокаПараметра.НаФронтенде, СтрокаПараметра.НаБэкенде);
	КонецЦикла;
	
	Для Каждого СтрокаМетода Из РК.ПолучитьЭлементыКоллекции(ОписаниеОперации.МетодыОперации) Цикл
		ОписаниеМетода = РаботаСXML.ПрочитатьТекстXMLУлучшенная(СтрокаМетода.Данные);
		Если ТипЗнч(ОписаниеМетода)<>Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Классы.ДобавитьМетод(ОписаниеМетода.Имя);
			Если ОписаниеМетода.Свойство("Параметры") Тогда
				Для Каждого ПараметрМетода Из ОписаниеМетода.Параметры Цикл
					Классы.ДобавитьПараметрМетода(ПараметрМетода.Имя);
				КонецЦикла;
			КонецЕсли;
			Классы.УстановитьПараметрыКомпиляцииДирективыМетода(ОписаниеМетода.Директива);
			Классы.УстановитьТекстОбработчикаМетода(ОписаниеМетода.Код);
	КонецЦикла;
	
	Классы.ЗакончитьСозданиеКласса();
	
	Возврат Класс;
	
КонецФункции

Функция НовыйОбъект(ИмяОперации) Экспорт
	
	ИмяКласса = "ОперацияПоЯчейкам_" + ИмяОперации;
	
	Объект = вмс_КлассныеОбъекты.НовыйОбъект(ИмяКласса);
	
	Возврат Объект;
	
КонецФункции

Функция ПолучитьОписаниеМетода(ТекстМетода) Экспорт
	
	ОписанияМетодов = ПолучитьОписанияМетодов(ТекстМетода);
	Если ОписанияМетодов.Количество()<>1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеМетода = ОписанияМетодов[0];
	
	Возврат ОписаниеМетода;
	
КонецФункции

Функция ПолучитьОписанияМетодов(ТекстМодуля) Экспорт

	Перем РК;
	
	РК = вмс_РаботаСКоллекциями;

	ТекстовыйПарсер = вмс_ВыполнениеПрограммногоКода.НовыйТекстовыйПарсер(ТекстМодуля);	
	вмс_ВыполнениеПрограммногоКода.ТекстовыйПарсер_СформироватьКодМодуля(ТекстовыйПарсер);
	
	ОписанияМетодов = Новый Массив;
	Для Каждого СтрокаПодпрограммы Из РК.ПолучитьЭлементыКоллекции(ТекстовыйПарсер.ТаблицаПодпрограмм) Цикл
		ОписаниеМетода = НовоеОписаниеМетода();
		ОписаниеМетода.Имя = СтрокаПодпрограммы.Имя;
		ОписаниеМетода.Тип = СтрокаПодпрограммы.Тип;
		ОписаниеМетода.Директива = СтрокаПодпрограммы.Директива;
		ОписаниеМетода.Код  = СтрокаПодпрограммы.Код;
		
		Для Каждого СтрокаПараметра Из РК.ПолучитьЭлементыКоллекции(СтрокаПодпрограммы.ТаблицаПараметров) Цикл
			Параметр = Новый Структура;
			Параметр.Вставить("Имя", СтрокаПараметра.Имя);
			ОписаниеМетода.Параметры.Добавить(Параметр);
		КонецЦикла;
		
		ОписанияМетодов.Добавить(ОписаниеМетода);
	КонецЦикла;
	
	Возврат ОписанияМетодов;
	
КонецФункции

Функция ПолучитьПолныйКодМетода(ОписаниеМетода) Экспорт
	
	Перем РК;
	
	РК = вмс_РаботаСКоллекциями;

	ТекстовыйПарсер = вмс_ВыполнениеПрограммногоКода.НовыйТекстовыйПарсер();
	Подпрограмма = РК.СкопироватьОбъект(ОписаниеМетода);
	Подпрограмма.Вставить("ТаблицаПараметров", ОписаниеМетода.Параметры);
	ПолныйКодМетода = вмс_ВыполнениеПрограммногоКода.ТекстовыйПарсер_ПолучитьКодПодпрограммы(ТекстовыйПарсер, Подпрограмма);
	
	Возврат ПолныйКодМетода;
	
КонецФункции

Функция НовоеОписаниеМетода() Экспорт
	
	ОписаниеМетода = Новый Структура;
	ОписаниеМетода.Вставить("Имя", "");
	ОписаниеМетода.Вставить("Тип", "Функция");
	ОписаниеМетода.Вставить("Директива", "");
	ОписаниеМетода.Вставить("Параметры", Новый Массив);
	ОписаниеМетода.Вставить("Код", "");
	ОписаниеМетода.Вставить("ПолныйКод", "");
	
	Возврат ОписаниеМетода;
	
КонецФункции

