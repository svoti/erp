Функция ПолучитьСтруктуруНастройкиТоварныхПолей() Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ТоварныеПоля = вмс_ОперацииПоЯчейкамКлиентСерверПовтИсп.ТоварныеПоля();
	ОбязательныеТоварныеПоля = вмс_ОперацииПоЯчейкамКлиентСерверПовтИсп.ОбязательныеТоварныеПоля();
	
	ТаблицаПолей = РК.НоваяКвазиТаблицаЗначений("Использование, Имя, Представление, Порядок"); //для универсальности, может быть передана на клиент
	Порядок = 1;
	Для Каждого ТоварноеПоле Из ТоварныеПоля Цикл
		СтрокаПоля = РК.ДобавитьЭлементКоллекции(ТаблицаПолей);
		СтрокаПоля.Использование = ОбязательныеТоварныеПоля.Найти(ТоварноеПоле) <> Неопределено;
		СтрокаПоля.Имя = ТоварноеПоле;
		СтрокаПоля.Представление = ТоварноеПоле;
		СтрокаПоля.Порядок = Порядок;
		Порядок = Порядок + 1;
	КонецЦикла;
	
	РК.ДобавитьИндексКоллекции(ТаблицаПолей, "Имя");
	
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("ТаблицаПолей", ТаблицаПолей);
	СтруктураНастройки.Вставить("СКДИсточникаПредставленийПолей", вмс_ОперацииПоЯчейкамВызовСервера.ПолучитьТекстСКДИсточникаПредставленийТоварныхПолей());
	
	Возврат СтруктураНастройки;
	
КонецФункции

Функция ИспользуемыеТоварныеПоля(УдалитьУпаковки = Ложь) Экспорт
	
	// ТУ_Кошелев 14.01.25 - перенес настройку в функцию чтобы не плодить лишние функции в модулях
	// ""Временное"" решение для работоспособности формы при включенных упаковках в товарных полях (их надо удалить из
	// товарныхъ полей в принципе)
	ИспользуемыеТоварныеПоля = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля(УдалитьУпаковки);
	
	Возврат ИспользуемыеТоварныеПоля;
	
КонецФункции

Функция ИспользуемыеТоварныеПоляНастройкиТоварныхПолей(НастройкаТоварныхПолей) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ИспользуемыеТоварныеПоля = Новый Массив;
	Для Каждого СтрокаПоля Из РК.ПолучитьЭлементыКоллекции(НастройкаТоварныхПолей.ТаблицаПолей) Цикл
		Если СтрокаПоля.Использование Тогда
			ИспользуемыеТоварныеПоля.Добавить(СтрокаПоля.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат ИспользуемыеТоварныеПоля;
	
КонецФункции

Функция ЗагрузитьСохраненнуюНастройкуТоварныхПолей(НастройкаТоварныхПолей, НастройкаТоварныхПолейСохраненная) Экспорт

	Если ТипЗнч(НастройкаТоварныхПолейСохраненная) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Если НастройкаТоварныхПолейСохраненная.Свойство("ТаблицаПолей") Тогда
		ЗагрузитьСохраненнуюТаблицуНастройкиТоварныхПолей(НастройкаТоварныхПолей.ТаблицаПолей, НастройкаТоварныхПолейСохраненная.ТаблицаПолей);
	КонецЕсли;
		
	Если НастройкаТоварныхПолейСохраненная.Свойство("СКДИсточникаПредставленийПолей") Тогда
		НастройкаТоварныхПолей.СКДИсточникаПредставленийПолей = НастройкаТоварныхПолейСохраненная.СКДИсточникаПредставленийПолей;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЗагрузитьСохраненнуюТаблицуНастройкиТоварныхПолей(ТаблицаПолей, ТаблицаПолейСохраненная) Экспорт

	РК = вмс_РаботаСКоллекциями;
	
	Для Каждого СтрокаПоля Из РК.ПолучитьЭлементыКоллекции(ТаблицаПолей) Цикл
		СтрокаПоля.Порядок = 0;
	КонецЦикла;
	
	Порядок = 1;
	ПоискПоИмени = Новый Структура("Имя", "");
	Для Каждого СтрокаПоляСохраненная Из РК.ПолучитьЭлементыКоллекции(ТаблицаПолейСохраненная) Цикл
		ПоискПоИмени.Имя = СтрокаПоляСохраненная.Имя;
		СтрокаПоля = РК.НайтиЭлементКоллекции(ТаблицаПолей, ПоискПоИмени);
		Если СтрокаПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПоля.Порядок = Порядок;
		ЗаполнитьЗначенияСвойств(СтрокаПоля, СтрокаПоляСохраненная);
		Порядок = Порядок + 1;
	КонецЦикла;

	Для Каждого СтрокаПоля Из РК.ПолучитьЭлементыКоллекции(ТаблицаПолей) Цикл
		Если СтрокаПоля.Порядок = 0 Тогда
			СтрокаПоля.Порядок = Порядок;
		КонецЕсли;
	КонецЦикла;
	
	РК.СортироватьКоллекцию(ТаблицаПолей, "Порядок");
	
КонецФункции

