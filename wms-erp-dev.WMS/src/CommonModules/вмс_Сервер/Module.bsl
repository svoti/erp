// Задача метода - сформировать верхнеуровнево документы заданий кладовщику.
// Тут обрабатывается разбивка по реквизитам шапки, которая в последствии будет использована при заполнении товаров по правилам.
// Экспортная потому что вызывается через менеджер фоновых заданий.
//
// Параметры:
//  ДокументОснование	 -ДокументСсылка 	 - документ распоряжения.
// 
// Возвращаемое значение:
//   -Неопределено 
//
Функция ОбновитьЗадачиКладовщикуПоРаспоряжению(ДокументОснование) Экспорт
	
	// TODO: 241023934
	// !!Пока не предусмотрена групповая обработка, хотя задачи уже получаются в массиве...
	// Планируется в этом методе не применять заполнение товарной части.
	// Ответственность метода верхнеуровнево разделить распоряжение по задачам.
	// Дозаполнение по товарам исходя из шапки документа предполагается в модуле объекта или модуле менеджера задачи
	
	НастройкиФормирования = НастройкиФормированияЗадачПоРаспоряжению(ДокументОснование);
	
	ЗаданияКладовщику = ЗадачиКладовщикуПоДокументуОснованию(ДокументОснование);
	
	Если ЗначениеЗаполнено(ЗаданияКладовщику) Тогда
		обЗаданиеКладовщику = ЗаданияКладовщику[0].ПолучитьОбъект();
	Иначе
		обЗаданиеКладовщику = Документы.вмс_ЗаданиеКладовщику.СоздатьДокумент();
		обЗаданиеКладовщику.Заполнить(Неопределено);
	КонецЕсли;
	
	Если ДокументОснование.Проведен Тогда
		
		// Если источник проведен, то зависимый документ перезаполняется
		// на основании источника и проводится
		
		обЗаданиеКладовщику.ПометкаУдаления = Ложь;
		ОбновитьЗависимыйДокумент(обЗаданиеКладовщику, ДокументОснование);
		обЗаданиеКладовщику.Записать(РежимЗаписиДокумента.Проведение);
		
	ИначеЕсли ДокументОснование.ПометкаУдаления Тогда 	  
		
		// Если источник помечен на удаление, то связанный документ также
		// помечается на удаление. Если он был проведен, то процедура
		// "УстановитьПометкуУдаления" инициирует отмену проведения документа  
		
		Если Не обЗаданиеКладовщику.ЭтоНовый() Тогда   
			
			// Если связанный документ еще не записан в базу, то
			// никакие действия не выполняются    
			
			обЗаданиеКладовщику.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
	Иначе 
		// Выполняется запись документа без проведения или установки пометки удаления 
		Если обЗаданиеКладовщику.ЭтоНовый() Тогда
			
			// Если связанный документ не записан в базу, то заполняем его и
			// выполняем запись документа без проведения 
			
			ОбновитьЗависимыйДокумент(обЗаданиеКладовщику, ДокументОснование);
			обЗаданиеКладовщику.Записать(РежимЗаписиДокумента.Запись);
		ИначеЕсли обЗаданиеКладовщику.Проведен Тогда 
			
			// Если связанный документ был проведен, то выполняем отмену проведения  
			
			обЗаданиеКладовщику.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе  
			
			// В остальных случаях просто записываем зависимый документ
			// Если была установлена пометка удаления - снимаем ее  
			
			обЗаданиеКладовщику.ПометкаУдаления = Ложь;
			обЗаданиеКладовщику.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Процедура ОбновитьЗависимыйДокумент(ЗависимыйДокумент, Источник)
	
	// TODO: 241023932
	// Здесь по задумке должно осуществляться обновление задачи по источнику и настройкам
	
	ЗависимыйДокумент.Дата = Источник.Дата + 1;
	ЗависимыйДокумент.Распоряжение = Источник.Ссылка;
	ЗависимыйДокумент.Комментарий = Источник.Комментарий; 
	
	Если ТипЗнч(Источник) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда  
		
		ЗависимыйДокумент.Организация = Источник.Организация;
		ЗависимыйДокумент.Автор = Пользователи.ТекущийПользователь();
		ЗависимыйДокумент.Склад = Источник.Склад;
		
		ЗависимыйДокумент.Товары.Очистить();
		
		Для каждого Строка Из Источник.Товары Цикл
			нСтрока = ЗависимыйДокумент.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(нСтрока, Строка);
			нСтрока.Документ = Источник;
			нСтрока.ЯчейкаПриемник = вмс_СкладыВызовСервера.ПолучитьЗонуПриемки(Источник.Склад);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

