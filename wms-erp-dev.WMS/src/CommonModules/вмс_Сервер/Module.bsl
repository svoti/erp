// Инициализирует процесс обновления системы, очищая записи о версиях подсистемы WMS.
//
// Возвращаемое значение:
//  Нет.
//
Процедура ИнициализироватьОбновлениеСистемы() Экспорт
	
	Записи = РегистрыСведений.ВерсииПодсистем.СоздатьНаборЗаписей();
	Записи.Заполнить(Неопределено);
	Записи.Отбор.ИмяПодсистемы.Установить(вмс_ОбновлениеИнформационнойБазыWMS.Имя());
	Записи.Прочитать();
	Записи.Очистить();
	Записи.Записать();
	
КонецПроцедуры

// Устанавливает или снимает пометку удаления для указанного объекта.
//
// Параметры:
//   Ссылка - СправочникСсылка, ДокументСсылка - ссылка на объект
//   Пометка - Булево - флаг установки пометки удаления (Истина - установить, Ложь - снять)
//
// Возвращаемое значение:
//   Нет.
//
Процедура УстановитьПометкуУдаленияОбъекта(Ссылка, Пометка = Истина) Экспорт
	Объект = Ссылка.ПолучитьОбъект();
	Объект.УстановитьПометкуУдаления(Пометка);
КонецПроцедуры

// Вычисляет хеш SHA256 для переданной строки и возвращает результат в формате Base64.
//
// Параметры:
//   СтрокаДляРасчетаХеша - Строка - данные для хеширования
//
// Возвращаемое значение:
//   Строка - хеш-сумма в кодировке Base64
//
Функция ХешированиеДанныхSHA256(СтрокаДляРасчетаХеша) Экспорт
	
	ХешированиеДанныхОбъект = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешированиеДанныхОбъект.Добавить(СтрокаДляРасчетаХеша);
	
	Возврат Base64Строка(ХешированиеДанныхОбъект.ХешСумма);
	
КонецФункции

// Обрабатывает запись документа распоряжения, регистрируя документ для последующей обработки.
// При необходимости может выполнять проверку возможности изменения документа.
//
// Параметры:
//  - Источник - Объект - документ-источник для обработки
//  - Отказ    - Булево - признак отказа от записи
//
Процедура ОбработатьЗаписьДокументаРаспоряжения(Источник, Отказ) Экспорт
	
	Если НЕ Источник.ОбменДанными.Загрузка Тогда
		ЗарегистрироватьДокументДляОбработки(Источник.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

// Обрабатывает записи зарегистрированных документов из регистра сведений, формируя задания кладовщикам 
// (и не только, в будущем может быть использована и для других целей).
// В случае ошибки сохраняет информацию об ошибке в регистре сведений.
// Обрабатывает документы порциями по 100 записей.
//
// Возвращаемое значение:
//   Нет
//
Процедура ОбработатьЗаписьЗарегистрированныхДокументов() Экспорт
	
	Кэш = Новый Структура;
	
	Пока Истина Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	вмс_ОбработкаЗаписиОбъектов.Объект КАК Объект,
		|	вмс_ОбработкаЗаписиОбъектов.Дата КАК Дата,
		|	вмс_ОбработкаЗаписиОбъектов.РежимЗаписи КАК РежимЗаписи
		|ИЗ
		|	РегистрСведений.вмс_ОбработкаЗаписиОбъектов КАК вмс_ОбработкаЗаписиОбъектов
		|ГДЕ
		|	НЕ вмс_ОбработкаЗаписиОбъектов.Ошибка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Прервать;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НомерСообщения = ПолучитьСообщенияПользователю().Количество();
			
			Попытка
				вмс_ФормированиеЗаданийКладовщикам.СформироватьЗаданияПоРаспоряжению(Выборка.Объект, Кэш);
				ИнформацияОбОшибке = Неопределено;
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
			КонецПопытки;
			
			Запись = РегистрыСведений.вмс_ОбработкаЗаписиОбъектов.СоздатьМенеджерЗаписи();
			Запись.Заполнить(Неопределено);
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Если ИнформацияОбОшибке <> Неопределено Тогда
				
				СообщенияПользователю = ПолучитьСообщенияПользователю();
				Сообщения = "";
				Пока НомерСообщения < СообщенияПользователю.Количество() Цикл
					СообщениеПользователю = СообщенияПользователю[НомерСообщения];
					Сообщения = Сообщения + СообщениеПользователю.Текст + Символы.ПС;
					НомерСообщения = НомерСообщения + 1;
				КонецЦикла;
				Сообщения = СокрП(Сообщения);
				
				Запись.Ошибка = Истина; 
				Запись.ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке); 
				Запись.Сообщения = Сообщения;
				Запись.Записать();
			Иначе
				Запись.Удалить();
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

