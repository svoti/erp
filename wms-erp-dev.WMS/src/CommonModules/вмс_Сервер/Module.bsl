	НастройкиФормирования.Вставить("РазделятьПоПомещениям", Ложь);
	НастройкиФормирования.Вставить("РазделятьПоСкладам", Ложь);
	НастройкиФормирования.Вставить("РазделятьПоИсполнителям", Ложь);
