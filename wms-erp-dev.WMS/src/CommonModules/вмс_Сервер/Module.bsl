// Создает новую настройку подключения с предустановленными значениями
// Создает элемент справочника настроек программы с базовыми параметрами
// для хранения адреса публикации. Устанавливает стандартные значения
// имени, параметра сеанса и наименования.
//
// Возвращаемое значение:
//  СправочникСсылка.вмс_НастройкиПрограммы - ссылка на созданный элемент справочника
//
Функция СоздатьНастройкуПодключения() Экспорт
	
	ИмяНастройки = "Адрес публикации";
	КодНастройки = "АдресПубликации";
	
	Попытка
		// Проверяем существование настройки
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|    вмс_НастройкиПрограммы.Ссылка
		|ИЗ
		|    Справочник.вмс_НастройкиПрограммы КАК вмс_НастройкиПрограммы
		|ГДЕ
		|    вмс_НастройкиПрограммы.Имя = &ИмяНастройки";
		
		Запрос.УстановитьПараметр("ИмяНастройки", КодНастройки);
		Результат = Запрос.Выполнить();
		
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		// Создаем новую настройку
		НоваяНастройка = Справочники.вмс_НастройкиПрограммы.СоздатьЭлемент();
		НоваяНастройка.Заполнить(Неопределено);
		НоваяНастройка.Имя = ТРег(КодНастройки);
		НоваяНастройка.ПараметрСеанса = НоваяНастройка.Имя;
		НоваяНастройка.Наименование = ИмяНастройки;
		НоваяНастройка.Значение = "";
		
		НоваяНастройка.Записать();
		
		Возврат НоваяНастройка.Ссылка;
		
	Исключение
		вмс_Журналирование.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Создание настройки АдресПубликации");
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Возвращает настройку подключения для адреса публикации, создавая новую при отсутствии.
// Ищет существующую настройку подключения по имени "АдресПубликации".
// Если настройка не найдена, создает новую с помощью функции СоздатьНастройкуПодключения().
// Обеспечивает возврат корректного значения даже при возникновении ошибок.
//
// Возвращаемое значение:
//  СправочникСсылка.вмс_НастройкиПрограммы - найденная или созданная настройка подключения
//  Неопределено - в случае ошибки при создании новой настройки
//
Функция ПолучитьНастройкуПодключения() Экспорт
	
	Попытка
		НастройкаПодключения = Справочники.вмс_НастройкиПрограммы.НайтиПоРеквизиту("Имя", "АдресПубликации");
		
		Если Не ЗначениеЗаполнено(НастройкаПодключения) Тогда
			НастройкаПодключения = СоздатьНастройкуПодключения();
		КонецЕсли;
		
		Возврат НастройкаПодключения;
		
	Исключение
		вмс_Журналирование.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Получение настройки АдресПубликации");
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

