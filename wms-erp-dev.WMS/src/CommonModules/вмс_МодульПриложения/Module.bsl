//ТУ_КС:
// Код из расширенного модуля приложения перенес в отдельный модуль,
// на случай если нельзя поставить ВМС модуль в виде расширения и требуется перенос в основную конфигурацию
// В таком случае типовой модуль приложения будет захламляться меньше
// В типом модуле потребуется только сделать переадресацию обработчиков событий на этот модуль

#Область ОбработчикиСобытий

&После("ПередНачаломРаботыСистемы")
Процедура вмс_ПередНачаломРаботыСистемы() Экспорт
	
	Если ВМС_ЛичныйКабинетПоклажедателяВызовСервер.ПроверитьНаРольПоклажедателя() Тогда
		КлиентскоеПриложение.УстановитьРежимОсновногоОкна(РежимОсновногоОкнаКлиентскогоПриложения.РабочееМесто);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриНачалеРаботыСистемы() Экспорт
	
	Если вмс_РаботаСПользователямиСервер.ПроверитьПраваНаВМС() Тогда	
		СистемаШтрихкодирования = Новый Структура;
		СистемаШтрихкодирования.Вставить("Клиенты", Новый Соответствие);
		
		вмс_ПараметрыПриложения = вмс_ОбщегоНазначенияКлиентСервер.НовыеПараметрыПриложения();
		вмс_ПараметрыПриложения["ИмяКомпьютера"] = ИмяЛокальногоКомпьютера();
		вмс_ПараметрыПриложения["ИмяЗвуковойСхемы"] = "СтандартнаяСхема";
		вмс_ПараметрыПриложения["ОбработкаОжидания"] = НоваяОбработкаОжидания();
		
		вмс_Сервер.ПриНачалеРаботыСистемы();
		
		ПодключитьОбработчикОжидания("ПроверкаЗаполненияНастроекСистемы", 3600, Истина);
		
		Если вмс_Печать.ЕстьПравоПечатиДокументовСклада() Тогда
			ПодключитьОбработчикОжидания("МониторПечати",1,Истина);
		КонецЕсли;	
		
		Если вмс_РаботаСОповещениями.ЕстьПравоПолучатьОповещения() Тогда 
			ПодключитьОбработчикОжидания("МониторОповещенийТСД",1,Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВМС_ЛичныйКабинетПоклажедателяВызовСервер.ПроверитьНаРольПоклажедателя() Тогда
		ОткрытьФорму("Обработка.вмс_КабинетПоклажедателя.Форма.ФормаРабочееМестоПоклажедателя",,,,,,,РежимОткрытияОкнаФормы.Независимый);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяЛокальногоКомпьютера() 
	
	Попытка
		objScript = Новый COMОбъект("WScript.Shell");
		objEnvironment = objScript.Environment("PROCESS");
		ИмяКлиента = ВРег(СокрЛП(objEnvironment.item("CLIENTNAME")));
		
		Если Не ЗначениеЗаполнено(ИмяКлиента) Тогда
			ИмяКлиента = Вычислить("ИмяКомпьютера()");
		КонецЕсли;
		
	Исключение
		ИмяКлиента = "localhost";
	КонецПопытки;
	
	Возврат ИмяКлиента;

КонецФункции

#КонецОбласти




#Область ОбработкаОжидания

Функция НоваяОбработкаОжидания()
	
	ОбработчикиОжидания = вмс_РаботаСКоллекциями.НоваяКоллекцияЗначений("Форма, ОбработчикОповещения, Имя, Интервал, Однократно, Удалить, Счетчик, Выполняется");
	
	ОбработкаОжидания = Новый Структура;
	ОбработкаОжидания.Вставить("Счетчик", 0);
	ОбработкаОжидания.Вставить("ОбработчикиОжидания", ОбработчикиОжидания);
	
	Возврат ОбработкаОжидания;
	
КонецФункции

Функция ДобавитьОбработчикОжидания(ОбработчикОповещения, Интервал, Однократно, Форма=Неопределено, Имя=Неопределено) Экспорт

	РК = вмс_РаботаСКоллекциями;
	
	ОбработкаОжидания = вмс_ПараметрыПриложения["ОбработкаОжидания"];
	ОбработчикОжидания = РК.ДобавитьЭлементКоллекции(ОбработкаОжидания.ОбработчикиОжидания, Новый Структура("ОбработчикОповещения, Интервал, Однократно, Форма, Имя", ОбработчикОповещения, Интервал, Однократно, Форма, Имя));
	ОбработчикОжидания.Счетчик = ОбработкаОжидания.Счетчик;
	ОбработчикОжидания.Удалить = Ложь;
	ОбработчикОжидания.Выполняется = Ложь;
	
	Если РК.ПолучитьЭлементыКоллекции(ОбработкаОжидания.ОбработчикиОжидания).Количество()=1 Тогда
		ПодключитьОбработчикОжидания("вмс_ОбщийОбработчикОжидания", 0.1, Истина);
	КонецЕсли;
	
КонецФункции

Функция УдалитьОбработчикиОжиданияФормы(Форма) Экспорт
	
	Возврат УдалитьОбработчикиОжидания(Новый Структура("Форма", Форма));
	
КонецФункции

Функция УдалитьОбработчикиОжидания(Отбор) Экспорт
	
	Для Каждого ОбработчикОжидания Из НайтиОбработчикиОжидания(Отбор) Цикл
		
		ОбработчикОжидания.Удалить = Истина;
		
	КонецЦикла;
	
КонецФункции

Функция НайтиОбработчикиОжидания(Отбор) Экспорт
	
	Возврат вмс_РаботаСКоллекциями.НайтиЭлементыКоллекции(вмс_ПараметрыПриложения["ОбработкаОжидания"].ОбработчикиОжидания, Отбор);
	
КонецФункции

Функция ОбщийОбработчикОжидания() Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ОбработкаОжидания = вмс_ПараметрыПриложения["ОбработкаОжидания"];
	
	Если РК.ПолучитьЭлементыКоллекции(ОбработкаОжидания.ОбработчикиОжидания).Количество()=0 Тогда
		ОбработкаОжидания.Счетчик = 0;
		Возврат Ложь;
	КонецЕсли;

	ПодключитьОбработчикОжидания("вмс_ОбщийОбработчикОжидания", 0.1, Истина);

	ОбработчикиДляУдаления = Новый Массив;
	Для Каждого ОбработчикОжидания Из РК.ПолучитьЭлементыКоллекции(ОбработкаОжидания.ОбработчикиОжидания) Цикл

		Если ОбработчикОжидания.Выполняется Тогда
			// была ошибка при выполнении, удалим проблемный обработчик
			ОбработчикОжидания.Выполняется = Ложь;
			ОбработчикОжидания.Удалить = Истина;
		КонецЕсли;
		
		Если ОбработчикОжидания.Удалить Тогда
			ОбработчикиДляУдаления.Добавить(ОбработчикОжидания);
			Продолжить;
		КонецЕсли;
		
		Если ОбработкаОжидания.Счетчик - ОбработчикОжидания.Счетчик < ОбработчикОжидания.Интервал Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработчикОжидания.Счетчик = ОбработкаОжидания.Счетчик;
		Если ОбработчикОжидания.Однократно Тогда
			ОбработчикОжидания.Удалить = Истина;
		КонецЕсли;

		Если ОбработчикОжидания.ОбработчикОповещения <> Неопределено Тогда
			ОбработчикОжидания.Выполняется = Истина;
			ВыполнитьОбработкуОповещения(ОбработчикОжидания.ОбработчикОповещения, ОбработчикОжидания);
			ОбработчикОжидания.Выполняется = Ложь;
		КонецЕсли;
		
		Если ОбработчикОжидания.Удалить Тогда
			ОбработчикиДляУдаления.Добавить(ОбработчикОжидания);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОбработчикиДляУдаления.Количество() > 0 Тогда
		РК.УдалитьЭлементыКоллекции(ОбработкаОжидания.ОбработчикиОжидания, ОбработчикиДляУдаления);
	КонецЕсли;
	
	ОбработкаОжидания.Счетчик = ОбработкаОжидания.Счетчик + 0.1;
	
КонецФункции

#КонецОбласти

