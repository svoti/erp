Функция ПолучитьТаблицуДоступныхРолейОператоров(Операторы = Неопределено, Роли = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	вмс_ГруппыРолейОператоровОператоры.Оператор КАК Оператор,
	|	вмс_ГруппыРолейОператоровОператоры.Ссылка.РольОператоров КАК РольОператора
	|ИЗ
	|	Справочник.вмс_ГруппыРолейОператоров.Операторы КАК вмс_ГруппыРолейОператоровОператоры
	|";
	
	Если ЗначениеЗаполнено(Операторы) Или ЗначениеЗаполнено(Роли) Тогда
		СтрокаОтбор = "";
		
		Если ЗначениеЗаполнено(Операторы) Тогда
			Запрос.УстановитьПараметр("Операторы", Операторы);
			Если ЗначениеЗаполнено(СтрокаОтбор) Тогда
				СтрокаОтбор = СтрокаОтбор + " И ";	
			Иначе
				СтрокаОтбор = "	";	
			КонецЕсли;
			СтрокаОтбор = СтрокаОтбор + "вмс_ГруппыРолейОператоровОператоры.Оператор В (&Операторы)";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Роли) Тогда
			Если ТипЗнч(Роли) = Тип("Строка") Тогда
				РолиМассив = вмс_РаботаСКоллекциями.СтрокуВМассив(Роли);
				Роли = Новый Массив;
				Для каждого Роль Из РолиМассив Цикл
					Роли.Добавить(Перечисления.вмс_РолиОператоров[Роль]);
				КонецЦикла;
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Роли", Роли);
			Если ЗначениеЗаполнено(СтрокаОтбор) Тогда
				СтрокаОтбор = СтрокаОтбор + " И ";	
			Иначе
				СтрокаОтбор = "	";	
			КонецЕсли;
			СтрокаОтбор = СтрокаОтбор + "вмс_ГруппыРолейОператоровОператоры.Ссылка.РольОператоров В (&Роли)";
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|" + СтрокаОтбор;
		
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
