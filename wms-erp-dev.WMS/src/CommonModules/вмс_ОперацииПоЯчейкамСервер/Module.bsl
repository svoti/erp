Функция ПолучитьСкладПоУмолчанию() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ЭтоГруппа";  
	
	ИмяСправочникаСклады = вмс_АдаптацияКонфигураций.ПолучитьИмяСправочникаСклады();
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"Справочник.Склады","Справочник." +ИмяСправочникаСклады);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"НЕ Склады.ЭтоГруппа",
	?(вмс_АдаптацияКонфигураций.ИерархическийСправочник(ИмяСправочникаСклады) = Истина,
	"НЕ Склады.ЭтоГруппа",
	"ИСТИНА"));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Владелец = Выборка.Ссылка;  
		Возврат Владелец;
	КонецЕсли;
КонецФункции

