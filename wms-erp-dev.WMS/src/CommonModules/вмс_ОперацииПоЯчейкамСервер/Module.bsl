Функция ПолучитьОбработанныеПомещения(ВходящиеПараметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокументыОпераций.Помещение КАК Помещение
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам КАК ДокументыОпераций
	|ГДЕ
	|	ДокументыОпераций.Готов
	|	И ДокументыОпераций.Проведен
	|	И ДокументыОпераций.ДокументОснование В(&ДокументыОснования)
	|	И ДокументыОпераций.ВидОперации В(&ВидыОпераций)";
	
	Запрос.УстановитьПараметр("ДокументыОснования", ВходящиеПараметры.ДокументыОснования);
	Запрос.УстановитьПараметр("ВидыОпераций", ВходящиеПараметры.ВидыОпераций);
	РезультатЗапроса = Запрос.Выполнить();
	
	ОбработанныеПомещения = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Помещение");
	
	Возврат ОбработанныеПомещения;
	
КонецФункции

Функция ПолучитьТаблицуПланаПоПомещениям(Знач ТаблицаОстатковЯчеек, Знач ТаблицаПлана, знач ТаблицаФакта) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ПоляОстатков = РК.ПолучитьКолонкиКоллекции(ТаблицаОстатковЯчеек);
	
	ПоляСоединения = РК.ПолучитьКолонкиКоллекции(ТаблицаПлана);
	ПоляСоединения = РК.ПересечениеМассивов(ПоляСоединения, вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля());
	ПоляСоединения = РК.ПересечениеМассивов(ПоляСоединения, ПоляОстатков);
	ДополнительныеПоля = РК.ЗначениеВМассив("Помещение");
	ПоляИтогов = РК.ЗначениеВМассив("Количество, КоличествоОстаток");
	
	ВсеПоля = Новый Массив;
	РК.ДобавитьЭлементыКоллекции(ВсеПоля, ПоляСоединения);
	РК.ДобавитьЭлементыКоллекции(ВсеПоля, ДополнительныеПоля);
	РК.ДобавитьЭлементыКоллекции(ВсеПоля, ПоляИтогов);
	
	ТаблицаПланаПоПомещениям = РК.СкопироватьКоллекцию(ТаблицаПлана, Новый Массив);
	РК.ДополнитьКолонкиКоллекции(ТаблицаПланаПоПомещениям, ВсеПоля);
	
	Отбор = Новый Структура(РК.МассивВСтроку(ПоляСоединения));
	
	// распределим отобранные товары
	ПоляФакта = РК.ПолучитьКолонкиКоллекции(ТаблицаФакта);
	НовыеПоляФакта = РК.ПересечениеМассивов(ПоляФакта, ВсеПоля);
	ТаблицаФакта = ТаблицаФакта.Скопировать(, РК.МассивВСтроку(НовыеПоляФакта));
	ТаблицаФакта.Колонки.Количество.Имя = "КоличествоОстаток";
	РК.СвернутьКоллекциюЗначений(ТаблицаФакта, , "КоличествоОстаток");
	
	ТаблицаРезультата = РК.РаспределитьРесурсыКоллекции(ТаблицаПлана, ТаблицаФакта, "Количество", "КоличествоОстаток", ПоляСоединения, "КоличествоОстаток, Помещение");
	
	ТаблицаПлана = РК.СкопироватьКоллекцию(ТаблицаПлана, Новый Массив);
	Для Каждого СтрокаТовара Из ТаблицаРезультата Цикл
		Если СтрокаТовара.Помещение <> Неопределено Тогда
			РК.ДобавитьЭлементКоллекции(ТаблицаПланаПоПомещениям, СтрокаТовара);
		Иначе
			РК.ДобавитьЭлементКоллекции(ТаблицаПлана, СтрокаТовара);
		КонецЕсли;
	КонецЦикла;
	
	// определим хватает ли товаров в помещении
	НовыеПоляОстатков = РК.ПересечениеМассивов(ПоляОстатков, ВсеПоля);
	ТаблицаОстатков = ТаблицаОстатковЯчеек.Скопировать(, РК.МассивВСтроку(НовыеПоляОстатков));
	ТаблицаОстатков.Колонки.Количество.Имя = "КоличествоОстаток";
	РК.СвернутьКоллекциюЗначений(ТаблицаОстатков, , "КоличествоОстаток");
	ТаблицаОстатков.Колонки.Добавить("Хватает");
	
	Для Каждого СтрокаТовара Из ТаблицаПлана Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТовара);
		НайденныеОстатки = ТаблицаОстатков.НайтиСтроки(Отбор);
		Если НайденныеОстатки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОстатка = НайденныеОстатки[0];
		СтрокаОстатка.Хватает = СтрокаОстатка.КоличествоОстаток >= СтрокаТовара.Количество;
	КонецЦикла;
	
	ТаблицаОстатков.Сортировать("Хватает УБЫВ, КоличествоОстаток");
	
	РаспределятьПлановоеКоличествоПоОстаткамПомещений = Ложь;
	Если РаспределятьПлановоеКоличествоПоОстаткамПомещений Тогда
		// распределим плановое количество по остаткам
		ТаблицаРезультата = РК.РаспределитьРесурсыКоллекции(ТаблицаПлана, ТаблицаОстатков, "Количество", "КоличествоОстаток", ПоляСоединения, "КоличествоОстаток, Помещение");
		РК.ДобавитьЭлементыКоллекции(ТаблицаПланаПоПомещениям, ТаблицаРезультата);
	Иначе
		// подтянем все помещения товаров независимо от количества в плане
		Для Каждого СтрокаПлана Из РК.ПолучитьЭлементыКоллекции(ТаблицаПлана) Цикл
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаПлана);
			НайденныеОстатки = РК.НайтиЭлементыКоллекции(ТаблицаОстатков, Отбор);
			Для Каждого СтрокаОстатка Из НайденныеОстатки Цикл
				СтрокаПланаПоПомещению = ТаблицаПланаПоПомещениям.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПланаПоПомещению, СтрокаПлана);
				ЗаполнитьЗначенияСвойств(СтрокаПланаПоПомещению, СтрокаОстатка);
				СтрокаПланаПоПомещению.Количество = Мин(СтрокаПлана.Количество, СтрокаОстатка.КоличествоОстаток);
				СтрокаПланаПоПомещению.КоличествоОстаток = СтрокаПланаПоПомещению.Количество;
			КонецЦикла;
		КонецЦикла;
		
		// проверим хватает ли остатка для плана
		ТаблицаПроверки = РК.СкопироватьКоллекцию(ТаблицаПлана);
		РК.ДобавитьКолонкуКоллекции(ТаблицаПроверки, "КоличествоОстаток");
		РК.ЗаполнитьЗначенияКоллекции(ТаблицаПроверки, 0, "КоличествоОстаток");
		РК.ДобавитьЭлементыКоллекции(ТаблицаПроверки, ТаблицаОстатков);
		РК.СвернутьКоллекциюЗначений(ТаблицаПроверки, ПоляСоединения, "Количество, КоличествоОстаток");
		
		Для Каждого СтрокаПроверки Из РК.ПолучитьЭлементыКоллекции(ТаблицаПроверки) Цикл
			Если СтрокаПроверки.Количество > СтрокаПроверки.КоличествоОстаток Тогда
				// не хватает, добавим строку с пустым помещением
				СтрокаПланаПоПомещению = ТаблицаПланаПоПомещениям.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПланаПоПомещению, СтрокаПлана);
				СтрокаПлана.Количество = СтрокаПроверки.Количество - СтрокаПроверки.КоличествоОстаток;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// скорректируем данные
	ПустоеПомещение				= Справочники.вмс_Помещения.ПустаяСсылка();
	ПомещениеНеназначенныхЯчеек	= Справочники.вмс_Помещения.ПолучитьПомещениеНеназначенныхЯчеек();
	ПомещениеБезОстатка			= Справочники.вмс_Помещения.ПолучитьПомещениеБезОстатка();
	
	Для Каждого СтрокаПлана Из РК.ПолучитьЭлементыКоллекции(ТаблицаПланаПоПомещениям) Цикл
		
		Если СтрокаПлана.Помещение = ПустоеПомещение Тогда
			СтрокаПлана.Помещение = ПомещениеНеназначенныхЯчеек;
		ИначеЕсли СтрокаПлана.Помещение = Неопределено Тогда
			СтрокаПлана.Помещение = ПомещениеБезОстатка;
			СтрокаПлана.КоличествоОстаток = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаПланаПоПомещениям;
	
КонецФункции

