	Дата = Неопределено;
	ВходящиеПараметры.Свойство("Дата", Дата);
	Если ТипЗнч(Дата) <> Тип("Дата") Тогда
		Дата = ПустаяДата;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТекущиеДокументы", ТекущиеДокументы);
	Запрос.УстановитьПараметр("ТаблицаПомещенийДляЗамены", ПолучитьТаблицуПомещенийДляЗамены());
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПомещенийДляЗамены.Помещение КАК Помещение,
	|	ТаблицаПомещенийДляЗамены.ПомещениеЗамена КАК ПомещениеЗамена
	|ПОМЕСТИТЬ ВТ_ТаблицаПомещенийДляЗамены
	|ИЗ
	|	&ТаблицаПомещенийДляЗамены КАК ТаблицаПомещенийДляЗамены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЗапроса.Товар КАК Товар,
	|	ТаблицаЗапроса.Ячейка КАК Ячейка,
	|	&ПолеСклад КАК Склад,
	|	&ПолеКонтейнер КАК Контейнер,
	|	ТаблицаЗапроса.КоличествоОборот КАК Количество,
	|	ТаблицаЗапроса.ВесОборот КАК Вес
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Обороты(, &Дата, , &Отборы) КАК ТаблицаЗапроса
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаЗапроса.Товар,
	|	ТаблицаЗапроса.Ячейка,
	|	&ПолеСклад,
	|	&ПолеКонтейнер,
	|	ВЫБОР
	|		КОГДА ТаблицаЗапроса.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА -ТаблицаЗапроса.Количество
	|		ИНАЧЕ ТаблицаЗапроса.Количество
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТаблицаЗапроса.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА -ТаблицаЗапроса.Вес
	|		ИНАЧЕ ТаблицаЗапроса.Вес
	|	КОНЕЦ
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам КАК ТаблицаЗапроса
	|ГДЕ
	|	ТаблицаЗапроса.Период <= &Дата
	|	И ТаблицаЗапроса.Регистратор В(&ТекущиеДокументы)
	|	И ТаблицаЗапроса.Активность
	|	И &Отборы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЗапроса.Товар КАК Товар,
	|	ТаблицаЗапроса.Ячейка КАК Ячейка,
	|	ТаблицаЗапроса.Склад КАК Склад,
	|	ТаблицаЗапроса.Контейнер КАК Контейнер,
	|	СУММА(ТаблицаЗапроса.Количество) КАК Количество,
	|	СУММА(ТаблицаЗапроса.Вес) КАК Вес,
	|	ЕСТЬNULL(ВТ_ТаблицаПомещенийДляЗамены.ПомещениеЗамена, вмс_МестаХранения.Помещение) КАК Помещение
	|ПОМЕСТИТЬ ВТ2
	|ИЗ
	|	ВТ КАК ТаблицаЗапроса
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|		ПО ТаблицаЗапроса.Ячейка = вмс_МестаХранения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаПомещенийДляЗамены КАК ВТ_ТаблицаПомещенийДляЗамены
	|		ПО (вмс_МестаХранения.Помещение = ВТ_ТаблицаПомещенийДляЗамены.Помещение)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЗапроса.Товар,
	|	ТаблицаЗапроса.Ячейка,
	|	ТаблицаЗапроса.Склад,
	|	ТаблицаЗапроса.Контейнер,
	|	ЕСТЬNULL(ВТ_ТаблицаПомещенийДляЗамены.ПомещениеЗамена, вмс_МестаХранения.Помещение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЗапроса.Товар КАК Товар,
	|	ТаблицаЗапроса.Ячейка КАК Ячейка,
	|	ТаблицаЗапроса.Ячейка.Наименование КАК НаименованиеЯчейки,
	|	ТаблицаЗапроса.Склад КАК Склад,
	|	ТаблицаЗапроса.Контейнер КАК Контейнер,
	|	ТаблицаЗапроса.Количество КАК Количество,
	|	ТаблицаЗапроса.Вес КАК Вес,
	|	ТаблицаЗапроса.Помещение КАК Помещение,
	|	ТаблицаЗапроса.Помещение.Приоритет КАК ПриоритетПомещения
	|ИЗ
	|	ВТ2 КАК ТаблицаЗапроса
	|ГДЕ
	|	ТаблицаЗапроса.Количество > 0";
	
	ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля(); 
	
	// Кулалаев Е.С + 31.05.2023 12:26:19
	// BOX-57 Модуль учета единиц измерения в мобильной версии: Остатки по упаковкам не ведутся. Пока.
	Если ТоварныеПоляМассив.Найти("Упаковка") <> Неопределено Тогда
		вмс_РаботаСКоллекциями.ВычестьМассив(ТоварныеПоляМассив, "Упаковка");
	КонецЕсли;
	// Кулалаев Е.С -

	ИспользуемыеПоля = Неопределено;
	ВходящиеПараметры.Свойство("ИспользуемыеПоля", ИспользуемыеПоля); 
	
	Если ИспользуемыеПоля <> Неопределено Тогда
		ИспользуемыеПоляМассив = вмс_РаботаСКоллекциями.ЗначениеВМассив(ИспользуемыеПоля);
	Иначе
		ИспользуемыеПоляМассив = Новый Массив;
	КонецЕсли;

	МассивОтборов = Новый Массив; 
	Товары = Неопределено;
	ВходящиеПараметры.Свойство("Товары", Товары);
	Если Товары <> Неопределено Тогда
		
		Если вмс_РаботаСКоллекциями.ЭтоКвазиТаблицаЗначений(Товары) ИЛИ вмс_РаботаСКоллекциями.ЭтоТаблицаЗначений(Товары) Тогда
			
			// отбор по таблице товаров+
			КолонкиТоваров = вмс_РаботаСКоллекциями.ПолучитьКолонкиКоллекции(Товары);
			
			ТекстОтборовПоТаблице = "";
			Для Каждого Измерение Из Метаданные.РегистрыНакопления.вмс_ОперацияПоЯчейкам.Измерения Цикл
				
				ИмяКолонки = Измерение.Имя;
				Если КолонкиТоваров.Найти(ИмяКолонки) <> Неопределено Тогда
					
					ТекстОтборовПоТаблице = ТекстОтборовПоТаблице + ИмяКолонки + ", ";
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ТекстОтборовПоТаблице <> "" Тогда
				
				ТекстОтборовПоТаблице = Лев(ТекстОтборовПоТаблице, СтрДлина(ТекстОтборовПоТаблице)-СтрДлина(", "));
				ТекстОтборовПоТаблице = "(" + ТекстОтборовПоТаблице + ") В (ВЫБРАТЬ " + ТекстОтборовПоТаблице + " ИЗ ТаблицаОтборовЗапроса)";
				МассивОтборов.Добавить(ТекстОтборовПоТаблице);
				
				Запрос.Текст =
				"ВЫБРАТЬ
				|	ТаблицаЗапроса.Товар КАК Товар,
				|	ТаблицаЗапроса.Ячейка КАК Ячейка,
				|	ТаблицаЗапроса.Контейнер КАК Контейнер
				|ПОМЕСТИТЬ ТаблицаОтборовЗапроса
				|ИЗ
				|	&ТаблицаОтборовЗапроса КАК ТаблицаЗапроса"
				+ Символы.ПС + ";" + Символы.ПС  + Символы.ПС
				+ Запрос.Текст;
				
				ТаблицаОтборовЗапроса = РегистрыНакопления.вмс_ОперацияПоЯчейкам.СоздатьНаборЗаписей().Выгрузить();
				вмс_РаботаСКоллекциями.ДобавитьЭлементыКоллекции(ТаблицаОтборовЗапроса, Товары);
				Запрос.УстановитьПараметр("ТаблицаОтборовЗапроса", ТаблицаОтборовЗапроса);
			КонецЕсли;
			// отбор по таблице товаров-
			
		ИначеЕсли ТипЗнч(Товары) = Тип("Структура") Тогда 
			
			ИспользуемыеВОтбореЗапросаТоварныеПоляМассив = вмс_РаботаСКоллекциями.ПересечениеМассивов(ТоварныеПоляМассив, ИспользуемыеПоляМассив);
			Для каждого ТоварноеПоле Из ИспользуемыеВОтбореЗапросаТоварныеПоляМассив Цикл
				Запрос.УстановитьПараметр(ТоварноеПоле, Товары[ТоварноеПоле]);
				МассивОтборов.Добавить(""+ТоварноеПоле+" В (&"+ТоварноеПоле+")");	
			КонецЦикла;
			
		Иначе
			
			Запрос.УстановитьПараметр("Товары", Товары);
			МассивОтборов.Добавить("Товар В (&Товары)");
			
		КонецЕсли;
		
	КонецЕсли; 
	
	ТоварныеПоляДляЗапроса = "";
	ИмяТаблицыЗапроса = "ТаблицаЗапроса";
	СвязкаПолей = "," + Символы.ПС + Символы.Таб;
	Для Каждого ИмяПоля Из ТоварныеПоляМассив Цикл
		ТоварныеПоляДляЗапроса = ТоварныеПоляДляЗапроса + СвязкаПолей + ИмяТаблицыЗапроса + "." + ИмяПоля;
	КонецЦикла;
	ТоварныеПоляДляЗапроса = Прав(ТоварныеПоляДляЗапроса, СтрДлина(ТоварныеПоляДляЗапроса)-СтрДлина(СвязкаПолей));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаЗапроса.Товар,", ТоварныеПоляДляЗапроса+",");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаЗапроса.Товар КАК Товар", ТоварныеПоляДляЗапроса);
	
	НастраиваемыеПоляМассив = вмс_РаботаСКоллекциями.ЗначениеВМассив("Контейнер, Склад");
	Для Каждого Поле Из НастраиваемыеПоляМассив Цикл
		ПолеЗапроса = "&Поле" + Поле;
		Если ИспользуемыеПоляМассив.Найти(Поле) <> Неопределено Тогда      
			// ТУ_Прошин_13.01.26 
			// Измерения склад больше нет, поэтому достаю из ячейки
			Если Поле = "Склад" Тогда  
				ТекстПоля = ИмяТаблицыЗапроса + "." + "Ячейка.Владелец"; 	
			Иначе	
				ТекстПоля = ИмяТаблицыЗапроса + "." + Поле;  
			КонецЕсли;
		Иначе
			ТекстПоля = "НЕОПРЕДЕЛЕНО";
		КонецЕсли;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ПолеЗапроса, ТекстПоля);
	КонецЦикла; 
	
	// Кулалаев Е.С + 24.05.2022 12:31:14
	
	ВключатьОтрицательные = Истина; // ТУ_Кошелев 08.07.24 - Поменял чтобы отрицательные строки по умолчанию включались в информацию, если параметр не передан
	Если ВходящиеПараметры.Свойство("ВключатьОтрицательные") Тогда        
		ВключатьОтрицательные = ВходящиеПараметры.ВключатьОтрицательные;
	КонецЕсли;
	
	Если ВключатьОтрицательные = Истина Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаЗапроса.Количество > 0", "ТаблицаЗапроса.Количество <> 0"); // ТУ_Самойленко 26.04.23 Исправлено название таблицы	
	КонецЕсли;	
	// Кулалаев Е.С -	
	
	Если ВходящиеПараметры.Свойство("БезЯчеекХранения") Тогда 
		Запрос.УстановитьПараметр("ЯчейкиИсключения", ПолучитьЯчейкиОтветственногоХранения());
		МассивОтборов.Добавить("НЕ Ячейка В (&ЯчейкиИсключения)");
	КонецЕсли;
	
	// Плугина 20.09 + 
	Оператор = Неопределено;
	ВходящиеПараметры.Свойство("Оператор",Оператор);
	Если Оператор <> Неопределено Тогда 	
		ДоступныеЯчейки = Справочники.вмс_НастройкиОператора.ПолучитьДоступныеЯчейкиОператора(Оператор);
		Если ЗначениеЗаполнено(ДоступныеЯчейки) Тогда   
			Запрос.УстановитьПараметр("ДоступныеЯчейки", ДоступныеЯчейки);
			МассивОтборов.Добавить("Ячейка В (&ДоступныеЯчейки)");
		КонецЕсли; 	
	КонецЕсли;
	// Плугина 20.09 -
	
	Склады = Неопределено;
	ВходящиеПараметры.Свойство("Склады",Склады);
	Если ЗначениеЗаполнено(Склады) Тогда //Склады <> Неопределено Тогда // ТУ_Самойленко 31.08.23 
		Запрос.УстановитьПараметр("Склады", Склады);  
		// ТУ_Прошин_13.01.26+
		МассивОтборов.Добавить("Ячейка.Владелец В (&Склады)");  
		//МассивОтборов.Добавить("Склад В (&Склады)");
		// ТУ_Прошин_13.01.26
	КонецЕсли;
	
	Ячейки = Неопределено;
	ВходящиеПараметры.Свойство("Ячейки",Ячейки);
	Если Ячейки <> Неопределено Тогда
		МассивЯчеекИТиповЯчеек = вмс_РаботаСКоллекциями.ЗначениеВМассив(Ячейки);
		МассивЯчеек = Новый Массив;
		МассивТиповЯчеек = Новый Массив;
		Для каждого ЗначениеЯчейки Из МассивЯчеекИТиповЯчеек Цикл
			Если ТипЗнч(ЗначениеЯчейки) = Тип("СправочникСсылка.вмс_МестаХранения") Тогда
				МассивЯчеек.Добавить(ЗначениеЯчейки);
			ИначеЕсли ТипЗнч(ЗначениеЯчейки) = Тип("ПеречислениеСсылка.вмс_ТипыЯчеек") Тогда
				МассивТиповЯчеек.Добавить(ЗначениеЯчейки);
			КонецЕсли;
		КонецЦикла;
		
		Запрос.УстановитьПараметр("Ячейки", МассивЯчеек);
		Запрос.УстановитьПараметр("ТипыЯчеек", МассивТиповЯчеек);
		МассивОтборов.Добавить("(Ячейка В (&Ячейки) ИЛИ Ячейка.ТипЯчейки В (&ТипыЯчеек))");
	КонецЕсли;
	
	Контейнеры = Неопределено;
	ВходящиеПараметры.Свойство("Контейнеры", Контейнеры);
	Если Контейнеры <> Неопределено Тогда
		Запрос.УстановитьПараметр("Контейнеры", Контейнеры);
		МассивОтборов.Добавить("Контейнер В (&Контейнеры)");
	КонецЕсли;
	
	ТекстОтборов = вмс_РаботаСКоллекциями.МассивВСтроку(МассивОтборов, " И ");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отборы", ТекстОтборов);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаОстатков = РезультатЗапроса.Выгрузить();
	ТаблицаОстатков.Колонки.Добавить("ПолеУпорядочиванияПоНаименованию");
	
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
		Префикс = "";
		Суффикс = "";
		вмс_РаботаСКоллекциями.РазложитьСтрокуНаПрефиксИЧисловойСуффикс(СтрокаОстатка.НаименованиеЯчейки, Префикс, Суффикс);
		Суффикс = Прав("000" + Суффикс, 3);
		СтрокаОстатка.ПолеУпорядочиванияПоНаименованию = Префикс + Суффикс;
	КонецЦикла;
	
	ТаблицаОстатков.Сортировать("ПриоритетПомещения, ПолеУпорядочиванияПоНаименованию");
	
	// ТУ_СКВ 26.07.23 ++
	ПоляГруппировки = Неопределено;
	ПоляСуммирования = Неопределено;
	ВходящиеПараметры.Свойство("ПоляГруппировки",ПоляГруппировки);
	ВходящиеПараметры.Свойство("ПоляСуммирования",ПоляСуммирования);
	Если ЗначениеЗаполнено(ПоляГруппировки) Тогда
		ТаблицаОстатков.Свернуть(ПоляГруппировки, ПоляСуммирования);	
	КонецЕсли;
	// ТУ_СКВ 26.07.23 -- 	
	
	Возврат ТаблицаОстатков;
	
КонецФункции  

// Удалить если нет на нее референсов, ибо негоже две одноликие функции попускать
Функция ПолучитьТаблицуОстатковВЯчейкахЧерезТаблицу(ВходящиеПараметры = Неопределено) Экспорт
	
	Возврат ПолучитьТаблицуОстатковВЯчейкахЧерезСтруктуру(ВходящиеПараметры);
	
КонецФункции  

Функция ПолучитьТаблицуОстатковВЯчейках(Товары=Неопределено, Склады=Неопределено, Ячейки=Неопределено, Контейнеры=Неопределено, ТекущиеДокументы=Неопределено, ИспользуемыеПоля=Неопределено, ВключатьОтрицательные=Ложь) Экспорт
	
	ВходящиеПараметры = Новый Структура;
	ВходящиеПараметры.Вставить("Товары", Товары);
	ВходящиеПараметры.Вставить("Склады", Склады);
	ВходящиеПараметры.Вставить("Ячейки", Ячейки);
	ВходящиеПараметры.Вставить("Контейнеры", Контейнеры);
	ВходящиеПараметры.Вставить("ТекущиеДокументы", ТекущиеДокументы);
	ВходящиеПараметры.Вставить("ИспользуемыеПоля", ИспользуемыеПоля);
	ВходящиеПараметры.Вставить("ВключатьОтрицательные", ВключатьОтрицательные);
	
	ТаблицаОстатков = ПолучитьТаблицуОстатковВЯчейкахЧерезСтруктуру(ВходящиеПараметры);
	
	Возврат ТаблицаОстатков;

КонецФункции

Функция ПолучитьМассивДокументовОперации(ПараметрыОперации) Экспорт
	
	ТаблицаДокументовОперации = ПолучитьТаблицуДокументовОперации(ПараметрыОперации);
	МассивДокументовОперации = ТаблицаДокументовОперации.ВыгрузитьКолонку("СсылкаОперации");
	
	Возврат МассивДокументовОперации;
	
КонецФункции

Функция ПолучитьТаблицуДокументовОперации(ПараметрыОперации) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкам.Ссылка КАК СсылкаОперации,
	|	вмс_ОперацияПоЯчейкам.Ответственный КАК Ответственный,
	|	вмс_ОперацияПоЯчейкам.Проведен КАК Проведен
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкам
	|ГДЕ
	|	вмс_ОперацияПоЯчейкам.ВидОперации = &ВидОперации
	|	И вмс_ОперацияПоЯчейкам.ДокументОснование В(&Распоряжения)
	|	И вмс_ОперацияПоЯчейкам.ВидСубОперации = &ВидСубОперации";
	
	Запрос.УстановитьПараметр("ВидОперации", ПараметрыОперации.ВидОперации);
	Запрос.УстановитьПараметр("Распоряжения", ПараметрыОперации.Распоряжения);
	Запрос.УстановитьПараметр("ВидСубОперации", Справочники.вмс_Операции.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаДокументовОперации = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаДокументовОперации;
	
КонецФункции

Функция ДополнитьОтборПараметрамиОперации(Запрос,Операция,Таблица)
	
	НастройкиОперации = Справочники.вмс_НастройкиОперации.НайтиПоРеквизиту("Операция",Операция);
	
	Если НЕ ЗначениеЗаполнено(НастройкиОперации) Тогда 
		Запрос.УстановитьПараметр("ДополнительныеУсловия", Истина);
		Возврат Запрос;
	КонецЕсли;
	
	ТаблицаНастроек = НастройкиОперации.СписокНастроек.Выгрузить(Новый Структура("ВидНастройки,ИспользуетсяВОперации",Перечисления.вмс_ВидыИспользованияНастроек.ИсточникДанных,Истина,));
	
	Если ЗначениеЗаполнено(ТаблицаНастроек) Тогда
		СтрокаНастроек = "";
		
		Для каждого Строка Из ТаблицаНастроек Цикл
			СтрокаНастроек = СтрокаНастроек + Таблица + "." + Строка.ПолеДанных + Перечисления.вмс_ВидыСравненияВНастройках.ПолучитьВидСравненияЗапросомПоВидуСравненияWMS(Строка.ВидСравнения) + Строка.ЗначениеНастройки + " И ";  			
		КонецЦикла; 
		
		СтрокаНастроек = СтрокаНастроек + "ИСТИНА";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительныеУсловия", СтрокаНастроек); 
		
	КонецЕсли;     
	
	Возврат Запрос;
	
	
	
КонецФункции

Функция ПолучитьТаблицуОстатковПоКонтейнерам(Контейнеры) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контейнеры", Контейнеры);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкамОстатки.Товар КАК Товар,
	|	вмс_ОперацияПоЯчейкамОстатки.Контейнер КАК Контейнер,
	|	вмс_ОперацияПоЯчейкамОстатки.Характеристика КАК Характеристика,
	|	вмс_ОперацияПоЯчейкамОстатки.Ячейка КАК Ячейка,
	|	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(, Контейнер В (&Контейнеры)) КАК вмс_ОперацияПоЯчейкамОстатки";
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаОстатков = РезультатЗапроса.Выгрузить();
	Возврат ТаблицаОстатков;
КонецФункции

Функция ПолучитьЯчейкиОтветственногоХранения() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_НастройкиОператора.ЯчейкаОтветственногоХранения КАК ЯчейкаОтветственногоХранения
	|ИЗ
	|	Справочник.вмс_НастройкиОператора КАК вмс_НастройкиОператора";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
