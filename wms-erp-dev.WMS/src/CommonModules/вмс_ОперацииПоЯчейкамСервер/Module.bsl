	ТаблицаПомещенийДляЗамены = Новый ТаблицаЗначений;
	ТаблицаПомещенийДляЗамены.Колонки.Добавить("Помещение", ОТПомещение);
	ТаблицаПомещенийДляЗамены.Колонки.Добавить("ПомещениеЗамена", ОТПомещение);
	
