КонецФункции

// ТУ_Кошелев 20.12.24 - сделал адаптацию конфигураций (пока для УТ и УНФ); учет знаменателя для УТ; возврат количества напрямую
Функция ПолучитьКоэффициентУпаковкиПоШтрихкоду(Штрихкод) Экспорт
	
	ИмяСправочникаУпаковки = вмс_АдаптацияКонфигураций.ПолучитьИмяСправочникаУпаковки();
	ИмяКолонкиЕдиницыИзмерения = вмс_АдаптацияКонфигураций.ИмяКолонкиЕдиницаИзмерения();
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры." + ИмяКолонкиЕдиницыИзмерения + " КАК Упаковка
	|ПОМЕСТИТЬ Упаковки
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод
	
	|ОБЪЕДИНИТЬ ВСЕ
	
	|ВЫБРАТЬ
	|	вмс_ШтрихкодыРасширенный.Упаковка
	|ИЗ
	|	РегистрСведений.вмс_ШтрихкодыРасширенный КАК вмс_ШтрихкодыРасширенный
	|ГДЕ
	|	вмс_ШтрихкодыРасширенный.Штрихкод = &Штрихкод
	|;";
	
	Если вмс_АдаптацияКонфигураций.ЭтоУТ() ИЛИ вмс_АдаптацияКонфигураций.ЭтоЕРП() Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ВЫБРАТЬ
		|ЕСТЬNULL(ВЫБОР      
		|	КОГДА УпаковкиСправочник.Знаменатель = 0
		|	ТОГДА УпаковкиСправочник.Числитель
		|	ИНАЧЕ УпаковкиСправочник.Числитель / УпаковкиСправочник.Знаменатель
		|КОНЕЦ, 1) КАК Коэффициент                
		|ИЗ
		|	Упаковки КАК Упаковки
		|		ЛЕВОЕ СОЕДИНЕНИЕ " + ИмяСправочникаУпаковки + " КАК УпаковкиСправочник
		|		ПО Упаковки.Упаковка = УпаковкиСправочник.Ссылка";
	Иначе	
		ТекстЗапроса = ТекстЗапроса + "
		|ВЫБРАТЬ
		|	ЕСТЬNULL(УпаковкиСправочник.Коэффициент, 1) КАК Коэффициент                
		|ИЗ
		|	Упаковки КАК Упаковки
		|		ЛЕВОЕ СОЕДИНЕНИЕ " + ИмяСправочникаУпаковки + " КАК УпаковкиСправочник
		|		ПО Упаковки.Упаковка = УпаковкиСправочник.Ссылка";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Коэффициент;
	КонецЦикла;
	
	Возврат 1;	
КонецФункции

