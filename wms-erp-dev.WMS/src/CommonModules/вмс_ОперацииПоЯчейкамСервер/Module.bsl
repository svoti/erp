Функция ПолучитьТаблицуТоваровВЯчейке(Товар, Ячейка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
	Запрос.Текст ="ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкамОстатки.Товар КАК Товар,
	|	вмс_ОперацияПоЯчейкамОстатки.Ячейка КАК Ячейка,
	|	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(
	|			,
	|			Товар = &Товар
	|				И Ячейка = &Ячейка) КАК вмс_ОперацияПоЯчейкамОстатки";
	
	Если Ячейка = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И МестаХраненияНоменклатуры.МестоХранения.Владелец В(&Склады)", "");
	КонецЕсли; 
	
	РезультатЗапроса = Запрос.Выполнить();
	//ТаблицаТоваровВЯчейке = РезультатЗапроса.Выгрузить();
	Выборка= РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Остатки = Выборка.Количество;	
		
	КонецЦикла;
	
	Возврат Остатки;	
	
КонецФункции
