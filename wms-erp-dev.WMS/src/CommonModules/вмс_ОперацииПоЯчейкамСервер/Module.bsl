// Функция - Получить данные собираемого комплекта
//
// Параметры:
//  ВходящиеПараметры	- Структура - коллекция входных параметров 
//  		Поля коллекции:
//      Основание   - ДокументСсылка.ЗаказНаСборку - документ для получения данных
// Возвращаемое значение:
//   - ТаблицаЗначений 
//
Функция ПолучитьДанныеСобираемогоКомплекта(ВходящиеПараметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказНаСборку.Номенклатура КАК Товар,
	|	ЗаказНаСборку.Характеристика КАК Характеристика,
	|   ЗаказНаСборку.Упаковка КАК Упаковка,
	|	ЗаказНаСборку.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказНаСборку КАК ЗаказНаСборку
	|ГДЕ
	|	ЗаказНаСборку.Ссылка = &ДокументОснование";     
	
	Запрос.УстановитьПараметр("ДокументОснование",ВходящиеПараметры.Основание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
	
КонецФункции

