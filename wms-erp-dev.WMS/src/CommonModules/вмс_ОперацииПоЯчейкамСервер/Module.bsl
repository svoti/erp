Функция ПолучитьЯчейкиДляОтгрузки(СписокДокументов) Экспорт
	
	Если Не ЗначениеЗаполнено(СписокДокументов) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкам.Ячейка КАК Ячейка,
	|	вмс_ОперацияПоЯчейкам.Регистратор.ДокументОснование КАК Документ
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкам
	|ГДЕ
	|	вмс_ОперацияПоЯчейкам.Регистратор.ДокументОснование В(&СписокДокументов)
	|	И вмс_ОперацияПоЯчейкам.Регистратор.ВидОперации = &ВидОперации
	|	И вмс_ОперацияПоЯчейкам.Регистратор.ПометкаУдаления = ЛОЖЬ
	|	И вмс_ОперацияПоЯчейкам.Регистратор.Проведен = ИСТИНА
	|	И вмс_ОперацияПоЯчейкам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_ОперацияПоЯчейкам.Ячейка,
	|	вмс_ОперацияПоЯчейкам.Регистратор.ДокументОснование";
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	Запрос.УстановитьПараметр("ВидОперации", вмс_ОперацииПоЯчейкамВызовСервера.ПолучитьСсылкуНаВидОперацииПоЯчейкам("Отбор"));  
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Возврат вмс_РаботаСКоллекциями.ЗагрузитьКвазиТаблицуЗначенийИзТаблицыЗначений(Результат);
	
КонецФункции 

