Функция ПолучитьНастройкуТоварныхПолей() Экспорт
	
	НастройкаТоварныхПолей = вмс_ОперацииПоЯчейкамКлиентСервер.ПолучитьСтруктуруНастройкиТоварныхПолей();

	НастройкаТоварныхПолейСохраненная = Справочники.вмс_НастройкиПрограммы.ПолучитьЗначениеНастройкиПрограммы("НастройкаТоварныхПолей");
	
	вмс_ОперацииПоЯчейкамКлиентСервер.ЗагрузитьСохраненнуюНастройкуТоварныхПолей(НастройкаТоварныхПолей, НастройкаТоварныхПолейСохраненная);
	
	Возврат НастройкаТоварныхПолей;

КонецФункции

Функция ПолучитьЗначенияПредставленийПолейДанных(ТаблицаЗапроса) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	ТаблицаДанных = РК.СкопироватьКоллекцию(ТаблицаЗапроса);
	ТоварныеПоляМассив = РК.ПолучитьКолонкиКоллекции(ТаблицаДанных);
	РК.ДобавитьКолонкуКоллекции(ТаблицаДанных, "Данные");
	
	Для Каждого СтрокаДанных Из РК.ПолучитьЭлементыКоллекции(ТаблицаДанных) Цикл
		ПредставлениеТовара = "";
		РК.ДобавитьЗначенияВСтроку(ПредставлениеТовара, СтрокаДанных.Товар.Артикул);
		РК.ДобавитьЗначенияВСтроку(ПредставлениеТовара, СтрокаДанных.Товар);
		
		ПредставлениеТоварныхПолей = "";
		Для Каждого ТоварноеПоле Из ТоварныеПоляМассив Цикл
			Если ТоварноеПоле = "Товар" Тогда
				Значение = ПредставлениеТовара;
			Иначе
				Значение = СтрокаДанных[ТоварноеПоле];
			КонецЕсли;
			
			Если Значение <> Неопределено Тогда
				РК.ДобавитьЗначенияВСтроку(ПредставлениеТоварныхПолей, Значение);
			КонецЕсли;
		КонецЦикла;
		
		Данные = Новый Структура;
		Данные.Вставить("ПредставлениеТовара", ПредставлениеТовара);
		Данные.Вставить("ПредставлениеТоварныхПолей", ПредставлениеТоварныхПолей);
		
		СтрокаДанных.Данные = Данные;
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьСКДИсточникаПредставленийТоварныхПолей() Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	СКД = Справочники.вмс_НастройкиПрограммы.ПолучитьМакет("СКДШаблонаИсточникаПредставленийТоварныхПолей");
	
	НаборДанных = СКД.НаборыДанных[0];
	
	ТоварныеПоля = вмс_ОперацииПоЯчейкамКлиентСерверПовтИсп.ТоварныеПоля();
	
	Для Каждого ТоварноеПоле Из ТоварныеПоля Цикл
		Если НаборДанных.Поля.Найти(ТоварноеПоле) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.Поле = ТоварноеПоле;
		Поле.ПутьКДанным = ТоварноеПоле;
		Поле.Заголовок = ТоварноеПоле;
	КонецЦикла;
	
	ВыбранныеПоля = СКД.НастройкиПоУмолчанию.Выбор.Элементы;
	Для Каждого ТоварноеПоле Из ТоварныеПоля Цикл
		ПолеКомпоновки = Новый ПолеКомпоновкиДанных(ТоварноеПоле);
		НайденноеПоле = РК.НайтиЭлементКоллекции(ВыбранныеПоля, Новый Структура("Поле", ПолеКомпоновки));
		Если НайденноеПоле <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Поле = ВыбранныеПоля.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Использование = Истина;
		Поле.Поле = ПолеКомпоновки;
	КонецЦикла;
	
	Возврат СКД;
	
КонецФункции

Функция ПолучитьЗначенияПредставленийПолейДанныхСКД(знач ТаблицаЗапроса) Экспорт
	
	РК = вмс_РаботаСКоллекциями;

	НастройкаТоварныхПолей = ПолучитьНастройкуТоварныхПолей();
	ТаблицаИспользуемыхТоварныхПолей = РК.СкопироватьКоллекцию(НастройкаТоварныхПолей.ТаблицаПолей, Новый Структура("Использование", Истина));
	РК.ДополнитьКолонкиКоллекции(ТаблицаИспользуемыхТоварныхПолей, "ПредставлениеМассив");
	Для Каждого СтрокаПоля Из РК.ПолучитьЭлементыКоллекции(ТаблицаИспользуемыхТоварныхПолей) Цикл
		СтрокаПоля.ПредставлениеМассив = РК.СтрокуВМассив(СтрокаПоля.Представление);
	КонецЦикла;
	ЭлементыТаблицыИспользуемыхТоварныхПолей = РК.ПолучитьЭлементыКоллекции(ТаблицаИспользуемыхТоварныхПолей);
	
	ТоварныеПоля = вмс_ОперацииПоЯчейкамКлиентСерверПовтИсп.ТоварныеПоля();

	Если РК.ЭтоКвазиТаблицаЗначений(ТаблицаЗапроса) Тогда
		ТаблицаЗапроса = РК.ВыгрузитьКвазиТаблицуЗначенийВИстиннуюТаблицуЗначений(ТаблицаЗапроса);
	КонецЕсли;
	РК.ДополнитьКолонкиКоллекции(ТаблицаЗапроса, ТоварныеПоля);
	
	ДанныеИсточника = ПолучитьДанныеИсточникаПредставленийТоварныхПолей(НастройкаТоварныхПолей, ТаблицаЗапроса);
	
	ПоляПоискаМассив = РК.СкопироватьОбъект(ТоварныеПоля);
	ПоляПоискаМассив = РК.ПересечениеМассивов(ПоляПоискаМассив, РК.ПолучитьКолонкиКоллекции(ДанныеИсточника));
	ПоляПоиска = РК.МассивВСтроку(ПоляПоискаМассив);
	
	ПоляТаблицыДанных = РК.СложениеМассивов(ТоварныеПоля, "Данные");
	ТаблицаДанных = РК.НоваяТаблицаЗначений(ПоляТаблицыДанных);
	
	Поиск = Новый Структура(ПоляПоиска);
	Для Каждого СтрокаЗапроса Из ТаблицаЗапроса Цикл

		ПредставлениеТоварныхПолей = "";
		
		ПредставленияТоварныхПолей = Новый Структура;

		ЗаполнитьЗначенияСвойств(Поиск, СтрокаЗапроса);
		ДанныеИсточникаПоСтрокеЗапросаМассив = ДанныеИсточника.НайтиСтроки(Поиск);
		Если ДанныеИсточникаПоСтрокеЗапросаМассив.Количество() > 0 Тогда
			ДанныеИсточникаПоСтрокеЗапроса = ДанныеИсточникаПоСтрокеЗапросаМассив[0];
			Для Каждого СтрокаПоля Из ЭлементыТаблицыИспользуемыхТоварныхПолей Цикл
				ИмяПоля = СтрокаПоля.Имя;
				ПредставлениеПоля = "";
				Для Каждого ПолеПредставления Из СтрокаПоля.ПредставлениеМассив Цикл
					Значение = ДанныеИсточникаПоСтрокеЗапроса[ПолеПредставления];
					
					Если Не ЗначениеЗаполнено(Значение) И вмс_ОбщегоНазначенияВызовСервера.ЭтоЗначениеСсылочногоТипа(Значение) Тогда
						ПредставлениеЗначения = "-";
					Иначе
						ПредставлениеЗначения = Строка(Значение);
					КонецЕсли;
					
					ПредставлениеПоля = ПредставлениеПоля + ПредставлениеЗначения;
				КонецЦикла;
				ПредставленияТоварныхПолей.Вставить(ИмяПоля, ПредставлениеПоля);
				РК.ДобавитьЗначенияВСтроку(ПредставлениеТоварныхПолей, ПредставлениеПоля);
			КонецЦикла;
		КонецЕсли;
		
		СтрокаДанных = ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДанных, СтрокаЗапроса);

		ДанныеПредставлений = Новый Структура;
		ДанныеПредставлений.Вставить("ПредставленияТоварныхПолей", ПредставленияТоварныхПолей);
		ДанныеПредставлений.Вставить("ПредставлениеТоварныхПолей", ПредставлениеТоварныхПолей);
		СтрокаДанных.Данные = ДанныеПредставлений;
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьДанныеИсточникаПредставленийТоварныхПолей(НастройкаТоварныхПолей, ТаблицаЗапроса)

	РК = вмс_РаботаСКоллекциями;

	СКД = вмс_ОбщегоНазначенияКлиентСервер.ПрочитатьТекстОбъектаXDTO(НастройкаТоварныхПолей.СКДИсточникаПредставленийПолей);
	
	ИсточникДоступныхНастроекКомпоновкиДанных = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД);
	
	КомпоновщикНастроекКомпоновкиДанных = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроекКомпоновкиДанных.Инициализировать(ИсточникДоступныхНастроекКомпоновкиДанных);
	НастройкиСКД = КомпоновщикНастроекКомпоновкиДанных.ПолучитьНастройки();

	ВнешниеНаборыДанных = Новый Структура("ТаблицаЗапроса", ТаблицаЗапроса);
	РаботаССКД.УстановитьВыбранныеПоляПоДоступнымПолям(НастройкиСКД);
	РаботаССКД.УстановитьНастройкиДляПолученияКоллекцииЗначений(НастройкиСКД);
	ДанныеИсточника = РаботаССКД.ПолучитьДанныеСКД(СКД, НастройкиСКД, ВнешниеНаборыДанных);
	
	Возврат ДанныеИсточника;

КонецФункции

