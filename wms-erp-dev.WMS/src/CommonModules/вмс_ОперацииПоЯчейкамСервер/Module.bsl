Функция ПолучитьТаблицуТоваровПоДокументам(ВходящиеПараметры) Экспорт 
	
	ДанныеСпискаТоваров = Справочники.вмс_РаспоряженияОпераций.ПолучитьСписокТоваровПоРаспоряжениям(ВходящиеПараметры);
	
	Если ДанныеСпискаТоваров.Таблица <> Неопределено Тогда
		ТаблицаТоваров = ДанныеСпискаТоваров.Таблица;

		ИмяКолонки = вмс_АдаптацияКонфигураций.ИмяКолонкиХарактеристика();
		Если ИмяКолонки <> Неопределено И ИмяКолонки <> "Характеристика" Тогда
			КолонкаХарактеристика = ТаблицаТоваров.Колонки.Найти(ИмяКолонки);
			Если КолонкаХарактеристика <> Неопределено Тогда
				КолонкаХарактеристика.Имя = "Характеристика";
			КонецЕсли;
		КонецЕсли; 
	Иначе
		ТаблицаТоваров = Новый ТаблицаЗначений;
		ТаблицаТоваров.Колонки.Добавить("Товар");
		ТаблицаТоваров.Колонки.Добавить("Характеристика");	
		ТаблицаТоваров.Колонки.Добавить("Количество");
	КонецЕсли; 
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Функция ПолучитьТаблицуПринятыхТоваров(ДокументОснование, ВидОперации, ВключаяДокументыОпераций=Неопределено, ИсключаяДокументыОпераций=Неопределено) Экспорт
	
	//24.05.2022 ТПТ2405
	// Старая функция. В мобильном приложении переделано на обработку через ПолучитьТаблицуПринятыхТоваровЧерезСтруктуру
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкамТовары.Ссылка.ДокументОснование КАК ДокументОснование,
	|	вмс_ОперацияПоЯчейкамТовары.Товар КАК Товар,
	|	вмс_ОперацияПоЯчейкамТовары.Характеристика КАК Характеристика,
	|	вмс_ОперацияПоЯчейкамТовары.Ячейка КАК Ячейка,
	|	вмс_ОперацияПоЯчейкамТовары.ЯчейкаПриемник КАК ЯчейкаПриемник,
	|	вмс_ОперацияПоЯчейкамТовары.Контейнер КАК Контейнер,
	|	вмс_ОперацияПоЯчейкамТовары.КонтейнерПриемник КАК КонтейнерПриемник,
	|	вмс_ОперацияПоЯчейкамТовары.КонтейнерОтправитель КАК КонтейнерОтправитель,
	|	СУММА(вмс_ОперацияПоЯчейкамТовары.Количество) КАК Количество
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам.Товары КАК вмс_ОперацияПоЯчейкамТовары
	|ГДЕ
	|	вмс_ОперацияПоЯчейкамТовары.Ссылка.Проведен
	|	И вмс_ОперацияПоЯчейкамТовары.Ссылка.ДокументОснование = &ДокументОснование
	|	И вмс_ОперацияПоЯчейкамТовары.Ссылка.ВидОперации = &ВидОперации
	|	И &ДопОтборы
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_ОперацияПоЯчейкамТовары.Товар,
	|	вмс_ОперацияПоЯчейкамТовары.Ячейка,
	|	вмс_ОперацияПоЯчейкамТовары.ЯчейкаПриемник,
	|	вмс_ОперацияПоЯчейкамТовары.Характеристика,
	|	вмс_ОперацияПоЯчейкамТовары.Контейнер,
	|	вмс_ОперацияПоЯчейкамТовары.КонтейнерПриемник,
	|	вмс_ОперацияПоЯчейкамТовары.КонтейнерОтправитель,
	|	вмс_ОперацияПоЯчейкамТовары.Ссылка.ДокументОснование";
	
	ДопОтборыСтрока = "";
	Если ВключаяДокументыОпераций <> Неопределено Тогда
		Запрос.УстановитьПараметр("ВключаяДокументыОпераций", ВключаяДокументыОпераций);
		ДопОтборыСтрока = ДопОтборыСтрока + " И вмс_ОперацияПоЯчейкамТовары.Ссылка В (&ВключаяДокументыОпераций)";
	КонецЕсли; 
	
	Если ИсключаяДокументыОпераций <> Неопределено Тогда
		Запрос.УстановитьПараметр("ИсключаяДокументыОпераций", ИсключаяДокументыОпераций);
		ДопОтборыСтрока = ДопОтборыСтрока + " И НЕ вмс_ОперацияПоЯчейкамТовары.Ссылка В (&ИсключаяДокументыОпераций)";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ДопОтборы", ДопОтборыСтрока);
	
	РезультатЗапроса = Запрос.Выполнить();
	Таблица = РезультатЗапроса.Выгрузить();
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьТаблицуОтобранныхТоваровЧерезСтруктуру(ВходящиеПараметры) Экспорт
	
	ПустаяЯчейка = Справочники.вмс_МестаХранения.ПустаяСсылка();
	ПустойТовар = Справочники.Номенклатура.ПустаяСсылка();

	ПолученныеДанные = ПолучитьТаблицуПринятыхТоваровЧерезСтруктуру(ВходящиеПараметры);
	
	НовыйФорматРезультата = ВходящиеПараметры.Свойство("НовыйФорматРезультата") И ВходящиеПараметры.НовыйФорматРезультата;
	
	Если НовыйФорматРезультата Тогда
		ТаблицаПринятыхТоваров = ПолученныеДанные.Товары;
	Иначе
		ТаблицаПринятыхТоваров = ПолученныеДанные;
	КонецЕсли;
	
	ТаблицаОтобранныхТоваров = ТаблицаПринятыхТоваров.СкопироватьКолонки();
	Для Каждого СтрокаПринятогоТовара Из ТаблицаПринятыхТоваров Цикл
		Если СтрокаПринятогоТовара.Ячейка <> ПустаяЯчейка И СтрокаПринятогоТовара.Товар <> ПустойТовар Тогда
			СтрокаОтобранногоТовара = ТаблицаОтобранныхТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОтобранногоТовара, СтрокаПринятогоТовара);
			
			Если СтрокаОтобранногоТовара.Ячейка.ТипЯчейки = Перечисления.вмс_ТипыЯчеек.ЗонаОтгрузки Тогда
				СтрокаОтобранногоТовара.Количество = -СтрокаОтобранногоТовара.Количество;
				СтрокаОтобранногоТовара.КоличествоБазовыхЕдиниц = -СтрокаОтобранногоТовара.КоличествоБазовыхЕдиниц;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если НовыйФорматРезультата Тогда
		ПолученныеДанные.Товары = ТаблицаОтобранныхТоваров;
	Иначе
		ПолученныеДанные = ТаблицаОтобранныхТоваров;
	КонецЕсли;
	
	Возврат ПолученныеДанные;
	
КонецФункции

Функция УстановитьЗонуОтгрузкиОперацииОтбора(ВходящиеПараметры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкам.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкам
	|ГДЕ
	|	вмс_ОперацияПоЯчейкам.Проведен
	|	И вмс_ОперацияПоЯчейкам.ДокументОснование В(&ДокументОснование)
	|	И вмс_ОперацияПоЯчейкам.ВидОперации = &ВидОперации";
	
	Запрос.УстановитьПараметр("ДокументОснование", ВходящиеПараметры.ДокументОснование);
	Запрос.УстановитьПараметр("ВидОперации", ВходящиеПараметры.ВидОперации);
	РезультатЗапроса = Запрос.Выполнить();
	
	ЗонаОтгрузки = ВходящиеПараметры.ЗонаОтгрузки;
	
	Выборка = РезультатЗапроса.Выбрать();
	Изменены = Ложь;
	Пока Выборка.Следующий() Цикл
		
		Изменен = Ложь;
		ОперацияПоЯчейкам = Выборка.Ссылка.ПолучитьОбъект();
		Для Каждого СтрокаТовара Из ОперацияПоЯчейкам.Товары Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.ЯчейкаПриемник) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТовара.ЯчейкаПриемник=ЗонаОтгрузки Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТовара.ЯчейкаПриемник = ЗонаОтгрузки;
			Изменен = Истина;
			Изменены = Истина;
			
		КонецЦикла;
		
		Если Изменен Тогда
			ОперацияПоЯчейкам.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Изменены;
	
КонецФункции

Функция ПолучитьТаблицуПринятыхТоваровЧерезСтруктуру(ВходящиеПараметры) Экспорт
	
	//24.05.2022 ТПТ2405
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументыОснования", ВходящиеПараметры.ДокументОснование);
	Запрос.УстановитьПараметр("ВидыОпераций", ВходящиеПараметры.ВидОперации);
	ТекстЗапросаПоТоварам =
	"ВЫБРАТЬ
	|	ДокументыОпераций.Ссылка КАК СсылкаОперации,
	|	ДокументыОпераций.ДокументОснование КАК ДокументОснование,
	|	ДокументыОпераций.Помещение КАК Помещение,
	|	ТоварыОпераций.Товар КАК Товар,
	|	ТоварыОпераций.Характеристика КАК Характеристика,
	|	ТоварыОпераций.Ячейка КАК Ячейка,
	|	ТоварыОпераций.ЯчейкаПриемник КАК ЯчейкаПриемник,
	|	ТоварыОпераций.Контейнер КАК Контейнер,
	|	ТоварыОпераций.КонтейнерПриемник КАК КонтейнерПриемник,
	|	ТоварыОпераций.Партия КАК Партия,
	|	ТоварыОпераций.Серия КАК Серия,
	|	ТоварыОпераций.Качество КАК Качество,
	|	ТоварыОпераций.Упаковка КАК Упаковка,
	|	ТоварыОпераций.Документ КАК Документ,
	|	СУММА(ТоварыОпераций.Количество) КАК Количество,
	|	СУММА(ТоварыОпераций.КоличествоБазовыхЕдиниц) КАК КоличествоБазовыхЕдиниц
	|ПОМЕСТИТЬ ТаблицаБезАртикула
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам КАК ДокументыОпераций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.вмс_ОперацияПоЯчейкам.Товары КАК ТоварыОпераций
	|		ПО ДокументыОпераций.Ссылка = ТоварыОпераций.Ссылка
	|ГДЕ
	|	ДокументыОпераций.Проведен
	|	И (ДокументыОпераций.ДокументОснование В (&ДокументыОснования)
	|			ИЛИ ДокументыОпераций.ЗаданиеКладовщику В (&ДокументыОснования))
	|	И ДокументыОпераций.ВидОперации В(&ВидыОпераций)
	|	И НЕ ДокументыОпераций.ВидСубОперации В (&ИсключитьВидыСубОпераций)
	|	И &ДопОтборы
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыОпераций.Ссылка,
	|	ДокументыОпераций.ДокументОснование,
	|	ДокументыОпераций.Помещение,
	|	ТоварыОпераций.Товар,
	|	ТоварыОпераций.Ячейка,
	|	ТоварыОпераций.ЯчейкаПриемник,
	|	ТоварыОпераций.Характеристика,
	|	ТоварыОпераций.Контейнер,
	|	ТоварыОпераций.КонтейнерПриемник,
	|	ТоварыОпераций.Партия,
	|	ТоварыОпераций.Серия,
	|	ТоварыОпераций.Качество,
	|	ТоварыОпераций.Упаковка,
	|	ТоварыОпераций.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаБезАртикула.СсылкаОперации КАК СсылкаОперации,
	|	ТаблицаБезАртикула.ДокументОснование КАК ДокументОснование,
	|	ТаблицаБезАртикула.Помещение КАК Помещение,
	|	ТаблицаБезАртикула.Товар КАК Товар,
	|	ТаблицаБезАртикула.Характеристика КАК Характеристика,
	|	ТаблицаБезАртикула.Ячейка КАК Ячейка,
	|	ТаблицаБезАртикула.ЯчейкаПриемник КАК ЯчейкаПриемник,
	|	ТаблицаБезАртикула.Контейнер КАК Контейнер,
	|	ТаблицаБезАртикула.КонтейнерПриемник КАК КонтейнерПриемник,
	|	ТаблицаБезАртикула.Партия КАК Партия,
	|	ТаблицаБезАртикула.Серия КАК Серия,
	|	ТаблицаБезАртикула.Качество КАК Качество,
	|	ТаблицаБезАртикула.Упаковка КАК Упаковка,
	|	ТаблицаБезАртикула.Документ КАК Документ,
	|	ТаблицаБезАртикула.Количество КАК Количество,
	|	ТаблицаБезАртикула.КоличествоБазовыхЕдиниц КАК КоличествоБазовыхЕдиниц,
	|	Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	ТаблицаБезАртикула КАК ТаблицаБезАртикула
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ТаблицаБезАртикула.Товар = Номенклатура.Ссылка";
	
	ДопОтборыСтрока = "";
	
	ИсключитьВидыСубОпераций = Новый Массив;
	ИсключитьВидыСубОпераций.Добавить(вмс_ОперацииПоЯчейкамВызовСервера.ПолучитьСсылкуНаВидОперацииПоЯчейкам("ИзменитьПаллету"));
	вмс_РаботаСКоллекциями.УдалитьПустыеСтрокиКоллекции(ИсключитьВидыСубОпераций);
	Запрос.УстановитьПараметр("ИсключитьВидыСубОпераций", ИсключитьВидыСубОпераций);
	
	Если ВходящиеПараметры.Свойство("ВключаяДокументыОпераций") И ВходящиеПараметры.ВключаяДокументыОпераций <> Неопределено Тогда
		Запрос.УстановитьПараметр("ВключаяДокументыОпераций", ВходящиеПараметры.ВключаяДокументыОпераций);
		ДопОтборыСтрока = ДопОтборыСтрока + " И ДокументыОпераций.Ссылка В (&ВключаяДокументыОпераций)";
	КонецЕсли; 
	
	Если ВходящиеПараметры.Свойство("ИсключаяДокументыОпераций") И ВходящиеПараметры.ИсключаяДокументыОпераций <> Неопределено Тогда
		Запрос.УстановитьПараметр("ИсключаяДокументыОпераций", ВходящиеПараметры.ИсключаяДокументыОпераций);
		ДопОтборыСтрока = ДопОтборыСтрока + " И НЕ ДокументыОпераций.Ссылка В (&ИсключаяДокументыОпераций)";
	КонецЕсли;
	
	Если ВходящиеПараметры.Свойство("ИсключаяОператоров") И ВходящиеПараметры.ИсключаяОператоров <> Неопределено Тогда
		Запрос.УстановитьПараметр("ИсключаяОператоров", ВходящиеПараметры.ИсключаяОператоров);
		ДопОтборыСтрока = ДопОтборыСтрока + " И НЕ ДокументыОпераций.Ответственный В (&ИсключаяОператоров)";
	КонецЕсли;
	
	Если Не (ВходящиеПараметры.Свойство("ДетализироватьПоОперациям") И ВходящиеПараметры.ДетализироватьПоОперациям = Истина) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументыОпераций.Ссылка КАК СсылкаОперации,", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументыОпераций.Ссылка,", "");
	КонецЕсли;
	
	ТекстЗапросаПоТоварам = СтрЗаменить(ТекстЗапросаПоТоварам, "И &ДопОтборы", ДопОтборыСтрока);
	
	Запрос.Текст = ТекстЗапросаПоТоварам;
	
	НовыйФорматРезультата = ВходящиеПараметры.Свойство("НовыйФорматРезультата") И ВходящиеПараметры.НовыйФорматРезультата = Истина;
	
	ПолучитьКодыМаркировки = ВходящиеПараметры.Свойство("ПолучитьКодыМаркировки") И ВходящиеПараметры.ПолучитьКодыМаркировки = Истина;
	Если ПолучитьКодыМаркировки Тогда 
		ЗапросКодыМаркировки = Новый Запрос;
		НовыйФорматРезультата = Истина;
		ТекстЗапросаПоКодамМаркировки =
		"ВЫБРАТЬ
		|	ДокументыОпераций.Ссылка КАК СсылкаОперации,
		|	ДокументыОпераций.ДокументОснование КАК ДокументОснование,
		|	ДокументыОпераций.Помещение КАК Помещение,
		|	КодыМаркировкиОпераций.НомерСтроки КАК НомерСтроки,
		|	КодыМаркировкиОпераций.Товар КАК Товар,
		|	КодыМаркировкиОпераций.Маркировка КАК Маркировка,
		|	КодыМаркировкиОпераций.Характеристика КАК Характеристика,
		// ТУ_Васильев 25.04.25 ++
		//|	КодыМаркировкиОпераций.КонтейнерОтправитель КАК КонтейнерОтправитель,
		// ТУ_Васильев 25.04.25 --
		|	КодыМаркировкиОпераций.Серия КАК Серия,
		|	КодыМаркировкиОпераций.Качество КАК Качество
		|ПОМЕСТИТЬ ТаблицаБезАртикула
		|ИЗ
		|	Документ.вмс_ОперацияПоЯчейкам КАК ДокументыОпераций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.вмс_ОперацияПоЯчейкам.КодыМаркировки КАК КодыМаркировкиОпераций
		|		ПО ДокументыОпераций.Ссылка = КодыМаркировкиОпераций.Ссылка
		|ГДЕ
		|	ДокументыОпераций.Проведен
		|	И ДокументыОпераций.ДокументОснование В(&ДокументыОснования)
		|	И ДокументыОпераций.ВидОперации В(&ВидыОпераций)
		|	И &ДопОтборы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаБезАртикула.СсылкаОперации КАК СсылкаОперации,
		|	ТаблицаБезАртикула.ДокументОснование КАК ДокументОснование,
		|	ТаблицаБезАртикула.Помещение КАК Помещение,
		|	ТаблицаБезАртикула.НомерСтроки КАК НомерСтроки,
		|	ТаблицаБезАртикула.Товар КАК Товар,
		|	ТаблицаБезАртикула.Маркировка КАК Маркировка,
		|	ТаблицаБезАртикула.Характеристика КАК Характеристика,
		// ТУ_Васильев 25.04.25 ++
		//|	ТаблицаБезАртикула.КонтейнерОтправитель КАК КонтейнерОтправитель,	
		// ТУ_Васильев 25.04.25 --
		|	ТаблицаБезАртикула.Серия КАК Серия,
		|	ТаблицаБезАртикула.Качество КАК Качество,
		|	Номенклатура.Артикул КАК Артикул
		|ИЗ
		|	ТаблицаБезАртикула КАК ТаблицаБезАртикула
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ТаблицаБезАртикула.Товар = Номенклатура.Ссылка";
		
		ДопОтборыПоКодамМаркировкиСтрока = ДопОтборыСтрока;
		ТекстЗапросаПоКодамМаркировки = СтрЗаменить(ТекстЗапросаПоКодамМаркировки, "И &ДопОтборы", ДопОтборыПоКодамМаркировкиСтрока);
		
		// ТУ_Васильев 25.04.25 ++
		ЗапросКодыМаркировки.УстановитьПараметр("ДокументыОснования", ВходящиеПараметры.ДокументОснование);
		ЗапросКодыМаркировки.УстановитьПараметр("ВидыОпераций", ВходящиеПараметры.ВидОперации);
		// ТУ_Васильев 25.04.25 --
		
		ЗапросКодыМаркировки.Текст = ТекстЗапросаПоКодамМаркировки;
	КонецЕсли;
	
	ТаблицаТоваров = Запрос.Выполнить().Выгрузить();
	
	// Кулалаев Е.С + 14.03.2023 17:08:04
	// -----Описание-----
	// Если ориентируемся по предыдущему документу (отбор - контроль, приемка - размещение)
	// то берем только строки, которые упали на ячейку
	// ------------------ 	
	Если ВходящиеПараметры.Свойство("ОбработкаПеремещения") И ВходящиеПараметры.ОбработкаПеремещения Тогда
		вмс_РаботаСКоллекциями.УдалитьПустыеСтрокиКоллекции(ТаблицаТоваров, "ЯчейкаПриемник");
	КонецЕсли;	
	// Кулалаев Е.С -
	
	// ТУ_Самойленко 03.08.23 ++
	ГруппировкаПолей = Неопределено;
	Если ВходящиеПараметры.Свойство("ГруппировкаПолей", ГруппировкаПолей) Тогда 
		Если ГруппировкаПолей = Истина Тогда
			НИТП = вмс_РаботаСКоллекциями.МассивВСтроку(вмс_ОперацииПоЯчейкамКлиентСервер.ИспользуемыеТоварныеПоля());
			НИТП = НИТП + ?(вмс_ОбщегоНазначенияСервер.ИспользуютсяКонтейнеры(), ", Контейнер", ""); //Добавление поля для определения в какой контейнер ушел товар при приемке
			НИТП = НИТП + ?(вмс_ОбщегоНазначенияСервер.ИспользуютсяКонтейнеры(), ", КонтейнерПриемник", ""); //Добавление поля для определения в какой контейнер ушел товар при приемке
			НИТП = НИТП + ", Артикул";
			ТаблицаТоваров.Свернуть(НИТП, "Количество"); //Пока убрал КоличествоБазовыхЕдиниц	
		ИначеЕсли ТипЗнч(ГруппировкаПолей) = Тип("Структура") Тогда
			ПоляГруппировки = Неопределено; ПоляСуммирования = Неопределено;	
			ГруппировкаПолей.Свойство("ПоляГруппировки", ПоляГруппировки);	
			ГруппировкаПолей.Свойство("ПоляСуммирования", ПоляСуммирования);
			ТаблицаТоваров.Свернуть(ПоляГруппировки, ПоляСуммирования);
		КонецЕсли;
	КонецЕсли;
	// ТУ_Самойленко 03.08.23 --
	
	Если НовыйФорматРезультата Тогда
		Результат = Новый Структура;
		Результат.Вставить("Товары", ТаблицаТоваров);
		Если ПолучитьКодыМаркировки Тогда
			ТаблицаКодовМаркировки = ЗапросКодыМаркировки.Выполнить().Выгрузить();
			Результат.Вставить("КодыМаркировки", ТаблицаКодовМаркировки);
		КонецЕсли;
	Иначе
		Результат = ТаблицаТоваров;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОтобранныеИПроверенныеТоварыПоЗаданиям(Задания) Экспорт
	
	// Кулалаев 08.07.2025: Исправлен алгоритм для отгрузки по отбору
	// Сначала находим все документы "Отбор", потом с видом "Контроль"
	// Если есть контроль - берем его. Иначе берем отбор.
	
		ТекстЗапроса = "ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкам.Ссылка КАК ДокументТСД,
	|	вмс_ОперацияПоЯчейкам.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкам
	|ГДЕ
	|	вмс_ОперацияПоЯчейкам.ВидОперации.ИмяДляПоиска В(&ИменаДляПоиска)
	|	И вмс_ОперацияПоЯчейкам.ДокументОснование В(&Задания)
	|	И вмс_ОперацияПоЯчейкам.Проведен = ИСТИНА"; 
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Задания", Задания);
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&ИменаДляПоиска", """Отбор"", ""Отбор2""");
	
	ДокументыОтбор = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументТСД");
	ОбщегоНазначения.СообщитьПользователю(ДокументыОтбор.Количество());
	
	Запрос.УстановитьПараметр("Задания", Задания);
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&ИменаДляПоиска", """Контроль""");
	
	ДокументыКонтроль = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументТСД"); 
	ОбщегоНазначения.СообщитьПользователю(ДокументыКонтроль.Количество());	
	ОперацииПоЯчейкам = Новый Массив;
	
	Если ДокументыКонтроль.Количество() > 0 Тогда
		ОперацииПоЯчейкам = ДокументыКонтроль;
	ИначеЕсли ДокументыОтбор.Количество() > 0 Тогда
		ОперацииПоЯчейкам = ДокументыОтбор;
	КонецЕсли;

	
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкамОбороты.Товар КАК Товар,
	|	вмс_ОперацияПоЯчейкамОбороты.Контейнер.Родитель КАК КонтейнерРодитель,
	|	ВЫБОР
	|		КОГДА вмс_ОперацияПоЯчейкамОбороты.Контейнер.Родитель ЕСТЬ NULL
	|				ИЛИ вмс_ОперацияПоЯчейкамОбороты.Контейнер.Родитель = ЗНАЧЕНИЕ(Справочник.вмс_Контейнеры.ПустаяСсылка)
	|			ТОГДА вмс_ОперацияПоЯчейкамОбороты.Контейнер
	|		ИНАЧЕ вмс_ОперацияПоЯчейкамОбороты.Контейнер.Родитель
	|	КОНЕЦ КАК Контейнер,
	|	вмс_ОперацияПоЯчейкамОбороты.Характеристика КАК Характеристика,
	|	вмс_ОперацияПоЯчейкамОбороты.Ячейка КАК Ячейка,
	|	СУММА(вмс_ОперацияПоЯчейкамОбороты.КоличествоПриход) КАК Количество,
	|	вмс_ОперацияПоЯчейкамОбороты.Партия КАК Партия,
	|	вмс_ОперацияПоЯчейкамОбороты.Серия КАК Серия,
	|	вмс_ОперацияПоЯчейкамОбороты.Качество КАК Качество
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Обороты(, , Регистратор, ) КАК вмс_ОперацияПоЯчейкамОбороты
	|ГДЕ
	|	вмс_ОперацияПоЯчейкамОбороты.Регистратор В(&ОперацииПоЯчейкам)
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_ОперацияПоЯчейкамОбороты.Характеристика,
	|	вмс_ОперацияПоЯчейкамОбороты.Ячейка,
	|	вмс_ОперацияПоЯчейкамОбороты.Товар,
	|	вмс_ОперацияПоЯчейкамОбороты.Качество,
	|	вмс_ОперацияПоЯчейкамОбороты.Серия,
	|	вмс_ОперацияПоЯчейкамОбороты.Партия,
	|	ВЫБОР
	|		КОГДА вмс_ОперацияПоЯчейкамОбороты.Контейнер.Родитель ЕСТЬ NULL
	|				ИЛИ вмс_ОперацияПоЯчейкамОбороты.Контейнер.Родитель = ЗНАЧЕНИЕ(Справочник.вмс_Контейнеры.ПустаяСсылка)
	|			ТОГДА вмс_ОперацияПоЯчейкамОбороты.Контейнер
	|		ИНАЧЕ вмс_ОперацияПоЯчейкамОбороты.Контейнер.Родитель
	|	КОНЕЦ,
	|	вмс_ОперацияПоЯчейкамОбороты.Контейнер.Родитель";
	
	Запрос.УстановитьПараметр("ОперацииПоЯчейкам", ОперацииПоЯчейкам);
	ТаблицаТоваров = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Функция ПолучитьТаблицуТоваровПоИнвентаризации(знач ДокументОперацияПоЯчейкам=Неопределено, Оператор=Неопределено) Экспорт
	
	Если ДокументОперацияПоЯчейкам = Неопределено Тогда
		ДокументОперацияПоЯчейкам = ПолучитьАктивнуюОперациюИнвентаризацииПоЯчейкам(Оператор);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОперацияПоЯчейкам);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Ссылка КАК Ссылка,
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Товар КАК Товар,
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Характеристика КАК Характеристика,
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Количество КАК Количество,
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.КоличествоУчет КАК КоличествоУчет,
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Ячейка КАК Ячейка
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам.ТоварыПоИнвентаризации КАК вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации
	|ГДЕ
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Ссылка = &Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаТоваровПоИнвентаризации = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаТоваровПоИнвентаризации;
	
КонецФункции

Функция ПолучитьАктивнуюОперациюИнвентаризацииПоЯчейкам(Оператор) Экспорт
	
	ВидОперации = вмс_ОперацииПоЯчейкамВызовСервера.ПолучитьСсылкуНаВидОперацииПоЯчейкам("Инвентаризация");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.УстановитьПараметр("Оператор", Оператор);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкам.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкам
	|ГДЕ
	|	вмс_ОперацияПоЯчейкам.Проведен
	|	И вмс_ОперацияПоЯчейкам.ВидОперации = &ВидОперации
	|	И вмс_ОперацияПоЯчейкам.Ответственный = &Оператор
	|	И НЕ вмс_ОперацияПоЯчейкам.Готов";
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТаблицуМестХраненияТовараДляРазмещения(Товары, Склады=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Склады", Склады);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестаХраненияНоменклатуры.МестоХранения.Владелец КАК Склад,
	|	МестаХраненияНоменклатуры.Товар КАК Товар,
	|	МестаХраненияНоменклатуры.Характеристика КАК Характеристика,
	|	МестаХраненияНоменклатуры.Приоритет КАК Приоритет,
	|	МестаХраненияНоменклатуры.МестоХранения КАК МестоХранения
	|ИЗ
	|	РегистрСведений.вмс_МестаХраненияНоменклатуры КАК МестаХраненияНоменклатуры
	|ГДЕ
	|	МестаХраненияНоменклатуры.Товар В(&Товары)
	|	И МестаХраненияНоменклатуры.МестоХранения.Владелец В(&Склады)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад,
	|	Товар,
	|	Приоритет,
	|	МестоХранения";
	
	Если Склады = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И МестаХраненияНоменклатуры.МестоХранения.Владелец В(&Склады)", "");
	КонецЕсли; 
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаМестХранения = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаМестХранения;
	
КонецФункции

