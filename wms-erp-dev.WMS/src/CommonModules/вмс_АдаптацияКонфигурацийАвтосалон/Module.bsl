Функция ПолучитьЕдиницыИзмеренияТоваров(Строки) Экспорт
	
	Текст = 
	"ВЫБРАТЬ	
	|   *	
	|ПОМЕСТИТЬ ТоварыДокумента
	|ИЗ
	|   &Строки КАК ТоварыДокумента 
	|;
	|//////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка,
	|	ЕСТЬNULL(ШтрихкодыНоменклатуры.Упаковка.Числитель, 1) / ЕСТЬNULL(ШтрихкодыНоменклатуры.Упаковка.Знаменатель, 1) КАК Коэффициент
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Номенклатура В
	|				(ВЫБРАТЬ
	|					ТоварыДокумента.Товар
	|				ИЗ
	|					ТоварыДокумента КАК Таблица)
	|";
	
	Запрос = Новый Запрос(Текст);
	
	// Установка параметров.
	Запрос.УстановитьПараметр("Строки", Строки);
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции
