Функция ПолучитьДинамическиеПараметрыНоменклатуры(ПараметрыОтбора) Экспорт
		
	// ТУ_Мовчан 06.06.23 ++
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Номенклатура КАК Товар,
	|	Таблица.Характеристика КАК Характеристика,
	|	Таблица.Назначение КАК Партия,
	|	Таблица.Серия КАК Серия,
	|	НЕОПРЕДЕЛЕНО КАК УчетныйПараметр1,
	|	НЕОПРЕДЕЛЕНО КАК УчетныйПараметр2
	|ИЗ
	|	Справочник.КлючиАналитикиУчетаНоменклатуры КАК Таблица
	|ГДЕ
	|	Таблица.Номенклатура = &Товар
	| 	И &ДопОтбор 
	|
	|СГРУППИРОВАТЬ ПО
	|	Таблица.Номенклатура,
	|	Таблица.Характеристика,
	|	Таблица.Назначение,
	|	Таблица.Серия
	|
	|УПОРЯДОЧИТЬ ПО
	|	Таблица.Назначение УБЫВ";
	
	ДопОтбор = "";
	
	Для каждого Строка Из ПараметрыОтбора Цикл	
		Если Строка.Ключ <> "Товар" Тогда
			ДопОтбор = ДопОтбор + "
			|	И Таблица." + Строка.Ключ + " = &" + Строка.Ключ;
		КонецЕсли;
		
		Запрос.УстановитьПараметр(Строка.Ключ, Строка.Значение);
	КонецЦикла;     
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ДопОтбор", ДопОтбор);  
	// ТУ_Мовчан 06.06.23 --
	ТаблицаВозможных = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаВозможных;
	
КонецФункции

Функция ПолучитьСтатическиеПараметрыНоменклатуры() Экспорт

	ТаблицаВозможных = Новый ТаблицаЗначений;
	ТаблицаВозможных.Колонки.Добавить("Качество");
	
	ИндексКачествоТовара = 0;
	Пока ИндексКачествоТовара < Перечисления.вмс_КачествоТовара.Количество() Цикл
		Строка = ТаблицаВозможных.Добавить();
		Строка.Качество = Перечисления.вмс_КачествоТовара.Получить(ИндексКачествоТовара);
		ИндексКачествоТовара = ИндексКачествоТовара + 1;
	КонецЦикла;
	
	Возврат ТаблицаВозможных;

КонецФункции
