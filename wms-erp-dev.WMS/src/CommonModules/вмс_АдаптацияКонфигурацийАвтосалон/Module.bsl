Функция ПолучитьУпаковкиТоваров(Товары) Экспорт
	
	//Кулалаев 
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Товар,
	|	ЕдиницыИзмерения.Ссылка КАК Упаковка,
	|	ЕдиницыИзмерения.Коэффициент КАК Коэффициент,
	|	ЕдиницыИзмерения.Коэффициент = 1 КАК ЭтоБаза
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО (Номенклатура.Ссылка = ЕдиницыИзмерения.Владелец
	|				ИЛИ Номенклатура.ТипНоменклатуры = ЕдиницыИзмерения.Владелец)
	|ГДЕ
	|	Номенклатура.Ссылка В(&Товары)";
	
	// Установка параметров.
	Запрос.УстановитьПараметр("Товары", Товары);
	Возврат Запрос.Выполнить().Выгрузить();    
	
КонецФункции

// ТУ_Мовчан 04.08.23
Функция СоздатьИПолучитьУпаковкуТовара(Товар, Коэффициент) Экспорт    
		
	НаименованиеПолное = "" + Коэффициент + " шт";
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЕдиницыИзмерения.Ссылка КАК Упаковка
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|ГДЕ
	|	ЕдиницыИзмерения.Владелец = &Владелец
	|   И ЕдиницыИзмерения.Коэффициент = &Коэффициент
	|";     
	
	Если Товар.ТипНоменклатуры.ИспользованиеЕдиницИзмерения = 1 Тогда    
		Запрос.УстановитьПараметр("Владелец", Товар.ТипНоменклатуры);		 
	Иначе
		Запрос.УстановитьПараметр("Владелец", Товар);	
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.УстановитьПараметр("Коэффициент", Коэффициент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Упаковка = Выборка.Упаковка;
		Прервать;
	КонецЦикла;	
	
	Если Упаковка = Неопределено Тогда
	
		НовыйЭлемент = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
		НовыйЭлемент.Заполнить(Неопределено);
		Если Товар.ТипНоменклатуры.ИспользованиеЕдиницИзмерения = 1 Тогда 
			НовыйЭлемент.Владелец = Товар.ТипНоменклатуры;  
		Иначе 
			НовыйЭлемент.Владелец = Товар; 
		КонецЕсли;  
		НовыйЭлемент.ЕдиницаПоКлассификатору = Товар.БазоваяЕдиницаИзмерения;
		НовыйЭлемент.Коэффициент = Коэффициент;
		НовыйЭлемент.Наименование = НаименованиеПолное;
		
		НовыйЭлемент.Записать();
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Упаковка = Выборка.Упаковка;
			Прервать;
		КонецЦикла;  
		
	КонецЕсли;
	
	Возврат Упаковка;
	
КонецФункции



