Функция ПолучитьДокументыСНесколькимиТЧ() Экспорт
	РК = вмс_РаботаСКоллекциями;
	
	Результат = Новый Соответствие;
	Результат.Вставить("Документ.ЗаявкаНаВозвратТоваровОтКлиента", Новый Структура("Поступление, Выбытие", РК.СтрокуВМассив("ВозвращаемыеТовары"), РК.СтрокуВМассив("ЗаменяющиеТовары")));
