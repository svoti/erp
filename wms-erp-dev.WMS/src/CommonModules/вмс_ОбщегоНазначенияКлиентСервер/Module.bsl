Функция ПолучитьСтруктуруСтрокиСоединения() Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	СтрокаСоединенияИнформационнойБазы = СтрокаСоединенияИнформационнойБазы();

	МассивКлючЗначение = РК.СтрокуВМассив(СтрокаСоединенияИнформационнойБазы, ";");
	
	Кавычка = """";
	
	Структура = Новый Структура;
	
	Для Каждого КлючЗначение Из МассивКлючЗначение Цикл
		
		КлючЗначениеМассив = РК.СтрокуВМассив(КлючЗначение, "=");
		Если КлючЗначениеМассив.Количество()=2 Тогда
			
			Ключ = КлючЗначениеМассив[0];
			Если Лев(Ключ, 1)=Кавычка И Прав(Ключ, 1)=Кавычка Тогда
				Ключ = Сред(Ключ, 2, СтрДлина(Ключ)-2);
			КонецЕсли;
			
			Значение = КлючЗначениеМассив[1];
			Если Лев(Значение, 1)=Кавычка И Прав(Значение, 1)=Кавычка Тогда
				Значение = Сред(Значение, 2, СтрДлина(Значение)-2);
			КонецЕсли;
			
			Структура.Вставить(Ключ, Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

