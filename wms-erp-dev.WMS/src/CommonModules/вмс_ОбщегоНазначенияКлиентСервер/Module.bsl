Функция ЭтоИмяТипаПеречисления(ИмяТипа) Экспорт

	ИмяТипаМассив = вмс_РаботаСКоллекциями.СтрокуВМассив(ИмяТипа, ".");
	Если ИмяТипаМассив.Количество() = 2 Тогда
		Раздел = ИмяТипаМассив[0];
		Возврат Раздел = "EnumRef" ИЛИ Раздел = "Enum" ИЛИ Раздел = "ПеречислениеСсылка" ИЛИ Раздел = "Перечисление";
	КонецЕсли;

КонецФункции

Функция ПолучитьИмяМенеджераОбъектаПоИмениТипа(ИмяТипа) Экспорт

	ПозицияТочки = Найти(ИмяТипа, ".");
	Если ПозицияТочки = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Раздел = Лев(ИмяТипа, ПозицияТочки-1);
	Если Раздел = "Справочник" ИЛИ Раздел = "СправочникОбъект" Тогда
		Раздел = "Справочники";
	ИначеЕсли Раздел = "Документ" ИЛИ Раздел = "ДокументОбъект" Тогда
		Раздел = "Документы";
	ИначеЕсли Раздел = "Перечисление" Тогда
		Раздел = "Перечисления";
	ИначеЕсли Раздел = "ПланВидовХарактеристик" ИЛИ Раздел = "ПланВидовХарактеристикОбъект" Тогда
		Раздел = "ПланыВидовХарактеристик";
	ИначеЕсли Раздел = "Обработка" ИЛИ Раздел = "ОбработкаОбъект" Тогда
		Раздел = "Обработки";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	КраткоеИмяТипа = Прав(ИмяТипа, СтрДлина(ИмяТипа)-ПозицияТочки);
	
	ИмяМенеджера = Раздел + "." + КраткоеИмяТипа;
	Возврат ИмяМенеджера;
	
КонецФункции

Функция ПолучитьОписаниеМетода(ИмяОбработчика, ВозвращаетРезультат=Ложь, Параметр1=null, Параметр2=null, Параметр3=null, Параметр4=null, Параметр5=null) Экспорт
	
	ПараметрыВсе = Новый Массив;
	ПараметрыВсе.Добавить(Параметр1);
	ПараметрыВсе.Добавить(Параметр2);
	ПараметрыВсе.Добавить(Параметр3);
	ПараметрыВсе.Добавить(Параметр4);
	ПараметрыВсе.Добавить(Параметр5);
	
	КоличествоЗаполненныхПараметров = ПараметрыВсе.Количество();
	Пока КоличествоЗаполненныхПараметров > 0 Цикл
		Если ПараметрыВсе[КоличествоЗаполненныхПараметров-1] <> null Тогда
			Прервать;
		КонецЕсли;
		КоличествоЗаполненныхПараметров = КоличествоЗаполненныхПараметров - 1;
	КонецЦикла;
	
	Параметры = Новый Массив;
	Для НомерПараметра=1 По КоличествоЗаполненныхПараметров Цикл
		Параметры.Добавить(ПараметрыВсе[НомерПараметра-1]);
	КонецЦикла;
	
	ОписаниеМетода = Новый Структура;
	ОписаниеМетода.Вставить("Имя", ИмяОбработчика);
	ОписаниеМетода.Вставить("ИмяОбработчика", ИмяОбработчика);
	ОписаниеМетода.Вставить("ВозвращаетРезультат", ВозвращаетРезультат);
	ОписаниеМетода.Вставить("Параметры", Параметры);
	ОписаниеМетода.Вставить("ПредОбработка");
	ОписаниеМетода.Вставить("ПостОбработка");
	
	Возврат ОписаниеМетода;
	
КонецФункции

Функция ПолучитьСтрокуПараметровМетода(Параметры) Экспорт
	СтрокаПараметров = "";
	Если Параметры.Количество() > 0 Тогда
		Разделитель = ", ";
		НомерПараметра = Параметры.Количество();
		Пока НомерПараметра>0 Цикл
			Если Параметры[НомерПараметра-1] <> null Тогда
				Прервать;
			КонецЕсли;
			НомерПараметра = НомерПараметра - 1;
		КонецЦикла;
		КоличествоПараметров = НомерПараметра;
		
		Для НомерПараметра=1 По КоличествоПараметров Цикл
			ИндексПараметра = НомерПараметра-1;
			СтрокаПараметров = СтрокаПараметров + Разделитель;
			Если Параметры[ИндексПараметра] <> null Тогда
				ИндексПараметраСтрокой = Формат(ИндексПараметра, "ЧН=0; ЧГ=0");
				СтрокаПараметров = СтрокаПараметров + "Параметры[" + ИндексПараметраСтрокой + "]";
			КонецЕсли;
		КонецЦикла;
		СтрокаПараметров = Прав(СтрокаПараметров, СтрДлина(СтрокаПараметров)-СтрДлина(Разделитель));
	КонецЕсли;
	СтрокаПараметров = "(" + СтрокаПараметров + ")";
	Возврат СтрокаПараметров;
КонецФункции

