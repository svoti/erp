Функция ПолучитьДанныеТипаОбъекта(знач ТипОбъекта) Экспорт
	
	ДанныеТиповОбъектов = ПолучитьПараметрыПриложения()["ДанныеТиповОбъектов"];
	ДанныеТипаОбъекта = ДанныеТиповОбъектов[ТипОбъекта];
	Если ДанныеТипаОбъекта <> Неопределено Тогда
		// есть в кэше
		Возврат ДанныеТипаОбъекта;
	КонецЕсли;

	#Если Клиент И НЕ ТолстыйКлиентОбычноеПриложение И НЕ ТолстыйКлиентУправляемоеПриложение Тогда
		
		ДанныеТипаОбъекта = вмс_ОбщегоНазначенияВызовСервера.ПолучитьДанныеТипаОбъекта(ТипОбъекта);
		
	#Иначе
		
		ДанныеТипаОбъекта = вмс_ОбщегоНазначенияСервер.ПолучитьДанныеТипаОбъекта(ТипОбъекта);

	#КонецЕсли
	
	ИмяТипаОбъекта = ДанныеТипаОбъекта.Имя;
	Если ДанныеТипаОбъекта.ТипОбъекта=Неопределено Тогда
		Попытка
			ДанныеТипаОбъекта.ТипОбъекта = Тип(ИмяТипаОбъекта);
		Исключение
		КонецПопытки;
	КонецЕсли;

	ТипОбъекта = ДанныеТипаОбъекта.ТипОбъекта;
	
	МенеджерОбъектов = ДанныеТипаОбъекта.МенеджерОбъектов;
	Если МенеджерОбъектов=Неопределено Тогда
		МенеджерОбъектов = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьМенеджерОбъектов(ИмяТипаОбъекта);
		Если МенеджерОбъектов <> Неопределено Тогда
			Если вмс_РаботаСКоллекциями.ДоступенОбходКоллекции(МенеджерОбъектов) Тогда
				СоответствиеЗначенийПоИмени = ДанныеТипаОбъекта.СоответствиеЗначенийПоИмени;
				Если СериализаторXDTO_XMLТип(ТипОбъекта) <> Неопределено Тогда
					Для Каждого ЗначениеПеречисления Из МенеджерОбъектов Цикл
						ИмяЗначения = ВРЕГ(СериализаторXDTO_XMLСтрока(ЗначениеПеречисления));
						СоответствиеЗначенийПоИмени[ИмяЗначения] = ЗначениеПеречисления;
					КонецЦикла;
				Иначе
					Для Каждого ЗначениеПеречисления Из МенеджерОбъектов Цикл
						ИмяЗначения = ВРЕГ(Строка(ЗначениеПеречисления));
						СоответствиеЗначенийПоИмени[ИмяЗначения] = ЗначениеПеречисления;
					КонецЦикла;
				КонецЕсли;
				
