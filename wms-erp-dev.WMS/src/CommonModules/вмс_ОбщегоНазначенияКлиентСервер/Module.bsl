Функция ПреобразоватьЧислоВДругуюСистемуСчисления(знач Число, ИсходноеОснование=Неопределено, Основание) Экспорт
	
	Если Основание < 2 ИЛИ Основание > 16 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Цифры = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ПолучитьЦифрыШестнадцатиричнойСистемы();
	
	НовоеЧисло = "";
	
	Если ТипЗнч(Число) = Тип("Строка") Тогда
		ЧислоСтрокой = Число;
		Число = 0;
		ДлинаСтроки = СтрДлина(ЧислоСтрокой);
		МножительРазряда = 1;
		Для НомерСимвола=1 По ДлинаСтроки Цикл
			Цифра = Сред(ЧислоСтрокой, ДлинаСтроки-НомерСимвола+1, 1);
			ИндексЦифры = Цифры.Найти(Цифра);
			Число = Число + ИндексЦифры*МножительРазряда;
			МножительРазряда = МножительРазряда * ИсходноеОснование;
		КонецЦикла;
	КонецЕсли;
	
	Остаток = Число;
	Пока Остаток > 0 Цикл
		ИндексЦифры = Остаток % Основание;
		Цифра = Цифры[ИндексЦифры];
		НовоеЧисло = Цифра + НовоеЧисло;
		Остаток = Цел(Остаток / Основание);
	КонецЦикла;
	
	Возврат НовоеЧисло;
	
КонецФункции

