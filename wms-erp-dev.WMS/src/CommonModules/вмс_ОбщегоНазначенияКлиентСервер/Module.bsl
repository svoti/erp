Функция ПолучитьТекстИзДвоичныхДанных(ДвоичныеДанные) Экспорт
	ПотокВПамяти = Новый ПотокВПамяти;
	ЗаписьДанных = Новый ЗаписьДанных(ПотокВПамяти);
	ЗаписьДанных.Записать(ДвоичныеДанные);
	ЗаписьДанных.Закрыть();
	ПотокВПамяти.Перейти(0, ПозицияВПотоке.Начало);
	
	ЧтениеТекста = Новый ЧтениеТекста(ПотокВПамяти);
	ТекстДанных = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	ПотокВПамяти.Закрыть();
	
	Возврат ТекстДанных;
