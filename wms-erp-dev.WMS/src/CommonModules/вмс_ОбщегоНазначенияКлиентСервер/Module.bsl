Функция ПолучитьПараметрыПриложения() Экспорт
	
	Перем ПараметрыПриложения;
	
#Если Клиент И НЕ ТолстыйКлиентОбычноеПриложение И НЕ ТолстыйКлиентУправляемоеПриложение Тогда
		// Тут все просто
		// возьмем параметры из глобальной переменной
		ПараметрыПриложения = Вычислить("вмс_ПараметрыПриложения");
#Иначе
		
		// а вот на сервере есть только кэш
		Способ = 3;
		
		Если Способ=1 Тогда
			
			// берем из кэша хранилища
			ПараметрыПриложения = ПолучитьИзВременногоХранилища(ПараметрыСеанса.вмс_АдресХранилищаПараметровПриложения);
			Сериализация = Ложь;
			Если ПараметрыПриложения <> Неопределено Тогда
				Сериализация = ПараметрыПриложения["ДанныеДляОтладки"].Ссылка1 <> ПараметрыПриложения["ДанныеДляОтладки"].Ссылка2;
				Если Сериализация Тогда
					ПараметрыПриложения = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
			Если ПараметрыПриложения=Неопределено Тогда
				ПараметрыПриложения = НовыеПараметрыПриложения();
				ПоместитьВоВременноеХранилище(ПараметрыПриложения, ПараметрыСеанса.вмс_АдресХранилищаПараметровПриложения);
			КонецЕсли;
			
			ДанныеДляОтладки = ПараметрыПриложения["ДанныеДляОтладки"];
			
			Если Сериализация Тогда
				ДанныеДляОтладки.ПотерялиКэш = Истина;
				ДанныеДляОтладки.ПричинаПотериКэша = "Сериализация";
			КонецЕсли;
			
			ДанныеДляОтладки.ЭтоНовые = Ложь;
			
		ИначеЕсли Способ=2 Тогда
			// обернем кэшем модуля значений повторного использования
			ПараметрыПриложения = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ПолучитьПараметрыПриложения(0);
			ДанныеДляОтладки = ПараметрыПриложения["ДанныеДляОтладки"];
			ДанныеДляОтладки.ЭтоНовые = Ложь;
		Иначе
			НомерКэширования = ПараметрыСеанса.вмс_НомерКэшированияПараметровПриложения;
			Если НомерКэширования=0 Тогда
				// нулевой пациент
				ПараметрыСеанса.вмс_НомерКэшированияПараметровПриложения = 1;
				ПараметрыПриложения = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ПолучитьПараметрыПриложения(1);
				ДанныеДляОтладки = ПараметрыПриложения["ДанныеДляОтладки"];
				ДанныеДляОтладки.ЭтоНовые = Ложь;
			Иначе
				ПараметрыПриложенияПредыдущие = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ПолучитьПараметрыПриложения(НомерКэширования);
				ДанныеДляОтладки = ПараметрыПриложенияПредыдущие["ДанныеДляОтладки"];
				Если ДанныеДляОтладки.ЭтоНовые Тогда
					// Все таки произошел обвал цепочки кэша
					// не успели перекинуть с одной руки в другую
					// сбросим номер кэширования и данные в хранилище и начнем все сначала :((
					ПоместитьВоВременноеХранилище(Неопределено, ПараметрыСеанса.вмс_АдресХранилищаПараметровПриложения);
					ОбновитьПовторноИспользуемыеЗначения();
					ПараметрыСеанса.вмс_НомерКэшированияПараметровПриложения = 1;
					ПараметрыПриложения = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ПолучитьПараметрыПриложения(1);
					ПараметрыПриложения["ДанныеДляОтладки"] = ДанныеДляОтладки;
					Если НЕ ДанныеДляОтладки.ПотерялиКэш Тогда
						ДанныеДляОтладки.ПотерялиКэш = Истина;
						ДанныеДляОтладки.ПричинаПотериКэша = "СбросКэшаМодуляПовтИсп";
					КонецЕсли;
					ДанныеДляОтладки.ЭтоНовые = Ложь;
				Иначе
					Если ТекущаяДата() - ДанныеДляОтладки.ДатаКэширования > 60 Тогда
						// Старый кэш скоро подохнет
						// пересядем на новый пока не поздно
						ПараметрыПриложения = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ПолучитьПараметрыПриложения(НомерКэширования+1);
						ПараметрыСеанса.вмс_НомерКэшированияПараметровПриложения = НомерКэширования+1;
					Иначе
						// попользуемся пока старым кэшем
						ПараметрыПриложения = ПараметрыПриложенияПредыдущие;
						
						// подкрепим также кэшем хранилища
						ПоместитьВоВременноеХранилище(ПараметрыПриложения, ПараметрыСеанса.вмс_АдресХранилищаПараметровПриложения);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

#КонецЕсли
	
	Возврат ПараметрыПриложения;
	
КонецФункции

