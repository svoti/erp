Функция ДанныеCOMИзДвоичныхДанных(ДвоичныеДанные) Экспорт
	КоличествоБайт = ДвоичныеДанные.Размер();
	БуфферДвоичныхДанных = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанные);
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить("VT_UI1");
	ПараметрыКонструктора.Добавить(КоличествоБайт);
	ДанныеCOM = Новый("COMSafeArray", ПараметрыКонструктора);
	Для НомерБайта=0 По КоличествоБайт-1 Цикл
		ДанныеCOM.SetValue(НомерБайта, БуфферДвоичныхДанных.Получить(НомерБайта));
	КонецЦикла;
	Возврат ДанныеCOM;
КонецФункции

Функция ПолучитьИмяПользователяОС() Экспорт
	
	Возврат ПолучитьИмяСистемнойПеременной("USERNAME");
	
КонецФункции

Функция ПолучитьИмяСистемнойПеременной(ИмяПеременной) Экспорт
	
	WshShell		= Новый COMОбъект("WScript.Shell"); 
    ИмяПользователя	= WshShell.ExpandEnvironmentStrings("%" + ИмяПеременной + "%");
	
	Возврат ИмяПользователя;
	
КонецФункции

Функция РазобратьПутьФайла(знач Путь) Экспорт
	
	ДлинаПути = СтрДлина(Путь);
	
	ПозицияИмени = СтрНайти(Путь, "\", НаправлениеПоиска.СКонца);

	ПозицияРасширения = СтрНайти(Путь, ".", НаправлениеПоиска.СКонца);
	Если ПозицияРасширения=0 Тогда
		ПозицияРасширения = ДлинаПути + 1;
	КонецЕсли;

	Разбор = Новый Структура;
	Разбор.Вставить("Путь",	Путь);
	Разбор.Вставить("Каталог", Лев(Путь, ПозицияИмени));
	Разбор.Вставить("Имя", Прав(Путь, ДлинаПути-ПозицияИмени));
	Разбор.Вставить("ИмяБезРасширения", Сред(Путь, ПозицияИмени+1, ПозицияРасширения-ПозицияИмени-1));
	Разбор.Вставить("Расширение", Прав(Путь, ДлинаПути-ПозицияРасширения));
	
	Возврат Разбор;
	
КонецФункции

Функция Пауза(Секунды) Экспорт
	
	ИмяПриложения = "TimeOut /T " + Формат(Секунды, "ЧГ=0");
	ЗапуститьПриложениеУлучшенный(ИмяПриложения, 0, Истина);
	
КонецФункции

Функция ЗапуститьПриложениеУлучшенный(знач ИмяПриложения, ТекущийКаталог="", ДождатьсяЗавершения=Ложь, ПолучитьВывод=Ложь, СостояниеОкна=1) Экспорт
	
	Кавычка = """";
	
	ИмяПриложения = СокрЛП(ИмяПриложения);
	Если ПолучитьВывод Тогда
		Если СтрНайти(ИмяПриложения, Кавычка)=0 Тогда
			ИмяПриложения = Кавычка + ИмяПриложения + Кавычка;
		КонецЕсли;
	КонецЕсли;
	
	Скрипт = ИмяПриложения;
	
	Если ПолучитьВывод Тогда
		ПутьКФайлуЛогов = ПолучитьИмяВременногоФайлаУлучшенная("txt");
		Скрипт = Скрипт + " > " + Кавычка + ПутьКФайлуЛогов + Кавычка;
	КонецЕсли;
	
	Скрипт = Кавычка + Скрипт + Кавычка;
	
	Команда = Скрипт;
	//Команда = """%COMSPEC%"" /c " + Команда;
	Команда = "cmd /c " + Команда;

	НативныйМетод = Истина;
	Если НативныйМетод Тогда
		
        КодВозврата = Неопределено;
		ЗапуститьПриложение(Команда, ТекущийКаталог, ДождатьсяЗавершения, КодВозврата);
		
	Иначе
		
		Сервер = Новый ComОбъект("WScript.Shell");
		
		Если ЗначениеЗаполнено(ТекущийКаталог) Тогда
			Сервер.CurrentDirectory = ТекущийКаталог;
		КонецЕсли;

		КодВозврата = Сервер.Run(Команда, СостояниеОкна, ДождатьсяЗавершения);
		
	КонецЕсли;

	Если ПолучитьВывод Тогда
		ФайлЛогов = Новый Файл(ПутьКФайлуЛогов);
		Если ФайлЛогов.Существует() Тогда
			ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлуЛогов);
			Вывод = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.OEM);
			УдалитьФайлы(ПутьКФайлуЛогов);
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КодВозврата", КодВозврата);
	Результат.Вставить("Вывод", Вывод);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИмяВременногоФайлаУлучшенная(Расширение) Экспорт
	
	#Если ВебКлиент Тогда
		Каталог = КаталогВременныхФайлов();
		ИмяФайла = Каталог + Новый УникальныйИдентификатор() + "." + Расширение;
	#Иначе
		ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	#КонецЕсли
	
	Возврат ИмяФайла;
	
КонецФункции
