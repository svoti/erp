Функция НачатьЗамерВремени() Экспорт
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Возврат ВремяНачала;
	
КонецФункции

Функция ЗакончитьЗамерВремени(ВремяНачала, Заголовок=Неопределено, Текст=Неопределено, Сообщить=Истина) Экспорт
	
	Время = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	
	ПоляЧастей = "Мера, Представление, Значение";
	
	ЧастиВремени = Новый Массив;
	ЧастиВремени.Добавить(Новый Структура(ПоляЧастей, 1, "мс"));
	ЧастиВремени.Добавить(Новый Структура(ПоляЧастей, 1000, "с"));
	ЧастиВремени.Добавить(Новый Структура(ПоляЧастей, 60, "м"));
	ЧастиВремени.Добавить(Новый Структура(ПоляЧастей, 60, "ч"));
	ЧастиВремени.Добавить(Новый Структура(ПоляЧастей, 24, "д"));
	
	ВремяОстаток = Время;
	Для НомерЧасти=0 По ЧастиВремени.Количество()-1-1 Цикл
		Мера = ЧастиВремени[НомерЧасти+1].Мера;
		ЧастиВремени[НомерЧасти].Значение = ВремяОстаток % Мера;
		ВремяОстаток = Цел(ВремяОстаток / Мера);
	КонецЦикла;
	
	ЧастиВремени[ЧастиВремени.ВГраница()].Значение = ВремяОстаток;
	
	Текст = "";
	Показывать = Ложь;
	Для НомерЧасти=0 По ЧастиВремени.ВГраница() Цикл
		
		ЧастьВремени = ЧастиВремени[ЧастиВремени.ВГраница()-НомерЧасти];
		
		Если Не Показывать Тогда
			Если ЧастьВремени.Значение <> 0 ИЛИ НомерЧасти=ЧастиВремени.ВГраница() Тогда
				Показывать = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если Показывать Тогда
			Текст = Текст + ?(ЗначениеЗаполнено(Текст), " ", "");
			Текст = Текст + ЧастьВремени.Значение + " " + ЧастьВремени.Представление;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Сообщить Тогда
		Если Заголовок <> Неопределено Тогда
			Сообщить(Заголовок);
		КонецЕсли;
		Сообщить(Текст);
	КонецЕсли;
	
	Возврат Время;
	
КонецФункции

