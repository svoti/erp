Функция НовыйСочетаниеКлавиш(Клавиша, Alt=Ложь, Control=Ложь, Shift=Ложь) Экспорт
	
	Если ТипЗнч(Клавиша) = Тип("Клавиша") Тогда
		Возврат Новый СочетаниеКлавиш(Клавиша, Alt, Control, Shift);
	КонецЕсли;
	
	Если ТипЗнч(Клавиша) = Тип("Число") Тогда
		КодСимвола = Формат(Клавиша, "ЧН=0; ЧГ=0");
	Иначе
		КодСимвола = КодСимвола(Клавиша);
	КонецЕсли;
	
	Строка =
	"{""#"",69cf4251-8759-11d5-bf7e-0050bae2bc79,1,
	|{0,%КодСимвола%,%Модификаторы%}
	|}";
	
	Модификаторы = Строка(?(Alt, 16, 0) + ?(Control, 8, 0) + ?(Shift, 4, 0));
	
	Строка = СтрЗаменить(Строка, "%КодСимвола%", КодСимвола);
	Строка = СтрЗаменить(Строка, "%Модификаторы%", Модификаторы);
	
	СочетаниеКлавиш = вмс_ОбщегоНазначенияВызовСервера.ЗначениеИзСтрокиВнутр_(Строка);
	
	Возврат СочетаниеКлавиш;
	
КонецФункции

Функция НовыйОписаниеОповещения(ИмяПроцедуры, Модуль, ДополнительныеПараметры=Неопределено, ИмяПроцедурыОбработкиОшибки=Неопределено, МодульОбработкиОшибки=Неопределено) Экспорт
	
	ОписаниеОповещения = Новый Структура;
	ОписаниеОповещения.Вставить("ИмяПроцедуры", ИмяПроцедуры);
	ОписаниеОповещения.Вставить("Модуль", Модуль);
	ОписаниеОповещения.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	ОписаниеОповещения.Вставить("ИмяПроцедурыОбработкиОшибки", ИмяПроцедурыОбработкиОшибки);
	ОписаниеОповещения.Вставить("МодульОбработкиОшибки", МодульОбработкиОшибки);
	ОписаниеОповещения.Вставить("ИмяМодуля", ПолучитьИмяОбъекта(Модуль));
	
	Возврат ОписаниеОповещения;
	
КонецФункции

Функция ПолучитьИмяОбъекта(Объект) Экспорт
	
	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта <> Тип("Строка") Тогда
		ИмяМодуля = Строка(Объект);
		Если СтрНайти(ИмяМодуля, "ВнешняяОбработкаОбъект.")=1 Тогда
			ИмяМодуля = СтрЗаменить(ИмяМодуля, "ВнешняяОбработкаОбъект.", "ВнешняяОбработка.");
			Возврат ИмяМодуля;
		КонецЕсли;
	КонецЕсли;
	
	ИмяМодуля = ПолучитьИмяТипаОбъекта(ТипОбъекта);
	
	Возврат ИмяМодуля;
	
КонецФункции

