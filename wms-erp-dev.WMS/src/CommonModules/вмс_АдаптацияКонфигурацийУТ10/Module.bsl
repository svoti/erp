Функция ПривязатьФотографиюКНоменклатуре(Номенклатура, ХранилищеФайла) Экспорт
	ДвоичныеДанные = ХранилищеФайла.Получить();
	ВыбранноеИзображение = Новый Картинка(ДвоичныеДанные);
	
	Изображение = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();
	Изображение.Заполнить(Неопределено);
	Изображение.ВидДанных = Перечисления.ВидыДополнительнойИнформацииОбъектов.Изображение;
	Изображение.Хранилище = Новый ХранилищеЗначения(ВыбранноеИзображение, Новый СжатиеДанных(0));
	Изображение.Объект = Номенклатура;
	Изображение.ИмяФайла = Номенклатура.Наименование;
	Изображение.Записать();
	
	НачатьТранзакцию();
	Попытка
		обНоменклатура = Номенклатура.ПолучитьОбъект();
		обНоменклатура.ОсновноеИзображение = Изображение.Ссылка; 
		обНоменклатура.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки; 
	
	Возврат Истина;
КонецФункции	
