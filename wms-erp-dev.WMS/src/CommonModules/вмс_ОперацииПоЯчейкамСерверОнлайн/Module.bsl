Функция ЗавершитьОперациюПоДокументу(ПараметрыОперации, ЗонаОтгрузки) Экспорт
	ВидОперации = ПараметрыОперации.ВидОперации;
	Ответственный = ПараметрыОперации.Ответственный;
	ДокументОснование = ПараметрыОперации.ДокументОснование;
	
	ПараметрыОперации = Новый Структура("ДокументОснование, ВидОперации", ДокументОснование, ВидОперации);
	ПеренестиОтобранныеТоварыВЗонуОтгрузки(ПараметрыОперации, Ответственный, ЗонаОтгрузки);
	вмс_ОперацииПоЯчейкамВызовСервера.ЗавершитьОперациюПоДокументу(ДокументОснование, ВидОперации, Ответственный);
	
КонецФункции

// Перенос из ячейки ответственного хранения в зону отгрузки
Функция ПеренестиОтобранныеТоварыВЗонуОтгрузки(ПараметрыОперации, Ответственный, ЗонаОтгрузки)
	
	РК = вмс_РаботаСКоллекциями;
	
	ТоварныеПоля = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля(Истина);
	ТоварыФакт = ПолучитьФактОтбора(ПараметрыОперации, ТоварныеПоля, Ложь, Ложь, Ложь);
	ТаблицаОперации = ТоварыФакт.Скопировать();
	ТаблицаОперации.Свернуть("Ссылка");
	
	Для Каждого СтрокаОперации Из ТаблицаОперации Цикл
		ДокументОперации = СтрокаОперации.Ссылка.ПолучитьОбъект();
		
		Для Каждого СтрокаДокумента Из ДокументОперации.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаДокумента.ЯчейкаПриемник) Тогда
				СтрокаДокумента.ЯчейкаПриемник = ЗонаОтгрузки;
			КонецЕсли;
		КонецЦикла;
		
		ДокументОперации.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
	
	Функция ПеренестиОтобранныеТоварыВЗонуОтгрузки1(ПараметрыОперации, Ответственный, ЗонаОтгрузки)
		
		РК = вмс_РаботаСКоллекциями;
		
		ТоварныеПоля = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля(Истина);
		ТекстЗапроса = ПолучитьФактОтбора(Неопределено, ТоварныеПоля, Ложь, Ложь, Истина);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "вмс_ОперацияПоЯчейкамТовары.Ячейка", "вмс_ОперацияПоЯчейкамТовары.ЯчейкаПриемник");
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ДокументОснование", ПараметрыОперации.ДокументОснование);
		Запрос.УстановитьПараметр("ВидОперации", ПараметрыОперации.ВидОперации);
		ТоварыФакт = Запрос.Выполнить().Выгрузить();
		
		// удалить строки, которые уже на зоне отгрузки
		РК.УдалитьЭлементыКоллекции(ТоварыФакт, ТоварыФакт.НайтиСтроки(Новый Структура("Ячейка", ЗонаОтгрузки)));
		Если ТоварыФакт.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ПустаяЯчейка = ПредопределенноеЗначение("Справочник.вмс_МестаХранения.ПустаяСсылка");
		
		ДокументПеренос = Документы.вмс_ОперацияПоЯчейкам.СоздатьДокумент();
		ДокументПеренос.Дата = ТекущаяДата();
		ДокументПеренос.Заполнить(Неопределено);
		ДокументПеренос.Комментарий = "#Перенос в зону отгрузки#";
		ЗаполнитьЗначенияСвойств(ДокументПеренос, ПараметрыОперации);
		ДокументПеренос.Ответственный = Ответственный;
		
		Для Каждого СтрокаФакт Из ТоварыФакт Цикл
			СтрокаДокумента = ДокументПеренос.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаФакт);
			
			СтрокаДокумента = ДокументПеренос.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаФакт);
			СтрокаДокумента.Ячейка = ПустаяЯчейка;
			СтрокаДокумента.ЯчейкаПриемник = ЗонаОтгрузки;
		КонецЦикла;
		
		ДокументПеренос.Записать(РежимЗаписиДокумента.Проведение);
		
		Возврат Истина;
		
	КонецФункции

Функция ПолучитьЗапросПланаИзСКД(СхемаКомпоновкиДанных, ДокументОснование)
	
	НастройкиКомпоновки = СхемаКомпоновкиДанных.ВариантыНастроек.Основной.Настройки;	
	Для Каждого Поле Из СхемаКомпоновкиДанных.НаборыДанных[0].Поля Цикл
		Если НЕ ТипЗнч(Поле)=Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Поле.Роль.Обязательное = Истина;
	КонецЦикла;
	РаботаССКД.ДобавитьОтбор(НастройкиКомпоновки.Отбор.Элементы, "Ссылка", ДокументОснование, ВидСравненияКомпоновкиДанных.Равно); 
	
	КомпоновщикМакетаКомпоновкиДанных = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакетаКомпоновкиДанных.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки);
	
	Запрос = Новый Запрос(Макет.НаборыДанных[0].Запрос);
	Для Каждого ЗначениеПараметра Из Макет.ЗначенияПараметров Цикл
		Запрос.УстановитьПараметр(ЗначениеПараметра.Имя, ЗначениеПараметра.Значение);
	КонецЦикла;
	
	Возврат Запрос;

КонецФункции

