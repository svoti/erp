Функция ПолучитьОперациюСеанса(ИдентификаторОперации, ВернутьОбъект = Истина) Экспорт 
	Если ВернутьОбъект Тогда
		Возврат Документы.вмс_ОперацияПоЯчейкам.ПолучитьСсылку(ИдентификаторОперации).ПолучитьОбъект();
	Иначе
		Возврат Документы.вмс_ОперацияПоЯчейкам.ПолучитьСсылку(ИдентификаторОперации);
	КонецЕсли;
КонецФункции

Функция СоздатьНовуюОперацию(ПараметрыОперации) Экспорт
	Результат = Новый Структура("Успех, ИдентификаторОперации, Сообщение", Ложь, Неопределено, "");
	
	ВидОперации = ПараметрыОперации.ВидОперации;
	Ответственный = ПараметрыОперации.Ответственный;
	ДокументОснование = ПараметрыОперации.ДокументОснование;
	ИдентификаторОперации = ПараметрыОперации.ИдентификаторОперации;
	
	РаспоряжениеНеЗавершено = вмс_ОперацииПоЯчейкамВызовСервера.УстановитьСтатусСПроверкой(ДокументОснование, ВидОперации, Ответственный);
	
	Если РаспоряжениеНеЗавершено Тогда
		НоваяОперацияПоЯчейкам = Документы.вмс_ОперацияПоЯчейкам.СоздатьДокумент();
		НоваяОперацияПоЯчейкам.Заполнить(Неопределено);
		
		НоваяОперацияПоЯчейкам.ДокументОснование   = ДокументОснование;
		НоваяОперацияПоЯчейкам.ВидОперации		   = ВидОперации;
		НоваяОперацияПоЯчейкам.Ответственный	   = Ответственный;
		НоваяОперацияПоЯчейкам.Дата				   = ТекущаяДата();
		НоваяОперацияПоЯчейкам.ВремяНачалаОперации = ТекущаяДата();
		
		НоваяОперацияПоЯчейкам.Записать(РежимЗаписиДокумента.Проведение);
		
		Результат.ИдентификаторОперации = НоваяОперацияПоЯчейкам.Ссылка.УникальныйИдентификатор();
		Результат.Успех = Истина;
	Иначе
		Результат.Сообещние = "Операция по распоряжению уже завершена";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции        

Функция ОбновитьОперациюОтбор(ИдентификаторОперации, КоличествоОтбора, Действие, ДанныеПолей, ДопНастройки) Экспорт
	Результат = Новый Структура("Успех, Сообщение, КоличествоФакт, КоличествоОстаток, КоличествоПланОбщее", Ложь, "", 0, 0, 0);
	
	СерииИзПлана			   = ДопНастройки.СерииИзПлана;
	ОтобратьКонтейнерПолностью = ДопНастройки.ОтобратьКонтейнерПолностью;
	
	ПустаяЯчейка = Справочники.вмс_МестаХранения.ПустаяСсылка();
	ПустойКонтейнер = Справочники.вмс_Контейнеры.ПустаяСсылка();
	
	Операция = ПолучитьОперациюСеанса(ИдентификаторОперации, Истина);
	ДокументОснование = Операция.ДокументОснование;
	ВидОперации = Операция.ВидОперации;
	
	ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля(Истина);
	
	ОтборИзКонтейнера = ДанныеПолей.Свойство("КонтейнерОтправитель") И ДанныеПолей.КонтейнерОтправитель <> ПустойКонтейнер;
	ОтборВКонтейнер = ДопНастройки.ОтборВКонтейнер;
	
	Если НЕ ДанныеПолей.Свойство("КонтейнерОтправитель") Тогда
		ДанныеПолей.Вставить("КонтейнерОтправитель", ПустойКонтейнер);
	КонецЕсли;
	
	Если НЕ ДанныеПолей.Свойство("КонтейнерПриемник") Тогда
		ДанныеПолей.Вставить("КонтейнерПриемник", ПустойКонтейнер);
	КонецЕсли;
	
	Если НЕ ОтобратьКонтейнерПолностью Тогда
		// Поиск строки отбора и установка количества к отбору (на случай если вид операции "=")
		НайденныеСтроки = Операция.Товары.НайтиСтроки(ДанныеПолей);
		Если НайденныеСтроки.Количество() = 0 Тогда
			СтрокаОперации = Операция.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОперации, ДанныеПолей);
		Иначе
			СтрокаОперации = НайденныеСтроки[0];         
		КонецЕсли;
		
		Если Действие = "+" Тогда
			КоличествоОтбора = КоличествоОтбора;
		ИначеЕсли Действие = "=" Тогда
			КоличествоОтбора = КоличествоОтбора - СтрокаОперации.Количество;
		Иначе
			Результат.Сообщение = Результат.Сообщение + "Неизвестный тип действия: " + Действие + Символы.ПС;
			Возврат Результат;
		КонецЕсли;
		//
	КонецЕсли;
	
	ПроверкаОстатков = МожноПровестиОтбор(ДокументОснование, ВидОперации, ТоварныеПоляМассив, ОтборИзКонтейнера, ОтборВКонтейнер, ОтобратьКонтейнерПолностью,
	СерииИзПлана, ДанныеПолей, КоличествоОтбора);
	
	Если Не ПроверкаОстатков.Успех Тогда
		Возврат ПроверкаОстатков; //При неудаче, в мобилке не обновляются данные, требуемые поля: Сообщение и Успех, которые тут есть, можно возвращать напрямую
	КонецЕсли;
	
	Если ОтобратьКонтейнерПолностью Тогда
		//
		Для Каждого СтрокаКонтейнера Из ПроверкаОстатков.СоставКонтейнера Цикл
			ЗаполнитьЗначенияСвойств(ДанныеПолей, СтрокаКонтейнера);
			ДанныеПолей.КонтейнерОтправитель = СтрокаКонтейнера.Контейнер;
			
			НайденныеСтроки = Операция.Товары.НайтиСтроки(ДанныеПолей);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокаОперации = Операция.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаОперации, ДанныеПолей);
				СтрокаОперации.Количество = СтрокаКонтейнера.КоличествоОстаток;
			Иначе
				СтрокаОперации = НайденныеСтроки[0];
				СтрокаОперации.Количество = СтрокаОперации.Количество + СтрокаКонтейнера.КоличествоОстаток;
			КонецЕсли;
		КонецЦикла;
		
		Результат.Сообщение = "Содержимое контейнера " + Строка(ДанныеПолей.КонтейнерОтправитель) + " отобрано полностью.";
		//
	Иначе
		//
		СтрокаОперации.Количество = СтрокаОперации.Количество + КоличествоОтбора;
		
		Результат.КоличествоФакт = СтрокаОперации.Количество;
		Результат.КоличествоОстаток = ПроверкаОстатков.КоличествоОстаток - КоличествоОтбора;
		Результат.КоличествоПланОбщее = ПроверкаОстатков.КоличествоПланОбщее - КоличествоОтбора;
		
		Если СтрокаОперации.Количество < 0 Тогда
			Результат.Сообщение = Результат.Сообщение + "При выполнении запрошенной операции не хватает остатка: " + Строка(СтрокаОперации.Количество) + Символы.ПС +
			"Обратитесь к разработчику." + Символы.ПС;
			Возврат Результат;
		ИначеЕсли СтрокаОперации.Количество = 0 Тогда
			Операция.Товары.Удалить(СтрокаОперации);
		КонецЕсли;
		//
	КонецЕсли;
	
	Операция.ВремяОкончанияОперации = ТекущаяДата();
	Операция.Записать(РежимЗаписиДокумента.Проведение);
	
	Результат.Успех = Истина;
	Возврат Результат;
КонецФункции

Функция МожноПровестиОтбор(ДокументОснование, ВидОперации, ТоварныеПоляМассив, ОтборИзКонтейнера, ОтборВКонтейнер, ОтобратьКонтейнерПолностью,
	СерииИзПлана, ДанныеПолей, Количество)
	Результат = Новый Структура("Успех, Сообщение, КоличествоОстаток, КоличествоПланОбщее, СоставКонтейнера", Ложь, "", 0, 0, Неопределено);
	
	// Предполагается что результат запроса совместим с товарными полями (иначе он бы не работал изначально)
	// !!!ВНИМАНИЕ!!!: не все параметры и фичи которые учтены в СКД/функции получения плана реализованы тут, возможно надо
	// будет добавить по мере необходимости Желательно сделать регистр исполнения плана, чтобы было легче искать остаки
	// плана, и не надо было делать вот это, что в коде далее, каждый раз Тогда можно будет обойтись двумя финальными
	// запросами, что существенно упростит отладку и доработку, и всегда будет соответствие расчетного плана фактическому
	
	ПервоеУсловие = Истина;
	ВыборОстатки = "";
	ВыборПланФакт = "";
	ГруппаПланФакт = "";
	ФильтрПланФактСумм = "";
	ФильтрОстатки = "";
	Для Каждого ИмяПоля Из ТоварныеПоляМассив Цикл
		ВыборОстатки = ВыборОстатки + Символы.Таб + "вмс_ОперацияПоЯчейкамОстатки." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
		
		Если ПервоеУсловие Тогда
			ФильтрОстатки = ФильтрОстатки + Символы.Таб + Символы.Таб +		   ИмяПоля + " = &" + ИмяПоля + Символы.ПС;
		Иначе
			ФильтрОстатки = ФильтрОстатки + Символы.Таб + Символы.Таб + "И " + ИмяПоля + " = &" + ИмяПоля + Символы.ПС;
		КонецЕсли;
		
		Если ИмяПоля <> "Серия" ИЛИ СерииИзПлана Тогда
			ВыборПланФакт  = ВыборПланФакт +  Символы.Таб + "&t." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
			ГруппаПланФакт = ГруппаПланФакт + Символы.Таб +			ИмяПоля +					  "," + Символы.ПС;
			Если ПервоеУсловие Тогда
				ФильтрПланФактСумм = ФильтрПланФактСумм + Символы.Таб +   "ПланФактСумм." + ИмяПоля + " = &" + ИмяПоля + Символы.ПС;
			Иначе
				ФильтрПланФактСумм = ФильтрПланФактСумм + Символы.Таб + "И ПланФактСумм." + ИмяПоля + " = &" + ИмяПоля + Символы.ПС;
			КонецЕсли;
		КонецЕсли;
		
		Если ПервоеУсловие Тогда
			ПервоеУсловие = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если ОтборИзКонтейнера Тогда
		ВыборОстатки = ВыборОстатки + Символы.Таб + "вмс_ОперацияПоЯчейкамОстатки.Контейнер КАК Контейнер," + Символы.ПС;
		ФильтрОстатки = ФильтрОстатки + Символы.Таб + Символы.Таб + "И Контейнер = &КонтейнерОтправитель" + Символы.ПС;
	КонецЕсли;
	
	Если ОтобратьКонтейнерПолностью Тогда
		ФильтрОстатки = Символы.Таб + Символы.Таб + "Контейнер = &КонтейнерОтправитель" + Символы.ПС;
		ФильтрПланФактСумм = Символы.Таб + "ИСТИНА" + Символы.ПС;
	Иначе
		ФильтрОстатки = ФильтрОстатки + Символы.Таб + Символы.Таб + "И Ячейка = &Ячейка" + Символы.ПС;
	КонецЕсли;
	
	ГруппаПланФакт = Лев(ГруппаПланФакт, СтрДлина(ГруппаПланФакт) - 2);
	
	РаспоряжениеОбъект = Справочники.вмс_РаспоряженияОпераций.НайтиТипРаспоряженияДляДокумента(ДокументОснование, ВидОперации).ПолучитьОбъект();
	РаспоряжениеОбъект.Прочитать();
	
	// ТУ_КС:
	// Более корректное получение текста запроса
	// Обнаруженная проблема старого алгоритма: не учтено, что первый пакет может содержать несколько запросов через "ОБЪЕДИНИТЬ",
	// в таком случае отбор наложится только на последний запрос
	Запрос = ПолучитьЗапросПланаИзСКД(РаспоряжениеОбъект.ХранилищеСКДТовары.Получить(), ДокументОснование);
	
	ИсходныйЗапросПлана = Запрос.Текст;
	
	Граница1План = СтрНайти(ИсходныйЗапросПлана, "ИЗ", НаправлениеПоиска.СКонца,, 1);
	
	НовыйЗапросПлана = 
	Сред(ИсходныйЗапросПлана, 1, Граница1План - 1) +
	"ПОМЕСТИТЬ ТаблицаПлан" + "
	|" +
	Сред(ИсходныйЗапросПлана, Граница1План) + "
	|;";
	
	//ИсходныйЗапросПлана = РаспоряжениеОбъект.ХранилищеСКДТовары.Получить().НаборыДанных.НаборДанных1.Запрос;
	//Граница1План = СтрНайти(ИсходныйЗапросПлана, ";",,,1);
	//Граница2План = СтрНайти(ИсходныйЗапросПлана, "ИЗ", НаправлениеПоиска.СКонца,, 1);
	//
	//НовыйЗапросПлана = 
	//Сред(ИсходныйЗапросПлана, 1, Граница1План - 1) + "
	//|ГДЕ
	//|	ТаблицаТоваров.Ссылка = &ДокументОснование
	//|	И ТаблицаТоваров.Ссылка.Проведен
	//|" + 
	//Сред(ИсходныйЗапросПлана, Граница1План, Граница2План - Граница1План) + "
	//|ПОМЕСТИТЬ
	//|	ТаблицаПлан
	//|" +
	//Сред(ИсходныйЗапросПлана, Граница2План) + "
	//|;";
	
	ИсходныйЗапросФакта = ПолучитьФактОтбора(Неопределено, ТоварныеПоляМассив, ОтборИзКонтейнера, ОтборВКонтейнер, Истина);
	
	Граница1Факт = СтрНайти(ИсходныйЗапросФакта, "ИЗ", НаправлениеПоиска.СКонца,, 1);
	
	НовыйЗапросФакта = 
	Сред(ИсходныйЗапросФакта, 1, Граница1Факт-1) + "
	|ПОМЕСТИТЬ
	|	ТаблицаФакт
	|" +
	Сред(ИсходныйЗапросФакта, Граница1Факт) + "
	|;";
	
	НовыйЗапросФинал = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(ВыборПланФакт, "&t", "ТаблицаПлан") +
	"	ТаблицаПлан.Количество КАК Количество
	|ПОМЕСТИТЬ ПланФакт
	|ИЗ
	|	ТаблицаПлан КАК ТаблицаПлан
	
	|ОБЪЕДИНИТЬ ВСЕ
	
	|ВЫБРАТЬ
	|" + СтрЗаменить(ВыборПланФакт, "&t", "ТаблицаФакт") +
	"	-ТаблицаФакт.Количество
	|ИЗ
	|	ТаблицаФакт КАК ТаблицаФакт
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(ВыборПланФакт, "&t", "ПланФакт") +
	"	СУММА(ПланФакт.Количество) КАК Количество
	|ПОМЕСТИТЬ ПланФактСумм
	|ИЗ
	|	ПланФакт КАК ПланФакт
	
	|СГРУППИРОВАТЬ ПО
	|" + ГруппаПланФакт + "
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(ВыборПланФакт, "&t", "ПланФактСумм") +
	"	ПланФактСумм.Количество КАК КоличествоПланОбщее
	|ИЗ
	|	ПланФактСумм КАК ПланФактСумм
	|ГДЕ
	|" + ФильтрПланФактСумм + "
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + ВыборОстатки + 
	"	вмс_ОперацияПоЯчейкамОстатки.Ячейка КАК Ячейка,
	|	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки( ,
	|" + ФильтрОстатки + ") КАК вмс_ОперацияПоЯчейкамОстатки";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	
	Для Каждого СтрокаДанных Из ДанныеПолей Цикл
		Ключ = СтрокаДанных.Ключ;
		Запрос.УстановитьПараметр(Ключ, СтрокаДанных.Значение);
	КонецЦикла;
	
	Запрос.Текст = 
	НовыйЗапросПлана + Символы.ПС +
	НовыйЗапросФакта + Символы.ПС +
	НовыйЗапросФинал;
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	РезультатПлан    = РезультатЗапроса[РезультатЗапроса.ВГраница()-1];
	РезультатОстатки = РезультатЗапроса[РезультатЗапроса.ВГраница()];
	
	Результат.Успех = Истина;
	
	Если ОтобратьКонтейнерПолностью Тогда
		ТаблицаПлан = РезультатПлан.Выгрузить();
		ТаблицаКонтейнер = РезультатОстатки.Выгрузить();
		ТаблицаКонтейнерРезультат = вмс_РаботаСКоллекциями.СкопироватьТаблицуЗначений(ТаблицаКонтейнер);
		
		Результат.СоставКонтейнера = ТаблицаКонтейнерРезультат;
		
		// Правка проверки плана с включенными сериями
		СтруктураПоиска = Новый Структура;
		ТоварныеПоляСтрока = "";
		Для Каждого ИмяПоля Из ТоварныеПоляМассив Цикл
			Если ИмяПоля <> "Серия" ИЛИ СерииИзПлана Тогда
				СтруктураПоиска.Вставить(ИмяПоля);
				ТоварныеПоляСтрока = ТоварныеПоляСтрока + ИмяПоля + ", ";
			КонецЕсли;
		КонецЦикла;
		ТоварныеПоляСтрока = Лев(ТоварныеПоляСтрока, СтрДлина(ТоварныеПоляСтрока) - 2);
		
		ТаблицаКонтейнер.Свернуть(ТоварныеПоляСтрока, "КоличествоОстаток");
		
		Для Каждого СтрокаКонтейнер Из ТаблицаКонтейнер Цикл
			Для Каждого Элемент Из СтруктураПоиска Цикл
				ИмяПоля = Элемент.Ключ;
				СтруктураПоиска[ИмяПоля] = СтрокаКонтейнер[ИмяПоля];
			КонецЦикла;
			
			НайденныеСтроки = ТаблицаПлан.НайтиСтроки(СтруктураПоиска);
			
			Если НайденныеСтроки.Количество() = 0 ИЛИ НайденныеСтроки[0].КоличествоПланОбщее < СтрокаКонтейнер.КоличествоОстаток Тогда
				ПредставлениеТовара = "";
				Для Каждого Элемент Из СтруктураПоиска Цикл
					ПредставлениеТовара = ПредставлениеТовара + Строка(СтрокаКонтейнер[Элемент.Ключ]) + " | ";
				КонецЦикла;
				ПредставлениеТовара = Лев(ПредставлениеТовара, СтрДлина(ПредставлениеТовара) - 3);
				
				КоличествоПлан = ?(НайденныеСтроки.Количество() = 0, 0, НайденныеСтроки[0].КоличествоПланОбщее);
				Результат.Успех = Ложь;
				Результат.Сообщение = Результат.Сообщение + "При отборе контейнера будет превышен план по товару: " + ПредставлениеТовара + Символы.ПС +
				"Остаток по плану:        " + КоличествоПлан + Символы.ПС +
				"Количество в контейнере: " + СтрокаКонтейнер.КоличествоОстаток + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Если РезультатПлан.Пустой() Тогда
			Результат.Сообщение = Результат.Сообщение + "Не найдены остатки в плане. ";
			Результат.Успех = Ложь;
		КонецЕсли;
		
		ВыборкаПлан = РезультатПлан.Выбрать();
		Пока ВыборкаПлан.Следующий() Цикл 
			Результат.КоличествоПланОбщее = ВыборкаПлан.КоличествоПланОбщее;
			
			Если ВыборкаПлан.КоличествоПланОбщее - Количество < 0 Тогда
				Результат.Сообщение = Результат.Сообщение + "Превышено общее количество к отбору по плану. ";
				Результат.Успех = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Если Количество > 0 И РезультатОстатки.Пустой() Тогда
			Результат.Сообщение = Результат.Сообщение + "Не найдены остатки на складе. ";
			Результат.Успех = Ложь;
		КонецЕсли;
		
		ВыборкаОстатки = РезультатОстатки.Выбрать();
		Пока ВыборкаОстатки.Следующий() Цикл
			Результат.КоличествоОстаток = ВыборкаОстатки.КоличествоОстаток;
			
			Если ВыборкаОстатки.КоличествоОстаток - Количество < 0 Тогда
				Результат.Сообщение = Результат.Сообщение + "Не хватает остатков в ячейке для отбора. ";
				Результат.Успех = Ложь;
			Иначе                                             
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ОтборПолучитьТаблицы(ПараметрыОперации, ДопНастройки = Неопределено, ТолькоПерваяСтрока = Ложь, ИмяТаблицы = "Маршрут") Экспорт
	Результат = Новый Структура("Успех, ВсеСобрано, Сообщение, Таблица", Ложь, Ложь, "", Неопределено);
	
	ВидОперации = ПараметрыОперации.ВидОперации;
	Ответственный = ПараметрыОперации.Ответственный;
	ДокументОснование = ПараметрыОперации.ДокументОснование;
	ИдентификаторОперации = ПараметрыОперации.ИдентификаторОперации;
	ВыбранноеПомещение = ПараметрыОперации.ВыбранноеПомещение;
	
	ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля(Истина);
	
	ОтборИзКонтейнера = Справочники.вмс_НастройкиПрограммы.ПолучитьЗначениеНастройкиПрограммы("ИспользоватьТару");
	ОтборВКонтейнер = ДопНастройки.ОтборВКонтейнер;
	ВыборПомещения = ДопНастройки.ВыборПомещения;
	СерииИзПлана = ДопНастройки.СерииИзПлана И ТоварныеПоляМассив.Найти("Серия") <> Неопределено;
	
	Если ТипЗнч(ОтборИзКонтейнера) <> Тип("Булево") Тогда
		Результат.Сообщение = "Не удалось получить настройку использования контейнеров";
		Возврат Результат;
	КонецЕсли;	
	
	// Оптимизировать функции если потребуется
	ПараметрыФункции = Новый Структура("ПараметрДокументы, ВидОперации", ДокументОснование, ВидОперации);
	ТаблицаПлан = вмс_ОперацииПоЯчейкамСервер.ПолучитьТаблицуТоваровПоДокументам(ПараметрыФункции);  
	
	ПараметрыФункции = Новый Структура("ДокументОснование, ВидОперации", ДокументОснование, ВидОперации); 
	ТаблицаФакт = ПолучитьФактОтбора(ПараметрыФункции, ТоварныеПоляМассив, ОтборИзКонтейнера, ОтборВКонтейнер, Ложь);
	
	Если ИмяТаблицы = "Маршрут" ИЛИ ИмяТаблицы = "Помещения" Тогда
		РезультатПодсказки = ПолучитьМаршрутОтбора(ДокументОснование, Ответственный, ИдентификаторОперации, ТаблицаПлан, ТаблицаФакт, ТоварныеПоляМассив,
		ОтборИзКонтейнера, ОтборВКонтейнер, СерииИзПлана, ВыборПомещения, ВыбранноеПомещение);
		// Дописать отдельную логику под помещения, с выдачей результатов по каким все отобрано	
	ИначеЕсли ИмяТаблицы = "ПланФакт" Тогда
		РезультатПодсказки = ПолучитьТаблицуПланФакт(ТаблицаПлан, ТаблицаФакт, ТоварныеПоляМассив, СерииИзПлана);
	КонецЕсли;
	
	Результат.ВсеСобрано = РезультатПодсказки.ВсеСобрано; 
	Таблица 			 = РезультатПодсказки.ТаблицаПодсказки;
	
	Если Таблица.Количество() = 0 Тогда
		Результат.Сообщение = "Не найдены строки для формирования маршрута отбора";
		Возврат Результат;
	КонецЕсли;
	
	Если ИмяТаблицы = "Помещения" Тогда
		Результат.Таблица = Таблица.ВыгрузитьКолонку("Помещение");
	ИначеЕсли ТолькоПерваяСтрока Тогда
		СтрокаТаблицы = Новый Структура();
		Для Каждого Колонка Из Таблица.Колонки Цикл
			СтрокаТаблицы.Вставить(Колонка.Имя);
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Таблица[0]);
		Результат.Таблица = СтрокаТаблицы;
	Иначе
		Результат.Таблица = Таблица;
	КонецЕсли;
	
	Результат.Успех = Истина;
	
	Возврат Результат;
КонецФункции

// Сделать адаптацию конфигураций (справочник серий)
Функция ПолучитьФактОтбора(ПараметрыОперации, ТоварныеПоляМассив, ОтборИзКонтейнера, ОтборВКонтейнер, ВозвратЗапроса = Ложь)
	Выбор1 = "";
	Выбор2 = "";
	Для Каждого ИмяПоля Из ТоварныеПоляМассив Цикл
		Если ИмяПоля = "Серия" Тогда
			Выбор1 = Выбор1 + "
			|	ВЫБОР
			|	КОГДА вмс_ОперацияПоЯчейкамТовары.Серия = Неопределено
			|	  ИЛИ вмс_ОперацияПоЯчейкамТовары.Серия ЕСТЬ NULL
			|	ТОГДА ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
			|	ИНАЧЕ вмс_ОперацияПоЯчейкамТовары.Серия
			|	КОНЕЦ КАК " + ИмяПоля + "," + Символы.ПС;
		Иначе
			Выбор1 = Выбор1 + Символы.Таб + "вмс_ОперацияПоЯчейкамТовары." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;                             
		КонецЕсли;
		Выбор2 = Выбор2 + Символы.Таб + "СтрокиОперации." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
	КонецЦикла;
	
	Если ОтборИзКонтейнера Тогда
		Выбор1 = Выбор1 + Символы.Таб + "вмс_ОперацияПоЯчейкамТовары.КонтейнерОтправитель КАК КонтейнерОтправитель," + Символы.ПС;
	КонецЕсли;
	
	Если ОтборВКонтейнер Тогда
		Выбор1 = Выбор1 + Символы.Таб + "вмс_ОперацияПоЯчейкамТовары.КонтейнерПриемник КАК КонтейнерПриемник," + Символы.ПС;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкам.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Операции
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкам
	|ГДЕ
	|	вмс_ОперацияПоЯчейкам.ДокументОснование = &ДокументОснование
	|	И вмс_ОперацияПоЯчейкам.ВидОперации = &ВидОперации
	|	И вмс_ОперацияПоЯчейкам.Проведен
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Операции.Ссылка КАК Ссылка,
	|" + Выбор1 + 
	"	вмс_ОперацияПоЯчейкамТовары.Ячейка КАК Ячейка,
	// При необходимости отображать ячейку-приемник, заменить поле
	|	вмс_ОперацияПоЯчейкамТовары.Количество КАК Количество
	|ИЗ
	|	Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.вмс_ОперацияПоЯчейкам.Товары КАК вмс_ОперацияПоЯчейкамТовары
	|		ПО Операции.Ссылка = вмс_ОперацияПоЯчейкамТовары.Ссылка
	|		И вмс_ОперацияПоЯчейкамТовары.Ячейка <> ЗНАЧЕНИЕ(Справочник.вмс_МестаХранения.ПустаяСсылка)";
	
	Если ВозвратЗапроса Тогда
		Возврат Запрос.Текст;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДокументОснование", ПараметрыОперации.ДокументОснование);
	Запрос.УстановитьПараметр("ВидОперации", ПараметрыОперации.ВидОперации);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции

Функция ПолучитьМаршрутОтбора(ДокументОснование, Ответственный, ИдентификаторОперации, ТаблицаПлан, ТаблицаФакт,
	ТоварныеПоляМассив, ОтборИзКонтейнера, ОтборВКонтейнер, СерииИзПлана, ВыборПомещения, ВыбранноеПомещение)
	Результат = Новый Структура("ВсеСобрано, ТаблицаПодсказки, Сообщение", Ложь, Неопределено, "");
	
	ОперацияПоЯчейкам = ПолучитьОперациюСеанса(ИдентификаторОперации, Ложь);
	
	ИспользоватьПомещения = Справочники.вмс_НастройкиПрограммы.ПолучитьЗначениеНастройкиПрограммы("ИспользоватьПомещения");
	
	Если ИспользоватьПомещения И ВыбранноеПомещение = Неопределено Тогда
		СписокПомещений = Справочники.вмс_НастройкиОператора.ПолучитьДоступныеПомещенияОператора(Ответственный);
		СписокПомещений.Добавить(Справочники.вмс_Помещения.ПустаяСсылка());
	ИначеЕсли ВыбранноеПомещение <> Неопределено Тогда
		СписокПомещений = Новый Массив;
		СписокПомещений.Добавить(ВыбранноеПомещение);
		СписокПомещений.Добавить(Справочники.вмс_Помещения.ПустаяСсылка());
	Иначе
		СписокПомещений = Новый Массив;
	КонецЕсли;
	
	ИндексСерии = ТоварныеПоляМассив.Найти("Серия");
	ИспользоватьСерии = ИндексСерии <> Неопределено;
	// Нужно для однозначного порядка полей в одном из объединений запросов, в одном из которых может не быть серий
	Если ИспользоватьСерии Тогда
		ТоварныеПоляМассив.Удалить(ИндексСерии);
		ТоварныеПоляМассив.Добавить("Серия");
	КонецЕсли;
	
	ПервыйЭлемент = Истина;
	СтрокаВыбор = "";
	СтрокаГруппы = "";
	СтрокаФильтр = "";
	СтрокаСоединение = "";
	СтрокаСоединениеФакт = "";
	СтрокаВыборСумм = "";
	СтрокаГруппыСумм = "";
	Для Каждого ИмяПоля Из ТоварныеПоляМассив Цикл
		СтрокаВыбор = СтрокаВыбор   + Символы.Таб + "&t." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
		СтрокаГруппы = СтрокаГруппы + Символы.Таб + "&t." + ИмяПоля + "," + Символы.ПС;
		
		Если СерииИзПлана ИЛИ ИмяПоля <> "Серия" Тогда //Только когда СерииИзПлана, добавлять серию в поля фильтра и соединения
			Если ПервыйЭлемент Тогда
				ПервыйЭлемент = Ложь;
				СтрокаФильтр	 = СтрокаФильтр		+ Символы.Таб + Символы.Таб;
				СтрокаСоединение = СтрокаСоединение + Символы.Таб + Символы.Таб;
			Иначе
				СтрокаФильтр	 = СтрокаФильтр		+ Символы.Таб + Символы.Таб + "И "; 
				СтрокаСоединение = СтрокаСоединение + Символы.Таб + Символы.Таб + "И "; 
			КонецЕсли;
			СтрокаФильтр	 = СтрокаФильтр + ИмяПоля + " В(ВЫБРАТЬ Финал." + ИмяПоля + " ИЗ Финал КАК Финал)" + Символы.ПС;
			СтрокаСоединение = СтрокаСоединение + "&t1." +  ИмяПоля + " = &t2." + ИмяПоля + Символы.ПС;
			СтрокаВыборСумм  = СтрокаВыборСумм  + Символы.Таб + "&t." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
			СтрокаГруппыСумм = СтрокаГруппыСумм + Символы.Таб + "&t." + ИмяПоля + "," + Символы.ПС;
		КонецЕсли;                                                                                               
	КонецЦикла;
	СтрокаГруппы = Лев(СтрокаГруппы, СтрДлина(СтрокаГруппы) - 2);
	СтрокаГруппыСумм = Лев(СтрокаГруппыСумм, СтрДлина(СтрокаГруппыСумм) - 2);
	СтрокаСоединениеФакт = СтрокаСоединение + Символы.Таб + Символы.Таб + "И &t1.Ячейка = &t2.Ячейка" + Символы.ПС;
	
	ЗаменаНеопределеноСерии =
	"	ВЫБОР КОГДА ОстаткиПланаПлюсФакт.ЭтоФакт ТОГДА ОстаткиПланаПлюсФакт.Серия
	|		КОГДА вмс_ОперацияПоЯчейкамОстатки.Серия = Неопределено
	|		ТОГДА ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|		ИНАЧЕ вмс_ОперацияПоЯчейкамОстатки.Серия
	|	КОНЕЦ";
	
	НеВключаемыеТипыЯчеек = Новый Массив;
	НеВключаемыеТипыЯчеек.Добавить(Перечисления.вмс_ТипыЯчеек.ЗонаОтгрузки);
	НеВключаемыеТипыЯчеек.Добавить(Перечисления.вмс_ТипыЯчеек.ЗонаОтбора);
	НеВключаемыеТипыЯчеек.Добавить(Перечисления.вмс_ТипыЯчеек.ЗонаКонтроля);
	НеВключаемыеТипыЯчеек.Добавить(Перечисления.вмс_ТипыЯчеек.Оператор);
	
	НеДоступныеТипыЯчеек = Новый Массив;
	НеДоступныеТипыЯчеек.Добавить(Перечисления.вмс_ТипыЯчеек.ЗонаПриемки);
	НеДоступныеТипыЯчеек.Добавить(Перечисления.вмс_ТипыЯчеек.Карантин);
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыбор, "&t", "План") +
	"	План.Количество КАК Количество
	|ПОМЕСТИТЬ План
	|ИЗ &План КАК План
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыбор, "&t", "Факт") +
