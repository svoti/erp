	|	ПодсказкаБезАртикула.КоличествоФакт			КАК КоличествоФакт,
	|	ЛОЖЬ										КАК ВРамкахПлана
	|ИЗ
	|	ПодсказкаБезАртикула КАК ПодсказкаБезАртикула
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО (ПодсказкаБезАртикула.Товар = Номенклатура.Ссылка)
	|ГДЕ
	|	НЕ &ИспользоватьПомещения ИЛИ ПодсказкаБезАртикула.Помещение В (&СписокПомещений)
	|УПОРЯДОЧИТЬ ПО
	|	Товар,
	|	РедактированиеДоступно УБЫВ,
	|	ОтобраноРанее,
	|	Приоритет,
	|	Наименование";
	//|	СортировкаРяд,
	//|	СортировкаНомер,
	//|	СортировкаЭтаж";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("План", ТаблицаПлан);
	Запрос.УстановитьПараметр("Факт", ТаблицаФакт);
	Запрос.УстановитьПараметр("НеВключаемыеТипыЯчеек", НеВключаемыеТипыЯчеек);
	Запрос.УстановитьПараметр("НеДоступныеТипыЯчеек", НеДоступныеТипыЯчеек);
	Запрос.УстановитьПараметр("СсылкаОперации", ОперацияПоЯчейкам);
	Запрос.УстановитьПараметр("ИспользоватьПомещения", ИспользоватьПомещения);
	Запрос.УстановитьПараметр("СписокПомещений", СписокПомещений);	
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	ЗапросПлана = РезультатЗапроса[РезультатЗапроса.ВГраница() - 4];
	Результат.ВсеСобрано = ЗапросПлана.Пустой();
	
	ОстаткиПлана = ЗапросПлана.Выгрузить();
	ТаблицаПланФакт = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить();
	
	ТоварПоПлану = Неопределено;
	
	Для Каждого СтрокаОстатков Из ТаблицаПланФакт Цикл
		КоличествоПланОбщее = 0; //Правка бага (ранее инициализировалось Неопределено, что вызывало исключение при заполнении подсказки при отсутствии остатков по плану)
		
		Если ТоварПоПлану <> СтрокаОстатков.Товар Тогда
			ТоварПоПлану = СтрокаОстатков.Товар;
			
			СтрокаПлана = ОстаткиПлана.Найти(ТоварПоПлану, "Товар");
			Если СтрокаПлана = Неопределено Тогда
				ОстатокПлана = 0;
			Иначе
				КоличествоПланОбщее = СтрокаПлана.Количество;
				ОстатокПлана = СтрокаПлана.Количество;
			КонецЕсли;
		КонецЕсли;
		
		ОтбираемоеКоличество = Мин(ОстатокПлана, СтрокаОстатков.КоличествоОстаток);
		
		СтрокаОстатков.КоличествоПланОбщее = КоличествоПланОбщее;
		Если СтрокаОстатков.КоличествоПлан = 0 Тогда
			СтрокаОстатков.КоличествоПлан = ОтбираемоеКоличество;
		КонецЕсли;
		
		ОстатокПлана = ОстатокПлана - ОтбираемоеКоличество;
		
		Если ОтбираемоеКоличество > 0 Тогда
			СтрокаОстатков.ВРамкахПлана = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаПланФакт.Сортировать("РедактированиеДоступно УБЫВ, ВРамкахПлана УБЫВ, ОтобраноРанее, Помещение, Приоритет, Наименование");
	
	Результат.ТаблицаПодсказки = ТаблицаПланФакт;
	
	Возврат Результат;
КонецФункции

Функция ПолучитьТаблицуПланФакт(ТаблицаПлан, ТаблицаФакт, ТоварныеПоляМассив, СерииИзПлана)
	// Начало дублирует функцию ПолучитьМаршрутОтбора, думаю не стоит объединять, и так формируется сложный запрос, пока
	// без регистра. Поэтому разделение еще и логики на две функции еще больше усложнит доработку.
	Результат = Новый Структура("ВсеСобрано, ТаблицаПодсказки");
	
	ПервыйЭлемент = Истина;
	СтрокаВыбор = "";
	СтрокаГруппы = "";
	СтрокаФильтр = "";
	СтрокаСоединение = "";
	СтрокаВыборСумм = "";
	СтрокаГруппыСумм = "";
	Для Каждого ИмяПоля Из ТоварныеПоляМассив Цикл
		СтрокаВыбор  = СтрокаВыбор  + Символы.Таб + "&t." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
		СтрокаГруппы = СтрокаГруппы + Символы.Таб + "&t." + ИмяПоля + "," + Символы.ПС;
		
		Если СерииИзПлана ИЛИ ИмяПоля <> "Серия" Тогда //Только когда СерииИзПлана, добавлять серию в поля фильтра и соединения
			Если ПервыйЭлемент Тогда
				ПервыйЭлемент = Ложь;
				СтрокаФильтр     = СтрокаФильтр     + Символы.Таб + Символы.Таб;
				СтрокаСоединение = СтрокаСоединение + Символы.Таб + Символы.Таб;
			Иначе
				СтрокаФильтр     = СтрокаФильтр     + Символы.Таб + Символы.Таб + "И "; 
				СтрокаСоединение = СтрокаСоединение + Символы.Таб + Символы.Таб + "И "; 
			КонецЕсли;
			СтрокаФильтр = СтрокаФильтр + ИмяПоля + " В(ВЫБРАТЬ Финал." + ИмяПоля + " ИЗ Финал КАК Финал)" + Символы.ПС;
			СтрокаСоединение = СтрокаСоединение + "&t1." + ИмяПоля + " = &t2." + ИмяПоля + Символы.ПС;
			СтрокаВыборСумм  = СтрокаВыборСумм  + Символы.Таб + "&t." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
			СтрокаГруппыСумм = СтрокаГруппыСумм + Символы.Таб + "&t." + ИмяПоля + "," + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	СтрокаГруппы = Лев(СтрокаГруппы, СтрДлина(СтрокаГруппы) - 2);
	СтрокаГруппыСумм = Лев(СтрокаГруппыСумм, СтрДлина(СтрокаГруппыСумм) - 2);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыборСумм, "&t", "План") +
	"	План.Количество КАК Количество
	|ПОМЕСТИТЬ План
	|ИЗ &План КАК План
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыборСумм, "&t", "Факт") + "
	|	Факт.Количество КАК Количество 
	|ПОМЕСТИТЬ Факт
	|ИЗ &Факт КАК Факт 
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыборСумм, "&t", "План") +
	"	СУММА(План.Количество) КАК Количество
	|ПОМЕСТИТЬ ПланГрупп
	|ИЗ План КАК План
	|СГРУППИРОВАТЬ ПО
	|	" + СтрЗаменить(СтрокаГруппыСумм, "&t", "План") + 
	";
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыборСумм, "&t", "Факт") + "
	|	СУММА(Факт.Количество) КАК Количество 
	|ПОМЕСТИТЬ ФактГрупп
	|ИЗ Факт КАК Факт
	|СГРУППИРОВАТЬ ПО
	|	" + СтрЗаменить(СтрокаГруппыСумм, "&t", "Факт") + 
	";
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыборСумм, "&t", "ПланГрупп") +
	"	ПланГрупп.Количество КАК КоличествоПлан,
	|	ФактГрупп.Количество КАК КоличествоФакт,
	|	ВЫБОР КОГДА ПланГрупп.Количество > ФактГрупп.Количество ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК НеCобрано
	|ПОМЕСТИТЬ ПланФакт
	|ИЗ ПланГрупп КАК ПланГрупп
	
	|ЛЕВОЕ СОЕДИНЕНИЕ ФактГрупп КАК ФактГрупп
	|		ПО
	|" + СтрЗаменить(СтрЗаменить(СтрокаСоединение, "&t1", "ПланГрупп"), "&t2", "ФактГрупп") + "	
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыборСумм, "&t", "ПланФакт") +
	"	Номенклатура.Артикул КАК Артикул,
	|	ПланФакт.КоличествоПлан КАК КоличествоПлан,
	|	ПланФакт.КоличествоФакт КАК КоличествоФакт
	|ИЗ ПланФакт КАК ПланФакт
	
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО (ПланФакт.Товар = Номенклатура.Ссылка)
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ПланФакт.НеCобрано) = 0 КАК ВсеСобрано
	|ИЗ ПланФакт КАК ПланФакт
	|;";
	Запрос.УстановитьПараметр("План", ТаблицаПлан);
	Запрос.УстановитьПараметр("Факт", ТаблицаФакт);           
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	Результат.ВсеСобрано = РезультатЗапроса[РезультатЗапроса.ВГраница()].Пустой();
	Результат.ТаблицаПодсказки = РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция ПолучитьОстаток(СобранныеДанные) Экспорт
	Запрос = Новый Запрос;
	Фильтры = "";
	ПервоеУсловие = Истина;
	
	Для Каждого Элемент Из СобранныеДанные Цикл
		Ключ = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если ПервоеУсловие Тогда
			ПервоеУсловие = Ложь;
		Иначе
			Фильтры = Фильтры + "И ";
		КонецЕсли;
		
		Фильтры = Фильтры + Ключ + " = &" + Ключ;		
		Фильтры = Фильтры + Символы.ПС + Символы.Таб + Символы.Таб;
		
		Запрос.УстановитьПараметр(Ключ, Значение);
	КонецЦикла;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(,
	|		" + Фильтры + ") КАК вмс_ОперацияПоЯчейкамОстатки";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Результат = Выборка.КоличествоОстаток;
	
	Возврат Результат;
КонецФункции	

// Нужна в основном для получения факта отбора при изменении контейнера при сборке в контейнер, т.к. обычными средствами
// данные не обновляются в этом случае
Функция ПолучитьФактПоСтроке(ИдентификаторОперации, СобранныеДанные) Экспорт
	Если ИдентификаторОперации = Неопределено Тогда
		Возврат 0;
	Иначе
		ОперацияПоЯчейкам = ПолучитьОперациюСеанса(ИдентификаторОперации, Ложь);
		НайденныеСтроки = ОперацияПоЯчейкам.Товары.НайтиСтроки(СобранныеДанные);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Возврат 0;
		Иначе
			Возврат НайденныеСтроки[0].Количество;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ЕстьБлокировкаЯчейки(Ячейка, Источник, БлокировкаТекст) Экспорт
	ВидыБлокировок = Новый Массив;
	ВидыБлокировок.Добавить(Перечисления.вмс_ВидыБлокировокЯчеек.Полная);
	ВидыБлокировок.Добавить(Перечисления.вмс_ВидыБлокировокЯчеек[БлокировкаТекст]);
	//БлокировкаТекст = Размещение или Отбор
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	вмс_ЗаблокированныеЯчейки.ВидБлокировки КАК ВидБлокировки
	|ИЗ
	|	РегистрСведений.вмс_ЗаблокированныеЯчейки КАК вмс_ЗаблокированныеЯчейки
	|ГДЕ
	|	вмс_ЗаблокированныеЯчейки.Ячейка = &Ячейка
	|	И вмс_ЗаблокированныеЯчейки.Источник <> &Источник
	|	И вмс_ЗаблокированныеЯчейки.ВидБлокировки В(&ВидыБлокировок)";
	Запрос.УстановитьПараметр("Ячейка", Ячейка); 
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("ВидыБлокировок", ВидыБлокировок);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
КонецФункции

Функция ОтменитьОперациюПоЯчейкам(ИдентификаторОперации) Экспорт
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	
	Если ИдентификаторОперации = Неопределено Тогда
		Результат.Сообщение = "Не найдена операция по ячейкам, которую можно отменить, по полученному идентификатору";
		Результат.Успех = Ложь;
		Возврат Результат;
	КонецЕсли;
	
	ОперацияОбъект = ПолучитьОперациюСеанса(ИдентификаторОперации, Истина);
	ОперацияОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	
	Результат.Успех = Истина;
	
	Возврат Результат;
КонецФункции

Функция ОтменитьОтборВКонтейнер(ИдентификаторОперации, Контейнер) Экспорт
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	
	Если ИдентификаторОперации = Неопределено Тогда
		Результат.Сообщение = "По текущему сеансу нет операции по ячейкам, которую можно отменить.";
		Возврат Результат;
	КонецЕсли;
	
	Операция = ПолучитьОперациюСеанса(ИдентификаторОперации, Истина);
	
	ТоварыТЧ = Операция.Товары;
	НайденныеСтроки = ТоварыТЧ.НайтиСтроки(Новый Структура("КонтейнерПриемник", Контейнер));
	
	Результат.Сообщение = "Отмена сборки в контейнер по текущему сеансу. Очищено: " + НайденныеСтроки.Количество() + " строк.";
	Результат.Успех = Истина;
	
	Для Каждого Строка Из НайденныеСтроки Цикл
		ТоварыТЧ.Удалить(Строка);
	КонецЦикла;
	
	Операция.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат Результат;
КонецФункции

Функция ПолучитьЯчейкуОтгрузкиДокумента(Документ) Экспорт
	ЯчейкаОтгрузкиДокумента = Ложь;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.вмс_ЗаданиеКладовщику") Тогда
		ЯчейкаОтгрузкиДокумента = Документ.ЗонаПолучатель;
		Если ЯчейкаОтгрузкиДокумента = Справочники.вмс_МестаХранения.ПустаяСсылка() Тогда
			ЯчейкаОтгрузкиДокумента = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЯчейкаОтгрузкиДокумента;
КонецФункции

