Функция ПреобразоватьДанныеПослеПолучения(Данные) Экспорт
	
	РК = вмс_РаботаСКоллекциями;

	КонтейнерДанных = Новый Массив;
	КонтейнерДанных.Добавить(Данные);

	ДополнительныеПараметрыРазложенияДанных = Новый Структура;
	МассивСсылокНаЗначения = РК.РазложитьСтруктуруДанныхВМассивСсылокНаЗначения(КонтейнерДанных, ДополнительныеПараметрыРазложенияДанных);
    МассивСсылокНаКвазиСсылки = ДополнительныеПараметрыРазложенияДанных.МассивСсылокНаКвазиСсылки;
	
	ПреобразоватьКвазиСсылкиВСсылкиВМассивеСсылокНаЗначения(МассивСсылокНаКвазиСсылки);
	
	РК.ЗаменитьКлючиСоответствий(ДополнительныеПараметрыРазложенияДанных.МассивЗаменКлючейСоответствий);
	
	Данные = КонтейнерДанных[0];

КонецФункции

Функция ПреобразоватьДанныеПередОтправкой(Данные) Экспорт

	РК = вмс_РаботаСКоллекциями;
	
	КонтейнерДанных = Новый Массив;
	КонтейнерДанных.Добавить(Данные);
	
	ДополнительныеПараметрыРазложенияДанных = Новый Структура;
	МассивСсылокНаЗначения = РК.РазложитьСтруктуруДанныхВМассивСсылокНаЗначения(КонтейнерДанных, ДополнительныеПараметрыРазложенияДанных);
	
	МассивСсылокНаТаблицы = ДополнительныеПараметрыРазложенияДанных.МассивСсылокНаТаблицы;
	Для Каждого СсылкаНаТаблицу Из МассивСсылокНаТаблицы Цикл
		РК.РазтипизироватьТаблицуЗначений(СсылкаНаТаблицу.Значение);
	КонецЦикла;
	
	ПреобразоватьСсылкиИБВКвазиСсылкиВМассивеСсылокНаЗначения(МассивСсылокНаЗначения);
	
	РК.ЗаменитьКлючиСоответствий(ДополнительныеПараметрыРазложенияДанных.МассивЗаменКлючейСоответствий);
	
	Данные = КонтейнерДанных[0];

КонецФункции

Функция ТестовыйМетод(Параметр) Экспорт
	Возврат "Ты передал """ + Параметр + """";
КонецФункции

Функция ПолучитьКодНовогоУзлаОбмена()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МобильныйОбмен.Код КАК Код
	|ИЗ
	|	ПланОбмена.МобильныйОбмен КАК МобильныйОбмен";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		НовыйКод = "1";
	Иначе
		ТаблицаКодов = РезультатЗапроса.Выгрузить();
		ТаблицаКодов.Колонки.Добавить("Порядок");
		Нули = "";
		ДлинаКода = Метаданные.ПланыОбмена.МобильныйОбмен.ДлинаКода;
		Для НомерНуля=1 По ДлинаКода Цикл
			Нули = Нули + "0";
		КонецЦикла;
		
		Для Каждого СтрокаКода Из ТаблицаКодов Цикл
			СтрокаКода.Порядок = Прав(Нули+СтрокаКода.Код, ДлинаКода);
		КонецЦикла;
		ТаблицаКодов.Сортировать("Порядок УБЫВ");
		Код = ТаблицаКодов[0].Код;
		КодЧисло = Число(Код);
		НовыйКодЧисло = КодЧисло + 1;
		НовыйКод = Формат(НовыйКодЧисло, "ЧГ=0");
	КонецЕсли;
	
	Возврат НовыйКод;
	
КонецФункции

Функция ЗарегистрироватьНовыйУзелОбмена(ИмяУзла, КодУзла) Экспорт
	
	Перем Узел, НовыйКодУзла;
	
	НачатьТранзакцию();
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("ПланОбмена.МобильныйОбмен");
	Блокировка.Заблокировать();
	Если ЗначениеЗаполнено(КодУзла) Тогда
		Узел = ПланыОбмена.МобильныйОбмен.НайтиПоКоду(КодУзла);
		Если ЗначениеЗаполнено(Узел) Тогда
			СоздатьУзел = Ложь;
		Иначе
			// узел по каким-то причинам удален из основной базы
			НовыйКодУзла = КодУзла;
			СоздатьУзел = Истина;
		КонецЕсли;
	Иначе
		НовыйКодУзла = ПолучитьКодНовогоУзлаОбмена();
		СоздатьУзел = Истина;
	КонецЕсли;
	
	Если СоздатьУзел Тогда  
		
		// Кулалаев Е.С + 03.07.2023 17:43:35
		// Использую выборку, потому что на старых клиентах может быть много старых баз.
		//Выборка = ПланыОбмена.МобильныйОбмен.Выбрать(Новый Структура("Наименование", ИмяУзла));	
		//Пока Выборка.Следующий() Цикл
		//	СтарыйУзел = Выборка.Ссылка.ПолучитьОбъект();  
		//	СтарыйУзел.Удалить(); // ( ͡° ͜ʖ ͡°)
		//КонецЦикла;
		// Кулалаев Е.С -
				
		НовыйУзел = ПланыОбмена.МобильныйОбмен.СоздатьУзел();
		НовыйУзел.Заполнить(Неопределено);
		НовыйУзел.Код = НовыйКодУзла;
		НовыйУзел.Наименование = ИмяУзла;
		НовыйУзел.Записать();
	КонецЕсли;  
	
	ЗафиксироватьТранзакцию();
	
	Возврат НовыйКодУзла;
	
КонецФункции

Функция ЗарегистрироватьОбъектДляОбмена(Объект) Экспорт

	Если ТипЗнч(Объект) = Тип("УдалениеОбъекта") Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(ПолучитьУзлыДляОбмена(), Объект);
		Возврат Истина;
	КонецЕсли;
	
	Если вмс_ОбщегоНазначенияВызовСервера.ЭтоОбъектИБ(Объект) Тогда
		СсылкаОбъекта = Объект.Ссылка;
		Если ЗначениеЗаполнено(СсылкаОбъекта) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(ПолучитьУзлыДляОбмена(), СсылкаОбъекта);
		Иначе
			Для Каждого Узел Из ПолучитьУзлыДляОбмена() Цикл
				Объект.ОбменДанными.Получатели.Добавить(Узел);
			КонецЦикла;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;

	Если вмс_ОбщегоНазначенияВызовСервера.ЭтоСсылкаОбъектаИБ(Объект) Тогда
		СсылкаОбъекта = Объект;
		Если ЗначениеЗаполнено(СсылкаОбъекта) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(ПолучитьУзлыДляОбмена(), СсылкаОбъекта);
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьУзлыДляОбмена() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МобильныйОбмен.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.МобильныйОбмен КАК МобильныйОбмен
	|ГДЕ
	|	НЕ МобильныйОбмен.ЭтотУзел";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Узлы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Узлы.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Узлы;
	
КонецФункции
