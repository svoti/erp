				ДанныеВХ.Записать(ПутьКФайлуНаСервере);
				
				ТабДок = Новый ТабличныйДокумент;
				
				Попытка
					ТабДок.Прочитать(ПутьКФайлуНаСервере, СпособЧтенияЗначенийТабличногоДокумента.Текст);	
				Исключение
					ТекстОшибки = ДопТекст + СтрШаблон("В документе %1 не удалось прочитать файл %2", СтрокаМассиваДокументов.Идентификатор, СтрокаМассиваДокументов.ИмяФайлаДляЗаполнения);
				КонецПопытки;
				
				Если ТекстОшибки <> ""  Тогда
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
								
				КоличествоСтрок = ТабДок.ВысотаТаблицы;
				КоличествоКолонок = ТабДок.ШиринаТаблицы;   
				
				ТабЗначений = Новый ТаблицаЗначений;
				ТабЗначений.Колонки.Добавить("Штрихкод");
				ТабЗначений.Колонки.Добавить("Артикул");
				ТабЗначений.Колонки.Добавить("Карточка");     
				ТабЗначений.Колонки.Добавить("Характеристика");    
				ТабЗначений.Колонки.Добавить("Упаковка");    
				ТабЗначений.Колонки.Добавить("Количество");    
				
				Для НомерСтроки = 1 По КоличествоСтрок Цикл	
					Если НомерСтроки = 1 Тогда  
						Если НЕ ПроверкаШапкиФайлаЗаполнения(ТабДок) Тогда
							ТекстОшибки = ДопТекст + СтрШаблон("В документе %1 в файле %2 не совпадают названия колонок с шаблоном", СтрокаМассиваДокументов.Идентификатор, СтрокаМассиваДокументов.ИмяФайлаДляЗаполнения);
							
							ВызватьИсключение ТекстОшибки; 						
						КонецЕсли;
						
						Продолжить;			
					КонецЕсли; 
					
					СтрокаТЗ = ТабЗначений.Добавить();
					СтрокаТЗ.Штрихкод = ТабДок.Область(НомерСтроки, 1).Текст;
					СтрокаТЗ.Артикул = ТабДок.Область(НомерСтроки, 2).Текст;
					СтрокаТЗ.Карточка = ТабДок.Область(НомерСтроки, 3).Текст;
					СтрокаТЗ.Характеристика = ТабДок.Область(НомерСтроки, 4).Текст;      
					СтрокаТЗ.Упаковка = ТабДок.Область(НомерСтроки, 5).Текст;
					СтрокаТЗ.Количество = ТабДок.Область(НомерСтроки, 6).Текст;
				КонецЦикла;
				
				НайденныйКонтрагент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаМассиваДокументов.Контрагент));
				
				Для каждого СтрокаПолученнойТЗ Из ТабЗначений Цикл  
