					ТекстОшибки = СтрШаблон("%1 ГУИД: %2, от %3. %4", ДопТекст, ДанныеДок.Идентификатор, ДанныеДок.Дата, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ЗаписьВЖурнал("Ошибка", ТекстОшибки);
					ТекстОшибки = ""; 
				КонецПопытки;
			КонецЕсли;
		Исключение
