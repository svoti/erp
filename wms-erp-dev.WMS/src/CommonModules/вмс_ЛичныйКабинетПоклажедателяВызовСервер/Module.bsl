Процедура ОтправитьПоклажедателяНаСервере(ОтправленныеДанные) Экспорт
	
	ДанныеКонтрагент = Новый Массив;                  
	//ДанныеПредставитель = Новый Массив;       
	
	Для каждого Данные Из ОтправленныеДанные Цикл        
		//ОтправленныеДанныеПредставитель = Новый Структура;
		//
		//ОтправленныеДанныеПредставитель.Вставить("Контрагент", Данные.Контрагент);	
		//ОтправленныеДанныеПредставитель.Вставить("Представитель", Данные.Представитель);
		
		ДанныеКонтрагент.Добавить(Данные.Контрагент);
		//ДанныеПредставитель.Добавить(ОтправленныеДанныеПредставитель);
	КонецЦикла;
	
	ДобавитьКонтрагентаВЛК(ДанныеКонтрагент);
