Процедура ВыгрузитьДокВыдачаСХранения() Экспорт

	ТекстОшибки = "";
	ДопТекст = "Выгрузить документы: выдача с хранения. ";  
	
	ДополнительныйПуть = "from_storage_out";
	
	Попытка
