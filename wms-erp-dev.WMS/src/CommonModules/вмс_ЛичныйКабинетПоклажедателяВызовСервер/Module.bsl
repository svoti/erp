Функция НайтиДокументУчетнойСистемы(ДокПоклажедателя) Экспорт   
	
	НайденныйДок = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	вмс_СвязанныеДокументыПоклажедателя.ДокументУчетнойСистемы КАК ДокументУчетнойСистемы
		|ИЗ
		|	РегистрСведений.вмс_СвязанныеДокументыПоклажедателя КАК вмс_СвязанныеДокументыПоклажедателя
		|ГДЕ
		|	вмс_СвязанныеДокументыПоклажедателя.ДокументПоклажедателя = &ДокументПоклажедателя";
		
	Запрос.УстановитьПараметр("ДокументПоклажедателя", ДокПоклажедателя);
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		НайденныйДок = Выборка.ДокументУчетнойСистемы;
	КонецЕсли;
	
	Возврат НайденныйДок;
	
КонецФункции

