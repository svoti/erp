КонецФункции

Функция РазбиениеМассива(ИсходныйМассив, Разбиение) Экспорт
	
	МассивМассивов = Новый Массив;
	ПромежуточныйМассив = Новый Массив;
	Счетчик = 1;  
	
	Для каждого ЭлементМассива Из ИсходныйМассив Цикл
		ПромежуточныйМассив.Добавить(ЭлементМассива);
		
		Если Счетчик = Разбиение Тогда
			Счетчик = 1;
			МассивМассивов.Добавить(ПромежуточныйМассив);     
			ПромежуточныйМассив = Новый Массив;
		Иначе
			Счетчик = Счетчик + 1;
		КонецЕсли;
	КонецЦикла;  
	
	Если  Счетчик <> 1 Тогда
		МассивМассивов.Добавить(ПромежуточныйМассив);     	
	КонецЕсли;

	Возврат МассивМассивов;
	
КонецФункции

Функция СтруктураПроверокЗаполненияКолонок(ДаныеСтроки)
	
	СтруктураВозврата = Новый Структура("Штрихкод, Артикул, Карточка, Характеристика, Упаковка, Количество", Ложь, Ложь, Ложь, Ложь, Ложь, Ложь);
	
	Если ЗначениеЗаполнено(ДаныеСтроки.Штрихкод) Тогда
		СтруктураВозврата.Вставить("Штрихкод", Истина);
	КонецЕсли;                         
	
	Если ЗначениеЗаполнено(ДаныеСтроки.Артикул) Тогда
		СтруктураВозврата.Вставить("Артикул", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДаныеСтроки.Карточка) Тогда
		СтруктураВозврата.Вставить("Карточка", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДаныеСтроки.Характеристика) Тогда
		СтруктураВозврата.Вставить("Характеристика", Истина);
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(ДаныеСтроки.Упаковка) Тогда
		СтруктураВозврата.Вставить("Упаковка", Истина);
	КонецЕсли; 
		
	Если ЗначениеЗаполнено(ДаныеСтроки.Количество) Тогда
		СтруктураВозврата.Вставить("Количество", Истина);
	КонецЕсли;
	
	Возврат СтруктураВозврата;    
	
КонецФункции

Функция ОбработатьТекст(ТекстДляОбработки) Экспорт
	
	ОбработанныйТекст = ТекстДляОбработки;
	ОбработанныйТекст = СокрЛП(ОбработанныйТекст);
	ОбработанныйТекст = СтрЗаменить(ОбработанныйТекст, Символы.НПП, " ");
	
	Возврат ОбработанныйТекст;     
	
КонецФункции

Функция ПоискКарточкиПоклажедателя(Контрагент, СтруктураПоиска) Экспорт //На вход подается структура("Штрихкод, Артикул, Карточка, Характеристика, Упаковка, Количество") и по заполненным полям осуществляется поиск
	
	РезультатПоиска = Новый Структура("КарточкаНайдена, НайденоНесколько, КарточкаСсылка, КомментарийКПоиску", Ложь, Ложь, Справочники.вмс_КарточкаПоклажедателя.ПустаяСсылка(), "Не найден.");
	ЗаполнениеКолонок = СтруктураПроверокЗаполненияКолонок(СтруктураПоиска);
	
	ДопОтборыСтрока = ""; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_КарточкаПоклажедателя.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.вмс_КарточкаПоклажедателя КАК вмс_КарточкаПоклажедателя
	|ГДЕ
	|	вмс_КарточкаПоклажедателя.Контрагент = &Контрагент
	|	И вмс_КарточкаПоклажедателя.ПометкаУдаления = ЛОЖЬ
	|	И вмс_КарточкаПоклажедателя.ЭтоГруппа = ЛОЖЬ
	|	И &ДопОтборы";	
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Если ЗаполнениеКолонок.Карточка Тогда   
		Запрос.УстановитьПараметр("Ссылка", СтруктураПоиска.Карточка);
		
		Если ТипЗнч(СтруктураПоиска.Карточка) = Тип("СправочникСсылка.вмс_КарточкаПоклажедателя") Тогда
			ДопОтборыСтрока = ДопОтборыСтрока + " И вмс_КарточкаПоклажедателя.Ссылка = &Ссылка";
		ИначеЕсли ТипЗнч(СтруктураПоиска.Карточка) = Тип("Строка") Тогда
			ДопОтборыСтрока = ДопОтборыСтрока + " И вмс_КарточкаПоклажедателя.Наименование = &Ссылка";	
		КонецЕсли;  	
	КонецЕсли;  
	
	Если ЗаполнениеКолонок.Упаковка Тогда   
		Запрос.УстановитьПараметр("Упаковка", СтруктураПоиска.Упаковка);
		ДопОтборыСтрока = ДопОтборыСтрока + " И вмс_КарточкаПоклажедателя.УпаковкаПоклажедателя = &Упаковка";	
	КонецЕсли;            
	
	Если ЗаполнениеКолонок.Характеристика Тогда   
		Запрос.УстановитьПараметр("Характеристика", СтруктураПоиска.Характеристика);
		ДопОтборыСтрока = ДопОтборыСтрока + " И вмс_КарточкаПоклажедателя.ХарактеристикаПоклажедателя = &Характеристика";	
	КонецЕсли;
	
	Если ЗаполнениеКолонок.Штрихкод Тогда   
		Запрос.УстановитьПараметр("Штрихкод", СтруктураПоиска.Штрихкод);
		ДопОтборыСтрока = ДопОтборыСтрока + " И вмс_КарточкаПоклажедателя.Штрихкод = &Штрихкод";	
	КонецЕсли;
	
	Если ЗаполнениеКолонок.Артикул Тогда   
		Запрос.УстановитьПараметр("Артикул", СтруктураПоиска.Артикул);
		ДопОтборыСтрока = ДопОтборыСтрока + " И вмс_КарточкаПоклажедателя.Артикул = &Артикул";	
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ДопОтборы", ДопОтборыСтрока);	
	РезультатЗапросПоВсемДанным = Запрос.Выполнить(); 
	
	Если Не РезультатЗапросПоВсемДанным.Пустой() Тогда
		Выборка = РезультатЗапросПоВсемДанным.Выбрать();    
			
		Если Выборка.Количество() = 1 Тогда   
			Выборка.Следующий();
			
			РезультатПоиска.Вставить("КарточкаНайдена", Истина);	
			РезультатПоиска.Вставить("КарточкаСсылка", Выборка.Ссылка); 
			РезультатПоиска.Вставить("КомментарийКПоиску", "Найден.");
		ИначеЕсли Выборка.Количество() > 1 Тогда
			РезультатПоиска.Вставить("КарточкаНайдена", Истина);	
			РезультатПоиска.Вставить("НайденоНесколько", Истина);
			РезультатПоиска.Вставить("КомментарийКПоиску", "Найдено несколько.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатПоиска
	
КонецФункции

Функция СтруктураНайденнаяКарточка(ДанныеСтроки, КарточкаСсылка, КомментарийКСтроке)
	
	СтруктураВозврата = Новый Структура("КомментарийКСтроке, Количество, Карточка, КарточкаНаименование, Упаковка, Характеристика, Штрихкод, Артикул", "", 0, "", "", "", "", "", "");
	
	Если ЗначениеЗаполнено(КарточкаСсылка) Тогда
		СтруктураВозврата.Вставить("Карточка", Строка(КарточкаСсылка.УникальныйИдентификатор()));  
		СтруктураВозврата.Вставить("Упаковка", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КарточкаСсылка,"УпаковкаПоклажедателя"));  
		СтруктураВозврата.Вставить("Характеристика", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КарточкаСсылка,"ХарактеристикаПоклажедателя"));
		СтруктураВозврата.Вставить("Штрихкод", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КарточкаСсылка,"Штрихкод"));
		СтруктураВозврата.Вставить("Артикул", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КарточкаСсылка,"Артикул"));
		СтруктураВозврата.Вставить("КарточкаНаименование", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КарточкаСсылка,"Наименование"));
	Иначе
		СтруктураВозврата.Вставить("Упаковка", ДанныеСтроки.Упаковка);  
		СтруктураВозврата.Вставить("Характеристика", ДанныеСтроки.Характеристика);
		СтруктураВозврата.Вставить("Штрихкод", ДанныеСтроки.Штрихкод);
		СтруктураВозврата.Вставить("Артикул", ДанныеСтроки.Артикул);
		СтруктураВозврата.Вставить("КарточкаНаименование", ДанныеСтроки.Карточка);	
	КонецЕсли;
	
	СтруктураВозврата.Вставить("КомментарийКСтроке", КомментарийКСтроке);
	СтруктураВозврата.Вставить("Количество", ДанныеСтроки.Количество);
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПроверкаШапкиФайлаЗаполнения(ТабДок)
	
	РезультатПроверки = Истина;
							
	Если ТабДок.Область(1, 1).Текст <> "Штрихкод" Тогда
		РезультатПроверки = Ложь;	
	КонецЕсли;   
	
	Если ТабДок.Область(1, 2).Текст <> "Артикул" Тогда
		РезультатПроверки = Ложь;	
	КонецЕсли;
	
	Если ТабДок.Область(1, 3).Текст <> "Карточка" Тогда
		РезультатПроверки = Ложь;	
	КонецЕсли;
	
	Если ТабДок.Область(1, 4).Текст <> "Характеристика" Тогда
		РезультатПроверки = Ложь;	
	КонецЕсли;
	
	Если ТабДок.Область(1, 5).Текст <> "Упаковка" Тогда
		РезультатПроверки = Ложь;	
	КонецЕсли;
	
	Если ТабДок.Область(1, 6).Текст <> "Количество" Тогда
		РезультатПроверки = Ложь;	
	КонецЕсли;
	
	Возврат РезультатПроверки
	
КонецФункции

Функция СписокСтатусовДокументовДляВыбора(ТипДокумента) Экспорт
	
	СписокСтатусов = Новый Массив;          
	СписокСтатусов.Добавить(Перечисления.вмс_СписокСтатусовДокументовПоклажедателей.Новый);
	СписокСтатусов.Добавить(Перечисления.вмс_СписокСтатусовДокументовПоклажедателей.Отклонен);

	Если ТипДокумента = "ВыдачаСХранения" Тогда
	    СписокСтатусов.Добавить(Перечисления.вмс_СписокСтатусовДокументовПоклажедателей.ОтбылСоСклада); 	
		СписокСтатусов.Добавить(Перечисления.вмс_СписокСтатусовДокументовПоклажедателей.ПереданНаСборку); 
	ИначеЕсли ТипДокумента = "ПередачаНаХранение"Тогда
		СписокСтатусов.Добавить(Перечисления.вмс_СписокСтатусовДокументовПоклажедателей.ПринятНаСкладе); 	           
		СписокСтатусов.Добавить(Перечисления.вмс_СписокСтатусовДокументовПоклажедателей.ОжидаетПоставки); 	
	КонецЕсли;

	Возврат СписокСтатусов;	

КонецФункции

