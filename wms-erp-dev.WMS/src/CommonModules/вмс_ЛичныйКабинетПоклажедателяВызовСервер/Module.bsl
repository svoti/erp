КонецПроцедуры 

Процедура ДобавитьКонтрагентаВЛК(КонтрагентМассив)	
	
	ДополнительныйПуть = "partners_in";
	
	Попытка
		ДанныеКонтрагент = Новый Массив;
		
		Для каждого Данные Из КонтрагентМассив Цикл   		
			ДанныеСтруктура = Новый Структура; 
			ДанныеСтруктура.Вставить("Идентификатор", Строка(Данные.УникальныйИдентификатор()));
			ДанныеСтруктура.Вставить("Наименование", Данные.Наименование);
			ДанныеСтруктура.Вставить("ИНН", Строка(Данные.ИНН));
			
			ДанныеКонтрагент.Добавить(ДанныеСтруктура);
		КонецЦикла;
		ТелоЗапроса = ЗаписатьЗначениеJSON(ДанныеКонтрагент);
		
		Ответ = ВыполнитьЗапросPOST(ДополнительныйПуть, ТелоЗапроса);
		
		Если Ответ.КодСостояния <> 200 Тогда    
			ТекстОшибки = СтрШаблон("Ошибка проверки соединения, код состояния: %1. Текст:%2", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
			
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		
		Возврат;
	КонецПопытки;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Контрагенты успешно отправлены";
	Сообщение.Сообщить();
	
КонецПроцедуры

Процедура ДобавитьПоклажедателяВЛК(ПредставительМассив)
	
	ДополнительныйПуть = "persons_in";
	
	Попытка
		ДанныеПредставитель = Новый Массив;	    
		
		Для каждого Данные Из ПредставительМассив Цикл 
			Наименование = Данные.Представитель.Наименование;
			
			АдресЭлектроннойПочты = Данные.Представитель.Почта;
			Телефон = Данные.Представитель.Телефон;
			
			Отказ = Ложь;
			
			Если Не ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
				ОбщегоНазначения.СообщитьПользователю("У представителя должен быть заполнен адрес электронной почты");  
				Отказ = Истина;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Телефон) Тогда
				ОбщегоНазначения.СообщитьПользователю("У представителя должен быть заполнен телефон");  
				Отказ = Истина;
			КонецЕсли;
			
			Телефон = "+" + СтрЗаменитьПоРегулярномуВыражению(Телефон, "[^0-9]", "");
			
			Если СтрДлина(Телефон) <> 12 Тогда
				ОбщегоНазначения.СообщитьПользователю("Некорректный номер телефона у выбранного представителя");     
				Отказ = Истина;
			КонецЕсли;		
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
			ДанныеСтруктура = Новый Структура;
			ДанныеСтруктура.Вставить("Идентификатор", Строка(Данные.Представитель.УникальныйИдентификатор()));
			ДанныеСтруктура.Вставить("Наименование", Наименование);
			ДанныеСтруктура.Вставить("Контрагент", Строка(Данные.Контрагент.УникальныйИдентификатор()));
			ДанныеСтруктура.Вставить("Телефон", Телефон);
			ДанныеСтруктура.Вставить("АдресЭлектроннойПочты", АдресЭлектроннойПочты);
			ДанныеСтруктура.Вставить("Пароль", Данные.Представитель.ПервичныйПароль);	
			ДанныеСтруктура.Вставить("ИспользованиеХарактеристик", Данные.Представитель.ИспользованиеХарактеристик);	
			
			ДанныеПредставитель.Добавить(ДанныеСтруктура);
		КонецЦикла;
		
		ТелоЗапроса = ЗаписатьЗначениеJSON(ДанныеПредставитель);	
		
		Ответ = ВыполнитьЗапросPOST(ДополнительныйПуть, ТелоЗапроса);
		
		Если Ответ.КодСостояния <> 200 Тогда    
			ТекстОшибки = СтрШаблон("Ошибка проверки соединения, код состояния: %1. Текст:%2", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
			
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		
		Возврат;
	КонецПопытки;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Поклажедатели успешно отправлены";
	Сообщение.Сообщить();
	
КонецПроцедуры

