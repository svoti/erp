					ДанныеСтрокиТЗ = Новый Структура(); 
					
					ДанныеСтрокиТЗ.Вставить("Штрихкод", ОбработатьТекст(СтрокаПолученнойТЗ.Штрихкод)); 
					ДанныеСтрокиТЗ.Вставить("Артикул", ОбработатьТекст(СтрокаПолученнойТЗ.Артикул));
					ДанныеСтрокиТЗ.Вставить("Карточка", ОбработатьТекст(СтрокаПолученнойТЗ.Карточка));
					ДанныеСтрокиТЗ.Вставить("Характеристика", ОбработатьТекст(СтрокаПолученнойТЗ.Характеристика));
					ДанныеСтрокиТЗ.Вставить("Упаковка", ОбработатьТекст(СтрокаПолученнойТЗ.Упаковка));
					ДанныеСтрокиТЗ.Вставить("Количество", ОбработатьТекст(СтрокаПолученнойТЗ.Количество));
					
					ПроверкаКолонок = СтруктураПроверокЗаполненияКолонок(ДанныеСтрокиТЗ);     
					
					Если ПроверкаКолонок.Количество Тогда
						ПроверкаКолонок.Вставить("Количество", Число(ДанныеСтрокиТЗ.Количество));
					Иначе
						ПроверкаКолонок.Вставить("Количество", 0);
					КонецЕсли;     
					
					ДанныеСтрокиТЗ.Вставить("Количество", ПроверкаКолонок.Количество);
					
					Если ПроверкаКолонок.Штрихкод = Ложь И ПроверкаКолонок.Артикул = Ложь И ПроверкаКолонок.Карточка = Ложь Тогда
						Прервать;	
					КонецЕсли;
					
					РезультатПоискаКарточки = ПоискКарточкиПоклажедателя(НайденныйКонтрагент, ДанныеСтрокиТЗ);    
					
					Если РезультатПоискаКарточки.КарточкаНайдена = Ложь Тогда 
						Если ПроверкаКолонок.Упаковка И ПроверкаКолонок.Карточка Тогда   
							РезультатСоздания = СоздатьКарточкуПоклажедателя(НайденныйКонтрагент, ДанныеСтрокиТЗ);    
							
							Если РезультатСоздания.УспешноеСоздание Тогда
								КарточкаСсылка = РезультатСоздания.Ссылка;    
								ДанныеЗаполненияТЧ = СтруктураНайденнаяКарточка(ДанныеСтрокиТЗ, КарточкаСсылка, РезультатПоискаКарточки.КомментарийКПоиску + " " + "Создана новая карточка");
							Иначе
								ДанныеЗаполненияТЧ = СтруктураНайденнаяКарточка(ДанныеСтрокиТЗ, КарточкаСсылка, РезультатПоискаКарточки.КомментарийКПоиску + " " + "Не удалось создать карточку");	
							КонецЕсли;							
						Иначе
							ДанныеЗаполненияТЧ = СтруктураНайденнаяКарточка(ДанныеСтрокиТЗ, КарточкаСсылка, РезультатПоискаКарточки.КомментарийКПоиску + " " + "Не удалось создать карточку. Отсутствуют данные обязательные для заполнения.");
						КонецЕсли;
					Иначе	
						Если РезультатПоискаКарточки.НайденоНесколько Тогда
							ДанныеЗаполненияТЧ = СтруктураНайденнаяКарточка(ДанныеСтрокиТЗ, КарточкаСсылка, РезультатПоискаКарточки.КомментарийКПоиску);
						Иначе    
							КарточкаСсылка = РезультатПоискаКарточки.КарточкаСсылка;
							ДанныеЗаполненияТЧ = СтруктураНайденнаяКарточка(ДанныеСтрокиТЗ, КарточкаСсылка, РезультатПоискаКарточки.КомментарийКПоиску);
						КонецЕсли;
					КонецЕсли;
					
					МассивЗаполненнаяТЧ.Добавить(ДанныеЗаполненияТЧ);
				КонецЦикла;	
			Иначе
				ЗаписьВЖурнал("Ошибка", СтрШаблон("В документе %1 файл для заполнения %2 не является таблицей", СтрокаМассиваДокументов.Идентификатор, СтрокаМассиваДокументов.ИмяФайлаДляЗаполнения));
				
				ЕстьОшибка = Истина;
			КонецЕсли;	
		Исключение
			Если ТекстОшибки = "" Тогда 
				ТекстОшибки = СтрШаблон("%1 %2", ДопТекст, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЗаписьВЖурнал("Ошибка", ТекстОшибки);
			Иначе
				ЗаписьВЖурнал("Ошибка", СтрШаблон("%1 %2", ДопТекст, ТекстОшибки));	
			КонецЕсли;   
			
			ЕстьОшибка = Истина;
		КонецПопытки;
		
		СтруктураЗаполненныйДокумент = Новый Структура();
		СтруктураЗаполненныйДокумент.Вставить("Идентификатор", СтрокаМассиваДокументов.Идентификатор);
		СтруктураЗаполненныйДокумент.Вставить("Контрагент", СтрокаМассиваДокументов.Контрагент);
		СтруктураЗаполненныйДокумент.Вставить("ЕстьОшибка", ЕстьОшибка);
		СтруктураЗаполненныйДокумент.Вставить("ЗаполненнаяТаблица", МассивЗаполненнаяТЧ);

        МассивЗаполненныеДокументы.Добавить(СтруктураЗаполненныйДокумент);     
	КонецЦикла;	  
	
	Возврат МассивЗаполненныеДокументы;
	
КонецФункции

