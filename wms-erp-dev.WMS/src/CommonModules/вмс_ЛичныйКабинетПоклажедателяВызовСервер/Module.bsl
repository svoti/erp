#Область Работа_со_справочниками

Процедура ОтправитьСклады(ОтправленныеДанные) Экспорт

	ДополнительныйПуть = "warehouse_in";

	Попытка
		МассивСклад = Новый Массив;	    
		
		Для каждого ЭлементМассива Из ОтправленныеДанные Цикл
			Наименование = ЭлементМассива.Наименование;
			СсылкаГУИДСтрока = Строка(ЭлементМассива.УникальныйИдентификатор());
			
			СкладСтруктура = Новый Структура;
			СкладСтруктура.Вставить("Идентификатор", СсылкаГУИДСтрока);
			СкладСтруктура.Вставить("Наименование", Наименование);
			СкладСтруктура.Вставить("ПометкаУдаления", ЭлементМассива.ПометкаУдаления);

			МассивСклад.Добавить(СкладСтруктура);
		КонецЦикла;
		
		ТелоЗапроса = ЗаписатьЗначениеJSON(МассивСклад);	
		Ответ = ВыполнитьЗапросPOST(ДополнительныйПуть, ТелоЗапроса);
		
		Если Ответ.КодСостояния <> 200 Тогда    
			ТекстОшибки = СтрШаблон("Ошибка проверки соединения, код состояния: %1. Текст:%2", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());

			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	Исключение
    	Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		
		Возврат;
	КонецПопытки;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Склады успешно отправлены";
	Сообщение.Сообщить();
	
КонецПроцедуры 

Процедура ПолучитьКарточки() Экспорт

	ТекстОшибки = "";
	ДопТекст = "Получить карточки. ";	
	
	ДополнительныйПуть = "goods_out";
		
	Попытка
		Ответ = ВыполнитьЗапросGET(ДополнительныйПуть);

		Если Ответ.КодСостояния <> 200 Тогда
        	ТекстОшибки = СтрШаблон("%1 Ошибка проверки соединения, код состояния: %2. Текст:%3", ДопТекст, Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
			
			ВызватьИсключение ТекстОшибки; 
		КонецЕсли;
		
		ДанныеОтвета = ПрочитатьЗначениеJSON(Ответ.ПолучитьТелоКакСтроку());
	Исключение
		Если ТекстОшибки = "" Тогда 
			ТекстОшибки = СтрШаблон("%1 %2", ДопТекст, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьВЖурнал("Ошибка", ТекстОшибки);
		Иначе
			ЗаписьВЖурнал("Ошибка", СтрШаблон("%1 %2", ДопТекст, ТекстОшибки));	
		КонецЕсли;
		
		Возврат;
	КонецПопытки;
		
	Если ДанныеОтвета.МассивГруппа.Количество() <> 0 Тогда
		Для каждого Группа Из ДанныеОтвета.МассивГруппа Цикл  
			Попытка
				НайденнаяГруппаСсылка = Справочники.вмс_КарточкаПоклажедателя.ПолучитьСсылку(Новый УникальныйИдентификатор(Группа.Идентификатор));
				НайденныйКонтрагентГруппы = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Группа.Контрагент));
				
				НайденнаяГруппаОбъект = НайденнаяГруппаСсылка.ПолучитьОбъект();
				
				Если НайденнаяГруппаОбъект = Неопределено Тогда
                	ГруппаОбъект = Справочники.вмс_КарточкаПоклажедателя.СоздатьГруппу(); 
					ГруппаОбъект.Заполнить(Неопределено);
					ГруппаОбъект.УстановитьСсылкуНового(НайденнаяГруппаСсылка);
				Иначе
					ГруппаОбъект = НайденнаяГруппаОбъект;
				КонецЕсли;     
				
				ГруппаОбъект.Родитель = Справочники.вмс_КарточкаПоклажедателя.НайтиПоНаименованию(НайденныйКонтрагентГруппы);    
				ГруппаОбъект.Наименование = Группа.Наименование;   
				ГруппаОбъект.ПометкаУдаления = Группа.ПометкаУдаления;
				
				ГруппаОбъект.Записать();   
			Исключение
				ТекстОшибки = СтрШаблон("%1 Массив групп. ГУИД: %2, Наименование %3. %4", ДопТекст, Группа.Идентификатор, Группа.Наименование, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьВЖурнал("Ошибка", ТекстОшибки);
				ТекстОшибки = "";
			КонецПопытки;	 
		КонецЦикла;
	КонецЕсли;
	
	ПодгруппыБезРодителя = Новый Массив;

	Если ДанныеОтвета.МассивПодгруппа.Количество() <> 0 Тогда
		Для каждого Подгруппа Из ДанныеОтвета.МассивПодгруппа Цикл 
			Попытка
				НайденнаяПодгруппаСсылка = Справочники.вмс_КарточкаПоклажедателя.ПолучитьСсылку(Новый УникальныйИдентификатор(Подгруппа.Идентификатор));
				НайденнаяПодгруппаОбъект = НайденнаяПодгруппаСсылка.ПолучитьОбъект();
				
				ПодгруппаРодительСсылка = Справочники.вмс_КарточкаПоклажедателя.ПолучитьСсылку(Новый УникальныйИдентификатор(Подгруппа.Родитель));
				
				Если ПодгруппаРодительСсылка.ПолучитьОбъект() = Неопределено Тогда
					ДанныеПодгруппы = Новый Структура;
					ДанныеПодгруппы.Вставить("Ссылка", Подгруппа.Идентификатор);  
					ДанныеПодгруппы.Вставить("Наименование", Подгруппа.Наименование); 
					ДанныеПодгруппы.Вставить("ПометкаУдаления", Подгруппа.ПометкаУдаления); 
					ДанныеПодгруппы.Вставить("Родитель", Подгруппа.Родитель);
					
					ПодгруппыБезРодителя.Добавить(ДанныеПодгруппы);    
					
					Продолжить;
				КонецЕсли;

				Если НайденнаяПодгруппаОбъект = Неопределено Тогда 
					ПодгруппаОбъект = Справочники.вмс_КарточкаПоклажедателя.СоздатьГруппу();
					ПодгруппаОбъект.Заполнить(Неопределено);
					ПодгруппаОбъект.УстановитьСсылкуНового(НайденнаяПодгруппаСсылка);
				Иначе
					ПодгруппаОбъект = НайденнаяПодгруппаОбъект;
				КонецЕсли;
				
				ПодгруппаОбъект.Наименование = Подгруппа.Наименование;     
				ПодгруппаОбъект.Родитель = ПодгруппаРодительСсылка;  
				ПодгруппаОбъект.ПометкаУдаления = Подгруппа.ПометкаУдаления;
				
				ПодгруппаОбъект.Записать();
			Исключение
				ТекстОшибки = СтрШаблон("%1 Массив подгрупп. ГУИД: %2, Наименование %3. %4", ДопТекст, Подгруппа.Идентификатор, Подгруппа.Наименование, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьВЖурнал("Ошибка", ТекстОшибки);
				ТекстОшибки = "";
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Если ПодгруппыБезРодителя.Количество() <> 0 Тогда
		Для каждого ПодгруппаБезРодителя Из ПодгруппыБезРодителя Цикл   
			Попытка
				НайденнаяПодгруппаБезРодителяСсылка = Справочники.вмс_КарточкаПоклажедателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ПодгруппаБезРодителя.Идентификатор));
				НайденнаяПодгруппаБезРодителяОбъект = НайденнаяПодгруппаБезРодителяСсылка.ПолучитьОбъект();   
				
				Если НайденнаяПодгруппаБезРодителяОбъект = Неопределено Тогда 
					ПодгруппаБезРодителяОбъект = Справочники.вмс_КарточкаПоклажедателя.СоздатьГруппу(); 
					ПодгруппаБезРодителяОбъект.УстановитьСсылкуНового(НайденнаяПодгруппаСсылка); 
				Иначе
					ПодгруппаБезРодителяОбъект = НайденнаяПодгруппаБезРодителяОбъект;
				КонецЕсли;
				
				ПодгруппаБезРодителяОбъект.Родитель = Справочники.вмс_КарточкаПоклажедателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ПодгруппаБезРодителя.Родитель)); 
				ПодгруппаБезРодителяОбъект.Наименование = ПодгруппаБезРодителя.Наименование;
				ПодгруппаБезРодителяОбъект.ПометкаУдаления = ПодгруппаБезРодителя.ПометкаУдаления;   
				
				ПодгруппаБезРодителяОбъект.Записать();
			Исключение
				ТекстОшибки = СтрШаблон("%1 Массив подгрупп без родителя. ГУИД: %2, Наименование %3. %4", ДопТекст, ПодгруппаБезРодителя.Идентификатор, ПодгруппаБезРодителя.Наименование, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьВЖурнал("Ошибка", ТекстОшибки);
				ТекстОшибки = "";
			КонецПопытки;
		КонецЦикла; 
	КонецЕсли;   
	
	Если ДанныеОтвета.МассивКарточка.Количество() <> 0 Тогда
		Для каждого Карточка Из ДанныеОтвета.МассивКарточка Цикл 
			Попытка
				НайденнаяКарточкаСсылка = Справочники.вмс_КарточкаПоклажедателя.ПолучитьСсылку(Новый УникальныйИдентификатор(Карточка.Идентификатор));
				НайденныйКонтрагентКарточки = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Карточка.Контрагент));
				НайденнаяКарточкаОбъект = НайденнаяКарточкаСсылка.ПолучитьОбъект();
				
				Если НайденнаяКарточкаОбъект = Неопределено Тогда
					КарточкаОбъект = Справочники.вмс_КарточкаПоклажедателя.СоздатьЭлемент(); 
					КарточкаОбъект.Заполнить(Неопределено);
					КарточкаОбъект.УстановитьСсылкуНового(НайденнаяКарточкаСсылка); 
				Иначе
					КарточкаОбъект = НайденнаяКарточкаОбъект; 
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Карточка.Родитель) Тогда
					КарточкаОбъект.Родитель = Справочники.вмс_КарточкаПоклажедателя.ПолучитьСсылку(Новый УникальныйИдентификатор(Карточка.Родитель));
				Иначе
					КарточкаОбъект.Родитель = Справочники.вмс_КарточкаПоклажедателя.НайтиПоНаименованию(НайденныйКонтрагентКарточки);
				КонецЕсли;  
				
				КарточкаОбъект.Контрагент = НайденныйКонтрагентКарточки;
				КарточкаОбъект.Наименование = Карточка.Наименование;
				КарточкаОбъект.Штрихкод = Карточка.Штрихкод;
				КарточкаОбъект.Артикул = Карточка.Артикул;
				КарточкаОбъект.УпаковкаПоклажедателя = Карточка.Упаковка;        
				КарточкаОбъект.БезХарактеристики = Карточка.БезХарактеристики;
				КарточкаОбъект.ПометкаУдаления = Карточка.ПометкаУдаления;
				
				Если ПроверкаИспользованияХарактеристикПоКонтрагенту(НайденныйКонтрагентКарточки) Тогда
					Если НЕ Карточка.БезХарактеристики Тогда
						КарточкаОбъект.ХарактеристикаПоклажедателя = Карточка.Характеристика;
					КонецЕсли;  
				КонецЕсли;  
				
				КарточкаОбъект.Записать();
			Исключение
				ТекстОшибки = СтрШаблон("%1 Массив карточек. ГУИД: %2, Наименование %3. %4", ДопТекст, Карточка.Идентификатор, Карточка.Наименование, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьВЖурнал("Ошибка", ТекстОшибки);
				ТекстОшибки = "";
			КонецПопытки;	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры 

Функция СоздатьКарточкуПоклажедателя(Контрагент, СтруктураДанных)
	
	СтруктураВозврата = Новый Структура("УспешноеСоздание, Ссылка", Ложь, Справочники.вмс_КарточкаПоклажедателя.ПустаяСсылка());
	
	Попытка
		КарточкаОбъект = Справочники.вмс_КарточкаПоклажедателя.СоздатьЭлемент(); 
		КарточкаОбъект.Заполнить(Неопределено);
		
		КарточкаОбъект.Наименование = СтруктураДанных.Карточка;
		КарточкаОбъект.Контрагент = Контрагент;
		КарточкаОбъект.Артикул = СтруктураДанных.Артикул;
		КарточкаОбъект.Штрихкод = СтруктураДанных.Штрихкод;
		КарточкаОбъект.УпаковкаПоклажедателя = СтруктураДанных.Упаковка;
		
		Если ПроверкаИспользованияХарактеристикПоКонтрагенту(Контрагент) Тогда
			Если ЗначениеЗаполнено(СтруктураДанных.Характеристика) Тогда
				КарточкаОбъект.ХарактеристикаПоклажедателя = СтруктураДанных.Характеристика;	
			Иначе
				КарточкаОбъект.БезХарактеристики = Истина;
			КонецЕсли;
		КонецЕсли; 	
		
		КарточкаОбъект.Записать();                        
		
		СтруктураВозврата.Вставить("УспешноеСоздание", Истина);    
		СтруктураВозврата.Вставить("Ссылка", КарточкаОбъект.Ссылка);  
	Исключение               
		СтруктураВозврата.Вставить("УспешноеСоздание", Ложь);
	КонецПопытки;
	
	Возврат	СтруктураВозврата;
	
КонецФункции

