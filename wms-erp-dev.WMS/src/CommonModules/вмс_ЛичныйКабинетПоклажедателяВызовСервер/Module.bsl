Функция ПроверкаИспользованияХарактеристикПоКонтрагенту(Контрагент) Экспорт
	
	РезультатПроверки = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	вмс_Поклажедатели.ИспользованиеХарактеристик КАК ИспользованиеХарактеристик
		|ИЗ
		|	Справочник.вмс_Поклажедатели КАК вмс_Поклажедатели
		|ГДЕ
		|	вмс_Поклажедатели.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);      
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий(); 
		
		Если Выборка.ИспользованиеХарактеристик Тогда
			РезультатПроверки = Истина;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатПроверки;
		
КонецФункции

