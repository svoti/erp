Процедура ОтправитьОстаткиПоКарточкам() Экспорт
	
	ТекстОшибки = "";
	ДопТекст = "Остатки по карточкам. ";
	
	Попытка
		ДополнительныйПуть = "remains_in";
		
		МассивОстатки = Новый Массив;	    
		МассивМассивовОстаткиПослеРазбиения = Новый Массив;
		МассивДляОбмена = Новый Массив;
		СтруктураДляОбмена = Новый Структура("МассивОстатки, ИндексОбмена");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	вмс_ОстаткиТоваровПоклажедателяОстатки.Номенклатура КАК Номенклатура,
		|	вмс_ОстаткиТоваровПоклажедателяОстатки.Контрагент КАК Контрагент,
		|	вмс_ОстаткиТоваровПоклажедателяОстатки.Склад КАК Склад,
		|	СУММА(вмс_ОстаткиТоваровПоклажедателяОстатки.КоличествоОстаток) КАК Количество
		|ИЗ
		|	РегистрНакопления.вмс_ОстаткиТоваровПоклажедателя.Остатки КАК вмс_ОстаткиТоваровПоклажедателяОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	вмс_ОстаткиТоваровПоклажедателяОстатки.Номенклатура,
		|	вмс_ОстаткиТоваровПоклажедателяОстатки.Контрагент,
		|	вмс_ОстаткиТоваровПоклажедателяОстатки.Склад";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				КарточкаГУИДСтрока = Строка(Выборка.Номенклатура.УникальныйИдентификатор());
				СкладГУИДСтрока = Строка(Выборка.Склад.УникальныйИдентификатор());
                КонтрагентГУИДСтрока = Строка(Выборка.Контрагент.УникальныйИдентификатор());
                Количество = Выборка.Количество;

				ОстаткиСтруктура = Новый Структура;
				ОстаткиСтруктура.Вставить("Карточка", КарточкаГУИДСтрока);
				ОстаткиСтруктура.Вставить("Склад", СкладГУИДСтрока);
				ОстаткиСтруктура.Вставить("Контрагент", КонтрагентГУИДСтрока);
				ОстаткиСтруктура.Вставить("Количество", Количество);
				
				МассивОстатки.Добавить(ОстаткиСтруктура);
			КонецЦикла;
		КонецЕсли;   

		ИндексОбмена = 0;  
	Исключение
		Если ТекстОшибки = "" Тогда 
			ТекстОшибки = СтрШаблон("%1 %2", ДопТекст, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьВЖурнал("Ошибка", ТекстОшибки);
		Иначе
			ЗаписьВЖурнал("Ошибка", СтрШаблон("%1 %2", ДопТекст, ТекстОшибки));	
		КонецЕсли; 
		
		Возврат;
	КонецПопытки;
	
	Если МассивОстатки.Количество() <> 0 Тогда
		МассивМассивовОстаткиПослеРазбиения = РазбиениеМассива(МассивОстатки, 2000);
		
		Для каждого ЭлементМассива Из МассивМассивовОстаткиПослеРазбиения Цикл
			Попытка
				СтруктураДляОбмена.Вставить("МассивОстатки",ЭлементМассива);     
				СтруктураДляОбмена.Вставить("ИндексОбмена", ИндексОбмена);
				
				МассивДляОбмена.Добавить(СтруктураДляОбмена);
				
				ТелоЗапроса = ЗаписатьЗначениеJSON(МассивДляОбмена);	
				Ответ = ВыполнитьЗапросPOST(ДополнительныйПуть, ТелоЗапроса); 
				
				ИндексОбмена = ИндексОбмена + 1;
				
				Если Ответ.КодСостояния <> 200 Тогда    
					ТекстОшибки = СтрШаблон("Ошибка проверки соединения, код состояния: %1. Текст:%2", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
					
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
			Исключение
				Если ТекстОшибки = "" Тогда 
					ТекстОшибки = СтрШаблон("%1 %2", ДопТекст, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ЗаписьВЖурнал("Ошибка", ТекстОшибки);
				Иначе
					ЗаписьВЖурнал("Ошибка", СтрШаблон("%1 %2", ДопТекст, ТекстОшибки));	
				КонецЕсли;

				ИндексОбмена = ИндексОбмена + 1;

				Продолжить;
			КонецПопытки;	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередатьСтатусДокумента(Док, ТипДок) Экспорт
	
	ТекстОшибки = "";  
	ДопТекст = СтрШаблон("Статус документа(%1)", ТипДок);
	ДополнительныйПуть = "status_in";

	Попытка
		ДанныеДокумента = Новый Массив;
		
		ДанныеДокументаСтруктура = Новый Структура; 
		ДанныеДокументаСтруктура.Вставить("ТипДокумента", ТипДок); 
		ДанныеДокументаСтруктура.Вставить("Идентификатор", Строка(Док.УникальныйИдентификатор()));
		ДанныеДокументаСтруктура.Вставить("Статус", Док.Статус.Метаданные().ЗначенияПеречисления.Получить(Перечисления[Док.Статус.Метаданные().Имя].Индекс(Док.Статус)).Имя);	
		ДанныеДокументаСтруктура.Вставить("НомерДокумента", Док.Номер);	
		
		ДанныеДокумента.Добавить(ДанныеДокументаСтруктура);
		
		ТелоЗапроса = ЗаписатьЗначениеJSON(ДанныеДокумента);	
		
		Ответ = ВыполнитьЗапросPOST(ДополнительныйПуть, ТелоЗапроса);
		
		Если Ответ.КодСостояния <> 200 Тогда
        	ТекстОшибки = ДопТекст + СтрШаблон("Ошибка проверки соединения, код состояния: %1. Текст:%2", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
			ВызватьИсключение ТекстОшибки; 
		КонецЕсли;                   
	Исключение
		Если ТекстОшибки = "" Тогда 
			ТекстОшибки = СтрШаблон("%1 %2", ДопТекст, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьВЖурнал("Ошибка", ТекстОшибки);
		Иначе
			ЗаписьВЖурнал("Ошибка", СтрШаблон("%1 %2", ДопТекст, ТекстОшибки));	
		КонецЕсли;	
	КонецПопытки;
		
КонецПроцедуры

Процедура ВыгрузитьДокПередачаНаХранение() Экспорт

	ТекстОшибки = "";
	ДопТекст = "Выгрузить документы: передача на хранение. ";  
	
	ДополнительныйПуть = "for_storage_out";
	
	Попытка
		Ответ = ВыполнитьЗапросGET(ДополнительныйПуть);
		Если Ответ.КодСостояния <> 200 Тогда
			ТекстОшибки = СтрШаблон("%1 Ошибка проверки соединения, код состояния: %2. Текст:%3", ДопТекст, Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
			
			ВызватьИсключение ТекстОшибки; 
		КонецЕсли;
		
		ДанныеОтвета = ПрочитатьЗначениеJSON(Ответ.ПолучитьТелоКакСтроку());
	Исключение
		Если ТекстОшибки = "" Тогда 
			ТекстОшибки = СтрШаблон("%1 %2", ДопТекст, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьВЖурнал("Ошибка", ТекстОшибки);
		Иначе
			ЗаписьВЖурнал("Ошибка", СтрШаблон("%1 %2", ДопТекст, ТекстОшибки));	
		КонецЕсли;
		
		Возврат;
	КонецПопытки;
	
	Для Каждого ДанныеДок Из ДанныеОтвета Цикл
		Попытка
			НайденныйДокСсылка = Документы.вмс_ПередачаНаХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеДок.Идентификатор));
			НайденныйДокОбъект = НайденныйДокСсылка.ПолучитьОбъект();
			
			Если НайденныйДокОбъект = Неопределено Тогда
				ДокОбъект = Документы.вмс_ПередачаНаХранение.СоздатьДокумент();	
				ДокОбъект.Заполнить(Неопределено);
				ДокОбъект.УстановитьСсылкуНового(НайденныйДокСсылка);
			Иначе
				ДокОбъект = НайденныйДокОбъект;	
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			
			ДвДанныеВнешнийфайл = Base64Значение(ДанныеДок.ВнешнийФайл);
			ДокОбъект.ИмяВнешнегоФайла = ДанныеДок.ИмяВнешнегоФайла;
			ДокОбъект.ВнешнийФайл = Новый ХранилищеЗначения(ДвДанныеВнешнийфайл);

			ДвДанныеФайлДляЗаполнения = Base64Значение(ДанныеДок.ФайлДляЗаполнения);
			ДокОбъект.ИмяФайлаДляЗаполнения = ДанныеДок.ИмяФайлаДляЗаполнения;
			ДокОбъект.ФайлДляЗаполнения = Новый ХранилищеЗначения(ДвДанныеФайлДляЗаполнения);

			ДокОбъект.Статус = Перечисления["вмс_СписокСтатусовДокументовПоклажедателей"][ДанныеДок.Статус]; 
			ДокОбъект.ПометкаУдаления = ДанныеДок.ПометкаУдаления; 
			ДокОбъект.Комментарий = ДанныеДок.Комментарий;
			ДокОбъект.Контрагент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеДок.Контрагент));
			ДокОбъект.Ответственный = Справочники.вмс_Поклажедатели.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеДок.Представитель));
			ДокОбъект.Склад = Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеДок.Склад));

			ДатаСтр = СтрЗаменить(ДанныеДок.Дата, "T", "");
			ДатаСтр = СтрЗаменить(ДатаСтр, "-", "");
			ДатаСтр = СтрЗаменить(ДатаСтр, ":", "");
			Вхождение = СтрНайти(ДатаСтр, ".");

			Если Вхождение <> 0 Тогда
				ПолученнаяДата = Лев(ДатаСтр, Вхождение - 1);	
			Иначе
				ПолученнаяДата = ДатаСтр;
			КонецЕсли;   
			
			ДокОбъект.Дата = Дата(ПолученнаяДата); 
			
			ДокОбъект.Товары.Очистить();
			
			Для Каждого ОписаниеСтроки Из ДанныеДок.МассивТовары Цикл
				НоваяСтрока = ДокОбъект.Товары.Добавить();
				НоваяСтрока.НоменклатураПоклажедателя = Справочники.вмс_КарточкаПоклажедателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ОписаниеСтроки.Карточка));
				НоваяСтрока.КоличествоПлан = ОписаниеСтроки.Количество;	        
				НоваяСтрока.КоличествоФакт = ОписаниеСтроки.Количество;	
				НоваяСтрока.Номенклатура = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.НоменклатураПоклажедателя, "Номенклатура");
				НоваяСтрока.Характеристика = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.НоменклатураПоклажедателя, "Характеристика");
				НоваяСтрока.Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.НоменклатураПоклажедателя, "Упаковка");
			КонецЦикла;      
			
			Если ДокОбъект.ПометкаУдаления Тогда   
				Попытка
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);	
				Исключение
