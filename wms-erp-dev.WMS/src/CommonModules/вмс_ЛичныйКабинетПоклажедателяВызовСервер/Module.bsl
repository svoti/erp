Функция СоздатьТоварПоклажедателя(ДанныеТовара) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// ТУ_Кошелев 09.01.25 - адаптация конфигураций для получения типа номенклатуры
	ЭтоУТ =  вмс_АдаптацияКонфигураций.ЭтоУТ();  
	ЭтоЕРП = вмс_АдаптацияКонфигураций.ЭтоЕРП();
	ЭтоУНФ = вмс_АдаптацияКонфигураций.ЭтоУНФ();
	УстановитьКатегорию = ЭтоУТ ИЛИ ЭтоУНФ;

	Если ЭтоУТ ИЛИ ЭтоЕРП Тогда
		ВидНоменклатурыТовара = Справочники.ВидыНоменклатуры.ВидНоменклатурыПоУмолчанию();
	ИначеЕсли ЭтоУНФ Тогда
		ВидНоменклатурыТовара = Справочники.КатегорииНоменклатуры.БезКатегории;
	КонецЕсли;    
	
	Если УстановитьКатегорию И ВидНоменклатурыТовара = Неопределено Тогда	
		ВидНоменклатурыТовара = ПолучитьВидНоменулатурыСТипомТовар();
		Если ВидНоменклатурыТовара = Неопределено Тогда
			Возврат Неопределено;			
		КонецЕсли;
	КонецЕсли;  
	
	НовыйТовар = Справочники.Номенклатура.СоздатьЭлемент();    
	НовыйТовар.Заполнить(Неопределено);
	
	НаименованиеТовара = Строка(ДанныеТовара.Контрагент) + "_" + СокрЛП(ДанныеТовара.Товар);  
	НовыйТовар.Наименование = НаименованиеТовара;
	НовыйТовар.НаименованиеПолное = НаименованиеТовара;
	
	// ТУ_Прошин_09.08.24+
	НовыйТовар.Родитель = ПолучитьГруппуТоваровПоклажедателя(ДанныеТовара.Контрагент);  
	// ТУ_Прошин_09.08.24-
	
	Если ЭтоУТ ИЛИ ЭтоЕРП Тогда
		НовыйТовар.ВидНоменклатуры = ВидНоменклатурыТовара;
	ИначеЕсли ЭтоУНФ Тогда
		НовыйТовар.КатегорияНоменклатуры = ВидНоменклатурыТовара;
	КонецЕсли;
	
	Если СтрДлина(СокрЛП(ДанныеТовара.Артикул)) > 0 Тогда
		НовыйТовар.Артикул = ДанныеТовара.Артикул;	
	КонецЕсли;
	//
	Если ЭтоУТ ИЛИ ЭтоЕРП Тогда
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(НовыйТовар);
	КонецЕсли;
	//      
	Если НЕ ЗначениеЗаполнено(НовыйТовар.ЕдиницаИзмерения) Тогда
		ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("шт");
		//Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		//
		//	//ЕдиницаИзмерения = ПолучитьСуществующуюЕдиницуИзмерения(); 	
		//
		//КонецЕсли;
		НовыйТовар.ЕдиницаИзмерения = ЕдиницаИзмерения;	
		
	КонецЕсли;
	//НовыйТовар.ЕдиницаИзмерения = ЕдиницаИзмерения; 
	НовыйТовар.Записать();
	Если СтрДлина(СокрЛП(ДанныеТовара.Штрихкод)) > 0 Тогда
		СоздатьШтрихкодТовара(НовыйТовар.Ссылка, ДанныеТовара.Штрихкод);
	КонецЕсли;
	ЗаписатьДанныеВРегистрТоварыПоклажедателей(НовыйТовар.Ссылка, ДанныеТовара);
	
	ДанныеТовара = ЗаписатьДанныеОТовареВСтруктуру(НовыйТовар);
	
	Возврат ДанныеТовара;
КонецФункции

Функция ЗаписатьДанныеОТовареВСтруктуру(Товар)
	
	ДанныеТовара = Новый Структура();
	ДанныеТовара.Вставить("Номенклатура", Товар.Ссылка);
	
	Возврат ДанныеТовара;
	
КонецФункции

Функция ПолучитьВидНоменулатурыСТипомТовар()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	НЕ ВидыНоменклатуры.ПометкаУдаления
	|	И НЕ ВидыНоменклатуры.ЭтоГруппа
	|	И ВидыНоменклатуры.ТипНоменклатуры = &ТипНоменклатурыТовар";
	
	Запрос.УстановитьПараметр("ТипНоменклатурыТовар", Перечисления.ТипыНоменклатуры.Товар);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.ВидНоменклатуры;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура СоздатьШтрихкодТовара(Товар, Штрихкод)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйШтрихкод = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();	
	НовыйШтрихкод.Заполнить(Неопределено);
	НовыйШтрихкод.Штрихкод = Штрихкод;
	НовыйШтрихкод.Номенклатура = Товар;
	НовыйШтрихкод.Записать();
	
КонецПроцедуры

Процедура ЗаписатьДанныеВРегистрТоварыПоклажедателей(Товар, ДанныеТовара)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйТовар = РегистрыСведений.вмс_ТоварыПоклажедателей.СоздатьМенеджерЗаписи();	  
	НовыйТовар.Заполнить(Неопределено);
	НовыйТовар.Товар = Товар;
	НовыйТовар.Контрагент = ДанныеТовара.Контрагент;
	НовыйТовар.Организация = ДанныеТовара.Организация;
	НовыйТовар.Записать();
	
КонецПроцедуры

Функция ПроверитьНаРольПоклажедателя() Экспорт
	ЭтоПоклажедатель = Ложь; 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗапросРегистра = РегистрыСведений.вмс_СписокПоклажедателей.СоздатьНаборЗаписей();
	ЗапросРегистра.Заполнить(Неопределено);
	ЗапросРегистра.Отбор.Пользователь.Установить(Пользователи.ТекущийПользователь());
	ЗапросРегистра.Прочитать();
	
	Если ЗапросРегистра.Количество() > 0 И РольДоступна("вмс_Поклажедатель_ПолныеПрава") Тогда
		ЭтоПоклажедатель = Истина;		
	КонецЕсли;
	
	Возврат ЭтоПоклажедатель;
КонецФункции

Функция ПолучитьГруппуТоваровПоклажедателя(Контрагент) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &Наименование
	|	И Номенклатура.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("Наименование", Строка(Контрагент));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();   
		ГруппаКонтрагента = Выборка.Ссылка;
	Иначе
		НоваяГруппа = Справочники.Номенклатура.СоздатьГруппу();
		НоваяГруппа.Наименование = Строка(КОнтрагент);
		НоваяГруппа.Записать(); 
		ГруппаКонтрагента = НоваяГруппа.Ссылка;
	КонецЕсли;  
	
	Возврат ГруппаКонтрагента; 
	
КонецФункции

