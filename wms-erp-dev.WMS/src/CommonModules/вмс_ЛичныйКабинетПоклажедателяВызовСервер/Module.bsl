Процедура ОтправитьДокПередачаНаХранение(Док) Экспорт
	
	ТекстОшибки = "";
	ДопТекст = "Отправить документы: передача на хранение. ";

	ДополнительныйПуть = "for_storage_in";
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.НоменклатураПоклажедателя КАК НоменклатураПоклажедателя,
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.КоличествоПлан КАК КоличествоПлан,
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.КоличествоФакт КАК КоличествоФакт
		|ИЗ
		|	Документ.вмс_ПередачаНаХранение.Товары КАК вмс_ПередачаНаХранениеСписокНоменклатуры
		|ГДЕ
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Док);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		МассивСписокТЧ = Новый Массив;    
		МассивДанных = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			СтруктураСписокТЧ = Новый Структура();
			СтруктураСписокТЧ.Вставить("Карточка", Строка(Выборка.НоменклатураПоклажедателя.УникальныйИдентификатор()));
			СтруктураСписокТЧ.Вставить("КоличествоПлан", Выборка.КоличествоПлан);
			СтруктураСписокТЧ.Вставить("КоличествоФакт", Выборка.КоличествоФакт);       
			
			МассивСписокТЧ.Добавить(СтруктураСписокТЧ);
		КонецЦикла;
		
		СтуктураДанных = Новый Структура;
		СтуктураДанных.Вставить("Идентификатор", Строка(Док.УникальныйИдентификатор()));
		СтуктураДанных.Вставить("Статус", Док.Статус.Метаданные().ЗначенияПеречисления.Получить(Перечисления[Док.Статус.Метаданные().Имя].Индекс(Док.Статус)).Имя);
        СтуктураДанных.Вставить("ЕстьРасхождение", Док.ЕстьРасхождение);
		СтуктураДанных.Вставить("МассивТовары", МассивСписокТЧ);
		
		МассивДанных.Добавить(СтуктураДанных);
		
		ТелоЗапроса = ЗаписатьЗначениеJSON(МассивДанных);	
		Ответ = ВыполнитьЗапросPOST(ДополнительныйПуть, ТелоЗапроса);
		
		Если Ответ.КодСостояния <> 200 Тогда    
			ТекстОшибки = СтрШаблон("Ошибка проверки соединения, код состояния: %1. Текст:%2", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
			
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	Исключение
		Если ТекстОшибки = "" Тогда 
			ТекстОшибки = СтрШаблон("%1 %2", ДопТекст, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьВЖурнал("Ошибка", ТекстОшибки);
		Иначе
			ЗаписьВЖурнал("Ошибка", СтрШаблон("%1 %2", ДопТекст, ТекстОшибки));	
		КонецЕсли;	
	КонецПопытки;
	
КонецПроцедуры

