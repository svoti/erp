Функция ПолучитьСоединенияРабочегоПроцесса(ПодключениеКПроцессу) Экспорт

	ИнформационнаяБаза = ПодключениеКПроцессу.CreateInfoBaseInfo();
	ИнформационнаяБаза.Name = ПолучитьИмяЭтойБазы();
	СоединенияБазы = ПодключениеКПроцессу.GetInfoBaseConnections(ИнформационнаяБаза);
	
	Возврат СоединенияБазы;
	
КонецФункции
	
Функция ПолучитьПодключенияКРабочииПроцессамСервера() Экспорт
	
	ИмяСервера = "localhost";
	Коннектор = Новый COMОбъект("v83.COMConnector");

	Агент = Коннектор.ConnectAgent(ИмяСервера);
	
	Кластеры = Агент.GetClusters();
	
	Логин = "вмс_Obmen";
	Пароль = "!password";
	
	ПодключенияКПроцессам = Новый Массив;
	Для Каждого Кластер Из Кластеры Цикл
		Агент.Authenticate(Кластер, "", "");
		Процессы = Агент.GetWorkingProcesses(Кластер);
		Для Каждого Процесс Из Процессы Цикл
			ПодключениеКПроцессу = Коннектор.ConnectWorkingProcess(ИмяСервера + ":" + СтрЗаменить(Процесс.MainPort, Символы.НПП, ""));
			ПодключениеКПроцессу.AddAuthentication(Логин, Пароль);
			ПодключенияКПроцессам.Добавить(ПодключениеКПроцессу);
		КонецЦикла;

	КонецЦикла;
	
	Возврат ПодключенияКПроцессам;
	
КонецФункции

Функция ПолучитьИмяЭтойБазы() Экспорт

	ИмяБазы = СтрокаСоединенияИнформационнойБазы();
	Позиция = СтрНайти(ИмяБазы, "Ref=");
	Если Позиция=0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяБазы = Сред(ИмяБазы, Позиция+4);
	ИмяБазы = СтрЗаменить(ИмяБазы, """", "");
	Если Прав(ИмяБазы, 1)=";" Тогда
		ИмяБазы = Лев(ИмяБазы, СтрДлина(ИмяБазы)-1);
	КонецЕсли;

	Возврат ИмяБазы;
	
КонецФункции

