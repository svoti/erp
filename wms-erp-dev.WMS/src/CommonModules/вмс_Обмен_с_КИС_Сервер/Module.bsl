
Функция ПолучитьРезультатЗапроса(ОписаниеЗапроса) Экспорт
	
	Запрос = ПолучитьЗапросИзОписанияЗапроса(ОписаниеЗапроса);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ПолучитьЗапросИзОписанияЗапроса(ОписаниеЗапроса) Экспорт
	
	Если ТипЗнч(ОписаниеЗапроса)=Тип("Строка") Тогда
		Запрос = Новый Запрос(ОписаниеЗапроса);
	Иначе
		Запрос = Новый Запрос(ОписаниеЗапроса.Текст);
		ПараметрыЗапроса = Неопределено;
		Если ОписаниеЗапроса.Свойство("Параметры", ПараметрыЗапроса) И ТипЗнч(ПараметрыЗапроса) = Тип("Структура") Тогда
			Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
				Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

