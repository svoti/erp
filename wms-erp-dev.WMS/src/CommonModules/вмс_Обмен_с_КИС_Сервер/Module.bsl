Функция ПредОбработкаМетодаОбмена(ОписаниеМетода) Экспорт
	
	вмс_Обмен_с_КИС_ВызовСервера.ПреобразоватьДанныеПослеПолучения(ОписаниеМетода.Параметры);
	
КонецФункции

Функция ПостОбработкаМетодаОбмена(ДанныеВыполнения) Экспорт
	
	Если ДанныеВыполнения.Результат <> Неопределено Тогда
		
		вмс_Обмен_с_КИС_ВызовСервера.ПреобразоватьДанныеПередОтправкой(ДанныеВыполнения.Результат);
		
	КонецЕсли;
	
КонецФункции

Функция РаспаковатьВходящиеДанные(ВходящиеДанные) Экспорт
	
	Данные = ВходящиеДанные;
	Сообщение = ПрочитатьЗаголовокДанных(Данные);
	Если Сообщение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Сообщение.ТипДанных = "XML" Тогда
		
		СтрокаXML = вмс_ОбщегоНазначенияСервер.РазкодироватьСтрокуИзBase64(Данные);
		РаспакованныеДанные = вмс_РаботаСXMLКлиентСервер.ПрочитатьТекстXMLУлучшенная(СтрокаXML);
		
	ИначеЕсли Сообщение.ТипДанных = "ValueStorage" Тогда
		
		ХранилищеЗначения = XMLЗначение(Тип("ХранилищеЗначения"), Данные);
		РаспакованныеДанные = ХранилищеЗначения.Получить();
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Сообщение.Вставить("Данные", РаспакованныеДанные);
	
	Возврат Сообщение;
	
КонецФункции

Функция УпаковатьИсходящиеДанные(ИсходящиеДанные, ТипДанных) Экспорт
	
	Если ТипДанных = "XML" Тогда
		
		СтрокаXML = вмс_РаботаСXMLКлиентСервер.XMLСтрокаИзЗначенияУлучшенная(ИсходящиеДанные, Ложь);
		УпакованныеДанные = вмс_ОбщегоНазначенияСервер.ЗакодироватьСтрокуВBase64(СтрокаXML);
		
	ИначеЕсли ТипДанных = "ValueStorage" Тогда
		
		ХранилищеЗначения = Новый ХранилищеЗначения(ИсходящиеДанные, Новый СжатиеДанных(9));
		УпакованныеДанные = XMLСтрока(ХранилищеЗначения);
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли; 
	
	ЗаголовокДанных = "Content-Type: " + ТипДанных;
	УпакованныеДанные = ЗаголовокДанных + Символы.ПС + УпакованныеДанные;
	
	Возврат УпакованныеДанные;
	
КонецФункции

Функция ПрочитатьЗаголовокДанных(Данные)
	
	ПозицияКонцаСтроки = СтрНайти(Данные, Символы.ПС);
	Если ПозицияКонцаСтроки = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаЗаголовка = Лев(Данные, ПозицияКонцаСтроки-1);
	
	ДанныеЗаголовка =  вмс_РаботаСКоллекциями.СтрокуВМассив(СтрокаЗаголовка, ":");
	
	Если ДанныеЗаголовка.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДанныеЗаголовка[0] <> "Content-Type" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипДанных = ДанныеЗаголовка[1];

	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ТипДанных", ТипДанных);
	
	Данные = Прав(Данные, СтрДлина(Данные)-ПозицияКонцаСтроки);
	
	Возврат СтруктураЗаголовка;
	
КонецФункции

