Функция ВыполнитьОбмен(ТекстСообщения) Экспорт

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстСообщения);
	ЧтениеСообщения = ПланыОбмена.СоздатьЧтениеСообщения();
	ЧтениеСообщения.НачатьЧтение(ЧтениеXML);

	Отправитель = ЧтениеСообщения.Отправитель;
	ПланыОбмена.УдалитьРегистрациюИзменений(Отправитель, ЧтениеСообщения.НомерПринятого);
	вмс_РаботаСXMLВызовСервера.ЗагрузитьОбъектыИзXML(ЧтениеXML, ЧтениеСообщения.Отправитель);
	ЧтениеСообщения.ЗакончитьЧтение();
	ЧтениеXML.Закрыть();
	
	/////////////////////////////////////////////////////////////////
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.Отступ = Ложь;
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML, Отправитель);
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(Отправитель, ЗаписьСообщения.НомерСообщения, ПолучитьМетаданныеОбъектовДляОбмена());
	МассивОбъектов = Новый Массив;
	Пока ВыборкаИзменений.Следующий() Цикл
		ОбъектОбмена = ВыборкаИзменений.Получить();
		МассивОбъектов.Добавить(ОбъектОбмена);
	КонецЦикла;
	вмс_РаботаСXMLКлиентСервер.ЗаписатьXMLУлучшенная(ЗаписьXML, МассивОбъектов);
	ЗаписьСообщения.ЗакончитьЗапись();
	ТекстОбмена = ЗаписьXML.Закрыть();
	Возврат ТекстОбмена;
	

КонецФункции

Функция ПолучитьМетаданныеОбъектовДляОбмена()
	
	СписокОбъектов = Новый Массив;
	
	Для Каждого Объект Из Метаданные.ПланыОбмена.МобильныйОбмен.Состав Цикл
		СписокОбъектов.Добавить(Объект.Метаданные);
	КонецЦикла;
	
	Возврат СписокОбъектов;
	
КонецФункции

Функция ВыгрузитьОбъектыПоОписаниюЗапроса(ОписаниеЗапроса) Экспорт
	
	Возврат ВыгрузитьОбъектыПоЗапросу(ПолучитьЗапросИзОписанияЗапроса(ОписаниеЗапроса));
	
КонецФункции

Функция ВыгрузитьОбъектыПоЗапросу(Запрос) Экспорт
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	МассивСсылок = вмс_Обмен_с_КИС_ВызовСервера.ПолучитьМассивСсылокИБВДанных(ТаблицаРезультата);
	Возврат ВыгрузитьОбъектыПоСсылкамВXML(МассивСсылок);
	
КонецФункции

Функция ВыгрузитьОбъектыПоСсылкамВXML(Ссылки) Экспорт
	
	МассивСсылок = вмс_РаботаСКоллекциями.ЗначениеВМассив(Ссылки, , Ложь);
	МассивОбъектов = Новый Массив;
	
	ВыгруженныеСсылки = Новый Соответствие;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.Отступ = Ложь;
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("ВыгрузкаОбъектов");
	Для Каждого Ссылка Из МассивСсылок Цикл
		
		Если ВыгруженныеСсылки[Ссылка] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если вмс_ОбщегоНазначенияВызовСервера.ЭтоЗначениеПеречисления(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Объект.Прочитать();
		
		МассивОбъектов.Добавить(Объект);
		
		//вмс_РаботаСXMLВызовСервера.ЗаписатьОбъектВXML(ЗаписьXML, Объект);
		ВыгруженныеСсылки[Ссылка] = Истина;
		
	КонецЦикла;
	
	вмс_РаботаСXMLКлиентСервер.ЗаписатьXMLУлучшенная(ЗаписьXML, МассивОбъектов);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции
	
