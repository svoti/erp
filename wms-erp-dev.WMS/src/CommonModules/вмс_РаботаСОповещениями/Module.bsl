// Процедура ДобавитьПроизвольноеОповещение(ТекстОповещения)
//
// Параметры:
//  ТекстОповещения - Строка - текст оповещения для отправки пользователям
//
// Возвращаемое значение:
//  Не возвращает значение
//
// Описание:
//  Добавляет произвольное оповещение для всех пользователей, указанных в списке получателей.
//  Оповещение записывается в регистр сведений "вмс_ОчередьОповещений" для каждого пользователя.
//  Если список пользователей пуст, процедура завершает работу без выполнения действий.
//
Процедура ДобавитьПроизвольноеОповещение(ТекстОповещения) Экспорт
	
	СписокПользователей = ПолучитьСписокПользователейОповещенийТСД();
	
	Если СписокПользователей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Пользователь Из СписокПользователей Цикл 
		МенеджерЗаписи = РегистрыСведений.вмс_ОчередьОповещений.СоздатьМенеджерЗаписи(); 
		МенеджерЗаписи.Заполнить(Неопределено);
		МенеджерЗаписи.Пользователь = Пользователь; 
		МенеджерЗаписи.ТекстОповещения = ТекстОповещения;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Отправляет оповещение о выполнении операции указанным пользователям ТСД.
//
// Параметры:
//  ВходящиеПараметры - Структура:
//   * Документ - ДокументСсылка - документ, по которому выполнена операция
//   * ВидОперации - Строка - вид выполненной операции
//   * ДокументТСД - ДокументСсылка - документ ТСД, связанный с операцией
//   * Ответственный - Строка - ФИО ответственного за операцию
//
// Возвращаемое значение:
//  Не возвращает значение
//
// Описание:
//  Формирует и записывает в регистр сведений "вмс_ОчередьОповещений" оповещение
//  о выполненной операции для каждого пользователя из списка получателей.
//  Если список пользователей пуст, процедура завершает работу без действий.
//
Процедура ДобавитьОповещениеВыполнениеОперации(ВходящиеПараметры) Экспорт
	
	СписокПользователей = ПолучитьСписокПользователейОповещенийТСД();
	
	Если СписокПользователей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Пользователь Из СписокПользователей Цикл 
		МенеджерЗаписи = РегистрыСведений.вмс_ОчередьОповещений.СоздатьМенеджерЗаписи(); 
		МенеджерЗаписи.Заполнить(Неопределено);
		МенеджерЗаписи.Пользователь = Пользователь; 
		МенеджерЗаписи.Документ = ВходящиеПараметры.Документ; 
		МенеджерЗаписи.ВидОперации = ВходящиеПараметры.ВидОперации;
		МенеджерЗаписи.ОперацияПоЯчейкам = ВходящиеПараметры.ДокументТСД; 
		МенеджерЗаписи.Ответственный = ВходящиеПараметры.Ответственный;
		МенеджерЗаписи.ТекстОповещения = СтрШаблон("Выполнена операция %1 по документу %2. Оператор %3", ВходящиеПараметры.ДокументТСД, ВходящиеПараметры.Документ, ВходящиеПараметры.Ответственный);
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Возвращает список пользователей для рассылки оповещений ТСД.
//
// Параметры:
//  Отсутствуют
//
// Возвращаемое значение:
//  Массив - список пользователей из регистра получателей оповещений.
//            Если нет прав доступа, возвращает пустой массив.
//
// Описание:
//  Получает список пользователей из регистра сведений "вмс_СписокПолучателейОповещений".
//  Перед выполнением проверяет наличие прав у текущего пользователя.
//  Использует привилегированный режим для доступа к защищенным данным.
//
Функция ПолучитьСписокПользователейОповещенийТСД() Экспорт
	
	МассивПользователей = Новый Массив;
	
	Если НЕ вмс_РаботаСПользователямиСервер.ПроверитьПраваНаВМС() Тогда
		Возврат МассивПользователей;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	РК = вмс_РаботаСКоллекциями;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_СписокПолучателейОповещений.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.вмс_СписокПолучателейОповещений КАК вмс_СписокПолучателейОповещений";
	
	ТаблицаПользователей = Запрос.Выполнить().Выгрузить(); 	
	МассивПользователей = РК.ВыгрузитьЗначенияКолонкиКоллекции(ТаблицаПользователей, "Пользователь");
	
	Возврат МассивПользователей; 
	
КонецФункции

// Проверяет наличие прав у текущего пользователя на получение оповещений ТСД.
//
// Параметры:
//  Отсутствуют
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь есть в списке получателей оповещений
//            и имеет необходимые права. Ложь - в противном случае.
//
// Описание:
//  Проверяет наличие текущего пользователя в регистре сведений
//  "вмс_СписокПолучателейОповещений". Перед проверкой
//  подтверждает общие права доступа к модулю ВМС.
//  Использует привилегированный режим для доступа к защищенным данным.
//
Функция ЕстьПравоПолучатьОповещения() Экспорт
	
	Если НЕ вмс_РаботаСПользователямиСервер.ПроверитьПраваНаВМС() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.вмс_СписокПолучателейОповещений.СоздатьНаборЗаписей();
	НаборЗаписей.Заполнить(Неопределено);
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователи.ТекущийПользователь()); 
	НаборЗаписей.Прочитать();
	
	Возврат НаборЗаписей.Количество() > 0;
	
КонецФункции

// Возвращает список непрочитанных оповещений для текущего пользователя с проверкой прав доступа.
//
// Параметры:
//  Отсутствуют
//
// Возвращаемое значение:
//  Массив из Структура - список актуальных оповещений пользователя из регистра "вмс_ОчередьОповещений".
//                     Каждая структура содержит поля записи регистра.
//                     При отсутствии прав или возникновении ошибки возвращает пустой массив:
//
// Описание:
//  Получает оповещения для текущего пользователя с соблюдением требований безопасности:
//  1. Проверяет права доступа к модулю ВМС
//  2. Использует привилегированный режим для работы с защищенными данными
//  3. Обеспечивает обработку ошибок с записью в журнал регистрации
//  4. Гарантирует возврат корректного результата (массива) в любом случае
//
Функция ПолучитьСписокАктуальныхОповещений() Экспорт
	
	МассивОповещений = Новый Массив;
	
	Если НЕ вмс_РаботаСПользователямиСервер.ПроверитьПраваНаВМС() Тогда
		Возврат МассивОповещений;
	КонецЕсли;
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		РК = вмс_РаботаСКоллекциями;
		ТекущийПользователь = Пользователи.ТекущийПользователь();
		
		НаборЗаписей = РегистрыСведений.вмс_ОчередьОповещений.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(ТекущийПользователь); 
		НаборЗаписей.Прочитать();  
		
		Если НаборЗаписей.Количество() > 0 Тогда
			ТаблицаОповещений = НаборЗаписей.Выгрузить();
			МассивОповещений = РК.ВыгрузитьКоллекциюВМассивСтруктур(ТаблицаОповещений);
		КонецЕсли;
		
	Исключение
		вмс_Журналирование.Ошибка(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат МассивОповещений;
	
КонецФункции

// Удаляет все запланированные оповещения для текущего пользователя
// 
// Параметры:
//  Отсутствуют
//
// Возвращаемое значение:
//  Булево - Истина, если удаление выполнено успешно, Ложь - в случае ошибки
//
// Описание:
//  Удаляет все записи оповещений для текущего пользователя из регистра
//  "вмс_ОчередьОповещений". Выполняется с проверкой прав и обработкой ошибок.
//
Функция УдалитьЗапланированныеОповещенияПользователю() Экспорт
	
	Если НЕ вмс_РаботаСПользователямиСервер.ПроверитьПраваНаВМС() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		НаборЗаписей = РегистрыСведений.вмс_ОчередьОповещений.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(Пользователи.ТекущийПользователь());
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Возврат Истина;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.вмс_ОчередьОповещений.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(Пользователи.ТекущийПользователь());	
		НаборЗаписей.Записать();
		
		Возврат Истина;
		
	Исключение
		вмс_Журналирование.Ошибка(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции
