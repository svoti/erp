Функция ПолучитьТаблицуПользователейСПравами() Экспорт
	
	Текст =
	"ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка КАК Ссылка,
	|	Неопределено КАК GUID
	|ПОМЕСТИТЬ ТаблицаПользователей
	|ИЗ
	|	&СправочникФизическиеЛица КАК ФизическиеЛица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(ТаблицаПользователей.Ссылка) КАК Оператор,
	|	ТаблицаПользователей.Ссылка КАК ОператорДляГУИД,
	|	ТаблицаПользователей.GUID КАК GUID,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(вмс_ГруппыРолейОператоровОператоры.Ссылка.РольОператоров), ""Пользователь"") КАК Роль
	|ИЗ
	|	ТаблицаПользователей КАК ТаблицаПользователей
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.вмс_ГруппыРолейОператоров.Операторы КАК вмс_ГруппыРолейОператоровОператоры
	|		ПО ТаблицаПользователей.Ссылка = вмс_ГруппыРолейОператоровОператоры.Оператор
	|";
	Текст = СтрЗаменить(Текст, "&СправочникФизическиеЛица", "Справочник." + вмс_АдаптацияКонфигураций.ИмяСправочникаФизЛица());
	
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из РезультатЗапроса Цикл
		Строка.GUID = Строка(Строка.ОператорДляГУИД.УникальныйИдентификатор());
	КонецЦикла; 
	РезультатЗапроса.Колонки.Удалить("ОператорДляГУИД");
	Возврат РезультатЗапроса;
	
КонецФункции
