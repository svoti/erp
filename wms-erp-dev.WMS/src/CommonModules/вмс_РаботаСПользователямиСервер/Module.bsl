	ТаблицаНастроекОператоров = ПолучитьТаблицуНастроекОператоров(Оператор);

	НастройкиОператора = ТаблицаНастроекОператоров.ВыгрузитьКолонку("Настройка");

	Возврат НастройкиОператора;
	
КонецФункции

