	Операции = ТаблицаОпераций.ВыгрузитьКолонку("Операция");
	
	Возврат Операции;
	
КонецФункции

Функция ПолучитьПомещенияОператора(Оператор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_НастройкиОператораПомещения.Помещение КАК Помещение
	|ИЗ
	|	Справочник.вмс_НастройкиОператора КАК вмс_НастройкиОператора
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.вмс_НастройкиОператора.Помещения КАК вмс_НастройкиОператораПомещения
	|		ПО вмс_НастройкиОператора.Ссылка = вмс_НастройкиОператораПомещения.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.вмс_Помещения КАК вмс_Помещения
	|		ПО (вмс_НастройкиОператораПомещения.Помещение = вмс_Помещения.Ссылка)
	|ГДЕ
	|	вмс_НастройкиОператора.Оператор = &Оператор
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_НастройкиОператораПомещения.Помещение";
	Запрос.УстановитьПараметр("Оператор", Оператор);
	Помещения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Помещение");
	
	Возврат Помещения;
	
КонецФункции

Функция ПолучитьТаблицуНастроекОператоров(Операторы) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_НастройкиОператора.Ссылка КАК Настройка,
	|	вмс_НастройкиОператора.ЗвуковаяСхема КАК ЗвуковаяСхема,
	|	вмс_НастройкиОператора.Оператор КАК Оператор
	|ИЗ
	|	Справочник.вмс_НастройкиОператора КАК вмс_НастройкиОператора
	|ГДЕ
	|	вмс_НастройкиОператора.Оператор В(&Операторы)
	|	И НЕ вмс_НастройкиОператора.ПометкаУдаления";
	Запрос.УстановитьПараметр("Операторы", Операторы);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаНастроекОператоров = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаНастроекОператоров;
	
КонецФункции

Функция ПолучитьТаблицуОперацийОператора(Оператор) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	вмс_НастройкиОператораОперации.Операция КАК Операция
	|ИЗ
	|	Справочник.вмс_НастройкиОператора.Операции КАК вмс_НастройкиОператораОперации
	|ГДЕ
	|	вмс_НастройкиОператораОперации.Ссылка.Оператор = &Оператор
	|	И НЕ вмс_НастройкиОператораОперации.Ссылка.ПометкаУдаления
	|	И вмс_НастройкиОператораОперации.Операция <> ЗНАЧЕНИЕ(Справочник.вмс_Операции.ПустаяСсылка)
	|	И НЕ вмс_НастройкиОператораОперации.Операция.ПометкаУдаления";
	Запрос.УстановитьПараметр("Оператор", Оператор);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаОпераций = РезультатЗапроса.Выгрузить();
	ТаблицаОпераций.Колонки.Добавить("МастерОперация");
	
	МастерОперации = ТаблицаОпераций.ВыгрузитьКолонку("Операция");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_Операции.Ссылка КАК Операция,
	|	вмс_Операции.Родитель КАК МастерОперация
	|ИЗ
	|	Справочник.вмс_Операции КАК вмс_Операции
	|ГДЕ
	|	НЕ вмс_Операции.ПометкаУдаления
	|	И вмс_Операции.Родитель В(&МастерОперации)";
	
	Пока МастерОперации.Количество() > 0 Цикл
		Запрос.УстановитьПараметр("МастерОперации", МастерОперации);
		РезультатЗапроса = Запрос.Выполнить();
		ТаблицаПодчиненныхОпераций = РезультатЗапроса.Выгрузить();
		РК.ДобавитьЭлементыКоллекции(ТаблицаОпераций, ТаблицаПодчиненныхОпераций);
		МастерОперации = РК.ВыгрузитьЗначенияКолонкиКоллекции(ТаблицаПодчиненныхОпераций, "Операция");
	КонецЦикла;
	
	Возврат ТаблицаОпераций;
	
КонецФункции

