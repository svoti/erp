// Климентов РаботаСАктивнымиСеансами  26.06
// ВидВзаимодействия (1 - Авторизация в приложении, 2 - Заход в операцию, 3 - Выход из операции, 4 - Гашение сеанса)
//
Функция ОбработатьЗаписьСеанса(СтруктураСеанса) Экспорт
	Если Не ЗначениеЗаполнено(СтруктураСеанса) Тогда
		Возврат Ложь;
	КонецЕсли;
	ВидВзаимодействия = 0;
	Если СтруктураСеанса.Свойство("ВидВзаимодействия") Тогда
		ВидВзаимодействия = СтруктураСеанса.ВидВзаимодействия;
	Иначе 
		Возврат Ложь;
	КонецЕсли;
	Если ВидВзаимодействия = 1 Тогда
		СтруктураСеанса.ВидВзаимодействия = Перечисления.вмс_ВидыВзаимодействияСТерминалом.Авторизован;
		РегистрыСведений.вмс_АктивныеСеансы.СоздатьНовуюЗапись(СтруктураСеанса);
	ИначеЕсли ВидВзаимодействия = 2 Тогда
		СтруктураСеанса.ВидВзаимодействия = Перечисления.вмс_ВидыВзаимодействияСТерминалом.ВОперации; 
		РегистрыСведений.вмс_АктивныеСеансы.ИзменитьСтатусСеансаПоСтруктуре(СтруктураСеанса);
	ИначеЕсли ВидВзаимодействия = 3 Тогда
		СтруктураСеанса.ВидВзаимодействия = Перечисления.вмс_ВидыВзаимодействияСТерминалом.Авторизован;
		РегистрыСведений.вмс_АктивныеСеансы.ИзменитьСтатусСеансаПоСтруктуре(СтруктураСеанса);
	ИначеЕсли ВидВзаимодействия = 4 Тогда
		СтруктураСеанса.ВидВзаимодействия = Перечисления.вмс_ВидыВзаимодействияСТерминалом.Авторизован;
		РегистрыСведений.вмс_АктивныеСеансы.ЗакончитьАктивныйСеансОператора(СтруктураСеанса.Оператор);
	КонецЕсли;
	Возврат Истина;
КонецФункции 

