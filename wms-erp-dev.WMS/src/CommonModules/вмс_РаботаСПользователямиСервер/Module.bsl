Функция ПроверитьАвторизованЛиПользовательСегодня(Пользователь, ИдентификаторКлиента) Экспорт
	
	ДатаНачала = НачалоДня(ТекущаяДатаСеанса());
	ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	
	Запрос = Новый Запрос;
	
	// Установка значений параметров
	Запрос.УстановитьПараметр("Оператор", Пользователь);
	Запрос.УстановитьПараметр("ДатаОкончания",ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_АктивныеСеансы.Оператор КАК Оператор,
	|	вмс_АктивныеСеансы.УникальныйИдентификаторБазы КАК УникальныйИдентификаторБазы
	|ИЗ
	|	РегистрСведений.вмс_АктивныеСеансы КАК вмс_АктивныеСеансы
	|ГДЕ
	|	вмс_АктивныеСеансы.ДатаВремя МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И вмс_АктивныеСеансы.Оператор = &Оператор";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		Если ИдентификаторКлиента = Результат[0].УникальныйИдентификаторБазы Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	
КонецФункции


