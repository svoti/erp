Функция ПолучитьРезультатЗапросаПоФизЛицу(Оператор) Экспорт  
	
	// Перенесено из МП
	Текст =
	"ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка КАК Ссылка,
	|	ФизическиеЛица.Наименование КАК Наименование,
	|	Пользователи.Ссылка КАК Пользователь,
	|	НастройкиОператора.Ссылка КАК НастройкаОператора,
	|	НастройкиОператора.ЯчейкаОтветственногоХранения КАК ЯчейкаОтветственногоХранения,
	|	НастройкиОператора.Разработчик КАК Разработчик,
	|	НастройкиОператора.ЗвуковаяСхема.Имя КАК ИмяЗвуковойСхемы
	|ИЗ
	|	&СправочникФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО ФизическиеЛица.Ссылка = Пользователи.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.вмс_НастройкиОператора КАК НастройкиОператора
	|		ПО ФизическиеЛица.Ссылка = НастройкиОператора.Оператор
	|ГДЕ
	|	ФизическиеЛица.Ссылка = &Ссылка
	|	И ФизическиеЛица.ПометкаУдаления = ЛОЖЬ";
	
	Текст = СтрЗаменить(Текст, "&СправочникФизическиеЛица", "Справочник." + вмс_АдаптацияКонфигураций.ИмяСправочникаФизЛица());
	Текст = СтрЗаменить(Текст, "Пользователи.ФизическоеЛицо", "Пользователи." + вмс_АдаптацияКонфигураций.ИмяКолонкиФизЛицо());
	
	ЗапросПоФизЛицу = Новый Запрос;
	ЗапросПоФизЛицу.УстановитьПараметр("Ссылка", Оператор);
	ЗапросПоФизЛицу.Текст = Текст;
	
	РезультатЗапроса = ЗапросПоФизЛицу.Выполнить();
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	
	ДобавитьДанныеЗвукаВходаОператора(ТаблицаРезультата);
	
	Возврат ТаблицаРезультата;
	
КонецФункции
