Функция АвторизоватьсяПоПользователюОС(Логин) Экспорт
	
	ОшибкиАвторизации = Новый Массив;
	
	РезультатАвторизации = Новый Структура;
	РезультатАвторизации.Вставить("ИмяПользователя");
	РезультатАвторизации.Вставить("СсылкаПользователя");
	РезультатАвторизации.Вставить("ФизическоеЛицо");
	РезультатАвторизации.Вставить("Успешно", Ложь);
	РезультатАвторизации.Вставить("ОшибкиАвторизации", ОшибкиАвторизации);
	
	ПользовательИБ = НайтиПользователяИБПоЛогинуОС(Логин);
	Если ПользовательИБ = Неопределено Тогда
		ОшибкиАвторизации.Добавить("Неверный логин!");
		Возврат РезультатАвторизации;
	КонецЕсли;
	
	РезультатАвторизации.ИмяПользователя = ПользовательИБ.Имя;
	
	СсылкаПользователя = НайтиСсылкуПользователяПоПользователюИБ(ПользовательИБ);
	Если СсылкаПользователя = Неопределено Тогда
		ОшибкиАвторизации.Добавить("Пользователь 1С не найден!");
		Возврат РезультатАвторизации;
	КонецЕсли;
	
	РезультатАвторизации.СсылкаПользователя = СсылкаПользователя;
	
	ВариантыРеквизитаФизическоеЛицо = Новый Массив;
	ВариантыРеквизитаФизическоеЛицо.Добавить("ФизическоеЛицо");
	ВариантыРеквизитаФизическоеЛицо.Добавить("ФизЛицо");
	РеквизитыПользователя = вмс_ОбщегоНазначенияВызовСервера.ПолучитьЗначенияРеквизитовОбъекта(СсылкаПользователя, ВариантыРеквизитаФизическоеЛицо);
	Для Каждого ВариантРеквизитаФизическоеЛицо Из ВариантыРеквизитаФизическоеЛицо Цикл
		ФизическоеЛицо = РеквизитыПользователя[ВариантРеквизитаФизическоеЛицо];
		Если ЗначениеЗаполнено(ФизическоеЛицо) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		ОшибкиАвторизации.Добавить("Физическое лицо не заполнено!");
		Возврат РезультатАвторизации;
	КонецЕсли;
	
	РезультатАвторизации.ФизическоеЛицо = ФизическоеЛицо;
	РезультатАвторизации.Успешно = Истина;
	Возврат РезультатАвторизации;
	
КонецФункции

Функция НайтиСсылкуПользователяПоПользователюИБ(ПользовательИБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ = &ИдентификаторПользователяИБ";
	Запрос.УстановитьПараметр("ИдентификаторПользователяИБ", ПользовательИБ.УникальныйИдентификатор);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция НайтиПользователяИБПоЛогинуОС(ЛогинОС) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	СписокПользователейИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
	УстановитьПривилегированныйРежим(Ложь);
	
	ВариантыНаписанияЛогина = Новый Массив;
	ВариантыНаписанияЛогина.Добавить(НРег(ЛогинОС));
	Если Лев(ЛогинОС, 2) <> "\\" Тогда
		ВариантыНаписанияЛогина.Добавить("\\" + НРег(ЛогинОС));
	КонецЕсли;
	
	Для Каждого ПользовательИБ Из СписокПользователейИБ Цикл
		
		Если Не ПользовательИБ.АутентификацияОС Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВариантыНаписанияЛогина.Найти(НРег(ПользовательИБ.ПользовательОС)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат ПользовательИБ;
		
	КонецЦикла;
	
КонецФункции

Функция ВыгрузитьНастройкиОператора(Оператор) Экспорт

	РК = вмс_РаботаСКоллекциями;

	ТаблицаНастроекОператора = ПолучитьТаблицуНастроекОператоров(Оператор);
	
	Операции = ПолучитьОперацииОператора(Оператор);
	
	Помещения = ПолучитьПомещенияОператора(Оператор);
	
	МассивОбъектов = Новый Массив;
	РК.ДобавитьЭлементыКоллекции(МассивОбъектов, ТаблицаНастроекОператора.ВыгрузитьКолонку("Настройка"));
	РК.ДобавитьЭлементыКоллекции(МассивОбъектов, Операции);
	РК.ДобавитьЭлементыКоллекции(МассивОбъектов, Помещения);
	РК.ДобавитьЭлементыКоллекции(МассивОбъектов, вмс_УправлениеСвойствамиВызовСервера.ПолучитьСсылкиОбъектовДополнительныхРеквизитов());
	
    ТекстXML = вмс_Обмен_с_КИС_Сервер.ВыгрузитьОбъектыПоСсылкамВXML(МассивОбъектов);
	
	Возврат ТекстXML;
	
КонецФункции

