Функция ПолучитьТаблицуПользователей() Экспорт 
	
	ТаблицаПользователей = вмс_РаботаСКоллекциями.НоваяТаблицаЗначений("Оператор, GUID, ХешПароля");
	
	Выборка = Справочники.вмс_НастройкиОператора.Выбрать();
	Пока Выборка.Следующий() Цикл 
		// ТУ_Кукушкин 06.05.25 ++ помеченные на удаление пользователи не должны приходить в список, иначе зачем их пометили 
		Если Выборка.ПометкаУдаления = Истина Тогда
			Продолжить;
		КонецЕсли;
		// ТУ_Кукушкин 06.05.25 --
		нСтрока = ТаблицаПользователей.Добавить();
		нСтрока.Оператор = Выборка.Оператор;
		нСтрока.GUID = Выборка.Оператор.УникальныйИдентификатор();
		нСтрока.ХешПароля = ХешПароля(Выборка.КодДоступа);		
	КонецЦикла; 
	
	Возврат ТаблицаПользователей;
	
КонецФункции
