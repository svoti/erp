// ТУ_Кошелев++
Функция ХешПароля(Пароль) Экспорт
	ХешПароля = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешПароля.Добавить(Пароль);
	Возврат ХешПароля.ХешСумма;
КонецФункции
