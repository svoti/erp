Функция НайтиПользователяПоШтрихкоду(Штрихкод) Экспорт
	
	ДанныеШтрихкода = вмс_ОбработкаШтрихкодовВызовСервера.ОбработатьШтрихкод(Штрихкод)["Оператор"];
	Если ДанныеШтрихкода = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ФизЛицо = ДанныеШтрихкода.Ссылка;
	
	//Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("ФизическоеЛицо", ФизЛицо); 
	// Мовчан 20.03.23++
	Пользователь = Справочники.Пользователи.НайтиПоРеквизиту(вмс_АдаптацияКонфигураций.ИмяКолонкиФизЛицо(), ФизЛицо);
	// Мовчан 20.03.23--
	
	Результат = Новый Структура;      
	Результат.Вставить("ФизическоеЛицо", ФизЛицо);
	Результат.Вставить("Наименование", ФизЛицо.Наименование);
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Авторизован", Истина);
	
	Возврат Результат;
	
КонецФункции

