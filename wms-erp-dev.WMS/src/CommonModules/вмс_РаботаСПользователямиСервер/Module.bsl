Функция ПолучитьНастройкуПользователя(ИмяНастройки, ПараметрыАвторизации=Неопределено) Экспорт
	НастройкиПользователя = ПолучитьНастройкиПользователя(ПараметрыАвторизации);
	Если вмс_РаботаСКоллекциями.ЭтоКвазиТаблицаЗначений(НастройкиПользователя) Тогда
		НайденныеСтроки = вмс_РаботаСКоллекциями.НайтиСтрокиКвазиТаблицыЗначений(НастройкиПользователя, Новый Структура("Настройка", ИмяНастройки));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат НайденныеСтроки[0].Значение;
		КонецЕсли; 
	КонецЕсли;
КонецФункции

Функция СохранитьНастройкуПользователя(ИмяНастройки, Значение, ПараметрыАвторизации=Неопределено) Экспорт
	
	Если ПараметрыАвторизации = Неопределено Тогда
		ПараметрыАвторизации = ПолучитьПараметрыАвторизации();
	КонецЕсли;
	
	НастройкиПользователя = ПолучитьНастройкиПользователя(ПараметрыАвторизации);
	Если Не вмс_РаботаСКоллекциями.ЭтоКвазиТаблицаЗначений(НастройкиПользователя) Тогда
		НастройкиПользователя = вмс_РаботаСКоллекциями.НоваяКвазиТаблицаЗначений("Настройка, Значение");
	КонецЕсли;
	
	Отбор = Новый Структура("Настройка", ИмяНастройки);
	НайденныеСтроки = вмс_РаботаСКоллекциями.НайтиСтрокиКвазиТаблицыЗначений(НастройкиПользователя, Отбор);
	Если НайденныеСтроки.Количество() > 0 Тогда
		СтрокаНастройки = НайденныеСтроки[0];
	Иначе
		СтрокаНастройки = вмс_РаботаСКоллекциями.ДобавитьСтрокуКвазиТаблицыЗначений(НастройкиПользователя);
		ЗаполнитьЗначенияСвойств(СтрокаНастройки, Отбор);
	КонецЕсли;
	
	СтрокаНастройки.Значение = Значение;
	
	СохранитьВсеНастройкиПользователя(НастройкиПользователя, ПараметрыАвторизации);
	
КонецФункции

