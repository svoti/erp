
#Область ДанныеКонтейнера 

// Возвращает цену контейнера для указанной операции и клиента
//
// Параметры:
//  Контейнер - СправочникСсылка/Неопределено - Контейнер или тара
//  Операция - Строка - Код операции
//  Клиент - СправочникСсылка.Контрагенты - Клиент для расчета цены
//  Период - Дата - Период действия цены
//
// Возвращаемое значение:
//  Число - цена услуги для конкретного клиента или общая цена,
//           если клиентская цена не найдена. 0 - если цена не определена.
//
// Описание:
//  Ищет в регистре сведений цену для указанной операции и контейнера,
//  учитывая приоритет клиентских цен над общими.
//
Функция ПолучитьЦенуКонтейнера(Контейнер, Операция, Клиент, Период) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Операция) ИЛИ НЕ ЗначениеЗаполнено(Период) Тогда
		Возврат 0;
	КонецЕсли;
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|    ВЫБОР
		|        КОГДА ОХР_ЦеныТарифицируемыхУслугСрезПоследних.Контрагент = &Контрагент
		|            ТОГДА ОХР_ЦеныТарифицируемыхУслугСрезПоследних.Цена
		|        ИНАЧЕ 0
		|    КОНЕЦ КАК Цена,
		|    ВЫБОР
		|        КОГДА ОХР_ЦеныТарифицируемыхУслугСрезПоследних.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|            ТОГДА ОХР_ЦеныТарифицируемыхУслугСрезПоследних.Цена
		|        ИНАЧЕ 0
		|    КОНЕЦ КАК ОбщаяЦена
		|ИЗ
		|    РегистрСведений.ОХР_ЦеныТарифицируемыхУслуг.СрезПоследних(
		|            &Период,
		|            ВЫБОР
		|                    КОГДА &УсловиеПоТаре
		|                        ТОГДА ТипТары = &ТипТары
		|                    ИНАЧЕ ИСТИНА
		|                КОНЕЦ
		|                И Операция = &Операция
		|                И (Контрагент = &Контрагент
		|                    ИЛИ Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))) КАК ОХР_ЦеныТарифицируемыхУслугСрезПоследних";
		
		Запрос.УстановитьПараметр("Контрагент", Клиент); 
		Запрос.УстановитьПараметр("УсловиеПоТаре", ЗначениеЗаполнено(Контейнер) И ТипЗнч(Контейнер) <> Тип("СправочникСсылка.Номенклатура"));
		Запрос.УстановитьПараметр("ТипТары", ?(ЗначениеЗаполнено(Контейнер) И ТипЗнч(Контейнер) <> Тип("СправочникСсылка.Номенклатура"), Контейнер.ТипТары, Неопределено));
		Запрос.УстановитьПараметр("Операция", Операция);
		Запрос.УстановитьПараметр("Период", Период);
		
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Возврат 0;
		КонецЕсли;
		
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат ?(ЗначениеЗаполнено(Выборка.Цена), Выборка.Цена, Выборка.ОбщаяЦена);
		КонецЕсли;
		
	Исключение
		вмс_Журналирование.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), СтрШаблон("Ошибка получения цены контейнера: %1, %2, %3, %4", Контейнер, Операция, Клиент, Период));
		Возврат 0;
	КонецПопытки;
	
	Возврат 0;
	
КонецФункции

#КонецОбласти
