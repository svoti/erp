	//	Если Комментарий="##Подведение итогов" Тогда
	//		Возврат Истина;
	//	Иначе
	//		Возврат Ложь;
	//	КонецЕсли;
	//Иначе
	//	Возврат Истина;
	//КонецЕсли;
	
КонецФункции

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.вмс_РегистрацияИзмененийОпераций.ЗарегистрироватьСсылкуДокументаОперации(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// 3.2.4: очистка иерархии и движений
	ОбработкаУдаленияПроведения(Отказ);
	
	Если Версия=2 Тогда
		
		УО = вмс_УправлениеОстаткамиНовый;
		
		ПроцессорУправленияОстатками = УО.НовыйПроцессорУправленияОстатками();
		УО.ЗагрузитьТаблицуИнструкций(ПроцессорУправленияОстатками, ЭтотОбъект);
		УО.СформироватьДвиженияПоРегистрам(ПроцессорУправленияОстатками);
		Если ПроцессорУправленияОстатками.Отказ Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Движения.вмс_ОперацияПоЯчейкам.Загрузить(ПроцессорУправленияОстатками.ДвиженияРегистров.ОстаткиТоваровВЯчейках);
		Движения.вмс_ОперацияПоЯчейкам.Записывать = Истина;
		
		Движения.вмс_ОстаткиВКонтейнерах.Загрузить(ПроцессорУправленияОстатками.ДвиженияРегистров.ОстаткиТоваровВКонтейнерах);
		Движения.вмс_ОстаткиВКонтейнерах.Записывать = Истина;
		
		Движения.вмс_МестоположенияКонтейнеров.Загрузить(ПроцессорУправленияОстатками.ДвиженияРегистров.МестоположенияКонтейнеров);
		Движения.вмс_МестоположенияКонтейнеров.Записывать = Истина;
		
	Иначе
		ТаблицаРегистра = ПолучитьТаблицуДляПроведения();
		
		НаборЗаписей = Движения.вмс_ОперацияПоЯчейкам;
		НаборЗаписей.Записывать = Истина;
		НаборЗаписей.Загрузить(ТаблицаРегистра); 
		
		Если ДополнительныеСвойства.Свойство("ОбменДанными") И ДополнительныеСвойства.ОбменДанными = Истина Тогда   
			// Проверка остатков перенесена в регистр накопления вмс_ОперацияПоЯчейкам. При обмене данными проверка не производится
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
		Иначе 
			//ВыполнитьКонтрольОстатков(Отказ);
			
			Если Отказ Тогда
				Возврат;	
			КонецЕсли;
		КонецЕсли;
		
		// Остатки тары
		ТаблицаРегистра = ПолучитьТаблицуТары();
		
		НаборЗаписей = Движения.вмс_ОстаткиВКонтейнерах;
		НаборЗаписей.Записывать = Истина;
		НаборЗаписей.Загрузить(ТаблицаРегистра);
		// Остатки тары ; 
	КонецЕсли;
	
	ОбработатьУпаковки(); 
	
	ДобавитьДвиженияПоМаркировке();
	
	ОбработатьЗаявкуКладовщику();

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ОчиститьДвиженияПоМаркировке();
	
	Для Каждого СтрокаДокумента Из ИерархияКонтейнеров Цикл 
		
		Контейнер = СтрокаДокумента.Контейнер.ПолучитьОбъект();
		
		Если ЗначениеЗаполнено(СтрокаДокумента.КонтейнерРасход) Тогда
			Контейнер.Родитель = СтрокаДокумента.КонтейнерРасход; // Контейнер достается на самый верх для упрощения
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.КонтейнерПриход) И СтрокаДокумента.Контейнер<>СтрокаДокумента.КонтейнерПриход Тогда
			Контейнер.Родитель = Справочники.вмс_Контейнеры.ПустаяСсылка();
		КонецЕсли;
		
		Контейнер.Записать(); 
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	РегистрыСведений.вмс_РегистрацияИзмененийОпераций.ЗарегистрироватьСсылкуДокументаОперации(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьУпаковки()
	
	Для Каждого СтрокаДокумента Из ИерархияКонтейнеров Цикл 
		
		Контейнер = СтрокаДокумента.Контейнер.ПолучитьОбъект();
		
		//это слияние контейнеров. Иерархиия не нужна
		Если Контейнер.ТипТары.ВидКонтейнера = СтрокаДокумента.КонтейнерПриход.ТипТары.ВидКонтейнера Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.КонтейнерРасход) Тогда
			Контейнер.Родитель = Справочники.вмс_Контейнеры.ПустаяСсылка(); // Контейнер достается на самый верх для упрощения
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.КонтейнерПриход) И СтрокаДокумента.Контейнер<>СтрокаДокумента.КонтейнерПриход Тогда
			Контейнер.Родитель = СтрокаДокумента.КонтейнерПриход;
		КонецЕсли;
		
		Контейнер.Записать(); 
		
	КонецЦикла;
	
	Движения.вмс_ИсторияИерархииКонтейнеров.Записывать = Истина;
	Для Каждого ТекСтрокаИерархияКонтейнеров Из ИерархияКонтейнеров Цикл
		Движение = Движения.вмс_ИсторияИерархииКонтейнеров.Добавить();
		Движение.Период = Дата;
		Движение.Контейнер = ТекСтрокаИерархияКонтейнеров.Контейнер;
		Движение.КонтейнерРасход = ТекСтрокаИерархияКонтейнеров.КонтейнерРасход;
		Движение.КонтейнерПриход = ТекСтрокаИерархияКонтейнеров.КонтейнерПриход;
		Движение.Ответственный = Ответственный;
		Движение.ВидОперации = ВидОперации;    
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДвиженияПоМаркировке()
	
	НаборЗаписей = РегистрыСведений.вмс_СостояниеМаркировки.СоздатьНаборЗаписей();
	НаборЗаписей.Заполнить(Неопределено);
	НаборЗаписей.Отбор.Распоряжение.Установить(ДокументОснование);
	НаборЗаписей.Отбор.СкладскойДокумент.Установить(Ссылка);
	
	Для Каждого СтрокаТаблицы Из КодыМаркировки Цикл 
		
		НоваяЗапись = НаборЗаписей.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаТаблицы);
		НоваяЗапись.Распоряжение = ДокументОснование; 
		НоваяЗапись.СкладскойДокумент = Ссылка; 
		НоваяЗапись.Период = Дата;
		НоваяЗапись.Состояние = Перечисления.вмс_СостояниеМаркировки.Обработана;
		НоваяЗапись.ХешСуммаКодаМаркировки = вмс_Сервер.ХешированиеДанныхSHA256(НоваяЗапись.Маркировка);
		
	КонецЦикла; 
	
	НаборЗаписей.Записать();   
		
КонецПроцедуры

Процедура ОчиститьДвиженияПоМаркировке()   
	
	НаборЗаписей = РегистрыСведений.вмс_СостояниеМаркировки.СоздатьНаборЗаписей();
	НаборЗаписей.Заполнить(Неопределено);
	НаборЗаписей.Отбор.Распоряжение.Установить(ДокументОснование);
	НаборЗаписей.Записать();
		
КонецПроцедуры

Функция ПолучитьТаблицуДляПроведения()
	
	ИспользоватьСклад = ДополнительныеСвойства.ИспользоватьСклад;

	Таблица = Движения.вмс_ОперацияПоЯчейкам.ВыгрузитьКолонки();
	
	Для Каждого СтрокаДокумента Из Товары Цикл 
		
		Если ЗначениеЗаполнено(СтрокаДокумента.Ячейка) Тогда
			СтрокаРегистра = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРегистра, СтрокаДокумента);
			Если ЗначениеЗаполнено(СтрокаДокумента.КонтейнерОтправитель) Тогда
				СтрокаРегистра.Контейнер = СтрокаДокумента.КонтейнерОтправитель;
			КонецЕсли;
			СтрокаРегистра.ВидДвижения = ВидДвиженияНакопления.Расход; 
			Если ИспользоватьСклад Тогда
				СтрокаРегистра.Склад = СтрокаДокумента.Ячейка.Владелец;   
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.ЯчейкаПриемник) Тогда
			СтрокаРегистра = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРегистра, СтрокаДокумента);
			Если ЗначениеЗаполнено(СтрокаДокумента.КонтейнерПриемник) Тогда
				СтрокаРегистра.Контейнер = СтрокаДокумента.КонтейнерПриемник;
			КонецЕсли;
			СтрокаРегистра.Ячейка = СтрокаДокумента.ЯчейкаПриемник;
			СтрокаРегистра.ВидДвижения = ВидДвиженияНакопления.Приход;   
			Если ИспользоватьСклад Тогда
				СтрокаРегистра.Склад = СтрокаДокумента.ЯчейкаПриемник.Владелец; 
			КонецЕсли;
		КонецЕсли;  		
		
	КонецЦикла;
	
	Для каждого Строка Из Таблица Цикл
		Если Не ЗначениеЗаполнено(Строка.Качество) Тогда
			Строка.Качество = ПредопределенноеЗначение("Перечисление.вмс_КачествоТовара.Новый");	
		КонецЕсли;	
	КонецЦикла; 
	
	Таблица.ЗаполнитьЗначения(Дата, "Период");
	Таблица.ЗаполнитьЗначения(Ссылка, "Регистратор");
	Таблица.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат Таблица;
	
КонецФункции

Процедура ЗаполнитьТаблицуТоваровПоИнвентаризации()
	
	Товары.Очистить();
	
	Если Не Готов Тогда
		Возврат;
	КонецЕсли;
	
	Версия = 2;
	
	ПустаяЯчейка = Справочники.вмс_МестаХранения.ПустаяСсылка();
	ПустойКонтейнер = Справочники.вмс_Контейнеры.ПустаяСсылка();
	
	Для Каждого СтрокаИнвентаризации Из ТоварыПоИнвентаризации Цикл
		Если СтрокаИнвентаризации.Контейнер <> ПустойКонтейнер И СтрокаИнвентаризации.КонтейнерОтправитель <> ПустойКонтейнер Тогда
			// вложенные контейнеры пока не поддерживаются
			Продолжить;
		КонецЕсли;
		
		Отклонение = СтрокаИнвентаризации.Количество - СтрокаИнвентаризации.КоличествоУчет;
		Если Отклонение > 0 Тогда
			СтрокаТовара = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовара, СтрокаИнвентаризации);
			СтрокаТовара.НомерСтрокиДокумента = СтрокаИнвентаризации.НомерСтроки;
			СтрокаТовара.Ячейка = Неопределено;
			СтрокаТовара.ЯчейкаПриемник = СтрокаИнвентаризации.Ячейка;
			СтрокаТовара.Количество = Отклонение;
			СтрокаТовара.КоличествоБазовыхЕдиниц = Отклонение;
			Если СтрокаТовара.КонтейнерОтправитель <> ПустойКонтейнер Тогда
				// контейнер-отправитель в инвентаризации имеет смысл места,
				// в котором делается инвентаризация, т.е. инвентаризируется состав контейнера
				СтрокаТовара.КонтейнерПриемник = СтрокаТовара.КонтейнерОтправитель;
				СтрокаТовара.КонтейнерОтправитель = ПустойКонтейнер;
			КонецЕсли;
		ИначеЕсли Отклонение < 0 Тогда
			СтрокаТовара = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовара, СтрокаИнвентаризации);
			СтрокаТовара.НомерСтрокиДокумента = СтрокаИнвентаризации.НомерСтроки;
			
			Если СтрокаИнвентаризации.Контейнер <> ПустойКонтейнер И СтрокаИнвентаризации.КонтейнерОтправитель = ПустойКонтейнер И СтрокаИнвентаризации.Ячейка = ПустаяЯчейка Тогда
				// списание контейнера без указания ячейки
				// так и оставляем
				СтрокаТовара.Количество = Отклонение;
			Иначе
				СтрокаТовара.Ячейка = СтрокаИнвентаризации.Ячейка;
				СтрокаТовара.ЯчейкаПриемник = Неопределено;
				СтрокаТовара.Количество = -Отклонение;
				СтрокаТовара.КоличествоБазовыхЕдиниц = -Отклонение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуТоваровПоИнвентаризацииСПомощьюМодуляУправлениеОстатками()
	
	Товары.Очистить();
	
	Если Не Готов Тогда
		Возврат;
	КонецЕсли;
	
	ДатаОстатков = ЭтотОбъект.Дата;
	Если НачалоДня(ДатаОстатков) = НачалоДня(ТекущаяДата()) Тогда
		ДатаОстатков = Неопределено;
	КонецЕсли;
	
	ПроцессорУправленияОстатками = вмс_УправлениеОстатками.НовыйПроцессорУправленияОстатками();
	ПроцессорУправленияОстатками.РазрешитьОтрицательныеОстатки = Истина; // ТУ_Самойленко 28.06.23 [Инвентаризация с отриц. остатками]
	ПроцессорУправленияОстатками.ТекущиеДокументы = ЭтотОбъект.Ссылка;
	ПроцессорУправленияОстатками.ДатаПолученияОстатков = ДатаОстатков;

	ТаблицаИзменений = ПолучитьТаблицуИзмененийДляУправленияОстатками(ПроцессорУправленияОстатками);
	Если ТаблицаИзменений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	вмс_УправлениеОстатками.ПодгрузитьНеобходимыеДанные(ПроцессорУправленияОстатками, ТаблицаИзменений);
	вмс_УправлениеОстатками.ПодгрузитьНеобходимыеДанные(ПроцессорУправленияОстатками, ТаблицаИзменений); // для теста
	вмс_УправлениеОстатками.УстановитьФактическиеКоличества(ПроцессорУправленияОстатками, ТаблицаИзменений);
	ТаблицаДвижений = вмс_УправлениеОстатками.ПолучитьТаблицуДвижений(ПроцессорУправленияОстатками);

	вмс_РаботаСКоллекциями.ДобавитьЭлементыКоллекции(Товары, ТаблицаДвижений);
	
КонецПроцедуры

Функция ПолучитьТаблицуИзмененийДляУправленияОстатками(ПроцессорУправленияОстатками)

	ПустойКонтейнер = ПроцессорУправленияОстатками.ПустойКонтейнер;
	
	КолонкиТаблицыОтклонений = вмс_РаботаСКоллекциями.СкопироватьОбъект(ПроцессорУправленияОстатками.ТоварныеПоляМассив);
	КолонкиТаблицыОтклонений.Добавить("Ячейка");
	КолонкиТаблицыОтклонений.Добавить("Контейнер");
	КолонкиТаблицыОтклонений.Добавить("Количество");
	КолонкиТаблицыОтклонений.Добавить("ИсходноеКоличество");
	ТаблицаИзменений = вмс_РаботаСКоллекциями.НоваяТаблицаЗначений(КолонкиТаблицыОтклонений);

	Для Каждого СтрокаИнвентаризации Из ТоварыПоИнвентаризации Цикл
		
		Отклонение = СтрокаИнвентаризации.Количество - СтрокаИнвентаризации.КоличествоУчет;
		Если Отклонение = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаОтклонения = ТаблицаИзменений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОтклонения, СтрокаИнвентаризации);
		НоваяСтрокаОтклонения.ИсходноеКоличество = СтрокаИнвентаризации.КоличествоУчет;
		Если СтрокаИнвентаризации.Контейнер <> ПустойКонтейнер Тогда
			НоваяСтрокаОтклонения.Товар = СтрокаИнвентаризации.Контейнер;
		КонецЕсли;
		НоваяСтрокаОтклонения.Контейнер = СтрокаИнвентаризации.КонтейнерОтправитель;
		
	КонецЦикла;
	
	Возврат ТаблицаИзменений;
	
КонецФункции

Функция ПолучитьТаблицуТары()

	Таблица = Движения.вмс_ОстаткиВКонтейнерах.ВыгрузитьКолонки();  
	
	Для Каждого СтрокаДокумента Из Товары Цикл 
		
		КонтейнерЗаполнен = ЗначениеЗаполнено(СтрокаДокумента.Контейнер);
		
		Если ЗначениеЗаполнено(СтрокаДокумента.КонтейнерОтправитель) Тогда
			СтрокаДвижений = Таблица.Добавить(); 
			ЗаполнитьЗначенияСвойств(СтрокаДвижений, СтрокаДокумента);
			СтрокаДвижений.Контейнер = СтрокаДокумента.КонтейнерОтправитель;
			СтрокаДвижений.ВидДвижения = ВидДвиженияНакопления.Расход;
			Если КонтейнерЗаполнен Тогда
				СтрокаДвижений.Товар = СтрокаДокумента.Контейнер;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.КонтейнерПриемник) Тогда
			СтрокаДвижений  =  Таблица.Добавить(); 
			ЗаполнитьЗначенияСвойств(СтрокаДвижений, СтрокаДокумента);
			СтрокаДвижений.ВидДвижения = ВидДвиженияНакопления.Приход;
			СтрокаДвижений.Контейнер = СтрокаДокумента.КонтейнерПриемник;
			Если КонтейнерЗаполнен Тогда
				СтрокаДвижений.Товар = СтрокаДокумента.Контейнер;
			КонецЕсли;
		КонецЕсли;
			
	КонецЦикла; 
	
	Для Каждого СтрокаДокумента Из АгрегацияКонтейнеров Цикл 
		
		Если ЗначениеЗаполнено(СтрокаДокумента.Контейнер) Тогда
			СтрокаДвижений  =  Таблица.Добавить(); 
			ЗаполнитьЗначенияСвойств(СтрокаДвижений, СтрокаДокумента);
			СтрокаДвижений.ВидДвижения = ВидДвиженияНакопления.Расход;
			СтрокаДвижений.Контейнер = СтрокаДокумента.Контейнер; 
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.КонтейнерПриемник) Тогда
			СтрокаДвижений  =  Таблица.Добавить(); 
			ЗаполнитьЗначенияСвойств(СтрокаДвижений, СтрокаДокумента);
			СтрокаДвижений.ВидДвижения = ВидДвиженияНакопления.Приход;
			СтрокаДвижений.Контейнер = СтрокаДокумента.КонтейнерПриемник;
		КонецЕсли;
		
    КонецЦикла;

	
	Таблица.Колонки.Удалить("НомерСтроки");
	МассивРеквизитов = вмс_РаботаСКоллекциями.ВыгрузитьЗначенияКолонокКоллекции(Таблица.Колонки, "Имя");
	МассивРесурсов = вмс_РаботаСКоллекциями.ВыгрузитьЗначенияКолонокКоллекции(Движения.вмс_ОстаткиВКонтейнерах.Метаданные().Ресурсы, "Имя");
	МассивПолейГруппировки = вмс_РаботаСКоллекциями.ВычитаниеМассивов(МассивРеквизитов, МассивРесурсов);
	ПоляГруппировки = вмс_РаботаСКоллекциями.МассивВСтроку(МассивПолейГруппировки);
	Ресурсы = вмс_РаботаСКоллекциями.МассивВСтроку(МассивРесурсов);
	Для Каждого Строка Из Таблица Цикл
		Если ТипЗнч(Строка.Товар) = Тип("СправочникСсылка.вмс_Контейнеры") Тогда
			Строка.Количество = 1;
		КонецЕсли;
		
		Если Строка.Маркировка <> "" Тогда
			Строка.ХешСуммаКодаМаркировки = вмс_Сервер.ХешированиеДанныхSHA256(Строка.Маркировка);
		КонецЕсли;
		
		Строка.Период = Дата;
		Строка.Регистратор = Ссылка;
		Строка.Активность = Истина;
	КонецЦикла;
	
	Таблица.Свернуть(ПоляГруппировки, Ресурсы);
	
	Возврат Таблица; 
	
	
	
КонецФункции  

Функция ПолучитьОстатокТары(Тара)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	вмс_ОстаткиВКонтейнерах.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.вмс_ОстаткиВКонтейнерах.Остатки(, Контейнер = &Контейнер) КАК вмс_ОстаткиВКонтейнерах";
	
	Запрос.УстановитьПараметр("Контейнер", Тара);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество
	Иначе
		Возврат 0;
	КонецЕсли;
	

КонецФункции

Процедура ЗаполнитьТабличнуюЧастьИерархииКонтейнеров()  
	
	Если ЗначениеЗаполнено(Товары) = Ложь Тогда
		Возврат;	
	КонецЕсли;    
	
	Если РучноеРедактированиеИерархии Тогда
		Возврат;	
	КонецЕсли;
	
	ИерархияКонтейнеров.Очистить();
	
	ПустойКонтейнер = Справочники.вмс_Контейнеры.ПолучитьПустойКонтейнер(); 
	
	ТаблицаТоваров = Товары.Выгрузить(,"Контейнер, КонтейнерПриемник, КонтейнерОтправитель");
	вмс_РаботаСКоллекциями.УдалитьПустыеСтрокиКоллекции(ТаблицаТоваров, "Контейнер");
	
	Для каждого Строка Из  ТаблицаТоваров Цикл 
		Если ЗначениеЗаполнено(Строка.КонтейнерПриемник) ИЛИ ЗначениеЗаполнено(Строка.КонтейнерОтправитель) Тогда
			нСтрока = ИерархияКонтейнеров.Добавить();
			нСтрока.Контейнер = Строка.Контейнер;
			нСтрока.КонтейнерПриход = Строка.КонтейнерПриемник;
			нСтрока.КонтейнерРасход = Строка.КонтейнерОтправитель;		
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьПоУмолчаниюКачествоУпаковкуСериюТоваров()
	
	КачествоПоУмолчанию = Перечисления.вмс_КачествоТовара.Новый;
