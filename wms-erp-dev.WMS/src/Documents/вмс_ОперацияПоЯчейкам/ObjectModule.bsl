Функция ЗаполнитьТаблицуТоваровПоОтгрузкеЗаданий(Задания) Экспорт
	
	ТаблицаТоваров = вмс_ОперацииПоЯчейкамСервер.ПолучитьОтобранныеИПроверенныеТоварыПоЗаданиям(Задания);
	вмс_РаботаСКоллекциями.УдалитьПустыеСтрокиКоллекции(ТаблицаТоваров, "Количество");
	вмс_РаботаСКоллекциями.ДобавитьЭлементыКоллекции(Товары, ТаблицаТоваров);
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// совместимость
	ДополнительныеСвойства.Вставить("ИспользоватьСклад", Метаданные.РегистрыНакопления.вмс_ОперацияПоЯчейкам.Измерения.Найти("Склад") <> Неопределено);
	
	Если ОбменДанными.Загрузка Тогда
		Если ЭтоНовый() Тогда
			// сгенерировать уникальный номер в основной базе при загрузке из мобильной базы
			УстановитьНовыйНомер(); 
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаТовара Из Товары Цикл
		// по умолчанию ссылается на себя
		СтрокаТовара.НомерСтрокиДокумента = СтрокаТовара.НомерСтроки;
		
		// 3.2.4: пересчитать Количество базовых единициц
		Если ЗначениеЗаполнено(СтрокаТовара.Упаковка) И ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
			СтрокаТовара.КоличествоБазовыхЕдиниц = СтрокаТовара.Количество * вмс_АдаптацияКонфигураций.КоэффициентУпаковки(СтрокаТовара.Упаковка, СтрокаТовара.Товар);
		Иначе
			СтрокаТовара.КоличествоБазовыхЕдиниц = СтрокаТовара.Количество;
		КонецЕсли;
		
	КонецЦикла;
	
	Если вмс_ОперацииПоЯчейкамВызовСервера.ЭтоВидОперацииИнвентаризация(ВидОперации) Тогда
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Если ФормироватьДвиженияИнвентаризации() Тогда
				ЗаполнитьТаблицуТоваровПоИнвентаризации();
			Иначе
				Товары.Очистить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВремяНачалаОперации) И ЗначениеЗаполнено(ВремяОкончанияОперации) Тогда
		ВремяВСекундах = ВремяОкончанияОперации - ВремяНачалаОперации; 	
	КонецЕсли;  

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ЗаполнитьТабличнуюЧастьИерархииКонтейнеров();
		ЗаполнитьПоУмолчаниюКачествоУпаковкуСериюТоваров();   
		// ТУ_Прошин_24.11.25+
		ПроверитьНаличиеВскрытыхКонтейнеров();
		// ТУ_Прошин_24.11.25-
	КонецЕсли;
	
	
	
КонецПроцедуры

Функция ФормироватьДвиженияИнвентаризации()
	
	Если НЕ вмс_ОперацииПоЯчейкамВызовСервера.ЭтоВидОперацииИнвентаризация(ВидОперации) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
