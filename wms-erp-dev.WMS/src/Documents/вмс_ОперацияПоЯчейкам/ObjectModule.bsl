Процедура ОбработатьЗаявкуКладовщику()
	
	Если ЗначениеЗаполнено(ЗаданиеКладовщику) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьДвиженияПланируемыйРасходПриход();
	
	СформироватьДвиженияВыполнениеРаспоряжения();
	
	Если Готов Тогда
		ЗакрытьПланПоЗаданиюКладовщику();
	КонецЕсли;
	
