Функция СформироватьДвиженияПланируемыйРасходПриход()
	
	ТаблицаРегистра = ТаблицаДвиженийПланируемыйПриходРасход();
	
	НаборЗаписей = Движения.вмс_ОперацияПоЯчейкам;
	НаборЗаписей.Записывать = Истина;
	
	Если ТаблицаРегистра.Количество() > 0  Тогда
		Для каждого Строка Из ТаблицаРегистра Цикл
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
		КонецЦикла;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ОбменДанными") И ДополнительныеСвойства.ОбменДанными = Истина Тогда
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
	КонецЕсли;
	
КонецФункции

Функция ЗакрытьПланПоЗаданиюКладовщику()
	
	НаборЗаписей = Движения.вмс_ОперацияПоЯчейкам;
	НаборЗаписей.Записать();
	
	ТаблицаРасхожденийПриходРасход = ПолучитьТаблицуРасхожденийЗаданияПриходРасход();  
	Если ТаблицаРасхожденийПриходРасход.Количество() > 0 Тогда   
		
		ПоляПоУмолчнию = Новый Структура;
		ПоляПоУмолчнию.Вставить("Период", Дата);
		ПоляПоУмолчнию.Вставить("ВидДвижения", ВидДвиженияНакопления.Приход);
		ПоляПоУмолчнию.Вставить("Сторно", Истина);
		
		НаборЗаписей.Записывать = Истина;
		Для Каждого Строка Из ТаблицаРасхожденийПриходРасход Цикл
			НоваяСтрока = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПоляПоУмолчнию);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;
		
		Если ДополнительныеСвойства.Свойство("ОбменДанными") И ДополнительныеСвойства.ОбменДанными = Истина Тогда   
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТаблицуРасхожденийЗаданияПриходРасход() 
	
		лТекст = "ВЫБРАТЬ
		         |	вмс_ЗаданиеКладовщику.Ссылка КАК ЗаданиеКладовщику,
		         |	вмс_ЗаданиеКладовщику.Ссылка КАК Регистратор
		         |ПОМЕСТИТЬ ВТ_Документы
		         |ИЗ
		         |	Документ.вмс_ЗаданиеКладовщику КАК вмс_ЗаданиеКладовщику
		         |ГДЕ
		         |	вмс_ЗаданиеКладовщику.Ссылка = &ЗаданиеКладовщику
		         |
		         |ОБЪЕДИНИТЬ ВСЕ
		         |
		         |ВЫБРАТЬ
		         |	вмс_ОперацияПоЯчейкам.ЗаданиеКладовщику,
		         |	вмс_ОперацияПоЯчейкам.Ссылка
		         |ИЗ
		         |	Документ.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкам
		         |ГДЕ
		         |	вмс_ОперацияПоЯчейкам.ЗаданиеКладовщику = &ЗаданиеКладовщику
		         |;
		         |
		         |////////////////////////////////////////////////////////////////////////////////
		         |ВЫБРАТЬ
		         |	ВТ_Документы.ЗаданиеКладовщику КАК ЗаданиеКладовщику,
		         |	вмс_ОперацияПоЯчейкамОбороты.Ячейка КАК Ячейка,
		         |	вмс_ОперацияПоЯчейкамОбороты.Контейнер КАК Контейнер,
		         |	вмс_ОперацияПоЯчейкамОбороты.Товар КАК Товар,
		         |	вмс_ОперацияПоЯчейкамОбороты.Характеристика КАК Характеристика,
		         |	вмс_ОперацияПоЯчейкамОбороты.Серия КАК Серия,
		         |	вмс_ОперацияПоЯчейкамОбороты.Партия КАК Партия,
		         |	вмс_ОперацияПоЯчейкамОбороты.Упаковка КАК Упаковка,
		         |	вмс_ОперацияПоЯчейкамОбороты.Качество КАК Качество,
		         |	&вмс_ОперацияПоЯчейкамОбороты_Склад КАК Склад,
		         |	ВЫБОР
		         |		КОГДА вмс_ОперацияПоЯчейкамОбороты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		         |			ТОГДА вмс_ОперацияПоЯчейкамОбороты.ПланируемыйРасход
		         |		ИНАЧЕ -вмс_ОперацияПоЯчейкамОбороты.ПланируемыйРасход
		         |	КОНЕЦ КАК ПланируемыйРасход,
		         |	ВЫБОР
		         |		КОГДА вмс_ОперацияПоЯчейкамОбороты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		         |			ТОГДА вмс_ОперацияПоЯчейкамОбороты.ПланируемыйПриход
		         |		ИНАЧЕ -вмс_ОперацияПоЯчейкамОбороты.ПланируемыйПриход
		         |	КОНЕЦ КАК ПланируемыйПриход
		         |ПОМЕСТИТЬ ВТ_Итог
		         |ИЗ
		         |	ВТ_Документы КАК ВТ_Документы
		         |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкамОбороты
		         |		ПО ВТ_Документы.Регистратор = вмс_ОперацияПоЯчейкамОбороты.Регистратор
		         |ГДЕ
		         |	вмс_ОперацияПоЯчейкамОбороты.Активность
		         |;
		         |
		         |////////////////////////////////////////////////////////////////////////////////
		         |ВЫБРАТЬ
		         |	ВТ_Итог.ЗаданиеКладовщику КАК ЗаданиеКладовщику,
		         |	ВТ_Итог.Ячейка КАК Ячейка,
		         |	ВТ_Итог.Контейнер КАК Контейнер,
		         |	ВТ_Итог.Товар КАК Товар,
		         |	ВТ_Итог.Характеристика КАК Характеристика,
		         |	ВТ_Итог.Серия КАК Серия,
		         |	ВТ_Итог.Партия КАК Партия,
		         |	ВТ_Итог.Упаковка КАК Упаковка,
		         |	ВТ_Итог.Качество КАК Качество,
		         |	ВТ_Итог.Склад КАК Склад,
		         |	-СУММА(ВТ_Итог.ПланируемыйРасход) КАК ПланируемыйРасход,
		         |	-СУММА(ВТ_Итог.ПланируемыйПриход) КАК ПланируемыйПриход
		         |ИЗ
		         |	ВТ_Итог КАК ВТ_Итог
		         |
		         |СГРУППИРОВАТЬ ПО
		         |	ВТ_Итог.ЗаданиеКладовщику,
		         |	ВТ_Итог.Ячейка,
		         |	ВТ_Итог.Контейнер,
		         |	ВТ_Итог.Товар,
		         |	ВТ_Итог.Характеристика,
		         |	ВТ_Итог.Серия,
		         |	ВТ_Итог.Партия,
		         |	ВТ_Итог.Упаковка,
		         |	ВТ_Итог.Качество,
		         |	ВТ_Итог.Склад
		         |
		         |ИМЕЮЩИЕ
		         |	(СУММА(ВТ_Итог.ПланируемыйРасход) <> 0
		         |		ИЛИ СУММА(ВТ_Итог.ПланируемыйПриход) <> 0)";

		
	лТекст = СтрЗаменить(лТекст, "&вмс_ОперацияПоЯчейкамОбороты_Склад", ?(ДополнительныеСвойства.ИспользоватьСклад, "вмс_ОперацияПоЯчейкамОбороты.Склад", "НЕОПРЕДЕЛЕНО"));
	
	лЗапрос = Новый Запрос(лТекст);
	лЗапрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	лЗапрос.УстановитьПараметр("ЗаданиеКладовщику", ЗаданиеКладовщику);     
	
	ТаблицаРасхожденийСПланомПриходРасход = лЗапрос.Выполнить().Выгрузить();     
	
	Возврат ТаблицаРасхожденийСПланомПриходРасход;
	
КонецФункции

Функция ТаблицаДвиженийПланируемыйПриходРасход()
	
	ИспользоватьСклад = ДополнительныеСвойства.ИспользоватьСклад;

	Таблица = Движения.вмс_ОперацияПоЯчейкам.ВыгрузитьКолонки();
	ВидДвижения = ВидДвиженияНакопления.Расход;
	
	Если ЗначениеЗаполнено(ВидДвижения) Тогда 
		
		Для Каждого СтрокаДокумента Из Товары Цикл 
			
			Если ЗначениеЗаполнено(СтрокаДокумента.Ячейка) Тогда
				СтрокаРегистра = Таблица.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРегистра, СтрокаДокумента);
				СтрокаРегистра.ПланируемыйРасход = СтрокаДокумента.Количество;   
				Если ИспользоватьСклад Тогда
					СтрокаРегистра.Склад = СтрокаДокумента.Ячейка.Владелец; 
				КонецЕсли;
				СтрокаРегистра.ВидДвижения = ВидДвижения;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаДокумента.ЯчейкаПриемник) Тогда
				СтрокаРегистра = Таблица.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРегистра, СтрокаДокумента);
				СтрокаРегистра.Ячейка = СтрокаДокумента.ЯчейкаПриемник;
				СтрокаРегистра.ПланируемыйПриход = СтрокаДокумента.Количество; 
				Если ИспользоватьСклад Тогда
					СтрокаРегистра.Склад = СтрокаДокумента.ЯчейкаПриемник.Владелец; 
				КонецЕсли;
				СтрокаРегистра.ВидДвижения = ВидДвижения;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Таблица.ЗаполнитьЗначения(0, "Количество"); // для этого документа Количество ни к чему
	Таблица.ЗаполнитьЗначения(Дата, "Период");
	Таблица.ЗаполнитьЗначения(Ссылка, "Регистратор");
	Таблица.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат Таблица;
	
КонецФункции

Функция СформироватьДвиженияВыполнениеРаспоряжения()
	
	Движения.вмс_ЗаданияКладовщикам.Записывать = Истина;
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.вмс_ЗаданияКладовщикам.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Распоряжение = ДокументОснование;
		Движение.Операция = ВидОперации;
		Движение.Номенклатура = ТекСтрокаТовары.Товар;
		Движение.Характеристика = ТекСтрокаТовары.Характеристика;
		Движение.Серия = ТекСтрокаТовары.Серия;
		Движение.Упаковка = ТекСтрокаТовары.Упаковка;
		Движение.Количество = ТекСтрокаТовары.Количество;
		Движение.КоличествоБазовыхЕдиниц = ТекСтрокаТовары.КоличествоБазовыхЕдиниц;
	КонецЦикла;
	
КонецФункции

