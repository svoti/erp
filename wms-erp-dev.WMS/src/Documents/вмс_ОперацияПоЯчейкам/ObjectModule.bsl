	Для каждого Строка Из ТоварыПоИнвентаризации  Цикл
		Если ЗначениеЗаполнено(Строка.Товар) Тогда 
			Если ЗначениеЗаполнено(Строка.Качество) = Ложь Тогда
				Строка.Качество = КачествоПоУмолчанию;	
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.Упаковка) = Ложь Тогда
				Строка.Упаковка = УпаковкаПоУмолчанию;	
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.Серия) = Ложь Тогда
				Строка.Серия = СерияПоУмолчанию;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
	Для каждого Строка Из АгрегацияКонтейнеров  Цикл
		Если ЗначениеЗаполнено(Строка.Товар) Тогда 
			Если ЗначениеЗаполнено(Строка.Качество) = Ложь Тогда
				Строка.Качество = КачествоПоУмолчанию;	
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.Упаковка) = Ложь Тогда
				Строка.Упаковка = УпаковкаПоУмолчанию;	
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.Серия) = Ложь Тогда
				Строка.Серия = СерияПоУмолчанию;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Строка Из КодыМаркировки  Цикл
		Если ЗначениеЗаполнено(Строка.Товар) Тогда 
			Если ЗначениеЗаполнено(Строка.Качество) = Ложь Тогда
				Строка.Качество = КачествоПоУмолчанию;	
			КонецЕсли;   
			// ТУ_Васильев 07.10.25 ++ Упаковки нет в рекизите таблицы КодыМаркировки
			//Если ЗначениеЗаполнено(Строка.Упаковка) = Ложь Тогда
			//	Строка.Упаковка = УпаковкаПоУмолчанию;	
