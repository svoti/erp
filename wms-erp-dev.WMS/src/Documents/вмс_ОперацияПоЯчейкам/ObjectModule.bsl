			Если ЗначениеЗаполнено(Строка.Серия) = Ложь Тогда
				Строка.Серия = СерияПоУмолчанию;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Функция ВыполнитьКонтрольОстатков(Отказ)
	
	ТоварныеПоля = вмс_ОперацииПоЯчейкамКлиентСервер.ИспользуемыеТоварныеПоля();
	
	// Кулалаев Е.С + 31.05.2023 12:26:19
	// BOX-57 Модуль учета единиц измерения в мобильной версии: Остатки по упаковкам не ведутся. Пока.
	Если ТоварныеПоля.Найти("Упаковка") <> Неопределено Тогда
		вмс_РаботаСКоллекциями.ВычестьМассив(ТоварныеПоля, "Упаковка");
	КонецЕсли;
	// Кулалаев Е.С 
	
	Колонки = вмс_РаботаСКоллекциями.МассивВСтроку(ТоварныеПоля);
	КолонкиДокумента = Колонки + ", Ячейка";
	
	ТаблицаТоваров = Товары.Выгрузить(, КолонкиДокумента); 
	ТаблицаТоваров.Свернуть(КолонкиДокумента);  
	
	Запрос = Новый Запрос; 
	Запрос.Текст = 
	"ВЫБРАТЬ	
	|   *	
	|ПОМЕСТИТЬ ТоварыДокумента
	|ИЗ
	|   &ВнешнийИсточник КАК ТоварыДокумента 
	|;
	|//////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(&МоментВремени, 	
	|			(&ТоварныеПоля) В
	|				(ВЫБРАТЬ
	|					&ТоварныеПоля
	|				ИЗ
	|					ТоварыДокумента КАК Таблица)) КАК вмс_ОперацияПоЯчейкамОстатки
	|ГДЕ
	|	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток < 0";   
	
	ГраницаКонтроля = Новый Граница(МоментВремени(), ВидГраницы.Включая);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТоварныеПоля", КолонкиДокумента); 	
	Запрос.УстановитьПараметр("МоментВремени", ГраницаКонтроля);
	Запрос.УстановитьПараметр("ТоварныеПоля", КолонкиДокумента);
	Запрос.УстановитьПараметр("ВнешнийИсточник", ТаблицаТоваров);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	//  5. Вывод сообщений о недостатке товаров
	Если Не РезультатЗапроса.Пустой() Тогда
		Отказ = Истина;
		ВыборкаОшибки = РезультатЗапроса.Выбрать(); 
		
		ЗаголовокСообщения = "Ошибка контроля остатков при проведении!" + Символы.ПС;
		ТоварнаяСтрока = "";
		
		Пока ВыборкаОшибки.Следующий() Цикл    
			
			Поля = Новый Структура(КолонкиДокумента,);
			ЗаполнитьЗначенияСвойств(Поля, ВыборкаОшибки);	
			
			Для каждого Поле Из Поля Цикл 
				Если ЗначениеЗаполнено(Поле.Значение) Тогда
					ТоварнаяСтрока = ТоварнаяСтрока + "- " + Поле.Ключ + ": " + Поле.Значение + Символы.ПС;		
				КонецЕсли;
			КонецЦикла; 
			
			ТоварнаяСтрока = СтрШаблон("%1Не хватает %2 шт %3 %3", ТоварнаяСтрока, -ВыборкаОшибки.КоличествоОстаток, Символы.ПС);  
			
		КонецЦикла;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("%1%2", ЗаголовокСообщения, ТоварнаяСтрока);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецФункции

Процедура ПроверитьНаличиеВскрытыхКонтейнеров()  
	
	// Если контейнер есть в колонке "КонтейнерОтправитель" значит из него что-то достали, таким образом его вскрыли.
	Для каждого Строка Из Товары Цикл
		Если ЗначениеЗаполнено(Строка.КонтейнерОтправитель) Тогда      
			Если НЕ Строка.КонтейнерОтправитель.Вскрыт Тогда   
				Справочники.вмс_Контейнеры.УстановитьФлагВскрытКонтейнеру(Строка.КонтейнерОтправитель);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;   
	
	Для каждого Строка Из ТоварыПоИнвентаризации Цикл
		Если ЗначениеЗаполнено(Строка.КонтейнерОтправитель) Тогда      
			Если НЕ Строка.КонтейнерОтправитель.Вскрыт Тогда   
				Справочники.вмс_Контейнеры.УстановитьФлагВскрытКонтейнеру(Строка.КонтейнерОтправитель);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

