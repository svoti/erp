#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

// ТОВАРЫ
&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Копирование Тогда
		Элемент.ТекущиеДанные.ИдентификаторИнструкции = 0;
	КонецЕсли;
	
КонецПроцедуры

// НАСТРОЙКИ ПОЛЕЙ

// ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
&НаКлиенте
Функция ОбработчикОбновленияДокумента(ОбработчикОжидания, ДополнительныеПараметры) Экспорт
	
	ЗаполнитьФактическоеКоличествоНаКлиентеНаСервереБезКонтекста(Объект.Товары, ПолучитьФактВыполненияИнструкций(Объект.Ссылка));
	
КонецФункции

//функции без контекста используются для того, чтобы форма не "моргала" при клиент-серверной передаче формы
//в таком случае при редактировании текста в поле ввода, текст очищается и невозможно нормально вводить данные
&НаСервереБезКонтекста
Функция ПолучитьДанныеОбновленияДокументаНаСервереБезКонтекста(знач ПараметрыФункции)

	Ссылка = ПараметрыФункции.Ссылка;
	
	ТекущаяВерсияДанных = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(Ссылка);
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ТекущаяВерсияДанных", ТекущаяВерсияДанных);
	Если ПараметрыФункции.ВерсияДанных=ТекущаяВерсияДанных Тогда
		РезультатФункции.Вставить("ДанныеФакта", ПолучитьФактВыполненияИнструкций(Ссылка));
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

&НаСервере
Функция ЗаполнитьФактическоеКоличество()
	
	ЗаполнитьФактическоеКоличествоНаКлиентеНаСервереБезКонтекста(Объект.Товары, ПолучитьФактВыполненияИнструкций(Объект.Ссылка));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполнитьФактическоеКоличествоНаКлиентеНаСервереБезКонтекста(Товары, ДанныеФакта)

	Для Каждого ЭлементТовара Из Товары Цикл
		
		КоличествоФакт = ДанныеФакта[ЭлементТовара.ИдентификаторИнструкции];
		Если КоличествоФакт=Неопределено Тогда
			КоличествоФакт = 0;
		КонецЕсли;
		
		Если ЭлементТовара.КоличествоФакт <> КоличествоФакт Тогда
			ЭлементТовара.КоличествоФакт = КоличествоФакт;
		КонецЕсли;
		
	КонецЦикла;
	
	РассчитатьИдентификаторыОформленияСтрокТоваров(Товары);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФактВыполненияИнструкций(знач Ссылка)
	
	ТаблицаФакта = Документы.вмс_ЗаданиеКладовщику.ПолучитьФактВыполненияИнструкций(Ссылка);
	
	ДанныеФакта = Новый Соответствие;
	Для Каждого СтрокаФакта Из ТаблицаФакта Цикл
		ДанныеФакта[СтрокаФакта.ИдентификаторИнструкции] = СтрокаФакта.Количество;
	КонецЦикла;
	
	Возврат ДанныеФакта;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьИдентификаторыОформленияСтрокТоваров(знач Строки)
	
	Если Строки=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипСтрок = ТипЗнч(Строки);
	Если ТипСтрок <> Тип("Массив") И ТипСтрок <> Тип("ДанныеФормыКоллекция") Тогда
		Строка = Строки;
		Строки = Новый Массив;
		Строки.Добавить(Строка);
	КонецЕсли;
	
	Для Каждого Строка Из Строки Цикл
		Если Строка.КоличествоФакт=0 Тогда
			ИдентификаторОформления = 0;
		ИначеЕсли Строка.КоличествоФакт < Строка.Количество Тогда
			ИдентификаторОформления = 1;
		ИначеЕсли Строка.КоличествоФакт = Строка.Количество Тогда
			ИдентификаторОформления = 2;
		Иначе
			ИдентификаторОформления = 3;
		КонецЕсли;
		
		Если Строка.ИдентификаторОформления <> ИдентификаторОформления Тогда
			Строка.ИдентификаторОформления = ИдентификаторОформления;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция НастроитьОформлениеСтрокТоваров()
	
	Цвета = Новый Массив;
	Цвета.Добавить(Новый Цвет(255, 255, 200));
	Цвета.Добавить(Новый Цвет(200, 255, 200));
	Цвета.Добавить(Новый Цвет(255, 200, 200));
	
	Для НомерЦвета=1 По Цвета.Количество() Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
		ПолеУО.Поле = Новый ПолеКомпоновкиДанных("Товары");
		
		ОтборУО = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.ИдентификаторОформления");
		ОтборУО.ПравоеЗначение = НомерЦвета;
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвета[НомерЦвета-1]);
	КонецЦикла;
	
КонецФункции

