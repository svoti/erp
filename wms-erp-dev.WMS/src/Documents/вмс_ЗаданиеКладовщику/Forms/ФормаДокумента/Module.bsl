&НаСервере
Процедура УстановитьСвязиВыбора() 
	
	Если вмс_АдаптацияКонфигураций.ЭтоУТ() ИЛИ вмс_АдаптацияКонфигураций.ЭтоЕРП() Тогда 
		
		// установка связей параметров выбора
		// по владельцу характеристике
		
		Элементы.ТоварыХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(Новый массив);
		
		Связи = Новый Массив();
		НоваяСвязь = Новый СвязьПараметраВыбора("Номенклатура", "Элементы.Товары.ТекущиеДанные.Номенклатура");	
		Связи.Добавить(НоваяСвязь); 
		
		Элементы.ТоварыХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(Связи);
		
		// по владельцу серии
		Элементы.ТоварыСерия.СвязиПараметровВыбора = Новый ФиксированныйМассив(Новый массив);
		
		Связи = Новый Массив();
		НоваяСвязь = Новый СвязьПараметраВыбора("Склад", "Объект.Склад");
		Связи.Добавить(НоваяСвязь);
		НоваяСвязь = Новый СвязьПараметраВыбора("Номенклатура", "Элементы.Товары.ТекущиеДанные.Номенклатура");  
		Связи.Добавить(НоваяСвязь);
		НоваяСвязь = Новый СвязьПараметраВыбора("Характеристика", "Элементы.Товары.ТекущиеДанные.Характеристика");
		Связи.Добавить(НоваяСвязь);
			
		Элементы.ТоварыСерия.СвязиПараметровВыбора = Новый ФиксированныйМассив(Связи);
		
	КонецЕсли; 
	
	Если вмс_АдаптацияКонфигураций.ЭтоУНФ() Тогда
		
		Элементы.ТоварыХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(Новый массив);
		
		НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Владелец", "Элементы.Товары.ТекущиеДанные.Номенклатура");
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НоваяСвязь);	
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	Если Объект.Авто Тогда
		Объект.Авто = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Автозаполнение задания отключено");
	КонецЕсли;
	РассчитатьИдентификаторыОформленияСтрокТоваров(Элемент.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник=ЭтаФорма Тогда
		Если ИмяСобытия="НастройкаПолей_ПриИзменении" Тогда
			НастройкаПолей_ПриИзменении(Параметр.СтандартнаяОбработка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОперацияПриИзменении(Элемент)
	
	Объект.Правило = НайтиПравилоЗаполненияЗадания(Объект.Операция);
	
	ПравилоПриИзменении(Элементы.Правило);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиПравилоЗаполненияЗадания(знач ВидОперации)
	
	Возврат Справочники.вмс_ПравилаЗаполненияЗадачиКладовщику.НайтиПравилоЗаполненияЗадания(ВидОперации);
	
КонецФункции

&НаКлиенте
Процедура ПравилоПриИзменении(Элемент)

	Если Объект.АвтоНастройкаПолей Тогда
		
		ЗаполнитьНастройкуПолейПоУмолчанию();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
