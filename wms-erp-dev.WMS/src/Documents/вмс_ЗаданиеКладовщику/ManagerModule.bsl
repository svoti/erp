Функция СводнаяТаблицаДляЗаполнения(Знач МаршрутОтбора, Знач ТаблицаПлан)
	
	РК = вмс_РаботаСКоллекциями;
	
	КолонкиМаршрута = РК.ПолучитьКолонкиКоллекции(МаршрутОтбора);
	КолонкиПлана = РК.ПолучитьКолонкиКоллекции(ТаблицаПлан);
	
	КолонкиСводнойТаблицы = РК.СложениеМассивов(КолонкиМаршрута, КолонкиПлана);
	РК.УдалитьДублиВМассиве(КолонкиСводнойТаблицы);
	РК.УдалитьЭлементыКоллекции(КолонкиМаршрута, "Товар");
	
	КолонкиСводнойТаблицы.Добавить("ИдентификаторИнструкции");
	КолонкиСводнойТаблицы.Добавить("ДополнительныеЯчейки");
	
	СводнаяТаблица = РК.НоваяТаблицаЗначений(КолонкиСводнойТаблицы);
	
	Возврат СводнаяТаблица;

