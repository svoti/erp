	Для Каждого Поле Из ТаблицаНастройки.НайтиСтроки(Новый Структура("Использование", Ложь)) Цикл
		
		ТаблицаНастройки.Удалить(Поле);
		
	КонецЦикла;
	
КонецФункции

Функция ЗаполнитьНастройкуПолейСтрокДокумента(ЗаданиеКладовщику) Экспорт
	
	ЗаданиеКладовщику.НастройкаПолейСтрок.Очистить();
	
	ЗаполнитьСвойстваПоляЯчейкаСтрокЗадания(ЗаданиеКладовщику);
	ЗаполнитьСвойстваПоляЯчейкаПриемникСтрокЗадания(ЗаданиеКладовщику);
	
	ЗаполнитьПолеСерияСтрокЗадания(ЗаданиеКладовщику);
	
	ЗаполнитьПолеКонтейнерПриемникСтрокЗадания(ЗаданиеКладовщику);  
	
	//ТУ_Прошин_07.05.26+      
	ЗаполнитьПолеКонтейнерОтправительСтрокЗадания(ЗаданиеКладовщику);
	ЗаполнитьПолеТоварСтрокЗадания(ЗаданиеКладовщику);
	ЗаполнитьПолеХарактеристикаСтрокЗадания(ЗаданиеКладовщику);
	ЗаполнитьПолеКонтейнерСтрокЗадания(ЗаданиеКладовщику);
	//ТУ_Прошин_07.05.26-
	
	ЗаданиеКладовщику.НастройкаПолейСтрок.Сортировать("ИдентификаторИнструкции, ИмяПоля, ИмяСвойства");
	
КонецФункции

Функция ЗаполнитьСвойстваПоляЯчейкаСтрокЗадания(ЗаданиеКладовщику)

	НастройкаПолей = ЗаданиеКладовщику.ДополнительныеСвойства.СтруктураНастройкиПолей.НастройкаПолей;
	
	ИмяПоля = "Ячейка";
	ИспользуетсяПланПоЯчейкеПриемнику = НастройкаПолей.НайтиСтроки(Новый Структура("Имя, План", ИмяПоля, Истина)).Количество() > 0;
	Если НЕ ИспользуетсяПланПоЯчейкеПриемнику Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Строка Из ЗаданиеКладовщику.Товары Цикл
		Если ЗначениеЗаполнено(Строка[ИмяПоля]) Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваПоля = Новый Структура;
		СвойстваПоля.Вставить("План", Ложь);
		УстановитьНастройкуПолейДляИнструкцийЗадания(Строка, ЗаданиеКладовщику.НастройкаПолейСтрок, ИмяПоля, СвойстваПоля);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьСвойстваПоляЯчейкаПриемникСтрокЗадания(ЗаданиеКладовщику)

	НастройкаПолей = ЗаданиеКладовщику.ДополнительныеСвойства.СтруктураНастройкиПолей.НастройкаПолей;
	
	ИмяПоля = "ЯчейкаПриемник";
	ИспользуетсяПланПоЯчейкеПриемнику = НастройкаПолей.НайтиСтроки(Новый Структура("Имя, Ввод, План", ИмяПоля, Истина, Истина)).Количество() > 0;
	Если НЕ ИспользуетсяПланПоЯчейкеПриемнику Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Строка Из ЗаданиеКладовщику.Товары Цикл
		Если ЗначениеЗаполнено(Строка[ИмяПоля]) Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваПоля = Новый Структура;
		СвойстваПоля.Вставить("План", Ложь);
		УстановитьНастройкуПолейДляИнструкцийЗадания(Строка, ЗаданиеКладовщику.НастройкаПолейСтрок, ИмяПоля, СвойстваПоля);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьПолеСерияСтрокЗадания(ЗаданиеКладовщику)

	НастройкаПолей = ЗаданиеКладовщику.ДополнительныеСвойства.СтруктураНастройкиПолей.НастройкаПолей;

	ПолеСерияМассив = НастройкаПолей.НайтиСтроки(Новый Структура("Имя", "Серия"));
	Если ПолеСерияМассив.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПолеСерия = ПолеСерияМассив[0];
	
	ТаблицаИспользованияСерий = вмс_СерииТоваровСервер.ИспользованиеУчетаСерийПоТоварам(ЗаданиеКладовщику.Товары.ВыгрузитьКолонку("Номенклатура"));
	НоменклатураСУчетомПоСериям = ТаблицаИспользованияСерий.Скопировать(Новый Структура("Используется", Истина)).ВыгрузитьКолонку("Товар");

	Для Каждого Строка Из ЗаданиеКладовщику.Товары Цикл
		СвойстваПоля = Новый Структура;

		ВедениеСерийногоУчетаПоТовару = НоменклатураСУчетомПоСериям.Найти(Строка.Номенклатура) <> Неопределено;
		ПланДляСтроки = НЕ (ВедениеСерийногоУчетаПоТовару И НЕ ЗначениеЗаполнено(Строка.Серия));
		Если ПолеСерия.План И НЕ ПланДляСтроки Тогда
			СвойстваПоля.Вставить("План", ПланДляСтроки);
		КонецЕсли;
		
		Если НЕ ВедениеСерийногоУчетаПоТовару Тогда
			СвойстваПоля.Вставить("Вывод", Ложь);
			//СвойстваПоля.Вставить("ОбязательныйВвод", Ложь);
			СвойстваПоля.Вставить("Ввод", Ложь);
			СвойстваПоля.Вставить("ОбязательноеЗаполнение", Ложь);
		КонецЕсли;
		
		Если СвойстваПоля.Количество() > 0 Тогда
			УстановитьНастройкуПолейДляИнструкцийЗадания(Строка, ЗаданиеКладовщику.НастройкаПолейСтрок, "Серия", СвойстваПоля);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
		
КонецФункции

