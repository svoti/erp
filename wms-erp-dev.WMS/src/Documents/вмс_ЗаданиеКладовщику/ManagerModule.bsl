Функция ЗаполнитьПолеТоварСтрокЗадания(ЗаданиеКладовщику)  
	
	НастройкаПолей = ЗаданиеКладовщику.ДополнительныеСвойства.СтруктураНастройкиПолей.НастройкаПолей;
	
	ПолеТоварМассив = НастройкаПолей.НайтиСтроки(Новый Структура("Имя", "Товар"));
	Если ПолеТоварМассив.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПолеТовар = ПолеТоварМассив[0];
	
	Для Каждого Строка Из ЗаданиеКладовщику.Товары Цикл
		СвойстваПоля = Новый Структура;
		Использование = ЗначениеЗаполнено(Строка.Номенклатура) ИЛИ НЕ ЗначениеЗаполнено(Строка.Контейнер);
		Если Использование Тогда
			Если ПолеТовар.План И НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				// товар не указан, разрешим ввод любого товара
				СвойстваПоля.Вставить("План", Ложь);
			КонецЕсли;
		Иначе
			// оперировать целыми контейнерами
			СвойстваПоля.Вставить("ОбязательноеЗаполнение", Использование); 
			СвойстваПоля.Вставить("Ввод", Использование);     
			СвойстваПоля.Вставить("Вывод", Использование);    
		КонецЕсли;

		Если СвойстваПоля.Количество() > 0 Тогда
			УстановитьНастройкуПолейДляИнструкцийЗадания(Строка, ЗаданиеКладовщику.НастройкаПолейСтрок, "Товар", СвойстваПоля);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;    
	
КонецФункции
	
//Устанавливает индивидуальные настройки полей для строк (инструкций) задания
//
//	Параметры:
//		ИнструкцииЗадания - Массив строк задания, одна строка задания, массив идентификаторов инструкций или один идентификатор инструкции
//		НастройкаПолейСтрок - таблица с настройками полей строк задания
//		Поля - Имена полей
//		Настройка - Структура со свойствами полей
Функция УстановитьНастройкуПолейДляИнструкцийЗадания(знач ИнструкцииЗадания, НастройкаПолейСтрок, знач Поля, Настройка) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	Если СтрНайти(Строка(ИнструкцииЗадания), "ДокументТабличнаяЧастьСтрока.")=1 ИЛИ НЕ РК.ДоступенОбходКоллекции(ИнструкцииЗадания) Тогда
		ИнструкцияЗадания = ИнструкцииЗадания;
		ИнструкцииЗадания = Новый Массив;
		ИнструкцииЗадания.Добавить(ИнструкцияЗадания);
	КонецЕсли;
	
	Поля = РК.ЗначениеВМассив(Поля, , Ложь);
	
	Для Каждого ИнструкцияЗадания Из ИнструкцииЗадания Цикл
		Если ТипЗнч(ИнструкцияЗадания)=Тип("Число") Тогда
			ИдентификаторИнструкции = ИнструкцияЗадания;
		ИначеЕсли ТипЗнч(ИнструкцияЗадания)=Тип("Строка") Тогда
			ИдентификаторИнструкции = Число(ИнструкцияЗадания);
		Иначе
			ИдентификаторИнструкции = ИнструкцияЗадания.ИдентификаторИнструкции;
		КонецЕсли;
		
		Для Каждого Поле Из Поля Цикл
			Для Каждого СвойствоПоля Из Настройка Цикл
				Отбор = Новый Структура("ИдентификаторИнструкции, ИмяПоля, ИмяСвойства", ИдентификаторИнструкции, Поле, СвойствоПоля.Ключ);
				СвойствоПоляИнструкцииМассив = НастройкаПолейСтрок.НайтиСтроки(Отбор);
				Если СвойствоПоляИнструкцииМассив.Количество()=0 Тогда
					СвойствоПоляИнструкции = НастройкаПолейСтрок.Добавить();
					ЗаполнитьЗначенияСвойств(СвойствоПоляИнструкции, Отбор);
				Иначе
					СвойствоПоляИнструкции = СвойствоПоляИнструкцииМассив[0];
				КонецЕсли;
				СвойствоПоляИнструкции.ЗначениеСвойства = СвойствоПоля.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецФункции

