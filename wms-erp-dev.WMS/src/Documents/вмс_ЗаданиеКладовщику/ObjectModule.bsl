Функция ЗаполнитьИдентификаторыИнструкций()
	
	Если Товары.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаТовары = Товары.Выгрузить();
	ТаблицаТовары.Сортировать("ИдентификаторИнструкции");
	ИдентификаторИнструкции = ТаблицаТовары[Товары.Количество()-1].ИдентификаторИнструкции;
	
	ИсправленоИдентификаторов = Ложь;
	
	НеВалидныеИдентификаторы = Новый Соответствие;
	НеВалидныеИдентификаторы[0] = Истина;
	Для Каждого Строка Из Товары Цикл
		Если НеВалидныеИдентификаторы[Строка.ИдентификаторИнструкции]=Истина Тогда
			Если Строка.ИдентификаторИнструкции <> 0 Тогда
				ИсправленоИдентификаторов = ИсправленоИдентификаторов + 1;
			КонецЕсли;
			
			ИдентификаторИнструкции = ИдентификаторИнструкции + 1;
			Строка.ИдентификаторИнструкции = ИдентификаторИнструкции;
		Иначе
			// запретить повторение идентификаторов
			НеВалидныеИдентификаторы[Строка.ИдентификаторИнструкции] = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ИсправленоИдентификаторов > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Исправлены некорректные идентификаторы инструкций");
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

