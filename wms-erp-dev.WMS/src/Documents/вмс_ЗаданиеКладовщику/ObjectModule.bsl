Функция РазделитьСборкуПоКонтейнерам(ПараметрыСборки = Неопределено)
	
	РК = вмс_РаботаСКоллекциями;
	// ТУ_Прошин_28.11.25+    
	Если ПараметрыСборки <> Неопределено Тогда  
		ТаблицаКонтейнеров = ПараметрыСборки.ТаблицаТоваров;
		Помещение = ПараметрыСборки.Помещение;  
		СсылкаНаОсновноеЗадание = ПараметрыСборки.СсылкаНаОсновноеЗадание;
	Иначе
		Помещение = Справочники.вмс_Помещения.ПустаяСсылка();
		ТаблицаКонтейнеров = Товары.Выгрузить();	   
		СсылкаНаОсновноеЗадание = Неопределено;
	КонецЕсли;
	
	// ТУ_Прошин_28.11.25-
	// ТаблицаКонтейнеров = Товары.Выгрузить(); 
	КолонкиТаблицы = РК.ПолучитьКолонкиКоллекции(ТаблицаКонтейнеров); 
	ТаблицаТоваров = РК.НоваяТаблицаЗначений(РК.МассивВСтроку(КолонкиТаблицы));
	
	ПустойКонтейнер = Справочники.вмс_Контейнеры.ПустаяСсылка();
	
	ОтборСтрокТоваров= Новый Структура("Контейнер", ПустойКонтейнер);
	НайденныеСтроки = ТаблицаКонтейнеров.НайтиСтроки(ОтборСтрокТоваров);  	
	
	РК.ДобавитьЭлементыКоллекции(ТаблицаТоваров, НайденныеСтроки);   
	РК.УдалитьЭлементыКоллекции(ТаблицаКонтейнеров, НайденныеСтроки);
	
	Если ТаблицаТоваров.Количество() = 0 ИЛИ ТаблицаКонтейнеров.Количество() = 0 Тогда 
		// нет смысла разбивать
		Возврат Ложь;
	КонецЕсли;   
	
	Если СсылкаНаОсновноеЗадание = Неопределено Тогда
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			СсылкаНаОсновноеЗадание = Документы.вмс_ЗаданиеКладовщику.ПолучитьСсылку();
			УстановитьСсылкуНового(СсылкаНаОсновноеЗадание);
		Иначе
			СсылкаНаОсновноеЗадание = Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ТаблицаТоваров");
	ДанныеЗаполнения.Вставить("Комментарий");
	ДанныеЗаполнения.Вставить("Помещение");
	
	ДанныеЗаполнения.ТаблицаТоваров = ТаблицаТоваров;
	ДанныеЗаполнения.Комментарий = "Без контейнеров";
	ДанныеЗаполнения.Помещение = Помещение;
	СоздатьЗаданиеКладовщикуОтУправляющегоЗадания(СсылкаНаОсновноеЗадание, ДанныеЗаполнения);
	
	ДанныеЗаполнения.ТаблицаТоваров = ТаблицаКонтейнеров;
	ДанныеЗаполнения.Комментарий = "По контейнерам";
	ДанныеЗаполнения.Помещение = Помещение;
	СоздатьЗаданиеКладовщикуОтУправляющегоЗадания(СсылкаНаОсновноеЗадание, ДанныеЗаполнения);
	
	Возврат Истина;
	
КонецФункции  

Функция СоздатьЗаданиеКладовщикуОтУправляющегоЗадания(СсылкаНаОсновноеЗадание, ДанныеЗаполнения)
	
	НовоеЗадание = Документы.вмс_ЗаданиеКладовщику.СоздатьДокумент();
	НовоеЗадание.Заполнить(Неопределено);
	ЗаполнитьЗначенияСвойств(НовоеЗадание, ЭтотОбъект,,"Номер, Дата");
	НовоеЗадание.Дата = Дата + 1;
	НовоеЗадание.Авто = Ложь;
	НовоеЗадание.Комментарий = НовоеЗадание.Комментарий + " " + ДанныеЗаполнения.Комментарий;
	НовоеЗадание.ОсновноеЗадание = СсылкаНаОсновноеЗадание;
	НовоеЗадание.Товары.Загрузить(ДанныеЗаполнения.ТаблицаТоваров);
	НовоеЗадание.Помещение = ДанныеЗаполнения.Помещение;
	
	//НовоеЗадание.НастройкаПолей.Загрузить(НастройкаПолей.Выгрузить());
	//НовоеЗадание.СборщикиДанных.Загрузить(СборщикиДанных.Выгрузить());
	//НовоеЗадание.НастройкаСтраниц.Загрузить(НастройкаСтраниц.Выгрузить());
	
	
	НовоеЗадание.Записать(РежимЗаписиДокумента.Проведение);
	
КонецФункции 

Функция ИнициализироватьПараметрыСборки()   
	
	ПараметрыСборки = Новый Структура("Помещение, ТаблицаТоваров, СсылкаНаОсновноеЗадание");
	Возврат ПараметрыСборки;       
	
КонецФункции

Функция РаботаСЗаданиемНаТСДЗавершена()
	
	Если Состояние = Перечисления.вмс_СостоянияЗаявокКладовщику.Завершена Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Состояние = Перечисления.вмс_СостоянияЗаявокКладовщику.ЗавершенаСОшибками Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Состояние = Перечисления.вмс_СостоянияЗаявокКладовщику.ЗавершенаСРасхождением Тогда
		Возврат Истина;	
	КонецЕсли;	
	
	Возврат Ложь;   
	
КонецФункции

Функция СкопироватьДополнительныеСвойства()
	
	// ТУ_Алфимов Д.С. 21.04.26 ++ Очистка плановой инвентаризации запрещена
	Если НЕ Операция.ИмяДляПоиска = "ПлановаяИнвентаризация" Тогда
		ТаблицаДополнительныхРеквизитов = вмс_УправлениеСвойствамиСервер.ПолучитьТаблицуДополнительныхРеквизитовОбъекта(Правило);
		ТаблицаДополнительныхРеквизитов.Колонки.ЗначениеСвойства.Имя = "Значение";
		
		ДополнительныеРеквизиты.Очистить();
		Для Каждого СтрокаЗначенияДополнительногоРеквизитаИсточника Из ТаблицаДополнительныхРеквизитов Цикл
			СтрокаЗначенияДополнительногоРеквизита = ДополнительныеРеквизиты.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗначенияДополнительногоРеквизита, СтрокаЗначенияДополнительногоРеквизитаИсточника);
		КонецЦикла;
	КонецЕсли;
	// ТУ_Алфимов Д.С. 21.04.26 --
КонецФункции

#КонецОбласти

#КонецЕсли
