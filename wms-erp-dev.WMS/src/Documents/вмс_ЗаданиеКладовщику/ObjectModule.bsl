Функция РазделитьСборкуПоПомещениям()
	
	ИспользуемыеПомещения = Товары.ВыгрузитьКолонку("Помещение");
	вмс_РаботаСКоллекциями.УдалитьДублиВМассиве(ИспользуемыеПомещения);
	
	Если ЗначениеЗаполнено(ИспользуемыеПомещения) Тогда
		
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			СсылкаНаОсновноеЗадание = Документы.вмс_ЗаданиеКладовщику.ПолучитьСсылку();
			УстановитьСсылкуНового(СсылкаНаОсновноеЗадание);
		Иначе
			СсылкаНаОсновноеЗадание = Ссылка;
		КонецЕсли;
		
		Для каждого мПомещение Из ИспользуемыеПомещения Цикл
			// ТУ_Прошин_27.11.25 
			Если вмс_ОбщегоНазначенияСервер.ИспользуютсяКонтейнеры() Тогда          
				ПараметрыСборки = ИнициализироватьПараметрыСборки();  
				ПараметрыСборки.Помещение = мПомещение;  
				ПараметрыСборки.СсылкаНаОсновноеЗадание = СсылкаНаОсновноеЗадание;
				ПараметрыСборки.ТаблицаТоваров = Товары.Выгрузить(Новый Структура("Помещение", мПомещение),);
				
				ЗаданияСформированы = РазделитьСборкуПоКонтейнерам(ПараметрыСборки);
				Если ЗаданияСформированы Тогда
					Продолжить;	
				КонецЕсли;	
			КонецЕсли;		
			// ТУ_Прошин_27.11.25-
			НовоеЗадание = Документы.вмс_ЗаданиеКладовщику.СоздатьДокумент();
			НовоеЗадание.Заполнить(Неопределено);
			ЗаполнитьЗначенияСвойств(НовоеЗадание, ЭтотОбъект,,"Номер, Дата");
			НовоеЗадание.Дата = Дата + 1;
			НовоеЗадание.Авто = Ложь;
			НовоеЗадание.Помещение = мПомещение;
			НовоеЗадание.ОсновноеЗадание = СсылкаНаОсновноеЗадание;
			
			НовоеЗадание.Товары.Загрузить(Товары.Выгрузить(Новый Структура("Помещение", мПомещение),));
			//НовоеЗадание.НастройкаПолей.Загрузить(НастройкаПолей.Выгрузить());
			//НовоеЗадание.СборщикиДанных.Загрузить(СборщикиДанных.Выгрузить());
			//НовоеЗадание.НастройкаСтраниц.Загрузить(НастройкаСтраниц.Выгрузить());
			
			НовоеЗадание.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЦикла;
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

