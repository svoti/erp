#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ЗарегистрироватьНачалоОперации(ПараметрыРегистрации) Экспорт
	
	УстановитьОтметкуНачалаОперацииИОчиститьДанные(ПараметрыРегистрации);
	
	ЗарегистрироватьПланОперации(ПараметрыРегистрации);

	ЗаписатьНачальныеДанныеФактаОперации(ПараметрыРегистрации);
	
	Если ПараметрыРегистрации.Свойство("ПолучатьОстаткиПоПлану") И ПараметрыРегистрации.ПолучатьОстаткиПоПлану=Истина Тогда
		ЗаписатьНачальныеДанныеОстатковОперации(ПараметрыРегистрации);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция УстановитьОтметкуНачалаОперацииИОчиститьДанные(ПараметрыРегистрации)

	РК = вмс_РаботаСКоллекциями;

	Данные = Новый Структура("Оператор, ВидОперации, Распоряжение");
	ЗаполнитьЗначенияСвойств(Данные, ПараметрыРегистрации);
	Данные.Вставить("ТипРегистрации", Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.НачалоОперации);
	
	МассивВариантовПараметровРегистрации = РК.ПолучитьСочетанияЭлементов(Данные); //может быть передано несколько распоряжений

	Для Каждого ВариантПараметровРегистрации Из МассивВариантовПараметровРегистрации Цикл
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Оператор.Установить(ВариантПараметровРегистрации.Оператор);
		НаборЗаписей.Отбор.ВидОперации.Установить(ВариантПараметровРегистрации.ВидОперации);
		НаборЗаписей.Отбор.Распоряжение.Установить(ВариантПараметровРегистрации.Распоряжение);
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, ВариантПараметровРегистрации);
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецФункции

Функция ПолучитьДанныеЗарегистрированныхИзмененийОперации(ПараметрыОперации) Экспорт
	
	Факт0 = ПолучитьДанныеЗарегистрированныхИзмененийФактаОперации(ПараметрыОперации, Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Факт0);
	
	Факт  = ПолучитьДанныеЗарегистрированныхИзмененийФактаОперации(ПараметрыОперации, Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Факт);
	
	Если ПараметрыОперации.Свойство("ПолучатьОстаткиПоПлану") И ПараметрыОперации.ПолучатьОстаткиПоПлану=Истина Тогда
		
		Остатки = ПолучитьДанныеЗарегистрированныхИзмененийОстатковОперации(ПараметрыОперации);
		
	Иначе
		
		Остатки = Неопределено;
		
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ЕстьИзменения", Факт0<>Неопределено ИЛИ Факт<>Неопределено ИЛИ Остатки<>Неопределено);
	Результат.Вставить("Факт0", Факт0);
	Результат.Вставить("Факт",  Факт);
	Результат.Вставить("Остатки", Остатки);
	
	Возврат Результат;
	
КонецФункции

Функция ЗарегистрироватьСсылкуДокументаОперации(Документ) Экспорт

	Флаг1 = Документ.ДополнительныеСвойства.Свойство("ЗагруженИзТСД") И Документ.ДополнительныеСвойства.ЗагруженИзТСД = Истина;
	
	Возврат ЗарегистрироватьСсылку(Документ.ВидОперации, Документ.ДокументОснование, Документ.Ссылка, Флаг1);

КонецФункции

Функция ЗарегистрироватьСсылку(ВидОперации, Распоряжение, СсылкаОперации, Флаг1=Ложь) Экспорт

	ТаблицаОператоров = НайтиПользователейОперации(Новый Структура("ВидОперации, Распоряжение", ВидОперации, Распоряжение));
	
	Для Каждого СтрокаОператора Из ТаблицаОператоров Цикл
		Запись = СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, СтрокаОператора);
		Запись.СсылкаОперации = СсылкаОперации;
		Запись.ТипРегистрации = Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Операция;
		Запись.Флаг1 = Флаг1;
		Запись.Дата = ТекущаяДатаСеанса();
		Запись.Записать();
	КонецЦикла;
	
КонецФункции

Функция НайтиПользователейОперации(ПараметрыОперации)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	вмс_РегистрацияИзмененийОпераций.Оператор КАК Оператор,
	|	вмс_РегистрацияИзмененийОпераций.ВидОперации КАК ВидОперации,
	|	вмс_РегистрацияИзмененийОпераций.Распоряжение КАК Распоряжение
	|ИЗ
	|	РегистрСведений.вмс_РегистрацияИзмененийОпераций КАК вмс_РегистрацияИзмененийОпераций
	|ГДЕ
	|	вмс_РегистрацияИзмененийОпераций.ВидОперации = &ВидОперации
	|	И вмс_РегистрацияИзмененийОпераций.Распоряжение = &Распоряжение
	|	И вмс_РегистрацияИзмененийОпераций.ТипРегистрации = &ТипРегистрации";
	
	Запрос.УстановитьПараметр("ВидОперации", ПараметрыОперации.ВидОперации);
	Запрос.УстановитьПараметр("Распоряжение", ПараметрыОперации.Распоряжение);
	Запрос.УстановитьПараметр("ТипРегистрации", Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.НачалоОперации);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаПользователей = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаПользователей;
	
КонецФункции

