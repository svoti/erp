Функция ЗарегистрироватьПланОперации(знач ПараметрыРегистрации)

	РК = вмс_РаботаСКоллекциями;

	Данные = Новый Структура("Оператор, ВидОперации, Распоряжение");
	ЗаполнитьЗначенияСвойств(Данные, ПараметрыРегистрации);
	
	МассивПараметровРегистрации = РК.ПолучитьСочетанияЭлементов(Данные); //может быть передано несколько распоряжений

	ТаблицаПлана = Неопределено;
	Если ПараметрыРегистрации.Свойство("ТаблицаПлана", ТаблицаПлана) Тогда
		КолонкиТаблицы = РК.ПолучитьКолонкиКоллекции(ТаблицаПлана);
		Если КолонкиТаблицы <> Неопределено Тогда
			ПоРаспоряжениям = КолонкиТаблицы.Найти("Распоряжение") <> Неопределено;
		Иначе
			ТаблицаПлана = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ТипРегистрации = Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.План;
	Для Каждого ПараметрыРегистрации Из МассивПараметровРегистрации Цикл
		
		НаборЗаписей = СоздатьНаборЗаписей();
		Для Каждого ПолеДанных Из ПараметрыРегистрации Цикл
			НаборЗаписей.Отбор[ПолеДанных.Ключ].Установить(ПолеДанных.Значение);
		КонецЦикла;
		НаборЗаписей.Отбор.ТипРегистрации.Установить(ТипРегистрации);
		
		Если ТаблицаПлана = Неопределено Тогда
			
			//пустой план
			
		Иначе
			
			Если ПоРаспоряжениям Тогда
				ТоварыПоРаспоряжению = РК.НайтиЭлементыКоллекции(ТаблицаПлана, Новый Структура("Распоряжение", ПараметрыРегистрации.Распоряжение));
			Иначе
				ТоварыПоРаспоряжению = РК.ПолучитьЭлементыКоллекции(ТаблицаПлана);
			КонецЕсли;
			
			Для Каждого ТоварПоРаспоряжению Из ТоварыПоРаспоряжению Цикл
				Запись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, ПараметрыРегистрации);
				Запись.ТипРегистрации = ТипРегистрации;
				ЗаполнитьЗначенияСвойств(Запись, ТоварПоРаспоряжению);
			КонецЦикла;
			
		КонецЕсли;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецФункции

Функция ПолучитьЗарегистрированныеИзмененияОперации(ПараметрыОперации, ТипРегистрации, ВключаяМассивСсылокОперации=Неопределено, ИсключаяМассивСсылокОперации=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_РегистрацияИзмененийОпераций.Оператор КАК Оператор,
	|	вмс_РегистрацияИзмененийОпераций.ВидОперации КАК ВидОперации,
	|	вмс_РегистрацияИзмененийОпераций.Распоряжение КАК Распоряжение,
	|	вмс_РегистрацияИзмененийОпераций.ТипРегистрации КАК ТипРегистрации,
	|	вмс_РегистрацияИзмененийОпераций.СсылкаОперации КАК СсылкаОперации,
	|	вмс_РегистрацияИзмененийОпераций.Товар КАК Товар,
	|	вмс_РегистрацияИзмененийОпераций.Характеристика КАК Характеристика,
	|	вмс_РегистрацияИзмененийОпераций.Ячейка КАК Ячейка,
	|	вмс_РегистрацияИзмененийОпераций.ЯчейкаПриемник КАК ЯчейкаПриемник,
	|	вмс_РегистрацияИзмененийОпераций.Контейнер КАК Контейнер,
	|	вмс_РегистрацияИзмененийОпераций.Партия КАК Партия,
	|	вмс_РегистрацияИзмененийОпераций.Серия КАК Серия,
	|	вмс_РегистрацияИзмененийОпераций.Качество КАК Качество,
	|	вмс_РегистрацияИзмененийОпераций.Упаковка КАК Упаковка,
	|	вмс_РегистрацияИзмененийОпераций.Документ КАК Документ,
	|	вмс_РегистрацияИзмененийОпераций.Помещение КАК Помещение,
	|	вмс_РегистрацияИзмененийОпераций.Количество КАК Количество,
	|	вмс_РегистрацияИзмененийОпераций.КоличествоУпаковок КАК КоличествоУпаковок,
	|	вмс_РегистрацияИзмененийОпераций.Вес КАК Вес,
	|	вмс_РегистрацияИзмененийОпераций.Флаг1 КАК Флаг1,
	|	вмс_РегистрацияИзмененийОпераций.Флаг2 КАК Флаг2
	|ИЗ
	|	РегистрСведений.вмс_РегистрацияИзмененийОпераций КАК вмс_РегистрацияИзмененийОпераций
	|ГДЕ
	|	вмс_РегистрацияИзмененийОпераций.Оператор = &Оператор
	|	И вмс_РегистрацияИзмененийОпераций.ВидОперации = &ВидОперации
	|	И вмс_РегистрацияИзмененийОпераций.Распоряжение В(&Распоряжение)
	|	И вмс_РегистрацияИзмененийОпераций.ТипРегистрации = &ТипРегистрации
	|	И &ДопОтборы";
	Запрос.УстановитьПараметр("Оператор", ПараметрыОперации.Оператор);
	Запрос.УстановитьПараметр("ВидОперации", ПараметрыОперации.ВидОперации);
	Запрос.УстановитьПараметр("Распоряжение", ПараметрыОперации.Распоряжение);
	Запрос.УстановитьПараметр("ТипРегистрации", ТипРегистрации);
	
	ДопОтборы = Новый Массив;
	Если ВключаяМассивСсылокОперации <> Неопределено Тогда
		Запрос.УстановитьПараметр("ВключаяМассивСсылокОперации", ВключаяМассивСсылокОперации);
		ДопОтборы.Добавить("вмс_РегистрацияИзмененийОпераций.СсылкаОперации В(&ВключаяМассивСсылокОперации)");
	КонецЕсли;
	
	Если ИсключаяМассивСсылокОперации <> Неопределено Тогда
		Запрос.УстановитьПараметр("ИсключаяМассивСсылокОперации", ИсключаяМассивСсылокОперации);
		ДопОтборы.Добавить("НЕ вмс_РегистрацияИзмененийОпераций.СсылкаОперации В(&ИсключаяМассивСсылокОперации)");
	КонецЕсли;
	
	Если ДопОтборы.Количество() > 0 Тогда
		ДопОтборыСтрока = вмс_РаботаСКоллекциями.МассивВСтроку(ДопОтборы, Символы.ПС + Символы.Таб + "И ");
	Иначе
		ДопОтборыСтрока = "ИСТИНА";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопОтборы", ДопОтборыСтрока);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаИзменений = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаИзменений;
	
КонецФункции

Функция УдалитьЗарегистрированныеИзмененияОперации(ПараметрыОперации, ТипРегистрации=Неопределено, СсылкиОперации=Неопределено) Экспорт
	
	РК = вмс_РаботаСКоллекциями;

	Данные = Новый Структура("Оператор, ВидОперации, Распоряжение");
	ЗаполнитьЗначенияСвойств(Данные, ПараметрыОперации);
	Данные.Вставить("СсылкаОперации", СсылкиОперации);
	
	МассивВариантовПараметровОперации = РК.ПолучитьСочетанияЭлементов(Данные); //может быть передано несколько распоряжений

	Для Каждого ВариантПараметровОперации Из МассивВариантовПараметровОперации Цикл
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Оператор.Установить(ВариантПараметровОперации.Оператор);
		НаборЗаписей.Отбор.ВидОперации.Установить(ВариантПараметровОперации.ВидОперации);
		НаборЗаписей.Отбор.Распоряжение.Установить(ВариантПараметровОперации.Распоряжение);
		Если ТипРегистрации <> Неопределено Тогда
			НаборЗаписей.Отбор.ТипРегистрации.Установить(ТипРегистрации);
		КонецЕсли;
		Если ВариантПараметровОперации.СсылкаОперации <> Неопределено Тогда
			НаборЗаписей.Отбор.СсылкаОперации.Установить(ВариантПараметровОперации.СсылкаОперации);
		КонецЕсли;
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецФункции

#КонецЕсли