Функция ЗаписатьНачальныеДанныеФактаОперации(ПараметрыРегистрации)

	ДанныеФактаОперации = ПолучитьДанныеФактаОперации(ПараметрыРегистрации);
	ЗаписатьДанныеФактаОперации(ПараметрыРегистрации, ДанныеФактаОперации, Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Факт0);

КонецФункции

Функция ПолучитьДанныеЗарегистрированныхИзмененийФактаОперации(ПараметрыОперации, ТипФакта) Экспорт

	РК = вмс_РаботаСКоллекциями;
	
	ЗарегистрированныеДокументыОперации = ПолучитьЗарегистрированныеДокументыОперации(ПараметрыОперации, ТипФакта);
	МассивДокументовОперации = ЗарегистрированныеДокументыОперации.МассивДокументовОперации;
	МассивДокументовОперацииЗагруженныхИзТСД = ЗарегистрированныеДокументыОперации.МассивДокументовОперацииЗагруженныхИзТСД;
	Если МассивДокументовОперации.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаСтарыхДанныхПоТоварам = ПолучитьЗарегистрированныеИзмененияОперации(ПараметрыОперации, ТипФакта, МассивДокументовОперации);
	
	ДанныеОперации = ПолучитьДанныеФактаОперации(ПараметрыОперации, МассивДокументовОперации);
	
	ТаблицаНовыхДанныхПоТоварам = ДанныеОперации.Товары;
	
	ПоляРесурсов = "Количество, КоличествоУпаковок";
	ПоляРесурсовМассив = РК.ЗначениеВМассив(ПоляРесурсов);
	ПоляГруппировкиМассив = РК.ПолучитьКолонкиКоллекции(ТаблицаНовыхДанныхПоТоварам);
	РК.ВычестьМассив(ПоляГруппировкиМассив, ПоляРесурсов);
	ПоляТаблицыМассив = РК.СложениеМассивов(ПоляГруппировкиМассив, ПоляРесурсовМассив);
	
	ТаблицаИзмененийПоТоварам = РК.НоваяТаблицаЗначений(ПоляТаблицыМассив);
	РК.ДобавитьЭлементыКоллекции(ТаблицаИзмененийПоТоварам, ТаблицаСтарыхДанныхПоТоварам);
	РК.ИнвертироватьЗначенияКоллекции(ТаблицаИзмененийПоТоварам, ПоляРесурсов);
	РК.ДобавитьЭлементыКоллекции(ТаблицаИзмененийПоТоварам, ТаблицаНовыхДанныхПоТоварам);
	
	Если ТипФакта = Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Факт Тогда
		//синхронизировать данные в учетной системе по данным из ТСД для текущего оператора
		//соответственно не регистрировать изменения по документам из ТСД для ТСД
		Для Каждого СсылкаОперации Из МассивДокументовОперацииЗагруженныхИзТСД Цикл
			НайденныеСтроки = ТаблицаИзмененийПоТоварам.НайтиСтроки(Новый Структура("СсылкаОперации", СсылкаОперации));
			РК.УдалитьЭлементыКоллекции(ТаблицаИзмененийПоТоварам, НайденныеСтроки);
		КонецЦикла;
	КонецЕсли;
	
	РК.ВычестьМассив(ПоляГруппировкиМассив, "СсылкаОперации");
	ПоляГруппировки = РК.МассивВСтроку(ПоляГруппировкиМассив);
	ТаблицаИзмененийПоТоварам.Свернуть(ПоляГруппировки, ПоляРесурсов);
	РК.УдалитьПустыеСтрокиКоллекции(ТаблицаИзмененийПоТоварам, ПоляРесурсов);
	
	ЗаписатьДанныеФактаОперации(ПараметрыОперации, ДанныеОперации, ТипФакта, МассивДокументовОперации);
	
	УдалитьЗарегистрированныеИзмененияОперации(ПараметрыОперации, Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Операция, МассивДокументовОперации);
	
	Если ТаблицаИзмененийПоТоварам.Количество() = 0 Тогда
		ТаблицаИзмененийПоТоварам = Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаИзмененийПоТоварам;
	
КонецФункции

Функция ПолучитьЗарегистрированныеДокументыОперации(ПараметрыОперации, ТипФакта)

	РК = вмс_РаботаСКоллекциями;
	
	ТекущиеДокументы = Неопределено;
	ПараметрыОперации.Свойство("ТекущиеДокументы", ТекущиеДокументы);
	
	Если ТипФакта = Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Факт0 Тогда
		ВключаяМассивСсылокОперации = Неопределено;
		ИсключаяМассивСсылокОперации = ТекущиеДокументы;
	Иначе
		ВключаяМассивСсылокОперации = ТекущиеДокументы;
		ИсключаяМассивСсылокОперации = Неопределено;
	КонецЕсли;
	
	МассивДокументовОперации = Новый Массив; 
	МассивДокументовОперацииЗагруженныхИзТСД = Новый Массив;
	
	ТаблицаЗарегистрированныхИзмененийОперации = ПолучитьЗарегистрированныеИзмененияОперации(ПараметрыОперации, Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Операция, ВключаяМассивСсылокОперации, ИсключаяМассивСсылокОперации);
	
	Для Каждого СтрокаЗарегистрированногоИзмененияОперации Из ТаблицаЗарегистрированныхИзмененийОперации Цикл
		
		МассивДокументовОперации.Добавить(СтрокаЗарегистрированногоИзмененияОперации.СсылкаОперации);
		
		Если СтрокаЗарегистрированногоИзмененияОперации.Флаг1 Тогда
			
			МассивДокументовОперацииЗагруженныхИзТСД.Добавить(СтрокаЗарегистрированногоИзмененияОперации.СсылкаОперации);
			
		КонецЕсли;

	КонецЦикла;
	
	ЗарегистрированныеДокументыОперации = Новый Структура;
	ЗарегистрированныеДокументыОперации.Вставить("МассивДокументовОперации", МассивДокументовОперации);
	ЗарегистрированныеДокументыОперации.Вставить("МассивДокументовОперацииЗагруженныхИзТСД", МассивДокументовОперацииЗагруженныхИзТСД);
	
	Возврат ЗарегистрированныеДокументыОперации;

КонецФункции

Функция ПолучитьДанныеФактаОперации(ПараметрыОперации, ДокументыОперации=Неопределено)

	ПараметрыПолученияДанных = Новый Структура;
	ПараметрыПолученияДанных.Вставить("ВидОперации", ПараметрыОперации.ВидОперации);
	ПараметрыПолученияДанных.Вставить("ДокументОснование", ПараметрыОперации.Распоряжение);
	ПараметрыПолученияДанных.Вставить("НовыйФорматРезультата", Истина);
	ПараметрыПолученияДанных.Вставить("ДетализироватьПоОперациям", Истина);
	ПараметрыПолученияДанных.Вставить("ВключаяДокументыОпераций", ДокументыОперации);

	ПараметрыПолученияФакта = Неопределено;
	МетодПолученияФакта = Неопределено;
	ПараметрыОперации.Свойство("ПараметрыПолученияФакта", ПараметрыПолученияФакта);
	Если ТипЗнч(ПараметрыПолученияФакта) = Тип("Структура") Тогда
		ПараметрыПолученияФакта.Свойство("МетодПолученияФакта", МетодПолученияФакта);
	КонецЕсли;
	
	Если МетодПолученияФакта = "вмс_ОперацииПоЯчейкамСервер.ПолучитьТаблицуОтобранныхТоваровЧерезСтруктуру" Тогда
		ПолученныеДанные = вмс_ОперацииПоЯчейкамСервер.ПолучитьТаблицуОтобранныхТоваровЧерезСтруктуру(ПараметрыПолученияДанных);
	Иначе
		ПолученныеДанные = вмс_ОперацииПоЯчейкамСервер.ПолучитьТаблицуПринятыхТоваровЧерезСтруктуру(ПараметрыПолученияДанных);
	КонецЕсли;
	
	ТаблицаДанныхПоТоварам = ПолученныеДанные.Товары;
	ТаблицаДанныхПоТоварам.Колонки.ДокументОснование.Имя = "Распоряжение";
	
	Возврат ПолученныеДанные;
	
КонецФункции

Функция ЗаписатьДанныеФактаОперации(ПараметрыОперации, ДанныеДокументовОперации, ТипРегистрации, знач ДокументыОперации=Неопределено)

	ТаблицаТоваров = ДанныеДокументовОперации.Товары;
	
	Если ДокументыОперации = Неопределено Тогда
		ТаблицаЗарегистрированныхДокументовОперации = ТаблицаТоваров.Скопировать();
		ТаблицаЗарегистрированныхДокументовОперации.Свернуть("СсылкаОперации");
		ДокументыОперации = ТаблицаЗарегистрированныхДокументовОперации.ВыгрузитьКолонку("СсылкаОперации");
	КонецЕсли;
	
	Для Каждого ДокументОперации Из ДокументыОперации Цикл
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Оператор.Установить(ПараметрыОперации.Оператор);
		НаборЗаписей.Отбор.ВидОперации.Установить(ПараметрыОперации.ВидОперации);
		НаборЗаписей.Отбор.СсылкаОперации.Установить(ДокументОперации);
		
		ТоварыОперации = ТаблицаТоваров.НайтиСтроки(Новый Структура("СсылкаОперации", ДокументОперации));
		Для Каждого ТоварОперации Из ТоварыОперации Цикл
			Запись = НаборЗаписей.Добавить();
			Запись.Оператор = ПараметрыОперации.Оператор;
			Запись.ВидОперации = ПараметрыОперации.ВидОперации;
			Запись.СсылкаОперации = ДокументОперации;
			ЗаполнитьЗначенияСвойств(Запись, ТоварОперации);
			Запись.ТипРегистрации = ТипРегистрации;
		КонецЦикла;
		
		НаборЗаписей.Записать();
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

