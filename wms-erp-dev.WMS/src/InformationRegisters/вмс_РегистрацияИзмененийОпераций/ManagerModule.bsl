#Область Остатки

Функция ПолучитьДанныеЗарегистрированныхИзмененийОстатковОперации(ПараметрыОперации) Экспорт

	РК = вмс_РаботаСКоллекциями;

	ТаблицаСтарыхОстатковПоТоварам = ПолучитьЗарегистрированныеИзмененияОперации(ПараметрыОперации, Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Остаток);

	ТаблицаЗапросаОстатковПоТоварам = ПолучитьЗарегистрированныеИзмененияОперации(ПараметрыОперации, Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.План);
	
	ТаблицаОстатковПоТоварам = ПолучитьДанныеОстатковОперации(ПараметрыОперации, ТаблицаЗапросаОстатковПоТоварам);
	
	ПоляРесурсов = "Количество, Вес";
	ПоляРесурсовМассив = РК.ЗначениеВМассив(ПоляРесурсов);
	ПоляГруппировкиМассив = РК.ПересечениеМассивов(РК.ПолучитьКолонкиКоллекции(ТаблицаСтарыхОстатковПоТоварам), РК.ПолучитьКолонкиКоллекции(ТаблицаОстатковПоТоварам));
	РК.ВычестьМассив(ПоляГруппировкиМассив, ПоляРесурсов);
	ПоляГруппировки = РК.МассивВСтроку(ПоляГруппировкиМассив);
	ПоляТаблицыМассив = РК.СложениеМассивов(ПоляГруппировкиМассив, ПоляРесурсовМассив);
	
	ТаблицаИзмененийПоТоварам = РК.НоваяТаблицаЗначений(ПоляТаблицыМассив);
	РК.ДобавитьЭлементыКоллекции(ТаблицаИзмененийПоТоварам, ТаблицаСтарыхОстатковПоТоварам);
	РК.ИнвертироватьЗначенияКоллекции(ТаблицаИзмененийПоТоварам, ПоляРесурсов);
	РК.ДобавитьЭлементыКоллекции(ТаблицаИзмененийПоТоварам, ТаблицаОстатковПоТоварам);
	ТаблицаИзмененийПоТоварам.Свернуть(ПоляГруппировки, ПоляРесурсов);
	РК.УдалитьПустыеСтрокиКоллекции(ТаблицаИзмененийПоТоварам, ПоляРесурсов);
	
	ЗаписатьДанныеОстатковОперации(ПараметрыОперации, ТаблицаОстатковПоТоварам);
	
	Если ТаблицаИзмененийПоТоварам.Количество() = 0 Тогда
		ТаблицаИзмененийПоТоварам = Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаИзмененийПоТоварам;
	
КонецФункции

Функция ЗаписатьНачальныеДанныеОстатковОперации(ПараметрыРегистрации)

	ТаблицаЗапросаОстатковПоТоварам = ПолучитьЗарегистрированныеИзмененияОперации(ПараметрыРегистрации, Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.План);
	
	ДанныеОстатков = ПолучитьДанныеОстатковОперации(ПараметрыРегистрации, ТаблицаЗапросаОстатковПоТоварам);
	
	ЗаписатьДанныеОстатковОперации(ПараметрыРегистрации, ДанныеОстатков);

	Возврат Истина;
		
КонецФункции

Функция ПолучитьДанныеОстатковОперации(ПараметрыОперации, ТаблицаЗапросаОстатковПоТоварам)
	
	РК = вмс_РаботаСКоллекциями;
	
	МассивТоваров = РК.ВыгрузитьЗначенияКолонкиКоллекции(ТаблицаЗапросаОстатковПоТоварам, "Товар");
	
	ПараметрыПолученияОстатковТоваровВЯчейках = Неопределено;
	ПараметрыОперации.Свойство("ПараметрыПолученияОстатковТоваровВЯчейках", ПараметрыПолученияОстатковТоваровВЯчейках);
	
	Если ТипЗнч(ПараметрыПолученияОстатковТоваровВЯчейках) <> Тип("Структура") Тогда
		ПараметрыПолученияОстатковТоваровВЯчейках = Новый Структура;
		ПараметрыПолученияОстатковТоваровВЯчейках.Вставить("ИспользуемыеПоля", "Контейнер");
	КонецЕсли;
	
	ПараметрыПолученияОстатковТоваровВЯчейках.Вставить("Товары", МассивТоваров);
	ТаблицаОстатковПоТоварам = вмс_ОперацииПоЯчейкамСервер.ПолучитьТаблицуОстатковВЯчейкахЧерезСтруктуру(ПараметрыПолученияОстатковТоваровВЯчейках);
	
	Возврат ТаблицаОстатковПоТоварам;
	
КонецФункции

Функция ЗаписатьДанныеОстатковОперации(знач ПараметрыОперации, ДанныеОстатков)
	
	РК = вмс_РаботаСКоллекциями;

	Данные = Новый Структура("Оператор, ВидОперации, Распоряжение");
	ЗаполнитьЗначенияСвойств(Данные, ПараметрыОперации);
	
	МассивПараметровОперации = РК.ПолучитьСочетанияЭлементов(Данные); //может быть передано несколько распоряжений

	ТипРегистрации = Перечисления.вмс_ТипыРегистрацииИзмененийОпераций.Остаток;
	
	Для Каждого ПараметрыОперации Из МассивПараметровОперации Цикл
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидОперации.Установить(ПараметрыОперации.ВидОперации);
		НаборЗаписей.Отбор.Оператор.Установить(ПараметрыОперации.Оператор);
		НаборЗаписей.Отбор.Распоряжение.Установить(ПараметрыОперации.Распоряжение);
		НаборЗаписей.Отбор.ТипРегистрации.Установить(ТипРегистрации);
		
		Для Каждого СтрокаОстатка Из ДанныеОстатков Цикл
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ПараметрыОперации);
			Запись.ТипРегистрации = ТипРегистрации;
			ЗаполнитьЗначенияСвойств(Запись, СтрокаОстатка);
		КонецЦикла;

		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецФункции

#КонецОбласти

//
//					Остатки-
