&НаКлиенте
Перем Переменные;

&НаСервере
Процедура ЗаполнитьСписокОбъектовМетаданных()

	ТаблицаГруппыМетаданных = вмс_РаботаСКоллекциями.НоваяТаблицаЗначений("Объект, Синоним");
	вмс_РаботаСКоллекциями.ДобавитьСтрокуТЗ(ТаблицаГруппыМетаданных, МетаДанные.Справочники, "Справочники");
	вмс_РаботаСКоллекциями.ДобавитьСтрокуТЗ(ТаблицаГруппыМетаданных, МетаДанные.Документы, "Документы");
	вмс_РаботаСКоллекциями.ДобавитьСтрокуТЗ(ТаблицаГруппыМетаданных, МетаДанные.ПланыВидовХарактеристик, "Планы видов характеристик");
	
	ЭлементыГрупп = ТаблицаОбъектовМетаданных.ПолучитьЭлементы();
	ЭлементыГрупп.Очистить();
	
	Для Каждого СтрокаГруппаМетаданных Из ТаблицаГруппыМетаданных Цикл
		СтрокаГруппы = ЭлементыГрупп.Добавить();
		СтрокаГруппы.Синоним = СтрокаГруппаМетаданных.Синоним;
		СтрокаГруппы.ЭтоГруппа = Истина;
		Для Каждого ОбъектМетаданных Из СтрокаГруппаМетаданных.Объект Цикл
			СтрокаОбъекта = СтрокаГруппы.ПолучитьЭлементы().Добавить();
			СтрокаОбъекта.Имя = ОбъектМетаданных.ПолноеИмя();
			СтрокаОбъекта.Синоним = ОбъектМетаданных.Синоним;
			СтрокаОбъекта.ЭтоГруппа = Ложь;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОбъектовМетаданныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
