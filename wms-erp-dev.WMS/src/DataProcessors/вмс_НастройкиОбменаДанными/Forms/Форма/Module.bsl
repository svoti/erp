		Сообщение.Текст = "Склады не заполнены";
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	МассивСкладов = Новый Массив;
	
	Для каждого СтрокаТЧ Из Объект.ТабСклады Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Склад) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("В строке %1 не заполнен склад", СтрокаТЧ.НомерСтроки);
			Сообщение.Сообщить();	
			
			НезаполненныеСтроки = Истина;  
			
			Продолжить;
		КонецЕсли;                    
		
		МассивСкладов.Добавить(СтрокаТЧ.Склад);
	КонецЦикла;  
	
	Если НезаполненныеСтроки Тогда
		Возврат;	
	Иначе      
		ОтправитьСкладыНаСервере(МассивСкладов); 
	КонецЕсли;
			
КонецПроцедуры

