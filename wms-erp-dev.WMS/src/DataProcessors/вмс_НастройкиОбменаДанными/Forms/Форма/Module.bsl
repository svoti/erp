КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПоклажедателя(Команда) 
	
	НезаполненныеСтроки = Ложь;
	
	Если Объект.ТабПоклажедатель.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Поклажедатели не заполнены";
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	МассивДляРегистрацииПоклажедателей = Новый Массив;
		
	Для каждого СтрокаТЧ Из Объект.ТабПоклажедатель Цикл
		Если (НЕ ЗначениеЗаполнено(СтрокаТЧ.Контрагент)) ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.Представитель) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("В строке %1 не заполнен контрагент или пользователь", СтрокаТЧ.НомерСтроки);
			Сообщение.Сообщить();	
			
			НезаполненныеСтроки = Истина; 
			
			Продолжить;
		КонецЕсли;
		
		ОтправленныеДанные = Новый Структура;
		ОтправленныеДанные.Вставить("Контрагент", СтрокаТЧ.Контрагент);
		ОтправленныеДанные.Вставить("Представитель", СтрокаТЧ.Представитель);   
		
		МассивДляРегистрацииПоклажедателей.Добавить(ОтправленныеДанные);
	КонецЦикла;          
	
	Если НезаполненныеСтроки Тогда
		Возврат;	
	Иначе      
		ОтправитьПоклажедателяНаСервере(МассивДляРегистрацииПоклажедателей);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСклады(Команда)
	
	НезаполненныеСтроки = Ложь;
	
	Если Объект.ТабСклады.Количество() = 0 Тогда
