КонецФункции

&НаСервере
Функция КонтрагентПредставителя(ТД_Представитель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.вмс_Поклажедатели КАК Пользователи
	|ГДЕ
	|	Пользователи.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ТД_Представитель);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();  
	Выборка.Следующий();
	
	Возврат Выборка.Контрагент;
	
КонецФункции

&НаКлиенте
Процедура ТабПоклажедательКонтрагентПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТабПоклажедатель.ТекущиеДанные;   	
	ТекДанные.Представитель = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПоклажедательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ТабПоклажедатель.ТекущиеДанные;   
	ТД_Представитель = ТекДанные.Представитель; 
	ТД_Контрагент = ТекДанные.Контрагент; 
	
	Если ЗначениеЗаполнено(ТД_Контрагент) Тогда
		ЗначениеОтбора = Новый Структура("Контрагент", ТД_Контрагент); 
		ПараметрыВыбора = Новый Структура("Отбор", ЗначениеОтбора);
		
		ОткрытьФорму("Справочник.вмс_Поклажедатели.Формавыбора",ПараметрыВыбора, Элемент);	
	Иначе
		ОткрытьФорму("Справочник.вмс_Поклажедатели.Формавыбора",,Элемент);			
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабПоклажедательОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ТабПоклажедатель.ТекущиеДанные;   
	ТекДанные.Контрагент = КонтрагентПредставителя(ВыбранноеЗначение);
	
КонецПроцедуры

