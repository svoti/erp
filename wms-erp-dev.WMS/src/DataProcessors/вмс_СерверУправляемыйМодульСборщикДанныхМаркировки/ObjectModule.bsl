Функция ОбработчикЭтапаВводаДанных_ПроверитьОбязательныйВводМаркировки(Параметры, ДополнительныеПараметры) Экспорт
	
	// 3.2.4
	
	СобранныеДанныеПолей = ДанныеТранзакции.СобранныеДанныеПолей;
	
	МаркируемыйТовар = СобранныеДанныеПолей.МаркируемыйТовар=Истина;
	МаркировкаВведена = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхСборки.ЗаполненныеПоляМассив.Найти("Маркировка") <> Неопределено;
	
	Если МаркируемыйТовар И НЕ МаркировкаВведена Тогда
		
		мТоварныеПоля = СписокПолейМодуля(Новый Структура("Группа", "Товар"));
		ПредставлениеТовара = Новый Массив;
		
		Для каждого ТоварноеПоле Из мТоварныеПоля Цикл
			ПредставлениеТовара.Добавить(ДанныеТранзакции.ОбщиеДанныеПолей[ТоварноеПоле]);
		КонецЦикла;
		
		ПредставлениеТовара = СтрСоединить(ПредставлениеТовара, ", ");
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ДанныеОТоваре", ПредставлениеТовара);
		СтандартныйМодуль.ПоказатьФормуДиалога(НовыйОписаниеОповещения("ОбработчикЗакрытияФормыВводаМаркировки"), "ОбщаяФорма.ФормаВводаМаркировки", ПараметрыФормы);
		Интерфейс.ОтменитьВводДанных();
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ОбработчикЗакрытияФормыВводаМаркировки(Маркировка, ДополнительныеПараметры) Экспорт
	
	Если Маркировка=Неопределено Тогда
		Возврат Ложь;
	Иначе
		ВвестиДанные(Маркировка);
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ПроверитьДублированиеМаркировкиНаВводе(Параметры, ДополнительныеПараметры) Экспорт
	
	СобранныеДанныеПолей = ДанныеТранзакции.СобранныеДанныеПолей;
	Если ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхСборки.ЗаполненныеПоляМассив.Найти("Маркировка")=Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	МаркаДоступна = вмс_ОбработкаМаркировкиСервер.ПроверитьВозможностьИспользованияМаркировки(СобранныеДанныеПолей.Маркировка, ПараметрыОбработки.Задание);
	
	Если Не МаркаДоступна Тогда
		Интерфейс.ОтменитьВводДанных();
		ПоказатьДиалогНаКлиенте(, "Марку уже сканировали!", , , , , "Ошибка");
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ПроверитьОтклонениеОтПлана(Параметры, ДополнительныеПараметры) Экспорт
	
	Если НЕ ПараметрыМодуля.ЕстьПлан Тогда
		// нет плана
		Возврат Истина;
	КонецЕсли;

	СобранныеДанныеПолей = ДанныеТранзакции.СобранныеДанныеПолей;
	Если ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхСборки.ЗаполненныеПоляМассив.Найти("Маркировка")=Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ДанныеТранзакции.ОбщиеДанныеПолей.МаркируемыйТовар <> Истина Тогда
		// для немаркируемого товара не проверям
		Возврат Истина;
	КонецЕсли;
	
	Маркировка = СобранныеДанныеПолей.Маркировка;
	
	Если ДанныеОбработки.Таблицы.ТаблицаКодовМаркировки.НайтиСтроки(Новый Структура("Маркировка", Маркировка)).Количество() > 0 Тогда
		// марка найдена в плане
		Возврат Истина;
	КонецЕсли;
	
	ПоказатьДиалогНаКлиенте(, "Марки нет в плане!", , , , , "Ошибка");
	Интерфейс.ОтменитьВводДанных();
	
	Возврат Ложь;
	
КонецФункции

