#Область РеализацияМетодов

Функция ВыполнитьДействие(Действие) Экспорт
	
	Код = Действие.Код;
	
	Если Код="ПередОткрытиемФормыВводаКоличества" Тогда
		
		ДействиеПередОткрытиемФормыВводаКоличества(Действие);
		
	КонецЕсли;
	
	Если Действие.Обработано Тогда
		Возврат Действие.Результат;
	КонецЕсли;
	
	Возврат СборщикДанныхСтандартный.ВыполнитьДействие(Действие);

КонецФункции

Функция ДействиеПередОткрытиемФормыВводаКоличества(Действие)
	
	МаркируемыйТовар = ДанныеМодуля.СобранныеДанныеПолей.МаркируемыйТовар;
	Если МаркируемыйТовар=Ложь Тогда
		// не обрабатываем
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыДействия = Действие.Параметры;
	ПараметрыДействия.Отказ = Истина;
	
	Если МаркируемыйТовар=Истина Тогда
		ПоказатьДиалогНаКлиенте(, "Требуется отсканировать марку товара");
	КонецЕсли;
	
	Возврат УстановитьРезультатДействия(Действие, ПараметрыДействия);
	
КонецФункции

Функция УстановитьСвойстваЭлементовВывода(Элементы, Свойства, ЗначениеСвойства=Неопределено)
	
	Возврат СтандартныйМодуль.УстановитьСвойстваЭлементовВывода(Элементы, Свойства, ЗначениеСвойства);
	
КонецФункции

Функция УстановитьДоступныеПоля() Экспорт
	
	РеквизитыОперацииПоЯчейкам = Метаданные.Документы.вмс_ОперацияПоЯчейкам.ТабличныеЧасти.КодыМаркировки.Реквизиты;
	Для Каждого Реквизит Из РеквизитыОперацииПоЯчейкам Цикл
		ИмяРеквизита = Реквизит.Имя;
		ИмяПоля = ИмяРеквизита;
		Если ИмяПоля <> "Количество" Тогда
			// ТУ_КС+
			Если ИмяПоля="Серия" Тогда
				ТипЗначенияПоля = Новый ОписаниеТипов("СправочникСсылка.вмс_СерииНоменклатуры");
			Иначе
				ТипЗначенияПоля = Реквизит.Тип;
			КонецЕсли;
			// ТУ_КС-
			УстановитьСвойстваПолейМодуля(ИмяПоля, Новый Структура("ПутьКДаннымСохранения, Синоним, ТипЗначения", "ОперацияПоЯчейкам.КодыМаркировки." + ИмяРеквизита, Реквизит.Синоним, ТипЗначенияПоля));
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция УстановитьДополнительныеПоля() Экспорт
	
	УстановитьСвойстваПолейМодуля("Маркировка", Новый Структура("ОбязательноеЗаполнение", Истина));
	
	СвойстваПоля = Новый Структура("Сборка, Вывод, ЗначениеПоУмолчанию", Истина, Ложь, Неопределено);
	УстановитьСвойстваПолейМодуля("МаркируемыйТовар", СвойстваПоля);
	//УстановитьСвойстваПолейОбработки("МаркируемыйТовар", СвойстваПоля);
	
	УстановитьСвойстваПолейМодуля("КоличествоМаркировки", Новый Структура("Ресурс, Ввод, Сборка, Группа, ОбязательноеЗаполнение, Вывод", Истина, Истина, Истина, "Количество", Истина, Ложь));
	
	//3.2.5
	СвойстваПоля = Новый Структура("Сборка, Ввод, Вывод, ЗначениеПоУмолчанию, ПутьРодителяДанныхСохранения", Истина, Истина, Ложь, Неопределено, "ОперацияПоЯчейкам.КодыМаркировки");
	УстановитьСвойстваПолейМодуля("ПолныйКодМаркировки", СвойстваПоля);
	
КонецФункции

Функция ИнициализироватьДанные() Экспорт
	
КонецФункции

Функция РазобратьВходящиеОбъекты(ВходящиеДанные) Экспорт
	
	ДанныеШтрихкода = ВходящиеДанные.ДанныеШтрихкода;
	
	ВходящиеОбъекты = ВходящиеДанные.ВходящиеОбъекты;
	Если ВходящиеОбъекты.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = ДанныеШтрихкода.Результат;
	ВводМаркировки = ДанныеШтрихкода.Обработан И (Результат.ДанныеМаркировки.ИдентифицируетЭкземпляр ИЛИ Результат.ДанныеМаркировки.ЭтоТранспортныйКод);
	
	ПоляДанныхМаркировки = ПараметрыМодуля.ПоляДанныхМаркировки;
	
	Если ВводМаркировки Тогда
		ПоляДанныхМаркировки.Очистить();
	КонецЕсли;
	
	ДанныеПолей = ВходящиеДанные.ДанныеПолей;
	
	ПоляВвода = ПоляВвода();
	
	ЗаполненныеПоляМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.ЗаполненныеПоляМассив;
	
	Для Каждого Объект Из ВходящиеОбъекты Цикл
		
		ТипОбъекта = ТипЗнч(Объект);
		
		ПоляПоТипу = Новый Массив;
		Для Каждого ПолеВвода Из ПоляВвода Цикл
			Если ТипЗнч(ПолеВвода.ТипЗначения)=Тип("ОписаниеТипов") И ПолеВвода.ТипЗначения.Типы().Найти(ТипОбъекта) <> Неопределено Тогда
				Если ПолеВвода.Имя="Серия" И НЕ ЗначениеЗаполнено(Объект) Тогда
					Продолжить;
				КонецЕсли;
				ПоляПоТипу.Добавить(ПолеВвода);
			КонецЕсли;
		КонецЦикла;
		
		Если ПоляПоТипу.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПоляПоТипу.Количество() > 1 Тогда
			Для Каждого ПолеВвода Из ПоляПоТипу Цикл
				ИмяПоля = ПолеВвода.Имя;
				Если ЗаполненныеПоляМассив.Найти(ИмяПоля)=Неопределено Тогда
					// Оставим первое незаполненное поле
					ПоляПоТипу.Очистить();
					ПоляПоТипу.Добавить(ПолеВвода);
					ЗаполненныеПоляМассив.Добавить(ИмяПоля);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ПолеВвода = ПоляПоТипу[ПоляПоТипу.Количество()-1];
		ИмяПоля = ПолеВвода.Имя;
		ДанныеПолей.Вставить(ИмяПоля, Объект);
		
		Если ВводМаркировки Тогда
			ПоляДанныхМаркировки.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	Если ВводМаркировки Тогда
		ДанныеПолей.Вставить("Маркировка", Результат.ШтрихкодНормализованныйПредставление);
		ДанныеПолей.Вставить("КоличествоМаркировки", Результат.ДанныеМаркировки.Количество);
		//3.2.5
		ДанныеПолей.Вставить("ПолныйКодМаркировки", Результат.ШтрихкодBase64);
		
		ПоляКоличества = ПоляОбработки(Новый Структура("Ввод, Группа", Истина, "Количество"));
		Для Каждого ПолеКоличества Из ПоляКоличества Цикл
			ДанныеПолей.Вставить(ПолеКоличества.Имя, Результат.ДанныеМаркировки.Количество);
			ДанныеПолей.Вставить("ТипВводаКоличества" + ПолеКоличества.Суффикс, "Добавить");
			ДанныеПолей.Вставить("ЗавершениеВводаКоличества" + ПолеКоличества.Суффикс, Ложь);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьВведенныеДанныеПолей(ПринятыеДанныеПолей) Экспорт
	
	ПоляДанныхМаркировки = ПараметрыМодуля.ПоляДанныхМаркировки;
	
	Для Каждого ПринятыеДанныеПоля Из ПринятыеДанныеПолей Цикл
		
		Если ПоляДанныхМаркировки.Найти(ПринятыеДанныеПоля.Ключ) <> Неопределено Тогда
			//изменилось ключевое поле
			Интерфейс.ОчиститьДанныеПолей("Маркировка", "ВведенныеДанныеПолей");
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СборщикДанныхСтандартный.ЗаполнитьВведенныеДанныеПолей(ПринятыеДанныеПолей);
	
КонецФункции

Функция ЗаполнитьОбщиеДанныеПолейДополнительно() Экспорт
	
	Товар = ДанныеТранзакции.ОбщиеДанныеПолей.Товар;
	Если ЗначениеЗаполнено(Товар) Тогда
		ДанныеТранзакции.ОбщиеДанныеПолей.МаркируемыйТовар = МаркируемыйТовар(Товар);
	Иначе
		ДанныеТранзакции.ОбщиеДанныеПолей.МаркируемыйТовар = Неопределено;
	КонецЕсли;
	
КонецФункции

Функция МаркируемыйТовар(Товар)

	Возврат ЗначениеЗаполнено(Товар) И вмс_АдаптацияКонфигураций.ОпределитьМаркируемыеТовары(Товар).Количество() > 0;

КонецФункции

Функция ЗаполнитьПредставлениеДанныхПолей() Экспорт
	
	РедактированиеКоличестваВручную = ДанныеМодуля.СобранныеДанныеПолей.МаркируемыйТовар=Ложь;
	
	Для Каждого ПолеВводаКоличества Из ПоляОбработки(Новый Структура("Ввод, Вывод, Группа", Истина, Истина, "Количество")) Цикл
		
		УстановитьСвойстваЭлементовВывода(ПолеВводаКоличества.ИмяЭлементаВывода, Новый Структура("РедактированиеТекста", РедактированиеКоличестваВручную));
		
	КонецЦикла;
	
КонецФункции

Функция СохранениеДанныхСборщика(Сборщик, Отказ) Экспорт
	
	Если Сборщик.Имя="СборщикДанныхТоваров" Тогда
		Если ДанныеТранзакции.ОбщиеДанныеПолей.МаркируемыйТовар=Истина Тогда
			// 3.2.5
			Если ПроверитьЗаполнениеПолейСборки(Сборщик) Тогда
				Если СохранитьДокументОперацииПоЯчейкам(Отказ) И НЕ Отказ Тогда
					// очистим данные транзакции основной обработки
					Обработки.вмс_СерверУправляемыйМодульСтандартный.ОчиститьДанныеПолей(ПараметрыОбработки, "Маркировка");
					ПараметрыМодуля.ДанныеСохранены = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ПараметрыМодуля.ДанныеСохранены И НЕ Отказ Тогда
				Отказ = Истина;
				ПоказатьДиалогНаКлиенте(, "Не удалось сохранить данные маркировки");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// 3.2.5
// проверим заполнние полей с учетом настройки полей ведущего сборщика товаров
Функция ПроверитьЗаполнениеПолейСборки(СборщикДанныхТоваров)
	
	ПоляМодуляМастер = ?(СборщикДанныхТоваров.ДанныеТранзакции.Активна, СборщикДанныхТоваров.ДанныеТранзакции.ПоляОбработки, СборщикДанныхТоваров.ПараметрыМодуля.ПоляОбработки);
	
	МодифицируемыеСвойства = "Ввод, ОбязательноеЗаполнение";
	ПоляМодуля = СборщикДанныхСтандартный.ПоляАнализаДанных()["СобранныеДанныеПолей"].Поля;
	ПоляМодуляИсходные = РК.НоваяТаблицаЗначений("Имя, " + МодифицируемыеСвойства);
	
	ПоляМодифицированные = Новый Массив;
	ПоискПоИмени = Новый Структура("Имя");
	Для Каждого ПолеМодуля Из ПоляМодуля Цикл
		ПоискПоИмени.Имя = ПолеМодуля.Имя;
		ПолеМодуляМастерМассив = ПоляМодуляМастер.НайтиСтроки(ПоискПоИмени);
		Если ПолеМодуляМастерМассив.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеМодуляИсходные = ПоляМодуляИсходные.Добавить();
		ЗаполнитьЗначенияСвойств(ПолеМодуляИсходные, ПолеМодуля);
		
		ПолеМодуляМастер = ПолеМодуляМастерМассив[0];
		ЗаполнитьЗначенияСвойств(ПолеМодуля, ПолеМодуляМастер, МодифицируемыеСвойства);
		ПоляМодифицированные.Добавить(Новый Структура("ПолеМодуля, ПолеМодуляИсходные", ПолеМодуля, ПолеМодуляИсходные));
	КонецЦикла;
	
	Интерфейс.ПроанализироватьЗаполнениеПолейДанных("СобранныеДанныеПолей");
	
	Для Каждого ЭлементПолеМодуля Из ПоляМодифицированные Цикл
		ЗаполнитьЗначенияСвойств(ЭлементПолеМодуля.ПолеМодуля, ЭлементПолеМодуля.ПолеМодуляИсходные, МодифицируемыеСвойства);
	КонецЦикла;
	
	АктивныеДанные = ?(ДанныеТранзакции.Активна, ДанныеТранзакции, ДанныеМодуля);
	
	Возврат АктивныеДанные.РезультатАнализаЗаполненияПолейДанныхСборки.ВсеПоляЗаполнены;

КонецФункции

Функция ВвестиДанныеПоля(ИмяПоля, ЗначениеПоля)

	Возврат СтандартныйМодуль.ВвестиДанныеПоля(ИмяПоля, ЗначениеПоля);
	
КонецФункции

Функция НовыеВходящиеДанные(Данные=Неопределено)
	
	Возврат Обработки.вмс_СерверУправляемыйМодульСтандартный.НовыеВходящиеДанные(Данные);
	
КонецФункции

Функция ВвестиДанные(ВходящиеДанные)

	Возврат вмс_СерверУправляемыеОбработки.ВыполнитьДействиеПереопределяемый(Действие("ВвестиДанные", Новый Структура("ВходящиеДанные", ВходящиеДанные)));
	
КонецФункции

