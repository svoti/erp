Процедура ПриОткрытии(Отказ)
	
	Перем РаботаСФормамиКлиент;
	
	РаботаСФормамиКлиент = Переменные.ОбщиеМодули.РаботаСФормамиКлиент;
	
	ТекстОписанияФормы = РаботаСФормамиКлиент.ПолучитьПараметрФормыНаКлиенте(ЭтаФорма, "ТекстОписанияФормы");
	Макет = РаботаСФормамиКлиент.ПолучитьПараметрФормыНаКлиенте(ЭтаФорма, "Макет");
	Если Макет <> Неопределено Тогда
		ДанныеМакета = РаботаСФормамиКлиент.ПолучитьДанныеМакета(Макет);
		Переменные.ИмяМакета = ДанныеМакета.Наименование;
	КонецЕсли;
	
	ЗагрузитьДанныеИзТекстаОписанияФормы(ТекстОписанияФормы);
	
КонецПроцедуры

