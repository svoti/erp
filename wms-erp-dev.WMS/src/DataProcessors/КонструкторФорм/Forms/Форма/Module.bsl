&НаКлиенте
Процедура СтруктураЭлементовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Перем РК;
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	Отказ = Истина;
	
	СтрокаТекущегоЭлемента = Элемент.ТекущиеДанные;
	Если СтрокаТекущегоЭлемента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРодителяТекущегоЭлемента = СтрокаТекущегоЭлемента.ПолучитьРодителя();
	Если Копирование Тогда
		Если СтрокаТекущегоЭлемента = Переменные.СтрокаФормы Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаНовогоЭлемента = СтрокаРодителяТекущегоЭлемента.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНовогоЭлемента, СтрокаТекущегоЭлемента);
		СтрокаНовогоЭлемента.ИмяЭлемента = ПолучитьИмяНовогоЭлемента(СтрокаНовогоЭлемента.ТипЭлемента);
		
		ЗначенияСвойствЭлемента = РК.НайтиЭлементыКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов, Новый Структура("ИмяЭлемента", СтрокаТекущегоЭлемента.ИмяЭлемента));
		Для Каждого СтрокаЗначенияСвойстваЭлемента Из ЗначенияСвойствЭлемента Цикл
			СтрокаЗначенияСвойстваНовогоЭлемента = РК.ДобавитьЭлементКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов);
			ЗаполнитьЗначенияСвойств(СтрокаЗначенияСвойстваНовогоЭлемента, СтрокаЗначенияСвойстваЭлемента);
			СтрокаЗначенияСвойстваНовогоЭлемента.ИмяЭлемента = СтрокаНовогоЭлемента.ИмяЭлемента;
			РК.ИндексироватьСтрокиКвазиТаблицы(Переменные.ТаблицаЗначенийСвойствЭлементов, СтрокаЗначенияСвойстваНовогоЭлемента);
		КонецЦикла;
		
		Элементы.СтруктураЭлементов.ТекущаяСтрока = СтрокаНовогоЭлемента.ПолучитьИдентификатор();
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СтрокаТекущегоЭлемента", СтрокаТекущегоЭлемента);
	
	ОО = Новый ОписаниеОповещения("ОбработчикВыбораТипаЭлемента", ЭтаФорма, ДополнительныеПараметры);
	
	РодительскиеЭлементы = Новый Массив;
	РодительскиеЭлементы.Добавить(СтрокаТекущегоЭлемента);
	Если СтрокаРодителяТекущегоЭлемента<>Неопределено Тогда
		РодительскиеЭлементы.Добавить(СтрокаРодителяТекущегоЭлемента);
	КонецЕсли;
	СписокВыбораТиповЭлементов = вмс_КонструкторФорм.ПолучитьСписокВыбораДоступныхТиповИВидовЭлементов(Переменные.СведенияОТипахЭлементовФормы, , РодительскиеЭлементы);
	СписокВыбораТиповЭлементов.ПоказатьВыборЭлемента(ОО, "Тип элемента");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораТипаЭлемента(ВыбранныйЭлементТипаЭлемента, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлементТипаЭлемента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРодителяЭлемента = ДополнительныеПараметры.СтрокаТекущегоЭлемента;
	
	СтрокаТипаЭлемента = ВыбранныйЭлементТипаЭлемента.Значение;
	
	ДоступныеТипыЭлементов = вмс_КонструкторФорм.ПолучитьДоступныеТипыИВидыЭлементов(Переменные.СведенияОТипахЭлементовФормы, , СтрокаРодителяЭлемента);
	Если ДоступныеТипыЭлементов.Найти(СтрокаТипаЭлемента)=Неопределено Тогда
		//не получается вставить в выделенную строку, тогда добавим в строку общего родителя перед выделенным элементом
		СтрокаРодителяЭлемента = СтрокаРодителяЭлемента.ПолучитьРодителя();
		ИндексНовогоЭлемента = СтрокаРодителяЭлемента.ПолучитьЭлементы().Индекс(ДополнительныеПараметры.СтрокаТекущегоЭлемента);
	Иначе
		ИндексНовогоЭлемента = СтрокаРодителяЭлемента.ПолучитьЭлементы().Количество();
	КонецЕсли;
	
	Если СтрокаТипаЭлемента.ТипЭлемента="ГруппаФормы" И СтрокаТипаЭлемента.ВидЭлемента="КоманднаяПанель" Тогда
		ИмяНовогоЭлемента = СтрокаРодителяЭлемента.ИмяЭлемента + "КоманднаяПанель";
		СтрокаЭлемента = НайтиЭлемент(ИмяНовогоЭлемента);
		Если СтрокаЭлемента<>Неопределено Тогда
			Элементы.СтруктураЭлементов.ТекущаяСтрока = СтрокаЭлемента.ПолучитьИдентификатор();
			Возврат;
		КонецЕсли;
		ИндексНовогоЭлемента = 0;
	Иначе
		ИмяНовогоЭлемента = ПолучитьИмяНовогоЭлемента(СтрокаТипаЭлемента.ТипЭлемента);;
	КонецЕсли;
	
	СтрокаНовогоЭлемента = СтрокаРодителяЭлемента.ПолучитьЭлементы().Вставить(ИндексНовогоЭлемента);
	СтрокаНовогоЭлемента.ИмяЭлемента = ИмяНовогоЭлемента;
	СтрокаНовогоЭлемента.ТипЭлемента = СтрокаТипаЭлемента.ТипЭлемента;
	СтрокаНовогоЭлемента.ВидЭлемента = СтрокаТипаЭлемента.ВидЭлемента;
	
	Если СтрокаНовогоЭлемента.ВидЭлемента="" Тогда
		ДоступныеВидыЭлемента = вмс_КонструкторФорм.ПолучитьДоступныеВидыЭлемента(Переменные.СведенияОТипахЭлементовФормы, СтрокаНовогоЭлемента.ТипЭлемента, СтрокаНовогоЭлемента.ВидЭлемента, СтрокаРодителяЭлемента);
		Если ДоступныеВидыЭлемента.Количество() > 0 Тогда
			ОписаниеВидаЭлемента = ДоступныеВидыЭлемента[0];
			СтрокаНовогоЭлемента.ВидЭлемента = ОписаниеВидаЭлемента.ВидЭлемента;
			УстановитьЗначениеСвойстваЭлемента(СтрокаНовогоЭлемента.ИмяЭлемента, "Вид", ОписаниеВидаЭлемента.ЗначениеСвойстваВидЭлемента);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьЗначенияСвойствЭлемента(СтрокаНовогоЭлемента.ИмяЭлемента, СтрокаТипаЭлемента.ЗначенияСвойствЭлементаПоУмолчанию);
	
	ОбновитьСтрокуЭлементаНаФорме(СтрокаНовогоЭлемента);
	
	Элементы.СтруктураЭлементов.ТекущаяСтрока = СтрокаНовогоЭлемента.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураЭлементовПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, ИдентификаторСтрокиРодителя, Поле)
	
	Если ИдентификаторСтрокиРодителя=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивРодителей = Новый Массив;
	
	СтрокаРодителя = СтруктураЭлементов.НайтиПоИдентификатору(ИдентификаторСтрокиРодителя);
	МассивРодителей.Добавить(СтрокаРодителя);
	
	СтрокаРодителя = СтрокаРодителя.ПолучитьРодителя();
	Если СтрокаРодителя<>Неопределено Тогда
		МассивРодителей.Добавить(СтрокаРодителя);
	КонецЕсли;
	
	МассивПодчиненныхЭлементов = Новый Массив;
	Для Каждого ИдентификаторСтроки Из ПараметрыПеретаскивания.Значение Цикл
		СтрокаЭлемента = СтруктураЭлементов.НайтиПоИдентификатору(ИдентификаторСтроки);
		МассивПодчиненныхЭлементов.Добавить(СтрокаЭлемента);
	КонецЦикла;
	
	Если Не вмс_КонструкторФорм.ПроверитьВозможностьПодчиненияЭлементов(Переменные.СведенияОТипахЭлементовФормы, МассивРодителей, МассивПодчиненныхЭлементов) Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыПеретаскивания.Действие = Переменные.ДействиеПеретаскивания.Отмена;
		ПараметрыПеретаскивания.ДопустимыеДействия = Переменные.ДопустимыеДействияПеретаскивания.НеОбрабатывать;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураЭлементовПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаРодителя = СтруктураЭлементов.НайтиПоИдентификатору(Строка);
	СтрокаЭлемента = СтруктураЭлементов.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение[0]);
	
	Если Не вмс_КонструкторФорм.ПроверитьВозможностьПодчиненияЭлементов(Переменные.СведенияОТипахЭлементовФормы, СтрокаРодителя, СтрокаЭлемента) Тогда
		//нельзя вставить в этот элемент
		//тогда вставим перед ним
		СтрокаСоседа = СтрокаРодителя;
		СтрокаРодителя = СтрокаСоседа.ПолучитьРодителя();
	КонецЕсли;
	
	СтрокаЭлемента = СкопироватьПереместитьЭлементДерева(СтрокаЭлемента, СтрокаРодителя, СтруктураЭлементов, Истина);
	
	Если СтрокаСоседа<>Неопределено Тогда
		ИндексСоседа = СтрокаРодителя.ПолучитьЭлементы().Индекс(СтрокаСоседа);
		ИндексЭлемента = СтрокаРодителя.ПолучитьЭлементы().Индекс(СтрокаЭлемента);
		Сдвиг = ИндексСоседа - ИндексЭлемента;
		СтрокаРодителя.ПолучитьЭлементы().Сдвинуть(ИндексЭлемента, Сдвиг)
	КонецЕсли;
	
	Элементы.СтруктураЭлементов.ТекущаяСтрока = СтрокаЭлемента.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураЭлементовПередУдалением(Элемент, Отказ)
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	
	Отказ = Истина;

	МассивВыделенныхСтрокЭлементов = Новый Массив;
	Для Каждого ИдентификаторВыделеннойСтроки Из Элементы.СтруктураЭлементов.ВыделенныеСтроки Цикл
		СтрокаЭлемента = СтруктураЭлементов.НайтиПоИдентификатору(ИдентификаторВыделеннойСтроки);
		МассивВыделенныхСтрокЭлементов.Добавить(СтрокаЭлемента);
	КонецЦикла;
	
	МассивЭлементов = ПолучитьВсеЭлементыДерева(МассивВыделенныхСтрокЭлементов, Истина);
	НомерЭлемента = МассивЭлементов.Количество();
	Пока НомерЭлемента>0 Цикл
		НомерЭлемента = НомерЭлемента - 1;
		СтрокаЭлемента = МассивЭлементов[НомерЭлемента];
		Если Переменные.СтрокаФормы=СтрокаЭлемента Тогда
			//не удалять главный элемент
			Продолжить;
		КонецЕсли;

		НайденныеСвойстваЭлемента = РК.НайтиЭлементыКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов, Новый Структура("ИмяЭлемента", СтрокаЭлемента.ИмяЭлемента));
		РК.УдалитьЭлементыКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов, НайденныеСвойстваЭлемента);
		
		СтрокаРодителя = СтрокаЭлемента.ПолучитьРодителя();
		Если СтрокаРодителя=Неопределено Тогда
			СтрокаРодителя = СтруктураЭлементов;
		КонецЕсли;
		СтрокаРодителя.ПолучитьЭлементы().Удалить(СтрокаЭлемента);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураЭлементовПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ОткрытьФормуСвойствЭлемента(Элемент.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Функция НайтиЭлемент(ИмяЭлемента)
	
	ВсеЭлементы = ПолучитьВсеЭлементыДерева(СтруктураЭлементов);
	Для Каждого Элемент Из ВсеЭлементы Цикл
		Если Элемент.ИмяЭлемента=ИмяЭлемента Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяНовогоЭлемента(Префикс="ЭлементФормы")
	
	МассивИменЭлементов = ПолучитьМассивИменЭлементов();
	
	НомерЭлемента = 0;
	Пока Истина Цикл
		НомерЭлементаСтрокой = Формат(НомерЭлемента, "ЧГ=0");
		ИмяНовогоЭлемента = Префикс + НомерЭлементаСтрокой;
		Если МассивИменЭлементов.Найти(ИмяНовогоЭлемента) = Неопределено Тогда
			Возврат ИмяНовогоЭлемента;
		КонецЕсли;
		НомерЭлемента = НомерЭлемента + 1;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Функция ПроверитьИмяЭлемента(ИмяЭлемента) Экспорт
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	
	Если Не РК.ПроверитьИмяПрограммнойПеременной(ИмяЭлемента) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МассивИменЭлементов = ПолучитьМассивИменЭлементов();
	Если МассивИменЭлементов.Найти(ИмяЭлемента) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПолучитьМассивИменЭлементов()

	Возврат Переменные.ОбщиеМодули.РаботаСКоллекциями.ВыгрузитьЗначенияКолонкиКоллекции(ПолучитьВсеЭлементыДерева(СтруктураЭлементов), "ИмяЭлемента");
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяНовогоРеквизита(СтрокаНовогоРеквизита, Префикс="Реквизит")
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	
	СтрокаРодителя = СтрокаНовогоРеквизита.ПолучитьРодителя();
	Если СтрокаРодителя=Неопределено Тогда
		СтрокаРодителя = СтруктураРеквизитов;
	КонецЕсли;
	
	МассивИменСуществующихРеквизитов = Новый Массив;
	Для Каждого СтрокаСоседнегоРеквизита Из СтрокаРодителя.ПолучитьЭлементы() Цикл
		МассивИменСуществующихРеквизитов.Добавить(СтрокаСоседнегоРеквизита.ИмяРеквизита);
	КонецЦикла;
	
	НомерРеквизита = 0;
	Пока Истина Цикл
		НомерРеквизитаСтрокой = Формат(НомерРеквизита, "ЧГ=0");
		ИмяНовогоРеквизита = Префикс + НомерРеквизитаСтрокой;
		Если МассивИменСуществующихРеквизитов.Найти(ИмяНовогоРеквизита) = Неопределено Тогда
			Прервать;
		КонецЕсли;
		НомерРеквизита = НомерРеквизита + 1;
	КонецЦикла;
	
	СтрокаНовогоРеквизита.ИмяРеквизита = ИмяНовогоРеквизита;
	
	СтрокаЗначенийСвойствНовогоРеквизита = ПолучитьЗначенияСвойствРеквизита(СтрокаНовогоРеквизита);
	СтрокаЗначенийСвойствНовогоРеквизита.ИмяРеквизита = ИмяНовогоРеквизита;
	
КонецФункции

&НаКлиенте
Функция ПроверитьИмяРеквизита(СтрокаРеквизита)

	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	
	Если Не РК.ПроверитьИмяПрограммнойПеременной(СтрокаРеквизита.ИмяРеквизита) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаРодителя = СтрокаРеквизита.ПолучитьРодителя();
	Если СтрокаРодителя=Неопределено Тогда
		СтрокаРодителя = СтруктураРеквизитов;
	КонецЕсли;
	
	Для Каждого СтрокаСоседнегоРеквизита Из СтрокаРодителя.ПолучитьЭлементы() Цикл
		Если СтрокаСоседнегоРеквизита<>СтрокаРеквизита Тогда
			Если СтрокаСоседнегоРеквизита.ИмяРеквизита=СтрокаРеквизита.ИмяРеквизита Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьВсеЭлементыДерева(знач Дерево, ВключаяДерево=Ложь, ОбратитьПорядок=Ложь)
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	МассивЭлементов=Новый Массив;
	ОбходЭлементов = Новый Массив;
	Если ТипЗнч(Дерево)=Тип("Массив") Тогда
		//передан массив деревьев
		МассивДеревьев = Дерево;
		Для Каждого Дерево Из МассивДеревьев Цикл
			ОбходЭлементов.Добавить(Дерево);
			Если ВключаяДерево Тогда
				МассивЭлементов.Добавить(Дерево);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ОбходЭлементов.Добавить(Дерево);
		Если ВключаяДерево Тогда
			МассивЭлементов.Добавить(Дерево);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаЭлемента Из ОбходЭлементов Цикл
		Для Каждого ПодчиненныйЭлемент Из СтрокаЭлемента.ПолучитьЭлементы() Цикл
			ОбходЭлементов.Добавить(ПодчиненныйЭлемент);
			МассивЭлементов.Добавить(ПодчиненныйЭлемент);
		КонецЦикла;
	КонецЦикла;
	
	//удалить дубли вложенных элементов перед родительскими элементами
	ОтмеченныеЭлементы = Новый Соответствие;
	НомерЭлемента = МассивЭлементов.Количество();
	Пока НомерЭлемента>0 Цикл
		НомерЭлемента = НомерЭлемента - 1;
		Элемент = МассивЭлементов[НомерЭлемента];
		Если ОтмеченныеЭлементы[Элемент]=Истина Тогда
			//удаляем дубль
			МассивЭлементов.Удалить(НомерЭлемента);
		Иначе
			ОтмеченныеЭлементы[Элемент]=Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбратитьПорядок Тогда
		РК.РазвернутьЭлементыМассива(МассивЭлементов);
	КонецЕсли;
	
	Возврат МассивЭлементов;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УдалитьСтрокуДерева(Дерево, Строка)
	
	СтрокаРодителя = Строка.ПолучитьРодителя();
	Если СтрокаРодителя=Неопределено Тогда
		СтрокаРодителя = Дерево;
	КонецЕсли;
	
	СтрокаРодителя.ПолучитьЭлементы().Удалить(Строка);
	
КонецФункции

&НаКлиенте
Функция СкопироватьПереместитьЭлементДерева(знач Элемент, Родитель, Дерево, Переместить=Ложь)
	
	ВсеЭлементы = ПолучитьВсеЭлементыДерева(Элемент, Истина);
	
	РодительЭлемента = Элемент.ПолучитьРодителя();
	Если РодительЭлемента = Неопределено Тогда
		РодительЭлемента = Дерево;
	КонецЕсли;
	
	СкопированныеЭлементы = Новый Соответствие;
	СкопированныеЭлементы[РодительЭлемента] = Родитель;
	
	Для Каждого Элемент Из ВсеЭлементы Цикл
		РодительЭлемента = Элемент.ПолучитьРодителя();
		Если РодительЭлемента = Неопределено Тогда
			РодительЭлемента = Дерево;
		КонецЕсли;
		РодительКопииЭлемента = СкопированныеЭлементы[РодительЭлемента];
		КопияЭлемента = РодительКопииЭлемента.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(КопияЭлемента, Элемент);
		СкопированныеЭлементы[Элемент] = КопияЭлемента;
	КонецЦикла;
	
	Элемент = ВсеЭлементы[0];
	КопияЭлемента = СкопированныеЭлементы[Элемент];
	
	Если Переместить Тогда
		РодительЭлемента = Элемент.ПолучитьРодителя();
		Если РодительЭлемента = Неопределено Тогда
			РодительЭлемента = Дерево;
		КонецЕсли;
		РодительЭлемента.ПолучитьЭлементы().Удалить(Элемент);
	КонецЕсли;
	
	Возврат КопияЭлемента;
	
КонецФункции

&НаКлиенте
Функция ОткрытьФормуСвойствЭлемента(Элемент)
	
	Перем ОписаниеОповещенияОЗакрытии;
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Элемент", Элемент);
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ОбработкаРедактированияСвойствЭлемента", ЭтаФорма, ДополнительныеПараметры);
	
	ФормаРедактированияСвойствЭлемента = ПолучитьФорму(Переменные.ИмяОбработки + ".Форма.ФормаСвойстваЭлемента", , ЭтаФорма, Элемент.ИмяЭлемента);
	ФормаРедактированияСвойствЭлемента.Переменные.Элемент = Элемент;
	ФормаРедактированияСвойствЭлемента.ОписаниеОповещенияОЗакрытии = ОписаниеОповещенияОЗакрытии;
	ФормаРедактированияСвойствЭлемента.Открыть();
	
КонецФункции

&НаКлиенте
Процедура ОбработкаРедактированияСвойствЭлемента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = ДополнительныеПараметры.Элемент;
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	
	ТекущиеЗначенияСвойствЭлемента = РК.НайтиЭлементыКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов, Новый Структура("ИмяЭлемента", Элемент.ИмяЭлемента));
	РК.УдалитьЭлементыКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов, ТекущиеЗначенияСвойствЭлемента);
	РК.ДобавитьЭлементыКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов, Результат.ТаблицаЗначенийСвойств);
	
	ТекущиеОбработчикиСобытийЭлемента = РК.НайтиЭлементыКоллекции(Переменные.ТаблицаОбработчиковСобытийЭлементов, Новый Структура("ИмяЭлемента", Элемент.ИмяЭлемента));
	РК.УдалитьЭлементыКоллекции(Переменные.ТаблицаОбработчиковСобытийЭлементов, ТекущиеОбработчикиСобытийЭлемента);
	РК.ДобавитьЭлементыКоллекции(Переменные.ТаблицаОбработчиковСобытийЭлементов, Результат.ТаблицаОбработчиковСобытий);

	Элемент.ИмяЭлемента = Результат.ИмяЭлемента;
	Элемент.ВидЭлемента = Результат.ВидЭлемента;
	ОбновитьСтрокуЭлементаНаФорме(Элемент);
	
КонецПроцедуры

&НаКлиенте
Функция ОбновитьСтрокуЭлементаНаФорме(СтрокаЭлемента)
	
	СтрокаТипаЭлемента = вмс_КонструкторФорм.ПолучитьСведенияОТипеЭлементаФормы(Переменные.СведенияОТипахЭлементовФормы, СтрокаЭлемента.ТипЭлемента, СтрокаЭлемента.ВидЭлемента);
	
	Если СтрокаТипаЭлемента<>Неопределено Тогда
		
		СтрокаЭлемента.ПредставлениеТипаЭлемента = СтрокаТипаЭлемента.Представление;
		СтрокаЭлемента.Картинка = СтрокаТипаЭлемента.Картинка;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекстОписанияФормы() Экспорт
	
	Перем РаботаСXML;
	
	РаботаСXML = Переменные.ОбщиеМодули.РаботаСXML;
	
	ОписаниеФормы = ПолучитьОписаниеФормы();
	
	ТекстОписанияФормы = РаботаСXML.XMLСтрокаИзЗначенияУлучшенная(ОписаниеФормы);
	
	Возврат ТекстОписанияФормы;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОписаниеФормы()
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	
	ОписаниеФормы = вмс_КонструкторФорм.НовоеОписаниеФормы();
	ОписаниеФормы.ТекстМодуля = РедакторМодуляФормы.ПолучитьТекст();
	
	//Реквизиты
	СоответствиеРеквизитов = Новый Соответствие;
	Для Каждого СтрокаРеквизита Из ПолучитьВсеЭлементыДерева(СтруктураРеквизитов) Цикл
		ОписаниеРеквизита = вмс_КонструкторФорм.НовоеОписаниеРеквизита();
		СтрокаЗначенийСвойствРеквизита = ПолучитьЗначенияСвойствРеквизита(СтрокаРеквизита);
		ЗаполнитьЗначенияСвойств(ОписаниеРеквизита, СтрокаЗначенийСвойствРеквизита, "ИмяРеквизита, ТипРеквизита, Заголовок, Статический");
		РодительСтрокиРеквизита = СтрокаРеквизита.ПолучитьРодителя();
		Если РодительСтрокиРеквизита=Неопределено Тогда
			ОписаниеРодителяРеквизита = ОписаниеФормы;
		Иначе
			ОписаниеРодителяРеквизита = СоответствиеРеквизитов[РодительСтрокиРеквизита];
		КонецЕсли;
		ОписаниеРодителяРеквизита.ПодчиненныеРеквизиты.Добавить(ОписаниеРеквизита);
		
		СоответствиеРеквизитов[СтрокаРеквизита] = ОписаниеРеквизита;
	КонецЦикла;
	
	//Команды
	Для Каждого СтрокаКоманды Из ТаблицаКоманд Цикл
		ОписаниеКоманды = вмс_КонструкторФорм.НовоеОписаниеКоманды();
		СтрокаЗначенийСвойствКоманды = ПолучитьЗначенияСвойствКоманды(СтрокаКоманды);
		ЗаполнитьЗначенияСвойств(ОписаниеКоманды, СтрокаЗначенийСвойствКоманды);
		ОписаниеФормы.Команды.Добавить(ОписаниеКоманды);
	КонецЦикла;
	
	//Элементы
	СоответствиеЭлементов = Новый Соответствие;
	СоответствиеЭлементов[Переменные.СтрокаФормы] = ОписаниеФормы;
	Для Каждого СтрокаЭлемента Из ПолучитьВсеЭлементыДерева(СтруктураЭлементов) Цикл
		ОписаниеЭлемента = СоответствиеЭлементов[СтрокаЭлемента];
		Если ОписаниеЭлемента = Неопределено Тогда
			ОписаниеЭлемента = вмс_КонструкторФорм.НовоеОписаниеЭлемента();
			СоответствиеЭлементов[СтрокаЭлемента] = ОписаниеЭлемента;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ОписаниеЭлемента, СтрокаЭлемента, "ИмяЭлемента, ТипЭлемента, ВидЭлемента");
		
		//
		СвойстваЭлемента = вмс_КонструкторФорм.ПолучитьСвойстваЭлементаФормы(Переменные.СведенияОТипахЭлементовФормы, СтрокаЭлемента.ТипЭлемента, СтрокаЭлемента.ВидЭлемента);
		Для Каждого СвойствоЭлемента Из СвойстваЭлемента Цикл
			ЗначенияСвойстваЭлемента = РК.НайтиЭлементыКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов, Новый Структура("ИмяЭлемента, ИмяСвойства", СтрокаЭлемента.ИмяЭлемента, СвойствоЭлемента.ИмяСвойства));
			Если ЗначенияСвойстваЭлемента.Количество() > 0 Тогда
				ЗначениеСвойства = ЗначенияСвойстваЭлемента[0].ЗначениеСвойства;
			Иначе
				ЗначениеСвойства = СвойствоЭлемента.ЗначениеПоУмолчанию;
			КонецЕсли;
			ОписаниеЭлемента.Свойства.Вставить(СвойствоЭлемента.ИмяСвойства, ЗначениеСвойства);
		КонецЦикла;
		
		//
		СобытияЭлемента = вмс_КонструкторФорм.ПолучитьСобытияЭлементаФормы(Переменные.СведенияОТипахЭлементовФормы, СтрокаЭлемента.ТипЭлемента, СтрокаЭлемента.ВидЭлемента);
		Для Каждого СобытиеЭлемента Из СобытияЭлемента Цикл
			ИменаОбработчиковСобытияЭлемента = РК.НайтиЭлементыКоллекции(Переменные.ТаблицаОбработчиковСобытийЭлементов, Новый Структура("ИмяЭлемента, ИмяСобытия", СтрокаЭлемента.ИмяЭлемента, СобытиеЭлемента.ИмяСобытия));
			Если ИменаОбработчиковСобытияЭлемента.Количество() > 0 Тогда
				ИмяОбработчика = ИменаОбработчиковСобытияЭлемента[0].ИмяОбработчика;
			Иначе
				ИмяОбработчика = "";
			КонецЕсли;
			ОписаниеЭлемента.События.Вставить(СобытиеЭлемента.ИмяСобытия, ИмяОбработчика);
		КонецЦикла;
		
		РодительСтрокиЭлемента = СтрокаЭлемента.ПолучитьРодителя();
		Если РодительСтрокиЭлемента <> Неопределено Тогда
			ОписаниеРодителяЭлемента = СоответствиеЭлементов[РодительСтрокиЭлемента];
			ОписаниеРодителяЭлемента.ПодчиненныеЭлементы.Добавить(ОписаниеЭлемента);
		КонецЕсли;

	КонецЦикла;
	
	вмс_КонструкторФорм.ЗаполнитьДополнительныеСвойстваОписанияФормы(ОписаниеФормы);
	
	Возврат ОписаниеФормы;
	
КонецФункции

&НаСервере
