&НаКлиенте
Функция УстановитьЗначениеСвойстваКоманды(СтрокаКоманды, ИмяСвойства, ЗначениеСвойства)
	
	ПолучитьЗначенияСвойствКоманды(СтрокаКоманды)[ИмяСвойства] = ЗначениеСвойства;
	
	ОбновитьСтрокуКомандыНаФорме(СтрокаКоманды);
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяНовойКоманды()
	
	СуществующиеИмена = Новый Соответствие;
	
	Для Каждого СтрокаКоманды Из ТаблицаКоманд Цикл
		СуществующиеИмена[СтрокаКоманды.Имя] = Истина;
	КонецЦикла;
	
	Префикс = "Команда";
	НомерКоманды = 1;
	
	Пока Истина Цикл
		НомерКомандыСтрокой = Формат(НомерКоманды, "ЧГ=0");
		ИмяКоманды = Префикс + НомерКомандыСтрокой;
		Если СуществующиеИмена[ИмяКоманды]<>Истина Тогда
			Прервать;
		КонецЕсли;
		НомерКоманды = НомерКоманды + 1;
	КонецЦикла;
	
	Возврат ИмяКоманды;
	
КонецФункции

&НаКлиенте
Функция ПолучитьЗначенияСвойствКоманды(СтрокаКоманды)
	
	Перем РК;
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	
	КлючКоманды = Новый Структура("СтрокаКоманды", СтрокаКоманды);
	СтрокаЗначенийСвойствКоманды = РК.НайтиЭлементКоллекции(Переменные.ТаблицаЗначенийСвойствКоманд, КлючКоманды);
	
	Если СтрокаЗначенийСвойствКоманды=Неопределено Тогда
		СтрокаЗначенийСвойствКоманды = РК.ДобавитьЭлементКоллекции(Переменные.ТаблицаЗначенийСвойствКоманд, КлючКоманды);
		СтрокаЗначенийСвойствКоманды.Картинка = Новый Картинка;
		СтрокаЗначенийСвойствКоманды.Отображение = ОтображениеКнопки.Авто;
	КонецЕсли;
	
	Возврат СтрокаЗначенийСвойствКоманды;

КонецФункции

&НаКлиенте
Функция ОбновитьСтрокуКомандыНаФорме(СтрокаКоманды)
	
	СтрокаЗначенийСвойствКоманды = ПолучитьЗначенияСвойствКоманды(СтрокаКоманды);
	
	ЗаполнитьЗначенияСвойств(СтрокаКоманды, СтрокаЗначенийСвойствКоманды, "Имя, Действие, Заголовок, Картинка");
	СтрокаКоманды.Отображение = Строка(СтрокаЗначенийСвойствКоманды.Отображение);
	
КонецФункции

&НаКлиенте
Процедура КомандыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	СтрокаНовойКоманды = ТаблицаКоманд.Добавить();
	
	Если Копирование Тогда
		СтрокаКоманды = Элементы.Команды.ТекущиеДанные;
		ЗначенияСвойствКоманды = ПолучитьЗначенияСвойствКоманды(СтрокаКоманды);
		ЗначенияСвойствНовойКоманды = ПолучитьЗначенияСвойствКоманды(СтрокаНовойКоманды);
		ЗаполнитьЗначенияСвойств(ЗначенияСвойствНовойКоманды, ЗначенияСвойствКоманды);
	КонецЕсли;

	ИмяНовойКоманды = ПолучитьИмяНовойКоманды();
	УстановитьЗначениеСвойстваКоманды(СтрокаНовойКоманды, "Имя", ИмяНовойКоманды);
	ОбновитьСтрокуКомандыНаФорме(СтрокаНовойКоманды);
	
	Элементы.Команды.ТекущаяСтрока = СтрокаНовойКоманды.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Перем РаботаСФормамиКлиент;
	
	РаботаСФормамиКлиент = глОбщийМодуль("РаботаСФормамиКлиент");
	
	СтрокаКоманды = Элементы.Команды.ТекущиеДанные;

	Если Элемент.ТекущийЭлемент.Имя = "КомандыКартинка" Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("СтрокаКоманды", СтрокаКоманды);
		ОО = Новый ОписаниеОповещения("ОбработчикВыбораКартинкиКоманды", ЭтаФорма, ДополнительныеПараметры);
		РаботаСФормамиКлиент.ОткрытьДиалогВыбораКартинки(ОО, ЭтаФорма, СтрокаКоманды.Картинка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораКартинкиКоманды(Картинка, ДополнительныеПараметры) Экспорт
	
	Если Картинка=Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьЗначениеСвойстваКоманды(ДополнительныеПараметры.СтрокаКоманды, "Картинка", Картинка);

КонецПроцедуры

&НаКлиенте
Процедура КомандыПолеПриИзменении(Элемент)
	
	СтрокаКоманды = Элементы.Команды.ТекущиеДанные;
	ИмяПоля = Прав(Элемент.Имя, СтрДлина(Элемент.Имя)-СтрДлина("Команды"));
	СтрокаЗначенийСвойствКоманды = ПолучитьЗначенияСвойствКоманды(СтрокаКоманды);
	СтрокаЗначенийСвойствКоманды[ИмяПоля] = СтрокаКоманды[ИмяПоля];
	
КонецПроцедуры

&НаКлиенте
Процедура КомандыКартинкаНажатие(Элемент, СтандартнаяОбработка)
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандыОтображениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаКоманды = Элементы.Команды.ТекущиеДанные;
	СтрокаЗначенийСвойствКоманды = ПолучитьЗначенияСвойствКоманды(СтрокаКоманды);
	
	СписокВыбора = ПолучитьСписокЗначенийПеречисления("ОтображениеКнопки");
	ТекущийЭлементЗначения = СписокВыбора.НайтиПоЗначению(СтрокаЗначенийСвойствКоманды.Отображение);
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СтрокаКоманды", СтрокаКоманды);
	ОО = Новый ОписаниеОповещения("ОбработчикВыбораЗначениеОтображенияКоманды", ЭтаФорма, ДополнительныеПараметры);
	СписокВыбора.ПоказатьВыборЭлемента(ОО, "Отображение", ТекущийЭлементЗначения); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораЗначениеОтображенияКоманды(ЭлементЗначения, ДополнительныеПараметры) Экспорт
	
	Если ЭлементЗначения=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеСвойстваКоманды(ДополнительныеПараметры.СтрокаКоманды, "Отображение", ЭлементЗначения.Значение);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокЗначенийПеречисления(ИмяТипаОбъекта)
	
	СписокЗначений = Новый СписокЗначений;
	
	Перечисление = Вычислить(ИмяТипаОбъекта);
	
	Для Каждого Значение Из Перечисление Цикл
		Представление = Строка(Значение);
		СписокЗначений.Добавить(Значение, Представление);
	КонецЦикла;
	
	Возврат СписокЗначений;
	
КонецФункции

