&НаКлиенте
Функция УстановитьЗначениеСвойстваЭлемента(ИмяЭлемента, ИмяСвойства, ЗначениеСвойства)
	
	ЗначенияСвойств = Новый Структура(ИмяСвойства, ЗначениеСвойства);
	
	УстановитьЗначенияСвойствЭлемента(ИмяЭлемента, ЗначенияСвойств)
	
КонецФункции

&НаКлиенте
Функция УстановитьЗначенияСвойствЭлемента(ИмяЭлемента, ЗначенияСвойств)
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	
	Для Каждого ЗначениеСвойства Из ЗначенияСвойств Цикл
		КлючСвойства = Новый Структура("ИмяЭлемента, ИмяСвойства", ИмяЭлемента, ЗначениеСвойства.Ключ);
		СтрокаЗначенияСвойстваЭлемента = РК.НайтиЭлементКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов, КлючСвойства);
		Если СтрокаЗначенияСвойстваЭлемента=Неопределено Тогда
			СтрокаЗначенияСвойстваЭлемента = РК.ДобавитьЭлементКоллекции(Переменные.ТаблицаЗначенийСвойствЭлементов, КлючСвойства);
		КонецЕсли;
		
		СтрокаЗначенияСвойстваЭлемента.ЗначениеСвойства = ЗначениеСвойства.Значение;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура Тест(Команда)
	
	ОписаниеФормы = ПолучитьОписаниеФормы();
	
	Для Каждого СвойствоОбъекта Из ОписаниеФормы.Свойства Цикл
		ОписаниеФормы.Свойства[СвойствоОбъекта.Ключ] = Строка(СвойствоОбъекта.Значение);
	КонецЦикла;
	
	Для Каждого ОписаниеЭлемента Из ОписаниеФормы.Элементы Цикл
		
		Для Каждого СвойствоОбъекта Из ОписаниеЭлемента.Свойства Цикл
			ОписаниеЭлемента.Свойства[СвойствоОбъекта.Ключ] = Строка(СвойствоОбъекта.Значение);
		КонецЦикла;
		
		ОписаниеЭлемента.Родитель = Неопределено;
		ОписаниеЭлемента.Элементы.Очистить();
		
	КонецЦикла;
	
	ОписаниеФормы.Элементы.Очистить();

	Для Каждого ОписаниеРеквизита Из ОписаниеФормы.Реквизиты Цикл
		
		ОписаниеРеквизита.Родитель = Неопределено;
		ОписаниеРеквизита.Реквизиты.Очистить();
		
	КонецЦикла;

	ТестНаСервере(ОписаниеФормы);
	
КонецПроцедуры

