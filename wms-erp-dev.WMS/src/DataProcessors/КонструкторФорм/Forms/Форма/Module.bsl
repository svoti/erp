	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ИмяОбработки = ОбработкаОбъект.Метаданные().ПолноеИмя();
	Возврат ИмяОбработки;
	
КонецФункции

&НаКлиенте
Функция Инициализация()
	
	Перем РК, РаботаСФормамиКлиент, ОбщегоНазначенияКлиентСервер, РаботаСXML;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	РаботаСФормамиКлиент = глОбщийМодуль("РаботаСФормамиКлиент");
	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	РаботаСXML = глОбщийМодуль("РаботаСXMLКлиентСервер");
	
	ОбщиеМодули = Новый Структура;
	ОбщиеМодули.Вставить("РаботаСКоллекциями", РК);
	ОбщиеМодули.Вставить("РаботаСФормамиКлиент", РаботаСФормамиКлиент);
	ОбщиеМодули.Вставить("ОбщегоНазначенияКлиентСервер", ОбщегоНазначенияКлиентСервер);
	ОбщиеМодули.Вставить("РаботаСXML", РаботаСXML);
	
	СведенияОТипахЭлементовФормы = вмс_КонструкторФорм.ПолучитьСведенияОТипахЭлементовФормы();
	
	ТаблицаЗначенийСвойствЭлементов = РК.НоваяКоллекцияЗначений("ИмяЭлемента, ИмяСвойства, ЗначениеСвойства");
	РК.ДобавитьИндексКоллекции(ТаблицаЗначенийСвойствЭлементов, "ИмяЭлемента, ИмяСвойства");
	
	ТаблицаОбработчиковСобытийЭлементов = РК.НоваяКоллекцияЗначений("ИмяЭлемента, ИмяСобытия, ИмяОбработчика");
	РК.ДобавитьИндексКоллекции(ТаблицаОбработчиковСобытийЭлементов, "ИмяЭлемента, ИмяСобытия");

	//здесь хранятся значения свойств реквизитов и команд, которые нельзя хранить в данных формы, ну и заодно храним все остальные значения
	ТаблицаЗначенийСвойствРеквизитов = РК.НоваяКоллекцияЗначений("СтрокаРеквизита, ИмяРеквизита, ТипРеквизита, Заголовок, Статический");
	РК.ДобавитьИндексКоллекции(ТаблицаЗначенийСвойствРеквизитов, "СтрокаРеквизита");

	ТаблицаЗначенийСвойствКоманд = РК.НоваяКоллекцияЗначений("СтрокаКоманды, Имя, Заголовок, Действие, Картинка, Отображение");
	РК.ДобавитьИндексКоллекции(ТаблицаЗначенийСвойствКоманд, "СтрокаКоманды");
	
	Переменные = Новый Структура;
	Переменные.Вставить("СведенияОТипахЭлементовФормы", СведенияОТипахЭлементовФормы);
	Переменные.Вставить("ТаблицаЗначенийСвойствЭлементов", ТаблицаЗначенийСвойствЭлементов);
	Переменные.Вставить("ТаблицаОбработчиковСобытийЭлементов", ТаблицаОбработчиковСобытийЭлементов);
	Переменные.Вставить("ТаблицаЗначенийСвойствРеквизитов", ТаблицаЗначенийСвойствРеквизитов);
	Переменные.Вставить("ТаблицаЗначенийСвойствКоманд", ТаблицаЗначенийСвойствКоманд);
	Переменные.Вставить("ОбщиеМодули", ОбщиеМодули);
	Переменные.Вставить("ИмяОбработки", ПолучитьИмяОбработки());
	Переменные.Вставить("ДействиеПеретаскивания", Вычислить("ДействиеПеретаскивания"));
	Переменные.Вставить("ДопустимыеДействияПеретаскивания", Вычислить("ДопустимыеДействияПеретаскивания"));
	Переменные.Вставить("ИмяМакета", "_Тест_");

	
	СтрокиЭлементов = СтруктураЭлементов.ПолучитьЭлементы();
	СтрокиЭлементов.Очистить();
	СтрокаФормы = СтрокиЭлементов.Добавить();
	СтрокаФормы.ИмяЭлемента = "Форма";
	СтрокаФормы.ТипЭлемента = "ФормаКлиентскогоПриложения";
	ОбновитьСтрокуЭлементаНаФорме(СтрокаФормы);
	Переменные.Вставить("СтрокаФормы", СтрокаФормы);
	
КонецФункции

&НаКлиенте
Функция ПолучитьЗначенияСвойствРеквизита(СтрокаРеквизита)
	
	Перем РК, ОбщегоНазначенияКлиентСервер;
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;
	ОбщегоНазначенияКлиентСервер = Переменные.ОбщиеМодули.ОбщегоНазначенияКлиентСервер;
	
	КлючРеквизита = Новый Структура("СтрокаРеквизита", СтрокаРеквизита);
	СтрокаЗначенийСвойствРеквизита = РК.НайтиЭлементКоллекции(Переменные.ТаблицаЗначенийСвойствРеквизитов, КлючРеквизита);
	
	Если СтрокаЗначенийСвойствРеквизита=Неопределено Тогда
		СтрокаЗначенийСвойствРеквизита = РК.ДобавитьЭлементКоллекции(Переменные.ТаблицаЗначенийСвойствРеквизитов, КлючРеквизита);
		СтрокаЗначенийСвойствРеквизита.ИмяРеквизита = СтрокаРеквизита.ИмяРеквизита;
		СтрокаЗначенийСвойствРеквизита.ТипРеквизита = ОбщегоНазначенияКлиентСервер.НовоеКвазиОписаниеТипов("Строка");
		СтрокаЗначенийСвойствРеквизита.Заголовок = СтрокаРеквизита.Заголовок;
		СтрокаЗначенийСвойствРеквизита.Статический = СтрокаРеквизита.Статический;
	КонецЕсли;
	
	Возврат СтрокаЗначенийСвойствРеквизита;

КонецФункции

&НаКлиенте
Функция ОбновитьСтрокуРеквизитаНаФорме(СтрокаРеквизита)
	
	Перем ОбщегоНазначенияКлиентСервер;
	
	ОбщегоНазначенияКлиентСервер = Переменные.ОбщиеМодули.ОбщегоНазначенияКлиентСервер;
	
	СтрокаЗначенийСвойствРеквизита = ПолучитьЗначенияСвойствРеквизита(СтрокаРеквизита);
	
	СтрокаРеквизита.ИмяРеквизита = СтрокаЗначенийСвойствРеквизита.ИмяРеквизита;
	СтрокаРеквизита.ПредставлениеТипаРеквизита = ОбщегоНазначенияКлиентСервер.ПредставлениеОбъекта(СтрокаЗначенийСвойствРеквизита.ТипРеквизита);
	СтрокаРеквизита.Заголовок = СтрокаЗначенийСвойствРеквизита.Заголовок;
	СтрокаРеквизита.Статический = СтрокаЗначенийСвойствРеквизита.Статический;
	
	Если СтрокаРеквизита=Элементы.СтруктураРеквизитов.ТекущиеДанные Тогда
		ПриОбновленииТекущейСтрокиРеквизита();
	КонецЕсли;
	
КонецФункции

