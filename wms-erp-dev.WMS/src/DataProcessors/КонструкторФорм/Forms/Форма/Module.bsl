&НаКлиенте
Процедура Проверить(Команда)
	
	Перем РаботаСФормамиКлиент;
	
	РаботаСФормамиКлиент = глОбщийМодуль("РаботаСФормамиКлиент");

	ИмяКласса = вмс_КонструкторФорм.ПолучитьИмяКлассаМодуляФормы(Переменные.ИмяМакета);
	
	ОписаниеФормы = ПолучитьОписаниеФормы();
	ТекстОписанияФормы = Переменные.ОбщиеМодули.РаботаСXML.XMLСтрокаИзЗначенияУлучшенная(ОписаниеФормы);
	ТекстМодуляКлассаФормы = вмс_КонструкторФорм.ПолучитьТекстМодуляКласса(ИмяКласса, ОписаниеФормы);
	МодульКлассаФормы = Новый Структура;
	МодульКлассаФормы.Вставить("Текст", ТекстМодуляКлассаФормы);
	МодульКлассаФормы.Вставить("Ссылка", ПредопределенноеЗначение("Справочник.вмс_ПрограммныеМодули.ПустаяСсылка"));
	
	Макет = Новый Структура;
	Макет.Вставить("Наименование", Переменные.ИмяМакета);
	Макет.Вставить("Данные", ТекстОписанияФормы);
	Макет.Вставить("МодульКлассаФормы", МодульКлассаФормы);
	Макет.Вставить("ИмяКлассаФормы", ИмяКласса);
	РаботаСФормамиКлиент.ОткрытьФормуИзМакета(Макет, , ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьИзXML(Команда)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.ПолноеИмяФайла = ИмяФайлаXML;
	ДиалогВыбораФайла.Фильтр = "Файлы в формате XML|*.xml";
	
	ВыбранныеФайлы = Ждать ДиалогВыбораФайла.ВыбратьАсинх();
	Если ВыбранныеФайлы=Неопределено ИЛИ ВыбранныеФайлы.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмяФайла = ВыбранныеФайлы[0];
	ЗагрузитьИзФайлаXML(Новый ОписаниеОповещения("ЗагрузитьИзXMLЗавершение", ЭтаФорма, Новый Структура("ДиалогВыбораФайла", ДиалогВыбораФайла)), ПолноеИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзXMLЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДиалогВыбораФайла = ДополнительныеПараметры.ДиалогВыбораФайла;
	
	
	Если Результат Тогда
		ИмяФайлаXML = ДиалогВыбораФайла.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаXML(Знач Оповещение, ИмяФайлаXML)
	
	Перем ОбщегоНазначенияКлиентСервер;
	
	ОбщегоНазначенияКлиентСервер = Переменные.ОбщиеМодули.ОбщегоНазначенияКлиентСервер;

	ТекстXML = ОбщегоНазначенияКлиентСервер.ПолучитьТекстИзФайла(ИмяФайлаXML);
	
	ОписаниеФормы = вмс_КонструкторФорм.ЗагрузитьОписаниеИзНативногоТекстаXML(ТекстXML);
	
	ФайлРазметкиФормы = Новый Файл(ИмяФайлаXML);
	ИмяФайлаМодуляФормы = ФайлРазметкиФормы.Путь + ФайлРазметкиФормы.ИмяБезРасширения + "\Module.bsl";
	
	ФайлМодуляФормы = Новый Файл(ИмяФайлаМодуляФормы);
	ФайлМодуляФормы.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ЗагрузитьИзФайлаXMLЗавершение", ЭтаФорма, Новый Структура("ИмяФайлаМодуляФормы, ОписаниеФормы, Оповещение", ИмяФайлаМодуляФормы, ОписаниеФормы, Оповещение)));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаXMLЗавершение(Существует, ДополнительныеПараметры) Экспорт
	
	Перем ОбщегоНазначенияКлиентСервер;
	
	ОбщегоНазначенияКлиентСервер = Переменные.ОбщиеМодули.ОбщегоНазначенияКлиентСервер;

	ИмяФайлаМодуляФормы = ДополнительныеПараметры.ИмяФайлаМодуляФормы;
	ОписаниеФормы = ДополнительныеПараметры.ОписаниеФормы;
	Оповещение = ДополнительныеПараметры.Оповещение;
		
	Если Существует Тогда
		ТекстМодуляФормы = ОбщегоНазначенияКлиентСервер.ПолучитьТекстИзФайла(ИмяФайлаМодуляФормы);
		ОписаниеФормы.ТекстМодуля = ТекстМодуляФормы;
		РедакторМодуляФормы.УстановитьТекст(ТекстМодуляФормы);
	КонецЕсли;
	
	ЗагрузитьДанныеИзОписанияФормы(ОписаниеФормы);
	
	ВыполнитьОбработкуОповещения(Оповещение, Истина);

КонецПроцедуры

&НаКлиенте
Функция ЗагрузитьДанныеИзТекстаОписанияФормы(ТекстОписанияФормы) Экспорт
	
	Перем РаботаСXML;
	
	Если Не ЗначениеЗаполнено(ТекстОписанияФормы) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РаботаСXML = Переменные.ОбщиеМодули.РаботаСXML;
	
	ОписаниеФормы = РаботаСXML.ПрочитатьТекстXMLУлучшенная(ТекстОписанияФормы);
	
	Возврат ЗагрузитьДанныеИзОписанияФормы(ОписаниеФормы);
	
КонецФункции

&НаКлиенте
Функция ЗагрузитьДанныеИзОписанияФормы(ОписаниеФормы)
	
	РК = Переменные.ОбщиеМодули.РаботаСКоллекциями;

	РедакторМодуляФормы.УстановитьТекст(ОписаниеФормы.ТекстМодуля);
	
	СтруктураЭлементов.ПолучитьЭлементы().Очистить();
	СоответствиеЭлементов = Новый Соответствие;
	ОбходЭлементов = Новый Массив;
	ОбходЭлементов.Добавить(ОписаниеФормы);
	РК.ДобавитьЭлементыКоллекции(ОбходЭлементов, ОписаниеФормы.Элементы);
	
	ТаблицаЗначенийСвойствЭлементов = Переменные.ТаблицаЗначенийСвойствЭлементов;
	РК.ОчиститьЭлементыКоллекции(ТаблицаЗначенийСвойствЭлементов);
	
	ТаблицаОбработчиковСобытийЭлементов = Переменные.ТаблицаОбработчиковСобытийЭлементов;
	РК.ОчиститьЭлементыКоллекции(ТаблицаОбработчиковСобытийЭлементов);
	
	Для Каждого ОписаниеЭлемента Из ОбходЭлементов Цикл
		
		Если ОписаниеЭлемента.Родитель = Неопределено Тогда
			СтрокаРодитель = СтруктураЭлементов;
		Иначе
			СтрокаРодитель = СоответствиеЭлементов[ОписаниеЭлемента.Родитель];
		КонецЕсли;
		
		СтрокаЭлемента = СтрокаРодитель.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЭлемента, ОписаниеЭлемента);
		
		Для Каждого СвойствоЭлемента Из ОписаниеЭлемента.Свойства Цикл
			СтрокаСвойстваЭлемента = РК.ДобавитьЭлементКоллекции(ТаблицаЗначенийСвойствЭлементов);
			СтрокаСвойстваЭлемента.ИмяЭлемента = ОписаниеЭлемента.ИмяЭлемента;
			СтрокаСвойстваЭлемента.ИмяСвойства = СвойствоЭлемента.Ключ;
			СтрокаСвойстваЭлемента.ЗначениеСвойства = СвойствоЭлемента.Значение;
		КонецЦикла;
		
		Для Каждого СобытиеЭлемента Из ОписаниеЭлемента.События Цикл
			СтрокаСобытияЭлемента = РК.ДобавитьЭлементКоллекции(ТаблицаОбработчиковСобытийЭлементов);
			СтрокаСобытияЭлемента.ИмяЭлемента = ОписаниеЭлемента.ИмяЭлемента;
			СтрокаСобытияЭлемента.ИмяСобытия = СобытиеЭлемента.Ключ;
			СтрокаСобытияЭлемента.ИмяОбработчика = СобытиеЭлемента.Значение;
		КонецЦикла;
		
		ОбновитьСтрокуЭлементаНаФорме(СтрокаЭлемента);
		
		СоответствиеЭлементов[ОписаниеЭлемента] = СтрокаЭлемента;
		
	КонецЦикла;
	РК.ИндексироватьКоллекцию(ТаблицаЗначенийСвойствЭлементов);
	РК.ИндексироватьКоллекцию(ТаблицаОбработчиковСобытийЭлементов);
	
	Переменные.СтрокаФормы = СтруктураЭлементов.ПолучитьЭлементы()[0];
	
	//реквизиты
	РК.ОчиститьЭлементыКоллекции(Переменные.ТаблицаЗначенийСвойствРеквизитов);
	СтруктураРеквизитов.ПолучитьЭлементы().Очистить();
	СоответствиеРеквизитов = Новый Соответствие;
	СоответствиеРеквизитов[ОписаниеФормы] = СтруктураРеквизитов;
	Для Каждого ОписаниеРеквизита Из ОписаниеФормы.Реквизиты Цикл
		
		СтрокаРодитель = СоответствиеРеквизитов[ОписаниеРеквизита.Родитель];
		СтрокаРеквизита = СтрокаРодитель.ПолучитьЭлементы().Добавить();
		СтрокаЗначенийСвойствРеквизита = ПолучитьЗначенияСвойствРеквизита(СтрокаРеквизита);
		ЗаполнитьЗначенияСвойств(СтрокаЗначенийСвойствРеквизита, ОписаниеРеквизита);
		ОбновитьСтрокуРеквизитаНаФорме(СтрокаРеквизита);
		
		СоответствиеРеквизитов[ОписаниеРеквизита] = СтрокаРеквизита;
		
	КонецЦикла;
	
	//команды
	РК.ОчиститьЭлементыКоллекции(Переменные.ТаблицаЗначенийСвойствКоманд);
	ТаблицаКоманд.Очистить();
	Для Каждого ОписаниеКоманды Из ОписаниеФормы.Команды Цикл
		
		СтрокаКоманды = ТаблицаКоманд.Добавить();
		СтрокаЗначенийСвойствКоманды = ПолучитьЗначенияСвойствКоманды(СтрокаКоманды);
		ЗаполнитьЗначенияСвойств(СтрокаЗначенийСвойствКоманды, ОписаниеКоманды);
		ОбновитьСтрокуКомандыНаФорме(СтрокаКоманды);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура СтруктураРеквизитовТипРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Перем РаботаСФормамиКлиент, ОписаниеОповещенияОЗакрытии;
	
	РаботаСФормамиКлиент = Переменные.ОбщиеМодули.РаботаСФормамиКлиент;
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаРеквизита = Элементы.СтруктураРеквизитов.ТекущиеДанные;
	СтрокаЗначенийСвойствРеквизита = ПолучитьЗначенияСвойствРеквизита(СтрокаРеквизита);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КвазиОписаниеТипов", СтрокаЗначенийСвойствРеквизита.ТипРеквизита);
	ДополнительныеПараметрыОповещения = Новый Структура;
	ДополнительныеПараметрыОповещения.Вставить("СтрокаЗначенийСвойствРеквизита", СтрокаЗначенийСвойствРеквизита);
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ОбработкаРедактированияТипаРеквизита", ЭтаФорма, ДополнительныеПараметрыОповещения);
	РаботаСФормамиКлиент.ОткрытьФормуУлучшенная("ОбщаяФорма.ФормаРедактированияТипаДанных", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещенияОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРедактированияТипаРеквизита(КвазиОписаниеТипов, ДополнительныеПараметры) Экспорт
	
	Если КвазиОписаниеТипов=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.СтрокаЗначенийСвойствРеквизита.ТипРеквизита = КвазиОписаниеТипов;
	
	ОбновитьСтрокуРеквизитаНаФорме(ДополнительныеПараметры.СтрокаЗначенийСвойствРеквизита.СтрокаРеквизита);
	
КонецПроцедуры

