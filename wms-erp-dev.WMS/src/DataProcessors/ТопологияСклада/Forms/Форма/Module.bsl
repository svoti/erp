			СтруктураЗначений.ЛинииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтЛинии,3) * КоличествоБуквПервогоСимвола  * КоличествоБуквВторогоСимвола ;
			
		КонецЕсли;
	КонецЕсли;
	
	
	//16.03+++
	Объект.КоличествоЛиний = (СтруктураЗначений.ЛинииДиапазонЧиселДо + 1) - СтруктураЗначений.ЛинииДиапазонЧиселОт;
	//16.03----
	
	//  ++++
	ОбщееКоличествоЯчеек();	
	
	
	
	
