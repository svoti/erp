					СимволЧислоОт = Число(СимволЧислоОт);
					
					Пока СимволЧислоОт <= СимволЧислоДо Цикл
						МассивЗначений.Добавить(Символ(СимволБуквы1)+ "" +  СимволЧислоОт);
						СимволЧислоОт = СимволЧислоОт + 1;
					КонецЦикла;  
					СимволБуквы1 = СимволБуквы1 + 1;
				КонецЦикла;
			Иначе   
				Пока СимволБуквы1 <= КодСимвола(Объект.ДиапазонБуквДоСклад,1) Цикл 
					СимволБуквы2 = КодСимвола(Объект.ДиапазонБуквОтСклад,2);
					Пока СимволБуквы2 <= КодСимвола(Объект.ДиапазонБуквДоСклад,2) Цикл 
