	СтруктураЗначений.Вставить("Склад", Неопределено);  
	СтруктураЗначений.Вставить("Секции", Неопределено); 
	СтруктураЗначений.Вставить("Линии", Неопределено);
	СтруктураЗначений.Вставить("Стеллажи", Неопределено); 
	СтруктураЗначений.Вставить("Ярусы", Неопределено);
	СтруктураЗначений.Вставить("Позиции", Неопределено);  
	
	СтруктураЗначений.Вставить("СкладРазделитель", "");  
	СтруктураЗначений.Вставить("СекцииРазделитель", ""); 
