		ДиапазонЧисел = Объект.ДиапазонЧиселОтСклад;	
		Пока ДиапазонЧисел <= Объект.ДиапазонЧиселДоСклад Цикл 
			Если ДиапазонЧисел = 0 Тогда
				ДиапазонЧисел = Формат(ДиапазонЧисел,"ЧН=0");
				МассивЗначений.Добавить(ДиапазонЧисел);
				ДиапазонЧисел = 0;
			Иначе
				
				МассивЗначений.Добавить(ДиапазонЧисел);
				
			КонецЕсли;
			ДиапазонЧисел = ДиапазонЧисел + 1;
		КонецЦикла;        
	Иначе 
		// +++
		ДлинаПоиска = СтрДлина(Объект.ДиапазонБуквДоСклад);
		Если ДлинаПоиска = 1 Тогда
			СимволБуквы = КодСимвола(Объект.ДиапазонБуквОтСклад);
			Пока СимволБуквы <= КодСимвола(Объект.ДиапазонБуквДоСклад) Цикл
