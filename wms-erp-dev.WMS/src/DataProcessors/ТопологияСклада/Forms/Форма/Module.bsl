&НаКлиенте
Процедура ДиапазонБуквОтСкладРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Если Объект.ТипНомераСклад = "Алфавитно-цифровой (рус.)" Тогда
		ОтА = 1040;
		ДоЯ = 1103;
	ИначеЕсли Объект.ТипНомераСклад = "Алфавитно-цифровой (лат.)" Тогда
		ОтА = 65;
		ДоЯ = 122;	    
	КонецЕсли;
	
	ДлинаПоиска = СтрДлина(Объект.ДиапазонБуквОтСклад);	
	Если ДлинаПоиска = 1 Тогда
		НомерСимвола = 1;  
		ПервыеБуквы = "";
	ИначеЕсли ДлинаПоиска = 2 Тогда
		НомерСимвола = 2; 
		ПервыеБуквы = КодСимвола(Объект.ДиапазонБуквОтСклад,1);
		ПервыеБуквы = Символ(ПервыеБуквы);
	Иначе
		НомерСимвола = 3; 
		Буква1 = КодСимвола(Объект.ДиапазонБуквОтСклад,1);  
		Буква1 = Символ(Буква1);
		Буква2 = КодСимвола(Объект.ДиапазонБуквОтСклад,2); 
		Буква2 = Символ(Буква2);
		ПервыеБуквы = Буква1 + Буква2;
	КонецЕсли;
	Если Направление > 0  Тогда        
		ТекущийСимвол = КодСимвола(Объект.ДиапазонБуквОтСклад,НомерСимвола);
		СимволЧисло = Ложь;
		Если ТекущийСимвол >= 48 И ТекущийСимвол <= 57  Тогда
			СимволЧисло = Истина;
			ТекущийСимвол = ТекущийСимвол + 1;  
		КонецЕсли;
		Если ТекущийСимвол < ОтА И СимволЧисло = Ложь Тогда
			ТекущийСимвол = ОтА;
		ИначеЕсли ТекущийСимвол >= ДоЯ Тогда
			ТекущийСимвол = ДоЯ;
		КонецЕсли;       
		Если СимволЧисло Тогда 
			Если ТекущийСимвол > 57 Тогда    
				Если КодСимвола(Объект.ДиапазонБуквОтСклад, 3) = -1 Тогда
					ТекущийСимвол = ТекущийСимвол - 1;
					ТекущийСимвол = Символ(ТекущийСимвол);
					НовыйСимвол = Число(ТекущийСимвол) + 1;
					Объект.ДиапазонБуквОтСклад = ПервыеБуквы + НовыйСимвол;    
					СтруктураЗначений.СкладДиапазонЧиселОт = СтруктураЗначений.СкладДиапазонЧиселОт + 1;   
					ОбщееКоличествоЯчеек();    
				Иначе  
					Число1 = КодСимвола(Объект.ДиапазонБуквОтСклад, 2);  
					Число2 = КодСимвола(Объект.ДиапазонБуквОтСклад, 3);  
					Число1 = Символ(Число1);
					Число2 = Символ(Число2);
					Если КодСимвола(Число1) <= 57 Тогда  
						Если Число1 = "9" И Число2 = "9" Тогда
							ПервыеБуквы = КодСимвола(Объект.ДиапазонБуквОтСклад,1); 
							ПервыеБуквы = Символ(ПервыеБуквы);
							ТекущийСимвол = "" + Число1 + "" + Число2;
							ТекущийСимвол = Число(ТекущийСимвол);
							НовыйСимвол = ТекущийСимвол ;
							Объект.ДиапазонБуквОтСклад = ПервыеБуквы + НовыйСимвол;  
							СтруктураЗначений.СкладДиапазонЧиселОт = СтруктураЗначений.СкладДиапазонЧиселОт ;  
						Иначе
							ПервыеБуквы = КодСимвола(Объект.ДиапазонБуквОтСклад,1); 
							ПервыеБуквы = Символ(ПервыеБуквы);
							
							ТекущийСимвол = "" + Число1 + "" + Число2;
							ТекущийСимвол = Число(ТекущийСимвол);
							НовыйСимвол = ТекущийСимвол + 1;
							Объект.ДиапазонБуквОтСклад = ПервыеБуквы + НовыйСимвол;  
							СтруктураЗначений.СкладДиапазонЧиселОт = СтруктураЗначений.СкладДиапазонЧиселОт + 1;  
							ОбщееКоличествоЯчеек(); 
						КонецЕсли;
					Иначе
						ТекущийСимвол = ТекущийСимвол - 1;
						ТекущийСимвол = Символ(ТекущийСимвол);
						НовыйСимвол = Число(ТекущийСимвол);
						Объект.ДиапазонБуквОтСклад = ПервыеБуквы + НовыйСимвол;
						ОбщееКоличествоЯчеек();   
					КонецЕсли;
				КонецЕсли;
			Иначе
				ТекущийСимвол = Символ(ТекущийСимвол);
				НовыйСимвол = Число(ТекущийСимвол);   
				Если КодСимвола(Объект.ДиапазонБуквОтСклад, 3) = - 1 Тогда
					Объект.ДиапазонБуквОтСклад = ПервыеБуквы + НовыйСимвол; 
					СтруктураЗначений.СкладДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСклад, НомерСимвола);				   
					ОбщееКоличествоЯчеек(); 
				Иначе  
					Число1 = КодСимвола(Объект.ДиапазонБуквОтСклад, 2);
					Число2 = КодСимвола(Объект.ДиапазонБуквОтСклад, 3); 
					Число1 = Символ(Число1);
					Число2 = Символ(Число2);
					Если КодСимвола(Число1) <= 57 Тогда
						ПервыеБуквы =  КодСимвола(Объект.ДиапазонБуквОтСклад, 1);
						ПервыеБуквы = Символ(ПервыеБуквы);
						НовыйСимвол = "" + Число1 + "" + Число2;
						НовыйСимвол = Число(НовыйСимвол) + 1;    
						Объект.ДиапазонБуквОтСклад = ПервыеБуквы + НовыйСимвол; 
						СтруктураЗначений.СкладДиапазонЧиселОт = СтруктураЗначений.СкладДиапазонЧиселОт + 1;
						ОбщееКоличествоЯчеек(); 	
					Иначе
						НовыйСимвол =  Число2;
						НовыйСимвол = Число(НовыйСимвол) + 1;    
						Объект.ДиапазонБуквОтСклад = ПервыеБуквы + НовыйСимвол; 
						СтруктураЗначений.СкладДиапазонЧиселОт = СтруктураЗначений.СкладДиапазонЧиселОт + 1;
						ОбщееКоличествоЯчеек(); 						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе  
			Если ТекущийСимвол = ДоЯ Тогда		 
				ТекущийСимвол = ТекущийСимвол;
			Иначе			 
				ТекущийСимвол = ТекущийСимвол + 1;
			КонецЕсли;
			НовыйСимвол = Символ(ТекущийСимвол);
			Объект.ДиапазонБуквОтСклад = ПервыеБуквы + НовыйСимвол; 
			СтруктураЗначений.СкладДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСклад, НомерСимвола);				   
			ОбщееКоличествоЯчеек(); 
		КонецЕсли;
	Иначе
		//Если НЕ Объект.ДиапазонБуквОтСклад = Объект.ДиапазонБуквОтСклад Тогда
		ТекущийСимвол = КодСимвола(Объект.ДиапазонБуквОтСклад,НомерСимвола);
		СимволЧисло = Ложь;
		Если ТекущийСимвол >= 48 И ТекущийСимвол <= 57  Тогда
			
			СимволЧисло = Истина;
			ТекущийСимвол = ТекущийСимвол - 1; 
			Если ТекущийСимвол = 47 Тогда
				ТекущийСимвол = ТекущийСимвол + 1;
			КонецЕсли;
		КонецЕсли;
		Если ТекущийСимвол <= ОтА И СимволЧисло = Ложь Тогда
			ТекущийСимвол = ОтА;
		ИначеЕсли ТекущийСимвол > ДоЯ Тогда
			ТекущийСимвол = ДоЯ;
		КонецЕсли;       
		Если СимволЧисло Тогда 
			Если ТекущийСимвол > 57 Тогда    
				Если КодСимвола(Объект.ДиапазонБуквОтСклад, 3) = -1 Тогда
					ТекущийСимвол = ТекущийСимвол + 1;
					ТекущийСимвол = Символ(ТекущийСимвол);
					НовыйСимвол = Число(ТекущийСимвол) - 1;
					Объект.ДиапазонБуквОтСклад = ПервыеБуквы + НовыйСимвол;    
					СтруктураЗначений.СкладДиапазонЧиселОт = СтруктураЗначений.СкладДиапазонЧиселОт + 1;   
					ОбщееКоличествоЯчеек();    
				Иначе  
					Число1 = КодСимвола(Объект.ДиапазонБуквОтСклад, 2);  
					Число2 = КодСимвола(Объект.ДиапазонБуквОтСклад, 3);  
