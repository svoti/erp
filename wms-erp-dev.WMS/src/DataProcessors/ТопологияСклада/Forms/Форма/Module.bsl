			КоличествоБуквВторогоСимвола = КодСимвола(Объект.ДиапазонБуквДоПозиции, 1) - КодСимвола(Объект.ДиапазонБуквОтПозиции, 1) + 1;
			СтруктураЗначений.ПозицииДиапазонЧиселДо = (КодСимвола(Объект.ДиапазонБуквДоПозиции,3) +1)  * КоличествоБуквВторогоСимвола - 1;
			СтруктураЗначений.ПозицииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтПозиции,3)  * КоличествоБуквВторогоСимвола ;   
		ИначеЕсли КодСимвола(Объект.ДиапазонБуквДоПозиции, 1) = КодСимвола(Объект.ДиапазонБуквОтПозиции, 1) И НЕ КодСимвола(Объект.ДиапазонБуквДоПозиции, 2) = КодСимвола(Объект.ДиапазонБуквОтПозиции, 2) Тогда
			КоличествоБуквВторогоСимвола = КодСимвола(Объект.ДиапазонБуквДоПозиции, 2) - КодСимвола(Объект.ДиапазонБуквОтПозиции, 2) + 1;
			СтруктураЗначений.ПозицииДиапазонЧиселДо = (КодСимвола(Объект.ДиапазонБуквДоПозиции,3) +1)  * КоличествоБуквВторогоСимвола - 1;
			СтруктураЗначений.ПозицииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтПозиции,3)  * КоличествоБуквВторогоСимвола ;
		ИначеЕсли НЕ КодСимвола(Объект.ДиапазонБуквДоПозиции, 1) = КодСимвола(Объект.ДиапазонБуквОтПозиции, 1) И НЕ КодСимвола(Объект.ДиапазонБуквДоПозиции, 2) = КодСимвола(Объект.ДиапазонБуквОтПозиции, 2) Тогда
			КоличествоБуквВторогоСимвола = КодСимвола(Объект.ДиапазонБуквДоПозиции, 2) - КодСимвола(Объект.ДиапазонБуквОтПозиции, 2) + 1; 
			КоличествоБуквПервогоСимвола = КодСимвола(Объект.ДиапазонБуквДоПозиции, 1) - КодСимвола(Объект.ДиапазонБуквОтПозиции, 1) + 1;
			СтруктураЗначений.ПозицииДиапазонЧиселДо = (КодСимвола(Объект.ДиапазонБуквДоПозиции,3) +1) * КоличествоБуквПервогоСимвола * КоличествоБуквВторогоСимвола  - 1;
			СтруктураЗначений.ПозицииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтПозиции,3) * КоличествоБуквПервогоСимвола  * КоличествоБуквВторогоСимвола ;
			
		КонецЕсли;
	КонецЕсли;
	
	//16.03+++
	Объект.КоличествоПозиции = (СтруктураЗначений.ПозицииДиапазонЧиселДо + 1) - СтруктураЗначений.ПозицииДиапазонЧиселОт;
	//16.03----
	
	
	//  ++++
	ОбщееКоличествоЯчеек();	
	
	
КонецПроцедуры

