&НаКлиенте
Процедура Просмотр(Команда)
	Если Объект.ДиапазонБуквОтСклад > Объект.ДиапазонБуквДоСклад ИЛИ Объект.ДиапазонЧиселОтСклад > Объект.ДиапазонЧиселДоСклад Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите корректный диапазон в колонке Склад!");
	ИначеЕсли Объект.ДиапазонБуквОтСекции > Объект.ДиапазонБуквДоСекции ИЛИ Объект.ДиапазонЧиселОтСекции > Объект.ДиапазонЧиселДоСекции Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите корректный диапазон в колонке Ряд/Стеллаж!");	
	ИначеЕсли Объект.ДиапазонБуквОтЛинии > Объект.ДиапазонБуквДоЛинии ИЛИ Объект.ДиапазонЧиселОтЛинии > Объект.ДиапазонЧиселДоЛинии Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите корректный диапазон в колонке Линии!");
	ИначеЕсли Объект.ДиапазонБуквОтСтеллажи > Объект.ДиапазонБуквДоСтеллажи ИЛИ Объект.ДиапазонЧиселОтСтеллажи > Объект.ДиапазонЧиселДоСтеллажи Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите корректный диапазон в колонке Секции!");
	ИначеЕсли Объект.ДиапазонБуквОтЯрусы > Объект.ДиапазонБуквДоЯрусы ИЛИ Объект.ДиапазонЧиселОтЯрусы > Объект.ДиапазонЧиселДоЯрусы Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите корректный диапазон в колонке Ярусы!");
	ИначеЕсли Объект.ДиапазонБуквОтПозиции > Объект.ДиапазонБуквДоПозиции ИЛИ Объект.ДиапазонЧиселОтПозиции > Объект.ДиапазонЧиселДоПозиции Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите корректный диапазон в колонке Позиции!");
	Иначе		
		СгенерироватьСтруктуруСклада(Истина).Показать();
		
		
	КонецЕсли;
	//СгенерироватьСтруктуруСклада(Истина).Показать();
КонецПроцедуры

&НаСервере
Функция  СгенерироватьСтруктуруСклада(ВТабличныйДокумент = Истина)
	МассивСекций = Новый Массив;  
	МассивЛиний = Новый Массив; 
	МассивСклад = Новый Массив;
	МассивСтеллажи = Новый Массив;  
	МассивЯрусы = Новый Массив;  
	МассивПозиции = Новый Массив;
	
	МассивСекций.Добавить("");
	МассивЛиний.Добавить("");
	МассивСклад.Добавить("");  
	МассивСтеллажи.Добавить(""); 
	МассивЯрусы.Добавить(""); 
	МассивПозиции.Добавить("");
	
	Если ВТабличныйДокумент Тогда
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.ОтображатьСетку = Ложь;
		Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ОбластьКоличества = Макет.ПолучитьОбласть("ОбластьКоличества");
		//ТУ_Августинович ++ 12.05.2026
		// - Добавление шапки таблицы с наименованием колонок
		ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
		//ТУ_Августинович -- 12.05.2026
		
		ОбластьЯчейки = Макет.ПолучитьОбласть("ОбластьЯчейки");  
		ТабДок.Вывести(ОбластьЗаголовок);
	КонецЕсли;	  
	
	//ТУ_Августинович ++ 000056225 27.10.2025
	СоставныеНаименования = Новый Массив;
	//ТУ_Августинович -- 27.10.2025
	
	СобратьВМассив = Новый Массив;
	Если Объект.Секции Тогда
		МассивСекций = ПолучитьСекцию();   
	КонецЕсли;
	Если Объект.Линии Тогда
		МассивЛиний = ПолучитьЛинию();   
	КонецЕсли; 
	Если Объект.Склад Тогда
		МассивСклад = ПолучитьСклад();
	КонецЕсли;  
	Если Объект.Позиции Тогда
		МассивПозиции = ПолучитьПозиции();
	КонецЕсли;
	
	Если Объект.Стеллажи Тогда
		МассивСтеллажи = ПолучитьСтеллажи();
	КонецЕсли;
	Если Объект.Ярусы Тогда
		МассивЯрусы = ПолучитьЯрусы();
	КонецЕсли;
	
	ШагСклад = 0;
	Пока ШагСклад <= МассивСклад.ВГраница()  ИЛИ Объект.Склад = Ложь Цикл  
		ШагСекции = 0;    
		Если Объект.Склад = Ложь ИЛИ (Объект.Секции = Ложь И Объект.Линии = Ложь И Объект.Стеллажи = Ложь И Объект.Ярусы = Ложь И Объект.Позиции = Ложь) Тогда
			РазделительСклад = ""; 
		Иначе
			РазделительСклад = Объект.РазделительСклад;	
		КонецЕсли;
		Пока ШагСекции <= МассивСекций.ВГраница() ИЛИ Объект.Секции = Ложь Цикл 
			ШагЛинии = 0;   
			Если Объект.Секции = Ложь ИЛИ (Объект.Линии = Ложь И Объект.Стеллажи = Ложь И Объект.Ярусы = Ложь И Объект.Позиции = Ложь)   Тогда
				РазделительСекции = "";
			Иначе
				РазделительСекции = Объект.РазделительСекции;
			КонецЕсли;
			Пока ШагЛинии <= МассивЛиний.ВГраница() ИЛИ Объект.Линии = Ложь Цикл   
				ШагСтеллажи = 0;
				Если Объект.Линии = Ложь ИЛИ (Объект.Стеллажи = Ложь И Объект.Ярусы = Ложь И Объект.Позиции = Ложь)  Тогда  
					РазделительЛинии = "";
				Иначе
					РазделительЛинии = Объект.РазделительЛинии;	
				КонецЕсли;    
				Пока ШагСтеллажи <= МассивСтеллажи.ВГраница() ИЛИ Объект.Стеллажи = Ложь Цикл  
					ШагЯрусы = 0;
					Если Объект.Стеллажи = Ложь ИЛИ (Объект.Ярусы = Ложь И Объект.Позиции = Ложь) Тогда
						//РазделительЯрусы = "";  
						РазделительСтеллажи = "";
					Иначе
						//РазделительЯрусы = Объект.РазделительЯрусы;
						РазделительСтеллажи = Объект.РазделительСтеллажи
					КонецЕсли;      
					Пока ШагЯрусы <= МассивЯрусы.ВГраница() ИЛИ Объект.Ярусы = Ложь Цикл  
						
						ШагПозиции = 0;
						Если Объект.Ярусы = Ложь ИЛИ (Объект.Позиции = Ложь) Тогда 
							РазделительЯрусы = ""; 
							//РазделительПозиции = "";
						Иначе
							//РазделительПозиции = Объект.РазделительПозиции;  
							РазделительЯрусы = Объект.РазделительЯрусы;; 
						КонецЕсли;      
						Пока ШагПозиции <= МассивПозиции.ВГраница() ИЛИ Объект.Позиции = Ложь Цикл
							
							// ТУ_Августинович ++ 000056225 27.10.2025
							// - Вытаскиваем составные части наименования ячейки. (Необходимо для генератора тополгии)
							СоставНаименования = Новый Структура("Склад, Секция, Линия, Стеллаж, Ярус, Позиция, ВидСверху");
							
							ЧастьСклад		= ПолучитьФормат(МассивСклад[ШагСклад],			Объект.КоличествоЦифрСклад);
							ЧастьСекция		= ПолучитьФормат(МассивСекций[ШагСекции],		Объект.КоличествоЦифрСекции);
							ЧастьЛиния		= ПолучитьФормат(МассивЛиний[ШагЛинии],			Объект.КоличествоЦифрЛинии);
							ЧастьСтеллаж	= ПолучитьФормат(МассивСтеллажи[ШагСтеллажи],	Объект.КоличествоЦифрСтеллажи);
							ЧастьЯрус		= ПолучитьФормат(МассивЯрусы[ШагЯрусы],			Объект.КоличествоЦифрЯрусы);
							ЧастьПозиция	= ПолучитьФормат(МассивПозиции[ШагПозиции], 	Объект.КоличествоЦифрПозиции);
							ЧастьВидСверху	= " " + ЧастьСклад + РазделительСклад + ЧастьСекция + РазделительСекции + ЧастьЛиния + РазделительЛинии + ЧастьСтеллаж;
							
							СоставНаименования.Склад	 = ЧастьСклад;
							СоставНаименования.Секция	 = ЧастьСекция;
							СоставНаименования.Линия	 = ЧастьЛиния;
							СоставНаименования.Стеллаж	 = ЧастьСтеллаж;
							СоставНаименования.Ярус		 = ЧастьЯрус;
							СоставНаименования.Позиция	 = ЧастьПозиция;
							СоставНаименования.ВидСверху = ЧастьВидСверху;
							
							СоставныеНаименования.Добавить(СоставНаименования);
							СобратьВМассив.Добавить(" " 
													+ ЧастьСклад + РазделительСклад
													+ ЧастьСекция + РазделительСекции
													+ ЧастьЛиния + РазделительЛинии
													+ ЧастьСтеллаж + РазделительСтеллажи
													+ ЧастьЯрус + РазделительЯрусы
													+ ЧастьПозиция);
							//СобратьВМассив.Добавить(" " +  ПолучитьФормат(МассивСклад[ШагСклад], Объект.КоличествоЦифрСклад) + РазделительСклад + ПолучитьФормат(МассивСекций[ШагСекции], Объект.КоличествоЦифрСекции) + РазделительСекции + ПолучитьФормат(МассивЛиний[ШагЛинии],Объект.КоличествоЦифрЛинии) + РазделительЛинии + ПолучитьФормат(МассивСтеллажи[ШагСтеллажи], Объект.КоличествоЦифрСтеллажи) + РазделительСтеллажи + ПолучитьФормат(МассивЯрусы[ШагЯрусы],Объект.КоличествоЦифрЯрусы) + РазделительЯрусы + ПолучитьФормат(МассивПозиции[ШагПозиции], Объект.КоличествоЦифрПозиции));
							// ТУ_Августинович -- 27.10.2025
							
							Если Объект.Позиции = Ложь Тогда
								
								Прервать;
								
							КонецЕсли; 
							
							ШагПозиции = ШагПозиции + 1;
							
						КонецЦикла;
						
						Если Объект.Ярусы = Ложь Тогда
							Прервать;
						КонецЕсли; 
						ШагЯрусы = ШагЯрусы + 1;
						
					КонецЦикла;
					Если Объект.Стеллажи = Ложь Тогда
						Прервать;
					КонецЕсли;
					ШагСтеллажи = ШагСтеллажи + 1;
				КонецЦикла;
				Если Объект.Линии = Ложь Тогда
					Прервать;
				КонецЕсли;
				ШагЛинии = ШагЛинии + 1;
			КонецЦикла;   
			Если Объект.Секции = Ложь Тогда	
				Прервать;
			КонецЕсли; 
			ШагСекции = ШагСекции + 1;
		КонецЦикла;    
		Если Объект.Склад = Ложь Тогда
			Прервать;
		КонецЕсли;
		ШагСклад = ШагСклад + 1;
	КонецЦикла;
	
	ОбластьКоличества.Параметры.КоличествоЯчеек = СобратьВМассив.Количество();
	ТабДок.Вывести(ОбластьКоличества);
	//ТУ_Августинович ++ 12.05.2026
	// - Добавление шапки таблицы с наименованием колонок
	ТабДок.Вывести(ОбластьШапка);
	//ТУ_Августинович -- 12.05.2026
	Шаг = 0; 
	
	Пока Шаг <= СобратьВМассив.ВГраница() Цикл
		ОбластьЯчейки.Параметры.Ячейка = СобратьВМассив[Шаг];
		
		// ТУ_Августинович ++ 000056225 27.10.2025
		// - Передаем составные части наименования ячйки на макет
		ОбластьЯчейки.Параметры.Склад	  = СоставныеНаименования[Шаг].Склад;
		ОбластьЯчейки.Параметры.Ряд		  = СоставныеНаименования[Шаг].Секция;
		ОбластьЯчейки.Параметры.Стеллаж	  = СоставныеНаименования[Шаг].Стеллаж;
		ОбластьЯчейки.Параметры.Ярус	  = СоставныеНаименования[Шаг].Ярус;
		ОбластьЯчейки.Параметры.Позиция	  = СоставныеНаименования[Шаг].Позиция;
		ОбластьЯчейки.Параметры.ВидСверху = СоставныеНаименования[Шаг].ВидСверху;
		//ТУ_Августинович ++ 21.04.2026
		// - Добавлен общий объем для ячеек
		ОбластьЯчейки.Параметры.Объем	  = ОбщийОбъемЯчеек;
		//ТУ_Августинович -- 21.04.2026
		
		// ТУ_Августинович -- 27.10.2025
		
		ТабДок.Вывести(ОбластьЯчейки);
		Шаг = Шаг + 1;
	КонецЦикла;
	
	
	Возврат ТабДок;
КонецФункции 

&НаСервере
Функция ПолучитьПозиции()
	
	//       	МассивЗначений = Новый Массив;
	//
	//Если Объект.ТипНомераПозиции = Элементы.ТипНомераПозиции.СписокВыбора[0].Значение Тогда
	//	ДиапазонЧисел = Объект.ДиапазонЧиселОтПозиции;	
	//	Пока ДиапазонЧисел <= Объект.ДиапазонЧиселДоПозиции Цикл 
	//		Если ДиапазонЧисел = 0 Тогда
	//			ДиапазонЧисел = Формат(ДиапазонЧисел,"ЧН=0");
	//			МассивЗначений.Добавить(ДиапазонЧисел);
	//			ДиапазонЧисел = 0;
	//		Иначе
	//			
	//			МассивЗначений.Добавить(ДиапазонЧисел);
	//			
	//		КонецЕсли;
	//		ДиапазонЧисел = ДиапазонЧисел + 1;
	//	КонецЦикла;        
	//Иначе
	//	СимволБуквы = КодСимвола(Объект.ДиапазонБуквОтПозиции);
	//	Пока СимволБуквы <= КодСимвола(Объект.ДиапазонБуквДоПозиции) Цикл
	//		МассивЗначений.Добавить(Символ(СимволБуквы));
	//		СимволБуквы = СимволБуквы + 1;
	//	КонецЦикла;  
	//КонецЕсли;
	//
	//
	//Возврат МассивЗначений;  
	
	МассивЗначений = Новый Массив;
	
	Если Объект.ТипНомераПозиции = Элементы.ТипНомераПозиции.СписокВыбора[0].Значение Тогда
		ДиапазонЧисел = Объект.ДиапазонЧиселОтПозиции;	
		Пока ДиапазонЧисел <= Объект.ДиапазонЧиселДоПозиции Цикл 
			Если ДиапазонЧисел = 0 Тогда
				ДиапазонЧисел = Формат(ДиапазонЧисел,"ЧН=0");
				МассивЗначений.Добавить(ДиапазонЧисел);
				ДиапазонЧисел = 0;
			Иначе
				
				МассивЗначений.Добавить(ДиапазонЧисел);
				
			КонецЕсли;
			ДиапазонЧисел = ДиапазонЧисел + 1;
		КонецЦикла;        
	Иначе 
		// +++
		ДлинаПоиска = СтрДлина(Объект.ДиапазонБуквДоПозиции);
		Если ДлинаПоиска = 1 Тогда
			СимволБуквы = КодСимвола(Объект.ДиапазонБуквОтПозиции);
			Пока СимволБуквы <= КодСимвола(Объект.ДиапазонБуквДоПозиции) Цикл
				МассивЗначений.Добавить(Символ(СимволБуквы));
				СимволБуквы = СимволБуквы + 1;
			КонецЦикла;     
			
		ИначеЕсли  ДлинаПоиска = 2 Тогда
			СимволБуквы1 = КодСимвола(Объект.ДиапазонБуквОтПозиции,1);
			СимволБуквы2 = КодСимвола(Объект.ДиапазонБуквОтПозиции,2); 
			Пока СимволБуквы1 <= КодСимвола(Объект.ДиапазонБуквДоПозиции,1) Цикл
				СимволБуквы2 = КодСимвола(Объект.ДиапазонБуквОтПозиции,2);
				Пока СимволБуквы2 <= КодСимвола(Объект.ДиапазонБуквДоПозиции,2) Цикл
					МассивЗначений.Добавить(Символ(СимволБуквы1)+ Символ(СимволБуквы2));
					СимволБуквы2 = СимволБуквы2 + 1;
				КонецЦикла;  
				СимволБуквы1 = СимволБуквы1 + 1;
			КонецЦикла;
			
		Иначе 
			СимволБуквы1 = КодСимвола(Объект.ДиапазонБуквОтПозиции,1);
			СимволБуквы2 = КодСимвола(Объект.ДиапазонБуквОтПозиции,2);    
			СимволБуквы3 = ?(КодСимвола(Объект.ДиапазонБуквОтПозиции,3) = -1,КодСимвола(Объект.ДиапазонБуквДоПозиции,3),КодСимвола(Объект.ДиапазонБуквОтПозиции,3)); 
			Если СимволБуквы2 >= 48 И СимволБуквы2 <= 57 И  СимволБуквы3 >= 48 И СимволБуквы3 <= 57 Тогда
				ЧислоДо1  = КодСимвола(Объект.ДиапазонБуквДоПозиции,2);   
				ЧислоДо1 = Символ(ЧислоДо1);
				ЧислоДо2 =  КодСимвола(Объект.ДиапазонБуквДоПозиции,3);    
				ЧислоДо2 = Символ(ЧислоДо2);
				СимволЧислоДо = "" + ЧислоДо1 + ""+ ЧислоДо2;
				СимволЧислоДо = Число(СимволЧислоДо);   
				ЧислоОт1 = Символ(СимволБуквы2);     
				Проверка = КодСимвола(Объект.ДиапазонБуквОтПозиции,3);
				Если Проверка = -1 Тогда
					ЧислоОт2 = "";
				Иначе
					ЧислоОт2 = Символ(СимволБуквы3);
				КонецЕсли;
