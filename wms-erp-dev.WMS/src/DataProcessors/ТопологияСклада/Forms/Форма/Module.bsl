&НаКлиенте
Процедура ДиапазонБуквДоСекцииПриИзменении(Элемент)   
	
	ДлинаПоиска = СтрДлина(Объект.ДиапазонБуквДоСекции);   
	
	Если ДлинаПоиска = 1 Тогда
		
		СтруктураЗначений.СекцииДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСекции); 
	ИначеЕсли ДлинаПоиска = 2  Тогда       
		Если КодСимвола(Объект.ДиапазонБуквДоСекции, 2) = КодСимвола(Объект.ДиапазонБуквОтСекции, 2) Тогда
			
			СтруктураЗначений.СекцииДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСекции);
			СтруктураЗначений.СекцииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСекции);
		ИначеЕсли НЕ КодСимвола(Объект.ДиапазонБуквДоСекции, 2) = КодСимвола(Объект.ДиапазонБуквОтСекции, 2) И НЕ КодСимвола(Объект.ДиапазонБуквДоСекции, 1) = КодСимвола(Объект.ДиапазонБуквОтСекции, 1) Тогда
			КоличествоБуквВторогоСимвола = КодСимвола(Объект.ДиапазонБуквДоСекции, 1) - КодСимвола(Объект.ДиапазонБуквОтСекции, 1)  ;
			СтруктураЗначений.СекцииДиапазонЧиселДо = (КодСимвола(Объект.ДиапазонБуквДоСекции,2) +2)  * КоличествоБуквВторогоСимвола ;
			СтруктураЗначений.СекцииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСекции,2)  * КоличествоБуквВторогоСимвола ; 
			
		Иначе
			
			СтруктураЗначений.СекцииДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСекции, 2); 
			
		КонецЕсли;
		
	Иначе
		Если КодСимвола(Объект.ДиапазонБуквДоСекции, 2) = КодСимвола(Объект.ДиапазонБуквОтСекции, 2) И КодСимвола(Объект.ДиапазонБуквДоСекции, 3) = КодСимвола(Объект.ДиапазонБуквОтСекции, 3) Тогда
			Если КодСимвола(Объект.ДиапазонБуквДоСекции, 3) <= 48 ИЛИ  КодСимвола(Объект.ДиапазонБуквДоСекции, 3) >= 57 Тогда
				
				СтруктураЗначений.СекцииДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСекции,1);
				СтруктураЗначений.СекцииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСекции,1);
			Иначе
				СтруктураЗначений.СекцииДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСекции);
				
				
			КонецЕсли;
			
		ИначеЕсли КодСимвола(Объект.ДиапазонБуквДоСекции, 1) = КодСимвола(Объект.ДиапазонБуквОтСекции, 1) И КодСимвола(Объект.ДиапазонБуквДоСекции, 3) = КодСимвола(Объект.ДиапазонБуквОтСекции, 3) Тогда
			Если КодСимвола(Объект.ДиапазонБуквДоСекции, 3) >= 48 И КодСимвола(Объект.ДиапазонБуквДоСекции, 3) <= 57 Тогда
				
				Число1До = КодСимвола(Объект.ДиапазонБуквДоСекции,2);
				Число2До = КодСимвола(Объект.ДиапазонБуквДоСекции,3); 
				ОбщееЧисло = "" + Символ(Число1До) + "" + Символ(Число2До);
				ОбщееЧисло = Число(ОбщееЧисло);
				СтруктураЗначений.СекцииДиапазонЧиселДо = ОбщееЧисло; 
				Число1От = КодСимвола(Объект.ДиапазонБуквОтСекции,2);
				Число2От = КодСимвола(Объект.ДиапазонБуквОтСекции,3);
				ЧислоОт = "" + Символ(Число1От) + "" + Символ(Число2От);
				ЧислоОт = Число(ЧислоОт);
				СтруктураЗначений.СекцииДиапазонЧиселОт = ЧислоОт;
			Иначе
				
				СтруктураЗначений.СекцииДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСекции, 2);   
				//++++++++++++
				СтруктураЗначений.СекцииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСекции, 2);    
				//------------
			КонецЕсли;
			
		ИначеЕсли КодСимвола(Объект.ДиапазонБуквДоСекции, 1) = КодСимвола(Объект.ДиапазонБуквОтСекции, 1) И НЕ КодСимвола(Объект.ДиапазонБуквДоСекции, 2) = КодСимвола(Объект.ДиапазонБуквОтСекции, 2) Тогда
			Если КодСимвола(Объект.ДиапазонБуквОтСекции,3) = -1 Тогда
				Число1До = КодСимвола(Объект.ДиапазонБуквДоСекции,2);
				Число2До = КодСимвола(Объект.ДиапазонБуквДоСекции,3); 
				ОбщееЧисло = "" + Символ(Число1До) + "" + Символ(Число2До);
				ОбщееЧисло = Число(ОбщееЧисло);
				СтруктураЗначений.СекцииДиапазонЧиселДо = ОбщееЧисло; 
				ЧислоОт = КодСимвола(Объект.ДиапазонБуквОтСекции,2);
				ЧислоОт = Символ(ЧислоОт);
				ЧислоОт = Число(ЧислоОт);
				СтруктураЗначений.СекцииДиапазонЧиселОт = ЧислоОт; 
			ИначеЕсли КодСимвола(Объект.ДиапазонБуквОтСекции,3) >= 48 И КодСимвола(Объект.ДиапазонБуквОтСекции,3) <= 57 Тогда
				Число1До = КодСимвола(Объект.ДиапазонБуквДоСекции,2);
				Число2До = КодСимвола(Объект.ДиапазонБуквДоСекции,3); 
				ОбщееЧисло = "" + Символ(Число1До) + "" + Символ(Число2До);
				ОбщееЧисло = Число(ОбщееЧисло);
				СтруктураЗначений.СекцииДиапазонЧиселДо = ОбщееЧисло; 
				Число1От = КодСимвола(Объект.ДиапазонБуквОтСекции,2);
				Число2От = КодСимвола(Объект.ДиапазонБуквОтСекции,3);
				ЧислоОт = "" + Символ(Число1От) + "" + Символ(Число2От);
				ЧислоОт = Число(ЧислоОт);
				СтруктураЗначений.СекцииДиапазонЧиселОт = ЧислоОт;				   
				
			Иначе
				
				СтруктураЗначений.СекцииДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСекции,3);
				
				
			КонецЕсли;  
		ИначеЕсли КодСимвола(Объект.ДиапазонБуквДоСекции, 1) = КодСимвола(Объект.ДиапазонБуквОтСекции, 1) И  КодСимвола(Объект.ДиапазонБуквДоСекции, 2) = КодСимвола(Объект.ДиапазонБуквОтСекции, 2) Тогда 
			//СтруктураЗначений.СкладДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСклад,3);  
			Если  КодСимвола(Объект.ДиапазонБуквДоСекции, 3) <= 48 ИЛИ  КодСимвола(Объект.ДиапазонБуквДоСекции, 3) >= 57 Тогда
				
				СтруктураЗначений.СекцииДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСекции,3);
				
			Иначе
				Число1До = КодСимвола(Объект.ДиапазонБуквДоСекции,2);
				Число2До = КодСимвола(Объект.ДиапазонБуквДоСекции,3); 
				ОбщееЧисло = "" + Символ(Число1До) + "" + Символ(Число2До);
				ОбщееЧисло = Число(ОбщееЧисло);
				СтруктураЗначений.СекцииДиапазонЧиселДо = ОбщееЧисло; 
				Число1От = КодСимвола(Объект.ДиапазонБуквОтСекции,2);
				Число2От = КодСимвола(Объект.ДиапазонБуквОтСекции,3);
				ЧислоОт = "" + Символ(Число1От) + "" + Символ(Число2От);
				ЧислоОт = Число(ЧислоОт);
				СтруктураЗначений.СекцииДиапазонЧиселОт = ЧислоОт;
				
				
			КонецЕсли;
		ИначеЕсли НЕ КодСимвола(Объект.ДиапазонБуквДоСекции, 1) = КодСимвола(Объект.ДиапазонБуквОтСекции, 1) И  КодСимвола(Объект.ДиапазонБуквДоСекции, 2) = КодСимвола(Объект.ДиапазонБуквОтСекции, 2) Тогда
			КоличествоБуквВторогоСимвола = КодСимвола(Объект.ДиапазонБуквДоСекции, 1) - КодСимвола(Объект.ДиапазонБуквОтСекции, 1) + 1;
			СтруктураЗначений.СекцииДиапазонЧиселДо = (КодСимвола(Объект.ДиапазонБуквДоСекции,3) +1)  * КоличествоБуквВторогоСимвола - 1;
			СтруктураЗначений.СекцииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСекции,3)  * КоличествоБуквВторогоСимвола ;   
		ИначеЕсли КодСимвола(Объект.ДиапазонБуквДоСекции, 1) = КодСимвола(Объект.ДиапазонБуквОтСекции, 1) И НЕ КодСимвола(Объект.ДиапазонБуквДоСекции, 2) = КодСимвола(Объект.ДиапазонБуквОтСекции, 2) Тогда
			КоличествоБуквВторогоСимвола = КодСимвола(Объект.ДиапазонБуквДоСекции, 2) - КодСимвола(Объект.ДиапазонБуквОтСекции, 2) + 1;
			СтруктураЗначений.СекцииДиапазонЧиселДо = (КодСимвола(Объект.ДиапазонБуквДоСекции,3) +1)  * КоличествоБуквВторогоСимвола - 1;
			СтруктураЗначений.СекцииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСекции,3)  * КоличествоБуквВторогоСимвола ;
		ИначеЕсли НЕ КодСимвола(Объект.ДиапазонБуквДоСекции, 1) = КодСимвола(Объект.ДиапазонБуквОтСекции, 1) И НЕ КодСимвола(Объект.ДиапазонБуквДоСекции, 2) = КодСимвола(Объект.ДиапазонБуквОтСекции, 2) Тогда
			КоличествоБуквВторогоСимвола = КодСимвола(Объект.ДиапазонБуквДоСекции, 2) - КодСимвола(Объект.ДиапазонБуквОтСекции, 2) + 1; 
			КоличествоБуквПервогоСимвола = КодСимвола(Объект.ДиапазонБуквДоСекции, 1) - КодСимвола(Объект.ДиапазонБуквОтСекции, 1) + 1;
			СтруктураЗначений.СекцииДиапазонЧиселДо = (КодСимвола(Объект.ДиапазонБуквДоСекции,3) +1) * КоличествоБуквПервогоСимвола * КоличествоБуквВторогоСимвола  - 1;
			СтруктураЗначений.СекцииДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСекции,3) * КоличествоБуквПервогоСимвола  * КоличествоБуквВторогоСимвола ;
			
		КонецЕсли;
	КонецЕсли;
	
	//  ++++      
	
	//16.03+++
	Объект.КоличествоСекции = (СтруктураЗначений.СекцииДиапазонЧиселДо + 1) - СтруктураЗначений.СекцииДиапазонЧиселОт;
	//16.03----
	
	ОбщееКоличествоЯчеек();	
	
КонецПроцедуры

&НаКлиенте
Процедура ДиапазонБуквДоСкладПриИзменении(Элемент) 

	ДлинаПоиска = СтрДлина(Объект.ДиапазонБуквДоСклад);   
	
	Если ДлинаПоиска = 1 Тогда
		
		СтруктураЗначений.СкладДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСклад); 
	ИначеЕсли ДлинаПоиска = 2  Тогда       
		Если КодСимвола(Объект.ДиапазонБуквДоСклад, 2) = КодСимвола(Объект.ДиапазонБуквОтСклад, 2) Тогда
			СтруктураЗначений.СкладДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСклад); 
			СтруктураЗначений.СкладДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСклад);

		ИначеЕсли НЕ КодСимвола(Объект.ДиапазонБуквДоСклад, 2) = КодСимвола(Объект.ДиапазонБуквОтСклад, 2) И НЕ КодСимвола(Объект.ДиапазонБуквДоСклад, 1) = КодСимвола(Объект.ДиапазонБуквОтСклад, 1) Тогда
			КоличествоБуквВторогоСимвола = КодСимвола(Объект.ДиапазонБуквДоСклад, 1) - КодСимвола(Объект.ДиапазонБуквОтСклад, 1)  ;
			СтруктураЗначений.СкладДиапазонЧиселДо = (КодСимвола(Объект.ДиапазонБуквДоСклад,2) +2)  * КоличествоБуквВторогоСимвола ;
			СтруктураЗначений.СкладДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСклад,2)  * КоличествоБуквВторогоСимвола ; 
			
		Иначе
			
			СтруктураЗначений.СкладДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСклад, 2); 
			
		КонецЕсли;
		
	Иначе
		Если КодСимвола(Объект.ДиапазонБуквДоСклад, 2) = КодСимвола(Объект.ДиапазонБуквОтСклад, 2) И КодСимвола(Объект.ДиапазонБуквДоСклад, 3) = КодСимвола(Объект.ДиапазонБуквОтСклад, 3) Тогда
			Если КодСимвола(Объект.ДиапазонБуквДоСклад, 3) <= 48 ИЛИ  КодСимвола(Объект.ДиапазонБуквДоСклад, 3) >= 57 Тогда
				
				СтруктураЗначений.СкладДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСклад,1);  
				//      +++++++++++++++++++++
				СтруктураЗначений.СкладДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСклад,1); 
				//   ---------------------
			Иначе
				СтруктураЗначений.СкладДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСклад);
				
				
			КонецЕсли;
			
		ИначеЕсли КодСимвола(Объект.ДиапазонБуквДоСклад, 1) = КодСимвола(Объект.ДиапазонБуквОтСклад, 1) И КодСимвола(Объект.ДиапазонБуквДоСклад, 3) = КодСимвола(Объект.ДиапазонБуквОтСклад, 3) Тогда
			Если КодСимвола(Объект.ДиапазонБуквДоСклад, 3) >= 48 И КодСимвола(Объект.ДиапазонБуквДоСклад, 3) <= 57 Тогда
				
				Число1До = КодСимвола(Объект.ДиапазонБуквДоСклад,2);
				Число2До = КодСимвола(Объект.ДиапазонБуквДоСклад,3); 
				ОбщееЧисло = "" + Символ(Число1До) + "" + Символ(Число2До);
				ОбщееЧисло = Число(ОбщееЧисло);
				СтруктураЗначений.СкладДиапазонЧиселДо = ОбщееЧисло; 
				Число1От = КодСимвола(Объект.ДиапазонБуквОтСклад,2);
				Число2От = КодСимвола(Объект.ДиапазонБуквОтСклад,3);
				ЧислоОт = "" + Символ(Число1От) + "" + Символ(Число2От);
