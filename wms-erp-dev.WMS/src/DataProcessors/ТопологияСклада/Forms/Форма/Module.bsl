	СтруктураЗначений.Вставить("СкладДиапазонЧиселДо", 0); 
	СтруктураЗначений.Вставить("СекцииДиапазонЧиселОт", 0);
	СтруктураЗначений.Вставить("СекцииДиапазонЧиселДо", 0); 
	СтруктураЗначений.Вставить("ЛинииДиапазонЧиселОт", 0);
	СтруктураЗначений.Вставить("ЛинииДиапазонЧиселДо", 0); 
	СтруктураЗначений.Вставить("СтеллажиДиапазонЧиселОт", 0);  
