							НовыйСимвол = "" + Число1 + "" + Число2;
							НовыйСимвол = Число(НовыйСимвол) - 1;    
							Объект.ДиапазонБуквДоПозиции = ПервыеБуквы + НовыйСимвол; 
							СтруктураЗначений.ПозицииДиапазонЧиселДо = СтруктураЗначений.ПозицииДиапазонЧиселДо - 1;
							ОбщееКоличествоЯчеек(); 
						Иначе
							НовыйСимвол =  Число2; 
							Если Число(НовыйСимвол) = 0 Тогда
								НовыйСимвол = Число(НовыйСимвол);
							Иначе
								НовыйСимвол = Число(НовыйСимвол) - 1;
								СтруктураЗначений.ПозицииДиапазонЧиселДо = СтруктураЗначений.ПозицииДиапазонЧиселДо - 1;
							КонецЕсли;
							Объект.ДиапазонБуквДоПозиции = ПервыеБуквы + НовыйСимвол; 
							ОбщееКоличествоЯчеек(); 						
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Иначе   
				Если ТекущийСимвол = ОтА Тогда
					ТекущийСимвол = ТекущийСимвол;
				Иначе
					ТекущийСимвол = ТекущийСимвол - 1;
				КонецЕсли;
				НовыйСимвол = Символ(ТекущийСимвол);
				Объект.ДиапазонБуквДоПозиции = ПервыеБуквы + НовыйСимвол; 
				СтруктураЗначений.ПозицииДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоПозиции, НомерСимвола);				   
				
				ОбщееКоличествоЯчеек();  
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	//16.03+++	
	Объект.КоличествоПозиции = (СтруктураЗначений.ПозицииДиапазонЧиселДо + 1) - СтруктураЗначений.ПозицииДиапазонЧиселОт;
