				КонецЦикла;  
				СимволБуквы1 = СимволБуквы1 + 1;
			КонецЦикла;
			
		Иначе 
			СимволБуквы1 = КодСимвола(Объект.ДиапазонБуквОтСклад,1);
			СимволБуквы2 = КодСимвола(Объект.ДиапазонБуквОтСклад,2);    
			СимволБуквы3 = ?(КодСимвола(Объект.ДиапазонБуквОтСклад,3) = -1,КодСимвола(Объект.ДиапазонБуквДоСклад,3),КодСимвола(Объект.ДиапазонБуквОтСклад,3)); 
			Если СимволБуквы2 >= 48 И СимволБуквы2 <= 57 И  СимволБуквы3 >= 48 И СимволБуквы3 <= 57 Тогда
				ЧислоДо1  = КодСимвола(Объект.ДиапазонБуквДоСклад,2);   
				ЧислоДо1 = Символ(ЧислоДо1);
				ЧислоДо2 =  КодСимвола(Объект.ДиапазонБуквДоСклад,3);    
