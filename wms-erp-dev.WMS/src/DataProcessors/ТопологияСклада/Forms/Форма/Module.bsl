&НаКлиенте
Процедура ПостроитьПример()  
	Объект.Пример = "";
	Если Объект.ТипНомераСклад = "Числовой" И Объект.Склад Тогда
		СтруктураЗначений.Склад =  Объект.ДиапазонЧиселОтСклад; 
		СтруктураЗначений.СкладРазделитель = Объект.РазделительСклад;
	ИначеЕсли Объект.Склад Тогда
		СтруктураЗначений.Склад =  Объект.ДиапазонБуквОтСклад; 
		СтруктураЗначений.СкладРазделитель = Объект.РазделительСклад;
	КонецЕсли;
	
	Если Объект.ТипНомераСекции = "Числовой" И Объект.Секции Тогда
		СтруктураЗначений.Секции =  Объект.ДиапазонЧиселОтСекции;  
		СтруктураЗначений.СекцииРазделитель = Объект.РазделительСекции;
		
	ИначеЕсли Объект.Секции Тогда
		СтруктураЗначений.Секции = Объект.ДиапазонБуквОтСекции; 
		СтруктураЗначений.СекцииРазделитель = Объект.РазделительСекции;
		
	КонецЕсли;  
	
	Если Объект.ТипНомераЛинии = "Числовой" И Объект.Линии Тогда
		СтруктураЗначений.Линии =  Объект.ДиапазонЧиселОтЛинии;
		СтруктураЗначений.ЛинииРазделитель = Объект.РазделительЛинии;
		
	ИначеЕсли Объект.Линии Тогда
		СтруктураЗначений.Линии = Объект.ДиапазонБуквОтЛинии; 
		СтруктураЗначений.ЛинииРазделитель = Объект.РазделительЛинии;
	КонецЕсли;       
	
	Если Объект.ТипНомераСтеллажи = "Числовой" И Объект.Стеллажи Тогда
		СтруктураЗначений.Стеллажи =  Объект.ДиапазонЧиселОтСтеллажи;
		СтруктураЗначений.СтеллажиРазделитель = Объект.РазделительСтеллажи;
		
	ИначеЕсли Объект.Стеллажи Тогда
		СтруктураЗначений.Стеллажи = Объект.ДиапазонБуквОтСтеллажи; 
		СтруктураЗначений.СтеллажиРазделитель = Объект.РазделительСтеллажи;
	КонецЕсли; 
	
	Если Объект.ТипНомераЯрусы = "Числовой" И Объект.Ярусы Тогда
		СтруктураЗначений.Ярусы =  Объект.ДиапазонЧиселОтЯрусы;
		СтруктураЗначений.ЯрусыРазделитель = Объект.РазделительЯрусы;
		
	ИначеЕсли Объект.Ярусы Тогда
		СтруктураЗначений.Ярусы= Объект.ДиапазонБуквОтЯрусы; 
		СтруктураЗначений.ЯрусыРазделитель = Объект.РазделительЯрусы;
	КонецЕсли; 
	
	Если Объект.ТипНомераПозиции = "Числовой" И Объект.Позиции Тогда
		СтруктураЗначений.Позиции =  Объект.ДиапазонЧиселОтПозиции;
		СтруктураЗначений.ПозицииРазделитель = Объект.РазделительПозиции;
		
	ИначеЕсли Объект.Позиции Тогда
		СтруктураЗначений.Позиции = Объект.ДиапазонБуквОтПозиции; 
		СтруктураЗначений.ПозицииРазделитель = Объект.РазделительПозиции;
	КонецЕсли;
	
	
	
	
	
	
	СтрПримера = "";         
	Если Объект.Склад И (Объект.Секции ИЛИ Объект.Линии ИЛИ Объект.Стеллажи ИЛИ Объект.Ярусы ИЛИ Объект.Позиции)  Тогда
		
		СтруктураЗначений.СкладРазделитель = Объект.РазделительСклад;
		
	ИначеЕсли Объект.Склад = Ложь Тогда 
		СтруктураЗначений.Склад = Неопределено;  
		СтруктураЗначений.СкладРазделитель = "";  
		
	Иначе
		
		
		СтруктураЗначений.СкладРазделитель = "";  
		
		
	КонецЕсли;  
	
	Если Объект.Секции И (Объект.Линии ИЛИ Объект.Стеллажи ИЛИ Объект.Ярусы ИЛИ Объект.Позиции)  Тогда
		
		СтруктураЗначений.СекцииРазделитель = Объект.РазделительСекции;
		
	ИначеЕсли Объект.Секции = Ложь Тогда
		
		СтруктураЗначений.Секции = Неопределено; 
		СтруктураЗначений.СекцииРазделитель = ""; 
	Иначе
		
		
		СтруктураЗначений.СекцииРазделитель = "";  
		
	КонецЕсли;
	Если Объект.Линии И (Объект.Стеллажи ИЛИ Объект.Ярусы ИЛИ Объект.Позиции)  Тогда
		
		СтруктураЗначений.ЛинииРазделитель = Объект.РазделительЛинии;
		
	ИначеЕсли Объект.Линии = Ложь Тогда
		СтруктураЗначений.Линии = Неопределено; 
		СтруктураЗначений.ЛинииРазделитель = "";   
	Иначе
		СтруктураЗначений.ЛинииРазделитель = "";   
		
		
	КонецЕсли;
	Если Объект.Стеллажи И (Объект.Ярусы ИЛИ Объект.Позиции)  Тогда
		
		СтруктураЗначений.СтеллажиРазделитель = Объект.РазделительСтеллажи;
		
	ИначеЕсли Объект.Стеллажи = Ложь Тогда
		
		СтруктураЗначений.СтеллажиРазделитель = ""; 
		СтруктураЗначений.Стеллажи = Неопределено;  
	Иначе
		СтруктураЗначений.СтеллажиРазделитель = ""; 
		
		
	КонецЕсли;
	Если Объект.Ярусы И (Объект.Позиции)  Тогда
		
		СтруктураЗначений.ЯрусыРазделитель = Объект.РазделительЯрусы;
		
	ИначеЕсли Объект.Ярусы = Ложь Тогда
		СтруктураЗначений.ЯрусыРазделитель = ""; 
		СтруктураЗначений.Ярусы = Неопределено;  
	Иначе
		СтруктураЗначений.ЯрусыРазделитель = ""; 
		
		
	КонецЕсли; 
	Если Объект.Позиции = Ложь Тогда
		СтруктураЗначений.Позиции = Неопределено; 
		
		
	КонецЕсли;
	СтрПримера = "" + ПолучитьФормат(СтруктураЗначений.Склад, Объект.КоличествоЦифрСклад) + СтруктураЗначений.СкладРазделитель + ПолучитьФормат(СтруктураЗначений.Секции, Объект.КоличествоЦифрСекции) + СтруктураЗначений.СекцииРазделитель + ПолучитьФормат(СтруктураЗначений.Линии, Объект.КоличествоЦифрЛинии) + СтруктураЗначений.ЛинииРазделитель + ПолучитьФормат(СтруктураЗначений.Стеллажи, Объект.КоличествоЦифрСтеллажи) + СтруктураЗначений.СтеллажиРазделитель + ПолучитьФормат(СтруктураЗначений.Ярусы, Объект.КоличествоЦифрЯрусы) + СтруктураЗначений.ЯрусыРазделитель + ПолучитьФормат(СтруктураЗначений.Позиции, Объект.КоличествоЦифрПозиции);
	СтрПримера = СокрЛП(СтрПримера);
	
	
	
	Объект.Пример = СтрПримера;     
	//СтрПримера = "" + ПолучитьФормат(СтруктураЗначений.Склад, Объект.КоличествоЦифрСклад) + СтруктураЗначений.СкладРазделитель + СтруктураЗначений.Секции + СтруктураЗначений.СекцииРазделитель + СтруктураЗначений.Линии + СтруктураЗначений.ЛинииРазделитель + СтруктураЗначений.Стеллажи + СтруктураЗначений.СтеллажиРазделитель + СтруктураЗначений.Ярусы + СтруктураЗначений.ЯрусыРазделитель + СтруктураЗначений.Позиции;
	
	//ПолучитьФормат(СтруктураЗначений.Склад, Объект.КоличествоЦифрСклад)
КонецПроцедуры     

&НаКлиенте
Процедура ДиапазонЧиселОтСкладПриИзменении(Элемент)
	ПостроитьПример();
	СтруктураЗначений.СкладДиапазонЧиселОт = Объект.ДиапазонЧиселОтСклад; 
	ОбщееКоличествоЯчеек();
	
	Объект.КоличествоСклад = (Объект.ДиапазонЧиселДоСклад +1) - Объект.ДиапазонЧиселОтСклад;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ДиапазонБуквОтСкладПриИзменении(Элемент)
	//ПостроитьПример();  
	//            
	ДлинаПоиска = СтрДлина(Объект.ДиапазонБуквОтСклад);  
	
	Если ДлинаПоиска = 1 Тогда
		СтруктураЗначений.СкладДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСклад); 
		Объект.ДиапазонБуквДоСклад = Объект.ДиапазонБуквОтСклад;  
		СтруктураЗначений.СкладДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСклад);   
		
	ИначеЕсли ДлинаПоиска = 2 Тогда
		
		СтруктураЗначений.СкладДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСклад, 2); 
		Объект.ДиапазонБуквДоСклад = Объект.ДиапазонБуквОтСклад;  
		СтруктураЗначений.СкладДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСклад,2);
	Иначе
		СтруктураЗначений.СкладДиапазонЧиселОт = КодСимвола(Объект.ДиапазонБуквОтСклад, 3); 
		Объект.ДиапазонБуквДоСклад = Объект.ДиапазонБуквОтСклад;  
		СтруктураЗначений.СкладДиапазонЧиселДо = КодСимвола(Объект.ДиапазонБуквДоСклад,3);		
		
		
		
	КонецЕсли; 
	ПостроитьПример(); 
	//16.03++++++
	Объект.КоличествоСклад = (СтруктураЗначений.СкладДиапазонЧиселДо + 1) - СтруктураЗначений.СкладДиапазонЧиселОт;
	//16.03-----
	ОбщееКоличествоЯчеек();	
	
КонецПроцедуры

&НаКлиенте
Процедура ДиапазонЧиселОтСекцииПриИзменении(Элемент)
	ПостроитьПример(); 
	СтруктураЗначений.СекцииДиапазонЧиселОт = Объект.ДиапазонЧиселОтСекции;
	ОбщееКоличествоЯчеек(); 
	Объект.КоличествоСекции= (Объект.ДиапазонЧиселДоСекции +1) - Объект.ДиапазонЧиселОтСекции;
КонецПроцедуры

