	СтруктураЗначений.Вставить("ЯрусыДиапазонЧиселОт", 0);
	СтруктураЗначений.Вставить("ЯрусыДиапазонЧиселДо", 0); 
	СтруктураЗначений.Вставить("ПозицииДиапазонЧиселОт", 0);
	СтруктураЗначений.Вставить("ПозицииДиапазонЧиселДо", 0);
	
	
	
	
	
КонецПроцедуры   

&НаКлиенте
Функция ОбщееКоличествоЯчеек()
	
	РазностьСклад = СтруктураЗначений.СкладДиапазонЧиселДо - СтруктураЗначений.СкладДиапазонЧиселОт; 
	РазностьСекции =  СтруктураЗначений.СекцииДиапазонЧиселДо - СтруктураЗначений.СекцииДиапазонЧиселОт; 
	РазностьЛинии =  СтруктураЗначений.ЛинииДиапазонЧиселДо - СтруктураЗначений.ЛинииДиапазонЧиселОт;
	РазностьСтеллажи =  СтруктураЗначений.СтеллажиДиапазонЧиселДо - СтруктураЗначений.СтеллажиДиапазонЧиселОт;
	РазностьЯрусы =  СтруктураЗначений.ЯрусыДиапазонЧиселДо - СтруктураЗначений.ЯрусыДиапазонЧиселОт;
	РазностьПозиции =  СтруктураЗначений.ПозицииДиапазонЧиселДо - СтруктураЗначений.ПозицииДиапазонЧиселОт;   
	
	Если РазностьСклад = 0 И Объект.Склад И (НЕ Объект.ДиапазонЧиселОтСклад = Объект.ДиапазонЧиселДоСклад ИЛИ  НЕ Объект.ДиапазонБуквОтСклад = Объект.ДиапазонБуквДоСклад)  Тогда	
		РазностьСклад = 1;
	КонецЕсли;  
	Если РазностьСекции = 0 И Объект.Секции И (НЕ Объект.ДиапазонЧиселОтСекции = Объект.ДиапазонЧиселДоСекции ИЛИ  НЕ Объект.ДиапазонБуквОтСекции = Объект.ДиапазонБуквДоСекции)  Тогда	
		РазностьСекции = 1;
	КонецЕсли;
	
	Если РазностьЛинии = 0 И Объект.Линии И (НЕ Объект.ДиапазонЧиселОтЛинии = Объект.ДиапазонЧиселДоЛинии ИЛИ  НЕ Объект.ДиапазонБуквОтЛинии = Объект.ДиапазонБуквДоЛинии) Тогда	
		РазностьЛинии = 1;
	КонецЕсли;
	Если РазностьСтеллажи = 0 И Объект.Стеллажи И (НЕ Объект.ДиапазонЧиселОтСтеллажи = Объект.ДиапазонЧиселДоСтеллажи ИЛИ  НЕ Объект.ДиапазонБуквОтСтеллажи = Объект.ДиапазонБуквДоСтеллажи) Тогда	
		РазностьСтеллажи = 1;
	КонецЕсли;
	Если РазностьЯрусы = 0 И Объект.Ярусы И (НЕ Объект.ДиапазонЧиселОтЯрусы = Объект.ДиапазонЧиселДоЯрусы ИЛИ  НЕ Объект.ДиапазонБуквОтЯрусы = Объект.ДиапазонБуквДоЯрусы) Тогда	
		РазностьЯрусы = 1;
	КонецЕсли;
	Если РазностьПозиции = 0 И Объект.Позиции И (НЕ Объект.ДиапазонЧиселОтПозиции = Объект.ДиапазонЧиселДоПозиции ИЛИ  НЕ Объект.ДиапазонБуквОтПозиции = Объект.ДиапазонБуквДоПозиции) Тогда	
		РазностьПозиции = 1;
	КонецЕсли;  
	
	
	
