		ИначеЕсли НЕ КодСимвола(Объект.ДиапазонБуквДоЛинии, 1) = КодСимвола(Объект.ДиапазонБуквОтЛинии, 1) И НЕ КодСимвола(Объект.ДиапазонБуквДоЛинии, 2) = КодСимвола(Объект.ДиапазонБуквОтЛинии, 2) Тогда
