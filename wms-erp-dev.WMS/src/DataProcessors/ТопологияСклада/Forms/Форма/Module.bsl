Функция ПолучитьФормат(Значение, КоличествоЦифрКолонка)
	Если КоличествоЦифрКолонка Тогда
		ЗначениеНулей = КоличествоЦифрКолонка;
	Иначе
		ЗначениеНулей = СтрДлина(Значение);
	КонецЕсли;      
	
	ФорматЧисла = Формат(Значение,"ЧЦ="+ ЗначениеНулей+"; ЧВН=; ЧГ=0");  
	Если Значение = 0 ИЛИ Значение = "0" Тогда
		Если ЗначениеНулей = 1 Тогда
			
			Возврат 0;
		ИначеЕсли ЗначениеНулей = 2 Тогда
			Возврат "" + 0 +""+0;
		ИначеЕсли ЗначениеНулей = 3 Тогда
			Возврат ""+0+""+0+""+0; 
		Иначе
			Возврат ""+0+""+0+""+0+""+0; 
		КонецЕсли;
	Иначе
		
		Возврат ФорматЧисла;
		
		
	КонецЕсли;
	
	
