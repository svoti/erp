Функция ОбработчикЭтапаВводаДанных_ПодобратьИнструкциюДляДанныхВвода(Параметры, ДополнительныеПараметры) Экспорт

	СписокВходящихПолейМассив = РК.ВыгрузитьЗначенияКолонкиКоллекции(ДанныеТранзакции.ВходящиеДанные.ДанныеПолей, "Ключ");
	СписокОсновныхПолейВводаМассив = СписокПолейМодуля(Новый Структура("Ввод, Ресурс", Истина, Ложь));
	СписокВходящихОсновныхПолейВводаМассив = РК.ПересечениеМассивов(СписокВходящихПолейМассив, СписокОсновныхПолейВводаМассив);
	Если СписокВходящихОсновныхПолейВводаМассив.Количество()=0 Тогда
		//основные поля не менялись, оставим предыдущую инструкцию
		Возврат Истина;
	КонецЕсли;
	
	Если ПодобратьИнструкциюДляДанныхВвода() Тогда
		ИдентификаторИнструкции = ПолучитьЗначениеДанныхПоляМодуля("ИдентификаторИнструкцииДляПоиска");
		УстановитьПоляОбработкиДляИнструкцииЗадания(ИдентификаторИнструкции);
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

//очистить ранее введенное поле для отображения подсказки при переходе к другой строке задания
Функция ОбработчикЭтапаВводаДанных_ОчиститьПоляВводаПриИзмененииИнструкции(Параметры, ДополнительныеПараметры) Экспорт

	ИдентификаторИнструкцииДляПоиска = ДанныеМодуля.СтатическиеДанныеПолей.ИдентификаторИнструкцииДляПоиска;
	ИдентификаторИнструкцииДляПоискаНовый = ДанныеТранзакции.СтатическиеДанныеПолей.ИдентификаторИнструкцииДляПоиска;
	
	Если ИдентификаторИнструкцииДляПоиска=ИдентификаторИнструкцииДляПоискаНовый Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВходящиеДанные = ДанныеТранзакции.ВходящиеДанные;
	Если ВходящиеДанные.Свойство("ВводСоставаКонтейнера") И ВходящиеДанные.ВводСоставаКонтейнера Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПринятыеДанныеПолей = ДанныеТранзакции.ПринятыеДанныеПолей;
	ВведенныеДанныеПолей = ДанныеТранзакции.ВведенныеДанныеПолей;
	ОбщиеДанныеПолей = ДанныеТранзакции.ОбщиеДанныеПолей;
	
	ЗаполненныеПоляВвода = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.ЗаполненныеПоляМассив;

	ЗапланированныеДанныеПолей = Новый Структура;
	Для Каждого ИмяПоля Из ЗаполненныеПоляВвода Цикл
		ЗапланированныеДанныеПолей.Вставить(ИмяПоля);
	КонецЦикла;

	Инструкция = ПолучитьИнструкциюПоИдентификатору(ИдентификаторИнструкцииДляПоискаНовый);
	Если Инструкция <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЗапланированныеДанныеПолей, Инструкция);
	КонецЕсли;
	
	ПоляДляОчистки = Новый Массив;
	
	Для Каждого ИмяПоляВвода Из ЗаполненныеПоляВвода Цикл
		Если ПринятыеДанныеПолей.Свойство(ИмяПоляВвода) Тогда
			//не очищать поля введенные только что
			Продолжить;
		КонецЕсли;
		
		Если ЗапланированныеДанныеПолей[ИмяПоляВвода]=Неопределено Тогда
			// нет в плане и в подсказке
			Продолжить;
		КонецЕсли;
		
		Если ВведенныеДанныеПолей[ИмяПоляВвода]=ЗапланированныеДанныеПолей[ИмяПоляВвода] Тогда
			Продолжить;
		КонецЕсли;
		
		ПоляДляОчистки.Добавить(ИмяПоляВвода);
	КонецЦикла;
	
	Если ПоляДляОчистки.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Интерфейс.ОчиститьДанныеПолей(ПоляДляОчистки, "ВведенныеДанныеПолей");
	Возврат Истина;
	
КонецФункции

Функция ПолучитьИнструкциюПоИдентификатору(Идентификатор)
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		ИнструкцияМассив = ДанныеОбработки.Таблицы.ТаблицаПланФакт.НайтиСтроки(Новый Структура("ИдентификаторИнструкцииДляПоиска", Идентификатор));
		Если ИнструкцияМассив.Количество() > 0 Тогда
			Возврат ИнструкцияМассив[0];
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ПроверкаВводаКонтейнераЦеликом(Параметры, ДополнительныеПараметры) Экспорт
	
	Перем Контейнер;
	
	Если НЕ (ДанныеТранзакции.ПринятыеДанныеПолей.Свойство("Контейнер", Контейнер) И ЗначениеЗаполнено(Контейнер)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПолеМодуля(Новый Структура("Имя, Ввод", "Товар", Истина))=ПустоеПолеОбработки Тогда
		// ввод контейнера целиком, без пересчета
		Возврат Ложь;
	КонецЕсли;

	ВходящиеДанные = ДанныеТранзакции.ВходящиеДанные;
	Если ВходящиеДанные.Свойство("ВводСоставаКонтейнера") И ВходящиеДанные.ВводСоставаКонтейнера=Истина Тогда
		// вводится состав контейнера
		Возврат Истина;
	КонецЕсли;
	
	Интерфейс.ОстановитьВводДанных();
	
	ОО = НовыйОписаниеОповещения("ОбработчикОтветаВводКонтейнераЦеликом", , Новый Структура("Контейнер", Контейнер));
	ПоказатьДиалогНаКлиенте(ОО, "Ввести контейнер целиком?", "ДаНетОтмена");
	
КонецФункции

Функция ОбработчикОтветаВводКонтейнераЦеликом(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ="Да" Тогда
		
		Интерфейс.ОтменитьВводДанных();
		
		ТаблицаСоставКонтейнера = ПолучитьСоставКонтейнера(ДополнительныеПараметры.Контейнер);
		ВвестиСоставКонтейнера(ТаблицаСоставКонтейнера);
		
	ИначеЕсли Ответ="Нет" Тогда
		
		Интерфейс.ВозобновитьВводДанных();
		
	Иначе
		
		Интерфейс.ОтменитьВводДанных();
		
	КонецЕсли;
	
КонецФункции

