Функция ОбработчикНачалоВыбораСерии(Параметры, ДополнительныеПараметры) Экспорт

	ОбщиеДанныеПолей = ДанныеМодуля.ОбщиеДанныеПолей;
	
	ПолеСерия = ПолеМодуля("Серия");
	Если НЕ (ПолеСерия <> Неопределено И ПолеСерия.Ввод) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеТовара = Новый Структура;
	Для Каждого ТоварноеПоле Из ПоляМодуля(Новый Структура("Группа", "Товар")) Цикл
		ДанныеТовара.Вставить(ТоварноеПоле.Имя, ОбщиеДанныеПолей[ТоварноеПоле.Имя]);
	КонецЦикла;
	
	ПараметрыИнициализации = Новый Структура;
	ПараметрыИнициализации.Вставить("НастройкаОператора", ПараметрыОбработки.НастройкаОператора);
	ПараметрыИнициализации.Вставить("Склад", ПараметрыОбработки.Склад);
	ПараметрыИнициализации.Вставить("ДанныеТовара", ДанныеТовара);
	ПараметрыИнициализации.Вставить("СоздаватьНовуюСерию", ПараметрыМодуля.СоздаватьНовуюСерию);
	//ПараметрыИнициализации.Вставить("ТаблицаОстатков", ПолучитьТаблицуОстатковСерий(ДанныеТовара));
	вмс_СерверУправляемыеОбработки.СоздатьОбработку("Обработка.вмс_СерверУправляемыйМодульВводСерии", ПараметрыИнициализации, ПараметрыОбработки.Идентификатор, НовыйОписаниеОповещения("ПриЗакрытииФормыСерии"));

	СтандартныйМодуль.ЗаморозитьТаймеры();
	
	Возврат Истина;

КонецФункции

Функция ПолучитьТаблицуОстатковСерий(ДанныеТовара)
	
	ЗаданиеКладовщику = ПараметрыОбработки.СсылкаНаЗадание.ПолучитьОбъект();
	ЗаданиеКладовщику.Товары.Очистить();
	
	Если ДанныеТовара.Свойство("Номенклатура") Тогда
		Номенклатура = ДанныеТовара.Номенклатура;
	Иначе
		Номенклатура = ДанныеТовара.Товар;
	КонецЕсли;
	
	СтрокаТовара = ЗаданиеКладовщику.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТовара, ДанныеТовара);
	СтрокаТовара.Номенклатура = Номенклатура;
	СтрокаТовара.Серия = Справочники.вмс_СерииНоменклатуры.ПустаяСсылка();
	СтрокаТовара.Количество = 1;

	ПараметрыЗаполнения = Документы.вмс_ЗаданиеКладовщику.НовыеПараметрыЗаполненияЯчеек(ЗаданиеКладовщику);
	
	ТаблицаОстатков = вмс_ОтборСервер.ПодобратьЯчейкиОтправители(ПараметрыЗаполнения);
	ТаблицаОстатков.Колонки.СвободныйОстаток.Имя = "Остаток";
	ТаблицаОстатков.Свернуть("Серия, Ячейка", "Остаток");
	
	Возврат ТаблицаОстатков;
	
КонецФункции

Функция ПриЗакрытииФормыСерии(ВходящиеДанные, ДополнительныеПараметры) Экспорт

	СтандартныйМодуль.РазморозитьТаймеры();

	Если ВходящиеДанные <> Неопределено Тогда
		
		ВвестиДанные(ВходящиеДанные);
		
	КонецЕсли;
	
КонецФункции

Функция ОбработчикНачалоВыбораКонтейнераПриемника(Параметры, ДополнительныеПараметры) Экспорт

	ОО = НовыйОписаниеОповещения("ОбработчикЗакрытияФормыГенерацииКонтейнеров");
	вмс_СерверУправляемыеОбработки.СоздатьОбработку("Обработка.вмс_СерверУправляемыйМодульГенерацияКонтейнеров", , ПараметрыОбработки.Идентификатор, ОО);

	СтандартныйМодуль.ЗаморозитьТаймеры();
	
КонецФункции

Функция ОбработчикЗакрытияФормыГенерацииКонтейнеров(Результат, ДополнительныеПараметры) Экспорт
	
	СтандартныйМодуль.РазморозитьТаймеры();
	
