	ПараметрыМодуля.ИдентификаторИнструкцииПолейОбработки = СостояниеМодуля.ИдентификаторИнструкцииПолейОбработки;
	
КонецФункции

Функция ВыполнитьЗавершениеОперации() Экспорт
	
	Если ПараметрыОбработки.Инвентаризация Тогда
		ВыполнитьЗавершениеИнвентаризации();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ВыполнитьЗавершениеИнвентаризации()

	ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;

	ДанныеОбновленияТаблицыПланФакт = ПараметрыТаблицы("ТаблицаПланФакт");
	ДанныеОбновленияТаблицыПланФакт.Ресурсы.Вставить("КоличествоУчет", 0);
	
	ДанныеФакта = ПолучитьТаблицуФакт(Истина, Истина);
	ЗаполнитьТаблицуПланФакт(ДанныеФакта);
	
	ОперацияПоЯчейкам = ПолучитьДокументОперацииПоЯчейкам();
	ТаблицаДокумента = ОперацияПоЯчейкам[ПараметрыОбработки.ИмяТаблицыФакта];
	Для Каждого ЭлементПланФакт Из ТаблицаПланФакт Цикл
		Если ЭлементПланФакт.КоличествоФактЗаполнено Тогда
			Продолжить;
		КонецЕсли;
		
		//дополним нулевым фактом невведенные элементы
		СтрокаДокумента = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ЭлементПланФакт);
		СтрокаДокумента.Количество = 0;
		СтрокаДокумента.КоличествоБазовыхЕдиниц = 0;
	КонецЦикла;
	
	ЗаписатьДокументОперацииПоЯчейкам(ОперацияПоЯчейкам);
	
КонецФункции

