Функция ОбновитьДанныеТранзакцииОбработки() Экспорт
	
	Если НЕ СборщикДанныхСтандартный.ОбновитьДанныеТранзакцииОбработки() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбновитьСвойстваПолейТранзакцииОбработки();
	
	Возврат Истина;
	
КонецФункции

Функция ОбновитьСвойстваПолейТранзакцииОбработки()

	ПоляОбработки = ПараметрыОбработки.ДанныеТранзакции.ПоляОбработки;
	Отбор = Новый Структура("Имя");
	
	Для Каждого ПолеМодуля Из ДанныеТранзакции.ПоляОбработки Цикл
		Отбор.Имя = ПолеМодуля.Имя;
		ПолеОбработкиМассив = ПоляОбработки.НайтиСтроки(Отбор);
		Если ПолеОбработкиМассив.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеОбработки = ПолеОбработкиМассив[0];
		ЗаполнитьЗначенияСвойств(ПолеОбработки, ПолеМодуля, , "События");
		
		ПолеОбработки.События.Очистить();
		Для Каждого Событие Из ПолеМодуля.События Цикл
			ПолеОбработки.События.Вставить(Событие.Ключ, Событие.Значение);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПослеЗавершенияТранзакцииВвода() Экспорт
	
	Если ДанныеТранзакции.ВходящиеДанные.ВводитьКоличествоВОтдельнойТранзакции Тогда
		//после завершения основной транзакции, выполним транзакцию ввода количества
		ВходяшиеДанные = НовыеВходящиеДанные(ДанныеТранзакции.ПринятыеДанныеПолейКоличества);
		ВходяшиеДанные.Вставить("ВводитьКоличествоВОтдельнойТранзакции", Ложь);
		ВходяшиеДанные.Вставить("АвтоВводКоличества", Истина);
		ВвестиДанные(ВходяшиеДанные);
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ПослеЗавершенияВвода() Экспорт
	
	Если НЕ Интерфейс.ВводДоступен() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДанныеТранзакции.ПринятыеДанныеПолей.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ИдентификаторИнструкции = ПолучитьЗначениеДанныхПоляМодуля("ИдентификаторИнструкцииДляПоиска");
	Если ЗначениеЗаполнено(ИдентификаторИнструкции) Тогда
		УстановитьТекущийЭлементТаблицы("ТаблицаПланФакт", ИдентификаторИнструкции);
		УстановитьТекущийЭлементТаблицыФактПоИдентификаторуИнструкции(ИдентификаторИнструкции);
	КонецЕсли;

	Если НЕ ПараметрыМодуля.ВводЗавершен Тогда
		//Если НЕ ПараметрыМодуля.ДанныеСохранены И ВведеноТоварноеПоле() И НЕ ВведеноКоличественноеПоле() Тогда
		//	Если АвтоВводКоличества() Тогда
		//		Возврат Истина;
		//	КонецЕсли;
		//КонецЕсли;

		Если Интерфейс.НачатьВыборСледующегоПоля() Тогда
			Возврат Истина;
		КонецЕсли;
	Иначе
		Если ПараметрыМодуля.АвтоПереходКСледующейИнструкции И ПланПоИнструкцииЗаданияВыполнен() Тогда
			ПерейтиКСледующейПозиции();
		КонецЕсли;

		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция УстановитьТекущийЭлементТаблицыФактПоИдентификаторуИнструкции(ИдентификаторИнструкции)
	//в таблице факт идентификатор инструкции НЕ совпадает с идентификатором элемента, дополнительно получим его
	ЭлементФактаМассив = ДанныеОбработки.Таблицы.ТаблицаФакт.НайтиСтроки(Новый Структура("ИдентификаторИнструкцииДляПоиска", ИдентификаторИнструкции));
	Если ЭлементФактаМассив.Количество() > 0 Тогда
		ИдентификаторЭлемента = СтандартныйМодуль.ДополнительныеДанныеЭлементаТаблицы("ТаблицаФакт", ЭлементФактаМассив[0]).Идентификатор;
		УстановитьТекущийЭлементТаблицы("ТаблицаФакт", ИдентификаторЭлемента);
	КонецЕсли;
КонецФункции

Функция ПланПоИнструкцииЗаданияВыполнен()
	
	ОбщиеДанныеПолей = ДанныеМодуля.ОбщиеДанныеПолей;
	
	Возврат ОбщиеДанныеПолей.Свойство("КоличествоПлан") И ОбщиеДанныеПолей.КоличествоПлан <> 0 И ОбщиеДанныеПолей.Свойство("КоличествоФактИтого") И ОбщиеДанныеПолей.КоличествоПлан=ОбщиеДанныеПолей.КоличествоФактИтого;
	
КонецФункции

Функция ЗаполнитьОбщиеДанныеПолей() Экспорт
	
	СборщикДанныхСтандартный.ЗаполнитьОбщиеДанныеПолей();
	
	ЗаполнитьТекущееКоличество();
	
КонецФункции

