Функция ЗаполнитьТаблицуМодификацииПолейИнструкцийЗадания(ИдентификаторыИнструкцийЗадания, МодификацияПолейИнструкцийЗаданияДляЗагрузки)
	
	Перем ОписаниеСвойстваПоля;
	
	МетаОписаниеСвойстваПоля = "ТипЗначения, МожноВключить";
	ОТБулево = Новый ОписаниеТипов("Булево");
	СвойстваПоля = Новый Структура;
	СвойстваПоля.Вставить("План",	Новый Структура(МетаОписаниеСвойстваПоля, ОТБулево, Ложь));
	СвойстваПоля.Вставить("Ввод",	Новый Структура(МетаОписаниеСвойстваПоля, ОТБулево, Ложь));
	СвойстваПоля.Вставить("Вывод",	Новый Структура(МетаОписаниеСвойстваПоля, ОТБулево, Ложь));
	СвойстваПоля.Вставить("ОбязательныйВвод", Новый Структура(МетаОписаниеСвойстваПоля, ОТБулево, Истина));
	СвойстваПоля.Вставить("ОбязательноеЗаполнение", Новый Структура(МетаОписаниеСвойстваПоля, ОТБулево, Истина));
	
	ТаблицаМодификацииПолейИнструкцийЗадания = ДанныеОбработки.Таблицы.ТаблицаМодификацииПолейИнструкцийЗадания;
	
	ОтборПоИдентификатору = Новый Структура("ИдентификаторИнструкции");
	Для Каждого ИдентификаторИнструкцииЗадания Из ИдентификаторыИнструкцийЗадания Цикл
		ОтборПоИдентификатору.ИдентификаторИнструкции = ИдентификаторИнструкцииЗадания;
		Для Каждого МодификацияПоляИнструкцииЗадания Из ТаблицаМодификацииПолейИнструкцийЗадания.НайтиСтроки(ОтборПоИдентификатору) Цикл
			ТаблицаМодификацииПолейИнструкцийЗадания.Удалить(МодификацияПоляИнструкцииЗадания);
		КонецЦикла;
		
		Если МодификацияПолейИнструкцийЗаданияДляЗагрузки=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого МодификацияПоляИнструкцииЗаданияДляЗагрузки Из МодификацияПолейИнструкцийЗаданияДляЗагрузки.НайтиСтроки(ОтборПоИдентификатору) Цикл
			Поле = ПолеМодуля(МодификацияПоляИнструкцииЗаданияДляЗагрузки.ИмяПоля);
			Если Поле=ПустоеПолеОбработки Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяСвойства = МодификацияПоляИнструкцииЗаданияДляЗагрузки.ИмяСвойства;
			Если НЕ СвойстваПоля.Свойство(ИмяСвойства, ОписаниеСвойстваПоля) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ОписаниеСвойстваПоля.МожноВключить=Ложь И Поле[ИмяСвойства]=Ложь Тогда
				Продолжить;
			КонецЕсли;

			МодификацияПоляИнструкцииЗадания = ТаблицаМодификацииПолейИнструкцийЗадания.Добавить();
			ЗаполнитьЗначенияСвойств(МодификацияПоляИнструкцииЗадания, МодификацияПоляИнструкцииЗаданияДляЗагрузки);
			МодификацияПоляИнструкцииЗадания.ЗначениеСвойства = ОписаниеСвойстваПоля.ТипЗначения.ПривестиЗначение(МодификацияПоляИнструкцииЗаданияДляЗагрузки.ЗначениеСвойства);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПрочитатьМодификациюПолейИнструкцийЗадания(Задание)

	МодификацияПолейИнструкцийЗадания = Задание.НастройкаПолейСтрок.Выгрузить();
	Товары = Задание.Товары;
	УдалитьМодификации = Новый Массив;
	ПоискПоИдентификатору = Новый Структура("ИдентификаторИнструкции");
	Для Каждого МодификацияПоляИнструкцииЗадания Из МодификацияПолейИнструкцийЗадания Цикл
		Если МодификацияПоляИнструкцииЗадания.ИдентификаторИнструкции=0 Тогда
			УдалитьМодификации.Добавить(МодификацияПоляИнструкцииЗадания);
			Продолжить;
		КонецЕсли;
		
		ПоискПоИдентификатору.ИдентификаторИнструкции = МодификацияПоляИнструкцииЗадания.ИдентификаторИнструкции;
		Если Товары.НайтиСтроки(ПоискПоИдентификатору).Количество()=0 Тогда
			УдалитьМодификации.Добавить(МодификацияПоляИнструкцииЗадания);
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	РК.УдалитьЭлементыКоллекции(МодификацияПолейИнструкцийЗадания, УдалитьМодификации);
	
	Возврат МодификацияПолейИнструкцийЗадания;
	
КонецФункции

Функция РассчитатьМодификациюПолейНовыхИнструкцийЗаданий(ЗаданиеКладовщику, ДанныеДляРасчета)

	ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;
	ЕстьКолонкаТовар = ТаблицаПланФакт.Колонки.Найти("Товар") <> Неопределено;
	
	Товары = ЗаданиеКладовщику.Товары;
	ТоварыВыгрузка = Товары.Выгрузить();
	Товары.Очистить();
	Для Каждого ЭлементДанныхДляРасчета Из ДанныеДляРасчета Цикл
		СтрокаПланФактДокументаЗадания = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПланФактДокументаЗадания, ЭлементДанныхДляРасчета);
		СтрокаПланФактДокументаЗадания.ИдентификаторИнструкции = ЭлементДанныхДляРасчета.ИдентификаторИнструкцииДляПоиска;
		Если ЕстьКолонкаТовар Тогда
			СтрокаПланФактДокументаЗадания.Номенклатура = ЭлементДанныхДляРасчета.Товар;
		КонецЕсли;
	КонецЦикла;
	
	Документы.вмс_ЗаданиеКладовщику.ЗаполнитьНастройкуПолейСтрокДокумента(ЗаданиеКладовщику);
	
	МодификацияПолейИнструкцийЗадания = ЗаданиеКладовщику.НастройкаПолейСтрок.Выгрузить();
	
	//для новых инструкций не отключать план по серии
	//при вводе серии инструкция будет заменена на заполненную
	УдалитьМодификации = Новый Массив;
	Для Каждого МодификацияПоля Из МодификацияПолейИнструкцийЗадания Цикл
		Если МодификацияПоля.ИмяПоля="Серия" И МодификацияПоля.ИмяСвойства="План" И МодификацияПоля.ЗначениеСвойства=Ложь Тогда
			УдалитьМодификации.Добавить(МодификацияПоля);
		КонецЕсли;
	КонецЦикла;
	РК.УдалитьЭлементыКоллекции(МодификацияПолейИнструкцийЗадания, УдалитьМодификации);
	
	Товары.Загрузить(ТоварыВыгрузка);

	Возврат МодификацияПолейИнструкцийЗадания;
	
КонецФункции

Функция ЗаполнитьПоляОбработкиИнструкцийЗаданияПоУмолчанию()
	
	ИдентификаторИнструкции = 0;
	РК.УдалитьЭлементыКоллекции(ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания, Новый Структура("ИдентификаторИнструкции", ИдентификаторИнструкции));
	
	Для Каждого Поле Из ПараметрыМодуля.ПоляОбработки Цикл
		
		ПолеИнструкцииПоУмолчанию = ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания.Добавить();
		ЗаполнитьЗначенияСвойств(ПолеИнструкцииПоУмолчанию, Поле);
		ПолеИнструкцииПоУмолчанию.ИдентификаторИнструкции = ИдентификаторИнструкции;
		
	КонецЦикла;
	
КонецФункции

Функция ЗаполнитьПоляОбработкиИнструкцийЗадания(ИдентификаторыИнструкций)
	
	ИдентификаторыИнструкцийМассив = РК.ЗначениеВМассив(ИдентификаторыИнструкций, , Ложь);
	
	ТаблицаМодификацииПолейИнструкцийЗадания = ДанныеОбработки.Таблицы.ТаблицаМодификацииПолейИнструкцийЗадания;
	ОтборМодификацийПоля = Новый Структура("ИдентификаторИнструкции, ИмяПоля");
	
	ПоляОбработкиИнструкцийЗадания = ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания;
	ПоляПоУмолчанию = ПоляОбработкиИнструкцийЗадания.НайтиСтроки(Новый Структура("ИдентификаторИнструкции", 0));
	
	ПоляОбработкиИнструкцийЗаданияДляПоиска = ПараметрыМодуля.ПоляОбработкиИнструкцийЗаданияДляПоиска;
	
	Для Каждого ИдентификаторИнструкции Из ИдентификаторыИнструкцийМассив Цикл
		
		Если ИдентификаторИнструкции=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПоляОбработкиИнструкцииЗаданияДляПоиска = Новый Соответствие;
		
		РК.УдалитьЭлементыКоллекции(ПоляОбработкиИнструкцийЗадания, Новый Структура("ИдентификаторИнструкции", ИдентификаторИнструкции));
		
		ОтборМодификацийПоля.ИдентификаторИнструкции = ИдентификаторИнструкции;
		Для Каждого ПолеПоУмолчанию Из ПоляПоУмолчанию Цикл
			
			ПолеИнструкции = ПоляОбработкиИнструкцийЗадания.Добавить();
			ЗаполнитьЗначенияСвойств(ПолеИнструкции, ПолеПоУмолчанию);
			ПолеИнструкции.События = РК.СкопироватьСтруктуру(ПолеПоУмолчанию.События);
			ПолеИнструкции.ИдентификаторИнструкции = ИдентификаторИнструкции;
			
			ОтборМодификацийПоля.ИмяПоля = ПолеПоУмолчанию.Имя;
			МодификацииПоля = ТаблицаМодификацииПолейИнструкцийЗадания.НайтиСтроки(ОтборМодификацийПоля);
			Для Каждого МодификацияПоля Из МодификацииПоля Цикл
				ПолеИнструкции[МодификацияПоля.ИмяСвойства] = МодификацияПоля.ЗначениеСвойства;
			КонецЦикла;
			
			Если ПолеИнструкции.План И НЕ ПолеИнструкции.Ресурс И ПолеИнструкции.ПутьРодителяДанныхЗаполнения="Задание.Товары" Тогда
				ПоляОбработкиИнструкцииЗаданияДляПоиска[ПолеИнструкции.Имя] = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		ПоляОбработкиИнструкцийЗаданияДляПоиска[ИдентификаторИнструкции] = ПоляОбработкиИнструкцииЗаданияДляПоиска;
		
	КонецЦикла;
	
КонецФункции

Функция УстановитьПоляОбработкиДляИнструкцииЗадания(ИдентификаторИнструкции)
	
	Если ДанныеТранзакции.ИдентификаторИнструкцииПолейОбработки=ИдентификаторИнструкции Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеТранзакции.ИдентификаторИнструкцииПолейОбработки = ИдентификаторИнструкции;

	ПоляМодуля = ДанныеТранзакции.ПоляОбработки;
	
	ПоляИнструкции = ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания.НайтиСтроки(Новый Структура("ИдентификаторИнструкции", ИдентификаторИнструкции));
	
	ОтборПоля = Новый Структура("Имя");
	Для Каждого ПолеИнструкции Из ПоляИнструкции Цикл
		ОтборПоля.Имя = ПолеИнструкции.Имя;
		ПолеМодуляМассив = ПоляМодуля.НайтиСтроки(ОтборПоля);
		Если ПолеМодуляМассив.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеМодуля = ПолеМодуляМассив[0];
		ЗаполнитьЗначенияСвойств(ПолеМодуля, ПолеИнструкции, , "Значение, ЗначениеУстановлено");
	КонецЦикла;
	
	СборщикДанныхСтандартный.ЗаполнитьПоляАнализаДанных();
	
	Интерфейс.ПроанализироватьЗаполнениеПолейДанных();
	
	Возврат Истина;
	
КонецФункции

Функция ПодобратьИнструкциюДляДанныхВвода()

	ИдентификаторИнструкцииДляПоиска = ПолучитьЗначениеДанныхПоляМодуля("ИдентификаторИнструкцииДляПоиска");

	//переключим на другую инструкцию, если текущая не соответствует введенным данным
	
	Отбор = Новый Структура(ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.ЗаполненныеПоля);
	ЗаполнитьЗначенияСвойств(Отбор, ДанныеТранзакции.ВведенныеДанныеПолей);
	ИдентификаторИнструкции = НайтиИнструкцию(Отбор, ИдентификаторИнструкцииДляПоиска);
	
	Если ИдентификаторИнструкции=0 Тогда
		
		ИдентификаторИнструкции = ДобавитьДанныеИнструкцииДляДанныхВводаБезПлана();
		
	КонецЕсли;
	
	УстановитьЗначениеДанныхПоляМодуля("ИдентификаторИнструкцииДляПоиска", ИдентификаторИнструкции);
	Возврат ИдентификаторИнструкции <> 0;
	
КонецФункции

Функция ДобавитьДанныеИнструкцииДляДанныхВводаБезПлана()
	
	ДанныеОбновленияТаблицыПланФактТранзакции = ПараметрыТаблицы("ТаблицаПланФакт");
	
	ИдентификаторИнструкции = ДанныеОбновленияТаблицыПланФактТранзакции.ИдентификаторНовойИнструкции;
	ДанныеОбновленияТаблицыПланФактТранзакции.ИдентификаторНовойИнструкции = ДанныеОбновленияТаблицыПланФактТранзакции.ИдентификаторНовойИнструкции + 1;
	
	//за основу возьмем данные предыдущей инструкции
	ДанныеПолейИнструкции = РК.СкопироватьСтруктуру(ДанныеМодуля.ОбщиеДанныеПолей);
	ДанныеПолейИнструкции.КоличествоПлан = 0;
	ДанныеПолейИнструкции.КоличествоФактИтого = 0;
	
	//добавим данные текущего ввода
	ЗаполнитьЗначенияСвойств(ДанныеПолейИнструкции, ДанныеТранзакции.ПринятыеДанныеПолей);
	
	
	
	
	
	//////////////////////////////////////////////////////////////////////////////
	// Данные настройки полей инструкции
	ДанныеДляРасчетаМодификацииПолейИнструкцииЗадания = РК.СкопироватьСтруктуру(ДанныеПолейИнструкции);
	ДанныеДляРасчетаМодификацииПолейИнструкцииЗадания.Вставить("ИдентификаторИнструкцииДляПоиска", ИдентификаторИнструкции);
	
	ДанныеДляРасчетаМодификацииПолейИнструкцийЗаданий = Новый Массив;
	ДанныеДляРасчетаМодификацииПолейИнструкцийЗаданий.Добавить(ДанныеДляРасчетаМодификацииПолейИнструкцииЗадания);
	
	ИдентификаторыИнструкций = Новый Массив;
	ИдентификаторыИнструкций.Добавить(ИдентификаторИнструкции);
	
	МодификацияПолейНовыхИнструкцийЗаданий = РассчитатьМодификациюПолейНовыхИнструкцийЗаданий(ПараметрыОбработки.Задание, ДанныеДляРасчетаМодификацииПолейИнструкцийЗаданий);
	ЗаполнитьТаблицуМодификацииПолейИнструкцийЗадания(ИдентификаторыИнструкций, МодификацияПолейНовыхИнструкцийЗаданий);
	ЗаполнитьПоляОбработкиИнструкцийЗадания(ИдентификаторыИнструкций);
	
	ПолеСерияМассив = ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания.НайтиСтроки(Новый Структура("ИдентификаторИнструкции, Имя", ИдентификаторИнструкции, "Серия"));
	Если ПолеСерияМассив.Количество() > 0 Тогда
		ПолеСерия = ПолеСерияМассив[0];
		Если НЕ ПолеСерия.Ввод Тогда
			ДанныеПолейИнструкции.Серия = ПолеСерия.ЗначениеПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	
	
	
	
	//////////////////////////////////////////////////////////////////////////////
	// Данные полей инструкции
	ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;
	ДанныеОбновленияТаблицыПланФакт = ПараметрыТаблицы("ТаблицаПланФакт");
	
	ИнструкцияМассив = ТаблицаПланФакт.НайтиСтроки(Новый Структура("ИдентификаторИнструкцииДляПоиска", ИдентификаторИнструкции));
	Если ИнструкцияМассив.Количество()=0 Тогда
		Инструкция = ТаблицаПланФакт.Добавить();
	Иначе
		Инструкция = ИнструкцияМассив[0];
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Инструкция, ЗначенияПоУмолчаниюЭлементаТаблицыПланФакт());
	Инструкция.ИдентификаторИнструкцииДляПоиска = ИдентификаторИнструкции;
	ДополнительныеДанныеЭлементаТаблицы = ДополнительныеДанныеЭлементаТаблицы(ДанныеОбновленияТаблицыПланФакт, Инструкция);
	ДополнительныеДанныеЭлементаТаблицы.Идентификатор = ИдентификаторИнструкции;
	ДополнительныеДанныеЭлементаТаблицы.УдалятьПустые = Ложь;

	ДанныеПолейИнструкции = РК.УдалитьЭлементыКоллекции(РК.СкопироватьСтруктуру(ДанныеПолейИнструкции),
													"ИдентификаторИнструкции, ИдентификаторИнструкцииДляПоиска, ИдентификаторИнструкцииЗаполнен, Выполнен");
	ЗаполнитьЗначенияСвойств(Инструкция, ДанныеПолейИнструкции);
	
	ИзмененныеЭлементы = Новый Массив;
	ИзмененныеЭлементы.Добавить(ТаблицаПланФакт.Индекс(Инструкция));
	
	ЗарегистрироватьИзмененияЭлементовТаблицы(ДанныеОбновленияТаблицыПланФакт, ИзмененныеЭлементы);

	ОбновитьИзмененныеЭлементыТаблицыПланФакт(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт);
	
	ДанныеТранзакции.НовыеИдентификаторыИнструкций.Добавить(ИдентификаторИнструкции);
	
	Возврат ИдентификаторИнструкции;
	
КонецФункции

