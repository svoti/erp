Функция ОпределитьСледующуюИнструкцию() Экспорт
	
	ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;
	ТекущаяИнструкцияМассив = ТаблицаПланФакт.НайтиСтроки(Новый Структура("ИдентификаторИнструкцииДляПоиска", ПолучитьЗначениеДанныхПоляМодуля("ИдентификаторИнструкцииДляПоиска")));
	Если ТекущаяИнструкцияМассив.Количество() > 0 Тогда
		НомерИнструкции = ТекущаяИнструкцияМассив[0].НомерИнструкции;
	Иначе
		НомерИнструкции = 0;
	КонецЕсли;
	
	КоличествоИнструкций = ТаблицаПланФакт.Количество();
	Поиск = Новый Структура("НомерИнструкции");
	НомерИнструкции = НомерИнструкции + 1;
	Для НомерПоиска=1 По 2 Цикл
		Пока НомерИнструкции <= КоличествоИнструкций Цикл
			Поиск.НомерИнструкции = НомерИнструкции;
			ИнструкцияМассив = ТаблицаПланФакт.НайтиСтроки(Поиск);
			Если ИнструкцияМассив.Количество()=0 Тогда
				НомерИнструкции = НомерИнструкции + 1;
				Продолжить;
			КонецЕсли;
			
			Инструкция = ИнструкцияМассив[0];
			Если Инструкция.Выполнен Тогда
				НомерИнструкции = НомерИнструкции + 1;
				Продолжить;
			КонецЕсли;
			
			УстановитьЗначениеДанныхПоляМодуля("ИдентификаторИнструкцииДляПоиска", Инструкция.ИдентификаторИнструкцииДляПоиска);
			Возврат Инструкция.ИдентификаторИнструкцииДляПоиска;
		КонецЦикла;
		
		НомерИнструкции = 1; //поищем с начала таблицы
	КонецЦикла;
	
	//нет инструкций
	УстановитьЗначениеДанныхПоляМодуля("ИдентификаторИнструкцииДляПоиска", 0);
	Возврат 0;
	
КонецФункции

