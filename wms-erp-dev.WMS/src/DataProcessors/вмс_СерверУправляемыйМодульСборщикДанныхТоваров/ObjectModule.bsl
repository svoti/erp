	ЗаполнитьТаблицуПланФакт(ДанныеФакт);
	
	ЗаполнитьТаблицуФакт(ДанныеФакт);
	
	//ЗаполнитьТаблицуФактБыдлоКодер(ДанныеФакт);
	
КонецФункции

Функция ЗаполнитьТаблицуПланФакт(ДанныеФакт)

	ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;
	ДанныеОбновленияТаблицыПланФакт = ПараметрыТаблицы("ТаблицаПланФакт");
	
	НачалоОбновленияТаблицы(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт);

	ЗначенияПоУмолчанию = ЗначенияПоУмолчаниюЭлементаТаблицыПланФакт();

	//план
	НоваяВерсияДокументаЗадания = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(ПараметрыОбработки.СсылкаНаЗадание);
	Если ПараметрыОбработки.ВерсияДокументаЗадания <> НоваяВерсияДокументаЗадания Тогда
		Если НоваяВерсияДокументаЗадания <> "" Тогда
			ПараметрыОбработки.Задание.Прочитать();
		КонецЕсли;
		ДанныеИнструкций = ПолучитьТаблицуПлана();
		ОбновитьДанныеТаблицы(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт, ДанныеИнструкций, "ИдентификаторИнструкцииЗаполнен, ИдентификаторИнструкции", Истина, "КоличествоПлан", ЗначенияПоУмолчанию);

		ЗаполнитьТаблицуМодификацииПолейИнструкцийЗадания(ДанныеИнструкций.ВыгрузитьКолонку("ИдентификаторИнструкции"), ПрочитатьМодификациюПолейИнструкцийЗадания(ПараметрыОбработки.Задание));
	КонецЕсли;
	
	//факт
	ДанныеПланФакт = ДанныеФакт.Скопировать();
	ЗначенияКолонкиКоличествоФакт = ДанныеПланФакт.ВыгрузитьКолонку("КоличествоФакт");
	ДанныеПланФакт.Колонки.Добавить("КоличествоФактИтого");
	ДанныеПланФакт.ЗагрузитьКолонку(ЗначенияКолонкиКоличествоФакт, "КоличествоФактИтого");
	
	ДанныеПланФакт.Колонки.Добавить("КоличествоФактЗаполнено");
	ДанныеПланФакт.ЗаполнитьЗначения(1, "КоличествоФактЗаполнено");

	ОсновныеПоляПлана = ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания.Скопировать(Новый Структура("ИдентификаторИнструкции, План, Ресурс", 0, Истина, Ложь)).ВыгрузитьКолонку("Имя");
	ПоляГруппировкиМассив = РК.ПолучитьКолонкиКоллекции(ТаблицаПланФакт);
	ПоляГруппировкиМассив = РК.ПересечениеМассивов(РК.ПолучитьКолонкиКоллекции(ДанныеПланФакт), ПоляГруппировкиМассив);
	ПоляГруппировкиМассив = РК.ПересечениеМассивов(ОсновныеПоляПлана, ПоляГруппировкиМассив);
	ПоляГруппировки = РК.МассивВСтроку(ПоляГруппировкиМассив);
	
	Поиск = Новый Массив;
	Поиск.Добавить(Новый Структура("ИдентификаторИнструкцииЗаполнен, ИдентификаторИнструкции", Истина));
	Поиск.Добавить(Новый Структура("ИдентификаторИнструкцииЗаполнен, " + ПоляГруппировки, Ложь));

	ОбновитьДанныеТаблицы(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт, ДанныеПланФакт, Поиск, Истина, "КоличествоФактИтого, КоличествоФактЗаполнено", ЗначенияПоУмолчанию);
	
	//план по предыдущему количеству
	Если ПараметрыОбработки.Инвентаризация Тогда
		ЗаполнитьКоличествоУчетТаблицыПланФакт(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт, Поиск, ЗначенияПоУмолчанию);
	КонецЕсли;
	
	ОбновитьИзмененныеЭлементыТаблицыПланФакт(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт);
	
	КонецОбновленияТаблицы(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт);
	
КонецФункции

Функция ОбновитьИзмененныеЭлементыТаблицыПланФакт(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт)
	
	ИзмененныеЭлементы = ДанныеОбновленияТаблицыПланФакт.ИзмененныеЭлементы;
	Если ИзмененныеЭлементы.Количество() > 0 Тогда
		УдалитьПустыеЭлементыТаблицы(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт);
		ЗаполнитьКоличествоФактИтогоВТаблице(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт);
	КонецЕсли;
	
	НовыеЭлементы = ДанныеОбновленияТаблицыПланФакт.НовыеЭлементы;
	Если НовыеЭлементы.Количество() > 0 Тогда
		ЗаполнитьИдентификаторыИнструкцийТаблицыПланФакт(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт, НовыеЭлементы);
		ЗаполнитьПоляОбработкиИнструкцийТаблицыПланФакт(ТаблицаПланФакт, НовыеЭлементы);
		ОбновитьПредставлениеТоваровВТаблице(ТаблицаПланФакт, НовыеЭлементы);
	КонецЕсли;
	
	Если ИзмененныеЭлементы.Количество() > 0 Тогда
		УстановитьОформлениеЭлементовТаблицыПланФакт(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт);
	КонецЕсли;
	
	УдаленныеЭлементы = ДанныеОбновленияТаблицыПланФакт.УдаленныеЭлементы;
	Если УдаленныеЭлементы.Количество() > 0 Тогда
		УдалитьДанныеИнструкцийЗадания(УдаленныеЭлементы);
	КонецЕсли;
	
КонецФункции

Функция ЗаполнитьКоличествоФактИтогоВТаблице(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт)
	
	ДополнительныеДанныеЭлементов = ДанныеОбновленияТаблицыПланФакт.ДополнительныеДанныеЭлементов;
	
	Для Каждого ИндексЭлемента Из ДанныеОбновленияТаблицыПланФакт.ИзмененныеЭлементы Цикл
		ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов[ИндексЭлемента];
		Элемент = ТаблицаПланФакт[ИндексЭлемента];
		Элемент.КоличествоФактИтогоВТаблице = Элемент.КоличествоФактИтого;
	КонецЦикла;
	
КонецФункции

Функция УдалитьДанныеИнструкцийЗадания(знач ИдентификаторыИнструкций)
	
	Если ТипЗнч(ИдентификаторыИнструкций) <> Тип("Массив") Тогда
		ИдентификаторИнструкции = ИдентификаторыИнструкций;
		ИдентификаторыИнструкций = Новый Массив;
		ИдентификаторыИнструкций.Добавить(ИдентификаторИнструкции);
	КонецЕсли;
	
	ОтборПоИдентификатору = Новый Структура("ИдентификаторИнструкции");
	ОтборПоИдентификаторуДляПоиска = Новый Структура("ИдентификаторИнструкцииДляПоиска");
	ТаблицаМодификацииПолейИнструкцийЗадания = ДанныеОбработки.Таблицы.ТаблицаМодификацииПолейИнструкцийЗадания;
	ПоляОбработкиИнструкцийЗадания = ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания;
	ПоляОбработкиИнструкцийЗаданияДляПоиска = ПараметрыМодуля.ПоляОбработкиИнструкцийЗаданияДляПоиска;
	ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;
	УдаляемыеЭлементы = Новый Массив;
	Для Каждого ИдентификаторИнструкции Из ИдентификаторыИнструкций Цикл
		
		Если ИдентификаторИнструкции=0 Тогда
			ВызватьИсключение "Идентификатор инструкции не указан!"
		КонецЕсли;
		
		ОтборПоИдентификатору.ИдентификаторИнструкции = ИдентификаторИнструкции;

		Для Каждого МодификацияПоля Из ТаблицаМодификацииПолейИнструкцийЗадания.НайтиСтроки(ОтборПоИдентификатору) Цикл
			ТаблицаМодификацииПолейИнструкцийЗадания.Удалить(МодификацияПоля);
		КонецЦикла;
		
		Для Каждого ПолеИнструкции Из ПоляОбработкиИнструкцийЗадания.НайтиСтроки(ОтборПоИдентификатору) Цикл
			ПоляОбработкиИнструкцийЗадания.Удалить(ПолеИнструкции);
		КонецЦикла;
		
		ПоляОбработкиИнструкцийЗаданияДляПоиска.Удалить(ИдентификаторИнструкции);
		
		ОтборПоИдентификаторуДляПоиска.ИдентификаторИнструкцииДляПоиска = ИдентификаторИнструкции;
		ЭлементТаблицыМассив = ТаблицаПланФакт.НайтиСтроки(ОтборПоИдентификаторуДляПоиска);
		Для Каждого ЭлементТаблицы Из ЭлементТаблицыМассив Цикл
			ИндексЭлемента = ТаблицаПланФакт.Индекс(ЭлементТаблицы);
			УдаляемыеЭлементы.Добавить(ИндексЭлемента);
		КонецЦикла;
		
	КонецЦикла;
	
	УдалитьЭлементыТаблицы(ТаблицаПланФакт, ПараметрыТаблицы("ТаблицаПланФакт"), УдаляемыеЭлементы);
	
КонецФункции

Функция ЗначенияПоУмолчаниюЭлементаТаблицыПланФакт()

	ЗначенияПоУмолчанию = Новый Структура;
	ЗначенияПоУмолчанию.Вставить("НомерИнструкции", 0);
	ЗначенияПоУмолчанию.Вставить("ИдентификаторИнструкцииЗаполнен", Ложь);
	ЗначенияПоУмолчанию.Вставить("ИдентификаторИнструкции", 0);
	ЗначенияПоУмолчанию.Вставить("ИдентификаторИнструкцииДляПоиска", 0);
	ЗначенияПоУмолчанию.Вставить("Выполнен", Ложь);
	ЗначенияПоУмолчанию.Вставить("КоличествоПлан", 0);
	ЗначенияПоУмолчанию.Вставить("КоличествоФактИтогоВТаблице", 0);
	ЗначенияПоУмолчанию.Вставить("КоличествоФактИтого", 0);
	ЗначенияПоУмолчанию.Вставить("КоличествоФактЗаполнено", 0);
	Если ПараметрыОбработки.Инвентаризация Тогда
		ЗначенияПоУмолчанию.Вставить("КоличествоУчет", 0);
	КонецЕсли;
	
	Возврат ЗначенияПоУмолчанию;
	
КонецФункции

Функция ЗаполнитьКоличествоУчетТаблицыПланФакт(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт, Поиск, ЗначенияПоУмолчанию)
	
	//новый план по предыдущей операции
	ДанныеПланФакт = ПолучитьТаблицуФакт(Ложь, Истина);

	ОбновитьДанныеТаблицы(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт, ДанныеПланФакт, Поиск, Ложь, , ЗначенияПоУмолчанию);
	
	ИзмененныеЭлементы = Новый Массив;
	
	ДанныеОбновленияЭлементов = ДанныеОбновленияТаблицыПланФакт.ДополнительныеДанныеЭлементов;
	Для ИндексЭлемента=0 По ДанныеОбновленияЭлементов.Количество()-1 Цикл
		ЭлементДанных = ТаблицаПланФакт[ИндексЭлемента];
		ЭлементОбновленияДанных = ДанныеОбновленияЭлементов[ИндексЭлемента];
		
		Если ЭлементОбновленияДанных.ФлагОбработки=ДанныеОбновленияТаблицыПланФакт.ФлагОбработки Тогда
			Значение = 0;
			Для Каждого ИндексЭлементаЗагрузки Из ЭлементОбновленияДанных.ЭлементыЗагрузки Цикл
				Значение = Значение + ДанныеПланФакт[ИндексЭлементаЗагрузки].КоличествоФакт;
			КонецЦикла;
		Иначе
			Значение = ЭлементДанных.КоличествоПлан;
		КонецЕсли;
		
		Если ЭлементДанных.КоличествоУчет <> Значение Тогда
			ЭлементДанных.КоличествоУчет = Значение;
			ИзмененныеЭлементы.Добавить(ИндексЭлемента);
		КонецЕсли;
	КонецЦикла;
	
	ЗарегистрироватьИзмененияЭлементовТаблицы(ДанныеОбновленияТаблицыПланФакт, ИзмененныеЭлементы);
	
КонецФункции

Функция ЗаполнитьИдентификаторыИнструкцийТаблицыПланФакт(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт, НовыеЭлементы)
	
	Если НовыеЭлементы.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИдентификаторНовойИнструкции = ДанныеОбновленияТаблицыПланФакт.ИдентификаторНовойИнструкции;
	
	ДополнительныеДанныеЭлементов = ДанныеОбновленияТаблицыПланФакт.ДополнительныеДанныеЭлементов;

	СгенерироватьИдентификаторыДляЭлементов = Новый Массив;
	//сначала обработаем инструкции из задания, потом сгенерируем идентификаторы инструкций вне плана
	Для Каждого ИндексНовогоЭлемента Из НовыеЭлементы Цикл
		НовыйЭлемент = ТаблицаПланФакт[ИндексНовогоЭлемента];
		
		НовыйЭлемент.ИдентификаторИнструкцииЗаполнен = НовыйЭлемент.ИдентификаторИнструкции <> 0;

		Если НовыйЭлемент.ИдентификаторИнструкцииЗаполнен Тогда
			НовыйЭлемент.ИдентификаторИнструкцииДляПоиска = НовыйЭлемент.ИдентификаторИнструкции;

			Если ИдентификаторНовойИнструкции <= НовыйЭлемент.ИдентификаторИнструкцииДляПоиска Тогда
				ИдентификаторНовойИнструкции = НовыйЭлемент.ИдентификаторИнструкцииДляПоиска + 1;
			КонецЕсли;
		ИначеЕсли НовыйЭлемент.ИдентификаторИнструкцииДляПоиска=0 Тогда
			СгенерироватьИдентификаторыДляЭлементов.Добавить(ИндексНовогоЭлемента);
		КонецЕсли;
	КонецЦикла;
	
	Если СгенерироватьИдентификаторыДляЭлементов.Количество() > 0 Тогда
		Для Каждого ИндексНовогоЭлемента Из СгенерироватьИдентификаторыДляЭлементов Цикл
			НовыйЭлемент = ТаблицаПланФакт[ИндексНовогоЭлемента];
			НовыйЭлемент.ИдентификаторИнструкцииДляПоиска = ИдентификаторНовойИнструкции;
			
			ИдентификаторНовойИнструкции = ИдентификаторНовойИнструкции + 1;
		КонецЦикла;
	КонецЕсли;
	
	//синхронизируем идентификаторы инструкций с идентификаторами на клиенте
	Для Каждого ИндексНовогоЭлемента Из НовыеЭлементы Цикл
		НовыйЭлемент = ТаблицаПланФакт[ИндексНовогоЭлемента];
		ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов[ИндексНовогоЭлемента];
		ДополнительныеДанныеЭлемента.Идентификатор = НовыйЭлемент.ИдентификаторИнструкцииДляПоиска;
	КонецЦикла;
	
	ДанныеОбновленияТаблицыПланФакт.ИдентификаторНовойИнструкции = ИдентификаторНовойИнструкции;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьПоляОбработкиИнструкцийТаблицыПланФакт(ТаблицаПланФакт, Элементы)

	Если Элементы.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИдентификаторыИнструкцийБезНастройкиПолей = Новый Массив;
	ДанныеДляРасчетаМодификацииПолейИнструкцийЗаданий = Новый Массив;

	ИдентификаторыИнструкций = Новый Массив;
	
	Для Каждого ИндексНовогоЭлемента Из Элементы Цикл
		НовыйЭлемент = ТаблицаПланФакт[ИндексНовогоЭлемента];
		ИдентификаторыИнструкций.Добавить(НовыйЭлемент.ИдентификаторИнструкцииДляПоиска);
		
		Если НЕ НовыйЭлемент.ИдентификаторИнструкцииЗаполнен Тогда
			ИдентификаторыИнструкцийБезНастройкиПолей.Добавить(НовыйЭлемент.ИдентификаторИнструкцииДляПоиска);
			ДанныеДляРасчетаМодификацииПолейИнструкцийЗаданий.Добавить(НовыйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Если ИдентификаторыИнструкцийБезНастройкиПолей.Количество() > 0 Тогда
		МодификацияПолейНовыхИнструкцийЗаданий = РассчитатьМодификациюПолейНовыхИнструкцийЗаданий(ПараметрыОбработки.Задание, ДанныеДляРасчетаМодификацииПолейИнструкцийЗаданий);
		ЗаполнитьТаблицуМодификацииПолейИнструкцийЗадания(ИдентификаторыИнструкцийБезНастройкиПолей, МодификацияПолейНовыхИнструкцийЗаданий);
	КонецЕсли;
	
	ЗаполнитьПоляОбработкиИнструкцийЗадания(ИдентификаторыИнструкций);
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьТаблицуФакт(ДанныеФакт)

	ТаблицаФакт = ДанныеОбработки.Таблицы.ТаблицаФакт;
	ДанныеОбновленияТаблицыФакт = ПараметрыТаблицы("ТаблицаФакт");

	НачалоОбновленияТаблицы(ТаблицаФакт, ДанныеОбновленияТаблицыФакт);
	
	ПоляФактаМассив = РК.ПересечениеМассивов(СписокПолейМодуля(Новый Структура("Сборка, Ресурс", Истина, Ложь)), РК.ПолучитьКолонкиКоллекции(ТаблицаФакт));
	ПоляФакта = РК.МассивВСтроку(ПоляФактаМассив);

	ОбновитьДанныеТаблицы(ТаблицаФакт, ДанныеОбновленияТаблицыФакт, ДанныеФакт, ПоляФакта, Истина, "КоличествоФакт");

	Если ДанныеОбновленияТаблицыФакт.ИзмененныеЭлементы.Количество() > 0 И ДанныеОбновленияТаблицыФакт.Ресурсы.Количество() > 0 Тогда
		УдалитьПустыеЭлементыТаблицы(ТаблицаФакт, ДанныеОбновленияТаблицыФакт);
	КонецЕсли;
	
	ЗаполнитьИдентификаторыИнструкцийТаблицыФакт(ТаблицаФакт, ДанныеОбновленияТаблицыФакт);
	
	ОбновитьПредставлениеТоваровВТаблице(ТаблицаФакт, ДанныеОбновленияТаблицыФакт.НовыеЭлементы);
	
	КонецОбновленияТаблицы(ТаблицаФакт, ДанныеОбновленияТаблицыФакт);
	
КонецФункции

Функция ЗаполнитьИдентификаторыИнструкцийТаблицыФакт(ТаблицаФакт, ДанныеОбновленияТаблицыФакт)
	
	НовыеЭлементы = ДанныеОбновленияТаблицыФакт.НовыеЭлементы;
	Если НовыеЭлементы.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеОбновленияЭлементовТаблицыФакт = ДанныеОбновленияТаблицыФакт.ДополнительныеДанныеЭлементов;
	
	НайтиИдентификаторыДляЭлементов = Новый Массив;
	Для Каждого ИндексНовогоЭлемента Из НовыеЭлементы Цикл
		
		НовыйЭлемент = ТаблицаФакт[ИндексНовогоЭлемента];
		
		НовыйЭлемент.ИдентификаторИнструкцииЗаполнен = НовыйЭлемент.ИдентификаторИнструкции <> 0;

		Если НовыйЭлемент.ИдентификаторИнструкцииДляПоиска=Неопределено Тогда
			Если НовыйЭлемент.ИдентификаторИнструкцииЗаполнен Тогда
				НовыйЭлемент.ИдентификаторИнструкцииДляПоиска = НовыйЭлемент.ИдентификаторИнструкции;
			Иначе
				НайтиИдентификаторыДляЭлементов.Добавить(НовыйЭлемент);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НайтиИдентификаторыДляЭлементов.Количество() > 0 Тогда
		
		ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;
		ДанныеОбновленияТаблицыПланФакт = ПараметрыТаблицы("ТаблицаПланФакт");
		ДанныеОбновленияЭлементовТаблицыПланФакт = ДанныеОбновленияТаблицыПланФакт.ДополнительныеДанныеЭлементов;
		
		ПоляПланаМассив = РК.ВыгрузитьЗначенияКолонкиКоллекции(ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания.НайтиСтроки(Новый Структура("ИдентификаторИнструкции, План, Ресурс", 0, Истина, Ложь)), "Имя");
		
		ПоляГруппировкиМассив = РК.ПолучитьКолонкиКоллекции(ТаблицаПланФакт);
		ПоляГруппировкиМассив = РК.ПересечениеМассивов(РК.ПолучитьКолонкиКоллекции(ТаблицаФакт), ПоляГруппировкиМассив);
		ПоляГруппировкиМассив = РК.ПересечениеМассивов(ПоляПланаМассив, ПоляГруппировкиМассив);
		РК.ВычестьМассив(ПоляГруппировкиМассив, "ИдентификаторИнструкцииДляПоиска");
		ПоляГруппировки = РК.МассивВСтроку(ПоляГруппировкиМассив);
		Отбор = Новый Структура(ПоляГруппировки);
		
		Для Каждого Элемент Из НайтиИдентификаторыДляЭлементов Цикл
			ЗаполнитьЗначенияСвойств(Отбор, Элемент);
			НайденныеСтрокиТаблицыПланФакт = ТаблицаПланФакт.НайтиСтроки(Отбор);
			Если НайденныеСтрокиТаблицыПланФакт.Количество() > 0 Тогда
				Элемент.ИдентификаторИнструкцииДляПоиска = НайденныеСтрокиТаблицыПланФакт[0].ИдентификаторИнструкцииДляПоиска;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	//Для Каждого ИндексНовогоЭлемента Из НовыеЭлементы Цикл
	//	НовыйЭлемент = ТаблицаФакт[ИндексНовогоЭлемента];
	//	ДанныеОбновленияЭлементаТаблицыФакт = ДанныеОбновленияЭлементовТаблицыФакт[ИндексНовогоЭлемента];
	//	ДанныеОбновленияЭлементаТаблицыФакт.Идентификатор = НовыйЭлемент.ИдентификаторИнструкцииДляПоиска;
	//КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьТаблицуФактБыдлоКодер(ДанныеФакт)

	ТаблицаФакт = ДанныеОбработки.Таблицы.ТаблицаФакт;
	ТаблицаФакт.Очистить();
	Для Каждого СтрокаДанныеФакт Из ДанныеФакт Цикл
		СтрокаФакт = ТаблицаФакт.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФакт, СтрокаДанныеФакт);
		СтрокаФакт.ПредставлениеТовара = СтрокаФакт.Товар;
	КонецЦикла;
	
КонецФункции

Функция НачалоОбновленияТаблицы(Таблица, ДанныеОбновленияТаблицы)
	
	ДанныеОбновленияТаблицы.ФлагОбработки = 0;
	ДанныеОбновленияТаблицы.ДополнительныеДанныеЭлементов.ЗаполнитьЗначения(0, "ФлагОбработки");
	
	ДанныеОбновленияТаблицы.НовыеЭлементы.Очистить();
	ДанныеОбновленияТаблицы.ИзмененныеЭлементы.Очистить();
	ДанныеОбновленияТаблицы.ИзмененныеЭлементыВСписке.Очистить();
	
КонецФункции

Функция ОчиститьИнструкцииНеЗавершеннойТранзакцииВвода(Таблица, ДанныеОбновленияТаблицы)
	
	НовыеИдентификаторыИнструкций = ДанныеТранзакции.НовыеИдентификаторыИнструкций;
	Если НовыеИдентификаторыИнструкций.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УдалитьДанныеИнструкцийЗадания(НовыеИдентификаторыИнструкций);
	
	НовыеИдентификаторыИнструкций.Очистить();
	
	Возврат Истина;
	
КонецФункции

Функция КонецОбновленияТаблицы(Таблица, ДанныеОбновленияТаблицы)
	
КонецФункции

Функция УдалитьПустыеЭлементыТаблицы(Таблица, ДанныеОбновленияТаблицы)

	УдаляемыеЭлементы = ПолучитьПустыеЭлементыДляУдаленияТаблицы(Таблица, ДанныеОбновленияТаблицы, ДанныеОбновленияТаблицы.ИзмененныеЭлементы);
	
	Если УдаляемыеЭлементы.Количество() > 0 Тогда
		УдалитьЭлементыТаблицы(Таблица, ДанныеОбновленияТаблицы, УдаляемыеЭлементы);
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПустыеЭлементыДляУдаленияТаблицы(Таблица, ДанныеОбновленияТаблицы, СписокЭлементов)
	
	ПустыеЭлементыДляУдаления = ПолучитьПустыеЭлементыТаблицы(Таблица, ДанныеОбновленияТаблицы, СписокЭлементов);
	
	ДополнительныеДанныеЭлементов = ДанныеОбновленияТаблицы.ДополнительныеДанныеЭлементов;
	ИндексПустогоЭлементаДляУдаленияВСпискеПустыхЭлементовДляУдаления = ПустыеЭлементыДляУдаления.Количество();
	Пока ИндексПустогоЭлементаДляУдаленияВСпискеПустыхЭлементовДляУдаления > 0 Цикл
		ИндексПустогоЭлементаДляУдаленияВСпискеПустыхЭлементовДляУдаления = ИндексПустогоЭлементаДляУдаленияВСпискеПустыхЭлементовДляУдаления - 1;
		ИндексПустогоЭлемента = ПустыеЭлементыДляУдаления[ИндексПустогоЭлементаДляУдаленияВСпискеПустыхЭлементовДляУдаления];
		ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов[ИндексПустогоЭлемента];
		Если НЕ ДополнительныеДанныеЭлемента.УдалятьПустые Тогда
			ПустыеЭлементыДляУдаления.Удалить(ИндексПустогоЭлементаДляУдаленияВСпискеПустыхЭлементовДляУдаления);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПустыеЭлементыДляУдаления;
	
КонецФункции

Функция ПолучитьПустыеЭлементыТаблицы(Таблица, ДанныеОбновленияТаблицы, СписокЭлементов)

	Ресурсы = ДанныеОбновленияТаблицы.Ресурсы;
	ПустыеЭлементы = Новый Массив;
	Если Ресурсы.Количество()=0 Тогда
		Возврат ПустыеЭлементы;
	КонецЕсли;
	
	ДанныеОбновленияЭлементов = ДанныеОбновленияТаблицы.ДополнительныеДанныеЭлементов;
	
	Для Каждого ИндексЭлемента Из СписокЭлементов Цикл
		ДанныеОбновленияЭлемента = ДанныеОбновленияЭлементов[ИндексЭлемента];
		
		Элемент = Таблица[ИндексЭлемента];
		
		Пустой = Истина;
		Для Каждого Ресурс Из Ресурсы Цикл
			Если Элемент[Ресурс.Ключ] <> Ресурс.Значение Тогда
				Пустой = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Пустой Тогда
			ПустыеЭлементы.Добавить(ИндексЭлемента);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПустыеЭлементы;
	
КонецФункции

Функция ОбновитьДанныеТаблицы(Таблица, ДанныеОбновленияТаблицы, ДанныеДляЗагрузки, знач Поиск, СтандартнаяОбработкаРесурсов=Ложь, знач Ресурсы=Неопределено, знач ЗначенияПоУмолчанию=Неопределено) Экспорт
	
	ДанныеОбновленияЭлементов = ДанныеОбновленияТаблицы.ДополнительныеДанныеЭлементов;
	
	ВариантыПоиска = Новый Массив;
	Если ТипЗнч(Поиск)=Тип("Строка") Тогда
		ПоискМассив = Новый Массив;
		ПоискМассив.Добавить(Поиск);
	Иначе
		ПоискМассив = Поиск;
	КонецЕсли;

	Для Каждого Поиск Из ПоискМассив Цикл
		Если ТипЗнч(Поиск)=Тип("Структура") Тогда
			Поиск = РК.СкопироватьСтруктуру(Поиск);
		ИначеЕсли ТипЗнч(Поиск)=Тип("Массив") Тогда
			Поиск = Новый Структура;
			Для Каждого ПолеПоиска Из Поиск Цикл
				Поиск.Вставить(ПолеПоиска);
			КонецЦикла;
		Иначе
			Поиск = Новый Структура(Поиск);
		КонецЕсли;
		ВариантыПоиска.Добавить(Поиск);
	КонецЦикла;

	ДанныеОбновленияТаблицы.ИспользуетсяМетодОбновитьДанныеТаблицы = Истина;
	
	ДанныеОбновленияТаблицы.ФлагОбработки = ДанныеОбновленияТаблицы.ФлагОбработки + 1;
	ФлагОбработки = ДанныеОбновленияТаблицы.ФлагОбработки;
	
	ИзмененныеЭлементы = Новый Массив;

	Для ИндексЭлементаДанныхДляЗагрузки=0 По ДанныеДляЗагрузки.Количество()-1 Цикл
		
		ЭлементДанныхЗагрузки = ДанныеДляЗагрузки[ИндексЭлементаДанныхДляЗагрузки];
		
		НайденныеСтроки = Новый Массив;
		Для Каждого Поиск Из ВариантыПоиска Цикл
			ЗаполнитьЗначенияСвойств(Поиск, ЭлементДанныхЗагрузки);
			НайденныеСтроки = Таблица.НайтиСтроки(Поиск);
			Если НайденныеСтроки.Количество() > 0 Тогда
				//удалим игнорируемые строки из поиска
				ИндексНайденого = НайденныеСтроки.Количество();
				Пока ИндексНайденого > 0 Цикл
					ИндексНайденого = ИндексНайденого - 1;
					Элемент = НайденныеСтроки[ИндексНайденого];
					ИндексЭлемента = Таблица.Индекс(Элемент);
					ДанныеОбновленияЭлемента = ДанныеОбновленияЭлементов[ИндексЭлемента];
				КонецЦикла;
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если НайденныеСтроки.Количество()=0 Тогда
			ИндексЭлемента = Таблица.Количество();
			Элемент = Таблица.Добавить();
			Если ЗначенияПоУмолчанию <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Элемент, ЗначенияПоУмолчанию);
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Элемент, ЭлементДанныхЗагрузки);
			
			ДанныеОбновленияЭлемента = ДополнительныеДанныеЭлементаТаблицы(ДанныеОбновленияТаблицы, Элемент);
		Иначе
			Элемент = НайденныеСтроки[0];
			ИндексЭлемента = Таблица.Индекс(Элемент);
			
			ДанныеОбновленияЭлемента = ДанныеОбновленияЭлементов[ИндексЭлемента];
		КонецЕсли;

		Если ДанныеОбновленияЭлемента.ФлагОбработки <> ФлагОбработки Тогда
			ДанныеОбновленияЭлемента.ФлагОбработки = ФлагОбработки;
			ДанныеОбновленияЭлемента.ЭлементыЗагрузки.Очистить();
		КонецЕсли;

		ДанныеОбновленияЭлемента.ЭлементыЗагрузки.Добавить(ИндексЭлементаДанныхДляЗагрузки);
		
	КонецЦикла;
	
	Если СтандартнаяОбработкаРесурсов Тогда
		Ресурсы = РК.ЗначениеВМассив(Ресурсы, , Ложь);
		ПустыеЗначенияРесурсов = Новый Структура;
		Для Каждого Ресурс Из Ресурсы Цикл
			Если ДанныеОбновленияТаблицы.Ресурсы.Свойство(Ресурс) Тогда
				ПустыеЗначенияРесурсов.Вставить(Ресурс, ДанныеОбновленияТаблицы.Ресурсы[Ресурс]);
			КонецЕсли;
		КонецЦикла;
		
		Для ИндексЭлемента=0 По ДанныеОбновленияЭлементов.Количество()-1 Цикл
			ДанныеОбновленияЭлемента = ДанныеОбновленияЭлементов[ИндексЭлемента];
			
			Элемент = Таблица[ИндексЭлемента];
			Изменен = Ложь;
			Если ДанныеОбновленияЭлемента.ФлагОбработки=ФлагОбработки Тогда
				Для Каждого Ресурс Из Ресурсы Цикл
					Значение = 0;
					
					Для Каждого ИндексЭлементаЗагрузки Из ДанныеОбновленияЭлемента.ЭлементыЗагрузки Цикл
						Значение = Значение + ДанныеДляЗагрузки[ИндексЭлементаЗагрузки][Ресурс];
					КонецЦикла;

					Если Элемент[Ресурс] <> Значение Тогда
						Элемент[Ресурс] = Значение;
						Изменен = Истина;
					КонецЕсли;
				КонецЦикла;
			Иначе
				Для Каждого Ресурс Из Ресурсы Цикл
					Значение = ПустыеЗначенияРесурсов[Ресурс];
					Если Элемент[Ресурс] <> Значение Тогда
						Элемент[Ресурс] = Значение;
						Изменен = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если Изменен Тогда
				ИзмененныеЭлементы.Добавить(ИндексЭлемента);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;

	Если ИзмененныеЭлементы.Количество() > 0 Тогда
		ЗарегистрироватьИзмененияЭлементовТаблицы(ДанныеОбновленияТаблицы, ИзмененныеЭлементы);
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция ЗарегистрироватьИзмененияЭлементовТаблицы(ДанныеОбновленияТаблицы, ИндексыЭлементов)
	
	Возврат СтандартныйМодуль.ЗарегистрироватьИзмененияЭлементовТаблицы(ДанныеОбновленияТаблицы, ИндексыЭлементов);
	
КонецФункции

Функция УдалитьЭлементыТаблицы(Таблица, ДанныеОбновленияТаблицы, знач УдаляемыеЭлементы)
	
	Если УдаляемыеЭлементы.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УдаляемыеЭлементы = СортироватьМассив(УдаляемыеЭлементы);
	
	ДанныеОбновленияЭлементов = ДанныеОбновленияТаблицы.ДополнительныеДанныеЭлементов;
	НовыеЭлементы = ДанныеОбновленияТаблицы.НовыеЭлементы;
	УдаленныеЭлементы = ДанныеОбновленияТаблицы.УдаленныеЭлементы;

	//добавление в список удаляемых на клиенте
	Для Каждого ИндексУдаляемогоЭлемента Из УдаляемыеЭлементы Цикл
		Если НовыеЭлементы.Найти(ИндексУдаляемогоЭлемента)=Неопределено Тогда
			ДанныеОбновленияЭлемента = ДанныеОбновленияЭлементов[ИндексУдаляемогоЭлемента];
			УдаленныеЭлементы.Добавить(ДанныеОбновленияЭлемента.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	
	//удаление элементов из таблиц, корректировка номеров элементов стоящих после удаляемых элементов
	НомерУдаляемого = УдаляемыеЭлементы.Количество();
	ИндексПоследнегоЭлемента = ДанныеОбновленияЭлементов.Количество()-1;
	Пока НомерУдаляемого > 0 Цикл
		
		ИндексУдаляемогоЭлемента = УдаляемыеЭлементы[НомерУдаляемого-1];

		Для ИндексЭлемента=ИндексУдаляемогоЭлемента+1 По ИндексПоследнегоЭлемента Цикл
			ДанныеОбновленияЭлемента = ДанныеОбновленияЭлементов[ИндексЭлемента];
			ДанныеОбновленияЭлемента.Номер = ДанныеОбновленияЭлемента.Номер - НомерУдаляемого;
		КонецЦикла;
		
		Таблица.Удалить(ИндексУдаляемогоЭлемента);
		ДанныеОбновленияЭлементов.Удалить(ИндексУдаляемогоЭлемента);
		
		НомерУдаляемого = НомерУдаляемого - 1;
		ИндексПоследнегоЭлемента = ИндексУдаляемогоЭлемента - 1;
		
	КонецЦикла;
	
	УдалитьЭлементыСписка(ДанныеОбновленияТаблицы.НовыеЭлементы, Неопределено, УдаляемыеЭлементы);
	УдалитьЭлементыСписка(ДанныеОбновленияТаблицы.ИзмененныеЭлементы, ДанныеОбновленияТаблицы.ИзмененныеЭлементыВСписке, УдаляемыеЭлементы);
	УдалитьЭлементыСписка(ДанныеОбновленияТаблицы.ИзмененныеЭлементыДляКлиента, ДанныеОбновленияТаблицы.ИзмененныеЭлементыВСпискеДляКлиента, УдаляемыеЭлементы);
	
	
КонецФункции

Функция УдалитьЭлементыСписка(Список, ИндексыЭлементовСписка, УдаляемыеЭлементы)
	
	ИндексСписка = Список.Количество()-1;
	Если ИндексСписка < 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИндексСпискаУдаляемых = УдаляемыеЭлементы.Количество()-1;
	Если ИндексСпискаУдаляемых < 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Список = СортироватьМассив(Список);
	ИндексЭлемента = Список[ИндексСписка];
	
	ИндексУдаляемогоЭлемента = УдаляемыеЭлементы[ИндексСпискаУдаляемых];
	Пока Истина Цикл
		
		Если ИндексЭлемента=ИндексУдаляемогоЭлемента Тогда
			Список.Удалить(ИндексСписка);
			Если ИндексСпискаУдаляемых=0 Тогда
				Прервать;
			КонецЕсли;
			
			ИндексСпискаУдаляемых = ИндексСпискаУдаляемых - 1;
			ИндексУдаляемогоЭлемента = УдаляемыеЭлементы[ИндексСпискаУдаляемых];
		ИначеЕсли ИндексЭлемента > ИндексУдаляемогоЭлемента Тогда
			Список[ИндексСписка] = Список[ИндексСписка] - ИндексСпискаУдаляемых - 1;
		Иначе
			Если ИндексСпискаУдаляемых=0 Тогда
				Прервать;
			КонецЕсли;
			
			ИндексСпискаУдаляемых = ИндексСпискаУдаляемых - 1;
			ИндексУдаляемогоЭлемента = УдаляемыеЭлементы[ИндексСпискаУдаляемых];
			Продолжить;
		КонецЕсли;
		
		Если ИндексСписка=0 Тогда
			Прервать;
		КонецЕсли;
		
		ИндексСписка = ИндексСписка - 1;
		ИндексЭлемента = Список[ИндексСписка];
		
	КонецЦикла;
	
	Если ИндексыЭлементовСписка <> Неопределено Тогда
		ИндексыЭлементовСписка.Очистить();
		Для ИндексСписка=0 По Список.Количество()-1 Цикл
			ИндексыЭлементовСписка[Список[ИндексСписка]] = Истина;
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

Функция СортироватьМассив(Массив)
	
	ТаблицаСортировки = Новый ТаблицаЗначений;
	ТаблицаСортировки.Колонки.Добавить("Значение");
	Для Каждого Значение Из Массив Цикл
		ТаблицаСортировки.Добавить().Значение = Значение;
	КонецЦикла;
	ТаблицаСортировки.Сортировать("Значение");
	МассивОтсортированный = ТаблицаСортировки.ВыгрузитьКолонку(0);
	Возврат МассивОтсортированный;
	
КонецФункции

Функция ОбновитьПредставлениеТоваровВТаблице(Таблица, Элементы)
	
	Если Элементы.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭлементТаблицы = Таблица[0];
	КолонкиТаблицы = РК.ВыгрузитьЗначенияКолонкиКоллекции(Таблица.Колонки, "Имя");
	
	Если Таблица=ДанныеОбработки.Таблицы.ТаблицаФакт Тогда
		ТоварныеПоля = СписокПолейМодуля(Новый Структура("Группа", "Товар"));
	Иначе
		ТоварныеПоля = СписокПолейМодуля(Новый Структура("Группа, План", "Товар", Истина));
	КонецЕсли;
	ТоварныеПоля = РК.ПересечениеМассивов(ТоварныеПоля, КолонкиТаблицы);
	
	// не добавлять в представление поля, для которых есть отдельные колонки на форме, чтобы не дублировать
	РК.ВычестьМассив(ТоварныеПоля, "Контейнер, КонтейнерОтправитель, КонтейнерПриемник, Ячейка, ЯчейкаПриемник");

	Разделитель = ", ";
	ДлинаРазделителя = СтрДлина(Разделитель);
	
	Для Каждого ИндексЭлемента Из Элементы Цикл
		ЭлементТаблицы = Таблица[ИндексЭлемента];
		
		ПредставлениеТовара = "";
		Для Каждого ТоварноеПоле Из ТоварныеПоля Цикл
			ПредставлениеТовара = ПредставлениеТовара + ЭлементТаблицы[ТоварноеПоле] + Разделитель;
		КонецЦикла;
		ПредставлениеТовара = Лев(ПредставлениеТовара, СтрДлина(ПредставлениеТовара)-ДлинаРазделителя);
		ЭлементТаблицы.ПредставлениеТовара = ПредставлениеТовара;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция УстановитьОформлениеЭлементовТаблицыПланФакт(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт);
	
	ЦветФонаВыполнен = Новый Цвет(200, 255, 200);
	ЦветФонаОшибка = Новый Цвет(255, 200, 200);
	ЦветФонаВРаботе = Новый Цвет(255, 255, 200);
	ЦветФонаБезПлана = Новый Цвет(200, 200, 255);
	ЦветФонаОбычный = Новый Цвет;

	ДополнительныеДанныеЭлементов = ДанныеОбновленияТаблицыПланФакт.ДополнительныеДанныеЭлементов;
	
	Для Каждого ИндексЭлемента Из ДанныеОбновленияТаблицыПланФакт.ИзмененныеЭлементы Цикл
		
		ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов[ИндексЭлемента];

		ЭлементТаблицы = ТаблицаПланФакт[ИндексЭлемента];

		ЭлементТаблицы.Выполнен = ЭлементТаблицы.КоличествоФактИтого=ЭлементТаблицы.КоличествоПлан;
		Если ЭлементТаблицы.Выполнен Тогда
			Если ЭлементТаблицы.КоличествоПлан=0 Тогда
				ЦветФона = ЦветФонаБезПлана;
			Иначе
				ЦветФона = ЦветФонаВыполнен;
			КонецЕсли;
		ИначеЕсли ЭлементТаблицы.КоличествоФактИтого > ЭлементТаблицы.КоличествоПлан Тогда
			ЦветФона = ЦветФонаОшибка;
		ИначеЕсли ЭлементТаблицы.КоличествоФактИтого <> 0 Тогда
			ЦветФона = ЦветФонаВРаботе;
		Иначе
			ЦветФона = ЦветФонаОбычный;
		КонецЕсли;
		
		УстановитьОформлениеЭлементаТаблицы("ТаблицаПланФакт", ЭлементТаблицы, Новый Структура("ЦветФона", ЦветФона));
		
	КонецЦикла;
	
КонецФункции

Функция ПолучитьТаблицуПлана()

	ТаблицаПлан = ПараметрыОбработки.Задание.Товары.Выгрузить();
	ТаблицаПлан.Колонки.Добавить("ИдентификаторИнструкцииЗаполнен");
	ТаблицаПлан.Колонки.Добавить("ИдентификаторИнструкцииЗаполненРесурс");
	УдалитьСтрокиПлана = Новый Массив;
	Для Каждого СтрокаПлана Из ТаблицаПлан Цикл
		Если СтрокаПлана.ИдентификаторИнструкции=0 Тогда
			УдалитьСтрокиПлана.Добавить(СтрокаПлана);
			Продолжить;
		КонецЕсли;
		
		СтрокаПлана.ИдентификаторИнструкцииЗаполнен = СтрокаПлана.ИдентификаторИнструкции <> 0;
		СтрокаПлана.ИдентификаторИнструкцииЗаполненРесурс = ?(СтрокаПлана.ИдентификаторИнструкцииЗаполнен, 1, 0);
	КонецЦикла;
	РК.УдалитьЭлементыКоллекции(ТаблицаПлан, УдалитьСтрокиПлана);
	ТаблицаПлан.Сортировать("НомерСтроки");
	
	ТаблицаПлан.Колонки.НомерСтроки.Имя = "НомерИнструкции";
	ТаблицаПлан.Колонки.Номенклатура.Имя = "Товар";
	ЗначенияКолонкиКоличества = ТаблицаПлан.ВыгрузитьКолонку("Количество");
	ТаблицаПлан.Колонки.Добавить("КоличествоПлан"); ТаблицаПлан.ЗагрузитьКолонку(ЗначенияКолонкиКоличества, "КоличествоПлан");
	ТаблицаПлан.Колонки.Добавить("КоличествоРазмещено"); ТаблицаПлан.ЗагрузитьКолонку(ЗначенияКолонкиКоличества, "КоличествоРазмещено");
	ТаблицаПлан.Колонки.Добавить("КоличествоОтобрано"); ТаблицаПлан.ЗагрузитьКолонку(ЗначенияКолонкиКоличества, "КоличествоОтобрано");
	Если ПараметрыОбработки.Инвентаризация Тогда
		ТаблицаПлан.Колонки.Добавить("КоличествоУчет"); ТаблицаПлан.ЗагрузитьКолонку(ЗначенияКолонкиКоличества, "КоличествоУчет");
	КонецЕсли;
	
	Возврат ТаблицаПлан;
	
КонецФункции

Функция ПолучитьТаблицуФакт(УчитыватьТекущиеОперации=Истина, УчитыватьНулевыеОстатки=Ложь)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ОперацияПоЯчейкам_Ссылка КАК ОперацияПоЯчейкам,
	|	&ТаблицаТовары_ПоляЗапроса КАК ПоляЗапроса,
	|	&ТаблицаТовары_Количество КАК КоличествоФакт,
	|	ОперацияПоЯчейкам.Дата КАК Дата,
	|	ТаблицаТовары.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ТаблицаТовары
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам КАК ОперацияПоЯчейкам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.вмс_ОперацияПоЯчейкам.Товары КАК ТаблицаТовары
	|		ПО ОперацияПоЯчейкам.Ссылка = ТаблицаТовары.Ссылка
	|ГДЕ
	|	(&СсылкаНаЗадание <> ЗНАЧЕНИЕ(Документ.вмс_ЗаданиеКладовщику.ПустаяСсылка)
	|				И ОперацияПоЯчейкам.ЗаданиеКладовщику = &СсылкаНаЗадание
	|			ИЛИ ОперацияПоЯчейкам.Ссылка = &СсылкаНаОперациюПоЯчейкам)
	|	И ОперацияПоЯчейкам.Проведен
	|	И НЕ ОперацияПоЯчейкам.Ссылка В (&ИсключитьОперации)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТовары.ОперацияПоЯчейкам КАК ОперацияПоЯчейкам,
	|	ТаблицаТовары.ПоляЗапроса КАК ПоляЗапроса,
	|	СУММА(ТаблицаТовары.КоличествоФакт) КАК КоличествоФакт,
	|	МИНИМУМ(ТаблицаТовары.Дата) КАК Дата,
	|	МИНИМУМ(ТаблицаТовары.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Итог
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТовары.ОперацияПоЯчейкам,
	|	ТаблицаТовары.ПоляЗапроса";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОперацияПоЯчейкам.Товары", "ОперацияПоЯчейкам." + ПараметрыОбработки.ИмяТаблицыФакта);
	
	ДанныеОбновленияТаблицыФакт = ПараметрыТаблицы("ТаблицаФакт");
	
	ПутиКДаннымСохраненияПолей = ДанныеОбновленияТаблицыФакт.ПутиКДаннымСохраненияПолей;
	
	Если ПолеМодуля(Новый Структура("Имя, План, Ввод", "Упаковка", Истина, Истина)) <> ПустоеПолеОбработки Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТовары.Количество КАК КоличествоФакт", "ТаблицаТовары.КоличествоБазовыхЕдиниц КАК КоличествоФакт");
	КонецЕсли;
	
	Если ПараметрыОбработки.Инвентаризация Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОперацияПоЯчейкам_Ссылка", "ОперацияПоЯчейкам.Ссылка");

		Запрос.Текст = Запрос.Текст + 
		"
		|;
		|
		|"
		
		+
		
		"ВЫБРАТЬ
		|	ТаблицаТовары.ПоляЗапроса КАК ПоляЗапроса,
		|	МАКСИМУМ(ТаблицаТовары.ОперацияПоЯчейкам) КАК ОперацияПоЯчейкам
		|ПОМЕСТИТЬ ВТ_ИтогДляИнвентаризации
		|ИЗ
		|	ВТ_Итог КАК ТаблицаТовары
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаТовары.ПоляЗапроса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаТовары.ПоляЗапроса КАК ПоляЗапроса,
		|	СУММА(ТаблицаТовары.КоличествоФакт) КАК КоличествоФакт,
		|	МИНИМУМ(ТаблицаТовары.Дата) КАК Дата,
		|	МИНИМУМ(ТаблицаТовары.НомерСтроки) КАК НомерСтроки
		|ИЗ
		|	ВТ_Итог КАК ТаблицаТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ИтогДляИнвентаризации КАК ВТ_ИтогДляИнвентаризации
		|		ПО ТаблицаТовары.ПоляЗапроса = ВТ_ИтогДляИнвентаризации.ПоляЗапроса
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаТовары.ПоляЗапроса";

		ПоляЗапросаДляСоединенияМассив = Новый Массив;
		ПоляЗапросаДляСоединенияМассив.Добавить("ТаблицаТовары.ОперацияПоЯчейкам = ВТ_ИтогДляИнвентаризации.ОперацияПоЯчейкам");
		Для Каждого ЭлементПутьКДанным Из ПутиКДаннымСохраненияПолей Цикл
			ИмяПоля = ЭлементПутьКДанным.ИмяРеквизита;
			ПоляЗапросаДляСоединенияМассив.Добавить("ТаблицаТовары." + ИмяПоля + " = ВТ_ИтогДляИнвентаризации." + ИмяПоля);
		КонецЦикла;

		Если ПоляЗапросаДляСоединенияМассив.Количество() > 0 Тогда
			ПоляЗапросаДляСоединения = РК.МассивВСтроку(ПоляЗапросаДляСоединенияМассив, Символы.ПС + Символы.Таб + "И ");
		Иначе
			ПоляЗапросаДляСоединения = "ИСТИНА";
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТовары.ПоляЗапроса = ВТ_ИтогДляИнвентаризации.ПоляЗапроса", ПоляЗапросаДляСоединения);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОперацияПоЯчейкам_Ссылка", "НЕОПРЕДЕЛЕНО");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ ВТ_Итог" + Символы.ПС, "");
	КонецЕсли;
	
	Если НЕ УчитыватьНулевыеОстатки Тогда
		Запрос.Текст = Запрос.Текст +
		"
		|
		|ИМЕЮЩИЕ
		|	СУММА(ТаблицаТовары.КоличествоФакт) <> 0";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст +
	"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	НомерСтроки";
	
	ПоляЗапросаМассив = Новый Массив;
	Для Каждого ЭлементПутьКДанным Из ПутиКДаннымСохраненияПолей Цикл
		ПутьКДанным = ЭлементПутьКДанным.ПутьКДанным;
		ПутьКДанным = СтрЗаменить(ПутьКДанным, "ОперацияПоЯчейкам." + ПараметрыОбработки.ИмяТаблицыФакта, "ТаблицаТовары");
		ПоляЗапросаМассив.Добавить(ПутьКДанным);
	КонецЦикла;
	
	Если ПоляЗапросаМассив.Количество() > 0 Тогда
		ПоляЗапроса = РК.МассивВСтроку(ПоляЗапросаМассив, "," + Символы.ПС + Символы.Таб);
	Иначе
		ПоляЗапроса = "НЕОПРЕДЕЛЕНО КАК ПустоеПоле";
	КонецЕсли;
	
	ПланПоУпаковкам = ДанныеОбработки.ЗапланированныеДанныеПолей.Свойство("Упаковка");
	ПолеКоличества = ?(ПланПоУпаковкам, "Количество", "КоличествоБазовыхЕдиниц");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТаблицаТовары_ПоляЗапроса КАК ПоляЗапроса", ПоляЗапроса);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТаблицаТовары_Количество КАК КоличествоФакт", "ТаблицаТовары." + ПолеКоличества + " КАК КоличествоФакт");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТовары.ПоляЗапроса КАК ПоляЗапроса", ПоляЗапроса);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТовары.ПоляЗапроса", ПоляЗапроса);
	
	Запрос.УстановитьПараметр("СсылкаНаЗадание", ПараметрыОбработки.СсылкаНаЗадание);
	Запрос.УстановитьПараметр("СсылкаНаОперациюПоЯчейкам", ДанныеОбработки.СсылкаОперацииПоЯчейкам);
	Если УчитыватьТекущиеОперации Тогда
		Запрос.УстановитьПараметр("ИсключитьОперации", Новый Массив);
	Иначе
		Запрос.УстановитьПараметр("ИсключитьОперации", ДанныеОбработки.СсылкаОперацииПоЯчейкам);
	КонецЕсли;
	
	ТаблицаФакт = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаФакт;
	
КонецФункции

#КонецОбласти

