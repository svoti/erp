Функция ИнициализироватьСвойстваОперации()
	
	Задание = ПараметрыОбработки.Задание;

	ПараметрыМодуля.Вставить("ПревышениеКоличестваПоПлану", "Запретить");
	ПараметрыМодуля.Вставить("АвтоПереходКСледующейИнструкции", Ложь);
	ПараметрыМодуля.Вставить("РазрешитьВводДанныхБезПлана", Ложь);
	ПараметрыМодуля.Вставить("СоздаватьНовуюСерию", Ложь);
	
	Если ЗначениеЗаполнено(Задание.Правило) Тогда
		Правило = Задание.Правило.ПолучитьОбъект();
		Правило.Прочитать();
		ПараметрыМодуля.СоздаватьНовуюСерию = НЕ Правило.ПодбиратьЯчейкиОтправители;
	КонецЕсли;
	
	//ТУ_КС для совместимости+
	Попытка
		Если Задание.РазрешитьПревышениеКоличества Тогда
			ПараметрыМодуля.ПревышениеКоличестваПоПлану = "Предупредить";
		КонецЕсли;
	Исключение
	КонецПопытки;
	//ТУ_КС для совместимости-

	СвойстваОперации = СвойстваОперации(Задание);
	Если СвойстваОперации.Свойство("ПревышениеКоличестваПоПлану") Тогда
		ПараметрыМодуля.ПревышениеКоличестваПоПлану = СвойстваОперации.ПревышениеКоличестваПоПлану;
	Иначе
		Если СвойстваОперации.Свойство("РазрешитьПревышениеКоличестваТовара") И СвойстваОперации.РазрешитьПревышениеКоличестваТовара=Истина Тогда
			ПараметрыМодуля.ПревышениеКоличестваПоПлану = "Предупредить";
		КонецЕсли;
	КонецЕсли;
	
	Если СвойстваОперации.Свойство("АвтоПереходКСледующейИнструкции") Тогда
		ПараметрыМодуля.АвтоПереходКСледующейИнструкции = СвойстваОперации.АвтоПереходКСледующейИнструкции=Истина;
	КонецЕсли;
		
	Если СвойстваОперации.Свойство("РазрешитьВводДанныхБезПлана") Тогда
		ПараметрыМодуля.РазрешитьВводДанныхБезПлана = СвойстваОперации.РазрешитьВводДанныхБезПлана=Истина;
	Иначе
		Если СвойстваОперации.Свойство("РазрешитьВводОтсутствующегоТовара") И СвойстваОперации.РазрешитьВводОтсутствующегоТовара=Истина Тогда
			ПараметрыМодуля.РазрешитьВводДанныхБезПлана = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

Функция СвойстваОперации(Задание)
	
	СвойстваОперации = Новый Структура;
	Свойства = Задание.ДополнительныеРеквизиты.ВыгрузитьКолонку("Свойство");
	Если Свойства.Количество()=0 Тогда
		Возврат СвойстваОперации;
	КонецЕсли;
	
	ТаблицаРеквизитовСвойств = вмс_ОбщегоНазначенияСервер.ПолучитьРеквизитыОбъектов(Свойства, "Ссылка, Имя");
	
	Поиск = Новый Структура("Свойство");
	Для Каждого РеквизитыСвойства Из ТаблицаРеквизитовСвойств Цикл
		Поиск.Свойство = РеквизитыСвойства.Ссылка;
		ЗначениеСвойстваМассив = Задание.ДополнительныеРеквизиты.НайтиСтроки(Поиск);
		Если ЗначениеСвойстваМассив.Количество() > 0 Тогда
			СвойстваОперации.Вставить(РеквизитыСвойства.Имя, ЗначениеСвойстваМассив[0].Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СвойстваОперации;
	
КонецФункции

Функция ИнициализироватьТаблицуПланФакт()
	
	// настроим колонки таблицы
	ПоляИнструкцийМассив = Новый Массив;
	
	ТаблицаВычисленийЗначенийПолей = Обработки.вмс_СерверУправляемыйМодульСтандартный.ПолучитьТаблицыВычисленийЗначенийПолей(ПараметрыМодуля).ТаблицаВычисленийЗначенийПолей.Скопировать(Новый Структура("Путь", "Задание.Товары"));
	
	Для Каждого ЭлементВычисления Из ТаблицаВычисленийЗначенийПолей Цикл
		ИмяРеквизита = ЭлементВычисления.Имя;
		ПоляИнструкцийМассив.Добавить(ИмяРеквизита);
	КонецЦикла;
	
	РК.ДобавитьЭлементыКоллекции(ПоляИнструкцийМассив, "ПредставлениеТовара, Выполнен, НомерИнструкции, ИдентификаторИнструкции, ИдентификаторИнструкцииДляПоиска, КоличествоПлан, КоличествоФактИтогоВТаблице, КоличествоФактИтого, КоличествоФактЗаполнено, ИдентификаторИнструкцииЗаполненРесурс");
	Если ПараметрыОбработки.Инвентаризация Тогда
		РК.ДобавитьЭлементыКоллекции(ПоляИнструкцийМассив, "КоличествоУчет");
	КонецЕсли;
	РК.УдалитьДублиВМассиве(ПоляИнструкцийМассив);

	ТаблицаПланФакт = РК.НоваяТаблицаЗначений(ПоляИнструкцийМассив);
	ТаблицаПланФакт.Индексы.Добавить("ИдентификаторИнструкцииЗаполнен, ИдентификаторИнструкции");
	ТаблицаПланФакт.Индексы.Добавить("ИдентификаторИнструкцииДляПоиска");
	
	// настроим вывод таблицы на клиенте
	НастраиваемыеКолонкиВывода = "Контейнер, КонтейнерОтправитель, КонтейнерПриемник, Ячейка, ЯчейкаПриемник";

	ПоляВыводаНачальные = РК.ПересечениеМассивов(ПоляИнструкцийМассив, СписокПолейМодуля(Новый Структура("План, Вывод", Истина, Истина)));
	
	ПоляВывода = Новый Массив;
	Если ПоляВыводаНачальные.Найти("Товар") <> Неопределено Тогда
		ПоляВывода.Добавить("ПредставлениеТовара");
	КонецЕсли;
	
	РК.ДобавитьЭлементыКоллекции(ПоляВывода, РК.ПересечениеМассивов(ПоляВыводаНачальные, НастраиваемыеКолонкиВывода));
	
	Если ПоляВыводаНачальные.Найти("КоличествоПлан") <> Неопределено Тогда
		РК.ДобавитьЭлементыКоллекции(ПоляВывода, "КоличествоПлан");
		РК.ДобавитьЭлементыКоллекции(ПоляВывода, "КоличествоФактИтогоВТаблице");
	КонецЕсли;

	РК.УдалитьДублиВМассиве(ПоляВывода);

	ПараметрыТаблицыПланФакт = УстановитьТаблицуОбработки("ТаблицаПланФакт", ТаблицаПланФакт, Истина, ПоляВывода);
	ПараметрыТаблицыПланФакт.Вставить("ИдентификаторНовойИнструкции", 1);
	Ресурсы = Новый Структура("КоличествоПлан, КоличествоФактИтого, КоличествоФактЗаполнено, ИдентификаторИнструкцииЗаполненРесурс", 0, 0, 0, 0);
	ПараметрыТаблицыПланФакт.Ресурсы = Ресурсы;
	
КонецФункции

Функция НастроитьПутиКДаннымЗаполненияПолейТаблицыПланФакт()
	
	ПутиКДаннымЗаполненияПолей = ПрочитатьПутиКДаннымПолей("ПутьКДаннымЗаполнения", Новый Структура("Использование", Истина));
	ТаблицаПутейПолей = ПутиКДаннымЗаполненияПолей.Скопировать(Новый Структура("ПутьРеквизита, Раунд", "Задание.Товары", 1));
	ТаблицаПутейПолей.Свернуть("ИмяПоля");
	ИменаПолей = ТаблицаПутейПолей.ВыгрузитьКолонку("ИмяПоля");
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ПутиКДаннымЗаполненияПоля = ПутиКДаннымЗаполненияПолей.НайтиСтроки(Новый Структура("ИмяПоля", ИмяПоля));
		Для Каждого ПутьКДаннымЗаполненияПоля Из ПутиКДаннымЗаполненияПоля Цикл
			ПутьКДаннымЗаполненияПоля.Поиск = ПутьКДаннымЗаполненияПоля.ИмяПоля="ИдентификаторИнструкцииДляПоиска";
		КонецЦикла;
	КонецЦикла;
	
	ЗаписатьПутиКДаннымПолей("ПутьКДаннымЗаполнения", ПутиКДаннымЗаполненияПолей);
	
КонецФункции

Функция ИнициализироватьТаблицуФакт()
	
	ИмяТаблицыФакта = ПараметрыОбработки.ИмяТаблицыФакта;
	
	ПутиКДаннымСохраненияПолей = ПрочитатьПутиКДаннымПолей("ПутьКДаннымСохранения", Новый Структура("Сборка, Ресурс", Истина, Ложь)).Скопировать(Новый Структура("ПутьРеквизита", "ОперацияПоЯчейкам." + ИмяТаблицыФакта));
	ПоляФакта = РК.ВыгрузитьЗначенияКолонкиКоллекции(ПутиКДаннымСохраненияПолей, "ИмяРеквизита");
	РК.ДобавитьЭлементыКоллекции(ПоляФакта, "ПредставлениеТовара, ИдентификаторИнструкцииЗаполнен, ИдентификаторИнструкции, ИдентификаторИнструкцииДляПоиска, КоличествоФакт");

	//
	НастраиваемыеКолонкиВывода = "Контейнер, КонтейнерОтправитель, КонтейнерПриемник, Ячейка, ЯчейкаПриемник";
	ПоляВывода = Новый Массив;
	ПутиКДаннымСохраненияПолей = ПрочитатьПутиКДаннымПолей("ПутьКДаннымСохранения", Новый Структура("Сборка, Вывод", Истина, Истина)).Скопировать(Новый Структура("ПутьРеквизита", "ОперацияПоЯчейкам." + ИмяТаблицыФакта));
	ПоляФактаВывод = РК.ВыгрузитьЗначенияКолонкиКоллекции(ПутиКДаннымСохраненияПолей, "ИмяРеквизита");
	РК.ДобавитьЭлементыКоллекции(ПоляВывода, РК.ПересечениеМассивов(ПоляФактаВывод, НастраиваемыеКолонкиВывода));
	Если ПоляФактаВывод.Найти("Товар") <> Неопределено Тогда
		РК.ДобавитьЭлементыКоллекции(ПоляВывода, "ПредставлениеТовара");
	КонецЕсли;
	Если ПоляФактаВывод.Найти("Количество") <> Неопределено Тогда
		РК.ДобавитьЭлементыКоллекции(ПоляВывода, "КоличествоФакт");
	КонецЕсли;
	
	ПутиКДаннымСохраненияПолей = ПрочитатьПутиКДаннымПолей("ПутьКДаннымСохранения", Новый Структура("Сборка, Ресурс", Истина, Ложь)).Скопировать(Новый Структура("ПутьРеквизита", "ОперацияПоЯчейкам." + ИмяТаблицыФакта));
	ПутиКДаннымСохраненияПолей.Колонки.Удалить("Поле");

	ПараметрыТаблицыФакт = УстановитьТаблицуОбработки("ТаблицаФакт", ПоляФакта, Истина, ПоляВывода);
	ПараметрыТаблицыФакт.Ресурсы = Новый Структура("КоличествоФакт", 0);
	ПараметрыТаблицыФакт.Вставить("ПутиКДаннымСохраненияПолей", ПутиКДаннымСохраненияПолей);
	
КонецФункции

Функция ИнициализироватьТаблицуМодификацииПолейИнструкцийЗадания()
	
	ТаблицаМодификацииПолейИнструкцийЗадания = РК.НоваяТаблицаЗначений("ИдентификаторИнструкции, ИмяПоля, ИмяСвойства, ЗначениеСвойства");
	ТаблицаМодификацииПолейИнструкцийЗадания.Индексы.Добавить("ИдентификаторИнструкции, ИмяПоля");
	УстановитьТаблицуОбработки("ТаблицаМодификацииПолейИнструкцийЗадания", ТаблицаМодификацииПолейИнструкцийЗадания, Ложь);
	
КонецФункции

