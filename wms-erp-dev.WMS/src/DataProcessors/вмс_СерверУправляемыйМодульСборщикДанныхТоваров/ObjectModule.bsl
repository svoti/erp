	УстановитьПоляОбработкиДляИнструкцииЗадания(ИдентификаторИнструкции);
	
	СборщикДанныхСтандартный.ЗаполнитьДанныеПолей();
	
КонецФункции

Функция НайтиИнструкцию(Отбор, ИдентификаторТекушейИнструкции)

	Перем НаправлениеПоиска;
	
	ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;
	
	НачальныйИндекс = 0;
	Если ИдентификаторТекушейИнструкции <> 0 Тогда
		ТекущаяИнструкцияМассив = ТаблицаПланФакт.НайтиСтроки(Новый Структура("ИдентификаторИнструкцииДляПоиска", ИдентификаторТекушейИнструкции));
		Если ТекущаяИнструкцияМассив.Количество() > 0 Тогда
			НачальныйИндекс = ТаблицаПланФакт.Индекс(ТекущаяИнструкцияМассив[0]);
		КонецЕсли;
	КонецЕсли;
	
	КонечныйИндекс = ТаблицаПланФакт.Количество()-1;
	
	ПоляОбработкиИнструкцийЗаданияДляПоиска = ПараметрыМодуля.ПоляОбработкиИнструкцийЗаданияДляПоиска;
	ИдентификаторВыполненнойИнструкции = 0;
	ПодходитИнструкцияДляВвода = Ложь;
	ИдентификаторИнструкцииБезПлана = 0;
	ДополнительныеДанныеЭлементовТаблицы = ПараметрыТаблицы("ТаблицаПланФакт").ДополнительныеДанныеЭлементов;
	Для НаправлениеПоиска=1 По 2 Цикл
		
		Для Индекс=НачальныйИндекс По КонечныйИндекс Цикл
			ДополнительныеДанныеЭлементаТаблицы = ДополнительныеДанныеЭлементовТаблицы[Индекс];
			
			ИнструкцияЗадания = ТаблицаПланФакт[Индекс];
			Выполнен = ИнструкцияЗадания.Выполнен;
			Если Выполнен И ИдентификаторВыполненнойИнструкции <> 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ИдентификаторИнструкции = ИнструкцияЗадания.ИдентификаторИнструкцииДляПоиска;
			
			ПоляОбработкиИнструкцииЗаданияДляПоиска = ПоляОбработкиИнструкцийЗаданияДляПоиска[ИдентификаторИнструкции];
			
			ИнструкцияПодходитПоОтбору = Истина;
			Для Каждого ПолеОтбора Из Отбор Цикл
				
				Если ПоляОбработкиИнструкцииЗаданияДляПоиска[ПолеОтбора.Ключ]=Истина Тогда
					
					Если ИнструкцияЗадания[ПолеОтбора.Ключ] <> ПолеОтбора.Значение Тогда
						ИнструкцияПодходитПоОтбору = Ложь;
						Прервать;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ИнструкцияПодходитПоОтбору Тогда
				ИдентификаторИнструкцииЗаполнен = ИнструкцияЗадания.ИдентификаторИнструкцииЗаполнен;
				Если ИдентификаторИнструкции=ИдентификаторТекушейИнструкции Тогда
					Если ИдентификаторИнструкцииЗаполнен Тогда
						Возврат ИдентификаторИнструкции;
					КонецЕсли;
				КонецЕсли;
				
				Если Выполнен Тогда
					Если ИдентификаторВыполненнойИнструкции=0 Тогда
						ИдентификаторВыполненнойИнструкции = ИдентификаторИнструкции;
					КонецЕсли;
				ИначеЕсли НЕ ИдентификаторИнструкцииЗаполнен Тогда
					ИдентификаторИнструкцииБезПлана = ИдентификаторИнструкции;
				Иначе
					Возврат ИдентификаторИнструкции;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		КонечныйИндекс = НачальныйИндекс-1;
		НачальныйИндекс = 0; //теперь ищем сначала
		
	КонецЦикла;
	
	Если ИдентификаторВыполненнойИнструкции <> 0 Тогда
		Возврат ИдентификаторВыполненнойИнструкции;
	КонецЕсли;
	
	Если ИдентификаторИнструкцииБезПлана <> 0 Тогда
		Возврат ИдентификаторИнструкцииБезПлана;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ЗаполнитьТекущееКоличество()
	
	ЗапланированныеДанныеПолей = ДанныеТранзакции.ЗапланированныеДанныеПолей;
	ОбщиеДанныеПолей = ДанныеТранзакции.ОбщиеДанныеПолей;
	ВведенныеДанныеПолей = ДанныеТранзакции.ВведенныеДанныеПолей;
	
	ПоляПоискаМассив = СписокПолейМодуля(Новый Структура("Сборка, Ресурс", Истина, Ложь));
	ПоляПоиска = РК.МассивВСтроку(ПоляПоискаМассив);
	Поиск = Новый Структура(ПоляПоиска);
	ЗаполнитьЗначенияСвойств(Поиск, ОбщиеДанныеПолей);
	НайденныеЭлементыФакта = ДанныеОбработки.Таблицы.ТаблицаФакт.НайтиСтроки(Поиск);
	Если НайденныеЭлементыФакта.Количество() > 0 Тогда
		Количество0 = НайденныеЭлементыФакта[0].КоличествоФакт;
	Иначе
		Количество0 = 0;
	КонецЕсли;
	
	КоличествоПлан = ЗапланированныеДанныеПолей.КоличествоПлан;
	КоличествоФактИтого = ЗапланированныеДанныеПолей.КоличествоФактИтого;
	
	ПоляКоличеств = ПоляМодуля(Новый Структура("Сборка, Группа", Истина, "Количество"));
	ПолеВводаКоличества = Неопределено;
	
	НеЗаполненныеПоляМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.НеЗаполненныеПоляМассив;
	ИмяПоляДляВвода = ?(НеЗаполненныеПоляМассив.Количество() > 0, НеЗаполненныеПоляМассив[0], Неопределено);
	
	Для Каждого ПолеКоличества Из ПоляКоличеств Цикл
		
		ИмяПоляКоличество = ПолеКоличества.Имя;
		ИмяПоляКоличество0 = "Количество0" + ПолеКоличества.Суффикс;
		ИмяПоляЗавершениеВводаКоличества = "ЗавершениеВводаКоличества" + ПолеКоличества.Суффикс;

		ОбщиеДанныеПолей[ИмяПоляКоличество0] = Количество0;

		Если НЕ ВведенныеДанныеПолей.Свойство(ИмяПоляЗавершениеВводаКоличества) Тогда
			//подтверждение ввода не требуется
			ОбщиеДанныеПолей[ИмяПоляЗавершениеВводаКоличества] = Истина;
		КонецЕсли;
		
		Если НЕ ПолеКоличества.Ввод Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеВводаКоличества = ПолеКоличества;
		ВведенныеДанныеПолей[ИмяПоляКоличество0] = Количество0;

		Количество = ВведенныеДанныеПолей[ИмяПоляКоличество];
		Если Количество=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗавершениеВводаКоличества = ВведенныеДанныеПолей[ИмяПоляЗавершениеВводаКоличества];

		ТипВводаКоличества = ВведенныеДанныеПолей["ТипВводаКоличества" + ПолеВводаКоличества.Суффикс];
		
		Если НЕ ЗавершениеВводаКоличества Тогда
			Если ПараметрыМодуля.АвтоПереходКСледующейИнструкции И КоличествоПлан <> 0 И ТипВводаКоличества=ТипыВводаКоличества.Добавить И ИмяПоляДляВвода=ИмяПоляКоличество Тогда
				ИзменениеКоличества = Количество;
				//Если ТипВводаКоличества=ТипыВводаКоличества.Установить Тогда
				//	ИзменениеКоличества = ИзменениеКоличества - Количество0;
				//КонецЕсли;
				
				Если КоличествоФактИтого+ИзменениеКоличества=КоличествоПлан Тогда
					//введено количество по плану
					ЗавершениеВводаКоличества = Истина;
				КонецЕсли;
			КонецЕсли;

			Если ЗавершениеВводаКоличества Тогда
				ВведенныеДанныеПолей[ИмяПоляЗавершениеВводаКоличества] = ЗавершениеВводаКоличества;
				ОбщиеДанныеПолей[ИмяПоляЗавершениеВводаКоличества] = ЗавершениеВводаКоличества;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗавершениеВводаКоличества Тогда
			//сформировать план для следующего количественного поля по текущему полю
			КоличествоПлан = Количество;
			Если ТипВводаКоличества=ТипыВводаКоличества.Добавить Тогда
				КоличествоПлан = КоличествоПлан + ВведенныеДанныеПолей[ИмяПоляКоличество0];
			КонецЕсли;
		Иначе
			//для общих данных (которые далее попадут в собранные) ввод считается завершенным при добавление любого количества
			//чтобы при вводе штуки данные сразу же сохранялись в базу
			Если ТипВводаКоличества=ТипыВводаКоличества.Добавить И Количество <> 0 Тогда
				ОбщиеДанныеПолей[ИмяПоляЗавершениеВводаКоличества] = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПолеВводаКоличества <> Неопределено Тогда
		
		ПолеКоличества = ПолеМодуля("Количество");
		Если ПолеКоличества <> ПустоеПолеОбработки И НЕ ПолеКоличества.Ввод Тогда
			//заполним поле "Количество" из другого поля количественного поля
			ОбщиеДанныеПолей.Количество0 				= ВведенныеДанныеПолей["Количество0" + ПолеВводаКоличества.Суффикс];
			ОбщиеДанныеПолей.ТипВводаКоличества			= ВведенныеДанныеПолей["ТипВводаКоличества" + ПолеВводаКоличества.Суффикс];
			ОбщиеДанныеПолей.ЗавершениеВводаКоличества	= ОбщиеДанныеПолей["ЗавершениеВводаКоличества" + ПолеВводаКоличества.Суффикс];
			
			ОбщиеДанныеПолей.Количество					= ВведенныеДанныеПолей[ПолеВводаКоличества.Имя];
		КонецЕсли;
		
	КонецЕсли;
	
	Интерфейс.ПроанализироватьЗаполнениеПолейДанных("ВведенныеДанныеПолей, ОбщиеДанныеПолей");
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьПодсказку()

	Если НЕ ПолеВыводится("Подсказка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПредставлениеДанныхПолей = ДанныеТранзакции.ПредставлениеДанныхПолей;

	Если ОжидаетсяПодтверждениеДанных() Тогда
		ПредставлениеДанныхПолей.Подсказка = "<подтвердите данные>";
		УстановитьСвойстваЭлементовВывода("Подсказка", "ЦветФона", Новый Цвет(200, 255, 200));
		Возврат Истина;
	КонецЕсли;
	
	НеЗаполненныеПоляВводаМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.НеЗаполненныеПоляМассив;
	НеЗаполненныеПоляСборкиМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхСборки.НеЗаполненныеПоляМассив;
	
	НеВведеноПолеВвода = Ложь;
	Для Каждого ИмяПоля Из НеЗаполненныеПоляСборкиМассив Цикл
		Если НеЗаполненныеПоляВводаМассив.Найти(ИмяПоля) <> Неопределено Тогда
			//еще не введено
			Продолжить;
		КонецЕсли;
		
		Если ИмяПоля="Количество" Тогда
			Если КоличествоВводится() Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Поле = ПолеМодуля(ИмяПоля);
		Если Поле.Ввод Тогда
			//ввод необязателен, но поле может быть введено
			//предложим ввести
			НеВведеноПолеВвода = Истина;
			НеЗаполненноеПоле = ИмяПоля;
		Иначе
			//поле не вводится и незаполнено, проблема в настройке заданиия кладовщику
			//это приоритетная ошибка, отобразим ее
			НеЗаполненноеПоле = ИмяПоля;
		КонецЕсли;
		
		Прервать;
	КонецЦикла;
	
	Если НеЗаполненноеПоле=Неопределено Тогда
		Если НеЗаполненныеПоляВводаМассив.Количество() > 0 Тогда
			НеЗаполненноеПоле = НеЗаполненныеПоляВводаМассив[0];
			НеВведеноПолеВвода = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НеЗаполненноеПоле=Неопределено Тогда
		ПредставлениеДанныхПолей.Подсказка = "";
		УстановитьСвойстваЭлементовВывода("Подсказка", "ЦветФона", Новый Цвет);
		Возврат Истина;
	КонецЕсли;

	Поле = ПолеМодуля(НеЗаполненноеПоле);
	
	//ПроигратьЗвукСхемы(НеЗаполненноеПоле);
	
	Если НеВведеноПолеВвода Тогда
		Если ЗначениеЗаполнено(Поле.СинонимВинительныйПадеж) Тогда
			Синоним = Поле.СинонимВинительныйПадеж;
		ИначеЕсли ЗначениеЗаполнено(Поле.Синоним) Тогда
			Синоним = Поле.Синоним;
		Иначе
			Синоним = Поле.Имя;
		КонецЕсли;
		Синоним = нрег(Синоним);
		Подсказка = "<введите " + Синоним + ">";
		ПредставлениеДанныхПолей.Подсказка = Подсказка;
		УстановитьСвойстваЭлементовВывода("Подсказка", "ЦветФона", Новый Цвет);
	Иначе
		Если ЗначениеЗаполнено(Поле.Синоним) Тогда
			Синоним = Поле.Синоним;
		Иначе
			Синоним = Поле.Имя;
		КонецЕсли;
		
		Если Поле.Пол="Мужской" Тогда
			Подсказка = "не заполнен"
		ИначеЕсли Поле.Пол="Женский" Тогда
			Подсказка = "не заполнена"
		Иначе
			Подсказка = "не заполнено"
		КонецЕсли;
		
		Синоним = нрег(Синоним);
		Подсказка = "<" + Подсказка + " " + Синоним + ">";
		ПредставлениеДанныхПолей.Подсказка = Подсказка;
		УстановитьСвойстваЭлементовВывода("Подсказка", "ЦветФона", Новый Цвет(255, 200, 200));
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ОжидаетсяПодтверждениеДанных()

	НеЗаполненныеПоляВводаМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.НеЗаполненныеПоляМассив;
	ЗаполненныеПоляВводаМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.ЗаполненныеПоляМассив;
	
	Если НеЗаполненныеПоляВводаМассив.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяПоля = НеЗаполненныеПоляВводаМассив[0];
	Если НЕ ИмяПоля="Количество" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗаполненныеПоляВводаМассив.Найти(ИмяПоля)=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Поле = ПолеМодуля(ИмяПоля);
	Если Поле.Ввод ИЛИ Поле.Вывод Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция ЗаполнитьПредставлениеДанныхПолей() Экспорт
	
	СборщикДанныхСтандартный.ЗаполнитьПредставлениеДанныхПолей();

	ЗаполнитьПодсказку();
	
	////
	ДанныеЗаполнения = ДанныеТранзакции;
	
	НеЗаполненныеПоляОбщихДанныхМассив = ДанныеЗаполнения.РезультатАнализаЗаполненияПолейОбщихДанных.НеЗаполненныеПоляМассив;
	
	ВведенныеДанныеПолей = ДанныеЗаполнения.ВведенныеДанныеПолей;
	ОбщиеДанныеПолей = ДанныеЗаполнения.ОбщиеДанныеПолей;
	ПредставлениеДанныхПолей = ДанныеЗаполнения.ПредставлениеДанныхПолей;
	
	ЗаполненныеПоляВводаМассив = ДанныеЗаполнения.РезультатАнализаЗаполненияПолейДанныхВвода.ЗаполненныеПоляМассив;

	ЦветФонаПоляНеЗаполнено = Новый Цвет(255, 100, 100);
	
	Для Каждого Поле Из ПоляВывода() Цикл
		
		ИмяПоля = Поле.Имя;
		ЭлементВывода = СтандартныйМодуль.ПолучитьЭлементВыводаДляПоляОбработки(Поле.ИмяЭлементаВывода, Поле);
		
		Если Поле.Ввод И Поле.Группа="Количество" Тогда
			
			//поле ввода количества
			Если ЗаполненныеПоляВводаМассив.Найти(ИмяПоля) <> Неопределено Тогда
				Значение = ВведенныеДанныеПолей[ИмяПоля];
				Если ВведенныеДанныеПолей["ТипВводаКоличества" + Поле.Суффикс]=ТипыВводаКоличества.Добавить Тогда
					//отобразим полное количество
					Значение = Значение + ВведенныеДанныеПолей["Количество0" + Поле.Суффикс];
				КонецЕсли;
			Иначе
				Значение = ОбщиеДанныеПолей["Количество0" + Поле.Суффикс];
			КонецЕсли;
			
			ПредставлениеДанныхПолей[ИмяПоля] = Значение;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИмяПоля = "КоличествоПлан";
	Если ПредставлениеДанныхПолей.Свойство(ИмяПоля) И ОбщиеДанныеПолей.Свойство(ИмяПоля) И ОбщиеДанныеПолей.Свойство("КоличествоФактИтого") Тогда
		КоличествоПлан = ОбщиеДанныеПолей[ИмяПоля];
		КоличествоФактИтого = ОбщиеДанныеПолей["КоличествоФактИтого"];
		МассивСтрок = Новый Массив;
		Если ЗначениеЗаполнено(КоличествоПлан) Тогда
			МассивСтрок.Добавить("План: " + КоличествоПлан);
		Иначе
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока("<товара нет в плане>", , , Новый Цвет(255, 200, 200)));
		КонецЕсли;

		МассивСтрок.Добавить(", Факт всего: " + КоличествоФактИтого);
		ПредставлениеДанныхПолей[ИмяПоля] = Новый ФорматированнаяСтрока(МассивСтрок);
	КонецЕсли;
	
	
	УстановитьСвойстваКнопкиДальше();
	
	Возврат ПредставлениеДанныхПолей;
	
КонецФункции

Функция УстановитьСвойстваКнопкиДальше()

	КнопкаДалее = ЭлементВывода("КнопкаДалее");
	Если КнопкаДалее=ПустойЭлементВывода Тогда
		//нет такой бук.. кнопки
		Возврат Ложь;
	КонецЕсли;
	
	ОбщиеДанныеПолей = ДанныеТранзакции.ОбщиеДанныеПолей;
	Если ОбщиеДанныеПолей.Свойство("КоличествоПлан") И ОбщиеДанныеПолей.Свойство("КоличествоФактИтого")
		И ОбщиеДанныеПолей.КоличествоПлан <> 0
		И ОбщиеДанныеПолей.КоличествоПлан=ОбщиеДанныеПолей.КоличествоФактИтого Тогда
		ЦветФона = Новый Цвет(62, 175, 118);
		Если НЕ ПараметрыМодуля.АнимацияКнопкиДалееУстановлена Тогда
			УстановитьАнимациюВводЗавершен();
			СтандартныйМодуль.ЗаморозитьТаймеры(2000);
			ПараметрыМодуля.АнимацияКнопкиДалееУстановлена = Истина;
		КонецЕсли;
	Иначе
		ЦветФона = Новый Цвет(125, 125, 118);
	КонецЕсли;
	
	УстановитьСвойстваЭлементовВывода(КнопкаДалее, Новый Структура("ЦветФона", ЦветФона));
	
	Если ОжидаетсяПодтверждениеДанных() Тогда
		УстановитьСвойстваЭлементовВывода(КнопкаДалее, "Заголовок", "Подтвердить");
	Иначе
		УстановитьСвойстваЭлементовВывода(КнопкаДалее, "Заголовок", "Далее");
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция УстановитьАнимациюВводЗавершен()

	Анимация = Новый Массив;
	Анимация.Добавить(Новый Структура("Начало, Значение1", 0, "      Далее"));
	Анимация.Добавить(Новый Структура("Начало, Значение1", 1, "          Далее"));
	Анимация.Добавить(Новый Структура("Начало, Значение1", 4, "Далее"));

	Для Каждого Эффект Из Анимация Цикл
		Эффект.Вставить("Повторять", Ложь); //ТУ_КС для совместимости
		Эффект.Вставить("ПолеОбъекта", "Заголовок");
	КонецЦикла;
	
	УстановитьСвойстваЭлементовВывода("КнопкаДалее", "Анимация", Анимация);
	
КонецФункции

Функция РезультатАнализаЗаполненияПолейДанных(Поля, Данные) Экспорт

	Перем ЗначениеПоля;
	
	ВведенныеДанныеПолей = ДанныеТранзакции.ВведенныеДанныеПолей;
	ОбщиеДанныеПолей = ДанныеТранзакции.ОбщиеДанныеПолей;
	
	Результат = Обработки.вмс_СерверУправляемыйМодульСборщикДанных.НовыйРезультатАнализаЗаполненияПолейДанных();
	
	НеЗаполненныеПоляМассив = Результат.НеЗаполненныеПоляМассив;
	ЗаполненныеПоляМассив = Результат.ЗаполненныеПоляМассив;
	
	ОсновныеПоляЗаполнены = Истина;
	Для Каждого Поле Из Поля Цикл
		
		ИмяПоля = Поле.Имя;
		Если НЕ Данные.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			Продолжить;
		КонецЕсли;
		
		Группа = Поле.Группа;
		Если Группа="Количество" Тогда
			
			//анализ количества не напрямую, а через служебное поле "ЗавершениеВводаКоличества"
			Продолжить;
			
		ИначеЕсли Группа="ЗавершениеВводаКоличества" Тогда
			
			ЗаполненныеПоляМассив.Добавить(ИмяПоля);
			
			ЗавершениеВводаКоличества = ЗначениеПоля;

			ИмяПоля = "Количество" + Поле.Суффикс;
			ЗначениеПоляЗаполнено = Данные.Свойство(ИмяПоля, ЗначениеПоля) ИЛИ ОбщиеДанныеПолей.Свойство(ИмяПоля, ЗначениеПоля);
			
			Если ЗначениеПоля=Неопределено Тогда
				//полностью незаполнено
				Заполнено = Ложь;
				НеЗаполнено = Истина;
			Иначе
				Заполнено = Истина;
				Если ЗавершениеВводаКоличества Тогда
					//полностью заполнено
					НеЗаполнено = Ложь;
				Иначе
					//заполнено частично
					НеЗаполнено = Истина;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			Заполнено = Поле.ПустыеЗначения.Найти(ЗначениеПоля)=Неопределено;
			НеЗаполнено = Не Заполнено;
			
			Если НеЗаполнено Тогда
				
				//уточним незаполненное значение
				Если Данные=ВведенныеДанныеПолей И НЕ Поле.ОбязательныйВвод Тогда
					//можно не вводить
					НеЗаполнено = Ложь;
				ИначеЕсли НЕ Поле.ОбязательноеЗаполнение Тогда
					//можно не заполнять
					НеЗаполнено = Ложь;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Заполнено Тогда
			ЗаполненныеПоляМассив.Добавить(ИмяПоля);
		КонецЕсли;
		
		Если НеЗаполнено Тогда
			НеЗаполненныеПоляМассив.Добавить(ИмяПоля);
			Если НЕ Поле.Ресурс Тогда
				ОсновныеПоляЗаполнены = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.ОсновныеПоляЗаполнены = ОсновныеПоляЗаполнены;
	
	Обработки.вмс_СерверУправляемыйМодульСборщикДанных.ФинализироватьРезультатАнализаЗаполненияПолейДанных(Результат);

	Возврат Результат;
	
КонецФункции

Функция СохранитьСостояниеОбработки() Экспорт
	
	СборщикДанныхСтандартный.СохранитьСостояниеОбработки();
	
	СостояниеМодуля.Вставить("ПоляОбработкиИнструкцийЗадания", ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания);
	СостояниеМодуля.Вставить("ПоляОбработкиИнструкцийЗаданияДляПоиска", ПараметрыМодуля.ПоляОбработкиИнструкцийЗаданияДляПоиска);
	СостояниеМодуля.Вставить("ИдентификаторИнструкцииПолейОбработки", ПараметрыМодуля.ИдентификаторИнструкцииПолейОбработки);
	
КонецФункции

Функция ВосстановитьСостояниеОбработки() Экспорт
	
	СборщикДанныхСтандартный.ВосстановитьСостояниеОбработки();

	ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания = СостояниеМодуля.ПоляОбработкиИнструкцийЗадания;
