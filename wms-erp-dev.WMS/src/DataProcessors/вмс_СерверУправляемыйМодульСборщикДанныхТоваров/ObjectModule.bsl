#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Перем РК;
Перем ТипыВводаКоличества;
Перем ПустойЭлементВывода;
Перем ПустоеПолеОбработки;

Функция Инициализировать() Экспорт
	
	//добавим предка, чтобы не определять все методы и этапы ввода,
	//а унаследовать их от стандартного сборщика
	Если Интерфейс.МодульПодключен("СборщикДанныхСтандартный") Тогда
		СборщикДанныхСтандартный = Интерфейс.Модуль("СборщикДанныхСтандартный");
	Иначе
		СборщикДанныхСтандартный = Обработки.вмс_СерверУправляемыйМодульСборщикДанныхСтандартный.Создать();
	КонецЕсли;
	Интерфейс.ДобавитьРеальныйМодуль(СборщикДанныхСтандартный);
	
	//укажем реализуемые в этом модуле методы
	ИменаРеализуемыхМетодов =
		"УстановитьСвойстваПолейПоУмолчанию,
		|УстановитьДоступныеПоля,
		|УстановитьДополнительныеПоля,
		|ПриЗавершенииИнициализацииПолей,
		|ИнициализироватьДанные,
		|ЕстьИзменениеДанных,
		|РазобратьВходящиеОбъекты,
		|НачатьТранзакциюСборщика,
		|ЗафиксироватьТранзакциюСборщика,
		|ОтменитьТранзакциюСборщика,
		|ОбновитьДанныеТранзакцииОбработки,
		|ПослеЗавершенияТранзакцииВвода,
		|ПослеЗавершенияВвода,
		|ЗаполнитьДанныеПолей,
		|ЗаполнитьОбщиеДанныеПолей,
		|ЗаполнитьПредставлениеДанныхПолей,
		|ЗаполнитьТаблицы,
		|РезультатАнализаЗаполненияПолейДанных,
		|ОчиститьДанныеПолей,
		|СохранитьСостояниеОбработки,
		|ВосстановитьСостояниеОбработки,
		|ВыполнитьЗавершениеОперации";

	Интерфейс.УстановитьРеализациюМетодов(ИменаРеализуемыхМетодов, ЭтотОбъект);
	
	//инициализируем этапы ввода данных
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_НачалоВвода", "НачалоВвода");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанных_СборщикДанныхТоваров", "ОбработкаВходящихДанных");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанныхПолей", "ОбработкаВходящихДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанныхПолей_Контейнеры", "ОбработкаВходящихДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ПроверитьВводДругогоТовара", "ЗаполнениеВведенныхДанныхПолей", "ЗаполнениеВведенныхДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ОбработатьНеСохраненноеКоличество", "ОбработатьНеСохраненноеКоличество", "ЗаполнениеВведенныхДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ПодобратьИнструкциюДляДанныхВвода", "ПодобратьИнструкциюДляДанныхВвода", "ЗаполнениеВведенныхДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ОчиститьПоляВводаПриИзмененииИнструкции", "ОчиститьПоляВводаПриИзмененииИнструкции", "ПодобратьИнструкциюДляДанныхВвода");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ПроверкаВводаКонтейнераЦеликом", "ПроверкаВводаКонтейнераЦеликом", "ПодобратьИнструкциюДляДанныхВвода");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ПроверитьОтклонениеОтПлана", "ПроверитьОтклонениеОтПлана");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ПроверитьПревышениеКоличестваПоПлану", "ПроверкаСобранныхДанных");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_СохранениеДанных");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_КонецВвода");
	
	//инициализируем переменные модуля
	ПараметрыМодуля.Вставить("ТипыВводаКоличества", ТипыВводаКоличества);
	ПараметрыМодуля.Вставить("ДанныеСохранены", Ложь);
	ПараметрыМодуля.Вставить("ВводЗавершен", Ложь);
	ПараметрыМодуля.Вставить("АнимацияКнопкиДалееУстановлена", Истина);
	
	ПустойЭлементВывода = ПараметрыОбработки.ПустойЭлементВывода;
	ПустоеПолеОбработки = ПараметрыОбработки.ПустоеПолеОбработки;
	
	ИнициализироватьСвойстваОперации();
	
	ПараметрыМодуля.Вставить("ПоляОбработкиИнструкцийЗадания", НовыеПоляОбработкиИнструкцийЗадания());
	ПараметрыМодуля.Вставить("ПоляОбработкиИнструкцийЗаданияДляПоиска", Новый Соответствие);
	ПараметрыМодуля.Вставить("ИдентификаторИнструкцииПолейОбработки"); // идентификатор инструкции, настройки полей которой используются
	
	ИнициализироватьОбработчикиСобытийПолейОбработки();
	
КонецФункции

Функция ИнициализироватьОбработчикиСобытийПолейОбработки()
	УстановитьОбработчикиСобытийПолейОбработки(ПолеОбработки(Новый Структура("Имя, Ввод", "Серия",				Истина)),	Новый Структура("НачалоВыбора", НовыйОписаниеОповещения("ОбработчикНачалоВыбораСерии")));
	УстановитьОбработчикиСобытийПолейОбработки(ПолеОбработки(Новый Структура("Имя, Ввод", "КонтейнерПриемник",	Истина)),	Новый Структура("НачалоВыбора", НовыйОписаниеОповещения("ОбработчикНачалоВыбораКонтейнераПриемника")));
КонецФункции

//Различные варианты полей обработки
Функция НовыеПоляОбработкиИнструкцийЗадания() Экспорт
	
	ПоляОбработкиИнструкцийЗадания = Обработки.вмс_СерверУправляемыйМодульСтандартный.НовыеПоляОбработки();
	ПоляОбработкиИнструкцийЗадания.Колонки.Добавить("ИдентификаторИнструкции");
	ПоляОбработкиИнструкцийЗадания.Индексы.Добавить("ИдентификаторИнструкции");
	
	Возврат ПоляОбработкиИнструкцийЗадания;
	
КонецФункции

Функция УстановитьСвойстваПолейПоУмолчанию() Экспорт

	ТаблицаЗначенийСвойствПолейОперацииПоУмолчанию = вмс_СерверУправляемыеОперации.ТаблицаЗначенийСвойствПолейОперацииПоУмолчанию();
	РК.УстановитьЭлементыКоллекции(ПоляМодуля(), ТаблицаЗначенийСвойствПолейОперацииПоУмолчанию);

КонецФункции

Функция УстановитьДоступныеПоля() Экспорт
	
	УстановитьСвойстваПолейМодуля("Подсказка", Новый Структура("Использование", Истина));

	РеквизитыЗадания = Метаданные.Документы.вмс_ЗаданиеКладовщику.ТабличныеЧасти.Товары.Реквизиты;
	Для Каждого Реквизит Из РеквизитыЗадания Цикл
		ИмяРеквизита = Реквизит.Имя;
		Если ИмяРеквизита="Номенклатура" Тогда
			ИмяРеквизита = "Товар";
		КонецЕсли;
		
		СвойстваПоУмолчанию = Новый Структура;
		СвойстваПоУмолчанию.Вставить("Использование", Истина);
		УстановитьСвойстваПолейМодуля(ИмяРеквизита, СвойстваПоУмолчанию);
	КонецЦикла;

	ИмяТаблицыФакта = ПараметрыОбработки.ИмяТаблицыФакта;
	РеквизитыОперацииПоЯчейкам = Метаданные.Документы.вмс_ОперацияПоЯчейкам.ТабличныеЧасти[ИмяТаблицыФакта].Реквизиты;
	Для Каждого Реквизит Из РеквизитыОперацииПоЯчейкам Цикл
		ИмяРеквизита = Реквизит.Имя;
		Если ИмяРеквизита="Номенклатура" Тогда
			ИмяРеквизита = "Товар";
		КонецЕсли;

		СвойстваПоУмолчанию = Новый Структура;
		СвойстваПоУмолчанию.Вставить("ПутьКДаннымСохранения", "ОперацияПоЯчейкам." + ИмяТаблицыФакта + "." + ИмяРеквизита);
		СвойстваПоУмолчанию.Вставить("Использование", Истина);
		УстановитьСвойстваПолейМодуля(ИмяРеквизита, СвойстваПоУмолчанию);
	КонецЦикла;
	
	УстановитьСвойстваПолейМодуля("Количество, КоличествоРазмещено, КоличествоОтобрано", Новый Структура("Использование, ПутьКДаннымСохранения", Истина, "ОперацияПоЯчейкам." + ИмяТаблицыФакта + "." + "Количество"));
	УстановитьСвойстваПолейМодуля("КоличествоПлан",			Новый Структура("План, Ресурс, НачальноеЗначение, ЗначениеПоУмолчанию, ПустыеЗначения, ПутьКДаннымЗаполнения", Истина, Истина, 0, 0, 0, "Задание.Товары.КоличествоПлан"));
	УстановитьСвойстваПолейМодуля("КоличествоФактИтого",	Новый Структура("План, Ресурс, НачальноеЗначение, ЗначениеПоУмолчанию, ПустыеЗначения, ПутьКДаннымЗаполнения", Истина, Истина, 0, 0, 0, "Задание.Товары.КоличествоФактИтого"));
	
	УстановитьСвойстваПолейМодуля("Серия", Новый Структура("АвтоНачалоВыбора", Истина));
	
	//включим реквизиты полей
	Для Каждого ПолеМодуля Из ПоляМодуля() Цикл
		Если ПолеМодуля.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьКДаннымЗаполненияМассив = РК.ЗначениеВМассив(ПолеМодуля.ПутьКДаннымЗаполнения, ".");
		ПутьКДаннымЗаполненияРодителя = "";
		Для Каждого ЭлементПутиКДанным Из ПутьКДаннымЗаполненияМассив Цикл
			Если ПутьКДаннымЗаполненияРодителя <> "" Тогда
				ПутьКДаннымЗаполненияРодителя = ПутьКДаннымЗаполненияРодителя + ".";
			КонецЕсли;
			ПутьКДаннымЗаполненияРодителя = ПутьКДаннымЗаполненияРодителя + ЭлементПутиКДанным;
			Если ПолеМодуля.ПутьКДаннымЗаполнения=ПутьКДаннымЗаполненияРодителя Тогда
				Прервать;
			КонецЕсли;
			
			ПолеРодитель = ПолеМодуля(Новый Структура("ПутьКДаннымЗаполнения", ПутьКДаннымЗаполненияРодителя));
			Если ПолеРодитель <> ПустоеПолеОбработки И ПолеРодитель.Использование Тогда
				УстановитьСвойстваПолейМодуля(ПолеМодуля, "Использование", Истина);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецФункции

Функция УстановитьДополнительныеПоля() Экспорт

	ПоляВводаКоличеств = ПоляВводаКоличеств();
	Если НЕ ПолеМодуля("Количество").Использование Тогда
		//установим свойства обязательного поля "количество" по используемому полю количества
		Если ПоляВводаКоличеств.Количество() > 0 Тогда
			ПолеКоличества = ПоляВводаКоличеств[0];
			ПолеКоличества = ПолеМодуля(ПолеКоличества.Имя);
			Свойства = Новый Структура("Ресурс, Группа, ТипЗначения, ПутьКДаннымЗаполнения, ПутьКДаннымСохранения");
			ЗаполнитьЗначенияСвойств(Свойства, ПолеКоличества);
			УстановитьСвойстваПолейМодуля("Количество", Свойства);
		КонецЕсли;

		УстановитьСвойстваПолейМодуля("Количество", "Вывод", Ложь);
	КонецЕсли;
	УстановитьСвойстваПолейМодуля("Количество", "Использование, Сборка", Истина);

	УстановитьСвойстваПолейМодуля("КоличествоПлан, КоличествоФактИтого", Новый Структура("Использование", Истина));
	
	Если ПолеМодуля("КоличествоУчет") <> ПустоеПолеОбработки Тогда
		УстановитьСвойстваПолейМодуля("КоличествоУчет", Новый Структура("Вывод, Сборка, Ресурс, ПутьКДаннымЗаполнения, ЗначениеПоУмолчанию", Ложь, Истина, Истина, "Задание.Товары.КоличествоУчет", 0));
	КонецЕсли;
	
	//служебные поля для ввода количества
	КопируемыеСвойства = "Ввод, План, Сборка, Суффикс, ПорядокВвода";
	Для Каждого ПолеКоличества Из ПоляМодуля(Новый Структура("Группа, Использование", "Количество", Истина)) Цикл
		Группа = "Количество0";
		Свойства = Новый Структура("Ресурс, Группа, ТипЗначения, НачальноеЗначение, ЗначениеПоУмолчанию, " + КопируемыеСвойства,	Истина, Группа, Новый ОписаниеТипов("Число"), 0, 0);
		ЗаполнитьЗначенияСвойств(Свойства, ПолеКоличества, КопируемыеСвойства);
		Свойства.Вставить("Вывод", Ложь);
		УстановитьСвойстваПолейМодуля(Группа + ПолеКоличества.Суффикс, Свойства);

		Группа = "ТипВводаКоличества";
		Свойства = Новый Структура("Ресурс, Группа, НачальноеЗначение, ЗначениеПоУмолчанию, ТипЗначения, " + КопируемыеСвойства,					Истина, Группа, ТипыВводаКоличества.Установить, ТипыВводаКоличества.Установить, Новый ОписаниеТипов);
		ЗаполнитьЗначенияСвойств(Свойства, ПолеКоличества, КопируемыеСвойства);
		Свойства.Вставить("Вывод", Ложь);
		УстановитьСвойстваПолейМодуля(Группа + ПолеКоличества.Суффикс, Свойства);
		
		Группа = "ЗавершениеВводаКоличества";
		Свойства = Новый Структура("Ресурс, Группа, НачальноеЗначение, ЗначениеПоУмолчанию, ТипЗначения, " + КопируемыеСвойства,					Истина, Группа, Ложь, Ложь, Новый ОписаниеТипов("Булево"));
		ЗаполнитьЗначенияСвойств(Свойства, ПолеКоличества, КопируемыеСвойства);
		Свойства.Вставить("Вывод", Ложь);
		УстановитьСвойстваПолейМодуля(Свойства.Группа + ПолеКоличества.Суффикс, Свойства);
	КонецЦикла;
	
	Если ПоляВводаКоличеств.Количество()=0 Тогда
		Если НЕ ПараметрыМодуля.АвтоПереходКСледующейИнструкции Тогда
			//для возможности подтверждения количества, если количество не вводится
			УстановитьСвойстваПолейМодуля("ЗавершениеВводаКоличества", Новый Структура("Вывод, Ввод", Ложь, Истина));
		КонецЕсли;
	КонецЕсли;
	
	УстановитьСвойстваПолейМодуля("ИдентификаторИнструкцииЗаполнен",	Новый Структура("Вывод, План, Значение, ЗначениеПоУмолчанию, ПутьКДаннымЗаполнения",																	Ложь, Истина, Истина,	Ложь, "Задание.Товары.ИдентификаторИнструкцииЗаполнен"));
	УстановитьСвойстваПолейМодуля("ИдентификаторИнструкции",			Новый Структура("Вывод, План, Сборка, ПустыеЗначения, НачальноеЗначение, ЗначениеПоУмолчанию, ПутьКДаннымЗаполнения, ПутьКДаннымСохранения",			Ложь, Истина, Истина, Неопределено, Неопределено, 0, "Задание.Товары.ИдентификаторИнструкции",			"ОперацияПоЯчейкам." + ПараметрыОбработки.ИмяТаблицыФакта + ".ИдентификаторИнструкции"));
	УстановитьСвойстваПолейМодуля("ИдентификаторИнструкцииДляПоиска",	Новый Структура("Вывод, План, Сборка, ПустыеЗначения, НачальноеЗначение, ЗначениеПоУмолчанию, ПутьКДаннымЗаполнения, ПутьКДаннымСохранения, Значение",	Ложь, Истина,	Ложь, Неопределено, Неопределено, 0, "Задание.Товары.ИдентификаторИнструкцииДляПоиска", "", 0));

КонецФункции

Функция ПриЗавершенииИнициализацииПолей() Экспорт
	
	СборщикДанныхСтандартный.ПриЗавершенииИнициализацииПолей();
	
	ДобавитьКнопкуДалее();
	ДобавитьОбработчикиСобытийПолей();
	
	НастроитьПутиКДаннымЗаполненияПолейТаблицыПланФакт();
	ЗаполнитьПоляОбработкиИнструкцийЗаданияПоУмолчанию();
	
КонецФункции

Функция ДобавитьКнопкуДалее()

	ПрефиксСтраницОперации = Обработки.вмс_СерверУправляемыйМодульОперацияПоЯчейкамУниверсальная.ПрефиксСтраницОперации();
	ПорядокВывода = 0;
	Для Каждого Поле Из ПоляОбработки(Новый Структура("Вывод, Страница", Истина, ПрефиксСтраницОперации + "ВводДанных")) Цикл
		Если Поле.ПорядокВывода > ПорядокВывода Тогда
			ПорядокВывода = Поле.ПорядокВывода;
		КонецЕсли;
	КонецЦикла;
	
	ПорядокВывода = ПорядокВывода + 1;
	УстановитьСвойстваЭлементовВывода("КнопкаДалее",	Новый Структура("ТипЭлемента, СочетаниеКлавиш, Заголовок, РастягиватьПоГоризонтали, ГоризонтальноеПоложениеВГруппе, КнопкаПоУмолчанию", "КнопкаФормы", 13, "Далее", Истина, "Центр", Истина));
	УстановитьСвойстваЭлементовВывода("КнопкаДалее",	Новый Структура("ЦветФона, ЦветТекста, Шрифт", Новый Цвет(62, 175, 118), Новый Цвет(255, 255, 255), Новый Шрифт(,,Истина,)));
	УстановитьСвойстваЭлементовВывода("КнопкаДалее",	Новый Структура("Номер", ПорядокВывода));
	УстановитьОбработчикиСобытийЭлементовВывода("КнопкаДалее", Новый Структура("Нажатие", НовыйОписаниеОповещения("ОбработчикКнопкиДальше")));
	
	УстановитьСвойстваЭлементовВывода("Форма", Новый Структура("ПоведениеКлавишиEnter", "КнопкаПоУмолчанию"));
	
КонецФункции

