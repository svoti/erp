Функция НачатьТранзакциюСборщика() Экспорт

	Если НЕ СборщикДанныхСтандартный.НачатьТранзакциюСборщика() Тогда
		Возврат Ложь;
	КонецЕсли;

	ДанныеТранзакции.НовыеИдентификаторыИнструкций.Очистить();
	ДанныеТранзакции.Вставить("ИдентификаторИнструкцииПолейОбработки", ПараметрыМодуля.ИдентификаторИнструкцииПолейОбработки);
	ДанныеТранзакции.Вставить("ПринятыеДанныеБезПолейКоличества", Новый Структура);
	ДанныеТранзакции.Вставить("ПринятыеДанныеПолейКоличества", Новый Структура);
	ДанныеТранзакции.Вставить("ВводКоличества", Ложь);
	Возврат Истина;
	
КонецФункции

Функция ЗафиксироватьТранзакциюСборщика() Экспорт

	ИдентификаторИнструкции = ДанныеМодуля.СтатическиеДанныеПолей.ИдентификаторИнструкцииДляПоиска;
	ИдентификаторНовойИнструкции = ДанныеТранзакции.СтатическиеДанныеПолей.ИдентификаторИнструкцииДляПоиска;
	
	Если НЕ СборщикДанныхСтандартный.ЗафиксироватьТранзакциюСборщика() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбновитьТекущуюИнструкцию(ИдентификаторИнструкции, ИдентификаторНовойИнструкции);
	
	ПараметрыМодуля.ИдентификаторИнструкцииПолейОбработки = ДанныеТранзакции.ИдентификаторИнструкцииПолейОбработки;

	ДанныеТранзакции.НовыеИдентификаторыИнструкций.Очистить();
	
	Возврат Истина;
	
КонецФункции

Функция ОбновитьТекущуюИнструкцию(ИдентификаторИнструкции, ИдентификаторНовойИнструкции)
	
	ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;
	ДанныеОбновленияТаблицыПланФакт = ПараметрыТаблицы("ТаблицаПланФакт");
	ДополнительныеДанныеЭлементов = ДанныеОбновленияТаблицыПланФакт.ДополнительныеДанныеЭлементов;
	
	Если ИдентификаторИнструкции <> 0 И ИдентификаторИнструкции <> ИдентификаторНовойИнструкции Тогда
		
		СписокЭлементовДляПроверки = Новый Массив;
		Для Каждого Инструкция Из ТаблицаПланФакт.НайтиСтроки(Новый Структура("ИдентификаторИнструкцииДляПоиска", ИдентификаторИнструкции)) Цикл
			ИндексЭлемента = ТаблицаПланФакт.Индекс(Инструкция);
			ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов[ИндексЭлемента];
            Если НЕ ДополнительныеДанныеЭлемента.УдалятьПустые Тогда
				ДополнительныеДанныеЭлемента.УдалятьПустые = Истина;
				СписокЭлементовДляПроверки.Добавить(ИндексЭлемента);
			КонецЕсли;
		КонецЦикла;
		
		Если СписокЭлементовДляПроверки.Количество() > 0 Тогда
			ПустыеЭлементы = ПолучитьПустыеЭлементыТаблицы(ТаблицаПланФакт, ДанныеОбновленияТаблицыПланФакт, СписокЭлементовДляПроверки);
			
			ИдентификаторыИнструкций = Новый Массив;
			Для Каждого ИндексЭлемента Из ПустыеЭлементы Цикл
				ИдентификаторыИнструкций.Добавить(ТаблицаПланФакт[ИндексЭлемента].ИдентификаторИнструкцииДляПоиска);
			КонецЦикла;
			
			УдалитьДанныеИнструкцийЗадания(ИдентификаторыИнструкций);
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	
	
	Если ИдентификаторНовойИнструкции <> 0 Тогда
		
		Для Каждого Инструкция Из ТаблицаПланФакт.НайтиСтроки(Новый Структура("ИдентификаторИнструкцииДляПоиска", ИдентификаторНовойИнструкции)) Цикл
			ИндексЭлемента = ТаблицаПланФакт.Индекс(Инструкция);
			ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов[ИндексЭлемента];
			ДополнительныеДанныеЭлемента.УдалятьПустые = Ложь;
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции

