#Область ЭтапыВвода

Функция ОбработчикЭтапаВводаДанных_НачалоВвода(Параметры, ДополнительныеПараметры) Экспорт
	
	СборщикДанныхСтандартный.ОбработчикЭтапаВводаДанных_НачалоВвода(Параметры, ДополнительныеПараметры);
	
	ПараметрыМодуля.ДанныеСохранены = Ложь;
	ПараметрыМодуля.ВводЗавершен = Ложь;
	ПараметрыМодуля.АнимацияКнопкиДалееУстановлена = Ложь;
	
	Интерфейс.ЗаполнитьТаблицы();
	УстановитьПоляОбработкиДляИнструкцииЗадания(0); //установим настройки полей по умолчанию
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанных_СборщикДанныхТоваров(Параметры, ДополнительныеПараметры) Экспорт

	ВходящиеДанные = ДанныеТранзакции.ВходящиеДанные;
	
	Если НЕ ВходящиеДанные.Свойство("ВводитьКоличествоВОтдельнойТранзакции") Тогда
		ВходящиеДанные.Вставить("ВводитьКоличествоВОтдельнойТранзакции", Истина);
	КонецЕсли;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанныхПолей(Параметры, ДополнительныеПараметры) Экспорт
	
	СборщикДанныхСтандартный.ЗаполнитьПринятыеДанныеПолей(ДанныеТранзакции.ВходящиеДанные);
	
	ОбработатьПринятыеДанныеКоличества();
	
КонецФункции

Функция ОбработатьПринятыеДанныеКоличества();
	
	ПринятыеДанныеПолей = ДанныеТранзакции.ПринятыеДанныеПолей;
	
	ВводКоличества = Ложь;
	Для Каждого ПолеВводаКоличества Из ПоляВводаКоличеств() Цикл
		
		Если НЕ ПринятыеДанныеПолей.Свойство(ПолеВводаКоличества.Имя) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоляТипВводаКоличества = "ТипВводаКоличества" + ПолеВводаКоличества.Суффикс;
		Если НЕ ПринятыеДанныеПолей.Свойство(ИмяПоляТипВводаКоличества) Тогда
			ПринятыеДанныеПолей.Вставить(ИмяПоляТипВводаКоличества, ПолучитьЗначениеСвойстваПоляМодуля(ИмяПоляТипВводаКоличества, "ЗначениеПоУмолчанию"));
		КонецЕсли;
		
		ВводКоличества = Истина;
		
	КонецЦикла;
	
	РезультатСепарации = ОтсепарироватьДанныеВводаКоличества(ПринятыеДанныеПолей);
	ДанныеТранзакции.ПринятыеДанныеБезПолейКоличества = РезультатСепарации.ПринятыеДанныеБезПолейКоличества;
	ДанныеТранзакции.ПринятыеДанныеПолейКоличества = РезультатСепарации.ПринятыеДанныеПолейКоличества;
	ДанныеТранзакции.ВводКоличества = ВводКоличества;
		
	Если ДанныеТранзакции.ВходящиеДанные.ВводитьКоличествоВОтдельнойТранзакции Тогда
		Если ДанныеТранзакции.ПринятыеДанныеПолейКоличества.Количество() > 0 И ДанныеТранзакции.ПринятыеДанныеБезПолейКоличества.Количество() > 0 Тогда
			// сначала введем основные поля без количества
			// количество введем в отдельной транзакции
			ДанныеТранзакции.ПринятыеДанныеПолей = ДанныеТранзакции.ПринятыеДанныеБезПолейКоличества;
			
			// также очистим количественные поля вводом пустых значений, чтобы к основным данным не примешались количества от прошлого ввода другого товара
			Для Каждого ПринятыеДанныеПоляКоличества Из ДанныеТранзакции.ПринятыеДанныеПолейКоличества Цикл
				ДанныеТранзакции.ПринятыеДанныеПолей.Вставить(ПринятыеДанныеПоляКоличества.Ключ, ПолучитьЗначениеСвойстваПоляМодуля(ПринятыеДанныеПоляКоличества.Ключ, "НачальноеЗначение"));
			КонецЦикла;
		Иначе
			ДанныеТранзакции.ВходящиеДанные.ВводитьКоличествоВОтдельнойТранзакции = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанныхПолей_Контейнеры(Параметры, ДополнительныеПараметры) Экспорт
	
	ВходящиеДанные = ДанныеТранзакции.ВходящиеДанные;
	Если ВходящиеДанные.Свойство("ПередатьВПолеКонтейнера") И ВходящиеДанные.ПередатьВПолеКонтейнера Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВходящиеДанные.Свойство("ВводСоставаКонтейнера") И ВходящиеДанные.ВводСоставаКонтейнера Тогда
		Возврат Ложь;
	КонецЕсли;

	ИдентификаторИнструкции = ПолучитьЗначениеДанныхПоляМодуля("ИдентификаторИнструкцииДляПоиска");
	СписокПолейВвода = ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания.Скопировать(Новый Структура("Ввод, ИдентификаторИнструкции", Истина, ИдентификаторИнструкции)).ВыгрузитьКолонку("Имя");
	ПоляВводаКонтейнеров = РК.ПересечениеМассивов(СписокПолейВвода, "Контейнер, КонтейнерПриемник");
	
	Если ПоляВводаКонтейнеров.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПринятыеДанныеПолей = ДанныеТранзакции.ПринятыеДанныеПолей;

	ПринятыеПоляКонтейнера = Новый Массив;
	Для Каждого ПолеВводаКонтейнера Из ПоляВводаКонтейнеров Цикл
		Если ПринятыеДанныеПолей.Свойство(ПолеВводаКонтейнера) Тогда
			ПринятыеПоляКонтейнера.Добавить(ПолеВводаКонтейнера);
		КонецЕсли;
	КонецЦикла;

	Если ПринятыеПоляКонтейнера.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПринятоеПолеКонтенера = ПринятыеПоляКонтейнера[0];
	Контейнер = ПринятыеДанныеПолей[ПринятоеПолеКонтенера];
	
	ПередатьВПоляКонтейнера = РК.ВычитаниеМассивов(ПоляВводаКонтейнеров, ПринятыеПоляКонтейнера);
	ПередатьВПолеКонтейнера = ПередатьВПоляКонтейнера[0];
	
	Интерфейс.ОстановитьВводДанных();
	ОО = НовыйОписаниеОповещения("ОбработчикДиалогаВводКонтейнера", , Новый Структура("ПередатьВПолеКонтейнера, Контейнер", ПередатьВПолеКонтейнера, Контейнер));
	
	Если ПередатьВПолеКонтейнера="Контейнер" Тогда
		Текст = "Переместить контейнер?";
	Иначе
		Текст = "Собрать контейнер?";
	КонецЕсли;
	
	ПоказатьДиалогНаКлиенте(ОО, Текст, "ДаНетОтмена");
	
КонецФункции

Функция ОбработчикДиалогаВводКонтейнера(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ="Да" Тогда
		Интерфейс.ОтменитьВводДанных();
		ВходящиеДанные = НовыеВходящиеДанные(Новый Структура(ДополнительныеПараметры.ПередатьВПолеКонтейнера, ДополнительныеПараметры.Контейнер));
		ВходящиеДанные.Вставить("ПередатьВПолеКонтейнера", Истина);
		ВвестиДанные(ВходящиеДанные);
	ИначеЕсли Ответ="Нет" Тогда
		Интерфейс.ВозобновитьВводДанных();
	Иначе
		Интерфейс.ОтменитьВводДанных();
	КонецЕсли;
	
КонецФункции

Функция ОтсепарироватьДанныеВводаКоличества(ПринятыеДанныеПолей)

	ПоляКоличества = Новый Массив;
	Для Каждого ПолеВводаКоличества Из ПоляВводаКоличеств() Цикл
		
		ИмяПоляКоличества = ПолеВводаКоличества.Имя;
		Если ПринятыеДанныеПолей.Свойство(ИмяПоляКоличества) Тогда
			ПоляКоличества.Добавить(ИмяПоляКоличества);
		КонецЕсли;
		
		ИмяПоляТипВводаКоличества = "ТипВводаКоличества" + ПолеВводаКоличества.Суффикс;
		Если ПринятыеДанныеПолей.Свойство(ИмяПоляТипВводаКоличества) Тогда
			ПоляКоличества.Добавить(ИмяПоляТипВводаКоличества);
		КонецЕсли;

		ИмяПоляЗавершениеВводаКоличества = "ЗавершениеВводаКоличества" + ПолеВводаКоличества.Суффикс;
		Если ПринятыеДанныеПолей.Свойство(ИмяПоляЗавершениеВводаКоличества) Тогда
			ПоляКоличества.Добавить(ИмяПоляЗавершениеВводаКоличества);
		КонецЕсли;
		
	КонецЦикла;
	
	ПринятыеДанныеБезПолейКоличества = РК.СкопироватьОбъект(ПринятыеДанныеПолей);
	ПринятыеДанныеПолейКоличества = Новый Структура;
	Для Каждого ПолеКоличества Из ПоляКоличества Цикл
		ПринятыеДанныеБезПолейКоличества.Удалить(ПолеКоличества);
		ПринятыеДанныеПолейКоличества.Вставить(ПолеКоличества, ПринятыеДанныеПолей[ПолеКоличества]);
	КонецЦикла;

	Результат = Новый Структура("ПринятыеДанныеБезПолейКоличества, ПринятыеДанныеПолейКоличества", ПринятыеДанныеБезПолейКоличества, ПринятыеДанныеПолейКоличества);
	Возврат Результат;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ПроверитьВводДругогоТовара(Параметры, ДополнительныеПараметры) Экспорт
	
	ТоварныеПоляМассив = СписокПолейМодуля(Новый Структура("Группа, Ввод", "Товар", Истина));
	ПринятыеДанныеПолей = ДанныеТранзакции.ПринятыеДанныеПолей;
	ПринятыеПоляМассив = РК.ВыгрузитьЗначенияКолонкиКоллекции(ПринятыеДанныеПолей, "Ключ");
	ПринятыеТоварныеПоляМассив = РК.ПересечениеМассивов(ТоварныеПоляМассив, ПринятыеПоляМассив);
	Если ПринятыеТоварныеПоляМассив.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПредыдущиеДанныеПолей = ДанныеМодуля.ОбщиеДанныеПолей;
	ВведенныеДанныеПолей = ДанныеТранзакции.ВведенныеДанныеПолей;
	
	//// Обработка поля "Серия"
	//Разрешить изменение серии с пустой на заполненную
	ИндексПоляСерии = ПринятыеТоварныеПоляМассив.Найти("Серия");
	Если ИндексПоляСерии <> Неопределено И НЕ ЗначениеЗаполнено(ПредыдущиеДанныеПолей["Серия"]) Тогда
		ПринятыеТоварныеПоляМассив.Удалить(ИндексПоляСерии);
		Если ПринятыеТоварныеПоляМассив.Количество()=0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	////
	
	ПринятыеТоварныеПоля = РК.МассивВСтроку(ПринятыеТоварныеПоляМассив);
	ДанныеТовара1 = Новый Структура(ПринятыеТоварныеПоля);
	ЗаполнитьЗначенияСвойств(ДанныеТовара1, ПредыдущиеДанныеПолей);

	ДанныеТовара2 = Новый Структура(ПринятыеТоварныеПоля);
	ЗаполнитьЗначенияСвойств(ДанныеТовара2, ВведенныеДанныеПолей);
	Если РК.СравнитьСтруктуры(ДанныеТовара1, ДанныеТовара2) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//введен другой товар
	//заполним поля по умолчанию
	ПроанализироватьДанныеПолей = Ложь;

	Если ПринятыеДанныеПолей.Свойство("Товар") Тогда
		Для Каждого ТоварноеПоле Из ПоляМодуля(Новый Структура("Группа", "Товар")) Цикл
			Если ПринятыеДанныеПолей.Свойство(ТоварноеПоле.Имя) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВведенныеДанныеПолей[ТоварноеПоле.Имя]=ТоварноеПоле.НачальноеЗначение Тогда
				Продолжить;
			КонецЕсли;
			
			ВведенныеДанныеПолей[ТоварноеПоле.Имя] = ТоварноеПоле.НачальноеЗначение;
			ПроанализироватьДанныеПолей = Истина;
		КонецЦикла;
	КонецЕсли;
	
	КоличествоПотеряно = Ложь;
	Для Каждого ПолеВводаКоличества Из ПоляВводаКоличеств() Цикл
		ИмяПоляКоличество = ПолеВводаКоличества.Имя;
		ИмяПоляЗавершениеВводаКоличества = "ЗавершениеВводаКоличества" + ПолеВводаКоличества.Суффикс;
		Если ВведенныеДанныеПолей[ИмяПоляКоличество]=ПолеВводаКоличества.НачальноеЗначение И ВведенныеДанныеПолей[ИмяПоляЗавершениеВводаКоличества]=Ложь Тогда
			//уже очищено
			Продолжить;
		КонецЕсли;

		Если ВведенныеДанныеПолей[ИмяПоляКоличество] <> ПолеВводаКоличества.НачальноеЗначение И
			(ВведенныеДанныеПолей["ТипВводаКоличества" + ПолеВводаКоличества.Суффикс]=ТипыВводаКоличества.Установить ИЛИ ВведенныеДанныеПолей[ИмяПоляКоличество] <> 0) Тогда
			КоличествоПотеряно = Истина;
		КонецЕсли;
		
		ВведенныеДанныеПолей[ИмяПоляКоличество] = ПолеВводаКоличества.НачальноеЗначение;
		ВведенныеДанныеПолей[ИмяПоляЗавершениеВводаКоличества] = Ложь;
		
		ПроанализироватьДанныеПолей = Истина;
	КонецЦикла;

	ДанныеВыполненияЭтапа = Параметры.Этап.ДанныеВыполненияЭтапа;
	Если КоличествоПотеряно И НЕ (ДанныеВыполненияЭтапа.Свойство("ЗапрошеноПодтверждение") И ДанныеВыполненияЭтапа.ЗапрошеноПодтверждение=Истина) Тогда
		ПоказатьДиалогНаКлиенте(НовыйОписаниеОповещения("ОбработчикВопросаПриВводеДанных"), "Вводится другой товар. Введенное количество не будет сохранено. Продолжить?", "ОКОтмена", , , , "Ошибка");
		ДанныеВыполненияЭтапа.Вставить("ЗапрошеноПодтверждение", Истина);

		// после ответа диалога вернемся в этот этап повторно (ПропускатьЭтап=Ложь)
		Интерфейс.ОстановитьВводДанных(Ложь);
		Возврат Ложь;
	КонецЕсли;
	
	Если ПроанализироватьДанныеПолей Тогда
		Интерфейс.ПроанализироватьЗаполнениеПолейДанных("ВведенныеДанныеПолей");
	КонецЕсли;
	
	Возврат ПроанализироватьДанныеПолей;
	
КонецФункции

