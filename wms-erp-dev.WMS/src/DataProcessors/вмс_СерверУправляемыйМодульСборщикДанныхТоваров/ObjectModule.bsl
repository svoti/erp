Функция ОбработчикКомандыОткрытьКарточкуТовара(Параметры, ДополнительныеПараметры) Экспорт

	ДанныеПолей = ДанныеОбработки.ОбщиеДанныеПолей;
	
	ПараметрыИнициализации = Новый Структура;
	ПараметрыИнициализации.Вставить("Товар", ДанныеПолей.Товар);
	Если ДанныеПолей.Свойство("Характеристика") Тогда
		ПараметрыИнициализации.Вставить("Характеристика", ДанныеПолей.Характеристика);
	КонецЕсли;
	
	//3.2.5
	//вмс_СерверУправляемыеОбработки.СоздатьОбработку("Обработка.вмс_СерверУправляемыйМодульКарточкаТовара",
	//												ПараметрыИнициализации,
	//												ПараметрыОбработки.Идентификатор,
	//												НовыйОписаниеОповещения("ОбработчикЗакрытияКарточкиТовара"));
	//												
	вмс_СерверУправляемыеОбработки.СоздатьОбработку("Обработка.вмс_СерверУправляемыйМодульОперацияПоЯчейкамКарточкаТовара",
													ПараметрыИнициализации,
													ПараметрыОбработки.Идентификатор,
													НовыйОписаниеОповещения("ОбработчикЗакрытияКарточкиТовара"));

	СтандартныйМодуль.ЗаморозитьТаймеры();
	
КонецФункции

