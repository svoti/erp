#Область РеализацияМетодов

Функция РазобратьВходящиеОбъекты(ВходящиеДанные) Экспорт
	
	СборщикДанныхСтандартный.РазобратьВходящиеОбъекты(ВходящиеДанные, ВсеПоляВвода());
	
	ЗаполнитьКоличествоПоШтрихкодуВоВходящихДанных(ВходящиеДанные);
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьКоличествоПоШтрихкодуВоВходящихДанных(ВходящиеДанные)

	Если НЕ ВходящиеДанные.ДанныеШтрихкода.Обработан Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеПолей = ВходящиеДанные.ДанныеПолей;

	Если НЕ ДанныеПолей.Свойство("Товар") И НЕ ДанныеПолей.Свойство("Контейнер") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеПолей.Вставить("Количество", 1);
	КоличествоУпаковок = 1;
	
	Результат = ВходящиеДанные.ДанныеШтрихкода.Результат;
	
	// 3.2.5 - изменил ключ "План" на "Сборка" для того, чтобы если упаковка вводится по факту - коэффициент количества тоже не учитывался.
	Если ПолеМодуля(Новый Структура("Имя, Сборка", "Упаковка", Истина)) = ПустоеПолеОбработки Тогда
		
		// упаковки нет в плане, используем упаковку как коэффициент для ввода количества
		ЭлементУпаковка = РК.НайтиЭлементКоллекции(Результат.НайденныеОбъекты, Новый Структура("ИмяТипаОбъекта", "Упаковка"));
		
		Если ЭлементУпаковка <> Неопределено Тогда
			
			Упаковка = ЭлементУпаковка.Объект;

			Товар = Неопределено;
			Если ДанныеПолей.Свойство("Товар", Товар) Тогда
				КоличествоУпаковок = вмс_ОперацииПоЯчейкамСервер.КоэффициентУпаковки(Упаковка, Товар);
			КонецЕсли;

		КонецЕсли;
		
		//Берем любое повышающее количество: из упаковки или из штрихкода.
		ДанныеПолей.Количество = Макс(КоличествоУпаковок, Результат.Количество);
		
	КонецЕсли;
	
	ПолеКоличества = АктивноеПолеКоличества();
	Если ПолеКоличества <> Неопределено  Тогда
		Если ПолеКоличества.Имя <> "Количество" Тогда
			// уточним имя поля количество, может называться по другому
			ДанныеПолей.Вставить(ПолеКоличества.Имя, ДанныеПолей.Количество);
			ДанныеПолей.Удалить("Количество");
		КонецЕсли;
		ДанныеПолей.Вставить("ТипВводаКоличества" + ПолеКоличества.Суффикс, ТипыВводаКоличества.Добавить);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// используются все поля ввода, но поля ввода для текущей инструкции задания будут в приоритете
Функция ВсеПоляВвода()
	
	ВсеПоляВвода = ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания.Скопировать(Новый Структура("Ввод, ИдентификаторИнструкции", Истина, 0));
	ВсеПоляВвода.Сортировать("ПорядокВвода");
	
	ПоляВводаТекущие = ПараметрыМодуля.ПоляОбработкиИнструкцийЗадания.Скопировать(Новый Структура("Ввод, ИдентификаторИнструкции", Истина, ПолучитьЗначениеДанныхПоляМодуля("ИдентификаторИнструкцииДляПоиска")));
	ПоляВводаТекущие.Сортировать("ПорядокВвода");

	ОтборПоИмени = Новый Структура("Имя");
	Для НомерПоля=0 По ПоляВводаТекущие.Количество()-1 Цикл
		ОтборПоИмени.Имя = ПоляВводаТекущие[НомерПоля].Имя;
		ПолеВводаМассив = ВсеПоляВвода.НайтиСтроки(ОтборПоИмени);
		Если ПолеВводаМассив.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеВвода = ПолеВводаМассив[0];
		ТекущийНомерПоля = ВсеПоляВвода.Индекс(ПолеВвода);
		Если ТекущийНомерПоля <> НомерПоля Тогда
			ВсеПоляВвода.Сдвинуть(ТекущийНомерПоля, НомерПоля-ТекущийНомерПоля);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВсеПоляВвода;
	
КонецФункции

