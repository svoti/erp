Функция Переинициализировать()
	
	СохраненныеПараметрыОбработки = Новый Структура("Диалоги, Таймеры, ЭлементыВывода");
	СохраненныеДанныеОбработки = Новый Структура("СсылкаОперацииПоЯчейкам");
	ЗаполнитьЗначенияСвойств(СохраненныеПараметрыОбработки, ПараметрыОбработки);
	ЗаполнитьЗначенияСвойств(СохраненныеДанныеОбработки, ДанныеОбработки);
	
	//скопируем значения полей
	ДанныеХЗ = Новый ХранилищеЗначения(ПараметрыОбработки.Данные);
	ПараметрыОбработки.СостояниеОбработки.Данные = ДанныеХЗ.Получить();
	
	Для Каждого СборщикДанных Из СборщикиДанных() Цикл
		ПараметрыМодуля = СборщикДанных.ПараметрыМодуля;
		ДанныеХЗ = Новый ХранилищеЗначения(ПараметрыМодуля.Данные);
		ПараметрыМодуля.СостояниеМодуля.Данные = ДанныеХЗ.Получить();
	КонецЦикла;
	
	//
	Действие = Действие("Инициализировать", ПараметрыОбработки.СостояниеОбработки.ПараметрыИнициализации);
	вмс_СерверУправляемыеОбработки.ВыполнитьДействиеПереопределяемый(Действие);
	
	//Если после инициализации какие-то поля были отключены, то элементы вывода этих полей также надо скрыть
	//Для этого сохраним информацию об этих элементах, чтобы система понимала, что они были, больше не используются
	//и их надо скрыть
	Для Каждого ЭлементВывода Из СохраненныеПараметрыОбработки.ЭлементыВывода Цикл
		НовыйЭлементВывода = ЭлементВывода(ЭлементВывода.Имя);
		Если НовыйЭлементВывода=ПустойЭлементВывода Тогда
			УстановитьСвойстваЭлементовВывода(ЭлементВывода.Имя, "Удалить", Истина);
		Иначе
			ТипЭлемента = Неопределено;
			НовыйТипЭлемента = Неопределено;
			Если ЭлементВывода.Свойства.Свойство("ТипЭлемента", ТипЭлемента)
				И НовыйЭлементВывода.Свойства.Свойство("ТипЭлемента", НовыйТипЭлемента)
				И ТипЭлемента <> НовыйТипЭлемента Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НовыйЭлементВывода, ЭлементВывода, "СвойстваНаКлиенте");
			Если НовыйЭлементВывода.Свойства.Свойство("Номер") Тогда
				НовыйЭлементВывода.СвойстваПередать.Вставить("Номер", НовыйЭлементВывода.Свойства.Номер);
				НовыйЭлементВывода.СвойстваНаКлиенте.Удалить("Номер");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СохраненныеПараметрыОбработки.Удалить("ЭлементыВывода");
	ЗаполнитьЗначенияСвойств(ПараметрыОбработки, СохраненныеПараметрыОбработки);
	ДанныеОбработки.СсылкаОперацииПоЯчейкам = СохраненныеДанныеОбработки.СсылкаОперацииПоЯчейкам;

	//восстановим значения полей
	ЗаполнитьЗначенияСвойств(ДанныеОбработки.ВведенныеДанныеПолей, СостояниеОбработки.Данные.ВведенныеДанныеПолей);
	Для Каждого ДанныеПоля Из СостояниеОбработки.Данные.СтатическиеДанныеПолей Цикл
		УстановитьЗначениеДанныхПоляОбработки(ПолеОбработки(ДанныеПоля.Ключ), ДанныеПоля.Значение);
	КонецЦикла;
	СостояниеОбработки.Данные = ДанныеОбработки;
	
	Для Каждого СборщикДанных Из СборщикиДанных() Цикл
		ЗаполнитьЗначенияСвойств(СборщикДанных.ДанныеМодуля.ВведенныеДанныеПолей, СборщикДанных.СостояниеМодуля.Данные.ВведенныеДанныеПолей);
		Для Каждого ДанныеПоля Из СборщикДанных.СостояниеМодуля.Данные.СтатическиеДанныеПолей Цикл
			Поле = Обработки.вмс_СерверУправляемыйМодульСтандартный.ПолеОбработки(СборщикДанных.ПараметрыМодуля, ДанныеПоля.Ключ);
			Обработки.вмс_СерверУправляемыйМодульСтандартный.УстановитьЗначениеДанныхПоляОбработки(СборщикДанных.ПараметрыМодуля, Поле, ДанныеПоля.Значение);
		КонецЦикла;
		СборщикДанных.СостояниеМодуля.Данные = СборщикДанных.ДанныеМодуля;
	КонецЦикла;
	
	//
	ЗаполнитьТаблицы();
	ЗаполнитьДанныеПолей();
	
КонецФункции

#КонецОбласти

