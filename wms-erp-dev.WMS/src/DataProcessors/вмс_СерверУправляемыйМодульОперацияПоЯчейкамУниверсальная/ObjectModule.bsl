Функция ОбработчикОжидания(Результат, ДополнительныеПараметры) Экспорт
	
	НоваяВерсияДокументаЗадания = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(ПараметрыОбработки.СсылкаНаЗадание);
	Если ПараметрыОбработки.ВерсияДокументаЗадания <> НоваяВерсияДокументаЗадания Тогда
		//при изменении задания переинициализируем операцию
		Если НастройкиПолейИзменились() Тогда
			Переинициализировать();
		Иначе
			СтандартныйМодуль.ОбработчикОжидания(Результат, ДополнительныеПараметры);
		КонецЕсли;
		ПараметрыОбработки.ВерсияДокументаЗадания = НоваяВерсияДокументаЗадания;
	Иначе
		
		НоваяВерсияНастройкиОператора = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(ПараметрыОбработки.НастройкаОператора);
		Если ПараметрыОбработки.ВерсияНастройкиОператора <> НоваяВерсияНастройкиОператора Тогда
			ПараметрыОбработки.МасштабФормы = вмс_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(ПараметрыОбработки.НастройкаОператора, "МасштабФормы");
			ПараметрыОбработки.ВерсияНастройкиОператора = НоваяВерсияНастройкиОператора;
		КонецЕсли;
		
		СтандартныйМодуль.ОбработчикОжидания(Результат, ДополнительныеПараметры);
	КонецЕсли;
	
КонецФункции

Функция ДействиеЕстьИзменениеДанных(Действие)

	НоваяВерсияДокументаЗадания = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(ПараметрыОбработки.СсылкаНаЗадание);
	Если ПараметрыОбработки.ВерсияДокументаЗадания <> НоваяВерсияДокументаЗадания Тогда
		Возврат УстановитьРезультатДействия(Действие, Истина);
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция НастройкиПолейИзменились()
	
	Задание = ПараметрыОбработки.Задание;
	Если НЕ ЗначениеЗаполнено(Задание.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НовоеЗадание = ПараметрыОбработки.Задание.Ссылка.ПолучитьОбъект();
	НовоеЗадание.Прочитать();
	
	СтруктураНастройкиПолей = ПараметрыОбработки.СтруктураНастройкиПолей;
	НоваяСтруктураНастройкиПолей = НовоеЗадание.СтруктураНастройкиПолей();
	
	ХЗ = Новый ХранилищеЗначения(СтруктураНастройкиПолей);
	НХЗ = Новый ХранилищеЗначения(НоваяСтруктураНастройкиПолей);
	
	XMLСтрока = XMLСтрока(ХЗ);
	НоваяXMLСтрока = XMLСтрока(НХЗ);
	
	НастройкиПолейИзменились = XMLСтрока <> НоваяXMLСтрока;
	
	Возврат НастройкиПолейИзменились;
	
КонецФункции

Функция НастроитьИспользованиеПолейПоИнструкции(Инструкция)
	
	ПустыеДанныеПолей = ДанныеОбработки.ПустыеДанныеПолей;
	ДанныеПолей = ДанныеОбработки.ДанныеПолей;
	
	ПоляПланаМассив = СписокПолейОбработки(Новый Структура("План, Ресурс", Истина, Ложь));
	Для Каждого Поле Из ПоляПланаМассив Цикл
		
		Если Поле="Ячейка" Тогда
			
			ПолеЗаполнено = ЗначениеЗаполнено(ДанныеПолей[Поле]);
			
			Если ПолеЗаполнено Тогда
				ВосстановитьИсходныеСвойстваПолейОбработки("Ячейка, КоличествоОтобрано, Количество0Отобрано, ТипВводаКоличестваОтобрано");
			Иначе
				УстановитьСвойстваПолейОбработки("Ячейка", "Ввод, Вывод", Ложь);
				УстановитьСвойстваПолейОбработки("КоличествоОтобрано, Количество0Отобрано, ТипВводаКоличестваОтобрано", "Сборка, Ввод, Вывод", Ложь);
			КонецЕсли;
			
		ИначеЕсли Поле="ЯчейкаПриемник" Тогда
			
			ПолеЗаполнено = ЗначениеЗаполнено(ДанныеПолей[Поле]);
			
			Если ПолеЗаполнено Тогда
				ВосстановитьИсходныеСвойстваПолейОбработки("ЯчейкаПриемник, КоличествоРазмещено, Количество0Размещено, ТипВводаКоличестваРазмещено");
			Иначе
				УстановитьСвойстваПолейОбработки("ЯчейкаПриемник", "Ввод, Вывод", Ложь);
				УстановитьСвойстваПолейОбработки("КоличествоРазмещено, Количество0Размещено, ТипВводаКоличестваРазмещено", "Сборка, Ввод, Вывод", Ложь);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ПолучитьИнструкциюПоИдентификатору(Идентификатор)
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		ИнструкцияМассив = ДанныеОбработки.Таблицы.ТаблицаПланФакт.НайтиСтроки(Новый Структура("ИдентификаторИнструкцииДляПоиска", Идентификатор));
		Если ИнструкцияМассив.Количество() > 0 Тогда
			Возврат ИнструкцияМассив[0];
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьСледующуюИнструкцию()
	
	ИнтерфейсСборщикДанныхТоваров = СборщикДанных("СборщикДанныхТоваров");
	Если ИнтерфейсСборщикДанныхТоваров <> Неопределено Тогда
		НачатьТранзакциюОбработки(ИнтерфейсСборщикДанныхТоваров);
		ИнтерфейсСборщикДанныхТоваров.НачатьТранзакциюСборщика();
		ИдентификаторИнструкцииДляПоиска = ИнтерфейсСборщикДанныхТоваров.Модуль("СборщикДанныхТоваров").ОпределитьСледующуюИнструкцию();
		ИнтерфейсСборщикДанныхТоваров.ОбновитьДанныеТранзакцииОбработки();
		ЗафиксироватьТранзакциюОбработки(ИнтерфейсСборщикДанныхТоваров);
	КонецЕсли;
	
	Возврат ИдентификаторИнструкцииДляПоиска;
	
КонецФункции

