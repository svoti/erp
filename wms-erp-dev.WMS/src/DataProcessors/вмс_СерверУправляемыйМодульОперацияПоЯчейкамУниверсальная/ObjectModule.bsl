Функция ПоказатьДиалогНаКлиенте(знач ОписаниеОповещения=Неопределено, Текст, знач Кнопки=Неопределено, знач Таймаут=Неопределено, КнопкаПоУмолчанию=Неопределено, Заголовок=Неопределено, ИмяЗвука="Сигнал")
	
	Если ТипЗнч(ОписаниеОповещения)=Тип("Строка") Тогда
		ОписаниеОповещения = НовыйОписаниеОповещения(ОписаниеОповещения);
	КонецЕсли;
	
	Возврат СтандартныйМодуль.ПоказатьДиалогНаКлиенте(ОписаниеОповещения, Текст, Кнопки, Таймаут, КнопкаПоУмолчанию, Заголовок, ИмяЗвука);
	
КонецФункции
