	Если ДействиеВыполняетсяПосле(Действие) Тогда
		Если ПроверитьВыполнениеПлана() Тогда
			ПредложитьЗавершениеОперации();
		КонецЕсли;

		ДобавитьТаймер("ОбработчикОжидания", 1000);
	КонецЕсли;
	
