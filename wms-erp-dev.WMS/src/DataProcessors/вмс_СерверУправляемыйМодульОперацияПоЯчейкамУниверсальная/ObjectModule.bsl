Функция ОбработчикЭтапаВводаДанныхТовара_КонецВвода(Параметры, ДополнительныеПараметры) Экспорт
	
	СборщикДанныхТоваров = СборщикДанных("СборщикДанныхТоваров");
	Если СборщикДанныхТоваров.ПараметрыМодуля.ДанныеСохранены Тогда
		Если ПроверитьВыполнениеПлана() Тогда
			ПредложитьЗавершениеОперации();
		КонецЕсли;
		
		Если ПараметрыОбработки.ПараллельноеФормированиеЗаданийСледующегоЭтапа Тогда
			ЗарегистрироватьНаОбновлениеЗаданияКладовщиковПоПравилуЗаполненияСледующегоЭтапа();
		КонецЕсли;
	КонецЕсли;

КонецФункции

Функция ЗарегистрироватьНаОбновлениеЗаданияКладовщиковПоПравилуЗаполненияСледующегоЭтапа()
	вмс_ФормированиеЗаданийКладовщикам.ЗарегистрироватьНаОбновлениеЗаданияКладовщиковПоПравилуЗаполнения(ПараметрыОбработки.СледующееПравилоЗаполнения, ПараметрыОбработки.ДокументОснование);
КонецФункции

Функция ДействиеВыборЭлементаТаблицы(Действие)
	
	ИмяТаблицы = Действие.Параметры.ИмяТаблицы;
	
	ЭлементТаблицы = ПолучитьЭлементТаблицыПоИдентификатору(ИмяТаблицы, Действие.Параметры.ИдентификаторЭлемента);
	
	СборщикиДанных = СборщикиДанныхСтраницыОперации("ВводДанных");
	Если ИмяТаблицы="ТаблицаПланФакт" Тогда

		Инструкция = ПолучитьИнструкциюПоИдентификатору(ЭлементТаблицы.ИдентификаторИнструкцииДляПоиска);
		Если Инструкция <> Неопределено Тогда
			ПараметрыТаблицы = ПараметрыТаблицы(ИмяТаблицы);
			ОчиститьДанныеПолей(, , СборщикиДанных);
			УстановитьЗначениеДанныхПоляОбработки("ИдентификаторИнструкцииДляПоиска", Инструкция.ИдентификаторИнструкцииДляПоиска);
			
			//в таблице план-факт идентификатор инструкции совпадает с идентификатором элемента
			ПараметрыТаблицы.ИдентификаторТекущегоЭлемента = Инструкция.ИдентификаторИнструкцииДляПоиска;
			ПараметрыТаблицы.ИдентификаторТекущегоЭлементаНаКлиенте = Инструкция.ИдентификаторИнструкцииДляПоиска;

			//в таблице факт идентификатор инструкции НЕ совпадает с идентификатором элемента, дополнительно получим его
			ЭлементФактаМассив = ДанныеОбработки.Таблицы.ТаблицаФакт.НайтиСтроки(Новый Структура("ИдентификаторИнструкцииДляПоиска", Инструкция.ИдентификаторИнструкцииДляПоиска));
			Если ЭлементФактаМассив.Количество() > 0 Тогда
				ИдентификаторЭлемента = СтандартныйМодуль.ДополнительныеДанныеЭлементаТаблицы("ТаблицаФакт", ЭлементФактаМассив[0]).Идентификатор;
				СтандартныйМодуль.УстановитьТекущийЭлементТаблицы("ТаблицаФакт", ИдентификаторЭлемента);
			КонецЕсли;
			
			ЗаполнитьДанныеПолей(СборщикиДанных);
			ПереключитьСтраницу("ВводДанных");
		КонецЕсли;
		
	ИначеЕсли ИмяТаблицы="ТаблицаФакт" Тогда
		
		Таблица = ДанныеОбработки.Таблицы[ИмяТаблицы];
		ВосстановитьИсходныеСвойстваПолейОбработки();
		ОсновныеПоляСборкиМассив = СписокПолейОбработки(Новый Структура("Сборка, Ресурс", Истина, Ложь));
		ОсновныеПоляСборки = РК.МассивВСтроку(ОсновныеПоляСборкиМассив);
		КолонкиКоллекции = РК.ПолучитьКолонкиКоллекции(Таблица);
		ПоляСборки = РК.ПересечениеМассивов(КолонкиКоллекции, ОсновныеПоляСборкиМассив);
		Если ПоляСборки.Количество() > 0 Тогда
			
			Инструкция = ПолучитьИнструкциюПоИдентификатору(ЭлементТаблицы.ИдентификаторИнструкцииДляПоиска);
			
			Если Инструкция <> Неопределено Тогда
				ПараметрыТаблицы = ПараметрыТаблицы(ИмяТаблицы);
				
				ИдентификаторЭлемента = СтандартныйМодуль.ДополнительныеДанныеЭлементаТаблицы(ПараметрыТаблицы, ЭлементТаблицы).Идентификатор;
				ПараметрыТаблицы.ИдентификаторТекущегоЭлемента = ИдентификаторЭлемента;
				ПараметрыТаблицы.ИдентификаторТекущегоЭлементаНаКлиенте = ИдентификаторЭлемента;
				
				ОчиститьДанныеПолей(, , СборщикиДанных);
				ЗаполнитьЗначенияСвойств(ДанныеОбработки.ВведенныеДанныеПолей, ЭлементТаблицы);
				УстановитьЗначениеДанныхПоляОбработки("ИдентификаторИнструкцииДляПоиска", Инструкция.ИдентификаторИнструкцииДляПоиска);
				СтандартныйМодуль.УстановитьТекущийЭлементТаблицы("ТаблицаПланФакт", Инструкция.ИдентификаторИнструкцииДляПоиска);
				ЗаполнитьДанныеПолей(СборщикиДанных);
				ПереключитьСтраницу("ВводДанных");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Функция ДействиеПриСменеСтраницы(Действие)
	
	Если ДействиеВыполняетсяПосле(Действие) Тогда
		ТаблицыСтраницы = Новый Массив;
		ТаблицыСтраницы.Добавить(Новый Структура("Таблица, Страница", "ТаблицаПланФакт", "ГлавнаяПанельСтраницаПланФакт"));
		ТаблицыСтраницы.Добавить(Новый Структура("Таблица, Страница", "ТаблицаФакт", "ГлавнаяПанельСтраницаФакт"));
		
		Для Каждого ТаблицаСтраница Из ТаблицыСтраницы Цикл
			Если НЕ ДанныеОбработки.Таблицы.Свойство(ТаблицаСтраница.Таблица) Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеОбновленияТаблицыПланФакт = ПараметрыТаблицы(ТаблицаСтраница.Таблица);
			ДополнительныеДанныеЭлементов = ДанныеОбновленияТаблицыПланФакт.ДополнительныеДанныеЭлементов;
			Если ДополнительныеДанныеЭлементов.Количество() > 0 Тогда
				Если ПараметрыОбработки.РабочаяСтраница=ТаблицаСтраница.Страница Тогда
					//очистить клиентский идентификатор чтобы он повторно обновился по серверному идентификатору
					ДанныеОбновленияТаблицыПланФакт.ИдентификаторТекущегоЭлементаНаКлиенте = 0;
				Иначе
					//чтобы список промотался до нужного элемента после перехода на страницу со списком
					ДанныеОбновленияТаблицыПланФакт.СброситьТекущийЭлемент = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

Функция СборщикиДанныхСтраницыОперации(ИмяСтраницы)
	
	ПрефиксСтраницОперации = Обработки.вмс_СерверУправляемыйМодульОперацияПоЯчейкамУниверсальная.ПрефиксСтраницОперации();

	ЭлементыСборщиковСтраницы = ПараметрыОбработки.СтруктураНастройкиПолей.НастройкаСтраниц.НайтиСтроки(Новый Структура("Имя", ПрефиксСтраницОперации + ИмяСтраницы));
	Сборщики = РК.ВыгрузитьЗначенияКолонкиКоллекции(ЭлементыСборщиковСтраницы, "СборщикДанных");
	Возврат Сборщики;
	
КонецФункции


Функция ПроверитьВыполнениеПлана()
	
	Если НЕ ПараметрыОбработки.ЕстьПлан Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаПланФакт = ДанныеОбработки.Таблицы.ТаблицаПланФакт;
	
	Возврат ТаблицаПланФакт.НайтиСтроки(Новый Структура("Выполнен", Ложь)).Количество()=0;
	
КонецФункции

Функция ПредложитьЗавершениеОперации()
	
	ПереключитьСтраницу("ПланФакт");
	
	ПоказатьДиалогНаКлиенте("ОбработчикОтветаНаВопросЗавершитьОперацию", "Задание выполнено. Завершить операцию?", "ДаНет", , , , "Завершение");
	
КонецФункции

