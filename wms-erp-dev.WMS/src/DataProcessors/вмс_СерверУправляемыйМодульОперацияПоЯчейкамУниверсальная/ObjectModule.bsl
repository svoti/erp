#Область Инициализация

Функция ДействиеИнициализироватьПеременныеМодуляОбработки(Действие)

	ТипыВводаКоличества = РК.НовоеПеречисление("Установить, Добавить", "Строка");
	
КонецФункции

Функция ДействиеСозданиеОбработки(Действие)

	ПараметрыИнициализации = Действие.Параметры;
	СсылкаНаЗадание = Неопределено;
	ПараметрыИнициализации.Свойство("СсылкаНаЗадание", СсылкаНаЗадание);
	Если ЗначениеЗаполнено(СсылкаНаЗадание) Тогда
		АктуализироватьЗаданиеКладовщику(СсылкаНаЗадание);
	КонецЕсли;

КонецФункции

//меняет состояние задания на "Обрабатывается" и дозаполняет данные (ячейки и т.п.)
Функция АктуализироватьЗаданиеКладовщику(СсылкаНаЗадание)
	
	НачатьТранзакцию();
	ЗаблокироватьЗаданиеКладовщику(СсылкаНаЗадание);
	ЗаданиеКладовщику = СсылкаНаЗадание.ПолучитьОбъект();
	Если ЗаданиеКладовщику=Неопределено Тогда
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	ЗаданиеКладовщику.Прочитать();
	Если ЗаданиеКладовщику.Состояние=Перечисления.вмс_СостоянияЗаявокКладовщику.Подготовлена Тогда
		ЗаданиеКладовщику.Состояние = Перечисления.вмс_СостоянияЗаявокКладовщику.Обрабатывается;
	КонецЕсли;

	Если ЗаданиеКладовщику.Состояние=Перечисления.вмс_СостоянияЗаявокКладовщику.Обрабатывается Тогда
		Если ЗаданиеКладовщику.Проведен Тогда
			ЗаданиеКладовщику.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	КонецЕсли;
	ЗафиксироватьТранзакцию();
	Возврат Истина;
	
КонецФункции

Функция ДействиеИнициализировать(Действие)

	Если ПараметрыОбработки.Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДействиеВыполняетсяПосле(Действие) Тогда
		//ПараметрыОбработки.ПроцессорВводаДанных.Вставить("ВводКоличества", Ложь);
		
		ЗаполнитьСтраницуЗавершение();

		УстановитьВидимостьТаблицыОбработки("ТаблицаПланФакт", ПараметрыОбработки.ЕстьПлан);
		
		ШрифтТаблиц = Новый Шрифт;
		УстановитьСвойстваЭлементовВывода("ТаблицаПланФакт, ТаблицаФакт", Новый Структура("Шрифт, ВариантУправленияВысотой, ВысотаВСтрокахТаблицы", ШрифтТаблиц, "ВСтрокахТаблицы", 1));
		УстановитьСвойстваЭлементовВывода("ТаблицаПланФактПредставлениеТовара, ТаблицаФактПредставлениеТовара", Новый Структура("Ширина, АвтоВысотаЯчейки", 30, Истина));
		
		УстановитьСвойстваЭлементовВывода("ТаблицаПланФактКоличествоПлан, ТаблицаПланФактКоличествоФактИтогоВТаблице", "Ширина", 7);

		УстановитьСвойстваЭлементовВывода("ТаблицаФактКоличествоФакт", "Ширина", 5);
		
		
		
		ПрефиксСтраниц = Обработки.вмс_СерверУправляемыйМодульОперацияПоЯчейкамУниверсальная.ПрефиксСтраницОперации();
		//УстановитьСвойстваЭлементовВывода("КартинкаТест", Новый Структура("ТипЭлемента, Значение, Родитель", "ПолеКартинки", БиблиотекаКартинок.BCGКорова.ПолучитьДвоичныеДанные(), ПрефиксСтраниц + "Инфо"));
		//УстановитьСвойстваЭлементовВывода("КартинкаТест", Новый Структура("ТипЭлемента, Картинка, Родитель", "Картинка", БиблиотекаКартинок.вмс_Штрихкод, ПрефиксСтраниц + "Инфо"));
		
		
		//УстановитьСвойстваЭлементовВывода(ПолучитьЭлементВыводаДляПоляОбработки("Товар"), Новый Структура("ВариантУправленияВысотой, МаксимальнаяВысота, АвтоМаксимальнаяВысота, АвтоПереносСтрок, МногострочныйРежим", "ПоСодержимому", 1, Ложь, Истина, Истина));
		
		СоздатьПорталВыводаHTMLДляСтраницы("Инфо");
		СоздатьПорталВыводаHTMLДляСтраницыВводДанных();
		
		//УстановитьСвойстваЭлементовВывода("ГлавнаяПанельСтраницаИнфо", Новый Структура("Видимость", Ложь));
		
	КонецЕсли;

КонецФункции

Функция ДействиеИнициализироватьПараметрыОбработки(Действие)
	
	Если ДействиеВыполняетсяПосле(Действие) Тогда
		ПараметрыИнициализации = Действие.Параметры.ПараметрыИнициализации;
		
		//
		СсылкаНаЗадание = Неопределено;
		ПараметрыИнициализации.Свойство("СсылкаНаЗадание", СсылкаНаЗадание);
		Если СсылкаНаЗадание <> Неопределено Тогда
			Задание = СсылкаНаЗадание.ПолучитьОбъект();
			Задание.Прочитать();
		Иначе
			Задание = Неопределено;
		КонецЕсли;
		
		Если Задание=Неопределено Тогда
			ВидОперации = Неопределено;
			ПараметрыИнициализации.Свойство("ВидОперации", ВидОперации);

			Задание = СгенерироватьЗаданиеКладовщику(ВидОперации);

			СсылкаНаЗадание = Задание.Ссылка;
		КонецЕсли;
		
		СтруктураНастройкиПолей = Задание.СтруктураНастройкиПолей();
		Задание.ДополнительныеСвойства.Вставить("СтруктураНастройкиПолей", СтруктураНастройкиПолей);
		
		ПравилоЗаполнения = Задание.Правило;
		СледующееПравилоЗаполнения = ПравилоЗаполнения.СледующееПравило;
		Склад = Задание.Склад;
		ДокументОснование = Задание.Распоряжение;
		ЗонаОтправитель = Задание.ЗонаОтправитель;
		ЗонаПолучатель = Задание.ЗонаПолучатель;
		ВидОперации = Задание.Операция;
		РеквизитыВидаОперации = вмс_ОбщегоНазначенияВызовСервера.ПолучитьЗначенияРеквизитовОбъекта(ВидОперации, "ОтветственноеХранение, ЗапрашиватьУслугиХранения");
		ЕстьОХР = РеквизитыВидаОперации <> Неопределено И ЗначениеЗаполнено(РеквизитыВидаОперации.ОтветственноеХранение);
		ЗапрашиватьУслугиХранения = ЕстьОХР И РеквизитыВидаОперации.ЗапрашиватьУслугиХранения=Истина;
		
		ПараллельноеФормированиеЗаданийСледующегоЭтапа =	ПравилоЗаполнения.ПараллельноеФормированиеЗаданийСледующегоЭтапа
															И ЗначениеЗаполнено(СледующееПравилоЗаполнения)
															И ЗначениеЗаполнено(ДокументОснование);
		
		Инвентаризация = Задание.Инвентаризация;
		ИмяТаблицыФакта = ?(Инвентаризация, "ТоварыПоИнвентаризации", "Товары");
		
		НастройкаОператора = Неопределено;
		ПараметрыИнициализации.Свойство("НастройкаОператора", НастройкаОператора);
		
		Если НастройкаОператора <> Неопределено Тогда
			РеквизитыНастройкиОператора = вмс_ОбщегоНазначенияВызовСервера.ПолучитьЗначенияРеквизитовОбъекта(НастройкаОператора, "Оператор, ЗвуковаяСхема, МасштабФормы");
			Ответственный = РеквизитыНастройкиОператора.Оператор;
			ИмяЗвуковойСхемы = РеквизитыНастройкиОператора.ЗвуковаяСхема.Имя;
			Если ЗначениеЗаполнено(РеквизитыНастройкиОператора.МасштабФормы) Тогда
				ПараметрыОбработки.МасштабФормы = РеквизитыНастройкиОператора.МасштабФормы;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыОбработки.ШрифтФормы = СтруктураНастройкиПолей.Шрифт;
	
		ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля();
		РК.ВычестьМассив(ТоварныеПоляМассив, "Упаковка");
		ТоварныеПоля = РК.МассивВСтроку(ТоварныеПоляМассив);

		ПараметрыОбработки.Вставить("СсылкаНаЗадание", СсылкаНаЗадание);
		ПараметрыОбработки.Вставить("Задание", Задание);
		ПараметрыОбработки.Вставить("СтруктураНастройкиПолей", СтруктураНастройкиПолей);
		ПараметрыОбработки.Вставить("ЕстьПлан", Задание.Товары.Количество() > 0);
		ПараметрыОбработки.Вставить("ВерсияДокументаЗадания");
		ПараметрыОбработки.Вставить("ОперацияПоЯчейкам");
		ПараметрыОбработки.Вставить("ВидОперации", ВидОперации);
		ПараметрыОбработки.Вставить("ЕстьОХР", ЕстьОХР);
		ПараметрыОбработки.Вставить("ЗапрашиватьУслугиХранения", ЗапрашиватьУслугиХранения);
		ПараметрыОбработки.Вставить("НастройкаОператора", НастройкаОператора);
		ПараметрыОбработки.Вставить("ВерсияНастройкиОператора");
		ПараметрыОбработки.Вставить("Ответственный", Ответственный);
		ПараметрыОбработки.Вставить("ДокументОснование", ДокументОснование);
		ПараметрыОбработки.Вставить("ПравилоЗаполнения", ПравилоЗаполнения);
		ПараметрыОбработки.Вставить("СледующееПравилоЗаполнения", СледующееПравилоЗаполнения);
		ПараметрыОбработки.Вставить("ПараллельноеФормированиеЗаданийСледующегоЭтапа", ПараллельноеФормированиеЗаданийСледующегоЭтапа);
		ПараметрыОбработки.Вставить("Склад", Склад);
		ПараметрыОбработки.Вставить("ЗонаОтправитель", ЗонаОтправитель);
		ПараметрыОбработки.Вставить("ЗонаПолучатель", ЗонаПолучатель);
		ПараметрыОбработки.Вставить("ТоварныеПоляМассив", ТоварныеПоляМассив);
		ПараметрыОбработки.Вставить("ТоварныеПоля", ТоварныеПоля);
		ПараметрыОбработки.Вставить("ТипыВводаКоличества", ТипыВводаКоличества);
		ПараметрыОбработки.Вставить("Инвентаризация", Инвентаризация);
		ПараметрыОбработки.Вставить("ИмяТаблицыФакта", ИмяТаблицыФакта);
		ПараметрыОбработки.Вставить("ИмяЗвуковойСхемы", ИмяЗвуковойСхемы);

		ПустойЭлементВывода = ПараметрыОбработки.ПустойЭлементВывода;
		ПустоеПолеОбработки = ПараметрыОбработки.ПустоеПолеОбработки;
	КонецЕсли;
	
КонецФункции

Функция СгенерироватьЗаданиеКладовщику(ВидОперации)

	Правило = Справочники.вмс_ПравилаЗаполненияЗадачиКладовщику.НайтиПравилоЗаполненияЗадания(ВидОперации);
	Если НЕ ЗначениеЗаполнено(Правило) Тогда
		ПараметрыОбработки.Отказ = Истина;
		вмс_СерверУправляемыеОбработки.ДобавитьОшибкуДействия("Не найдено правило заполнения");
		Задание = Документы.вмс_ЗаданиеКладовщику.СоздатьДокумент();
		Возврат Задание;
	КонецЕсли;
	
	ТаблицаЗаданийКладовщику = вмс_ФормированиеЗаданийКладовщикам.ЗаполнитьЗаданияКладовщикамПоРаспоряжению(Правило, Неопределено);
	
	Если ЗначениеЗаполнено(ТаблицаЗаданийКладовщику) Тогда
		Задание = ТаблицаЗаданийКладовщику[0].ЗаданиеКладовщикуОбъект;
		Задание.ДозаполнениеДокумента();
	Иначе
		Задание = Документы.вмс_ЗаданиеКладовщику.СоздатьДокумент();
		Задание.Заполнить(Неопределено);
		ПараметрыОбработки.Отказ = Истина;
		вмс_СерверУправляемыеОбработки.ДобавитьОшибкуДействия("Нет данных для обработки");
	КонецЕсли;

	Возврат Задание;
	
КонецФункции

Функция ДействиеИнициализироватьСборщикиДанных(Действие)

	СтруктураНастройкиПолей = ПараметрыОбработки.СтруктураНастройкиПолей;
	НастройкаСборщиковДанных = СтруктураНастройкиПолей.СборщикиДанных;
	НастройкаСтраниц = СтруктураНастройкиПолей.НастройкаСтраниц;
	Для Каждого НастройкаСборщикаДанных Из НастройкаСборщиковДанных Цикл
		Имя = НастройкаСборщикаДанных.Имя;
		СтраницыСборщика = НастройкаСтраниц.НайтиСтроки(Новый Структура("СборщикДанных", Имя));
		ПоляСборщика = Новый Массив;
		Для Каждого СтраницаСборщика Из СтраницыСборщика Цикл
			РК.ДобавитьЭлементыКоллекции(ПоляСборщика, ПоляОбработки(Новый Структура("Страница", СтраницаСборщика.Имя)));
		КонецЦикла;
		СписокПолейСборщика = РК.ВыгрузитьЗначенияКолонкиКоллекции(ПоляСборщика, "Имя");
		
		Если НастройкаСборщикаДанных.Тип="СборщикДанныхТоваров" Тогда
			Если СписокПолейСборщика.Найти("Маркировка") <> Неопределено Тогда
				СборщикДанных = СтандартныйМодуль.ДобавитьСборщикДанных("СборщикДанныхМаркировки", "СборщикДанныхМаркировки");
				СборщикДанных.УстановитьПоля(ПоляСборщика);
				СборщикДанных.УстановитьРабочиеСтраницы(РК.ВыгрузитьЗначенияКолонкиКоллекции(СтраницыСборщика, "Имя"));
			КонецЕсли;
		КонецЕсли;
		
		СборщикДанных = СтандартныйМодуль.ДобавитьСборщикДанных(НастройкаСборщикаДанных.Тип, Имя);
		СборщикДанных.УстановитьПоля(ПоляСборщика);
		СборщикДанных.УстановитьРабочиеСтраницы(РК.ВыгрузитьЗначенияКолонкиКоллекции(СтраницыСборщика, "Имя"));
	КонецЦикла;
	
	СборщикДанныхТоваров = СборщикДанных("СборщикДанныхТоваров");
	Если СборщикДанныхТоваров <> Неопределено Тогда
		УстановитьДополнительныеПоляСборщикаДанныхТоваров(СборщикДанныхТоваров);
		СборщикДанныхТоваров.ДобавитьЭтапВводаДанных(НовыйОписаниеОповещения("ОбработчикЭтапаВводаДанныхТовара_КонецВвода"), "КонецВвода");
	КонецЕсли;

	СборщикДанныхЗавершение = СборщикДанных("СборщикДанныхЗавершение");
	Если СборщикДанныхЗавершение <> Неопределено Тогда
		СборщикДанныхЗавершение.ДобавитьЭтапВводаДанных(НовыйОписаниеОповещения("ОбработчикЭтапаВводаДанныхПередЗавершениемОперации"), "КонецВвода");
	КонецЕсли;
	
	УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция УстановитьДополнительныеПоляСборщикаДанныхТоваров(СборщикДанныхТоваров)
	
	ПоляИспользуемыеСборщиками = Новый Массив;
	Для Каждого СборщикДанных Из СборщикиДанных() Цикл
		РК.ДобавитьЭлементыКоллекции(ПоляИспользуемыеСборщиками, СборщикДанных.ПараметрыМодуля.ПоляОбработки.ВыгрузитьКолонку("Имя"));
	КонецЦикла;
	
	ПоляСборщика = Новый Массив;
	Для Каждого ИмяСтраницы Из СборщикДанныхТоваров.ПараметрыМодуля.РабочиеСтраницы Цикл
		РК.ДобавитьЭлементыКоллекции(ПоляСборщика, СписокПолейОбработки(Новый Структура("Страница", ИмяСтраницы)));
	КонецЦикла;
	
	ДополнительныеПоляСборщика = РК.ВычитаниеМассивов(ПоляСборщика, ПоляИспользуемыеСборщиками);
	Если ДополнительныеПоляСборщика.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ИмяПоля Из ДополнительныеПоляСборщика Цикл
		Обработки.вмс_СерверУправляемыйМодульСтандартный.УстановитьСвойстваПолейОбработки(СборщикДанныхТоваров.ПараметрыМодуля, ИмяПоля, ПолеОбработки(ИмяПоля));
	КонецЦикла;
	
	СборщикДанныхТоваров.ИнициализироватьДанные();
	
	Возврат Истина;
	
КонецФункции

Функция ДействиеИнициализироватьИсточникиДанныхДляЗаполненияПолей(Действие)

	СтандартныйМодуль.ДобавитьИсточникДанныхДляЗаполненияПолей("Задание", "ПараметрыОбработки.Задание");
	СтандартныйМодуль.ДобавитьИсточникДанныхДляЗаполненияПолей("Задание.Товары", "ДанныеОбработки.Таблицы.ТаблицаПланФакт");

КонецФункции

Функция ДействиеИнициализироватьПоляОбработкиПоУмолчанию(Действие)
	
	РК.УстановитьЭлементыКоллекции(ПараметрыОбработки.ПоляОбработки, вмс_СерверУправляемыеОперации.ТаблицаЗначенийСвойствПолейОперацииПоУмолчанию());

	//отключим по умолчанию все поля, после завершения инициализации неиспользуемые поля будут удалены
	УстановитьСвойстваПолейОбработки(, "Использование", Ложь);

	УстановитьРезультатДействия(Действие, Истина);

КонецФункции

Функция ДействиеИнициализироватьПоляОбработки(Действие)

	ИнициализироватьПоляОбработкиПоЗаданию();
	
	Если ПараметрыОбработки.Инвентаризация Тогда
		ПолеЯчейка = ПолеОбработки("Ячейка");
		Если ПолеЯчейка.Использование Тогда
			УстановитьСвойстваПолейОбработки(ПолеЯчейка, Новый Структура("Синоним, СинонимВинительныйПадеж", "Ячейка", "Ячейку"));
		КонецЕсли;
	КонецЕсли;
	
	ИнициализироватьПоляОперацииПриЗавершении();
	
	ИнциализироватьСобытияПолейОбработки();
	
	УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция ИнциализироватьСобытияПолейОбработки()
	Для Каждого Поле Из ПоляОбработки(Новый Структура("Группа, Ввод, Вывод", "Количество", Истина, Истина)) Цикл
		УстановитьОбработчикиСобытийПолейОбработки(Поле, Новый Структура("Нажатие", НовыйОписаниеОповещения("ОбработчикОткрытьФормуВводаКоличества", , Новый Структура("ИмяПоля", Поле.Имя))));
		УстановитьСвойстваЭлементовВывода(Поле.ИмяЭлементаВывода, Новый Структура("ТолькоПросмотр", Истина));
	КонецЦикла;
КонецФункции

Функция ОбработчикОткрытьФормуВводаКоличества(Результат, ДополнительныеПараметры) Экспорт
	
	ПараметрыДействия = Новый Структура("Отказ", Ложь);
	ДействиеПередОткрытиемФормыВводаКоличества = Действие("ПередОткрытиемФормыВводаКоличества", ПараметрыДействия);
	ДействиеПередОткрытиемФормыВводаКоличества.Результат = ПараметрыДействия;
	вмс_СерверУправляемыеОбработки.ВыполнитьДействиеПереопределяемый(ДействиеПередОткрытиемФормыВводаКоличества);
	Если ДействиеПередОткрытиемФормыВводаКоличества.Результат.Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Количество", ДанныеОбработки.ПредставлениеДанныхПолей[ДополнительныеПараметры.ИмяПоля]);
	СтандартныйМодуль.ПоказатьФормуДиалога(НовыйОписаниеОповещения("ОбработчикЗакрытияФормыВводаКоличества", , ДополнительныеПараметры), "ОбщаяФорма.ФормаВводаКоличества", ПараметрыФормы);
	
КонецФункции

Функция ОбработчикЗакрытияФормыВводаКоличества(ВведенноеКоличество, ДополнительныеПараметры) Экспорт
	
	Если ВведенноеКоличество=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВвестиДанныеПоля(ДополнительныеПараметры.ИмяПоля, ВведенноеКоличество);
	
КонецФункции

Функция ИнициализироватьПоляОбработкиПоЗаданию()
	
	СтруктураНастройкиПолей = ПараметрыОбработки.СтруктураНастройкиПолей;
	
	ПорядокВвода = 1;
	
	НастройкаПолей = СтруктураНастройкиПолей.НастройкаПолей.Скопировать();
	НастройкаПолей.Сортировать("ПорядокВвода");
	
	Для Каждого НастройкаПоля Из НастройкаПолей Цикл
		
		Если НЕ (НастройкаПоля.Ввод ИЛИ НастройкаПоля.Сборка ИЛИ НастройкаПоля.Вывод) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = НастройкаПоля.Имя;
		Если ИмяПоля="ЯчейкаОтправитель" Тогда
			ИмяПоля = "Ячейка";
		КонецЕсли;
		
		СвойстваПоля = Новый Структура("ОбязательныйВвод, ОбязательноеЗаполнение, Сборка, Ввод, План, Вывод, Ресурс, Страница, ПутьКДаннымЗаполнения, Синоним, ПоложениеЗаголовка", Истина, Истина, Ложь, Ложь, Ложь, Ложь, Ложь);
		ЗаполнитьЗначенияСвойств(СвойстваПоля, НастройкаПоля);
		Если ЗначениеЗаполнено(СвойстваПоля.Страница) Тогда
			СвойстваПоля.Страница = СвойстваПоля.Страница;
		КонецЕсли;
		
		ТипЗначения = НастройкаПоля.ТипЗначения;
		Если ТипЗнч(ТипЗначения)=Тип("ОписаниеТипов") И ТипЗначения.Типы().Количество() > 0 Тогда
			СвойстваПоля.Вставить("ТипЗначения", ТипЗначения);
		КонецЕсли;
		
		Шрифт = НастройкаПоля.Шрифт;
		Если ТипЗнч(Шрифт) <> Тип("Шрифт") Тогда
			Шрифт = Новый Шрифт;
		КонецЕсли;

		СвойстваПоля.Вставить("ПорядокВвода", ПорядокВвода);
		СвойстваПоля.Вставить("ПорядокВывода", ПорядокВвода);
		СвойстваПоля.Вставить("Шрифт", Шрифт);
		
		УстановитьСвойстваПолейОбработки(ИмяПоля, СвойстваПоля);
		УстановитьСвойстваЭлементовВывода(ИмяПоля, Новый Структура("МногострочныйРежим", Истина));
		
		ПорядокВвода = ПорядокВвода + 1;
		
	КонецЦикла;

	Подсказка = ПолеОбработки("Подсказка");
	Если Подсказка <> ПустоеПолеОбработки Тогда
		УстановитьСвойстваЭлементовВывода(ПолучитьЭлементВыводаДляПоляОбработки("Подсказка", Подсказка), Новый Структура("ГоризонтальноеПоложение, РастягиватьПоВертикали", "Центр", "Нет"));
	КонецЕсли;
		
	ПорядокВвода = ПорядокВвода + 1;
	УстановитьСвойстваПолейОбработки("КоличествоПлан",		Новый Структура("План, Вывод, Ресурс, НачальноеЗначение, ЗначениеПоУмолчанию, ПустыеЗначения, ПорядокВывода, Страница, ПоложениеЗаголовка, Шрифт", Истина, Ложь, Истина, 0, 0, 0, ПорядокВвода, "ГлавнаяПанельСтраницаВводДанных", "Нет", Шрифт));
	УстановитьСвойстваЭлементовВывода("КоличествоПлан", "РастягиватьПоВертикали", Ложь);
	УстановитьСвойстваПолейОбработки("КоличествоФактИтого", Новый Структура("План, Вывод, Ресурс, НачальноеЗначение, ЗначениеПоУмолчанию, ПустыеЗначения, ПорядокВывода", Истина, Ложь,	Истина, 0, 0, 0, ПорядокВвода+1));

КонецФункции

Функция ИнициализироватьПоляОперацииПриЗавершении()
	ПрефиксСтраницОперации = Обработки.вмс_СерверУправляемыйМодульОперацияПоЯчейкамУниверсальная.ПрефиксСтраницОперации();
	ИмяСтраницы = ПрефиксСтраницОперации + "Завершение";

	УстановитьСвойстваПолейОбработки("ПодтвердитьРасхожденияПоПлану", Новый Структура("Ввод, Вывод, АвтоНачалоВыбора, ТипЗначения, Страница", Истина, Ложь, Истина, Новый ОписаниеТипов("Булево"), ИмяСтраницы));
	СтандартныйМодуль.УстановитьОбработчикиСобытийПолейОбработки("ПодтвердитьРасхожденияПоПлану", Новый Структура("НачалоВыбора", НовыйОписаниеОповещения("ОбработчикЗадатьВопросПодтвердитьРасхожденияПоПлану")));
	
	Если ПараметрыОбработки.ЗапрашиватьУслугиХранения Тогда
		УстановитьСвойстваПолейОбработки("УслугиОХР", Новый Структура("Ввод, Вывод, АвтоНачалоВыбора, ТипЗначения, Страница", Истина, Ложь, Истина, Новый ОписаниеТипов("Булево"), ИмяСтраницы));
		СтандартныйМодуль.УстановитьОбработчикиСобытийПолейОбработки("УслугиОХР", Новый Структура("НачалоВыбора", НовыйОписаниеОповещения("ОбработчикЗадатьВопросНужноВвестиУслугиОХР")));
	КонецЕсли;
КонецФункции

Функция ДействиеЗакончитьИнициализациюПолейОбработки(Действие)
	
	Если ПараметрыОбработки.ЕстьПлан Тогда
		Для Каждого ПолеКоличества Из ПоляОбработки(Новый Структура("Группа", "Количество")) Цикл
			Если ПолеКоличества.План И ПолеКоличества.Вывод Тогда
				УстановитьСвойстваПолейОбработки("КоличествоПлан", Новый Структура("Вывод", Истина));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ПолеОбработки Из ПоляОбработки() Цикл
		Если НЕ ЗначениеЗаполнено(ПолеОбработки.Страница) Тогда
			ПолеОбработки.Страница = "ГлавнаяПанельСтраницаВводДанных";
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция СоздатьПорталВыводаHTMLДляСтраницыВводДанных()
	
	ИмяПортала = СоздатьПорталВыводаHTMLДляСтраницы("ВводДанных");
	
	КнопкаДалее = ЭлементВывода("КнопкаДалее");
	Если КнопкаДалее <> ПустойЭлементВывода Тогда
		СвойстваЭлемента = Новый Структура;
		СвойстваЭлемента.Вставить("ТипЭлемента", КнопкаДалее.ТипЭлемента);
		СвойстваЭлемента.Вставить("Видимость", Ложь);
		СвойстваЭлемента.Вставить("Номер", КнопкаДалее.Номер);
		Если КнопкаДалее.Свойства.Свойство("СочетаниеКлавиш") Тогда
			СвойстваЭлемента.Вставить("СочетаниеКлавиш", КнопкаДалее.Свойства.СочетаниеКлавиш);
		КонецЕсли;
		УстановитьСвойстваЭлементовВывода("КнопкаДалееПереходникHTML", СвойстваЭлемента);
		УстановитьОбработчикиСобытийЭлементовВывода("КнопкаДалееПереходникHTML", РК.СкопироватьОбъект(КнопкаДалее.События));

		ПрограммныйКод =
		"document = ЭтаФорма.Элементы.[ПорталВыводаHTML].Документ;
		|defaultView = document.defaultView;
		|document.activeElement.blur();
		|button = defaultView.КнопкаДалееПереходникHTML;
		|Если button <> Неопределено Тогда
		|	button.focus();
		|	button.click();
		|КонецЕсли;";
		
		ПрограммныйКод = СтрЗаменить(ПрограммныйКод, "[ПорталВыводаHTML]", ИмяПортала);
		
		ДополнительныеПараметры = Новый Структура("ПрограммныйКод", ПрограммныйКод);
		УстановитьОбработчикиСобытийЭлементовВывода("КнопкаДалее", Новый Структура("Нажатие", НовыйОписаниеОповещения("ОбработчикКнопкиДалееВызовHTML", , ДополнительныеПараметры)));
		
		УстановитьСвойстваЭлементовВывода("КнопкаДалееПереходникHTML", "Портал", ИмяПортала);
	КонецЕсли;
	
КонецФункции

Функция СоздатьПорталВыводаHTMLДляСтраницы(ИмяСтраницы)

	ИмяПортала = "ПорталВыводаHTMLСтраницы" + ИмяСтраницы;
	
	ИмяСтраницыПолное = "ГлавнаяПанельСтраница" + ИмяСтраницы;
	УстановитьСвойстваЭлементовВывода(ИмяПортала, Новый Структура("ТипЭлемента, АктивизироватьПоУмолчанию, Родитель", "ПолеHTMLДокумента", Истина, ИмяСтраницыПолное));
	
	ПоляВывода = ПоляОбработки(Новый Структура("Вывод, Страница", Истина, ИмяСтраницыПолное));
	Если ПоляВывода.Количество() > 0 Тогда
		ПорядокВывода = ПоляВывода[0].ПорядокВывода;
		Для Каждого ПолеВывода Из ПоляВывода Цикл
			Если ПолеВывода.ПорядокВывода < ПорядокВывода Тогда
				ПорядокВывода = ПолеВывода.ПорядокВывода;
			КонецЕсли;
		КонецЦикла;
		УстановитьСвойстваЭлементовВывода(ИмяПортала, Новый Структура("Номер", ПорядокВывода));
	КонецЕсли;
	СписокЭлементовВывода = РК.ВыгрузитьЗначенияКолонкиКоллекции(ПоляВывода, "ИмяЭлементаВывода");
	
	УстановитьСвойстваЭлементовВывода(СписокЭлементовВывода, "Портал", ИмяПортала);
	
	УстановитьОбработчикиСобытийЭлементовВывода(ИмяПортала, Новый Структура("ПриНажатии", НовыйОписаниеОповещения("ОбработчикHTMLСобытия", СтандартныйМодуль)));
	УстановитьОбработчикиСобытийЭлементовВывода(ИмяПортала, Новый Структура("RunTimeError", НовыйОписаниеОповещения("ОбработчикОшибкиВыполнения", СтандартныйМодуль)));

	Возврат ИмяПортала;

КонецФункции

