Функция ЗавершитьОперацию()
	
	Если ВвестиДанныеПередЗавершениемОперации() Тогда
		//начат ввод данных
		Возврат Ложь;
	КонецЕсли;
	
	//ввод данных не требуется, завершаем операцию
	Возврат ЗавершитьОперациюПослеВводаДанных();
	
КонецФункции

Функция ЗавершитьОперациюПослеВводаДанных()
	
	НачатьТранзакцию();
	
	Если НЕ ВыполнитьЗавершениеОперации() Тогда
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
	ЗавершитьРаботуОбработки();
	Возврат Истина;
	
КонецФункции

Функция ДействиеВыполнитьЗавершениеОперации(Действие)
	
	Для Каждого СборщикДанных Из СборщикиДанных() Цикл
		Если НЕ СборщикДанных.ВыполнитьЗавершениеОперации() Тогда
			Возврат УстановитьРезультатДействия(Действие, Ложь);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ УстановитьПризнакГотовОперацииПоЯчейкам() Тогда
		Возврат УстановитьРезультатДействия(Действие, Ложь);
	КонецЕсли;

	вмс_ОперацииПоЯчейкамВызовСервера.ЗавершитьОперациюПоДокументу(ПараметрыОбработки.СсылкаНаЗадание, ПараметрыОбработки.ВидОперации, ПараметрыОбработки.Ответственный, , ДанныеОбработки.СсылкаОперацииПоЯчейкам);
	Если ПараметрыОбработки.ЕстьОХР И ЗначениеЗаполнено(ПараметрыОбработки.ДокументОснование) Тогда
		Документы.ОХР_РегистрацияОпераций.ЗаписатьПоОперацииПоЯчейкамПоОснованию(ПараметрыОбработки.ДокументОснование, ПараметрыОбработки.ВидОперации, ПараметрыОбработки.Ответственный);
	КонецЕсли;
	
	Возврат УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция УстановитьПризнакГотовОперацииПоЯчейкам()
	
	ОперацияПоЯчейкам = ПолучитьДокументОперацииПоЯчейкам();
	ОперацияПоЯчейкам.Готов = Истина;
	Возврат ЗаписатьДокументОперацииПоЯчейкам(ОперацияПоЯчейкам);
	
КонецФункции

Процедура ОбработчикОтветаНаВопросЗавершитьОперацию(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ="Да" Тогда
		ЗавершитьОперацию();
	КонецЕсли;
	
КонецПроцедуры

Функция ВвестиДанныеПередЗавершениемОперации()
	
	СборщикДанныхЗавершение = СборщикДанных("СборщикДанныхЗавершение"); 
	Если СборщикДанныхЗавершение=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СборщикДанныхЗавершение.НачатьВыборСледующегоПоля();
	
КонецФункции

Функция ОбработчикЭтапаВводаДанныхПередЗавершениемОперации(Параметры, ДополнительныеПараметры) Экспорт
	
	СборщикДанныхЗавершение = СборщикДанных("СборщикДанныхЗавершение"); 
	
	Если СборщикДанныхЗавершение.ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.ВсеПоляЗаполнены Тогда
		ДанныеОбработки.ВводДанныхПередЗавершениемОперацииЗавершен = Истина;
	КонецЕсли;
	
КонецФункции

Функция ДействиеПередЗакрытиемФормыОбработки(Действие)
	
	ПоказатьДиалогНаКлиенте("ОбработчикОтветаНаВопросЗакрытьФорму", "Закрыть?", "OKОтмена");

	Ответ = Действие.Параметры;
	Ответ.Отказ = Истина;
	УстановитьРезультатДействия(Действие, Ответ);
	
КонецФункции

Процедура ОбработчикОтветаНаВопросЗакрытьФорму(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ="OK" Тогда
		
		ЗавершитьРаботуОбработки();
		
