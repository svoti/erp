Функция ДействиеПолучитьДокументОперацииПоЯчейкам(Действие)

	ОперацияПоЯчейкам = ПараметрыОбработки.ОперацияПоЯчейкам;
	СсылкаОперацииПоЯчейкам = ДанныеОбработки.СсылкаОперацииПоЯчейкам;
	
	Если ЗначениеЗаполнено(СсылкаОперацииПоЯчейкам) Тогда
		
		НоваяВерсияДанных = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(СсылкаОперацииПоЯчейкам);
		
		Если НоваяВерсияДанных <> "" Тогда
			Если ОперацияПоЯчейкам=Неопределено Тогда
				ОперацияПоЯчейкам = СсылкаОперацииПоЯчейкам.ПолучитьОбъект();
				ПараметрыОбработки.ОперацияПоЯчейкам = ОперацияПоЯчейкам;
			КонецЕсли;
			ВерсияДанных = ОперацияПоЯчейкам.ВерсияДанных;
		Иначе
			Если ОперацияПоЯчейкам=Неопределено Тогда
				ВерсияДанных = "";
			Иначе
				ВерсияДанных = ОперацияПоЯчейкам.ВерсияДанных;
			КонецЕсли;
		КонецЕсли;

		Если ВерсияДанных <> НоваяВерсияДанных Тогда
			
			Если НоваяВерсияДанных <> "" Тогда
				
				ОперацияПоЯчейкам.Прочитать();
				Если ОперацияПоЯчейкам.ПометкаУдаления Тогда
					//документ помечен на удаление
					ОперацияПоЯчейкам = Неопределено;
					ПараметрыОбработки.ОперацияПоЯчейкам = ОперацияПоЯчейкам;
				КонецЕсли;
				
			Иначе
				
				//документ удален
				ОперацияПоЯчейкам = Неопределено;
				ПараметрыОбработки.ОперацияПоЯчейкам = ОперацияПоЯчейкам;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОперацияПоЯчейкам=Неопределено И Действие.Параметры.Создавать Тогда
		
		ОперацияПоЯчейкам = НовыйДокументОперацииПоЯчейкам();
		ПараметрыОбработки.ОперацияПоЯчейкам = ОперацияПоЯчейкам;
		
	КонецЕсли;
	
	Возврат УстановитьРезультатДействия(Действие, ОперацияПоЯчейкам);

КонецФункции

Функция ДействиеЗаписатьДокументОперацииПоЯчейкам(Действие)
	
	ОперацияПоЯчейкам = Действие.Параметры.ОперацияПоЯчейкам;
	
	ОперацияПоЯчейкам.ВремяОкончанияОперации = ТекущаяДатаСеанса();
	
	Отказ = Ложь;
	СтандартныйМодуль.НачатьСборСообщений();
	Попытка
		ОперацияПоЯчейкам.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Отказ = Истина;
	КонецПопытки;
	СтандартныйМодуль.ЗакончитьСборСообщений();
	
	Если Отказ Тогда
		СобранныеСообщения = СтандартныйМодуль.СобранныеСообщения();
		Если СобранныеСообщения.Количество()=0 Тогда
			СобранныеСообщения.Добавить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		Иначе
			УбратьНомераСтрокИзСообщений();
		КонецЕсли;
		СтандартныйМодуль.ОтправитьСобранныеСообщенияВОшибкуДействия();
		ПараметрыОбработки.ОперацияПоЯчейкам = Неопределено;
	Иначе
		СтандартныйМодуль.УдалитьСобранныеСообщения();
		ДанныеОбработки.СсылкаОперацииПоЯчейкам = ОперацияПоЯчейкам.Ссылка;
	КонецЕсли;
	
	Возврат УстановитьРезультатДействия(Действие, НЕ Отказ);
	
КонецФункции

Функция УбратьНомераСтрокИзСообщений()
	
	Сообщения = СтандартныйМодуль.СобранныеСообщения();
	Для НомерСообщения=0 По Сообщения.ВГраница() Цикл
		Сообщение = Сообщения[НомерСообщения];
		Если СтрНайти(нрег(Сообщение), "номер строки ") <> 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Позиция = СтрНайти(Сообщение, ": ");
		Если Позиция=0 Тогда
			Продолжить;
		КонецЕсли;
		
		Сообщение = Прав(Сообщение, СтрДлина(Сообщение) - Позиция - 1);
		Сообщения[НомерСообщения] = Сообщение;
	КонецЦикла;
	
КонецФункции

Функция ДействиеНовыйДокументОперацииПоЯчейкам(Действие)
	
	ОперацияПоЯчейкам = Документы.вмс_ОперацияПоЯчейкам.СоздатьДокумент();
	ОперацияПоЯчейкам.Дата = ТекущаяДатаСеанса();
	ОперацияПоЯчейкам.ВремяНачалаОперации = ОперацияПоЯчейкам.Дата;
	ОперацияПоЯчейкам.ДокументОснование = ПараметрыОбработки.ДокументОснование;
	ОперацияПоЯчейкам.ЗаданиеКладовщику = ПараметрыОбработки.СсылкаНаЗадание;
	ОперацияПоЯчейкам.ВидОперации = ПараметрыОбработки.ВидОперации;
	ОперацияПоЯчейкам.Версия = 2;
	ОперацияПоЯчейкам.Ответственный = ПараметрыОбработки.Ответственный;
	
	Возврат УстановитьРезультатДействия(Действие, ОперацияПоЯчейкам);

КонецФункции

