&НаКлиенте
Функция ПоляИсточникаИПриемникаЗаполнены()
	
	РеквизитыФормы = Новый СписокЗначений();
	Для каждого ПолеИсточника Из Элементы.Источник.ПодчиненныеЭлементы Цикл
		Если ПолеИсточника.Видимость=Истина Тогда
			РеквизитыФормы.Добавить(ПолеИсточника.Имя, ПолеИсточника.Заголовок)	
		КонецЕсли;	
	КонецЦикла;
	
	Для каждого ПолеИсточника Из Элементы.Приемник.ПодчиненныеЭлементы Цикл
		Если ПолеИсточника.Видимость=Истина Тогда
			РеквизитыФормы.Добавить(ПолеИсточника.Имя, ПолеИсточника.Заголовок)	
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Реквизит Из РеквизитыФормы Цикл	
		Если Не ЗначениеЗаполнено(ЭтотОбъект[Реквизит.Значение]) И Не  Реквизит.Значение = "ОбъектПриемник" Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Пустое поле: " + Реквизит.Представление;
			Сообщение.Поле = Реквизит.Значение;
			Сообщение.УстановитьДанные(Реквизит.Значение);
			Сообщение.ОбщегоНазначенияКлиент.СообщитьПользователю();
			Возврат Ложь;
		КонецЕсли;  		
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаСервере
Функция  ЗаполнитьДокументПриемник()	
	ПравилоКонвертации = СоздатьПравилаКонвертации(); 
	Возврат  Справочники.вмс_ПравилаКонвертацииРеквизитов.ВыполнитьПравилоКонвертации(ПравилоКонвертации, 
