КонецФункции

&НаСервере
Функция ПолучитьСтруктуруДокумента(ТипДокумента, НаименованиеТаблицы = "")
	
	МетаданныеДокумента = ПустаяСсылкаДокумента(ТипДокумента).Метаданные();	 
	СтруктураДокумента = новый Структура("РеквизитыШапки, КлолнкиТабличнойЧасти, ИмяТабличнойЧасти, ТипДокумента", Новый Массив, Новый Массив, НаименованиеТаблицы, ТипДокумента);   
		
	Для каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл    
		
		СтруктураРеквизита = Новый Структура("Имя, Тип",Реквизит.Имя, Реквизит.Тип);	
		СтруктураДокумента.РеквизитыШапки.Добавить(СтруктураРеквизита);
		
	КонецЦикла;	 
	
	Если НаименованиеТаблицы <> ""  Тогда
		
		Если  НаименованиеТаблицы <> "ТоварТСД" Тогда
			
			МетаданныеТабличнойЧастиДокумента= МетаданныеДокумента.ТабличныеЧасти.Найти(НаименованиеТаблицы); 
			
			Если МетаданныеТабличнойЧастиДокумента <> Неопределено  Тогда
				
				Для каждого Колонка  Из МетаданныеТабличнойЧастиДокумента.Реквизиты Цикл		
					СтруктураРеквизита = Новый Структура("Имя, Тип",Колонка.Имя, Колонка.Тип);	
					СтруктураДокумента.КлолнкиТабличнойЧасти.Добавить(СтруктураРеквизита);
				КонецЦикла;	  
				
			КонецЕсли; 
			
		Иначе 
			
			ПустаяТаблицаПринятыхТоваров = ПустаяТаблицаПринятыхТоваровТСД();
			
			Для каждого Колонка Из ПустаяТаблицаПринятыхТоваров.Колонки Цикл			
				СтруктураРеквизита = Новый Структура("Имя, Тип",Колонка.Имя, Колонка.ТипЗначения);
				СтруктураДокумента.КлолнкиТабличнойЧасти.Добавить(СтруктураРеквизита);
			КонецЦикла;  
			
		КонецЕсли;  
		
	КонецЕсли;
	
	Возврат СтруктураДокумента;
	
КонецФункции 


#Область ЗаполнениеТаблицы

&НаСервере
Процедура ЗаполнитьТаблицыРеквизитовФормы()
	
	РеквизитыШапкиДокумента.Очистить();  
	РеквизитыТабличнойЧастиДокумента.Очистить();
	РеквизитыТабличнойЧастиТСД.Очистить();
	
	Если  ЗначениеЗаполнено(ТипОбъектаИсточник)  Тогда
		ОбъектМетаданныхШапкиИсточник = ПустаяСсылкаДокумента(ТипОбъектаИсточник).Метаданные();		
		ЗаполнитьТаблицуРеквизитамиИсточника(ОбъектМетаданныхШапкиИсточник, РеквизитыШапкиДокумента);
		//ЗаполнитьТаблицуЗначениямиИсточника(ОбъектИсточник);
	КонецЕсли;	
	
	
	Если  ЗначениеЗаполнено(ТипОбъектаПриемник)   Тогда
		ОбъектМетаданныхШапкиПриемник = ПустаяСсылкаДокумента(ТипОбъектаПриемник).Метаданные();
		ЗаполнитьТаблицуРеквизитамиПриемник(ОбъектМетаданныхШапкиПриемник, РеквизитыШапкиДокумента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяТабличнойЧастиИсточник)  Тогда
		ОбъектМетаданныхТабличнойЧастиИсточник = ПустаяСсылкаДокумента(ТипОбъектаИсточник).Метаданные().ТабличныеЧасти[ИмяТабличнойЧастиИсточник];
		ЗаполнитьТаблицуРеквизитамиИсточника(ОбъектМетаданныхТабличнойЧастиИсточник, РеквизитыТабличнойЧастиДокумента);
	КонецЕсли; 
	
	Если ЗагрузитьРеквизитыТабличнуюЧастьПринятыхТоваровИзТСД ИЛИ ЗагрузитьРеквизитыТабличнуюЧастьОтобранныхТоваровИзТСД Тогда
		ЗаполнитьТаблицуРеквизитамиПринятыхИОтобранныхТоваров(РеквизитыТабличнойЧастиТСД);
	КонецЕсли;
	
	Если РеквизитыТабличнойЧастиДокумента.Количество() > 0 И ЗначениеЗаполнено(ИмяТабличнойЧастиПриемник)  Тогда
		ОбъектМетаданныхТабличнойЧастиПриемник = ПустаяСсылкаДокумента(ТипОбъектаПриемник).Метаданные().ТабличныеЧасти[ИмяТабличнойЧастиПриемник];
		ЗаполнитьТаблицуРеквизитамиПриемник(ОбъектМетаданныхТабличнойЧастиПриемник, РеквизитыТабличнойЧастиДокумента);	
	КонецЕсли;     
	
	Если РеквизитыТабличнойЧастиТСД.Количество() > 0 И ЗначениеЗаполнено(ИмяТабличнойЧастиПриемник)  Тогда
		ОбъектМетаданныхТабличнойЧастиПриемник = ПустаяСсылкаДокумента(ТипОбъектаПриемник).Метаданные().ТабличныеЧасти[ИмяТабличнойЧастиПриемник];
		ЗаполнитьТаблицуРеквизитамиПриемник(ОбъектМетаданныхТабличнойЧастиПриемник, РеквизитыТабличнойЧастиТСД);	
	КонецЕсли;

	
	ОтсортироватьТаблицыФормы();	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРеквизитамиИсточника(ОбъектМетаданных, Таблица)
	РеквизитыДокумента = РеквизитыОбъекта(ОбъектМетаданных);
	
	Для каждого Реквизит Из РеквизитыДокумента Цикл	
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.ПредставлениеРеквизитаИсточник = Реквизит.Представление;
		СтрокаТаблицы.ИмяРеквизитаИсточник = Реквизит.Имя;
		СтрокаТаблицы.ОписаниеТиповИсточник = Реквизит.Тип;  
		
		Если Реквизит.Имя = "Комментарий" Тогда
			СтрокаТаблицы.Выражение = "Приемник.Комментарий =  ""Заполнено с ТСД на основании """""" + Строка(Источник) + """"""""" ;
		КонецЕсли;
		
	КонецЦикла;	 
	
КонецПроцедуры    

&НаСервере
Процедура ЗаполнитьТаблицуРеквизитамиПринятыхИОтобранныхТоваров(Таблица) 
	
	ПустаяТаблицаПринятыхТоваров = ПустаяТаблицаПринятыхТоваровТСД();
	
	Для каждого Колонка Из ПустаяТаблицаПринятыхТоваров.Колонки Цикл	
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.ПредставлениеРеквизитаИсточник = Колонка.Заголовок + " (" + Колонка.ТипЗначения + ")" ;
		СтрокаТаблицы.ИмяРеквизитаИсточник = Колонка.Имя;
		СтрокаТаблицы.ОписаниеТиповИсточник = Колонка.ТипЗначения;	
	КонецЦикла;  
	
КонецПроцедуры      

&НаСервере
Функция ПустаяТаблицаПринятыхТоваровТСД() 
	Отбор = Новый Структура("ДокументОснование, ВидОперации", Неопределено, Неопределено);  
	Возврат вмс_ОперацииПоЯчейкамСервер.ПолучитьТаблицуПринятыхТоваровЧерезСтруктуру(Отбор);
КонецФункции    

&НаСервере
Процедура ПолучитьКолонкиТаблицыПринятыхТоваровТСД( МассивРеквизитов) 
	
	ПустаяТаблицаПринятыхТоваров = ПустаяТаблицаПринятыхТоваровТСД();
	
	Если  МассивРеквизитов = Неопределено Тогда	
		МассивРеквизитов = Новый Массив;	
	КонецЕсли;
	
	
	Для каждого Колонка Из ПустаяТаблицаПринятыхТоваров.Колонки Цикл	    
		
		Реквизит =  Новый Структура;
		Реквизит.Вставить("Имя",Колонка.Имя); 
		Реквизит.Вставить("ИмяДокумента", "ТаблицаТоваровТСД");
		Реквизит.Вставить("Представление", СтрШаблон("%1 (%2)", Колонка.Имя,  Колонка.ТипЗначения));
				
		Если ТочноеСоответствиеТипов Тогда
			
			Реквизит.Вставить("Тип",Колонка.ТипЗначения);
			
		Иначе
			
			Типы = Новый Массив();
			Типы.Добавить("Строка");
			Типы.Добавить("Число");
			Типы.Добавить("Дата");
			РезультатПоиска = Типы.Найти(""+Колонка.ТипЗначения);
			Если РезультатПоиска <> Неопределено  Тогда
				ТипРеквизита = Новый Массив();
				ТипРеквизита.Добавить(Тип(Типы[РезультатПоиска]));
				Реквизит.Вставить("Тип",Новый ОписаниеТипов(ТипРеквизита));
			Иначе	
				Реквизит.Вставить("Тип", Колонка.ТипЗначения);
			КонецЕсли; 
			
		КонецЕсли;  
		
		МассивРеквизитов.Добавить(Реквизит);  

	КонецЦикла; 	  
	
КонецПроцедуры 


&НаСервере
Процедура ЗаполнитьТаблицуЗначениямиИсточника(ДокументСсылка)
	
	ОбъектДокумента = ДокументСсылка.ПолучитьОбъект();
	Отбор = Новый Структура();
	Отбор.Вставить("ИмяИсточника",ДокументСсылка.Метаданные().Имя);
	РеквизитыДокумента = РеквизитыШапкиДокумента.НайтиСтроки(Отбор);
	
	ЗначениеРеквизитов = Новый Структура();
	Для каждого	СтрокаТаблицы  Из РеквизитыДокумента  Цикл
		ЗначениеРеквизита = ОбъектДокумента[СтрокаТаблицы.ИмяРеквизитаИсточник];
		ЗначениеРеквизитов.Вставить(СтрокаТаблицы.ИмяРеквизитаИсточник, ЗначениеРеквизита);
		СтрокаТаблицы.ЗначениеПоУмолчанию = ЗначениеРеквизита;	
	КонецЦикла; 
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРеквизитамиПриемник(ОбъектМетаданных, Таблица)
	
	РеквизитыПриемника = Новый Массив();
	РеквизитыПриемника = РеквизитыОбъекта(ОбъектМетаданных);
	
	РеквизитыБезИсточника = Новый Массив();
	
	Для каждого СтрокаИсточник Из Таблица Цикл
		Итератор = 0;	
		Пока РеквизитыПриемника.Количество() <> Итератор Цикл	
			Если РеквизитыПриемника[Итератор].Имя = СтрокаИсточник.ИмяРеквизитаИсточник  Тогда			
				СодержитТип = Ложь;		
				Для каждого ТипПриемника Из РеквизитыПриемника[Итератор].Тип.Типы() Цикл		
					СодержитТип = СтрокаИсточник.ОписаниеТиповИсточник.СодержитТип(ТипПриемника);
					Если СодержитТип Тогда	
						СтрокаИсточник.ПредставлениеРеквизитаПриемник = РеквизитыПриемника[Итератор].Представление;
						СтрокаИсточник.ИмяРеквизитаПриемник = РеквизитыПриемника[Итератор].Имя;
						СтрокаИсточник.ОписаниеТиповПриемник = РеквизитыПриемника[Итератор].Тип;
						СтрокаИсточник.Пометка = Истина; 
						РеквизитыПриемника.Удалить(Итератор);
						Прервать;
					КонецЕсли;
					Если Не СодержитТип Тогда
						Итератор = Итератор + 1;
						Прервать;	
					КонецЕсли;
				КонецЦикла;
			Иначе
				Итератор = Итератор + 1;	
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;	
	
	Для каждого ЭлементМассива Из РеквизитыПриемника Цикл	
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.ПредставлениеРеквизитаПриемник = ЭлементМассива.Представление;
		НоваяСтрока.ИмяРеквизитаПриемник = ЭлементМассива.Имя;
		НоваяСтрока.ОписаниеТиповПриемник = ЭлементМассива.Тип;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРеквизитовТабличнойЧастиДаннымиИзТСД()
	РеквизитыТабличнойЧастиДокумента.Очистить();
	ВходящийПараметры = Новый Структура;
	ВходящийПараметры.Вставить("ДокументОснование",ОбъектИсточник);
	ВходящийПараметры.Вставить("ВидОперации",ОперацияТСД);
	ВходящийПараметры.Вставить("ВключаяДокументыОпераций",Неопределено);
	РезультатЗапроса = вмс_ОперацииПоЯчейкамСервер.ПолучитьТаблицуПринятыхТоваровЧерезСтруктуру(ВходящийПараметры);
	
	Если РезультатЗапроса.Количество()=0 Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Операция не найдена");
		Возврат;
		
	КонецЕсли;
	
	Если ТоварыОперацииПоЯчейкам.Выгрузить().Колонки.Количество() = 0 Тогда
		
		НовыеРеквизиты = Новый Массив();
		Для каждого КолонкаРезультатаЗапроса Из РезультатЗапроса.Колонки Цикл	
			НовыеРеквизиты.Добавить(
			Новый РеквизитФормы(
			КолонкаРезультатаЗапроса.Имя,
			КолонкаРезультатаЗапроса.ТипЗначения,
			"ТоварыОперацииПоЯчейкам"
			)
			);	
		КонецЦикла;
		
		ИзменитьРеквизиты(НовыеРеквизиты); 
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(РезультатЗапроса, "ТоварыОперацииПоЯчейкам");
	
	Для каждого СтрокаРезультатаЗапроса Из РезультатЗапроса.Колонки  Цикл
		НоваяСтрока = РеквизитыТабличнойЧастиДокумента.Добавить();	
		НоваяСтрока.ИмяРеквизитаИсточник = СтрокаРезультатаЗапроса.Имя;
		НоваяСтрока.ОписаниеТиповИсточник = СтрокаРезультатаЗапроса.ТипЗначения;
		НоваяСтрока.ПредставлениеРеквизитаИсточник = СтрокаРезультатаЗапроса.Имя + " (" + СтрокаРезультатаЗапроса.ТипЗначения + ")"; 	
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Процедура ОтсортироватьТаблицыФормы()	
	РеквизитыШапкиДокумента.Сортировать("Пометка УБЫВ, ИмяРеквизитаИсточник УБЫВ");
	РеквизитыТабличнойЧастиДокумента.Сортировать("Пометка УБЫВ, ИмяРеквизитаИсточник УБЫВ");
КонецПроцедуры

#КонецОбласти

#Область РаботаСПравиломКонвертации

&НаСервере
Функция СохранитьПравилаКонвертацииНаСервере(НаименованиеПравила)
	ПравилаКонвертации = СоздатьПравилаКонвертации(); 
	Возврат Справочники.вмс_ПравилаКонвертацииРеквизитов.ЗаписатьПравилоКонвертации(НаименованиеПравила, ПравилаКонвертации);
КонецФункции 

&НаСервере
Функция СоздатьПравилаКонвертации() 
	ПравилаКонвертации = Новый Структура;  

	ПравилаКонвертации.Вставить("ПравилаКонвертацииРеквизитовШапки", РеквизитФормыВЗначение("РеквизитыШапкиДокумента"));
	ПравилаКонвертации.Вставить("ПравилаКонвертацииРеквизитовТабличнойЧасти", РеквизитФормыВЗначение("РеквизитыТабличнойЧастиДокумента"));
	ПравилаКонвертации.Вставить("РеквизитыТабличнойЧастиТСД", РеквизитФормыВЗначение("РеквизитыТабличнойЧастиТСД"));
	ПравилаКонвертации.Вставить("ТипПриемника",ТипОбъектаПриемник);  
	ПравилаКонвертации.Вставить("ТипИсточника",ТипОбъектаИсточник);

	ПравилаКонвертации.Вставить("ИмяТабличнойЧастиИсточник",ИмяТабличнойЧастиИсточник);
	ПравилаКонвертации.Вставить("ИмяТабличнойЧастиПриемник",ИмяТабличнойЧастиПриемник);
	
	ПравилаКонвертации.Вставить("ПерезаполнитьИсточник", ПерезаполнитьИсточник);
	ПравилаКонвертации.Вставить("ОчиститьТабличнуюЧастьПриемника",ОчиститьТабличнуюЧасть); 
	ПравилаКонвертации.Вставить("ЗагрузитьРеквизитыТабличнуюЧастьОтобранныхТоваровИзТСД", ЗагрузитьРеквизитыТабличнуюЧастьОтобранныхТоваровИзТСД); 
	//ПравилаКонвертации.Вставить("ЗагрузитьРеквизитыТабличнойЧастиИзДокументаИсточника", ЗагрузитьРеквизитыТабличнойЧастиИзДокументаИсточника);   
	//ПравилаКонвертации.Вставить("ЗагрузитьРеквизитыТабличнуюЧастьИзДокументаТСД", ЗагрузитьРеквизитыТабличнуюЧастьИзДокументаТСД);
	ПравилаКонвертации.Вставить("ЗагрузитьРеквизитыТабличнуюЧастьПринятыхТоваровИзТСД", ЗагрузитьРеквизитыТабличнуюЧастьПринятыхТоваровИзТСД); 	
	//ПравилаКонвертации.Вставить("ЗагрузитьРеквизитыШапкиИзДокументаИсточника", ЗагрузитьРеквизитыШапкиИзДокументаИсточника); 
	//ПравилаКонвертации.Вставить("ЗагрузитьРеквизитыШапкиИзТСД", ЗагрузитьРеквизитыШапкиИзТСД); 
	
	ПравилаКонвертации.Вставить("СопоставлениеТоваровТСДПоУмолчанию", Ложь);
	ПравилаКонвертации.Вставить("ЗаполнитьНаОсновании", ЗаполнитьНаОсновании);
	ПравилаКонвертации.Вставить("ДозаполнитьДокумент", Истина);
	ПравилаКонвертации.Вставить("ЗаполнитьКодыМаркировки", ЗаполнитьКодыМаркировки);
	ПравилаКонвертации.Вставить("СопоставлениеТоваровТСДПоСерии", Ложь);
	ПравилаКонвертации.Вставить("УдалитьСтрокиПриемникаСНулевымКоличеством", УдалитьСтрокиПриемникаСНулевымКоличеством);
	ПравилаКонвертации.Вставить("ПроводитьДокумент", ПроводитьДокумент);
	
	ПравилаКонвертации.Вставить("ОперацияТСД", ОперацияТСД);
	ПравилаКонвертации.Вставить("Источник",ОбъектИсточник);
	ПравилаКонвертации.Вставить("ОперацияПоЯчейкам",ОперацияПоЯчейкам);
	ПравилаКонвертации.Вставить("Приемник",ОбъектПриемник);

	ПравилаКонвертации.Вставить("ДозаполнитьТабличнуюЧасть",ДозаполнитьТабличнуюЧасть);
	
	Возврат ПравилаКонвертации;
КонецФункции

&НаСервере
Процедура ПолучитьПравилоКонвертации(ВыбранноеПравилоКонвертации);
	
	ПравилоКонвертации = ВыбранноеПравилоКонвертации.Ссылка.ПолучитьОбъект().ПолучитьПравилоКонвертации();
	
	Если ЗначениеЗаполнено(ПравилоКонвертации) Тогда
		
		РеквизитыШапкиДокумента.Очистить();
		РеквизитыШапкиДокумента.Загрузить(ПравилоКонвертации.ПравилаКонвертацииРеквизитовШапки);
		Если РеквизитыШапкиДокумента.Количество() > 0 Тогда
			ЗаполнитьШапку = Истина;
			ТипОбъектаИсточник = ПравилоКонвертации.ТипИсточника;
			Элементы.ИмяТабличнойЧастиИсточник.СписокВыбора.ЗагрузитьЗначения(ИменаТаблицДокумента(ТипОбъектаИсточник));
			ИнициализацияОбъекта(ТипОбъектаИсточник, "ОбъектИсточник");
			Элементы.ТаблицыРеквизитовСтраница.Видимость = Истина;
			Элементы.РеквизитыШапкиСтраница.Видимость = Истина;	
		КонецЕсли;
		
		ТипОбъектаПриемник = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ТипПриемника");
		Элементы.ИмяТабличнойЧастиПриемник.СписокВыбора.ЗагрузитьЗначения(ИменаТаблицДокумента(ТипОбъектаПриемник));
		
		ИмяТабличнойЧастиИсточник = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ИмяТабличнойЧастиИсточник"); 
		ИмяТабличнойЧастиПриемник = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ИмяТабличнойЧастиПриемник");
		ОперацияТСД = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ОперацияТСД");
		ОчиститьТабличнуюЧасть = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ОчиститьТабличнуюЧастьПриемника");
		ПерезаполнитьИсточник = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ПерезаполнитьИсточник");
		ОбъектИсточник = ПолучитьПараметрКонвертации(ПравилоКонвертации, "Источник");
		ОперацияПоЯчейкам = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ОперацияПоЯчейкам");
		ОбъектПриемник = ПолучитьПараметрКонвертации(ПравилоКонвертации, "Приемник");
		СопоставлениеТоваровТСДПоУмолчанию = ПолучитьПараметрКонвертации(ПравилоКонвертации, "СопоставлениеТоваровТСДПоУмолчанию");
		ЗаполнитьНаОсновании = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ЗаполнитьНаОсновании");
		ДозаполнитьДокумент = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ЗаполнитьНаОсновании");
		ЗаполнитьКодыМаркировки = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ЗаполнитьКодыМаркировки");
		УдалитьСтрокиПриемникаСНулевымКоличеством = ПолучитьПараметрКонвертации(ПравилоКонвертации, "УдалитьСтрокиПриемникаСНулевымКоличеством");
		ПроводитьДокумент = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ПроводитьДокумент");
        ДозаполнитьТабличнуюЧасть = ПолучитьПараметрКонвертации(ПравилоКонвертации, "ДозаполнитьТабличнуюЧасть");
		
		РеквизитыТабличнойЧастиДокумента.Очистить();	
		РеквизитыТабличнойЧастиДокумента.Загрузить(ПравилоКонвертации.ПравилаКонвертацииРеквизитовТабличнойЧасти); 
		
		
		
		Если РеквизитыТабличнойЧастиДокумента.Количество() > 0  Тогда
			ЗагрузитьРеквизитыТабличнуюЧастьПринятыхТоваровИзТСД = ПравилоКонвертации.ЗагрузитьРеквизитыТабличнуюЧастьПринятыхТоваровИзТСД;
			ЗагрузитьРеквизитыТабличнуюЧастьОтобранныхТоваровИзТСД = ПравилоКонвертации.ЗагрузитьРеквизитыТабличнуюЧастьОтобранныхТоваровИзТСД;
		КонецЕсли;    
		
		РеквизитыТабличнойЧастиТСД.Очистить();
		РеквизитыТабличнойЧастиТСД.Загрузить(ПравилоКонвертации.РеквизитыТабличнойЧастиТСД);		
		
	КонецЕсли;    
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьПараметрКонвертации(ПравилоКонертации, НаименованиеПараметра)
	
	Если ПравилоКонертации.Свойство(НаименованиеПараметра) Тогда
		Возврат ПравилоКонертации[НаименованиеПараметра];	
	КонецЕсли; 
	
КонецФункции


&НаСервере
Функция  ИзменитьПравилоКонвертацииЭлементаСправочника()     
	
	НовоеПравило = СоздатьПравилаКонвертации();
	ПравилоКонвертацииСсылка = Справочники.вмс_ПравилаКонвертацииРеквизитов.СохранитьПравилоКонвертации(Параметры.ПравилоКонвертации.Ссылка, НовоеПравило);	
	Возврат  ПравилоКонвертацииСсылка;       
	
КонецФункции

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	ТекущаяСтраница = Элементы.РекизитыСтраницы.ТекущаяСтраница; 
	
	ТекущаяТаблица = Неопределено; 
	Если ТекущаяСтраница = Элементы.РеквизитыШапкиСтраница Тогда
		
		Для Каждого СтрокаТаблицы Из РеквизитыШапкиДокумента Цикл           
			СтрокаТаблицы.Пометка = Ложь;	
		КонецЦикла;     
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтраница = Элементы.РеквизитыТабличнойЧастиСтраница Тогда
		ТекущаяТаблица = РеквизитыТабличнойЧастиДокумента;
	ИначеЕсли ТекущаяСтраница = Элементы.РеквизитыТСД Тогда  
		ТекущаяТаблица = РеквизитыТабличнойЧастиТСД;
	КонецЕсли;    
	
	Для Каждого СтрокаТаблицы Из ТекущаяТаблица Цикл
		СтрокаТаблицы.Пометка = Ложь;
		СтрокаТаблицы.КолонкаСуммирования = Ложь;
	КонецЦикла;  
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти