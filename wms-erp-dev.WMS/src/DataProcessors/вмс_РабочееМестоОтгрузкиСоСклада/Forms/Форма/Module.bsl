#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДоступныеСклады.ЗагрузитьЗначения(вмс_СкладыВызовСервера.СкладыХраненияWMS());
	
	Если ЗначениеЗаполнено(ДоступныеСклады) Тогда
		Склад = ДоступныеСклады.Получить(0).Значение;
	КонецЕсли;
	
	Период.ДатаНачала  = НачалоМесяца(ТекущаяДата());
	Период.ДатаОкончания = КонецМесяца(Период.ДатаНачала);
	СкладПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	СкладПриИзмененииНаСервере();
	Элементы.НоменклатураККонтролю.Обновить(); 
КонецПроцедуры          

&НаСервере
Процедура СкладПриИзмененииНаСервере()
	ЗаполнитьЗонуОтгрузки();
	ЗаполнитьРаспоряженияНаОтгрузку();
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ЗаполнитьРаспоряженияНаОтгрузку();
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	ОбновитьТаблицуЗаданиеКладовщику(ТекущаяСтраница.Имя);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПланируемыйОтбор

