Процедура КомандаПочинитьРегистрОперацииПоЯчейкамНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	вмс_ОперацияПоЯчейкам.Регистратор КАК РегистраторСсылка,
	|	вмс_ОперацияПоЯчейкам.Регистратор.Дата КАК РегистраторДата
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкам
	|ГДЕ
	|	вмс_ОперацияПоЯчейкам.Регистратор.Номер ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистраторДата";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыНакопления.вмс_ОперацияПоЯчейкам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.РегистраторСсылка);
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

