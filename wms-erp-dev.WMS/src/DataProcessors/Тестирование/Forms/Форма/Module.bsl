Функция Тест68()
	
	РК = вмс_РаботаСКоллекциями;
	ИК = вмс_ИндексированиеКоллекций;
	
	ПоляИндексирования = "Товар, Ячейка";
	ВсеПоля = ПоляИндексирования + ", Количество";
	Тип = "ТаблицаЗначений";
	Таблица = РК.НоваяКоллекцияЗначений(ВсеПоля, Тип);
	Для НомерТовара=1 По 100 Цикл
		Для НомерЯчейки=1 По 10 Цикл
			РК.ДобавитьЭлементКоллекции(Таблица, Новый Структура(ВсеПоля, "Т" + НомерТовара, "Я" + НомерЯчейки, 1));
		КонецЦикла;
	КонецЦикла;
	
	ПоляИндексированияМассив = РК.ЗначениеВМассив(ПоляИндексирования);
	КоличествоПолей = ПоляИндексированияМассив.Количество();
	
	Индекс = ИК.НовыйИндекс();
	
	КоличествоВариантов = Pow(2, КоличествоПолей) - 1;
	
	ВекторизированныеДанные = Новый Массив;
	Для НомерВарианта=0 По КоличествоВариантов-1 Цикл
		
		Вариант = РК.РазложитьЧислоНаРазряды(НомерВарианта, 2, КоличествоПолей);
		
		Для Каждого ЭлементДанных Из РК.ПолучитьЭлементыКоллекции(Таблица) Цикл
			
			Вектор = Новый Массив;
			Для НомерПоля=0 По КоличествоПолей-1 Цикл
				ОбщееЗначение = Вариант[НомерПоля]=1;
				Если ОбщееЗначение Тогда
					Вектор.Добавить(Неопределено);
				Иначе
					Вектор.Добавить(ЭлементДанных[ПоляИндексированияМассив[НомерПоля]]);
				КонецЕсли;
			КонецЦикла;
			
			ВекторизированныеДанные.Добавить(Новый Структура("Вектор, ЭлементДанных", Вектор, ЭлементДанных));
			
		КонецЦикла;
		
	КонецЦикла;
	
	ИК.ВставитьДанныеВИндекс(Индекс, ВекторизированныеДанные);
	
	Вектор = ИК.НовыйВектор(Новый Структура("Товар, Ячейка", "Т1", Неопределено), ПоляИндексированияМассив);
	ИндексЭлемента = ИК.НайтиИндекс(Индекс, Вектор);
	Данные = ИК.ПолучитьДанныеИндекса(ИндексЭлемента);

	Вектор = ИК.НовыйВектор(Новый Структура("Товар, Ячейка", Неопределено, "Я2"), ПоляИндексированияМассив);
	ИндексЭлемента = ИК.НайтиИндекс(Индекс, Вектор);
	Данные = ИК.ПолучитьДанныеИндекса(ИндексЭлемента);

	Вектор = ИК.НовыйВектор(Новый Структура("Товар, Ячейка", Неопределено, "Я1"), ПоляИндексированияМассив);
	ИндексЭлемента = ИК.НайтиИндекс(Индекс, Вектор);
	Данные = ИК.ПолучитьДанныеИндекса(ИндексЭлемента);
	
	Данные = ИК.ПолучитьДанныеИндекса(Индекс);
	РК.УдалитьДублиВМассиве(Данные);
КонецФункции

