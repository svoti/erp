#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьОсновныеДанныеОбработкиИзРегистра()
	
	УстановитьПривилегированныйРежим(Истина);
	
	лТекст = "ВЫБРАТЬ
	|	вмс_СписокПоклажедателей.Контрагент КАК Контрагент,
	|	вмс_СписокПоклажедателей.Организация КАК Организация,
	|	вмс_СписокПоклажедателей.Склад КАК Склад,
	|	вмс_СписокПоклажедателей.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.вмс_СписокПоклажедателей КАК вмс_СписокПоклажедателей
	|ГДЕ
	|	вмс_СписокПоклажедателей.Пользователь = &Пользователь";
	
	лЗапрос = Новый Запрос(лТекст);
	
	лЗапрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	РезультатЗапроса = лЗапрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Контрагент = Выборка.Контрагент; 
		Пользователь = Выборка.Пользователь;
		Организация = Выборка.Организация;
		Склад = Выборка.Склад;
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции // ЗаполнитьОсновныеДанныеОбработки()()
&НаКлиенте
Процедура ОбработкаВводаТовараВТаблицу(НаименованиеТаблицыПриемника)  
	
	ДополнительныеПараметры = Новый Структура("НаименованиеТаблицыПриемника", НаименованиеТаблицыПриемника);
	Оповещение = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект, ДополнительныеПараметры);	
	ПоказатьВводЗначения(Оповещение,,"Введите количество товара","Число");       
	
КонецПроцедуры // ОбработкаВводаТовараВТаблицу()

&НаКлиенте
Процедура ПослеВводаКоличества(Результат, Параметры) Экспорт	
	
	Если Не Результат = Неопределено Тогда 
		Если Параметры.НаименованиеТаблицыПриемника = "Возврат" Тогда  
			// ТУ_Прошин_08.08.24+
			ВыделенныеСтроки = Элементы.ОстаткиНаСкладе.ВыделенныеСтроки;  
			Для Каждого Строка Из ВыделенныеСтроки Цикл
				ТекущиеДанные = ОстаткиНаСкладе.НайтиПоИдентификатору(Строка);
				Если ТекущиеДанные.Количество < Результат Тогда
					
					ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Некорректный ввод количества! Введено больше товара - %1 чем отдано на хранение - %2!",ТекущиеДанные.Номенклатура, ТекущиеДанные.Количество));
				Иначе
					ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор(); 
					ДобавитьТоварВВозвратТовара(ТекущиеДанные, Результат, ИдентификаторСтроки);
				КонецЕсли;
				
			КонецЦикла;	
			// ТУ_Прошин_08.08.24-
			
		ИначеЕсли Параметры.НаименованиеТаблицыПриемника = "Остатки" Тогда 
			
			// ТУ_Прошин_08.08.24+
			ВыделенныеСтроки = Элементы.ВозвратТоваров.ВыделенныеСтроки;  
			Для Каждого Строка Из ВыделенныеСтроки Цикл
				ТекущиеДанные = ВозвратТоваров.НайтиПоИдентификатору(Строка);
				Если ТекущиеДанные.Количество < Результат Тогда
					
					ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Некорректный ввод количества! Введено больше товара - %1 чем указано в таблице - %2!",ТекущиеДанные.Номенклатура, ТекущиеДанные.Количество));
				Иначе
					ОбработатьЧастичноеУдалениеТовараИзТаблицы(Результат, ТекущиеДанные, Строка);
				КонецЕсли;			
			КонецЦикла;	
			// ТУ_Прошин_08.08.24-
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры   
&НаКлиенте
Процедура ВычестьКоличествоВТаблицеИсточнике(ДанныеТовара, КоличествоТовара, Идентификатор)
	
	ДанныеТовара.Количество = ДанныеТовара.Количество - КоличествоТовара;	
	Если ДанныеТовара.Количество = 0 Тогда	
		ОстаткиНаСкладе.Удалить(ОстаткиНаСкладе.НайтиПоИдентификатору(Идентификатор));	 	
	КонецЕсли;
	
КонецПроцедуры // ВычестьКоличествоВТаблицеИсточнике()

&НаКлиенте
Процедура УдалитьТоварИзТаблицы()
	ТекущиеДанные = Элементы.ВозвратТоваров.ТекущиеДанные;  
	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();       
	// ТУ_Прошин_08.08.24+   
	ВыделенныеСтроки = Элементы.ВозвратТоваров.ВыделенныеСтроки;
	ДополнительныеПараметры = Новый Структура("ВыделенныеСтроки, ИдентификаторСтроки", ВыделенныеСтроки);
	//ДополнительныеПараметры = Новый Структура("ДанныеТовара, ИдентификаторСтроки", ТекущиеДанные, ИдентификаторСтроки); 
	// ТУ_Прошин_08.08.24-
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаУдалитьТоварЦеликом",
	ЭтотОбъект,ДополнительныеПараметры);	
	
	ПоказатьВопрос(Оповещение,
	"Удалить товар целиком?",
	РежимДиалогаВопрос.ДаНетОтмена,0,КодВозвратаДиалога.Да,"Отмена добавления товара");     
	
КонецПроцедуры      

&НаКлиенте
Процедура ПослеЗакрытияВопросаУдалитьТоварЦеликом(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда 
		// ТУ_Прошин_08.08.24+                        
		МассивУдаляемыхСтрок = Новый Массив;
		//ДанныеТовара = Параметры.ДанныеТовара;    
		Для Каждого Строка Из Параметры.ВыделенныеСтроки Цикл    
			ДанныеТовара = ВозвратТоваров.НайтиПоИдентификатору(Строка);
			// ТУ_Прошин_08.08.24-
			ОтборТовара = Новый Структура("Номенклатура", ДанныеТовара.Номенклатура);
			НайденнаяСтрока = ОстаткиНаСкладе.НайтиСтроки(ОтборТовара);
			Если НайденнаяСтрока.Количество() > 0 Тогда
				НайденнаяСтрока[0].Количество = НайденнаяСтрока[0].Количество + ДанныеТовара.Количество; 
			Иначе
				НоваяСтрокаОстатков = ОстаткиНаСкладе.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаОстатков, ДанныеТовара);	
			КонецЕсли;   
			МассивУдаляемыхСтрок.Добавить(ДанныеТовара);
			//ВозвратТоваров.Удалить(ДанныеТовара);  
		КонецЦикла; 
		Если МассивУдаляемыхСтрок.Количество() > 0 Тогда
			Для Каждого Строка Из МассивУдаляемыхСтрок Цикл
				ВозвратТоваров.Удалить(Строка);		
			КонецЦикла;
		КонецЕсли;
		
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда 
		ОбработкаВводаТовараВТаблицу("Остатки");
	КонецЕсли;	
	
	
	
КонецПроцедуры   

&НаКлиенте
Процедура ОбработатьЧастичноеУдалениеТовараИзТаблицы(КоличествоНаУдаление, ДанныеТовара, Идентификатор)
	
	ДанныеТовара.Количество = ДанныеТовара.Количество - КоличествоНаУдаление;
	
	ОтборТовара = Новый Структура("Номенклатура", ДанныеТовара.Номенклатура);
	НайденнаяСтрока = ОстаткиНаСкладе.НайтиСтроки(ОтборТовара);
	Если НайденнаяСтрока.Количество() > 0 Тогда
		
		НайденнаяСтрока[0].Количество = НайденнаяСтрока[0].Количество + КоличествоНаУдаление;
	Иначе
		НоваяСтрокаОстатков = ОстаткиНаСкладе.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОстатков, ДанныеТовара);
		НоваяСтрокаОстатков.Количество = КоличествоНаУдаление;
	КонецЕсли;
	Если ДанныеТовара.Количество = 0 Тогда	
		ВозвратТоваров.Удалить(ВозвратТоваров.НайтиПоИдентификатору(Идентификатор));
	КонецЕсли;
	
КонецПроцедуры // ОбработатьЧастичноеУдалениеТовараИзТаблицы()

&НаСервере
Процедура СоздатьРаспоряжение(ТипРаспоряжения)
	
	ЭтоУТ =  вмс_АдаптацияКонфигураций.ЭтоУТ();
	ЭтоЕРП = вмс_АдаптацияКонфигураций.ЭтоЕРП();
	ЭтоУНФ = вмс_АдаптацияКонфигураций.ЭтоУНФ();
	
	Если ЭтоУТ Тогда
		ВалютаДокумента = Константы.ВалютаУправленческогоУчета.Получить(); 
		модОбработкаТабличнойЧастиКлиентСервер = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер"); 
		модОбработкаТабличнойЧастиСервер = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ОбщийМодуль("ОбработкаТабличнойЧастиСервер");
	ИначеЕсли ЭтоЕРП Тогда
		ВалютаДокумента = Константы.ВалютаУправленческогоУчета.Получить(); 
		модОбработкаТабличнойЧастиКлиентСервер = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиКлиентСервер"); 
		модОбработкаТабличнойЧастиСервер = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиСервер");
	ИначеЕсли ЭтоУНФ Тогда
		ВалютаДокумента = Константы.ВалютаУчета.Получить();
		модОбработкаТабличнойЧастиКлиентСервер = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ОбщийМодуль("ТабличныеЧастиУНФКлиентСервер");
	КонецЕсли;
	
	Если ТипРаспоряжения = "Приобретение" Тогда
		
		ТаблицаТоваров = СдатьНаХранение;
		
		Если ЭтоУТ ИЛИ ЭтоЕРП Тогда
			НовыйДокумент = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
			НовыйДокумент.Заполнить(Неопределено);
			
			НовыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
			НовыйДокумент.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;  
			НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;  
			НовыйДокумент.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным;
		ИначеЕсли ЭтоУНФ Тогда
			НовыйДокумент = Документы.ПриходнаяНакладная.СоздатьДокумент();
			
			НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика;
			НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;  
		КонецЕсли;
		
	ИначеЕсли ТипРаспоряжения = "Реализация" Тогда
		
		ТаблицаТоваров = ВозвратТоваров;	
		
		Если ЭтоУТ ИЛИ ЭтоЕРП Тогда
			НовыйДокумент = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
			НовыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
			НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;  
			НовыйДокумент.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
		ИначеЕсли ЭтоУНФ Тогда
			НовыйДокумент = Документы.РасходнаяНакладная.СоздатьДокумент();
			НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю;
			НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;  
		КонецЕсли;
	КонецЕсли;
	
	НовыйДокумент.Дата = ТекущаяДата();
	НовыйДокумент.Контрагент = Контрагент;
	НовыйДокумент.Организация = Организация; 
	НовыйДокумент.Автор = ИмяПользователя();
	Если ЭтоУТ ИЛИ ЭтоЕРП Тогда
		НовыйДокумент.Партнер = Контрагент.Партнер; 
		НовыйДокумент.Склад = Склад;
		НовыйДокумент.ЦенаВключаетНДС = Истина;
		НовыйДокумент.Валюта = ВалютаДокумента;
		НовыйДокумент.ВалютаВзаиморасчетов = ВалютаДокумента;
		ТабличнаяЧастьДокумента = НовыйДокумент.Товары;
	ИначеЕсли ЭтоУНФ Тогда
		НовыйДокумент.СтруктурнаяЕдиница = Склад;
		НовыйДокумент.СуммаВключаетНДС = Истина;
		НовыйДокумент.ВалютаДокумента = ВалютаДокумента;
		ТабличнаяЧастьДокумента = НовыйДокумент.Запасы;
	КонецЕсли;
	
	ТабличнаяЧастьДокумента.Загрузить(ТаблицаТоваров.Выгрузить());
	
	Если ЭтоУТ ИЛИ ЭтоЕРП Тогда 
		СтруктураПересчетаСуммы = модОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(НовыйДокумент);
		СтруктураДействий = Новый Структура; 
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСумму");
	КонецЕсли;
	
	Для Каждого Строка Из ТабличнаяЧастьДокумента Цикл
		Строка.Цена = 1;
		Если ЭтоУТ ИЛИ ЭтоЕРП Тогда
			Строка.Склад = НовыйДокумент.Склад;
			Строка.КоличествоУпаковок = Строка.Количество;
			Строка.СтавкаНДС = Строка.Номенклатура.СтавкаНДС;
			модОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Строка, СтруктураДействий, Неопределено);
		ИначеЕсли ЭтоУНФ Тогда
			Строка.СтруктурнаяЕдиница = НовыйДокумент.СтруктурнаяЕдиница;
			Строка.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(Строка.Номенклатура.ВидСтавкиНДС);
			ПараметрыРасчета = Новый Структура("РассчитатьСумму, СуммаВключаетНДС", Истина, Истина);
			АдаптацияУНФ = модОбработкаТабличнойЧастиКлиентСервер.РассчитатьСуммыВСтрокеТЧ(Строка, ПараметрыРасчета);
		КонецЕсли;
	КонецЦикла;
	
	Если ЭтоУТ ИЛИ ЭтоЕРП Тогда
		ИтоговаяСумма = ТабличнаяЧастьДокумента.Итог("СуммаСНДС");
		НовыйДокумент.СуммаВзаиморасчетов = ИтоговаяСумма;
		НовыйДокумент.СуммаДокумента = ИтоговаяСумма;
	ИначеЕсли ЭтоУНФ Тогда
		ИтоговаяСумма = ТабличнаяЧастьДокумента.Итог("Сумма");
		НовыйДокумент.СуммаДокумента = ИтоговаяСумма;
	КонецЕсли;
	
	НовыйДокумент.Комментарий = "Созданно программно в результате действий поклажедателя " + ИмяПользователя();
	
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		УдалостьПровести = Истина; 
		ОбщегоНазначения.СообщитьПользователю("Документ создан успешно!");
	Исключение 
		вмс_Журналирование.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), СтрШаблон("Объект: %1", Строка(НовыйДокумент)));
		УдалостьПровести = Ложь;
	КонецПопытки;
	
	Если Не УдалостьПровести и не НовыйДокумент.Проведен Тогда
		Попытка
			вмс_ОперацииПоЯчейкамВызовСервера.ЗаписатьКлиентскуюИнформациюОбОшибкеВЖурнал();  
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	
	Если Не УдалостьПровести Тогда
		Если НовыйДокумент.Проведен Тогда
			НовыйДокумент.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись); 
			ОбщегоНазначения.СообщитьПользователю("Документ создан, но не проведен!");
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьТаблицуОстаткиНаСкладе();
	
	ТаблицаТоваров.Очистить();
КонецПроцедуры // СоздатьРаспоряжение()

#КонецОбласти










