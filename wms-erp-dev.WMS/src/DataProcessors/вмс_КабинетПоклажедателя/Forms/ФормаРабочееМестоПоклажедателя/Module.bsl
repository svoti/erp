#Область ОбработчикиСобытийЭлементовТаблицыФормыОстаткиНаСкладе

&НаСервере
Процедура ЗаполнитьТаблицуОстаткиНаСкладе()	
	
	УстановитьПривилегированныйРежим(Истина);
	
	лТекст = "ВЫБРАТЬ
	|	вмс_ТоварыПоклажедателей.Товар КАК Номенклатура,
	|	вмс_ТоварыПоклажедателей.Контрагент КАК Контрагент,
	|	вмс_ТоварыПоклажедателей.Организация КАК Организация,
	|	СУММА(ТоварыОрганизацийОстатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрСведений.вмс_ТоварыПоклажедателей КАК вмс_ТоварыПоклажедателей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОрганизаций.Остатки КАК ТоварыОрганизацийОстатки
	|		ПО вмс_ТоварыПоклажедателей.Товар = ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура
	|			И вмс_ТоварыПоклажедателей.Организация = ТоварыОрганизацийОстатки.Организация
	|ГДЕ
	|	вмс_ТоварыПоклажедателей.Контрагент = &Контрагент
	|	И вмс_ТоварыПоклажедателей.Организация = &Организация
	|	И ТоварыОрганизацийОстатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_ТоварыПоклажедателей.Товар,
	|	вмс_ТоварыПоклажедателей.Контрагент,
	|	вмс_ТоварыПоклажедателей.Организация";
	
	лЗапрос = Новый Запрос(лТекст);
	
	лЗапрос.УстановитьПараметр("Контрагент", Контрагент);
	лЗапрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = лЗапрос.Выполнить();
	
	ОстаткиНаСкладе.Загрузить(РезультатЗапроса.Выгрузить());	
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиНаСкладеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  
	СтандартнаяОбработка = Ложь;       
	ОбработкаВводаТовараВТаблицу("Возврат");
КонецПроцедуры      

&НаКлиенте
Процедура ВычестьКоличествоИзТаблицыОстатков(ДобавляемыйТовар)
	СтруктураОтбора = Новый Структура("Номенклатура", ДобавляемыйТовар.Номенклатура);
	НайденнаяСтрока = ОстаткиНаСкладе.НайтиСтроки(СтруктураОтбора);
	Если НайденнаяСтрока.Количество() > 0 Тогда
		Строка = НайденнаяСтрока[0];
		Строка.Количество = Строка.Количество - ДобавляемыйТовар.Количество;
		Если Строка.Количество = 0 Тогда
			ИндексТовара = Строка.ПОлучитьИдентификатор();
			ОстаткиНаСкладе.Удалить(Строка);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ВычестьКоличествоИзТаблицыОстатков()

