#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)   
	ОсновныеДанныеЗаполнены = ЗаполнитьОсновныеДанныеОбработкиИзРегистра();    
	Если ОсновныеДанныеЗаполнены Тогда
		ЗаполнитьТаблицуОстаткиНаСкладе();
		Элементы.Декорация1.Видимость = Ложь;
	Иначе    
		Элементы.ГруппаКомандыШапки.Видимость = Ложь;
		Элементы.ГруппаТелаФормы.Видимость = Ложь;
		Элементы.Декорация1.Заголовок = "Обратитесь к хранителю оказывающему услуги! Необходимо выполнить настройки для вашего личного кабинета поклажедателя!";
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы Тогда
		ЭтоПоклажедатель = ВМС_ЛичныйКабинетПоклажедателяВызовСервер.ПроверитьНаРольПоклажедателя();
		Если ЭтоПоклажедатель Тогда	
			ЗавершитьРаботуСистемы(Истина);
		КонецЕсли;                    
	КонецЕсли;
КонецПроцедуры
