&НаКлиенте
Процедура ЗагрузитьТоварыНаОтгрузкуИзЕксельЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) И (ТипЗнч(Результат) = Тип("Структура") ИЛИ ТипЗнч(Результат) = Тип("Массив")) Тогда
		Для каждого Строка Из Результат.МассивОбработанныхТоваров Цикл  
			НоваяСтрокаТЧ = ВозвратТоваров.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, Строка);
			Если  Строка.Количество > Строка.КоличествоНаОстатках Тогда
				Сообщение = Новый СообщениеПользователю; 
				ТекстСообщения = СтрШаблон("Недостаточно товара %1. Добавляется к отгрузке - %2, в наличии на складе -  %3", Строка.Номенклатура, Строка.Количество, Строка.КоличествоНаОстатках);
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();	             
				НоваяСтрокаТЧ.Количество = Строка.КоличествоНаОстатках;
			КонецЕсли;
			ВычестьКоличествоИзТаблицыОстатков(НоваяСтрокаТЧ);	
		КонецЦикла;	
		
		Если Результат.МассивНеОбработанныхТоваров.Количество() > 0 Тогда
			Для каждого Строка Из Результат.МассивНеОбработанныхТоваров Цикл
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтрШаблон("Товара %1 нет в базе данных!", Строка);
				Сообщение.Сообщить();		
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры // ЗагрузитьТоварыНаОтгрузкуИзЕксель()

