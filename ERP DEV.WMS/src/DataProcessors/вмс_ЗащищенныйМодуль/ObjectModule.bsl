Функция ПолучитьСуперКонтейнер()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипПартии", "Супер контейнер");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_Контейнеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.вмс_Контейнеры КАК вмс_Контейнеры
	|ГДЕ
	|	вмс_Контейнеры.ТипТары В
	|			(ВЫБРАТЬ
	|				ТипыКонтейнеров.Ссылка КАК Ссылка
	|			ИЗ
	|				ПланВидовХарактеристик.ТипыКонтейнеров КАК ТипыКонтейнеров
	|			ГДЕ
	|				ТипыКонтейнеров.Наименование = &ТипПартии)
	|	И НЕ вмс_Контейнеры.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.вмс_Контейнеры.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;	
КонецФункции

Функция ПолучитьПустойКонтейнер()
