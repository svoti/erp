// ТУ_Кошелев 06.08.24 - проверка доступности лицензий на разные подсистемы

// Определяет доступность подсистемы по имени лицензии.
//
// Параметры:
//  ИмяЛицензии - Строка - идентификатор лицензии.
//
// Возвращаемое значение:
//  Булево - Истина.
//
Функция ПодсистемаДоступна(ИмяЛицензии) Экспорт
	//Отключена проверка до доработки программы генерации лицензий
	//Возврат Истина;
	Возврат Вычислить(ИмяЛицензии + "Доступна()");
КонецФункции

// ТУ_Кошелев 17.06.24 - Обертка для выполнения всех функций с проверкой

// Выполняет функцию контейнеров с параметрами при наличии лицензии.
//
// Параметры:
//  - ИмяФункции - Строка    - имя вызываемой функции.
//  - Параметры  - Структура - параметры функции, где ключ - имя параметра, значение - значение параметра.
//
// Возвращаемое значение:
//  - Произвольный - результат выполнения вызванной функции, либо Ложь при отсутствии лицензии.
//
Функция ВыполнитьФункциюКонтейнеров(ИмяФункции, Параметры) Экспорт  
	Если НЕ вмс_ЛицензияКонтейнерыДоступна() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстВыполнения = ИмяФункции + "("; 
	
	Для Каждого Параметр Из Параметры Цикл
		ТекстВыполнения = ТекстВыполнения + "Параметры." + Параметр.Ключ + ", ";
	КонецЦикла; 
	
	Если Параметры.Количество() <> 0 Тогда
		ТекстВыполнения = Лев(ТекстВыполнения, СтрДлина(ТекстВыполнения) - 2);
	КонецЕсли;                           
	
	ТекстВыполнения = ТекстВыполнения + ")";
	
	Возврат Вычислить(ТекстВыполнения);
КонецФункции
//

Функция ПолучитьИмяМодуля() Экспорт
