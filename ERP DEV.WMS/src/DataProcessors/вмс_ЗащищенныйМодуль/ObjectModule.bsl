Функция ПолучитьСоставПартии(МассивКонтейнеров, ПолнаяРазузловка=Истина, Товары=Истина, Контейнеры=Истина)
	
	Результат = Новый Структура("Таблица, Товары, Контейнеры");
	
	пОтчет = Отчеты.СКДИерархияКонтейнеров.Создать();
	СКД = пОтчет.СхемаКомпоновкиДанных;
	АдресСхемы = ПоместитьВоВременноеХранилище(СКД);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы);
	КомпоновщикНастроек = пОтчет.КомпоновщикНастроек;
	
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(КомпоновщикНастроек.Настройки);
	РаботаССКД.ДобавитьОтбор(КомпоновщикНастроек.Настройки.Отбор.Элементы, "КоличествоКонечныйОстаток", 0, ВидСравненияКомпоновкиДанных.Больше);
	
	НастройкиКомпоновщика = КомпоновщикНастроек.Настройки;
	ПараметрыНастройки = НастройкиКомпоновщика.ПараметрыДанных;
	
	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Контейнер");
	Параметр.Использование = Истина;
	Параметр.Значение = МассивКонтейнеров;
	
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных);
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Если ПолнаяРазузловка Тогда
		Результат.Таблица = ТаблицаРезультат;
	КонецЕсли;
	
	Если Товары Тогда
		Результат.Товары = ТаблицаРезультат.Скопировать(Новый Структура("Тип",Тип("СправочникСсылка.Номенклатура")));
	КонецЕсли;
	
	Если Контейнеры Тогда
		Результат.Контейнеры = ТаблицаРезультат.Скопировать(Новый Структура("Тип",Тип("СправочникСсылка.вмс_Контейнеры")));
	КонецЕсли;
	
	Возврат Результат;
	
	
КонецФункции // ПолучитьСоставПаллеты()

Функция ПолучитьТаблицуОперацийКонтейнеров(МассивКонтейнеров)
	
	пМассивКонтейнеров = Новый Массив;
	
	Если ТипЗнч(МассивКонтейнеров) = Тип("Массив") Тогда 
		пМассивКонтейнеров = МассивКонтейнеров
	Иначе
		пМассивКонтейнеров.Добавить(МассивКонтейнеров);
	КонецЕсли;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("МассивКонтейнеров",пМассивКонтейнеров);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОперацииКонтейнеров.Ссылка КАК ТипКонтейнера,
	|	ОперацииКонтейнеров.Операция КАК ОперацияКонтейнера
	|ИЗ
	|	Справочник.вмс_Контейнеры КАК вмс_Контейнеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ТипыКонтейнеров.ОперацииОтветственногоХранения КАК ОперацииКонтейнеров
	|		ПО вмс_Контейнеры.ТипТары = ОперацииКонтейнеров.Ссылка
	|ГДЕ
	|	НЕ ОперацииКонтейнеров.Ссылка ЕСТЬ NULL
	|	И вмс_Контейнеры.Ссылка В(&МассивКонтейнеров)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОперацииКонтейнеров.Ссылка,
	|	ОперацииКонтейнеров.Операция";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	
КонецФункции

Функция ПолучитьВидыПартийДляВидовТоваров(ВидыТоваров)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_СоединениеОбъектов.ОбъектПриемник КАК ВидТовара,
	|	вмс_СоединениеОбъектов.ОбъектИсточник КАК ВидПартии
	|ИЗ
	|	РегистрСведений.вмс_СоединениеОбъектов КАК вмс_СоединениеОбъектов
	|ГДЕ
	|	вмс_СоединениеОбъектов.ОбъектПриемник В(&ВидыТоваров)
	|	И вмс_СоединениеОбъектов.ОбъектИсточник ССЫЛКА Справочник.вмс_ВидыПартийТоваров
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	вмс_СоединениеОбъектов.ОбъектИсточник,
	|	вмс_СоединениеОбъектов.ОбъектПриемник
	|ИЗ
	|	РегистрСведений.вмс_СоединениеОбъектов КАК вмс_СоединениеОбъектов
	|ГДЕ
	|	вмс_СоединениеОбъектов.ОбъектИсточник В(&ВидыТоваров)
	|	И вмс_СоединениеОбъектов.ОбъектПриемник ССЫЛКА Справочник.вмс_ВидыПартийТоваров";
	Запрос.УстановитьПараметр("ВидыТоваров", ВидыТоваров);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаВидыПартийДляВидовТоваров = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаВидыПартийДляВидовТоваров;
	
КонецФункции

Функция ПолучитьВидыПартийДляТоваров(Товары)
	
	ТаблицаВидыТоваров = вмс_ОбщегоНазначенияСервер.ПолучитьВидыТоваров(Товары);
	ТаблицаПартииТоваров = ТаблицаВидыТоваров.Скопировать();
	ТаблицаВидыТоваров.Свернуть("ВидТовара");
	ВидыТоваров = ТаблицаВидыТоваров.ВыгрузитьКолонку("ВидТовара"); 
	//ТУ_Мовчан 01.06.23 ++
	Для каждого Строка Из Товары Цикл
		ВидыТоваров.Добавить(Строка); 
	КонецЦикла;
	//ТУ_Мовчан 01.06.23 --
	
	ТаблицаВидыПартийДляВидовТоваров = ПолучитьВидыПартийДляВидовТоваров(ВидыТоваров);
	
	СтрокиТовараУдалить = Новый Массив;
	ТаблицаПартииТоваров.Колонки.Добавить("ВидПартии");
	Для Каждого СтрокаТовара Из ТаблицаПартииТоваров Цикл
		НайденныеСтрокиВидыПартий = ТаблицаВидыПартийДляВидовТоваров.НайтиСтроки(Новый Структура("ВидТовара", СтрокаТовара.ВидТовара));
		Если НайденныеСтрокиВидыПартий.Количество() > 0 Тогда
			СтрокаТовара.ВидПартии = НайденныеСтрокиВидыПартий[0].ВидПартии;
		Иначе
			//ТУ_Мовчан 01.06.23 ++
			НайденныеСтрокиВидыПартий = ТаблицаВидыПартийДляВидовТоваров.НайтиСтроки(Новый Структура("ВидТовара", СтрокаТовара.Товар));
			Если НайденныеСтрокиВидыПартий.Количество() > 0 Тогда
				СтрокаТовара.ВидПартии = НайденныеСтрокиВидыПартий[0].ВидПартии;
			Иначе
				СтрокиТовараУдалить.Добавить(СтрокаТовара);
			КонецЕсли; 
			//ТУ_Мовчан 01.06.23 -- 
			
			//СтрокиТовараУдалить.Добавить(СтрокаТовара);
		КонецЕсли;
	КонецЦикла;
	
	вмс_РаботаСКоллекциями.УдалитьЭлементыКоллекции(ТаблицаПартииТоваров, СтрокиТовараУдалить);
	
	Возврат ТаблицаПартииТоваров;
	
КонецФункции

Функция ПолучитьВидПартииДляМоноТовара(Товар)
	
	ТаблицаПартииТоваров = ПолучитьВидыПартийДляТоваров(Товар);
	Если ТаблицаПартииТоваров.Количество() > 0 Тогда
		Возврат ТаблицаПартииТоваров[0].ВидПартии;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТаблицуСоставаПоКонтейнерам(Контейнеры, ДополнительныеПараметры=Неопределено)
	
	Перем РК;
	
	РК = вмс_РаботаСКоллекциями;
	
	МассивКонтейнеров = РК.ЗначениеВМассив(Контейнеры);
	РК.УдалитьДублиВМассиве(МассивКонтейнеров);
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли;
	
	ТоварныеПоля = РК.ПолучитьЗначениеПоляСтруктуры(ДополнительныеПараметры, "ТоварныеПоля");
	Если ТоварныеПоля <> Неопределено Тогда
		ТоварныеПоляМассив = РК.ЗначениеВМассив(ТоварныеПоля, , Ложь);
	Иначе
		ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля();		
	КонецЕсли;   
	
	ДополнительныеПараметры.Вставить("ТоварныеПоля", ТоварныеПоляМассив);
	
	//Кулалаев Е.С + 31.05.2023 12:26:19
	//BOX-57 Модуль учета единиц измерения в мобильной версии: Остатки по упаковкам не ведутся. Пока.
	Если ТоварныеПоляМассив.Найти("Упаковка") <> Неопределено Тогда
		вмс_РаботаСКоллекциями.ВычестьМассив(ТоварныеПоляМассив, "Упаковка");
	КонецЕсли;
	//Кулалаев Е.С -
	
	ТоварныеПоля = РК.МассивВСтроку(ТоварныеПоляМассив);
	
	ПоляТаблицыСостава = "ПолныеДанные, Контейнер, ТипКонтейнера, Уровень, %ТОВАРНЫЕПОЛЯ%, СодержимоеКонтейнер, Маркировка, КоличествоОстаток";
	ПоляТаблицыСостава = СтрЗаменить(ПоляТаблицыСостава, "%ТОВАРНЫЕПОЛЯ%", ТоварныеПоля);
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// иерархия вверх
	// Так как контейнеры могут входит в иерархию друг друга надо сделать слияние иерархий, чтобы не было наложений при разузловании
	// Контейнеры ползут вверх, играя в царя горы. Кто доползет первым останется, остальные выбывают
	
	ТаблицаСоставаИерархияВверх = РК.НоваяТаблицаЗначений(ПоляТаблицыСостава);
	
	ПолучитьГоризонтальныеОстаткиДополнительныхУровней = РК.ПолучитьЗначениеПоляСтруктуры(ДополнительныеПараметры, "ПолучитьГоризонтальныеОстаткиДополнительныхУровней") = Истина;
	МаксимальныйУровеньРазузлования = РК.ПолучитьЗначениеПоляСтруктуры(ДополнительныеПараметры, "МаксимальныйУровеньРазузлования");
	Если ТипЗнч(МаксимальныйУровеньРазузлования) <> Тип("Число") Тогда
		МаксимальныйУровеньРазузлования = -1;
	КонецЕсли;
	
	Уровень = 0;
	МассивКонтейнеровДляОбработки = МассивКонтейнеров; 
	МассивКонтейнеровВерхнегоУровня = Новый Массив;
	Проигравшие = Новый Массив;
	Пока МассивКонтейнеровДляОбработки.Количество() > 0 Цикл 
		ТаблицаСоставаСледующийУровень = ПолучитьТаблицуСледующегоУровняСоставаПоКонтейнерам(МассивКонтейнеровДляОбработки, Ложь, ДополнительныеПараметры);
		
		Для Каждого Контейнер Из МассивКонтейнеровДляОбработки Цикл
			Если ТаблицаСоставаСледующийУровень.НайтиСтроки(Новый Структура("Товар", Контейнер)).Количество() = 0 Тогда
				МассивКонтейнеровВерхнегоУровня.Добавить(Контейнер);
			КонецЕсли;
		КонецЦикла;
		
		Если ПолучитьГоризонтальныеОстаткиДополнительныхУровней Тогда
			МассивКонтейнеровСледующегоУровня = РК.ВыгрузитьЗначенияКолонкиКоллекции(ТаблицаСоставаСледующийУровень, "Контейнер");
			ТаблицаСоставаСледующийУровень = ПолучитьТаблицуСледующегоУровняСоставаПоКонтейнерам(МассивКонтейнеровСледующегоУровня, Истина, ДополнительныеПараметры);
		КонецЕсли;
		
		МассивКонтейнеровДляОбработки = Новый Массив;
		Для Каждого СтрокаСоставаСледующийУровень Из ТаблицаСоставаСледующийУровень Цикл
			Если МассивКонтейнеров.Найти(СтрокаСоставаСледующийУровень.Контейнер) <> Неопределено Тогда
				//этот контейнер входит в иерархию другого контейнера
				Проигравшие.Добавить(СтрокаСоставаСледующийУровень.Товар);
				Продолжить;
			КонецЕсли;
			
			СтрокаСостава = ТаблицаСоставаИерархияВверх.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСостава, СтрокаСоставаСледующийУровень);
			СтрокаСостава.ПолныеДанные = Ложь;
			
			Если ТаблицаСоставаИерархияВверх.НайтиСтроки(Новый Структура("Товар", СтрокаСостава.Контейнер)).Количество() = 0 Тогда
				МассивКонтейнеровДляОбработки.Добавить(СтрокаСостава.Контейнер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	//удалим Проигравшие контейнеры и их позорный путь изгладим из истории
	СтрокиУдалить = Новый Массив;
	Для Каждого Контейнер Из Проигравшие Цикл
		РК.ДобавитьЭлементыКоллекции(СтрокиУдалить, ТаблицаСоставаИерархияВверх.НайтиСтроки(Новый Структура("Контейнер", Контейнер)));
	КонецЦикла;
	
	Для Каждого СтрокаКонтейнера Из СтрокиУдалить Цикл
		Контейнер = СтрокаКонтейнера.Товар;
		Проигравшие.Добавить(Контейнер);
		РК.ДобавитьЭлементыКоллекции(СтрокиУдалить, ТаблицаСоставаИерархияВверх.НайтиСтроки(Новый Структура("Контейнер", Контейнер)));
	КонецЦикла;
	РК.УдалитьЭлементыКоллекции(ТаблицаСоставаИерархияВверх, СтрокиУдалить);
	МассивКонтейнеровДляРазузлования = РК.ВычитаниеМассивов(МассивКонтейнеров, Проигравшие);
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// иерархия вниз (разузлование)
	ТаблицаСоставаИерархияВниз = РК.НоваяТаблицаЗначений(ПоляТаблицыСостава);
	Для Каждого Контейнер Из МассивКонтейнеровДляРазузлования Цикл
		СтрокиКонтейнераИерархияВверх = ТаблицаСоставаИерархияВверх.НайтиСтроки(Новый Структура("Товар", Контейнер));
		Для Каждого СтрокаКонтейнераИерархияВверх Из СтрокиКонтейнераИерархияВверх Цикл
			СтрокаКонтейнераИерархияВниз = ТаблицаСоставаИерархияВниз.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКонтейнераИерархияВниз, СтрокаКонтейнераИерархияВверх);
			ТаблицаСоставаИерархияВверх.Удалить(СтрокаКонтейнераИерархияВверх);
		КонецЦикла;
	КонецЦикла;
	
	ТипКонтейнер = Тип("СправочникСсылка.вмс_Контейнеры");
	УровеньРазузлования = 0;
	СтрокиКонтейнеровНижнихУровней = Новый Массив;
	Пока МассивКонтейнеровДляРазузлования.Количество() > 0 Цикл
		
		Если МаксимальныйУровеньРазузлования = УровеньРазузлования Тогда
			Прервать;
		КонецЕсли;
		
		ТаблицаСоставаСледующийУровень = ПолучитьТаблицуСледующегоУровняСоставаПоКонтейнерам(МассивКонтейнеровДляРазузлования, Истина, ДополнительныеПараметры);
		Для Каждого Контейнер Из МассивКонтейнеровДляРазузлования Цикл
			Если ТаблицаСоставаСледующийУровень.НайтиСтроки(Новый Структура("Контейнер", Контейнер)).Количество() = 0 Тогда
				СтрокиКонтейнера = ТаблицаСоставаИерархияВниз.НайтиСтроки(Новый Структура("Товар", Контейнер));
				Для Каждого СтрокаСостава Из СтрокиКонтейнера Цикл
					СтрокаСостава.ПолныеДанные = Истина;
					СтрокиКонтейнеровНижнихУровней.Добавить(СтрокаСостава);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		МассивКонтейнеровДляРазузлования = Новый Массив;
		Для Каждого СтрокаСоставаСледующийУровень Из ТаблицаСоставаСледующийУровень Цикл
			СтрокаСостава = ТаблицаСоставаИерархияВниз.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСостава, СтрокаСоставаСледующийУровень);
			СтрокаСостава.ПолныеДанные = Ложь;
			Содержимое = СтрокаСостава.Товар;
			Если ТаблицаСоставаИерархияВниз.НайтиСтроки(Новый Структура("Контейнер", Содержимое)).Количество() = 0 Тогда
				Если ТипЗнч(Содержимое) = ТипКонтейнер Тогда
					МассивКонтейнеровДляРазузлования.Добавить(Содержимое);
				Иначе
					СтрокаСостава.ПолныеДанные = Истина;
					СтрокиКонтейнеровНижнихУровней.Добавить(СтрокаСостава);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		УровеньРазузлования = УровеньРазузлования + 1;
		
	КонецЦикла;
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// проставим признак полноты данных от нижних уровней к верхним
	ОбработанныеСтрокиКонтейнеров = Новый Соответствие;
	Для Каждого СтрокаКонтейнера Из СтрокиКонтейнеровНижнихУровней Цикл
		СтрокиМастерКонтейнера = ТаблицаСоставаИерархияВниз.НайтиСтроки(Новый Структура("Товар", СтрокаКонтейнера.Контейнер));
		Если СтрокиМастерКонтейнера.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаМастерКонтейнера = СтрокиМастерКонтейнера[0];
		
		Если ОбработанныеСтрокиКонтейнеров[СтрокаМастерКонтейнера] <> Истина Тогда
			СтрокаМастерКонтейнера.ПолныеДанные = СтрокаКонтейнера.ПолныеДанные;
			Если СтрокаМастерКонтейнера.ПолныеДанные Тогда
				СтрокиКонтейнеровНижнихУровней.Добавить(СтрокаМастерКонтейнера);
			КонецЕсли;
			ОбработанныеСтрокиКонтейнеров[СтрокаМастерКонтейнера] = Истина;
		ИначеЕсли СтрокаМастерКонтейнера.ПолныеДанные И Не СтрокаКонтейнера.ПолныеДанные Тогда
			СтрокаМастерКонтейнера.ПолныеДанные = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// объединим иерархии вверх и вниз
	ТаблицаСостава = РК.НоваяТаблицаЗначений(ПоляТаблицыСостава);
	РК.ДобавитьЭлементыКоллекции(ТаблицаСостава, ТаблицаСоставаИерархияВверх);
	РК.ДобавитьЭлементыКоллекции(ТаблицаСостава, ТаблицаСоставаИерархияВниз);
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// проставим уровень
	СтрокиКонтейнеров = Новый Массив;
	Для Каждого Контейнер Из МассивКонтейнеровВерхнегоУровня Цикл
		СтрокиКонтейнера = ТаблицаСостава.НайтиСтроки(Новый Структура("Контейнер", Контейнер));
		РК.ДобавитьЭлементыКоллекции(СтрокиКонтейнеров, СтрокиКонтейнера);
	КонецЦикла;
	
	Уровень = 0;
	Пока СтрокиКонтейнеров.Количество() > 0 Цикл
		СтрокиКонтейнеровСледующегоУровня = Новый Массив;
		Для Каждого СтрокаКонтейнера Из СтрокиКонтейнеров Цикл
			СтрокаКонтейнера.Уровень = Уровень;
			СтрокиКонтейнераСледующегоУровня = ТаблицаСостава.НайтиСтроки(Новый Структура("Контейнер", СтрокаКонтейнера.Товар));
			РК.ДобавитьЭлементыКоллекции(СтрокиКонтейнеровСледующегоУровня, СтрокиКонтейнераСледующегоУровня);
		КонецЦикла;
		СтрокиКонтейнеров = СтрокиКонтейнеровСледующегоУровня;
		Уровень = Уровень + 1;
	КонецЦикла;
	
	ТаблицаСостава.Сортировать("Уровень");
	
	ТолькоТовары = РК.ПолучитьЗначениеПоляСтруктуры(ДополнительныеПараметры, "ТолькоТовары") = Истина;
	Если ТолькоТовары Тогда
		ТипКонтейнер = Тип("СправочникСсылка.вмс_Контейнеры");
		ТаблицаТоваров = ТаблицаСостава.СкопироватьКолонки();
		ТаблицаОбходаКонтейнеров = ТаблицаСостава.СкопироватьКолонки();
		Для Каждого Контейнер Из МассивКонтейнеров Цикл
			РК.ДобавитьЭлементыКоллекции(ТаблицаОбходаКонтейнеров, ТаблицаСостава.НайтиСтроки(Новый Структура("Контейнер", Контейнер)));
		КонецЦикла;
		
		Для Каждого СтрокаОбхода Из ТаблицаОбходаКонтейнеров Цикл
			Если ТипЗнч(СтрокаОбхода.Товар) = ТипКонтейнер Тогда
				СтрокиСоставаСледующийУровень = ТаблицаСостава.НайтиСтроки(Новый Структура("Контейнер", СтрокаОбхода.Товар));
				Для Каждого СтрокаСоставаСледующийУровень Из СтрокиСоставаСледующийУровень Цикл
					СтрокаОбходаСледующийУровень = ТаблицаОбходаКонтейнеров.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаОбходаСледующийУровень, СтрокаСоставаСледующийУровень);
					ЗаполнитьЗначенияСвойств(СтрокаОбходаСледующийУровень, СтрокаОбхода, "ПолныеДанные, Контейнер, ТипКонтейнера, Уровень");
				КонецЦикла;
			Иначе
				СтрокаТовара = ТаблицаТоваров.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТовара, СтрокаОбхода);
			КонецЕсли;
		КонецЦикла;
		
		РК.СвернутьТаблицуЗначений(ТаблицаТоваров, , "КоличествоОстаток");
		
		Возврат ТаблицаТоваров;
	КонецЕсли;
	
	Возврат ТаблицаСостава;
	
КонецФункции

Функция ПолучитьВсеТоварыКонтейнеров(Контейнеры, ДополнительныеПараметры=Неопределено)
	
	Перем РК, ДетализироватьПоКонтейнерам;
	
	РК = вмс_РаботаСКоллекциями;
	
	МассивКонтейнеров = РК.ЗначениеВМассив(Контейнеры);
	РК.УдалитьДублиВМассиве(МассивКонтейнеров);
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли;
	
	ТоварныеПоля = Неопределено;
	ДополнительныеПараметры.Свойство("ТоварныеПоля", ТоварныеПоля);
	
	Если ТоварныеПоля <> Неопределено Тогда
		ТоварныеПоляМассив = РК.ЗначениеВМассив(ТоварныеПоля, , Ложь);
	Иначе
		ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля(); 
	КонецЕсли;  
	
	//Кулалаев Е.С + 31.05.2023 12:26:19
	//BOX-57 Модуль учета единиц измерения в мобильной версии: Остатки по упаковкам не ведутся. Пока.
	Если ТоварныеПоляМассив.Найти("Упаковка") <> Неопределено Тогда
		вмс_РаботаСКоллекциями.ВычестьМассив(ТоварныеПоляМассив, "Упаковка");
	КонецЕсли;
	//Кулалаев Е.С -
	
	
	ДополнительныеПараметры.Вставить("ТоварныеПоля", ТоварныеПоляМассив);
	
	ТоварныеПоля = РК.МассивВСтроку(ТоварныеПоляМассив);
	
	ПоляТаблицыСостава = "Контейнер, Артикул, %ТОВАРНЫЕПОЛЯ%, КоличествоОстаток";
	ПоляТаблицыСостава = СтрЗаменить(ПоляТаблицыСостава, "%ТОВАРНЫЕПОЛЯ%", ТоварныеПоля);
	ТаблицаСостава = РК.НоваяТаблицаЗначений(ПоляТаблицыСостава);
	
	МассивКонтейнеровДляРазузлованияУровня = РК.СкопироватьОбъект(МассивКонтейнеров);
	МассивКонтейнеровДляРазузлования = МассивКонтейнеровДляРазузлованияУровня;
	
	ТипКонтейнер = Тип("СправочникСсылка.вмс_Контейнеры");
	ТаблицаИерархииКонтейнеров = РК.НоваяТаблицаЗначений("МастерКонтейнер, Контейнер, Номер");
	Пока МассивКонтейнеровДляРазузлованияУровня.Количество() > 0 Цикл
		ТаблицаСоставаСледующийУровень = ПолучитьТаблицуСледующегоУровняСоставаПоКонтейнерам(МассивКонтейнеровДляРазузлованияУровня, Истина, ДополнительныеПараметры);
		МассивКонтейнеровДляРазузлованияУровня = Новый Массив;
		Для Каждого СтрокаСоставаСледующийУровень Из ТаблицаСоставаСледующийУровень Цикл
			Если ТипЗнч(СтрокаСоставаСледующийУровень.Товар) = ТипКонтейнер Тогда
				ВложенныйКонтейнер = СтрокаСоставаСледующийУровень.Товар;
				Если ТаблицаИерархииКонтейнеров.НайтиСтроки(Новый Структура("Контейнер", ВложенныйКонтейнер)).Количество() = 0 Тогда
					СтрокаИерархии = ТаблицаИерархииКонтейнеров.Добавить();
					СтрокаИерархии.МастерКонтейнер = СтрокаСоставаСледующийУровень.Контейнер;
					СтрокаИерархии.Контейнер = ВложенныйКонтейнер;
					СтрокаИерархии.Номер = ТаблицаИерархииКонтейнеров.Количество();
				КонецЕсли;
				
				Если МассивКонтейнеровДляРазузлования.Найти(ВложенныйКонтейнер) = Неопределено Тогда
					МассивКонтейнеровДляРазузлования.Добавить(ВложенныйКонтейнер);
					МассивКонтейнеровДляРазузлованияУровня.Добавить(ВложенныйКонтейнер);
				КонецЕсли;
			Иначе
				СтрокаСостава = ТаблицаСостава.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСостава, СтрокаСоставаСледующийУровень);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаИерархииКонтейнеров.Сортировать("Номер УБЫВ");
	
	//дополнить иерархию мастер-контейнерами (у которых нет своих мастеров)
	Для Каждого Контейнер Из МассивКонтейнеров Цикл
		Если ТаблицаИерархииКонтейнеров.НайтиСтроки(Новый Структура("Контейнер", Контейнер)).Количество() > 0 Тогда
			//уже подгружен
			Продолжить;
		КонецЕсли;
		
		СтрокаИерархии = ТаблицаИерархииКонтейнеров.Добавить();
		СтрокаИерархии.МастерКонтейнер = Неопределено;
		СтрокаИерархии.Контейнер = Контейнер;
		СтрокаИерархии.Номер = ТаблицаИерархииКонтейнеров.Количество();
	КонецЦикла;
	
	//формируем полный состав контейнеров с учетом вложенных контейнеров
	ТаблицаПолногоСостава = ТаблицаСостава.Скопировать();
	Для Каждого СтрокаКонтейнера Из ТаблицаИерархииКонтейнеров Цикл
		СтрокиВложенныхКонтейнеров = ТаблицаИерархииКонтейнеров.НайтиСтроки(Новый Структура("МастерКонтейнер", СтрокаКонтейнера.Контейнер));
		Для Каждого СтрокаВложенногоКонтейнера Из СтрокиВложенныхКонтейнеров Цикл
			ТоварыВложенногоКонтейнера = ТаблицаПолногоСостава.НайтиСтроки(Новый Структура("Контейнер", СтрокаВложенногоКонтейнера.Контейнер));
			Для Каждого ТоварВложенногоКонтейнера Из ТоварыВложенногоКонтейнера Цикл
				СтрокаСостава = ТаблицаПолногоСостава.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСостава, ТоварВложенногоКонтейнера);
				СтрокаСостава.Контейнер = СтрокаКонтейнера.Контейнер;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	РК.СвернутьТаблицуЗначений(ТаблицаПолногоСостава, , "КоличествоОстаток");
	
	//вернем результат только по переданным контейнерам (без вложенных контейнеров)
	СтрокиТоваров = Новый Массив;
	Для Каждого Контейнер Из МассивКонтейнеров Цикл
		РК.ДобавитьЭлементыКоллекции(СтрокиТоваров, ТаблицаПолногоСостава.НайтиСтроки(Новый Структура("Контейнер", Контейнер)));
	КонецЦикла;
	ТаблицаСоставаРезультат = ТаблицаПолногоСостава.Скопировать(СтрокиТоваров);
	
	Возврат ТаблицаСоставаРезультат;
	
КонецФункции

Функция ПолучитьТаблицуСледующегоУровняСоставаПоКонтейнерам(Контейнеры, Вниз=Истина, ДополнительныеПараметры=Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.Контейнер КАК Контейнер,
	|	ВТ.Товар КАК Товар,
	|	ВТ.Маркировка КАК Маркировка,
	|	ВТ.КоличествоОборот КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.вмс_ОстаткиВКонтейнерах.Обороты(, &Дата, , Контейнер В (&Контейнеры)) КАК ВТ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ.Контейнер,
	|	ВТ.Товар,
	|	ВТ.Маркировка,
	|	-ВТ.КоличествоОборот
	|ИЗ
	|	РегистрНакопления.вмс_ОстаткиВКонтейнерах.Обороты(, &Дата, Регистратор, Контейнер В (&Контейнеры)) КАК ВТ
	|ГДЕ
	|	ВТ.Регистратор В(&ТекущиеДокументы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Контейнер КАК Контейнер,
	|	ВТ.Товар КАК Товар,
	|	ВТ.Маркировка КАК Маркировка,
	|	СУММА(ВТ.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ2
	|ИЗ
	|	ВТ КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Контейнер,
	|	ВТ.Товар,
	|	ВТ.Маркировка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Контейнер КАК Контейнер,
	|	ВТ.Товар КАК Товар,
	|	ВТ.Маркировка КАК Маркировка,
	|	ВТ.КоличествоОстаток КАК КоличествоОстаток,
	|	ВТ.Контейнер.ТипТары КАК ТипКонтейнера,
	|	ВЫБОР
	|		КОГДА &Товар ССЫЛКА Справочник.вмс_Контейнеры
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СодержимоеКонтейнер,
	|	&Артикул КАК Артикул,
	|	ЛОЖЬ КАК ПолныеДанные
	|ИЗ
	|	ВТ2 КАК ВТ
	|ГДЕ
	|	ВТ.КоличествоОстаток <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контейнер";
	
	РК = вмс_РаботаСКоллекциями;
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли;
	
	ПустаяДата = '00010101';
	Дата = Неопределено;
	ДополнительныеПараметры.Свойство("Дата", Дата);
	Если ТипЗнч(Дата) <> Тип("Дата") Тогда
		Дата = ПустаяДата;
	КонецЕсли;
	
	ТоварныеПоля = Неопределено;
	ДополнительныеПараметры.Свойство("ТоварныеПоля", ТоварныеПоля);
	Если ТоварныеПоля <> Неопределено Тогда
		ТоварныеПоляМассив = РК.ЗначениеВМассив(ТоварныеПоля, , Ложь);
	Иначе
		ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля();   
	КонецЕсли;
	
	//Кулалаев Е.С + 31.05.2023 12:26:19
	//BOX-57 Модуль учета единиц измерения в мобильной версии: Остатки по упаковкам не ведутся. Пока.
	Если ТоварныеПоляМассив.Найти("Упаковка") <> Неопределено Тогда
		вмс_РаботаСКоллекциями.ВычестьМассив(ТоварныеПоляМассив, "Упаковка");
	КонецЕсли;
	//Кулалаев Е.С -
	
	ТоварныеПоля = РК.МассивВСтроку(ТоварныеПоляМассив);
	
	ТекущиеДокументы = Неопределено;
	ДополнительныеПараметры.Свойство("ТекущиеДокументы", ТекущиеДокументы);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТ.Товар КАК Товар", ТоварныеПоля);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТ.Товар", ТоварныеПоля);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Артикул", "ВЫРАЗИТЬ(ВТ.Товар КАК Справочник.Номенклатура).Артикул");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Товар", "ВТ.Товар");
	
	Если Вниз <> Истина Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Контейнер В (&Контейнеры)", "Товар В (&Контейнеры)");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Контейнеры", Контейнеры);
	Запрос.УстановитьПараметр("ТекущиеДокументы", ТекущиеДокументы);
	
	РезультатЗапроса = Запрос.Выполнить();
	Таблица = РезультатЗапроса.Выгрузить();
	Возврат Таблица;
	
КонецФункции

Функция СоставКонтейнераУпрощенный(Контейнер = Неопределено)
	Результат = Новый Структура("Успех, Сообщение, Таблица", Ложь, "", Неопределено);
	
	Если НЕ ЗначениеЗаполнено(Контейнер) Тогда
		Результат.Таблица = Новый ТаблицаЗначений;
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;
	
	ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля();
	//""Временное"" решение для работоспособности формы при включенных упаковках в товарных полях (их надо удалить из товарныхъ полей в принципе)
	ИндексУпаковки = ТоварныеПоляМассив.Найти("Упаковка");
	Если ИндексУпаковки <> Неопределено Тогда
		ТоварныеПоляМассив.Удалить(ИндексУпаковки);
	КонецЕсли;
	//
	
	СтрокаВыбор = "";
	Для Каждого ИмяПоля Из ТоварныеПоляМассив Цикл
		СтрокаВыбор = СтрокаВыбор + Символы.Таб + "&t." + ИмяПоля + " КАК " + ИмяПоля + "," + Символы.ПС;
	КонецЦикла;
	
	Запрос = Новый Запрос;	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыбор, "&t", "вмс_ОперацияПоЯчейкамОстатки") +
	"	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ БезАртикула
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(, Контейнер = &Контейнер) КАК вмс_ОперацияПоЯчейкамОстатки
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + СтрЗаменить(СтрокаВыбор, "&t", "БезАртикула") +
	"	БезАртикула.Количество КАК Количество,
	|	Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	БезАртикула КАК БезАртикула
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО БезАртикула.Товар = Номенклатура.Ссылка";
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	
	Результат.Таблица = Запрос.Выполнить().Выгрузить();
	Результат.Успех = Истина;
	Возврат Результат;
КонецФункции

