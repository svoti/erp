#Область ВИП

Функция ЭтоВИП(Имя) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ВИПы = РК.СтрокуВМассив(ПолучитьСтрокуИзДвоичныхДанных(ПолучитьМакет("gymvip")), Символы.ПС);
	
	Инициалы = РК.СтрокуВМассив(Строка(Имя), " ");
	Для ИндексИнициала=0 По Инициалы.ВГраница() Цикл
		Инициалы[ИндексИнициала] = нрег(Инициалы[ИндексИнициала]);
	КонецЦикла;
	
	Для Каждого ВИП из ВИПы Цикл
		Опознан = Истина;
		ИнициалыВИП = РК.СтрокуВМассив(ВИП, " ");
		Для Каждого ИнициалВИП Из ИнициалыВИП Цикл
			Если Инициалы.Найти(нрег(ИнициалВИП))=Неопределено Тогда
				Опознан = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Опознан Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЗагрузитьЗвуковуюСхемуВИП() Экспорт
	
	вмс_ОбновлениеИнформационнойБазы.ЗагрузитьПредопределенныеОбъектыИБИзДанныхXML(ПолучитьМакет("gymsfx"));
	
