#Область БиблиотекаФункций

Функция ИнициализироватьМодульОбработки(ПараметрыИнициализации) Экспорт
	
	Имя = ПараметрыИнициализации.ИмяСборщика;
	ОсновнойМодульСборщика = ПараметрыИнициализации.ОсновнойМодульСборщика;
	
	ИменаМетодов = 
	"ВыполнитьДействие,
	|УстановитьПоля,
	|УстановитьСвойстваПолейПоУмолчанию,
	|УстановитьДоступныеПоля,
	|УстановитьДополнительныеПоля,
	|ПриЗавершенииИнициализацииПолей,
	|ИнициализироватьДанные,
	|ЕстьИзменениеДанных,
	|НачатьВводДанных,
	|НачатьВыборСледующегоПоля,
	|РазобратьВходящиеОбъекты,
	|УстановитьРабочиеСтраницы,
	|ВводДоступен,
	|НачатьТранзакциюСборщика,
	|ОбновитьДанныеТранзакцииОбработки,
	|ЗафиксироватьТранзакциюСборщика,
	|ПослеЗавершенияТранзакцииВвода,
	|ПослеЗавершенияВвода,
	|ОстановитьВводДанных,
	|ОтменитьВводДанных,
	|ВозобновитьВводДанных,
	|ОтменитьТранзакциюСборщика,
	|ЗакончитьТранзакциюСборщика,
	|СохранениеДанныхСборщика,
	|ЗаполнитьПринятыеДанныеПолей,
	|ЗаполнитьВведенныеДанныеПолей,
	|ЗаполнитьЗапланированныеДанныеПолей,
	|ЗаполнитьСобранныеДанныеПолей,
	|ЗаполнитьСобранныеДанныеПолейДополнительно,
	|ЗаполнитьДанныеПолей,
	|ЗаполнитьОбщиеДанныеПолей,
	|ЗаполнитьОбщиеДанныеПолейДополнительно,
	|ЗаполнитьПредставлениеДанныхПолей,
	|ЗаполнитьТаблицы,
	|ПроанализироватьЗаполнениеПолейДанных,
	|РезультатАнализаЗаполненияПолейДанных,
	|ОчиститьДанныеПолей,
	|СохранитьСостояниеОбработки,
	|ВосстановитьСостояниеОбработки,
	|ВыполнитьЗавершениеОперации";
	МодулиМетодов = Новый Структура(ИменаМетодов);
	
	ДанныеРеальныхМодулей = РК.НоваяТаблицаЗначений("ИмяМодуля, Модуль");
	
	ЭтапыВводаДанных = РК.НоваяТаблицаЗначений("ОписаниеОповещения, Группа, Имя, Пропускать, Данные");
	
	Обработки.вмс_СерверУправляемыйМодульСтандартный.ИнициализироватьДанныеОбработки(ПараметрыМодуля);
	
	ПараметрыМодуля.Вставить("ОсновнойМодульСборщика", ОсновнойМодульСборщика);
	ПараметрыМодуля.Вставить("МодулиМетодов", МодулиМетодов);
	ПараметрыМодуля.Вставить("ДанныеРеальныхМодулей", ДанныеРеальныхМодулей);
	
	ПараметрыМодуля.Вставить("ЭтапыВводаДанных", ЭтапыВводаДанных);
	ПараметрыМодуля.Вставить("ПанельЭлементовВыводаПоУмолчанию", ПараметрыОбработки.ПанельЭлементовВыводаПоУмолчанию);
	ПараметрыМодуля.Вставить("РабочиеСтраницы");
	
	//унифицировать для всех модулей операции
	ПараметрыМодуля.Вставить("ПустойЭлементВывода", ПараметрыОбработки.ПустойЭлементВывода);
	ПараметрыМодуля.Вставить("ПустоеПолеОбработки", ПараметрыОбработки.ПустоеПолеОбработки);
	
	ДанныеТранзакции = ПараметрыМодуля.ДанныеТранзакции;
	ДанныеТранзакции.Вставить("НомерЭтапа", 0);
	
	ДобавитьРеальныйМодуль(ОсновнойМодульСборщика);
	
КонецФункции

Функция ДобавитьРеальныйМодуль(РеальныйМодуль) Экспорт
	
	Если НЕ МодульПодключен(РеальныйМодуль) Тогда
		ИмяМодуля = ПолучитьИмяНовогоМодуля(РеальныйМодуль);
		ДанныеРеальногоМодуля = ДанныеРеальныхМодулей.Добавить();
		ДанныеРеальногоМодуля.ИмяМодуля = ИмяМодуля;
		ДанныеРеальногоМодуля.Модуль = РеальныйМодуль;
	КонецЕсли;
	
	РеальныйМодуль.Интерфейс = ЭтотОбъект;
	ЗаполнитьЗначенияСвойств(РеальныйМодуль, ЭтотОбъект);
	РеальныйМодуль.Инициализировать();
	
КонецФункции

Функция Модуль(ИмяМодуля) Экспорт
	
	ДанныеРеальногоМодуляМассив = ДанныеРеальныхМодулей.НайтиСтроки(Новый Структура("ИмяМодуля", ИмяМодуля));
	
	Если ДанныеРеальногоМодуляМассив.Количество() > 0 Тогда
		
		Возврат ДанныеРеальногоМодуляМассив[0].Модуль;
		
	Конецесли;
	
КонецФункции

Функция ИмяМодуля(Модуль) Экспорт
	
	ДанныеРеальногоМодуля = ДанныеРеальногоМодуля(Модуль);
	
	Если ДанныеРеальногоМодуля <> Неопределено Тогда
		
		Возврат ДанныеРеальногоМодуля.ИмяМодуля;
		
	Конецесли;
	
КонецФункции

Функция МодульПодключен(Модуль) Экспорт
	
	Возврат ДанныеРеальногоМодуля(Модуль) <> Неопределено;
	
КонецФункции

Функция ДанныеРеальногоМодуля(Модуль) Экспорт
	
	ДанныеРеальногоМодуляМассив = ДанныеРеальныхМодулей.НайтиСтроки(Новый Структура("Модуль", Модуль));
	
	Если ДанныеРеальногоМодуляМассив.Количество() > 0 Тогда
		
		Возврат ДанныеРеальногоМодуляМассив[0];
		
	Конецесли;
	
КонецФункции

Функция ПолучитьИмяНовогоМодуля(Модуль)
	
	ИмяНовогоМодуля = Модуль.Метаданные().Имя;
	
	Префикс = "вмс_СерверУправляемыйМодуль";
	ДлинаПрефикса = СтрДлина(Префикс);
	
	Если Лев(ИмяНовогоМодуля, ДлинаПрефикса)=Префикс Тогда
		ИмяНовогоМодуля = Прав(ИмяНовогоМодуля, СтрДлина(ИмяНовогоМодуля)-ДлинаПрефикса);
	КонецЕсли;
	
	НомерМодуля = 0;
	Префикс = ИмяНовогоМодуля;
	Пока Истина Цикл
		Суффикс = Формат(НомерМодуля, "ЧГ=0");
		ИмяНовогоМодуля = Префикс + Суффикс;
		Если ДанныеРеальныхМодулей.НайтиСтроки(Новый Структура("ИмяМодуля", ИмяНовогоМодуля)).Количество()=0 Тогда
			Прервать;
		КонецЕсли;
		
		НомерМодуля = НомерМодуля + 1;
	КонецЦикла;
	
	Возврат ИмяНовогоМодуля;
	
КонецФункции

Функция УстановитьРеализациюМетодов(ИменаРеализуемыхМетодовИнтерфейса, МодульРеализацииМетодов) Экспорт
	
	ИменаМетодовМассив = РК.ЗначениеВМассив(ИменаРеализуемыхМетодовИнтерфейса);
	
	Для Каждого ИмяМетода Из ИменаМетодовМассив Цикл
		Если НЕ МодулиМетодов.Свойство(ИмяМетода) Тогда
			ВызватьИсключение "Отсуствует интерфейс для метода """ + ИмяМетода + """";
		КонецЕсли;
		
		МодулиМетодов[ИмяМетода] = МодульРеализацииМетодов;
	КонецЦикла;
	
КонецФункции

Функция ДобавитьЭтапВводаДанных(ОписаниеОбработчика, знач Группа=Неопределено, знач Место=Неопределено, знач Имя=Неопределено) Экспорт
	
	ЭтапыВводаДанных = ПараметрыМодуля.ЭтапыВводаДанных;
	
	Если Место=Неопределено Тогда
		Место = Группа;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Если ОписаниеОбработчика <> Неопределено Тогда
			Если ОписаниеОбработчика.ЭтоПередаточныйОбработчикОповещения Тогда
				ОбработчикОповещенияРеальногоМодуля = ОписаниеОбработчика.ДополнительныеПараметры;
			Иначе
				ОбработчикОповещенияРеальногоМодуля = ОписаниеОбработчика;
			КонецЕсли;
			Имя = ОбработчикОповещенияРеальногоМодуля.ИмяПроцедуры;
		КонецЕсли;
	КонецЕсли;
	
	Отбор = Новый Структура("Имя", Имя);
	Если Место <> Неопределено Тогда
		Отбор.Вставить("Группа", Место);
	КонецЕсли;
	
	СуществующиеЭтапы = ЭтапыВводаДанных.НайтиСтроки(Отбор);
	Если СуществующиеЭтапы.Количество() > 0 Тогда
		//заменим обработчик
		ЭтапВводаДанных = СуществующиеЭтапы[0];
	Иначе
		Если Место <> Неопределено Тогда
			СуществующиеЭтапы = ЭтапыВводаДанных.НайтиСтроки(Новый Структура("Группа", Место));
			Если СуществующиеЭтапы.Количество() > 0 Тогда
				СуществующийЭтап = СуществующиеЭтапы[СуществующиеЭтапы.Количество()-1];
				Индекс = ЭтапыВводаДанных.Индекс(СуществующийЭтап) + 1;
			Иначе
				Индекс = ЭтапыВводаДанных.Количество();
			КонецЕсли;
		Иначе
			Индекс = ЭтапыВводаДанных.Количество();
		КонецЕсли;
		ЭтапВводаДанных = ЭтапыВводаДанных.Вставить(Индекс);
		ЭтапВводаДанных.Группа = Группа;
		ЭтапВводаДанных.Имя = Имя;
		ЭтапВводаДанных.Пропускать = Ложь;
		ЭтапВводаДанных.Данные = Новый Структура;
	КонецЕсли;
	
	ЭтапВводаДанных.ОписаниеОповещения = ОписаниеОбработчика;
	
	Возврат ЭтапВводаДанных;
	
КонецФункции

Функция НовыйОписаниеОповещения(ИмяПроцедуры, Модуль, ДополнительныеПараметры=Неопределено) Экспорт
	
	ИмяМодуля = ИмяМодуля(Модуль);
	Если ИмяМодуля <> Неопределено Тогда
		//это реальный модуль, доступ к нему осуществляется через передаточный обработчик интерфейса
		ОбработчикОповещенияРеальногоМодуля = вмс_ОбщегоНазначенияКлиентСервер.НовыйОписаниеОповещения(ИмяПроцедуры, Неопределено, ДополнительныеПараметры);
		ОбработчикОповещенияРеальногоМодуля.ИмяМодуля = ИмяМодуля;
		ОписаниеОповещения = вмс_СерверУправляемыеОбработки.НовыйОписаниеОповещения("ПередаточныйОбработчикОповещения", ПараметрыОбработки, ЭтотОбъект, ОбработчикОповещенияРеальногоМодуля);
		ОписаниеОповещения.ЭтоПередаточныйОбработчикОповещения = Истина;
	Иначе
		ОписаниеОповещения = вмс_СерверУправляемыеОбработки.НовыйОписаниеОповещения(ИмяПроцедуры, ПараметрыОбработки, Модуль, ДополнительныеПараметры);
	КонецЕсли;
	
	Возврат ОписаниеОповещения;
	
КонецФункции

Функция ПередаточныйОбработчикОповещения(Результат, знач ОбработчикОповещенияРеальногоМодуля) Экспорт
	
	ОбработчикОповещенияРеальногоМодуля = РК.СкопироватьОбъект(ОбработчикОповещенияРеальногоМодуля);
	ОбработчикОповещенияРеальногоМодуля.Модуль = Модуль(ОбработчикОповещенияРеальногоМодуля.ИмяМодуля);
	вмс_ОбщегоНазначенияКлиентСервер.ВыполнитьОбработкуОповещенияПереопределенный(ОбработчикОповещенияРеальногоМодуля, Результат);
	
КонецФункции

Функция Действие(Код, ПараметрыДействия=Неопределено) Экспорт
	
	Возврат вмс_СерверУправляемыеОбработки.Действие(Код, ПараметрыДействия, ПараметрыОбработки.Идентификатор, ПараметрыОбработки, ЭтотОбъект);
	
КонецФункции

