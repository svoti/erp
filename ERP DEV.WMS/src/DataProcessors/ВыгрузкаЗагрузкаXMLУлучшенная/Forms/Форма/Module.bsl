&НаКлиенте
Перем Переменные;

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;  
	ДиалогВыбораФайла.ПолноеИмяФайла = "ВыгрузкаЭлементов.xml";
	ДиалогВыбораФайла.Показать(Новый ОписаниеОповещения("ПриВыбореФайла", ЭтаФорма));
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореФайла(ВыбранныйПутьКФайлу, ДополнительныеПараметры) Экспорт
	Если ВыбранныйПутьКФайлу <> Неопределено И ВыбранныйПутьКФайлу.Количество() > 0 Тогда
		ПутьКФайлу = ВыбранныйПутьКФайлу[0];
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура Выгрузить(Команда)
	ТекстВыгрузки = ВыгрузитьНаСервере(Переменные.ВыбранныеОбъекты);
	ЗаписьТекста = Новый ЗаписьТекста;
	ЗаписьТекста.Открыть(ПутьКФайлу);
	ЗаписьТекста.ЗаписатьСтроку(ТекстВыгрузки);
	ЗаписьТекста.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыгрузитьНаСервере(знач ВыбранныеОбъекты)
	
	ТекстВыгрузки = ВыгрузитьОбъектыПоСсылкам(ВыбранныеОбъекты);
	
	Возврат ТекстВыгрузки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыгрузитьОбъектыПоСсылкам(МассивСсылокНаОбъекты)

	Перем Объект;
	Перем РаботаСXMLКлиентСервер;
	
	РаботаСXMLКлиентСервер = ПолучитьОбщийМодульНаСервере("РаботаСXMLКлиентСервер");
	РаботаСXMLКлиентСервер = вмс_РаботаСXMLКлиентСервер;

	МассивОбъектов = Новый Массив;
	Для Каждого СсылкаНаОбъект Из МассивСсылокНаОбъекты Цикл
		Объект = СсылкаНаОбъект.ПолучитьОбъект();
		МассивОбъектов.Добавить(Объект);
	КонецЦикла;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьНачалоЭлемента("ВыгрузкаПредопределенныхЭлементов");
	ПараметрыЗаписиXML = РаботаСXMLКлиентСервер.ПолучитьПараметрыЗаписиXML(ЗаписьXML, Истина);
	РаботаСXMLКлиентСервер.ПодготовитьОбъектыИЗначенияСвойствОбъектовДляЗаписи(ПараметрыЗаписиXML, МассивОбъектов);
	РаботаСXMLКлиентСервер.ЗаписатьСодержимое(ПараметрыЗаписиXML);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ТекстВыгрузки = ЗаписьXML.Закрыть();
	
	Возврат ТекстВыгрузки;
	
КонецФункции

&НаКлиенте
Процедура Загрузить(Команда)
	ЧтениеТекста = Новый ЧтениеТекста;
	ЧтениеТекста.Открыть(ПутьКФайлу);
	Текст = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	ЗагрузитьНаСервере(Текст);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьНаСервере(Текст)
	Перем вмс_ОбновлениеИнформационнойБазы;
	вмс_ОбновлениеИнформационнойБазы = ПолучитьОбщийМодульНаСервере("ОбновлениеИнформационнойБазы");
	вмс_ОбновлениеИнформационнойБазы.ЗагрузитьПредопределенныеОбъектыИБИзДанныхXML(Текст);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСсылкиНаОбъекты(ОбъектыМетаданных)
	
	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = ПолучитьОбщийМодульНаСервере("РаботаСКоллекциями");
	
	МассивОбъектовМетаданных = РаботаСКоллекциями.ЗначениеВМассив(ОбъектыМетаданных);
	
	ТекстШаблон =
	"ВЫБРАТЬ
	|	ТаблицаИБ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК ТаблицаИБ";
	
	ТекстЗапросаМассив = Новый Массив;
	
	Для Каждого ОбъектМетаданных Из МассивОбъектовМетаданных Цикл
		ТекстОбъекта = ТекстШаблон;
		ТекстОбъекта = СтрЗаменить(ТекстОбъекта, "Справочник.Номенклатура", ОбъектМетаданных);
		ТекстЗапросаМассив.Добавить(ТекстОбъекта);
	КонецЦикла;
	
	ТекстЗапроса = РаботаСКоллекциями.МассивВСтроку(ТекстЗапросаМассив, Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС + Символы.ПС);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаСсылок = РезультатЗапроса.Выгрузить();
	МассивСсылокНаОбъекты = ТаблицаСсылок.ВыгрузитьКолонку("Ссылка");
	Возврат МассивСсылокНаОбъекты;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Переменные = Новый Структура;
	Переменные.Вставить("ФормаВыбораОбъектов");
	Переменные.Вставить("ВыбранныеОбъекты", Новый Массив);
	СформироватьПредставлениеВыбранныхОбъектов();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОбщийМодульНаСервере(ИмяМодуля)
	
	Попытка
		Возврат Вычислить("вмс_" + ИмяМодуля);
	Исключение
	КонецПопытки;

	Попытка
		Возврат Вычислить(ИмяМодуля);
	Исключение
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ПолучитьОбщийМодуль(ИмяМодуля)
	
	Попытка
		Возврат Вычислить("вмс_" + ИмяМодуля);
	Исключение
	КонецПопытки;
	
	Попытка
		Возврат Вычислить(ИмяМодуля);
	Исключение
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ПерекрутитьМакеты(Команда)
	Каталог = Неопределено;

	ПолучитьВыбранныйКаталог(Новый ОписаниеОповещения("ПерекрутитьМакетыЗавершение", ЭтаФорма));
КонецПроцедуры

&НаКлиенте
Процедура ПерекрутитьМакетыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Каталог = Результат;
	Если Каталог = Неопределено Тогда
		ПоказатьПредупреждение(, "Неверный путь!");
		Возврат;
	КонецЕсли;
	ДанныеФайлов = ПерекрутитьМакетыНаСервере();
	ЗаписатьДанныеФайловВКаталог(Каталог, ДанныеФайлов);

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВыбранныйКаталог(Знач Оповещение)
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Каталог = ПутьКФайлу;
	Файл = Новый Файл(Каталог);
	Файл.НачатьПроверкуЭтоКаталог(Новый ОписаниеОповещения("ПолучитьВыбранныйКаталогЗавершение", ЭтаФорма, Новый Структура("Каталог, Оповещение, Файл", Каталог, Оповещение, Файл)));
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВыбранныйКаталогЗавершение(ЭтоКаталог, ДополнительныеПараметры) Экспорт
	
	Каталог = ДополнительныеПараметры.Каталог;
	Оповещение = ДополнительныеПараметры.Оповещение;
	Файл = ДополнительныеПараметры.Файл;
	Если ЭтоКаталог Тогда
		ВыполнитьОбработкуОповещения(Оповещение, Каталог);
		Возврат;
	КонецЕсли;
	
	ПутьКФайлуМассив = вмс_РаботаСКоллекциями.СтрокуВМассив(ПутьКФайлу, "\");
	ПутьКФайлуМассив.Удалить(ПутьКФайлуМассив.ВГраница());
	Каталог = вмс_РаботаСКоллекциями.МассивВСтроку(ПутьКФайлуМассив);
	
	Файл = Новый Файл(Каталог);
	Файл.НачатьПроверкуЭтоКаталог(Новый ОписаниеОповещения("ПолучитьВыбранныйКаталогЗавершениеЗавершение", ЭтаФорма, Новый Структура("Каталог, Оповещение", Каталог, Оповещение)));

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВыбранныйКаталогЗавершениеЗавершение(ЭтоКаталог1, ДополнительныеПараметры1) Экспорт
	
	Каталог = ДополнительныеПараметры1.Каталог;
	Оповещение = ДополнительныеПараметры1.Оповещение;
	
	
	Если ЭтоКаталог1 Тогда
		ВыполнитьОбработкуОповещения(Оповещение, Каталог);
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
	Возврат;

КонецПроцедуры

&НаКлиенте
Функция ЗаписатьДанныеФайловВКаталог(Каталог, ДанныеФайлов)
	
	Для каждого ДанныеФайла Из ДанныеФайлов Цикл
		ИмяФайла = Каталог + "\" + ДанныеФайла.Имя + ".xml";
		ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла);
		ЗаписьТекста.Записать(ДанныеФайла.Текст);
		ЗаписьТекста.Закрыть();
	КонецЦикла;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПерекрутитьМакетыНаСервере()
	ДанныеФайлов = Новый Массив;
	Объекты = вмс_ОбновлениеИнформационнойБазыWMS.ПолучитьОбъектыДляЗагрузкиПредопределенныхЭлементов();
	Для Каждого Объект Из Объекты Цикл
		Макет = вмс_ОбновлениеИнформационнойБазыWMS.ПолучитьМакетПредопределенныхЭлементовОбъекта(Объект);
		МассивЭлементов = ПрочитатьЭлементыВСтаромФормате(Макет);
		ТекстXML = ЗаписатьЭлементыВНовомФормате(МассивЭлементов);
		ИмяФайла = СтрЗаменить(Объект, ".", "_");
		ДанныеФайлов.Добавить(Новый Структура("Имя, Текст", ИмяФайла, ТекстXML));
	КонецЦикла;
	Возврат ДанныеФайлов;
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьЭлементыВСтаромФормате(ДвоичныеДанныеМакета)
	МассивЭлементов = Новый Массив;
	Текст = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьТекстИзДвоичныхДанных(ДвоичныеДанныеМакета);
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Текст);
	ЧтениеXML.Прочитать(); //заголовок
	ЧтениеXML.Прочитать(); //первый элемент
	Пока Истина Цикл
		Элемент = вмс_РаботаСXMLСервер.ПолучитьОбъектИзXML(ЧтениеXML);
		Если Элемент = Неопределено Тогда
			Прервать;
		КонецЕсли;
		МассивЭлементов.Добавить(Элемент);
	КонецЦикла;
	Возврат МассивЭлементов;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьЭлементыВНовомФормате(МассивЭлементов)
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьНачалоЭлемента("ВыгрузкаПредопределенныхЭлементов");
	вмс_РаботаСXMLКлиентСервер.ЗаписатьXMLУлучшенная(ЗаписьXML, МассивЭлементов);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ТекстXML = ЗаписьXML.Закрыть();
	Возврат ТекстXML;
КонецФункции

&НаКлиенте
Функция ВыгрузитьПредопределенные(Команда)
	ТекстВыгрузки = ВыгрузитьПредопределенныеНаСервере();
	ЗаписьТекста = Новый ЗаписьТекста;
	ЗаписьТекста.Открыть(ПутьКФайлу);
	ЗаписьТекста.ЗаписатьСтроку(ТекстВыгрузки);
	ЗаписьТекста.Закрыть();
КонецФункции

&НаСервере
Функция ВыгрузитьПредопределенныеНаСервере()
	Объекты = вмс_ОбновлениеИнформационнойБазыWMS.ПолучитьОбъектыДляЗагрузкиПредопределенныхЭлементов();
	МассивСсылокНаОбъекты = ПолучитьСсылкиНаОбъекты(Объекты);
	ТекстВыгрузки = ВыгрузитьОбъектыПоСсылкам(МассивСсылокНаОбъекты);
	Возврат ТекстВыгрузки;
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если Переменные.ФормаВыбораОбъектов = ИсточникВыбора Тогда
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
			Переменные.ВыбранныеОбъекты = ВыбранноеЗначение;
		Иначе
			Переменные.ВыбранныеОбъекты.Очистить();
		КонецЕсли;
		СформироватьПредставлениеВыбранныхОбъектов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеОбъектыПредставлениеНажатие(Элемент, СтандартнаяОбработка)
	Перем вмс_ОбщегоНазначенияКлиент;
	
	вмс_ОбщегоНазначенияКлиент = ПолучитьОбщийМодуль("ОбщегоНазначенияКлиент");
	
	СтандартнаяОбработка = Ложь;
	
	Если Переменные.ФормаВыбораОбъектов <> Неопределено Тогда
		Если Переменные.ФормаВыбораОбъектов.Открыта() Тогда
			Переменные.ФормаВыбораОбъектов.Активизировать();
		Иначе
			Переменные.ФормаВыбораОбъектов.Открыть();
		КонецЕсли;
	Иначе
		Переменные.ФормаВыбораОбъектов = вмс_ОбщегоНазначенияКлиент.ПоказатьВыборОбъектаМетаданных(, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция СформироватьПредставлениеВыбранныхОбъектов()
	
	ВыбранныеОбъектыПредставление = "Выбрано объектов: " + Переменные.ВыбранныеОбъекты.Количество();
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьИзМакета(Команда)
	
	СписокМакетов = ПолучитьСписокМакетовДляЗагрузки();
	
	ОО = Новый ОписаниеОповещения("ЗагрузитьИзМакетаПослеВыбораМакета", ЭтаФорма);
	СписокМакетов.ПоказатьВыборЭлемента(ОО, "Выберите макет");
	
	ЗагрузитьИзМакетаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзМакетаПослеВыбораМакета(ВыбранныйЭлементМакета, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлементМакета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяМакета = ВыбранныйЭлементМакета.Значение;
	
	вмс_ОбновлениеИнформационнойБазыВызовСервера.ЗагрузитьПредопределенныеОбъектыИБИзОбщегоМакета(ИмяМакета);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокМакетовДляЗагрузки()
	
	СписокМакетов = Новый СписокЗначений;
	
	Для Каждого МетаданныеМакета Из Метаданные.ОбщиеМакеты Цикл
		
		ИмяМакета = МетаданныеМакета.Имя;
		Если СтрНайти(ИмяМакета, "ПредопределенныеЭлементы") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СписокМакетов.Добавить(ИмяМакета, МетаданныеМакета.Синоним);
		
	КонецЦикла;
	
	Возврат СписокМакетов;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗагрузитьИзМакетаНаСервере()
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзТабличногоДокумента(Команда)
	
	ОткрытьФорму("Обработка.ВыгрузкаЗагрузкаXMLУлучшенная.Форма.ФормаЗагрузкиИзТабличногоДокумента");
	
КонецПроцедуры
