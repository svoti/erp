Функция ПриЗавершенииИнициализацииПолей() Экспорт
	
	ЗаполнитьПоляАнализаДанных();
	
КонецФункции

Функция ПоляАнализаДанных() Экспорт
	
	Возврат ?(ДанныеТранзакции.Активна, ДанныеТранзакции.ПоляАнализаДанных, ПараметрыМодуля.ПоляАнализаДанных);
	
КонецФункции

Функция ЗаполнитьПоляАнализаДанных() Экспорт
	
	ПоляМодуля = ПоляМодуля().Скопировать();
	ПоляМодуля.Сортировать("ПорядокВвода");
	
	ПоляАнализаДанных = ПоляАнализаДанных();
	
	ПоляАнализаДанных["ВведенныеДанныеПолей"]		= Новый Структура("Поля, ИмяРезультата", ПоляМодуля.НайтиСтроки(Новый Структура("Ввод", Истина)), "РезультатАнализаЗаполненияПолейДанныхВвода");
	ПоляАнализаДанных["ЗапланированныеДанныеПолей"]	= Новый Структура("Поля, ИмяРезультата", ПоляМодуля.НайтиСтроки(Новый Структура("План", Истина)), "РезультатАнализаЗаполненияПолейДанныхПлана");
	ПоляАнализаДанных["СобранныеДанныеПолей"]		= Новый Структура("Поля, ИмяРезультата", ПоляМодуля.НайтиСтроки(Новый Структура("Сборка", Истина)), "РезультатАнализаЗаполненияПолейДанныхСборки");
	ПоляАнализаДанных["ОбщиеДанныеПолей"]			= Новый Структура("Поля, ИмяРезультата", ПоляМодуля, "РезультатАнализаЗаполненияПолейОбщихДанных");
	
КонецФункции

