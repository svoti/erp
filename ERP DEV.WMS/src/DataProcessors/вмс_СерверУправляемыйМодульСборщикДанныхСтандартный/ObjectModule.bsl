#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Перем РК;
Перем ТипыПредставлений;
Перем ПустоеПолеОбработки;

Функция Инициализировать() Экспорт
	
	//укажем реализуемые методы
	ИменаРеализуемыхМетодов =
		"ВыполнитьДействие,
		|УстановитьПоля,
		|УстановитьСвойстваПолейПоУмолчанию,
		|УстановитьДоступныеПоля,
		|УстановитьДополнительныеПоля,
		|ПриЗавершенииИнициализацииПолей,
		|ИнициализироватьДанные,
		|ЕстьИзменениеДанных,
		|НачатьВводДанных,
		|НачатьВыборСледующегоПоля,
		|РазобратьВходящиеОбъекты,
		|УстановитьРабочиеСтраницы,
		|ВводДоступен,
		|НачатьТранзакциюСборщика,
		|ОбновитьДанныеТранзакцииОбработки,
		|ЗафиксироватьТранзакциюСборщика,
		|ПослеЗавершенияТранзакцииВвода,
		|ПослеЗавершенияВвода,
		|ВозобновитьВводДанных,
		|ОтменитьТранзакциюСборщика,
		|ЗакончитьТранзакциюСборщика,
		|СохранениеДанныхСборщика,
		|ОстановитьВводДанных,
		|ОтменитьВводДанных,
		|ЗаполнитьПринятыеДанныеПолей,
		|ЗаполнитьВведенныеДанныеПолей,
		|ЗаполнитьЗапланированныеДанныеПолей,
		|ЗаполнитьДанныеПолей,
		|ЗаполнитьОбщиеДанныеПолей,
		|ЗаполнитьОбщиеДанныеПолейДополнительно,
		|ЗаполнитьСобранныеДанныеПолей,
		|ЗаполнитьСобранныеДанныеПолейДополнительно,
		|ЗаполнитьПредставлениеДанныхПолей,
		|ЗаполнитьТаблицы,
		|ПроанализироватьЗаполнениеПолейДанных,
		|РезультатАнализаЗаполненияПолейДанных,
		|ОчиститьДанныеПолей,
		|СохранитьСостояниеОбработки,
		|ВосстановитьСостояниеОбработки,
		|ВыполнитьЗавершениеОперации";

	Интерфейс.УстановитьРеализациюМетодов(ИменаРеализуемыхМетодов, ЭтотОбъект);
	
	//инициализируем этапы ввода данных
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_НачалоВвода", "НачалоВвода");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанных", "ОбработкаВходящихДанных");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанныхПолей", "ОбработкаВходящихДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ЗаполнениеВведенныхДанныхПолей", "ЗаполнениеВведенныхДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ЗаполнениеДанныхПолей", "ЗаполнениеДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ПроверитьОтклонениеОтПлана", "ПроверитьОтклонениеОтПлана", "ЗаполнениеДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ПроверкаСобранныхДанных", "ПроверкаСобранныхДанных");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_ЗавершениеВводаДанныхПолей", "ЗавершениеВводаДанныхПолей");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_СохранениеДанных", "СохранениеДанных");
	ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_КонецВвода", "КонецВвода");
	
	ТипыПредставлений = Новый Соответствие;
	ТипыПредставлений[Тип("Неопределено")] = Истина;
	ТипыПредставлений[Тип("Null")] = Истина;
	ТипыПредставлений[Тип("Строка")] = Истина;
	ТипыПредставлений[Тип("Число")] = Истина;
	ТипыПредставлений[Тип("Дата")] = Истина;
	ТипыПредставлений[Тип("Булево")] = Истина;
	ТипыПредставлений[Тип("УникальныйИдентификатор")] = Истина;
	ТипыПредставлений[Тип("ФорматированнаяСтрока")] = Истина;
	
	ПараметрыМодуля.Вставить("ТипыПредставлений", ТипыПредставлений);
	ПараметрыМодуля.Вставить("ЗависимостиПолей", Новый Массив);
	ПараметрыМодуля.Вставить("ПоляАнализаДанных", Новый Соответствие);
	
	ПустоеПолеОбработки = ПараметрыОбработки.ПустоеПолеОбработки;
	
КонецФункции

