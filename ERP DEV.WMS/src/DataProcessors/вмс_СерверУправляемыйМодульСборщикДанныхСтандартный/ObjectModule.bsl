#Область ЭтапыВвода

Функция ОбработчикЭтапаВводаДанных_НачалоВвода(Параметры, ДополнительныеПараметры) Экспорт
	
	ДанныеТранзакции.ПринятыеДанныеПолей.Очистить();
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанных(Параметры, ДополнительныеПараметры) Экспорт
	
	Если НЕ Интерфейс.ВводДоступен() Тогда
		Возврат Ложь;
	КонецЕсли;

	ВходящиеДанные = ДанныеТранзакции.ВходящиеДанные;
	ДанныеШтрихкода = ВходящиеДанные.ДанныеШтрихкода;
	Если ДанныеШтрихкода.Обработан Тогда
		ВходящиеОбъекты = РК.ВыгрузитьЗначенияКолонкиКоллекции(ДанныеШтрихкода.Результат.НайденныеОбъекты, "Объект");
		РК.УстановитьЭлементыКоллекции(ВходящиеДанные.ВходящиеОбъекты, ВходящиеОбъекты);
	КонецЕсли;
	
	Интерфейс.РазобратьВходящиеОбъекты(ВходящиеДанные); 
	Возврат Истина;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ОбработкаВходящихДанныхПолей(Параметры, ДополнительныеПараметры) Экспорт
	
	Если ЗаполнитьПринятыеДанныеПолей(ДанныеТранзакции.ВходящиеДанные).Количество()=0 Тогда
		//нет полей для ввода
		Интерфейс.ЗакончитьТранзакциюСборщика();
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ЗаполнениеВведенныхДанныхПолей(Параметры, ДополнительныеПараметры) Экспорт

	Интерфейс.ЗаполнитьВведенныеДанныеПолей(ДанныеТранзакции.ПринятыеДанныеПолей);
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ЗаполнениеДанныхПолей(Параметры, ДополнительныеПараметры) Экспорт

	Интерфейс.ЗаполнитьДанныеПолей();
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ПроверитьОтклонениеОтПлана(Параметры, ДополнительныеПараметры) Экспорт

	СписокВходящихПолейМассив = РК.ВыгрузитьЗначенияКолонкиКоллекции(ДанныеТранзакции.ВходящиеДанные.ДанныеПолей, "Ключ");
	СписокПолейПланФактаМассив = СписокПолейМодуля(Новый Структура("План, Ввод", Истина, Истина));
	СписокВходящихПолейПланФактаМассив = РК.ПересечениеМассивов(СписокПолейПланФактаМассив, СписокВходящихПолейМассив);
	Если СписокВходящихПолейПланФактаМассив.Количество()=0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЗапланированныеДанныеПолей = ДанныеТранзакции.ЗапланированныеДанныеПолей;
	ЗаполненныеПоляПланаМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхПлана.ЗаполненныеПоляМассив;
	
	ПолеНайдено = Ложь;
	Для Каждого ИмяПоля Из СписокВходящихПолейПланФактаМассив Цикл
		Если ЗаполненныеПоляПланаМассив.Найти(ИмяПоля)=Неопределено Тогда
			//нет плана по этому полю
			Продолжить;
		КонецЕсли;
		
		Если ЗапланированныеДанныеПолей[ИмяПоля]=ДанныеТранзакции.ОбщиеДанныеПолей[ИмяПоля] Тогда
			//нет расхождений с планом по этому полю
			Продолжить;
		КонецЕсли;
		
		Если ДанныеМодуля.ОбщиеДанныеПолей[ИмяПоля]=ДанныеТранзакции.ОбщиеДанныеПолей[ИмяПоля] Тогда
			//нет изменений по этому полю
			Продолжить;
		КонецЕсли;
		
		ПолеНайдено = Истина;
		Прервать;
	КонецЦикла;
	
	Если НЕ ПолеНайдено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЗначениеФакта = ДанныеТранзакции.ОбщиеДанныеПолей[ИмяПоля];
	ЗначениеПлана = ЗапланированныеДанныеПолей[ИмяПоля];
	Если НЕ ЗначениеЗаполнено(ЗначениеФакта) Тогда
		ЗначениеФакта = "<пусто>";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ЗначениеПлана) Тогда
		ЗначениеПлана = "<пусто>";
	КонецЕсли;
	
	Поле = ПолеМодуля(ИмяПоля);
	ТекстСообщения = Поле.Синоним + " """ + ЗначениеФакта + """ не соответствует плану.";
	ТекстСообщения = ТекстСообщения + " Ожидается """ + ЗначениеПлана + """.";
	
	Если ПараметрыМодуля.РазрешитьВводДанныхБезПлана Тогда
		Интерфейс.ОстановитьВводДанных();
		ОО = НовыйОписаниеОповещения("ОбработчикВопросаПриВводеДанных");
		ПоказатьДиалогНаКлиенте(ОО, ТекстСообщения + " Продолжить?", "ОКОтмена", , , , "Ошибка");
	Иначе
		Интерфейс.ОтменитьВводДанных();
		ПоказатьДиалогНаКлиенте(, ТекстСообщения, , , , , "Ошибка");
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

