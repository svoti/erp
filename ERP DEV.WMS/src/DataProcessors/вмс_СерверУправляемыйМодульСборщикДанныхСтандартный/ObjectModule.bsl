Функция ЗаполнитьПринятыеДанныеПолей(ВходящиеДанные) Экспорт

	ПринятыеДанныеПолей = ДанныеТранзакции.ПринятыеДанныеПолей;
	
	Для Каждого ВходящееПоле Из ВходящиеДанные.ДанныеПолей Цикл
		
		ИмяПоля = ВходящееПоле.Ключ;
		
		Поле = ПолеМодуля(ИмяПоля);
		Если НЕ (Поле <> ПустоеПолеОбработки И Поле.Ввод) Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = ВходящееПоле.Значение;
		Если ТипЗнч(Поле.ТипЗначения)=Тип("ОписаниеТипов") Тогда
			Значение = Поле.ТипЗначения.ПривестиЗначение(Значение);
		КонецЕсли;
		
		ПринятыеДанныеПолей.Вставить(ИмяПоля, Значение);
		
	КонецЦикла;
	
	Возврат ПринятыеДанныеПолей;
	
КонецФункции

Функция ЗаполнитьВведенныеДанныеПолей(ПринятыеДанныеПолей) Экспорт
	
	ВведенныеДанныеПолей = ДанныеТранзакции.ВведенныеДанныеПолей;
	
	ЗаполнитьЗначенияСвойств(ВведенныеДанныеПолей, ПринятыеДанныеПолей);
	
	Интерфейс.ПроанализироватьЗаполнениеПолейДанных("ВведенныеДанныеПолей");
	
	Возврат ВведенныеДанныеПолей;
	
КонецФункции

Функция ЗаполнитьЗапланированныеДанныеПолей() Экспорт
	
	Результат = Обработки.вмс_СерверУправляемыйМодульСтандартный.ПолучитьТаблицыВычисленийЗначенийПолей(ПараметрыМодуля);
	ТаблицаВычисленийЗначенийПолей = Результат.ТаблицаВычисленийЗначенийПолей;
	ТаблицаВычисляемыхПолей = Результат.ТаблицаВычисляемыхПолей;
	
	ЗапланированныеДанныеПолей = ДанныеТранзакции.ЗапланированныеДанныеПолей;
	ОбщиеДанныеПолей = ДанныеТранзакции.ОбщиеДанныеПолей;
	
	ТаблицаРаундов = ТаблицаВычисленийЗначенийПолей.Скопировать();
	ТаблицаРаундов.Свернуть("Раунд");
	
	Для Каждого ЭлементРаунда Из ТаблицаРаундов Цикл
		
		Раунд = ЭлементРаунда.Раунд;
		ТаблицаВычисленийЗначенийПолейРаунда = ТаблицаВычисленийЗначенийПолей.Скопировать(Новый Структура("Раунд", Раунд));
		ТаблицаВычисленийЗначенийПолейРаунда.Сортировать("ПолноеИмя");
		
		ТаблицаВычисляемыхПолейРаунда = ТаблицаВычисляемыхПолей.Скопировать(Новый Структура("Раунд", Раунд));
		
		ЗаполненныеПоляЗапланированныхДанныхМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхПлана.ЗаполненныеПоляМассив;
		НеЗаполненныеПоляЗапланированныхДанныхМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхПлана.НеЗаполненныеПоляМассив;
		ЗаполненныеПоляОбщихДанныхМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейОбщихДанных.ЗаполненныеПоляМассив;
		НеЗаполненныеПоляОбщихДанныхМассив = ДанныеТранзакции.РезультатАнализаЗаполненияПолейОбщихДанных.НеЗаполненныеПоляМассив;
		
		Для Каждого ЭлементВычисленияЗначения Из ТаблицаВычисленийЗначенийПолейРаунда Цикл
			
			Если ЭлементВычисленияЗначения.ЗначениеРассчитано Тогда
				Продолжить;
			ИначеЕсли СтандартныйМодуль.ИсточникДанныхДляЗаполненияПолей(ЭлементВычисленияЗначения.ПолноеИмя) <> Неопределено Тогда
				Значение = СтандартныйМодуль.ДанныеИсточникаДляЗаполненияПолей(ЭлементВычисленияЗначения.ПолноеИмя);
			Иначе
				ЭлементВычисленияРодительМассив = ТаблицаВычисленийЗначенийПолейРаунда.НайтиСтроки(Новый Структура("ПолноеИмя", ЭлементВычисленияЗначения.Путь));
				Если ЭлементВычисленияРодительМассив.Количество() > 0 Тогда
					ЭлементВычисленияРодитель = ЭлементВычисленияРодительМассив[0];
					Если НЕ ЭлементВычисленияРодитель.ЗначениеРассчитано Тогда
						ВызватьИсключение "значение не рассчитано """ + ЭлементВычисленияРодитель.ПолноеИмя + """";
					КонецЕсли;
					ЗначениеРодителя = ЭлементВычисленияРодитель.Значение;
				Иначе
					ЗначениеРодителя = ОбщиеДанныеПолей;
				КонецЕсли;
				
				Если ЗначениеРодителя=Неопределено Тогда
					Значение = Неопределено;
				Иначе
					Значение = ЗначениеРодителя[ЭлементВычисленияЗначения.Имя];
				КонецЕсли;
			КонецЕсли;
			
			Попытка
				//если это табличная часть
				Таблица = Значение.Выгрузить();
				Значение = Таблица;
			Исключение
			КонецПопытки;
			
			Если ТипЗнч(Значение)=Тип("ТаблицаЗначений") Тогда
				//поищем элемент таблицы по заполненным полям
				Таблица = Значение;
				ЭлементыВычисленийЗначенийКолонокТаблицы = ТаблицаВычисленийЗначенийПолейРаунда.НайтиСтроки(Новый Структура("Путь", ЭлементВычисленияЗначения.ПолноеИмя));
				ОтборЭлементаТаблицы = Новый Структура;
				Для Каждого ЭлементВычисленияЗначенияКолонкиТаблицы Из ЭлементыВычисленийЗначенийКолонокТаблицы Цикл
					ПолеРаундаМассив = ТаблицаВычисляемыхПолейРаунда.НайтиСтроки(Новый Структура("ПутьКДанным", ЭлементВычисленияЗначенияКолонкиТаблицы.ПолноеИмя));
					Для Каждого ПолеРаунда Из ПолеРаундаМассив Цикл
						Если ПолеРаунда.Поиск И ПолеРаунда.План И ЗаполненныеПоляОбщихДанныхМассив.Найти(ПолеРаунда.ИмяПоля) <> Неопределено Тогда
							ОтборЭлементаТаблицы.Вставить(ЭлементВычисленияЗначенияКолонкиТаблицы.Имя, ОбщиеДанныеПолей[ПолеРаунда.ИмяПоля]);
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				
				Если ОтборЭлементаТаблицы.Количество()=0 Тогда
					НайденныеЭлементыТаблицы = Новый Массив;
					Если Таблица.Количество() > 0 Тогда
						НайденныеЭлементыТаблицы.Добавить(Таблица[0]);
					КонецЕсли;
				Иначе
					НайденныеЭлементыТаблицы = Таблица.НайтиСтроки(ОтборЭлементаТаблицы);
				КонецЕсли;
				
				Если НайденныеЭлементыТаблицы.Количество()=0 Тогда
					//не найдено подходящих элементов таблицы, возьмем значение из существующего поля
					УдалениеЭлементовВычислений = Новый Массив;
					Для Каждого ЭлементВычисленияКолонки Из ЭлементыВычисленийЗначенийКолонокТаблицы Цикл
						ПолеРаундаМассив = ТаблицаВычисляемыхПолейРаунда.НайтиСтроки(Новый Структура("ПутьКДанным", ЭлементВычисленияКолонки.ПолноеИмя));
						Если ПолеРаундаМассив.Количество() > 0 Тогда
							ПолеРаунда = ПолеРаундаМассив[0];
							ЭлементВычисленияКолонки.Значение = ОбщиеДанныеПолей[ПолеРаунда.ИмяПоля];
							ЭлементВычисленияКолонки.ЗначениеРассчитано = Истина;
						Иначе
							УдалениеЭлементовВычислений.Добавить(ЭлементВычисленияКолонки);
						КонецЕсли;
					КонецЦикла;

					//удалим связанные с таблицей расчеты иерархически
					Для Каждого ЭлементВычисления Из УдалениеЭлементовВычислений Цикл
						РК.ДобавитьЭлементыКоллекции(УдалениеЭлементовВычислений, ТаблицаВычисленийЗначенийПолейРаунда.НайтиСтроки(Новый Структура("Путь", ЭлементВычисления.ПолноеИмя)));
						ТаблицаВычисленийЗначенийПолейРаунда.Удалить(ЭлементВычисления);
					КонецЦикла;
					
					Значение = Неопределено;
				Иначе
					Значение = НайденныеЭлементыТаблицы[0];
					ЭлементВычисленияЗначения.ЗначениеРассчитано = Истина;
				КонецЕсли;
			Иначе
				ЭлементВычисленияЗначения.ЗначениеРассчитано = Истина;
			КонецЕсли;

			ЭлементВычисленияЗначения.Значение = Значение;
			
			//заполним связанные незаполненные поля данных
			ВычисляемыеПоля = ТаблицаВычисляемыхПолейРаунда.НайтиСтроки(Новый Структура("ПутьКДанным", ЭлементВычисленияЗначения.ПолноеИмя));
			Для Каждого ВычисляемоеПоле Из ВычисляемыеПоля Цикл
				Если ВычисляемоеПоле.План И ЗаполненныеПоляЗапланированныхДанныхМассив.Найти(ВычисляемоеПоле.ИмяПоля)=Неопределено Тогда
					ЗапланированныеДанныеПолей[ВычисляемоеПоле.ИмяПоля] = Значение;
				КонецЕсли;

				Если ЗаполненныеПоляОбщихДанныхМассив.Найти(ВычисляемоеПоле.ИмяПоля)=Неопределено Тогда
					ОбщиеДанныеПолей[ВычисляемоеПоле.ИмяПоля] = Значение;
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;
		
		Интерфейс.ПроанализироватьЗаполнениеПолейДанных("ЗапланированныеДанныеПолей, ОбщиеДанныеПолей");
		
	КонецЦикла;
	
КонецФункции

Функция ЗаполнитьДанныеПолей() Экспорт
	Интерфейс.ОчиститьДанныеПолей(, "ЗапланированныеДанныеПолей, СобранныеДанныеПолей, ОбщиеДанныеПолей");
	Интерфейс.ЗаполнитьОбщиеДанныеПолей();
	Интерфейс.ЗаполнитьСобранныеДанныеПолей();
КонецФункции

Функция ЗаполнитьОбщиеДанныеПолей() Экспорт
	
	Для Каждого ИмяПоля Из СписокПолейВвода() Цикл
		ДанныеТранзакции.ОбщиеДанныеПолей[ИмяПоля] = ДанныеТранзакции.ВведенныеДанныеПолей[ИмяПоля];
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ДанныеТранзакции.ОбщиеДанныеПолей, ДанныеТранзакции.СтатическиеДанныеПолей);
	Интерфейс.ЗаполнитьОбщиеДанныеПолейДополнительно();
	Интерфейс.ПроанализироватьЗаполнениеПолейДанных("ОбщиеДанныеПолей");
	
	Интерфейс.ЗаполнитьЗапланированныеДанныеПолей();
	ЗаполнитьДанныеПолейПоУмолчанию();
	
КонецФункции

Функция ЗаполнитьОбщиеДанныеПолейДополнительно() Экспорт
КонецФункции

Функция ЗаполнитьСобранныеДанныеПолей() Экспорт
	
	ВведенныеДанныеПолей = ДанныеТранзакции.ВведенныеДанныеПолей;
	ОбщиеДанныеПолей = ДанныеТранзакции.ОбщиеДанныеПолей;
	СобранныеДанныеПолей = ДанныеТранзакции.СобранныеДанныеПолей;
	
	ПоляСборки = ПоляМодуля(Новый Структура("Сборка", Истина));
	Для Каждого ПолеСборки Из ПоляСборки Цикл
		
		ИмяПоля = ПолеСборки.Имя;
		Если ПолеСборки.Ввод И ПолеСборки.ОбязательныйВвод Тогда
			ЗначениеПоля = ВведенныеДанныеПолей[ИмяПоля];
		Иначе
			ЗначениеПоля = ОбщиеДанныеПолей[ИмяПоля];
		КонецЕсли;
		
		СобранныеДанныеПолей[ИмяПоля] = ЗначениеПоля;
		
	КонецЦикла;
	
	Интерфейс.ЗаполнитьСобранныеДанныеПолейДополнительно();
	
	Интерфейс.ПроанализироватьЗаполнениеПолейДанных("СобранныеДанныеПолей");
	
	Возврат СобранныеДанныеПолей;
	
КонецФункции

Функция ЗаполнитьСобранныеДанныеПолейДополнительно() Экспорт
КонецФункции

Функция ЗаполнитьДанныеПолейПоУмолчанию() Экспорт
	
	ДанныеПолейМассив = Новый Массив;
	ДанныеПолейМассив.Добавить(Новый Структура("Данные, Поля, РезультатАнализаЗаполненияПолейДанных", ДанныеТранзакции.ЗапланированныеДанныеПолей, ПоляМодуля(Новый Структура("План", Истина)), ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхПлана));
	ДанныеПолейМассив.Добавить(Новый Структура("Данные, Поля, РезультатАнализаЗаполненияПолейДанных", ДанныеТранзакции.ОбщиеДанныеПолей, ПоляМодуля(), ДанныеТранзакции.РезультатАнализаЗаполненияПолейОбщихДанных));
	
	Для Каждого ДанныеПолей Из ДанныеПолейМассив Цикл
		
		Данные = ДанныеПолей.Данные;
		Поля = ДанныеПолей.Поля;
		РезультатАнализаЗаполненияПолейДанных = ДанныеПолей.РезультатАнализаЗаполненияПолейДанных;
		
		ЗаполненныеПоляМассив = РезультатАнализаЗаполненияПолейДанных.ЗаполненныеПоляМассив;
	
		Для Каждого Поле Из Поля Цикл
			
			ИмяПоля = Поле.Имя;
			
			Если ЗаполненныеПоляМассив.Найти(ИмяПоля)=Неопределено Тогда
				Данные[ИмяПоля] = Поле.ЗначениеПоУмолчанию;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Интерфейс.ПроанализироватьЗаполнениеПолейДанных("ЗапланированныеДанныеПолей, ОбщиеДанныеПолей");
	
КонецФункции

Функция ЗаполнитьПредставлениеДанныхПолей() Экспорт
	
	ВведенныеДанныеПолей = ДанныеТранзакции.ВведенныеДанныеПолей;
	ЗапланированныеДанныеПолей = ДанныеТранзакции.ЗапланированныеДанныеПолей;
	СобранныеДанныеПолей = ДанныеТранзакции.СобранныеДанныеПолей;
	ОбщиеДанныеПолей = ДанныеТранзакции.ОбщиеДанныеПолей;
	ПредставлениеДанныхПолей = ДанныеТранзакции.ПредставлениеДанныхПолей;
	
	ЦветФонаОбычный = Новый Цвет(255, 255, 255);
	ЦветФонаПоляНеВведено = Новый Цвет(255, 255, 100);
	
	ШрифтРасхождения = Новый Шрифт(, , , , , Истина);
	
	ЭлементыВывода = ПараметрыОбработки.ЭлементыВывода;
	ОтборЭлементаВывода = Новый Структура("Имя");
	ТипЭлемента = Неопределено;
	СписокВыбора = Неопределено;
	
	Для Каждого Поле Из ПоляВывода() Цикл
		
		ИмяПоля = Поле.Имя;
		Если Поле.Сборка Тогда
			ЗначениеФакта = СобранныеДанныеПолей[ИмяПоля];
			ЗначениеФактаЗаполнено = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхСборки.ЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено;
			ЗначениеФактаНеЗаполнено = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхСборки.НеЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено;
		ИначеЕсли Поле.Ввод Тогда
			ЗначениеФакта = ВведенныеДанныеПолей[ИмяПоля];
			ЗначениеФактаЗаполнено = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.ЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено;
			ЗначениеФактаНеЗаполнено = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода.НеЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено;
		Иначе
			ЗначениеФакта = Неопределено;
			ЗначениеФактаЗаполнено = Ложь;
			ЗначениеФактаНеЗаполнено = Ложь;
		КонецЕсли;
		
		Если Поле.План Тогда
			ЗначениеПлана = ЗапланированныеДанныеПолей[ИмяПоля];
			ЗначениеПланаЗаполнено = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхПлана.ЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено;
			ЗначениеПланаНеЗаполнено = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхПлана.НеЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено;
		Иначе
			ЗначениеПлана = ОбщиеДанныеПолей[ИмяПоля];
			ЗначениеПланаЗаполнено = ДанныеТранзакции.РезультатАнализаЗаполненияПолейОбщихДанных.ЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено;
			ЗначениеПланаНеЗаполнено = ДанныеТранзакции.РезультатАнализаЗаполненияПолейОбщихДанных.НеЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено;
		КонецЕсли;
		
		ОтборЭлементаВывода.Имя = Поле.ИмяЭлементаВывода;
		ЭлементВыводаМассив = ЭлементыВывода.НайтиСтроки(ОтборЭлементаВывода);
		Если ЭлементВыводаМассив.Количество()=0 Тогда
			ЭлементВывода = СтандартныйМодуль.ПолучитьЭлементВывода(Поле.ИмяЭлементаВывода);
		Иначе
			ЭлементВывода = ЭлементВыводаМассив[0];
		КонецЕсли;
		
		Если ЭлементВывода.Новый Тогда
			СтандартныйМодуль.ИнициализироватьЭлементВыводаДляПоляОбработки(ЭлементВывода, Поле);
		КонецЕсли;

		ЭлементВывода.Свойства.Свойство("ТипЭлемента", ТипЭлемента);
		
		ЦветФона = ЦветФонаОбычный;
		МассивСтрокПредставления = Новый Массив;
		
		Если ЗначениеПланаЗаполнено Тогда
			Если ЗначениеЗаполнено(ЗначениеПлана) Тогда
				ПредставлениеЗначенияПлана = Строка(ЗначениеПлана);
			Иначе
				ПредставлениеЗначенияПлана = "<пусто>";
			КонецЕсли;
			
			Если НЕ ЗначениеФактаЗаполнено Тогда
				Если ЗначениеФактаНеЗаполнено Тогда
					ЦветФона = ЦветФонаПоляНеВведено;
				КонецЕсли;
				МассивСтрокПредставления.Добавить(Новый ФорматированнаяСтрока(ПредставлениеЗначенияПлана, , , ЦветФона));
			ИначеЕсли ЗначениеПлана <> ЗначениеФакта Тогда
				МассивСтрокПредставления.Добавить(Новый ФорматированнаяСтрока(ПредставлениеЗначенияПлана, ШрифтРасхождения, , ));
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеФактаЗаполнено Тогда
			
			Если ЗначениеЗаполнено(ЗначениеФакта) Тогда
				ПредставлениеЗначенияФакта = Строка(ЗначениеФакта);
			Иначе
				ПредставлениеЗначенияФакта = "<пусто>";
			КонецЕсли;

			Если МассивСтрокПредставления.Количество() > 0 Тогда
				МассивСтрокПредставления.Добавить(" ");
			КонецЕсли;
			
			МассивСтрокПредставления.Добавить(ПредставлениеЗначенияФакта);
			
		ИначеЕсли НЕ ЗначениеПланаЗаполнено Тогда

			Если ЗначениеФактаНеЗаполнено Тогда
				Если Поле.Пол="Мужской" Тогда
					ТекстНеЗаполнено = "не заполнен";
				ИначеЕсли Поле.Пол="Женский" Тогда
					ТекстНеЗаполнено = "не заполнена";
				Иначе
					ТекстНеЗаполнено = "не заполнено";
				КонецЕсли;
				
				ЦветФона = ЦветФонаПоляНеВведено;
				МассивСтрокПредставления.Добавить(Новый ФорматированнаяСтрока("<" + ТекстНеЗаполнено + ">", , , ЦветФона));
			Иначе
				МассивСтрокПредставления.Добавить("<пусто>");
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипЗнч(Поле.ТипЗначения)=Тип("ОписаниеТипов") И Поле.ТипЗначения.Типы().Количество()=1 Тогда
			Тип = Поле.ТипЗначения.Типы()[0];
		Иначе
			Тип = Неопределено;
		КонецЕсли;
		
		Если ЭлементВывода.Свойства.Свойство("СписокВыбора", СписокВыбора) И СписокВыбора <> Неопределено Тогда
			Значение = ОбщиеДанныеПолей[ИмяПоля];
			ЭлементСписка = СписокВыбора.НайтиПоЗначению(Значение);
			Если ЭлементСписка <> Неопределено Тогда
				Значение = ЭлементСписка.ПолучитьИдентификатор() + 1;
			Иначе
				Значение = 0;
			КонецЕсли;
			ПредставлениеДанныхПолей[ИмяПоля] = Значение;
		ИначеЕсли ТипЭлемента="ПолеВвода" И ТипыПредставлений[Тип]=Истина ИЛИ ТипЭлемента="ПолеФлажка" Тогда
			ПредставлениеДанныхПолей[ИмяПоля] = ОбщиеДанныеПолей[ИмяПоля];
		Иначе
			ПредставлениеДанныхПолей[ИмяПоля] = Новый ФорматированнаяСтрока(МассивСтрокПредставления);
		КонецЕсли;

		Если ТипЭлемента="ПолеВвода" ИЛИ ТипЭлемента="ПолеФлажка" Тогда
			ЭлементВывода.Свойства.Вставить("ЦветФона", ЦветФона);
			ЭлементВывода.СвойстваПередать.Вставить("ЦветФона", ЦветФона);
			ЭлементВывода.Обновить = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПредставлениеДанныхПолей;
	
КонецФункции

Функция ЗаполнитьТаблицы() Экспорт
	
	//
	
КонецФункции

Функция НачатьТранзакциюСборщика() Экспорт
	
	Если ДанныеТранзакции.Активна Тогда
		//отмена предыдущей транзакции
		//возможно не завершилась из-за критической ошибки выполнения кода
		ОтменитьТранзакциюСборщика();
	КонецЕсли;
	
	ДанныеТранзакции.НомерЭтапа = 0;
	
	//добавим текущие данные модуля в транзакцию
	Обработки.вмс_СерверУправляемыйМодульСтандартный.НачатьТранзакциюОбработки(ПараметрыМодуля);
	ДанныеТранзакции.Вставить("ПоляАнализаДанных", РК.СкопироватьОбъект(ПараметрыМодуля.ПоляАнализаДанных));
	
	//добавим общие данные обработки в транзакцию
	ДанныеТранзакцииОбработки = ПараметрыОбработки.ДанныеТранзакции;
	ДанныеТранзакции.ПринятыеДанныеПолей.Очистить();
	ДанныеТранзакции.ВходящиеДанные = ДанныеТранзакцииОбработки.ВходящиеДанные;
	ЗаполнитьЗначенияСвойств(ДанныеТранзакции.ВведенныеДанныеПолей, ДанныеТранзакцииОбработки.ВведенныеДанныеПолей);
	СкопироватьСтатическиеДанныеПолейТранзакции(ПараметрыОбработки, ПараметрыМодуля);
	ЗаполнитьЗначенияСвойств(ДанныеТранзакции.ЗапланированныеДанныеПолей, ДанныеТранзакцииОбработки.ЗапланированныеДанныеПолей);
	ЗаполнитьЗначенияСвойств(ДанныеТранзакции.СобранныеДанныеПолей, ДанныеТранзакцииОбработки.СобранныеДанныеПолей);
	СкопироватьОбщиеДанныеПолейТранзакции(ПараметрыОбработки, ПараметрыМодуля);
	ЗаполнитьЗначенияСвойств(ДанныеТранзакции.ПредставлениеДанныхПолей, ДанныеТранзакцииОбработки.ПредставлениеДанныхПолей);
	
	Интерфейс.ПроанализироватьЗаполнениеПолейДанных();
	
	Возврат Истина;
	
КонецФункции

Функция	СкопироватьСтатическиеДанныеПолейТранзакции(ПараметрыОбработкиИсточника, ПараметрыОбработкиПриемника)
	
	ПоляИсточника = ПараметрыОбработкиИсточника.ДанныеТранзакции.ПоляОбработки;
	ПоляПриемника = ПараметрыОбработкиПриемника.ДанныеТранзакции.ПоляОбработки;

	СтатическиеДанныеПолейИсточника = ПараметрыОбработкиИсточника.ДанныеТранзакции.СтатическиеДанныеПолей;
	СтатическиеДанныеПолейПриемника = ПараметрыОбработкиПриемника.ДанныеТранзакции.СтатическиеДанныеПолей;
	
	Для Каждого ПолеДанных Из СтатическиеДанныеПолейПриемника Цикл
		Если ПоляИсточника.НайтиСтроки(Новый Структура("Имя", ПолеДанных.Ключ)).Количество() > 0
			И НЕ СтатическиеДанныеПолейИсточника.Свойство(ПолеДанных.Ключ) Тогда
			СтатическиеДанныеПолейПриемника.Удалить(ПолеДанных.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПолеДанных Из СтатическиеДанныеПолейИсточника Цикл
		ПолеПриемникаМассив = ПоляПриемника.НайтиСтроки(Новый Структура("Имя", ПолеДанных.Ключ));
		Если ПолеПриемникаМассив.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеПриемника = ПолеПриемникаМассив[0];
		ПолеПриемника.Значение = ПолеДанных.Значение;
		ПолеПриемника.ЗначениеУстановлено = Истина;
		СтатическиеДанныеПолейПриемника.Вставить(ПолеДанных.Ключ, ПолеДанных.Значение);
	КонецЦикла;
	
КонецФункции

//добавим общие поля обработки в транзакцию сборщика, чтобы их можно было использовать как источник для заполнения
Функция	СкопироватьОбщиеДанныеПолейТранзакции(ПараметрыОбработкиИсточника, ПараметрыОбработкиПриемника)
	
	ОбщиеДанныеПолейИсточника = ПараметрыОбработкиИсточника.ДанныеТранзакции.ОбщиеДанныеПолей;
	ОбщиеДанныеПолейПриемника = ПараметрыОбработкиПриемника.ДанныеТранзакции.ОбщиеДанныеПолей;
	
	Для Каждого ПолеДанных Из ОбщиеДанныеПолейИсточника Цикл
		ОбщиеДанныеПолейПриемника.Вставить(ПолеДанных.Ключ, ПолеДанных.Значение);
	КонецЦикла;
	
КонецФункции

Функция ОстановитьВводДанных(ПропуститьЭтап) Экспорт

	Интерфейс.ОтменитьТранзакциюСборщика();
	
	СтандартныйМодуль.ОстановитьВводДанных(ПропуститьЭтап);
	
КонецФункции

Функция ОтменитьВводДанных() Экспорт

	Интерфейс.ОтменитьТранзакциюСборщика();
	
	СтандартныйМодуль.ОтменитьВводДанных();
	
КонецФункции

Функция ОтменитьТранзакциюСборщика() Экспорт
	
	Интерфейс.ЗакончитьТранзакциюСборщика();
	ДанныеТранзакции.Отменить = Истина;
	
КонецФункции

Функция ЗакончитьТранзакциюСборщика() Экспорт
	
	ДанныеТранзакции.Активна = Ложь;
	ДанныеТранзакции.Прервать = Истина;
	
КонецФункции

Функция ОбновитьДанныеТранзакцииОбработки() Экспорт
	
	Если ДанныеТранзакции.Отменить Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеТранзакцииОбработки = ПараметрыОбработки.ДанныеТранзакции;
	ДанныеТранзакцииОбработки.ВходящиеДанные = ДанныеТранзакции.ВходящиеДанные;
	Для Каждого ПринятоеПолеДанных Из ДанныеТранзакции.ПринятыеДанныеПолей Цикл
		ДанныеТранзакцииОбработки.ПринятыеДанныеПолей.Вставить(ПринятоеПолеДанных.Ключ, ПринятоеПолеДанных.Значение);
	КонецЦикла;

	ЗаполнитьЗначенияСвойств(ДанныеТранзакцииОбработки.ВведенныеДанныеПолей, ДанныеТранзакции.ВведенныеДанныеПолей);
	СкопироватьСтатическиеДанныеПолейТранзакции(ПараметрыМодуля, ПараметрыОбработки);
	ЗаполнитьЗначенияСвойств(ДанныеТранзакцииОбработки.ЗапланированныеДанныеПолей, ДанныеТранзакции.ЗапланированныеДанныеПолей);
	ЗаполнитьЗначенияСвойств(ДанныеТранзакцииОбработки.СобранныеДанныеПолей, ДанныеТранзакции.СобранныеДанныеПолей);
	ЗаполнитьЗначенияСвойств(ДанныеТранзакцииОбработки.ОбщиеДанныеПолей, ДанныеТранзакции.ОбщиеДанныеПолей);
	ЗаполнитьЗначенияСвойств(ДанныеТранзакцииОбработки.ПредставлениеДанныхПолей, ДанныеТранзакции.ПредставлениеДанныхПолей);
	
	Возврат Истина;
	
КонецФункции

Функция ЗафиксироватьТранзакциюСборщика() Экспорт
	
	Если ДанныеТранзакции.Отменить Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Обработки.вмс_СерверУправляемыйМодульСтандартный.ЗафиксироватьТранзакциюОбработки(ПараметрыМодуля);
	ПараметрыМодуля.ПоляАнализаДанных = ДанныеТранзакции.ПоляАнализаДанных;
	
	Возврат Истина;
	
КонецФункции

Функция ПослеЗавершенияТранзакцииВвода() Экспорт
	
	
КонецФункции

Функция ПослеЗавершенияВвода() Экспорт

	Если НЕ Интерфейс.ВводДоступен() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДанныеТранзакции.ПринятыеДанныеПолей.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачатьВыборСледующегоПоля();
	Возврат Истина;
	
КонецФункции

// 3.2.5
Функция ПроанализироватьЗаполнениеПолейДанных(знач ИмяДанных=Неопределено) Экспорт
	
	Если ИмяДанных=Неопределено Тогда
		ИмяДанных = "ВведенныеДанныеПолей, ЗапланированныеДанныеПолей, СобранныеДанныеПолей, ОбщиеДанныеПолей";
	КонецЕсли;
	
	АктивныеДанные = ?(ДанныеТранзакции.Активна, ДанныеТранзакции, ДанныеМодуля);
		
	ИмяДанныхМассив = РК.ЗначениеВМассив(ИмяДанных, , Ложь);
	
	МодульМетодаРезультатАнализаЗаполненияПолейДанных = Интерфейс.МодулиМетодов.РезультатАнализаЗаполненияПолейДанных;
	
	ПоляАнализаДанных = ПоляАнализаДанных();
	Для Каждого ИмяДанных Из ИмяДанныхМассив Цикл
		ЭлементПолейАнализаДанных = ПоляАнализаДанных[ИмяДанных];
		Если ЭлементПолейАнализаДанных=Неопределено Тогда
			ВызватьИсключение "Неизвестный вид данных полей """ + ИмяДанных + """";
		КонецЕсли;

		Данные = АктивныеДанные[ИмяДанных];
		РезультатАнализаЗаполненияПолейДанных = МодульМетодаРезультатАнализаЗаполненияПолейДанных.РезультатАнализаЗаполненияПолейДанных(ЭлементПолейАнализаДанных.Поля, Данные);
		АктивныеДанные.Вставить(ЭлементПолейАнализаДанных.ИмяРезультата, РезультатАнализаЗаполненияПолейДанных);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция РезультатАнализаЗаполненияПолейДанных(Поля, Данные) Экспорт

	Перем ЗначениеПоля;
	
	Результат = Обработки.вмс_СерверУправляемыйМодульСборщикДанных.НовыйРезультатАнализаЗаполненияПолейДанных();
	
	НеЗаполненныеПоляМассив = Результат.НеЗаполненныеПоляМассив;
	ЗаполненныеПоляМассив = Результат.ЗаполненныеПоляМассив;
	
	ОсновныеПоляЗаполнены = Истина;
	Для Каждого Поле Из Поля Цикл
		
		ИмяПоля = Поле.Имя;
		Если НЕ Данные.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			Продолжить;
		КонецЕсли;
		
		Заполнено = Поле.ПустыеЗначения.Найти(ЗначениеПоля)=Неопределено;
		
		Если Заполнено Тогда
			ЗаполненныеПоляМассив.Добавить(ИмяПоля);
		ИначеЕсли Поле.ОбязательноеЗаполнение Тогда
			НеЗаполненныеПоляМассив.Добавить(ИмяПоля);
			Если НЕ Поле.Ресурс Тогда
				ОсновныеПоляЗаполнены = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.ОсновныеПоляЗаполнены = ОсновныеПоляЗаполнены;
	
	Обработки.вмс_СерверУправляемыйМодульСборщикДанных.ФинализироватьРезультатАнализаЗаполненияПолейДанных(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ОчиститьДанныеПолей(знач Поля=Неопределено, знач ИмяДанных=Неопределено) Экспорт
	
	Если ИмяДанных=Неопределено Тогда
		ИмяДанных = "ВведенныеДанныеПолей, ЗапланированныеДанныеПолей, СобранныеДанныеПолей, ОбщиеДанныеПолей";
	КонецЕсли;

	ИмяДанныхМассив = РК.ЗначениеВМассив(ИмяДанных, , Ложь);
	Если ИмяДанныхМассив.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Обработки.вмс_СерверУправляемыйМодульСтандартный.ОчиститьДанныеПолей(ПараметрыМодуля, Поля, ИмяДанныхМассив);
	Интерфейс.ПроанализироватьЗаполнениеПолейДанных(ИмяДанныхМассив);
	Возврат Истина;
	
КонецФункции

Функция СохранитьСостояниеОбработки() Экспорт
	
	СостояниеМодуля.Вставить("ПоляОбработки", ПараметрыМодуля.ПоляОбработки);
	СостояниеМодуля.Вставить("ЭтапыВводаДанных", ПараметрыМодуля.ЭтапыВводаДанных)
	
