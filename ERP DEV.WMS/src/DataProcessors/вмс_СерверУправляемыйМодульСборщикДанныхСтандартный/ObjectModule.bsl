Функция ОбновитьЗависимостиПолей()
	
	ЗависимостиПолей = ПараметрыМодуля.ЗависимостиПолей;
	
	ИсточникиДанныхПолей = РК.ЗначениеВМассив("ДанныеВвода, ДанныеПлана, ОбщиеДанные, ДанныеСбора");
	
	ПутиКДаннымПолей = Обработки.вмс_СерверУправляемыйМодульСтандартный.ПрочитатьПутиКДаннымПолей(ПараметрыМодуля, "ПутьКДаннымЗаполнения");
	
	ЗависимостиПолей.Очистить();
	Для Каждого ПутьКДаннымПоля Из ПутиКДаннымПолей Цикл
		Если ПутьКДаннымПоля.ПутьКДанным="" Тогда
			Продолжить;
		КонецЕсли;
		
		ИсточникДанных = ПутьКДаннымПоля.ПутьРеквизита;
		Если ИсточникДанных="" Тогда
			ИсточникДанных = "ОбщиеДанные";
		КонецЕсли;
		
		Если ИсточникиДанныхПолей.Найти(ИсточникДанных)=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеЗависимости = ПутьКДаннымПоля.ИмяРеквизита;
		Если ЗависимостиПолей.Найти(ПолеЗависимости)=Неопределено Тогда
			ЗависимостиПолей.Добавить(ПолеЗависимости);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция НачатьВводДанных(знач ВходящиеДанные) Экспорт
	
	Для Каждого ЭтапВводаДанных Из ПараметрыМодуля.ЭтапыВводаДанных Цикл
		ЭтапВводаДанных.Пропускать = Ложь;
		ЭтапВводаДанных.Данные.Очистить();
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

Функция НачатьВыборСледующегоПоля() Экспорт
	
	ИмяПоля = СледующееПолеВвода();
	Если ИмяПоля=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПолеМодуля = ПолеМодуля(ИмяПоля);
	Если НЕ ПолеМодуля.АвтоНачалоВыбора Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбработчикСобытияПоля = Неопределено;
	ПолеМодуля.События.Свойство("НачалоВыбора", ОбработчикСобытияПоля);
	
	Если ОбработчикСобытияПоля=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	вмс_СерверУправляемыеОбработки.ВыполнитьОбработкуОповещенияПереопределенный(ОбработчикСобытияПоля);
	Возврат Истина;
	
КонецФункции

Функция СледующееПолеВвода()

	НеЗаполненныеПоляМассив = ДанныеМодуля.РезультатАнализаЗаполненияПолейДанныхВвода.НеЗаполненныеПоляМассив;
	
	Если НеЗаполненныеПоляМассив.Количество() > 0 Тогда
		
		СледующееПолеВвода = НеЗаполненныеПоляМассив[0];
		Возврат СледующееПолеВвода;
		
	КонецЕсли;
	
КонецФункции

Функция ВозобновитьВводДанных() Экспорт
	
	вмс_СерверУправляемыеОбработки.ВыполнитьДействиеПереопределяемый(Действие("ВозобновитьВводДанных"));
	
КонецФункции

