Функция ЕстьЗависимостиПолей(Поля) Экспорт
	
	Если ТипЗнч(Поля)=Тип("Структура") Тогда
		ПоляМассив = РК.ВыгрузитьЗначенияКолонкиКоллекции(Поля, "Ключ");
	Иначе
		ПоляМассив = РК.ЗначениеВМассив(Поля);
	КонецЕсли;
	
	ПоляЗависимости = РК.ПересечениеМассивов(ПоляМассив, ПараметрыМодуля.ЗависимостиПолей);
	
	Возврат ПоляЗависимости.Количество() > 0;
	
