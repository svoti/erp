Функция УстановитьПоля(знач ОбщиеПоля=Неопределено) Экспорт
	
	ОбщиеПоля = ПоляОбработки(ОбщиеПоля);

	//очистим данные полей
	УстановитьСвойстваПолейМодуля(, "Использование", Ложь);

	//установим значения свойств по умолчанию
	Интерфейс.УстановитьСвойстваПолейПоУмолчанию();
	
	//установим общие настройки полей
	Для Каждого ОбщееПоле Из ОбщиеПоля Цикл
		УстановитьСвойстваПолейМодуля(ОбщееПоле.Имя, ОбщееПоле);
	КонецЦикла;	
	УстановитьСвойстваПолейМодуля(, "Использование", Ложь);
	
	Интерфейс.УстановитьДоступныеПоля();
	УдалитьПоляМодуля(Новый Структура("Использование", Ложь)); //удалим недоступные поля
	
	СписокОбщихПолей = РК.ВыгрузитьЗначенияКолонкиКоллекции(ОбщиеПоля, "Имя");
	Для Каждого Поле Из ПоляМодуля() Цикл
		Если СписокОбщихПолей.Найти(Поле.Имя)=Неопределено Тогда
			УстановитьСвойстваПолейМодуля(Поле, "Использование", Ложь);
		КонецЕсли;
	КонецЦикла;
	Интерфейс.УстановитьДополнительныеПоля();
	УдалитьПоляМодуля(Новый Структура("Использование", Ложь)); //удалим неиспользуемые поля
	ПоляМодуля().Сортировать("ПорядокВвода");
	
	ОбновитьЗависимостиПолей();
	
	Интерфейс.ПриЗавершенииИнициализацииПолей();
	
	Интерфейс.ИнициализироватьДанные();
	
КонецФункции

