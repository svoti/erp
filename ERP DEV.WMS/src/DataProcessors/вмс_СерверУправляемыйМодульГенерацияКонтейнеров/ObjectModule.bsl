Перем РК;

Функция ВыполнитьДействие(Действие) Экспорт
	
	Код = Действие.Код;
	
	Если Код="Инициализировать" Тогда
		
		ДействиеИнициализировать(Действие);
		
	ИначеЕсли Код="ИнициализироватьПоляОбработки" Тогда
		
		ДействиеИнициализироватьПоляОбработки(Действие);
		
	ИначеЕсли Код="ПослеЗаполненияДанныхПолей" Тогда
		
		ДействиеПослеЗаполненияДанныхПолей(Действие);
		
	КонецЕсли;
	
КонецФункции

Функция ДействиеИнициализировать(Действие)
	
	Если ДействиеВыполняетсяПосле(Действие) Тогда
		//ТУ_Августинович ++ 06.05.2026
		// - Реализация записи документа основания и контрагента, если они есть (при генерации контейнеров через ТСД).
		
		НастройкаОператора = Неопределено;
		ДокументОснование  = Неопределено;
		Если ПараметрыОбработки.ИдентификаторРодителя <> 0 Тогда
			ПараметрыОбработкиРодителя = вмс_СерверУправляемыеОбработки.ПараметрыОбработки(ПараметрыОбработки.ИдентификаторРодителя);
			ПараметрыОбработкиРодителя.Свойство("НастройкаОператора", НастройкаОператора);
			ПараметрыОбработкиРодителя.Свойство("ДокументОснование",  ДокументОснование);
		КонецЕсли;
		
		ПараметрыОбработки.Вставить("НастройкаОператора", НастройкаОператора);
		ПараметрыОбработки.Вставить("ДокументОснование",  ДокументОснование);
		
		Попытка
			ПараметрыОбработки.Вставить("Контрагент", ДокументОснование.Контрагент);
		Исключение
			ПараметрыОбработки.Вставить("Контрагент", Неопределено);
		КонецПопытки;
		
		//ТУ_Августинович -- 06.05.2026
	КонецЕсли;
	
КонецФункции

Функция ДействиеИнициализироватьПоляОбработки(Действие)
	
	УстановитьСвойстваПолейОбработки("ТипКонтейнера", Новый Структура("Синоним, ТипЗначения, СписокВыбора", "Тип", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ТипыКонтейнеров"), СписокТиповКонтейнеров()));
	УстановитьСвойстваПолейОбработки("Количество", Новый Структура("Синоним, ТипЗначения", "Количество", Новый ОписаниеТипов("Число")));
	УстановитьСвойстваЭлементовВывода("Количество", Новый Структура("РастягиватьПоВертикали", Ложь));
	
	УстановитьПоляВводаОбработки("ТипКонтейнера, Количество");
	ДанныеОбработки.ВведенныеДанныеПолей.ТипКонтейнера = ПланыВидовХарактеристик.ТипыКонтейнеров.НайтиПоНаименованию("Коробка");
	ДанныеОбработки.ВведенныеДанныеПолей.Количество = 1;

	УстановитьПоляВыводаОбработки("ТипКонтейнера, Количество");
	СтандартныйМодуль.СгруппироватьЭлементыВывода("ТипКонтейнера, Количество");

	УстановитьТаблицуОбработки("ТаблицаКонтейнеров", "ПредставлениеКонтейнера, Контейнер", Истина, "ПредставлениеКонтейнера");
	УстановитьСвойстваЭлементовВывода("ТаблицаКонтейнеров", Новый Структура("ПоложениеКоманднойПанели", "Нет"));
	УстановитьСвойстваЭлементовВывода("ТаблицаКонтейнеровПредставлениеКонтейнера", Новый Структура("Заголовок", "Контейнеры"));

	УстановитьСвойстваЭлементовВывода("КнопкаПечать", Новый Структура("ТипЭлемента, Заголовок, Номер", "КнопкаФормы", "Печать", 2));
	УстановитьСвойстваЭлементовВывода("КнопкаСоздать", Новый Структура("ТипЭлемента, Заголовок, Номер", "КнопкаФормы", "Создать", 3));
	УстановитьОбработчикиСобытийЭлементовВывода("КнопкаПечать", Новый Структура("Нажатие", НовыйОписаниеОповещения("ОбработчикКнопкиПечатьЭтикетокКонтейнеров")));
	УстановитьОбработчикиСобытийЭлементовВывода("КнопкаСоздать", Новый Структура("Нажатие", НовыйОписаниеОповещения("ОбработчикКнопкиСоздатьКонтейнеры")));
	СтандартныйМодуль.СгруппироватьЭлементыВывода("КнопкаПечать, КнопкаСоздать");
	
	УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция ОбработчикКнопкиПечатьЭтикетокКонтейнеров(Результат, ДополнительныеПараметры) Экспорт
	
	Контейнеры = ДанныеОбработки.Таблицы.ТаблицаКонтейнеров.ВыгрузитьКолонку("Контейнер");
	Этикетка = вмс_Печать.СформироватьПечатнуюФормуКонтейнеров(Контейнеры);
	СтандартныйМодуль.НачатьПечать(Этикетка);
	
КонецФункции

Функция ОбработчикКнопкиСоздатьКонтейнеры(Результат, ДополнительныеПараметры) Экспорт
	
	ДанныеЗаполнения = Справочники.вмс_Контейнеры.НовыеПараметрыСозданияКонтейнеров();
	ДанныеЗаполнения.Количество = ДанныеОбработки.ВведенныеДанныеПолей.Количество;
	ДанныеЗаполнения.ТипКонтейнера = ДанныеОбработки.ВведенныеДанныеПолей.ТипКонтейнера;
	
	//ТУ_Августинович ++ 06.05.2026
	// - Реализация записи документа основания и контрагента, если они есть (при генерации контейнеров через ТСД).
	
	ДанныеЗаполнения.Контрагент	  = ПараметрыОбработки.Контрагент;
	ДанныеЗаполнения.Распоряжение = ПараметрыОбработки.ДокументОснование;
	
	//ДанныеЗаполнения.Контрагент = Контрагент;
	//Попытка
	//	//ДанныеЗаполнения.Распоряжение = КонтекстФормы.ДокументОснование;
	//Исключение
	//КонецПопытки;
	
	//ТУ_Августинович -- 06.05.2026
		
	МассивКонтейнеров = Справочники.вмс_Контейнеры.СоздатьКонтейнеры(ДанныеЗаполнения);
	ТаблицаКонтейнеров = ДанныеОбработки.Таблицы.ТаблицаКонтейнеров;
	Для Каждого Контейнер Из МассивКонтейнеров Цикл
		ЭлементКонтейнера = ТаблицаКонтейнеров.Добавить();
		ЭлементКонтейнера.Контейнер = Контейнер;
		ЭлементКонтейнера.ПредставлениеКонтейнера = "" + ТаблицаКонтейнеров.Количество() + ". " + Контейнер;
	КонецЦикла;
	
	ДанныеОбработки.ВведенныеДанныеПолей.Количество = 0;
	
	ЗаполнитьДанныеПолей();
	
КонецФункции

Функция ДействиеПослеЗаполненияДанныхПолей(Действие)
	
	ОбновитьЭлементыВывода();
	
КонецФункции

Функция ОбновитьЭлементыВывода()
	ВведенныеДанныеПолей = ДанныеОбработки.ВведенныеДанныеПолей;
	ДоступностьКнопкиСоздать = ЗначениеЗаполнено(ВведенныеДанныеПолей.ТипКонтейнера) И ЗначениеЗаполнено(ВведенныеДанныеПолей.Количество);
	УстановитьСвойстваЭлементовВывода("КнопкаСоздать", Новый Структура("Доступность", ДоступностьКнопкиСоздать));

	ДоступностьКнопкиПечать = ДанныеОбработки.Таблицы.ТаблицаКонтейнеров.Количество() > 0;
	УстановитьСвойстваЭлементовВывода("КнопкаПечать", Новый Структура("Доступность", ДоступностьКнопкиПечать));
КонецФункции

Функция СписокТиповКонтейнеров()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТипыКонтейнеров.Ссылка КАК Ссылка,
	|	ТипыКонтейнеров.Наименование КАК Наименование
	|ИЗ
	|	ПланВидовХарактеристик.ТипыКонтейнеров КАК ТипыКонтейнеров
	|ГДЕ
	|	НЕ ТипыКонтейнеров.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СписокТиповКонтейнеров = Новый СписокЗначений;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокТиповКонтейнеров.Добавить(Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокТиповКонтейнеров;
	
КонецФункции











