Функция НоваяПаллетаПродолжение(Дата,дПараметры) Экспорт 
	
	Если ЗначениеЗаполнено(Дата) Тогда 		
		ДатаПаллеты = Дата;	
	КонецЕсли;
	
КонецФункции


&НаКлиенте
Функция АнимацияТекущаяПаллета() Экспорт
	
	Если ЖирныйШрифт Тогда  		
		Элементы.Надписи.ТекущаяСтраница = Элементы.ОбычнаяНадпись;
		//Элементы.ТекущаяПаллета.Шрифт = Новый Шрифт(,,Ложь);
		ЖирныйШрифт = Ложь;
	Иначе   
		Элементы.Надписи.ТекущаяСтраница = Элементы.ЖирнаяНадпись;
		//Элементы.ТекущаяПаллета.Шрифт = Новый Шрифт(,,Истина);
		ЖирныйШрифт = Истина;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("АнимацияТекущаяПаллета",0.3,Истина);
  
КонецФункции // АнимацияТекущаяПаллета()

&НаКлиенте
Процедура ТаблицаТоваровПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) 
	
	Для каждого пСтрока Из ПараметрыПеретаскивания.Значение Цикл 
		
		Количество = Неопределено;
		Оповещение = Новый ОписаниеОповещения("ТаблицаТоваровПеретаскиваниеЗавершение",ЭтаФорма,Новый Структура("СтрокаПаллет",пСтрока));  
		
		ПараметрыОткрытия = Новый Структура("Номенклатура,Количество",);
		ЗаполнитьЗначенияСвойств(ПараметрыОткрытия,пСтрока);	
		ОткрытьФорму("Обработка.СборкаПаллетПоДокументу.Форма.ФормаВводаКоличества",ПараметрыОткрытия,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		//ПоказатьВводЗначения(Оповещение,пСтрока.Количество,"Сколько товара " + Символы.ПС + """" + пСтрока.Номенклатура + """ (" + пСтрока.Количество + ") убрать",Тип("Число")); 
		
	КонецЦикла; 

КонецПроцедуры   

&НаКлиенте
Функция ТаблицаТоваровПеретаскиваниеЗавершение(Результат,Параметры) Экспорт  
	
	пСтрока = Параметры.СтрокаПаллет; 
	
	Если Результат = Неопределено Тогда Возврат Неопределено КонецЕсли;
	
	КоличествоТовара = Результат.Количество;
	
	Если ЗначениеЗаполнено(КоличествоТовара) Тогда 
		
		Если пСтрока.Количество < КоличествоТовара Тогда
			ТаблицаПаллет.Удалить(пСтрока); 
			Возврат Неопределено;
		КонецЕсли;
		
		нСтр = ТаблицаТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,пСтрока);
		нСтр.Количество = КоличествоТовара;
		//нСтр.ДатаПаллеты = ДатаПаллеты;
		
		пСтрока.Количество = пСтрока.Количество - КоличествоТовара;
		Если пСтрока.Количество = 0 Тогда
			ТаблицаПаллет.Удалить(пСтрока);
		КонецЕсли;
		
	КонецЕсли; 
	
	СвернутьТаблицуТоваров();
	
КонецФункции // ТаблицаПаллетПеретаскиваниеЗавершение()

&НаКлиенте
Процедура СменитьПаллету(Команда)
	
	Если ПоследняяПаллета = 1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Пока использована только 1 паллета. Переключиться невозможно.";
		Сообщение.Сообщить();                                                           
		Возврат;
	КонецЕсли;
	
	СЗ = Новый СписокЗначений;
	Для Счетчик = 1 По ПоследняяПаллета Цикл 
		СЗ.Добавить(Счетчик,"Паллета №" + Счетчик);
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения("СменитьПаллетуЗавершение",ЭтаФорма);
	ПоказатьВыборИзСписка(Оповещение,СЗ);
	
КонецПроцедуры  

&НаКлиенте
Функция СменитьПаллетуЗавершение(ВыбранныйЭлемент,пПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ТекущаяПаллета = ВыбранныйЭлемент.Значение; 
		
		Оповещение = Новый ОписаниеОповещения("НоваяПаллетаПродолжение",ЭтотОбъект);
		ПоказатьВводДаты(Оповещение,ДатаПаллеты,"Укажите дату");
		
	КонецЕсли;
	
КонецФункции // СменитьПаллетуЗавершение()

&НаСервере
Функция ЗавершитьСборкуПаллетНаСервере(ТипПартии)  

	СтрокиПаллет = ТаблицаПаллет.Выгрузить();
	СтрокиПаллет.Свернуть("Паллета,ДатаПаллеты");  	
	МенеджерТары = Справочники.вмс_Контейнеры;
	МассивПартий = Новый Массив;
	
	
	ДокументДвижения = Документы.вмс_ОперацияПоЯчейкам.СоздатьДокумент();
	ДокументДвижения.Заполнить(Неопределено);
	ДокументДвижения.Дата = ТекущаяДата();  
	ДокументДвижения.Готов = Истина;
	ДокументДвижения.Ответственный = Пользователи.ТекущийПользователь();
	ДокументДвижения.Комментарий = "#Сборка тары"; 
	ДокументДвижения.ДокументОснование = Параметры.ПараметрКоманды;
	
	Для каждого СтрокаПаллеты Из СтрокиПаллет Цикл  
		
		пДата = Параметры.ПараметрКоманды.Дата;
		
		НоваяТара = Справочники.вмс_Контейнеры.СоздатьЭлемент();
		НоваяТара.Штрихкод = МенеджерТары.ПолучитьНовыйНомерТары(ТипПартии);
		НоваяТара.ТипТары  = ТипПартии;
		НоваяТара.ДатаПартии = СтрокаПаллеты.ДатаПаллеты;
		НоваяТара.Наименование = ТипПартии.Префикс + Формат(пДата, "ДФ=ddMMyy_HHmmss") + "_#" + СтрокаПаллеты.Паллета + "_" + Формат(ТекущаяДата(), "ДФ=ddMMyy/HHmmss");
		НоваяТара.Записать();
		
		МассивПартий.Добавить(НоваяТара.Ссылка);
		
		МассивСтрок = ТаблицаПаллет.НайтиСтроки(Новый Структура("Паллета",СтрокаПаллеты.Паллета));
		
		Для каждого пСтрока Из МассивСтрок Цикл 
			
			нСтр = ДокументДвижения.Товары.Добавить();
			нСтр.Товар = пСтрока.Номенклатура;
			нСтр.Количество = пСтрока.Количество;
			нСтр.КонтейнерПриемник = НоваяТара.Ссылка; 			
		КонецЦикла;
		
	КонецЦикла;
	
	ДокументДвижения.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат МассивПартий;	
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьСборкуПаллет(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьСборкуПаллетПродолжение",ЭтаФорма);
	ПоказатьВводЗначения(Оповещение,,"Выберите тип паллеты",Тип("ПланВидовХарактеристикСсылка.ТипыКонтейнеров"));
	
КонецПроцедуры

&НаКлиенте
Функция ЗавершитьСборкуПаллетПродолжение(ТипПартии,ДополнительныеПараметры) Экспорт
	
	Если ТипПартии = Неопределено Тогда Иначе  
		МассивПартий = ЗавершитьСборкуПаллетНаСервере(ТипПартии);
		ВыполнитьПечатьУпаковочныхЛистов(МассивПартий);          
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецФункции // ЗавершитьСборкуПаллет()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ПараметрКоманды") Тогда  
		Если ЗначениеЗаполнено(Параметры.ПараметрКоманды.Ссылка) Тогда
			Объект.Распоряжение = Параметры.ПараметрКоманды;
			РаспоряжениеПриИзмененииНаСервере();
		Иначе     
			Отказ = Истина;
			ВызватьИсключение "Документ должен быть записан перед этой операцией!";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьПечатьУпаковочныхЛистов(МассивПаллет)
	
	Результат = Новый ТабличныйДокумент; 
	Результат.АвтоМасштаб = Истина;
	Результат.ПолеСверху = 0;
	Результат.ПолеСлева  = 0;
	Результат.ПолеСнизу  = 0;
	Результат.ПолеСправа = 0;

	
	Для каждого Паллета Из МассивПаллет Цикл
	
		ТабличныйДокумент = СоздатьТабличныйДокументЭтикеткиПаллеты(Паллета);
		ВывестиТабличныйДокументЭтикеткиПаллеты(Результат,ТабличныйДокумент);
			
	КонецЦикла;  
	
	Результат.Показать("Паллеты");
	
КонецФункции // ВыполнитьПечатьУпаковочныхЛистов()

Функция СоздатьТабличныйДокументЭтикеткиПаллеты(Паллета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ПолеСверху = 0;
	ТабличныйДокумент.ПолеСлева  = 0;
	ТабличныйДокумент.ПолеСнизу  = 0;
	ТабличныйДокумент.ПолеСправа = 0;
	//ТабличныйДокумент.ШиринаСтраницы = Ширина;
	//ТабличныйДокумент.ВысотаСтраницы = Высота;
	ТабличныйДокумент.РазмерСтраницы = "Custom";

	ТабличныйДокумент.Очистить();
	
	Макет = ПолучитьОбщийМакет("МакетШтрихкода");
	
	Область = Макет.ПолучитьОбласть("ОбластьШтрихкод|ШиринаЭтикетки");
	Рисунок = Область.Рисунки.ШтрихКод;
	
	Эталон = ПолучитьОбщийМакет("Эталон");
	
	КоличествоМиллиметровВПикселеВысота = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
	КоличествоМиллиметровВПикселеШирина = Эталон.Рисунки.Квадрат100Пикселей.Ширина / 100;
	ШиринаШтрихкода = Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселеШирина);
	ВысотаШтрихкода = Окр(Рисунок.Высота / КоличествоМиллиметровВПикселеВысота * 1.5);
	
	ПараметрыШтрихкода = Новый Структура;
	ПараметрыШтрихкода.Вставить("Ширина",ШиринаШтрихкода);
	ПараметрыШтрихкода.Вставить("Высота",ВысотаШтрихкода);
	ПараметрыШтрихкода.Вставить("Штрихкод",        Паллета.Штрихкод);
	ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь);
	ПараметрыШтрихкода.Вставить("ТипКода",99);
		
	// ТУ Алфимов 01.03.2024++
	//Рисунок.Картинка = МенеджерОборудованияВызовСервера.ПолучитьКартинкуШтрихкода(ПараметрыШтрихкода);
	
	Рисунок.Картинка = вмс_Печать.ИзображениеШтрихкода(ПараметрыШтрихкода);
	// ТУ Алфимов 01.03.2024--
	
	Рисунок.Расположить(Область.Область());
	ТабличныйДокумент.Вывести(Область); 
	
	Область = Макет.ПолучитьОбласть("ОбластьПредставлениеКода|ШиринаЭтикетки");
	Область.Параметры.ПредставлениеКода = Паллета.Наименование + Символы.ПС + "Дата:" + Формат(Паллета.ДатаПартии, "ДФ=dd.MM.yyyy");
	ТабличныйДокумент.Вывести(Область);
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ()

