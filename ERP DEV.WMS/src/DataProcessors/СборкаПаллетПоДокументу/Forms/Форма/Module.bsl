&НаКлиенте
Процедура ТаблицаПаллетПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Если Не ЗначениеЗаполнено(ТекущаяПаллета) Тогда
		//TODO: Выбор паллеты если не указана
		// 		Кнопка "Новая паллета
		ТекущаяПаллета = ТекущаяПаллета + 1;
		ПоследняяПаллета = ТекущаяПаллета;
		ПодключитьОбработчикОжидания("АнимацияТекущаяПаллета",0.1,Истина);
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(ДатаПаллеты) Тогда  
		
		Оповещение = Новый ОписаниеОповещения("ТаблицаПаллетПеретаскиваниеПродолжение",ЭтотОбъект,ПараметрыПеретаскивания);
		ПоказатьВводДаты(Оповещение,ДатаПаллеты,"Укажите дату");
		Возврат;
			
	КонецЕсли;	
		
	Для каждого пСтрока Из ПараметрыПеретаскивания.Значение Цикл 
		
		Количество = Неопределено;
		Оповещение = Новый ОписаниеОповещения("ТаблицаПаллетПеретаскиваниеЗавершение",ЭтаФорма,Новый Структура("СтрокаТовара",пСтрока));  
		
		ПараметрыОткрытия = Новый Структура("Номенклатура,Количество",);
		ЗаполнитьЗначенияСвойств(ПараметрыОткрытия,пСтрока);	
		ОткрытьФорму("Обработка.СборкаПаллетПоДокументу.Форма.ФормаВводаКоличества",ПараметрыОткрытия,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

		//ПоказатьВводЧисла(Оповещение,пСтрока.Количество,"Сколько товара " + Символы.ПС + """" + пСтрока.Номенклатура + """ (" + пСтрока.Количество + ") взять"); 
				
	КонецЦикла; 	

КонецПроцедуры 

&НаКлиенте
Функция ТаблицаПаллетПеретаскиваниеПродолжение(пДата,ПараметрыПеретаскивания) Экспорт
	
	Если ЗначениеЗаполнено(пДата) Тогда
		
		ДатаПаллеты = пДата;
		
		Для каждого пСтрока Из ПараметрыПеретаскивания.Значение Цикл 
			
			Количество = Неопределено;
			Оповещение = Новый ОписаниеОповещения("ТаблицаПаллетПеретаскиваниеЗавершение",ЭтаФорма,Новый Структура("СтрокаТовара",пСтрока));  
			
			ПараметрыОткрытия = Новый Структура("Номенклатура,Количество",);
			ЗаполнитьЗначенияСвойств(ПараметрыОткрытия,пСтрока);	
			ОткрытьФорму("Обработка.СборкаПаллетПоДокументу.Форма.ФормаВводаКоличества",ПараметрыОткрытия,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
			//ПоказатьВводЧисла(Оповещение,пСтрока.Количество,"Сколько товара " + Символы.ПС + """" + пСтрока.Номенклатура + """ (" + пСтрока.Количество + ") взять"); 
			
		КонецЦикла; 	
		
	КонецЕсли;
	
КонецФункции


&НаКлиенте
Функция ТаблицаПаллетПеретаскиваниеЗавершение(Результат,Параметры) Экспорт  
	
пСтрока = Параметры.СтрокаТовара; 
	
	Если Результат = Неопределено Тогда Возврат Неопределено КонецЕсли;
	
	КоличествоТовара = Результат.Количество;
	
	Если ЗначениеЗаполнено(КоличествоТовара) Тогда 
		
		Если пСтрока.Количество < КоличествоТовара Тогда
			ВызватьИсключение "Превышено количество отбираемого товара";
			Возврат Неопределено;
		КонецЕсли;
		
		нСтр = ТаблицаПаллет.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,пСтрока);
		нСтр.Количество = КоличествоТовара; 
		нСтр.Паллета = ТекущаяПаллета; 
		нСтр.ДатаПаллеты = ДатаПаллеты;
			
		пСтрока.Количество = пСтрока.Количество - КоличествоТовара;
		Если пСтрока.Количество = 0 Тогда
			ТаблицаТоваров.Удалить(пСтрока);
		КонецЕсли;
		
	КонецЕсли; 
	

	СвернутьТаблицуПаллет();
	
КонецФункции // ТаблицаПаллетПеретаскиваниеЗавершение()

&НаСервере
Функция СвернутьТаблицуПаллет()
	
	ТЗ = ТаблицаПаллет.Выгрузить();
	ТЗ.Свернуть("Номенклатура,Паллета,ДатаПаллеты","Количество");
	ТЗ.Сортировать("Паллета");
	ТаблицаПаллет.Загрузить(ТЗ);	
	
КонецФункции // СвернутьТаблицуПаллет()

&НаСервере
Функция СвернутьТаблицуТоваров()
	
	ТЗ = ТаблицаТоваров.Выгрузить();
	ТЗ.Свернуть("Номенклатура","Количество");
	ТаблицаТоваров.Загрузить(ТЗ);	
	
КонецФункции // СвернутьТаблицуПаллет()

&НаКлиенте
Процедура НоваяПаллета(Команда)
	ТекущаяПаллета = ПоследняяПаллета + 1;  
	ПоследняяПаллета = ТекущаяПаллета; 
	ПодключитьОбработчикОжидания("АнимацияТекущаяПаллета",0.1,Истина);
	
	Оповещение = Новый ОписаниеОповещения("НоваяПаллетаПродолжение",ЭтотОбъект);
	ПоказатьВводДаты(Оповещение,ДатаПаллеты,"Укажите дату");
	
КонецПроцедуры  

