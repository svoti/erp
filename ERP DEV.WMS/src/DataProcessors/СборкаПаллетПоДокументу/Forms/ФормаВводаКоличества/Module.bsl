
&НаКлиенте
Процедура Ок(Команда)
	
	Закрыть(Новый Структура("Номенклатура,Количество",Параметры.Номенклатура,КоличествоВзять));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НоменклатураНадпись = "Товар:" + Параметры.Номенклатура 
	+ Символы.ПС + Символы.ПС +
	"Количество в документе:" + Параметры.Количество;
	
	КоличествоВзять = Параметры.Количество;
КонецПроцедуры
