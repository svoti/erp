Функция НачатьПрисвоениеШтрихкода() 
	
	РК = вмс_РаботаСКоллекциями;
	ТаблицыОперации = ДанныеОбработки.Таблицы;	   
	СтрокаПрисвоения = ДанныеОбработки.Таблицы.ТаблицаПрисвоения[0]; 
	ТоварныеПоляМассив = вмс_ОперацииПоЯчейкамКлиентСервер.ИспользуемыеТоварныеПоля();    
	ВведенныеДанныеПолей = ПараметрыОбработки.Данные.ВведенныеДанныеПолей;      
//	Штрихкод = ВведенныеДанныеПолей.Штрихкод;                 
	ПолеВыводаШтрихкод = ПолучитьЭлементВывода("Штрихкод");   
	Если НЕ ПолеВыводаШтрихкод.Свойства.Свойство("Значение") ИЛИ НЕ ЗначениеЗаполнено(ПолеВыводаШтрихкод.Свойства.Значение) Тогда     
		ПоказатьДиалогНаКлиенте(,"Отсканируйте штрихкод!");
		Возврат Ложь;	
	КонецЕсли;
	Штрихкод = ПолеВыводаШтрихкод.Свойства.Значение;
	
	Если ВведенныеДанныеПолей.Свойство("Коэффициент") И ВведенныеДанныеПолей.Коэффициент <> Неопределено Тогда 
		Коэффициент = ВведенныеДанныеПолей.Коэффициент; 
	Иначе 
		Коэффициент = ПолучитьЗначениеДанныхПоляОбработки("Коэффициент"); 
	КонецЕсли;
	
	//Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
	//	ПоказатьДиалогНаКлиенте(,"Отсканируйте штрихкод!");
	//	Возврат Ложь;
	//КонецЕсли;	 
		
	ВыбранныйЭлемент = Новый Структура(РК.МассивВСтроку(ТоварныеПоляМассив));
    ЗаполнитьЗначенияСвойств(ВыбранныйЭлемент, СтрокаПрисвоения);
	ВыбранныйЭлемент.Вставить("Номенклатура", СтрокаПрисвоения.Товар);
	
	РезультатОпроса = Новый Структура;    
	РезультатОпроса.Вставить("Штрихкод", Штрихкод);
	РезультатОпроса.Вставить("ВыбранныйЭлемент", ВыбранныйЭлемент); 
	РезультатОпроса.Вставить("Коэффициент", Коэффициент); 
	
	ОО = вмс_СерверУправляемыеОбработки.НовыйОписаниеОповещения("ПослеЗакрытияВопросаОПрисвоении", ПараметрыОбработки, ЭтотОбъект,РезультатОпроса);
	
	Выбранно = "";
	Для Каждого ИмяПоля Из ТоварныеПоляМассив Цикл
		Выбранно = Выбранно + Символы.ПС + ВыбранныйЭлемент[ИмяПоля];
	КонецЦикла;   
	
	ТекстВопроса = Прав(Выбранно, СтрДлина(Выбранно)-СтрДлина(Символы.ПС));
	ПоказатьДиалогНаКлиенте(ОО, ТекстВопроса, "ДаНетОтмена",, "Да", "Присвоить штрихкод: " + Штрихкод);
	
КонецФункции

Процедура ПослеЗакрытияВопросаОПрисвоении(Результат, Параметры) Экспорт
	
	Если Результат = "Отмена" Тогда
		Возврат;
	КонецЕсли;
	
	ШтрихкодПрисвоен = Ложь;
	Если Результат = "Да" Тогда
		ШтрихкодПрисвоен = ПрисвоитьШтрихкодНоменклатуре(Параметры);
	КонецЕсли;         
	//3.2.4 18.06.26+
	// Если была отсканирована марка - нужно передать марку, предполагается что такая фича нужна только если присвоение из задания   
	ПараметрыИнициализации = СостояниеОбработки.ПараметрыИнициализации;
	
	Если ПараметрыИнициализации.Свойство("ОтсканированаМарка") И ПараметрыИнициализации.ОтсканированаМарка Тогда  
		вмс_СерверУправляемыеОбработки.ЗавершитьРаботуОбработки(ПараметрыОбработки,ПараметрыИнициализации.Марка);
	Иначе
		вмс_СерверУправляемыеОбработки.ЗавершитьРаботуОбработки(ПараметрыОбработки,Параметры.Штрихкод);
	КонецЕсли;
	//ТУ_Прошин_18.06.26-
	//вмс_СерверУправляемыеОбработки.ЗавершитьРаботуОбработки(ПараметрыОбработки,Параметры.Штрихкод);
	
КонецПроцедуры  

Функция ПрисвоитьШтрихкодНоменклатуре(Параметры)  
	ШтрихкодПрисвоен = вмс_ОбработкаШтрихкодовСервер.ПрисвоитьШтрихкодНоменклатуре(Параметры);    
	Возврат ШтрихкодПрисвоен;
КонецФункции 






































