Функция ДействиеИнициализироватьДанныеОбработки(Действие)
	
	//Основная таблица операции+
	СписокНоменклатуры = РК.НоваяКоллекцияЗначений("Код, Артикул, Номенклатура, Характеристика");
	ДанныеОбработки.Таблицы.Вставить("СписокНоменклатуры", СписокНоменклатуры);
	
	УстановитьСвойстваЭлементовВывода("ГлавнаяПанельСтраницаВводДанных", Новый Структура("Заголовок", "Присвоение штрихкода"));
	УстановитьСвойстваЭлементовВывода("СписокНоменклатуры", Новый Структура("Родитель", "ГлавнаяПанельСтраницаВводДанных"));

	Если СостояниеОбработки.ПараметрыИнициализации.ВерсияМобильногоКлиента >= "2.1.3" Тогда
		УстановитьСвойстваЭлементовВывода("СписокНоменклатурыГруппаОсновныеПоля", Новый Структура("Родитель, ТипЭлемента, Вид, Группировка", "СписокНоменклатуры", "ГруппаФормы", "ГруппаКолонок", "Вертикальная"));
		УстановитьСвойстваЭлементовВывода("СписокНоменклатурыКод, СписокНоменклатурыАртикул, СписокНоменклатурыНоменклатура, СписокНоменклатурыХарактеристика", Новый Структура("Родитель", "СписокНоменклатурыГруппаОсновныеПоля"));
		ИспользоватьХарактеристики = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля().Найти("Характеристика") <> Неопределено;
		Если НЕ ИспользоватьХарактеристики Тогда       
			УстановитьСвойстваЭлементовВывода("СписокНоменклатурыХарактеристика", Новый Структура("Видимость", "Ложь")); 
		КонецЕсли;
		
	КонецЕсли;
	//-
	
	//Таблица присвоения+
	ТаблицаПрисвоения = РК.НоваяКоллекцияЗначений("Товар, Характеристика");
	ДанныеОбработки.Таблицы.Вставить("ТаблицаПрисвоения", ТаблицаПрисвоения);
		
	Если СостояниеОбработки.ПараметрыИнициализации.ВерсияМобильногоКлиента >= "2.1.3" Тогда
		УстановитьСвойстваЭлементовВывода("ТаблицаПрисвоения", Новый Структура("Видимость", "Ложь"));
	КонецЕсли;	
	//-        
	
	//Таблица товаров задания+
	//ТаблицаТоваровЗадания = РК.НоваяКоллекцияЗначений("Номенклатура, Характеристика");     
	ТаблицаТоваровЗадания = Новый ТаблицаЗначений;
	ТаблицаТоваровЗадания.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));   
	
	ТаблицаТоваровЗадания.Колонки.Добавить("Характеристика", Новый ОписаниеТипов(вмс_РаботаСКоллекциями.ЗначениеВМассив(ТипЗнч(вмс_АдаптацияКонфигураций.ПустаяХарактеристика()))));
	ДанныеОбработки.Таблицы.Вставить("ТаблицаТоваровЗадания", ТаблицаТоваровЗадания); 
	Если СостояниеОбработки.ПараметрыИнициализации.ВерсияМобильногоКлиента >= "2.1.3" Тогда
		УстановитьСвойстваЭлементовВывода("ТаблицаТоваровЗадания", Новый Структура("Видимость", "Ложь"));
	КонецЕсли;
	//-     
	 УстановитьСвойстваЭлементовВывода("Поиск, КнопкаОчиститьПоиск", Новый Структура("Родитель", "ГруппаПолейПоискТриграмма")); 
    УстановитьСвойстваЭлементовВывода("ТоварПредставление, Штрихкод, СписокНоменклатуры, ТаблицаПрисвоения, ТаблицаТоваровЗадания", Новый Структура("Родитель", "ГруппаТаблицОперации"));     
	УстановитьСвойстваЭлементовВывода("КнопкаПрисвоитьШтрихкод", Новый Структура("Родитель", "ГруппаКомандПодвал"));
	СтандартныйМодуль.СгруппироватьЭлементыВывода("ТоварПредставление, Штрихкод, СписокНоменклатуры, ТаблицаПрисвоения, ТаблицаТоваровЗадания", "Вертикальная");

	СтандартныйМодуль.СгруппироватьЭлементыВывода("ГруппаПолейПоискТриграмма, ГруппаПолейУпаковки, ГруппаТаблицОперации, ГруппаКомандПодвал", "Вертикальная");

КонецФункции  

Функция ДействиеОбработатьВводШтрихкода(Действие)

	РК = вмс_РаботаСКоллекциями;
	Действие.СтандартнаяОбработка = Ложь;  
	Действие.Обработано = Истина;
	Штрихкод = Действие.Параметры;      
	
	ВходящиеДанные = НовыеВходящиеДанные(Штрихкод); 
	ВходящиеДанные.Вставить("ПрисвоениеШтрихкода", Истина);
	ВвестиДанные(ВходящиеДанные);    
	//УстановитьРезультатДействия(Действие, Истина)     
	
	Результат = ВходящиеДанные.ДанныеШтрихкода.Результат;       
	
	Если ЗначениеЗаполнено(Результат) И Результат.НайденныеОбъекты.Количество() > 0 Тогда  
		МассивНайденныхОбъектов = РК.ВыгрузитьЗначенияКолонкиКоллекции(Результат.НайденныеОбъекты, "Объект");
		РК.УдалитьДублиВМассиве(МассивНайденныхОбъектов);
		ТекстСообщения = СтрШаблон("Отсканированный штрихкод уже назначен для %1 !", РК.МассивВСтроку(МассивНайденныхОбъектов)); 
		УстановитьСвойстваЭлементовВывода("Штрихкод", Новый Структура("Значение","")); 
		ПоказатьДиалогНаКлиенте(,ТекстСообщения);
		Возврат Ложь;	
	Иначе 
		ОтсканированныйШтрихкод = Действие.Параметры;      
		УстановитьСвойстваЭлементовВывода("Штрихкод", Новый Структура("Значение",ОтсканированныйШтрихкод)); 
	КонецЕсли;
		
КонецФункции    

Функция ДействиеВвестиДанные(Действие) 
		
КонецФункции

Функция ДействиеНачалоОбработки(Действие) 
	 
	ПараметрыИнициализации = СостояниеОбработки.ПараметрыИнициализации;
	Если ПараметрыИнициализации.Свойство("ДокументСсылка") И ЗначениеЗаполнено(ПараметрыИнициализации.ДокументСсылка) Тогда   
		ОтсканированныйШтрихкод = ПараметрыИнициализации.Штрихкод;    
		УстановитьСвойстваЭлементовВывода("Штрихкод", Новый Структура("Значение",ОтсканированныйШтрихкод));

		Если ПараметрыИнициализации.ИзЗадания Тогда
			ТаблицаТоваров = ПараметрыИнициализации.ДокументСсылка.Товары.Выгрузить();
			ТаблицаТоваров.Свернуть("Номенклатура, Характеристика");
			
			Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
				НоваяСтрока = ДанныеОбработки.Таблицы.СписокНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);  
				НоваяСтрока.Код = СтрокаТовара.Номенклатура.Код;
				НоваяСтрока.Артикул = СтрокаТовара.Номенклатура.Артикул;  
				
				НоваяСтрока = ДанныеОбработки.Таблицы.ТаблицаТоваровЗадания.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);
 
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	
КонецФункции 

Функция ДействиеПриОткрытииФормыОбработки(Действие)	
	УстановитьЗаголовокФормы("Присвоение штрихкода");	
КонецФункции    

Функция ДействиеИнициализироватьПараметрыОбработки(Действие)
	Если ДействиеВыполняетсяПосле(Действие) Тогда
		ПустоеПолеОбработки = ПараметрыОбработки.ПустоеПолеОбработки;
	КонецЕсли;
КонецФункции   

Функция УстановитьЗаголовокФормы(Заголовок)

	Возврат ДобавитьДействиеНаКлиенте("УстановитьЗаголовок", Заголовок);
	
КонецФункции      

Функция ДействиеПослеЗавершенияВвода(Действие)
	  
	ДанныеПолей = Действие.МодульВызова.ДанныеОбработки.ВходящиеДанные.ДанныеПолей;
	Если ДанныеПолей.Свойство("Поиск") Тогда 
		ПоискТриграмма = ДанныеПолей.Поиск;  
		Если СтрДлина(ПоискТриграмма) > 0 Тогда
			ВыполнитьПоискТриграммаНаСервере(ПоискТриграмма);   
		КонецЕсли;
	ИначеЕсли ДанныеПолей.Свойство("Коэффициент") Тогда	
		УстановитьЗначениеДанныхПоляОбработки("Коэффициент", ДанныеПолей.Коэффициент); 	
	КонецЕсли;

КонецФункции      

Функция ДействиеЗафиксироватьТранзакциюОбработки(Действие)  
			
КонецФункции     

Процедура ВыполнитьПоискТриграммаНаСервере(ПоискТриграмма) 
	
	ПараметрыИнициализации = СостояниеОбработки.ПараметрыИнициализации;
	ТаблицыОперации = ДанныеОбработки.Таблицы;

	ОбработаннаяСтрока = вмс_РаботаСТриграммамиВызовСервера.ОбработатьСтроку(ПоискТриграмма);
	МассивТриграммов = вмс_РаботаСТриграммамиВызовСервера.ПолучитьМассивТриграммов(ОбработаннаяСтрока);      
	
	Если ПараметрыИнициализации.Свойство("ДокументСсылка") И ЗначениеЗаполнено(ПараметрыИнициализации.ДокументСсылка) И ПараметрыИнициализации.ИзЗадания Тогда  
		
		ТаблицаТоваров = ТаблицыОперации.ТаблицаТоваровЗадания;
		ТаблицаСовпаденийТриграммов = вмс_РаботаСТриграммамиВызовСервера.ПолучитьТаблицуСовпаденийТриграммовПоТаблицеНоменклатуры(МассивТриграммов, ТаблицаТоваров);   
	Иначе		
		ТаблицаСовпаденийТриграммов = вмс_РаботаСТриграммамиВызовСервера.ПолучитьТаблицуСовпаденийТриграммов(МассивТриграммов);     
		Если вмс_АдаптацияКонфигураций.ИспользуютсяХарактеристики() Тогда
			ДополнитьТаблицуСовпаденийТриграммовХарактеристикой(ТаблицаСовпаденийТриграммов);		
		КонецЕсли;  
	КонецЕсли;
	
	ТаблицыОперации.СписокНоменклатуры.Очистить();
	
	Если ТаблицаСовпаденийТриграммов.Количество() = 0 Тогда  
		ПоказатьДиалогНаКлиенте(,"Номенклатура не найдена!");
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаСовпаденийТриграммов Цикл
		НоваяСтрока = ТаблицыОперации.СписокНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(Строка.Номенклатура);
		НоваяСтрока.Код = ДанныеНоменклатуры.Код;
		НоваяСтрока.Артикул = ДанныеНоменклатуры.Артикул;
	КонецЦикла;
		
КонецПроцедуры  

Процедура ДополнитьТаблицуСовпаденийТриграммовХарактеристикой(ТаблицаСовпаденийТриграммов)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаСовпадений.Номенклатура КАК Номенклатура,
		|	ТаблицаСовпадений.КоличествоТриграммов КАК КоличествоТриграммов
		|ПОМЕСТИТЬ ВТ_ТаблицаСовпадений
		|ИЗ
		|	&ТаблицаСовпадений КАК ТаблицаСовпадений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаСовпадений.Номенклатура КАК Номенклатура,
		|	ВТ_ТаблицаСовпадений.КоличествоТриграммов КАК КоличествоТриграммов,
		|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
		|ИЗ
		|	ВТ_ТаблицаСовпадений КАК ВТ_ТаблицаСовпадений
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО ВТ_ТаблицаСовпадений.Номенклатура = ХарактеристикиНоменклатуры.Владелец
		|
		|УПОРЯДОЧИТЬ ПО
		|	КоличествоТриграммов УБЫВ,
		|	Номенклатура,
		|	Характеристика";
	Запрос.УстановитьПараметр("ТаблицаСовпадений", ТаблицаСовпаденийТриграммов);
	РезультатЗапроса = Запрос.Выполнить();
	
	Таблица = РезультатЗапроса.Выгрузить();
	
	ТаблицаСовпаденийТриграммов = Таблица;
КонецПроцедуры 

Функция ПолучитьДанныеНоменклатуры(Товар)
	
	Данные = Новый Структура("Код, Артикул");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Код КАК Код,
		|	Номенклатура.Артикул КАК Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Товар);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(Данные, Выборка);
	
	Возврат Данные;
	
КонецФункции

Процедура ОбработатьОчисткуПоляПоискаТриграмма()  
	
	ПараметрыИнициализации = СостояниеОбработки.ПараметрыИнициализации;     
	ВвестиДанныеПоля("Поиск","");
	
	Если ПараметрыИнициализации.Свойство("ДокументСсылка") И ЗначениеЗаполнено(ПараметрыИнициализации.ДокументСсылка) И ПараметрыИнициализации.ИзЗадания Тогда  
		
		ТаблицаТоваровЗадания = ДанныеОбработки.Таблицы.ТаблицаТоваровЗадания;  
		
		СписокНоменклатуры = ДанныеОбработки.Таблицы.СписокНоменклатуры;
		СписокНоменклатуры.Очистить();
		Для Каждого Строка Из ТаблицаТоваровЗадания Цикл
			НоваяСтрока = СписокНоменклатуры.Добавить();    
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
			ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(Строка.Номенклатура);
			НоваяСтрока.Код = ДанныеНоменклатуры.Код;
			НоваяСтрока.Артикул = ДанныеНоменклатуры.Артикул;
		КонецЦикла 
	Иначе		
		ДанныеОбработки.Таблицы.СписокНоменклатуры.Очистить();	
	КонецЕсли;
	
КонецПроцедуры       

Процедура ДействиеВыборЭлементаТаблицы(Действие)
	
	ИмяТаблицы = Действие.Параметры.ИмяТаблицы;
	ЭлементТаблицы = ПолучитьЭлементТаблицыПоИдентификатору(ИмяТаблицы, Действие.Параметры.ИдентификаторЭлемента); 
	РК = вмс_РаботаСКоллекциями;
	
	Если ИмяТаблицы="СписокНоменклатуры" Тогда
		ДанныеСтроки = Новый Структура(РК.МассивВСтроку(вмс_ОперацииПоЯчейкамКлиентСервер.ИспользуемыеТоварныеПоля()));     
		ДанныеСтроки.Вставить("Артикул", ""); 
		ДанныеСтроки.Вставить("Код", ""); 
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, ЭлементТаблицы);  
		ДанныеСтроки.Товар = ЭлементТаблицы.Номенклатура;
		
		ПакетПолей = РК.СкопироватьОбъект(ДанныеСтроки);
		
		Для каждого КлючЗначение Из ДанныеСтроки Цикл 
			Если Строка(КлючЗначение.Значение) = "<>" Тогда
				ДанныеСтроки.Вставить(КлючЗначение.Ключ, "");	
			КонецЕсли;	
		КонецЦикла;
		
		ТекстВопроса = СтрШаблон("Выбрать ");
		Для Каждого КлючЗначение Из ДанныеСтроки Цикл     		
			Если КлючЗначение.Значение <> ""  Тогда 
				ТекстВопроса = ТекстВопроса + КлючЗначение.Значение + ", ";	
			КонецЕсли;
		КонецЦикла;
		ТекстВопроса = Лев(ТекстВопроса, СтрДлина(ТекстВопроса)-2) + "?";
		ТекстВопроса = СокрЛП(ТекстВопроса);       
		
		ОО = вмс_СерверУправляемыеОбработки.НовыйОписаниеОповещения("Обработчик_ВыборТовараПодтвердить", ПараметрыОбработки, ЭтотОбъект,ПакетПолей);
		ПоказатьДиалогНаКлиенте(ОО, ТекстВопроса, "ДаНет");
	КонецЕсли;
	
КонецПроцедуры 

Процедура Обработчик_ВыборТовараПодтвердить(Ответ, ПакетПолей) Экспорт   
	
	Если Ответ = "Да" Тогда    
		Коэффициент = 1;
		ОбработатьВыборТовараЗавершение(Коэффициент, ПакетПолей);	
	КонецЕсли;	
	
КонецПроцедуры   

