		УстановитьСвойстваЭлементовВывода("ТоварПредставление", Новый Структура("Видимость, Значение", "Истина", ТоварСтрокой)); 
		УстановитьСвойстваЭлементовВывода("СписокНоменклатуры", Новый Структура("Видимость", "Ложь"));   
		//УстановитьСвойстваЭлементовВывода("ТаблицаПрисвоения", Новый Структура("Видимость", "Истина"));  
		УстановитьСвойстваЭлементовВывода("Штрихкод", Новый Структура("Видимость", "Истина")); 
