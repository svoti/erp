		//Если ИспользоватьУпаковки Тогда 
			УстановитьСвойстваЭлементовВывода("Коэффициент", Новый Структура("Видимость", "Истина"));   
			УстановитьСвойстваЭлементовВывода("ГруппаПолейУпаковки", Новый Структура("Видимость", "Истина"));
