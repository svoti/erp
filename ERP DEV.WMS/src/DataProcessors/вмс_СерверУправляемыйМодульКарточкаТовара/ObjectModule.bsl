Процедура НачатьПечатьЭтикетки(Этикетка)
		
	ТаблицаПринтеров = вмс_Печать.ПолучитьТаблицуНастроекПринтеров(ПараметрыОбработки.НастройкаОператора);
	
	Если ЗначениеЗаполнено(ТаблицаПринтеров) Тогда
		
		Если ТаблицаПринтеров.Количество() = 1 Тогда
			// принтер один - берем его
			ОбработчикВыбораПринтера(ТаблицаПринтеров[0].Принтер, Этикетка);
		Иначе
			// принтеров несколько. Пробуем по умолчанию, либо выбор
			ПринтерыПоУмолчанию = ТаблицаПринтеров.НайтиСтроки(Новый Структура("ПоУмолчанию", Истина));
			Если ЗначениеЗаполнено(ПринтерыПоУмолчанию) Тогда
				// берем отмеченный по умолчанию
				ОбработчикВыбораПринтера(ПринтерыПоУмолчанию[0], Этикетка);
			Иначе
				// выбираем принтер
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("Принтеры", ТаблицаПринтеров.ВыгрузитьКолонку("Принтер"));
				СтандартныйМодуль.ПоказатьФормуДиалога(НовыйОписаниеОповещения("ОбработчикВыбораПринтера", , Этикетка), "ОбщаяФорма.ФормаВыборПринтера", ПараметрыФормы);
			КонецЕсли;
		КонецЕсли;	
	Иначе
		ПоказатьДиалогНаКлиенте(, "Не указаны принтеры у оператора. Укажите в настройках оператора");
	КонецЕсли;

КонецПроцедуры

Функция ОбработчикВыбораПринтера(ВыбранныйПринтер, ТабличныйДокумент) Экспорт
	
	// 3.2.4
	Если ВыбранныйПринтер=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ВыбранныйПринтер.ТипПринтера = ПредопределенноеЗначение("Перечисление.ТипыПринтеров.ЛокальныйПринтер") Тогда
		вмс_Печать.ДобавитьДокументКПечатиЧерезРегистр(ТабличныйДокумент, ВыбранныйПринтер);
	ИначеЕсли ВыбранныйПринтер.ТипПринтера = ПредопределенноеЗначение("Перечисление.ТипыПринтеров.СерверныйПринтер") Тогда
		вмс_Печать.ВыполнитьПечатьЧерезКомпоненту(ТабличныйДокумент, ВыбранныйПринтер);
	Иначе
		ДобавитьДействиеНаКлиенте("ПечатьНаБеспроводнойПринтер", ТабличныйДокумент);
	КонецЕсли;
	
КонецФункции

