Функция ОбработчикЭтапаВводаДанных_СохранениеДанных(НаборДанных, ДополнительныеПараметры) Экспорт
	
	
КонецФункции

Функция ОбработчикНажатияКнопкиПодтвердить(Результат, ДополнительныеПараметры) Экспорт
	
	Серия = ПолучитьЗначениеДанныхПоляОбработки("Серия");
	
	//3.2.5 ZAD-48:
	РеквизитыСерии = ПолучитьРеквизитыСерии();
	
	Если Не ПроверитьРеквизитыСерии(РеквизитыСерии) Тогда
		Возврат Ложь;
	КонецЕсли;
	//3.2.5 ZAD-48:
	
	Если НЕ ЗначениеЗаполнено(Серия) Тогда
		Серия = ПолучитьСерию();
	КонецЕсли;
	
	Ячейка = ПолучитьЗначениеДанныхПоляОбработки("Ячейка");
	
	ВходящиеДанные = СтандартныйМодульМенеджер.НовыеВходящиеДанные();
	ВходящиеДанные.ВходящиеОбъекты.Добавить(Серия);
	Если ЗначениеЗаполнено(Ячейка) Тогда
		ВходящиеДанные.ВходящиеОбъекты.Добавить(Ячейка);
	КонецЕсли;
	вмс_СерверУправляемыеОбработки.ЗавершитьРаботуОбработки(ПараметрыОбработки, ВходящиеДанные);
	
КонецФункции

//3.2.5 ZAD-48:
Функция ОбработчикНажатияКнопкиНовыйНомер(Результат, ДополнительныеПараметры) Экспорт
	
	СлучайныйНомер = вмс_СерииТоваровСервер.СгенерироватьСлучайныйНомерСерии();
	СтандартныйМодуль.ВвестиДанныеПоля("Номер", СлучайныйНомер);
		
КонецФункции

Функция ОбработчикНажатияКнопкиПечать(Результат, ДополнительныеПараметры) Экспорт
	
	НачатьТранзакцию();
	РеквизитыСерии = ПолучитьРеквизитыСерии();
	
	//3.2.5 ZAD-48:
	Если Не ПроверитьРеквизитыСерии(РеквизитыСерии) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Серия = вмс_СерииТоваровСервер.ПолучитьСерию(РеквизитыСерии);
	Если Серия=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеШК = Новый Структура;
	Для Каждого Поле Из ПоляОбработки("Товар, Характеристика") Цикл
		Если Поле.Имя="Товар" Тогда
			ИмяПоля = "Номенклатура";
		Иначе
			ИмяПоля = Поле.Имя;
		КонецЕсли;
		
		ДанныеШК.Вставить(ИмяПоля, Поле.Значение);
	КонецЦикла;
	ДанныеШК.Вставить("Серия", Серия);
	вмс_СерииТоваровСервер.ЗаписатьШтрихкодСерии(ДанныеШК, РеквизитыСерии);
	
	Этикетка = вмс_Печать.СформироватьПечатнуюФормуСерии(РеквизитыСерии);
	
	Если СтандартныйМодуль.НачатьПечать(Этикетка) Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
	
КонецФункции

Функция ОбработчикНажатияКнопкиОтмена(Результат, ДополнительныеПараметры) Экспорт
	
	вмс_СерверУправляемыеОбработки.ЗавершитьРаботуОбработки(ПараметрыОбработки, Неопределено);
	
КонецФункции

Функция ДействиеПослеЗавершенияВвода(Действие)
	
	УстановитьЗначениеДанныхПоляОбработки("Серия", НайтиСерию());
	УстановитьЗначениеДанныхПоляОбработки("Ячейка", Неопределено);
	
	ОбновитьПредставлениеКнопок();
	
КонецФункции

Функция ОбновитьПредставлениеКнопок()
	
	ПолеКнопки = ПолеОбработки("КнопкаПодтвердить");
	Если ПолеКнопки=ПустоеПолеОбработки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПолеКнопкиПечать = ПолеОбработки("КнопкаПечать");
	
	Серия = ПолучитьЗначениеДанныхПоляОбработки("Серия");
	
	Если ЗначениеЗаполнено(Серия) ИЛИ НЕ СоздаватьНовуюСерию Тогда
		СвойстваКнопки = Новый Структура("Заголовок, ЦветФона", "Выбрать", Новый Цвет);
		СвойстваКнопки.Вставить("Доступность", ЗначениеЗаполнено(Серия));
	Иначе
		СвойстваКнопки = Новый Структура("Заголовок, ЦветФона, Доступность", "Создать", Новый Цвет(220, 255, 220), Истина);
		СвойстваКнопки.Вставить("Доступность", ЗначениеЗаполнено(ДанныеОбработки.СобранныеДанныеПолей.ГоденДо) И ЗначениеЗаполнено(ДанныеОбработки.СобранныеДанныеПолей.ДатаПроизводства)); 
	КонецЕсли;
	
	ЭлементКнопки = СтандартныйМодуль.ПолучитьЭлементВыводаДляПоляОбработки(ПолеКнопки.ИмяЭлементаВывода, ПолеКнопки);
	УстановитьСвойстваЭлементовВывода(ЭлементКнопки, СвойстваКнопки);
	
	ЭлементКнопкиПечать = СтандартныйМодуль.ПолучитьЭлементВыводаДляПоляОбработки(ПолеКнопкиПечать.ИмяЭлементаВывода, ПолеКнопкиПечать);
	УстановитьСвойстваЭлементовВывода(ЭлементКнопкиПечать, Новый Структура("Доступность", СвойстваКнопки.Доступность));
	
КонецФункции

Функция НайтиСерию()
	
	РеквизитыСерии = ПолучитьРеквизитыСерии();
	СсылкаНаСерию = вмс_СерииТоваровСервер.НайтиСерию(РеквизитыСерии);
	Возврат СсылкаНаСерию;
	
КонецФункции

Функция ПолучитьСерию()
	
	РеквизитыСерии = ПолучитьРеквизитыСерии();
	СсылкаНаСерию = вмс_СерииТоваровСервер.ПолучитьСерию(РеквизитыСерии);
	Возврат СсылкаНаСерию;
	
КонецФункции

Функция ПолучитьРеквизитыСерии()
	
	РеквизитыСерии = Новый Структура;
	Для Каждого ПолеСборки Из ПоляОбработки(Новый Структура("Сборка", Истина)) Цикл
		РеквизитыСерии.Вставить(ПолеСборки.Имя, ДанныеОбработки.СобранныеДанныеПолей[ПолеСборки.Имя]);
	КонецЦикла;
	
	Возврат РеквизитыСерии;
	
КонецФункции

//3.2.5 ZAD-48:
Функция ПроверитьРеквизитыСерии(РеквизитыСерии)
		
	// Проверяем, что заполнены обязательные поля
	Серия = ПолучитьЗначениеДанныхПоляОбработки("Серия");
	
	ДатаПроизводстваПустая = РеквизитыСерии.Свойство("ДатаПроизводства") И НЕ ЗначениеЗаполнено(РеквизитыСерии.ДатаПроизводства);
	ГоденДоПустая = РеквизитыСерии.Свойство("ГоденДо") И НЕ ЗначениеЗаполнено(РеквизитыСерии.ГоденДо); а=0;
	
	// Если создаем новую серию - проверяем обязательные поля
	Если НЕ ЗначениеЗаполнено(Серия) Тогда
		
		Если ГоденДоПустая Тогда
			ПоказатьДиалогНаКлиенте(, "Не заполнена дата годности!");
			Возврат Ложь; // Остановка выполнения
		КонецЕсли;
		
		Если ДатаПроизводстваПустая Тогда
			ПоказатьДиалогНаКлиенте(, "Не заполнена дата производства!");
			Возврат Ложь; // Остановка выполнения
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверка логики: дата производства не может быть больше даты годности
	Если НЕ ДатаПроизводстваПустая И Не ГоденДоПустая Тогда
		Если РеквизитыСерии.ДатаПроизводства > РеквизитыСерии.ГоденДо Тогда
			ПоказатьДиалогНаКлиенте(, "Дата производства не может быть больше даты годности!");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина; // Продолжить выполнение
		
КонецФункции


