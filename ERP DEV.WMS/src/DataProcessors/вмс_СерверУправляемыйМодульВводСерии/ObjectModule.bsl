#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем РК;
Перем СтандартныйМодульМенеджер;
Перем ПустоеПолеОбработки;
Перем СоздаватьНовуюСерию;

#Область API
Функция ВыполнитьДействие(Действие) Экспорт
	
	Код = Действие.Код;
	
	ВыполнитьТест = Ложь;
	Если ВыполнитьТест Тогда
		Тест();
	КонецЕсли;
	
	Если Код="ИнициализироватьПоляОбработки" Тогда
		
		ДействиеИнициализироватьПоляОбработки(Действие);
		
	ИначеЕсли Код="ИнициализироватьПараметрыОбработки" Тогда
		
		ДействиеИнициализироватьПараметрыОбработки(Действие);
		
	ИначеЕсли Код="ЗакончитьИнициализациюПолейОбработки" Тогда
		
		ДействиеЗакончитьИнициализациюПолейОбработки(Действие);
		
	ИначеЕсли Код="ИнициализироватьДанныеОбработки" Тогда
		
		ДействиеИнициализироватьДанныеОбработки(Действие);
		
	ИначеЕсли Код="ИнициализироватьЭтапыВводаДанных" Тогда
		
		ДействиеИнициализироватьЭтапыВводаДанных(Действие);
		
	ИначеЕсли Код="НачалоОбработки" Тогда
		
		ДействиеНачалоОбработки(Действие);
		
	ИначеЕсли Код="ПриОткрытииФормыОбработки" Тогда
		
		ДействиеПриОткрытииФормыОбработки(Действие);
		
	ИначеЕсли Код="ПолучениеФормыОбработки" Тогда
		
		//УстановитьРезультатДействия(Действие, "ФормаОперацииНовая");
		
	ИначеЕсли Код="ВыборЭлементаТаблицы" Тогда
		
		ДействиеВыборЭлементаТаблицы(Действие);
		
	ИначеЕсли Код="ПослеЗавершенияВвода" Тогда
		
		ДействиеПослеЗавершенияВвода(Действие);
		
	КонецЕсли;
	
	Возврат Действие.Результат;
	
КонецФункции
#КонецОбласти

Функция Тест()
	
	СтандартныйМодуль.РазгруппироватьЭлементыВывода("КнопкаПодтвердить, КнопкаОтмена");
	
КонецФункции

Функция ДействиеИнициализироватьПоляОбработки(Действие)
	
	Перем Товар;
	
	УстановитьСвойстваЭлементовВывода("ГлавнаяПанельСтраницаПланФакт", Новый Структура("Заголовок", "Выбор"));

	ЗначениеПоля = Неопределено;
	ДанныеТовара = Неопределено;
	ПараметрыИнициализации = СостояниеОбработки.ПараметрыИнициализации;
	Если ТипЗнч(ПараметрыИнициализации) <> Тип("Структура") Тогда
		ПараметрыИнициализации = Новый Структура;
	КонецЕсли;
	
	ПараметрыИнициализации.Свойство("ДанныеТовара", ДанныеТовара);
	Если ТипЗнч(ДанныеТовара) <> Тип("Структура") Тогда
		ДанныеТовара = Новый Структура;
	КонецЕсли;
	
	ИсключенияВвода = РК.ЗначениеВМассив("СерияУчета, ВидНоменклатуры");
	ИсключенияВывода = РК.ЗначениеВМассив("СерияУчета");
	Если вмс_АдаптацияКонфигураций.ИмяРеквизитаНоменклатурыВладелецСерии()="Ссылка" Тогда
		//уже есть поле товар, не выводить еще раз ссылку товара в поле "Вид"
		ИсключенияВывода.Добавить("ВидНоменклатуры");
	КонецЕсли;
	
	ДанныеТовара.Свойство("Серия", ЗначениеПоля);
	УстановитьСвойстваПолейОбработки("Серия", Новый Структура("Вывод, Значение", Ложь, ЗначениеПоля));	
	УстановитьСвойстваПолейОбработки("Ячейка", Новый Структура("Вывод, Значение", Ложь, Неопределено));	
	
	ПараметрыИнициализации.Свойство("Склад", ЗначениеПоля);
	УстановитьСвойстваПолейОбработки("Склад", Новый Структура("Вывод, Значение", Ложь, ЗначениеПоля));
	
	ДанныеТовара.Свойство("Товар", Товар);
	УстановитьСвойстваПолейОбработки("Товар", Новый Структура("Использование, Значение", Истина, Товар));
	
	Если ДанныеТовара.Свойство("Характеристика", ЗначениеПоля) Тогда
		УстановитьСвойстваПолейОбработки("Характеристика", Новый Структура("Использование, Значение", Истина, ЗначениеПоля));
	КонецЕсли;
	СтандартныйМодуль.УстановитьСвойстваЭлементовВывода("Товар", "Высота", 2);
	
	Для Каждого РеквизитСерии Из Метаданные.Справочники.вмс_СерииНоменклатуры.Реквизиты Цикл
		ИмяПоля = РеквизитСерии.Имя;
		Ввод = ИсключенияВвода.Найти(ИмяПоля)=Неопределено;
		Вывод = ИсключенияВывода.Найти(ИмяПоля)=Неопределено;
		СвойстваПоля = Новый Структура("Ввод, Вывод, Сборка, Синоним, ТипЗначения, ЗначениеПоУмолчанию", Ввод, Вывод, Истина, РеквизитСерии.Синоним, РеквизитСерии.Тип, РеквизитСерии.Тип.ПривестиЗначение());
		УстановитьСвойстваПолейОбработки(ИмяПоля, СвойстваПоля);
	КонецЦикла;
	
	Если ПараметрыИнициализации.Свойство("ВидНоменклатуры") Тогда
		ВидНоменклатуры = ПараметрыИнициализации.ВидНоменклатуры;
	КонецЕсли;
	
	Если ВидНоменклатуры=Неопределено Тогда
		ИмяРеквизитаВладелецСерии = вмс_АдаптацияКонфигураций.ИмяРеквизитаНоменклатурыВладелецСерии();
		ВидНоменклатуры = вмс_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(Товар, ИмяРеквизитаВладелецСерии);
	КонецЕсли;
	
	УстановитьЗначениеДанныхПоляОбработки("ВидНоменклатуры", ВидНоменклатуры);
	
	УстановитьСвойстваПолейОбработки("КнопкаПодтвердить", Новый Структура("ТипЭлемента, Синоним", "КнопкаФормы", "ОК"));
	СтандартныйМодуль.УстановитьОбработчикиСобытийПолейОбработки("КнопкаПодтвердить", Новый Структура("Нажатие", НовыйОписаниеОповещения("ОбработчикНажатияКнопкиПодтвердить")));
	УстановитьСвойстваПолейОбработки("КнопкаПечать", Новый Структура("ТипЭлемента, Синоним", "КнопкаФормы", "Печать"));
	СтандартныйМодуль.УстановитьОбработчикиСобытийПолейОбработки("КнопкаПечать", Новый Структура("Нажатие", НовыйОписаниеОповещения("ОбработчикНажатияКнопкиПечать")));
	//3.2.5 ZAD-48:
	УстановитьСвойстваПолейОбработки("КнопкаНовыйНомер", Новый Структура("ТипЭлемента, Синоним", "КнопкаФормы", "Заполнить номер"));
	СтандартныйМодуль.УстановитьОбработчикиСобытийПолейОбработки("КнопкаНовыйНомер", Новый Структура("Нажатие", НовыйОписаниеОповещения("ОбработчикНажатияКнопкиНовыйНомер")));
	//3.2.5 ZAD-48:
	УстановитьСвойстваПолейОбработки("КнопкаОтмена", Новый Структура("ТипЭлемента, Синоним", "КнопкаФормы", "Отмена"));
	СтандартныйМодуль.УстановитьОбработчикиСобытийПолейОбработки("КнопкаОтмена", Новый Структура("Нажатие", НовыйОписаниеОповещения("ОбработчикНажатияКнопкиОтмена")));
	
	
	УстановитьТаблицуОбработки("ОстаткиСерий", "Серия, Ячейка, Остаток");
	УстановитьМестоположениеТаблицыОбработки("ОстаткиСерий", "ГлавнаяПанельСтраницаПланФакт");

	Если СостояниеОбработки.ПараметрыИнициализации.ВерсияМобильногоКлиента >= "2.1.3" Тогда
		// возможность указать вид группы доступна с версии "2.1.3"
		СтандартныйМодуль.СгруппироватьЭлементыВывода("ОстаткиСерийСерия, ОстаткиСерийЯчейка", "Вертикальная");
	КонецЕсли;
	УстановитьСвойстваЭлементовВывода("ОстаткиСерийОстаток", Новый Структура("Ширина", 1));
	
	Возврат УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция ДействиеЗакончитьИнициализациюПолейОбработки(Действие)
	
	СтандартныйМодуль.СгруппироватьЭлементыВывода("КнопкаПодтвердить, КнопкаПечать, КнопкаОтмена");
	//СтандартныйМодуль.СгруппироватьЭлементыВывода("Товар, ГоденДо", "Вертикальная");
	
КонецФункции

Функция ДействиеИнициализироватьПараметрыОбработки(Действие)
	
	Если ДействиеВыполняетсяПосле(Действие) Тогда
		ПустоеПолеОбработки = ПараметрыОбработки.ПустоеПолеОбработки;
		
		СоздаватьНовуюСерию = Ложь;
		
		ПараметрыИнициализации = СостояниеОбработки.ПараметрыИнициализации;
		Если ТипЗнч(ПараметрыИнициализации)=Тип("Структура") Тогда
			СоздаватьНовуюСерию = ПараметрыИнициализации.Свойство("СоздаватьНовуюСерию") И ПараметрыИнициализации.СоздаватьНовуюСерию=Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ДействиеИнициализироватьДанныеОбработки(Действие)
	
КонецФункции

Функция ЗаполнитьТаблицуОстатковСерий()
	
	ПараметрыИнициализации = СостояниеОбработки.ПараметрыИнициализации;
	
	Если ПараметрыИнициализации.Свойство("ТаблицаОстатков") Тогда
		ТаблицаОстатков = ПараметрыИнициализации.ТаблицаОстатков;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	вмс_ОперацияПоЯчейкамОстатки.Серия КАК Серия,
		|	вмс_ОперацияПоЯчейкамОстатки.Ячейка КАК Ячейка,
		|	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(
		|			,
		|			Товар = &Товар
		|				И Ячейка.Владелец = &Склад) КАК вмс_ОперацияПоЯчейкамОстатки";
		Запрос.УстановитьПараметр("Склад", ПолучитьЗначениеДанныхПоляОбработки("Склад"));
		Запрос.УстановитьПараметр("Товар", ПолучитьЗначениеДанныхПоляОбработки("Товар"));
		РезультатЗапроса = Запрос.Выполнить();
		ТаблицаОстатков = РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
	РК.УстановитьЭлементыКоллекции(ДанныеОбработки.Таблицы.ОстаткиСерий, ТаблицаОстатков);
	
КонецФункции

Функция	ДействиеИнициализироватьЭтапыВводаДанных(Действие)
	
	Если ДействиеВыполняетсяПосле(Действие) Тогда
		
		ДобавитьЭтапВводаДанных("ОбработчикЭтапаВводаДанных_СохранениеДанных", "СохранениеДанных");
		
	КонецЕсли;
	
КонецФункции

Функция ДействиеНачалоОбработки(Действие)
	
	ЗаполнитьТаблицуОстатковСерий();
	
	Серия = ПолучитьЗначениеДанныхПоляОбработки("Серия");
	ЗаполнитьРеквизитыСерии(Серия);
	
КонецФункции

Функция ДействиеПриОткрытииФормыОбработки(Действие)
	
	УстановитьЗаголовокФормы("Ввод серии");
	
КонецФункции

Функция ДействиеВыборЭлементаТаблицы(Действие)
	
	ИмяТаблицы = Действие.Параметры.ИмяТаблицы;
	
	ЭлементТаблицы = ПолучитьЭлементТаблицыПоИдентификатору(ИмяТаблицы, Действие.Параметры.ИдентификаторЭлемента);
	
	Если ИмяТаблицы="ОстаткиСерий" Тогда
		
		ЗаполнитьРеквизитыСерии(ЭлементТаблицы.Серия);
		УстановитьЗначениеДанныхПоляОбработки("Ячейка", ЭлементТаблицы.Ячейка);
		СтандартныйМодуль.ПереключитьСтраницу("ВводДанных");
		
		//Результат = Новый Структура("Серия", ЭлементТаблицы.Серия);
		//вмс_СерверУправляемыеОбработки.ЗавершитьРаботуОбработки(ПараметрыОбработки, Результат);
	КонецЕсли;
	
КонецФункции

Функция ЗаполнитьРеквизитыСерии(Серия)
	
	СписокПолейВвода = СписокПолейОбработки(Новый Структура("Ввод", Истина));
	ДанныеПолей = вмс_ОбщегоНазначенияВызовСервера.ПолучитьЗначенияРеквизитовОбъекта(Серия, СписокПолейВвода);
	СтандартныйМодуль.ВвестиДанные(ДанныеПолей);
	
	//установим явно ссылку на серию после поиска по реквизитам (устраняет проблему с дублями серии)
	//поиск по реквизитам будет использован при редактировании реквизитов серии пользователем
	УстановитьЗначениеДанныхПоляОбработки("Серия", Серия);
	
КонецФункции

