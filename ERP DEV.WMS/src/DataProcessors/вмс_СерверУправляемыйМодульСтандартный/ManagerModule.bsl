Функция НачатьТранзакциюОбработки(ПараметрыОбработки) Экспорт

	СкопироватьДанныеВТранзакцию(ПараметрыОбработки);
	
	ДанныеТранзакции = ПараметрыОбработки.ДанныеТранзакции;
	ДанныеТранзакции.Активна = Истина;
	ДанныеТранзакции.Прервать = Ложь;
	ДанныеТранзакции.Отменить = Ложь;
	Возврат Истина;
	
КонецФункции

Функция СкопироватьДанныеВТранзакцию(ПараметрыОбработки) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ДанныеТранзакции = ПараметрыОбработки.ДанныеТранзакции;
	ДанныеОбработки = ПараметрыОбработки.Данные;
	
	СкопироватьПоляОбработки(ДанныеТранзакции.ПоляОбработки, ПараметрыОбработки.ПоляОбработки, ПараметрыОбработки, Ложь);
	ДанныеТранзакции.Вставить("ВходящиеДанные", СкопироватьВходящиеДанные(ДанныеОбработки.ВходящиеДанные));
	ДанныеТранзакции.Вставить("ПринятыеДанныеПолей", РК.СкопироватьОбъект(ДанныеОбработки.ПринятыеДанныеПолей));
	ДанныеТранзакции.Вставить("ВведенныеДанныеПолей", РК.СкопироватьОбъект(ДанныеОбработки.ВведенныеДанныеПолей));
	ДанныеТранзакции.Вставить("СтатическиеДанныеПолей", РК.СкопироватьОбъект(ДанныеОбработки.СтатическиеДанныеПолей));
	ДанныеТранзакции.Вставить("ЗапланированныеДанныеПолей", РК.СкопироватьОбъект(ДанныеОбработки.ЗапланированныеДанныеПолей));
	ДанныеТранзакции.Вставить("СобранныеДанныеПолей", РК.СкопироватьОбъект(ДанныеОбработки.СобранныеДанныеПолей));
	ДанныеТранзакции.Вставить("ОбщиеДанныеПолей", РК.СкопироватьОбъект(ДанныеОбработки.ОбщиеДанныеПолей));
	ДанныеТранзакции.Вставить("ПредставлениеДанныхПолей", РК.СкопироватьОбъект(ДанныеОбработки.ПредставлениеДанныхПолей));
	
	ДанныеТранзакции.Вставить("РезультатАнализаЗаполненияПолейДанныхВвода", РК.СкопироватьСтруктуру(ДанныеОбработки.РезультатАнализаЗаполненияПолейДанныхВвода));
	ДанныеТранзакции.Вставить("РезультатАнализаЗаполненияПолейДанныхПлана", РК.СкопироватьСтруктуру(ДанныеОбработки.РезультатАнализаЗаполненияПолейДанныхПлана));
	ДанныеТранзакции.Вставить("РезультатАнализаЗаполненияПолейДанныхСборки", РК.СкопироватьСтруктуру(ДанныеОбработки.РезультатАнализаЗаполненияПолейДанныхСборки));
	ДанныеТранзакции.Вставить("РезультатАнализаЗаполненияПолейОбщихДанных", РК.СкопироватьСтруктуру(ДанныеОбработки.РезультатАнализаЗаполненияПолейОбщихДанных));
	
КонецФункции

Функция СкопироватьПоляОбработки(ПоляПриемник, ПоляИсточник, ПараметрыОбработки, ОбрабатыватьУстановкуСвойств) Экспорт
	
	ПоляПриемник.Очистить();
	
	ПустойЭлементВывода = ПараметрыОбработки.ПустойЭлементВывода;
	ЭлементыВывода = ПараметрыОбработки.ЭлементыВывода;
	
	ПоискПоИмени = Новый Структура("Имя");
	
	Для Каждого ПолеИсточник Из ПоляИсточник Цикл
		ПолеПриемник = ПоляПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(ПолеПриемник, ПолеИсточник, , "События");
		
		СобытияПриемник = Новый Структура;
		СобытияПриемник.Очистить();
		Для Каждого Событие Из ПолеИсточник.События Цикл
			СобытияПриемник.Вставить(Событие.Ключ, Событие.Значение);
		КонецЦикла;
		
		ПолеПриемник.События = СобытияПриемник;

		Если ОбрабатыватьУстановкуСвойств Тогда
			// передать значения свойств в элемент вывода
			СвойстваЭлементаВывода = Новый Структура;
			ПоискПоИмени.Имя = ПолеПриемник.ИмяЭлементаВывода;
			ЭлементВыводаМассив = ЭлементыВывода.НайтиСтроки(ПоискПоИмени);
			Если ЭлементВыводаМассив.Количество() > 0 Тогда
				ЭлементВывода = ЭлементВыводаМассив[0];
				Если ЭлементВывода.Видимость <> ПолеПриемник.Вывод Тогда
					СвойстваЭлементаВывода.Вставить("Видимость", ПолеПриемник.Вывод);
				КонецЕсли;

				Если СвойстваЭлементаВывода.Количество() > 0 Тогда
					УстановитьСвойстваЭлементовВывода(ПараметрыОбработки, ЭлементВывода, СвойстваЭлементаВывода);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция ЗафиксироватьТранзакциюОбработки(ПараметрыОбработки) Экспорт

	РК = вмс_РаботаСКоллекциями;
	
	ДанныеТранзакции = ПараметрыОбработки.ДанныеТранзакции;
	ДанныеОбработки = ПараметрыОбработки.Данные;

	ДанныеТранзакции.Активна = Ложь;

	//РК.УстановитьЭлементыКоллекции(ПараметрыОбработки.ПоляОбработки, ДанныеТранзакции.ПоляОбработки);
	СкопироватьПоляОбработки(ПараметрыОбработки.ПоляОбработки, ДанныеТранзакции.ПоляОбработки, ПараметрыОбработки, Истина);
	ДанныеОбработки.ВходящиеДанные = СкопироватьВходящиеДанные(ДанныеТранзакции.ВходящиеДанные);
	РК.СкопироватьПоляСтруктуры(ДанныеТранзакции.ПринятыеДанныеПолей, ДанныеОбработки.ПринятыеДанныеПолей);
	ЗаполнитьЗначенияСвойств(ДанныеОбработки.ВведенныеДанныеПолей, ДанныеТранзакции.ВведенныеДанныеПолей);
	ЗаполнитьЗначенияСвойств(ДанныеОбработки.ЗапланированныеДанныеПолей, ДанныеТранзакции.ЗапланированныеДанныеПолей);
	ЗаполнитьЗначенияСвойств(ДанныеОбработки.СобранныеДанныеПолей, ДанныеТранзакции.СобранныеДанныеПолей);
	ЗаполнитьЗначенияСвойств(ДанныеОбработки.ОбщиеДанныеПолей, ДанныеТранзакции.ОбщиеДанныеПолей);
	РК.СкопироватьПоляСтруктуры(ДанныеТранзакции.СтатическиеДанныеПолей, ДанныеОбработки.СтатическиеДанныеПолей);
	ЗаполнитьЗначенияСвойств(ДанныеОбработки.ПредставлениеДанныхПолей, ДанныеТранзакции.ПредставлениеДанныхПолей);

	ДанныеОбработки.РезультатАнализаЗаполненияПолейДанныхВвода = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхВвода;
	ДанныеОбработки.РезультатАнализаЗаполненияПолейДанныхПлана = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхПлана;
	ДанныеОбработки.РезультатАнализаЗаполненияПолейДанныхСборки = ДанныеТранзакции.РезультатАнализаЗаполненияПолейДанныхСборки;
	ДанныеОбработки.РезультатАнализаЗаполненияПолейОбщихДанных = ДанныеТранзакции.РезультатАнализаЗаполненияПолейОбщихДанных;
	
КонецФункции
#КонецЕсли
