Функция НовыеПоляОбработки() Экспорт
	
	РК = вмс_РаботаСКоллекциями;

	ПоляОбработки = РК.НоваяТаблицаЗначений("
	
		|Имя, ПутьКДаннымСохранения, ПутьКДаннымЗаполнения, ПутьРодителяДанныхЗаполнения, ПутьРодителяДанныхСохранения, Использование,
		|Ввод, Сборка, План, Вывод, ПорядокВвода, ПорядокВывода, ОбязательныйВвод, ОбязательноеЗаполнение, Ресурс, Группа, Суффикс,
		|ТипЗначения, Значение, ЗначениеУстановлено, НачальноеЗначение, ЗначениеПоУмолчанию, ПустыеЗначения, СписокВыбора, АвтоНачалоВыбора,
		
		|ИмяЭлементаВывода, ПоложениеЗаголовка, Страница, События, ТипЭлемента, Синоним, СинонимРодительныйПадеж, СинонимВинительныйПадеж, Пол,
		|Шрифт
		
	|");
	
	ПоляОбработки.Индексы.Добавить("Имя");
	
	Возврат ПоляОбработки;
	
КонецФункции

Функция ИнициализироватьДанныеПолейОбработки(ПараметрыОбработки)
	
	ДанныеОбработки = ПараметрыОбработки.Данные;
	
	ДанныеОбработки.Вставить("ВходящиеДанные", НовыеВходящиеДанные());
	ДанныеОбработки.Вставить("ПринятыеДанныеПолей", Новый Структура); //отфильтрованные и типизированные данные входящих полей для ввода
	ДанныеОбработки.Вставить("ВведенныеДанныеПолей", Новый Структура);
	ДанныеОбработки.Вставить("СтатическиеДанныеПолей", Новый Структура);
	ДанныеОбработки.Вставить("ЗапланированныеДанныеПолей", Новый Структура);
	ДанныеОбработки.Вставить("СобранныеДанныеПолей", Новый Структура);
	ДанныеОбработки.Вставить("ОбщиеДанныеПолей", Новый Структура);
	ДанныеОбработки.Вставить("ПредыдущиеВведенныеДанныеПолей", Новый Структура); //для отслеживания изменений во введенных данных
	ДанныеОбработки.Вставить("ПредставлениеДанныхПолей", Новый Структура);
	ДанныеОбработки.Вставить("РезультатАнализаЗаполненияПолейДанныхВвода", Обработки.вмс_СерверУправляемыйМодульСборщикДанных.НовыйРезультатАнализаЗаполненияПолейДанных());
	ДанныеОбработки.Вставить("РезультатАнализаЗаполненияПолейДанныхПлана", Обработки.вмс_СерверУправляемыйМодульСборщикДанных.НовыйРезультатАнализаЗаполненияПолейДанных());
	ДанныеОбработки.Вставить("РезультатАнализаЗаполненияПолейОбщихДанных", Обработки.вмс_СерверУправляемыйМодульСборщикДанных.НовыйРезультатАнализаЗаполненияПолейДанных());
	ДанныеОбработки.Вставить("РезультатАнализаЗаполненияПолейДанныхСборки", Обработки.вмс_СерверУправляемыйМодульСборщикДанных.НовыйРезультатАнализаЗаполненияПолейДанных());
	
	Возврат Истина;

КонецФункции

//возвращает всю таблицу полей или массив полей по отбору
Функция ПоляОбработки(ПараметрыОбработки, знач Отбор=Неопределено) Экспорт

	РК = вмс_РаботаСКоллекциями;
	
	Если ПараметрыОбработки.ДанныеТранзакции.Активна Тогда
		ПоляОбработки = ПараметрыОбработки.ДанныеТранзакции.ПоляОбработки;
	Иначе
		ПоляОбработки = ПараметрыОбработки.ПоляОбработки;
	КонецЕсли;
	
	ТипОтбора = ТипЗнч(Отбор);
	
	ПустоеПолеОбработки = ПараметрыОбработки.ПустоеПолеОбработки;
	
	Если Отбор=ПустоеПолеОбработки Тогда
		
		Отбор = Новый Массив;
		
	ИначеЕсли Отбор=Неопределено ИЛИ Отбор=ПоляОбработки Тогда
		
		//вернуть всю таблицу полей
		Возврат ПоляОбработки;
		
	ИначеЕсли ТипОтбора=Тип("Структура") Тогда
		
		Если Отбор.Свойство("Имя") Тогда
			ВыбранныеПоля = Новый Массив;
			ИменаПолей = РК.ЗначениеВМассив(Отбор.Имя, , Ложь);
			//обработка имен нескольких полей
			Отбор = РК.СкопироватьСтруктуру(Отбор);
			Для Каждого ИмяПоля Из ИменаПолей Цикл
				Отбор.Имя = ИмяПоля;
				Для Каждого Поле Из ПоляОбработки.НайтиСтроки(Отбор) Цикл
					ВыбранныеПоля.Добавить(Поле);
				КонецЦикла;
			КонецЦикла;
			
		Иначе
			//обычный поиск
			ВыбранныеПоля = ПоляОбработки.НайтиСтроки(Отбор);
		КонецЕсли;
		
		Возврат ВыбранныеПоля;
		
	ИначеЕсли ТипОтбора=Тип("Строка") Тогда
		
		Отбор = РК.СтрокуВМассив(Отбор);
		
	ИначеЕсли ТипОтбора <> Тип("Массив") Тогда
		
		ЭлементОтбора = Отбор;
		Отбор = Новый Массив;
		Отбор.Добавить(ЭлементОтбора);
		
	КонецЕсли;
	
	ВыбранныеПоля = Новый Массив;
	ОтборПоИмени = Новый Структура("Имя");
	Для Каждого Элемент Из Отбор Цикл
		
		Если Элемент=ПустоеПолеОбработки Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента=Тип("Строка") Тогда
			ОтборПоИмени.Имя = Элемент;
			Для Каждого Поле Из ПоляОбработки.НайтиСтроки(ОтборПоИмени) Цикл
				ВыбранныеПоля.Добавить(Поле);
			КонецЦикла;
		ИначеЕсли ТипЭлемента=Тип("СтрокаТаблицыЗначений") Тогда
			Если ПоляОбработки.Индекс(Элемент) > -1 Тогда
				ВыбранныеПоля.Добавить(Элемент);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВыбранныеПоля;
	
КонецФункции

Функция ПолеОбработки(ПараметрыОбработки, Отбор) Экспорт
	
	Поля = ПоляОбработки(ПараметрыОбработки, Отбор);
	
	Если Поля.Количество()=1 Тогда
		Возврат Поля[0];
	КонецЕсли;
	
	Возврат ПараметрыОбработки.ПустоеПолеОбработки;
	
КонецФункции

Функция ПолучитьПолеОбработки(ПараметрыОбработки, Отбор) Экспорт
	
	Поля = ПолучитьПоляОбработки(ПараметрыОбработки, Отбор);
	
	Если Поля.Количество() > 0 Тогда
		Возврат Поля[0];
	КонецЕсли;
	
КонецФункции

//возвращает поля с указанными именами, если поля нет, то создает новое
Функция ПолучитьПоляОбработки(ПараметрыОбработки, знач Поля=Неопределено) Экспорт

	РК = вмс_РаботаСКоллекциями;

	ПоляОбработки = ПоляОбработки(ПараметрыОбработки);
	
	Если Поля=Неопределено ИЛИ Поля=ПоляОбработки Тогда
		Возврат ПоляОбработки;
	КонецЕсли;
	
	Если ТипЗнч(Поля)=Тип("Массив") Тогда
		ПоляМассив = Поля;
	ИначеЕсли ТипЗнч(Поля)=Тип("Строка") Тогда
		ПоляМассив = СтрРазделить(СтрЗаменить(Поля, " ", ""), ",", Ложь);
	Иначе
		ПоляМассив = Новый Массив;
		ПоляМассив.Добавить(Поля);
	КонецЕсли;

	Поля = Новый Массив;
	Отбор = Новый Структура("Имя");
	ПустоеПолеОбработки = ПараметрыОбработки.ПустоеПолеОбработки;
	Для Каждого Поле Из ПоляМассив Цикл
		
		Если Поле=ПустоеПолеОбработки Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Поле)=Тип("Строка") Тогда

			ИмяПоля = Поле;
			Отбор.Имя = ИмяПоля;
			ПолеМассив = ПоляОбработки.НайтиСтроки(Отбор);
			Если ПолеМассив.Количество()=0 Тогда
				Поле = НовоеПолеОбработки(ПараметрыОбработки, ИмяПоля);
			Иначе
				Поле = ПолеМассив[0];
			КонецЕсли;

			Поля.Добавить(Поле);
			
		ИначеЕсли ТипЗнч(Поле)=Тип("СтрокаТаблицыЗначений") Тогда
			
			Если ПоляОбработки.Индекс(Поле) > -1 Тогда
				Поля.Добавить(Поле);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Поля;

КонецФункции

Функция НовоеПолеОбработки(ПараметрыОбработки, Имя)

	ПорядокВвода = ПараметрыОбработки.ПорядокВводаНовогоПоляОбработки;
	ПараметрыОбработки.ПорядокВводаНовогоПоляОбработки = ПорядокВвода + 1;

	Поле = ПараметрыОбработки.ПоляОбработки.Добавить();
	Поле.Имя = Имя;
	Поле.Страница = "ГлавнаяПанельСтраницаВводДанных";
	Поле.ПутьКДаннымСохранения = "";
	Поле.ПутьКДаннымЗаполнения = "";
	Поле.ИмяЭлементаВывода = Имя;
	Поле.Использование = Ложь;
	Поле.Ввод = Ложь;
	Поле.Сборка = Ложь;
	Поле.План = Ложь;
	Поле.Вывод = Истина;
	Поле.Ресурс = Ложь;
	Поле.ОбязательныйВвод = Ложь;
	Поле.ОбязательноеЗаполнение = Истина;
	Поле.ПустыеЗначения = Новый Массив;
	Поле.ПустыеЗначения.Добавить(Неопределено);
	Поле.ЗначениеУстановлено = Ложь;
	Поле.События = Новый Структура;
	Поле.ПорядокВвода = ПорядокВвода;
	Поле.ПорядокВывода = ПорядокВвода;
	Поле.АвтоНачалоВыбора = Ложь;
	Поле.ТипЗначения = Новый ОписаниеТипов("Строка");
	Поле.Шрифт = Новый Шрифт;
	
	Возврат Поле;
	
КонецФункции

Функция УстановитьСвойстваПолейОбработки(ПараметрыОбработки, Поля=Неопределено, знач Свойства=Неопределено, Значение=Неопределено) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	Если ТипЗнч(Свойства)=Тип("Строка") Тогда
		Свойства = Новый Структура(Свойства);
		Для Каждого ЭлементСвойства Из Свойства Цикл
			Свойства.Вставить(ЭлементСвойства.Ключ, Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЗнч(Свойства)=Тип("СтрокаТаблицыЗначений") Тогда
		// передали элемент поля
		ПолеИсточник = Свойства;
		Свойства = Новый Структура(ПараметрыОбработки.СвойстваПолейОбработкиБезИмени);
		ЗаполнитьЗначенияСвойств(Свойства, ПолеИсточник);
	КонецЕсли;
	
	Если ТипЗнч(Свойства) <> Тип("Структура") Тогда
		Свойства = Новый Структура;
	КонецЕсли;
	
	Если Свойства.Свойство("Имя") Тогда
		ВызватьИсключение "Свойство поля обработки ""Имя"" недоступно для изменения";
	КонецЕсли;
	
	Если НЕ Свойства.Свойство("Использование") Тогда
		Свойства.Вставить("Использование", Истина);
	КонецЕсли;
	
	ДанныеТранзакции = ПараметрыОбработки.ДанныеТранзакции;
	Если ДанныеТранзакции.Активна Тогда
		ДанныеОбработки = ДанныеТранзакции;
	Иначе
		ДанныеОбработки = ПараметрыОбработки.Данные;
	КонецЕсли;
	
	ЗначениеСвойства = Неопределено;
	Для Каждого Поле Из ПолучитьПоляОбработки(ПараметрыОбработки, Поля) Цикл
		
		ИзмененныеСвойства = Новый Структура;
		Для Каждого ЭлементСвойства Из Свойства Цикл
			
			ИмяСвойства = ЭлементСвойства.Ключ;
			ТекущееЗначение = Поле[ИмяСвойства];
			ТипЗначения = ТипЗнч(ТекущееЗначение);
			НовоеЗначение = ЭлементСвойства.Значение;
			Если ТипЗначения=Тип("Структура") Тогда
				РК.УстановитьЭлементыКоллекции(ТекущееЗначение, НовоеЗначение);
			ИначеЕсли ТипЗначения=Тип("Массив") Тогда
				РК.УстановитьЭлементыКоллекции(ТекущееЗначение, РК.ЗначениеВМассив(НовоеЗначение));
			ИначеЕсли ТекущееЗначение <> НовоеЗначение Тогда
				Поле[ИмяСвойства] = НовоеЗначение;
				ИзмененныеСвойства.Вставить(ИмяСвойства, НовоеЗначение);
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ Свойства.Свойство("ЗначениеУстановлено") ИЛИ Свойства.ЗначениеУстановлено Тогда
			Если ИзмененныеСвойства.Свойство("Значение", ЗначениеСвойства) ИЛИ Свойства.Свойство("Значение", ЗначениеСвойства) И НЕ Поле.ЗначениеУстановлено Тогда
				Поле.ЗначениеУстановлено = Истина;
				ДанныеОбработки.СтатическиеДанныеПолей.Вставить(Поле.Имя, ЗначениеСвойства);
			ИначеЕсли Свойства.Свойство("ЗначениеУстановлено") Тогда
				ДанныеОбработки.СтатическиеДанныеПолей.Вставить(Поле.Имя, Поле.Значение);
			КонецЕсли;
		Иначе
			ДанныеОбработки.СтатическиеДанныеПолей.Удалить(Поле.Имя);
		КонецЕсли;
		
		Если ИзмененныеСвойства.Свойство("ПутьКДаннымЗаполнения") Тогда
			Поле.ПутьРодителяДанныхЗаполнения = ПрочитатьПутьРодителяДанныхПоля(ПараметрыОбработки, Поле, "ПутьКДаннымЗаполнения");
		КонецЕсли;

		Если ИзмененныеСвойства.Свойство("ПутьКДаннымСохранения") Тогда
			Поле.ПутьРодителяДанныхСохранения = ПрочитатьПутьРодителяДанныхПоля(ПараметрыОбработки, Поле, "ПутьКДаннымСохранения");
		КонецЕсли;
		
		Если ИзмененныеСвойства.Свойство("ПорядокВвода", ЗначениеСвойства) Тогда
			Если ЗначениеСвойства >= ПараметрыОбработки.ПорядокВводаНовогоПоляОбработки Тогда
				ПараметрыОбработки.ПорядокВводаНовогоПоляОбработки = ЗначениеСвойства + 1;
			КонецЕсли;
		КонецЕсли;
		
		Если ИзмененныеСвойства.Свойство("ТипЗначения", ЗначениеСвойства) Тогда
			
			Если ТипЗнч(ЗначениеСвойства) <> Тип("ОписаниеТипов") Тогда
				Если ТипЗнч(ЗначениеСвойства)=Тип("Строка") Тогда
					ЗначениеСвойства = Тип(ЗначениеСвойства);
				КонецЕсли;
				
				Если ТипЗнч(ЗначениеСвойства)=Тип("Тип") Тогда
					Тип = ЗначениеСвойства;
					ЗначениеСвойства = Новый Массив;
					ЗначениеСвойства.Добавить(Тип);
				КонецЕсли;
				
				Если ТипЗнч(ЗначениеСвойства)=Тип("Массив") Тогда
					ЗначениеСвойства = Новый ОписаниеТипов(ЗначениеСвойства);
				КонецЕсли;
				
				ИзмененныеСвойства.ТипЗначения = ЗначениеСвойства;
					
				Поле.ТипЗначения = ЗначениеСвойства;
			КонецЕсли;
			
		КонецЕсли;
			
		Если ИзмененныеСвойства.Свойство("Использование", ЗначениеСвойства) Тогда
			
			Если ЗначениеСвойства Тогда
				
				Если Поле.Ввод Тогда
					ДанныеОбработки.ВведенныеДанныеПолей.Вставить(Поле.Имя, Поле.НачальноеЗначение);
				КонецЕсли;
				
				Если Поле.ЗначениеУстановлено Тогда
					ДанныеОбработки.СтатическиеДанныеПолей.Вставить(Поле.Имя, Поле.Значение);
				КонецЕсли;

				Если Поле.План Тогда
					ДанныеОбработки.ЗапланированныеДанныеПолей.Вставить(Поле.Имя, Поле.НачальноеЗначение);
				КонецЕсли;

				Если Поле.Сборка Тогда
					ДанныеОбработки.СобранныеДанныеПолей.Вставить(Поле.Имя, Поле.НачальноеЗначение);
				КонецЕсли;

				ДанныеОбработки.ОбщиеДанныеПолей.Вставить(Поле.Имя, Поле.НачальноеЗначение);

				Если Поле.Вывод Тогда
					ДанныеОбработки.ПредставлениеДанныхПолей.Вставить(Поле.Имя, "");
				КонецЕсли;
				
				Если НЕ ИзмененныеСвойства.Свойство("ТипЗначения") Тогда
					АвтоопределениеТипаЗначенияПоляОбработки(Поле, ИзмененныеСвойства);
				КонецЕсли;
				
			Иначе
				ДанныеОбработки.ВведенныеДанныеПолей.Удалить(Поле.Имя);
				ДанныеОбработки.СтатическиеДанныеПолей.Удалить(Поле.Имя);
				ДанныеОбработки.ЗапланированныеДанныеПолей.Удалить(Поле.Имя);
				ДанныеОбработки.СобранныеДанныеПолей.Удалить(Поле.Имя);
				ДанныеОбработки.ОбщиеДанныеПолей.Удалить(Поле.Имя);
				ДанныеОбработки.ПредставлениеДанныхПолей.Удалить(Поле.Имя);
			КонецЕсли;
			
		ИначеЕсли Поле.Использование Тогда
			
			Если ИзмененныеСвойства.Свойство("Ввод", ЗначениеСвойства) Тогда
				Если ЗначениеСвойства Тогда
					ДанныеОбработки.ВведенныеДанныеПолей.Вставить(Поле.Имя, Поле.НачальноеЗначение);
				Иначе
					// может быть динамический ввод
					//ДанныеОбработки.ВведенныеДанныеПолей.Удалить(Поле.Имя);
				КонецЕсли;
			КонецЕсли;
			
			Если ИзмененныеСвойства.Свойство("План", ЗначениеСвойства) Тогда
				Если ЗначениеСвойства Тогда
					ДанныеОбработки.ЗапланированныеДанныеПолей.Вставить(Поле.Имя, Поле.НачальноеЗначение);
				Иначе
					//ДанныеОбработки.ЗапланированныеДанныеПолей.Удалить(Поле.Имя);
				КонецЕсли;
			КонецЕсли;
			
			Если ИзмененныеСвойства.Свойство("Сборка", ЗначениеСвойства) Тогда
				Если ЗначениеСвойства Тогда
					ДанныеОбработки.СобранныеДанныеПолей.Вставить(Поле.Имя, Поле.НачальноеЗначение);
				Иначе
					//ДанныеОбработки.СобранныеДанныеПолей.Удалить(Поле.Имя);
				КонецЕсли;
			КонецЕсли;
			
			Если ИзмененныеСвойства.Свойство("Вывод", ЗначениеСвойства) Тогда
				Если ЗначениеСвойства Тогда
					ДанныеОбработки.ПредставлениеДанныхПолей.Вставить(Поле.Имя, "");
				Иначе
					//ДанныеОбработки.ПредставлениеДанныхПолей.Удалить(Поле.Имя);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		ПередатьСвойстваПоляОбработкиВЭлементФормы(ПараметрыОбработки, Поле, ИзмененныеСвойства);
		
	КонецЦикла;
	
КонецФункции

Функция АвтоопределениеТипаЗначенияПоляОбработки(Поле, ИзмененныеСвойства)
	
	// определим по типам списка выбора
	СписокВыбора = Поле.СписокВыбора;
	Если ТипЗнч(СписокВыбора)=Тип("СписокЗначений") И ЗначениеЗаполнено(СписокВыбора) Тогда
		Типы = Новый Массив;
		Для Каждого ЭлементСписка Из СписокВыбора Цикл
			Типы.Добавить(ТипЗнч(ЭлементСписка.Значение));
		КонецЦикла;
		
		ИзмененныеСвойства.Вставить("ТипЗначения", Новый ОписаниеТипов(Типы));
		Поле.ТипЗначения = ИзмененныеСвойства.ТипЗначения;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
		
КонецФункции

Функция ПередатьСвойстваПоляОбработкиВЭлементФормы(ПараметрыОбработки, Поле, ИзмененныеСвойства)
	
	ПередатьСвойстваПолейВЭлементВывода = ПараметрыОбработки.ПередатьСвойстваПолейВЭлементВывода;
	
	СвойстваЭлементаВывода = Новый Структура;

	Если ИзмененныеСвойства.Свойство("Использование") И ИзмененныеСвойства.Использование Тогда
		
		// при включении поля транслируем все свойства в элемент вывода
		Для Каждого ТранслироватьСвойство Из ПередатьСвойстваПолейВЭлементВывода Цикл
			СвойстваЭлементаВывода.Вставить(ТранслироватьСвойство.Значение, Поле[ТранслироватьСвойство.Ключ]);
		КонецЦикла;
		
		Если СвойстваЭлементаВывода.Свойство("СписокВыбора") И СвойстваЭлементаВывода.СписокВыбора=Неопределено Тогда
			СвойстваЭлементаВывода.Удалить("СписокВыбора");
		КонецЕсли;

		Если СвойстваЭлементаВывода.Свойство("ПоложениеЗаголовка") И СвойстваЭлементаВывода.ПоложениеЗаголовка=Неопределено Тогда
			СвойстваЭлементаВывода.Удалить("ПоложениеЗаголовка");
		КонецЕсли;
		
	Иначе
		
		Для Каждого ИзмененноеСвойство Из ИзмененныеСвойства Цикл
			ИмяСвойства = ИзмененноеСвойство.Ключ;
			НовоеЗначение = ИзмененноеСвойство.Значение;
			ИмяСвойстваЭлементаВывода = ПередатьСвойстваПолейВЭлементВывода[ИмяСвойства];
			Если ИмяСвойстваЭлементаВывода <> Неопределено Тогда
				СвойстваЭлементаВывода.Вставить(ИмяСвойстваЭлементаВывода, НовоеЗначение);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если СвойстваЭлементаВывода.Количество() > 0 Тогда
		УстановитьСвойстваЭлементовВывода(ПараметрыОбработки, Поле.ИмяЭлементаВывода, СвойстваЭлементаВывода, , Ложь);
	КонецЕсли;
	
КонецФункции

Функция ПолучитьКоличествоЭлементовВыводаРодителя(ПараметрыОбработки, Родитель)

	Возврат ПараметрыОбработки.ЭлементыВывода.НайтиСтроки(Новый Структура("Родитель", Родитель)).Количество();

КонецФункции

Функция УдалитьПоляОбработки(ПараметрыОбработки, Поля=Неопределено) Экспорт
	
	Возврат вмс_РаботаСКоллекциями.УдалитьЭлементыКоллекции(ПоляОбработки(ПараметрыОбработки), ПоляОбработки(ПараметрыОбработки, Поля));
	
КонецФункции

Функция ПодготовитьДанныеПолейОбработки(ПараметрыОбработки) Экспорт
	
	ДанныеОбработки = ПараметрыОбработки.Данные;
	
	ДанныеОбработки.ВведенныеДанныеПолей.Очистить();
	ДанныеОбработки.ЗапланированныеДанныеПолей.Очистить();
	ДанныеОбработки.СобранныеДанныеПолей.Очистить();
	ДанныеОбработки.ОбщиеДанныеПолей.Очистить();
	ДанныеОбработки.ПредставлениеДанныхПолей.Очистить();
	
	Для Каждого Поле Из ПоляОбработки(ПараметрыОбработки) Цикл
		
		ИмяПоля = Поле.Имя;
		
		Если Поле.Ввод Тогда
			ДанныеОбработки.ВведенныеДанныеПолей.Вставить(ИмяПоля);
		КонецЕсли;
		
		Если Поле.План Тогда
			ДанныеОбработки.ЗапланированныеДанныеПолей.Вставить(ИмяПоля);
		КонецЕсли;

		ДанныеОбработки.ОбщиеДанныеПолей.Вставить(ИмяПоля);

		Если Поле.Сборка Тогда
			ДанныеОбработки.СобранныеДанныеПолей.Вставить(ИмяПоля);
		КонецЕсли;
		
		Если Поле.Вывод Тогда
			ДанныеОбработки.ПредставлениеДанныхПолей.Вставить(ИмяПоля);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция УстановитьЗначениеДанныхПоляОбработки(ПараметрыОбработки, Поле, Значение) Экспорт
	
	Возврат УстановитьСвойстваПолейОбработки(ПараметрыОбработки, Поле, "Значение", Значение);
	
КонецФункции

Функция ПолучитьЗначениеДанныхПоляОбработки(ПараметрыОбработки, ИмяПоля) Экспорт
	
	Возврат ПолучитьЗначениеСвойстваПоляОбработки(ПараметрыОбработки, ИмяПоля, "Значение");
	
КонецФункции

Функция ОчиститьЗначениеДанныхПоляОбработки(ПараметрыОбработки, ИмяПоля, Значение) Экспорт
	
	ПараметрыОбработки.Данные.СтатическиеДанныеПолей.Удалить(ИмяПоля);
	
КонецФункции

Функция ПолучитьЗначениеСвойстваПоляОбработки(ПараметрыОбработки, знач Поле, ИмяСвойства) Экспорт
	
	Поле = ПолеОбработки(ПараметрыОбработки, Поле);
	
	Если Поле <> ПараметрыОбработки.ПустоеПолеОбработки Тогда
		
		Возврат Поле[ИмяСвойства];
		
	КонецЕсли;
	
КонецФункции

Функция УстановитьПоляВводаОбработки(ПараметрыОбработки, Поля) Экспорт
	
	ПорядокВвода = 1;
	
	Для Каждого Поле Из ПолучитьПоляОбработки(ПараметрыОбработки, Поля) Цикл
		
		УстановитьСвойстваПолейОбработки(ПараметрыОбработки, Поле, Новый Структура("Ввод, Сборка, ОбязательныйВвод, Использование, ПорядокВывода", Истина, Истина, Истина, Истина, ПорядокВвода));
		
		ПорядокВвода = ПорядокВвода + 1;
		
	КонецЦикла;
	
КонецФункции

Функция УстановитьПоляВыводаОбработки(ПараметрыОбработки, Поля) Экспорт
	
	ПоляВывода = ПолучитьПоляОбработки(ПараметрыОбработки, Поля);
	
	Для Каждого Поле Из ПоляОбработки(ПараметрыОбработки) Цикл
		
		ПорядокВывода = ПоляВывода.Найти(Поле);
		
		Если ПорядокВывода=Неопределено Тогда
			УстановитьСвойстваПолейОбработки(ПараметрыОбработки, Поле, Новый Структура("Вывод", Ложь));
		Иначе
			УстановитьСвойстваПолейОбработки(ПараметрыОбработки, Поле, Новый Структура("Вывод, Использование, ПорядокВывода", Истина, Истина, ПорядокВывода));
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция СписокПолейВвода(ПараметрыОбработки) Экспорт
	
	Список = Новый Массив;
	Для Каждого Поле Из ПоляВвода(ПараметрыОбработки) Цикл
		Список.Добавить(Поле.Имя);
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции

Функция ПоляВвода(ПараметрыОбработки) Экспорт
	
	ПоляОбработки = ПоляОбработки(ПараметрыОбработки);
	ПоляОбработки.Сортировать("ПорядокВвода");
	ПоляВвода = ПоляОбработки.НайтиСтроки(Новый Структура("Ввод", Истина));
	
	Возврат ПоляВвода;
	
КонецФункции

