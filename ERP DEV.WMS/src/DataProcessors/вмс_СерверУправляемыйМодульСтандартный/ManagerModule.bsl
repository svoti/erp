Функция УстановитьСвойстваЭлементовВывода(ПараметрыОбработки, Элементы=Неопределено, знач СвойстваУстановить=Неопределено, знач ЗначениеСвойства=Неопределено, Явно=Истина) Экспорт
	
	РК = вмс_РаботаСКоллекциями;

	Если ТипЗнч(Элементы)=Тип("СтрокаТаблицыЗначений") Тогда
		//для оптимизации
		ВыбранныеЭлементы = Новый Массив;
		ВыбранныеЭлементы.Добавить(Элементы);
	Иначе
		ВыбранныеЭлементы = ПолучитьЭлементыВывода(ПараметрыОбработки, Элементы);
		Если ВыбранныеЭлементы.Количество()=0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	СтандартныеСвойства = Новый Структура("Использование, Новый, Удалить, Родитель, ТипЭлемента, ТипЗначения, Видимость, Номер, Портал");
	
	Если ТипЗнч(СвойстваУстановить)=Тип("Строка") Тогда
		СвойстваУстановить = Новый Структура(СвойстваУстановить);
		Для Каждого СвойствоУстановить Из СвойстваУстановить Цикл
			СвойстваУстановить[СвойствоУстановить.Ключ] = ЗначениеСвойства;
		КонецЦикла;
	ИначеЕсли ТипЗнч(СвойстваУстановить)=Тип("Структура") Тогда
		СвойстваУстановить = РК.СкопироватьСтруктуру(СвойстваУстановить);
	Иначе
		СвойстваУстановить = Новый Структура;
	КонецЕсли;
	
	Если СвойстваУстановить.Свойство("Родитель") Тогда
		Родитель = СвойстваУстановить.Родитель;
		Если Родитель <> Неопределено И ТипЗнч(Родитель) <> Тип("Строка") Тогда
			СвойстваУстановить.Родитель = Родитель.Имя;
		КонецЕсли;
	КонецЕсли;
	
	Если СвойстваУстановить.Свойство("РодительНового") Тогда
		Родитель = СвойстваУстановить.РодительНового;
		Если Родитель <> Неопределено И ТипЗнч(Родитель) <> Тип("Строка") Тогда
			СвойстваУстановить.РодительНового = Родитель.Имя;
		КонецЕсли;
	КонецЕсли;
	
	СтандартныеСвойстваУстановить = Новый Структура;
	
	Для Каждого СвойствоУстановить Из СвойстваУстановить Цикл
		ИмяСвойства = СвойствоУстановить.Ключ;
		Если Прав(ИмяСвойства, 6)="Нового" Тогда
			ИмяСтандартногоСвойства = Лев(ИмяСвойства, СтрДлина(ИмяСвойства)-6);
		Иначе
			ИмяСтандартногоСвойства = ИмяСвойства;
		КонецЕсли;
		
		Если СтандартныеСвойства.Свойство(ИмяСтандартногоСвойства) Тогда
			СтандартныеСвойстваУстановить.Вставить(ИмяСтандартногоСвойства, СвойствоУстановить.Значение);
		КонецЕсли;
	КонецЦикла;
	
	СвойстваУстановить.Удалить("Использование");
	СвойстваУстановить.Удалить("Новый");
	СвойстваУстановить.Удалить("Портал");
	
	Родитель = Неопределено;
	Если СвойстваУстановить.Свойство("Родитель", Родитель) ИЛИ СвойстваУстановить.Свойство("РодительНового", Родитель) Тогда
		ПриУстановкеРодителяЭлементовВывода(ПараметрыОбработки, ВыбранныеЭлементы, Родитель);
	КонецЕсли;
	
	Для Каждого ЭлементВывода Из ВыбранныеЭлементы Цикл
		
		СвойстваУстановленныеЯвно = ЭлементВывода.СвойстваУстановленныеЯвно;

		Для Каждого СвойствоУстановить Из СтандартныеСвойстваУстановить Цикл
			ИмяСвойства = СвойствоУстановить.Ключ;
			Если Явно Тогда
				ЭлементВывода[ИмяСвойства] = СвойствоУстановить.Значение;
				СвойстваУстановленныеЯвно[ИмяСвойства] = Истина;
			ИначеЕсли СвойстваУстановленныеЯвно[ИмяСвойства] <> Истина Тогда
				ЭлементВывода[ИмяСвойства] = СвойствоУстановить.Значение;
			Иначе
				ТочкаЧеканута = 1;
			КонецЕсли;
		КонецЦикла;
		
		Свойства = ЭлементВывода.Свойства;
		СвойстваПередать = ЭлементВывода.СвойстваПередать;
		Для Каждого СвойствоУстановить Из СвойстваУстановить Цикл
			ИмяСвойства = СвойствоУстановить.Ключ;
			ЗначениеСвойства = СвойствоУстановить.Значение;

			Если Явно Тогда
				СвойстваПередать.Вставить(ИмяСвойства, ЗначениеСвойства);
				Свойства.Вставить(ИмяСвойства, ЗначениеСвойства);
				
				СвойстваПередать.Удалить(ИмяСвойства + "Нового");
				Свойства.Удалить(ИмяСвойства + "Нового");
				
				СвойстваУстановленныеЯвно[ИмяСвойства] = Истина;
			ИначеЕсли СвойстваУстановленныеЯвно[ИмяСвойства] <> Истина Тогда
				СвойстваПередать.Вставить(ИмяСвойства, ЗначениеСвойства);
				Свойства.Вставить(ИмяСвойства, ЗначениеСвойства);
				
				СвойстваПередать.Удалить(ИмяСвойства + "Нового");
				Свойства.Удалить(ИмяСвойства + "Нового");
			Иначе
				ТочкаЧеканута = 1;
			КонецЕсли;
		КонецЦикла;
		
		ЭлементВывода.Обновить = Истина;
		
		Если НЕ ЭлементВывода.Удалить И НЕ СтандартныеСвойстваУстановить.Свойство("Использование") Тогда
			ЭлементВывода.Использование = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

// пересчитывает уровень вложенности элементов по иерархии
Функция ПриУстановкеРодителяЭлементовВывода(ПараметрыОбработки, ВыбранныеЭлементы, Родитель)

	ЭлементыВывода = ПараметрыОбработки.ЭлементыВывода;
	
	Если Родитель=Неопределено Тогда
		Уровень = -1;
	Иначе
		ЭлементРодительМассив = ЭлементыВывода.НайтиСтроки(Новый Структура("Имя", Родитель));
		Если ЭлементРодительМассив.Количество() > 0 Тогда
			ЭлементРодитель = ЭлементРодительМассив[0];
			Уровень = ЭлементРодитель.Уровень;
		Иначе
			Уровень = 0;
		КонецЕсли;
	КонецЕсли;
	
	ЭлементыСоседи = ЭлементыВывода.НайтиСтроки(Новый Структура("Родитель", Родитель));
	Если ЭлементыСоседи.Количество()=0 Тогда
		Номер = 0;
	Иначе
		Номер = ЭлементыСоседи[0].Номер;
		Для Каждого ЭлементСосед Из ЭлементыСоседи Цикл
			Если ЭлементСосед.Номер > Номер Тогда
				Номер = ЭлементСосед.Номер;
			КонецЕсли;
		КонецЦикла;
		Номер = Номер + 1;
	КонецЕсли;
	
	Для Каждого ЭлементВывода Из ВыбранныеЭлементы Цикл
		Если ЭлементВывода.Родитель <> Родитель Тогда
			Если ЭлементВывода.Номер <> Номер Тогда
				ЭлементВывода.Номер = Номер;
				ЭлементВывода.Свойства.Удалить("НомерНового");
				ЭлементВывода.Свойства.Вставить("Номер", Номер);
				ЭлементВывода.СвойстваПередать.Удалить("НомерНового");
				ЭлементВывода.СвойстваПередать.Вставить("Номер", Номер);
				ЭлементВывода.Обновить = Истина;
			КонецЕсли;
			Номер = Номер + 1;
		КонецЕсли;
	КонецЦикла;
	
	ОбходЭлементов = ВыбранныеЭлементы;
	ОбработанныеЭлементы = Новый Соответствие;
	
	Пока ОбходЭлементов.Количество() > 0 Цикл
		
		Уровень = Уровень + 1;

		ОбходЭлементовСледующегоУровня = Новый Массив;
		Для Каждого ЭлементВывода Из ОбходЭлементов Цикл
			ИмяЭлемента = ЭлементВывода.Имя;
			Если ОбработанныеЭлементы[ИмяЭлемента]=Истина Тогда
				ВызватьИсключение "Зацикливание иерархии элементов вывода!";
			КонецЕсли;
			ОбработанныеЭлементы[ИмяЭлемента] = Истина;
			ЭлементВывода.Уровень = Уровень;
			ЭлементыДети = ЭлементыВывода.НайтиСтроки(Новый Структура("Родитель", ИмяЭлемента));
			Для Каждого ЭлементДитё Из ЭлементыДети Цикл
				ОбходЭлементовСледующегоУровня.Добавить(ЭлементДитё);
			КонецЦикла;
		КонецЦикла;
		
		ОбходЭлементов = ОбходЭлементовСледующегоУровня;

	КонецЦикла;
	
КонецФункции

Функция ПолучитьЭлементыВывода(ПараметрыОбработки, ОтборЭлементов) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	Если ОтборЭлементов=ПараметрыОбработки.ПустойЭлементВывода Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ДопРезультатОтбора = Новый Структура;
	ПолученныеЭлементы = РК.ОтобратьЭлементыКоллекции(ПараметрыОбработки.ЭлементыВывода, ОтборЭлементов, "Имя", , ДопРезультатОтбора);

	Для Каждого ИмяЭлемента Из ДопРезультатОтбора.НенайденныеПоИмени Цикл
		ЭлементВывода = НовыйЭлементВывода(ПараметрыОбработки, ИмяЭлемента);
		ПолученныеЭлементы.Добавить(ЭлементВывода);
	КонецЦикла;
	
	Возврат ПолученныеЭлементы;
	
КонецФункции

Функция ЭлементВывода(ПараметрыОбработки, ОтборЭлемента) Экспорт
	
	РК = вмс_РаботаСКоллекциями;

	Если ОтборЭлемента=Неопределено Тогда
		Возврат ПараметрыОбработки.ПустойЭлементВывода;
	КонецЕсли;
	
	Элементы = РК.ОтобратьЭлементыКоллекции(ПараметрыОбработки.ЭлементыВывода, ОтборЭлемента, "Имя");

	Если Элементы.Количество() > 0 Тогда
		
		Возврат Элементы[0];
		
	Иначе
		
		Возврат ПараметрыОбработки.ПустойЭлементВывода;
		
	КонецЕсли;
	
КонецФункции

Функция ЭлементыВывода(ПараметрыОбработки, ОтборЭлементов=Неопределено) Экспорт

	РК = вмс_РаботаСКоллекциями;

	ЭлементыВывода = ПараметрыОбработки.ЭлементыВывода;
	Если ОтборЭлементов=Неопределено ИЛИ ОтборЭлементов=ЭлементыВывода Тогда
		Возврат ЭлементыВывода;
	КонецЕсли;
	
	Возврат РК.ОтобратьЭлементыКоллекции(ЭлементыВывода, ОтборЭлементов, "Имя");

КонецФункции

Функция НовыйЭлементВывода(ПараметрыОбработки, Имя) Экспорт
	
	РК = вмс_РаботаСКоллекциями;

	ЭлементыВывода = ПараметрыОбработки.ЭлементыВывода;
	
	Если Имя <> "Форма" Тогда	
		Если Имя <> ПараметрыОбработки.ПанельЭлементовВыводаПоУмолчанию Тогда
			Родитель = ПараметрыОбработки.ПанельЭлементовВыводаПоУмолчанию;
			Номер = ЭлементыВывода.НайтиСтроки(Новый Структура("Родитель", Родитель)).Количество();
		КонецЕсли;
	КонецЕсли;

	Свойства = Новый Структура;
	
	ЭлементВывода = ЭлементыВывода.Добавить();
	ЭлементВывода.Имя = Имя;
	ЭлементВывода.Видимость = Истина;
	
	Если Родитель <> Неопределено Тогда
		ЭлементВывода.Уровень = 1;
		ЭлементВывода.Номер = Номер;
		Свойства.Вставить("НомерНового", Номер);

		ЭлементВывода.Родитель = Родитель;
		Свойства.Вставить("РодительНового", ЭлементВывода.Родитель);
	Иначе
		ЭлементВывода.Уровень = 0;
		ЭлементВывода.Номер = 0;
	КонецЕсли;

	Если Имя <> "Форма" Тогда	
		Свойства.Вставить("Видимость", ЭлементВывода.Видимость);
	КонецЕсли;
	
	ЭлементВывода.Новый = Истина;
	ЭлементВывода.Удалить = Ложь;
	ЭлементВывода.Обновить = Ложь;
	ЭлементВывода.Использование = Истина;
	ЭлементВывода.Свойства = Свойства;
	ЭлементВывода.СвойстваПередать = РК.СкопироватьСтруктуру(ЭлементВывода.Свойства);
	ЭлементВывода.СвойстваНаКлиенте = Новый Структура;
	ЭлементВывода.События = Новый Структура;
	ЭлементВывода.СвойстваУстановленныеЯвно = Новый Соответствие;
	
	Возврат ЭлементВывода;
	
КонецФункции

