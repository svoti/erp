Функция ТаблицаПолейОбработки(ПараметрыОбработки, Отбор=Неопределено) Экспорт
	
	ВыбранныеПоля = ПоляОбработки(ПараметрыОбработки, Отбор);
	
	Если ТипЗнч(ВыбранныеПоля)=Тип("ТаблицаЗначений") Тогда
		
		ТаблицаВыбранныхПолей = ВыбранныеПоля.Скопировать();
		
	Иначе
		
		ТаблицаПолей = ПоляОбработки(ПараметрыОбработки);
		ТаблицаВыбранныхПолей = ТаблицаПолей.Скопировать(ВыбранныеПоля);
		
	КонецЕсли;
	
	Возврат ТаблицаВыбранныхПолей;
	
КонецФункции

Функция ПрочитатьПутьРодителяДанныхПоля(ПараметрыОбработки, Поле, ПолеПути)
	
	Пути = Поле[ПолеПути];
	
	ПозицияЗапятой = СтрНайти(Пути, ",");
	Если ПозицияЗапятой <> 0 Тогда
		Путь = Лев(Пути, ПозицияЗапятой-1);
	Иначе
		Путь = Пути;
	КонецЕсли;
	
	Символ = Лев(Путь, 1);
	Если Символ="!" ИЛИ Символ="@" Тогда
		Путь = Прав(Путь, СтрДлина(Путь)-1);
	КонецЕсли;
	
	ПозицияТочки = СтрНайти(Путь, ".", НаправлениеПоиска.СКонца);
	Если ПозицияТочки <> 0 Тогда
		ПутьРодителя = Лев(Путь, ПозицияТочки-1);
	Иначе
		ПутьРодителя = "";
	КонецЕсли;
	
	Возврат ПутьРодителя;
	
КонецФункции

Функция ПрочитатьПутиКДаннымПолей(ПараметрыОбработки, ПолеПути, знач Поля=Неопределено) Экспорт

	РК = вмс_РаботаСКоллекциями;
	ТаблицаПутейКДаннымПолей = РК.НоваяТаблицаЗначений("ИмяПоля, Поле, Раунд, ПутьКДанным, ПутьКДаннымМассив, ПутьРеквизита, ИмяРеквизита, Поиск");

	СпецСимволыПути = Новый Соответствие;
	СпецСимволыПути["!"] = Истина;
	СпецСимволыПути["@"] = Истина;
	Для Каждого Поле Из ПоляОбработки(ПараметрыОбработки, Поля) Цикл
		ПутиКДанным = СтрРазделить(Поле[ПолеПути], ",", Ложь);

		Раунд = 1;
		Для Каждого ПутьКДанным Из ПутиКДанным Цикл
			ПутьКДанным = СтрЗаменить(ПутьКДанным, " ", "");
			Поиск = НЕ Поле.Ресурс;
			Пока Истина Цикл
				Символ = Лев(ПутьКДанным, 1);
				Если СпецСимволыПути[Символ] <> Истина Тогда
					Прервать;
				КонецЕсли;
				ПутьКДанным = Прав(ПутьКДанным, СтрДлина(ПутьКДанным)-1);
				
				Если Символ="!" Тогда
					//поле должно быть заполнено до начала раунда, в противном случае данные в таблице не будут искаться
					//и ни одно поле в той же таблице не будет заполнено
				ИначеЕсли Символ="@" Тогда
					//не искать по этому полю, только заполнять данными, найденными по другим полям поиска
					Поиск = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			ПутьКДаннымМассив = СтрРазделить(ПутьКДанным, ".", Ложь);
			Если ПутьКДаннымМассив.Количество() > 1 Тогда
				ИмяРеквизита = ПутьКДаннымМассив[ПутьКДаннымМассив.ВГраница()];
				ПутьРеквизита = Лев(ПутьКДанным, СтрДлина(ПутьКДанным)-СтрДлина(ИмяРеквизита)-1);
			Иначе
				ИмяРеквизита = ПутьКДанным;
				ПутьРеквизита = "";
			КонецЕсли;
			
			ЭлементПутьКДанным = ТаблицаПутейКДаннымПолей.Добавить();
			ЭлементПутьКДанным.ИмяПоля = Поле.Имя;
			ЭлементПутьКДанным.Поле = Поле;
			ЭлементПутьКДанным.Раунд = Раунд;
			ЭлементПутьКДанным.ПутьКДанным = ПутьКДанным;
			ЭлементПутьКДанным.ПутьКДаннымМассив = ПутьКДаннымМассив;
			ЭлементПутьКДанным.ПутьРеквизита = ПутьРеквизита;
			ЭлементПутьКДанным.ИмяРеквизита = ИмяРеквизита;
			ЭлементПутьКДанным.Поиск = Поиск;
			Раунд = Раунд + 1;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаПутейКДаннымПолей;
	
КонецФункции

Функция ЗаписатьПутиКДаннымПолей(ПараметрыОбработки, ПолеПути, ТаблицаПутейКДаннымПолей) Экспорт
	
	ТаблицаПолей = ТаблицаПутейКДаннымПолей.Скопировать();
	ТаблицаПолей.Свернуть("ИмяПоля");
	ИменаПолей = ТаблицаПолей.ВыгрузитьКолонку("ИмяПоля");
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ТаблицаПутейКДаннымПоля = ТаблицаПутейКДаннымПолей.Скопировать(Новый Структура("ИмяПоля", ИмяПоля));
		Если ТаблицаПутейКДаннымПоля.Количество()=0 Тогда
			ПутьКДанным = "";
		Иначе
			ТаблицаПутейКДаннымПоля.Сортировать("Раунд");
			КоличествоРаундов = ТаблицаПутейКДаннымПоля[ТаблицаПутейКДаннымПоля.Количество()-1].Раунд;
		
			ПутиРаундовКДанным = Новый Массив;
			Для Раунд=1 По КоличествоРаундов Цикл
				ЭлементПутьРаундаКДаннымМассив = ТаблицаПутейКДаннымПоля.НайтиСтроки(Новый Структура("Раунд", Раунд));
				Если ЭлементПутьРаундаКДаннымМассив.Количество()=0 Тогда
					ПутьРаундаКДанным = "";
				Иначе
					ЭлементПутьРаундаКДанным = ЭлементПутьРаундаКДаннымМассив[0];
					ПутьРаундаКДанным = ЭлементПутьРаундаКДанным.ПутьКДанным;
					Если НЕ ЭлементПутьРаундаКДанным.Поиск Тогда
						ПутьРаундаКДанным = "@" + ПутьРаундаКДанным;
					КонецЕсли;
				КонецЕсли;
				ПутиРаундовКДанным.Добавить(ПутьРаундаКДанным);
			КонецЦикла;
		
			ПутьКДанным = вмс_РаботаСКоллекциями.МассивВСтроку(ПутиРаундовКДанным);
		КонецЕсли;
		
		УстановитьСвойстваПолейОбработки(ПараметрыОбработки, ИмяПоля, ПолеПути, ПутьКДанным);
	КонецЦикла;
	
КонецФункции

Функция ПолучитьТаблицыВычисленийЗначенийПолей(ПараметрыОбработки) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ТаблицаВычисленийЗначенийПолей = РК.НоваяТаблицаЗначений("Раунд, Путь, Имя, ПолноеИмя, Значение, ЗначениеРассчитано");
	ТаблицаВычисляемыхПолей = ПрочитатьПутиКДаннымПолей(ПараметрыОбработки, "ПутьКДаннымЗаполнения");
	ТаблицаВычисляемыхПолей.Колонки.Добавить("План");
	
	Для Каждого ЭлементПоля Из ТаблицаВычисляемыхПолей Цикл
		
		ЭлементПоля.План = ЭлементПоля.Поле.План;
		
		Раунд = ЭлементПоля.Раунд;
			
		Путь = "";
		Для Каждого Имя Из ЭлементПоля.ПутьКДаннымМассив Цикл
			
			Если Путь <> "" Тогда
				ПолноеИмя = Путь + "." + Имя;
			Иначе
				ПолноеИмя = Имя;
			КонецЕсли;
			
			Если ТаблицаВычисленийЗначенийПолей.НайтиСтроки(Новый Структура("ПолноеИмя, Раунд", ПолноеИмя, Раунд)).Количество()=0 Тогда
				ЭлементВычислений = ТаблицаВычисленийЗначенийПолей.Добавить();
				ЭлементВычислений.Раунд = Раунд;
				ЭлементВычислений.Путь = Путь;
				ЭлементВычислений.Имя = Имя;
				ЭлементВычислений.ПолноеИмя = ПолноеИмя;
				ЭлементВычислений.ЗначениеРассчитано = Ложь;
			КонецЕсли;

			Путь = ПолноеИмя;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаВычисленийЗначенийПолей.Сортировать("Раунд, ПолноеИмя");
	
	Результат = Новый Структура("ТаблицаВычисленийЗначенийПолей, ТаблицаВычисляемыхПолей", ТаблицаВычисленийЗначенийПолей, ТаблицаВычисляемыхПолей);
	Возврат Результат;
	
КонецФункции

Функция ОчиститьДанныеПолей(ПараметрыОбработки, знач Поля=Неопределено, знач ИмяДанных=Неопределено) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	Данные = ?(ПараметрыОбработки.ДанныеТранзакции.Активна, ПараметрыОбработки.ДанныеТранзакции, ПараметрыОбработки.Данные);
	
	//	
	Если ИмяДанных=Неопределено Тогда
		ИмяДанных = "ВведенныеДанныеПолей, ЗапланированныеДанныеПолей, СобранныеДанныеПолей, ОбщиеДанныеПолей";
	КонецЕсли;

	ИмяДанныхМассив = РК.ЗначениеВМассив(ИмяДанных, , Ложь);
	Если ИмяДанныхМассив.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//	
	Поля = ПоляОбработки(ПараметрыОбработки, Поля);
	Если Поля.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//	
	Для Каждого ИмяДанных Из ИмяДанныхМассив Цикл
		ДанныеПолей = Данные[ИмяДанных];
		Для Каждого Поле Из Поля Цикл
			Если ДанныеПолей.Свойство(Поле.Имя) Тогда
				ДанныеПолей[Поле.Имя] = Поле.НачальноеЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

