#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Функция ИнициализироватьДанныеОбработки(ПараметрыОбработки) Экспорт
	
	ИнициализироватьПоляОбработки(ПараметрыОбработки);
	ИнициализироватьЭлементыВывода(ПараметрыОбработки);
	ИнициализироватьДанныеПолейОбработки(ПараметрыОбработки);
	ИнициализироватьДанныеТранзакции(ПараметрыОбработки);
	
КонецФункции

Функция ИнициализироватьПоляОбработки(ПараметрыОбработки)
	
	РК = вмс_РаботаСКоллекциями;
	
	ПоляОбработки = НовыеПоляОбработки();
	
	СвойстваПолейОбработкиМассив = РК.ПолучитьКолонкиКоллекции(ПоляОбработки);
	СвойстваПолейОбработки = РК.МассивВСтроку(СвойстваПолейОбработкиМассив);
	
	РК.ВычестьМассив(СвойстваПолейОбработкиМассив, "Имя");
	СвойстваПолейОбработкиБезИмени = РК.МассивВСтроку(СвойстваПолейОбработкиМассив);
	
	ПередатьСвойстваПолейВЭлементВывода = Новый Соответствие;
	ПередатьСвойстваПолейВЭлементВывода["Вывод"] = "Видимость";
	ПередатьСвойстваПолейВЭлементВывода["Страница"] = "Родитель";
	ПередатьСвойстваПолейВЭлементВывода["Синоним"] = "Заголовок";
	ПередатьСвойстваПолейВЭлементВывода["ПоложениеЗаголовка"] = "ПоложениеЗаголовка";
	ПередатьСвойстваПолейВЭлементВывода["СписокВыбора"] = "СписокВыбора";
	ПередатьСвойстваПолейВЭлементВывода["Шрифт"] = "Шрифт";

	ПараметрыОбработки.Вставить("ПоляОбработки", ПоляОбработки);
	ПараметрыОбработки.Вставить("СтраницаПолейОбработкиПоУмолчанию", "ГлавнаяПанельСтраницаВводДанных");
	ПараметрыОбработки.Вставить("СвойстваПолейОбработки", СвойстваПолейОбработки);
	ПараметрыОбработки.Вставить("СвойстваПолейОбработкиБезИмени", СвойстваПолейОбработкиБезИмени);
	ПараметрыОбработки.Вставить("ПорядокВводаНовогоПоляОбработки", 0);

	ПустоеПолеОбработки = Новый Структура;
	ПустоеПолеОбработки.Вставить("Использование", Ложь);
	ПустоеПолеОбработки.Вставить("ПустоеПолеОбработки", Истина);
	ПараметрыОбработки.Вставить("ПустоеПолеОбработки", ПустоеПолеОбработки);

	ПараметрыОбработки.Вставить("ПередатьСвойстваПолейВЭлементВывода", ПередатьСвойстваПолейВЭлементВывода);

	Возврат Истина;
	
КонецФункции

Функция ИнициализироватьЭлементыВывода(ПараметрыОбработки)

	ПараметрыОбработки.Вставить("ЭлементыВывода", НовыеЭлементыВывода());
	ПараметрыОбработки.Вставить("ПустойЭлементВывода", Новый Структура("ПустойЭлементВывода", Истина));
	ПараметрыОбработки.Вставить("ПанельЭлементовВыводаПоУмолчанию", ПараметрыОбработки.СтраницаПолейОбработкиПоУмолчанию);
	
	СтандартныеСвойства = 
	"Использование, Новый, Удалить, Родитель, ТипЭлемента, ТипЗначения, Видимость, Номер, Портал";
	
	РК = вмс_РаботаСКоллекциями;
	ПараметрыОбработки.Вставить("СтандартныеСвойстваЭлементовВывода", РК.ПреобразоватьМассивВСоответствие(РК.СтрокуВМассив(СтандартныеСвойства)));
	
	Возврат Истина;
	
КонецФункции

Функция НовыеЭлементыВывода()

	РК = вмс_РаботаСКоллекциями;

	ЭлементыВывода = РК.НоваяТаблицаЗначений("Имя, ТипЭлемента, ТипЗначения, Новый, Удалить, Уровень, Родитель, Портал, Номер, Использование, Видимость, Обновить, События, Свойства, СвойстваПередать, СвойстваНаКлиенте, СвойстваУстановленныеЯвно");
	ЭлементыВывода.Индексы.Добавить("Имя");
	ЭлементыВывода.Индексы.Добавить("Обновить");
	ЭлементыВывода.Индексы.Добавить("Портал");
	ЭлементыВывода.Индексы.Добавить("Использование");
	
	Возврат ЭлементыВывода;
	
КонецФункции

Функция	ИнициализироватьДанныеТранзакции(ПараметрыОбработки)
	
	ДанныеТранзакции = Новый Структура;
	ДанныеТранзакции.Вставить("Активна", Ложь);
	ДанныеТранзакции.Вставить("Прервать", Ложь);
	ДанныеТранзакции.Вставить("Отменить", Ложь);
	ДанныеТранзакции.Вставить("ПоляОбработки", НовыеПоляОбработки());
	
	ПараметрыОбработки.Вставить("ДанныеТранзакции", ДанныеТранзакции);
	СкопироватьДанныеВТранзакцию(ПараметрыОбработки);
	
КонецФункции

Функция НовыеВходящиеДанные(Данные=Неопределено) Экспорт
	
	ДанныеШтрихкода = Новый Структура;
	ДанныеШтрихкода.Вставить("Штрихкод");
	ДанныеШтрихкода.Вставить("Обработан", Ложь);
	ДанныеШтрихкода.Вставить("Результат");
	ДанныеШтрихкода.Вставить("Количество", 1);
	
	ВходящиеДанные = Новый Структура;
	ВходящиеДанные.Вставить("ЭтоВходящиеДанные", Истина); // для идентификации типа
	ВходящиеДанные.Вставить("НачалоВвода", Истина);
	ВходящиеДанные.Вставить("Обработаны", Ложь);
	ВходящиеДанные.Вставить("НомерДанных", 0);
	ВходящиеДанные.Вставить("МассивДанных", Новый Массив); // для множественного ввода данных (например список товаров)
	ВходящиеДанные.Вставить("ДанныеШтрихкода", ДанныеШтрихкода);
	ВходящиеДанные.Вставить("ВходящиеОбъекты", Новый Массив);
	ВходящиеДанные.Вставить("ДанныеПолей", Новый Структура);
	ВходящиеДанные.Вставить("Описание", "");
	
	ИнициализироватьВходящиеДанные(ВходящиеДанные, Данные);
	
	Возврат ВходящиеДанные;
	
КонецФункции

Функция ИнициализироватьВходящиеДанные(ВходящиеДанные, Данные=Неопределено) Экспорт

	РК = вмс_РаботаСКоллекциями;

	МассивДанных = ВходящиеДанные.МассивДанных;
	МассивДанных.Очистить();
	
	ДанныеШтрихкода = ВходящиеДанные.ДанныеШтрихкода;
	ДанныеШтрихкода.Штрихкод = Неопределено;
	ДанныеШтрихкода.Обработан = Ложь;
	ДанныеШтрихкода.Результат = Неопределено;
	
	ДанныеПолей = ВходящиеДанные.ДанныеПолей;
	ДанныеПолей.Очистить();
	
	ТипДанных = ТипЗнч(Данные);
	
	Если ТипДанных=Тип("Структура") Тогда
		РК.СкопироватьПоляСтруктуры(Данные, ДанныеПолей);
		МассивДанных.Добавить(ДанныеПолей);
	ИначеЕсли ТипДанных=Тип("Строка") Тогда
		ДанныеШтрихкода.Штрихкод = Данные;
		МассивДанных.Добавить(ДанныеШтрихкода.Штрихкод);
	ИначеЕсли ТипДанных=Тип("Массив") ИЛИ ТипДанных=Тип("ТаблицаЗначений") Тогда
		Для Каждого ЭлементДанных Из Данные Цикл
			Если ТипЗнч(ЭлементДанных)=Тип("СтрокаТаблицыЗначений") Тогда
				ЭлементДанныхНовый = РК.СтрокуТаблицыЗначенийВСтруктуру(ЭлементДанных);
			ИначеЕсли ТипЗнч(ЭлементДанных)=Тип("Структура") Тогда
				ЭлементДанныхНовый = РК.СкопироватьСтруктуру(ЭлементДанных);
			Иначе
				ЭлементДанныхНовый = ЭлементДанных;
			КонецЕсли;
			МассивДанных.Добавить(ЭлементДанныхНовый);
		КонецЦикла;
	КонецЕсли;
	
	ВходящиеДанные.Описание = ОписаниеВходящихДанных(ВходящиеДанные);

	Возврат Истина;
	
КонецФункции

Функция ОписаниеВходящихДанных(ВходящиеДанные) Экспорт
	
	РК = вмс_РаботаСКоллекциями;

	Если ЗначениеЗаполнено(ВходящиеДанные.ДанныеШтрихкода.Штрихкод) Тогда
		
		Описание = ВходящиеДанные.ДанныеШтрихкода.Штрихкод;
		
	ИначеЕсли ВходящиеДанные.ВходящиеОбъекты.Количество() > 0 Тогда

		Описание = РК.МассивВСтроку(ВходящиеДанные.ВходящиеОбъекты);
		
	ИначеЕсли ВходящиеДанные.ДанныеПолей.Количество() > 0 Тогда
		
		ИменаПолейМассив = РК.ВыгрузитьЗначенияКолонкиКоллекции(ВходящиеДанные.ДанныеПолей, "Ключ");
		Описание = РК.МассивВСтроку(ИменаПолейМассив);
		
	Иначе
		
		Описание = "";
		
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция ЭтоВходящиеДанные(Объект) Экспорт
	
	Возврат ТипЗнч(Объект)=Тип("Структура") И Объект.Свойство("ЭтоВходящиеДанные") И Объект.ЭтоВходящиеДанные=Истина;
	
КонецФункции

Функция СкопироватьВходящиеДанные(ВходящиеДанные) Экспорт
	
	Возврат вмс_РаботаСКоллекциями.СкопироватьОбъект(ВходящиеДанные, Истина, 3);
	
КонецФункции

