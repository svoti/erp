КонецФункции

Функция ДействиеИнициализироватьПоляОбработки(Действие)

	//
	
КонецФункции

Функция ДействиеЗакончитьИнициализациюПолейОбработки(Действие)
	
	ПоляОбработки = ПараметрыОбработки.ПоляОбработки;
	Для Каждого Поле Из ПоляОбработки Цикл
		Если Поле.Вывод И Поле.Использование Тогда
			ПолучитьЭлементВыводаДляПоляОбработки(Поле.ИмяЭлементаВывода, Поле);
		Иначе
			ЭлементВывода = ЭлементВывода(Поле.ИмяЭлементаВывода);
			Если ЭлементВывода <> ПустойЭлементВывода Тогда
				ИнициализироватьЭлементВыводаДляПоляОбработки(ЭлементВывода, Поле);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	РК.УдалитьЭлементыКоллекции(ПоляОбработки, ПоляОбработки.НайтиСтроки(Новый Структура("Использование", Ложь)));
	
	ИнициализироватьОбработчикиСобытийПолейОбработки();
	
	Для Каждого Поле Из ПоляОбработки() Цикл
		Свойства = Новый Структура;
		Синоним = Поле.Синоним;
		Если НЕ ЗначениеЗаполнено(Синоним) Тогда
			Синоним = Поле.Имя;
			Свойства.Вставить("Синоним", Синоним);
		КонецЕсли;
			
		Если НЕ ЗначениеЗаполнено(Поле.СинонимВинительныйПадеж) Тогда
			Свойства.Вставить("СинонимВинительныйПадеж", Синоним);
		КонецЕсли;
		
		Если Свойства.Количество() > 0 Тогда
			УстановитьСвойстваПолейОбработки(Поле, Свойства);
		КонецЕсли;
	КонецЦикла;
	
	РК.УстановитьЭлементыКоллекции(ПараметрыОбработки.ПоляОбработкиИсходные, ПоляОбработки);
	
	УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция ОбновитьДанныеТранзакции()
	
	НачатьТранзакциюОбработки();
	
	Для Каждого СборщикДанных Из СборщикиДанных() Цикл
		СборщикДанных.НачатьТранзакциюСборщика();
		СборщикДанных.ОбновитьДанныеТранзакцииОбработки();
	КонецЦикла;
	
	ЗафиксироватьТранзакциюОбработки();
	
КонецФункции

Функция ДобавитьКомандыКонтекстногоМенюПолейНачало()
	
	ОписаниеОповещенияНачалоВыбора = Неопределено;
	Для Каждого ПолеВводаВывода Из ПоляОбработки(Новый Структура("Ввод, Вывод", Истина, Истина)) Цикл
		
		ДобавитьКомандуКонтекстногоМенюПоля(ПолеВводаВывода, "Подтвердить", "Подтвердить", НовыйОписаниеОповещения("ОбработчикКомандыПоля_Подтвердить", ЭтотОбъект, Новый Структура("ИмяПоля", ПолеВводаВывода.Имя)));
		ДобавитьКомандуКонтекстногоМенюПоля(ПолеВводаВывода, "Очистить", "Очистить", НовыйОписаниеОповещения("ОбработчикКомандыПоля_Очистить", ЭтотОбъект, Новый Структура("ИмяПоля", ПолеВводаВывода.Имя)));
		
	КонецЦикла;
		
КонецФункции

Функция ДобавитьКомандыКонтекстногоМенюПолейЗавершение()
	
	ОписаниеОповещенияНачалоВыбора = Неопределено;
	Для Каждого ПолеВводаВывода Из ПоляОбработки(Новый Структура("Ввод, Вывод", Истина, Истина)) Цикл
		
		Если ПолеВводаВывода.События.Свойство("НачалоВыбора", ОписаниеОповещенияНачалоВыбора) И ЭлементВывода(ПолеВводаВывода.ИмяЭлементаВывода + "КонтекстноеМенюВыбрать")=ПустойЭлементВывода Тогда
			ДобавитьКомандуКонтекстногоМенюПоля(ПолеВводаВывода, "Выбрать", "Выбрать", ОписаниеОповещенияНачалоВыбора);
		КонецЕсли;
		
	КонецЦикла;
		
КонецФункции

Функция ОбработчикКомандыПоля_Подтвердить(Параметр, ДополнительныеПараметры) Экспорт
	
	ИмяПоля = ДополнительныеПараметры.ИмяПоля;
	Если ДанныеОбработки.РезультатАнализаЗаполненияПолейОбщихДанных.ЗаполненныеПоляМассив.Найти(ИмяПоля)=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВвестиДанные(Новый Структура(ИмяПоля, ДанныеОбработки.ОбщиеДанныеПолей[ИмяПоля]));
	
КонецФункции

Функция ОбработчикКомандыПоля_Очистить(Параметр, ДополнительныеПараметры) Экспорт
	
	ОчиститьДанныеПолей(ДополнительныеПараметры.ИмяПоля, "ВведенныеДанныеПолей");
	
КонецФункции

Функция ИнициализироватьОбработчикиСобытийПолейОбработки()
	
	ПримитивныеТипы = Новый Массив;
	ПримитивныеТипы.Добавить(Тип("Строка"));
	ПримитивныеТипы.Добавить(Тип("Число"));
	ПримитивныеТипы.Добавить(Тип("Булево"));
	ПримитивныеТипы.Добавить(Тип("Дата"));
	
	Для Каждого ПолеВвода Из ПоляОбработки(Новый Структура("Вывод", Истина)) Цикл
		
		РедактированиеТекста = Ложь;
		ТипЭлемента = Неопределено;
		
		ЭлементВывода = ПолучитьЭлементВыводаДляПоляОбработки(ПолеВвода.ИмяЭлементаВывода, ПолеВвода);
		
		Если ПолеВвода.Ввод Тогда

			СодержитТолькоПримитивныеТипы = Ложь;
			ТипЗначения = ПолеВвода.ТипЗначения;
			ИспользоватьОбработчикПриИзменении = Ложь;
			
			Если ТипЗнч(ТипЗначения)=Тип("ОписаниеТипов") Тогда
				НеПримитивныеТипы = РК.ВычитаниеМассивов(ТипЗначения.Типы(), ПримитивныеТипы);
				СодержитТолькоПримитивныеТипы = НеПримитивныеТипы.Количество()=0;
				Если СодержитТолькоПримитивныеТипы Тогда
					ИспользоватьОбработчикПриИзменении = Истина;
					РедактированиеТекста = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ СодержитТолькоПримитивныеТипы Тогда
				Если ПолеВвода.СписокВыбора <> Неопределено Тогда
					СодержитТолькоПримитивныеТипы = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ИспользоватьОбработчикПриИзменении Тогда
				Если ПолеВвода.СписокВыбора <> Неопределено Тогда
					ИспользоватьОбработчикПриИзменении = Истина;
					РедактированиеТекста = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ИспользоватьОбработчикПриИзменении Тогда
				УстановитьОбработчикиСобытийПолейОбработки(ПолеВвода, Новый Структура("Очистка", НовыйОписаниеОповещения("ОбработчикОчисткиЗначенияПоля", ЭтотОбъект, Новый Структура("ИмяПоля", ПолеВвода.Имя))));
				УстановитьОбработчикиСобытийПолейОбработки(ПолеВвода, Новый Структура("ПриИзменении", ОписаниеОбработчикаИзмененияЗначенияПоля(ПолеВвода.Имя)));
			КонецЕсли;
			
			ОО = НовыйОписаниеОповещения("ОбработчикСобытияНажатиеНаПоле", , Новый Структура("ИмяПоля", ПолеВвода.Имя));
			Если СодержитТолькоПримитивныеТипы Тогда
				УстановитьОбработчикиСобытийПолейОбработки(ПолеВвода, Новый Структура("КонтекстноеМеню", ОО));
			Иначе
				УстановитьОбработчикиСобытийПолейОбработки(ПолеВвода, Новый Структура("Нажатие", ОО));
				УстановитьПередаточныйОбработчикСобытийЭлементовВывода(ПолеВвода, Новый Структура("НачалоВыбора", ОписаниеОбработчикаНачалоВыбораЗначенияПоляПоУмолчанию(ПолеВвода.Имя))); //заблокируем стандартное действие по умолчанию
			КонецЕсли;
			
		Иначе
			
			УстановитьСвойстваЭлементовВывода(ПолеВвода.ИмяЭлементаВывода, Новый Структура("ТолькоПросмотр", Истина));
			
		КонецЕсли;

		Если ЭлементВывода.Свойства.Свойство("ТипЭлемента", ТипЭлемента) И ТипЭлемента="ПолеВвода" Тогда
			УстановитьСвойстваЭлементовВывода(ЭлементВывода, "РедактированиеТекста", РедактированиеТекста);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ОбработчикСобытияНажатиеНаПоле(Параметр, ДополнительныеПараметры) Экспорт
	
	Перем Заголовок;
	
	ИмяПоля = ДополнительныеПараметры.ИмяПоля;
	Поле = ПолеОбработки(ИмяПоля);
	
	КонтекстныеКоманды = ЭлементыВывода(Новый Структура("Родитель", Поле.ИмяЭлементаВывода + "КонтекстноеМеню"));
	
	СписокЗначений = Новый СписокЗначений;
	Для Каждого КонтекстнаяКоманда Из КонтекстныеКоманды Цикл
		Если КонтекстнаяКоманда.Видимость Тогда
			КонтекстнаяКоманда.Свойства.Свойство("Заголовок", Заголовок);
			СписокЗначений.Добавить(КонтекстнаяКоманда.Имя, Заголовок);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокЗначений.Количество() > 0 Тогда
		ПоказатьВыборИзМеню(НовыйОписаниеОповещения("ОбработчикВыбораКонтекстнойКомандыПоля", , ДополнительныеПараметры), СписокЗначений);
	КонецЕсли;
	
КонецФункции

Функция ОбработчикВыбораКонтекстнойКомандыПоля(ИмяКоманды, ДополнительныеПараметры) Экспорт
	
	ОбработатьСобытиеЭлементаВывода(ИмяКоманды, "Нажатие");
	
