Функция ПараметрыТаблицы(ИмяТаблицы) Экспорт
	
	ПараметрыТаблиц = ПараметрыОбработки.ПараметрыТаблиц;
	
	Если НЕ ПараметрыТаблиц.Свойство(ИмяТаблицы) Тогда
		ПараметрыТаблицы = НовыеПараметрыТаблицы(ИмяТаблицы);
		ПараметрыТаблиц.Вставить(ИмяТаблицы, ПараметрыТаблицы);
		СоздатьЭлементыТаблицыОбработки(ПараметрыТаблицы);
	Иначе
		ПараметрыТаблицы = ПараметрыТаблиц[ИмяТаблицы];
	КонецЕсли;
	
	Возврат ПараметрыТаблицы;
	
КонецФункции

Функция НовыеПараметрыТаблицы(ИмяТаблицы)
	
	ТаблицыОбработки = ДанныеОбработки.Таблицы;
	
	Таблица = ТаблицыОбработки[ИмяТаблицы];
	
	Поля = РК.ПолучитьКолонкиКоллекции(Таблица);
	ПоляВывода = РК.СкопироватьОбъект(Поля);
	
	ДополнительныеДанныеЭлементов = Новый ТаблицаЗначений;
	ДополнительныеДанныеЭлементов.Колонки.Добавить("Идентификатор");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("Изменен");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("Номер");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("ФлагОбработки");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("ЭлементыЗагрузки");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("ЗначенияПолей");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("ЗначенияДополнительныхПолей");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("ИдентификаторОформления");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("УдалятьПустые");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("Скрывать");
	
	ДополнительныеДанныеЭлементов.Индексы.Добавить("Идентификатор");
	ДополнительныеДанныеЭлементов.Индексы.Добавить("Изменен");
	
	ПараметрыТаблицы = Новый Структура;
	ПараметрыТаблицы.Вставить("Имя", ИмяТаблицы);
	ПараметрыТаблицы.Вставить("Вывод", Истина);
	ПараметрыТаблицы.Вставить("Поля", Поля);
	ПараметрыТаблицы.Вставить("ПоляВывода", ПоляВывода);
	ПараметрыТаблицы.Вставить("ИдентификаторНовогоЭлемента", 0);
	ПараметрыТаблицы.Вставить("ИдентификаторТекущегоЭлемента", 0);
	ПараметрыТаблицы.Вставить("ИдентификаторТекущегоЭлементаНаКлиенте", 0);
	ПараметрыТаблицы.Вставить("ДополнительныеДанныеЭлементов", ДополнительныеДанныеЭлементов);
	ПараметрыТаблицы.Вставить("МестоПоложение");
	ПараметрыТаблицы.Вставить("Новые", Истина);
	ПараметрыТаблицы.Вставить("ФлагОбработки", 0);
	ПараметрыТаблицы.Вставить("СброситьТекущийЭлемент", Ложь);
	ПараметрыТаблицы.Вставить("Ресурсы", Новый Структура);
	ПараметрыТаблицы.Вставить("НовыеЭлементы", Новый Массив);
	ПараметрыТаблицы.Вставить("ИзмененныеЭлементы", Новый Массив);
	ПараметрыТаблицы.Вставить("ИзмененныеЭлементыВСписке", Новый Соответствие);
	ПараметрыТаблицы.Вставить("ИзмененныеЭлементыДляКлиента", Новый Массив);
	ПараметрыТаблицы.Вставить("ИзмененныеЭлементыВСпискеДляКлиента", Новый Соответствие);
	ПараметрыТаблицы.Вставить("УдаленныеЭлементы", Новый Массив);
	ПараметрыТаблицы.Вставить("ИдентификаторыНаКлиенте", Новый Соответствие);
	ПараметрыТаблицы.Вставить("ИспользуетсяМетодОбновитьДанныеТаблицы", Ложь);
	
	Возврат ПараметрыТаблицы;
	
КонецФункции

// Параметры
// 	ИмяТаблицы - Имя таблицы
//	Источник - Список колонок таблицы или таблица значений
Функция УстановитьТаблицуОбработки(ИмяТаблицы, Источник, Видимость=Истина, знач ПоляВывода=Неопределено) Экспорт
	
	Таблица = РК.НоваяТаблицаЗначений(, Источник);
	
	Если ТипЗнч(Источник)=Тип("ТаблицаЗначений") Тогда
		РК.УстановитьЭлементыКоллекции(Таблица, Источник);
	КонецЕсли;
	
	ДанныеОбработки.Таблицы.Вставить(ИмяТаблицы, Таблица);
	
	ПараметрыТаблицы = ПараметрыТаблицы(ИмяТаблицы); //инициализируем параметры таблицы
	
	УстановитьВидимостьТаблицыОбработки(ИмяТаблицы, Видимость);
	УстановитьПоляВыводаТаблицы(ИмяТаблицы, ПоляВывода);	
	
	Возврат ПараметрыТаблицы;
	
КонецФункции

Функция УстановитьВидимостьТаблицыОбработки(ИмяТаблицы, Видимость) Экспорт

	ПараметрыТаблицы = ПараметрыТаблицы(ИмяТаблицы);
	ПараметрыТаблицы.Вывод = Видимость;
	УстановитьСвойстваЭлементовВывода(ИмяТаблицы, Новый Структура("Видимость", Видимость));
	
КонецФункции

Функция УстановитьМестоположениеТаблицыОбработки(ИмяТаблицы, МестоПоложение) Экспорт

	ПараметрыТаблицы = ПараметрыТаблицы(ИмяТаблицы);
	ПараметрыТаблицы.МестоПоложение = МестоПоложение;
	УстановитьСвойстваЭлементовВывода(ИмяТаблицы, Новый Структура("Родитель", МестоПоложение));
	
КонецФункции

Функция УстановитьПоляВыводаТаблицы(ИмяТаблицы, знач ПоляВывода=Неопределено) Экспорт
	
	ПараметрыТаблицы = ПараметрыТаблицы(ИмяТаблицы);

	Если ПоляВывода=Неопределено Тогда
		ПоляВывода = ПараметрыТаблицы.Поля;
	КонецЕсли;
	
	РК.УстановитьЭлементыКоллекции(ПараметрыТаблицы.ПоляВывода, ПоляВывода);
	
	Для Каждого ИмяПоля Из ПараметрыТаблицы.Поля Цикл
		ВидимостьПоля = ПараметрыТаблицы.ПоляВывода.Найти(ИмяПоля) <> Неопределено;
		
		ИмяЭлементаВыводаПоля = ИмяТаблицы + ИмяПоля;
		ЭлементВывода = ПолучитьЭлементВывода(ИмяЭлементаВыводаПоля);
		
		СвойстваПоля = Новый Структура;
		СвойстваПоля.Вставить("Видимость", ВидимостьПоля);
		УстановитьСвойстваЭлементовВывода(ЭлементВывода, СвойстваПоля);
	КонецЦикла;
	
КонецФункции

Функция СоздатьЭлементыТаблицыОбработки(ПараметрыТаблицы)
	
	ИмяТаблицы = ПараметрыТаблицы.Имя;
	ЭлементВывода = ПолучитьЭлементВывода(ИмяТаблицы);
	
	СвойстваПоля = Новый Структура;
	СвойстваПоля.Вставить("ТипЭлемента", "ТаблицаФормы");
	СвойстваПоля.Вставить("ТипЗначения", "ТаблицаЗначений");
	СвойстваПоля.Вставить("ПутьКДанным", ИмяТаблицы);
	СвойстваПоля.Вставить("ТолькоПросмотр", Истина);
	СвойстваПоля.Вставить("ДействиеВыбор", "ВыборЭлементаТаблицы");
	Если ПараметрыТаблицы.МестоПоложение <> Неопределено Тогда
		// суффикс "Нового" для того, чтобы не двигать предопределенный элемент на форме
		СвойстваПоля.Вставить("РодительНового", ПараметрыТаблицы.МестоПоложение);
	КонецЕсли;
	УстановитьСвойстваЭлементовВывода(ЭлементВывода, СвойстваПоля);
	
	
	////////////////////////////////////////////////////////////////
	Для Каждого ИмяПоля Из ПараметрыТаблицы.Поля Цикл
		ВидимостьПоля = ПараметрыТаблицы.ПоляВывода.Найти(ИмяПоля) <> Неопределено;
		
		ИмяЭлементаВыводаПоля = ИмяТаблицы + ИмяПоля;
		ЭлементВывода = ПолучитьЭлементВывода(ИмяЭлементаВыводаПоля);
		СвойстваУстановленныеЯвно = ЭлементВывода.СвойстваУстановленныеЯвно;
		
		СвойстваПоля = Новый Структура;
		Если СвойстваУстановленныеЯвно["Родитель"] <> Истина Тогда
			СвойстваПоля.Вставить("РодительНового", ИмяТаблицы);
		КонецЕсли;
		СвойстваПоля.Вставить("ТипЭлемента", "ПолеФормы");
		СвойстваПоля.Вставить("ПутьКДаннымНового", ИмяТаблицы + "." + ИмяПоля);
		УстановитьСвойстваЭлементовВывода(ЭлементВывода, СвойстваПоля);
	КонецЦикла;
	
КонецФункции

Функция ДополнительныеДанныеЭлементаТаблицы(знач ПараметрыТаблицы, ЭлементТаблицы) Экспорт

	Если ТипЗнч(ПараметрыТаблицы)=Тип("Строка") Тогда
		ПараметрыТаблицы = ПараметрыТаблицы(ПараметрыТаблицы);
	КонецЕсли;
	
	ИмяТаблицы = ПараметрыТаблицы.Имя;

	Таблица = ДанныеОбработки.Таблицы[ИмяТаблицы];
	Номер = Таблица.Индекс(ЭлементТаблицы);
	Если Номер=-1 Тогда
		ВызватьИсключение "Элемент не принадлежит таблице """ + ИмяТаблицы + """!";
	КонецЕсли;
	
	ПодготовитьЭлементыДополнительныхДанныхТаблицы(Таблица, ПараметрыТаблицы);
	
	ДополнительныеДанныеЭлемента = ПараметрыТаблицы.ДополнительныеДанныеЭлементов[Номер];
	
	Возврат ДополнительныеДанныеЭлемента;
	
КонецФункции

Функция ПодготовитьЭлементыДополнительныхДанныхТаблицы(Таблица, ПараметрыТаблицы) Экспорт
	
	ДополнительныеДанныеЭлементов = ПараметрыТаблицы.ДополнительныеДанныеЭлементов;

	Номер = ДополнительныеДанныеЭлементов.Количество();
	КоличествоЭлементов = Таблица.Количество();
	Пока Номер < КоличествоЭлементов Цикл
		ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов.Добавить();
		ДополнительныеДанныеЭлемента.Идентификатор = ПараметрыТаблицы.ИдентификаторНовогоЭлемента;
		ДополнительныеДанныеЭлемента.Номер = Номер;
		ДополнительныеДанныеЭлемента.ЗначенияПолей = Новый Структура;
		ДополнительныеДанныеЭлемента.ЗначенияДополнительныхПолей = Новый Структура("ИдентификаторОформления");
		ДополнительныеДанныеЭлемента.Изменен = Истина;
		ДополнительныеДанныеЭлемента.ФлагОбработки = ПараметрыТаблицы.ФлагОбработки - 1;
		ДополнительныеДанныеЭлемента.ЭлементыЗагрузки = Новый Массив;
		ДополнительныеДанныеЭлемента.УдалятьПустые = Истина;
		ДополнительныеДанныеЭлемента.Скрывать = Ложь;
		
		ПараметрыТаблицы.НовыеЭлементы.Добавить(Номер);
		
		ПараметрыТаблицы.ИзмененныеЭлементы.Добавить(Номер);
		ПараметрыТаблицы.ИзмененныеЭлементыВСписке[Номер] = Истина;
		
		ПараметрыТаблицы.ИзмененныеЭлементыДляКлиента.Добавить(Номер);
		ПараметрыТаблицы.ИзмененныеЭлементыВСпискеДляКлиента[Номер] = Истина;
		
		ПараметрыТаблицы.ИдентификаторНовогоЭлемента = ПараметрыТаблицы.ИдентификаторНовогоЭлемента + 1;
		Номер = Номер + 1;
	КонецЦикла;
	
КонецФункции

Функция СкрытьЭлементыТаблицы(ДанныеОбновленияТаблицы, ИндексыЭлементов) Экспорт
	
	ДополнительныеДанныеЭлементов = ДанныеОбновленияТаблицы.ДополнительныеДанныеЭлементов;
	
	Для Каждого ИндексЭлемента Из ИндексыЭлементов Цикл
		ДополнительныеДанныеЭлементов[ИндексЭлемента].Скрывать = Истина;
	КонецЦикла;
	
	ЗарегистрироватьИзмененияЭлементовТаблицы(ДанныеОбновленияТаблицы, ИндексыЭлементов);
	
КонецФункции

Функция ПоказатьЭлементыТаблицы(ДанныеОбновленияТаблицы, ИндексыЭлементов) Экспорт
	
	ДополнительныеДанныеЭлементов = ДанныеОбновленияТаблицы.ДополнительныеДанныеЭлементов;
	
	Для Каждого ИндексЭлемента Из ИндексыЭлементов Цикл
		ДополнительныеДанныеЭлементов[ИндексЭлемента].Скрывать = Ложь;
	КонецЦикла;
	
	ЗарегистрироватьИзмененияЭлементовТаблицы(ДанныеОбновленияТаблицы, ИндексыЭлементов);
	
КонецФункции

Функция ЗарегистрироватьИзмененияЭлементовТаблицы(ДанныеОбновленияТаблицы, ИндексыЭлементов) Экспорт
	
	ИзмененныеЭлементы = ДанныеОбновленияТаблицы.ИзмененныеЭлементы;
	ИзмененныеЭлементыВСписке = ДанныеОбновленияТаблицы.ИзмененныеЭлементыВСписке;
	ИзмененныеЭлементыДляКлиента = ДанныеОбновленияТаблицы.ИзмененныеЭлементыДляКлиента;
	ИзмененныеЭлементыВСпискеДляКлиента = ДанныеОбновленияТаблицы.ИзмененныеЭлементыВСпискеДляКлиента;
	
	Для Каждого ИндексЭлемента Из ИндексыЭлементов Цикл
		Если ИзмененныеЭлементыВСписке[ИндексЭлемента]=Неопределено Тогда
			ИзмененныеЭлементы.Добавить(ИндексЭлемента);
			ИзмененныеЭлементыВСписке[ИндексЭлемента] = Истина;
		КонецЕсли;

		Если ИзмененныеЭлементыВСпискеДляКлиента[ИндексЭлемента]=Неопределено Тогда
			ИзмененныеЭлементыДляКлиента.Добавить(ИндексЭлемента);
			ИзмененныеЭлементыВСпискеДляКлиента[ИндексЭлемента] = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция УстановитьОформлениеЭлементаТаблицы(ИмяТаблицы, Элемент, Свойства) Экспорт
	
	ОформлениеЭлементов = ПараметрыОбработки.ОформлениеЭлементов;
	
	ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементаТаблицы(ИмяТаблицы, Элемент);
	
	СписокВсехСвойств = "ЦветФона";
	ВсеСвойства = Новый Структура(СписокВсехСвойств);
	
	ЭлементОформленияМассив = ОформлениеЭлементов.НайтиСтроки(Новый Структура("Идентификатор", ДополнительныеДанныеЭлемента.ИдентификаторОформления));
	Если ЭлементОформленияМассив.Количество() > 0 Тогда
		ЭлементОформленияМассив0 = ЭлементОформленияМассив[0];
		ЭлементОформленияМассив0.Использование = ЭлементОформленияМассив0.Использование - 1;
		ЗаполнитьЗначенияСвойств(ВсеСвойства, ЭлементОформленияМассив0);
	Иначе
		ЭлементОформленияМассив0 = Неопределено;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ВсеСвойства, Свойства);

	ЭлементОформленияМассив = ОформлениеЭлементов.НайтиСтроки(ВсеСвойства);
	Если ЭлементОформленияМассив.Количество()=0 Тогда
		ЭлементОформления = ОформлениеЭлементов.Добавить();
		ЭлементОформления.ИмяЭлемента = ИмяТаблицы;
		ЭлементОформления.Идентификатор = ПараметрыОбработки.ИдентификаторНовогоЭлементаОформления;
		ЭлементОформления.Использование = 1;
		ЭлементОформления.СвойстваНаКлиенте = Новый Структура(СписокВсехСвойств);
		ЗаполнитьЗначенияСвойств(ЭлементОформления, ВсеСвойства);
		ПараметрыОбработки.ИдентификаторНовогоЭлементаОформления = ПараметрыОбработки.ИдентификаторНовогоЭлементаОформления + 1;
	Иначе
		ЭлементОформления = ЭлементОформленияМассив[0];
		ЭлементОформления.Использование = ЭлементОформления.Использование + 1;
	КонецЕсли;
	
	ДополнительныеДанныеЭлемента.ИдентификаторОформления = ЭлементОформления.Идентификатор;
	
КонецФункции

Функция ОбновитьДанныеТаблицы(ИмяТаблицы, ДанныеДляЗагрузки, ПоляГруппировки, Отбор=Неопределено, ТипОчистки="Удалять", ПустыеДанныеПолей=Неопределено) Экспорт
	
	ПараметрыТаблицы = ПараметрыТаблицы(ИмяТаблицы);
	
	Таблица = ДанныеОбработки.Таблицы[ИмяТаблицы];
	
	Если Отбор <> Неопределено Тогда
		ОтобранныеСтрокиТаблицы = Таблица.НайтиСтроки(Отбор);
	Иначе
		ОтобранныеСтрокиТаблицы = Таблица;
	КонецЕсли;

	ДополнительныеДанныеЭлементов = Новый ТаблицаЗначений;
	ДополнительныеДанныеЭлементов.Колонки.Добавить("Элемент");
	ДополнительныеДанныеЭлементов.Колонки.Добавить("ФлагОбработки");
	
	Для Каждого СтрокаТаблицы Из ОтобранныеСтрокиТаблицы Цикл
		ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов.Добавить();
		ДополнительныеДанныеЭлемента.Элемент = СтрокаТаблицы;
		ДополнительныеДанныеЭлемента.ФлагОбработки = 0;
	КонецЦикла;
	
	ДополнительныеДанныеЭлементов.Индексы.Добавить("Элемент");
	ДополнительныеДанныеЭлементов.Индексы.Добавить("ФлагОбработки");
	
	НовыеЭлементы = Новый Массив;
	ИзмененныеЭлементы = Новый Массив;
	ПоляГруппировкиМассив = РК.ЗначениеВМассив(ПоляГруппировки, , Ложь);
	Поиск = Новый Структура;
	Для Каждого ПолеГруппировки Из ПоляГруппировкиМассив Цикл
		Поиск.Вставить(ПолеГруппировки);
	КонецЦикла;
	
	ПоискДопДанных = Новый Структура("Элемент");
	Для Каждого ЭлементДанных Из РК.ПолучитьЭлементыКоллекции(ДанныеДляЗагрузки) Цикл
		ЗаполнитьЗначенияСвойств(Поиск, ЭлементДанных);
		НайденныеСтроки = Таблица.НайтиСтроки(Поиск);
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаТаблицы = НайденныеСтроки[0];
			ПоискДопДанных.Элемент = СтрокаТаблицы;
			ДополнительныеДанныеЭлементаМассив = ДополнительныеДанныеЭлементов.НайтиСтроки(ПоискДопДанных);
			ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементаМассив[0];
			ДополнительныеДанныеЭлемента.ФлагОбработки = 1;
		Иначе
			СтрокаТаблицы = Таблица.Добавить();
			НовыеЭлементы.Добавить(СтрокаТаблицы);

			ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов.Добавить();
			ДополнительныеДанныеЭлемента.Элемент = СтрокаТаблицы;
			ДополнительныеДанныеЭлемента.ФлагОбработки = 1;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЭлементДанных);
		
		ИзмененныеЭлементы.Добавить(СтрокаТаблицы);
	КонецЦикла;
	
	УдаляемыеЭлементы = ДополнительныеДанныеЭлементов.НайтиСтроки(Новый Структура("ФлагОбработки", 0));
	
	ОчищенныеЭлементы = Новый Массив;
	Если ТипОчистки="Удалять" Тогда
		Для Каждого ДополнительныеДанныеЭлемента Из УдаляемыеЭлементы Цикл
			Таблица.Удалить(ДополнительныеДанныеЭлемента.Элемент);
		КонецЦикла;
	ИначеЕсли ТипОчистки="Заполнять" Тогда
		ПустыеДанныеПолей = ПустыеДанныеПолей;
		Для Каждого ДополнительныеДанныеЭлемента Из УдаляемыеЭлементы Цикл
			Элемент = ДополнительныеДанныеЭлемента.Элемент;
			ЗаполнитьЗначенияСвойств(Элемент, ПустыеДанныеПолей);
			ОчищенныеЭлементы.Добавить(Элемент);
		КонецЦикла;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НовыеЭлементы", НовыеЭлементы);
	Результат.Вставить("ИзмененныеЭлементы", ИзмененныеЭлементы);
	Результат.Вставить("ОчищенныеЭлементы", ОчищенныеЭлементы);
	
	Возврат Результат;

КонецФункции

Функция ПолучитьИзмененияТаблицы(ИмяТаблицы)
	
	Перем ПредыдущееЗначениеПоля;
	
	ПараметрыТаблицы = ПараметрыТаблицы(ИмяТаблицы);
	
	Поля = ПараметрыТаблицы.ПоляВывода;
	
	Таблица = ДанныеОбработки.Таблицы[ИмяТаблицы];
	
	ДополнительныеДанныеЭлементов = ПараметрыТаблицы.ДополнительныеДанныеЭлементов;
	ИдентификаторыНаКлиенте = ПараметрыТаблицы.ИдентификаторыНаКлиенте;
	
	ИзмененияЭлементов = Новый Массив;
	
	ПодготовитьЭлементыДополнительныхДанныхТаблицы(Таблица, ПараметрыТаблицы);
	
	ТипыПредставлений = ПараметрыОбработки.ТипыПредставлений;

	Если ПараметрыТаблицы.ИспользуетсяМетодОбновитьДанныеТаблицы Тогда
		НомераЭлементов = ПараметрыТаблицы.ИзмененныеЭлементыДляКлиента;
		ПараметрыТаблицы.ИзмененныеЭлементыДляКлиента = Новый Массив;
		ПараметрыТаблицы.ИзмененныеЭлементыВСпискеДляКлиента.Очистить();
	Иначе
		НомераЭлементов = Новый Массив;
		Для НомерЭлемента=0 По Таблица.Количество()-1 Цикл
			НомераЭлементов.Добавить(НомерЭлемента);
		КонецЦикла;
	КонецЕсли;
	
	УдаленияЭлементов = ПараметрыТаблицы.УдаленныеЭлементы;
	ПараметрыТаблицы.УдаленныеЭлементы = Новый Массив;

	Для Каждого НомерЭлемента Из НомераЭлементов Цикл
		
		ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов[НомерЭлемента];
		Если ДополнительныеДанныеЭлемента.Скрывать Тогда
			УдаленияЭлементов.Добавить(ДополнительныеДанныеЭлемента.Идентификатор);
			Продолжить;
		КонецЕсли;

		ЭлементТаблицы = Таблица[НомерЭлемента];
		
		ИзменениеЭлемента = Новый Структура;
		
		Если НомерЭлемента <> ДополнительныеДанныеЭлемента.Номер Тогда
			ИзменениеЭлемента.Вставить("Номер", НомерЭлемента);
			ДополнительныеДанныеЭлемента.Номер = НомерЭлемента;
		КонецЕсли;
		
		ИзмененныеЗначенияПолей = Новый Структура;
		ЗначенияПолей = ДополнительныеДанныеЭлемента.ЗначенияПолей;
		Для Каждого Поле Из Поля Цикл
			ЗначениеПоля = ЭлементТаблицы[Поле];
			Если НЕ ЗначенияПолей.Свойство(Поле, ПредыдущееЗначениеПоля) ИЛИ ПредыдущееЗначениеПоля <> ЗначениеПоля Тогда
				ЗначенияПолей.Вставить(Поле, ЗначениеПоля);
				
				//на клиент передаем представления полей
				Если ТипыПредставлений[ТипЗнч(ЗначениеПоля)]=Истина Тогда
					ИзмененныеЗначенияПолей.Вставить(Поле, ЗначениеПоля);
				Иначе
					ИзмененныеЗначенияПолей.Вставить(Поле, Строка(ЗначениеПоля));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ИзмененныеЗначенияПолей.Количество() > 0 Тогда
			ИзменениеЭлемента.Вставить("ЗначенияПолей", ИзмененныеЗначенияПолей);
		КонецЕсли;
		
		ЗначенияДополнительныхПолей = ДополнительныеДанныеЭлемента.ЗначенияДополнительныхПолей;
		Если ЗначенияДополнительныхПолей.ИдентификаторОформления <> ДополнительныеДанныеЭлемента.ИдентификаторОформления Тогда
			ИзменениеЭлемента.Вставить("ИдентификаторОформления", ДополнительныеДанныеЭлемента.ИдентификаторОформления);
			ЗначенияДополнительныхПолей.ИдентификаторОформления = ДополнительныеДанныеЭлемента.ИдентификаторОформления;
		КонецЕсли;
		
		Если ИзменениеЭлемента.Количество() > 0 Тогда
			ИзменениеЭлемента.Вставить("Идентификатор", ДополнительныеДанныеЭлемента.Идентификатор);
			ИзмененияЭлементов.Добавить(ИзменениеЭлемента);
			
			ИдентификаторыНаКлиенте[ДополнительныеДанныеЭлемента.Идентификатор] = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	//отрубим "хвост" таблицы
	НомерПервогоУдаленногоЭлемента = Таблица.Количество();
	НомерЭлемента = ДополнительныеДанныеЭлементов.Количество()-1;
	Пока НомерЭлемента >= НомерПервогоУдаленногоЭлемента Цикл
		ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементов[НомерЭлемента];
		УдаленияЭлементов.Добавить(ДополнительныеДанныеЭлемента.Идентификатор);
		ДополнительныеДанныеЭлементов.Удалить(ДополнительныеДанныеЭлемента);
		НомерЭлемента = НомерЭлемента - 1;
	КонецЦикла;
	
	ИзменениеТаблицы = Новый Структура;
	Если ИзмененияЭлементов.Количество() > 0 Тогда
		ИзменениеТаблицы.Вставить("ИзмененияЭлементов", ИзмененияЭлементов);
	КонецЕсли;
	
	Если УдаленияЭлементов.Количество() > 0 Тогда
		НомерЭлемента = УдаленияЭлементов.Количество();
		Пока НомерЭлемента > 0 Цикл
			НомерЭлемента = НомерЭлемента - 1;
			Идентификатор = УдаленияЭлементов[НомерЭлемента];
			Если ИдентификаторыНаКлиенте[Идентификатор]=Истина Тогда
				ИдентификаторыНаКлиенте.Удалить(Идентификатор);
			Иначе
				УдаленияЭлементов.Удалить(НомерЭлемента);
			КонецЕсли;
		КонецЦикла;
		
		Если УдаленияЭлементов.Количество() > 0 Тогда
			ИзменениеТаблицы.Вставить("УдаленияЭлементов", УдаленияЭлементов);
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыТаблицы.СброситьТекущийЭлемент Тогда
		Если ДополнительныеДанныеЭлементов.Количество() > 0 Тогда
			ИзменениеТаблицы.Вставить("ТекущийЭлемент", ДополнительныеДанныеЭлементов[0].Идентификатор);
		КонецЕсли;
		ПараметрыТаблицы.СброситьТекущийЭлемент = Ложь;
	ИначеЕсли ПараметрыТаблицы.ИдентификаторТекущегоЭлемента <> ПараметрыТаблицы.ИдентификаторТекущегоЭлементаНаКлиенте Тогда
		Если ИдентификаторыНаКлиенте[ПараметрыТаблицы.ИдентификаторТекущегоЭлемента]=Истина Тогда
			ИзменениеТаблицы.Вставить("ТекущийЭлемент", ПараметрыТаблицы.ИдентификаторТекущегоЭлемента);
			ПараметрыТаблицы.ИдентификаторТекущегоЭлементаНаКлиенте = ПараметрыТаблицы.ИдентификаторТекущегоЭлемента;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыТаблицы.Новые Тогда
		ИзменениеТаблицы.Вставить("Очистить", Истина);
		ПараметрыТаблицы.Новые = Ложь;
	КонецЕсли;
	
	Возврат ИзменениеТаблицы;
	
КонецФункции

Функция СортироватьМассив(Массив)
	
	ТаблицаСортировки = Новый ТаблицаЗначений;
	ТаблицаСортировки.Колонки.Добавить("Значение");
	Для Каждого Значение Из Массив Цикл
		ТаблицаСортировки.Добавить().Значение = Значение;
	КонецЦикла;
	ТаблицаСортировки.Сортировать("Значение");
	МассивОтсортированный = ТаблицаСортировки.ВыгрузитьКолонку(0);
	Возврат МассивОтсортированный;
	
КонецФункции

Функция ПолучитьЭлементТаблицыПоИдентификатору(ИмяТаблицы, Идентификатор) Экспорт
	
	ДополнительныеДанныеЭлементаМассив = ПараметрыТаблицы(ИмяТаблицы).ДополнительныеДанныеЭлементов.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
	
	Если ДополнительныеДанныеЭлементаМассив.Количество() > 0 Тогда
		
		ДополнительныеДанныеЭлемента = ДополнительныеДанныеЭлементаМассив[0];
		
		ЭлементТаблицы = ДанныеОбработки.Таблицы[ИмяТаблицы][ДополнительныеДанныеЭлемента.Номер];
		
		Возврат ЭлементТаблицы;
		
	КонецЕсли;
	
КонецФункции

Функция УстановитьТекущийЭлементТаблицы(ИмяТаблицы, Идентификатор) Экспорт
	
	ПараметрыТаблицы(ИмяТаблицы).ИдентификаторТекущегоЭлемента = Идентификатор;
	
КонецФункции

