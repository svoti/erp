#Область ОбработкаШтрихкодов

Функция НайденоНесколькоОбъектовПоШтрихкоду(ДанныеШтрихкода)
	
	Возврат РК.НайтиЭлементыКоллекции(ДанныеШтрихкода.Результат.НайденныеОбъекты, Новый Структура("НомерОбъекта", 2)).Количество() > 0;
	
КонецФункции

Функция ОбработатьВыборОбъектаПоШтрихкоду(ДанныеШтрихкода)
	
	СписокВыбора = ПолучитьСписокВыбораОбъектовПоШтрихкоду(ДанныеШтрихкода);
	
	ПоказатьВыборИзМеню(НовыйОписаниеОповещения("ОбработчикВыборОбъектаПоШтрихкоду"), СписокВыбора);
	
КонецФункции

Функция ОбработчикВыборОбъектаПоШтрихкоду(НомерВыбранныхОбъектов, ДополнительныеПараметры) Экспорт

	Если НомерВыбранныхОбъектов=Неопределено Тогда
		ОтменитьВводДанных();
		Возврат Ложь;
	КонецЕсли;
	
	ВходящиеДанные = ДанныеОбработки.ВходящиеДанные;
	
	ОтобратьВыбранныеОбъектыПоШтрихкоду(ВходящиеДанные.ДанныеШтрихкода, НомерВыбранныхОбъектов);
	ВходящиеДанные.Обработаны = Истина;
	
	ПродолжитьВводДанных();
	
КонецФункции

Функция ОтобратьВыбранныеОбъектыПоШтрихкоду(ДанныеШтрихкода, НомерВыбранныхОбъектов)
	
	Результат = ДанныеШтрихкода.Результат;

	ОтобранныеОбъекты = Новый Массив;
	Для Каждого НайденныйОбъект Из Результат.НайденныеОбъекты Цикл
		Если НайденныйОбъект.НомерОбъекта=НомерВыбранныхОбъектов Тогда
			НайденныйОбъект.НомерОбъекта = 1;
			ОтобранныеОбъекты.Добавить(НайденныйОбъект);
		КонецЕсли;
	КонецЦикла;
	
	Результат.НайденныеОбъекты = ОтобранныеОбъекты;
	ДанныеШтрихкода.Обработан = Истина;
	
КонецФункции

Функция ПолучитьСписокВыбораОбъектовПоШтрихкоду(ДанныеШтрихкода)
	
	СписокВыбора = Новый СписокЗначений;
	
	Для Каждого НайденныйОбъект Из ДанныеШтрихкода.Результат.НайденныеОбъекты Цикл
		ЭлементСписка = СписокВыбора.НайтиПоЗначению(НайденныйОбъект.НомерОбъекта);
		Если ЭлементСписка=Неопределено Тогда
			ЭлементСписка = СписокВыбора.Добавить(НайденныйОбъект.НомерОбъекта, "" + НайденныйОбъект.НомерОбъекта + ".");
		КонецЕсли;
		
		ПредставлениеОбъекта = Строка(НайденныйОбъект.Объект);
		Если ПредставлениеОбъекта="" Тогда
			ПредставлениеОбъекта = "<пусто> (" + ТипЗнч(НайденныйОбъект.Объект) + ")";
		КонецЕсли;
		ЭлементСписка.Представление = СокрП(ЭлементСписка.Представление) + Символы.ПС + " " + ПредставлениеОбъекта + Символы.ПС;
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

Функция ПриЗакрытииПрисвоенияШтрихкода(Штрихкод, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Штрихкод) Тогда
		// получим новые данные по штрих-коду
		вмс_ОбработкаШтрихкодовПовтИсп.УдалитьДанныеШтрихкодаИзКэша(Штрихкод);
		ПолучитьДанныеШтрихкода();
		
		// продолжить ввод с того места, на котором остановились
		ПродолжитьВводДанных();
	Иначе
		ОтменитьВводДанных();
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеШтрихкода()
	
	ВходящиеДанные = ДанныеОбработки.ВходящиеДанные;
	ДанныеШтрихкода = ВходящиеДанные.ДанныеШтрихкода;
	
	Если ЗначениеЗаполнено(ДанныеШтрихкода.Штрихкод) Тогда
		Результат = вмс_ОбработкаШтрихкодовПовтИсп.ОбработатьШтрихкодНовая(ДанныеШтрихкода.Штрихкод);
		
		ДанныеШтрихкода.Результат = РК.СкопироватьОбъект(Результат);
		ДанныеШтрихкода.Результат.НайденныеОбъекты = РК.СкопироватьОбъект(Результат.НайденныеОбъекты, Истина, 1);
	КонецЕсли;
	
КонецФункции

Функция ЗадатьВопросОНеобходимостиПрисвоенияШтрихкода(Результат, ДополнительныеПараметры = Неопределено) Экспорт   
	
	ПараметрыПрисвоения = Новый Структура("Штрихкод, ИзБазы, ИзЗадания, ОтсканированаМарка, Марка",
											ДополнительныеПараметры.Штрихкод, Ложь, Ложь, ДополнительныеПараметры.ОтсканированаМарка, ДополнительныеПараметры.Марка);
	
	Если Результат = "Да. Из базы" Тогда      
		ПараметрыПрисвоения.ИзБазы = Истина;  
		НачатьПрисвоениеШтрихкода(ПараметрыПрисвоения);
	ИначеЕсли Результат = "Да. Из задания" Тогда
		ПараметрыПрисвоения.ИзЗадания = Истина; 
		НачатьПрисвоениеШтрихкода(ПараметрыПрисвоения);
	Иначе
		ОтменитьВводДанных();
	КонецЕсли;
	
КонецФункции

