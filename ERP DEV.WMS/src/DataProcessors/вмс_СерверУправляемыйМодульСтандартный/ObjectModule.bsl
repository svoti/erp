Функция УстановитьОбработчикиСобытийПолейОбработки(Поля=Неопределено, События) Экспорт
	
	Для Каждого Поле Из ПоляОбработки(Поля) Цикл
		
		Для Каждого Событие Из События Цикл
			
			Поле.События.Вставить(Событие.Ключ, Событие.Значение);
			
		КонецЦикла;
		
		//установим передатчик события с элементов вывода на поля обработки
		УстановитьПередаточныйОбработчикСобытийЭлементовВывода(Поле, События);
		
	КонецЦикла;
	
КонецФункции

Функция ВосстановитьИсходныеСвойстваПолейОбработки(Поля=Неопределено) Экспорт
	
	ПоляОбработкиИсходные = ПараметрыОбработки.ПоляОбработкиИсходные;
	
	Отбор = Новый Структура("Имя");
	Для Каждого Поле Из ПоляОбработки(Поля) Цикл
		
		Отбор.Имя = Поле.Имя;
		ИсходныеСвойстваМассив = ПоляОбработкиИсходные.НайтиСтроки(Отбор);
		Если ИсходныеСвойстваМассив.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИсходныеСвойства = ИсходныеСвойстваМассив[0];
		ЗаполнитьЗначенияСвойств(Поле, ИсходныеСвойства);
		
	КонецЦикла;
	
КонецФункции

Функция ДобавитьКомандуКонтекстногоМенюПоля(знач Поле, ИмяКоманды, ЗаголовокКоманды, ОбработчикКоманды) Экспорт
	
	Поле = ПолеОбработки(Поле);
	Если Поле=ПустоеПолеОбработки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ГруппаКнопок = Поле.ИмяЭлементаВывода + "КонтекстноеМеню";
	УстановитьСвойстваЭлементовВывода(ГруппаКнопок, Новый Структура("ТипЭлемента, Родитель", "ГруппаФормы", Поле.ИмяЭлементаВывода));
	Номер = ЭлементыВывода(Новый Структура("Родитель", ГруппаКнопок)).Количество();
	
	ИмяКнопки = ГруппаКнопок + ИмяКоманды;
	УстановитьСвойстваЭлементовВывода(ИмяКнопки, Новый Структура("ТипЭлемента, Заголовок, Родитель, Номер", "КнопкаФормы", ЗаголовокКоманды, ГруппаКнопок, Номер));
	УстановитьОбработчикиСобытийЭлементовВывода(ИмяКнопки, Новый Структура("Нажатие", ОбработчикКоманды));
	Возврат Истина;
	
КонецФункции

