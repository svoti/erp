Функция ОстановитьВводДанных(знач ПропуститьЭтап=Неопределено) Экспорт

	ВводДанных = ПараметрыОбработки.ВводДанных;
	Если ВводДанных.Остановить Тогда
		// уже остановлен
		Возврат Ложь;
	КонецЕсли; 
	
	Если ПропуститьЭтап=Неопределено Тогда
		// по умолчанию пропускаем
		ПропуститьЭтап = Истина;
	КонецЕсли;
	
	ВводДанных.ПропуститьЭтап = ПропуститьЭтап;
	ВводДанных.Остановить = Истина;
	
	Возврат Истина;

КонецФункции

Функция ОтменитьВводДанных() Экспорт

	ОстановитьВводДанных();
	
	ВводДанных = ПараметрыОбработки.ВводДанных;
	Если ВводДанных.Отменить Тогда
		Возврат Ложь;
	КонецЕсли;

	ВводДанных.Отменить = Истина;
	Возврат Истина;
	
