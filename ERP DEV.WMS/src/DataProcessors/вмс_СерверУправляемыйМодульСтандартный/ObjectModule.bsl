#Область СборщикиДанных
Функция СборщикДанных(Отбор) Экспорт
	
	СборщикиДанных = СборщикиДанных(Отбор);
	
	Если СборщикиДанных.Количество() > 0 Тогда
		
		Возврат СборщикиДанных[0];
		
	КонецЕсли;
	
КонецФункции

Функция СборщикиДанных(знач Отбор=Неопределено) Экспорт
	
	ТаблицаСборщиковДанных = ПараметрыОбработки.ТаблицаСборщиковДанных;
	
	Если Отбор=Неопределено ИЛИ Отбор=ТаблицаСборщиковДанных Тогда
		
		ОтобранныеЭлементы = ТаблицаСборщиковДанных;
		
	Иначе
		
		ОтобранныеЭлементы = РК.ОтобратьЭлементыКоллекции(ТаблицаСборщиковДанных, Отбор, , "Имя, Сборщик");
		
	КонецЕсли;
	
	СборщикиДанных = РК.ВыгрузитьЗначенияКолонкиКоллекции(ОтобранныеЭлементы, "Сборщик");
	
	Возврат СборщикиДанных;
	
КонецФункции

Функция ДобавитьСборщикДанных(ТипСборщика="СборщикДанныхСтандартный", знач ИмяСборщика=Неопределено) Экспорт
	
	Если ИмяСборщика=Неопределено Тогда
		ИмяСборщика = ТипСборщика;
	КонецЕсли;

	СборщикДанных = вмс_СерверУправляемыеОбработки.ПолучитьМодульОбработки(ПараметрыОбработки, ИмяСборщика);
	Если СборщикДанных=Неопределено Тогда
		ИмяМодуляСборщика = "вмс_СерверУправляемыйМодуль" + ТипСборщика;
		ОсновнойМодульСборщика = Обработки[ИмяМодуляСборщика].Создать();
		
		ПараметрыИнициализацияМодуля = Новый Структура;
		ПараметрыИнициализацияМодуля.Вставить("ИмяСборщика", ИмяСборщика);
		ПараметрыИнициализацияМодуля.Вставить("ОсновнойМодульСборщика", ОсновнойМодульСборщика);
		СборщикДанных = вмс_СерверУправляемыеОбработки.ДобавитьМодульОбработки(ПараметрыОбработки, "Обработка.вмс_СерверУправляемыйМодульСборщикДанных", ПараметрыИнициализацияМодуля, ИмяСборщика);
	Иначе
		ПараметрыИнициализацияМодуля = Новый Структура;
		ПараметрыИнициализацияМодуля.Вставить("ИмяСборщика", ИмяСборщика);
		ПараметрыИнициализацияМодуля.Вставить("ОсновнойМодульСборщика", СборщикДанных.ПараметрыМодуля.ОсновнойМодульСборщика);
		СборщикДанных.ВыполнитьДействие(Действие("ИнициализироватьМодульОбработки", ПараметрыИнициализацияМодуля));
	КонецЕсли;

	ЭлементТаблицыСборщиковДанных = ПараметрыОбработки.ТаблицаСборщиковДанных.Добавить();
	ЭлементТаблицыСборщиковДанных.Имя = ИмяСборщика;
	ЭлементТаблицыСборщиковДанных.Сборщик = СборщикДанных;
	
	Возврат СборщикДанных;
	
КонецФункции
