Функция НачатьСборСообщений() Экспорт
	
	СборСообщения = ПараметрыОбработки.СборыСообщений.Добавить();
	СборСообщения.НомерПервогоСообщения = ПолучитьСообщенияПользователю().Количество();
	СборСообщения.Сообщения = Новый Массив;
	
КонецФункции

Функция ЗакончитьСборСообщений() Экспорт

	СборСообщений = ПараметрыОбработки.СборыСообщений[ПараметрыОбработки.СборыСообщений.Количество()-1];
	
	Сообщения = ПолучитьСообщенияПользователю();
	Для НомерСообщения=СборСообщений.НомерПервогоСообщения По Сообщения.Количество()-1 Цикл
		Сообщение = Сообщения[НомерСообщения];
		СборСообщений.Сообщения.Добавить(Сообщение.Текст);
	КонецЦикла;
	
КонецФункции

Функция ОтправитьСобранныеСообщенияВОшибкуДействия() Экспорт
	СборСообщений = ПараметрыОбработки.СборыСообщений[ПараметрыОбработки.СборыСообщений.Количество()-1];
	Для Каждого Сообщение Из СборСообщений.Сообщения Цикл
		ДобавитьОшибкуДействия(Сообщение);
	КонецЦикла;
	ПараметрыОбработки.СборыСообщений.Удалить(СборСообщений);
КонецФункции

Функция СобранныеСообщения() Экспорт
	СборСообщений = ПараметрыОбработки.СборыСообщений[ПараметрыОбработки.СборыСообщений.Количество()-1];
	Возврат СборСообщений.Сообщения;
КонецФункции

Функция УдалитьСобранныеСообщения() Экспорт
	ПараметрыОбработки.СборыСообщений.Удалить(ПараметрыОбработки.СборыСообщений.Количество()-1);
КонецФункции


#Область Диалоги

Функция ПоказатьДиалогНаКлиенте(ОписаниеОповещения=Неопределено, Текст, знач Кнопки=Неопределено, знач Таймаут=Неопределено, КнопкаПоУмолчанию=Неопределено, Заголовок=Неопределено, ИмяЗвука="Сигнал") Экспорт
	
	НомерДиалога = ДобавитьДиалог(ОписаниеОповещения);
	
	Если ТипЗнч(Таймаут) <> Тип("Число") Тогда
		Таймаут = 0;
	КонецЕсли;
	
	ПараметрыДействия = Новый Структура;
	ПараметрыДействия.Вставить("Текст", Текст);
	ПараметрыДействия.Вставить("Кнопки", ПолучитьКнопкиДиалога(Кнопки));
	ПараметрыДействия.Вставить("Таймаут", Таймаут);
	ПараметрыДействия.Вставить("КнопкаПоУмолчанию", КнопкаПоУмолчанию);
	ПараметрыДействия.Вставить("Заголовок", Заголовок);
	ПараметрыДействия.Вставить("ДиалогИД", НомерДиалога);
	ДобавитьДействиеНаКлиенте("ПоказатьДиалог", ПараметрыДействия);
	
	ПроигратьЗвукСхемы(ИмяЗвука);
	
КонецФункции

Функция ПолучитьКнопкиДиалога(ОписаниеКнопок)
	
	Кнопки = Новый СписокЗначений;
	Если ОписаниеКнопок="OK" Тогда
		Кнопки.Добавить("OK");
	ИначеЕсли ОписаниеКнопок="OKОтмена" Тогда //англ OK
		Кнопки.Добавить("OK");
		Кнопки.Добавить("Отмена");
	ИначеЕсли ОписаниеКнопок="ОКОтмена" Тогда //рус ОК
		Кнопки.Добавить("ОК");
		Кнопки.Добавить("Отмена");
	ИначеЕсли ОписаниеКнопок="ДаНет" Тогда
		Кнопки.Добавить("Да");
		Кнопки.Добавить("Нет");
	ИначеЕсли ОписаниеКнопок="ДаНетОтмена" Тогда
		Кнопки.Добавить("Да");
		Кнопки.Добавить("Нет");
		Кнопки.Добавить("Отмена");
	ИначеЕсли ТипЗнч(ОписаниеКнопок)=Тип("Строка") Тогда
		КнопкиМассив = вмс_РаботаСКоллекциями.СтрокуВМассив(ОписаниеКнопок);
		Кнопки.ЗагрузитьЗначения(КнопкиМассив);
	ИначеЕсли ТипЗнч(ОписаниеКнопок)=Тип("СписокЗначений") Тогда
		Для Каждого Элемент Из ОписаниеКнопок Цикл
			НовыйЭлемент = Кнопки.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элемент);
		КонецЦикла;
	Иначе
		Кнопки.Добавить("OK");
	КонецЕсли;
	
	Возврат Кнопки;
	
КонецФункции

Функция ПоказатьФормуДиалога(ОписаниеОповещения=Неопределено, ИмяФормы, Параметры=Неопределено, Заголовок=Неопределено) Экспорт

	НомерДиалога = ДобавитьДиалог(ОписаниеОповещения);
	
	ПараметрыДействия = Новый Структура;
	ПараметрыДействия.Вставить("ИмяФормы", ИмяФормы);
	ПараметрыДействия.Вставить("Параметры", Параметры);
	ПараметрыДействия.Вставить("Заголовок", Заголовок);
	ПараметрыДействия.Вставить("ДиалогИД", НомерДиалога);
	ДобавитьДействиеНаКлиенте("ПоказатьФормуДиалога", ПараметрыДействия);
	
КонецФункции

Функция ДействиеОбработатьОтветДиалога(Действие)
	
	ПараметрыФункции = Действие.Параметры;
	
	Диалоги = ПараметрыОбработки.Диалоги;
	ДанныеДиалога = Диалоги.ДанныеДиалогов[ПараметрыФункции.ДиалогИД];
	Если ДанныеДиалога=Неопределено Тогда
		ДобавитьОшибкуДействия("Сервер не дождался ответа. Повторите еще раз");
		Возврат УстановитьРезультатДействия(Действие, Ложь);
	КонецЕсли;
	
	Диалоги.ДанныеДиалогов.Удалить(ПараметрыФункции.ДиалогИД);
	
	ОписаниеОповещения = ДанныеДиалога.ОписаниеОповещения;
	Если ОписаниеОповещения <> Неопределено Тогда
		вмс_СерверУправляемыеОбработки.ВыполнитьОбработкуОповещенияПереопределенный(ОписаниеОповещения, ПараметрыФункции.Ответ);
	КонецЕсли;
	
	Возврат УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция ДобавитьДиалог(ОписаниеОповещения) Экспорт
	
	Диалоги = ПараметрыОбработки.Диалоги;
	Диалоги.НомерДиалога = Диалоги.НомерДиалога + 1;
	НомерДиалога = Диалоги.НомерДиалога;
	
	ДанныеДиалога = Новый Структура;
	ДанныеДиалога.Вставить("НомерДиалога", НомерДиалога);
	ДанныеДиалога.Вставить("ОписаниеОповещения", ОписаниеОповещения);
	
	Диалоги.ДанныеДиалогов[НомерДиалога] = ДанныеДиалога;
	
	Возврат НомерДиалога;
	
КонецФункции

Функция ПоказатьВыборИзМеню(ОписаниеОповещения, СписокЗначений, ЭлементФормы=Неопределено) Экспорт
	
	НомерДиалога = ДобавитьДиалог(ОписаниеОповещения);

