Функция ОбработчикЭтапаВводаДанных_КонецВвода(Параметр, ДополнительныеПараметры) Экспорт
	
	Если НачатьВводДанных() Тогда
		// начать ввод следующего элемента данных
	Иначе
		// ввод данных завершен
		// вернемся к вводу предыдущих данных (если есть)
		ВводДанных = ПараметрыОбработки.ВводДанных;
		Если ВводДанных.СтекВходящихДанных.Количество() > 0 Тогда
			ДанныеОбработки.ВходящиеДанные = ВводДанных.СтекВходящихДанных.Получить(ВводДанных.СтекВходящихДанных.Количество()-1);
			ВводДанных.СтекВходящихДанных.Удалить(ВводДанных.СтекВходящихДанных.Количество()-1);
			ВводДанных.НомерНовогоЭтапа = НомерНовогоЭтапаВвода();
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция	ПроанализироватьЗаполнениеПолейДанныхОбработки(ИмяДанных=Неопределено, СборщикиДанных=Неопределено) Экспорт
	
	Если ИмяДанных=Неопределено Тогда
		ИмяДанных = "ВведенныеДанныеПолей, ЗапланированныеДанныеПолей, СобранныеДанныеПолей, ОбщиеДанныеПолей";
	КонецЕсли;
	
	ИмяДанныхМассив = РК.ЗначениеВМассив(ИмяДанных, , Ложь);
	
	Для Каждого ИмяДанных Из ИмяДанныхМассив Цикл
		
		Если ИмяДанных="ВведенныеДанныеПолей" Тогда
			Поля = ТаблицаПолейОбработки(Новый Структура("Ввод", Истина));
			ИмяРезультата = "РезультатАнализаЗаполненияПолейДанныхВвода";
		ИначеЕсли ИмяДанных="ЗапланированныеДанныеПолей" Тогда
			Поля = ТаблицаПолейОбработки(Новый Структура("План", Истина));
			ИмяРезультата = "РезультатАнализаЗаполненияПолейДанныхПлана";
		ИначеЕсли ИмяДанных="СобранныеДанныеПолей" Тогда
			Поля = ТаблицаПолейОбработки(Новый Структура("Сборка", Истина));
			ИмяРезультата = "РезультатАнализаЗаполненияПолейДанныхСборки";
		ИначеЕсли ИмяДанных="ОбщиеДанныеПолей" Тогда
			Поля = ТаблицаПолейОбработки();
			ИмяРезультата = "РезультатАнализаЗаполненияПолейОбщихДанных";
		Иначе
			ВызватьИсключение "Неизвестный вид данных полей """ + ИмяДанных + """";
		КонецЕсли;

		Поля.Сортировать("ПорядокВвода");
		
		Результат = Обработки.вмс_СерверУправляемыйМодульСборщикДанных.НовыйРезультатАнализаЗаполненияПолейДанных();
		
		ЕстьЗаполненныеОсновныеПоля = Ложь;
		ЕстьНеЗаполненныеОсновныеПоля = Ложь;
		
		Для Каждого Поле Из Поля Цикл
			
			ИмяПоля = Поле.Имя;
			
			Для Каждого Сборщик Из СборщикиДанных(СборщикиДанных) Цикл
				РезультатСборщика = Сборщик.ДанныеТранзакции[ИмяРезультата];
				Если РезультатСборщика.ЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено Тогда
					Результат.ЗаполненныеПоляМассив.Добавить(ИмяПоля);
					Если НЕ Поле.Ресурс Тогда
						ЕстьЗаполненныеОсновныеПоля = Истина;
					КонецЕсли;
				КонецЕсли;

				Если РезультатСборщика.НеЗаполненныеПоляМассив.Найти(ИмяПоля) <> Неопределено Тогда
					Результат.НеЗаполненныеПоляМассив.Добавить(ИмяПоля);
					Если НЕ Поле.Ресурс Тогда
						ЕстьНеЗаполненныеОсновныеПоля = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		Результат.ОсновныеПоляЗаполнены = ЕстьЗаполненныеОсновныеПоля И НЕ ЕстьНеЗаполненныеОсновныеПоля;
		
		Обработки.вмс_СерверУправляемыйМодульСборщикДанных.ФинализироватьРезультатАнализаЗаполненияПолейДанных(Результат);
		
		ПараметрыОбработки.ДанныеТранзакции.Вставить(ИмяРезультата, Результат);
		
	КонецЦикла;
	
КонецФункции

Функция ДействиеПослеЗаполненияДанныхПолей(Действие)
	
	ОбновитьКонтекстныеКомандыПолей();

