// передает событие дальше на связанные с элементом поля обработки
Функция ПередаточныйОбработчикСобытияЭлементаВывода(Параметры, ДополнительныеПараметры) Экспорт
	
	ИмяЭлементаВывода = ДополнительныеПараметры.ИмяЭлементаВывода;
	ИмяСобытия = ДополнительныеПараметры.ИмяСобытия;
	
	ПоляДляОповещения = ПоляОбработки(Новый Структура("ИмяЭлементаВывода", ИмяЭлементаВывода));
	
	ОбработчикСобытияПоля = Неопределено;
	Для Каждого ПолеОбработки Из ПоляДляОповещения Цикл
		ПолеОбработки.События.Свойство(ИмяСобытия, ОбработчикСобытияПоля);
		
		Если ОбработчикСобытияПоля <> Неопределено Тогда
			
			вмс_СерверУправляемыеОбработки.ВыполнитьОбработкуОповещенияПереопределенный(ОбработчикСобытияПоля, Параметры);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ЗадействоватьМеханизмПрисвоенияШтрихкодаПриСканировании(ДанныеШтрихкода)   
	//Для автономной операции+  
	ВходящиеДанные = ДанныеОбработки.ВходящиеДанные;
	Если ВходящиеДанные.Свойство("ПрисвоениеШтрихкода") И ВходящиеДанные.ПрисвоениеШтрихкода Тогда
		Возврат Истина;
	КонецЕсли;
	//-
	
	//Для присвоения из операции+
	Оператор = ПараметрыОбработки.НастройкаОператора; 
	//3.2.4 ТУ_Прошин_18.06.26+   
	ДанныеМаркировки = ДанныеШтрихкода.Результат.ДанныеМаркировки;
	//3.2.4  ТУ_Прошин_18.06.26-
	
	Если Оператор.РазрешитьПрисвоениеШтрихкода Тогда   
		//3.2.4 ТУ_Прошин_18.06.26 + 
		//ДопПараметры = Новый Структура("Штрихкод", ДанныеШтрихкода.Штрихкод);     
		Если ЗначениеЗаполнено(ДанныеМаркировки) И ДанныеМаркировки.Разобран И ДанныеМаркировки.ИдентифицируетЭкземпляр Тогда  
			НеизвестныйШтрихкод = ДанныеМаркировки.EAN; 
			ДопПараметры = Новый Структура("Штрихкод, ОтсканированаМарка, Марка", НеизвестныйШтрихкод, Истина, ДанныеШтрихкода.Штрихкод);     
		Иначе   
			НеизвестныйШтрихкод = ДанныеШтрихкода.Штрихкод;
			ДопПараметры = Новый Структура("Штрихкод, ОтсканированаМарка, Марка", НеизвестныйШтрихкод, Ложь, ""); 
		КонецЕсли;
		//3.2.4  ТУ_Прошин_18.06.26 -
		
		ОО = вмс_СерверУправляемыеОбработки.НовыйОписаниеОповещения("ЗадатьВопросОНеобходимостиПрисвоенияШтрихкода", ПараметрыОбработки, ЭтотОбъект,ДопПараметры);
		Кнопки = Новый СписокЗначений;   
		Кнопки.Добавить("Да. Из задания");
		Кнопки.Добавить("Да. Из базы");
        Кнопки.Добавить("Нет");
		ПоказатьДиалогНаКлиенте(ОО,СтрШаблон("Штрих-код не опознан: %1. Присвоить штрихкод?", НеизвестныйШтрихкод),Кнопки, , , , "Нераспознано");
		Возврат Истина;
	КонецЕсли;
	//-
	
	Возврат Ложь
КонецФункции  

Функция НачатьПрисвоениеШтрихкода(ПараметрыПрисвоения)  
	//ТУ_Прошин_26.03.26+	
		
	ПараметрыИнициализации = Новый Структура;
	ПараметрыИнициализации.Вставить("Штрихкод", ПараметрыПрисвоения.Штрихкод);  
	//3.2.4  ТУ_Прошин_18.06.26+  
	ПараметрыИнициализации.Вставить("ОтсканированаМарка", ПараметрыПрисвоения.ОтсканированаМарка); 
	ПараметрыИнициализации.Вставить("Марка", ПараметрыПрисвоения.Марка); 
	//3.2.4  ТУ_Прошин_18.06.26-
	ПараметрыИнициализации.Вставить("ИзБазы", ПараметрыПрисвоения.ИзБазы);
	ПараметрыИнициализации.Вставить("ИзЗадания", ПараметрыПрисвоения.ИзЗадания); 
	Если ПараметрыОбработки.Свойство("Задание") Тогда 
		ПараметрыИнициализации.Вставить("ДокументСсылка", ПараметрыОбработки.Задание.Ссылка); 
		КонецЕсли;
	ПараметрыИнициализации.Вставить("НастройкаОператора", ПараметрыОбработки.НастройкаОператора); 
	Если ПараметрыОбработки.Свойство("Склад") Тогда 	
		ПараметрыИнициализации.Вставить("Склад", ПараметрыОбработки.Склад);    
	КонецЕсли;
	вмс_СерверУправляемыеОбработки.СоздатьОбработку("Обработка.вмс_СерверУправляемыйМодульОперацияПоЯчейкамПрисвоениеШтрихкода", ПараметрыИнициализации, ПараметрыОбработки.Идентификатор, НовыйОписаниеОповещения("ПриЗакрытииПрисвоенияШтрихкода"));

	ЗаморозитьТаймеры();
	
	Возврат Истина;
    //ТУ_Прошин_26.03.26+
КонецФункции

