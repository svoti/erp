#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
//Служебные локальные переменные модуля
Перем РК;
Перем ПустойЭлементВывода;
Перем ПустоеПолеОбработки;

#Область API
Функция ВыполнитьДействие(Действие) Экспорт
	
	Код = Действие.Код;
	
	Если Код="СозданиеОбработки" Тогда
		
		ДействиеСозданиеОбработки(Действие);
		
	ИначеЕсли Код="ИнициализироватьПеременныеМодуляОбработки" Тогда

		ДействиеИнициализироватьПеременныеМодуляОбработки(Действие);
		
	ИначеЕсли Код="Инициализировать" Тогда
		
		ДействиеИнициализировать(Действие);
		
	ИначеЕсли Код="ИнициализироватьПараметрыОбработки" Тогда

		ДействиеИнициализироватьПараметрыОбработки(Действие);
		
	ИначеЕсли Код="ИнициализироватьИсточникиДанныхДляЗаполненияПолей" Тогда

		ДействиеИнициализироватьИсточникиДанныхДляЗаполненияПолей(Действие);
		
	ИначеЕсли Код="ИнициализироватьПоляОбработкиПоУмолчанию" Тогда

		ДействиеИнициализироватьПоляОбработкиПоУмолчанию(Действие);
		
	ИначеЕсли Код="ИнициализироватьПоляОбработки" Тогда

		ДействиеИнициализироватьПоляОбработки(Действие);

	ИначеЕсли Код="ЗакончитьИнициализациюПолейОбработки" Тогда
		
		ДействиеЗакончитьИнициализациюПолейОбработки(Действие);
		
	ИначеЕсли Код="ИнициализироватьСборщикиДанных" Тогда
		
		ДействиеИнициализироватьСборщикиДанных(Действие);
		
	ИначеЕсли Код="ОбработатьОшибкуВзаимодействия" Тогда
		
		ДействиеОбработатьОшибкуВзаимодействия(Действие);
		
	ИначеЕсли Код="НачалоОбработки" Тогда
		
		ДействиеНачалоОбработки(Действие);
		
	ИначеЕсли Код="СохранитьСостояниеОбработки" Тогда

		ДействиеСохранитьСостояниеОбработки(Действие);

	ИначеЕсли Код="ВосстановитьСостояниеОбработки" Тогда

		ДействиеВосстановитьСостояниеОбработки(Действие);

	ИначеЕсли Код="ОбработатьВводШтрихкода" Тогда

		ДействиеОбработатьВводШтрихкода(Действие);

	ИначеЕсли Код="НачатьТранзакциюОбработки" Тогда
		
		ДействиеНачатьТранзакциюОбработки(Действие);
		
	ИначеЕсли Код="ОтменитьТранзакциюОбработки" Тогда
		
		ДействиеОтменитьТранзакциюОбработки(Действие);
		
	ИначеЕсли Код="ЗафиксироватьТранзакциюОбработки" Тогда
		
		ДействиеЗафиксироватьТранзакциюОбработки(Действие);
		
	ИначеЕсли Код="ВвестиДанные" Тогда
		
		ДействиеВвестиДанные(Действие);
		
	ИначеЕсли Код="ПослеЗаполненияДанныхПолей" Тогда

		ДействиеПослеЗаполненияДанныхПолей(Действие);

	ИначеЕсли Код="ПриЗавершенииТранзакцииВвода" Тогда // вызывается до переноса данные транзакции в основные данные
		
		ДействиеПриЗавершенииТранзакцииВвода(Действие);
		
	ИначеЕсли Код="ПослеЗавершенияТранзакцииВвода" Тогда
		
		ДействиеПослеЗавершенияТранзакцииВвода(Действие);
		
	ИначеЕсли Код="ПослеЗавершенияВвода" Тогда
		
		ДействиеПослеЗавершенияВвода(Действие);
		
	ИначеЕсли Код="ЕстьИзменениеДанных" Тогда

		ДействиеЕстьИзменениеДанных(Действие);
		
	ИначеЕсли Код="ЗаполнитьДанныеПолей" Тогда

		ДействиеЗаполнитьДанныеПолей(Действие);
		
	ИначеЕсли Код="ВозобновитьВводДанных" Тогда
		
		ДействиеВозобновитьВводДанных(Действие);
		
	ИначеЕсли Код="ВвестиДанныеНаКлиенте" Тогда
		
		ДействиеВвестиДанныеНаКлиенте(Действие);
		
	ИначеЕсли Код="ВыборЭлементаТаблицы" Тогда
		
		ДействиеВыборЭлементаТаблицы(Действие);
		
	ИначеЕсли Код="СобытиеЭлементаВывода" Тогда
		
		ДействиеСобытиеЭлементаВывода(Действие);
		
	ИначеЕсли Код="Таймер" Тогда

		ДействиеТаймер(Действие);
		
	ИначеЕсли Код="ОбновитьСостояниеКлиента" Тогда

		ДействиеОбновитьСостояниеКлиента(Действие);
		
	ИначеЕсли Код="ПолучениеФормыОбработки" Тогда
		
		ДействиеПолучениеФормыОбработки(Действие);
		
	ИначеЕсли Код="ПриОткрытииФормыОбработки" Тогда
		
		ДействиеПриОткрытииФормыОбработки(Действие);
		
	ИначеЕсли Код="ПослеОткрытияФормыОбработки" Тогда
		
		ДействиеПослеОткрытияФормыОбработки(Действие);
		
	ИначеЕсли Код="ПриСменеСтраницы" Тогда

		ДействиеПриСменеСтраницы(Действие);

	ИначеЕсли Код="ПередЗакрытиемФормыОбработки" Тогда
		
	ИначеЕсли Код="ПриЗакрытииФормыОбработки" Тогда
		
		ПараметрыОбработки.ФормаОткрыта = Ложь;
		ЗавершитьРаботуОбработки();
		
	ИначеЕсли Код="ПослеЗакрытияФормыОбработки" Тогда
		
		//на случай если событие при закрытии не отработало
		ПараметрыОбработки.ФормаОткрыта = Ложь;
		ЗавершитьРаботуОбработки();
		
	ИначеЕсли Код="ОбработатьОтветДиалога" Тогда

		ДействиеОбработатьОтветДиалога(Действие);
		
	КонецЕсли;
	
	Возврат Действие.Результат;
	
КонецФункции
#КонецОбласти

Функция ДействиеСозданиеОбработки(Действие)
	
	УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция ДействиеИнициализироватьПеременныеМодуляОбработки(Действие)

	ПараметрыМодуля.Вставить("ПредыдущийМасштабФормы");
	ПараметрыМодуля.Вставить("ПредыдущийШрифтФормы");
	
КонецФункции

Функция ДействиеИнициализировать(Действие)

	ИнициализироватьПараметрыОбработки(Действие.Параметры);
	Если ПараметрыОбработки.Отказ Тогда
		Возврат УстановитьРезультатДействия(Действие, Ложь);
	КонецЕсли;
	
	ИнициализироватьИсточникиДанныхДляЗаполненияПолей();

	ИнициализироватьПоляОбработкиПоУмолчанию();
	ИнициализироватьПоляОбработки();
	ЗакончитьИнициализациюПолейОбработки();

	ИнициализироватьДанныеОбработки();
	
	ДобавитьКомандыКонтекстногоМенюПолейНачало();
	ИнициализироватьСборщикиДанных();
	ДобавитьКомандыКонтекстногоМенюПолейЗавершение();

	ОбновитьДанныеТранзакции();
	
	Возврат УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция ДействиеПолучениеФормыОбработки(Действие)
	
	УстановитьРезультатДействия(Действие, "ФормаСерверУправляемойОперации");
	
КонецФункции

Функция ДействиеОбработатьОшибкуВзаимодействия(Действие)

	ВосстановитьВводДанных();
	
	Возврат УстановитьРезультатДействия(Действие, Истина);
	
КонецФункции

Функция ДействиеНачалоОбработки(Действие)
	
	ЗаполнитьТаблицы();
	ЗаполнитьДанныеПолей();
	
	ИмяФормы = ПолучитьФормуОбработки();
	
	ОткрытьФормуОбработки("Документ.вмс_ОперацияПоЯчейкам.Форма." + ИмяФормы);
	
	Возврат УстановитьРезультатДействия(Действие, Истина);

КонецФункции

Функция ДействиеИнициализироватьПараметрыОбработки(Действие)
	
	ПараметрыИнициализации = Действие.Параметры.ПараметрыИнициализации;
	Если ПараметрыИнициализации.Свойство("ЭтоАндроидОС") Тогда
		ЭтоАндроидОС = ПараметрыИнициализации.ЭтоАндроидОС;
	Иначе
		ЭтоАндроидОС = Истина;
	КонецЕсли;
	
	ТипыПредставлений = Новый Соответствие;
	ТипыПредставлений[Тип("Неопределено")] = Истина;
	ТипыПредставлений[Тип("Null")] = Истина;
	ТипыПредставлений[Тип("Строка")] = Истина;
	ТипыПредставлений[Тип("Число")] = Истина;
	ТипыПредставлений[Тип("Дата")] = Истина;
	ТипыПредставлений[Тип("Булево")] = Истина;
	ТипыПредставлений[Тип("УникальныйИдентификатор")] = Истина;
	ТипыПредставлений[Тип("ФорматированнаяСтрока")] = Истина;
	ТипыПредставлений[Тип("Картинка")] = Истина;
	
	ОформлениеЭлементов = Новый ТаблицаЗначений;
	ОформлениеЭлементов.Колонки.Добавить("Идентификатор");
	ОформлениеЭлементов.Колонки.Добавить("ИмяЭлемента");
	ОформлениеЭлементов.Колонки.Добавить("Использование");
	ОформлениеЭлементов.Колонки.Добавить("ЦветФона");
	ОформлениеЭлементов.Колонки.Добавить("СвойстваНаКлиенте");
	
	ОформлениеЭлементов.Индексы.Добавить("Идентификатор");

	СборыСообщений = РК.НоваяТаблицаЗначений("НомерПервогоСообщения, Сообщения");
	
	ТаблицаСборщиковДанных = РК.НоваяТаблицаЗначений("Имя, Страница, Сборщик");
	
	Диалоги = Новый Структура;
	Диалоги.Вставить("НомерДиалога", 0);
	Диалоги.Вставить("ДанныеДиалогов", Новый Соответствие);
	
	Таймеры = Новый Структура;
	Таймеры.Вставить("ДанныеТаймеров", Новый Соответствие);
	
	ИсточникиДанныхДляЗаполненияПолей = РК.НоваяТаблицаЗначений("ПутьКДанным, ВнутреннийПуть");
	
	Обработки.вмс_СерверУправляемыйМодульСтандартный.ИнициализироватьДанныеОбработки(ПараметрыОбработки);
	ПустойЭлементВывода = ПараметрыОбработки.ПустойЭлементВывода;
	ПустоеПолеОбработки = ПараметрыОбработки.ПустоеПолеОбработки;

	ДанныеОбработки.Вставить("Таблицы", Новый Структура);
	
	Если НЕ ПараметрыОбработки.Свойство("НастройкаОператора") Тогда
		НастройкаОператора = Неопределено;
		ПараметрыИнициализации.Свойство("НастройкаОператора", НастройкаОператора);
		ПараметрыОбработки.Вставить("НастройкаОператора", НастройкаОператора);
	КонецЕсли;
	
	ПараметрыВыводаHTML = Новый Структура;
	ПараметрыВыводаHTML.Вставить("ОтступЭлементов", "");
	ПараметрыВыводаHTML.Вставить("КоэффициентШрифта_1С_HTML", Новый Структура("_1С, HTML", 8, 13));

	ПараметрыОбработки.Вставить("ВводДанных", НовыйВводДанных());
	ПараметрыОбработки.Вставить("ТаблицаСборщиковДанных", ТаблицаСборщиковДанных);
	ПараметрыОбработки.Вставить("ПоляОбработкиИсходные", ПараметрыОбработки.ПоляОбработки.Скопировать());
	ПараметрыОбработки.Вставить("ТипыПредставлений", ТипыПредставлений);
	ПараметрыОбработки.Вставить("ИдентификаторНовогоЭлементаОформления", 0);
	ПараметрыОбработки.Вставить("ОформлениеЭлементов", ОформлениеЭлементов);
	ПараметрыОбработки.Вставить("ПараметрыТаблиц", Новый Структура);
	ПараметрыОбработки.Вставить("Диалоги", Диалоги);
	ПараметрыОбработки.Вставить("Таймеры", Таймеры);
	ПараметрыОбработки.Вставить("РабочаяСтраница");
	ПараметрыОбработки.Вставить("ИсточникиДанныхДляЗаполненияПолей", ИсточникиДанныхДляЗаполненияПолей);
	ПараметрыОбработки.Вставить("ЭтоАндроидОС", ЭтоАндроидОС);
	ПараметрыОбработки.Вставить("ИмяЗвуковойСхемы", "СтандартнаяСхема");
	ПараметрыОбработки.Вставить("МасштабФормы", 100);
	ПараметрыОбработки.Вставить("ШрифтФормы", Новый Шрифт);
	
	ПараметрыОбработки.Вставить("СборыСообщений", СборыСообщений);
	ПараметрыОбработки.Вставить("ПараметрыВыводаHTML", ПараметрыВыводаHTML);

	УстановитьСвойстваЭлементовВывода("ГлавнаяПанельСтраницаВводДанных", Новый Структура("ТипЭлемента", "ГруппаФормы"));
	
КонецФункции

Функция ДействиеИнициализироватьИсточникиДанныхДляЗаполненияПолей(Действие)

	ДобавитьИсточникДанныхДляЗаполненияПолей("ДанныеВвода", "ПараметрыОбработки.ДанныеТранзакции.ВведенныеДанныеПолей");
	ДобавитьИсточникДанныхДляЗаполненияПолей("ДанныеПлана", "ПараметрыОбработки.ДанныеТранзакции.ЗапланированныеДанныеПолей");
	ДобавитьИсточникДанныхДляЗаполненияПолей("ОбщиеДанные", "ПараметрыОбработки.ДанныеТранзакции.ОбщиеДанныеПолей");
	ДобавитьИсточникДанныхДляЗаполненияПолей("ДанныеСбора", "ПараметрыОбработки.ДанныеТранзакции.СобранныеДанныеПолей");

КонецФункции

Функция ДействиеИнициализироватьПоляОбработкиПоУмолчанию(Действие)
	
