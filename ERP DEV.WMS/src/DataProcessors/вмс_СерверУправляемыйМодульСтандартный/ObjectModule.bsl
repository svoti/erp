Функция ДобавитьИсточникДанныхДляЗаполненияПолей(ПутьКДанным, ВнутреннийПуть) Экспорт
	
	ИсточникДанных = ПараметрыОбработки.ИсточникиДанныхДляЗаполненияПолей.Добавить();
	ИсточникДанных.ПутьКДанным = ПутьКДанным;
	ИсточникДанных.ВнутреннийПуть = ВнутреннийПуть;
	
	Возврат ИсточникДанных;
	
КонецФункции

Функция ИсточникДанныхДляЗаполненияПолей(знач ПутьКДанным) Экспорт

	ПутьКДанным = СтрЗаменить(ПутьКДанным, " ", "");
	ИсточникиДанныхДляЗаполненияПолей = ПараметрыОбработки.ИсточникиДанныхДляЗаполненияПолей;
	
	//поищем по полному пути
	ИсточникДанныхМассив = ИсточникиДанныхДляЗаполненияПолей.НайтиСтроки(Новый Структура("ПутьКДанным", ПутьКДанным));
	Если ИсточникДанныхМассив.Количество() <> 0 Тогда
		Возврат ИсточникДанныхМассив[0];
	КонецЕсли;
	
КонецФункции

Функция ДанныеИсточникаДляЗаполненияПолей(знач ПутьКДанным) Экспорт
	
	ПутьКДанным = СтрЗаменить(ПутьКДанным, " ", "");

	ИсточникДанныхДляЗаполненияПолей = ИсточникДанныхДляЗаполненияПолей(ПутьКДанным);
	Если ИсточникДанныхДляЗаполненияПолей=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПутьМассив = РК.СтрокуВМассив(ИсточникДанныхДляЗаполненияПолей.ВнутреннийПуть, ".");
	
	Данные = ЭтотОбъект;
	Для Каждого ЭлементПути Из ПутьМассив Цикл
		Данные = Данные[ЭлементПути];
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

