	ПараметрыДействия.Вставить("СписокЗначений", вмс_РаботаСXMLКлиентСервер.СериализироватьВXMLНаСервере(СписокЗначений));
	ПараметрыДействия.Вставить("ДиалогИД", НомерДиалога);
	ДобавитьДействиеНаКлиенте("ПоказатьВыборИзМеню", ПараметрыДействия);
	
