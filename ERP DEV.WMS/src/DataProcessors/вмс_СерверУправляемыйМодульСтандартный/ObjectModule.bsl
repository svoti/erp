Функция ОбновитьКонтекстныеКомандыПолей()
	
	ЗаполненныеПоляВводаМассив = ДанныеОбработки.РезультатАнализаЗаполненияПолейДанныхВвода.ЗаполненныеПоляМассив;
	ЗаполненныеПоляОбщихДанныхМассив = ДанныеОбработки.РезультатАнализаЗаполненияПолейОбщихДанных.ЗаполненныеПоляМассив;
	
	Для Каждого ПолеВводаВывода Из ПоляОбработки(Новый Структура("Ввод, Вывод", Истина, Истина)) Цикл
		
		ИмяПоля = ПолеВводаВывода.Имя;
		
		КнопкаОчистить = ЭлементВывода(ПолеВводаВывода.ИмяЭлементаВывода + "КонтекстноеМеню" + "Очистить");
		Если КнопкаОчистить <> Неопределено Тогда
			УстановитьСвойстваЭлементовВывода(КнопкаОчистить, "Видимость", ЗаполненныеПоляВводаМассив.Найти(ИмяПоля) <> Неопределено);
		КонецЕсли;
		
		КнопкаПодтвердить = ЭлементВывода(ПолеВводаВывода.ИмяЭлементаВывода + "КонтекстноеМеню" + "Подтвердить");
		Если КнопкаПодтвердить <> Неопределено Тогда
			УстановитьСвойстваЭлементовВывода(КнопкаПодтвердить, "Видимость", ЗаполненныеПоляВводаМассив.Найти(ИмяПоля)=Неопределено И ЗаполненныеПоляОбщихДанныхМассив.Найти(ИмяПоля) <> Неопределено);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

