Функция ОбработчикЭтапаВводаДанных_НеизвестныйШтрихкод(Параметр, ДополнительныеПараметры) Экспорт

	ВходящиеДанные = ДанныеОбработки.ВходящиеДанные;
	ДанныеШтрихкода = ВходящиеДанные.ДанныеШтрихкода;

	Если ЗначениеЗаполнено(ДанныеШтрихкода.Штрихкод) Тогда
		Результат = ДанныеШтрихкода.Результат;
		Если Результат.НайденныеОбъекты.Количество()=0 Тогда     
			Если ЗадействоватьМеханизмПрисвоенияШтрихкодаПриСканировании(ДанныеШтрихкода) Тогда 
				ОстановитьВводДанных();
			Иначе
				ОтменитьВводДанных();
				ПоказатьДиалогНаКлиенте(, "Штрих-код не опознан: " + ДанныеШтрихкода.Штрихкод, , , , , "Нераспознано");
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ВыборОбъектаПоШтрихкоду(Параметр, ДополнительныеПараметры) Экспорт
	
	ВходящиеДанные = ДанныеОбработки.ВходящиеДанные;
	ДанныеШтрихкода = ВходящиеДанные.ДанныеШтрихкода;

	Если ЗначениеЗаполнено(ДанныеШтрихкода.Штрихкод) Тогда
		Если НайденоНесколькоОбъектовПоШтрихкоду(ДанныеШтрихкода) Тогда
			ОбработатьВыборОбъектаПоШтрихкоду(ДанныеШтрихкода);
			ОстановитьВводДанных();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_ЗавершениеОбработкиШтрихкода(Параметр, ДополнительныеПараметры) Экспорт
	
