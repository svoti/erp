Функция КнопкаТекстHTML(Элемент)
	
	Перем ГорячаяКлавиша, Заголовок, ЦветФона;

	ЭлементыСтиля = Новый Массив;
	Если НЕ Элемент.Видимость Тогда
		ЭлементыСтиля.Добавить("display: none");
	КонецЕсли;
	
	Свойства = Элемент.Свойства;
	Свойства.Свойство("Заголовок", Заголовок);
	Если Заголовок=Неопределено Тогда
		Заголовок = Элемент.Имя;
	КонецЕсли;

	Свойства.Свойство("ЦветФона", ЦветФона);
	Если ТипЗнч(ЦветФона)=Тип("Цвет") И ЦветФона.Вид=ВидЦвета.Абсолютный Тогда
		ЭлементыСтиля.Добавить("background-color: " + ЦветHTML(ЦветФона));
	КонецЕсли;

	Стиль = РК.МассивВСтроку(ЭлементыСтиля, "; ");

	Аттрибуты = Новый Массив;
	Аттрибуты.Добавить("id=""" + Элемент.Имя + """");
	Аттрибуты.Добавить("type=""button""");
	Аттрибуты.Добавить("class=""btn btn-primary""");
	Аттрибуты.Добавить("style=""" + Стиль + """");
	
	Свойства.Свойство("СочетаниеКлавиш", ГорячаяКлавиша);
	Если ГорячаяКлавиша <> Неопределено Тогда
		Аттрибуты.Добавить("hotkey=""" + ГорячаяКлавиша + """");
	КонецЕсли;
	СтрокаАттрибутов = РК.МассивВСтроку(Аттрибуты, " ");

	ТекстHTMLЭлемента = "";
	ТекстHTMLЭлемента = ТекстHTMLЭлемента + "<div class=""button-group"">" + Символы.ПС;
    ТекстHTMLЭлемента = ТекстHTMLЭлемента + "	<button " + СтрокаАттрибутов + ">" + Заголовок + "</button>" + Символы.ПС;
    ТекстHTMLЭлемента = ТекстHTMLЭлемента + "<div>";
	
	Возврат ТекстHTMLЭлемента;
	
КонецФункции

Функция ЗаголовокЭлементаТекстHTML(Элемент)
	
	Перем ПоложениеЗаголовка, ГоризонтальноеПоложение, Заголовок, ШрифтЗаголовка;
	
	ТекстHTMLЭлемента = "";

	Свойства = Элемент.Свойства;
	Свойства.Свойство("ПоложениеЗаголовка", ПоложениеЗаголовка);
	Если ПоложениеЗаголовка="Нет" Тогда
		Возврат ТекстHTMLЭлемента;
	КонецЕсли;

	Свойства.Свойство("ГоризонтальноеПоложение", ГоризонтальноеПоложение);

	Свойства.Свойство("Заголовок", Заголовок);
	Если Заголовок=Неопределено Тогда
		Заголовок = Элемент.Имя;
	КонецЕсли;
	Заголовок = СтрокаHTML(Заголовок);
	
	ЭлементыСтиля = Новый Массив;

	Свойства.Свойство("ШрифтЗаголовка", ШрифтЗаголовка);
	ДобавитьШрифт1СВСтильЭлементаHTML(ЭлементыСтиля, ШрифтЗаголовка);
		
	Если ГоризонтальноеПоложение="Центр" Тогда
		ЭлементыСтиля.Добавить("text-align: center");
	КонецЕсли;
	
	Стиль = РК.МассивВСтроку(ЭлементыСтиля, "; ");
	
	ТекстHTMLЭлемента = ТекстHTMLЭлемента + "<label class=""form-label"" style=""" + Стиль + """>" + Заголовок + "</label>";

	Возврат ТекстHTMLЭлемента;

КонецФункции

Функция ДобавитьШрифт1СВСтильЭлементаHTML(ЭлементыСтиля, Шрифт1С)

	Если Шрифт1С=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ШрифтHTML = ШрифтHTMLИз1С(Шрифт1С);
	
	РазделительШрифта = "; ";

	СтильШрифта = "";
	
	Если ЗначениеЗаполнено(ШрифтHTML.Имя) Тогда
		СтильШрифта = СтильШрифта + "font-family: " + ШрифтHTML.Имя + РазделительШрифта;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШрифтHTML.Размер) Тогда
		СтильШрифта = СтильШрифта + "font-size: " + ШрифтHTML.Размер + РазделительШрифта;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШрифтHTML.Толщина) Тогда
		СтильШрифта = СтильШрифта + "font-weight: " + ШрифтHTML.Толщина + РазделительШрифта;
	КонецЕсли;
	
	Если СтильШрифта="" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтильШрифта = Лев(СтильШрифта, СтрДлина(СтильШрифта)-СтрДлина(РазделительШрифта));
	
	ЭлементыСтиля.Добавить(СтильШрифта);
	Возврат Истина;

КонецФункции

Функция ШрифтHTMLИз1С(Шрифт1С)
	
	КоэффициентШрифта_1С_HTML = ПараметрыОбработки.ПараметрыВыводаHTML.КоэффициентШрифта_1С_HTML;
	
	РазмерШрифтаHTML = КоэффициентШрифта_1С_HTML.HTML;
	РазмерШрифта1С = КоэффициентШрифта_1С_HTML._1С;
	
	Шрифт1СНаКлиенте = ШрифтНаКлиенте(Шрифт1С);
	Если ЗначениеЗаполнено(Шрифт1СНаКлиенте.Имя) Тогда
		Имя = Шрифт1СНаКлиенте.Имя;
	КонецЕсли;
	
	Если Шрифт1СНаКлиенте.Размер <> -1 Тогда
		Размер = Шрифт1СНаКлиенте.Размер * Шрифт1СНаКлиенте.Масштаб * РазмерШрифтаHTML / (100*РазмерШрифта1С);
		Размер = Цел(Размер);
		Размер = "" + ЧислоHTML(Размер) + "px";
	Иначе//Если Шрифт1С.Масштаб <> 100 Тогда
		Размер = "" + Шрифт1СНаКлиенте.Масштаб + "%";
	КонецЕсли;

	ШрифтHTML = Новый Структура;
	ШрифтHTML.Вставить("Имя", Имя);
	ШрифтHTML.Вставить("Размер", Размер);
	ШрифтHTML.Вставить("Толщина", ?(Шрифт1СНаКлиенте.Полужирный=Истина, "bold", Неопределено));
	
	Возврат ШрифтHTML;
	
КонецФункции

Функция ВывестиТекстHTMLЭлемента(HTML, ОтступЭлемента, ТекстHTMLЭлемента)
	
	Если ТекстHTMLЭлемента <> "" Тогда
		
		Для Каждого Строка Из СтрРазделить(ТекстHTMLЭлемента, Символы.ПС, Ложь) Цикл
			HTML = HTML + ОтступЭлемента + Строка + Символы.ПС;
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции

Функция ОбработчикHTMLСобытия(Параметр, ДополнительныеПараметры) Экспорт
	
	ПрефиксСобытия = "https://fakehtmlevent/";
	Если Лев(Параметр, СтрДлина(ПрефиксСобытия))=ПрефиксСобытия Тогда
		ДанныеСобытияJSON = Прав(Параметр, СтрДлина(Параметр)-СтрДлина(ПрефиксСобытия));
		ДанныеСобытия = ПрочитатьЗначениеJSON(ДанныеСобытияJSON);
		ИмяСобытия = ДанныеСобытия.name;
		Если ИмяСобытия="change" Тогда
			ИмяСобытия1С = "ПриИзменении";
		ИначеЕсли ИмяСобытия="click" Тогда
			ИмяСобытия1С = "Нажатие";
		ИначеЕсли ИмяСобытия="dblclick" Тогда
			ИмяСобытия1С = "Выбор";
		ИначеЕсли ИмяСобытия="contextmenu" Тогда
			ИмяСобытия1С = "КонтекстноеМеню";
		Иначе
			ИмяСобытия1С = ИмяСобытия;
		КонецЕсли;
		
		Данные = ДекодироватьЮНИКОДСтроку(ДанныеСобытия.data);
		ОбработатьСобытиеЭлементаВывода(ДанныеСобытия.element, ИмяСобытия1С, Данные);
	КонецЕсли;
	
КонецФункции

Функция ОбработчикОшибкиВыполнения(Параметр, ДополнительныеПараметры) Экспорт
	
	ВызватьИсключение "Ошибка при выполнении JavaScript - " + Параметр;
	
КонецФункции

Функция ДекодироватьЮНИКОДСтроку(ЮНИКОДСтрока)
	
	КодыСимволов = СтрРазделить(ЮНИКОДСтрока, ",", Ложь);
	
	Строка = "";
	
	Для Каждого КодСимвола Из КодыСимволов Цикл
		Строка = Строка + Символ(КодСимвола);
	КонецЦикла;
	
	Возврат Строка;
	
КонецФункции

Функция ЦветHTML(Цвет)
	
	Нули = "00";
	
	ЦветHTML = "#";
	ЦветHTML = ЦветHTML + Прав(Нули + вмс_ОбщегоНазначенияКлиентСервер.ПреобразоватьЧислоВДругуюСистемуСчисления(Цвет.Красный, , 16), 2);
	ЦветHTML = ЦветHTML + Прав(Нули + вмс_ОбщегоНазначенияКлиентСервер.ПреобразоватьЧислоВДругуюСистемуСчисления(Цвет.Зеленый, , 16), 2);
	ЦветHTML = ЦветHTML + Прав(Нули + вмс_ОбщегоНазначенияКлиентСервер.ПреобразоватьЧислоВДругуюСистемуСчисления(Цвет.Синий, , 16), 2);
	
	Возврат ЦветHTML;
	
КонецФункции

Функция СтрокаHTML(Строка)
	
	СтрокаHTML = Строка;
	СтрокаHTML = СтрЗаменить(СтрокаHTML, "<", "&lt;");
	СтрокаHTML = СтрЗаменить(СтрокаHTML, ">", "&gt;");
	
	Возврат СтрокаHTML;
	
КонецФункции

Функция ЧислоHTML(Число)
	
	Возврат Формат(Число, "ЧРД=.; ЧН=0; ЧГ=0");
	
КонецФункции

Функция ОчиститьКлиентскийКэшПредставления() Экспорт

	Для Каждого ЭлементВывода Из ПараметрыОбработки.ЭлементыВывода Цикл
		ЭлементВывода.Обновить = Истина;
		ЭлементВывода.СвойстваНаКлиенте.Очистить();
	КонецЦикла;
		
	Для Каждого ЭлементПараметрыТаблицы Из ПараметрыОбработки.ПараметрыТаблиц Цикл
		ПараметрыТаблицы = ЭлементПараметрыТаблицы.Значение;
		ПараметрыТаблицы.Новые = Истина;
		Для Каждого ДополнительныеДанныеЭлемента Из ПараметрыТаблицы.ДополнительныеДанныеЭлементов Цикл
			ДополнительныеДанныеЭлемента.ЗначенияПолей.Очистить();
			Для Каждого ЗначениеДополнительногоПоля Из ДополнительныеДанныеЭлемента.ЗначенияДополнительныхПолей Цикл
				ДополнительныеДанныеЭлемента.ЗначенияДополнительныхПолей[ЗначениеДополнительногоПоля.Ключ] = Неопределено;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ЭлементОформления Из ПараметрыОбработки.ОформлениеЭлементов Цикл
		СвойстваНаКлиенте = ЭлементОформления.СвойстваНаКлиенте;
		Для Каждого СвойствоНаКлиенте Из СвойстваНаКлиенте Цикл
			СвойстваНаКлиенте[СвойствоНаКлиенте.Ключ] = Неопределено;
		КонецЦикла;
	КонецЦикла;
		
КонецФункции

Функция ПолучитьДанныеЭлементовВыводаДляПередачиНаКлиент()

	ДанныеЭлементов = Новый Массив;
	ЭлементыВывода = ПараметрыОбработки.ЭлементыВывода;
	
	ИзмененныеЭлементыВывода = ЭлементыВывода.НайтиСтроки(Новый Структура("Обновить", Истина));
	Если ИзмененныеЭлементыВывода.Количество()=0 Тогда
		Возврат ДанныеЭлементов;
	КонецЕсли;
	
	//требуется сортировка так, как при индексированом отборе не сохраняется порядок строк
	СортировочнаяТаблица = Новый ТаблицаЗначений;
	СортировочнаяТаблица.Колонки.Добавить("Удалить");
	СортировочнаяТаблица.Колонки.Добавить("Уровень");
	СортировочнаяТаблица.Колонки.Добавить("Родитель"); //для того, чтобы элементы разных родителей не смешивались в списке (для наглядности при отладке кода)
	СортировочнаяТаблица.Колонки.Добавить("Номер");
	СортировочнаяТаблица.Колонки.Добавить("ЭлементВывода");
	
	Для Каждого ЭлементВывода Из ИзмененныеЭлементыВывода Цикл
		ЭлементСортировочнойТаблицы = СортировочнаяТаблица.Добавить();
		ЭлементСортировочнойТаблицы.Удалить = ЭлементВывода.Удалить;
		ЭлементСортировочнойТаблицы.Уровень = ЭлементВывода.Уровень;
		ЭлементСортировочнойТаблицы.Родитель = ЭлементВывода.Родитель;
		ЭлементСортировочнойТаблицы.Номер = ЭлементВывода.Номер;
		ЭлементСортировочнойТаблицы.ЭлементВывода = ЭлементВывода;
	КонецЦикла;
	СортировочнаяТаблица.Сортировать("Удалить, Уровень, Родитель, Номер");
	
	ИзмененныеЭлементыВывода.Очистить();
	Для Каждого ЭлементСортировочнойТаблицы Из СортировочнаяТаблица Цикл
		ИзмененныеЭлементыВывода.Добавить(ЭлементСортировочнойТаблицы.ЭлементВывода);
	КонецЦикла;
	
	ТипыПредставлений = ПараметрыОбработки.ТипыПредставлений;
	ТипЭлемента = Неопределено;
	Видимость = Неопределено;
	Номер = Неопределено;
	Для Каждого ЭлементВывода Из ИзмененныеЭлементыВывода Цикл
		
		Если ЭлементВывода.Новый Тогда
			ЗакончитьИнициализациюЭлементаВывода(ЭлементВывода);
		КонецЕсли;
		
		Свойства = ЭлементВывода.Свойства;
		СвойстваНаКлиенте = ЭлементВывода.СвойстваНаКлиенте;
		СвойстваПередать = ЭлементВывода.СвойстваПередать;
		
		Если СвойстваПередать.Свойство("ТипЗначения") Тогда
			ТипЗначения = СвойстваПередать.ТипЗначения;
			Если ТипЗначения <> Неопределено И ТипЗнч(ТипЗначения)=Тип("ОписаниеТипов") Тогда
				
				Если Свойства.Свойство("СписокВыбора") И Свойства.СписокВыбора <> Неопределено Тогда
					// в качестве значений списка будут переданы числовые идентификаторы,
					ТипЗначения = Новый ОписаниеТипов("Число");
				Иначе
					Свойства.Свойство("ТипЭлемента", ТипЭлемента);
					Если ТипЗначения <> Неопределено Тогда
						Если ТипЭлемента="ПолеНадписи" Тогда
							ТипЗначения = Неопределено;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Если ТипЗначения <> Неопределено Тогда
					Для Каждого Тип Из ТипЗначения.Типы() Цикл
						Если ТипыПредставлений[Тип] <> Истина Тогда
							//Есть недоступные типы, тогда не передаем тип значения
							ТипЗначения = Неопределено;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Если ТипЗначения <> Неопределено Тогда
					ТипЗначения = вмс_РаботаСXMLКлиентСервер.СериализироватьВXMLНаСервере(ТипЗначения);
					СвойстваПередать.ТипЗначения = ТипЗначения;
				Иначе
					СвойстваПередать.Удалить("ТипЗначения");
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;

		ДанныеЭлемента = Новый Структура;
		Для Каждого СвойствоЭлемента Из СвойстваПередать Цикл
			
			ИмяСвойства = СвойствоЭлемента.Ключ;
			ЗначениеСвойства = СвойствоЭлемента.Значение;

			ТипЗначения = ТипЗнч(ЗначениеСвойства);
			Если ТипЗначения=Тип("Картинка") Тогда
				ЗначениеСвойства = вмс_РаботаСXMLКлиентСервер.СериализироватьВXMLНаСервере(ЗначениеСвойства);
			ИначеЕсли ТипЗначения=Тип("СписокЗначений") Тогда
				// на клиент передаем идентификаторы элементов вместо значений
				ЗначениеСвойстваИсходное = ЗначениеСвойства;
				ЗначениеСвойства = Новый СписокЗначений;
				Для Каждого ЭлементСписка Из ЗначениеСвойстваИсходное Цикл
					ПредставлениеЭлемента = ЭлементСписка.Представление;
					Если НЕ ЗначениеЗаполнено(ПредставлениеЭлемента) Тогда
						ПредставлениеЭлемента = Строка(ЭлементСписка.Значение);
					КонецЕсли;
					ЗначениеСвойства.Добавить(ЭлементСписка.ПолучитьИдентификатор()+1, ПредставлениеЭлемента);
				КонецЦикла;
			ИначеЕсли ТипЗначения=Тип("Шрифт") Тогда
				ЗначениеСвойства = ШрифтНаКлиенте(ЗначениеСвойства);
			КонецЕсли;
			
			Если НЕ СвойстваНаКлиенте.Свойство(ИмяСвойства) ИЛИ ЗначениеСвойства <> СвойстваНаКлиенте[ИмяСвойства] Тогда
				ДанныеЭлемента.Вставить(ИмяСвойства, ЗначениеСвойства);
				СвойстваНаКлиенте.Вставить(ИмяСвойства, ЗначениеСвойства);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДанныеЭлемента.Количество() > 0 Тогда
			Если ДанныеЭлемента.Свойство("ТипЗначения") ИЛИ ДанныеЭлемента.Свойство("ТипЭлемента") ИЛИ ДанныеЭлемента.Свойство("ПутьКДанным") Тогда
				//при изменении основных свойств потребуется создать элемент заново, для этого потребуются также другие свойства
				//передадим все свойства
				Для Каждого Свойство Из СвойстваНаКлиенте Цикл
					ДанныеЭлемента.Вставить(Свойство.Ключ, Свойство.Значение);
				КонецЦикла;
			КонецЕсли;
			
			Если ДанныеЭлемента.Свойство("Видимость", Видимость) И Видимость Тогда
				//переустановим номер так, как соседние элементы могли сдвинуться
				Если СвойстваНаКлиенте.Свойство("Номер", Номер) Тогда
					ДанныеЭлемента.Вставить("Номер", Номер);
				КонецЕсли;
			КонецЕсли;

			ДанныеЭлемента.Вставить("Имя", ЭлементВывода.Имя);
			ДанныеЭлементов.Добавить(ДанныеЭлемента);
		КонецЕсли;
		
		/////////////////////////////////////////////////////////
		Если ЭлементВывода.СвойстваПередать.Свойство("Удалить") Тогда
			ЭлементыВывода.Удалить(ЭлементВывода);
			Продолжить;
		КонецЕсли;
		
		ЭлементВывода.СвойстваПередать.Очистить();
		ЭлементВывода.Обновить = Ложь;

	КонецЦикла;
	
	Возврат ДанныеЭлементов;
	
КонецФункции

Функция ШрифтНаКлиенте(Шрифт)
	
	ШрифтФормы = ПараметрыОбработки.ШрифтФормы;
	
	Масштаб = Цел(Шрифт.Масштаб * ПараметрыОбработки.МасштабФормы * ШрифтФормы.Масштаб / 10000);
	
	Размер = ?(Шрифт.Размер=-1, Неопределено, Шрифт.Размер);
	
	ШрифтНаКлиенте = Новый Шрифт(ШрифтФормы, Шрифт.Имя, Размер, Шрифт.Полужирный, Шрифт.Наклонный, Шрифт.Подчеркивание, Шрифт.Зачеркивание, Масштаб);
	
	Возврат ШрифтНаКлиенте;
	
КонецФункции

Функция ПолучитьДанныеОформленияЭлементовДляПередачиНаКлиент()

	ОформлениеЭлементов = ПараметрыОбработки.ОформлениеЭлементов;
	ИзменениеОформленияЭлементов = Новый Массив;
	УдалениеОформленияЭлементов = Новый Массив;
	УдалитьЭлементыОформления = Новый Массив;
	Для Каждого ЭлементОформления Из ОформлениеЭлементов Цикл
		Если ЭлементОформления.Использование=0 Тогда
			УдалениеОформленияЭлементов.Добавить(ЭлементОформления.Идентификатор);
			УдалитьЭлементыОформления.Добавить(ЭлементОформления);
		Иначе
			ЭлементИзмененияОформления = Новый Структура;
			Для Каждого Свойство Из ЭлементОформления.СвойстваНаКлиенте Цикл
				ИмяСвойства = Свойство.Ключ;
				Значение = ЭлементОформления[ИмяСвойства];
				Если Значение <> Свойство.Значение Тогда
					ЭлементИзмененияОформления.Вставить(ИмяСвойства, Значение);
					ЭлементОформления.СвойстваНаКлиенте.Вставить(ИмяСвойства, Значение);
				КонецЕсли;
			КонецЦикла;

			Если ЭлементИзмененияОформления.Количество() > 0 Тогда
				ЭлементИзмененияОформления.Вставить("Идентификатор", ЭлементОформления.Идентификатор);
				ЭлементИзмененияОформления.Вставить("ИмяЭлемента", ЭлементОформления.ИмяЭлемента);
				ИзменениеОформленияЭлементов.Добавить(ЭлементИзмененияОформления);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементОформления Из УдалитьЭлементыОформления Цикл
		ОформлениеЭлементов.Удалить(ЭлементОформления);
	КонецЦикла;

	ДанныеОформленияЭлементов = Новый Структура;
	Если ИзменениеОформленияЭлементов.Количество() > 0 Тогда
		ДанныеОформленияЭлементов.Вставить("ИзменениеОформленияЭлементов", ИзменениеОформленияЭлементов);
	КонецЕсли;
	
	Если УдалениеОформленияЭлементов.Количество() > 0 Тогда
		ДанныеОформленияЭлементов.Вставить("УдалениеОформленияЭлементов", УдалениеОформленияЭлементов);
	КонецЕсли;
	
	Возврат ДанныеОформленияЭлементов;

КонецФункции

Функция УстановитьСвойстваЭлементовВывода(Элементы=Неопределено, знач СвойстваУстановить=Неопределено, ЗначениеСвойства=Неопределено) Экспорт
	
	Возврат Обработки.вмс_СерверУправляемыйМодульСтандартный.УстановитьСвойстваЭлементовВывода(ПараметрыОбработки, Элементы, СвойстваУстановить, ЗначениеСвойства);
	
КонецФункции

Функция УстановитьОбработчикиСобытийЭлементовВывода(знач Элементы, События) Экспорт
	
	Элементы = ПолучитьЭлементыВывода(Элементы);
	
	Для Каждого Элемент Из Элементы Цикл
		
		Для Каждого Событие Из События Цикл
			
			Элемент.События.Вставить(Событие.Ключ, Событие.Значение);
			
			//обработчики событий на форме
			Элемент.Свойства.Вставить("Действие" + Событие.Ключ, Событие.Ключ + "Элемента");
			Элемент.СвойстваПередать.Вставить("Действие" + Событие.Ключ, Событие.Ключ + "Элемента");
			Элемент.Обновить = Истина;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецФункции

Функция УстановитьПередаточныйОбработчикСобытийЭлементовВывода(Поле, События) Экспорт
	
	Элемент = ПолучитьЭлементВыводаДляПоляОбработки(Поле.ИмяЭлементаВывода, Поле);
	
	СобытияЭлемента = Новый Структура;
	Для Каждого Событие Из События Цикл
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяЭлементаВывода", Элемент.Имя);
		ДополнительныеПараметры.Вставить("ИмяСобытия", Событие.Ключ);
		ПередаточныйОбработчикСобытияЭлементаВывода = НовыйОписаниеОповещения("ПередаточныйОбработчикСобытияЭлементаВывода", , ДополнительныеПараметры);
		СобытияЭлемента.Вставить(Событие.Ключ, ПередаточныйОбработчикСобытияЭлементаВывода);
	КонецЦикла;
	
	УстановитьОбработчикиСобытийЭлементовВывода(Элемент, СобытияЭлемента);
		
	
КонецФункции

Функция ПолучитьЗначениеСвойстваЭлементаВывода(Элемент, ИмяСвойства) Экспорт
	
	ЗначениеСвойства = Неопределено;
	
	ЭлементВывода = ЭлементВывода(Элемент);
	
	Если ЭлементВывода <> ПустойЭлементВывода Тогда
		
		ЭлементВывода.Свойства.Свойство(ИмяСвойства, ЗначениеСвойства);
		
	КонецЕсли;
	
	Возврат ЗначениеСвойства;
	
КонецФункции

Функция СгруппироватьЭлементыВывода(знач Элементы, ТипГруппировки="ГоризонтальнаяВсегда") Экспорт
	
	Элементы = ПолучитьЭлементыВывода(Элементы);
	Если Элементы.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбщийРодитель = ПолучитьОбщегоРодителяЭлементовВывода(Элементы);
	
	ЭлементыДляГруппировки = Новый Массив;
	
	Для Каждого Элемент Из Элементы Цикл
		ИерархияЭлемента = ПолучитьИерархиюЭлементаВывода(Элемент);
		ЭлементДляГруппировки = Элемент;
		Для Каждого Родитель Из ИерархияЭлемента Цикл
			Если Родитель=ОбщийРодитель Тогда
				Прервать;
			КонецЕсли;
			ЭлементДляГруппировки = Родитель;
		КонецЦикла;
		
		Если ЭлементыДляГруппировки.Найти(ЭлементДляГруппировки)=Неопределено Тогда
			ЭлементыДляГруппировки.Добавить(ЭлементДляГруппировки);
		КонецЕсли;
	КонецЦикла;
	
	Группа = Неопределено;
	Если ЭлементыДляГруппировки.Количество()=1 Тогда
		Элемент = ЭлементыДляГруппировки[0];
		Если Элемент.ТипЭлемента="ГруппаФормы" Тогда
			Группа = Элемент;
		КонецЕсли;
	КонецЕсли;
	
	Если Группа=Неопределено Тогда
		
		Элемент = ЭлементыДляГруппировки[0];
		Номер = Элемент.Номер;
		
		ИмяГруппы = "ГруппировкаЭлементов";
		Для Каждого Элемент Из ЭлементыДляГруппировки Цикл
			ИмяГруппы = ИмяГруппы + Элемент.Имя;
		КонецЦикла;
		Группа = НовыйЭлементВывода(ИмяГруппы);
		УстановитьСвойстваЭлементовВывода(Группа, Новый Структура("ТипЭлемента, Родитель, ОтображатьЗаголовок, Номер, Отображение", "ГруппаФормы", ОбщийРодитель, Ложь, Номер, "Нет"));
		
		Номер = 0;
		Для Каждого Элемент Из ЭлементыДляГруппировки Цикл
			УстановитьСвойстваЭлементовВывода(Элемент, Новый Структура("Номер", Номер));
			Номер = Номер + 1;
		КонецЦикла;
		
	КонецЕсли;

	УстановитьСвойстваЭлементовВывода(Группа, Новый Структура("Группировка", ТипГруппировки));
	
	УстановитьСвойстваЭлементовВывода(ЭлементыДляГруппировки, Новый Структура("Родитель", Группа));
	
	Возврат Группа;
	
КонецФункции

Функция РазгруппироватьЭлементыВывода(Элементы) Экспорт
	
	РодителиПотерявшиеДетей = Новый Массив;
	
	Для Каждого Элемент Из ЭлементыВывода(Элементы) Цикл
		
		Родитель = Элемент.Родитель;
		Если Родитель <> Неопределено Тогда
			Дед = ПолучитьЗначениеСвойстваЭлементаВывода(Родитель, "Родитель");
			Если РодителиПотерявшиеДетей.Найти(Родитель)=Неопределено Тогда
				РодителиПотерявшиеДетей.Добавить(Родитель);
			КонецЕсли;
			УстановитьСвойстваЭлементовВывода(Элемент, Новый Структура("Родитель", Дед));
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Родитель Из РодителиПотерявшиеДетей Цикл
		Если СтрНайти(Родитель, "ГруппировкаЭлементов") <> 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Дети = ЭлементыВывода(Новый Структура("Родитель", Родитель));
		Если Дети.Количество()=0 Тогда
			//убьём бездетных родителей
			ПометитьЭлементыВыводаНаУдаление(Родитель);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция ПолучитьОбщегоРодителяЭлементовВывода(знач Элементы) 

	Элементы = ЭлементыВывода(Элементы);
	
	Если Элементы.Количество()=0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИерархияЭлементов = ПолучитьИерархиюЭлементаВывода(Элементы[0]);
	Если ИерархияЭлементов.Количество()=0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для НомерЭлемента=1 По Элементы.Количество()-1 Цикл
		Элемент = Элементы[НомерЭлемента];
		ИерархияЭлемента = ПолучитьИерархиюЭлементаВывода(Элемент);
		
		Если ИерархияЭлемента.Количество()=0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Для Каждого Родитель Из ИерархияЭлемента Цикл
			ИндексЭлемента = ИерархияЭлементов.Найти(Родитель);
			Если ИндексЭлемента <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		КоличествоУдаляемых = ИндексЭлемента;
		Для НомерУдаляемого=1 По КоличествоУдаляемых Цикл
			ИерархияЭлементов.Удалить(0);
		КонецЦикла;
		
		Если ИерархияЭлементов.Количество()=0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщийРодитель = ИерархияЭлементов[0];
	
	Возврат ОбщийРодитель;
	
КонецФункции

Функция ПолучитьИерархиюЭлементаВывода(знач Элемент)
	
	ЭлементыВывода = ПараметрыОбработки.ЭлементыВывода;

	ИерархияЭлемента = Новый Массив;
	
	Отбор = Новый Структура("Имя");
	Пока Элемент.Родитель <> Неопределено Цикл
		
		Отбор.Имя = Элемент.Родитель;
		ЭлементРодительМассив = ЭлементыВывода.НайтиСтроки(Отбор);
		Если ЭлементРодительМассив.Количество()=0 Тогда
			Прервать;
		КонецЕсли;
		
		ЭлементРодитель = ЭлементРодительМассив[0];
		ИерархияЭлемента.Добавить(ЭлементРодитель);
		
		Элемент = ЭлементРодитель;
		
	КонецЦикла;
	
	Возврат ИерархияЭлемента;
	
КонецФункции
		
Функция ПолучитьЭлементВыводаДляПоляОбработки(знач ЭлементВывода, знач ПолеДанныхЭлемента=Неопределено) Экспорт
	
	//получим элемент вывода если было передано имя элемента
	ЭлементВывода = ПолучитьЭлементВывода(ЭлементВывода);
	
	Если ЭлементВывода.Новый Тогда
		ИнициализироватьЭлементВыводаДляПоляОбработки(ЭлементВывода, ПолеДанныхЭлемента);
	КонецЕсли;
	
	Возврат ЭлементВывода;
	
КонецФункции

Функция ИнициализироватьЭлементВыводаДляПоляОбработки(знач ЭлементВывода, знач ПолеДанныхЭлемента=Неопределено) Экспорт
	
	СвойстваУстановить = Новый Структура;
	
	ИмяЭлементаВывода = ЭлементВывода.Имя;

	//Автоопределение свойств:
	
	//// ТИП ЗНАЧЕНИЯ
	ТипЗначенияУстановленныйЯвно = ЭлементВывода.ТипЗначения;
	ТипЗначения = ТипЗначенияУстановленныйЯвно;
	Если ТипЗначения=Неопределено Тогда
		Если ПолеДанныхЭлемента <> Неопределено Тогда
			ТипЗначения = ПолеДанныхЭлемента.ТипЗначения;
		КонецЕсли;
		
		Если ТипЗначения <> Неопределено Тогда
			СвойстваУстановить.Вставить("ТипЗначения", ТипЗначения);
		КонецЕсли;
	КонецЕсли;

	//// ТИП ЭЛЕМЕНТА
	ТипЭлементаУстановленныйЯвно = ЭлементВывода.ТипЭлемента;
	ТипЭлемента = ТипЭлементаУстановленныйЯвно;
	Если ТипЭлемента=Неопределено Тогда
		Если ПолеДанныхЭлемента <> Неопределено Тогда
			ТипЭлемента = ПолеДанныхЭлемента.ТипЭлемента;
		КонецЕсли;

		Если ТипЭлемента=Неопределено Тогда
			Если ТипЗнч(ТипЗначения)=Тип("ОписаниеТипов") Тогда
				Типы = ТипЗначения.Типы();
				Если Типы.Количество()=1 Тогда
					Тип = Типы[0];
					Если Тип=Тип("Булево") Тогда
						ТипЭлемента = "ПолеФлажка";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Если ТипЭлемента=Неопределено Тогда
			Если ПолеДанныхЭлемента <> Неопределено Тогда
				События = ПолеДанныхЭлемента.События;
				Если События.Свойство("НачалоВыбора") ИЛИ События.Свойство("ПриИзменении") Тогда
					ТипЭлемента = "ПолеВвода";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЭлемента=Неопределено Тогда
			ТипЭлемента = "ПолеВвода";
		КонецЕсли;
		
		Если ТипЭлемента <> Неопределено Тогда
			СвойстваУстановить.Вставить("ТипЭлемента", ТипЭлемента);
		КонецЕсли;
	КонецЕсли;
	
	СвойстваУстановить.Вставить("АвтоМаксимальнаяШирина", Ложь);
	СвойстваУстановить.Вставить("МаксимальнаяШирина", 0);
	
	УстановитьСвойстваЭлементовВывода(ЭлементВывода, СвойстваУстановить);
	
	//не изменять пока явно установленные свойства (будут установлены при завершении инициализации, при первой передачи элемента на клиент)
	//чтобы можно было уточнять эти свойства при автоопределении значений свойств
	ЭлементВывода.ТипЗначения = ТипЗначенияУстановленныйЯвно;
	ЭлементВывода.ТипЭлемента = ТипЭлементаУстановленныйЯвно;
	
	Возврат ЭлементВывода;
	
КонецФункции

Функция ЗакончитьИнициализациюЭлементаВывода(ЭлементВывода)
	
	Свойства = ЭлементВывода.Свойства;
	СвойстваПередать = ЭлементВывода.СвойстваПередать;
	
	ТипЭлемента = Неопределено;
	СуффиксСвойств = "";
	ДополнительныеСвойства = Новый Структура;
	Если НЕ Свойства.Свойство("ТипЭлемента", ТипЭлемента) И НЕ Свойства.Свойство("ТипЭлементаНового", ТипЭлемента) Тогда
		Если ЭлементВывода.Имя <> "Форма" Тогда

			СуффиксСвойств = "Нового";
			
			////
			ТипЭлемента = Неопределено;
			Если ТипЭлемента=Неопределено Тогда
				Значение = Неопределено;
				Если Свойства.Свойство("Значение", Значение) Тогда
					Если ТипЗнч(Значение)=Тип("ДвоичныеДанные") Тогда
						Попытка
							Значение = Новый Картинка(Значение);
						Исключение
						КонецПопытки;
					КонецЕсли;

					Если ТипЗнч(Значение)=Тип("Картинка") Тогда
						ТипЭлемента = "ПолеКартинки";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ТипЭлемента=Неопределено Тогда
				Если ЭлементВывода.События.Свойство("Нажатие") Тогда
					ТипЭлемента = "КнопкаФормы";
				КонецЕсли;
			КонецЕсли;

			Если ТипЭлемента=Неопределено Тогда
				ТипЭлемента = "ПолеНадписи";
			КонецЕсли;
			
			ДополнительныеСвойства.Вставить("ТипЭлемента" + СуффиксСвойств, ТипЭлемента);
			
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Свойства.Свойство("ПутьКДанным") И НЕ Свойства.Свойство("ПутьКДаннымНового") Тогда
		ДополнительныеСвойства.Вставить("ПутьКДанным" + СуффиксСвойств, ЭлементВывода.Имя);
	КонецЕсли;
		
	Если ТипЭлемента="ПолеВвода" Тогда
		Если Свойства.Свойство("СписокВыбора") И Свойства.СписокВыбора <> Неопределено Тогда
			Если НЕ Свойства.Свойство("РежимВыбораИзСписка") Тогда
				ДополнительныеСвойства.Вставить("РежимВыбораИзСписка" + СуффиксСвойств, Истина);
			КонецЕсли;
		КонецЕсли;

		Если НЕ Свойства.Свойство("МногострочныйРежим") Тогда
			//ДополнительныеСвойства.Вставить("МногострочныйРежим", Истина);
		КонецЕсли;
		
	ИначеЕсли ТипЭлемента="ПолеНадписи" Тогда
		Если НЕ Свойства.Свойство("ЦветТекста") Тогда
			ДополнительныеСвойства.Вставить("ЦветТекста" + СуффиксСвойств, Новый Цвет(0, 0, 0));
		КонецЕсли;
		Если НЕ Свойства.Свойство("РастягиватьПоВертикали") Тогда
			ДополнительныеСвойства.Вставить("РастягиватьПоВертикали" + СуффиксСвойств, Истина);
		КонецЕсли;
	ИначеЕсли ТипЭлемента="ПолеКартинки" Тогда
		Если НЕ Свойства.Свойство("ПоложениеЗаголовка") Тогда
			ДополнительныеСвойства.Вставить("ПоложениеЗаголовка" + СуффиксСвойств, "Нет");
		КонецЕсли;
		Если НЕ Свойства.Свойство("ТипЗначения") Тогда
			//строка адреса картинки в хранилище
			ДополнительныеСвойства.Вставить("ТипЗначения" + СуффиксСвойств, Новый ОписаниеТипов("Строка"));
		КонецЕсли;
	ИначеЕсли ТипЭлемента="ПолеHTMLДокумента" Тогда
		Если НЕ Свойства.Свойство("ПоложениеЗаголовка") Тогда
			ДополнительныеСвойства.Вставить("ПоложениеЗаголовка" + СуффиксСвойств, "Нет");
		КонецЕсли;
		Если НЕ Свойства.Свойство("ТипЗначения") Тогда
			ДополнительныеСвойства.Вставить("ТипЗначения" + СуффиксСвойств, Новый ОписаниеТипов("Строка"));
		КонецЕсли;
		Если НЕ Свойства.Свойство("ПутьКДанным") Тогда
			ДополнительныеСвойства.Вставить("ПутьКДанным" + СуффиксСвойств, ЭлементВывода.Имя + ", " + ЭлементВывода.Имя + "Буффер");
		КонецЕсли;
	ИначеЕсли ТипЭлемента="ГруппаФормы" Тогда
		Если НЕ Свойства.Свойство("Вид") Тогда
			Родитель = ЭлементВывода(ЭлементВывода.Родитель);
			Если Родитель <> ПустойЭлементВывода И Родитель.ТипЭлемента="ТаблицаФормы" Тогда
				ДополнительныеСвойства.Вставить("Вид" + СуффиксСвойств, "ГруппаКолонок");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ДополнительноеСвойство Из ДополнительныеСвойства Цикл
		Свойства.Вставить(ДополнительноеСвойство.Ключ, ДополнительноеСвойство.Значение);
		СвойстваПередать.Вставить(ДополнительноеСвойство.Ключ, ДополнительноеСвойство.Значение);
	КонецЦикла;

	//
	СтандартныеСвойстваМассив = Новый Массив;
	СтандартныеСвойстваМассив.Добавить("ТипЭлемента");
	СтандартныеСвойстваМассив.Добавить("ТипЗначения");
	
	Для Каждого СтандартноеСвойство Из СтандартныеСвойстваМассив Цикл
		Если Свойства.Свойство(СтандартноеСвойство) Тогда
			ЭлементВывода[СтандартноеСвойство] = Свойства[СтандартноеСвойство];
		КонецЕсли;
	КонецЦикла;
	
	ОчиститьНедоступныеСобытияЭлементаВывода(ЭлементВывода);
	ОчиститьНедоступныеСвойстваЭлементаВывода(ЭлементВывода);

	ЭлементВывода.Новый = Ложь;
	
КонецФункции

Функция ОчиститьНедоступныеСобытияЭлементаВывода(ЭлементВывода)
	
	ТипЭлемента = Неопределено;
	Если НЕ ЭлементВывода.Свойства.Свойство("ТипЭлемента", ТипЭлемента) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Вид = Неопределено;
	ЭлементВывода.Свойства.Свойство("Вид", Вид);
	
	Если ТипЭлемента="ПолеHTMLДокумента" Тогда
		ДоступныеСобытия = "ПриНажатии";
	ИначеЕсли ТипЭлемента="ПолеФлажка" Тогда
		ДоступныеСобытия =
		"ПриИзменении";
	ИначеЕсли ТипЭлемента="ПолеВвода" Тогда
		ДоступныеСобытия =
		"ПриИзменении,
		|АвтоПодбор,
		|ДобавлениеМножественныхЗначений,
		|ИзменениеТекстаРедактирования,
		|НачалоВыбора,
		|НачалоВыбораИзСписка,
		|ОбработкаВыбора,
		|ОбработкаНавигационнойСсылкиМножественногоЗначения,
		|ОбработкаФормированияКоманд,
		|ОкончаниеВводаТекста,
		|Открытие,
		|ОткрытиеМножественногоЗначения,
		|Очистка,
		|Регулирование,
		|Создание,
		|УдалениеМножественныхЗначений";
	ИначеЕсли ТипЭлемента="ПолеНадписи" Тогда
		ДоступныеСобытия =
		"ПриИзменении,
		|Нажатие,
		|ОбработкаНавигационнойСсылки";
	ИначеЕсли ТипЭлемента="КнопкаФормы" Тогда
		ДоступныеСобытия =
		"Нажатие";
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	ДоступныеСобытияМассив = РК.ЗначениеВМассив(ДоступныеСобытия);
	СобытияМассив = РК.ВыгрузитьЗначенияКолонкиКоллекции(ЭлементВывода.События, "Ключ");
	НедоступныеСобытияМассив = РК.ВычитаниеМассивов(СобытияМассив, ДоступныеСобытияМассив);
	Если НедоступныеСобытияМассив.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого НедоступноеСобытие Из НедоступныеСобытияМассив Цикл
		//ЭлементВывода.События.Удалить(НедоступноеСобытие);
		ЭлементВывода.Свойства.Удалить("Действие" + НедоступноеСобытие);
		ЭлементВывода.СвойстваПередать.Удалить("Действие" + НедоступноеСобытие);
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

Функция ОчиститьНедоступныеСвойстваЭлементаВывода(ЭлементВывода)
	
	ТипЭлемента = Неопределено;
	Если НЕ ЭлементВывода.Свойства.Свойство("ТипЭлемента", ТипЭлемента) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВидЭлемента = Неопределено;
	УстановленВидЭлемента = ЭлементВывода.Свойства.Свойство("Вид", ВидЭлемента) И ВидЭлемента <> Неопределено ИЛИ ЭлементВывода.Свойства.Свойство("ВидНового", ВидЭлемента) И ВидЭлемента <> Неопределено;

	НедоступныеСвойстваЭлемента = Новый Массив;
	
	Если ТипЭлемента="КнопкаФормы" Тогда
		РК.ДобавитьЭлементыКоллекции(НедоступныеСвойстваЭлемента, "ТолькоПросмотр");
	КонецЕсли;
	
	Если ТипЭлемента="ПолеФлажка" Тогда
		РК.ДобавитьЭлементыКоллекции(НедоступныеСвойстваЭлемента, "АвтоМаксимальнаяШирина, АвтоМаксимальнаяШирина, МаксимальнаяШирина, МаксимальнаяВысота, МногострочныйРежим");
	КонецЕсли;
	
	Если ТипЭлемента="ГруппаФормы" Тогда
		Если ВидЭлемента="ГруппаКолонок" Тогда
			РК.ДобавитьЭлементыКоллекции(НедоступныеСвойстваЭлемента, "Отображение");
		КонецЕсли;
	КонецЕсли;
	
	Если НедоступныеСвойстваЭлемента.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого НедоступноеСвойство Из НедоступныеСвойстваЭлемента Цикл
		ЭлементВывода.СвойстваПередать.Удалить(НедоступноеСвойство);
		ЭлементВывода.СвойстваНаКлиенте.Удалить(НедоступноеСвойство);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьЭлементВывода(ОтборЭлемента) Экспорт
	
	Элементы = ПолучитьЭлементыВывода(ОтборЭлемента);
	
	Если Элементы.Количество() > 0 Тогда
		
		Возврат Элементы[0];
		
	Иначе
		
		Возврат ПустойЭлементВывода;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЭлементыВывода(ОтборЭлементов) Экспорт
	
	Возврат Обработки.вмс_СерверУправляемыйМодульСтандартный.ПолучитьЭлементыВывода(ПараметрыОбработки, ОтборЭлементов);
	
КонецФункции

Функция ПометитьЭлементыВыводаНаУдаление(Элементы)
	
	УстановитьСвойстваЭлементовВывода(Элементы, Новый Структура("Удалить", Истина));
	
КонецФункции

Функция ЭлементВывода(ОтборЭлемента) Экспорт
	
	Возврат Обработки.вмс_СерверУправляемыйМодульСтандартный.ЭлементВывода(ПараметрыОбработки, ОтборЭлемента);
	
КонецФункции

Функция ЭлементыВывода(ОтборЭлементов=Неопределено) Экспорт

	ЭлементыВывода = ПараметрыОбработки.ЭлементыВывода;
	Если ОтборЭлементов=Неопределено ИЛИ ОтборЭлементов=ЭлементыВывода Тогда
		Возврат ЭлементыВывода;
	КонецЕсли;
	
	Возврат РК.ОтобратьЭлементыКоллекции(ЭлементыВывода, ОтборЭлементов, "Имя");

КонецФункции

Функция НовыйЭлементВывода(Имя) Экспорт
	
	Возврат Обработки.вмс_СерверУправляемыйМодульСтандартный.НовыйЭлементВывода(ПараметрыОбработки, Имя);
	
КонецФункции

Функция ОчиститьЭлементыВывода() Экспорт
	
	УстановитьСвойстваЭлементовВывода(, "Удалить", Истина);
	
КонецФункции

