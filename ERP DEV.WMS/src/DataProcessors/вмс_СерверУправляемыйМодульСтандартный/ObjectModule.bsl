Функция ОбработчикИзмененияЗначенияПоля(знач ЗначениеПоля, ДополнительныеПараметры) Экспорт
	
	ИмяПоля = ДополнительныеПараметры.ИмяПоля;
	
	СписокВыбора = ПолучитьЗначениеСвойстваПоляОбработки(ИмяПоля, "СписокВыбора");
	Если СписокВыбора <> Неопределено Тогда
		Если ЗначениеПоля <> Неопределено Тогда
			ИдентификаторЭлемента = Число(ЗначениеПоля) - 1;
		Иначе
			ИдентификаторЭлемента = -1;
		КонецЕсли;
		
		ЭлементСпискаВыбора = СписокВыбора.НайтиПоИдентификатору(ИдентификаторЭлемента);
		Если ЭлементСпискаВыбора <> Неопределено Тогда
			ЗначениеПоля = ЭлементСпискаВыбора.Значение;
		Иначе
			ЗначениеПоля = ПолучитьЗначениеСвойстваПоляОбработки(ИмяПоля, "ЗначениеПоУмолчанию");
		КонецЕсли;
	КонецЕсли;
	
	ВходящиеДанныеПолей = Новый Структура;
	ВходящиеДанныеПолей.Вставить(ИмяПоля, ЗначениеПоля);
	
	ВвестиДанныеНаКлиенте(ВходящиеДанныеПолей);
	
КонецФункции

