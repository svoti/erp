	Если ЗначениеЗаполнено(ДанныеШтрихкода.Штрихкод) Тогда
		ДанныеШтрихкода.Обработан = Истина;
	КонецЕсли;
	
КонецФункции

Функция ОбработчикЭтапаВводаДанных_НачатьТранзакциюОбработки(Параметры, ДополнительныеПараметры) Экспорт

	НачатьТранзакциюОбработки();
	
	Этап = Параметры.Этап;
