Функция НачатьВводДанных(ВходящиеДанные=Неопределено)
	
	ВложенныйВводДанных = Ложь;
	ВводДанных = ПараметрыОбработки.ВводДанных;
	
	Если ВводДанных.Отменить Тогда
		// ввод данных был отменен
		// будем считать ввод устаревшим, очистим его и начнем новый ввод
		ВводДанных.Отменить = Ложь;
		ВводДанных.НомерЭтапа = Неопределено;
	КонецЕсли;
	
	Если ВходящиеДанные <> Неопределено Тогда

		// новый ввод данных
		
		Если ВводДанных.НомерЭтапа <> Неопределено Тогда
			// уже происходит ввод данных, будет выполнен вложенный ввод данных
			// текущие входящие данные сохраняем, вернемся к ним позже, после вложенного ввода данных
			ВложенныйВводДанных = Истина;
			ВводДанных.СтекВходящихДанных.Добавить(ДанныеОбработки.ВходящиеДанные);
		КонецЕсли;
		
		ДанныеОбработки.ВходящиеДанные = ВходящиеДанные;
		
	Иначе
		
		ВходящиеДанные = ДанныеОбработки.ВходящиеДанные;
		
		// перейдем к следующему элементу данных в текущих данных
		ВходящиеДанные.НомерДанных = ВходящиеДанные.НомерДанных + 1;
		
	КонецЕсли;

	Если НЕ ЗагрузитьСледующийЭлементВходящихДанных() Тогда
		// отмена ввода
		Если ВложенныйВводДанных Тогда
			ВводДанных.СтекВходящихДанных.Удалить(ВводДанных.СтекВходящихДанных.Количество()-1);
		КонецЕсли;
		
		Возврат Ложь;
	КонецЕсли;
	
	Если ВложенныйВводДанных Тогда
		ВводДанных.НомерНовогоЭтапа = ВводДанных.НомерЭтапа + 1;
	Иначе
		ОчиститьЗавершенныеЭтапыВвода();
	КонецЕсли;
	
	СформироватьЭтапыВвода();
	
	Если ВводДанных.НомерЭтапа=Неопределено Тогда
		// перейдем к началу этапов
		Если НЕ ПерейтиКЭтапуВвода(0) Тогда
			// не заполнены этапы?
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПродолжитьВводДанных() Экспорт
	
	ВводДанных = ПараметрыОбработки.ВводДанных;

	Если ВводДанных.Выполняется Тогда
		// уже выполняется
		Возврат Истина;
	КонецЕсли;

	Если ВводДанных.НомерЭтапа=Неопределено Тогда
		// нет данных для ввода
		ВводДанных.Выполняется = Ложь;
		Возврат Ложь;
	КонецЕсли;
	
	ЗаморозитьТаймеры(1000);
	ВводДанных.Выполняется = Истина;
	
	Если ВводДанных.Остановить Тогда
		// ввод данных был остановлен и теперь возобновлен
		ВводДанных.Остановить = Ложь;
		
		// возможно потребуются какие-то дополнительные действия здесь...
	КонецЕсли;
	
	СтатусВыполнен = ВводДанных.ДополнительныеДанные.МеткаВыполненнага;
	
	ВводЗавершен = Ложь;
	
	ЭтапыВвода = ВводДанных.ЭтапыВвода;
	ПараметрыОбработчика = Новый Структура("Этап");
	Пока Истина Цикл
		
		ЭтапВвода = ЭтапыВвода[ВводДанных.НомерЭтапа];

		Если НЕ ЭтапВвода.Пропустить Тогда
			ПараметрыОбработчика.Этап = ЭтапВвода;
			вмс_СерверУправляемыеОбработки.ВыполнитьОбработкуОповещенияПереопределенный(ЭтапВвода.Обработчик, ПараметрыОбработчика);
		КонецЕсли;
		
		Если ВводДанных.Остановить Тогда
			
			ЭтапВвода.Пропустить = ВводДанных.ПропуститьЭтап;

			Если ПараметрыОбработки.ДанныеТранзакции.Активна Тогда
				ОтменитьТранзакциюОбработки();

				// прерывание произошло в транзакции,
				// в случае возобновления начнем транзакцию сначала
				ПерейтиКЭтапуВвода("НачалоТранзакцииОбработки", -1);
			КонецЕсли;
			
			Прервать;
			
		КонецЕсли;
		
		ЭтапВвода.Статус = СтатусВыполнен;
		
		МодульОбработки = ПолучитьМодульОбработки(ЭтапВвода.Обработчик.ИмяМодуля);
		Если ТипЗнч(МодульОбработки)=Тип("ОбработкаОбъект.вмс_СерверУправляемыйМодульСборщикДанных") Тогда
			СборщикДанных = МодульОбработки;
			Если СборщикДанных.ДанныеТранзакции.Прервать Тогда
				ПерейтиКЭтапуВвода("КонецВводаСборщика");
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ПерейтиКСледующемуЭтапуВвода() Тогда
			// перейти к следующему этапу
		Иначе
			// ввод завершен
			ВводЗавершен = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ВводДанных.Выполняется = Ложь;
	
	Если ВводЗавершен Тогда
		ПослеЗавершенияВвода();
	КонецЕсли;
	
	Возврат ВводЗавершен;
	
КонецФункции

Функция ВосстановитьВводДанных()

	ВводДанных = ПараметрыОбработки.ВводДанных;

	Если ВводДанных.Выполняется Тогда
		// критануло при вводе данных
		ВводДанных.Выполняется = Ложь;
		ОтменитьВводДанных();
	КонецЕсли;
	
КонецФункции

Функция ПерейтиКСледующемуЭтапуВвода()
	
	Возврат ПерейтиКЭтапуВвода(Неопределено, 1, Истина);
	
КонецФункции

Функция ПерейтиКЭтапуВвода(знач ЭтапВвода=Неопределено, Направление=Неопределено, знач ПерейтиДалее=Неопределено)
	
	ВводДанных = ПараметрыОбработки.ВводДанных;
	ЭтапыВвода = ВводДанных.ЭтапыВвода;
	КоличествоЭтапов = ЭтапыВвода.Количество();
	НомерЭтапа = ВводДанных.НомерЭтапа;

	Если НомерЭтапа=Неопределено Тогда
		НомерЭтапа = 0;
		ПерейтиДалее = Ложь;
	КонецЕсли;
	
	ТипПоиска = 0;
	Если ТипЗнч(ЭтапВвода)=Тип("Строка") Тогда
		Метка = ЭтапВвода;
		ТипПоиска = 1;
	ИначеЕсли ТипЗнч(ЭтапВвода)=Тип("Число") Тогда
		ЦелевойНомерЭтапа = ЭтапВвода;
		Если ЦелевойНомерЭтапа >=0 И ЦелевойНомерЭтапа < КоличествоЭтапов Тогда
			ЦелевойЭтапВвода = ЭтапыВвода[ЦелевойНомерЭтапа];
			ТипПоиска = 2;
		Иначе
			ЦелевойНомерЭтапа = Неопределено;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЭтапВвода)=Тип("СтрокаТаблицыЗначений") Тогда
		ЦелевойЭтапВвода = ЭтапВвода;
		ЦелевойНомерЭтапа = ЭтапыВвода.Индекс(ЦелевойЭтапВвода);
		Если ЦелевойНомерЭтапа <> -1 Тогда
			ТипПоиска = 2;
		Иначе
			ЦелевойЭтапВвода = Неопределено;
			ЦелевойНомерЭтапа = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ПерейтиДалее=Неопределено Тогда
		Если ТипПоиска=0 ИЛИ ТипПоиска=1 Тогда
			ПерейтиДалее = Истина;
		Иначе
			ПерейтиДалее = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Направление=Неопределено Тогда
		Если ЦелевойНомерЭтапа <> Неопределено Тогда
			Если НомерЭтапа <= ЦелевойНомерЭтапа Тогда
				Направление = 1;
			Иначе
				Направление = -1;
			КонецЕсли;
		Иначе
			Направление = 1;
		КонецЕсли;
	КонецЕсли;
	
	ЭтапНайден = Ложь;
	
	Если Направление=1 Тогда
		
		МеткаВыполненнага = ВводДанных.ДополнительныеДанные.МеткаВыполненнага;
		МеткаПропущеннага = ВводДанных.ДополнительныеДанные.МеткаПропущеннага;
		
		Пока НомерЭтапа < КоличествоЭтапов Цикл
			
			ЭтапВвода = ЭтапыВвода[НомерЭтапа];
			
			Если ПерейтиДалее Тогда
				ПерейтиДалее = Ложь;
			ИначеЕсли ТипПоиска=0
				ИЛИ ТипПоиска=1 И ЭтапВвода.Метка=Метка
				ИЛИ ТипПоиска=2 И ЭтапВвода=ЦелевойЭтапВвода Тогда
				ЭтапНайден = Истина;
				Прервать;
			КонецЕсли;
			
			Если ЭтапВвода.Статус <> МеткаВыполненнага Тогда
				ЭтапВвода.Статус = МеткаПропущеннага;
			КонецЕсли;
			
			НомерЭтапа = НомерЭтапа + Направление;
			
		КонецЦикла;
		
	ИначеЕсли Направление=-1 Тогда
		
		МеткаОтмененнага = ВводДанных.ДополнительныеДанные.МеткаОтмененнага;
		
		Пока НомерЭтапа >= 0 Цикл
			
			ЭтапВвода = ЭтапыВвода[НомерЭтапа];
			
			Если ПерейтиДалее Тогда
				ПерейтиДалее = Ложь;
			ИначеЕсли ТипПоиска=0
				ИЛИ ТипПоиска=1 И ЭтапВвода.Метка=Метка
				ИЛИ ТипПоиска=2 И ЭтапВвода=ЦелевойЭтапВвода Тогда
				ЭтапНайден = Истина;
				Прервать;
			КонецЕсли;
			
			ЭтапВвода.Статус = МеткаОтмененнага;
			
			НомерЭтапа = НомерЭтапа + Направление;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЭтапНайден Тогда
		ЭтапВвода.Статус = ВводДанных.ДополнительныеДанные.МеткаАктивнага;
		ВводДанных.НомерЭтапа = НомерЭтапа;
	Иначе
		ВводДанных.НомерЭтапа = Неопределено;
	КонецЕсли;
	
	Возврат ЭтапНайден;
	
КонецФункции

Функция НомерНовогоЭтапаВвода()

	ВводДанных = ПараметрыОбработки.ВводДанных;
	ЭтапыВвода = ВводДанных.ЭтапыВвода;

	Уровень = ВводДанных.СтекВходящихДанных.Количество();
	
	ЭтапыВводаУровня = ЭтапыВвода.НайтиСтроки(Новый Структура("Уровень", Уровень));
	Если ЭтапыВводаУровня.Количество()=0 Тогда
		// нет этапов на этом уровне тогда...
		Если ВводДанных.НомерЭтапа <> Неопределено Тогда
			// ...добавим после текущего
			Номер = ВводДанных.НомерЭтапа + 1;
		Иначе
			// ...добавим в конец
			Номер = ЭтапыВвода.Количество();
		КонецЕсли;
	Иначе
		// есть этапы на этом уровне вложенности,
		// добавим новый этап в конец уровня
		ИндексПоследнегоЭтапаВвода = 0;
		Для Каждого ЭтапВвода Из ЭтапыВводаУровня Цикл
			ИндексЭтапаВвода = ЭтапыВвода.Индекс(ЭтапВвода);
			Если ИндексПоследнегоЭтапаВвода < ИндексЭтапаВвода Тогда
				ИндексПоследнегоЭтапаВвода = ИндексЭтапаВвода;
			КонецЕсли;
		КонецЦикла;
		
		Номер = ИндексПоследнегоЭтапаВвода + 1;
	КонецЕсли;
	
	Возврат Номер;
		
КонецФункции

Функция НовыйВводДанных()
	
	ВводДанных = Новый Структура;
	ВводДанных.Вставить("ЭтапыВвода", НоваяТаблицаЭтаповВвода());
	ВводДанных.Вставить("НомерЭтапа", Неопределено);
	ВводДанных.Вставить("СтекВходящихДанных", Новый Массив);
	ВводДанных.Вставить("Выполняется", Ложь);
	ВводДанных.Вставить("Остановить", Ложь);
	ВводДанных.Вставить("Отменить", Ложь);
	ВводДанных.Вставить("ПропуститьЭтап", Ложь);
	ВводДанных.Вставить("НомерНовогоЭтапа", 0);
	
	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("МеткаВыполненнага", Новый ФорматированнаяСтрока("  V"));
	ДополнительныеДанные.Вставить("МеткаАктивнага", Новый ФорматированнаяСтрока("  A <<<<<<<<<"));
	ДополнительныеДанные.Вставить("МеткаОтмененнага", Новый ФорматированнаяСтрока("      ↑"));
	ДополнительныеДанные.Вставить("МеткаПропущеннага", Новый ФорматированнаяСтрока("      ↓"));
	ВводДанных.Вставить("ДополнительныеДанные", ДополнительныеДанные);
	
	Возврат ВводДанных;
	
КонецФункции

Функция НоваяТаблицаЭтаповВвода()
	
	ТаблицаЭтаповВвода = РК.НоваяКоллекцияЗначений(
							"Статус, Пропустить, Метка, Представление, ОписаниеДанных, НомерДанных, Уровень, Обработчик, ДанныеВыполненияЭтапа"
	);
	
	Возврат ТаблицаЭтаповВвода;
	
КонецФункции

Функция ДобавитьЭтапВвода(знач Обработчик, Метка=Неопределено, знач Представление=Неопределено, знач Номер=Неопределено)

	ВводДанных = ПараметрыОбработки.ВводДанных;
	ЭтапыВвода = ВводДанных.ЭтапыВвода;
	
	Уровень = ВводДанных.СтекВходящихДанных.Количество();
	
	Если ТипЗнч(Обработчик)=Тип("Строка") Тогда
		Обработчик = НовыйОписаниеОповещения(Обработчик);
	КонецЕсли;
	
	Если Номер=Неопределено Тогда
		Номер = ВводДанных.НомерНовогоЭтапа;
		ВводДанных.НомерНовогоЭтапа = ВводДанных.НомерНовогоЭтапа + 1;
	Иначе
		ВводДанных.НомерНовогоЭтапа = Номер + 1;
	КонецЕсли;
	
	Если Представление=Неопределено Тогда
		Если Обработчик.ЭтоПередаточныйОбработчикОповещения Тогда
			ОбработчикОповещенияРеальногоМодуля = Обработчик.ДополнительныеПараметры;
			ИмяПроцедуры = ОбработчикОповещенияРеальногоМодуля.ИмяПроцедуры;
		Иначе
			ИмяПроцедуры = Обработчик.ИмяПроцедуры;
		КонецЕсли;
		
		Представление = Обработчик.ИмяМодуля + "." + ИмяПроцедуры;
	КонецЕсли;
	
	ЭтапВвода = ЭтапыВвода.Вставить(Номер);
	ЭтапВвода.Пропустить = Ложь;
	ЭтапВвода.Метка = Метка;
	ЭтапВвода.Представление = Представление;
	ЭтапВвода.ОписаниеДанных = ДанныеОбработки.ВходящиеДанные.Описание;
	ЭтапВвода.НомерДанных = ДанныеОбработки.ВходящиеДанные.НомерДанных;
	ЭтапВвода.Уровень = Уровень;
	ЭтапВвода.Обработчик = Обработчик;
	ЭтапВвода.ДанныеВыполненияЭтапа = Новый Структура;
	
	Возврат ЭтапВвода;

КонецФункции

Функция ОчиститьЗавершенныеЭтапыВвода()
	
	ВводДанных = ПараметрыОбработки.ВводДанных;
	
	Если ВводДанных.НомерЭтапа=Неопределено Тогда
		// почистить данные завершенного ввода
		// сделать это сейчас, а не сразу при завершении,
		// придержим их до следующего ввода чтобы можно было просмотреть данные в целях отладки
		ВводДанных.ЭтапыВвода.Очистить();
		ВводДанных.СтекВходящихДанных.Очистить();
		ВводДанных.НомерНовогоЭтапа = 0;
	КонецЕсли;
	
КонецФункции

Функция СформироватьЭтапыВвода()
	
	ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_НачалоВвода", "НачалоВвода");

	СформироватьЭтапыОбработкиШтрихкода();
	
	ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_НачатьТранзакциюОбработки", "НачалоТранзакцииОбработки");
	
	// для тестирования отказов
	//ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_ВрезатьКрита");
	
	СформироватьЭтапыСборщиков();
	
	ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_ПриЗавершенииТранзакцииВвода");
	ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_ЗафиксироватьТранзакциюОбработки");
	ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_ПослеЗавершенияТранзакцииВвода");
	ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_КонецВвода", "КонецВвода");
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьЭтапыОбработкиШтрихкода()
	
	ВходящиеДанные = ДанныеОбработки.ВходящиеДанные;

	// добавим этапы, если был передан штрихкод
	Если ЗначениеЗаполнено(ВходящиеДанные.ДанныеШтрихкода.Штрихкод) Тогда
		ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_ПоискПоШтрихкоду");
		ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_НеизвестныйШтрихкод");
		ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_ВыборОбъектаПоШтрихкоду");
		ДобавитьЭтапВвода("ОбработчикЭтапаВводаДанных_ЗавершениеОбработкиШтрихкода");
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция СформироватьЭтапыСборщиков()
	Для Каждого СборщикДанных Из СборщикиДанных() Цикл
		СформироватьЭтапыСборщика(СборщикДанных);
	КонецЦикла;
КонецФункции

Функция СформироватьЭтапыСборщика(СборщикДанных)
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СборщикДанных", СборщикДанных.Имя);
	Обработчик = НовыйОписаниеОповещения("ОбработчикЭтапаВводаДанных_НачатьТранзакциюСборщика", , ДополнительныеПараметры);
	ДобавитьЭтапВвода(Обработчик, , СборщикДанных.Имя + ".НачатьТранзакциюСборщика");
	
	Для Каждого ЭтапВводаДанных Из СборщикДанных.ПараметрыМодуля.ЭтапыВводаДанных Цикл
		ДобавитьЭтапВвода(ЭтапВводаДанных.ОписаниеОповещения);
	КонецЦикла;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СборщикДанных", СборщикДанных.Имя);
	Обработчик = НовыйОписаниеОповещения("ОбработчикЭтапаВводаДанных_ОбновитьДанныеТранзакцииОбработки", , ДополнительныеПараметры);
	ДобавитьЭтапВвода(Обработчик, "КонецВводаСборщика", СборщикДанных.Имя + ".ОбновитьДанныеТранзакцииОбработки");
КонецФункции

Функция ЗагрузитьСледующийЭлементВходящихДанных()

	ВходящиеДанные = ДанныеОбработки.ВходящиеДанные;
	
	Если ВходящиеДанные.НомерДанных < ВходящиеДанные.МассивДанных.Количество() Тогда
		ЭлементДанных = ВходящиеДанные.МассивДанных[ВходящиеДанные.НомерДанных];
		ЭлементВходящихДанных = Обработки.вмс_СерверУправляемыйМодульСтандартный.НовыеВходящиеДанные(ЭлементДанных);
		ЗаполнитьЗначенияСвойств(ВходящиеДанные, ЭлементВходящихДанных, "ДанныеШтрихкода, ДанныеПолей, Описание");
	ИначеЕсли ВходящиеДанные.НомерДанных <> 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

