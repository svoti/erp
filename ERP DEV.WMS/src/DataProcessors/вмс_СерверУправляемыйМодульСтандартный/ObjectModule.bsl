		// начало транзакции основного ввода
		// очистить принятые поля здесь,
		// на вложенных вводах не очищать, а аккамулировать принятые поля
		ПараметрыОбработки.ДанныеТранзакции.ПринятыеДанныеПолей.Очистить();
	КонецЕсли;
	
