#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СхемаКомпоновкиДанных = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	Отчет.ПериодОтчета = Новый СтандартныйПериод;
	Отчет.ПериодОтчета.ДатаНачала = НачалоМесяца(ТекущаяДата());
	Отчет.ПериодОтчета.ДатаОкончания = ТекущаяДата();
	
	ПараметрДанных= КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Период");
	ПараметрДанных.Значение = Отчет.ПериодОтчета;
	ПараметрДанных.Использование=Истина; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы  

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Если Отчет.ПериодОтчета.ДатаНачала > Отчет.ПериодОтчета.ДатаОкончания Тогда
		
		Перенос = Отчет.ПериодОтчета.ДатаНачала;
		Отчет.ПериодОтчета.ДатаНачала = Отчет.ПериодОтчета.ДатаОкончания;
		Отчет.ПериодОтчета.ДатаОкончания = Перенос;
		
	КонецЕсли;
	
	Если Отчет.ПериодОтчета.ДатаОкончания > ТекущаяДата() Тогда
		
		Отчет.ПериодОтчета.ДатаОкончания = ТекущаяДата();
		
	КонецЕсли;
	
	Если Отчет.ПериодОтчета.ДатаНачала > ТекущаяДата() Тогда
		
		Отчет.ПериодОтчета.ДатаНачала = ТекущаяДата();
		
	КонецЕсли;
	
	ПараметрДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Период");
	ПараметрДанных.Значение = Отчет.ПериодОтчета;
	ПараметрДанных.Использование=Истина; 
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	ПолеОтбора = Новый ПолеКомпоновкиДанных("Контрагент");
	
	// найдем отбор
	ЭлементОтбора = Неопределено;
	Для Каждого Отбор Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Если Отбор.ЛевоеЗначение = ПолеОтбора Тогда
			ЭлементОтбора = Отбор;
			Прервать
		КонецЕсли;
	КонецЦикла;
	
	// если не нашли, то создадим
	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = ПолеОтбора;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ЭлементОтбора.Использование  = Истина;
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Контрагент;
	Иначе
		ЭлементОтбора.Использование = Ложь;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура СкладПриИзменении(Элемент) 
	
	ПолеОтбора = Новый ПолеКомпоновкиДанных("Склад");
	
	// найдем отбор
	ЭлементОтбора = Неопределено;
	Для Каждого Отбор Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Если Отбор.ЛевоеЗначение = ПолеОтбора Тогда
			ЭлементОтбора = Отбор;
			Прервать
		КонецЕсли;
	КонецЦикла;
	
	// если не нашли, то создадим
	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = ПолеОтбора;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Склад) Тогда
		ЭлементОтбора.Использование  = Истина;
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Склад;
	Иначе
		ЭлементОтбора.Использование = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы  

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьОтчетНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНаСервере() 
	
	Результат.Очистить();
	
	СхемаКомпоновкиДанных = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанных"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказПокупателя(Команда)
	РезультатСоздания = СоздатьЗаказ(Отчет.ПериодОтчета, Контрагент);
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьЗаказ(Период, Контрагент);
	
	Запрос = ЗапросПоУслугам(Период, Контрагент);
	Таблица = Запрос.Выполнить().Выгрузить();
	
	НовыйДокумент = Неопределено; 
	СтрокаЗаписи = Новый Структура;
	СтрокаЗаписи.Вставить("Контрагент"); 
	СтрокаЗаписи.Вставить("Организация");
	СтрокаЗаписи.Вставить("Вид");
	МассивДокументов = Новый Массив;    
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	вмс_УслугиОтветственногоХранения.Номенклатура КАК Номенклатура
	|ИЗ
	|	Справочник.вмс_УслугиОтветственногоХранения КАК вмс_УслугиОтветственногоХранения
	|ГДЕ
	|	вмс_УслугиОтветственногоХранения.Ссылка = &Ссылка";
	
	//ТУ_Кошелев 11.12.24 - Адаптация под УНФ; вызов метода Заполнить() после создания документа, для корректного отображения в списке и заполнения всех необходимых полей
	КонфигурацияУНФ = вмс_АдаптацияКонфигураций.ЭтоУНФ();
	Для каждого Строка Из Таблица Цикл  
		
		Если Строка.Вид = "Услуги" Тогда 
			
			Если СтрокаЗаписи.Контрагент <> Строка.Контрагент ИЛИ СтрокаЗаписи.Организация <> Строка.Организация Тогда
				
				Если КонфигурацияУНФ Тогда
					
					НовыйДокумент = Документы.ЗаказПокупателя.СоздатьДокумент();
					НовыйДокумент.Заполнить(Неопределено);
					
					НовыйДокумент.Контрагент = Строка.Контрагент;
					НовыйДокумент.Организация = Строка.Организация;
					НовыйДокумент.Дата = ТекущаяДата(); 
					
					НовыйДокумент.СуммаВключаетНДС = Истина;
					НовыйДокумент.ВалютаДокумента = Константы.ВалютаУчета.Получить();
					НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
					ДокументСтруктура = Новый Структура;
					ДокументСтруктура.Вставить("Документ");
					ДокументСтруктура.Вставить("Контрагент", НовыйДокумент.Контрагент);
					ДокументСтруктура.Вставить("Организация", НовыйДокумент.Организация);
				Иначе
					
					НовыйДокумент = Документы.ЗаказКлиента.СоздатьДокумент();
					НовыйДокумент.Заполнить(Неопределено);
					
					НовыйДокумент.Контрагент = Строка.Контрагент;
					НовыйДокумент.Организация = Строка.Организация;
					НовыйДокумент.Дата = ТекущаяДата(); 
					
					НовыйДокумент.Партнер = Строка.Контрагент.Партнер;  
					НовыйДокумент.ЦенаВключаетНДС = Истина;
					НовыйДокумент.Валюта =  Константы.ВалютаРегламентированногоУчета.Получить();
					НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
					НовыйДокумент.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению; 
					НовыйДокумент.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");
					НовыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
					ДокументСтруктура = Новый Структура;
					ДокументСтруктура.Вставить("Документ");
					ДокументСтруктура.Вставить("Контрагент", НовыйДокумент.Контрагент);
					ДокументСтруктура.Вставить("Организация", НовыйДокумент.Организация);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Строка.Вид = "Хранение" Тогда  
			
			НайденныйДокумент = Неопределено;
			
			Для каждого Документ Из МассивДокументов Цикл
				
				Если Документ.Контрагент = Строка.Контрагент И Документ.Организация = Строка.Организация Тогда
					НайденныйДокумент = Документ;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если НайденныйДокумент = Неопределено Тогда
				
				Если КонфигурацияУНФ Тогда
					
					НовыйДокумент = Документы.ЗаказПокупателя.СоздатьДокумент();
					НовыйДокумент.Заполнить(Неопределено);
					
					НовыйДокумент.Контрагент = Строка.Контрагент;
					НовыйДокумент.Организация = Строка.Организация;
					НовыйДокумент.Дата = ТекущаяДата();
					
					НовыйДокумент.СуммаВключаетНДС = Истина;
					НовыйДокумент.ВалютаДокумента = Константы.ВалютаУчета.Получить();
					НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
				Иначе   
					
					НовыйДокумент = Документы.ЗаказКлиента.СоздатьДокумент();
					НовыйДокумент.Заполнить(Неопределено);
					
					НовыйДокумент.Контрагент = Строка.Контрагент;
					НовыйДокумент.Организация = Строка.Организация;
					НовыйДокумент.Дата = ТекущаяДата();
					
					НовыйДокумент.Партнер = Строка.Контрагент.Партнер;
					НовыйДокумент.ЦенаВключаетНДС = Истина;
					НовыйДокумент.Валюта =  Константы.ВалютаРегламентированногоУчета.Получить();
					НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
					НовыйДокумент.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению; 
					НовыйДокумент.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");
					НовыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
				КонецЕсли;
			Иначе
				Отбор = Новый Структура;
				Отбор.Вставить("Содержание", Строка.Операция);
				
				//ТУ_Августинович ++ 20.03.2026
				// - В УНФ используются Запасы вместо Товары
				НаименованиеТЧ = ?(КонфигурацияУНФ, "Запасы", "Товары");
				
				Если НайденныйДокумент[НаименованиеТЧ].НайтиСтроки(Отбор).Количество() <> 0 Тогда
				//ТУ_Августинович -- 20.03.2026
					
					Если КонфигурацияУНФ Тогда
						
						НовыйДокумент = Документы.ЗаказПокупателя.СоздатьДокумент();
						НовыйДокумент.Заполнить(Неопределено);
						
						НовыйДокумент.Контрагент = Строка.Контрагент;
						НовыйДокумент.Организация = Строка.Организация;
						НовыйДокумент.Дата = ТекущаяДата();
						
						
						НовыйДокумент.СуммаВключаетНДС = Истина;
						НовыйДокумент.ВалютаДокумента = Константы.ВалютаУчета.Получить();
						НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
					Иначе 
						
						НовыйДокумент = Документы.ЗаказКлиента.СоздатьДокумент();
						НовыйДокумент.Заполнить(Неопределено);
						
						НовыйДокумент.Контрагент = Строка.Контрагент;
						НовыйДокумент.Организация = Строка.Организация;
						НовыйДокумент.Дата = ТекущаяДата();
						
						
						НовыйДокумент.Партнер = Строка.Контрагент.Партнер;  
						НовыйДокумент.ЦенаВключаетНДС = Истина;  
						НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
						НовыйДокумент.Валюта =  Константы.ВалютаРегламентированногоУчета.Получить();  
						НовыйДокумент.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению; 
						НовыйДокумент.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");
						НовыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
					КонецЕсли;
					
				Иначе
					НовыйДокумент = НайденныйДокумент;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаЗаписи = Строка;
		
		Если КонфигурацияУНФ Тогда
			СтрокаТЧ = НовыйДокумент.Запасы.Добавить();
			Запрос.УстановитьПараметр("Ссылка", Строка.Операция);
			Выборка = Запрос.Выполнить().Выбрать();
			Выборка.Следующий();
			СтрокаТЧ.Номенклатура = Выборка.Номенклатура;
			СтрокаТЧ.Содержание = СтрокаЗаписи.Операция;
			СтрокаТЧ.Количество = СтрокаЗаписи.Количество;
			СтрокаТЧ.Сумма = СтрокаЗаписи.Сумма;
			СтрокаТЧ.Цена = СтрокаЗаписи.Сумма / СтрокаЗаписи.Количество;
			ОбработатьСтрокуТабличнойЧасти(СтрокаТЧ, НовыйДокумент);
		Иначе
			СтрокаТЧ = НовыйДокумент.Товары.Добавить();
			Запрос.УстановитьПараметр("Ссылка", Строка.Операция);
			Выборка = Запрос.Выполнить().Выбрать();
			Выборка.Следующий();
			СтрокаТЧ.Номенклатура = Выборка.Номенклатура;
			СтрокаТЧ.Содержание = СтрокаЗаписи.Операция;
			СтрокаТЧ.Количество = СтрокаЗаписи.Количество;
			СтрокаТЧ.КоличествоУпаковок = СтрокаЗаписи.Количество;
			СтрокаТЧ.Сумма = СтрокаЗаписи.Сумма;
			СтрокаТЧ.Цена = СтрокаЗаписи.Сумма / СтрокаЗаписи.Количество;  
			СтрокаТЧ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется;
			СтрокаТЧ.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("20%");
			ОбработатьСтрокуТабличнойЧасти(СтрокаТЧ, НовыйДокумент);
		КонецЕсли;
		
		НайденныйДокумент = Неопределено;
		
		Для каждого Документ Из МассивДокументов Цикл
			
			Если Документ.Контрагент = Строка.Контрагент И Документ.Организация = Строка.Организация Тогда
				НайденныйДокумент = Документ;
				Прервать;
			КонецЕсли;
			
		КонецЦикла; 
		
		Если НайденныйДокумент = Неопределено Тогда
			МассивДокументов.Добавить(НовыйДокумент);
		Иначе
			НайденныйДокумент = НовыйДокумент;
		КонецЕсли;
		
	КонецЦикла; 
	
	Для каждого Документ Из МассивДокументов Цикл
		
		//ТУ_Прошин_11.04.24++  
		Если КонфигурацияУНФ Тогда
			//ТУ_Августинович ++ 20.03.2026
			// - В табличной части Запасы может не быть колонки СуммаСНДС.
			//	 Поэтому была реализована проверка существоания данной колонки
			
			ИтоговаяСумма = 0;
			
			Если Документ.Запасы.Найти("СуммаСНДС") <> Неопределено Тогда
				ИтоговаяСумма = Документ.Запасы.Итог("СуммаСНДС");
			ИначеЕсли Документ.Запасы.Найти("Всего") <> Неопределено Тогда
				ИтоговаяСумма = Документ.Запасы.Итог("Всего");
			КонецЕсли;
			//ТУ_Августинович -- 20.03.2026
			
			Документ.СуммаДокумента = ИтоговаяСумма;
		Иначе
			ИтоговаяСумма = Документ.Товары.Итог("СуммаСНДС");
			Документ.СуммаДокумента = ИтоговаяСумма;
		КонецЕсли;
		//ТУ_Прошин_11.04.24--
		
		Документ.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

