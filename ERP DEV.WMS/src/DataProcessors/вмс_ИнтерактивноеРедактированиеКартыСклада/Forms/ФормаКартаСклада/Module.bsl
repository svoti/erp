КонецПроцедуры

&НаКлиенте
Процедура КартаСкладаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Область)
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОбъектыСклада.ТекущиеДанные;
	ИндексТекущейСтроки = ОбъектыСклада.Индекс(ТекущиеДанные);
	
	ПодставитьПолеШаблона(КартаСклада.ТекущаяОбласть, Элементы.ОбъектыСклада.ТекущаяСтрока);
	ОбновитьСписокОбъектовСклада();
	
	ИдентификаторТекущейСтроки = Неопределено;
	Попытка
		ИдентификаторТекущейСтроки = ОбъектыСклада.Получить(ИндексТекущейСтроки).ПолучитьИдентификатор();
	Исключение
	КонецПопытки;
	
	Элементы.ОбъектыСклада.ТекущаяСтрока = ИдентификаторТекущейСтроки;
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура КартаСкладаПриИзмененииСодержимогоОбласти(Элемент, Область, ДополнительныеПараметры)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура МестаХраненияПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	
	Если Строка = Неопределено И МестаХранения.Количество() <> 0 Тогда
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
	Иначе	
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	ТЗ = МетаданныеКарты.Выгрузить();
	ХЗ = Новый ХранилищеЗначения(ТЗ);
	
	ДанныеДляСохранения = Новый Структура("Склад, СвойстваКартыСклада");
	ДанныеДляСохранения.Склад				= Склад;
	ДанныеДляСохранения.СвойстваКартыСклада	= ХЗ;
	
	ОбменДаннымиСлужебный.ДобавитьЗаписьВРегистрСведений(ДанныеДляСохранения, "вмс_ХранениеКартСкладов");
	
	Модифицированность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	СкладПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура СкладПриИзмененииНаСервере()
	КартаСклада.Очистить();
	МестаХранения.Очистить();
	МетаданныеКарты.Очистить();
	ОтображениеСтеллажа.Очистить();
	
	УстановитьРазмерыЯчеек();
	ОткрытиеСохраненнойКарты();
	ОбновитьСписокОбъектовСклада();
КонецПроцедуры

&НаСервере
Процедура УдалитьНаСервере(ИмяВыделеннойОбласти)
	ТекущаяОбласть	= КартаСклада.Область(ИмяВыделеннойОбласти);
	КопияСвойств	= МетаданныеКарты.Выгрузить();
	
	Для Индекс = 0 По КопияСвойств.Количество() - 1 Цикл
		ИмяОбласти = КопияСвойств[Индекс].Область;
		ОбластьСодержимая = КартаСклада.Область(ИмяОбласти);
		
		Если ВхождениеОднойОбластиВДругую(ОбластьСодержимая, ТекущаяОбласть) Тогда
			НайденныеСтроки = МетаданныеКарты.НайтиСтроки(Новый Структура("Область", ИмяОбласти));
			Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				МетаданныеКарты.Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьОтображениеКарты();
	ОбновитьСписокОбъектовСклада();
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	ИмяВыделеннойОбласти = КартаСклада.ТекущаяОбласть.Имя;
	УдалитьНаСервере(ИмяВыделеннойОбласти);
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура МетаданныеКартыПриИзмененииНаСервере()
	//ТекущиеСвойства = Элементы.МетаданныеКарты.ТекущиеДанные;
	//ЗаполнитьОбласть(ТекущиеСвойства.МестоХранения, ТекущиеСвойства.Область, ТекущиеСвойства.Цвет);
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеКартыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	СтрокаСвойств = Элементы.МетаданныеКарты.ТекущиеДанные;
	ИндексСтроки  = МетаданныеКарты.Индекс(СтрокаСвойств);
	
	ЗаполненоОбъектСклада	= ЗначениеЗаполнено(СтрокаСвойств.ОбъектСклада);
	ЗаполненоОбласть		= ЗначениеЗаполнено(СтрокаСвойств.Область);
	
	Если НЕ ЗаполненоОбъектСклада И НЕ ЗаполненоОбласть Тогда
		МетаданныеКарты.Удалить(СтрокаСвойств);
	ИначеЕсли НЕ ЗаполненоОбъектСклада И НЕ ЭтоНеРабочаяЗона(СтрокаСвойств.ТипОбъектаСклада) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнено поле"
		,
		, СтрШаблон("МетаданныеКарты[%1].ОбъектСклада", ИндексСтроки));
	ИначеЕсли НЕ ЗаполненоОбласть Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнено поле"
		,
		, СтрШаблон("МетаданныеКарты[%1].Область", ИндексСтроки));
	Иначе
		ОбновитьОтображениеКарты();
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеКартыПослеУдаления(Элемент)
	ОбновитьОтображениеКарты();
	Модифицированность = Истина;
КонецПроцедуры



#Область ОбновлениеЭлементов


&НаСервере
Процедура ОбновлениеЭлементовНаСервере()
	Если ЗначениеЗаполнено(Склад) Тогда
		ОбновитьОтображениеКарты();
		ОбновитьСписокОбъектовСклада();
		ОбновлениеОтображенияСтеллажа();
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ОбновлениеОтображенияСтеллажа()
	ИмяСтеллажа		 = Элементы.ОтображениеСтеллажа.Заголовок;
	НайденныеОбъекты = МетаданныеКарты.НайтиСтроки(Новый Структура("ОбъектСклада", ИмяСтеллажа));
	
	Для каждого НайденныйОбъект Из НайденныеОбъекты Цикл
		ДетализацияОбъектаСклада(НайденныйОбъект.ОбъектСклада);
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура ОбновлениеЭлементов()
	ОбновлениеЭлементовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура АвтообновлениеЭлементов()
	ОбновлениеЭлементов();
	ПодключитьОбработчикОжидания("АвтообновлениеЭлементов", ЧастотаАвтобновленияКарты, Истина);
КонецПроцедуры


&НаКлиенте
Процедура ЧастотаАвтобновленияКартыПриИзменении(Элемент)
	ОбновитьОбработчикОжидания();
КонецПроцедуры


&НаКлиенте
Процедура АвтообновлениеКартыПриИзменении(Элемент)
	Элементы.ЧастотаАвтобновленияКарты.Доступность = АвтообновлениеКарты;
	
	Если АвтообновлениеКарты Тогда
		ВключитьОбработчикОжидания();
	Иначе
		ВыключитьОбработчикОжидания();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьОбработчикОжидания()
	ВыключитьОбработчикОжидания();
	ВключитьОбработчикОжидания();
КонецПроцедуры


&НаКлиенте
Процедура ВключитьОбработчикОжидания()
	ПодключитьОбработчикОжидания("АвтообновлениеЭлементов", ЧастотаАвтобновленияКарты, Истина);
КонецПроцедуры


&НаКлиенте
Процедура ВыключитьОбработчикОжидания()
	ОтключитьОбработчикОжидания("АвтообновлениеЭлементов");
КонецПроцедуры


&НаКлиенте
Процедура Обновить(Команда)
	ОбновлениеЭлементов()
КонецПроцедуры


&НаСервере
Процедура ОбновитьОтображениеКарты()
	КартаСклада.Очистить();
	УстановитьРазмерыЯчеек();
	ЗаполнитьКартуИзМетоданных();
КонецПроцедуры


&НаСервере
Процедура ОбновитьСписокОбъектовСклада()
	//СписокЯчеек = СписокМестХранения(Склад);
	СписокОбъектовСклада = СписокОбъектовСклада(Склад);

	Если НЕ ЗначениеЗаполнено(СписокОбъектовСклада) ИЛИ СписокОбъектовСклада.Количество() = 0 Тогда
		ТекстСообщения = СтрШаблон("В системе отсутствует информация по местам хранения у помещения - ""%1""", Склад);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	//МестаХранения.Загрузить(СписокЯчеек);
	ОбъектыСклада.Очистить();
	ОбъектыСклада.Загрузить(СписокОбъектовСклада);
КонецПроцедуры


#КонецОбласти



&НаКлиенте
Процедура ОбъектыСкладаНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Элементы.КартаСклада.ТолькоПросмотр = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыСкладаОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	Элементы.КартаСклада.ТолькоПросмотр = Истина;
КонецПроцедуры

&НаСервере
Процедура КартаСкладаВыборНаСервере(ИмяОбласти)
	НайденныеСтроки = МетаданныеКарты.НайтиСтроки(Новый Структура("Область", ИмяОбласти));
	
	Если НайденныеСтроки.Количество() = 0 ИЛИ НЕ ЭтоСтеллаж(НайденныеСтроки[0].ТипОбъектаСклада) Тогда
		ОбщегоНазначения.СообщитьПользователю("Объект склада не является стеллажем!");
		Возврат;
	КонецЕсли;
	
	ДетализацияОбъектаСклада(НайденныеСтроки[0].ОбъектСклада);
КонецПроцедуры

&НаКлиенте
Процедура КартаСкладаВыбор(Элемент, Область, СтандартнаяОбработка)
	//КартаСкладаВыборНаСервере(Область.Имя);
	
	НайденныеСтроки = МетаданныеКарты.НайтиСтроки(Новый Структура("Область", Область.Имя));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Если ЭтоСтеллаж(НайденныеСтроки[0].ТипОбъектаСклада) Тогда
			ДетализацияОбъектаСклада(НайденныеСтроки[0].ОбъектСклада);
		ИначеЕсли ЭтоОднаИзРабочихЗон(НайденныеСтроки[0].ТипОбъектаСклада) Тогда
			ОткрытьФормуОстаткиНаЯчейке(НайденныеСтроки[0].ОбъектСклада, Склад)
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КартаСкладаПриАктивизации(Элемент)
	ИмяТекущейОбласти = Элемент.ТекущаяОбласть.Имя;
	
	НайденныеСтроки = МетаданныеКарты.НайтиСтроки(Новый Структура("Область", ИмяТекущейОбласти));
	
	Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		//Индекс = НайденнаяСтрока.Индекс();
		Элементы.МетаданныеКарты.ТекущаяСтрока = МетаданныеКарты.Индекс(НайденнаяСтрока);
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ОтображениеСтеллажаВыборНаСервере(ИмяЯчейки)

КонецПроцедуры

&НаКлиенте
Процедура ОтображениеСтеллажаВыбор(Элемент, Область, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура("ИмяЯчейки, Склад");
	ПараметрыФормы.ИмяЯчейки = Область.Текст;
	ПараметрыФормы.Склад	 = Склад;
	
	ОткрытьФорму("Обработка.вмс_ИнтерактивноеРедактированиеКартыСклада.Форма.ФормаОстатокНаЯчейке"
				, ПараметрыФормы
				, ЭтотОбъект
				, // <Уникальность>
				, // <Окно>
				, // <НавигационнаяСсылка>
				, // <ОписаниеОповещенияОЗакрытии>
				, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьМетаданныеКартыПриИзменении(Элемент)
	Элементы.МетаданныеКарты.Видимость = ОткрытьМетаданныеКарты;
КонецПроцедуры

#КонецОбласти