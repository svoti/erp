#Область ТипыОбъектовСклада


&НаСервере
Функция ТипыОбъектовСклада()
	Возврат Перечисления.вмс_ТипыОбъектовСклада;
КонецФункции

&НаСервере
Функция ЭтоСтеллаж(ТипОбъектаСклада)
	Возврат ТипыОбъектовСклада().Стеллаж = ТипОбъектаСклада;
КонецФункции

&НаСервере
Функция ЭтоНеРабочаяЗона(ТипОбъектаСклада)
	Возврат ТипыОбъектовСклада().НеРабочаяЗона = ТипОбъектаСклада;
КонецФункции

&НаСервере
Функция ЭтоЗонаПриемки(ТипОбъектаСклада)
	Возврат ТипыОбъектовСклада().ЗонаПриемки = ТипОбъектаСклада;
КонецФункции

&НаСервере
Функция ЭтоЗонаОтбора(ТипОбъектаСклада)
	Возврат ТипыОбъектовСклада().ЗонаОтбора = ТипОбъектаСклада;
КонецФункции

&НаСервере
Функция ЭтоЗонаКонтроля(ТипОбъектаСклада)
	Возврат ТипыОбъектовСклада().ЗонаКонтроля = ТипОбъектаСклада;
КонецФункции

&НаСервере
Функция ЭтоЗонаОтгрузки(ТипОбъектаСклада)
	Возврат ТипыОбъектовСклада().ЗонаОтгрузки = ТипОбъектаСклада;
КонецФункции

&НаСервере
Функция ЭтоКарантин(ТипОбъектаСклада)
	Возврат ТипыОбъектовСклада().Карантин = ТипОбъектаСклада;
КонецФункции

&НаСервере
Функция ЭтоСлужебные(ТипОбъектаСклада)
	Возврат ТипыОбъектовСклада().Служебные = ТипОбъектаСклада;
КонецФункции

&НаСервере
Функция ЭтоОднаИзРабочихЗон(ТипОбъектаСклада)
	Возврат ЭтоЗонаПриемки(ТипОбъектаСклада)
			ИЛИ ЭтоЗонаОтбора(ТипОбъектаСклада)
			ИЛИ ЭтоЗонаКонтроля(ТипОбъектаСклада)
			ИЛИ ЭтоЗонаОтгрузки(ТипОбъектаСклада)
			ИЛИ ЭтоКарантин(ТипОбъектаСклада)
			//ИЛИ ЭтоСлужебные(ТипОбъектаСклада)
	;
КонецФункции


&НаСервере
Процедура ЗаполннитьТипОбъектовИСвойстваЗаполнения(Знач ТипОбъектаИСвойстваЗаполнения, ТипОбъекта, Цвет = Неопределено, Узор = Неопределено)
	СвойстваЗаполнения = Новый Структура("Цвет, Узор");
	СвойстваЗаполнения.Цвет = Цвет;
	СвойстваЗаполнения.Узор = Узор;
	ТипОбъектаИСвойстваЗаполнения.Вставить(ТипОбъекта, СвойстваЗаполнения);
КонецПроцедуры

&НаСервере
Функция ТипОбъектаИСвойстваЗаполнения()
	ТипОбъектаИСвойстваЗаполнения = Новый Соответствие;
	
	// Стеллаж
	ЗаполннитьТипОбъектовИСвойстваЗаполнения(ТипОбъектаИСвойстваЗаполнения
											, ТипыОбъектовСклада().Стеллаж
											, WebЦвета.Золотистый
											, ТипУзораТабличногоДокумента.БезУзора);
	
	// НеРабочаяЗона
	ЗаполннитьТипОбъектовИСвойстваЗаполнения(ТипОбъектаИСвойстваЗаполнения
											, ТипыОбъектовСклада().НеРабочаяЗона
											, WebЦвета.Белый
											, ТипУзораТабличногоДокумента.Узор8);
	
	// ЗонаПриемки
	ЗаполннитьТипОбъектовИСвойстваЗаполнения(ТипОбъектаИСвойстваЗаполнения
											, ТипыОбъектовСклада().ЗонаПриемки
											, WebЦвета.ЛимонноЗеленый
											, ТипУзораТабличногоДокумента.БезУзора);
	
	// ЗонаОтбора
	ЗаполннитьТипОбъектовИСвойстваЗаполнения(ТипОбъектаИСвойстваЗаполнения
											, ТипыОбъектовСклада().ЗонаОтбора
											, WebЦвета.Голубой
											, ТипУзораТабличногоДокумента.БезУзора);
	
	// ЗонаКонтроля
	ЗаполннитьТипОбъектовИСвойстваЗаполнения(ТипОбъектаИСвойстваЗаполнения
											, ТипыОбъектовСклада().ЗонаКонтроля
											, WebЦвета.ТемноОранжевый
											, ТипУзораТабличногоДокумента.БезУзора);
	
	// ЗонаОтгрузки
	ЗаполннитьТипОбъектовИСвойстваЗаполнения(ТипОбъектаИСвойстваЗаполнения
											, ТипыОбъектовСклада().ЗонаОтгрузки
											, WebЦвета.ОранжевоКрасный
											, ТипУзораТабличногоДокумента.БезУзора);
	
	// Карантин
	ЗаполннитьТипОбъектовИСвойстваЗаполнения(ТипОбъектаИСвойстваЗаполнения
											, ТипыОбъектовСклада().Карантин
											, WebЦвета.Томатный
											, ТипУзораТабличногоДокумента.БезУзора);
	
	// Служебные
	ЗаполннитьТипОбъектовИСвойстваЗаполнения(ТипОбъектаИСвойстваЗаполнения
											, ТипыОбъектовСклада().Служебные
											, WebЦвета.СветлоСерый
											, ТипУзораТабличногоДокумента.БезУзора);
	
	Возврат ТипОбъектаИСвойстваЗаполнения;
КонецФункции

#КонецОбласти


#Область ОбъектыСклада

&НаСервере
Функция СписокМестХранения(Владелец, ВидСверху)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_МестаХранения.ЧастьНаименованияЯрус КАК ЧастьНаименованияЯрус,
	|	вмс_МестаХранения.ЧастьНаименованияМесто КАК ЧастьНаименованияМесто,
	|	вмс_МестаХранения.Ссылка КАК Ссылка,
	|	вмс_МестаХранения.Наименование КАК Наименование
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	вмс_МестаХранения.ВидСверху = &ВидСверху
	|	И НЕ вмс_МестаХранения.ЭтоГруппа
	|	И вмс_МестаХранения.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЧастьНаименованияЯрус УБЫВ,
	|	ЧастьНаименованияМесто
	|ИТОГИ ПО
	|	ЧастьНаименованияЯрус";
	Запрос.УстановитьПараметр("Владелец",	Владелец);
	Запрос.УстановитьПараметр("ВидСверху",	ВидСверху);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

&НаСервере
Функция СписокМестХраненияСИндикациейЗаполнености(Стеллаж)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец",	Склад);
	Запрос.УстановитьПараметр("ВидСверху",	Стеллаж);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_МестаХранения.ЧастьНаименованияЯрус КАК ЧастьНаименованияЯрус,
	|	вмс_МестаХранения.ЧастьНаименованияМесто КАК ЧастьНаименованияМесто,
	|	вмс_МестаХранения.Ссылка КАК Ссылка,
	|	вмс_МестаХранения.Наименование КАК Наименование
	|ПОМЕСТИТЬ ВТ_Ячейки
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	вмс_МестаХранения.ВидСверху = &ВидСверху
	|	И НЕ вмс_МестаХранения.ЭтоГруппа
	|	И вмс_МестаХранения.Владелец = &Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкамОстатки.Ячейка КАК Ячейка,
	|	вмс_ОперацияПоЯчейкамОстатки.Ячейка.Объем КАК ЯчейкаОбъем,
	|	вмс_ОперацияПоЯчейкамОстатки.Товар КАК Товар,
	|	вмс_ОперацияПоЯчейкамОстатки.Товар.ОбъемЧислитель КАК ТоварОбъемЧислитель,
	|	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток * вмс_ОперацияПоЯчейкамОстатки.Товар.ОбъемЧислитель КАК ОбъемНаЯчейке,
	|	ВЫБОР
	|		КОГДА вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток > 0
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Пустая
	|ПОМЕСТИТЬ ВТ_РН_ОперацииПоЯчейкам
	|ИЗ
	|	РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(
	|			,
	|			Ячейка В
	|				(ВЫБРАТЬ
	|					ВТ_Ячейки.Ссылка
	|				ИЗ
	|					ВТ_Ячейки КАК ВТ_Ячейки)) КАК вмс_ОперацияПоЯчейкамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РН_ОперацииПоЯчейкам.Ячейка КАК Ячейка,
	|	СУММА(ЕСТЬNULL(ВТ_РН_ОперацииПоЯчейкам.ОбъемНаЯчейке, 0)) КАК ОбъемНаЯчейке,
	|	МАКСИМУМ(ЕСТЬNULL(ВТ_РН_ОперацииПоЯчейкам.ЯчейкаОбъем, 0)) КАК ЯчейкаОбъем,
	|	ВТ_РН_ОперацииПоЯчейкам.Пустая КАК Пустая
	|ПОМЕСТИТЬ ВТ_Сгруппированные
	|ИЗ
	|	ВТ_РН_ОперацииПоЯчейкам КАК ВТ_РН_ОперацииПоЯчейкам
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_РН_ОперацииПоЯчейкам.Ячейка,
	|	ВТ_РН_ОперацииПоЯчейкам.Пустая
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Сгруппированные.Ячейка КАК Ячейка,
	|	ВТ_Сгруппированные.Ячейка.Наименование КАК ИмяЯчейки,
	|	ВЫБОР
	|		КОГДА ВТ_Сгруппированные.ЯчейкаОбъем = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_Сгруппированные.ОбъемНаЯчейке * 100 / ВТ_Сгруппированные.ЯчейкаОбъем
	|	КОНЕЦ КАК Заполненность,
	|	ВТ_Сгруппированные.Пустая КАК Пустая
	|ПОМЕСТИТЬ ВТ_ЯчейкиСПроцентомЗаполнености
	|ИЗ
	|	ВТ_Сгруппированные КАК ВТ_Сгруппированные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Ячейки.ЧастьНаименованияЯрус КАК ЧастьНаименованияЯрус,
	|	ВТ_Ячейки.ЧастьНаименованияМесто КАК ЧастьНаименованияМесто,
	|	ВТ_Ячейки.Ссылка КАК Ячейка,
	|	ВТ_Ячейки.Наименование КАК ИмяЯчейки,
	|	ЕСТЬNULL(ВТ_ЯчейкиСПроцентомЗаполнености.Заполненность, 0) КАК Заполненность,
	|	ЕСТЬNULL(ВТ_ЯчейкиСПроцентомЗаполнености.Пустая, ИСТИНА) КАК Пустая
	|ИЗ
	|	ВТ_Ячейки КАК ВТ_Ячейки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЯчейкиСПроцентомЗаполнености КАК ВТ_ЯчейкиСПроцентомЗаполнености
	|		ПО ВТ_Ячейки.Ссылка = ВТ_ЯчейкиСПроцентомЗаполнености.Ячейка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЧастьНаименованияЯрус УБЫВ,
	|	ИмяЯчейки
	|ИТОГИ ПО
	|	ЧастьНаименованияЯрус";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеСтеллажа = Результат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ДанныеСтеллажа.Колонки.Добавить("Цвет", Новый ОписаниеТипов("Цвет"));
	
	ЦветЗаполнения = Неопределено;
	
	Для каждого Ярус Из ДанныеСтеллажа.Строки Цикл
		Для каждого Ячейка Из Ярус.Строки Цикл
			Если ИспользуетсяВГХ Тогда
				Если Ячейка.Заполненность > 75 Тогда
					Ячейка.Цвет = WebЦвета.Томатный;
				ИначеЕсли Ячейка.Заполненность > 50 Тогда
					Ячейка.Цвет = WebЦвета.Оранжевый;
				ИначеЕсли Ячейка.Заполненность > 25 Тогда
					Ячейка.Цвет = WebЦвета.СветлоЗолотистый;
				Иначе
					Ячейка.Цвет = WebЦвета.ЖелтоЗеленый;
				КонецЕсли;
			Иначе
				Ячейка.Цвет = ?(Ячейка.Пустая, WebЦвета.Белый, WebЦвета.СветлоСерый);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДанныеСтеллажа;
КонецФункции


&НаСервере
Функция СписокОбъектовСклада(Склад)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_МестаХранения.ВидСверху КАК ОбъектСклада,
	|	вмс_МестаХранения.ТипЯчейки КАК ТипЯчейки
	|ПОМЕСТИТЬ ВТ_ОбъектыСклада
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	вмс_МестаХранения.Владелец = &Склад
	|	И НЕ вмс_МестаХранения.ВидСверху В (&ОбъектыСклада)
	|	И вмс_МестаХранения.ВидСверху <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_МестаХранения.ВидСверху,
	|	вмс_МестаХранения.ТипЯчейки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	вмс_МестаХранения.Наименование,
	|	вмс_МестаХранения.ТипЯчейки
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	вмс_МестаХранения.Владелец = &Склад
	|	И НЕ вмс_МестаХранения.Наименование В (&ОбъектыСклада)
	|	И вмс_МестаХранения.ТипЯчейки <> ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.Хранение)
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_МестаХранения.Наименование,
	|	вмс_МестаХранения.ТипЯчейки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вмс_ТипыЯчеек.Ссылка КАК ТипЯчейки,
	|	ВЫБОР
	|		КОГДА вмс_ТипыЯчеек.Ссылка = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.Хранение)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.вмс_ТипыОбъектовСклада.Стеллаж)
	|		КОГДА вмс_ТипыЯчеек.Ссылка = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаПриемки)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.вмс_ТипыОбъектовСклада.ЗонаПриемки)
	|		КОГДА вмс_ТипыЯчеек.Ссылка = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаОтгрузки)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.вмс_ТипыОбъектовСклада.ЗонаОтгрузки)
	|		КОГДА вмс_ТипыЯчеек.Ссылка = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаОтбора)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.вмс_ТипыОбъектовСклада.ЗонаОтбора)
	|		КОГДА вмс_ТипыЯчеек.Ссылка = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаКонтроля)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.вмс_ТипыОбъектовСклада.ЗонаКонтроля)
	|		КОГДА вмс_ТипыЯчеек.Ссылка = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.Карантин)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.вмс_ТипыОбъектовСклада.Карантин)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.вмс_ТипыОбъектовСклада.Служебные)
	|	КОНЕЦ КАК ТипОбъектовСклада
	|ПОМЕСТИТЬ ВТ_ТипыОбъектовСклада
	|ИЗ
	|	Перечисление.вмс_ТипыЯчеек КАК вмс_ТипыЯчеек,
	|	Перечисление.вмс_ТипыОбъектовСклада КАК вмс_ТипыОбъектовСклада
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТипыОбъектовСклада.ТипЯчейки КАК ТипЯчейки,
	|	ВТ_ТипыОбъектовСклада.ТипОбъектовСклада КАК ТипОбъектовСклада
	|ПОМЕСТИТЬ ВТ_ТипыОбъектовСкладаСГруппировкой
	|ИЗ
	|	ВТ_ТипыОбъектовСклада КАК ВТ_ТипыОбъектовСклада
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТипыОбъектовСклада.ТипЯчейки,
	|	ВТ_ТипыОбъектовСклада.ТипОбъектовСклада
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОбъектыСклада.ОбъектСклада КАК ОбъектСклада,
	|	ВТ_ТипыОбъектовСкладаСГруппировкой.ТипОбъектовСклада КАК ТипОбъектаСклада
	|ИЗ
	|	ВТ_ОбъектыСклада КАК ВТ_ОбъектыСклада
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТипыОбъектовСкладаСГруппировкой КАК ВТ_ТипыОбъектовСкладаСГруппировкой
	|		ПО ВТ_ОбъектыСклада.ТипЯчейки = ВТ_ТипыОбъектовСкладаСГруппировкой.ТипЯчейки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектСклада";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ОбъектыСклада",	МетаданныеКарты.Выгрузить().ВыгрузитьКолонку("ОбъектСклада"));
	СписокОбъектовСклада = Запрос.Выполнить().Выгрузить();
	
	НеРабочаяЗона = СписокОбъектовСклада.Добавить();
	НеРабочаяЗона.ОбъектСклада		= "Не рабочая зона";
	НеРабочаяЗона.ТипОбъектаСклада	= Перечисления.вмс_ТипыОбъектовСклада.НеРабочаяЗона;
	
	Возврат СписокОбъектовСклада;
КонецФункции


