#Область РаботаСТабличнымиДокументами

&НаСервере
Процедура УстановитьРазмерыЯчеек(Высота = 2, Ширина = 2)
	//КартаСклада.Область().ВысотаСтроки	= Высота;
	КартаСклада.Область().ШиринаКолонки	= Ширина;
КонецПроцедуры


&НаСервере
Процедура ОбъединитьОбласть(ИмяОбласти)
	
	Область = КартаСклада.Область(ИмяОбласти);
	Область.Объединить();
	Область.ВертикальноеПоложение	= ВертикальноеПоложение.Центр;
	Область.ГоризонтальноеПоложение	= ГоризонтальноеПоложение.Центр;
	
КонецПроцедуры


&НаСервере
Процедура ИзменитьОриентациюТекстаВОбласти(Область)
	
	//Область = КартаСклада.Область(ИмяОбласти);
	ПерваяСтрока	 = Область.Верх;
	ПерваяКолонка	 = Область.Лево;
	ПоследняяСтрока	 = Область.Низ;
	ПоследняяКолонка = Область.Право;
	
	КоличествоКолонок = ПоследняяКолонка - ПерваяКолонка + 1;
	КоличествоСтрок	  = ПоследняяСтрока - ПерваяСтрока + 1;
	
	
	Если КоличествоСтрок > КоличествоКолонок Тогда
		Область.ОриентацияТекста = 90;
	Иначе
		Область.ОриентацияТекста = 0;
	КонецЕсли;
	
	//Область.ОриентацияТекста = Число(?(КоличествоСтрок > КоличествоКолонок, 90, 0));
КонецПроцедуры


&НаКлиенте
Процедура ПодставитьПолеШаблона(Область, ВыбраннаяСтрока)
	// Перед началом добавления необходимо выделить область в табличном документе.
	Если ТипЗнч(Область) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
		ТекстСообщения = НСтр("ru = 'Для переноса нужно выделить ячейку или область ячеек'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Возврат;
	Иначе
		ТекущаяОбласть = Область;
		ОбъединитьОбласть(ТекущаяОбласть.Имя);
	КонецЕсли;
	
	// Подготовка данных.
	ТекущиеДанные	 = ОбъектыСклада.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ТипОбъектаСклада = ТекущиеДанные.ТипОбъектаСклада;
	ОбъектСклада	 = ТекущиеДанные.ОбъектСклада;
	
	СвойстваЗаполнения = ТипОбъектаИСвойстваЗаполнения()[ТипОбъектаСклада];
	
	ТекущаяОбласть.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Текст;
	ТекущаяОбласть.Текст	  = ?(ЭтоНеРабочаяЗона(ТипОбъектаСклада), "", ОбъектСклада);
	
	НайденныеСтроки = МетаданныеКарты.НайтиСтроки(Новый Структура("ОбъектСклада", ОбъектСклада));
	
	Если НайденныеСтроки.Количество() = 0 ИЛИ ЭтоНеРабочаяЗона(ТипОбъектаСклада) Тогда
		НовыеДанные = МетаданныеКарты.Добавить();
		НовыеДанные.ОбъектСклада	 = ОбъектСклада;
		НовыеДанные.Область			 = ТекущаяОбласть.Имя;
		НовыеДанные.Цвет			 = СвойстваЗаполнения.Цвет;
		НовыеДанные.ТипОбъектаСклада = ТипОбъектаСклада;
	Иначе
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Область = ТекущаяОбласть.Имя;
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьОтображениеКарты();
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьКартуИзМетоданных()
	ИменаЯчеек = МетаданныеКарты.Выгрузить().ВыгрузитьКолонку("ОбъектСклада");
	
	Для каждого СтрокаДанных Из МетаданныеКарты Цикл
		ОбъектСклада = ?(ЭтоНеРабочаяЗона(СтрокаДанных.ТипОбъектаСклада), "", СтрокаДанных.ОбъектСклада);
		ЗаполнитьОбласть(ОбъектСклада, СтрокаДанных.Область, СтрокаДанных.Цвет, ТипОбъектаИСвойстваЗаполнения()[СтрокаДанных.ТипОбъектаСклада].Узор);
	КонецЦикла;
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьОбласть(ОбъектСклада, ИмяОбласти, Цвет, Узор)
	ТекущаяОбласть = КартаСклада.Область(ИмяОбласти);
	ОбъединитьОбласть(ТекущаяОбласть.Имя);
	
	ТекущаяОбласть.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Текст;
	ТекущаяОбласть.Текст	  = ОбъектСклада;
	
	ИзменитьОриентациюТекстаВОбласти(ТекущаяОбласть);
	
	ЗакраситьГраницыОбласти(ТекущаяОбласть);
	ЗакраситьОбласть(ТекущаяОбласть, Цвет, Узор);
КонецПроцедуры


&НаСервере
Процедура ЗакраситьОбласть(Область, Цвет = Неопределено, Узор = Неопределено)
	Если НЕ ЗначениеЗаполнено(Цвет) И ТипЗнч(Цвет) <> Тип("Цвет") Тогда
		ТекстСообщения = НСтр("ru = 'Не указан цвет ячейки'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	Иначе
		Область.ЦветФона = Цвет;
		Область.Узор = ?(ЗначениеЗаполнено(Узор), Узор, ТипУзораТабличногоДокумента.БезУзора);
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ЗакраситьГраницыОбласти(Область, ГраницаСлева = Истина, ГраницаСправа = Истина, ГраницаСверху = Истина, ГраницаСнизу = Истина)
	Если ГраницаСлева Тогда
		Область.ГраницаСлева  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2, );
	КонецЕсли;
	
	Если ГраницаСправа Тогда
		Область.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2, );
	КонецЕсли;
	
	Если ГраницаСверху Тогда
		Область.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2, );
	КонецЕсли;
	
	Если ГраницаСнизу Тогда
		Область.ГраницаСнизу  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2, );
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ОткрытиеСохраненнойКарты()
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		ТекстСообщения = "Выберите склад";
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Склад");
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.вмс_ХранениеКартСкладов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Склад = Склад;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		СохраненныеДанные = МенеджерЗаписи.СвойстваКартыСклада.Получить();
		
		Если ЗначениеЗаполнено(СохраненныеДанные) И ТипЗнч(СохраненныеДанные) = Тип("ТаблицаЗначений") Тогда
			МетаданныеКарты.Загрузить(СохраненныеДанные);
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьКартуИзМетоданных();
КонецПроцедуры


&НаСервере
Функция ВхождениеОднойОбластиВДругую(ОбластьСодержимая, ОбластьСодержащая)
	// Координаты ОбластьСодержимая
    ПерваяСтрока1		= ОбластьСодержимая.Верх;
    ПерваяКолонка1		= ОбластьСодержимая.Лево;
    ПоследняяСтрока1	= ОбластьСодержимая.Низ;
    ПоследняяКолонка1	= ОбластьСодержимая.Право;

    // Координаты ОбластьСодержащая
    ПерваяСтрока2		= ОбластьСодержащая.Верх;
    ПерваяКолонка2		= ОбластьСодержащая.Лево;
    ПоследняяСтрока2	= ОбластьСодержащая.Низ;
    ПоследняяКолонка2	= ОбластьСодержащая.Право;

    // Проверка вхождения по вертикали
    ПоВертикали	  = (ПерваяСтрока1 >= ПерваяСтрока2) И (ПоследняяСтрока1 <= ПоследняяСтрока2);

    // Проверка вхождения по горизонтали
    ПоГоризонтали = (ПерваяКолонка1 >= ПерваяКолонка2) И (ПоследняяКолонка1 <= ПоследняяКолонка2);

    // Если Вхождение есть по обоим направлениям, то одна область содержит другую
    Возврат ПоВертикали И ПоГоризонтали;
КонецФункции


&НаСервереБезКонтекста
Функция МакетДетализацияОбъектаСклада()
	Возврат Обработки.вмс_ИнтерактивноеРедактированиеКартыСклада.ПолучитьМакет("ДетализацияОбъектаСклада");
КонецФункции


&НаСервере
Процедура ДетализацияОбъектаСклада(ИмяОбъектаСклада)
	ДанныеСтеллажа = СписокМестХраненияСИндикациейЗаполнености(ИмяОбъектаСклада);
	
	Если ДанныеСтеллажа = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Отсутствуют данные по объекту склада");
		Возврат;
	КонецЕсли;
	
	Макет = МакетДетализацияОбъектаСклада();
	ОблОбъектСклада	= Макет.ПолучитьОбласть("ОбъектСклада");
	ОблЯрус			= Макет.ПолучитьОбласть("Ярус");
	
	ОтображениеСтеллажа.Очистить();
	ОтображениеСтеллажа.УстановитьРастягиваниеПоГоризонтали(Истина);
	// Заголовок
	Элементы.ОтображениеСтеллажа.Заголовок = ИмяОбъектаСклада;
	
	КоличестваМестНаЯрусах = Новый Массив;
	Ярусы = ДанныеСтеллажа.Строки;
	
	Для каждого Ярус Из Ярусы Цикл
		КоличестваМестНаЯрусах.Добавить(Ярус.Строки.Количество());
	КонецЦикла;
	
	НаименьшееОбщееКратное = НаименьшееОбщееКратноеДляМассиваЧисел(КоличестваМестНаЯрусах);
	
	НеВыбранаТекущаяОбласть	= Истина;
	ТекущаяОбласть			= Неопределено;
	
	// Отрисовка объекта склада
	Для каждого Ярус Из Ярусы Цикл
		Шаг = 1;
		ОблЯрус.Очистить();
		Смещение = НаименьшееОбщееКратное / Ярус.Строки.Количество() - 1;
		
		Для каждого Ячейка Из Ярус.Строки Цикл
			// ТУ_Августинович ++ 06.11.2025
			// - Вся эта конструкция только чтобы изменить ШиринуКолонок
			ОблЯчейка = ОблЯрус.Область(1, Шаг, 3, Шаг + Смещение);
			ОблЯчейка.СоздатьФорматСтрок();
			ОблЯчейка = ОблЯрус.Область(1, Шаг, 3, Шаг + Смещение);
			// ТУ_Августинович -- 06.11.2025
			
			Если НеВыбранаТекущаяОбласть Тогда
				ТекущаяОбласть = ОблЯчейка;
				
				ВыбранаТекущаяОбласть = Ложь;
			КонецЕсли;
			
			ОблЯчейка.Объединить();
			
			ОблЯчейка.Заполнение			  = ТипЗаполненияОбластиТабличногоДокумента.Текст;
			ОблЯчейка.Текст					  = Ячейка.ИмяЯчейки; //  + " | " + Ячейка.Заполненность + "%"
			ОблЯчейка.ЦветФона				  = Ячейка.Цвет;
			ОблЯчейка.ВертикальноеПоложение	  = ВертикальноеПоложение.Центр;
			ОблЯчейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			
			Если Смещение = 0 Тогда
				ОблЯчейка.ШиринаКолонки = СтрДлина(Ячейка.ИмяЯчейки) + 2;
			КонецЕсли;
			
			ЗакраситьГраницыОбласти(ОблЯчейка);
			
			Шаг = Шаг + Смещение + 1;
		КонецЦикла;
		
		ОтображениеСтеллажа.Вывести(ОблЯрус);
	КонецЦикла;
	
	Элементы.ОтображениеСтеллажа.ТекущаяОбласть = ТекущаяОбласть;
КонецПроцедуры

&НаСервере
Функция НаибольшийОбщийДелитель(Знач Первое, Знач Второе)
	Пока Второе <> 0 Цикл
		Остаток = Первое % Второе;
		Первое = Второе;
		Второе = Остаток;
	КонецЦикла;
	
	Возврат Первое;
КонецФункции

&НаСервере
Функция НаименьшееОбщееКратноеДляДвухЧисел(Знач Первое, Знач Второе)
	Возврат (Первое * Второе) / НаибольшийОбщийДелитель(Первое, Второе);
КонецФункции

&НаСервере
Функция НаименьшееОбщееКратноеДляМассиваЧисел(МассивЧисел)
	Если МассивЧисел.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ТекущееНОК = МассивЧисел[0];
	Для Индекс = 1 По МассивЧисел.Количество() - 1 Цикл
		ТекущееНОК = НаименьшееОбщееКратноеДляДвухЧисел(ТекущееНОК, МассивЧисел[Индекс]);
	КонецЦикла;
	Возврат ТекущееНОК;
КонецФункции


