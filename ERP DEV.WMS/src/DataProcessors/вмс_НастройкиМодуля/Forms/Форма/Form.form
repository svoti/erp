  <items xsi:type="form:FormGroup">
    <name>Страницы</name>
    <id>12</id>
    <items xsi:type="form:FormGroup">
      <name>Информация</name>
      <id>195</id>
      <items xsi:type="form:Decoration">
        <name>ИнформацияОПрограмме</name>
        <id>200</id>
        <title>
          <key>ru</key>
          <value>Программный комплекс &lt;b>AS:WMS&lt;/> предназначен для автоматизации складского учета на базе программных продуктов 1С и состоит из двух основных частей: серверной и мобильной. Мобильная часть работает на терминалах сбора данных (ТСД) и предназначена для использования работниками склада. Серверная часть работает в паре с учетной системой, обеспечивая работу мобильной части.

Ссылка на документацию: &lt;link https://gclnk.com/5MFjb8J2>https://gclnk.com/5MFjb8J2&lt;/></value>
        </title>
        <visible>true</visible>
        <enabled>true</enabled>
        <userVisible>
          <common>true</common>
        </userVisible>
        <extendedTooltip>
          <name>ИнформацияОПрограммеРасширеннаяПодсказка</name>
          <id>202</id>
          <type>Label</type>
          <autoMaxWidth>true</autoMaxWidth>
          <autoMaxHeight>true</autoMaxHeight>
          <extInfo xsi:type="form:LabelDecorationExtInfo">
            <horizontalAlign>Left</horizontalAlign>
          </extInfo>
        </extendedTooltip>
        <contextMenu>
          <name>ИнформацияОПрограммеКонтекстноеМеню</name>
          <id>201</id>
          <autoFill>true</autoFill>
        </contextMenu>
        <formatted>true</formatted>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </items>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <title>
        <key>ru</key>
        <value>О программе</value>
      </title>
      <toolTip>
