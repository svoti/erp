&НаСервере
Функция УстановитьИспользованиеХарактеристик() 
	
	НастройкаПрограммы = Справочники.вмс_НастройкиПрограммы.ПолучитьНастройкуПрограммы("НастройкаТоварныхПолей");
	СтруктураНастройки = НастройкаПрограммы.ХранилищеНастройки.Получить();
	
	Если СтруктураНастройки = Неопределено Тогда
		СтруктураНастройки = вмс_ОперацииПоЯчейкамКлиентСервер.ПолучитьСтруктуруНастройкиТоварныхПолей();
	КонецЕсли;
	
	СтрокаПоля = вмс_РаботаСКоллекциями.НайтиЭлементКоллекции(СтруктураНастройки.ТаблицаПолей, Новый Структура("Имя", "Характеристика"));
	СтрокаПоля.Использование = ИспользоватьХарактеристики; 
	
	ОбъектНастройкаПрограммы = НастройкаПрограммы.ПолучитьОбъект();
	ОбъектНастройкаПрограммы.ХранилищеНастройки = Новый ХранилищеЗначения(СтруктураНастройки, Новый СжатиеДанных(9));
	ОбъектНастройкаПрограммы.Записать();
	
	
КонецФункции

