		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Верхняя граница классификации не может быть меньше нижней!";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ЗапуститьABCАнализ();
