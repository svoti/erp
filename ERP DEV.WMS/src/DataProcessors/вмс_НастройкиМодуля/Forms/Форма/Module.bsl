&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьНастройкиМодуля();
	ЗапроситьКоличествоЛицензийТСД();
	ЗапроситьКоличествоЛицензийПодсистем();
	ОбновитьЗаголовокКоличествоЛицензий();
	ПрочитатьНастройкиВесогабариты();
	УстановитьДоступностьЭлементов();
	ПроверкаКомпонентыСетевойПечатиНаСервере();
	
	Если Параметры.Свойство("ОткрытьНастройкиРазмещения") Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.УчетныеНастройки;
		Элементы.ГруппаУчетныхНастроек.ТекущаяСтраница = Элементы.НастройкиВесогабаритов;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)    
	
	Если ИмяСобытия = "Запись_РегламентныеЗадания" Тогда 
		ГуидПодпитки = ПолучитьГуидРегламентногоЗаданияПодпитки(); 
		ГуидТекущегоЗадания = Новый УникальныйИдентификатор(Параметр);
		
		Если ГуидПодпитки = ГуидТекущегоЗадания Тогда   
			Использование = ПолучитьИспользованиеРегламеногоЗаданияПодпитки();
			УстановитьНастройкиПодпитки(Использование);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

