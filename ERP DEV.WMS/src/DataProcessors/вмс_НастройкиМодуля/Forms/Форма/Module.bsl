&НаСервере
Функция ЗапроситьКоличествоЛицензийТСД()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_Лицензии.Лицензия КАК Лицензия
	|ИЗ
	|	РегистрСведений.вмс_Лицензии КАК вмс_Лицензии";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	КоличествоЛицензийТСД = Выборка.Количество();
	
КонецФункции

&НаСервере
Функция ЗапроситьКоличествоЛицензийПодсистем()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_ЛицензииПодсистем.Лицензия КАК Лицензия
	|ИЗ
	|	РегистрСведений.вмс_ЛицензииПодсистем КАК вмс_ЛицензииПодсистем
	|ГДЕ
	|	вмс_ЛицензииПодсистем.Лицензия <> """"";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	КоличествоЛицензийПодсистем = Выборка.Количество();
	
КонецФункции

&НаСервере
Функция ОбновитьЗаголовокКоличествоЛицензий()
	
	Элементы.ВвестиЛицензииТСД.Заголовок = СтрШаблон("Ввести лицензии ТСД (%2)", Элементы.ВвестиЛицензииТСД.Заголовок, КоличествоЛицензийТСД);
	Элементы.ВвестиЛицензииПодсистем.Заголовок = СтрШаблон("Ввести лицензии подсистем (%2)", Элементы.ВвестиЛицензииПодсистем.Заголовок, КоличествоЛицензийПодсистем);
	
КонецФункции

&НаСервере
Функция ЗаполнитьНастройкиМодуля()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_НастройкиПрограммы.Имя КАК Имя,
	|	вмс_НастройкиПрограммы.Значение КАК Значение
	|ИЗ
	|	Справочник.вмс_НастройкиПрограммы КАК вмс_НастройкиПрограммы";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ЭтотОбъект[Выборка.Имя] = Выборка.Значение;
		Исключение
			//ОписаниеОшибки()
		КонецПопытки;
		
		Если Выборка.Имя = "ЯчейкаБезОстатка" Тогда
			ВиртуальнаяЯчейка_БезОстатка = Выборка.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	ИспользоватьХарактеристики = вмс_АдаптацияКонфигураций.ИспользуютсяХарактеристики();
	ИспользоватьСерии = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля().Найти("Серия") <> Неопределено;
	ИспользоватьКачество = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля().Найти("Качество") <> Неопределено;
	
КонецФункции

