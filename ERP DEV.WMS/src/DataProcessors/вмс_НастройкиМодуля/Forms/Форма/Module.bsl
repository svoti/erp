&НаСервере
Процедура СоздатьЯчейкуБезОстаткаНаСервере()
	
	НоваяЯчейка = Справочники.вмс_МестаХранения.СоздатьЭлемент();
	НоваяЯчейка.Заполнить(Неопределено);
	НоваяЯчейка.Наименование = "Без остатка";
	НоваяЯчейка.ТипЯчейки = Перечисления.вмс_ТипыЯчеек.Карантин;
	НоваяЯчейка.Записать();
	
	ВиртуальнаяЯчейка_БезОстатка = НоваяЯчейка.Ссылка;
	
	УстановитьДоступностьЭлементов();
	
