&НаСервере
Функция ПолучитьШтрихкодыНоменклатурыПоТоварам(ТаблицаТоваров)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СписокНоменклатуры", ТаблицаТоваров);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	вмс_ШтрихкодыРасширенный.Номенклатура КАК Номенклатура,
	|	вмс_ШтрихкодыРасширенный.Штрихкод КАК Штрихкод,
	|	вмс_ШтрихкодыРасширенный.Характеристика КАК Характеристика,
	|	вмс_ШтрихкодыРасширенный.Упаковка КАК Упаковка,
	|	вмс_ШтрихкодыРасширенный.Серия КАК Серия
	|ИЗ
	|	РегистрСведений.вмс_ШтрихкодыРасширенный КАК вмс_ШтрихкодыРасширенный
	|ГДЕ
	|	вмс_ШтрихкодыРасширенный.Номенклатура В(&СписокНоменклатуры)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Номенклатура,
	|	ШтрихкодыНоменклатуры.Штрихкод,
	|	ШтрихкодыНоменклатуры.Характеристика,
	|	ШтрихкодыНоменклатуры.Упаковка,
	|	NULL
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Номенклатура В(&СписокНоменклатуры)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	МассивДанных = Новый Массив;
	Пока Выборка.Следующий() Цикл 
		
		Если МассивДанных.Количество() > 0 Тогда
			ШКНайден = НайтиТоварВМассивеСтруктур(Выборка.Номенклатура, МассивДанных, "Номенклатура");
		Иначе
			СД = Новый Структура();
			СД.Вставить("Номенклатура", Выборка.Номенклатура);
			СД.Вставить("Штрихкод", Выборка.Штрихкод);
			СД.Вставить("КоличествоЭтикеток", 0);
			МассивДанных.Добавить(СД); 
		КонецЕсли;
		
		Если ШКНайден = 0 Тогда
			СД = Новый Структура();
			СД.Вставить("Номенклатура", Выборка.Номенклатура);
			СД.Вставить("Штрихкод", Выборка.Штрихкод);
			СД.Вставить("КоличествоЭтикеток", 0);
			МассивДанных.Добавить(СД);	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивДанных;
	
КонецФункции  

&НаСервере
Функция НайтиТоварВМассивеСтруктур(Номенклатура, МассивДанных, КлючСтруктуры)
	
	Для каждого ЭлементМассива Из МассивДанных Цикл
		Для каждого ЭлементСтуктуры Из ЭлементМассива Цикл
			Если ЭлементСтуктуры.Ключ = КлючСтруктуры
				И ЭлементСтуктуры.Значение = Номенклатура Тогда
				Результат = 1;
				Прервать;
			Иначе
				Результат = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПодобратьНоменклатуру(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора",Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор",Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе",Истина);
	
	ОО = Новый ОписаниеОповещения("ВыбраннаяНоменклатураДляТаблицы",ЭтотОбъект);
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, ЭтотОбъект, ,,, ОО);
	//ОткрытьФорму("ВнешняяОбработка.ТУ_ПечатьШтрихкодовНоменклатуры.Форма.ФормаПодбораНом",ПараметрыФормы,ЭтаФорма,,,,ОО);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяНоменклатураДляТаблицы(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	ЗаполнитьТаблицуВыбраннойНоменклатуры(РезультатЗакрытия, ВыводитьОдинШтрихкод);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуВыбраннойНоменклатуры(Массив, ВыводитьОдинШтрихкод)
	
	Если Массив = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Для каждого Элемент Из Массив Цикл
		
		ОбработатьСтрокуТаблицы(Элемент, ВыводитьОдинШтрихкод);
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьСтрокуТаблицы(Номенклатура, ВыводитьОдинШтрихкод, СтрокаТаблицы = Неопределено, МассивРеквизитов = Неопределено)
	
	Запрос = Новый Запрос;
	
	Характеристика = Неопределено;
	Серия = Неопределено;
	
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("Серия", Серия);
	
	Если ЗначениеЗаполнено(СтрокаТаблицы) И СтрокаТаблицы <> Неопределено Тогда
		
		ПараметрыПоиска = Новый Структура;
		Для каждого Реквизит Из МассивРеквизитов Цикл
			ПараметрыПоиска.Вставить(Реквизит, СтрокаТаблицы[Реквизит]);		
		КонецЦикла;
		
		НайденныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыПоиска);
		
		Если НайденныеСтроки.Количество() <> 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Данный товар уже был добавлен в список.");
			Возврат;		
		КонецЕсли;
		
		Для каждого Параметр Из МассивРеквизитов Цикл
			Запрос.УстановитьПараметр(Параметр, СтрокаТаблицы[Параметр]);		
		КонецЦикла;
		
	Иначе
		
		ПараметрыПоиска = Новый Структура("Номенклатура", Номенклатура);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыПоиска);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		
		Если НайденныеСтроки.Количество() <> 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Данный товар уже был добавлен в список.");
			Возврат;		
		КонецЕсли;
		
	КонецЕсли;
	
	Если вмс_АдаптацияКонфигураций.ЭтоУТ() ИЛИ вмс_АдаптацияКонфигураций.ЭтоЕРП() Тогда
		
		Если ВыводитьОдинШтрихкод Тогда
			
			Запрос.Текст = "ВЫБРАТЬ
			|	вмс_ШтрихкодыРасширенный.Номенклатура КАК Номенклатура,
			|	вмс_ШтрихкодыРасширенный.Характеристика КАК Характеристика,
			|	вмс_ШтрихкодыРасширенный.Серия КАК Серия,
			|	вмс_ШтрихкодыРасширенный.Штрихкод КАК Штрихкод
			|ПОМЕСТИТЬ ВТ_ВсеШтрихкодыНоменклатуры
			|ИЗ
			|	РегистрСведений.вмс_ШтрихкодыРасширенный КАК вмс_ШтрихкодыРасширенный
			|ГДЕ
			|	вмс_ШтрихкодыРасширенный.Номенклатура = &Номенклатура
			|	И ВЫБОР
			|			КОГДА &Характеристика = НЕОПРЕДЕЛЕНО
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ вмс_ШтрихкодыРасширенный.Характеристика = &Характеристика
			|		КОНЕЦ
			|	И ВЫБОР
			|			КОГДА &Серия = НЕОПРЕДЕЛЕНО
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ вмс_ШтрихкодыРасширенный.Серия = &Серия
			|		КОНЕЦ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ШтрихкодыНоменклатуры.Номенклатура,
			|	ШтрихкодыНоменклатуры.Характеристика,
			|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка),
			|	ШтрихкодыНоменклатуры.Штрихкод
			|ИЗ
			|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
			|ГДЕ
			|	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура
			|	И ВЫБОР
			|			КОГДА &Характеристика = НЕОПРЕДЕЛЕНО
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ШтрихкодыНоменклатуры.Характеристика = &Характеристика
			|		КОНЕЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ВТ_ВсеШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
			|	ВТ_ВсеШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
			|	ВТ_ВсеШтрихкодыНоменклатуры.Серия КАК Серия,
			|	МАКСИМУМ(ВТ_ВсеШтрихкодыНоменклатуры.Штрихкод) КАК Штрихкод
			|ИЗ
			|	ВТ_ВсеШтрихкодыНоменклатуры КАК ВТ_ВсеШтрихкодыНоменклатуры
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ВсеШтрихкодыНоменклатуры.Номенклатура,
			|	ВТ_ВсеШтрихкодыНоменклатуры.Характеристика,
			|	ВТ_ВсеШтрихкодыНоменклатуры.Серия";
			
		Иначе
			
			Запрос.Текст = "ВЫБРАТЬ
			|	вмс_ШтрихкодыРасширенный.Номенклатура КАК Номенклатура,
			|	вмс_ШтрихкодыРасширенный.Характеристика КАК Характеристика,
