КонецПроцедуры

&НаСервере
Процедура ЗагрузитьШКНаСервере()
	
	ТабЗнач = Объект.Товары.Выгрузить();
	ТабЗнач.Свернуть("Номенклатура", "Количество");
	
	Если ТабЗнач.Количество()<> 0 Тогда
		СопоставитьИЗаполнитьШтрихкодыНоменклатуры(ТабЗнач);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаОповещенияНаСервере(МассивТоваров)
	
	Если МассивТоваров.Количество()<> 0 Тогда
		Для каждого ТоварМасс Из МассивТоваров Цикл
			СтрТЧ = Объект.Товары.Добавить();
			СтрТЧ.Номенклатура =  ТоварМасс.Номенклатура;
			СтрТЧ.КоличествоЭтикеток   =  ТоварМасс.КоличествоЭтикеток;
		КонецЦикла; 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ТипЗнч(Параметр) = Тип("Массив") Тогда
		ОбработкаОповещенияНаСервере(Параметр);
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ВысотаЭтикетки = 25;
	Объект.ШиринаЭтикетки = 58;
	Объект.РазмерШрифта = 10;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКоличествоДляВсейНоменклатуры(Команда)	
	Для каждого Строка Из Объект.Товары Цикл
		Строка.КоличествоЭтикеток = КоличествоДляВсейНоменклатуры;	
	КонецЦикла;
КонецПроцедуры

#Область ГенерацияШтрихкодаНоменклатуры
&НаКлиенте
Процедура Сгенерировать(Команда)
	СгенерироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СгенерироватьНаСервере()
	
	Префикс = "3";
	Итератор = ПоследнийНомерШтрихкодаПачек() + 1;
	ВсегоСоздано = 0;
	
	НайденныеОбъекты = Объект.Товары.НайтиСтроки(Новый Структура("Штрихкод",""));
	
	Если НайденныеОбъекты.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("У всей номенклатуры есть штрихкоды");
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаТЧ Из НайденныеОбъекты Цикл	
		Штрихкод = Префикс + Формат(Итератор, "ЧЦ=11; ЧВН=; ЧГ=");
		Штрихкод = Штрихкод + КонтрольныйСимволEAN(Штрихкод, 13);
		//Штрихкод = Штрихкод + РегистрыСведений.вмс_ШтрихкодыРасширенный.КонтрольныйСимволEAN(Штрихкод, 13);
		Итератор = Итератор + 1;
		СтрокаТЧ.Штрихкод = Штрихкод;
		
		ЗаписьРС = РегистрыСведений.вмс_ШтрихкодыРасширенный.СоздатьМенеджерЗаписи();
		ЗаписьРС.Заполнить(Неопределено);
		ЗаписьРС.Штрихкод 		= Штрихкод;
		ЗаписьРС.Номенклатура 	= СтрокаТЧ.Номенклатура;
		
		Если ЗначениеЗаполнено(СтрокаТЧ.Характеристика) Тогда
			ЗаписьРС.Характеристика = СтрокаТЧ.Характеристика;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТЧ.Серия) Тогда
			ЗаписьРС.Серия = СтрокаТЧ.Серия;	
		КонецЕсли;
		
		ЗаписьРС.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Функция КонтрольныйСимволEAN(ШтрихКод, Тип) Экспорт
	
	Четн   = 0;
	Нечетн = 0;
	
	КоличествоИтераций = ?(Тип = 13, 6, 4);
	
	Для Индекс = 1 По КоличествоИтераций Цикл
		Если (Тип = 8) И (Индекс = КоличествоИтераций) Тогда
		Иначе
			Четн   = Четн   + Сред(ШтрихКод, 2 * Индекс, 1);
		КонецЕсли;
		Нечетн = Нечетн + Сред(ШтрихКод, 2 * Индекс - 1, 1);
	КонецЦикла;
	
	Если Тип = 13 Тогда
		Четн = Четн * 3;
	Иначе
		Нечетн = Нечетн * 3;
	КонецЕсли;
	
	КонтЦифра = 10 - (Четн + Нечетн) % 10;
	
	Возврат ?(КонтЦифра = 10, "0", Строка(КонтЦифра));
	
КонецФункции

&НаСервереБезКонтекста
Функция ПоследнийНомерШтрихкодаПачек()
	
	Номер = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
