		КонецЕсли;
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	МинимальноеКолвоДляПечати = 1;
	
	Если РезультатЗапроса.Пустой() Тогда 
		
		НоваяСтрока = Объект.Товары.Добавить();
		
		Если ЗначениеЗаполнено(СтрокаТаблицы) И СтрокаТаблицы <> Неопределено Тогда
			СтрокаРеквизитов = СтрСоединить(МассивРеквизитов, ", ");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, СтрокаРеквизитов);
			НоваяСтрока.КоличествоЭтикеток = СтрокаТаблицы.Количество;
		Иначе
			НоваяСтрока.Номенклатура = Номенклатура; 
			НоваяСтрока.КоличествоЭтикеток = МинимальноеКолвоДляПечати;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		
		Если ЗначениеЗаполнено(СтрокаТаблицы) И СтрокаТаблицы <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, СтрокаРеквизитов);
			НоваяСтрока.КоличествоЭтикеток = СтрокаТаблицы.Количество;			
			НоваяСтрока.Штрихкод = Выборка.Штрихкод;
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "Номенклатура, Характеристика, Серия, Штрихкод");
			НоваяСтрока.КоличествоЭтикеток = МинимальноеКолвоДляПечати;				
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
