
&НаКлиенте
Процедура Напечатать(Команда)
	
	МассивЭлементов = Новый Массив;
	Для каждого ШК Из Объект.Товары Цикл
		Если ШК.Штрихкод = "" Тогда
			ТекстС = "Штрихкод на номенклатуру : " + ШК.Номенклатура + " не распечатан, т.к. отсутствует в базе";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстС);
			Продолжить;
		КонецЕсли; 
		Если ШК.КоличествоЭтикеток = 1 Тогда
			МассивЭлементов.Добавить(Новый Структура("Штрихкод, Номенклатура, Характеристика, Серия", ШК.Штрихкод,ШК.Номенклатура,ШК.Характеристика,ШК.Серия));	
		Иначе
			Для Счетчик = 1 По ШК.КоличествоЭтикеток Цикл
				МассивЭлементов.Добавить(Новый Структура("Штрихкод, Номенклатура, Характеристика, Серия", ШК.Штрихкод,ШК.Номенклатура,ШК.Характеристика,ШК.Серия));	
			КонецЦикла; 
		КонецЕсли; 
	КонецЦикла;
	
	РазмерыСтр = Новый Структура;
	РазмерыСтр.Вставить("Высота",Объект.ВысотаЭтикетки);
	РазмерыСтр.Вставить("Ширина",Объект.ШиринаЭтикетки);
	
	ДанныеДляПередачи = Новый Структура;
	ДанныеДляПередачи.Вставить("ВысотаЭтикетки", Объект.ВысотаЭтикетки);
	ДанныеДляПередачи.Вставить("КодируемыеЗначения ", МассивЭлементов);
	ДанныеДляПередачи.Вставить("КоличествоКолонок ", 1);
	ДанныеДляПередачи.Вставить("КоличествоСтрок ", 1);
	ДанныеДляПередачи.Вставить("Отладка", Ложь);
	ДанныеДляПередачи.Вставить("Префикс", "");
	ДанныеДляПередачи.Вставить("РазмерШрифта ", Объект.РазмерШрифта);
	ДанныеДляПередачи.Вставить("Размеры ", РазмерыСтр);
	ДанныеДляПередачи.Вставить("Префикс", "");
	ДанныеДляПередачи.Вставить("РежимПечати ", 2);
	ДанныеДляПередачи.Вставить("ТипКода", 99);
	ДанныеДляПередачи.Вставить("ШиринаЭтикетки", Объект.ШиринаЭтикетки);
	
	
	ТабДок = ВывестиШтрихкодСервер(ДанныеДляПередачи);
	Если ТабДок <> Неопределено Тогда
		ТабДок.Показать();
	КонецЕсли;  
	
КонецПроцедуры

&НаСервере
Функция ВывестиШтрихкодСервер(ПараметрыПечати)
	
	пОбъект = РеквизитФормыВЗначение("Объект");
	Возврат пОбъект.ПечатьТонкийКлиент(ПараметрыПечати);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуНоменклатурыИШКНаСервере(ВыбранноеЗначение)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		ВыбОбъект = ВыбранноеЗначение.ПолучитьОбъект();
		
		НазваниеТЧДока = "Товары";
		Если вмс_АдаптацияКонфигураций.ЭтоУНФ() Тогда
			НазваниеТЧДока = "Запасы";	
		КонецЕсли;
		
		МассивРеквизитов = Новый Массив;
		
		Для каждого ТабличнаяЧасть Из ВыбранноеЗначение.Метаданные().ТабличныеЧасти Цикл
			Если СтрНайти(ТабличнаяЧасть.Имя, НазваниеТЧДока) <> 0 ИЛИ
				СтрНайти(ТабличнаяЧасть.Синоним, НазваниеТЧДока) <> 0 Тогда
				НазваниеТЧДока = ТабличнаяЧасть.Имя;
				Для каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
					Если (СтрНачинаетсяС(Реквизит.Имя, "Номенклатура") И 
						СтрЗаканчиваетсяНа(Реквизит.Имя, "Номенклатура")) ИЛИ 
						(СтрНачинаетсяС(Реквизит.Имя, "Характеристика") И 
						СтрЗаканчиваетсяНа(Реквизит.Имя, "Характеристика")) ИЛИ
						(СтрНачинаетсяС(Реквизит.Имя, "Серия") И 
						СтрЗаканчиваетсяНа(Реквизит.Имя, "Серия")) Тогда
						МассивРеквизитов.Добавить(Реквизит.Имя);	
					КонецЕсли;
				КонецЦикла;
				Прервать;
			КонецЕсли;		
		КонецЦикла;
		
		Объект.Товары.Очистить();
		СтрокаРеквизитов = СтрСоединить(МассивРеквизитов, ", ");
		
		Попытка
			ВыбОбъект[НазваниеТЧДока].Свернуть(СтрокаРеквизитов, "Количество");
		Исключение
			ТекстСообщ = "Не удалось обработать табличную часть документа. Выберите другой документ.";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщ);
			Возврат;
		КонецПопытки;
		
		Для каждого НоменклатураДока Из ВыбОбъект[НазваниеТЧДока] Цикл
			ОбработатьСтрокуТаблицы(НоменклатураДока.Номенклатура, ВыводитьОдинШтрихкод, НоменклатураДока, МассивРеквизитов);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	ЗаполнитьТаблицуНоменклатурыИШКНаСервере(Объект.ДокументОснование);
КонецПроцедуры

