&НаКлиенте
Функция ВызовОбработчикаСобытияЭлемента(Элемент, ИмяСобытия, Параметр1="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр2="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр3="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр4="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162")
	
	ОбработчикСобытия = ПолучитьОбработчикСобытияЭлемента(Элемент, ИмяСобытия);
	Если ОбработчикСобытия=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = вмс_ВыполнениеПрограммногоКода.ВызовПодпрограммы(ЭтаФорма, , ОбработчикСобытия, Переменные.ПроцессорКода, Параметр1, Параметр2, Параметр3, Параметр4);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОбработчикСобытияЭлемента(Элемент, ИмяСобытия)

	Перем ДополнительныеСвойстваЭлемента;
	
	ДополнительныеСвойстваЭлемента = ПолучитьДополнительныеСвойстваЭлемента(Элемент);
	
	СвойстваСобытий = ДополнительныеСвойстваЭлемента["События"];
	Если СвойстваСобытий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СвойстваСобытий[ИмяСобытия];
	
КонецФункции

