&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьОбщиеМодули()
	
	ОбщиеМодули = Новый Соответствие;
	
	ИменаМодулей = Новый Массив;
	ИменаМодулей.Добавить("РаботаСКоллекциями");
	ИменаМодулей.Добавить("РаботаСФормамиКлиентСервер");
	ИменаМодулей.Добавить("РаботаСФормамиСервер");
	ИменаМодулей.Добавить("РаботаСXMLКлиентСервер");
	ИменаМодулей.Добавить("РаботаСXMLСервер");
	
	Для Каждого ИмяМодуля Из ИменаМодулей Цикл
		ОбщиеМодули[ИмяМодуля] = глОбщийМодуль(ИмяМодуля);
	КонецЦикла;
	
	Возврат ОбщиеМодули;
	
КонецФункции

&НаКлиенте
Функция Инициализация() Экспорт
	
	ОбщиеМодули = ПолучитьОбщиеМодули();
	
	Переменные.Вставить("ДополнительныеСвойстваКоманд", Новый Соответствие);
	Переменные.Вставить("ДополнительныеСвойстваФормы", Новый Соответствие);
	Переменные.Вставить("ДополнительныеСвойстваЭлементов", Новый Соответствие);
	Переменные.Вставить("ОбщиеМодули", ОбщиеМодули);
	Переменные.Вставить("ПроцессорКода", вмс_ВыполнениеПрограммногоКода.ГлобальныйПроцессорКода());
	
КонецФункции

&НаКлиенте
Функция ЗагрузитьИзОписанияФормы(знач ОписаниеФормы) Экспорт
	
	Перем РК, РаботаСXMLКлиентСервер;
	
	Инициализация();
	
	РК = Переменные.ОбщиеМодули["РаботаСКоллекциями"];
	РаботаСXMLКлиентСервер = Переменные.ОбщиеМодули["РаботаСXMLКлиентСервер"];
	
	Если ТипЗнч(ОписаниеФормы)=Тип("Строка") Тогда
		ТекстОписанияФормы = ОписаниеФормы;
		ОписаниеФормы = РаботаСXMLКлиентСервер.ПрочитатьТекстXMLУлучшенная(ТекстОписанияФормы);
	Иначе
		ТекстОписанияФормы = РаботаСXMLКлиентСервер.XMLСтрокаИзЗначенияУлучшенная(ОписаниеФормы);
	КонецЕсли;
	
	ЗагрузитьДополнительныеСвойстваЭлементов(ОписаниеФормы);
	
	ЗагрузитьИзОписанияФормыНаСервере(ТекстОписанияФормы);

	ВызовОбработчикаСобытияЭлемента(ЭтаФорма, "ПриСозданииНаСервере", Ложь, Истина);
	
КонецФункции

&НаКлиенте
Функция ЗагрузитьДополнительныеСвойстваЭлементов(ОписаниеФормы)
	
	РК = Переменные.ОбщиеМодули["РаботаСКоллекциями"];
	
	МассивОписанийЭлементов = РК.СкопироватьОбъект(ОписаниеФормы.Элементы);
	МассивОписанийЭлементов.Добавить(ОписаниеФормы);
	Для Каждого ОписаниеЭлемента Из МассивОписанийЭлементов Цикл
		СобытияЭлемента = Новый Соответствие;
		Для Каждого СобытиеЭлемента Из ОписаниеЭлемента.События Цикл
			Если ЗначениеЗаполнено(СобытиеЭлемента.Значение) Тогда
				СобытияЭлемента[СобытиеЭлемента.Ключ] = ВРЕГ(СобытиеЭлемента.Значение);
			КонецЕсли;
		КонецЦикла;
		
		ДополнительныеСвойстваЭлемента = Новый Соответствие;
		ДополнительныеСвойстваЭлемента["События"] = СобытияЭлемента;
		Если ОписаниеЭлемента=ОписаниеФормы Тогда
			Переменные.ДополнительныеСвойстваФормы = ДополнительныеСвойстваЭлемента;
		Иначе
			Переменные.ДополнительныеСвойстваЭлементов[ОписаниеЭлемента.ИмяЭлемента] = ДополнительныеСвойстваЭлемента;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ОписаниеКоманды Из ОписаниеФормы.Команды Цикл
		ОписаниеСобытийКоманды = Новый Соответствие;
		ОписаниеСобытийКоманды["ОбработкаДействияКоманды"] = ВРЕГ(ОписаниеКоманды.Действие);
		
		ДополнительныеСвойстваКоманды = Новый Соответствие;
		ДополнительныеСвойстваКоманды["События"] = ОписаниеСобытийКоманды;
		Переменные.ДополнительныеСвойстваКоманд[ОписаниеКоманды.Имя] = ДополнительныеСвойстваКоманды;
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция ЗагрузитьИзОписанияФормыНаСервере(ТекстОписанияФормы)

	Перем РаботаСXMLКлиентСервер;
	
	РаботаСXMLКлиентСервер = глОбщийМодуль("РаботаСXMLКлиентСервер");
	ОписаниеФормы = РаботаСXMLКлиентСервер.ПрочитатьТекстXMLУлучшенная(ТекстОписанияФормы);
	
	вмс_КонструкторФормСервер.СоздатьЭлементыФормы(ЭтаФорма, ОписаниеФормы);
	
	ЭтаФорма.АвтоЗаголовок = Ложь; //не нужон
	
	Для Каждого СобытиеФормы Из ОписаниеФормы.События Цикл
		ИмяСобытия = СобытиеФормы.Ключ;
		ИмяОбработчика = ИмяСобытия;
		Попытка
			ЭтаФорма.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
		Исключение
			ТочкаОстановы = 0;
		КонецПопытки;
	КонецЦикла;

	Для Каждого ОписаниеЭлемента Из ОписаниеФормы.Элементы Цикл
		ЭлементФормы = Элементы.Найти(ОписаниеЭлемента.ИмяЭлемента);
		Для Каждого СобытиеЭлемента Из ОписаниеЭлемента.События Цикл
			ИмяСобытия = СобытиеЭлемента.Ключ;
			ИмяОбработчика = "ОбработчикСобытияЭлемента_" + ИмяСобытия;
			Попытка
				ЭлементФормы.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
			Исключение
				ТочкаОстановы = 0;
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Для Каждого ОписаниеКоманды Из ОписаниеФормы.Команды Цикл
		КомандаФормы = Команды.Найти(ОписаниеКоманды.Имя);
		КомандаФормы.Действие = "ОбработкаДействияКоманды";
	КонецЦикла;

КонецФункции

&НаКлиенте
Функция УстановитьЗначениеДополнительногоСвойстваЭлемента(Элемент, ИмяСвойства, ЗначениеСвойства)
	
	ПолучитьДополнительныеСвойстваЭлемента(Элемент)[ИмяСвойства] = ЗначениеСвойства;

КонецФункции

&НаКлиенте
Функция ПолучитьЗначениеДополнительногоСвойстваЭлемента(Элемент, ИмяСвойства)
	
	Возврат ПолучитьДополнительныеСвойстваЭлемента(Элемент)[ИмяСвойства];
	
КонецФункции

&НаКлиенте
Функция ПолучитьДополнительныеСвойстваЭлемента(Элемент)

	Если ТипЗнч(Элемент) = Тип("Строка") Тогда
		ИмяЭлемента = Элемент;
		ДополнительныеСвойства = Переменные.ДополнительныеСвойстваЭлементов;
	Иначе
		Если Элемент = ЭтаФорма Тогда
			Возврат Переменные.ДополнительныеСвойстваФормы;
		КонецЕсли;
		
		ИмяЭлемента = Элемент.Имя;
		Если ТипЗнч(Элемент) = Тип("КомандаФормы") Тогда
			ДополнительныеСвойства = Переменные.ДополнительныеСвойстваКоманд;
		Иначе
			ДополнительныеСвойства = Переменные.ДополнительныеСвойстваЭлементов;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеСвойстваЭлемента = ДополнительныеСвойства[ИмяЭлемента];
	Если ДополнительныеСвойстваЭлемента = Неопределено Тогда
		ДополнительныеСвойстваЭлемента = Новый Соответствие;
		ДополнительныеСвойства[ИмяЭлемента] = ДополнительныеСвойстваЭлемента;
	КонецЕсли;
	
	Возврат ДополнительныеСвойстваЭлемента;
	
КонецФункции

&НаСервере
Функция ПолучитьДополнительныеСвойстваЭлементаНаСервере(Элемент)

	Если Элемент = ЭтаФорма Тогда
		Возврат ЭтаФорма.ДанныеДляРаботыНаСервере.ДополнительныеСвойстваФормы;
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ОбработатьСозданиеНовыхКоманд()

	НовыеКоманды = Переменные.ДанныеДляРаботыНаСервере.НовыеКоманды;
	Если НовыеКоманды.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ИмяКоманды Из НовыеКоманды Цикл
		
		Команда = Команды[ИмяКоманды];
		
		СобытияКоманды = Новый Соответствие;
		СобытияКоманды["ОбработкаДействияКоманды"] = Команда.Действие;

		ДополнительныеСвойстваКоманды = Новый Соответствие;
		ДополнительныеСвойстваКоманды["События"] = СобытияКоманды;
		
		Переменные.ДополнительныеСвойстваКоманд[Команда.Имя] = ДополнительныеСвойстваКоманды;
		
	КонецЦикла;
	
	ОбработатьСозданиеНовыхКомандНаСервере(НовыеКоманды);
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОбработатьСозданиеНовыхКомандНаСервере(НовыеКоманды)
	
	Для Каждого ИмяКоманды Из НовыеКоманды Цикл
		
		Команда = Команды[ИмяКоманды];
		Команда.Действие = "ОбработкаДействияКоманды";
		
	КонецЦикла;
	
КонецФункции

