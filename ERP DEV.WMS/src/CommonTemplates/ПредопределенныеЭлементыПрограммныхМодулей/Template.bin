			<Наименование Тип="Строка">КласснаяСтруктура</Наименование>
			<Код Тип="Строка">000000002</Код>
			<Текст Тип="Строка">Класс КласснаяСтруктура

	ИспользоватьНативныеМетоды
	
	Функция КласснаяСтруктура()
	
		вмс_КлассныеОбъекты.УстановитьНативныйОбъект(ЭтотОбъект, Новый Структура);
	
	КонецФункции

	Функция УстановитьЗначениеПоля(ИмяПоля, ЗначениеПоля)
	
		вмс_КлассныеОбъекты.ПолучитьНативныйОбъект(ЭтотОбъект).Вставить(ИмяПоля, ЗначениеПоля);
		
	КонецФункции

	Функция ПолучитьЗначениеПоля(ИмяПоля)
	
		ЗначениеПоля = Неопределено;
		вмс_КлассныеОбъекты.ПолучитьНативныйОбъект(ЭтотОбъект).Свойство(ИмяПоля, ЗначениеПоля);
		Возврат ЗначениеПоля;
		
	КонецФункции
	
	
КонецКласса
</Текст>
