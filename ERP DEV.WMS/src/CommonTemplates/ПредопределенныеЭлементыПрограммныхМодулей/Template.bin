			<Текст Тип="Строка">#Если Не _БАЗОВЫЙКЛАСС_ Тогда
#Определить _БАЗОВЫЙКЛАСС_

Класс БазовыйКласс

	Перем мФуу;
	
	Функция БазовыйКласс()
	
		мФуу = "Фуу!"
	
	КонецФункции

	Функция УстановитьЗначениеПоля(ИмяПоля, ЗначениеПоля)
		Возврат вмс_КлассныеОбъекты.УстановитьЗначениеПоляПриватно(ЭтотОбъект, ИмяПоля, ЗначениеПоля);
	КонецФункции

	Функция ПолучитьЗначениеПоля(ИмяПоля)
		Возврат вмс_КлассныеОбъекты.ПолучитьЗначениеПоляПриватно(ЭтотОбъект, ИмяПоля);
	КонецФункции
	
	Функция Фуу()
		
		Сообщить(мФуу);
	
	КонецФункции	
	
КонецКласса

#КонецЕсли</Текст>
		</Объект>
		<Объект Номер="3" Тип="СправочникОбъект.вмс_ПрограммныеМодули" Ссылка="06f22fd1-2ed3-11ef-878c-7c10c944d3e9" ЭтоГруппа="false">
