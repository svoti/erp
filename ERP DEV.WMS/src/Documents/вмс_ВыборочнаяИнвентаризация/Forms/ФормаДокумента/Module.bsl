&НаКлиенте
Перем ПеременныеКлиент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект,Неопределено);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПеременныеКлиент = Новый Структура;
	ПеременныеКлиент.Вставить("ТоварныеПоляМассив", ПолучитьТоварныеПоля());
	ПеременныеКлиент.Вставить("ИспользуемыеПоляМассив", ПолучитьИспользуемыеПоля(ПеременныеКлиент.ТоварныеПоляМассив));
	ПеременныеКлиент.Вставить("КомандаЗаполнения", "");
	
	ВосстановитьНастройкиФормы();
	
	ОбновитьОтображениеПолейТаблицы(ПеременныеКлиент.ИспользуемыеПоляМассив);
	ЗадатьСписокВыбора();
	ПрочиеПроверкиПередЗапуском();
	
	ПеременныеКлиент.Вставить("СтатусДокумента", Элементы.Статус.ТекстРедактирования);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры 

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	СохранитьНастройкиФормы();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	// ТУ_Самойленко 19.04.23 ++
	Если ЗначениеЗаполнено(ПеременныеКлиент.КомандаЗаполнения) Тогда
		Если ПеременныеКлиент.КомандаЗаполнения = "ЗаполнитьИсполнителейВыделенныхСтрок" Тогда
			ЗаполнитьСтрокиИсполнителем(ВыбранноеЗначение);
		ИначеЕсли ПеременныеКлиент.КомандаЗаполнения = "РаспределитьИсполнителей" Тогда
			РаспределитьПланПоИсполнителям(ВыбранноеЗначение);
		КонецЕсли;
	КонецЕсли;
	
	ПеременныеКлиент.КомандаЗаполнения = "";
	// ТУ_Самойленко 19.04.23 --
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСтрокиИсполнителем(НовыйИсполнитель)
	
	Для каждого Индекс Из Элементы.ПланВыборочнойИнвентаризации.ВыделенныеСтроки Цикл
		
		ИзменяемаяСтрока = Объект.Товары.НайтиПоИдентификатору(Индекс);
		ИзменяемаяСтрока.Исполнитель = НовыйИсполнитель;
		
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция РаспределитьПланПоИсполнителям(Исполнители)
	
	ТаблицаПлан = Объект.Товары;
	ЯчейкиТЗ = ТаблицаПлан.Выгрузить(, "Ячейка");
	ЯчейкиТЗ.Свернуть("Ячейка");
	мЯчейки = ЯчейкиТЗ.ВыгрузитьКолонку("Ячейка");
	
	ЧислоИсполнителей = Исполнители.Количество();
	ЧислоСтрок = ТаблицаПлан.Количество(); 
	
	Если ЧислоИсполнителей < 1 Тогда
		ОбщегоНазначения.СообщитьПользователю("Отказ по причине - Не указан ни один исполнитель!");
		Возврат Ложь;	
	КонецЕсли;
	Если ЧислоСтрок < 1 Или ЧислоСтрок < ЧислоИсполнителей Тогда
		ОбщегоНазначения.СообщитьПользователю("Отказ по причине - Недостаточно строк в табличной части для распределения!");
		Возврат Ложь;	
	КонецЕсли;
	
	СтрокНаИсполнителя = Цел(ЧислоСтрок/ЧислоИсполнителей);
	ПоследнийИсполнитель = Исполнители[ЧислоИсполнителей - 1];
	ТекущийИндекс = 0;
	ТекущийИсполнитель = Исполнители[ТекущийИндекс];
	ОсталосьРаспределитьСтрок = СтрокНаИсполнителя; 
	
	Если мЯчейки.Количество() < ЧислоИсполнителей Тогда 
		ОбщегоНазначения.СообщитьПользователю("Отказ по причине - Количество исполнителей превышает количество ячеек!");
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Ячейка Из мЯчейки Цикл
		НайденныеСтроки = ТаблицаПлан.НайтиСтроки(Новый Структура("Ячейка", Ячейка));
		Для Каждого Строка Из НайденныеСтроки Цикл
			Строка.Исполнитель = ТекущийИсполнитель;	
		КонецЦикла;
		ОсталосьРаспределитьСтрок = ОсталосьРаспределитьСтрок - НайденныеСтроки.Количество();
		Если ОсталосьРаспределитьСтрок < 1 И ТекущийИсполнитель <> ПоследнийИсполнитель Тогда
			ТекущийИндекс = ТекущийИндекс + 1;
			ТекущийИсполнитель = Исполнители[ТекущийИндекс];
			ОсталосьРаспределитьСтрок = СтрокНаИсполнителя;		
		КонецЕсли;		
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция ОбновитьОтображениеПолейТаблицы(ИспользуемыеПоляМассив)
	
	Для каждого ИмяПоля Из ИспользуемыеПоляМассив Цикл
		Элементы["ПланВыборочнойИнвентаризации" + ИмяПоля].Видимость = Истина;	
	КонецЦикла;
	
КонецФункции


#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	ОтборПриИзмененииНаСервере(Элемент.Имя);
	
КонецПроцедуры

&НаСервере
Функция ОтборПриИзмененииНаСервере(ИмяПоля)
	
	УдаляемыеЭлементы = Новый Массив;
	
	Для Каждого Поле Из ЭтотОбъект[ИмяПоля] Цикл
		Если Не ЗначениеЗаполнено(Поле.Значение) Тогда
			УдаляемыеЭлементы.Добавить(Поле);		
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого УдаляемыйЭлемент Из УдаляемыеЭлементы Цикл
		ЭтотОбъект[ИмяПоля].Удалить(УдаляемыйЭлемент);	
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	
	Если Элемент.ВыделенныйТекст = "В работе" Тогда
		Результат = ПроверитьАктуальностьТабличныхДанных();
		Если ЗначениеЗаполнено(Результат) Тогда			
			ОО = Новый ОписаниеОповещения("ОбработкаАктуализацииДанных", ЭтотОбъект, Результат);
			ПоказатьВопрос(ОО, "Обнаружено расхождение плана инвентаризации с учтенными остатками! Актуализировать данные?", РежимДиалогаВопрос.ДаНетОтмена, 0,,"Обнаружено расхождение!");	
		Иначе
			ОбработкаАктуализацииДанных();
		КонецЕсли;
	Иначе
		ОбработкаАктуализацииДанных();	
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура СтатусПриИзмененииСервер()
	
	НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Исполнитель", Справочники.ФизическиеЛица.ПустаяСсылка()));
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Объект.Статус = Справочники.вмс_СтатусыДокументов.ПолучитьСтатус("Подготовка", "Выборочная инвентаризация");
		ОбщегоНазначения.СообщитьПользователю("Невозможно изменить статус документа пока план инвентаризации полностью не распределен между исполнителями!");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ЧтоДелатьПослеВыбора = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
	
	Проводник = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Фильтр = "Excel-файл (*.xls;*.xlsx)|*.xls;*.xlsx";
	Проводник.Фильтр = Фильтр;
	Проводник.Показать(ЧтоДелатьПослеВыбора);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ПутьКФайлу = ВыбранныеФайлы[0];
	
КонецПроцедуры


#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьТаблицуВыборочнойИнвентаризации(Команда)
	
	ЗаполнитьПланВыборочнойИнвентаризации(ПеременныеКлиент.ТоварныеПоляМассив);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПланВыборочнойИнвентаризации(ТоварныеПоляМассив)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_МестаХранения.Ссылка КАК Ячейка
	|ПОМЕСТИТЬ МестаХранения
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	вмс_МестаХранения.Владелец = &Склад
	|	И вмс_МестаХранения.ПометкаУдаления = ЛОЖЬ
	|	И вмс_МестаХранения.ЭтоГруппа = ЛОЖЬ
	|	И &УсловиеТипЯчейки
	|	И &УсловиеПомещение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МестаХранения.Ячейка КАК Ячейка,
	|	Остатки.Контейнер КАК Контейнер,
	|	Остатки.Товар КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Партия КАК Партия,
	|	Остатки.Серия КАК Серия,
	|	Остатки.Качество КАК Качество,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	МестаХранения КАК МестаХранения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(
	|				,
	|				Ячейка.Владелец = &Склад
	|					И &УсловиеПоТоварам) КАК Остатки
	|		ПО МестаХранения.Ячейка = Остатки.Ячейка
	|ГДЕ
	|	&ЗаполнятьПустымиЯчейками";
	
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	
	Если ЗначениеЗаполнено(Объект.Помещение) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПомещение", "вмс_МестаХранения.Помещение В(&УсловиеПомещение)");
		Запрос.УстановитьПараметр("УсловиеПомещение", Объект.Помещение);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПомещение", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипыЯчеекДляИнвентаризации) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТипЯчейки", "вмс_МестаХранения.ТипЯчейки В(&УсловиеТипЯчейки)");
		Запрос.УстановитьПараметр("УсловиеТипЯчейки", ТипыЯчеекДляИнвентаризации);
	Иначе
		Запрос.УстановитьПараметр("УсловиеТипЯчейки", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТоварыДляИнвентаризации) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоТоварам", "Номенклатура В(&УсловиеПоТоварам)");
		Запрос.УстановитьПараметр("УсловиеПоТоварам", ТоварыДляИнвентаризации);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПоТоварам", Истина);
	КонецЕсли;
	
	Если Объект.ЗаполнятьТаблицуПустымиЯчейками Тогда
		Запрос.УстановитьПараметр("ЗаполнятьПустымиЯчейками", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЗаполнятьПустымиЯчейками", "НЕ Остатки.КоличествоОстаток ЕСТЬ NULL");
	КонецЕсли;
	
	Объект.Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Для каждого Строка Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Строка.Артикул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Номенклатура, "Артикул");
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция ЗаполнитьТаблицуЯчейкамиБезНаполнения()
	
	ДоступныеЯчейки = ПолучитьЯчейкиПоОтбору();
	ВнесенныеЯчейки = ПолучитьЯчейкиТаблицы();
	вмс_РаботаСКоллекциями.ВычестьМассив(ДоступныеЯчейки, ВнесенныеЯчейки);
	
	Для Каждого Ячейка Из ДоступныеЯчейки Цикл
		Если Не Ячейка.ЭтоГруппа Тогда
			СтрокаТаблицы = Объект.Товары.Добавить();
			СтрокаТаблицы.Ячейка = Ячейка; 
		КонецЕсли;
	КонецЦикла;
	
КонецФункции 

&НаКлиенте
Процедура ЗаполнитьИсполнителейВыделенныхСтрок(Команда)
		
	ПеременныеКлиент.КомандаЗаполнения = "ЗаполнитьИсполнителейВыделенныхСтрок";
	
	// ТУ_Герасимов 29.10.2025 ++
	
	СписокСотрудников = ПолучитьСписокСотрудников();
	НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных;
	
	Отбор = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наименование");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = СписокСотрудников;
	Отбор.Использование = Истина;    
	// ТУ_Герасимов 29.10.2025 --
	
	
	ПараметрыИсполнения = Новый Структура;
	ПараметрыИсполнения.Вставить("РежимВыбора", Истина);
	ПараметрыИсполнения.Вставить("ФиксированныеНастройки", НастройкиКомпоновки);	

	
	ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора", ПараметрыИсполнения, ЭтаФорма);
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьСписокСотрудников()
 	 Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|ФизическиеЛица.Наименование КАК Наименование
	|ИЗ
	|Справочник.вмс_НастройкиОператора КАК вмс_НастройкиОператора
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|	ПО (вмс_НастройкиОператора.Оператор = ФизическиеЛица.Ссылка)
	|ГДЕ
	|вмс_НастройкиОператора.Оператор.Ссылка = ФизическиеЛица.Ссылка";
	
	СписокСотрудников = Новый СписокЗначений;
	СписокСотрудников.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0));
	Возврат СписокСотрудников;
КонецФункции

&НаКлиенте
Процедура РаспределитьИсполнителей(Команда)
	ПеременныеКлиент.КомандаЗаполнения = "РаспределитьИсполнителей";   
	
	ПараметрыИсполнения = Новый Структура("РежимВыбора, МножественныйВыбор", Истина, Истина);	
	// ТУ_Герасимов 29.10.2025 ++
	СписокСотрудников = ПолучитьСписокСотрудников();
	НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных;
	
	Отбор = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наименование");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = СписокСотрудников;
	Отбор.Использование = Истина;    
	
	ПараметрыИсполнения.Вставить("ФиксированныеНастройки", НастройкиКомпоновки);
	
	// ТУ_Герасимов 29.10.2025 --
	
	ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора", ПараметрыИсполнения, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетПоИнвентаризации(Команда)
	
	ФормаОтчета = ПолучитьФорму("Отчет.вмс_РезультатыВыборочнойИнвентаризации.ФормаОбъекта");
	
	КомпоновщикНастроек = ФормаОтчета.Отчет.КомпоновщикНастроек;
