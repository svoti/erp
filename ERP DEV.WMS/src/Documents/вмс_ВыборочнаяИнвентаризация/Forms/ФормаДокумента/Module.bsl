Функция ПолучитьКоличествоУчетнойСистемы(ДанныеТовара, Склад)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика
	|				И Склад = &Склад) КАК ТоварыНаСкладахОстатки";
	
	Запрос.УстановитьПараметр("Номенклатура", ДанныеТовара.Товар);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Характеристика", ДанныеТовара.Характеристика);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();;
		Выборка.Следующий();
		Возврат Выборка.Количество;
	КонецЕсли;
	
КонецФункции

// ТУ_Самойленко 05.07.23 ++ [Блокировка ячеек]
&НаКлиенте
Процедура ОбработкаАктуализацииДанных(Ответ=Неопределено, Результат=Неопределено) Экспорт
	
	Отказ = Ложь;
	
	Если Ответ <> Неопределено И Результат <> Неопределено Тогда
		Отказ = ?(Ответ = КодВозвратаДиалога.Да ИЛИ Ответ = КодВозвратаДиалога.Отмена, Истина, Ложь);
		ПостобработкаАктуализацииДанных(?(Ответ = КодВозвратаДиалога.Да, Истина, Ложь), Результат);
	КонецЕсли; 
	
	// ТУ_Самойленко 05.07.23 ++ [Блокировка ячеек] 
	ПараметрыОбработчика = Новый Структура("Отказ, ОтказБлокировки, Ответ", Отказ, Ложь, Неопределено);
	Если Элементы.Статус.ТекстРедактирования = "В работе" И Ответ <> КодВозвратаДиалога.Отмена Тогда
		СписокЯчеек = ПолучитьСписокЯчеекТабличнойЧасти();
		Ответ = ВедетсяРаботаСЯчейками(СписокЯчеек);  	
		ОтказБлокировки = Ответ.ВедетсяРаботаСЯчейками ИЛИ Ответ.ПроводитсяИнвентаризацияЯчеек;
		Если ОтказБлокировки Тогда
			ПараметрыОбработчика.ОтказБлокировки = ОтказБлокировки;
			ПараметрыОбработчика.Ответ = Ответ;
			ОбщегоНазначенияКлиент.СообщитьПользователю(Ответ.ТекстСообщения);
			ОО = Новый ОписаниеОповещения("ЗавершениеОбработкаАктуализацииДанных", ЭтаФорма, ПараметрыОбработчика);
			ПоказатьВопрос(ОО, "Одна или несколько ячеек недоступны для изменения вида блокировки. Очистить таблицу от данных ячеек и продолжить?", РежимДиалогаВопрос.ДаНет,,,"Внимание");
		Иначе
			ЗавершениеОбработкаАктуализацииДанных(Неопределено, ПараметрыОбработчика);
		КонецЕсли;
	Иначе
		ЗавершениеОбработкаАктуализацииДанных(Неопределено, ПараметрыОбработчика);	
	КонецЕсли; 
	// ТУ_Самойленко 05.07.23 -- [Блокировка ячеек]
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеОбработкаАктуализацииДанных(Результат, ПараметрыОбработчика) Экспорт
	
	Если Результат = Неопределено Тогда 
		
		Если ПараметрыОбработчика.Отказ Тогда
			ВернутьПрежнийСтатус(ПеременныеКлиент.СтатусДокумента);
		Иначе
			СтатусПриИзмененииСервер();
		КонецЕсли;
		ПеременныеКлиент.СтатусДокумента = Элементы.Статус.ТекстРедактирования;
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда   
		
		ВернутьПрежнийСтатус(ПеременныеКлиент.СтатусДокумента);	
		ПеременныеКлиент.СтатусДокумента = Элементы.Статус.ТекстРедактирования;
		
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		
		УдалитьСтрокиСЯчейками(ПараметрыОбработчика.Ответ.НедоступныеЯчейки);
		СтатусПриИзмененииСервер();
		ПеременныеКлиент.СтатусДокумента = Элементы.Статус.ТекстРедактирования;
		
	КонецЕсли;
	
КонецПроцедуры

