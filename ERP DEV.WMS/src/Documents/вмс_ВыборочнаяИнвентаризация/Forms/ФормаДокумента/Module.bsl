&НаСервере
Функция ЗаполнитьКоличествоФакт(ИтоговаяОперация)
	
	//ПоляОтбора = вмс_РаботаСКоллекциями.СтрокуВМассив("Ячейка, Контейнер, Товар, Характеристика, Часть, Серия, Качество");
	ПоляОтбора = ПолучитьТоварныеПоля();
	ПоляОтбора.Добавить("Ячейка");
	ПоляОтбора.Добавить("Контейнер");
	
	КонвертацияИмен = Новый Структура;
	КонвертацияИмен.Вставить("Контейнер", "Контейнер");
	
	Для Каждого Строка Из ИтоговаяОперация.ТоварыПоИнвентаризации Цикл
		
		Отбор = Новый Структура;
		Для Каждого ИмяПоля Из ПоляОтбора Цикл
			нИмяПоля = ?(КонвертацияИмен.Свойство(ИмяПоля), КонвертацияИмен[ИмяПоля], ИмяПоля);
			Отбор.Вставить(нИмяПоля, Строка[ИмяПоля]);
		КонецЦикла;
		
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Отбор);
		
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			НайденныеСтроки[0].КоличествоФакт = Строка.Количество;	
		Иначе
			ДобавочнаяСтрока = Объект.Товары.Добавить();
			Для Каждого ИмяПоля Из ПоляОтбора Цикл
				нИмяПоля = ?(КонвертацияИмен.Свойство(ИмяПоля), КонвертацияИмен[ИмяПоля], ИмяПоля);
				ДобавочнаяСтрока[нИмяПоля] = Строка[ИмяПоля];
				ДобавочнаяСтрока.КоличествоФакт = Строка.Количество;
				ДобавочнаяСтрока.Количество = Строка.КоличествоУчет;
				ДобавочнаяСтрока.Исполнитель = НайтиИсполнителяСтроки(Строка, ПоляОтбора);
			КонецЦикла; 
			ДобавочнаяСтрока.Артикул = ДобавочнаяСтрока.Товар.Артикул;
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.Товары.Сортировать("Ячейка, Контейнер, Артикул, Товар");
	
	// ТУ_Самойленко 24.05.23 ++
	Объект.Товары.Загрузить(УдалитьПустыеСтрокиЗаполненныхЯчеек(Объект.Товары.Выгрузить()));
	// ТУ_Самойленко 24.05.23 --
	
	Модифицированность = Истина;
	
КонецФункции

&НаСервере
Функция НайтиИсполнителяСтроки(Строка, ПоляОтбора)
	
	ТоварныеПоля = ПолучитьТоварныеПоля();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Ссылка.Ответственный КАК Исполнитель
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам.ТоварыПоИнвентаризации КАК вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации
	|ГДЕ
	|	вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Контейнер = &Контейнер";
	Для Каждого ИмяПоля Из ТоварныеПоля Цикл
		Запрос.Текст = Запрос.Текст + "	И вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации." + ИмяПоля + " = &" + ИмяПоля;	
	КонецЦикла;

	Запрос.Текст = Запрос.Текст + "
	|	И вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Ячейка = &Ячейка
	|	И вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Ссылка.Проведен = ИСТИНА
	|	И вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Ссылка.ДокументОснование = &Документ
	|	И НЕ вмс_ОперацияПоЯчейкамТоварыПоИнвентаризации.Ссылка.Комментарий ПОДОБНО ""##Подведение итогов""";
	Запрос.УстановитьПараметр("Документ", Объект.Ссылка);
	Для Каждого ИмяПоля Из ПоляОтбора Цикл
		Запрос.УстановитьПараметр(ИмяПоля, Строка[ИмяПоля]);
	КонецЦикла;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() <> 0 Тогда
		Выборка.Следующий();
		Исполнитель = Выборка.Исполнитель; 
	Иначе
		Исполнитель = Справочники.ФизическиеЛица.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Исполнитель;
	
КонецФункции

&НаСервере
Функция ПроверитьАктуальностьТабличныхДанных()
	
	Идентичны = Истина;
	
	ПоляОтбора = вмс_РаботаСКоллекциями.СтрокуВМассив("Ячейка, Контейнер, Номенклатура, Характеристика, Партия, Серия, Качество, Количество");
	
	ТаблицаИсточник = Объект.Товары.Выгрузить();
	
	ЗаполнитьПланВыборочнойИнвентаризации(ПолучитьТоварныеПоля());
	
	Если Объект.ЗаполнятьТаблицуПустымиЯчейками Тогда
		ЗаполнитьТаблицуЯчейкамиБезНаполнения();	
	КонецЕсли; 
	
	Если ТаблицаИсточник.Количество() = Объект.Товары.Количество() Тогда
		Для Каждого Строка Из ТаблицаИсточник Цикл
			
			Отбор = Новый Структура;
			Для Каждого ИмяПоля Из ПоляОтбора Цикл
				Отбор.Вставить(ИмяПоля, Строка[ИмяПоля]);		
			КонецЦикла;
			
			НайденныеСтроки = Объект.Товары.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() <> 1 Тогда
				Идентичны = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		Идентичны = Ложь;
	КонецЕсли;
	
	Если Идентичны Тогда 
		Объект.Товары.Очистить();
		Объект.Товары.Загрузить(ТаблицаИсточник);
		Возврат Неопределено;	
	Иначе
		Возврат вмс_РаботаСКоллекциями.ЗагрузитьКвазиТаблицуЗначенийИзТаблицыЗначений(ТаблицаИсточник);	
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПостобработкаАктуализацииДанных(Актуализировать, КвазиТаблицаИсточник) 
	
	ТаблицаИсточник = вмс_РаботаСКоллекциями.ВыгрузитьКвазиТаблицуЗначенийВИстиннуюТаблицуЗначений(КвазиТаблицаИсточник);
	
	Если Актуализировать Тогда
		ПоляОтбора = вмс_РаботаСКоллекциями.СтрокуВМассив("Ячейка, Контейнер, Товар, Характеристика, Партия, Серия, Качество");
		Для Каждого Строка Из ТаблицаИсточник Цикл
			Отбор = Новый Структура;
			Для Каждого ИмяПоля Из ПоляОтбора Цикл
				Отбор.Вставить(ИмяПоля, Строка[ИмяПоля]);		
			КонецЦикла;
			НайденныеСтроки = Объект.Товары.НайтиСтроки(Отбор);
			Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
				Для Каждого нСтрока Из НайденныеСтроки Цикл
					нСтрока.Исполнитель = Строка.Исполнитель;	
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Объект.Товары.Очистить();
		Объект.Товары.Загрузить(ТаблицаИсточник);
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ВернутьПрежнийСтатус(СтатусДокумента)
	
	Объект.Статус = Справочники.вмс_СтатусыДокументов.ПолучитьСтатус(СтатусДокумента, "Выборочная инвентаризация");	
	
КонецПроцедуры

&НаСервере
Функция УдалитьПустыеСтрокиЗаполненныхЯчеек(Таблица)
	
	ПустыеЯчейки = Новый Массив;
	УдаляемыеСтроки = Новый Массив;
	
	Для Каждого Строка Из Таблица Цикл		
		Если Не ЗначениеЗаполнено(Строка.Товар) Тогда
			Если ПустыеЯчейки.Найти(Строка.Ячейка) = Неопределено Тогда
				ПустыеЯчейки.Добавить(Строка.Ячейка);	
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого ПустаяЯчейка Из ПустыеЯчейки Цикл
		НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура("Ячейка", ПустаяЯчейка));
		Если НайденныеСтроки.Количество() > 1 Тогда
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Если Не ЗначениеЗаполнено(НайденнаяСтрока.Товар) И УдаляемыеСтроки.Найти(НайденнаяСтрока) = Неопределено Тогда
					УдаляемыеСтроки.Добавить(НайденнаяСтрока);	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		Таблица.Удалить(УдаляемаяСтрока);	
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

