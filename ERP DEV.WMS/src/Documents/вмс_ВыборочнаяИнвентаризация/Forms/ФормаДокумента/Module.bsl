Функция УдалитьСтрокиСЯчейками(СписокЯчеек) 
	
	ТаблицаТоваров = Объект.Товары.Выгрузить();
	Для Каждого Ячейка Из СписокЯчеек Цикл
		НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(Новый Структура("Ячейка", Ячейка));
		Для Каждого Строка Из НайденныеСтроки Цикл
			ТаблицаТоваров.Удалить(Строка);	
		КонецЦикла;
	КонецЦикла; 
	Объект.Товары.Загрузить(ТаблицаТоваров);
	
КонецФункции

