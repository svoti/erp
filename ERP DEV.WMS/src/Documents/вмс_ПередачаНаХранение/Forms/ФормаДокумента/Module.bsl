&НаКлиенте
Процедура СоздатьНаОсновании(Команда)

	Если Объект.ПометкаУдаления Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Нельзя создать документ учетной системы на основании документа, помеченного на удаление.";
		Сообщение.Сообщить();   
		
		Возврат;
	КонецЕсли;    

	НайденныйДокУчСис = вмс_ЛичныйКабинетПоклажедателяВызовСервер.НайтиДокументУчетнойСистемы(Объект.Ссылка);
	
	Если НайденныйДокУчСис <> Неопределено Тогда
	    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Документ уже был создан. Перезаписать документ?",РежимДиалогаВопрос.ДаНетОтмена,0);
	Иначе
		ПолноеСопоставление = ПроверитьСопоставлениеСУчетнойСистемой(Объект.Ссылка);
		
		Если ПолноеСопоставление Тогда
			СоздатьНаОснованииНаСервере(Объект.Ссылка);  
			
			ДокументУчетнойСистемы(Неопределено);
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

 &НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПолноеСопоставление = ПроверитьСопоставлениеСУчетнойСистемой(Объект.Ссылка);
		
		Если ПолноеСопоставление Тогда
			СоздатьНаОснованииНаСервере(Объект.Ссылка);  
			
			ДокументУчетнойСистемы(Неопределено);
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Функция ПроверитьСопоставлениеСУчетнойСистемой(ДокСсылка)

	Проверка = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.НомерСтроки КАК НомерСтроки,
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.НоменклатураПоклажедателя КАК НоменклатураПоклажедателя,
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.НоменклатураПоклажедателя.Номенклатура КАК НоменклатураУчетнойСистемы,
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.НоменклатураПоклажедателя.Характеристика КАК ХарактеристикаУчетнойСистемы,
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.НоменклатураПоклажедателя.Упаковка КАК УпаковкаУчетнойСистемы,
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.НоменклатураПоклажедателя.ХарактеристикаПоклажедателя КАК ХарактеристикаПоклажедателя,
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.НоменклатураПоклажедателя.УпаковкаПоклажедателя КАК УпаковкаПоклажедателя
		|ИЗ
		|	Документ.вмс_ПередачаНаХранение.Товары КАК вмс_ПередачаНаХранениеСписокНоменклатуры
		|ГДЕ
		|	вмс_ПередачаНаХранениеСписокНоменклатуры.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка.НоменклатураУчетнойСистемы) Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтрШаблон("В строке %1 у номенклатуры ""%2"" не заполнено сопоставление с учетной системой.", Выборка.НомерСтроки, Выборка.НоменклатураПоклажедателя);
				Сообщение.Сообщить();
				
				Проверка = Ложь;
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(Выборка.УпаковкаУчетнойСистемы) Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтрШаблон("В строке %1 у единицы измерения ""%2"" не заполнено сопоставление с учетной системой.", Выборка.НомерСтроки, Выборка.УпаковкаПоклажедателя);
				Сообщение.Сообщить();
				
				Проверка = Ложь;
			КонецЕсли;
			
			Если вмс_ЛичныйКабинетПоклажедателяВызовСервер.ПроверкаИспользованияХарактеристикПоКонтрагенту(Объект.Контрагент) Тогда
				Если НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.НоменклатураПоклажедателя, "БезХарактеристики") Тогда
					Если НЕ ЗначениеЗаполнено(Выборка.ХарактеристикаУчетнойСистемы) Тогда
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = СтрШаблон("В строке %1 у характеристики ""%2"" номенклатуры ""%3"" не заполнено сопоставление с учетной системой.", Выборка.НомерСтроки, Выборка.ХарактеристикаПоклажедателя, Выборка.НоменклатураПоклажедателя);
						Сообщение.Сообщить();
						
						Проверка = Ложь;
					КонецЕсли;						
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Возврат Проверка;
	
КонецФункции

&НаКлиенте
Процедура ДокументУчетнойСистемы(Команда)
	
	НайденныйДокУчСис = вмс_ЛичныйКабинетПоклажедателяВызовСервер.НайтиДокументУчетнойСистемы(Объект.Ссылка);
	
	Если НайденныйДокУчСис = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Документ не создан";
		Сообщение.Сообщить();

		Возврат;
	Иначе   
		Если НЕ ПроверкаПроведенияСозданногоДокументаУчСистемы(НайденныйДокУчСис) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Документ учетной системы не проведен";
			Сообщение.Сообщить();
		КонецЕсли;    
		
		Оповещение = Новый ОписаниеОповещения("ОткрытьДокументУчетнойСистемы", ЭтотОбъект, НайденныйДокУчСис);
		ПоказатьВопрос(Оповещение, "Открыть документ учетной системы?",РежимДиалогаВопрос.ДаНетОтмена,0);
	КонецЕсли;
	
КонецПроцедуры      

Функция ПроверкаПроведенияСозданногоДокументаУчСистемы(НайденныйДок)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НайденныйДок, "Проведен");	
КонецФункции 

&НаКлиенте
Процедура ОткрытьДокументУчетнойСистемы(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПараметрыФормы = Новый Структура("Ключ", Параметры);
		ОткрытьФорму("Документ.ПриобретениеТоваровУслуг.ФормаОбъекта", ПараметрыФормы);
	Иначе
    	Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.ИмяВнешнегоФайла) Тогда
		Элементы.ГруппаВнешниеФайлы.Видимость = Истина;
	КонецЕсли;             
	
	Если ЗначениеЗаполнено(Объект.ИмяФайлаДляЗаполнения) Тогда
		Элементы.ГруппаФайлыДляЗаполнения.Видимость = Истина;
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура СтатусНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Элементы.Статус.РежимВыбораИзСписка = Истина;
	Элементы.Статус.СписокВыбора.Очистить();
	
	СписокСтатусов = вмс_ЛичныйКабинетПоклажедателяВызовСервер.СписокСтатусовДокументовДляВыбора("ПередачаНаХранение");
	
	Для каждого значение Из СписокСтатусов Цикл
		Элементы.Статус.СписокВыбора.Добавить(Значение);	
	КонецЦикла; 

КонецПроцедуры



