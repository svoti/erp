#Область API 
//ОХ:
Функция СоздатьДокументОтветственногоХраненияВУчетнойСистеме(Распоряжение, ТаблицаПартий = Неопределено, Ответственный) Экспорт
	
	Если Метаданные.Документы.Найти("ОХР_РегистрацияОпераций") <> Неопределено Тогда
		
		НоваяРегистрация = Документы.ОХР_РегистрацияОпераций.СоздатьДокумент();
		НоваяРегистрация.Заполнить(Неопределено);
		НоваяРегистрация.Дата = ТекущаяДата();
		ЗаполнитьЗначенияСвойств(НоваяРегистрация,Распоряжение);
		
		Если ТипЗнч(Ответственный) = ТипЗнч(НоваяРегистрация.Ответственный) Тогда
			НоваяРегистрация.Ответственный = Ответственный;
		Иначе
			// ТУ_Прошин_24.05.24++
			ОператорТСД = Справочники.вмс_НастройкиОператора.НайтиПоРеквизиту("Оператор", Ответственный);
			НоваяРегистрация.Ответственный = ОператорТСД;
			// ТУ_Прошин_24.05.24--
		КонецЕсли;
		
		НоваяРегистрация.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти