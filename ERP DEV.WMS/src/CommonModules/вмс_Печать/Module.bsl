// Вызывается из модуля приложения. Возвращает непечатанные данные.
//
// Параметры:
//  ИмяКомпьютера	 - Строка	 - имя локального компьютера, с которого происходит печать
// 
// Возвращаемое значение:
// Массив  - массив ненапечатанных данных.
//
Функция ОбработчикОжиданияСервераПечати(ИмяКомпьютера) Экспорт
	
	МассивДокументов = Новый Массив;
	
	НаборЗаписей = РегистрыСведений.ОчередьПечати.СоздатьНаборЗаписей();
	НаборЗаписей.Заполнить(Неопределено);
	НаборЗаписей.Отбор.ИмяКомпьютера.Установить(ИмяКомпьютера); 
	НаборЗаписей.Отбор.Распечатано.Установить(Ложь);
	НаборЗаписей.Прочитать();  	
	
	Если НаборЗаписей.Количество() > 0 Тогда
		
		НачатьТранзакцию();	   
		
		МенеджерЗаписи = РегистрыСведений.ОчередьПечати.СоздатьМенеджерЗаписи();
		
		Для Каждого ТекЗапись Из НаборЗаписей Цикл
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ТекЗапись);
			МенеджерЗаписи.Прочитать();
			МенеджерЗаписи.Распечатано = Истина;
			МенеджерЗаписи.Записать();
		КонецЦикла;	
		
		ТаблицаПечати = НаборЗаписей.Выгрузить();		
		ТаблицаПечати.Сортировать("НомерДокумента");    
		
		Попытка
			
			Для каждого Строка Из ТаблицаПечати  Цикл 
													
				ТабличныйДокумент = Строка.Хранилище.Получить(); 
				Если ТипЗнч(ТабличныйДокумент) <> Тип("ТабличныйДокумент") Тогда
					Продолжить;	
				КонецЕсли;
				УстановитьБазовыеПараметрыТабличногоДокумента(ТабличныйДокумент);
				ТабличныйДокумент.ИмяПринтера = Строка.ПутьКПринтеру; 
				МассивДокументов.Добавить(ТабличныйДокумент);
								
			КонецЦикла;		
		
			ЗафиксироватьТранзакцию(); 
			Возврат МассивДокументов;
		Исключение    
			ОписаниеОшибки = ОписаниеОшибки();
			ОтменитьТранзакцию();
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

// Возвращает Истина, если у пользователя есть право на работу с модулем, и он установлен как оператор печати (под его
// учеткой запускается мониторинг сервера печати) Используется для инициализации монитора сервера печати, и при
// определении необходимости добавить ШК склада в типовую печатную форму.
// 
// Возвращаемое значение:
// Булево  - значение права печати
//
Функция ЕстьПравоПечатиДокументовСклада() Экспорт 
	
	// ТУ_Мовчан 11.01.24
	Если НЕ вмс_РаботаСПользователямиСервер.ПроверитьПраваНаВМС() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.вмс_ОператорыПечатиАдресныхДокументов.СоздатьНаборЗаписей();
