Функция ОтправкаЗаданияНаПечатьВИС(Ответ, ТабличныйДокумент, Оператор=Неопределено, ПараметрыПечати=Неопределено) Экспорт
	
	МассивТабДоков = Новый Массив;
	МассивТабДоков.Добавить(ТабличныйДокумент);
	ИнформацияПоИсполнению = ДобавитьДокументКПечатиНаСервер(МассивТабДоков,Оператор,ПараметрыПечати);
	
	Если ЗначениеЗаполнено(ИнформацияПоИсполнению) Тогда
		Ответ.Ошибка = НЕ ИнформацияПоИсполнению.Результат;
		Ответ.ТекстОшибки = ИнформацияПоИсполнению.ОтветСервераПечати;
		Возврат Ответ;	
	Иначе
		Ответ.Ошибка = Истина;
		Ответ.ТекстОшибки = "Не удалось отправить документ на сервер печати";
		Возврат Ответ;	
	КонецЕсли;
	
КонецФункции 

Функция ДобавитьДокументКПечатиНаСервер(МассивТабличныхДокументов, Оператор = Неопределено, ПараметрыПечати = Неопределено) Экспорт
	
	ПринтерНаПечать = Неопределено; 
	ИмяКомпьютера = Неопределено;
	ПутьКПринтеру = Неопределено;
	
	// ТУ_Самойленко 10.08.23 ++ 
	Если Не ЗначениеЗаполнено(ПараметрыПечати) Тогда 
		
		ТаблицаНастроекПечати = ПолучитьТаблицуНастроекПринтеров(Оператор);  
		
		Если ЗначениеЗаполнено(ТаблицаНастроекПечати) Тогда
			
			// Сначала ищем локальный принтер по умолчанию
			// Если не нашли, ищем первый локальный принтер
			МассивЛокальныхПринтеровПоУмолчанию = ТаблицаНастроекПечати.НайтиСтроки(Новый Структура("ТипПринтера,ПоУмолчанию",Перечисления.ТипыПринтеров.ЛокальныйПринтер,Истина));
			
			Если МассивЛокальныхПринтеровПоУмолчанию.Количество() <> 0 Тогда
				ПринтерНаПечать = МассивЛокальныхПринтеровПоУмолчанию[0]; 
			Иначе
				Для каждого СтрокаПринтер Из ТаблицаНастроекПечати Цикл			
					Если СтрокаПринтер.ТипПринтера = Перечисления.ТипыПринтеров.ЛокальныйПринтер Тогда
						ПринтерНаПечать = СтрокаПринтер;
						Прервать;
					КонецЕсли;			
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПринтерНаПечать = Неопределено Тогда
			Возврат Новый Структура("Результат,ОтветСервераПечати",Ложь,"Не удалось определить принтер для текущего оператора");	
		КонецЕсли;
		
	Иначе
		
		ПринтерНаПечать = ПараметрыПечати;
		
	КонецЕсли;
		
	// ТУ_Самойленко 10.08.23 --
	
	Для каждого ТабличныйДокумент Из МассивТабличныхДокументов  Цикл 
		
		НаборЗаписей = РегистрыСведений.ОчередьПечати.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИмяКомпьютера.Установить(ПринтерНаПечать.ИмяКомпьютера);
		НаборЗаписей.Прочитать();
		
		Запись = НаборЗаписей.Добавить(); 
		Запись.Период = ТекущаяДата();
		ЗаполнитьЗначенияСвойств(Запись,ПринтерНаПечать);
		Запись.НомерДокумента = НаборЗаписей.Количество();
		Запись.Хранилище = Новый ХранилищеЗначения(ТабличныйДокумент); 
		
		Если ТипЗнч(Оператор)=Тип("СправочникСсылка.вмс_НастройкиОператора") Тогда
			Запись.Оператор = Оператор;
		Иначе
			// ТУ_Прошин_06.05.24++
			НайденныйОператор = Справочники.вмс_НастройкиОператора.НайтиПоРеквизиту("Оператор", Оператор);
			Если ЗначениеЗаполнено(НайденныйОператор) Тогда	
				Запись.Оператор = НайденныйОператор;
			КонецЕсли;  
			// ТУ_Прошин_06.05.24--
		КонецЕсли;
				
		НаборЗаписей.Записать();  
		
		ИмяКомпьютера = ПринтерНаПечать.ИмяКомпьютера; 
		ПутьКПринтеру = ПринтерНаПечать.ПутьКПринтеру;
	КонецЦикла;	
	
	Возврат Новый Структура("Результат,ОтветСервераПечати",Истина,"Отправлено на " + ИмяКомпьютера + "\" + ПутьКПринтеру);
	
КонецФункции

Функция СформироватьТабличныйДокументЭтикеткиКонтейнеровПоШаблону(МассивКонтейнеров, КоличествоКопий = 1, ТабличныйДокумент)
	ТаблицаПечати = Новый ТаблицаЗначений;
	ТаблицаПечати.Колонки.Добавить("Контейнер");
	ТаблицаПечати.Колонки.Добавить("Шаблон");	
	
	Для каждого Контейнер Из МассивКонтейнеров  Цикл	
		нСтрока = ТаблицаПечати.Добавить(); 
		нСтрока.Контейнер = Контейнер;
		нСтрока.Шаблон = Контейнер.ТипТары.ШаблонЭтикетки;		
	КонецЦикла;  
	
	ТаблицаШаблонов = ТаблицаПечати.Скопировать(,"Шаблон");
	ТаблицаШаблонов.Свернуть("Шаблон");
	
	Для каждого пСтрока Из ТаблицаШаблонов  Цикл		
		МассивКонтейнеровШаблона = ТаблицаПечати.НайтиСтроки(Новый Структура("Шаблон",пСтрока.Шаблон));	
		
		Для каждого СтрокаКонтейнер Из МассивКонтейнеровШаблона  Цикл
			
			Контейнер = СтрокаКонтейнер.Контейнер; 		
			СтруктураШаблона = пСтрока.Шаблон.ШаблонЭтикетки.Получить();
			
			Область = СтруктураШаблона.МакетЭтикетки;
			ПараметрыМакета = Новый Структура("",);
			
			Для каждого КлючЗначение Из СтруктураШаблона.ПараметрыШаблона Цикл 
				
				Если СтруктураШаблона.Свойство("ОбработчикиПараметров") Тогда
					Обработчики = СтруктураШаблона.ОбработчикиПараметров;
					Обработчик = Обработчики[КлючЗначение.Ключ];
					Если ЗначениеЗаполнено(Обработчик) Тогда 
						
						Обработчик = СтрЗаменить(Обработчик,"%Параметр%",Строка(Контейнер[КлючЗначение.Ключ])); 
						Попытка
							ЗначениеПараметра = Вычислить(Обработчик);	
						Исключение
							ЗначениеПараметра = Строка(Контейнер[КлючЗначение.Ключ]);
						КонецПопытки;
						
					Иначе
						ЗначениеПараметра = Строка(Контейнер[КлючЗначение.Ключ]);						
					КонецЕсли;  
				Иначе
					ЗначениеПараметра = Строка(Контейнер[КлючЗначение.Ключ]);			
				КонецЕсли;
				ПараметрыМакета.Вставить(КлючЗначение.Значение,ЗначениеПараметра);	
			КонецЦикла;
			
			Область.Параметры.Заполнить(ПараметрыМакета);
			
			Для каждого Рисунок Из Область.Рисунки Цикл
				
				Если СтрНайти(Рисунок.Имя, "Штрихкод") = 1 Тогда
					
					ЗначениеШтрихкода = Контейнер.Штрихкод;
					Если ЗначениеЗаполнено(ЗначениеШтрихкода) Тогда
						ЗначениеШтрихкодаДляКомпоненты = ЗначениеШтрихкода;
						
						Если СтруктураШаблона.Свойство("УровеньЧеткости") Тогда
							УровеньЧеткости = СтруктураШаблона.УровеньЧеткости;
						Иначе
							УровеньЧеткости = 1;
						КонецЕсли;  
						
						Эталон = ПолучитьОбщийМакет("Эталон");
						
						КоличествоМиллиметровВПикселеВысота = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
						КоличествоМиллиметровВПикселеШирина = Эталон.Рисунки.Квадрат100Пикселей.Ширина / 100;
						
						ПараметрыШтрихкода = Новый Структура;
						ПараметрыШтрихкода.Вставить("Ширина",           Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселеШирина) * УровеньЧеткости);
						ПараметрыШтрихкода.Вставить("Высота",           Окр(Рисунок.Высота / КоличествоМиллиметровВПикселеВысота) * УровеньЧеткости);
						ПараметрыШтрихкода.Вставить("Штрихкод",         СокрЛП(ЗначениеШтрихкодаДляКомпоненты));
						ПараметрыШтрихкода.Вставить("ТипВходныхДанных", 0); // Штрихкод - это строка
						ПараметрыШтрихкода.Вставить("ОтображатьТекст",  Ложь);  
						
						Если СтруктураШаблона.Свойство("ТипКода") Тогда
							ПараметрыШтрихкода.Вставить("ТипКода", СтруктураШаблона.ТипКода);
						Иначе
							ПараметрыШтрихкода.Вставить("ТипКода", 16);
						КонецЕсли;
						
						Если СтруктураШаблона.Свойство("GS1DatabarКоличествоСтрок") Тогда
							ПараметрыШтрихкода.Вставить("GS1DatabarКоличествоСтрок", СтруктураШаблона.GS1DatabarКоличествоСтрок);
						КонецЕсли;
						Если СтруктураШаблона.Свойство("ТипШрифта") Тогда
							ПараметрыШтрихкода.Вставить("ТипШрифта", СтруктураШаблона.МонохромныйШрифт);
						КонецЕсли;
						Если СтруктураШаблона.Свойство("УголПоворота") Тогда
							ПараметрыШтрихкода.Вставить("УголПоворота", СтруктураШаблона.УголПоворота);
						КонецЕсли;
						Если СтруктураШаблона.Свойство("МонохромныйШрифт") Тогда
							ПараметрыШтрихкода.Вставить("МонохромныйШрифт", СтруктураШаблона.МонохромныйШрифт);
						КонецЕсли;
						Если СтруктураШаблона.Свойство("Масштабировать") Тогда
							ПараметрыШтрихкода.Вставить("Масштабировать", СтруктураШаблона.Масштабировать);
						КонецЕсли;
						Если СтруктураШаблона.Свойство("СохранятьПропорции") Тогда
							ПараметрыШтрихкода.Вставить("СохранятьПропорции", СтруктураШаблона.СохранятьПропорции);
						КонецЕсли;
						Если СтруктураШаблона.Свойство("ВертикальноеВыравнивание") Тогда
							ПараметрыШтрихкода.Вставить("ВертикальноеВыравнивание", СтруктураШаблона.ВертикальноеВыравнивание);
						КонецЕсли;
						
						// ТУ Алфимов 01.03.2024++
						//Рисунок.Картинка = МенеджерОборудованияВызовСервера.ПолучитьКартинкуШтрихкода(ПараметрыШтрихкода);
						
						Рисунок.Картинка = ИзображениеШтрихкода(ПараметрыШтрихкода);
						// ТУ Алфимов 01.03.2024--
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			// Прошин_ТУ_19.05.23++
			
			//Для Счетчик = 1 По КоличествоКопий  Цикл
			//	//Область.ВысотаСтраницы = пСтрока.ВысотаЭтикетки;
			//	//Область.ШиринаСтраницы = пСтрока.ШиринаЭтикетки; 
			//	ТабличныйДокумент.Вывести(Область); 
			//	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц(); 				
			//КонецЦикла;     
			
			Для Счетчик = 1 По КоличествоКопий  Цикл
				ТабличныйДокумент.РазмерСтраницы = "Custom";
				ТабличныйДокумент.ВысотаСтраницы = пСтрока.Шаблон.ВысотаЭтикетки;
				ТабличныйДокумент.ШиринаСтраницы = пСтрока.Шаблон.ШиринаЭтикетки;
				ТабличныйДокумент.Вывести(Область); 
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц(); 				
			КонецЦикла; 
			// Прошин_ТУ_19.05.23--

			
		КонецЦикла;	
		
	КонецЦикла;	
КонецФункции

Функция СформироватьТабличныйДокументЭтикеткиСерииПоШаблону(СерииДляПечати, КоличествоКопий = 1, ТабличныйДокумент, Принтер=Неопределено)
	
	// ТУ_Самойленко 30.08.23 ++
	ПолученыПараметрыПечати = Ложь;
	Если Принтер <> Неопределено Тогда
		ПараметрыПечати = ПолучитьПараметрыПринтера(Принтер);
		ПолученыПараметрыПечати = Истина;
	КонецЕсли;
	// ТУ_Самойленко 30.08.23 --
	
	ТаблицаПечати = Новый ТаблицаЗначений;
	ТаблицаПечати.Колонки.Добавить("РеквизитыСерии");
	ТаблицаПечати.Колонки.Добавить("Штрихкод");	
	
	Для каждого РеквизитыСерии Из СерииДляПечати  Цикл	
		нСтрока = ТаблицаПечати.Добавить(); 
		нСтрока.РеквизитыСерии = РеквизитыСерии;
		нСтрока.Штрихкод = вмс_СерииТоваровСервер.СформироватьШтрикходСерии(РеквизитыСерии);		
	КонецЦикла;  
	
	Макет = ПолучитьОбщийМакет("МакетШтрихкода"); 
	
	// ТУ_Самойленко 30.08.23 ++
	Если ПолученыПараметрыПечати Тогда
		ШиринаЭтикетки = ПараметрыПечати.ШиринаЭтикетки;
		ВысотаЭтикетки = ПараметрыПечати.ВысотаЭтикетки;
		РазмерШрифта = ПараметрыПечати.РазмерШрифта;
	Иначе
		ШиринаЭтикетки = 50;
		ВысотаЭтикетки = 50;
		РазмерШрифта = Окр(ВысотаЭтикетки * 0.4);
	КонецЕсли;
	// ТУ_Самойленко 30.08.23 --
	
	Для каждого ДанныеПечати Из ТаблицаПечати Цикл 
			
		ЗначениеШтрихкода = ДанныеПечати.Штрихкод;  
		Шаблон = Макет.ПолучитьОбласть("ОбластьШтрихкода"); 
		
		УстановитьБазовыеПараметрыТабличногоДокумента(Шаблон);
		
		Эталон = ПолучитьОбщийМакет("Эталон");
		КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;  //0.26454
		
		ПараметрыШтрихкода = Новый Структура;
		ПараметрыШтрихкода.Вставить("Ширина",          Окр(ШиринаЭтикетки / КоличествоМиллиметровВПикселе));
		ПараметрыШтрихкода.Вставить("Высота",          Окр((ВысотаЭтикетки - 2) / КоличествоМиллиметровВПикселе));
		ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
		ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь); 
		ПараметрыШтрихкода.Вставить("Масштабировать", Истина);
		ПараметрыШтрихкода.Вставить("ТипКода", 16);
		ПараметрыШтрихкода.Вставить("УбратьЛишнийФон", Истина);
		
		
		// ТУ Алфимов 01.03.2024++
		//Шаблон.Рисунки.Штрихкод.Картинка = МенеджерОборудованияВызовСервера.ПолучитьКартинкуШтрихкода(ПараметрыШтрихкода);
		
		Шаблон.Рисунки.Штрихкод.Картинка = ИзображениеШтрихкода(ПараметрыШтрихкода);
		// ТУ Алфимов 01.03.2024--
		
		Шаблон.Рисунки.Штрихкод.Высота = 1; 
		Шаблон.Рисунки.Штрихкод.Ширина = ШиринаЭтикетки;    
		
		Шаблон.Параметры.ПредставлениеКода = ЗначениеШтрихкода;		
		Шаблон.ТекущаяОбласть.Шрифт = Новый Шрифт(Шаблон.ТекущаяОбласть.Шрифт,,РазмерШрифта,Истина);   
		
		ОбластьПредставления = Шаблон.Область(1,1,1,Шаблон.ШиринаТаблицы);
		ОбластьПредставления.Объединить(); 
		ОбластьПредставления.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		
		КартинкаШтрихкода = Шаблон.Рисунки.Штрихкод;
		// Сохраним размеры штрихкода
		ВысотаКартинки = КартинкаШтрихкода.Высота;
		ШиринаКартинки = КартинкаШтрихкода.Ширина;
		ВерхКартинки = КартинкаШтрихкода.Верх; 
		ЛевоКартинки = КартинкаШтрихкода.Лево;
		КартинкаШтрихкода.Расположить(ОбластьПредставления);
		// Сохраним размеры штрихкода	
		НоваяШирина = КартинкаШтрихкода.Ширина; 
		НоваяВысота = ВысотаЭтикетки - КартинкаШтрихкода.Высота;		
		Разница = (НоваяШирина - ШиринаКартинки) / 2; 
		ВеличинаСдвигаКартинкиНаТекст = КартинкаШтрихкода.Высота / 5; // рассчитаем место, куда можно задвинуть картинку, потому что текст центрирован, внизу есть место
		КартинкаШтрихкода.Верх = ВерхКартинки - ВеличинаСдвигаКартинкиНаТекст; //задвинем картинку на текст
		КартинкаШтрихкода.Высота = НоваяВысота + (ВеличинаСдвигаКартинкиНаТекст - 4); // ТУ_Самойленко 30.08.23 Заменил +4 на -4
		КартинкаШтрихкода.Ширина = ШиринаКартинки;
		КартинкаШтрихкода.Лево = ЛевоКартинки + Разница;	
		КартинкаШтрихкода.РазмерКартинки = РазмерКартинки.Пропорционально; // ТУ_Самойленко 30.08.23 Убрал реальный размер, т.к. при увеличении размера этикетки, она не полностью отображается.
		
		Для Счетчик = 1 По КоличествоКопий  Цикл 
			ТабличныйДокумент.РазмерСтраницы = "Custom";
			ТабличныйДокумент.ВысотаСтраницы = ВысотаЭтикетки;
			ТабличныйДокумент.ШиринаСтраницы = ШиринаЭтикетки;
			ТабличныйДокумент.Вывести(Шаблон);   
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЦикла;	
		
	КонецЦикла; 
		
	
КонецФункции

#КонецОбласти
