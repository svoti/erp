// Возвращает табличный документ, с автомасштабом по ширине и без полей.
// 
// Возвращаемое значение:
// ТабличныйДокумент -ТабличныйДокумент с автомасштабом по ширине и без полей 
//
Функция НовыйТабличныйДокумент()
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	УстановитьБазовыеПараметрыТабличногоДокумента(ТабличныйДокумент);
	
