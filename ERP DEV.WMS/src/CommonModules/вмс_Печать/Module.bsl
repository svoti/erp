// 3.2.4
Функция ДобавитьДокументКПечатиЧерезРегистр(ТабличныйДокумент, ВыбранныйПринтер) Экспорт
	
	НаборЗаписей = РегистрыСведений.ОчередьПечати.СоздатьНаборЗаписей();
	НаборЗаписей.Заполнить(Неопределено);
	НаборЗаписей.Отбор.ИмяКомпьютера.Установить(ВыбранныйПринтер.ИмяКомпьютера);
	НаборЗаписей.Прочитать();
	
	Запись = НаборЗаписей.Добавить(); 
	Запись.Период = ТекущаяДата();
	ЗаполнитьЗначенияСвойств(Запись, ВыбранныйПринтер);
	Запись.НомерДокумента = НаборЗаписей.Количество();
	Запись.Хранилище = Новый ХранилищеЗначения(ТабличныйДокумент);
	Запись.Оператор = Неопределено;
	
	НаборЗаписей.Записать();
	
КонецФункции

