Функция ПолучитьДанныеПринтера(Принтер) Экспорт
	ДанныеПринтера = Новый Структура;

	Для Каждого ИмяПоля Из ПолучитьИменаПолейНастроекПринтера() Цикл
		ДанныеПринтера.Вставить(ИмяПоля, Принтер[ИмяПоля]);
	КонецЦикла;

	Возврат ДанныеПринтера;
КонецФункции

// Используется для формирования задания на печать через сервер печати
//
// Параметры:
//  ДанныеПечати - Структура	 - содержит входные данные для печати:
//     * ПараметрыПечати - Структура - содержит параметры печати
//     * МассивЭлементов - Массив - контейнеры, которые нужно напечатать
//     * КоличествоЭкземпляров - Число - сколько этикеток одного контейнера печатать
// Возвращаемое значение:
// Структура:
// 
//     * Ошибка - Булево - признак ошибки при отправке задания
//     * ТекстОшибки - Строка - поясняющий к ошибке комментарий
//
Функция ПечатьКонтейнераВИС(ДанныеПечати, Оператор = Неопределено) Экспорт 
	
	Ответ = Новый Структура("Ошибка, ТекстОшибки",Ложь,"Гуд ньюс");
	
	// -// Определение параметров печати //-//
	
	Принтер = Неопределено;
	ПараметрыПечати = Неопределено;
	Если ДанныеПечати.Свойство("ПараметрыПечати") Тогда
		ДанныеПечати.ПараметрыПечати.Свойство("Принтер", Принтер);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Принтер) Тогда
		ПараметрыПечати = ПолучитьПараметрыПринтера(Принтер);		
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ПараметрыПечати) Тогда
		Ответ.Ошибка = Истина;
		Ответ.ТекстОшибки = "Не удалось получить параметры печати";
		Возврат Ответ;	
	КонецЕсли; 
	
	// -// Формирование этикетки //-//
	
	МассивЭлементов = Неопределено;
	Если НЕ ДанныеПечати.Свойство("МассивЭлементов", МассивЭлементов) Тогда
		Ответ.Ошибка = Истина;
		Ответ.ТекстОшибки = "Отсутствует ключ МассивЭлементов";
		Возврат Ответ;
	КонецЕсли;
	
	КоличествоЭкземпляров = Неопределено;
	Если НЕ ДанныеПечати.Свойство("КоличествоЭкземпляров", КоличествоЭкземпляров) Тогда
		КоличествоЭкземпляров = 1;	
	КонецЕсли;
	
	ТабДокЭтикетки = СформироватьТабличныйДокументЭтикеткиКонтейнеров(МассивЭлементов, КоличествоЭкземпляров);
	
	Если ТабДокЭтикетки = Неопределено Тогда
		Ответ.Ошибка = Истина;
		Ответ.ТекстОшибки = "Не удалось сформировать табличный документ";
		Возврат Ответ;	
	КонецЕсли;
	
	// -// Отправка задания на печать //-//
	
	Возврат ОтправкаЗаданияНаПечатьВИС(Ответ, ТабДокЭтикетки,,ПараметрыПечати);

КонецФункции

// Возвращает по массиву контейнеров табличный документ с этикетками. Используется при непосредственной печати с ТСД и
// как метод печати для сервера печати Во время печати определяет, печатать внешнюю печатную форму из контейнера или по
// стандартному шаблону, в зависимости от типа контейнера
//
// Параметры:
//  МассивКонтейнеров	 - Массив	 - контейнеры, для которых печатаются этикетки
//  КоличествоКопий		 - Число	 - сколько раз печатать каждую этикетку
// 
// Возвращаемое значение:
// ТабличныйДокумент  - табличный документ с этикетками
//
Функция СформироватьТабличныйДокументЭтикеткиКонтейнеров(МассивКонтейнеров, КоличествоКопий = 1) Экспорт
	
	ТабличныйДокумент = НовыйТабличныйДокумент(); 
	
	ПоШаблону = Новый Массив;
	Для каждого Контейнер Из МассивКонтейнеров  Цикл
		Если Контейнер.ТипТары.ИспользоватьВнешнююПечатнуюФорму = Истина Тогда 
			Если МассивКонтейнеров.Найти(Контейнер)= 0 ИЛИ Контейнер.ТипТары <> МассивКонтейнеров[?(МассивКонтейнеров.Найти(Контейнер)= 0,0,(МассивКонтейнеров.Найти(Контейнер)-1))].ТипТары Тогда 
				ПФ = Контейнер.ТипТары.ВнешняяПечатнаяФорма.Получить(); 
				Если ПФ <> Неопределено Тогда
					Адрес = ПоместитьВоВременноеХранилище(ПФ.ФайлПФ);
					ИмяОбработки = ВнешниеОбработки.Подключить(Адрес, , Ложь, ОбщегоНазначения.ОписаниеЗащитыБезПредупреждений());
					МенеджерОбработки = ВнешниеОбработки.Создать(ИмяОбработки);
				КонецЕсли;
			КонецЕсли; 
			Попытка
				МенеджерОбработки.СформироватьЭтикетку(Контейнер, ТабличныйДокумент, КоличествоКопий);
			Исключение
				ТекстОшибки = ОписаниеОшибки();
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
				ЗаписьЖурналаРегистрации("AS:WMS", УровеньЖурналаРегистрации.Ошибка, ,, ТекстОшибки);
			КонецПопытки;			
		Иначе
			ПоШаблону.Добавить(Контейнер);	
		КонецЕсли	
	КонецЦикла;
	
	Если ПоШаблону.Количество() <> 0 Тогда 
		СформироватьТабличныйДокументЭтикеткиКонтейнеровПоШаблону(ПоШаблону,КоличествоКопий,ТабличныйДокумент)
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Используется для формирования задания на печать серии через сервер печати
//
// Параметры:
//  ДанныеПечати - Структура	 - содержит входные данные для печати:
//     * ПараметрыПечати - Структура - содержит параметры печати
//     * РеквизитыСерии - Структура - параметры серии для печати: ВАЖНО, должен быть заполнен хоть 1 параметр:
//         * Номер - Строка , Неопределено- номер серии  
//         * ГоденДо - Дата ,Неопределено - окончание срока годности
//         * ДатаПроизводства - Дата ,Неопределено - дата производства серии
//     * КоличествоЭкземпляров - Число - сколько этикеток серии печатать
// Возвращаемое значение:
// Структура:
// 
//     * Ошибка - Булево - признак ошибки при отправке задания
//     * ТекстОшибки - Строка - поясняющий к ошибке комментарий
//
Функция ПечатьСерийнойЭтикеткиВИС(ДанныеПечати, Оператор = Неопределено) Экспорт

	Ответ = Новый Структура("Ошибка, ТекстОшибки",Ложь,"Гуд ньюс");
	
	// -// Определение параметров печати //-//
	
	Принтер = Неопределено;
	ПараметрыПечати = Неопределено;
	Если ДанныеПечати.Свойство("ПараметрыПечати") Тогда
		ДанныеПечати.ПараметрыПечати.Свойство("Принтер", Принтер);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Принтер) Тогда
		ПараметрыПечати = ПолучитьПараметрыПринтера(Принтер);		
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ПараметрыПечати) Тогда
		Ответ.Ошибка = Истина;
		Ответ.ТекстОшибки = "Не удалось получить параметры печати";
		Возврат Ответ;	
	КонецЕсли;
	
	// -// Формирование этикетки //-//
	
	РеквизитыПечати = Неопределено;
	Если НЕ ДанныеПечати.Свойство("РеквизитыПечати", РеквизитыПечати) Тогда
		Ответ.Ошибка = Истина;
		Ответ.ТекстОшибки = "Отсутствует ключ РеквизитыПечати";
		Возврат Ответ;
	КонецЕсли;
	
	КоличествоЭкземпляров = Неопределено;
	Если НЕ ДанныеПечати.Свойство("КоличествоЭкземпляров", КоличествоЭкземпляров) Тогда
		КоличествоЭкземпляров = 1;
	КонецЕсли;
	
	ТабДокЭтикетки = СформироватьТабличныйДокументЭтикеткиСерии(РеквизитыПечати, КоличествоЭкземпляров, Принтер);
	
	Если ТабДокЭтикетки = Неопределено Тогда
		Ответ.Ошибка = Истина;
		Ответ.ТекстОшибки = "Не удалось сформировать табличный документ";
		Возврат Ответ;	
	КонецЕсли; 
	
	// -// Отправка задания на печать //-//
	
	Возврат ОтправкаЗаданияНаПечатьВИС(Ответ, ТабДокЭтикетки,,ПараметрыПечати);	
	
КонецФункции

// Возвращает по реквизитам серии табличный документ с этикетками. Используется при непосредственной печати с ТСД и как
// метод печати для сервера печати Во время печати определяет, печатать внешнюю печатную форму из контейнера или по
// стандартному шаблону, в зависимости от типа контейнера
//
// Параметры:
//  РеквизитыСерии - Структура - параметры серии для печати: ВАЖНО, должен быть заполнен хоть 1 параметр:
//         * Номер - Строка , Неопределено- номер серии  
//         * ГоденДо - Дата ,Неопределено - окончание срока годности
//         * ДатаПроизводства - Дата ,Неопределено - дата производства серии
//  КоличествоКопий		 - Число	 - сколько раз печатать каждую этикетку
// 
// Возвращаемое значение:
// ТабличныйДокумент  - табличный документ с этикетками
//
Функция СформироватьТабличныйДокументЭтикеткиСерии(РеквизитыСерии, КоличествоКопий = 1, Принтер=Неопределено) Экспорт  
	
	ТабличныйДокумент = НовыйТабличныйДокумент(); 
	
	ПоШаблону = Новый Массив;
	Если Ложь Тогда  //Заглушка для печати через внешнюю обработку  
		
		// Кулалаев Е.С + 31.05.2024 17:56:48
		// Рефакторинг. вмс_Печать на вмс_Печать
		
		МенеджерОбработки = вмс_ПечатьПереопределяемыйВызовСервера.СформироватьТабличныйДокументЭтикеткиСерии(РеквизитыСерии, КоличествоКопий);
		
		Попытка
			МенеджерОбработки.СформироватьЭтикетку(РеквизитыСерии, ТабличныйДокумент, КоличествоКопий);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			ЗаписьЖурналаРегистрации("AS:WMS", УровеньЖурналаРегистрации.Ошибка, ,, ТекстОшибки);
		КонецПопытки;
		
	Иначе
		ПоШаблону.Добавить(РеквизитыСерии);	
	КонецЕсли;	
	
	Если ПоШаблону.Количество() <> 0 Тогда			
		СформироватьТабличныйДокументЭтикеткиСерииПоШаблону(ПоШаблону, КоличествоКопий, ТабличныйДокумент, Принтер); // ТУ_Самойленко 30.08.23		
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьТоварнойЭтикеткиВИС(ДанныеПечати, Оператор = Неопределено) Экспорт
	
	Ответ = Новый Структура("Ошибка, ТекстОшибки",Ложь,"Гуд ньюс");
	
	Попытка
		// -// Определение параметров печати //-//
		
		Принтер = Неопределено;
		ПараметрыПечати = Неопределено;
		Если ДанныеПечати.Свойство("ПараметрыПечати") Тогда
			ДанныеПечати.ПараметрыПечати.Свойство("Принтер", Принтер);	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Принтер) Тогда
			ПараметрыПечати = ПолучитьПараметрыПринтера(Принтер);		
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(ПараметрыПечати) Тогда
			Ответ.Ошибка = Истина;
			Ответ.ТекстОшибки = "Не удалось получить параметры печати";
			Возврат Ответ;	
		КонецЕсли;
		
		// -// Формирование этикетки //-//
		
		РеквизитыПечати = Неопределено;
		Если НЕ ДанныеПечати.Свойство("РеквизитыПечати", РеквизитыПечати) Тогда
			Ответ.Ошибка = Истина;
			Ответ.ТекстОшибки = "Отсутствует ключ РеквизитыПечати";
			Возврат Ответ;
		КонецЕсли;
		
		КоличествоЭкземпляров = Неопределено;
		Если ДанныеПечати.Свойство("КоличествоЭкземпляров", КоличествоЭкземпляров) Тогда
			РеквизитыПечати.Вставить("Количество", КоличествоЭкземпляров);
		Иначе
			Если НЕ РеквизитыПечати.Свойство("Количество") Тогда
				РеквизитыПечати.Вставить("Количество", 1);	
			КонецЕсли;
		КонецЕсли;
		
		ТабДокЭтикетки = вмс_АдаптацияКонфигураций.ПечатьЭтикеткиТовара(РеквизитыПечати);
		
		Если ТабДокЭтикетки = Неопределено Тогда
			Ответ.Ошибка = Истина;
			Ответ.ТекстОшибки = "Не удалось сформировать табличный документ";
			Возврат Ответ;	
		КонецЕсли; 
		
		// -// Отправка задания на печать //-//
		// ТУ_Прошин_13.05.24++
		// Добавил параметр Оператора
		Возврат ОтправкаЗаданияНаПечатьВИС(Ответ, ТабДокЭтикетки,Оператор,ПараметрыПечати);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Ответ.Ошибка = Истина;
		Ответ.ТекстОшибки = вмс_ОбщегоНазначенияВызовСервера.ТекстовоеПредставлениеОшибки(Инфо);
		Возврат Ответ;
	КонецПопытки;
КонецФункции

Функция СформироватьПечатнуюФорму(Объекты, ИмяМакета, ПараметрыПечати=Неопределено) Экспорт
	
	Перем Результат;
	
	Если ТипЗнч(Объекты) <> ТипЗнч("Массив") Тогда
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объекты);
	Иначе
		МассивОбъектов = Объекты;
	КонецЕсли;
	
	ИмяМенеджераПечати = МассивОбъектов[0].Метаданные().ПолноеИмя();
	
	Если ТипЗнч(ПараметрыПечати) <> Тип("Структура") Тогда
		ПараметрыПечати = Новый Структура;
	КонецЕсли;
	
	Результат = УправлениеПечатью.СформироватьПечатныеФормы(ИмяМенеджераПечати, ИмяМакета, МассивОбъектов, ПараметрыПечати);
	
	Возврат Результат;
	
КонецФункции

