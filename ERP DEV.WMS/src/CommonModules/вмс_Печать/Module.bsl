// 3.2.4
Функция СформироватьПечатнуюФормуКонтейнеров(МассивКонтейнеров, КоличествоКопий = 1) Экспорт
	
	ТабличныйДокумент = НовыйТабличныйДокумент(); 
	
	ПоШаблону = Новый Массив;
	Для каждого Контейнер Из МассивКонтейнеров  Цикл
		Если Контейнер.ТипТары.ИспользоватьВнешнююПечатнуюФорму = Истина Тогда 
			Если МассивКонтейнеров.Найти(Контейнер)= 0 ИЛИ Контейнер.ТипТары <> МассивКонтейнеров[?(МассивКонтейнеров.Найти(Контейнер)= 0,0,(МассивКонтейнеров.Найти(Контейнер)-1))].ТипТары Тогда 
				ПФ = Контейнер.ТипТары.ВнешняяПечатнаяФорма.Получить(); 
				Если ПФ <> Неопределено Тогда
					Адрес = ПоместитьВоВременноеХранилище(ПФ.ФайлПФ);
					ИмяОбработки = ВнешниеОбработки.Подключить(Адрес, , Ложь, ОбщегоНазначения.ОписаниеЗащитыБезПредупреждений());
					МенеджерОбработки = ВнешниеОбработки.Создать(ИмяОбработки);
				КонецЕсли;
			КонецЕсли; 
			Попытка
				МенеджерОбработки.СформироватьЭтикетку(Контейнер, ТабличныйДокумент, КоличествоКопий);
			Исключение
				ТекстОшибки = ОписаниеОшибки();
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
				ЗаписьЖурналаРегистрации("AS:WMS", УровеньЖурналаРегистрации.Ошибка, ,, ТекстОшибки);
			КонецПопытки;			
		Иначе
			ПоШаблону.Добавить(Контейнер);	
		КонецЕсли	
	КонецЦикла;
	
	Если ПоШаблону.Количество() <> 0 Тогда 
		СформироватьТабличныйДокументЭтикеткиКонтейнеровПоШаблону(ПоШаблону,КоличествоКопий,ТабличныйДокумент)
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

