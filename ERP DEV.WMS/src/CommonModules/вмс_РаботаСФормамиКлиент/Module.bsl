#Область Масштаб

Функция ИзменитьМасштабФормы(Форма,НовыйМасштаб) Экспорт
	
	ТипТаблица = Тип("ТаблицаФормы");
	ТипГруппа = Тип("ГруппаФормы");
	
	КоллекцияЭлементовФормы = Форма.Элементы;
	
	Для Каждого ТекущийЭлемент Из КоллекцияЭлементовФормы Цикл
		
		Если ТипЗнч(ТекущийЭлемент) = ТипТаблица Тогда
			// Элементы колонок таблицы наследуют масштаб таблицы + свой масштаб
			// Я вот так решил избежать двойного увеличения
		ИначеЕсли ТипЗнч(ТекущийЭлемент) = ТипГруппа Тогда
			Если ТекущийЭлемент.Вид = ВидГруппыФормы.КоманднаяПанель Тогда
				// Тут есть свои особенности у "Обычного приложения"
			Иначе
				ИзменитьШрифт(ТекущийЭлемент.ШрифтЗаголовка,НовыйМасштаб);
			КонецЕсли;
		Иначе
			Попытка
				ИзменитьШрифт(ТекущийЭлемент.Шрифт,НовыйМасштаб);
			Исключение
			КонецПопытки;    
			Попытка
				ИзменитьШрифт(ТекущийЭлемент.ШрифтЗаголовка,НовыйМасштаб);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Процедура ИзменитьШрифт(ИсходныйШрифт, Масштаб) Экспорт
	
	Если ИсходныйШрифт.Размер = -1 Тогда
		НовыйМасштаб = (Масштаб/ИсходныйШрифт.Масштаб)*100;
		Если НовыйМасштаб <> 100 Тогда
			// Чтобы избежать повторного увеличения при неоднократном вызове масштабирования
			ИсходныйШрифт = Новый Шрифт(ИсходныйШрифт,,,,,,,НовыйМасштаб);
		КонецЕсли;
	Иначе
		ИсходныйШрифт = Новый Шрифт(ИсходныйШрифт,,ИсходныйШрифт.Размер,,,,,Масштаб);
	КонецЕсли; 
	
КонецПроцедуры

Функция НастроитьМасштабированиеФормы(Форма) Экспорт
	
	пМасштаб = 100;
	
	ПараметрыАвторизации = вмс_РаботаСПользователямиКлиент.ПолучитьПараметрыАвторизации();
	НастройкиФорм = вмс_РаботаСПользователямиСервер.ПолучитьНастройкиПользователя(ПараметрыАвторизации);
	Если вмс_РаботаСКоллекциями.ЭтоКвазиТаблицаЗначений(НастройкиФорм) Тогда
		НайденныеСтроки = вмс_РаботаСКоллекциями.НайтиСтрокиКвазиТаблицыЗначений(НастройкиФорм, Новый Структура("Настройка", "Масштаб"));
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			Строка = НайденныеСтроки[0];
			Попытка
				пМасштаб = Строка.Значение;
				Если пМасштаб < 60 Тогда
					пМасштаб = 60;
				КонецЕсли;
				ИзменитьМасштабФормы(Форма,пМасштаб);
			Исключение
				пМасштаб = 100;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Форма.пМасштаб = пМасштаб;
	Исключение
	КонецПопытки
	
	
КонецФункции
	
