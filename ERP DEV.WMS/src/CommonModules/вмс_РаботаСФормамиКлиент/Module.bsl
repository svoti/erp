Функция НоваяКлавиатурнаяПанель(Форма, знач ГруппаРазмещения=Неопределено) Экспорт
	
	Если НЕ вмс_РаботаСФормамиКлиентСервер.ПроверитьНаличиеСлужебногоСерверногоМетодаФормы(Форма) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяГруппыРазмещения = Неопределено;
	Если ТипЗнч(ГруппаРазмещения) = Тип("Строка") Тогда
		ГруппаРазмещения = Форма.Элементы.Найти(ГруппаРазмещения);
	КонецЕсли; 
	
	Если ТипЗнч(ГруппаРазмещения) = Тип("ГруппаФормы") Тогда
		ИмяГруппыРазмещения = ГруппаРазмещения.Имя;
	КонецЕсли;
	
	Слушатели = вмс_РаботаСКоллекциями.НоваяКвазиТаблицаЗначений("Имя, ОповещениеВвода, ОповещениеОжидания");
	
	КлавиатурнаяПанель = Новый Структура;
	КлавиатурнаяПанель.Вставить("Кнопки", Новый Соответствие);
	КлавиатурнаяПанель.Вставить("СимволыКнопок", Новый Соответствие);
	КлавиатурнаяПанель.Вставить("ИмяГруппыРазмещения", ИмяГруппыРазмещения);
	КлавиатурнаяПанель.Вставить("ИмяПанели", Неопределено);
	КлавиатурнаяПанель.Вставить("Форма", Форма);
	КлавиатурнаяПанель.Вставить("Слушатели", Слушатели);
	КлавиатурнаяПанель.Вставить("Скрывать", Истина);
	КлавиатурнаяПанель.Вставить("СобственнаяГруппаРазмещения", Ложь);
	
	Возврат КлавиатурнаяПанель;
	
КонецФункции

Функция КлавиатурнаяПанель_ПолучитьСтруктуруДляПередачиНаСервер(КлавиатурнаяПанель) Экспорт
	
	КлавиатурнаяПанельСервер = вмс_РаботаСКоллекциями.СкопироватьСтруктуру(КлавиатурнаяПанель);
	
	ОчисткаПолей = Новый Структура("Форма, Слушатели");
	ЗаполнитьЗначенияСвойств(КлавиатурнаяПанельСервер, ОчисткаПолей);
	
	// Перед отправкой на сервер очистить символы так, как некоторые нельзя передавать на сервер
	Для Каждого ЭлементКнопки Из КлавиатурнаяПанельСервер.Кнопки Цикл
		ЭлементКнопки.Значение.СимволКнопки = "";
	КонецЦикла;
	
	Возврат КлавиатурнаяПанельСервер;
	
КонецФункции

Функция ДобавитьКнопкиИКомандыКлавиатурнойПанели(КлавиатурнаяПанель, НовыеКнопки) Экспорт
	
	Форма = КлавиатурнаяПанель.Форма;
	
	КлавиатурнаяПанельСервер = КлавиатурнаяПанель_ПолучитьСтруктуруДляПередачиНаСервер(КлавиатурнаяПанель);
	
	ПрограммныйКод =
	"КлавиатурнаяПанель = ДополнительныеПараметры[0];
	|МассивКнопок = ДополнительныеПараметры[1];
	|вмс_РаботаСФормамиСервер.КлавиатурнаяПанель_ДобавитьКнопкиИКоманды(Форма, КлавиатурнаяПанель, МассивКнопок);
	|Результат = КлавиатурнаяПанель;";
	
	ДополнительныеПараметры = Новый Массив;
	ДополнительныеПараметры.Добавить(КлавиатурнаяПанельСервер);
	ДополнительныеПараметры.Добавить(вмс_РаботаСКоллекциями.ЗакодироватьСтрокуВМассивКодов(НовыеКнопки));
	
	КлавиатурнаяПанельСервер = Форма.СлужебнаяФункцияВызовСервера(ПрограммныйКод, ДополнительныеПараметры);
	
	ЗаполнитьЗначенияСвойств(КлавиатурнаяПанель, КлавиатурнаяПанельСервер, "ИмяПанели, Кнопки");
	
	// Восстановление кнопок
	// также восстановим ссылки в списке СимволыКнопок так,
	// как после передачи на сервер ссылки начинают указывать на копии данных кнопок, а не на оригинальные данные
	КлавиатурнаяПанель.СимволыКнопок.Очистить();
	Для Каждого ЭлементКнопки Из КлавиатурнаяПанель.Кнопки Цикл
		ДанныеКнопки = ЭлементКнопки.Значение;
		ДанныеКнопки.СимволКнопки = Символ(ДанныеКнопки.КодСимволаКнопки);
		КлавиатурнаяПанель.СимволыКнопок[ДанныеКнопки.КодСимволаКнопки] = ДанныеКнопки;
	КонецЦикла; 
	
	вмс_ПодключаемыеКомандыКлиент.ВывестиКоманды(Форма);
	
	ТаблицаКоманд = вмс_ПодключаемыеКомандыКлиент.ПолучитьТаблицуОписанияКомандФормы(Форма);
	
	ОписаниеКоманды = Новый Структура;
	ОписаниеКоманды.Вставить("ИмяВФорме");
	ОписаниеКоманды.Вставить("Обработчик", "вмс_РаботаСФормамиКлиент.КлавиатурнаяПанель_ОбработатьКоманду");
	ОписаниеКоманды.Вставить("ДополнительныеПараметры", Новый Структура("КлавиатурнаяПанель", КлавиатурнаяПанель));
	
	Для Каждого ЭлементКнопки Из КлавиатурнаяПанель.Кнопки Цикл
		ДанныеКнопки = ЭлементКнопки.Значение;
		ИмяКоманды = ДанныеКнопки.ИмяКоманды;
		Если вмс_РаботаСКоллекциями.НайтиСтрокуКвазиТаблицыЗначений(ТаблицаКоманд, "ИмяВФорме", ИмяКоманды) = Неопределено Тогда
			ОписаниеКоманды.ИмяВФорме = ИмяКоманды;
			вмс_ПодключаемыеКомандыКлиентСервер.ДобавитьОписаниеКоманды(Форма, ОписаниеКоманды);
		КонецЕсли;
	КонецЦикла; 
	
КонецФункции

Функция ПолучитьСимволКлавиатурнойПанели(КлавиатурнаяПанель, Команда) Экспорт
	
	ДанныеКоманды = КлавиатурнаяПанель.Кнопки[Команда.Имя];
	Если ДанныеКоманды <> Неопределено Тогда
		Возврат ДанныеКоманды.СимволКнопки;
	КонецЕсли; 
	
КонецФункции

Функция КлавиатурнаяПанель_ДобавитьСлушателя(КлавиатурнаяПанель, Имя, ОповещениеВвода, ОповещениеОжидания=Неопределено) Экспорт
	
	Слушатель = вмс_РаботаСКоллекциями.НайтиСтрокуКвазиТаблицыЗначений(КлавиатурнаяПанель.Слушатели, "Имя", Имя);
	Если Слушатель = Неопределено Тогда
		Слушатель = вмс_РаботаСКоллекциями.ДобавитьСтрокуКвазиТаблицыЗначений(КлавиатурнаяПанель.Слушатели);
		Слушатель.Имя = Имя;
	КонецЕсли;
	
	Слушатель.ОповещениеВвода = ОповещениеВвода;
	Слушатель.ОповещениеОжидания = ОповещениеОжидания;
	
	Возврат Слушатель;
	
КонецФункции

Функция КлавиатурнаяПанель_УдалитьСлушателя(КлавиатурнаяПанель, Имя) Экспорт
	
	Слушатель = вмс_РаботаСКоллекциями.НайтиСтрокуКвазиТаблицыЗначений(КлавиатурнаяПанель.Слушатели, "Имя", Имя);
	Если Слушатель <> Неопределено Тогда
		вмс_РаботаСКоллекциями.УдалитьСтрокиКвазиТаблицыЗначений(КлавиатурнаяПанель.Слушатели, Слушатель);
	КонецЕсли;
	
КонецФункции

Функция КлавиатурнаяПанель_ОбработатьКоманду(ПараметрФормы, Контекст) Экспорт
	
	ИмяКоманды = Контекст.ОписаниеКоманды.ИмяВФорме;
	КлавиатурнаяПанель = Контекст.ОписаниеКоманды.ДополнительныеПараметры.КлавиатурнаяПанель;
	Если КлавиатурнаяПанель.Скрывать Тогда
		ПанельКлавиатуры = КлавиатурнаяПанель.Форма.Элементы.Найти(КлавиатурнаяПанель.ИмяПанели);
		ПанельКлавиатуры.ТекущаяСтраница = ПанельКлавиатуры.ПодчиненныеЭлементы[0]; //переключить на пустую страницу
		
		Если ТипЗнч(ПанельКлавиатуры.Родитель) = Тип("ГруппаФормы") И ПанельКлавиатуры.Родитель.Вид = ВидГруппыФормы.Страница Тогда
			СтраницаПанели = ПанельКлавиатуры.Родитель;
			ПанельРодитель = СтраницаПанели.Родитель;
			Если ПанельРодитель.ТекущаяСтраница = СтраницаПанели Тогда
				// перелистнуть страницу в родительской панели
				ИндексСтраницы = ПанельРодитель.ПодчиненныеЭлементы.Индекс(СтраницаПанели);
				Если ИндексСтраницы > 0 Тогда
					ПанельРодитель.ТекущаяСтраница = ПанельРодитель.ПодчиненныеЭлементы[ИндексСтраницы-1];
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеКнопки = КлавиатурнаяПанель.Кнопки[ИмяКоманды];
	Если ДанныеКнопки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	БуфферВвода = ДанныеКнопки.СимволКнопки;
	
	КлавиатурнаяПанель_ОповеститьСлушателей(КлавиатурнаяПанель, БуфферВвода);
	
	Возврат Истина;
	
КонецФункции

Функция КлавиатурнаяПанель_ОповеститьСлушателей(КлавиатурнаяПанель, БуфферВвода) Экспорт
	
	Для Каждого Слушатель Из КлавиатурнаяПанель.Слушатели.Строки Цикл
		
		Если БуфферВвода <> Неопределено И БуфферВвода <> "" Тогда
			БуфферВводаМассив = вмс_РаботаСКоллекциями.СтрокуВМассивПосимвольно(БуфферВвода);
			БуфферВвода = "";
			Для Каждого СимволКнопки Из БуфферВводаМассив Цикл
				ВыполнитьОбработкуОповещения(Слушатель.ОповещениеВвода, СимволКнопки);
				БуфферВвода = БуфферВвода + СимволКнопки;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция КлавиатурнаяПанель_Поломать(КлавиатурнаяПанель) Экспорт
	
	Форма = КлавиатурнаяПанель.Форма;
	Если Форма = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаКоманд = вмс_ПодключаемыеКомандыКлиент.ПолучитьТаблицуОписанияКомандФормы(Форма);
	Если ТаблицаКоманд <> Неопределено Тогда
		Для Каждого ЭлементДанныеКнопки Из КлавиатурнаяПанель.Кнопки Цикл
			ДанныеКнопки = ЭлементДанныеКнопки.Значение;
			ИмяКоманды = ДанныеКнопки.ИмяКоманды;
			СтрокаКоманды = вмс_РаботаСКоллекциями.НайтиСтрокуКвазиТаблицыЗначений(ТаблицаКоманд, "ИмяВФорме", ИмяКоманды);
			Если СтрокаКоманды <> Неопределено Тогда
				вмс_РаботаСКоллекциями.УдалитьСтрокиКвазиТаблицыЗначений(ТаблицаКоманд, СтрокаКоманды);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПрограммныйКод =
	"КлавиатурнаяПанель = ДополнительныеПараметры;
	|вмс_РаботаСФормамиСервер.КлавиатурнаяПанель_Поломать(Форма, КлавиатурнаяПанель);";
	
	КлавиатурнаяПанельСервер = КлавиатурнаяПанель_ПолучитьСтруктуруДляПередачиНаСервер(КлавиатурнаяПанель);
	Форма.СлужебнаяФункцияВызовСервера(ПрограммныйКод, КлавиатурнаяПанельСервер);
	
	КлавиатурнаяПанель.Кнопки.Очистить();
	КлавиатурнаяПанель.СимволыКнопок.Очистить();
	
	Возврат Истина;
	
КонецФункции

