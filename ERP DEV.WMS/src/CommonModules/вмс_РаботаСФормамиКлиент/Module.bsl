КонецФункции

Функция ПолучитьОписаниеЭлементовФормы(Форма) Экспорт
	
	ОписаниеСписок = Новый Соответствие;
	
	Для Каждого Элемент Из Форма.Элементы Цикл
		
		ОписаниеЭлемента = ОписаниеСписок[Элемент.Имя];
		Если ОписаниеЭлемента = Неопределено Тогда
			ОписаниеЭлемента = вмс_РаботаСФормамиКлиентСервер.ПолучитьПоляЭлементаФормы(Элемент);
			ОписаниеСписок[ОписаниеЭлемента.Имя] = ОписаниеЭлемента;
		КонецЕсли; 
		
		Если ОписаниеЭлемента.ТипЭлемента = Тип("ГруппаФормы") Тогда
			ПодчиненныеЭлементыОписание = Новый Массив;
			Для Каждого ПодчиненныйЭлемент Из Элемент.ПодчиненныеЭлементы Цикл
				ОписаниеПодчиненногоЭлемента = ОписаниеСписок[ПодчиненныйЭлемент.Имя];
				Если ОписаниеПодчиненногоЭлемента = Неопределено Тогда
					ОписаниеПодчиненногоЭлемента = вмс_РаботаСФормамиКлиентСервер.ПолучитьПоляЭлементаФормы(ПодчиненныйЭлемент);
					ОписаниеСписок[ОписаниеПодчиненногоЭлемента.Имя] = ОписаниеПодчиненногоЭлемента;
				КонецЕсли;
				ПодчиненныеЭлементыОписание.Добавить(ОписаниеПодчиненногоЭлемента);
			КонецЦикла;
			ОписаниеЭлемента.Вставить("ПодчиненныеЭлементы", ПодчиненныеЭлементыОписание);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОписаниеСписок;
	
КонецФункции

Функция ЗаполнитьПодменюСканирование(Форма) Экспорт
	
	ИмяПодменюСканирование = "ПодменюСканирование";
	ПодменюСканирование = Форма.Элементы.Найти(ИмяПодменюСканирование);
	Если ПодменюСканирование = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ФормаШаблонов = ПолучитьФорму("Обработка.вмс_МодульИнтеграции.Форма.ФормаШаблонов");
	ОписаниеЭлементовФормы = ПолучитьОписаниеЭлементовФормы(ФормаШаблонов);
	
	ДанныеДляЗаполненияПодменюСканирование = Новый Структура;
	ДанныеДляЗаполненияПодменюСканирование.Вставить("ИмяПодменюСканирование", ИмяПодменюСканирование);
	ДанныеДляЗаполненияПодменюСканирование.Вставить("ОписаниеЭлементовФормы", ОписаниеЭлементовФормы);
	
	Возврат ДанныеДляЗаполненияПодменюСканирование;
	
КонецФункции

Функция ПриОткрытии(Форма, Отказ) Экспорт
	ДанныеПриОткрытииНаСервере = Новый Структура;
	ДанныеПриОткрытииНаСервере.Вставить("ДанныеДляЗаполненияПодменюСканирование", ЗаполнитьПодменюСканирование(Форма));
	Возврат ДанныеПриОткрытииНаСервере;
КонецФункции

