Функция ОткрытьФормуУлучшенная(ИмяФормы, Параметры=Неопределено, Владелец=Неопределено, Уникальность=Неопределено, Окно=Неопределено, НавигационнаяСсылка=Неопределено, ОписаниеОповещенияОЗакрытии=Неопределено, РежимОткрытияОкна=Неопределено) Экспорт
	
	Форма = ПолучитьФормуУлучшенная(ИмяФормы, Параметры, Владелец, Уникальность, Окно, НавигационнаяСсылка, ОписаниеОповещенияОЗакрытии, РежимОткрытияОкна);	
	Форма.Открыть();
	Возврат Форма;
	
КонецФункции

Функция ПолучитьФормуУлучшенная(ИмяФормы, Параметры=Неопределено, Владелец=Неопределено, Уникальность=Неопределено, Окно=Неопределено, НавигационнаяСсылка=Неопределено, ОписаниеОповещенияОЗакрытии=Неопределено, РежимОткрытияОкна=Неопределено) Экспорт

	Форма = ПолучитьФорму(ИмяФормы, , Владелец, Уникальность, Окно);
	Форма.ОписаниеОповещенияОЗакрытии = ОписаниеОповещенияОЗакрытии;
	Форма.НавигационнаяСсылка = НавигационнаяСсылка;
	Если РежимОткрытияОкна <> Неопределено Тогда
		Форма.РежимОткрытияОкна = РежимОткрытияОкна;
	КонецЕсли;
	УстановитьПараметрыФормыНаКлиенте(Форма, Параметры);
	Возврат Форма;
	
КонецФункции

Функция УстановитьПараметрФормыНаКлиенте(Форма, ИмяПараметра, ЗначениеПараметра) Экспорт
	
	Возврат УстановитьПараметрыФормыНаКлиенте(Форма, Новый Структура(ИмяПараметра, ЗначениеПараметра));
	
КонецФункции

Функция УстановитьПараметрыФормыНаКлиенте(Форма, ПараметрыДляУстановки) Экспорт
	
	Если ТипЗнч(ПараметрыДляУстановки) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыФормы = ПолучитьПараметрыФормыНаКлиенте(Форма);
	
	Для Каждого ПараметрДляУстановки Из ПараметрыДляУстановки Цикл
		ПараметрыФормы.Вставить(ПараметрДляУстановки.Ключ, ПараметрДляУстановки.Значение);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьПараметрФормыНаКлиенте(Форма, ИмяПараметра) Экспорт
	
	Перем ЗначениеПараметра;
	
	ПолучитьПараметрыФормыНаКлиенте(Форма).Свойство(ИмяПараметра, ЗначениеПараметра);
	
	Возврат ЗначениеПараметра;
	
КонецФункции

Функция ПолучитьПараметрыФормыНаКлиенте(Форма) Экспорт
	
	ПеременныеФормы = ПолучитьКлиентскиеПеременные(Форма);
	ПараметрыФормы = ПеременныеФормы["ПараметрыФормы"];
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
		ПеременныеФормы["ПараметрыФормы"] = ПараметрыФормы;
	КонецЕсли;
	
	Возврат ПараметрыФормы;
	
КонецФункции

Функция ОткрытьФормуИзМакета(Макет, Параметры=Неопределено, ВладелецФормы=Неопределено, Уникальность=Неопределено, Окно=Неопределено, НавигационнаяСсылка=Неопределено, ОписаниеОповещенияОЗакрытии=Неопределено) Экспорт
	
	Форма = ПолучитьФормуИзМакета(Макет, Параметры, ВладелецФормы, Уникальность, Окно, НавигационнаяСсылка, ОписаниеОповещенияОЗакрытии);
	Форма.Открыть();
	
	Возврат Форма;
	
КонецФункции

Функция ПолучитьФормуИзМакета(Макет, Параметры=Неопределено, ВладелецФормы=Неопределено, Уникальность=Неопределено, Окно=Неопределено, НавигационнаяСсылка=Неопределено, ОписаниеОповещенияОЗакрытии=Неопределено) Экспорт
	
	ДанныеМакета = ПолучитьДанныеМакета(Макет);
	
	вмс_ВыполнениеПрограммногоКода.ПроцессорКода_ДобавитьПрограммныйМодуль(ДанныеМакета.МодульКлассаФормы);
	
	ИмяКласса = ДанныеМакета.ИмяКлассаФормы;
	КлассноеРасширение = вмс_КлассныеОбъекты.НовыйОбъект(ВРЕГ(ИмяКласса));
	
	Форма = ПолучитьФормуУлучшенная("ОбщаяФорма.вмс_ФормаШаблон", Параметры, ВладелецФормы, Уникальность, Окно, НавигационнаяСсылка, ОписаниеОповещенияОЗакрытии);
	Форма.Переменные.КлассноеРасширение = КлассноеРасширение;
	КлассноеРасширение.НативныйОбъект = Форма;
	Форма.ЗагрузитьИзОписанияФормы(ДанныеМакета.Данные);
	
	Возврат Форма;
	
КонецФункции

Функция ПолучитьДанныеМакета(Макет) Экспорт
	
	Если ТипЗнч(Макет)=Тип("Структура") Тогда
		
		ДанныеМакета = Макет;
		
	Иначе
		
		ДанныеМакета = вмс_РаботаСФормамиВызовСервера.ПолучитьДанныеМакета(Макет);
		
	КонецЕсли;
	
	Возврат ДанныеМакета;
	
КонецФункции

Функция ОткрытьДиалогВыбораКартинки(ОписаниеОповещенияОЗакрытии=Неопределено, ВладелецФормы=Неопределено, ТекущаяКартинка=Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущаяКартинка", ТекущаяКартинка);
	
	ДиалогВыбораКартинки = ОткрытьФормуУлучшенная("ОбщаяФорма.ФормаВыбораКартинки", ПараметрыФормы, ВладелецФормы, , , , ОписаниеОповещенияОЗакрытии);
	
	Возврат ДиалогВыбораКартинки;
	
КонецФункции

#Область АвтоОбновлениеДокумента

Функция АвтоОбновлениеДокумента_ПослеЗаписи(Форма, ПараметрыЗаписи)
	
	АвтоОбновлениеДокумента = АвтоОбновлениеДокумента(Форма);
	Если НЕ АвтоОбновлениеДокумента.Включено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	АвтоОбновлениеДокумента.Ссылка = Форма.Объект.Ссылка;
	АвтоОбновлениеДокумента.ВерсияДанных = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(АвтообновлениеДокумента.Ссылка);
	
КонецФункции

Функция ВключитьАвтоОбновлениеДокумента(Форма, знач ОбработчикОбновленияДокумента=Неопределено) Экспорт
	
	АвтообновлениеДокумента = АвтообновлениеДокумента(Форма);
	АвтообновлениеДокумента.Включено = Истина;
	АвтообновлениеДокумента.Ссылка = Форма.Объект.Ссылка;
	АвтоОбновлениеДокумента.ВерсияДанных = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(АвтообновлениеДокумента.Ссылка);
	
	Если ТипЗнч(ОбработчикОбновленияДокумента)=Тип("Строка") Тогда
		ОбработчикОбновленияДокумента = Новый ОписаниеОповещения(ОбработчикОбновленияДокумента, Форма);
	КонецЕсли;
	АвтоОбновлениеДокумента.ОбработчикОбновленияДокумента = ОбработчикОбновленияДокумента;
	
	ОО = Новый ОписаниеОповещения("ОбработчикОжиданияОбновлениеДокумента", вмс_РаботаСФормамиКлиент);
	вмс_МодульПриложения.ДобавитьОбработчикОжидания(ОО, 1, Ложь, Форма, "АвтоОбновлениеДокумента");
	
КонецФункции

Функция ОбработчикОжиданияОбновлениеДокумента(ОбработчикОжидания, ДополнительныеПараметры) Экспорт
	
	Форма = ОбработчикОжидания.Форма;
	АвтообновлениеДокумента = АвтообновлениеДокумента(Форма);
	
	Если АвтообновлениеДокумента.ЗавершениеРаботы Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если АвтообновлениеДокумента.ДокументУдален Тогда
		// выдать сообщение когда пользователь посмотрит на окно и завершить работу
		Если Форма.ВводДоступен() Тогда
			СообщитьОбУдаленииДокумента(Форма);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если АвтоОбновлениеДокумента.ВерсияДанных <> "" Тогда
		ТекущаяВерсияДанных = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(АвтообновлениеДокумента.Ссылка);
		
		Если ТекущаяВерсияДанных <> АвтообновлениеДокумента.ВерсияДанных Тогда
			АвтообновлениеДокумента.ВерсияДанных = ТекущаяВерсияДанных;
			Если АвтообновлениеДокумента.ВерсияДанных="" Тогда
				АвтообновлениеДокумента.ДокументУдален = Истина;
				Если Форма.ВводДоступен() Тогда
					СообщитьОбУдаленииДокумента(Форма);
				КонецЕсли;
				Форма.ТолькоПросмотр = Истина;
			Иначе
				Форма.Прочитать();
			КонецЕсли;
		ИначеЕсли АвтообновлениеДокумента.ОбработчикОбновленияДокумента <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(АвтообновлениеДокумента.ОбработчикОбновленияДокумента, ОбработчикОжидания);
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция СообщитьОбУдаленииДокумента(Форма)
	АвтообновлениеДокумента = АвтообновлениеДокумента(Форма);
	АвтообновлениеДокумента.ЗавершениеРаботы = Истина;
	ПоказатьПредупреждение(Новый ОписаниеОповещения("ОбработчикЗакрытьФорму", вмс_РаботаСФормамиКлиент, Форма), "Документ был удален");
КонецФункции

Функция ОбработчикЗакрытьФорму(Форма) Экспорт
	АвтообновлениеДокумента = АвтообновлениеДокумента(Форма);
	ОповеститьОбИзменении(АвтообновлениеДокумента.Ссылка);
	Форма.Закрыть();
КонецФункции

Функция АвтообновлениеДокументаВключено(Форма)
	
	Возврат АвтообновлениеДокумента(Форма).Включено;
	
КонецФункции
	
Функция АвтообновлениеДокумента(Форма)

	Переменные = ПолучитьКлиентскиеПеременные(Форма);
	
	АвтообновлениеДокумента = Переменные["АвтообновлениеДокумента"];
	Если АвтообновлениеДокумента=Неопределено Тогда
		АвтообновлениеДокумента = Новый Структура;
		АвтообновлениеДокумента.Вставить("Включено", Ложь);
		АвтообновлениеДокумента.Вставить("Ссылка", Неопределено);
		АвтообновлениеДокумента.Вставить("ВерсияДанных", "");
		АвтообновлениеДокумента.Вставить("ДокументУдален", Ложь);
		АвтообновлениеДокумента.Вставить("ЗавершениеРаботы", Ложь);
		АвтообновлениеДокумента.Вставить("ОбработчикОбновленияДокумента");
		Переменные["АвтообновлениеДокумента"] = АвтообновлениеДокумента;
	КонецЕсли;
	
	Возврат АвтообновлениеДокумента;
	
КонецФункции

#КонецОбласти