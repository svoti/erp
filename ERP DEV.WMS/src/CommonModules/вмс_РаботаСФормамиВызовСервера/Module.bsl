Функция ПолучитьДанныеМакета(Макет) Экспорт
	
	ДанныеМакета = Новый Структура;
	ДанныеМакета.Вставить("Наименование", Макет.Наименование);
	ДанныеМакета.Вставить("Данные", Макет.Данные);
	ДанныеМакета.Вставить("МодульКлассаФормы", Макет.МодульКлассаФормы);
	ДанныеМакета.Вставить("ИмяКлассаФормы", Макет.МодульКлассаФормы.Наименование);
	
	Возврат ДанныеМакета;
	
КонецФункции
