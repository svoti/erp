#Область ПрограммныйИнтерфейс

Функция ВыполнитьПодпиткуНаЯчейках(ПараметрыПодпитки = Неопределено) Экспорт

	Если ПараметрыПодпитки = Неопределено Тогда
		ПараметрыПодпитки = ИнициализироватьПараметрыПодпитки();
	КонецЕсли;
	
	ПравилоЗаполненияЗадачиКладовщику = Справочники.вмс_ПравилаЗаполненияЗадачиКладовщику.ПолучитьЭлементСправочникаОперацииПоИмени("Подпитка");  	
	Если НЕ ЗначениеЗаполнено(ПравилоЗаполненияЗадачиКладовщику) Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Результат = ПолучитьДефицитТовараНаЗонахБыстрогоДоступа(ПараметрыПодпитки, ПравилоЗаполненияЗадачиКладовщику);   
	
	ТаблицаДефицитаОбщая = Результат.ТаблицаДефицитаОбщая;  
	ТаблицаДефицитаПоЗонам = Результат.ТаблицаДефицитаПоЗонам; 
	МассивЗонДоступа = Результат.МассивЗонДоступа;
	 
	РК = вмс_РаботаСКоллекциями;
	Если ТаблицаДефицитаОбщая.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;         
	
	ПравилоПодпитки = ПодготовитьПараметрыПодпитки(ПравилоЗаполненияЗадачиКладовщику);
	МассивСтрокОтбора = Новый Массив; 
	ТаблицаЯчеекЗонДоступа = ПолучитьТаблицуЯчеекЗоныДоступа(МассивЗонДоступа);     
	ОперацияПодпитка  = Справочники.вмс_Операции.ПолучитьЭлементСправочникаОперацииПоИмени("Подпитка");
	
	Если ПравилоПодпитки.ПодбиратьЯчейкиПоСкладам Тогда
		МассивСтрокОтбора.Добавить("Склад"); 
	КонецЕсли;          
	
	Если ПравилоПодпитки.ОтбиратьПоПомещениям Тогда
		МассивСтрокОтбора.Добавить("Помещение"); 
	КонецЕсли;           
	
	Если МассивСтрокОтбора.Количество() > 0 Тогда    
		ПравилаСтрокой = РК.МассивВСтроку(МассивСтрокОтбора);
		
		ТаблицаОтборовПоПравилу = ТаблицаДефицитаОбщая.Скопировать();
		ТаблицаОтборовПоПравилу.Свернуть(ПравилаСтрокой);    
		
		Для Каждого СтрокаПравила Из ТаблицаОтборовПоПравилу Цикл    
			Отбор = Новый Структура(ПравилаСтрокой); 
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаПравила); 
			
			НайденныеСтрокиОбщие = ТаблицаДефицитаОбщая.НайтиСтроки(Отбор);    
			
			Если НайденныеСтрокиОбщие.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;        
			
			Если ПараметрыПодпитки.ПроверятьЗавершениеПоследнейПодпитки Тогда 
				Если НЕ ПоследняяПодпиткаЗавершена(ОперацияПодпитка,Отбор) Тогда			
					Продолжить;
				КонецЕсли;		
			КонецЕсли;             
					
			НайденныеСтрокиПоЗонам = ТаблицаДефицитаПоЗонам.НайтиСтроки(Отбор);  
			НайденныеЯчейкиЗонДоступа = ТаблицаЯчеекЗонДоступа.НайтиСтроки(Отбор);
			
			НачатьФормированиеЗаданийНаПодпитку(ПравилоПодпитки, НайденныеСтрокиОбщие,НайденныеСтрокиПоЗонам, НайденныеЯчейкиЗонДоступа, Отбор);			
			
		КонецЦикла;	
	Иначе   
		// В таком случае предполагается что все остатки по вмс ведутся по одному складу и на всех ячейках вмс - один склад
		// по сути ничем не отличается если по вмс один склад и стоит галочка "по складам"
		ДанныеОтбора = Новый Структура("Склад", ТаблицаДефицитаПоЗонам[0].Склад);           
		Если ПараметрыПодпитки.ПроверятьЗавершениеПоследнейПодпитки Тогда 
			Если НЕ ПоследняяПодпиткаЗавершена(ОперацияПодпитка,ДанныеОтбора) Тогда			
				Возврат Ложь;
			КонецЕсли;		
		КонецЕсли; 
		НачатьФормированиеЗаданийНаПодпитку(ПравилоПодпитки, ТаблицаДефицитаОбщая,ТаблицаДефицитаПоЗонам, ТаблицаЯчеекЗонДоступа, ДанныеОтбора);
	КонецЕсли;  
	
КонецФункции

Функция ИнициализироватьПараметрыПодпитки() Экспорт  
	
	Перем ПараметрыЗаполения;
	
	ПараметрыПодпитки = Новый Структура;
	ПараметрыПодпитки.Вставить("ТаблицаТоваров", Неопределено);
	ПараметрыПодпитки.Вставить("МассивЗонДоступа", Неопределено);  
	ПараметрыПодпитки.Вставить("МассивСкладов", Неопределено); 
	ПараметрыПодпитки.Вставить("МассивПомещений", Неопределено);   
	// Данный параметр служит для того, чтобы не создавать новое задание на подпитку, если последнее еще не выполнено
	ПараметрыПодпитки.Вставить("ПроверятьЗавершениеПоследнейПодпитки", Истина);
	
	Возврат ПараметрыПодпитки; 
	
КонецФункции

Функция ПодготовитьПараметрыПодпитки(ПараметрыЗаполнения); 
	
	Правило = Новый Структура;
	
	Для Каждого Реквизит Из Метаданные.Справочники.вмс_ПравилаЗаполненияЗадачиКладовщику.Реквизиты Цикл
		Правило.Вставить(Реквизит.Имя);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Правило, ПараметрыЗаполнения);
	
	Правило.Вставить("ПодбиратьЯчейкиПоСкладам", ПараметрыЗаполнения.Подпитка_ПодбиратьЯчейкиПоСкладам);
	Правило.Вставить("ОтбиратьПоПомещениям", ПараметрыЗаполнения.Подпитка_ПодбиратьЯчейкиПоПомещениям);
	Правило.Вставить("ИспользоватьОСГНаОтбор", ПараметрыЗаполнения.Подпитка_ИспользоватьОСГНаОтбор);    
	Правило.Вставить("ОбъединятьВОдноЗадание", ПараметрыЗаполнения.Подпитка_ОбъединятьВОдноЗадание);
	
	Возврат Правило; 
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс 

Функция ПолучитьДефицитТовараНаЗонахБыстрогоДоступа(ПараметрыПодпитки, ПравилоПодпитки)   
	
	ТаблицаТоваров = ПараметрыПодпитки.ТаблицаТоваров;
	МассивЗонДоступа = ПараметрыПодпитки.МассивЗонДоступа; 
	МассивСкладов = ПараметрыПодпитки.МассивСкладов;  
	МассивПомещений = ПараметрыПодпитки.МассивПомещений;
	
	лТекст = "  
		|	&ТекстЗапросаТаблицыТоваров
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вмс_ЯчейкиПоЗонамБыстрогоДоступа.Ячейка КАК Ячейка,
		|	вмс_ЯчейкиПоЗонамБыстрогоДоступа.ЗонаДоступа КАК ЗонаДоступа
		|ПОМЕСТИТЬ ВТ_ЯчейкиПоЗонамБыстрогоДоступа
		|ИЗ
		|	РегистрСведений.вмс_ЯчейкиПоЗонамБыстрогоДоступа КАК вмс_ЯчейкиПоЗонамБыстрогоДоступа   
		| ГДЕ
		| 	ИСТИНА
		| &УсловиеОтбораЯчеекЗонДоступа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вмс_МинОстаткиПоЗонамБыстрогоДоступа.Товар КАК Товар,
		|	вмс_МинОстаткиПоЗонамБыстрогоДоступа.ЗонаДоступа КАК ЗонаДоступа,
		|	вмс_МинОстаткиПоЗонамБыстрогоДоступа.МинимальныйОстаток КАК МинимальныйОстаток,
		|	вмс_МинОстаткиПоЗонамБыстрогоДоступа.ЗонаДоступа.Склад КАК Склад,
		|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
		|	вмс_МинОстаткиПоЗонамБыстрогоДоступа.Товар.ВесЧислитель КАК ВесЕдиницыТовара,
		|	вмс_МинОстаткиПоЗонамБыстрогоДоступа.Товар.ОбъемЧислитель КАК ОбъемЕдиницыТовара,
		|	вмс_МинОстаткиПоЗонамБыстрогоДоступа.Характеристика КАК Характеристика,
		|	вмс_МинОстаткиПоЗонамБыстрогоДоступа.ЗонаДоступа.Помещение КАК Помещение
		|ПОМЕСТИТЬ ВТ_МинимальныйОстатокПоЗонам
		|ИЗ 
		|	&УсловиеСоединенияТаблицыТоваров
		|   ГДЕ
		| 	ИСТИНА
		| 	&УсловиеОтбораМинОстатковЗонДоступа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вмс_ОперацияПоЯчейкамОстатки.Товар КАК Товар,
		|	СУММА(ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток, 0)) КАК КоличествоОстаток,
		|	ВТ_ЯчейкиПоЗонамБыстрогоДоступа.ЗонаДоступа КАК ЗонаДоступа,
		|	вмс_ОперацияПоЯчейкамОстатки.Ячейка.Владелец КАК Склад,
		|	вмс_ОперацияПоЯчейкамОстатки.Характеристика КАК Характеристика,
		|	вмс_ОперацияПоЯчейкамОстатки.Серия КАК Серия
		|ПОМЕСТИТЬ ВТ_ТекущийОстатокНаЗонах
		|ИЗ
		|	ВТ_ЯчейкиПоЗонамБыстрогоДоступа КАК ВТ_ЯчейкиПоЗонамБыстрогоДоступа
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки КАК вмс_ОперацияПоЯчейкамОстатки
		|		ПО ВТ_ЯчейкиПоЗонамБыстрогоДоступа.Ячейка = вмс_ОперацияПоЯчейкамОстатки.Ячейка
		|ГДЕ
		|	НЕ вмс_ОперацияПоЯчейкамОстатки.Товар ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	вмс_ОперацияПоЯчейкамОстатки.Товар,
		|	ВТ_ЯчейкиПоЗонамБыстрогоДоступа.ЗонаДоступа,
		|	вмс_ОперацияПоЯчейкамОстатки.Ячейка.Владелец,
		|	вмс_ОперацияПоЯчейкамОстатки.Характеристика,
		|	вмс_ОперацияПоЯчейкамОстатки.Серия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВТ_МинимальныйОстатокПоЗонам.МинимальныйОстаток - ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.КоличествоОстаток, 0)) КАК Количество,
		|	ВТ_МинимальныйОстатокПоЗонам.Товар КАК Номенклатура,
		|	ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.Склад, ВТ_МинимальныйОстатокПоЗонам.Склад) КАК Склад,
		|	ВТ_МинимальныйОстатокПоЗонам.Упаковка КАК Упаковка,
		|	МАКСИМУМ(ВТ_МинимальныйОстатокПоЗонам.ВесЕдиницыТовара) КАК ВесЕдиницыТовара,
		|	МАКСИМУМ(ВТ_МинимальныйОстатокПоЗонам.ОбъемЕдиницыТовара) КАК ОбъемЕдиницыТовара,
		|	ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.Серия, ЗНАЧЕНИЕ(Справочник.вмс_СерииНоменклатуры.ПустаяСсылка)) КАК Серия,
		|	ВТ_МинимальныйОстатокПоЗонам.Характеристика КАК Характеристика,
		|	ВТ_МинимальныйОстатокПоЗонам.Помещение КАК Помещение   
		|ПОМЕСТИТЬ ТаблицаДефицитаОбщая
		|ИЗ
		|	ВТ_МинимальныйОстатокПоЗонам КАК ВТ_МинимальныйОстатокПоЗонам
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущийОстатокНаЗонах КАК ВТ_ТекущийОстатокНаЗонах
		|		ПО ВТ_МинимальныйОстатокПоЗонам.Товар = ВТ_ТекущийОстатокНаЗонах.Товар
		|			И ВТ_МинимальныйОстатокПоЗонам.ЗонаДоступа = ВТ_ТекущийОстатокНаЗонах.ЗонаДоступа
		|ГДЕ
		|	ВТ_МинимальныйОстатокПоЗонам.МинимальныйОстаток > ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.КоличествоОстаток, 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_МинимальныйОстатокПоЗонам.Товар,
		|	ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.Склад, ВТ_МинимальныйОстатокПоЗонам.Склад),
		|	ВТ_МинимальныйОстатокПоЗонам.Упаковка,
		|	ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.Серия, ЗНАЧЕНИЕ(Справочник.вмс_СерииНоменклатуры.ПустаяСсылка)),
		|	ВТ_МинимальныйОстатокПоЗонам.Характеристика,
		|	ВТ_МинимальныйОстатокПоЗонам.Помещение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_МинимальныйОстатокПоЗонам.МинимальныйОстаток - ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.КоличествоОстаток, 0) КАК Количество,
		|	ВТ_МинимальныйОстатокПоЗонам.Товар КАК Номенклатура,
		|	ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.Склад, ВТ_МинимальныйОстатокПоЗонам.Склад) КАК Склад,
		|	ВТ_МинимальныйОстатокПоЗонам.Упаковка КАК Упаковка,
		|	ВТ_МинимальныйОстатокПоЗонам.ВесЕдиницыТовара КАК ВесЕдиницыТовара,
		|	ВТ_МинимальныйОстатокПоЗонам.ОбъемЕдиницыТовара КАК ОбъемЕдиницыТовара,
		|	ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.Серия, ЗНАЧЕНИЕ(Справочник.вмс_СерииНоменклатуры.ПустаяСсылка)) КАК Серия,
		|	ВТ_МинимальныйОстатокПоЗонам.Характеристика КАК Характеристика,
		|	ВТ_МинимальныйОстатокПоЗонам.Помещение КАК Помещение,
		|	ВТ_МинимальныйОстатокПоЗонам.ЗонаДоступа КАК ЗонаДоступа 
		|ПОМЕСТИТЬ ТаблицаДефицитаПоЗонам
		|ИЗ
		|	ВТ_МинимальныйОстатокПоЗонам КАК ВТ_МинимальныйОстатокПоЗонам
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущийОстатокНаЗонах КАК ВТ_ТекущийОстатокНаЗонах
		|		ПО ВТ_МинимальныйОстатокПоЗонам.Товар = ВТ_ТекущийОстатокНаЗонах.Товар
		|			И ВТ_МинимальныйОстатокПоЗонам.ЗонаДоступа = ВТ_ТекущийОстатокНаЗонах.ЗонаДоступа
		|ГДЕ
		|	ВТ_МинимальныйОстатокПоЗонам.МинимальныйОстаток > ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.КоличествоОстаток, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_МинимальныйОстатокПоЗонам.ЗонаДоступа КАК ЗонаДоступа  
		|ПОМЕСТИТЬ ТаблицаЗон
		|ИЗ
		|	ВТ_МинимальныйОстатокПоЗонам КАК ВТ_МинимальныйОстатокПоЗонам
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущийОстатокНаЗонах КАК ВТ_ТекущийОстатокНаЗонах
		|		ПО ВТ_МинимальныйОстатокПоЗонам.Товар = ВТ_ТекущийОстатокНаЗонах.Товар
		|			И ВТ_МинимальныйОстатокПоЗонам.ЗонаДоступа = ВТ_ТекущийОстатокНаЗонах.ЗонаДоступа
		|ГДЕ
		|	ВТ_МинимальныйОстатокПоЗонам.МинимальныйОстаток > ЕСТЬNULL(ВТ_ТекущийОстатокНаЗонах.КоличествоОстаток, 0)
		|";

	лЗапрос = Новый Запрос(лТекст);
	лЗапрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Если ТаблицаТоваров <> Неопределено Тогда
		лЗапрос.Текст = СтрЗаменить(лЗапрос.Текст, "&ТекстЗапросаТаблицыТоваров", "ВЫБРАТЬ
		|	ТаблицаТоваров.Товар КАК Товар,
		|	ТаблицаТоваров.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ ВТ_ТаблицаТоваров
		|ИЗ
		|	&ТаблицаТоваров КАК ТаблицаТоваров
		|;");
		
		лЗапрос.Текст = СтрЗаменить(лЗапрос.Текст, "&УсловиеСоединенияТаблицыТоваров", "ВТ_ТаблицаТоваров КАК ВТ_ТаблицаТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.вмс_МинОстаткиПоЗонамБыстрогоДоступа КАК вмс_МинОстаткиПоЗонамБыстрогоДоступа
		|		ПО (ВТ_ТаблицаТоваров.Товар = вмс_МинОстаткиПоЗонамБыстрогоДоступа.Товар
		|				И ВТ_ТаблицаТоваров.Характеристика = вмс_МинОстаткиПоЗонамБыстрогоДоступа.Характеристика)");
		
		лЗапрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	Иначе    
		лЗапрос.Текст = СтрЗаменить(лЗапрос.Текст, "&ТекстЗапросаТаблицыТоваров", "");
		лЗапрос.Текст = СтрЗаменить(лЗапрос.Текст, "&УсловиеСоединенияТаблицыТоваров", "РегистрСведений.вмс_МинОстаткиПоЗонамБыстрогоДоступа КАК вмс_МинОстаткиПоЗонамБыстрогоДоступа")
	КонецЕсли;      
	УсловиеОтбораЯчеекЗонДоступа = "";  
	УсловиеОтбораМинОстатковЗонДоступа = "";  
	Если МассивЗонДоступа <> Неопределено Тогда   
