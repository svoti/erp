Функция НачатьФормированиеЗаданийНаПодпитку(ПравилоПодпитки, ПланПодпитки,ПланПодпиткиПоЗонам, ТаблицаЯчеекНаРазмещение, ДетальныеДанныеПодпитки)    
	
	РК = вмс_РаботаСКоллекциями;
	МассивЗонДоступа = РК.ВыгрузитьЗначенияКолонкиКоллекции(ПланПодпиткиПоЗонам, "ЗонаДоступа");
	РК.УдалитьДублиВМассиве(МассивЗонДоступа);   
	//ОперацияОтбор = Справочники.вмс_Операции.ПолучитьЭлементСправочникаОперацииПоИмени("Отбор");   
	//ОперацияРазмещение = Справочники.вмс_Операции.ПолучитьЭлементСправочникаОперацииПоИмени("Размещение");
	ОперацияПодпитка  = Справочники.вмс_Операции.ПолучитьЭлементСправочникаОперацииПоИмени("Подпитка");
	
	ТаблицаТоваровНаОтбор = ПодготовитьТаблицуТовараНаОтбор(ПравилоПодпитки, ПланПодпитки,ПланПодпиткиПоЗонам, ДетальныеДанныеПодпитки);  
	Если ТаблицаТоваровНаОтбор.Количество() = 0 Тогда 
		// Нет остатков чтобы отобрать товар
		Возврат Ложь;	
	КонецЕсли;	
	
	Если НЕ ПравилоПодпитки.ОбъединятьВОдноЗадание Тогда      
		ДанныеЗаданиеКладовщику = ИнициализироватьДанныеЗаданияКладовщикаПодпитки();
		ДанныеЗаданиеКладовщику.ТаблицаТоваров = ТаблицаТоваровНаОтбор;  
		ДанныеЗаданиеКладовщику.ПравилоПодпитки = ПравилоПодпитки;
		ДанныеЗаданиеКладовщику.Операция = ОперацияПодпитка;
		ДанныеЗаданиеКладовщику.ДетальныеДанныеПодпитки = ДетальныеДанныеПодпитки;
		ДанныеЗаданиеКладовщику.МассивЗонДоступа = МассивЗонДоступа;     
		
		СформироватьЗаданиеНаПодпитку(ДанныеЗаданиеКладовщику);
		
		ТаблицаТоваровНаРазмещение = ПодготовитьТаблицуТовараНаРазмещение(ТаблицаТоваровНаОтбор, ПравилоПодпитки, ПланПодпиткиПоЗонам,ТаблицаЯчеекНаРазмещение, ДетальныеДанныеПодпитки);      
		
		ДанныеЗаданиеКладовщику = ИнициализироватьДанныеЗаданияКладовщикаПодпитки();
		ДанныеЗаданиеКладовщику.ТаблицаТоваров = ТаблицаТоваровНаРазмещение;  
		ДанныеЗаданиеКладовщику.ПравилоПодпитки = ПравилоПодпитки;
		ДанныеЗаданиеКладовщику.Операция = ОперацияПодпитка;
		ДанныеЗаданиеКладовщику.ДетальныеДанныеПодпитки = ДетальныеДанныеПодпитки;
		ДанныеЗаданиеКладовщику.МассивЗонДоступа = МассивЗонДоступа; 
		
		СформироватьЗаданиеНаПодпитку(ДанныеЗаданиеКладовщику);	
	Иначе    
		ТаблицаТоваровНаРазмещение = ПодготовитьТаблицуТовараНаРазмещение(ТаблицаТоваровНаОтбор, ПравилоПодпитки, ПланПодпиткиПоЗонам,ТаблицаЯчеекНаРазмещение, ДетальныеДанныеПодпитки);
		ОбщаяТаблицаПодпитки = СоединитьТаблицыТоваровНаОтборИРазмещение(ТаблицаТоваровНаОтбор, ТаблицаТоваровНаРазмещение);  
		
		ДанныеЗаданиеКладовщику = ИнициализироватьДанныеЗаданияКладовщикаПодпитки();
		ДанныеЗаданиеКладовщику.ТаблицаТоваров = ОбщаяТаблицаПодпитки;  
		ДанныеЗаданиеКладовщику.ПравилоПодпитки = ПравилоПодпитки;
		ДанныеЗаданиеКладовщику.Операция = ОперацияПодпитка;
		ДанныеЗаданиеКладовщику.ДетальныеДанныеПодпитки = ДетальныеДанныеПодпитки;
		ДанныеЗаданиеКладовщику.МассивЗонДоступа = МассивЗонДоступа; 
		
		СформироватьЗаданиеНаПодпитку(ДанныеЗаданиеКладовщику);
	КонецЕсли;
	
КонецФункции   

Функция ИнициализироватьДанныеЗаданияКладовщикаПодпитки()  
	
	Перем ДанныеЗаданияКладовщика;
	
	ДанныеЗаданияКладовщика = Новый Структура;
	ДанныеЗаданияКладовщика.Вставить("ТаблицаТоваров", Неопределено);  
	ДанныеЗаданияКладовщика.Вставить("ПравилоПодпитки", Неопределено);  
	ДанныеЗаданияКладовщика.Вставить("ДетальныеДанныеПодпитки", Неопределено); 
	ДанныеЗаданияКладовщика.Вставить("Операция", Неопределено);
	ДанныеЗаданияКладовщика.Вставить("МассивЗонДоступа", Новый Массив);   

    Возврат ДанныеЗаданияКладовщика;           
	
КонецФункции

Функция ПодготовитьТаблицуТовараНаРазмещение(ТаблицаТоваровНаОтбор, ПравилоПодпитки, ПланПодпиткиПоЗонам, СписокЯчеекНаРазмещение, ДетальныеДанныеПодпитки)  
	РК = вмс_РаботаСКоллекциями;
	
	ТаблицаТоваровНаРазмещение = ТаблицаТоваровНаОтбор.Скопировать();
	ТаблицаТоваровНаРазмещение.Колонки.Номенклатура.Имя = "Товар";
	КолонкиТоваровПодпитки = РК.ПолучитьКолонкиКоллекции(ТаблицаТоваровНаРазмещение);
	
	ПараметрыРазмещения = вмс_РазмещениеСервер.ПолучитьПустыеПараметрыДляПолученияЯчейкиПолучателя();
	ПараметрыРазмещения.Вставить("ЭтоПодпитка", Истина);
	
	КолонкиТоваровРазмещение = РК.ПолучитьКолонкиКоллекции(ПараметрыРазмещения.Товары);
	РК.УдалитьЭлементыКоллекции(КолонкиТоваровРазмещение, "Количество");
	
	// ТУ_Алфимов_16.07.2026 ++ 3.2.5
	Если ТаблицаТоваровНаРазмещение.Колонки.Найти("ОбъемТары") = Неопределено Тогда
		ТаблицаТоваровНаРазмещение.Колонки.Добавить("ОбъемТары", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	// ТУ_Алфимов_16.07.2026 -- 3.2.5
	
	ТаблицаТоваровНаРазмещение.Свернуть(РК.МассивВСтроку(КолонкиТоваровРазмещение), "Количество");
	
	МассивЗонДоступа = РК.ВыгрузитьЗначенияКолонкиКоллекции(ПланПодпиткиПоЗонам, "ЗонаДоступа");
	РК.УдалитьДублиВМассиве(МассивЗонДоступа); 
	ОбщаяТаблицаРазмещения = Неопределено;
	
	ТранзитнаяЗона = вмс_СкладыВызовСервера.ПолучитьЗонуСклада(ДетальныеДанныеПодпитки.Склад, Перечисления.вмс_ТипыЯчеек.Транзит);
	
	Если МассивЗонДоступа.Количество() > 1 Тогда
		
		Для Каждого ЗонаДоступа Из МассивЗонДоступа Цикл
			ТаблицаТоваровНаРазмещениеПоЗонам = ТаблицаТоваровНаРазмещение.Скопировать();
			ТаблицаТоваровНаРазмещениеПоЗонам.Очистить();
			
			Отбор = Новый Структура("ЗонаДоступа", ЗонаДоступа);
			ПотребностьЗоны = РК.НайтиЭлементыКоллекции(ПланПодпиткиПоЗонам, Отбор);
			ЯчейкиЗоны = РК.НайтиЭлементыКоллекции(СписокЯчеекНаРазмещение, Отбор);
			МассивДопустимыхЯчеек = РК.ВыгрузитьЗначенияКолонкиКоллекции(ЯчейкиЗоны, "Ячейка");
			ПараметрыРазмещения.Вставить("ДопустимыеЯчейки",МассивДопустимыхЯчеек);
			
			Для Каждого СтрокаПотребностиЗоны Из ПотребностьЗоны Цикл
				ОтборТовара = Новый Структура("Товар, Характеристика, Серия", СтрокаПотребностиЗоны.Номенклатура, СтрокаПотребностиЗоны.Характеристика, СтрокаПотребностиЗоны.Серия);
				НайденнаяСтрока = ТаблицаТоваровНаРазмещение.НайтиСтроки(ОтборТовара);
				Если НЕ ЗначениеЗаполнено(НайденнаяСтрока) Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаОбщегоПланаНаРазмещение = НайденнаяСтрока[0];
				Если СтрокаПотребностиЗоны.Количество > СтрокаОбщегоПланаНаРазмещение.Количество Тогда
					РазмещаемоеКоличество = СтрокаОбщегоПланаНаРазмещение.Количество;
				Иначе
					РазмещаемоеКоличество = СтрокаПотребностиЗоны.Количество;
				КонецЕсли;
				СтрокаОбщегоПланаНаРазмещение.Количество = СтрокаОбщегоПланаНаРазмещение.Количество - РазмещаемоеКоличество;
				
				НоваяСтрока = ТаблицаТоваровНаРазмещениеПоЗонам.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаОбщегоПланаНаРазмещение);
				НоваяСтрока.Количество = РазмещаемоеКоличество;
			КонецЦикла;
			
			ПараметрыРазмещения.Товары = ТаблицаТоваровНаРазмещениеПоЗонам;
			ПараметрыРазмещения.Правило = ПравилоПодпитки;
			ПараметрыРазмещения.Склад = ДетальныеДанныеПодпитки.Склад;
			
			МаршрутРазмещения = вмс_РазмещениеСервер.ПодобратьЯчейкиПолучатели(ПараметрыРазмещения);
			
			КолонкиТаблицыНаРазмещение = РК.ПолучитьКолонкиКоллекции(ТаблицаТоваровНаРазмещениеПоЗонам);
			НедостающиеКолонки = РК.СкопироватьМассив(КолонкиТоваровПодпитки);
			РК.УдалитьЭлементыКоллекции(НедостающиеКолонки, КолонкиТаблицыНаРазмещение);
			
			Для Каждого Колонка Из НедостающиеКолонки Цикл
				ТаблицаТоваровНаРазмещениеПоЗонам.Колонки.Добавить(Колонка);
			КонецЦикла;
			
			ТаблицаТоваровНаРазмещениеПоЗонам.Колонки.Товар.Имя = "Номенклатура";

			ПодготовитьТаблицуТоваровНаРазмещениеДляЗадания(ТаблицаТоваровНаРазмещениеПоЗонам, МаршрутРазмещения);
			Если ОбщаяТаблицаРазмещения = Неопределено Тогда  
				ОбщаяТаблицаРазмещения = ТаблицаТоваровНаРазмещениеПоЗонам.Скопировать();
			Иначе
				РК.ДобавитьЭлементыКоллекции(ОбщаяТаблицаРазмещения, ТаблицаТоваровНаРазмещениеПоЗонам);
			КонецЕсли;
				
			ОтборНулевыхСтрок = Новый Структура("Количество", 0);
			РаспределенныеСтроки = ТаблицаТоваровНаРазмещение.НайтиСтроки(ОтборНулевыхСтрок);
			РК.УдалитьЭлементыКоллекции(ТаблицаТоваровНаРазмещение, РаспределенныеСтроки);
			
		КонецЦикла;
		
		РК.ЗаполнитьЗначенияКоллекции(ОбщаяТаблицаРазмещения, ТранзитнаяЗона, "Ячейка");
		РК.ЗаполнитьЗначенияКоллекции(ОбщаяТаблицаРазмещения, ДетальныеДанныеПодпитки.Склад, "Склад");
		РК.ЗаполнитьЗначенияКоллекции(ОбщаяТаблицаРазмещения, ТранзитнаяЗона, "ЯчейкаТранзит");
			
	Иначе
		ОбщаяТаблицаРазмещения = ТаблицаТоваровНаРазмещение.Скопировать();
		
		ПараметрыРазмещения.Товары = ОбщаяТаблицаРазмещения;
		ПараметрыРазмещения.Правило = ПравилоПодпитки;
		ПараметрыРазмещения.Склад = ДетальныеДанныеПодпитки.Склад;
		МассивДопустимыхЯчеек = РК.ВыгрузитьЗначенияКолонкиКоллекции(СписокЯчеекНаРазмещение, "Ячейка");
		ПараметрыРазмещения.Вставить("ДопустимыеЯчейки", МассивДопустимыхЯчеек);
			
		МаршрутРазмещения = вмс_РазмещениеСервер.ПодобратьЯчейкиПолучатели(ПараметрыРазмещения);
				
		КолонкиТаблицыНаРазмещение = РК.ПолучитьКолонкиКоллекции(ОбщаяТаблицаРазмещения);
		НедостающиеКолонки = РК.СкопироватьМассив(КолонкиТоваровПодпитки);
		РК.УдалитьЭлементыКоллекции(НедостающиеКолонки, КолонкиТаблицыНаРазмещение);
		
		Для Каждого Колонка Из НедостающиеКолонки Цикл
			ОбщаяТаблицаРазмещения.Колонки.Добавить(Колонка);
		КонецЦикла;
		
		ОбщаяТаблицаРазмещения.Колонки.Товар.Имя = "Номенклатура";
		
		ПодготовитьТаблицуТоваровНаРазмещениеДляЗадания(ОбщаяТаблицаРазмещения, МаршрутРазмещения);
		
		РК.ЗаполнитьЗначенияКоллекции(ОбщаяТаблицаРазмещения, ТранзитнаяЗона, "Ячейка");
		РК.ЗаполнитьЗначенияКоллекции(ОбщаяТаблицаРазмещения, ДетальныеДанныеПодпитки.Склад, "Склад");
		РК.ЗаполнитьЗначенияКоллекции(ОбщаяТаблицаРазмещения, ТранзитнаяЗона, "ЯчейкаТранзит");
		
	КонецЕсли;
	
	Возврат ОбщаяТаблицаРазмещения;
	
КонецФункции

Функция ПодготовитьТаблицуТовараНаОтбор(ПравилоПодпитки, ПланПодпитки,ПланПодпиткиПоЗонам, ДетальныеДанныеПодпитки)
	РК = вмс_РаботаСКоллекциями;      
	
	ТаблицаТоваров = ПодготовитьТаблицуТоваровДляПодитки(ПланПодпитки);
	ПараметрыЗаполненияОтбора = ПодготовитьПараметрыОтбораНаПодпитку(ПравилоПодпитки,ТаблицаТоваров, ДетальныеДанныеПодпитки);  
	
	МаршрутОтбора = вмс_ОтборСервер.ПодобратьЯчейкиОтправители(ПараметрыЗаполненияОтбора);  
	
	КолонкиТоваров = РК.ПолучитьКолонкиКоллекции(ТаблицаТоваров); 	
	КолонкиМаршрута = РК.ПолучитьКолонкиКоллекции(МаршрутОтбора); 
	РК.УдалитьЭлементыКоллекции(КолонкиМаршрута, "Товар");
	
	КолонкиТоваровПодпитки = РК.СложениеМассивов(КолонкиМаршрута, КолонкиТоваров);
	РК.УдалитьДублиВМассиве(КолонкиТоваровПодпитки); 	
	ОбязательныеКолонки = ПолучитьМассивОбязательныхКолонокЗаданияКладовщику();	 
	Для Каждого Колонка Из ОбязательныеКолонки Цикл
		КолонкиТоваровПодпитки.Добавить(Колонка);		
	КонецЦикла;
	
	ТаблицаТоваровОтбор = РК.НоваяТаблицаЗначений(КолонкиТоваровПодпитки);
	
	ТаблицаПланОтбора = ТаблицаТоваров.Скопировать();
	ТаблицаПланОтбора.Колонки.Добавить("Обработано", Новый ОписаниеТипов("Булево"));  
	
	Для Каждого СтрокаОтбора Из МаршрутОтбора Цикл   
		
		Отбор = Новый Структура("Номенклатура, Характеристика", СтрокаОтбора.Товар, СтрокаОтбора.Характеристика);
		НайденныеСтроки = ТаблицаПланОтбора.НайтиСтроки(Отбор); 
		
		Для Каждого СтрокаПлана Из НайденныеСтроки Цикл
			Если СтрокаПлана.Количество  <> 0 Тогда 				
				
				НоваяСтрока = ТаблицаТоваровОтбор.Добавить();  
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтбора);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлана);
				НоваяСтрока.ИдентификаторИнструкции = 0;    
				НоваяСтрока.Серия = СтрокаОтбора.Серия;
				Если СтрокаПлана.Количество > СтрокаОтбора.СвободныйОстаток Тогда
					НоваяСтрока.Количество = СтрокаОтбора.СвободныйОстаток;   
					СтрокаПлана.Количество = СтрокаПлана.Количество - НоваяСтрока.Количество; 	
				Иначе   
					НоваяСтрока.Количество = СтрокаПлана.Количество; 
					СтрокаПлана.Количество = 0;
					СтрокаПлана.Обработано = Истина;
				КонецЕсли;	
			Иначе   
				НайденныеСтроки = ТаблицаТоваровОтбор.НайтиСтроки(Отбор);  
				Для Каждого Строка Из НайденныеСтроки Цикл      
					МассивДопЯчеек = РК.СтрокуВМассив(Строка.ДополнительныеЯчейки);
					МассивДопЯчеек.Добавить(СтрокаОтбора.Ячейка);
					Строка.ДополнительныеЯчейки = РК.МассивВСтроку(МассивДопЯчеек);   
				КонецЦикла;			
			КонецЕсли;
		КонецЦикла;		
		
	КонецЦикла;    
	
	ТаблицаТоваровОтбор.Сортировать("ПриоритетЗоны, Приоритет, Ячейка");  
	Операция = Справочники.вмс_Операции.ПолучитьЭлементСправочникаОперацииПоИмени("Отбор");   
	ТранзитнаяЗона = вмс_СкладыВызовСервера.ПолучитьЗонуСклада(ДетальныеДанныеПодпитки.Склад, Перечисления.вмс_ТипыЯчеек.Транзит);
	РК.ЗаполнитьЗначенияКоллекции(ТаблицаТоваровОтбор, ТранзитнаяЗона, "ЯчейкаПриемник"); 
	РК.ЗаполнитьЗначенияКоллекции(ТаблицаТоваровОтбор, ТранзитнаяЗона, "ЯчейкаТранзит"); 
	
	// Товар, которого нет на остатках чтобы подпитать+	
	ОтборНеОбработанного = Новый Структура("Обработано", Ложь);
	ТоварБезОстатка = ТаблицаПланОтбора.НайтиСтроки(ОтборНеОбработанного);
	
	//Для Каждого Строка Из ТоварБезОстатка Цикл
	//	НоваяСтрока = ЗаданиеКладовщику.Товары.Добавить();
	//	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	//	НоваяСтрока.ИдентификаторИнструкции = 0; 
	//КонецЦикла;    
	
	// Товар, которого нет на остатках чтобы подпитать-  
	
	Возврат ТаблицаТоваровОтбор;
	
КонецФункции

Функция СоединитьТаблицыТоваровНаОтборИРазмещение(ТаблицаТоваровНаОтбор, ТаблицаТоваровНаРазмещение);   
	
	РК = вмс_РаботаСКоллекциями;
	КолонкиТаблицы = РК.ПолучитьКолонкиКоллекции(ТаблицаТоваровНаОтбор);
	ОбщаяТаблицаПодпитки = РК.НоваяТаблицаЗначений(РК.МассивВСтроку(КолонкиТаблицы));
	
	ПланОтбораДляОбработки = ТаблицаТоваровНаОтбор.Скопировать();
	ПланОтбораДляОбработки.Колонки.Добавить("Обработано", Новый ОписаниеТипов("Булево"));  
	
	Для Каждого СтрокаРазмещения Из ТаблицаТоваровНаРазмещение Цикл
		ОтборТовара = Новый Структура("Номенклатура, Характеристика, Серия, Обработано", СтрокаРазмещения.Номенклатура, СтрокаРазмещения.Характеристика, СтрокаРазмещения.Серия, Ложь);
		НайденныеСтроки = ПланОтбораДляОбработки.НайтиСтроки(ОтборТовара); 
		КоличествоНаРазмещение = СтрокаРазмещения.Количество;
		Для Каждого СтрокаОтбора Из НайденныеСтроки Цикл 
			Если КоличествоНаРазмещение = 0 Тогда
				Прервать;
			КонецЕсли;
			
			НоваяОбщаяСтрока = ОбщаяТаблицаПодпитки.Добавить();	  
			ЗаполнитьЗначенияСвойств(НоваяОбщаяСтрока, СтрокаРазмещения);
			НоваяОбщаяСтрока.ИдентификаторИнструкции = 0;     
			НоваяОбщаяСтрока.Ячейка = СтрокаОтбора.Ячейка;
			НоваяОбщаяСтрока.ЯчейкаПриемник = СтрокаРазмещения.ЯчейкаПриемник; 		

			Если КоличествоНаРазмещение < СтрокаОтбора.Количество Тогда
				НоваяОбщаяСтрока.Количество = КоличествоНаРазмещение; 
				СтрокаОтбора.Количество = СтрокаОтбора.Количество - КоличествоНаРазмещение;
				КоличествоНаРазмещение = 0;   
			Иначе
				НоваяОбщаяСтрока.Количество = СтрокаОтбора.Количество;   
				КоличествоНаРазмещение = КоличествоНаРазмещение - СтрокаОтбора.Количество;
				СтрокаОтбора.Количество = 0;
				СтрокаОтбора.Обработано = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;  
	
		// проверка себя	
	//ОтборНеОбработанного = Новый Структура("Обработано", Ложь);
	//ТоварБезОстатка = ПланОтбораДляОбработки.НайтиСтроки(ОтборНеОбработанного);

	Возврат ОбщаяТаблицаПодпитки;	
		
КонецФункции

Функция ПолучитьТаблицуЯчеекЗоныДоступа(МассивЗонДоступа)   
	
	лТекст = "
		|ВЫБРАТЬ  
		|	вмс_ЯчейкиПоЗонамБыстрогоДоступа.ЗонаДоступа КАК ЗонаДоступа,
		|	вмс_ЯчейкиПоЗонамБыстрогоДоступа.Ячейка КАК Ячейка,   
		|	вмс_ЯчейкиПоЗонамБыстрогоДоступа.Ячейка.Помещение КАК Помещение,
		|	вмс_ЯчейкиПоЗонамБыстрогоДоступа.Ячейка.Владелец КАК Склад
		|ИЗ
		|	РегистрСведений.вмс_ЯчейкиПоЗонамБыстрогоДоступа КАК вмс_ЯчейкиПоЗонамБыстрогоДоступа
		|ГДЕ
		|	вмс_ЯчейкиПоЗонамБыстрогоДоступа.ЗонаДоступа В (&МассивЗонДоступа)
		|";

	лЗапрос = Новый Запрос(лТекст);

	// Установка параметров.
	лЗапрос.УстановитьПараметр("МассивЗонДоступа", МассивЗонДоступа);

	ТаблицаЯчеек = лЗапрос.Выполнить().Выгрузить();
    //МассивЯчеек = ТаблицаЯчеек.ВыгрузитьКолонку("Ячейка");
	
	Возврат ТаблицаЯчеек;

КонецФункции

Функция ПолучитьМассивОбязательныхКолонокЗаданияКладовщику()  
	ОбязательныеКолонки = Новый Массив;
	
	ОбязательныеКолонки.Добавить("ИдентификаторИнструкции");  
	ОбязательныеКолонки.Добавить("ДополнительныеЯчейки");  
	ОбязательныеКолонки.Добавить("СпособВводаСерии");     
	ОбязательныеКолонки.Добавить("Партия");   
	ОбязательныеКолонки.Добавить("ЯчейкаПриемник");   
	ОбязательныеКолонки.Добавить("ЯчейкаТранзит");
	
	Возврат ОбязательныеКолонки;
	
КонецФункции

Процедура ПодготовитьТаблицуТоваровНаРазмещениеДляЗадания(ТаблицаТоваровНаРазмещение, МаршрутРазмещения) 
	
	Для каждого Строка Из ТаблицаТоваровНаРазмещение Цикл
		
		Отбор = Новый Структура("Товар, Характеристика", Строка.Номенклатура, Строка.Характеристика);
		НайденныеСтроки = МаршрутРазмещения.НайтиСтроки(Отбор);
		ПерваяЯчейка = Истина;
		ДополнительныеЯчейки = Новый Массив;
		
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если ПерваяЯчейка Тогда
				Строка.ЯчейкаПриемник = НайденнаяСтрока.Ячейка;
				ПерваяЯчейка = Ложь;
			Иначе
				ДополнительныеЯчейки.Добавить(НайденнаяСтрока.Ячейка);
			КонецЕсли;
		КонецЦикла;
		
		Строка.ДополнительныеЯчейки = вмс_РаботаСКоллекциями.МассивВСтроку(ДополнительныеЯчейки, ",");
		
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьЗаданиеНаПодпитку(ДанныеЗаданияКладовщика)
	
	РК = вмс_РаботаСКоллекциями;
	
	Задание = Документы.вмс_ЗаданиеКладовщику.СоздатьДокумент();
	Задание.Заполнить(Неопределено);
	Задание.АвтоНастройкаПолей = Истина;
	ЗаполнитьЗначенияСвойств(Задание, ДанныеЗаданияКладовщика.ДетальныеДанныеПодпитки);
	Задание.Дата = ТекущаяДатаСеанса();
	Задание.Операция = ДанныеЗаданияКладовщика.Операция;
	
	// ТУ_Алфимов 16.07.2026 ++ 3.2.5
	//Задание.Правило = ДанныеЗаданияКладовщика.ПравилоПодпитки;
	Задание.Правило = Справочники.вмс_ПравилаЗаполненияЗадачиКладовщику.НайтиПоРеквизиту("Имя", "Подпитка");
	// ТУ_Алфимов 16.07.2026 -- 3.2.5
	
	Задание.Комментарий = "Подпитка: " +  РК.МассивВСтроку(ДанныеЗаданияКладовщика.МассивЗонДоступа);
	Задание.Товары.Загрузить(ДанныеЗаданияКладовщика.ТаблицаТоваров);
	Задание.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Функция ПодготовитьПараметрыОтбораНаПодпитку(ПравилоПодпитки, ТаблицаТоваров, ДанныеОтбора = Неопределено)  
	
	ПараметрыЗаполненияОтбора = вмс_ОтборСервер.НовыйПараметрыЗаполненияОтбора();
	
	ПараметрыЗаполненияОтбора.Товары = ТаблицаТоваров; 
	Если ПравилоПодпитки.ПодбиратьЯчейкиПоСкладам Тогда
		ПараметрыЗаполненияОтбора.Склад = ДанныеОтбора.Склад;
	КонецЕсли;   
	
	Если ПравилоПодпитки.ОтбиратьПоПомещениям Тогда
		ПараметрыЗаполненияОтбора.Помещение = ДанныеОтбора.Помещение;
	КонецЕсли;
	
	ПараметрыЗаполненияОтбора.Правило = ПравилоПодпитки;
	
	ДоступныеТипы  = Новый Массив;
	ДоступныеТипы.Добавить(Перечисления.вмс_ТипыЯчеек.Хранение);
	
	ПараметрыЗаполненияОтбора.ТипыЯчеек = ДоступныеТипы; 
	
	// ТУ_Алфимов 16.07.2026 ++ 3.2.5
	// В момент когда нужен объект Задания кладовщика, его нет, ошибка в вмс_ОтборСервер.ДобавитьТаблицуЗапросаДвиженияЗадания() (костыль)
	Если Не ЗначениеЗаполнено(ПараметрыЗаполненияОтбора.ЗаданиеКладовщику) Тогда
		ЗаданиеОбъект = Документы.вмс_ЗаданиеКладовщику.СоздатьДокумент();
		ПараметрыЗаполненияОтбора.ЗаданиеКладовщику = ЗаданиеОбъект; 
	КонецЕсли;
	// ТУ_Алфимов 16.07.2026 -- 3.2.5
	
	Возврат ПараметрыЗаполненияОтбора;
	
КонецФункции

Функция ПодготовитьТаблицуТоваровДляПодитки(ТаблицаДефицита)

	РК = вмс_РаботаСКоллекциями;
	ТаблицаТоваров = РК.НоваяТаблицаЗначений("Номенклатура, Характеристика, Серия, Упаковка, Количество, ВесЕдиницыТовара, ОбъемЕдиницыТовара, ЗонаДоступа");
	ПустаяХарактеристика = вмс_АдаптацияКонфигураций.ПустаяХарактеристика();
	ПустаяУпаковка = вмс_АдаптацияКонфигураций.ПустаяУпаковка();
	ПустаяСерия = Справочники.вмс_СерииНоменклатуры.ПустаяСсылка();
	
	Для Каждого Строка Из ТаблицаДефицита Цикл
		НоваяСтрока = ТаблицаТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	//	НоваяСтрока.Характеристика = ПустаяХарактеристика;
		НоваяСтрока.Упаковка = ПустаяУпаковка;
	КонецЦикла;
	
	Возврат ТаблицаТоваров;
	
КонецФункции 

Функция ПоследняяПодпиткаЗавершена(ОперацияПодпитка,Отбор)
	
	ПоследнееЗаданиеПодпитки = ПолучитьПоследнееЗаданиеНаПопдиткуПоОтбору(ОперацияПодпитка,Отбор);
	Если ПоследнееЗаданиеПодпитки = Неопределено Тогда
		// Значит это первое задание на подпитку
		Возврат Истина;
	КонецЕсли;
	
	ДанныеОСтатусеПодпитки = РегистрыСведений.вмс_СтатусыДокументов.ПолучитьДанныеОСтатусеДокумента(ПоследнееЗаданиеПодпитки); 
	СтатусЗавершения = вмс_ОперацииПоЯчейкамВызовСервера.ПолучитьСтатусЗавершенияОперации(ОперацияПодпитка); 

	Если ДанныеОСтатусеПодпитки.Статус = СтатусЗавершения Тогда
		Возврат Истина	
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции    


Функция ПолучитьПоследнееЗаданиеНаПопдиткуПоОтбору(ОперацияПодпитка, ПоляОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	вмс_ЗаданиеКладовщику.Ссылка КАК Задание
		|ИЗ
		|	Документ.вмс_ЗаданиеКладовщику КАК вмс_ЗаданиеКладовщику
		|ГДЕ
		|	вмс_ЗаданиеКладовщику.Операция = &Операция
		|	УсловиеОтбора
		|
		|УПОРЯДОЧИТЬ ПО
		|	вмс_ЗаданиеКладовщику.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Операция", ОперацияПодпитка);
	
	УсловиеОтбора = "";  
	Если ПоляОтбора.Свойство("Склад") Тогда   
		УсловиеОтбора = УсловиеОтбора + " И вмс_ЗаданиеКладовщику.Склад = &Склад"; 
		Запрос.УстановитьПараметр("Склад", ПоляОтбора.Склад);
	КонецЕсли; 
	
	Если ПоляОтбора.Свойство("Помещение")Тогда  
		УсловиеОтбора = УсловиеОтбора + " И вмс_ЗаданиеКладовщику.Помещение = &Помещение"; 
		Запрос.УстановитьПараметр("Помещение", ПоляОтбора.Помещение);
	КонецЕсли;  
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "УсловиеОтбора", УсловиеОтбора);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Задание;
	
КонецФункции
	

