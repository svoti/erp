Функция ПолучитьДанныеНачальногоЗаполнения()

	Данные = Новый Структура("", );
	
	// Проверка настройки публикации
	НастройкаПодключения = вмс_Сервер.ПолучитьНастройкуПодключения();
	Если ЗначениеЗаполнено(НастройкаПодключения) Тогда 
		Если ЗначениеЗаполнено(НастройкаПодключения.Значение) Тогда
			Данные.Вставить("АдресПубликации",НастройкаПодключения.Значение);
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не заполнена ключевая настройка ""Адрес публикации""";
			Сообщение.Сообщить();  
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнена ключевая настройка ""Адрес публикации""";
		Сообщение.Сообщить();  
		Возврат Неопределено;
	КонецЕсли;  
	
	Данные = вмс_РаботаСXMLКлиентСервер.СериализироватьВXMLНаСервере(Данные);
	Данные = СтрЗаменить(Данные,Символы.ПС,"");
	
	Данные = "INICIALIZATION" + Данные;
	
	Возврат Данные;
	
