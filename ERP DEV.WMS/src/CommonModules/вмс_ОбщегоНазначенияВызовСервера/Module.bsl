Функция ПолучитьДанныеСеанса() Экспорт
	
	ПараметрыПриложения = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПриложения();
	ДанныеСеансаИБ = ПолучитьДанныеТекущегоСеансаИнформационнойБазы();
	
	ДанныеДляОтладки = ПараметрыПриложения["ДанныеДляОтладки"];
	
	ДанныеСеанса = Новый Структура;
	ДанныеСеанса.Вставить("ДатаИнициализации", ДанныеДляОтладки.ДатаИнициализации);
	ДанныеСеанса.Вставить("Идентификатор", ДанныеДляОтладки.Идентификатор);
	ДанныеСеанса.Вставить("СсылочностьНарушена", ДанныеДляОтладки.Ссылка1 <> ДанныеДляОтладки.Ссылка2);
	ДанныеСеанса.Вставить("ПотерялиКэш", ДанныеДляОтладки.ПотерялиКэш);
	ДанныеСеанса.Вставить("ЧутьНеПотерялиКэш", ДанныеДляОтладки.ЧутьНеПотерялиКэш);
	ДанныеСеанса.Вставить("ПричинаПотериКэша", ДанныеДляОтладки.ПричинаПотериКэша);
	
	Для Каждого ПолеДанныхСеансаИБ Из ДанныеСеансаИБ Цикл
		ДанныеСеанса.Вставить(ПолеДанныхСеансаИБ.Ключ, ПолеДанныхСеансаИБ.Значение);
	КонецЦикла;
	
	Возврат ДанныеСеанса;
	
КонецФункции

Функция ПолучитьДанныеТекущегоСеансаИнформационнойБазы() Экспорт

	ДанныеСеанса = Новый Структура("IPАдресКлиента, ИмяКомпьютера, ИмяПриложения, НачалоСеанса, НомерСеанса, НомерСоединения, ИмяПользователя");
	
	ТекущийСеанс = ПолучитьТекущийСеансИнформационнойБазы();
	ЗаполнитьЗначенияСвойств(ДанныеСеанса, ТекущийСеанс);
	ДанныеСеанса.ИмяПользователя = ТекущийСеанс.Пользователь.Имя;
	
	Возврат ДанныеСеанса;
	
КонецФункции

