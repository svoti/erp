Процедура УстановкаПараметровСеанса(ИменаПараметровСеанса) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	ПрефиксПараметров = "вмс_";
	
	Если ИменаПараметровСеанса = Неопределено Тогда
		ПриНачалеРаботы();
		Возврат;
	КонецЕсли;
	
	ИменаПараметровСеансаМассив = вмс_РаботаСКоллекциями.ЗначениеВМассив(ИменаПараметровСеанса);
	
	Для Каждого ИмяПараметраСеанса Из ИменаПараметровСеансаМассив Цикл
		
		Если ИмяПараметраСеанса = ПрефиксПараметров + "НастройкаТоварныхПолей" Тогда 
			ПараметрыСеанса.вмс_НастройкаТоварныхПолей =
					Новый ХранилищеЗначения(Справочники.вмс_НастройкиПрограммы.ПолучитьЗначениеНастройкиПрограммы("НастройкаТоварныхПолей"));
		КонецЕсли;
				
		Если ИмяПараметраСеанса = "вмс_АдресХранилищаПараметровПриложения" Тогда
			
			ПараметрыСеанса.вмс_АдресХранилищаПараметровПриложения = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
			
		ИначеЕсли ИмяПараметраСеанса = "вмс_АдресХранилищаСостоянийСерверУправляемыхОбработок" Тогда
			
			ПараметрыСеанса.вмс_АдресХранилищаСостоянийСерверУправляемыхОбработок = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
			
		ИначеЕсли ИмяПараметраСеанса = "вмс_НомерКэшированияПараметровПриложения" Тогда
			
			ПараметрыСеанса.вмс_НомерКэшированияПараметровПриложения = 0;
			
		ИначеЕсли ИмяПараметраСеанса = "вмс_ХешСуммаРасширенияКонфигурации" Тогда
			
			ПараметрыСеанса.вмс_ХешСуммаРасширенияКонфигурации = вмс_ОбновлениеИнформационнойБазыWMS.ХешСуммаРасширенияКонфигурации();
			
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры

