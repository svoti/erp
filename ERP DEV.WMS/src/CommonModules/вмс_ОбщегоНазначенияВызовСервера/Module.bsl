	БесконечнаяСтруктура = Новый Структура;
	БесконечнаяСтруктура.Вставить("а", БесконечнаяСтруктура);
	
	ХранилищеЗначения = Новый ХранилищеЗначения(БесконечнаяСтруктура);
	
	Возврат "Груз200";
	
