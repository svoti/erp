Функция СформироватьТабличныйДокументНачальногоЗаполненияТСД() Экспорт  
	
	Данные = ПолучитьДанныеНачальногоЗаполнения();
	
	Если Данные = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет = ПолучитьОбщийМакет("МакетШтрихкода");
	Шаблон = Макет.ПолучитьОбласть("ОбластьШтрихкода"); 
	
	Эталон = ПолучитьОбщийМакет("Эталон");
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;  //0.26454
	
	ПараметрыШтрихкода = Новый Структура;
	ПараметрыШтрихкода.Вставить("Ширина",          Окр(100 / КоличествоМиллиметровВПикселе));
	ПараметрыШтрихкода.Вставить("Высота",          Окр(100 / КоличествоМиллиметровВПикселе));
	ПараметрыШтрихкода.Вставить("Штрихкод",        Данные);
	ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь); 
	ПараметрыШтрихкода.Вставить("Масштабировать", Истина);
	
	ПараметрыШтрихкода.Вставить("ТипКода",16);
	
	// ТУ Алфимов 01.03.2024++
	//Шаблон.Рисунки.Штрихкод.Картинка = МенеджерОборудованияВызовСервера.ПолучитьКартинкуШтрихкода(ПараметрыШтрихкода);
	
	// ТУ_Кулалаев Е.С ++ 31.05.2024 17:59:26 
	// Рефакторинг: Заменил вмс_Печать на вмс_Печать
		
	Шаблон.Рисунки.Штрихкод.Картинка = вмс_Печать.ИзображениеШтрихкода(ПараметрыШтрихкода);
	// ТУ Алфимов 01.03.2024--
	
	Шаблон.Рисунки.Штрихкод.Высота = 100;
	ТабличныйДокумент.Вывести(Шаблон);   
	
	ПредставлениеКода = Макет.ПолучитьОбласть("ПредставлениеКода");
	ПредставлениеКода.Параметры.ПредставлениеКода = "Отсканируйте данный штрихкод на ТСД для заполнения начальных параметров";  
	ТабличныйДокумент.Вывести(ПредставлениеКода);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

