Функция ВерсияДанных(знач Ссылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	
	ТаблицаДанныхИБ = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка)).ПолноеИмя();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаДанныхИБ.ВерсияДанных КАК ВерсияДанных
	|ИЗ
	|	Документ.вмс_ЗаданиеКладовщику КАК ТаблицаДанныхИБ
	|ГДЕ
	|	ТаблицаДанныхИБ.Ссылка = &Ссылка";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.вмс_ЗаданиеКладовщику", ТаблицаДанныхИБ);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ВерсияДанных;
	
КонецФункции

