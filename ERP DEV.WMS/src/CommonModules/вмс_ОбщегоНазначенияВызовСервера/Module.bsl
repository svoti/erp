Функция ВыполнитьПакетнуюПредОбработкуМетода(ОписаниеМетода, ПакетРезультатовСоответствие, Отказ)
	
	Если ОписаниеМетода.ПакетнаяПредОбработка <> Неопределено Тогда
		Выполнить(ОписаниеМетода.ПакетнаяПредОбработка);
	КонецЕсли;
	
КонецФункции 

Функция ВыполнитьОбработчикМетода(ОписаниеМетода)
	
	Если ОписаниеМетода.ПредОбработка <> Неопределено Тогда
		Выполнить(ОписаниеМетода.ПредОбработка + "(ОписаниеМетода)");
	КонецЕсли;
	
	Параметры = ОписаниеМетода.Параметры;
	СтрокаПараметров = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьСтрокуПараметровМетода(Параметры);
	ТекстИсполняемогоКода = ОписаниеМетода.ИмяОбработчика + СтрокаПараметров;
	
	Если ОписаниеМетода.ВозвращаетРезультат Тогда
		Результат = Вычислить(ТекстИсполняемогоКода);
	Иначе
		Выполнить(ТекстИсполняемогоКода);
		Результат = Неопределено;
	КонецЕсли;

	Если ОписаниеМетода.ПостОбработка <> Неопределено Тогда
		ДанныеВыполнения = Новый Структура;
		ДанныеВыполнения.Вставить("Результат", Результат);
		ДанныеВыполнения.Вставить("ОписаниеМетода", ОписаниеМетода);
		Выполнить(ОписаниеМетода.ПостОбработка + "(ДанныеВыполнения)");
		Результат = ДанныеВыполнения.Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СлужебнаяФункцияВызовСервераНаФорме(Форма, ПрограммныйКод, ДополнительныеПараметры=Неопределено) Экспорт
	
	Результат = Неопределено;
	Выполнить(ПрограммныйКод);
	Возврат Результат;
	
