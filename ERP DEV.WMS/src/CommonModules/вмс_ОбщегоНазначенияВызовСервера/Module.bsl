Функция ПолучитьКвазиСсылкуИБ(ИмяТипа, GUID, Представление="") Экспорт
	
	Ссылка = НайтиКвазиСсылкуИБ(ИмяТипа, GUID);
	
	Если Ссылка = Неопределено Тогда
		Ссылка = СоздатьКвазиСсылкуИБ(ИмяТипа, GUID, Представление);
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

Функция ПолучитьОбъектКвазиСсылкиИБ(ИмяТипа, GUID, Представление="") Экспорт
	
	Ссылка = НайтиКвазиСсылкуИБ(ИмяТипа, GUID);
	
	Если Ссылка <> Неопределено Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = СоздатьОбъектКвазиСсылкиИБ(ИмяТипа, GUID, Представление);
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции

Функция НайтиКвазиСсылкуИБ(ИмяТипа, GUID) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяТипа", ИмяТипа);
	Запрос.УстановитьПараметр("GUID", GUID);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КвазиСсылки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КвазиСсылки КАК КвазиСсылки
	|ГДЕ
	|	КвазиСсылки.ИмяТипа = &ИмяТипа
	|	И КвазиСсылки.GUID = &GUID
	|	И НЕ КвазиСсылки.ПометкаУдаления";
	
	Если ТипЗнч(GUID) = Тип("Строка") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КвазиСсылки.GUID", "КвазиСсылки.Имя"); 
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

// Функция - ПолучитьДанныеКвазиСсылокИБ
//
// Параметры:
//  - КвазиСсылкиИБ - Массив - массив квази-ссылок информационной базы
//  - ТипРезультата - Число -	1 - возвращает квазитаблицу значений (КвазиТаблицаЗначений), 
//								2 - возвращает массив структур
// 
// Возвращаемое значение:
//  - КвазиТаблицаЗначений - если ТипРезультата = 1
//  - Массив - массив структур с полями Ссылка, ИмяТипа, GUID, Имя, если ТипРезультата = 2
//
Функция ПолучитьДанныеКвазиСсылокИБ(КвазиСсылкиИБ, ТипРезультата=1) Экспорт
	
	Перем РаботаСКоллекциями, ОбщегоНазначенияСервер;
	
	РаботаСКоллекциями = вмс_РаботаСКоллекциями;
	ОбщегоНазначенияСервер = вмс_ОбщегоНазначенияСервер;
	
	/////////////////////////////////////////////////////////////////////////////////////////
	ТаблицаКвазиСсылокИБ = ОбщегоНазначенияСервер.ПолучитьДанныеКвазиСсылокИБ(КвазиСсылкиИБ);
	
	Если ТипРезультата = 1 Тогда
		Возврат РаботаСКоллекциями.НоваяКвазиТаблицаЗначений(ТаблицаКвазиСсылокИБ);
	КонецЕсли;
	
	Если ТипРезультата = 2 Тогда
		МассивКвазиСсылкиИБ = Новый Массив;
		ПоляДанных = "Ссылка, ИмяТипа, GUID, Имя";
		Для Каждого СтрокаТаблицыКвазиСсылкиИБ Из ТаблицаКвазиСсылокИБ Цикл
			ДанныеКвазиСсылкиИБ = Новый Структура(ПоляДанных);
			ЗаполнитьЗначенияСвойств(ДанныеКвазиСсылкиИБ, СтрокаТаблицыКвазиСсылкиИБ);
			МассивКвазиСсылкиИБ.Добавить(ДанныеКвазиСсылкиИБ);
		КонецЦикла;
		Возврат МассивКвазиСсылкиИБ;
	КонецЕсли;
	
КонецФункции

