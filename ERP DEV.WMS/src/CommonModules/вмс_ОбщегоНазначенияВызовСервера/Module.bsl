Функция ВыполнитьПакетМетодов(ПакетМетодов, ВыполнятьВПопытке=Истина, ОстанавливатьсяПоОшибке=Ложь) Экспорт

	ПакетРезультатовМассив = Новый Массив;
	ПакетРезультатовСоответствие = Новый Соответствие;
	Отказ = Ложь;
	
	Для Каждого ОписаниеМетода Из ПакетМетодов Цикл
		
		ДанныеВыполнения = Новый Структура;
		ДанныеВыполнения.Вставить("Имя", ОписаниеМетода.Имя);
		ДанныеВыполнения.Вставить("ОписаниеМетода", ОписаниеМетода);
		ДанныеВыполнения.Вставить("Ошибка", Ложь);
		ДанныеВыполнения.Вставить("Результат");
		ДанныеВыполнения.Вставить("ИнформацияОбОшибке");
		ДанныеВыполнения.Вставить("Отказ", Ложь);
		
		Если Не Отказ Тогда
			Если ВыполнятьВПопытке Тогда
				Попытка
					ВыполнитьПакетнуюПредОбработкуМетода(ОписаниеМетода, ПакетРезультатовСоответствие, Отказ);
					Если Отказ Тогда
						Результат = Неопределено;
					Иначе
						Результат = ВыполнитьМетод(ОписаниеМетода, Ложь);
					КонецЕсли;
				Исключение
					ИнформацияОбОшибке = ИнформацияОбОшибке();
					ДанныеВыполнения.ИнформацияОбОшибке = ИнформацияОбОшибке;
					ТекстОшибки = "";
					ТекстОшибки = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке) + Символы.ПС + Символы.ПС;
					ТекстОшибки = ТекстОшибки + вмс_Журналирование.СериализоватьКонтекст(Новый Структура("Имя, Параметры", ОписаниеМетода.Имя, ОписаниеМетода.Параметры));
					вмс_Журналирование.Ошибка(ТекстОшибки, "Метод """ + ОписаниеМетода.Имя + """");
					Результат = Неопределено;
				КонецПопытки
			Иначе
				ВыполнитьПакетнуюПредОбработкуМетода(ОписаниеМетода, ПакетРезультатовСоответствие, Отказ);
				Если Отказ Тогда
					Результат = Неопределено;
				Иначе
					Результат = ВыполнитьМетод(ОписаниеМетода, Ложь);
				КонецЕсли;
			КонецЕсли;

			ДанныеВыполнения.Ошибка = ДанныеВыполнения.ИнформацияОбОшибке <> Неопределено;
			ДанныеВыполнения.Результат = Результат;
			
			Если ДанныеВыполнения.Ошибка И ОстанавливатьсяПоОшибке Тогда
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;

		ДанныеВыполнения.Отказ = Отказ;
		
		ПакетРезультатовМассив.Добавить(ДанныеВыполнения);
		ПакетРезультатовСоответствие[ОписаниеМетода.Имя] = ДанныеВыполнения;
		
	КонецЦикла;
	
	Возврат ПакетРезультатовМассив;

КонецФункции

Функция ВыполнитьМетод(ОписаниеМетода, ВыполнятьВПопытке=Истина, ИнформацияОбОшибке=Неопределено) Экспорт
	
	ИнформацияОбОшибке = Неопределено;
	
	Если ВыполнятьВПопытке Тогда
		
		Попытка
			
			// Рефакторинг, чтобы уменьшить размер стека вызова функции
			// { Тело функции ВыполнитьОбработчикМетода
			Если ОписаниеМетода.ПредОбработка <> Неопределено Тогда
				Выполнить(ОписаниеМетода.ПредОбработка + "(ОписаниеМетода)");
			КонецЕсли;
			
			Параметры = ОписаниеМетода.Параметры;
			СтрокаПараметров = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьСтрокуПараметровМетода(Параметры);
			ТекстИсполняемогоКода = ОписаниеМетода.ИмяОбработчика + СтрокаПараметров;
			
			Если ОписаниеМетода.ВозвращаетРезультат Тогда
				Результат = Вычислить(ТекстИсполняемогоКода);
			Иначе
				Выполнить(ТекстИсполняемогоКода);
				Результат = Неопределено;
			КонецЕсли;

			Если ОписаниеМетода.ПостОбработка <> Неопределено Тогда
				ДанныеВыполнения = Новый Структура;
				ДанныеВыполнения.Вставить("Результат", Результат);
				ДанныеВыполнения.Вставить("ОписаниеМетода", ОписаниеМетода);
				Выполнить(ОписаниеМетода.ПостОбработка + "(ДанныеВыполнения)");
				Результат = ДанныеВыполнения.Результат;
			КонецЕсли;
			// } Тело функции
			
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			вмс_Журналирование.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;
		
	Иначе
		
		// { Тело функции ВыполнитьОбработчикМетода
		Если ОписаниеМетода.ПредОбработка <> Неопределено Тогда
			Выполнить(ОписаниеМетода.ПредОбработка + "(ОписаниеМетода)");
		КонецЕсли;
		
		Параметры = ОписаниеМетода.Параметры;
		СтрокаПараметров = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьСтрокуПараметровМетода(Параметры);
		ТекстИсполняемогоКода = ОписаниеМетода.ИмяОбработчика + СтрокаПараметров;
		
		Если ОписаниеМетода.ВозвращаетРезультат Тогда
			Результат = Вычислить(ТекстИсполняемогоКода);
		Иначе
			Выполнить(ТекстИсполняемогоКода);
			Результат = Неопределено;
		КонецЕсли;

		Если ОписаниеМетода.ПостОбработка <> Неопределено Тогда
			ДанныеВыполнения = Новый Структура;
			ДанныеВыполнения.Вставить("Результат", Результат);
			ДанныеВыполнения.Вставить("ОписаниеМетода", ОписаниеМетода);
			Выполнить(ОписаниеМетода.ПостОбработка + "(ДанныеВыполнения)");
			Результат = ДанныеВыполнения.Результат;
		КонецЕсли;
		// } Тело функции
		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

#КонецОбласти

#Область ПреобразованиеВСтруктурыОбъектовИБ  

Функция ПолучитьСтруктуруИзОбъекта(знач Объект) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	Структура = Новый Структура;
	Структура.Вставить("Представление", Строка(Объект));
	Структура.Вставить("ДополнительныеСвойства", Новый Структура);
	
	МетаДанныеОбъекта = МетаДанные.НайтиПоТипу(ТипЗнч(Объект));
	Если МетаДанныеОбъекта = Неопределено Тогда
		Возврат Структура;
	КонецЕсли;
	
	Если Метаданные.РегистрыСведений.Содержит(МетаДанныеОбъекта) ИЛИ Метаданные.РегистрыНакопления.Содержит(МетаДанныеОбъекта) Тогда
		// набор записей регистра
		СтруктураОтбора = Новый Структура;
		Для Каждого ЭлементОтбора Из Объект.Отбор Цикл
			СтруктураОтбора.Вставить(ЭлементОтбора.ПутьКДанным, ЭлементОтбора.Значение);
		КонецЦикла;
		
		ТаблицаЗаписей = Новый ТаблицаЗначений;
		Для Каждого Реквизит Из МетаДанныеОбъекта.СтандартныеРеквизиты Цикл
			ТаблицаЗаписей.Колонки.Добавить(Реквизит.Имя);
		КонецЦикла;
		
		Для Каждого Реквизит Из МетаДанныеОбъекта.Измерения Цикл
			ТаблицаЗаписей.Колонки.Добавить(Реквизит.Имя);
		КонецЦикла;
		
		Для Каждого Реквизит Из МетаДанныеОбъекта.Реквизиты Цикл
			ТаблицаЗаписей.Колонки.Добавить(Реквизит.Имя);
		КонецЦикла;
		
		Для Каждого Реквизит Из МетаДанныеОбъекта.Ресурсы Цикл
			ТаблицаЗаписей.Колонки.Добавить(Реквизит.Имя);
		КонецЦикла;
		
		Для Каждого Запись Из Объект Цикл
			СтрокаЗаписи = ТаблицаЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗаписи, Запись);
		КонецЦикла;
		
		Структура.Вставить("Отбор", СтруктураОтбора);
		Структура.Вставить("Записи", ТаблицаЗаписей);
	Иначе
		Для Каждого Реквизит Из МетаДанныеОбъекта.СтандартныеРеквизиты Цикл
			Структура.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);
		КонецЦикла;
		
		Для Каждого Реквизит Из МетаДанныеОбъекта.Реквизиты Цикл
			Структура.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);
		КонецЦикла;
		
		Для Каждого МетаДанныеТабличнойЧасти Из МетаДанныеОбъекта.ТабличныеЧасти Цикл
			ИмяТабличнойЧасти = МетаДанныеТабличнойЧасти.Имя;
			ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
			Таблица = РК.СкопироватьТаблицуЗначений(ТабличнаяЧасть.Выгрузить(), , Истина);
			Структура.Вставить(ИмяТабличнойЧасти, Таблица);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ДополнительноеСвойство Из Объект.ДополнительныеСвойства Цикл
		Структура.ДополнительныеСвойства.Вставить(ДополнительноеСвойство.Ключ, ДополнительноеСвойство.Значение);
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

Функция ПолучитьИменаРеквизитовШапкиОбъекта(Объект) Экспорт
	
	МассивИменРеквизитов = Новый Массив;
	
	МетаДанныеОбъекта = МетаДанные.НайтиПоТипу(ТипЗнч(Объект));
	Если МетаДанныеОбъекта = Неопределено Тогда
		Возврат МассивИменРеквизитов;
	КонецЕсли; 
	
	Для Каждого Реквизит Из МетаДанныеОбъекта.Реквизиты Цикл
		МассивИменРеквизитов.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Возврат МассивИменРеквизитов;
	
КонецФункции

Функция ПолучитьЗначенияРеквизитовОбъектов(Объекты, Реквизиты, ДополнительныеПараметры=Неопределено) Экспорт
	
	ТаблицаРезультата = вмс_ОбщегоНазначенияСервер.ПолучитьРеквизитыОбъектов(Объекты, Реквизиты, ДополнительныеПараметры);

	// для возможности передачи на клиент
	КвазиТаблицаРезультата = вмс_РаботаСКоллекциями.НоваяКвазиТаблицаЗначений(ТаблицаРезультата);
	
	Возврат КвазиТаблицаРезультата;
	
КонецФункции

Функция ПолучитьЗначенияРеквизитовОбъекта(Объект, СписокРеквизитов, ДополнительныеПараметры=Неопределено) Экспорт
	
	ТаблицаРеквизитов = вмс_ОбщегоНазначенияСервер.ПолучитьРеквизитыОбъектов(Объект, СписокРеквизитов, ДополнительныеПараметры);

	Если ЗначениеЗаполнено(ТаблицаРеквизитов) Тогда
		СтрокаРеквизита = ТаблицаРеквизитов[0];
		Значения = Новый Структура;
		Для Каждого Колонка Из ТаблицаРеквизитов.Колонки Цикл
			Значения.Вставить(Колонка.Имя, СтрокаРеквизита[Колонка.Имя]);
		КонецЦикла;
		Возврат Значения;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЗначениеРеквизитаОбъекта(Объект, Реквизит, ДополнительныеПараметры=Неопределено) Экспорт
	
	ТаблицаРеквизитов = вмс_ОбщегоНазначенияСервер.ПолучитьРеквизитыОбъектов(Объект, Реквизит, ДополнительныеПараметры);
	
	Если ЗначениеЗаполнено(ТаблицаРеквизитов) Тогда
		Возврат ТаблицаРеквизитов[0][ТаблицаРеквизитов.Колонки[0].Имя];
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область РаботаСТипамиДанных

Функция ЭтоЗначениеСсылочногоТипа(Значение) Экспорт

	Возврат ЭтоСсылочныйТип(ТипЗнч(Значение));
	
КонецФункции

Функция ЭтоСсылочныйТип(знач ТипЗначения) Экспорт
	
	ТипЗначенияТипаЗначения = ТипЗнч(ТипЗначения);
	Если ТипЗначенияТипаЗначения = Тип("Тип") Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗначения);
	ИначеЕсли ТипЗначенияТипаЗначения = Тип("Массив") Тогда
		МассивТипов = ТипЗначения;
	ИначеЕсли ТипЗначенияТипаЗначения = Тип("ОписаниеТипов") Тогда
		МассивТипов = ТипЗначения.Типы();
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ТипЗначения Из МассивТипов Цикл
		МетаДанныеЗначения = МетаДанные.НайтиПоТипу(ТипЗначения);
		Если ЭтоМетаданныеСсылочногоТипа(МетаДанныеЗначения) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоМетаданныеСсылочногоТипа(МетаДанныеЗначения) Экспорт

	Если МетаДанныеЗначения <> Неопределено Тогда
		Если МетаДанные.Справочники.Содержит(МетаДанныеЗначения) Тогда
			Возврат Истина;
		КонецЕсли;

		Если МетаДанные.Документы.Содержит(МетаДанныеЗначения) Тогда
			Возврат Истина;
		КонецЕсли;

		Если МетаДанные.ПланыВидовХарактеристик.Содержит(МетаДанныеЗначения) Тогда
			Возврат Истина;
		КонецЕсли;

		Если МетаДанные.Перечисления.Содержит(МетаДанныеЗначения) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоЗначениеПеречисления(Значение) Экспорт
	МетаДанныеОбъекта = МетаДанные.НайтиПоТипу(ТипЗнч(Значение));
	Возврат МетаДанныеОбъекта <> Неопределено И МетаДанные.Перечисления.Содержит(МетаДанныеОбъекта);
КонецФункции

Функция ПолучитьИменаСсылочныхТипов(ДляСправочников=Истина, ДляДокументов=Истина, ДляПлановВидовХарактеристик=Истина) Экспорт
	
	РазделыМетаданных = Новый Массив;
	
	Если ДляСправочников Тогда
		РазделыМетаданных.Добавить(Метаданные.Справочники);
	КонецЕсли;
	
	Если ДляДокументов Тогда
		РазделыМетаданных.Добавить(Метаданные.Документы);
	КонецЕсли;
	
	Если ДляПлановВидовХарактеристик Тогда
		РазделыМетаданных.Добавить(Метаданные.ПланыВидовХарактеристик);
	КонецЕсли;
	
	МассивИменТипов = Новый Массив;
	Для Каждого Раздел Из РазделыМетаданных Цикл
		Для Каждого ОбъектМетаданных Из Раздел Цикл
			ИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
			ИмяТипа = СтрЗаменить(ИмяОбъекта, ".", "Ссылка.");
			МассивИменТипов.Добавить(ИмяТипа);
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивИменТипов;
	
КонецФункции

Функция ЭтоОбъектИБ(Объект) Экспорт
	
	Возврат ЭтоТипОбъектаИБ(ТипЗнч(Объект));
	
КонецФункции

Функция ЭтоСсылкаОбъектаИБ(Ссылка) Экспорт
	
	Возврат ЭтоТипСсылкиОбъектаИБ(ТипЗнч(Ссылка));
	
КонецФункции

Функция ЭтоТипОбъектаИБ(ТипОбъекта) Экспорт
	
