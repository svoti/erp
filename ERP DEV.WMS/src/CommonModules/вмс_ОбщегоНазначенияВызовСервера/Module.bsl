Функция СоздатьКвазиСсылкуИБ(ИмяТипа, GUID, Представление="")

	КвазиСсылкаИБ = СоздатьОбъектКвазиСсылкиИБ(ИмяТипа, GUID, Представление);
	КвазиСсылкаИБ.Записать();
	
	Возврат КвазиСсылкаИБ.Ссылка;

КонецФункции

Функция СоздатьОбъектКвазиСсылкиИБ(ИмяТипа, GUID, Представление="")

	КвазиСсылкаИБ = Справочники.КвазиСсылки.СоздатьЭлемент();
	КвазиСсылкаИБ.ИмяТипа = ИмяТипа;
	Если ТипЗнч(GUID) = Тип("Строка") Тогда
		КвазиСсылкаИБ.Имя = GUID;
	Иначе
		КвазиСсылкаИБ.GUID = GUID;
	КонецЕсли;
	КвазиСсылкаИБ.Наименование = Представление;
	
	Возврат КвазиСсылкаИБ;

КонецФункции

