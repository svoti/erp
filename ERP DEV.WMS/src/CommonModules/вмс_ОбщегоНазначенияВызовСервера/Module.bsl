Функция ПолучитьПустуюСсылкуНаТовар() Экспорт
	Возврат ПолучитьПустуюСсылкуНаОбъектИБ("Справочник.Номенклатура");
КонецФункции

Функция ПолучитьПустуюСсылкуНаОбъектИБ(ИмяОбъекта) Экспорт
	Менеджер = вмс_ОбщегоНазначенияСервер.ПолучитьМенеджерОбъектовБазы(ИмяОбъекта);
	Возврат Менеджер.ПустаяСсылка();
КонецФункции

Функция ПолучитьСсылкуОбъектаИБ(ТипОбъекта, пСсылка=Неопределено, Представление=Неопределено) Экспорт
	
	Перем ОбщегоНазначенияСервер, ОбщегоНазначенияВызовСервера;
	Перем Гуид, Ссылка, ЭтоГруппа, Объект;
	
	ОбщегоНазначенияСервер = вмс_ОбщегоНазначенияСервер;
	ОбщегоНазначенияВызовСервера = вмс_ОбщегоНазначенияВызовСервера;
	
	МетаданныеОбъекта = ОбщегоНазначенияСервер.ПолучитьМетаДанныеОбъекта(ТипОбъекта);
	Если МетаданныеОбъекта <> Неопределено Тогда
		ЭтоПеречисление = Метаданные.Перечисления.Содержит(МетаданныеОбъекта);
	Иначе
		ЭтоПеречисление = ТипЗнч(ТипОбъекта) = Тип("Строка") И Найти(ТипОбъекта, "ПеречислениеСсылка.") = 1;
	КонецЕсли;
	
	Если пСсылка <> Неопределено Тогда
		Если ТипЗнч(пСсылка) = Тип("Строка") Тогда
			Если ЭтоПеречисление Тогда
				Гуид = пСсылка;
			Иначе
				Гуид = Новый УникальныйИдентификатор(пСсылка);
			КонецЕсли;
		ИначеЕсли ТипЗнч(пСсылка) = Тип("УникальныйИдентификатор") Тогда
			Гуид = пСсылка;
		Иначе
			Гуид = пСсылка.УникальныйИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
	Если МетаданныеОбъекта <> Неопределено Тогда
		Менеджер = ОбщегоНазначенияСервер.ПолучитьМенеджерОбъектовБазы(МетаданныеОбъекта);
		Если Гуид <> Неопределено Тогда
			Если ЭтоПеречисление Тогда
				Если МетаданныеОбъекта.ЗначенияПеречисления.Найти(Гуид) = Неопределено Тогда
					Ссылка = Менеджер.ПустаяСсылка();
				Иначе	
					Ссылка = Менеджер[Гуид];
				КонецЕсли;
			Иначе
				Ссылка = Менеджер.ПолучитьСсылку(Гуид);
			КонецЕсли;
		КонецЕсли;
	Иначе
		МетаданныеОбъекта = ОбщегоНазначенияСервер.ПолучитьМетаДанныеОбъекта("Справочник.КвазиСсылки");
		Если МетаданныеОбъекта <> Неопределено Тогда
			Если ТипЗнч(ТипОбъекта) = Тип("Строка") И Гуид <> Неопределено Тогда
				ИмяТипаОбъекта = ТипОбъекта;
				ИмяТипаОбъекта = СтрЗаменить(ИмяТипаОбъекта, "Ссылка.", ".");
				ИмяТипаОбъекта = СтрЗаменить(ИмяТипаОбъекта, "Объект.", ".");
				Ссылка = ОбщегоНазначенияВызовСервера.ПолучитьКвазиСсылкуИБ(ИмяТипаОбъекта, Гуид, Представление);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

Функция ПолучитьСсылкиОбъектовИБ(знач ТаблицаДанныхОбъектов) Экспорт
	
	Перем РК, ОбщегоНазначенияСервер, ОбращенияКИСВызовСервера;
	
	РК = вмс_РаботаСКоллекциями;
	ОбщегоНазначенияСервер = вмс_ОбщегоНазначенияСервер;
	ОбращенияКИСВызовСервера = вмс_Обмен_с_КИС_ВызовСервера;
	
	ТаблицаТиповОбъектов = Новый ТаблицаЗначений;
	ТаблицаТиповОбъектов.Колонки.Добавить("ТипОбъекта");
	ТаблицаТиповОбъектов.Колонки.Добавить("МетаданныеОбъекта");
	ТаблицаТиповОбъектов.Колонки.Добавить("Менеджер");
	ТаблицаТиповОбъектов.Колонки.Добавить("ЭтоПеречисление");
	ТаблицаТиповОбъектов.Индексы.Добавить("ТипОбъекта");
	
	МетаданныеКвазиСсылок = ОбщегоНазначенияСервер.ПолучитьМетаДанныеОбъекта("Справочник.КвазиСсылки");
	
	ТаблицаКвазиСсылок = ОбращенияКИСВызовСервера.НоваяТаблицаКвазиСсылок();
	ТаблицаКвазиСсылок.Колонки.Добавить("Номер");
	
	ПоискТипа = Новый Структура("ТипОбъекта");
	МассивСсылок = Новый Массив;
	Для Каждого ДанныеОбъекта Из РК.ПолучитьЭлементыКоллекции(ТаблицаДанныхОбъектов) Цикл
		
		ТипОбъекта = ДанныеОбъекта.ТипОбъекта;
		ПоискТипа.ТипОбъекта = ТипОбъекта;
		ДанныеТипаОбъектаМассив = ТаблицаТиповОбъектов.НайтиСтроки(ПоискТипа);
		Если ДанныеТипаОбъектаМассив.Количество()=0 Тогда

			МетаданныеОбъекта = ОбщегоНазначенияСервер.ПолучитьМетаДанныеОбъекта(ТипОбъекта);
			Если МетаданныеОбъекта <> Неопределено Тогда
				ЭтоПеречисление = Метаданные.Перечисления.Содержит(МетаданныеОбъекта);
			Иначе
				МетаданныеОбъекта = МетаданныеКвазиСсылок;
				ЭтоПеречисление = ТипЗнч(ТипОбъекта)=Тип("Строка") И Найти(ТипОбъекта, "ПеречислениеСсылка.")=1;
			КонецЕсли;
			
			Менеджер = ОбщегоНазначенияСервер.ПолучитьМенеджерОбъектовБазы(МетаданныеОбъекта);

			ДанныеТипаОбъекта = ТаблицаТиповОбъектов.Добавить();
			ДанныеТипаОбъекта.ТипОбъекта = ТипОбъекта;
			ДанныеТипаОбъекта.МетаданныеОбъекта = МетаданныеОбъекта;
			ДанныеТипаОбъекта.Менеджер = Менеджер;
			ДанныеТипаОбъекта.ЭтоПеречисление = ЭтоПеречисление;
			
		Иначе
			
			ДанныеТипаОбъекта = ДанныеТипаОбъектаМассив[0];
			
			МетаданныеОбъекта = ДанныеТипаОбъекта.МетаданныеОбъекта;
			Менеджер = ДанныеТипаОбъекта.Менеджер;
			ЭтоПеречисление = ДанныеТипаОбъекта.ЭтоПеречисление;
			
		КонецЕсли;
		
		GUID = ДанныеОбъекта.GUID;
		Если МетаданныеОбъекта=МетаданныеКвазиСсылок Тогда
			// поищем пакетно позже в едином запросе
			ИмяТипаКвазиСсылкиИБ = ТипОбъекта;
			ИмяТипаКвазиСсылкиИБ = СтрЗаменить(ИмяТипаКвазиСсылкиИБ, "Ссылка.", ".");
			ИмяТипаКвазиСсылкиИБ = СтрЗаменить(ИмяТипаКвазиСсылкиИБ, "Объект.", ".");
			СсылкаОбъектаИБ = Неопределено;
			СтрокаКвазиСсылки = ТаблицаКвазиСсылок.Добавить();
			СтрокаКвазиСсылки.ИмяТипа = ИмяТипаКвазиСсылкиИБ;
			Если ЭтоПеречисление Тогда
				СтрокаКвазиСсылки.Имя = GUID;
			Иначе
				СтрокаКвазиСсылки.GUID = Новый УникальныйИдентификатор(GUID);
			КонецЕсли;
			СтрокаКвазиСсылки.Представление = ДанныеОбъекта.Представление;
			СтрокаКвазиСсылки.Номер = МассивСсылок.Количество();
		Иначе
			Если ЭтоПеречисление Тогда
				Если МетаданныеОбъекта.ЗначенияПеречисления.Найти(GUID) = Неопределено Тогда
					СсылкаОбъектаИБ = Менеджер.ПустаяСсылка();
				Иначе	
					СсылкаОбъектаИБ = Менеджер[GUID];
				КонецЕсли;
			Иначе
				GUID = Новый УникальныйИдентификатор(GUID);
				СсылкаОбъектаИБ = Менеджер.ПолучитьСсылку(GUID);
			КонецЕсли;
		КонецЕсли;

		МассивСсылок.Добавить(СсылкаОбъектаИБ);
		
	КонецЦикла;
	
	Если ТаблицаКвазиСсылок.Количество() > 0 Тогда
		ОбращенияКИСВызовСервера.ПолучитьКвазиСсылкиИБПоТаблицеКвазиСсылок(ТаблицаКвазиСсылок);
		
		Для Каждого СтрокаКвазиСсылки Из ТаблицаКвазиСсылок Цикл
			МассивСсылок[СтрокаКвазиСсылки.Номер] = СтрокаКвазиСсылки.КвазиСсылкаИБ;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивСсылок;
	
КонецФункции

Функция ПолучитьМакет(ИмяМакета) Экспорт
	
	ПутьКМакетуМассив = вмс_РаботаСКоллекциями.СтрокуВМассив(ИмяМакета);
	Если ПутьКМакетуМассив.Количество() = 1 Тогда
		Возврат ПолучитьОбщийМакет(ПутьКМакетуМассив[0]);
	КонецЕсли;
	
	Если ПутьКМакетуМассив.Количество() = 2 Тогда
		ИмяМакета = ПутьКМакетуМассив[ПутьКМакетуМассив.ВГраница()];
		ПутьКМакетуМассив.Удалить(ПутьКМакетуМассив.ВГраница());
		
		Менеджер = вмс_ОбщегоНазначенияСервер.ПолучитьМенеджерОбъектовБазы(ПутьКМакетуМассив);
		Возврат Менеджер.ПолучитьМакет(ИмяМакета);
	КонецЕсли;
	
КонецФункции

