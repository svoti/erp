// ТУ_Кошелев 13.12.24 - добавил функцию текстового представления ошибки.
// В мобилке есть дубль этой функции, сделан для новой формы отбора. Вероятно целесообразно проверить использования этой
// функции в МП, и заменить все случаи на формирование текста в учетной системе напрямую.
//
Функция ТекстовоеПредставлениеОшибки(Инфо) Экспорт
	Если Инфо.Причина = Неопределено Тогда
		Причина = "";
	Иначе
		Причина = Инфо.Причина.Описание;
	КонецЕсли;
	
	Сообщение =
		"Модуль  : " + Инфо.ИмяМодуля + Символы.ПС +
		"Строка №: " + Инфо.НомерСтроки + Символы.ПС +
		"Строка  : " + Инфо.ИсходнаяСтрока + Символы.ПС +
		"Описание: " + Инфо.Описание + Символы.ПС +
		"Доп инфо: " + Инфо.ДополнительнаяИнформация + Символы.ПС +
		"Причина : " + Причина + Символы.ПС +
		"Код     : " + Инфо.Код + Символы.ПС;
	Возврат Сообщение;
КонецФункции

