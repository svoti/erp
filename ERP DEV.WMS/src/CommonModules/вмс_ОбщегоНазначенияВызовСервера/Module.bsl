КонецФункции

Функция ПолучитьДанныеТипаОбъекта(знач ТипОбъекта) Экспорт
	
	Данные = вмс_ОбщегоНазначенияСервер.ПолучитьДанныеТипаОбъекта(ТипОбъекта);
	
	// Значения этих полей не передаем так, как могут быть недоступны на клиенте
	Данные.Вставить("МенеджерОбъектов");
	Данные.Вставить("ТипОбъекта");
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьИмяТипаЗначения(Значение) Экспорт
	
	Возврат ПолучитьИмяТипа(ТипЗнч(Значение));
	
КонецФункции

Функция ПолучитьИмяТипаОбъекта(Объект) Экспорт
	
	МетаДанныеОбъекта = МетаДанные.НайтиПоТипу(ТипЗнч(Объект));
	
	Если МетаДанныеОбъекта <> Неопределено Тогда
		Возврат МетаДанныеОбъекта.ПолноеИмя();
	КонецЕсли; 
	
КонецФункции

Функция ПолучитьИмяТипа(Тип) Экспорт
	
	Если Тип = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если Тип = Тип("Структура") Тогда
		ИмяТипа = "Структура";
	ИначеЕсли Тип = Тип("Соответствие") Тогда
		ИмяТипа = "Соответствие";
	ИначеЕсли Тип = Тип("Массив") Тогда
		ИмяТипа = "Массив";
	ИначеЕсли Тип = Тип("ТаблицаЗначений") Тогда
		ИмяТипа = "ТаблицаЗначений";
	ИначеЕсли Тип = Тип("УдалениеОбъекта") Тогда
		ИмяТипа = "УдалениеОбъекта";
	ИначеЕсли Тип = Тип("ОписаниеТипов") Тогда
		ИмяТипа = "ОписаниеТипов";
	ИначеЕсли Тип = Тип("ФормаКлиентскогоПриложения") Тогда
		ИмяТипа = "ФормаКлиентскогоПриложения";
	ИначеЕсли Тип = Тип("ПолеФормы") Тогда
		ИмяТипа = "ПолеФормы";
	ИначеЕсли Тип = Тип("КнопкаФормы") Тогда
		ИмяТипа = "КнопкаФормы";
	ИначеЕсли Тип = Тип("ТаблицаФормы") Тогда
		ИмяТипа = "ТаблицаФормы";
	ИначеЕсли Тип = Тип("ГруппаФормы") Тогда
		ИмяТипа = "ГруппаФормы";
	ИначеЕсли Тип = Тип("Число") Тогда
		ИмяТипа = "Число";
	ИначеЕсли Тип = Тип("Строка") Тогда
		ИмяТипа = "Строка";
	ИначеЕсли Тип = Тип("Дата") Тогда
		ИмяТипа = "Дата";
	ИначеЕсли Тип = Тип("Булево") Тогда
		ИмяТипа = "Булево";
	ИначеЕсли Тип = Тип("Неопределено") Тогда
		ИмяТипа = "Неопределено";
	Иначе
		XMLТип = XMLТип(Тип);
		Если XMLТип <> Неопределено Тогда
			ИмяТипа = XMLТип.ИмяТипа;
			ИмяТипа = СтрЗаменить(ИмяТипа, "EnumRef.", "ПеречислениеСсылка.");
			ИмяТипа = СтрЗаменить(ИмяТипа, "CatalogRef.", "СправочникСсылка.");
			ИмяТипа = СтрЗаменить(ИмяТипа, "DocumentRef.", "ДокументСсылка.");
			ИмяТипа = СтрЗаменить(ИмяТипа, "ChartOfCharacteristicTypesRef.", "ПланВидовХарактеристикСсылка.");
			ИмяТипа = СтрЗаменить(ИмяТипа, "CatalogObject.", "СправочникОбъект.");
			ИмяТипа = СтрЗаменить(ИмяТипа, "DocumentObject.", "ДокументОбъект.");
			ИмяТипа = СтрЗаменить(ИмяТипа, "ChartOfCharacteristicTypesObject.", "ПланВидовХарактеристикОбъект.");
			ИмяТипа = СтрЗаменить(ИмяТипа, "InformationRegisterRecordSet.", "РегистрСведенийНаборЗаписей.");
			ИмяТипа = СтрЗаменить(ИмяТипа, "AccumulationRegisterRecordSet.", "РегистрНакопленияНаборЗаписей.");
		Иначе
			МетаданныеОбъекта = Метаданные.НайтиПоТипу(Тип);
			Если МетаданныеОбъекта <> Неопределено Тогда
				ИмяТипа = МетаданныеОбъекта.ПолноеИмя();
			Иначе
				ИмяТипа = Строка(Тип);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
	Возврат ИмяТипа;
	
КонецФункции

Функция ЕстьМетаданныеОбъекта(Объект) Экспорт
	
	Возврат вмс_ОбщегоНазначенияСервер.ПолучитьМетаданныеОбъекта(Объект) <> Неопределено;
	
КонецФункции

Функция ПолучитьСписокИменОбщихМодулей(НаКлиенте) Экспорт
	
	СписокИмен = Новый Массив;
	
	Для Каждого ОМ Из Метаданные.ОбщиеМодули Цикл
		
		Если ОМ.Глобальный Тогда
			Продолжить;
		КонецЕсли;
		
		Если НаКлиенте И (ОМ.КлиентУправляемоеПриложение ИЛИ ОМ.ВызовСервера) ИЛИ
			НЕ НаКлиенте И ОМ.Сервер Тогда
			СписокИмен.Добавить(ОМ.Имя);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокИмен;
	
КонецФункции

// Безопасное получение описания типов,
// если каких-то типов не существует в данной конфигурации, то он добавлен не будет
//
// Параметры:
//  Источник - Произвольный - Если тип "ОписаниеТипов",то без изменений.
//    Иначе преобразуется в только существующие типы.
//  КвалификаторыЧисла - КвалификаторыЧисла - По умолчанию Неопределено.
//  КвалификаторыСтроки - КвалификаторыСтроки - По умолчанию Неопределено.
//  КвалификаторыДаты - КвалификаторыДаты - По умолчанию Неопределено.
//
// Возвращаемое значение:
//  ОписаниеТипов
//
Функция ПолучитьОписаниеТипов(Источник, КвалификаторыЧисла=Неопределено, КвалификаторыСтроки=Неопределено, КвалификаторыДаты=Неопределено) Экспорт
	
	ТипИсточника = ТипЗнч(Источник);
	Если ТипИсточника = Тип("ОписаниеТипов") Тогда
		Возврат Источник;
	КонецЕсли;
	
	МассивТипов = вмс_РаботаСКоллекциями.ЗначениеВМассив(Источник);
	МассивТиповПроверенный = ПроверитьТипыДанных(МассивТипов);
	ОписаниеТипов = Новый ОписаниеТипов(МассивТиповПроверенный, КвалификаторыЧисла, КвалификаторыСтроки, КвалификаторыДаты);
	
	Возврат ОписаниеТипов;
	
КонецФункции

Функция ПроверитьТипыДанных(ТипыДанных) Экспорт

	МассивТипов = вмс_РаботаСКоллекциями.ЗначениеВМассив(ТипыДанных, , Ложь);
	МассивТиповПроверенный = Новый Массив;
	Для Каждого ТипДанных Из МассивТипов Цикл
		Если ТипЗнч(ТипДанных) <> Тип("Тип") Тогда
			ИмяТипаДанных = Строка(ТипДанных);
			Если СтрНайти(ИмяТипаДанных, "Ссылка.") > 0 Тогда
				ИмяОбъекта = СтрЗаменить(ИмяТипаДанных, "Ссылка.", ".");
				МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
				Если МетаданныеОбъекта = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ТипДанных = Тип(ИмяТипаДанных);
		КонецЕсли;
		
		МассивТиповПроверенный.Добавить(ТипДанных);
	КонецЦикла;
	
	Возврат МассивТиповПроверенный;
	
КонецФункции

