Функция КвазиРеквизиты_ПолучитьТаблицуРеквизитов(СписокРеквизитов)

	ТаблицаРеквизитов = вмс_РаботаСКоллекциями.ЗначениеВТаблицуЗначений(СписокРеквизитов, "Имя");
	Если ТаблицаРеквизитов.Колонки.Найти("Имя") = Неопределено Тогда
		ТаблицаРеквизитов.Колонки.Добавить("Имя");
	КонецЕсли;
	
	Если ТаблицаРеквизитов.Колонки.Найти("Тип") = Неопределено Тогда
		ТаблицаРеквизитов.Колонки.Добавить("Тип");
	КонецЕсли;
	
	Возврат ТаблицаРеквизитов;
	
КонецФункции

Функция КвазиРеквизиты_ПриЧтенииНаСервере(Форма, ТекущийОбъект, СписокРеквизитов) Экспорт
	
	ТаблицаРеквизитов = КвазиРеквизиты_ПолучитьТаблицуРеквизитов(СписокРеквизитов);
	ИнициализированныеТаблицы = Новый Соответствие;
	
	Для Каждого СтрокаРеквизита Из ТаблицаРеквизитов Цикл
		Реквизит = СтрокаРеквизита.Имя;
		Если Не ЗначениеЗаполнено(Реквизит) Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьРеквизита = вмс_РаботаСКоллекциями.ЗначениеВМассив(Реквизит, ".");
		Если ПутьРеквизита.Количество() = 2 Тогда
			ИмяТаблицы = ПутьРеквизита[0];
			Реквизит = ПутьРеквизита[1];
			ТаблицаИсточник = ТекущийОбъект[ИмяТаблицы];
			ТаблицаПриемник = Форма[ИмяТаблицы];
			Если ИнициализированныеТаблицы[ИмяТаблицы] <> Истина Тогда
				ТаблицаПриемник.Очистить();
				Для Каждого СтрокаИсточник Из ТаблицаИсточник Цикл
					СтрокаПриемник = ТаблицаПриемник.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаИсточник);
				КонецЦикла;
				ИнициализированныеТаблицы[ИмяТаблицы] = Истина;
			КонецЕсли;
			
			Для НомерСтроки=1 По ТаблицаИсточник.Количество() Цикл
				СтрокаИсточник = ТаблицаИсточник[НомерСтроки-1];
				СтрокаПриемник = ТаблицаПриемник[НомерСтроки-1];
				СтрокаПриемник[Реквизит] = КвазиРеквизиты_ПрочитатьЗначениеРеквизита(СтрокаИсточник[Реквизит]);
			КонецЦикла;
		Иначе
			Форма[Реквизит] = КвазиРеквизиты_ПрочитатьЗначениеРеквизита(ТекущийОбъект[Реквизит]);
		КонецЕсли;
		
	КонецЦикла;
	
	КвазиРеквизиты_ОбновитьЭлементыНаСервере(Форма, СписокРеквизитов);
	
	Возврат Истина;
	
КонецФункции

Функция КвазиРеквизиты_ПрочитатьЗначениеРеквизита(Значение)
	
	Если ТипЗнч(Значение) = Тип("СправочникСсылка.КвазиСсылки") Тогда
		Возврат вмс_Обмен_с_КИС_ВызовСервера.ПолучитьСсылкуИзКвазиСсылки(Значение);
	Иначе
		Возврат Значение;
	КонецЕсли;

КонецФункции

Функция КвазиРеквизиты_ЗаписатьЗначениеРеквизита(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если вмс_ОбщегоНазначенияВызовСервера.ЭтоТипСсылкиОбъектаИБ(ТипЗначения) И Не ТипЗначения = Тип("СправочникСсылка.КвазиСсылки") Тогда
		Возврат вмс_Обмен_с_КИС_ВызовСервера.ПолучитьКвазиСсылкуИБИзСсылки(Значение);
	Иначе
		Возврат Значение;
	КонецЕсли;

КонецФункции

Функция КвазиРеквизиты_ОбновитьЭлементыНаСервере(Форма, СписокРеквизитов) Экспорт
	
	ТаблицаРеквизитов = КвазиРеквизиты_ПолучитьТаблицуРеквизитов(СписокРеквизитов);
	
	Для Каждого Элемент Из Форма.Элементы Цикл
		
		Если ТипЗнч(Элемент) = Тип("ПолеФормы") И Элемент.Вид = ВидПоляФормы.ПолеВвода Тогда
			НайденныеСтрокиРеквизита = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("Имя", Элемент.ПутьКДанным));
			Если НайденныеСтрокиРеквизита.Количество() > 0 Тогда
				СтрокаРеквизита = НайденныеСтрокиРеквизита[0];
				Элемент.ОграничениеТипа = вмс_ОбщегоНазначенияВызовСервера.ПолучитьОписаниеТипов(СтрокаРеквизита.Тип);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция КвазиРеквизиты_ПередЗаписьюНаСервере(Форма, ТекущийОбъект, СписокРеквизитов) Экспорт
	
	ТаблицаРеквизитов = КвазиРеквизиты_ПолучитьТаблицуРеквизитов(СписокРеквизитов);
	ИнициализированныеТаблицы = Новый Соответствие;
	
	Для Каждого СтрокаРеквизита Из ТаблицаРеквизитов Цикл
		Реквизит = СтрокаРеквизита.Имя;
		Если Не ЗначениеЗаполнено(Реквизит) Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьРеквизита = вмс_РаботаСКоллекциями.ЗначениеВМассив(Реквизит, ".");
		Если ПутьРеквизита.Количество() = 2 Тогда
			ИмяТаблицы = ПутьРеквизита[0];
			Реквизит = ПутьРеквизита[1];
			ТаблицаИсточник = Форма[ИмяТаблицы];
			ТаблицаПриемник = ТекущийОбъект[ИмяТаблицы];
			Если ИнициализированныеТаблицы[ИмяТаблицы] <> Истина Тогда
				ТаблицаПриемник.Очистить();
				Для Каждого СтрокаИсточник Из ТаблицаИсточник Цикл
					СтрокаПриемник = ТаблицаПриемник.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаИсточник);
				КонецЦикла;
				ИнициализированныеТаблицы[ИмяТаблицы] = Истина;
			КонецЕсли;
			
			Для НомерСтроки=1 По ТаблицаИсточник.Количество() Цикл
				СтрокаИсточник = ТаблицаИсточник[НомерСтроки-1];
				СтрокаПриемник = ТаблицаПриемник[НомерСтроки-1];
				СтрокаПриемник[Реквизит] = КвазиРеквизиты_ЗаписатьЗначениеРеквизита(СтрокаИсточник[Реквизит]);
			КонецЦикла;
		Иначе
			ТекущийОбъект[Реквизит] = КвазиРеквизиты_ЗаписатьЗначениеРеквизита(Форма[Реквизит]);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

