Функция ДобавитьРеквизитФормыТаблица(Форма, ИмяТаблицы, Колонки) Экспорт

	Перем РК;
	
	РК = вмс_РаботаСКоллекциями;
	
	НовыеРеквизиты = Новый Массив;
	НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяТаблицы, Новый ОписаниеТипов("ТаблицаЗначений")));
	
	МассивКолонок = РК.ЗначениеВМассив(Колонки);
	
	Для Каждого Колонка Из МассивКолонок Цикл
		НовыеРеквизиты.Добавить(Новый РеквизитФормы(Колонка, Новый ОписаниеТипов, ИмяТаблицы));
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(НовыеРеквизиты);
	
	Возврат Форма[ИмяТаблицы];
	
КонецФункции

Функция ДобавитьРеквизитыФормы(Форма, знач Реквизиты, Путь=Неопределено) Экспорт

	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		Реквизиты = Новый Структура(Реквизиты);
	ИначеЕсли  ТипЗнч(Реквизиты) = Тип("Массив") Тогда
		МассивИмен = Реквизиты;
		Реквизиты = Новый Структура;
		Для Каждого Имя Из МассивИмен Цикл
			Реквизиты.Вставить(Имя);
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЗнч(Реквизиты) <> Тип("Структура") ИЛИ Реквизиты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НовыеРеквизиты = Новый Массив;
	Для Каждого Реквизит Из Реквизиты Цикл
		ОписаниеТиповРеквизита = Реквизит.Значение;
		Если ОписаниеТиповРеквизита = Неопределено ИЛИ ТипЗнч(ОписаниеТиповРеквизита) = Тип("Строка") ИЛИ ТипЗнч(ОписаниеТиповРеквизита) = Тип("Массив") Тогда
			ОписаниеТиповРеквизита = Новый ОписаниеТипов(ОписаниеТиповРеквизита);
		КонецЕсли;
		
		ИмяРеквизита = Реквизит.Ключ;
		НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, ОписаниеТиповРеквизита, Путь));
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(НовыеРеквизиты);

КонецФункции

Функция СоздатьТаблицуФормы(Форма, ИмяТаблицы, знач Колонки) Экспорт

	ТаблицаКолонок = Новый ТаблицаЗначений;
	ТаблицаКолонок.Колонки.Добавить("Имя");
	ТаблицаКолонок.Колонки.Добавить("Тип");
	
	Если ТипЗнч(Колонки) = Тип("Строка") Тогда
		Колонки = вмс_РаботаСКоллекциями.СтрокуВМассив(Колонки);
	КонецЕсли;
	
	Если ТипЗнч(Колонки) = Тип("Массив") Тогда
		Для Каждого Колонка Из Колонки Цикл
			СтрокаКолонки = ТаблицаКолонок.Добавить();
			СтрокаКолонки.Имя = Колонка;
			СтрокаКолонки.Тип = Новый ОписаниеТипов;
		КонецЦикла;
	КонецЕсли;
	
	НовыеРеквизиты = Новый Массив;
	НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяТаблицы, Новый ОписаниеТипов("ТаблицаЗначений")));
	
	Для Каждого СтрокаКолонки Из ТаблицаКолонок Цикл
		НовыеРеквизиты.Добавить(Новый РеквизитФормы(СтрокаКолонки.Имя, СтрокаКолонки.Тип, ИмяТаблицы));
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(НовыеРеквизиты);
		
КонецФункции

Функция НайтиРеквизит(Форма, ПолноеИмяРеквизита) Экспорт
	
	ИмяРеквизита = "";
	ПутьРеквизита = "";
	ПолучитьИмяИПутьРеквизита(ПолноеИмяРеквизита, ИмяРеквизита, ПутьРеквизита);
	
	МассивРеквизитов = Форма.ПолучитьРеквизиты(ПутьРеквизита);
	РеквизитФормы = вмс_РаботаСКоллекциями.НайтиЭлементКоллекции(МассивРеквизитов, Новый Структура("Имя", ИмяРеквизита));
	Возврат РеквизитФормы;
	
КонецФункции

Функция ПолучитьИмяИПутьРеквизита(ПолноеИмяРеквизита, ИмяРеквизита, ПутьРеквизита) Экспорт

	ПолноеИмяРеквизитаМассив = вмс_РаботаСКоллекциями.ЗначениеВМассив(ПолноеИмяРеквизита, ".");

	Если ПолноеИмяРеквизитаМассив.Количество() > 0 Тогда
		ИмяРеквизита = ПолноеИмяРеквизитаМассив[ПолноеИмяРеквизитаМассив.ВГраница()];
		ПолноеИмяРеквизитаМассив.Удалить(ПолноеИмяРеквизитаМассив.ВГраница());
	Иначе
		ИмяРеквизита = Неопределено;
	КонецЕсли;
	
	ПутьРеквизита = вмс_РаботаСКоллекциями.МассивВСтроку(ПолноеИмяРеквизитаМассив, ".");
	
КонецФункции

