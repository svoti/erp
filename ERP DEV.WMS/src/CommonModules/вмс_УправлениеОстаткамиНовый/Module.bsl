Функция ПроверитьВозможностьВложенияКонтейнеров(Процессор, ВнутреннийКонтейнер, ВнешнийКонтейнер, СтрокаИнструкции)
	
	ВидВнутреннегоКонтейнера = ВнутреннийКонтейнер.ТипТары.ВидКонтейнера;
	ВидВнешнегоКонтейнера = ВнешнийКонтейнер.ТипТары.ВидКонтейнера;
	Паллет = Процессор.ВидКонтейнераПаллет;
	
	Если ВидВнутреннегоКонтейнера = Паллет Тогда
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
			"Паллет нельзя помещать в другие контейнеры (запрещено: паллет в коробку)");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьЦикличностьВложения(Процессор, ПроверяемыйКонтейнер, РодительскийКонтейнер, СтрокаИнструкции)
	
	ТекущийКонтейнер = РодительскийКонтейнер;
	ПустойКонтейнер = Процессор.ПустойКонтейнер;
	Пока ЗначениеЗаполнено(ТекущийКонтейнер) И ТекущийКонтейнер <> ПустойКонтейнер Цикл
		Если ТекущийКонтейнер = ПроверяемыйКонтейнер Тогда
			ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
				"Обнаружена циклическая вложенность контейнеров");
			Возврат Ложь;
		КонецЕсли;
		Местоположение = ПолучитьМестоположениеКонтейнера(Процессор, ТекущийКонтейнер);
		ТекущийКонтейнер = Местоположение.КонтейнерРодитель;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция ПроверитьПересчитываемыеКонтейнерыПоСоставу(Процессор)
	
	РК = вмс_РаботаСКоллекциями;
	
	ПересчитываемыеКонтейнеры = Процессор.ПересчитываемыеКонтейнеры;
	ПересчитанныеКонтейнеры = Новый Массив;
	ТоварныеПоля = Процессор.ТоварныеПоля;
		
	
	// 1. Сначала соберем пересчитанные контейнеры
	Для Каждого Строка Из ПересчитываемыеКонтейнеры Цикл 
		
		Если ПересчитанныеКонтейнеры.Найти(Строка.Контейнер) = Неопределено Тогда
			ПересчитанныеКонтейнеры.Добавить(Строка.Контейнер);	
		КонецЕсли;		 
		
	КонецЦикла;
	
	Для каждого Контейнер Из ПересчитанныеКонтейнеры Цикл
		
		ОстаткиТовара = ПолучитьОстаткиТоваровВКонтейнере(Процессор, Контейнер); 	
		СтрокиКонтейнера = РК.НайтиЭлементыКоллекции(Процессор.ПересчитываемыеКонтейнеры, Новый Структура("Контейнер", Контейнер));   
		Если СтрокиКонтейнера.Количество() > 0 Тогда  
			//Возникла ситуация, если кладовщик ошибся при пересчете контейнера и отсканировал ячейку приемник некорректно (товар с одного контейнера начал кидать на разные ячейки)
			//то ошибки высвечиваются на тсд фонтаном и неинформативно, пытаюсь таким образом исправить
			КолонкиКоллекции = РК.ПолучитьКолонкиКоллекции(СтрокиКонтейнера);  
			РК.УдалитьЭлементыКоллекции(КолонкиКоллекции, "НомерСтрокиДокумента, ДополнительныеДанные, ЯчейкаПриемник, КонтейнерПриемник, Количество");   
			РК.СвернутьКоллекциюЗначений(СтрокиКонтейнера, КолонкиКоллекции, "Количество");
		КонецЕсли;
		
		МестоположениеКонтейнера = ПолучитьМестоположениеКонтейнера(Процессор, Контейнер);	
		Для Каждого СтрокаКонтейнера Из СтрокиКонтейнера Цикл
			
			Отбор = Новый Структура(ТоварныеПоля);    
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаКонтейнера);
			СтрокаОстатка = РК.НайтиЭлементКоллекции(ОстаткиТовара, Отбор);
			Если ЗначениеЗаполнено(СтрокаОстатка) И ЗначениеЗаполнено(СтрокаКонтейнера.ЯчейкаОтправитель) Тогда   
				ЗонаКарантина = вмс_СкладыВызовСервера.ПолучитьЗонуСклада(СтрокаКонтейнера.ЯчейкаОтправитель.Владелец, ПредопределенноеЗначение("Перечисление.вмс_ТипыЯчеек.Карантин"));
				Разница = СтрокаОстатка.Количество - СтрокаКонтейнера.Количество; 
				Если Разница > 0 Тогда     
					// Списываем товар с контейнера, которого нет на контейнера в момент пересчета+
					СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВЯчейках", СтрокаКонтейнера);
					СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Расход;
					// ТУ_Прошин_29.05.26+
					// Здесь будто нужно использовать родитель контейнера, который был до операции
					//МастерКонтейнер = МастерКонтейнер(Процессор, СтрокаКонтейнера.Контейнер); 
					МастерКонтейнер = ТекущийКонтейнерИзРегистра(Процессор, СтрокаКонтейнера.Контейнер);
					// ТУ_Прошин_29.05.26-
					Если ЗначениеЗаполнено(МастерКонтейнер) Тогда   
						СтрокаДвиженияРегистра.Контейнер = МастерКонтейнер;
					Иначе	
						СтрокаДвиженияРегистра.Контейнер = СтрокаКонтейнера.Контейнер;    
					КонецЕсли;
					СтрокаДвиженияРегистра.Ячейка = СтрокаКонтейнера.ЯчейкаОтправитель;
					СтрокаДвиженияРегистра.Количество = Разница;
					
					СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВКонтейнерах", СтрокаКонтейнера);
					СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Расход;
					СтрокаДвиженияРегистра.Контейнер = СтрокаКонтейнера.Контейнер;
					СтрокаДвиженияРегистра.Количество = Разница;     
					// Списываем товар с контейнера, которого нет на контейнера в момент пересчета-
					
					//Приходуем товар которого нет в моменте на контейнере в ячейку аномалий (карантина)+     
					СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВЯчейках", СтрокаКонтейнера);
					СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Приход; 
					СтрокаДвиженияРегистра.Ячейка = ЗонаКарантина;
					СтрокаДвиженияРегистра.Количество = Разница; 
					СтрокаДВиженияРегистра.Контейнер = Процессор.ПустойКонтейнер;
					// Приходуем товар которого нет в моменте на контейнере в ячейку аномалий (карантина)-
					
					ПрименитьДвиженияРегистровКДанным(Процессор, СтрокаКонтейнера.ДополнительныеДанные.ДвиженияРегистров); 
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла; 
	
		
	
КонецФункции // ПроверитьПересчитываемыеКонтейнерыПоСоставу()

Функция ТекущийКонтейнерИзРегистра(Процессор, Контейнер) 
	
	ОН = Процессор.ОбщиеМодули.ОбщегоНазначения;
	    
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	вмс_МестоположенияКонтейнеровСрезПоследних.Контейнер КАК Контейнер,
		|	вмс_МестоположенияКонтейнеровСрезПоследних.КонтейнерРодитель КАК КонтейнерРодитель
		|ИЗ
		|	РегистрСведений.вмс_МестоположенияКонтейнеров.СрезПоследних(
		|			,
		|			Контейнер = &Контейнер
		|				И &УсловиеИсключенияДокумента) КАК вмс_МестоположенияКонтейнеровСрезПоследних
		|";

		
	ТекущаяОперация = Процессор.ДокументОперации;
		
	ПараметрыЗапроса = Новый Структура("Контейнер", Контейнер);
	Если ЗначениеЗаполнено(ТекущаяОперация.ЗаданиеКладовщику) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИсключенияДокумента", "Регистратор.ЗаданиеКладовщику <> &ЗаданиеКладовщикуОперации");
		ПараметрыЗапроса.Вставить("ЗаданиеКладовщикуОперации", ТекущаяОперация.ЗаданиеКладовщику);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИсключенияДокумента", "Регистратор <> &ТекущаяОперация");
		ПараметрыЗапроса.Вставить("ТекущаяОперация", ТекущаяОперация);	
	КонецЕсли;
	
    Запрос = ОН.НовыйЗапрос(ТекстЗапроса);
	Запрос.Параметры = ПараметрыЗапроса; 
	ТаблицаРодителейКонтейнера = ОН.ПолучитьТаблицуРезультатаЗапроса(Запрос);

	Если ТаблицаРодителейКонтейнера.Количество() = 0 Тогда
		Возврат Процессор.ПустойКонтейнер;
	КонецЕсли;
	
	ИсходныйРодитель = ТаблицаРодителейКонтейнера[0].КонтейнерРодитель; 
	
	Возврат ИсходныйРодитель;	
	
    
КонецФункции  

Функция ТекущаяЯчейкаИзРегистра(Процессор, Контейнер) 
	
	ОН = Процессор.ОбщиеМодули.ОбщегоНазначения;
	    
		ТекстЗапроса = "ВЫБРАТЬ
		               |	вмс_МестоположенияКонтейнеровСрезПоследних.Контейнер КАК Контейнер,
		               |	вмс_МестоположенияКонтейнеровСрезПоследних.Ячейка КАК Ячейка
		               |ИЗ
		               |	РегистрСведений.вмс_МестоположенияКонтейнеров.СрезПоследних(
		               |			,
		               |			Контейнер = &Контейнер
		               |				И &УсловиеИсключенияДокумента) КАК вмс_МестоположенияКонтейнеровСрезПоследних";

		
	ТекущаяОперация = Процессор.ДокументОперации;
		
	ПараметрыЗапроса = Новый Структура("Контейнер", Контейнер);
	Если ЗначениеЗаполнено(ТекущаяОперация.ЗаданиеКладовщику) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИсключенияДокумента", "Регистратор.ЗаданиеКладовщику <> &ЗаданиеКладовщикуОперации");
		ПараметрыЗапроса.Вставить("ЗаданиеКладовщикуОперации", ТекущаяОперация.ЗаданиеКладовщику);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИсключенияДокумента", "Регистратор <> &ТекущаяОперация");
		ПараметрыЗапроса.Вставить("ТекущаяОперация", ТекущаяОперация);	
	КонецЕсли;
	
    Запрос = ОН.НовыйЗапрос(ТекстЗапроса);
	Запрос.Параметры = ПараметрыЗапроса; 
	ТаблицаЯчеекКонтейнера = ОН.ПолучитьТаблицуРезультатаЗапроса(Запрос);

	Если ТаблицаЯчеекКонтейнера.Количество() = 0 Тогда
		Возврат Процессор.ПустаяЯчейка;
	КонецЕсли;
	
	ИсходнаяЯчейка = ТаблицаЯчеекКонтейнера[0].Ячейка; 
	
	Возврат ИсходнаяЯчейка;	
	
КонецФункции

Функция ВыполнитьСлияниеКонтейнеровВидаКороб(Процессор, СтрокаИнструкции, ПустойКонтейнер, ПустаяЯчейка) 
	Перем ОстаткиВнутреннегоКонтейнера, Остаток, ОстаткиПриемника;
	Перем КлючиДанных, ИндексОстатков, ОстатокПриемника, КоличествоОбъединить;
	Перем МестоположениеКонтейнера;
	
	// Пока так, проблема возникает если выполняют слияние короба который на палллета и кладут в пустой, по сути это какая то дичь, но у нас ломается потому как по 
	// местоположению короба источника он уже не на паллете в этот момент и мы не можем приемнику назначить родителя, поэтому лучше пока такой сценарий просто обрезать     
	// ++
	ОстаткиКонтейнерПриемника =  ПолучитьОстаткиТоваровВКонтейнере(Процессор, СтрокаИнструкции.КонтейнерПриемник);   
	Если ОстаткиКонтейнерПриемника.Количество() = 0 Тогда
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Контейнер приемник при слиянии коробов не может быть пустым! Слияние невозможно!",));       
		Возврат Ложь;
		
	КонецЕсли;
	// --
	
	ОстаткиВнутреннегоКонтейнера = ПолучитьОстаткиТоваровВКонтейнере(Процессор, СтрокаИнструкции.Контейнер);
	
	// Определяем местоположение контейнера-приемника
	Если СтрокаИнструкции.ЯчейкаПриемник <> ПустаяЯчейка Тогда 
		//ТУ_Прошин_25.05.26+
		//МестоположениеКонтейнера = Новый Структура;    
		МестоположениеКонтейнера = ПолучитьМестоположениеКонтейнера(Процессор, СтрокаИнструкции.КонтейнерПриемник);
		//ТУ_Прошин_25.05.26-
		МестоположениеКонтейнера.Ячейка = СтрокаИнструкции.ЯчейкаПриемник;
		МестоположениеКонтейнера.КонтейнерОстатковВЯчейках = СтрокаИнструкции.КонтейнерПриемник;
	Иначе
		МестоположениеКонтейнера = ПолучитьМестоположениеКонтейнера(Процессор, СтрокаИнструкции.КонтейнерПриемник);
	КонецЕсли;
	
	// Обрабатываем каждый товар из источника
	Для Каждого Остаток Из ОстаткиВнутреннегоКонтейнера Цикл
		Если Остаток.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		// Формируем ключи для поиска аналогичного товара в приемнике
		КлючиДанных = НовыйЭлементДанных(Процессор, "ОстаткиТоваровВКонтейнерах", СтрокаИнструкции);
		КлючиДанных.Контейнер = СтрокаИнструкции.КонтейнерПриемник;
		КлючиДанных.Товар = Остаток.Товар;
		Если Остаток.Свойство("Характеристика") И ЗначениеЗаполнено(Остаток.Характеристика) Тогда
			КлючиДанных.Характеристика = Остаток.Характеристика;
		КонецЕсли;
		Если Остаток.Свойство("Серия") И ЗначениеЗаполнено(Остаток.Серия) Тогда
			КлючиДанных.Серия = Остаток.Серия;
		КонецЕсли;
		ИндексОстатков = НайтиИндекс(Процессор, "ОстаткиТоваровВКонтейнерах", КлючиДанных);
 		Если ИндексОстатков <> Неопределено Тогда
			// Товар уже есть в приемнике - объединяем количество
			ОстаткиПриемника = ПолучитьДанныеИндекса(ИндексОстатков);
			Для Каждого ОстатокПриемника Из ОстаткиПриемника Цикл
				КоличествоОбъединить = Мин(Остаток.Количество, ОстатокПриемника.Количество);
				// Приходуем объединенное количество
				СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВКонтейнерах", СтрокаИнструкции, Остаток);
				СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Приход;
				СтрокаДвиженияРегистра.Контейнер = СтрокаИнструкции.КонтейнерПриемник;
				СтрокаДвиженияРегистра.Количество = Остаток.Количество;
				Прервать;
			КонецЦикла;
		Иначе
			// Товара нет в приемнике - просто приходуем
			СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВКонтейнерах", СтрокаИнструкции, Остаток);
			СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Приход;
			СтрокаДвиженияРегистра.Контейнер = СтрокаИнструкции.КонтейнерПриемник;
			СтрокаДвиженияРегистра.Количество = Остаток.Количество;
		КонецЕсли;
		// Приходуем товар в ячейку (если есть местоположение) todo. если у приемника есть местоположение    
		МестоположениеКонтейнераИсточника = ПолучитьМестоположениеКонтейнера(Процессор, СтрокаИнструкции.Контейнер);
		Если МестоположениеКонтейнера <> Неопределено И (ЗначениеЗаполнено(МестоположениеКонтейнера.Ячейка) ИЛИ ЗначениеЗаполнено(МестоположениеКонтейнераИсточника.Ячейка)) Тогда
			СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВЯчейках", СтрокаИнструкции, Остаток);
			ЗаполнитьЗначенияСвойств(СтрокаДвиженияРегистра, Остаток);
			СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Приход;
			СтрокаДвиженияРегистра.Контейнер = МестоположениеКонтейнера.КонтейнерОстатковВЯчейках;  
			// Логика в том, что если контейнер приемник есть на остатках в ячейке - то приходуем на нее, а если нет то приходуем где лежал исходный контейнер
			// нужно, например, в сценарии если для слияния создали новый контейнер
			ЯчейкаПрихода = ?(ЗначениеЗаполнено(МестоположениеКонтейнера.Ячейка), МестоположениеКонтейнера.Ячейка, МестоположениеКонтейнераИсточника.Ячейка);	
			СтрокаДвиженияРегистра.Ячейка = ЯчейкаПрихода;   
			
			Если НЕ ЗначениеЗаполнено(МестоположениеКонтейнера.Ячейка) Тогда
				// Если для слияния создали новый короб - нужно определить его местоположение положив на ячейку и закрепив родителя по источнику      
				КопияСтрокиИнструкции = вмс_РаботаСКоллекциями.СкопироватьОбъект(СтрокаИнструкции);  
				КопияСтрокиИнструкции.Контейнер = СтрокаИнструкции.КонтейнерПриемник; 
				
				ДобавитьДвижениеРегистраМестоположенияКонтейнеров(Процессор, КопияСтрокиИнструкции, СтрокаИнструкции.КонтейнерПриемник, МестоположениеКонтейнераИсточника.КонтейнерРодитель, МестоположениеКонтейнераИсточника.КонтейнерРодитель, ЯчейкаПрихода);		
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	// Списываем контейнер-источник с ячейки (он теперь пустой)
	//ВыполнитьСписаниеКонтейнераСМест(Процессор, СтрокаИнструкции, ПустойКонтейнер, ПустаяЯчейка);
	// Списываем товары из контейнера-источника (регистр ОстаткиТоваровВКонтейнерах)
	Для Каждого Остаток Из ОстаткиВнутреннегоКонтейнера Цикл
		Если Остаток.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВКонтейнерах", СтрокаИнструкции, Остаток);
		СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Расход;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции

Функция ВыполнитьСлияниеКонтейнеровВидаПаллет(Процессор, СтрокаИнструкции, ПустойКонтейнер, ПустаяЯчейка)
	Перем ОстаткиВнутреннегоКонтейнера, Остаток, ОстаткиПриемника;
	Перем КлючиДанных, ИндексОстатков, ОстатокПриемника, КоличествоОбъединить;
	Перем МестоположениеКонтейнера;
	РК = вмс_РаботаСКоллекциями;
	// Получаем товары из контейнера-источника
	
	ОстаткиВнутреннегоКонтейнера = ПолучитьОстаткиТоваровВКонтейнере(Процессор, СтрокаИнструкции.Контейнер);
	
	// Определяем местоположение контейнера-приемника
	Если СтрокаИнструкции.ЯчейкаПриемник <> ПустаяЯчейка Тогда 
		//ТУ_Прошин_25.05.26+
		//МестоположениеКонтейнера = Новый Структура;    
		МестоположениеКонтейнера = ПолучитьМестоположениеКонтейнера(Процессор, СтрокаИнструкции.КонтейнерПриемник);
		//ТУ_Прошин_25.05.26-
		МестоположениеКонтейнера.Ячейка = СтрокаИнструкции.ЯчейкаПриемник;
		МестоположениеКонтейнера.КонтейнерОстатковВЯчейках = СтрокаИнструкции.КонтейнерПриемник;
	Иначе
		МестоположениеКонтейнера = ПолучитьМестоположениеКонтейнера(Процессор, СтрокаИнструкции.КонтейнерПриемник);
	КонецЕсли;
		
	// Обрабатываем каждый товар из источника
 	Для Каждого Остаток Из ОстаткиВнутреннегоКонтейнера Цикл
		Если Остаток.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		// Формируем ключи для поиска аналогичного товара в приемнике
		КлючиДанных = НовыйЭлементДанных(Процессор, "ОстаткиТоваровВКонтейнерах", СтрокаИнструкции);
		КлючиДанных.Контейнер = СтрокаИнструкции.КонтейнерПриемник;
		КлючиДанных.Товар = Остаток.Товар;
		Если Остаток.Свойство("Характеристика") И ЗначениеЗаполнено(Остаток.Характеристика) Тогда
			КлючиДанных.Характеристика = Остаток.Характеристика;
		КонецЕсли;
		Если Остаток.Свойство("Серия") И ЗначениеЗаполнено(Остаток.Серия) Тогда
			КлючиДанных.Серия = Остаток.Серия;
		КонецЕсли;
		ИндексОстатков = НайтиИндекс(Процессор, "ОстаткиТоваровВКонтейнерах", КлючиДанных);
 		Если ИндексОстатков <> Неопределено Тогда
			// Товар уже есть в приемнике - объединяем количество
			ОстаткиПриемника = ПолучитьДанныеИндекса(ИндексОстатков);
			Для Каждого ОстатокПриемника Из ОстаткиПриемника Цикл
				КоличествоОбъединить = Мин(Остаток.Количество, ОстатокПриемника.Количество);
				// Приходуем объединенное количество
				СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВКонтейнерах", СтрокаИнструкции, Остаток);
				СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Приход;
				СтрокаДвиженияРегистра.Контейнер = СтрокаИнструкции.КонтейнерПриемник;
				СтрокаДвиженияРегистра.Количество = Остаток.Количество;
				Прервать;
			КонецЦикла;
		Иначе
			// Товара нет в приемнике - просто приходуем
			СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВКонтейнерах", СтрокаИнструкции, Остаток);
			СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Приход;
			СтрокаДвиженияРегистра.Контейнер = СтрокаИнструкции.КонтейнерПриемник;
			СтрокаДвиженияРегистра.Количество = Остаток.Количество;
		КонецЕсли;
		// Приходуем товар в ячейку (если есть местоположение) todo. если у приемника есть местоположение   
		МестоположениеКонтейнераИсточника = ПолучитьМестоположениеКонтейнера(Процессор, СтрокаИнструкции.Контейнер);
		Если МестоположениеКонтейнера <> Неопределено И (ЗначениеЗаполнено(МестоположениеКонтейнера.Ячейка) ИЛИ ЗначениеЗаполнено(МестоположениеКонтейнераИсточника.Ячейка)) Тогда   
			Если ТипЗнч(Остаток.Товар) = Тип("СправочникСсылка.вмс_Контейнеры") Тогда         
				ОстатокКороба = ПолучитьОстаткиТоваровВКонтейнере(Процессор, Остаток.Товар);
				Для Каждого СтрокаОстаткаКороба Из ОстатокКороба Цикл
					СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВЯчейках", СтрокаИнструкции, Остаток); 
					ЗаполнитьЗначенияСвойств(СтрокаДвиженияРегистра, СтрокаОстаткаКороба);
					СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Приход;
					СтрокаДвиженияРегистра.Контейнер = МестоположениеКонтейнера.КонтейнерОстатковВЯчейках; 
					// Логика в том, что если контейнер приемник есть на остатках в ячейке - то приходуем на нее, а если нет то приходуем где лежал исходный контейнер
					// нужно, например, в сценарии если для слияния создали новый контейнер
					ЯчейкаПрихода = ?(ЗначениеЗаполнено(МестоположениеКонтейнера.Ячейка), МестоположениеКонтейнера.Ячейка, МестоположениеКонтейнераИсточника.Ячейка);
					СтрокаДвиженияРегистра.Ячейка = ЯчейкаПрихода;   
					
					// Меняем местоположение коробов      
					КопияСтрокиИнструкции = вмс_РаботаСКоллекциями.СкопироватьОбъект(СтрокаИнструкции);  
					КопияСтрокиИнструкции.Контейнер = Остаток.Товар; 
					
					ДобавитьДвижениеРегистраМестоположенияКонтейнеров(Процессор, КопияСтрокиИнструкции, Остаток.Товар, СтрокаИнструкции.КонтейнерПриемник, СтрокаИнструкции.КонтейнерПриемник, ЯчейкаПрихода);	
					Если НЕ ЗначениеЗаполнено(МестоположениеКонтейнера.Ячейка) Тогда
						КопияСтрокиИнструкции2 = вмс_РаботаСКоллекциями.СкопироватьОбъект(СтрокаИнструкции);  
						КопияСтрокиИнструкции2.Контейнер = СтрокаИнструкции.КонтейнерПриемник; 
						
						ДобавитьДвижениеРегистраМестоположенияКонтейнеров(Процессор, КопияСтрокиИнструкции2, СтрокаИнструкции.КонтейнерПриемник, ПустойКонтейнер, СтрокаИнструкции.КонтейнерПриемник, ЯчейкаПрихода);		
					КонецЕсли;	
				КонецЦикла;
				
			Иначе
				СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВЯчейках", СтрокаИнструкции, Остаток);
				ЗаполнитьЗначенияСвойств(СтрокаДвиженияРегистра, Остаток);
				СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Приход;
				СтрокаДвиженияРегистра.Контейнер = МестоположениеКонтейнера.КонтейнерОстатковВЯчейках;    
				// Логика в том, что если контейнер приемник есть на остатках в ячейке - то приходуем на нее, а если нет то приходуем где лежал исходный контейнер
				// нужно, например, в сценарии если для слияния создали новый контейнер
				ЯчейкаПрихода = ?(ЗначениеЗаполнено(МестоположениеКонтейнера.Ячейка), МестоположениеКонтейнера.Ячейка, МестоположениеКонтейнераИсточника.Ячейка);
				СтрокаДвиженияРегистра.Ячейка = ЯчейкаПрихода;
				//СтрокаДвиженияРегистра.Ячейка = МестоположениеКонтейнера.Ячейка;   
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Списываем контейнер-источник с ячейки (он теперь пустой)
	//ВыполнитьСписаниеКонтейнераСМест(Процессор, СтрокаИнструкции, ПустойКонтейнер, ПустаяЯчейка);
	// Списываем товары из контейнера-источника (регистр ОстаткиТоваровВКонтейнерах)
	Для Каждого Остаток Из ОстаткиВнутреннегоКонтейнера Цикл
		Если Остаток.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДвиженияРегистра = ДобавитьДвижениеРегистра(Процессор, "ОстаткиТоваровВКонтейнерах", СтрокаИнструкции, Остаток);
		СтрокаДвиженияРегистра.ВидДвижения = ВидДвиженияНакопления.Расход;
	КонецЦикла;

	Возврат Истина;
КонецФункции

Функция МастерКонтейнер(Процессор, Контейнер)
	
	МестоположениеКонтейнераОтправителя = ПолучитьМестоположениеКонтейнера(Процессор, Контейнер);
	Возврат МестоположениеКонтейнераОтправителя.КонтейнерРодитель;

КонецФункции

// 3.2.4 - Компиляция 3 уровня, новая -

Функция ПроверитьЯчейкуПриемникНаМестоположениеКонтейнерПриемника(Процессор, СтрокаИнструкции, КонтейнерПриемник, ЯчейкаПриемник)
	//ТУ_Прошин_26.05.26+	
	МестоположениеКонтейнера = ПолучитьМестоположениеКонтейнера(Процессор, КонтейнерПриемник);
	Ячейка = МестоположениеКонтейнера.Ячейка;
	Если Ячейка <> Неопределено И Ячейка <> Процессор.ПустаяЯчейка И Ячейка <> Процессор.ЯчейкаДляНеразмещенныхКонтейнеров И ЯчейкаПриемник <> Ячейка Тогда
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Контейнер приемник находится на ячейке %1, разместить на ячейку %2 невозможно!", Строка(МестоположениеКонтейнера.Ячейка), Строка(ЯчейкаПриемник)));       
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина  
	//ТУ_Прошин_26.05.26-
КонецФункции  

Функция ПроверитьЯчейкуПриемникНаМестоположениеКонтейнера(Процессор, СтрокаИнструкции, Контейнер, ЯчейкаПриемник)
	//ТУ_Прошин_29.05.26+	
	МестоположениеКонтейнера = ПолучитьМестоположениеКонтейнера(Процессор, Контейнер);  
	ЯчейкаДоОперацииПоЯчейкам = ТекущаяЯчейкаИзРегистра(Процессор, Контейнер);  
	Ячейка = МестоположениеКонтейнера.Ячейка;
	Если Ячейка <> Неопределено И Ячейка <> Процессор.ПустаяЯчейка И Ячейка <> Процессор.ЯчейкаДляНеразмещенныхКонтейнеров И (Ячейка <> ЯчейкаПриемник И ЯчейкаДоОперацииПоЯчейкам <> Ячейка) Тогда
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Контейнер находится на ячейке %1, разместить на ячейку %2 невозможно!", Строка(МестоположениеКонтейнера.Ячейка), Строка(ЯчейкаПриемник)));       
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина  
	//ТУ_Прошин_29.05.26-
КонецФункции 

Функция ПредполагаемыйМастерКонтейнерСоответствуетТекущему(Процессор, СтрокаИнструкции, Контейнер, ПотенциальныйМастерКонтейнер, ПустойКонтейнер)    
	
	ПаллетаПересчета = ПолучитьПаллетуПересчетаКонтейнера(Процессор, Контейнер);

	Если ПаллетаПересчета <> Неопределено И ПаллетаПересчета <> ПотенциальныйМастерКонтейнер Тогда   
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Контейнер %1 находится на контейнере %2, разместить на контейнер %3 невозможно!", Строка(Контейнер), Строка(ПаллетаПересчета), Строка(ПотенциальныйМастерКонтейнер)));
		Возврат Ложь; 
	ИначеЕсли СтрокаИнструкции.ПересчетКонтейнераРодителя И ПотенциальныйМастерКонтейнер <> ПустойКонтейнер Тогда
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Нельзя перемещать контейнер на другой контейнер во время пересчета мастер контейнера! ",));
		Возврат Ложь;		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьПаллетуПересчетаКонтейнера(Процессор, Контейнер)

	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	СтрокаИнструкцииПересчета = РК.НайтиЭлементКоллекции(Процессор.ТаблицаИнструкцийРазложенная, Новый Структура("Контейнер, ПересчетВКонтейнере", Контейнер, Истина));
	
	Если СтрокаИнструкцииПересчета <> Неопределено Тогда
		Возврат СтрокаИнструкцииПересчета.КонтейнерПриемник;
	КонецЕсли;
	
КонецФункции

Функция ЗакончитьФормированиеДвижений(Процессор)
	
	УпорядочитьДвиженияРегистров(Процессор);
	
	ЗаполнитьПоляДвиженийРегистровПоУмолчанию(Процессор);
	
КонецФункции

Функция УпорядочитьДвиженияРегистров(Процессор)

	Перем РК;
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;

	Для Каждого ДвиженияРегистра Из Процессор.ДвиженияРегистров Цикл
		ИмяРегистра = ДвиженияРегистра.Ключ;
		ТаблицаДвижений = ДвиженияРегистра.Значение;
		МассивЭлементов = Новый Массив;
		Для Каждого СтрокаИнструкции Из РК.ПолучитьЭлементыКоллекции(Процессор.ТаблицаИнструкцийРазложенная) Цикл
			
			Для Каждого СтрокаДвижения Из СтрокаИнструкции.ДополнительныеДанные.ДвиженияРегистров[ИмяРегистра] Цикл
				МассивЭлементов.Добавить(СтрокаДвижения);
			КонецЦикла;
			
		КонецЦикла;
        РК.УдалитьДублиВМассиве(МассивЭлементов, Истина);
		РК.УпорядочитьЭлементыКоллекцииЗначенийПоМассиву(ТаблицаДвижений, МассивЭлементов);
	КонецЦикла;
	
	
КонецФункции

Функция ЗаполнитьПоляДвиженийРегистровПоУмолчанию(Процессор)
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	ОН = Процессор.ОбщиеМодули.ОбщегоНазначения;
	
	Регистратор = Процессор.ДокументОперации;
	Если ЗначениеЗаполнено(Процессор.Дата) Тогда
		Период = Процессор.Дата;
	Иначе
		Период = ТекущаяДата();
	КонецЕсли;
	
	СерияПоУмолчанию = Процессор.ПустаяСерия;
	КачествоНовый = Процессор.КачествоНовый;
	
	МассивЯчеек = Новый Массив;
	Для Каждого СтрокаДвижения Из РК.ПолучитьЭлементыКоллекции(Процессор.ДвиженияРегистров.ОстаткиТоваровВЯчейках) Цикл
		МассивЯчеек.Добавить(СтрокаДвижения.Ячейка);
	КонецЦикла;
		
	Запрос = ОН.НовыйЗапрос("ВЫБРАТЬ МестаХранения.Ссылка КАК Ячейка, МестаХранения.Владелец КАК Склад ИЗ Справочник.вмс_МестаХранения КАК МестаХранения ГДЕ МестаХранения.Ссылка В (&МассивЯчеек)");
	Запрос.Параметры.Вставить("МассивЯчеек", МассивЯчеек);
	ТаблицаЯчеек = ОН.ПолучитьТаблицуРезультатаЗапроса(Запрос);

	Для Каждого СтрокаДвижения Из РК.ПолучитьЭлементыКоллекции(Процессор.ДвиженияРегистров.ОстаткиТоваровВЯчейках) Цикл
		
		СтрокаДвижения.Регистратор = Регистратор;
		СтрокаДвижения.Период = Период;
		
		// ТУ_Прошин_13.01.26+ 
		// Измерение склад упразнено
		//СтрокаЯчейки = РК.НайтиЭлементКоллекции(ТаблицаЯчеек, Новый Структура("Ячейка", СтрокаДвижения.Ячейка));
		//Если СтрокаЯчейки <> Неопределено Тогда
		//	СтрокаДвижения.Склад = СтрокаЯчейки.Склад;
		//КонецЕсли; 
		// ТУ_Прошин_13.01.26-
		
		Если СтрокаДвижения.Серия=Неопределено Тогда
			СтрокаДвижения.Серия = СерияПоУмолчанию;
		КонецЕсли; 
		
		// ТУ_Прошин_10.11.25+
		Если СтрокаДвижения.Качество = Неопределено Тогда
			СтрокаДвижения.Качество = КачествоНовый;	
		КонецЕсли;	
		// ТУ_Прошин_10.11.25-
		
	КонецЦикла;
	
	Для Каждого СтрокаДвижения Из РК.ПолучитьЭлементыКоллекции(Процессор.ДвиженияРегистров.ОстаткиТоваровВКонтейнерах) Цикл
		
		СтрокаДвижения.Регистратор = Регистратор;
		СтрокаДвижения.Период = Период;   
		
		// ТУ_Прошин_10.11.25+
		Если СтрокаДвижения.Качество = Неопределено Тогда
			СтрокаДвижения.Качество = КачествоНовый;	
		КонецЕсли;	
		// ТУ_Прошин_10.11.25-
		
	КонецЦикла;
	
	Для Каждого СтрокаДвижения Из РК.ПолучитьЭлементыКоллекции(Процессор.ДвиженияРегистров.МестоположенияКонтейнеров) Цикл
		
		СтрокаДвижения.Регистратор = Регистратор;
		СтрокаДвижения.Период = Период;
		
	КонецЦикла;
	
КонецФункции

Функция ПолучитьОстатокТовара(Процессор, Аналитика)

	Индекс = НайтиИндекс(Процессор, "ОстаткиТоваровВЯчейках", Аналитика);
	
	Если Индекс <> Неопределено Тогда
		Данные = Индекс.Данные;
		Если Данные.Количество() > 0 Тогда
			Возврат Данные[0].Количество;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьМестоположениеКонтейнера(Процессор, Контейнер)
	
	Местоположение = Новый Структура();
	Местоположение.Вставить("Контейнер", Контейнер);
	Местоположение.Вставить("КонтейнерОстатковВЯчейках", Процессор.ПустойКонтейнер);
	Местоположение.Вставить("КонтейнерРодитель", Процессор.ПустойКонтейнер);
	Местоположение.Вставить("Ячейка", Процессор.ПустаяЯчейка);

	Индекс = НайтиИндекс(Процессор, "МестоположенияКонтейнеров", Новый Структура("Контейнер", Контейнер));
	Если Индекс <> Неопределено Тогда
		Данные = Индекс.Данные;
		Если Данные.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Местоположение, Данные[0]);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Местоположение;
	
КонецФункции

Функция ДобавитьДвижениеРегистра(Процессор, ИмяРегистра, СтрокаИнструкции, Знач ДанныеЗаполнения=Неопределено)
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	
	Если ДанныеЗаполнения=Неопределено Тогда
		ДанныеЗаполнения = СтрокаИнструкции;
	КонецЕсли;
	
	СтрокаДвиженияРегистра = РК.ДобавитьЭлементКоллекции(Процессор.ДвиженияРегистров[ИмяРегистра], ДанныеЗаполнения);
	СтрокаДвиженияРегистра.НомерСтрокиДокумента = СтрокаИнструкции.НомерСтрокиДокумента;
	СтрокаИнструкции.ДополнительныеДанные.ДвиженияРегистров[ИмяРегистра].Добавить(СтрокаДвиженияРегистра);
	СтрокаИнструкции.ДополнительныеДанные.Скомпилирована = Истина;
	
	Возврат СтрокаДвиженияРегистра;
	
КонецФункции

Функция ДобавитьДвижениеРегистраМестоположенияКонтейнеров(Процессор, СтрокаИнструкции, Контейнер, КонтейнерРодитель, КонтейнерОстатковВЯчейках, Ячейка)
	
	Перем РК;
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	
	ТаблицаДвиженийРегистраМестоположенияКонтейнеров = Процессор.ДвиженияРегистров.МестоположенияКонтейнеров;
	ПоляОтбораЭлемента = Новый Структура("Контейнер", Контейнер);
	МестоположениеКонтейнера = РК.НайтиЭлементКоллекции(ТаблицаДвиженийРегистраМестоположенияКонтейнеров, ПоляОтбораЭлемента);
	Если МестоположениеКонтейнера=Неопределено Тогда
		МестоположениеКонтейнера = РК.ДобавитьЭлементКоллекции(ТаблицаДвиженийРегистраМестоположенияКонтейнеров, ПоляОтбораЭлемента);
	КонецЕсли;
	
	МестоположениеКонтейнера.КонтейнерРодитель = КонтейнерРодитель;
	МестоположениеКонтейнера.КонтейнерОстатковВЯчейках = КонтейнерОстатковВЯчейках;
	МестоположениеКонтейнера.Ячейка = Ячейка;
	
	СтрокаИнструкции.ДополнительныеДанные.ДвиженияРегистров.МестоположенияКонтейнеров.Добавить(МестоположениеКонтейнера);
	СтрокаИнструкции.ДополнительныеДанные.Скомпилирована = Истина;
	
	Возврат МестоположениеКонтейнера;
	
КонецФункции

Функция ПолучитьОстаткиТоваровВКонтейнере(Процессор, Контейнер)
	
	ИК = Процессор.ОбщиеМодули.ИндексированиеКоллекций;
	
	ОстаткиТоваровВКонтейнерах = Процессор.Данные.ОстаткиТоваровВКонтейнерах;
	
	Вектор = Новый Массив;
	Вектор.Добавить(Контейнер);
	ИндексОстаткиТоваровВКонтейнере = ИК.НайтиИндекс(ОстаткиТоваровВКонтейнерах, Вектор);
	Если ИндексОстаткиТоваровВКонтейнере <> Неопределено Тогда
		ОстаткиТоваровВКонтейнере = ИК.ПолучитьДанныеИндекса(ИндексОстаткиТоваровВКонтейнере);
	Иначе
		ОстаткиТоваровВКонтейнере = Новый Массив;
	КонецЕсли;
	
	Возврат ОстаткиТоваровВКонтейнере;
	
КонецФункции    

Функция ПроверитьОстаткиТоваровВКонтейнереНаЯчейке(Процессор, СтрокаИнструкции, ЯчейкаСписания, Контейнер) 
	//ТУ_Прошин_26.05.26+
	ИК = Процессор.ОбщиеМодули.ИндексированиеКоллекций;
	РК = вмс_работаСКоллекциями;
	
	ОстаткиТоваровВКонтейнерах = Процессор.Данные.ОстаткиТоваровВЯчейках;   
	Вектор = Новый Массив;    
	
	Для Каждого ТоварноеПоле Из Процессор.ТоварныеПоляМассив Цикл
		Вектор.Добавить(СтрокаИнструкции[ТоварноеПоле]);	
	КонецЦикла;  
	
	ИндексОстаткиТоваровВЯчейке = ИК.НайтиИндекс(ОстаткиТоваровВКонтейнерах, Вектор);
	Если ИндексОстаткиТоваровВЯчейке = Неопределено Тогда       
		Возврат Ложь;
	КонецЕсли;
	
	ОстаткиТоваровВЯчейке = ИК.ПолучитьДанныеИндекса(ИндексОстаткиТоваровВЯчейке);
	РК.УдалитьДублиВМассиве(ОстаткиТоваровВЯчейке);
	Если ОстаткиТоваровВЯчейке.Количество() = 0 Тогда     
		Возврат Ложь;	
	КонецЕсли;
	
	Для Каждого Строка Из ОстаткиТоваровВЯчейке Цикл
		Если Строка.Ячейка = ЯчейкаСписания И Строка.Контейнер = Контейнер Тогда
			Возврат Истина;		
		КонецЕсли;		
	КонецЦикла;
		
	Возврат Ложь;

	//ТУ_Прошин_26.05.26-
КонецФункции 

Функция ПолучитьЯчейкуКонтейнераПоОстаткамТоваровВЯчейке(Процессор, СтрокаИнструкции, Контейнер)
	ИК = Процессор.ОбщиеМодули.ИндексированиеКоллекций;
	РК = вмс_работаСКоллекциями;
	
	ОстаткиТоваровВКонтейнерах = Процессор.Данные.ОстаткиТоваровВЯчейках;   
	Вектор = Новый Массив;    
	
	Для Каждого ТоварноеПоле Из Процессор.ТоварныеПоляМассив Цикл
		Вектор.Добавить(СтрокаИнструкции[ТоварноеПоле]);	
	КонецЦикла;  
	
	ИндексОстаткиТоваровВЯчейке = ИК.НайтиИндекс(ОстаткиТоваровВКонтейнерах, Вектор);
	Если ИндексОстаткиТоваровВЯчейке = Неопределено Тогда       
		Возврат Неопределено;
	КонецЕсли;
	
	ОстаткиТоваровВЯчейке = ИК.ПолучитьДанныеИндекса(ИндексОстаткиТоваровВЯчейке);
	РК.УдалитьДублиВМассиве(ОстаткиТоваровВЯчейке);
	Если ОстаткиТоваровВЯчейке.Количество() = 0 Тогда     
		Возврат Неопределено;	
	КонецЕсли;
	
	Отбор = Новый Структура("Контейнер", Контейнер);
	СтрокаОстатка = РК.НайтиЭлементКоллекции(ОстаткиТоваровВЯчейке, Отбор);  
	Если ЗначениеЗаполнено(СтрокаОстатка) Тогда
		Возврат СтрокаОстатка.Ячейка
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

Функция ПрименитьДвиженияРегистровКДанным(Процессор, ДвиженияРегистров)
	
	ПрименитьДвиженияРегистраОстаткиТоваровВЯчейках(Процессор, ДвиженияРегистров);
	
	ПрименитьДвиженияРегистраОстаткиТоваровВКонтейнерах(Процессор, ДвиженияРегистров);
	
	ПрименитьДвиженияРегистраМестоположенияКонтейнеров(Процессор, ДвиженияРегистров);
	
КонецФункции

Функция ПрименитьДвиженияРегистраОстаткиТоваровВЯчейках(Процессор, ДвиженияРегистров)
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	
	Для Каждого СтрокаДвижения Из ДвиженияРегистров.ОстаткиТоваровВЯчейках Цикл
		ЭтоПриход = СтрокаДвижения.ВидДвижения=ВидДвиженияНакопления.Приход;
		КоличествоОборот = ?(ЭтоПриход, СтрокаДвижения.Количество, -СтрокаДвижения.Количество);
		Индекс = НайтиИндекс(Процессор, "ОстаткиТоваровВЯчейках", СтрокаДвижения);
		Если Индекс=Неопределено Тогда
			КоличествоОстаток = 0;
			ЭлементДанныхОстатков = НовыйЭлементДанных(Процессор, "ОстаткиТоваровВЯчейках", СтрокаДвижения);
			ЭлементДанныхОстатков.Количество = КоличествоОборот;
			
			ДанныеДляЗагрузки = Новый Массив;
			ДанныеДляЗагрузки.Добавить(ЭлементДанныхОстатков);
			ВставитьДанныеВИндекс(Процессор, "ОстаткиТоваровВЯчейках", ДанныеДляЗагрузки);
		Иначе
			ЭлементДанныхОстатков = Индекс.Данные[0];
			КоличествоОстаток = ЭлементДанныхОстатков.Количество;
			ЭлементДанныхОстатков.Количество = ЭлементДанныхОстатков.Количество + КоличествоОборот;
		КонецЕсли;
		
		Если НЕ ЭтоПриход И СтрокаДвижения.Количество > 0 И КоличествоОстаток < СтрокаДвижения.Количество Тогда
			ДобавитьОшибкуПроведения(Процессор, СтрокаДвижения, "недостаточно остатка - доступный остаток: " + КоличествоОстаток);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ПрименитьДвиженияРегистраОстаткиТоваровВКонтейнерах(Процессор, ДвиженияРегистров)
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	ИмяРегистра = "ОстаткиТоваровВКонтейнерах";
	
	ДанныеДляЗагрузки = Новый Массив;
	Для Каждого СтрокаДвижения Из ДвиженияРегистров[ИмяРегистра] Цикл
		ЭтоПриход = СтрокаДвижения.ВидДвижения=ВидДвиженияНакопления.Приход;
		КоличествоОборот = ?(ЭтоПриход, СтрокаДвижения.Количество, -СтрокаДвижения.Количество);
		Индекс = НайтиИндекс(Процессор, ИмяРегистра, СтрокаДвижения);
		Если Индекс=Неопределено Тогда
			КоличествоОстаток = 0;
			ЭлементДанныхОстатков = НовыйЭлементДанных(Процессор, ИмяРегистра, СтрокаДвижения);
			ЭлементДанныхОстатков.Количество = КоличествоОборот;
			ДанныеДляЗагрузки.Добавить(ЭлементДанныхОстатков);
		Иначе
			ЭлементДанныхОстатков = Индекс.Данные[0];
			КоличествоОстаток = ЭлементДанныхОстатков.Количество;
			ЭлементДанныхОстатков.Количество = ЭлементДанныхОстатков.Количество + КоличествоОборот;
		КонецЕсли;
		
		Если НЕ ЭтоПриход И СтрокаДвижения.Количество > 0 И КоличествоОстаток < СтрокаДвижения.Количество Тогда
			ДобавитьОшибкуПроведения(Процессор, СтрокаДвижения, "недостаточно остатка в контейнере");
		КонецЕсли;
		
	КонецЦикла;
	
	ВставитьДанныеВИндекс(Процессор, ИмяРегистра, ДанныеДляЗагрузки);
	
КонецФункции

Функция ПрименитьДвиженияРегистраМестоположенияКонтейнеров(Процессор, ДвиженияРегистров)
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	ИмяРегистра = "МестоположенияКонтейнеров";
	
	ДанныеДляЗагрузки = Новый Массив;
	Для Каждого СтрокаДвижения Из ДвиженияРегистров[ИмяРегистра] Цикл
		
		Индекс = НайтиИндекс(Процессор, ИмяРегистра, СтрокаДвижения);
		Если Индекс=Неопределено Тогда
			ЭлементДанныхОстатков = НовыйЭлементДанных(Процессор, ИмяРегистра, СтрокаДвижения);
			ДанныеДляЗагрузки.Добавить(ЭлементДанныхОстатков);
		Иначе
			ЭлементДанныхОстатков = Индекс.Данные[0];
			ЗаполнитьЗначенияСвойств(ЭлементДанныхОстатков, СтрокаДвижения);
		КонецЕсли;
		
	КонецЦикла;
	
	ВставитьДанныеВИндекс(Процессор, ИмяРегистра, ДанныеДляЗагрузки);
	
КонецФункции

Функция ДобавитьОшибкуПроведения(Процессор, СтрокаДвижения, ТекстОшибки)
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	
	Процессор.Отказ = Истина;
	
	ЭлементОшибки = РК.ДобавитьЭлементКоллекции(Процессор.Ошибки); 
	ЭлементОшибки.НомерСтроки = СтрокаДвижения.НомерСтрокиДокумента;
	ЭлементОшибки.Текст = ТекстОшибки;
	
КонецФункции

Функция ПоказатьОшибкиПроведения(Процессор)
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	
	ТекстОшибки = "";
	
	#Если НЕ Клиент Тогда
		Для Каждого ЭлементОшибки Из РК.ПолучитьЭлементыКоллекции(Процессор.Ошибки) Цикл
			ТекстОшибкиСтроки = "Номер строки " + ЭлементОшибки.НомерСтроки + ": " + ЭлементОшибки.Текст;
			ТекстОшибки = ТекстОшибки + ТекстОшибкиСтроки +  Символы.ПС;
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибкиСтроки);
		КонецЦикла;
	#КонецЕсли
	
	Если ТипЗнч(Процессор.ДокументОперации)=Тип("ДокументСсылка.вмс_ОперацияПоЯчейкам") Тогда
		ОперацияПоЯчейкамОбъект = Процессор.ДокументОперации.ПолучитьОбъект();
	Иначе
		ОперацияПоЯчейкамОбъект = Процессор.ДокументОперации;
	КонецЕсли;
	
	ТекстОшибки = "Ошибка при проведении документа " + ОперацияПоЯчейкамОбъект + Символы.ПС + ТекстОшибки;
	ТекстОшибки = СокрЛП(ТекстОшибки);
	
	#Если НЕ Клиент Тогда
		Контекст = "";
		Контекст = Контекст + "Дата: " + ТекущаяДата() + Символы.ПС;
		Контекст = Контекст + ОперацияПоЯчейкамОбъект + Символы.ПС;
		Контекст = Контекст + ОперацияПоЯчейкамОбъект.ЗаданиеКладовщику;
		ТекстОшибки = ТекстОшибки + Символы.ПС + Символы.ПС + вмс_Журналирование.СериализоватьКонтекст(ОперацияПоЯчейкамОбъект);
		
		ПараметрыФоновогоЗадания = Новый Массив;
		ПараметрыФоновогоЗадания.Добавить(ТекстОшибки);
		ПараметрыФоновогоЗадания.Добавить(Контекст);
		ФоновыеЗадания.Выполнить("вмс_Журналирование.Ошибка", ПараметрыФоновогоЗадания);
	#КонецЕсли
	
КонецФункции

Функция ЗагрузитьОстатки(Процессор)
	
	Перем РК, ИК;
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	ИК = Процессор.ОбщиеМодули.ИндексированиеКоллекций;
	
	ТаблицаЗапросаОстатковТоваровВЯчейках = ПолучитьТаблицуДанных(Процессор, "ЗапросОстатковТоваровВЯчейках");
	ТаблицаЗапросаОстатковКонтейнеровВЯчейках = ПолучитьТаблицуДанных(Процессор, "ЗапросОстатковКонтейнеровВЯчейках");
	ТаблицаЗапросаОстатковТоваровВКонтейнерах = ПолучитьТаблицуДанных(Процессор, "ЗапросОстатковТоваровВКонтейнерах");
	ТаблицаЗапросаМестоположенийКонтейнеров = ПолучитьТаблицуДанных(Процессор, "ЗапросМестоположенийКонтейнеров");
	Если РК.ПолучитьЭлементыКоллекции(ТаблицаЗапросаОстатковТоваровВЯчейках).Количество()=0
		И РК.ПолучитьЭлементыКоллекции(ТаблицаЗапросаОстатковКонтейнеровВЯчейках).Количество()=0
		И РК.ПолучитьЭлементыКоллекции(ТаблицаЗапросаОстатковТоваровВКонтейнерах).Количество()=0
		И РК.ПолучитьЭлементыКоллекции(ТаблицаЗапросаМестоположенийКонтейнеров).Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Структура;
	Запрос.Вставить("ТаблицаЗапросаОстатковТоваровВЯчейках", ТаблицаЗапросаОстатковТоваровВЯчейках);
	Запрос.Вставить("ТаблицаЗапросаОстатковКонтейнеровВЯчейках", ТаблицаЗапросаОстатковКонтейнеровВЯчейках);
	Запрос.Вставить("ТаблицаЗапросаОстатковТоваровВКонтейнерах", ТаблицаЗапросаОстатковТоваровВКонтейнерах);
	Запрос.Вставить("ТаблицаЗапросаМестоположенийКонтейнеров", ТаблицаЗапросаМестоположенийКонтейнеров);
	Результат = ПолучитьДанныеИзБД(Процессор, Запрос);
	
	// остатки в ячейках
	ЗагрузитьДанныеВИндекс(Процессор, "ОстаткиТоваровВЯчейках", Результат.ТаблицаОстатковТоваровВЯчейках);
	// Добавим в кэш нулевые остатки, чтобы понимать, что по этим данным уже делался запрос
	ДанныеПоЗапросамОстатковВЯчейках = ИК.ПолучитьДанныеИндекса(Процессор.Данные.ЗапросОстатковТоваровВЯчейках);
	ВставитьДанныеВИндекс(Процессор, "ОстаткиТоваровВЯчейках", ДанныеПоЗапросамОстатковВЯчейках, "ТолькоНовые");
	
	// остатки в контейнерах
	Если Результат.ТаблицаОстатковТоваровВКонтейнерах <> Неопределено Тогда
		ЗагрузитьДанныеВИндекс(Процессор, "ОстаткиТоваровВКонтейнерах", Результат.ТаблицаОстатковТоваровВКонтейнерах);
	КонецЕсли;
	
	// Местоположения контейнеров
	Если Результат.ТаблицаМестоположенийКонтейнеров <> Неопределено Тогда
		ЗагрузитьДанныеВИндекс(Процессор, "МестоположенияКонтейнеров", Результат.ТаблицаМестоположенийКонтейнеров);
		ДанныеПоМестоположенияКонтейнеров = ИК.ПолучитьДанныеИндекса(Процессор.Данные.ЗапросМестоположенийКонтейнеров);
		ВставитьДанныеВИндекс(Процессор, "МестоположенияКонтейнеров", ДанныеПоМестоположенияКонтейнеров, "ТолькоНовые");
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеИзБД(Процессор, Запрос)
	
	ОН = Процессор.ОбщиеМодули.ОбщегоНазначения;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДокументОперации", Процессор.ДокументОперации);
	ДополнительныеПараметры.Вставить("Дата", Процессор.Дата);
	
	Если ОН.ЭтоБэкенд() Тогда
		#Если Клиент И НЕ ТолстыйКлиентОбычноеПриложение И НЕ ТолстыйКлиентУправляемоеПриложение Тогда
			УО = Процессор.ОбщиеМодули.УправлениеОстаткамиНовыйВызовСервера;
		#Иначе
			УО = Процессор.ОбщиеМодули.УправлениеОстаткамиНовыйСервер;
		#КонецЕсли
		
		Результат = УО.ПолучитьДанныеИзБД(Запрос, ДополнительныеПараметры);
	Иначе
		
		ОКИС = Вычислить("ОбращенияКИСКлиентСервер");
		Результат = ОКИС.ВыполнитьМетодОсновнойБД("вмс_УправлениеОстаткамиНовыйСервер");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуДанных(Процессор, ИмяТаблицы) Экспорт

	Перем РК, ИК;
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	ИК = Процессор.ОбщиеМодули.ИндексированиеКоллекций;
	
	Индекс = Процессор.Данные[ИмяТаблицы];

	ДанныеОстатков = ИК.ПолучитьДанныеИндекса(Индекс);
	РК.УдалитьДублиВМассиве(ДанныеОстатков);
	
	ТаблицаДанных = РК.НоваяКоллекцияЗначений(Индекс.ДополнительныеДанные.ВсеПоля);
	РК.ДобавитьЭлементыКоллекции(ТаблицаДанных, ДанныеОстатков);
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция СлияниеКонтейнеровДоступно(Процессор, СтрокаИнструкции, ПустойКонтейнер, ПустаяЯчейка)    
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	
	ОтборСтрокиИнструкции = Новый Структура("НомерСтрокиДокумента", СтрокаИнструкции.НомерСтрокиДокумента);
	ЗаполнитьЗначенияСвойств(ОтборСтрокиИнструкции, СтрокаИнструкции);
	СтрокаИнструкциДокумента = РК.НайтиЭлементКоллекции(Процессор.ТаблицаИнструкций, ОтборСтрокиИнструкции);	
	
	Если ЗначениеЗаполнено(СтрокаИнструкциДокумента.ЯчейкаОтправитель) И НЕ ЗначениеЗаполнено(СтрокаИнструкциДокумента.ЯчейкаПриемник) Тогда
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Выполнять слияние контейнеров при этом списывать контейнер с ячейки запрещено!",));
		Возврат Ложь; 	
	КонецЕсли;    
	
	Если НЕ ЗначениеЗаполнено(СтрокаИнструкциДокумента.ЯчейкаОтправитель) И ЗначениеЗаполнено(СтрокаИнструкциДокумента.ЯчейкаПриемник) Тогда
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Выполнять слияние контейнеров при этом приходовать контейнер на ячейку запрещено!",));
		Возврат Ложь; 	
	КонецЕсли;  
	
	Если СтрокаИнструкциДокумента.ЯчейкаОтправитель <> СтрокаИнструкциДокумента.ЯчейкаПриемник Тогда
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Выполнять слияние контейнеров, которые находятся на разных ячейках запрещено!",));
		Возврат Ложь; 	
	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаИнструкциДокумента.Товар) Тогда 
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Выполнять слияние контейнеров, во время пересчета товара запрещено!",));
		Возврат Ложь;
	КонецЕсли;  
	
	Если СтрокаИнструкциДокумента.Контейнер = СтрокаИнструкциДокумента.КонтейнерПриемник Тогда  
		ДобавитьОшибкуПроведения(Процессор, СтрокаИнструкции,
		СтрШаблон("Заполнение полей некорректно! Контейнер и Контейнер-приемник один и тот же контейнер!",));
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
КонецФункции

