Функция ДобавитьИндекс(Процессор, ИмяИндекса, знач ПоляИндексирования, знач ПоляИтогов)
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	ИК = Процессор.ОбщиеМодули.ИндексированиеКоллекций;
	
	ПоляИндексированияМассив = РК.ЗначениеВМассив(ПоляИндексирования, , Ложь);
	ПоляИндексирования = РК.МассивВСтроку(ПоляИндексированияМассив);
	
	ПоляИтоговМассив = РК.ЗначениеВМассив(ПоляИтогов, , Ложь);
	ПоляИтогов = РК.МассивВСтроку(ПоляИтоговМассив);
	
	ВсеПоляМассив = РК.СложениеМассивов(ПоляИндексированияМассив, ПоляИтоговМассив);
	ВсеПоля = РК.МассивВСтроку(ВсеПоляМассив);
	
	Индекс = ИК.НовыйИндекс();
	Индекс.ДополнительныеДанные.Вставить("ПоляИндексирования", ПоляИндексирования);
	Индекс.ДополнительныеДанные.Вставить("ПоляИндексированияМассив", ПоляИндексированияМассив);
	Индекс.ДополнительныеДанные.Вставить("ПоляИтоговМассив", ПоляИтоговМассив);
	Индекс.ДополнительныеДанные.Вставить("ПоляИтогов", ПоляИтогов);
	Индекс.ДополнительныеДанные.Вставить("ВсеПоляМассив", ВсеПоляМассив);
	Индекс.ДополнительныеДанные.Вставить("ВсеПоля", ВсеПоля);
	
	Процессор.Данные.Вставить(ИмяИндекса, Индекс);
	
	Возврат Индекс;
	
КонецФункции

Функция ДобавитьВИндексКомбинацииСПустымиЗначениямиПолей(Процессор, ИмяИндекса, ПоляКомбинацииСПустымиЗначениям, ПустыеЗначенияПолей)

	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	
	Индекс = Процессор.Данные[ИмяИндекса];
	ПоляИндексированияМассив = Индекс.ДополнительныеДанные.ПоляИндексированияМассив;
	
	ПоляКомбинацииСПустымиЗначениямМассив = РК.ЗначениеВМассив(ПоляКомбинацииСПустымиЗначениям);
	КоличествоПолейКомбинацииСПустымиЗначениями = ПоляКомбинацииСПустымиЗначениямМассив.Количество();
	НомераРазрядов = Новый Соответствие;
	Для НомерРазряда=0 По КоличествоПолейКомбинацииСПустымиЗначениями-1 Цикл
		Поле = ПоляКомбинацииСПустымиЗначениямМассив[НомерРазряда];
		НомераРазрядов[Поле] = НомерРазряда;
	КонецЦикла;
	
	Если ПоляИндексированияМассив.Количество() > ПоляКомбинацииСПустымиЗначениямМассив.Количество() Тогда
		// для оставшихся полей индексирования также нужно сделать комбинацию с пустыми значениями,
		// но это комбинация будет общей для всех таких полей
		ПоляОбщейКомбинации = РК.ВычитаниеМассивов(ПоляИндексированияМассив, ПоляКомбинацииСПустымиЗначениямМассив);
		Для Каждого Поле Из ПоляОбщейКомбинации Цикл
			НомераРазрядов[Поле] = НомерРазряда;
		КонецЦикла;

		КоличествоПолейКомбинацииСПустымиЗначениями = КоличествоПолейКомбинацииСПустымиЗначениями + 1;
	КонецЕсли;
	
	КоличествоКомбинаций = pow(2, КоличествоПолейКомбинацииСПустымиЗначениями) - 1; // "-1" так, как комбинация со всеми пустыми полями не имеет смысла
	
	СоответствиеЗначенийПустыхПолей = Новый Соответствие;
	Если ТипЗнч(ПустыеЗначенияПолей)=Тип("Структура") Тогда
		Для Каждого ПустоеЗначениеПоля Из ПустыеЗначенияПолей Цикл
			СоответствиеЗначенийПустыхПолей[ПустоеЗначениеПоля.Ключ] = ПустоеЗначениеПоля.Значение;
		КонецЦикла;
	КонецЕсли;
	
	Индекс.ДополнительныеДанные.Вставить("СоответствиеЗначенийПустыхПолей", СоответствиеЗначенийПустыхПолей);
	
	Комбинации = Новый Массив;
	
	Для НомерКомбинации=0 По КоличествоКомбинаций-1 Цикл

		КомбинацияПустыхПолей = РК.РазложитьЧислоНаРазряды(НомерКомбинации, 2, КоличествоПолейКомбинацииСПустымиЗначениями);
		
		Комбинация = Новый Массив;
		Для Каждого Поле Из ПоляИндексированияМассив Цикл
			РазрядКомбинации = НомераРазрядов[Поле];
			Комбинация.Добавить(КомбинацияПустыхПолей[РазрядКомбинации]);
		КонецЦикла;
		
		Комбинации.Добавить(Комбинация);
		
	КонецЦикла;
	
	Индекс.ДополнительныеДанные.Вставить("КомбинацииСПустымиЗначениямиПолей", Комбинации);

КонецФункции

Функция НовыйЭлементДанных(Процессор, ИмяИндекса, ДанныеДляЗаполнения=Неопределено)
	
	Индекс = Процессор.Данные[ИмяИндекса];
	
	ЭлементДанных = Новый Структура(Индекс.ДополнительныеДанные.ВсеПоля);
	
	Если ДанныеДляЗаполнения <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭлементДанных, ДанныеДляЗаполнения);
	КонецЕсли;
	
	ЗначенияНенайденныхДанных = Неопределено;
	Индекс.ДополнительныеДанные.Свойство("ЗначенияНенайденныхДанных", ЗначенияНенайденныхДанных);
	Если ЗначенияНенайденныхДанных <> Неопределено Тогда
		// Если данные по запросу не будут найдены, то подставятся ЗначенияНенайденныхДанных
		ЗаполнитьЗначенияСвойств(ЭлементДанных, ЗначенияНенайденныхДанных);
	КонецЕсли;
	
	Возврат ЭлементДанных;
	
КонецФункции

Функция ЗагрузитьДанныеВИндекс(Процессор, ИмяИндекса, Данные)
	
	РК = Процессор.ОбщиеМодули.РаботаСКоллекциями;
	ИК = Процессор.ОбщиеМодули.ИндексированиеКоллекций;

	Индекс = Процессор.Данные[ИмяИндекса];
	ПоляЭлемента = Индекс.ДополнительныеДанные.ВсеПоля;
	
	ДанныеДляЗагрузки = Новый Массив;
	Для Каждого ЭлементДанных Из РК.ПолучитьЭлементыКоллекции(Данные) Цикл
		ЭлементДанныхДляЗагрузки = Новый Структура(ПоляЭлемента);
		ЗаполнитьЗначенияСвойств(ЭлементДанныхДляЗагрузки, ЭлементДанных);
		ДанныеДляЗагрузки.Добавить(ЭлементДанныхДляЗагрузки);
	КонецЦикла;
	
	ВставитьДанныеВИндекс(Процессор, ИмяИндекса, ДанныеДляЗагрузки, "Замещать");
	
КонецФункции

Функция ВставитьЭлементДанныхВИндекс(Процессор, ИмяИндекса, ЭлементДанных, РежимВставки="Замещать")
	
	Данные = Новый Массив;
	Данные.Добавить(ЭлементДанных);
	ВставитьДанныеВИндекс(Процессор, ИмяИндекса, Данные, РежимВставки);
	
КонецФункции

Функция ВставитьДанныеВИндекс(Процессор, ИмяИндекса, знач Данные, РежимВставки="Замещать")
	
	ИК = Процессор.ОбщиеМодули.ИндексированиеКоллекций;
	
	Индекс = Процессор.Данные[ИмяИндекса];
	ПоляИндексированияМассив = Индекс.ДополнительныеДанные.ПоляИндексированияМассив;

	Если Индекс.ДополнительныеДанные.Свойство("КомбинацииСПустымиЗначениямиПолей") Тогда
		КомбинацииСПустымиЗначениямиПолей = Индекс.ДополнительныеДанные.КомбинацииСПустымиЗначениямиПолей;
		СоответствиеЗначенийПустыхПолей = Индекс.ДополнительныеДанные.СоответствиеЗначенийПустыхПолей;
		НомерПоследнегоПоляИндексирования = ПоляИндексированияМассив.Количество()-1;

		ЗначенияПустыхПолейМассив = Новый Массив;
		Для Каждого Поле Из ПоляИндексированияМассив Цикл
			ЗначенияПустыхПолейМассив.Добавить(СоответствиеЗначенийПустыхПолей[Поле]);
		КонецЦикла;
		
		ВекторизированныеДанныеДляЗагрузки = Новый Массив;
		Для Каждого ЭлементДанныхДляЗагрузки Из Данные Цикл
			ДанныеЭлементаМассив = Новый Массив;
			Для Каждого Поле Из ПоляИндексированияМассив Цикл
				ДанныеЭлементаМассив.Добавить(ЭлементДанныхДляЗагрузки[Поле]);
			КонецЦикла;
			
			Для Каждого Комбинация Из КомбинацииСПустымиЗначениямиПолей Цикл
				Вектор = Новый Массив;
				ДополнительныеКлючиВектора = Новый Массив;
				Для НомерПоля=0 По НомерПоследнегоПоляИндексирования Цикл
					Если Комбинация[НомерПоля]=1 Тогда
						ЗначениеПоля = ЗначенияПустыхПолейМассив[НомерПоля];
						Если ЗначениеПоля <> ДанныеЭлементаМассив[НомерПоля] Тогда
							ДополнительныеКлючиВектора.Добавить(ДанныеЭлементаМассив[НомерПоля]);
						КонецЕсли;
					Иначе
						ЗначениеПоля = ДанныеЭлементаМассив[НомерПоля];
					КонецЕсли;
					Вектор.Добавить(ЗначениеПоля);
				КонецЦикла;
				
				Для Каждого Ключ Из ДополнительныеКлючиВектора Цикл
					Вектор.Добавить(Ключ);
				КонецЦикла;
				
				ЭлементВекторизированныхДанныхДляЗагрузки = Новый Структура("Вектор, ЭлементДанных", Вектор, ЭлементДанныхДляЗагрузки);
				ВекторизированныеДанныеДляЗагрузки.Добавить(ЭлементВекторизированныхДанныхДляЗагрузки);
			КонецЦикла;
		КонецЦикла;

		ИК.ВставитьДанныеВИндекс(Индекс, ВекторизированныеДанныеДляЗагрузки, РежимВставки);
	Иначе
		ВекторизированныеДанныеДляЗагрузки = ИК.ВекторизироватьТаблицу(Данные, ПоляИндексированияМассив);
		ИК.ВставитьДанныеВИндекс(Индекс, ВекторизированныеДанныеДляЗагрузки, РежимВставки);
	КонецЕсли;
	
КонецФункции

Функция НайтиИндекс(Процессор, ИмяИндекса, КлючиДанных)
	
	ИК = Процессор.ОбщиеМодули.ИндексированиеКоллекций;
	
	НачальныйИндекс = Процессор.Данные[ИмяИндекса];
	
	Вектор = ИК.НовыйВектор(КлючиДанных, НачальныйИндекс.ДополнительныеДанные.ПоляИндексированияМассив);
	
	Индекс = ИК.НайтиИндекс(НачальныйИндекс, Вектор);

	Возврат Индекс;

КонецФункции

Функция ПолучитьДанныеИндексаБезИтогов(Индекс)

	Если НЕ Индекс.ДополнительныеДанные.Свойство("ПоляИндексированияМассив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КоличествоПолейИндексирования = Индекс.ДополнительныеДанные.ПоляИндексированияМассив.Количество();
	
	Возврат ПолучитьДанныеИндекса(Индекс, КоличествоПолейИндексирования);
	
КонецФункции

Функция ПолучитьДанныеИндекса(знач Индекс, МаксГлубина=-1)
	
	Данные = Новый Массив;
	
	Если Индекс=Неопределено Тогда
		Возврат Данные;
	КонецЕсли;
	
	ОбходИндексов = Новый Массив;
	ОбходИндексов.Добавить(Индекс);
	
	Уровень = 0;
	Пока ОбходИндексов.Количество() > 0 Цикл
		
		ОбходИндексовСледующийУровень = Новый Массив;
		
		Для Каждого Индекс Из ОбходИндексов Цикл
			
			Для Каждого ЭлементДанных Из Индекс.Данные Цикл
				Данные.Добавить(ЭлементДанных);
			КонецЦикла;
			
			Если Индекс.ИндексДляНеопределено <> Неопределено Тогда
				ОбходИндексовСледующийУровень.Добавить(Индекс.ИндексДляНеопределено);
			КонецЕсли;
			
			Для Каждого ЭлементВложенногоИндекса Из Индекс.ИндексыПоКлючу Цикл
				ОбходИндексовСледующийУровень.Добавить(ЭлементВложенногоИндекса.Значение);
			КонецЦикла;
			
		КонецЦикла;
		
		ОбходИндексов = ОбходИндексовСледующийУровень;
		
		Если Уровень=МаксГлубина Тогда
			Прервать;
		КонецЕсли;
		
		Уровень = Уровень + 1;
		
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

