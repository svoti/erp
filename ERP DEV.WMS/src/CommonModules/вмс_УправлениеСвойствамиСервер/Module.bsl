Функция глОбщийМодуль(ИмяМодуля)
	Возврат вмс_ОбщегоНазначенияКлиентСервер.ОбщийМодуль(ИмяМодуля);
КонецФункции

Функция ИнициализироватьДополнительныеРеквизиты(Форма, Объект, знач ВладелецДополнительныхРеквизитов=Неопределено, ГруппаДополнительныхРеквизитов=Неопределено)
	
	Перем РаботаСФормамиСервер;
	
	Если глОбщийМодуль("УправлениеСвойствамиКлиентСервер").ДополнительныеРеквизитыИнициализированы(Форма) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Форма) <> Тип("ФормаКлиентскогоПриложения") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РаботаСФормамиСервер = глОбщийМодуль("РаботаСФормамиСервер");
	
	Если РаботаСФормамиСервер.НайтиРеквизит(Форма, "ИнформацияОДополнительныхРеквизитов") = Неопределено Тогда
		Если ВладелецДополнительныхРеквизитов=Неопределено Тогда
			ВладелецДополнительныхРеквизитов = Объект.Ссылка;
		КонецЕсли;
		
		ИнформацияОДополнительныхРеквизитов = Новый Структура;
		ИнформацияОДополнительныхРеквизитов.Вставить("ИмяГруппыДополнительныхРеквизитов", ПолучитьИмяГруппыДополнительныхРеквизитов(Форма, ГруппаДополнительныхРеквизитов));
		ИнформацияОДополнительныхРеквизитов.Вставить("Владелец", ВладелецДополнительныхРеквизитов);
		
		МассивНовыхРеквизитов = Новый Массив;
		МассивНовыхРеквизитов.Добавить(Новый РеквизитФормы("ИнформацияОДополнительныхРеквизитов", Новый ОписаниеТипов));
		Форма.ИзменитьРеквизиты(МассивНовыхРеквизитов);
		
		Форма.ИнформацияОДополнительныхРеквизитов = ИнформацияОДополнительныхРеквизитов;
	КонецЕсли;
		
	Если РаботаСФормамиСервер.НайтиРеквизит(Форма, "ТаблицаДополнительныхРеквизитов") = Неопределено Тогда
		РаботаСФормамиСервер.СоздатьТаблицуФормы(Форма, "ТаблицаДополнительныхРеквизитов", "Свойство, ИмяЭлемента, ИмяРеквизита, ТипЗначенияСвойства");
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьИмяГруппыДополнительныхРеквизитов(Форма, пГруппаДополнительныхРеквизитов=Неопределено) Экспорт
	
	Перем ГруппаДополнительныхРеквизитов;
	
	Если пГруппаДополнительныхРеквизитов <> Неопределено Тогда
		Если ТипЗнч(пГруппаДополнительныхРеквизитов) = Тип("Строка") Тогда
			Если Форма.Элементы.Найти(пГруппаДополнительныхРеквизитов) <> Неопределено Тогда
				ГруппаДополнительныхРеквизитов = пГруппаДополнительныхРеквизитов;
			КонецЕсли;
		Иначе
			ГруппаДополнительныхРеквизитов = пГруппаДополнительныхРеквизитов.Имя;
		КонецЕсли;
	КонецЕсли;
	
	Если ГруппаДополнительныхРеквизитов = Неопределено Тогда
		ГруппаДополнительныхРеквизитов = "ГруппаДополнительныхРеквизитов";
		ЭлементГруппы = Форма.Элементы.Добавить(ГруппаДополнительныхРеквизитов, Тип("ГруппаФормы"));
		ЭлементГруппы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ЭлементГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ЭлементГруппы.ОтображатьЗаголовок = Ложь;
		ЭлементГруппы.Отображение = ОтображениеОбычнойГруппы.Нет;
	КонецЕсли;
	
	Возврат ГруппаДополнительныхРеквизитов;
	
КонецФункции

Функция ПолучитьТаблицуДополнительныхРеквизитовОбъекта(Объект) Экспорт
	
	Возврат ПолучитьТаблицуДополнительныхРеквизитовОбъектов(Объект);
	
КонецФункции
	
Функция ПолучитьТаблицуДополнительныхРеквизитовОбъектов(Объекты) Экспорт
	
	Запрос = ПолучитьЗапросПоДополнительнымРеквизитамОбъектов(Объекты);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаСвойств = РезультатЗапроса.Выгрузить();
	ТаблицаСвойств.Сортировать("Номер");
	
	Возврат ТаблицаСвойств;
	
КонецФункции

Функция ПолучитьЗапросПоДополнительнымРеквизитамОбъектов(Объекты, ИмяВременнойТаблицы=Неопределено) Экспорт

	Перем РК, ОбщегоНазначенияСервер;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	ОбщегоНазначенияСервер = глОбщийМодуль("ОбщегоНазначенияСервер");
	
	МассивОбъектов = РК.ЗначениеВМассив(Объекты, , Ложь);
	
	Запрос = Справочники.вмс_НаборыДополнительныхРеквизитов.ПолучитьЗапросПоНаборамОбъектов(МассивОбъектов, "НаборыСвойствОбъектов");
	ТекстЗапроса = Запрос.Текст;
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + ";" + Символы.ПС + Символы.ПС;
	ТекстЗапроса = ТекстЗапроса +
	"ВЫБРАТЬ
	|	НаборыСвойствОбъектов.Объект КАК Объект,
	|	МИНИМУМ(вмс_НаборыДополнительныхРеквизитовДополнительныеРеквизиты.НомерСтроки) КАК Номер,
	|	вмс_ДополнительныеРеквизиты.Ссылка КАК Свойство
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	НаборыСвойствОбъектов КАК НаборыСвойствОбъектов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.вмс_НаборыДополнительныхРеквизитов.ДополнительныеРеквизиты КАК вмс_НаборыДополнительныхРеквизитовДополнительныеРеквизиты
	|		ПО НаборыСвойствОбъектов.Набор = вмс_НаборыДополнительныхРеквизитовДополнительныеРеквизиты.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.вмс_ДополнительныеРеквизиты КАК вмс_ДополнительныеРеквизиты
	|		ПО (вмс_НаборыДополнительныхРеквизитовДополнительныеРеквизиты.Свойство = вмс_ДополнительныеРеквизиты.Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	НаборыСвойствОбъектов.Объект,
	|	вмс_ДополнительныеРеквизиты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Объект КАК Объект,
	|	ВТ.Номер КАК Номер,
	|	ВТ.Свойство КАК Свойство,
	|	ВТ.Свойство.Имя КАК Имя,
	|	ВТ.Свойство.Наименование КАК Представление,
	|	ВТ.Свойство.ТипЗначения КАК ТипЗначения
	|ПОМЕСТИТЬ Свойства
	|ИЗ
	|	ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	NULL КАК Объект,
	|	NULL КАК Свойство,
	|	0 КАК Значение
	|ПОМЕСТИТЬ ЗначенияСвойств
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Свойства.Объект КАК Объект,
	|	Свойства.Свойство КАК Свойство,
	|	Свойства.Номер КАК Номер,
	|	Свойства.Имя КАК ИмяСвойства,
	|	Свойства.Представление КАК ПредставлениеСвойства,
	|	Свойства.ТипЗначения КАК ТипЗначенияСвойства,
	|	ЗначенияСвойств.Значение КАК ЗначениеСвойства,
	|	&ИмяВременнойТаблицы КАК ИмяВременнойТаблицы
	|ИЗ
	|	Свойства КАК Свойства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗначенияСвойств КАК ЗначенияСвойств
	|		ПО Свойства.Объект = ЗначенияСвойств.Объект
	|			И Свойства.Свойство = ЗначенияСвойств.Свойство";
	
	Привязка = "," + Символы.ПС + Символы.Таб + "&ИмяВременнойТаблицы КАК ИмяВременнойТаблицы";
	Если ЗначениеЗаполнено(ИмяВременнойТаблицы) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Привязка, Символы.ПС + "ПОМЕСТИТЬ " + ИмяВременнойТаблицы);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Привязка, "");
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////
	ТекстШаблонаЗапросаПоЗначениямСвойствОбъекта =
	"ВЫБРАТЬ
	|	ДополнительныеРеквизиты.Ссылка КАК Объект,
	|	ДополнительныеРеквизиты.Свойство КАК Свойство,
	|	ДополнительныеРеквизиты.Значение КАК Значение
	|ПОМЕСТИТЬ ЗначенияСвойств
	|ИЗ
	|	Справочник.вмс_Операции.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты
	|ГДЕ
	|	ДополнительныеРеквизиты.Ссылка В(&ВладелецДополнительныхРеквизитов)";
	
	НомерПараметра = 1;
	ПрефиксПараметра = "ВладелецДополнительныхРеквизитов";
	СвязкаТекстовЗапросов = "
	|
	|ОБЪЕДИНИТЬ
	|
	|";
	
	ТекстЗапросовПоЗначениямСвойствОбъектов = "";
	ТаблицаБлизостиЭлементов = Неопределено;
	Если Запрос.Параметры.Свойство("ТаблицаБлизостиЭлементов", ТаблицаБлизостиЭлементов) Тогда
		ТаблицаИменТиповОбъектов = ТаблицаБлизостиЭлементов.Скопировать();
		ТаблицаИменТиповОбъектов.Колонки.Элемент.Имя = "Объект";
		ТаблицаИменТиповОбъектов.Свернуть("Объект, ИмяТипа");
	Иначе
		ТаблицаИменТиповОбъектов = ОбщегоНазначенияСервер.ПолучитьТаблицуИменТиповОбъектов(МассивОбъектов);
	КонецЕсли;
	ТаблицаИменТипов = ТаблицаИменТиповОбъектов.Скопировать();
	ТаблицаИменТипов.Свернуть("ИмяТипа");
	Для Каждого СтрокаИмениТипа Из ТаблицаИменТипов Цикл
		ИмяТипаОбъекта = СтрокаИмениТипа.ИмяТипа;
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяТипаОбъекта);
		Если МетаданныеОбъекта = Неопределено ИЛИ Не Метаданные.Справочники.Содержит(МетаданныеОбъекта) И Не Метаданные.Документы.Содержит(МетаданныеОбъекта) И Не Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		
		МетаданныеТабличнойЧастиДополнительныеРеквизиты = МетаданныеОбъекта.ТабличныеЧасти.Найти("ДополнительныеРеквизиты");
		Если Не (МетаданныеТабличнойЧастиДополнительныеРеквизиты <> Неопределено И МетаданныеТабличнойЧастиДополнительныеРеквизиты.Реквизиты.Найти("Значение") <> Неопределено) Тогда
			Продолжить;
		КонецЕсли;
		СтрокиОбъектов = ТаблицаИменТиповОбъектов.НайтиСтроки(Новый Структура("ИмяТипа", ИмяТипаОбъекта));
		ОбъектыПоТипу = РК.ВыгрузитьЗначенияКолонкиКоллекции(СтрокиОбъектов, "Объект");
		НомерПараметраСтрока = Формат(НомерПараметра, "ЧГ=0");
		ИмяПараметра = ПрефиксПараметра + НомерПараметраСтрока;
		
		ТекстЗапросаПоЗначениямСвойствОбъекта = ТекстШаблонаЗапросаПоЗначениямСвойствОбъекта;
		ТекстЗапросаПоЗначениямСвойствОбъекта = СтрЗаменить(ТекстЗапросаПоЗначениямСвойствОбъекта, "Справочник.вмс_Операции", ИмяТипаОбъекта);
		ТекстЗапросаПоЗначениямСвойствОбъекта = СтрЗаменить(ТекстЗапросаПоЗначениямСвойствОбъекта, "&" + ПрефиксПараметра, "&" + ИмяПараметра);
		Если ТекстЗапросовПоЗначениямСвойствОбъектов <> "" Тогда
			ТекстЗапросовПоЗначениямСвойствОбъектов = ТекстЗапросовПоЗначениямСвойствОбъектов + СвязкаТекстовЗапросов;
			ТекстЗапросаПоЗначениямСвойствОбъекта = СтрЗаменить(ТекстЗапросаПоЗначениямСвойствОбъекта, "ПОМЕСТИТЬ ЗначенияСвойств" + Символы.ПС, "");
		КонецЕсли;
		ТекстЗапросовПоЗначениямСвойствОбъектов = ТекстЗапросовПоЗначениямСвойствОбъектов + ТекстЗапросаПоЗначениямСвойствОбъекта;
		Запрос.УстановитьПараметр(ИмяПараметра, ОбъектыПоТипу);
		НомерПараметра = НомерПараметра + 1;
	КонецЦикла;
	
	Если ТекстЗапросовПоЗначениямСвойствОбъектов <> "" Тогда
		ТекстЗапроса = РК.ВрезатьСтроку(ТекстЗапроса, Символы.ПС + Символы.ПС + ТекстЗапросовПоЗначениямСвойствОбъектов + Символы.ПС, "ПОМЕСТИТЬ ЗначенияСвойств", ";", ";");
	КонецЕсли;

	//////////////////////////////////////////////////////////////////////////////////////////////////////////
	Запрос.Текст = ТекстЗапроса;

	Возврат Запрос;
	
КонецФункции

Функция ОбновитьДополнительныеРеквизиты(Форма) Экспорт

	Перем УправлениеСвойствамиКлиентСервер, РаботаСФормамиКлиентСервер;
	
	УправлениеСвойствамиКлиентСервер = глОбщийМодуль("УправлениеСвойствамиКлиентСервер");
	РаботаСФормамиКлиентСервер = глОбщийМодуль("РаботаСФормамиКлиентСервер");
	
	Если Не УправлениеСвойствамиКлиентСервер.ДополнительныеРеквизитыИнициализированы(Форма) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОчиститьДополнительныеРеквизиты(Форма);
	
	ИнформацияОДополнительныхРеквизитов = Форма.ИнформацияОДополнительныхРеквизитов;
	ГруппаДополнительныхРеквизитов = Форма.Элементы.Найти(ИнформацияОДополнительныхРеквизитов.ИмяГруппыДополнительныхРеквизитов);
	ТаблицаДополнительныхРеквизитовФормы = Форма.ТаблицаДополнительныхРеквизитов;
	ТаблицаДополнительныхРеквизитов = ПолучитьТаблицуДополнительныхРеквизитовОбъектов(Форма.Объект);
	ТипБулево = Тип("Булево");
	
	НовыеРеквизиты = Новый Массив;
	Для Каждого СтрокаДополнительногоРеквизита Из ТаблицаДополнительныхРеквизитов Цикл
		ИмяЭлемента = РаботаСФормамиКлиентСервер.ПолучитьНовоеИмяЭлементаФормы(Форма, "ДополнительныеРеквизит");
		ТипыДополнительногоРеквизита = СтрокаДополнительногоРеквизита.ТипЗначенияСвойства.Типы();
		ЭлементДополнительногоРеквизита = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаДополнительныхРеквизитов);
		Если ТипыДополнительногоРеквизита.Количество() = 1 И ТипыДополнительногоРеквизита[0] = ТипБулево <> Неопределено Тогда
			ЭлементДополнительногоРеквизита.Вид = ВидПоляФормы.ПолеФлажка;
		КонецЕсли;
		
		ИмяРеквизита = ИмяЭлемента;
		НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, СтрокаДополнительногоРеквизита.ТипЗначенияСвойства, , СтрокаДополнительногоРеквизита.ПредставлениеСвойства));
		
		СтрокаДополнительногоРеквизитаФормы = ТаблицаДополнительныхРеквизитовФормы.Добавить();
		СтрокаДополнительногоРеквизитаФормы.Свойство = СтрокаДополнительногоРеквизита.Свойство;
		СтрокаДополнительногоРеквизитаФормы.ИмяЭлемента = ИмяЭлемента;
		СтрокаДополнительногоРеквизитаФормы.ИмяРеквизита = ИмяРеквизита;
		СтрокаДополнительногоРеквизитаФормы.ТипЗначенияСвойства = СтрокаДополнительногоРеквизита.ТипЗначенияСвойства;
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(НовыеРеквизиты);
	
	ТипЗначениеДополнительногоРеквизита = Тип("СправочникСсылка.вмс_ЗначенияСвойствОбъектов");
	
	Для Каждого СтрокаДополнительногоРеквизитаФормы Из ТаблицаДополнительныхРеквизитовФормы Цикл
		ЭлементДополнительногоРеквизита = Форма.Элементы.Найти(СтрокаДополнительногоРеквизитаФормы.ИмяЭлемента);
		ЭлементДополнительногоРеквизита.ПутьКДанным = СтрокаДополнительногоРеквизитаФормы.ИмяРеквизита;
		
		Если СтрокаДополнительногоРеквизитаФормы.ТипЗначенияСвойства.Типы().Найти(ТипЗначениеДополнительногоРеквизита) <> Неопределено Тогда
			ПараметрыВыбора = Новый Массив;
			НовыйПараметр = Новый ПараметрВыбора("Отбор.Владелец", СтрокаДополнительногоРеквизитаФормы.Свойство);
			ПараметрыВыбора.Добавить(НовыйПараметр);
			ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
			ЭлементДополнительногоРеквизита.ПараметрыВыбора = ПараметрыВыбора;
		КонецЕсли;
	КонецЦикла;
	
	ЗагрузитьЗначенияДополнительныхРеквизитов(Форма);
	
	Возврат Истина;
	
КонецФункции

Функция ОчиститьДополнительныеРеквизиты(Форма)
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");

	Если Форма.ТаблицаДополнительныхРеквизитов.Количество() > 0 Тогда
		Для каждого СтрокаДополнительногоРеквизитаФормы Из Форма.ТаблицаДополнительныхРеквизитов Цикл
			Элемент = Форма.Элементы.Найти(СтрокаДополнительногоРеквизитаФормы.ИмяЭлемента);
			Если Элемент <> Неопределено Тогда
				Форма.Элементы.Удалить(Элемент);
			КонецЕсли;
		КонецЦикла;
		Форма.ИзменитьРеквизиты(, РК.ВыгрузитьЗначенияКолонокКоллекции(Форма.ТаблицаДополнительныхРеквизитов, "ИмяРеквизита"));
		Форма.ТаблицаДополнительныхРеквизитов.Очистить();
	КонецЕсли;
	
КонецФункции

Функция ЗагрузитьЗначенияДополнительныхРеквизитов(Форма)

	ТаблицаДополнительныхРеквизитовФормы = Форма.ТаблицаДополнительныхРеквизитов;
	ТаблицаДополнительныхРеквизитов = Форма.Объект.ДополнительныеРеквизиты;

	Для Каждого СтрокаДополнительногоРеквизитаФормы Из ТаблицаДополнительныхРеквизитовФормы Цикл
		ИмяРеквизитаНаФорме = СтрокаДополнительногоРеквизитаФормы.ИмяРеквизита;
		
		НайденныеЗначения = ТаблицаДополнительныхРеквизитов.НайтиСтроки(Новый Структура("Свойство", СтрокаДополнительногоРеквизитаФормы.Свойство));
		Если НайденныеЗначения.Количество() > 0 Тогда
			ЗначениеРеквизита = НайденныеЗначения[0].Значение;
		Иначе
			ЗначениеРеквизита = Неопределено;
		КонецЕсли;
		
		ЗначениеРеквизита = СтрокаДополнительногоРеквизитаФормы.ТипЗначенияСвойства.ПривестиЗначение(ЗначениеРеквизита);
		Форма[ИмяРеквизитаНаФорме] = ЗначениеРеквизита;
	КонецЦикла;
	
КонецФункции

Функция СохранитьЗначенияДополнительныхРеквизитов(Форма, Объект) Экспорт
	
	Перем УправлениеСвойствамиКлиентСервер;
	
	УправлениеСвойствамиКлиентСервер = глОбщийМодуль("УправлениеСвойствамиКлиентСервер");
	
	Если Не УправлениеСвойствамиКлиентСервер.ДополнительныеРеквизитыИнициализированы(Форма) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаДополнительныхРеквизитовФормы = Форма.ТаблицаДополнительныхРеквизитов;
	ТаблицаДополнительныхРеквизитов = Объект.ДополнительныеРеквизиты;

	Для Каждого СтрокаДополнительногоРеквизитаФормы Из ТаблицаДополнительныхРеквизитовФормы Цикл
		ИмяРеквизитаНаФорме = СтрокаДополнительногоРеквизитаФормы.ИмяРеквизита;
		
		НайденныеЗначения = ТаблицаДополнительныхРеквизитов.НайтиСтроки(Новый Структура("Свойство", СтрокаДополнительногоРеквизитаФормы.Свойство));
		Если НайденныеЗначения.Количество() > 0 Тогда
			СтрокаЗначения = НайденныеЗначения[0];
		Иначе
			СтрокаЗначения = ТаблицаДополнительныхРеквизитов.Добавить();
			СтрокаЗначения.Свойство = СтрокаДополнительногоРеквизитаФормы.Свойство;
		КонецЕсли;
		
		СтрокаЗначения.Значение = Форма[ИмяРеквизитаНаФорме];
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Функция ПриСозданииНаСервере(Форма, Объект, знач ВладелецДополнительныхРеквизитов=Неопределено, ГруппаДополнительныхРеквизитов=Неопределено, Отказ=Ложь, СтандартнаяОбработка=Истина) Экспорт
	
	Перем УправлениеСвойствамиВызовСервера;
	
	УправлениеСвойствамиВызовСервера = глОбщийМодуль("УправлениеСвойствамиВызовСервера");
	
	Если Не УправлениеСвойствамиВызовСервера.ИспользоватьДополнительныеРеквизитыОбъекта(Объект.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ИнициализироватьДополнительныеРеквизиты(Форма, Объект, ВладелецДополнительныхРеквизитов, ГруппаДополнительныхРеквизитов) Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбновитьДополнительныеРеквизиты(Форма);
	Возврат Истина;
	
КонецФункции

Функция ПередЗаписьюНаСервере(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	СохранитьЗначенияДополнительныхРеквизитов(Форма, ТекущийОбъект);
	
КонецФункции
