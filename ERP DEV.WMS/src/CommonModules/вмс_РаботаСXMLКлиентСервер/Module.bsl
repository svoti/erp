Функция XMLЗначениеУлучшенная(знач Тип, знач СтрокаXML) Экспорт
	
	ДанныеТипаОбъекта = глОбщийМодуль("ОбщегоНазначенияКлиентСервер").ПолучитьДанныеТипаОбъекта(Тип);
	
	Если ДанныеТипаОбъекта.ЭтоТипСсылкиОбъектаИБ Тогда
		
		Значение = глОбщийМодуль("ОбщегоНазначенияВызовСервера").ПолучитьСсылкуОбъектаИБ(ДанныеТипаОбъекта.Имя, СтрокаXML);
		Возврат Значение;
		
	ИначеЕсли Тип = "ОписаниеТипов" ИЛИ Тип = "TypeDescription" ИЛИ Тип = Тип("ОписаниеТипов") Тогда
		
		Значение = ОписаниеТиповИзXMLСтроки(СтрокаXML);
		Возврат Значение;
		
	Иначе
		
		Если ТипЗнч(Тип) = Тип("Строка") Тогда
			Попытка
				Тип = Тип(Тип);
			Исключение
				Тип = Неопределено;
			КонецПопытки;
		КонецЕсли;
		
		Если Тип <> Неопределено Тогда
			Попытка
				Значение = XMLЗначение(Тип, СтрокаXML);
				Возврат Значение;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	//ну пусть будет просто строка
	Значение = СтрокаXML;
	
	Возврат Значение;
	
КонецФункции

//{ Описание типов
Функция ОписаниеТиповИзXMLСтроки(СтрокаXML) Экспорт
	
	Возврат ОписаниеТиповИзСтруктурыОписания(ПолучитьСтруктуруОписанияТиповИзXMLСтроки(СтрокаXML));
	
КонецФункции

Функция ОписаниеТиповИзСтруктурыОписания(СтруктураОписанияТипов)

	Если СтруктураОписанияТипов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДоступныеИменаТипов = Новый Массив;
	Для Каждого ИмяТипа Из СтруктураОписанияТипов.ИменаТипов Цикл
		ПозицияСимвола = СтрНайти(ИмяТипа, ":");
		Если ПозицияСимвола > 0 Тогда
			ИмяТипа = Прав(ИмяТипа, СтрДлина(ИмяТипа)-ПозицияСимвола);
		КонецЕсли;
		
		Если ИмяТипа="decimal" Тогда
			ИмяТипа = "Число";
		ИначеЕсли ИмяТипа="dateTime" Тогда
			ИмяТипа = "Дата";
		КонецЕсли;
		
		Если ИмяТипа="ТаблицаЗначений" Тогда
			// сам тип недоступен на клиенте, но описание типов, содержащее тип "ТаблицаЗначений" можно создать
		Иначе
			Попытка
				Тип = Тип(ИмяТипа);
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		ДоступныеИменаТипов.Добавить(ИмяТипа);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтруктураОписанияТипов.КвалификаторыДаты) Тогда
		ИмяЧастейДаты = СтруктураОписанияТипов.КвалификаторыДаты;
		ИмяЧастейДаты = СтрЗаменить(ИмяЧастейДаты, "xs:", "");
		КвалификаторыДаты = Новый КвалификаторыДаты(ЧастиДаты[ИмяЧастейДаты]);
	КонецЕсли;
	
	ДоступныеИменаТиповСтрока = СтрСоединить(ДоступныеИменаТипов, ", ");
	ОписаниеТипов = Новый ОписаниеТипов(ДоступныеИменаТиповСтрока, , , КвалификаторыДаты);
	Возврат ОписаниеТипов;
	
КонецФункции

Функция ПолучитьСтруктуруОписанияТиповИзXMLСтроки(СтрокаXML)

	Если СтрНайти(СтрокаXML, "<")=0 Тогда
		//список типов строкой
		СтруктураОписанияТипов = Новый Структура;
		СтруктураОписанияТипов.Вставить("ИменаТипов", СтрРазделить(СтрокаXML, ","));
		СтруктураОписанияТипов.Вставить("КвалификаторыДаты");
		Возврат СтруктураОписанияТипов;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	
	ЧтениеXML.Прочитать();
	Если ЧтениеXML.Имя <> "TypeDescription" Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЧтениеXML.Прочитать();
	СтруктураОписанияТипов = ПрочитатьСвойстваОписанияТиповИзXML(ЧтениеXML);

	Возврат СтруктураОписанияТипов;
	
КонецФункции

Функция ПрочитатьСвойстваОписанияТиповИзXML(ЧтениеXML)

	ИменаТипов = Новый Массив;
	Пока ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		
		Если ЧтениеXML.Имя = "Type" Тогда
			
			ЧтениеXML.Прочитать(); // прочитать значение элемента
			ИменаТипов.Добавить(ЧтениеXML.Значение);
			ЧтениеXML.Прочитать(); // прочитать конец элемента
			
		ИначеЕсли ЧтениеXML.Имя = "DateQualifiers" Тогда
			
			ЧтениеXML.Прочитать();
			
			Если ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя="DateFractions" Тогда
				ЧтениеXML.Прочитать();
				Если ЧтениеXML.ТипУзла=ТипУзлаXML.Текст Тогда
					КвалификаторыДаты = ЧтениеXML.Значение;
					ЧтениеXML.Прочитать(); // </DateFractions>
				Иначе
					КвалификаторыДаты = "";
					Если ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Тогда
						ЧтениеXML.Пропустить(); // </DateFractions>
					КонецЕсли;
				КонецЕсли;
				ЧтениеXML.Прочитать(); // </DateQualifiers>
			ИначеЕсли ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Тогда
				ЧтениеXML.Пропустить();  // </DateQualifiers>
			КонецЕсли;
			
		Иначе
			
			ЧтениеXML.Пропустить();
			
		КонецЕсли;

		ЧтениеXML.Прочитать(); // прочитать следующий элемент
	КонецЦикла;
	
	СтруктураОписанияТипов = Новый Структура;
	СтруктураОписанияТипов.Вставить("ИменаТипов", ИменаТипов);
	СтруктураОписанияТипов.Вставить("КвалификаторыДаты", КвалификаторыДаты);
	
	Возврат СтруктураОписанияТипов;
	
КонецФункции
//} Описание типов

Функция ПрочитатьТекстТекущегоУзлаXML(ЧтениеXML, Отступ=Истина, Нативный=Истина) Экспорт

	Если Нативный Тогда
		//возможно работает быстрее
		Текст = ПрочитатьТекстТекущегоУзлаXMLНативный(ЧтениеXML, Отступ);
	Иначе
		Текст = ПрочитатьТекстТекущегоУзлаXMLКустарный(ЧтениеXML, Отступ);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

//перемещает указатель чтения за конец текущего элемента, также как и функция "ПрочитатьТекстТекущегоУзлаXML"
Функция ПрочитатьТекстТекущегоУзлаXMLВнутри(ЧтениеXML, Отступ=Истина, Нативный=Истина) Экспорт
	
	ЧтениеXML.Прочитать(); //первый узел/текст внутри текущего узла
	Текст = ПрочитатьТекстТекущегоУзлаXML(ЧтениеXML, Отступ, Нативный);
	ЧтениеXML.Прочитать(); //пройти конец текущего узла
	
	Возврат Текст;
	
КонецФункции

Функция ПрочитатьТекстТекущегоУзлаXMLНативный(ЧтениеXML, Отступ=Истина) Экспорт
	
	Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
		Текст = ЧтениеXML.Значение;
		ЧтениеXML.Прочитать();
		Возврат Текст;
	КонецЕсли;
	
	Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
		Текст = "";
		Возврат Текст;
	КонецЕсли;
	
	Уровень = 1;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.Отступ = Отступ;
	ЗаписьXML.УстановитьСтроку();
	Пока Истина Цикл
		
		ЗаписьXML.ЗаписатьТекущий(ЧтениеXML);
		
		Если Не ЧтениеXML.Прочитать() Тогда
			Прервать;
		КонецЕсли;
		
		Если Уровень = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Уровень = Уровень + 1;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Уровень = Уровень - 1;
		КонецЕсли;
		
	КонецЦикла;

	Текст = ЗаписьXML.Закрыть();
	
	Возврат Текст;
	
КонецФункции

Функция ПрочитатьТекстТекущегоУзлаXMLКустарный(ЧтениеXML, ДобавлятьОтступ=Истина) Экспорт

	Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
		Текст = ЧтениеXML.Значение;
		ЧтениеXML.Прочитать();
		Возврат Текст;
	КонецЕсли;
	
	Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
		Текст = "";
		Возврат Текст;
	КонецЕсли;
	
	Уровень = 1;
	Отступ = "";
	Текст = "";
	
	Если ДобавлятьОтступ Тогда
		СимволОтступа = Символы.Таб;
		СимволПереноса = Символы.ПС;
	Иначе
		СимволОтступа = "";
		СимволПереноса = "";
	КонецЕсли;

	ДлинаСимволаОтступа = СтрДлина(СимволОтступа);
	
	ПредыдущийТипУзла = Неопределено;
	СтекУзлов = Новый Массив;
	Пока Истина Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ПредыдущийТипУзла <> Неопределено Тогда
				Текст = Текст + СимволПереноса;
			КонецЕсли;
			
			Имя = ЧтениеXML.Имя;
			Атрибуты = "";
			НомерПоследнегоАтрибута = ЧтениеXML.КоличествоАтрибутов()-1;
			Для НомерАтрибута=0 По НомерПоследнегоАтрибута Цикл
				Атрибуты = Атрибуты + " " + ЧтениеXML.ИмяАтрибута(НомерАтрибута) + "="""+ ЧтениеXML.ПолучитьАтрибут(НомерАтрибута) + """";
			КонецЦикла;
			Текст = Текст + Отступ;
			Текст = Текст + "<" + Имя + Атрибуты + ">";
			СтекУзлов.Добавить(Имя);
			Отступ = Отступ + СимволОтступа;
			Уровень = Уровень + 1;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			Текст = Текст + ЧтениеXML.Значение;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Уровень = Уровень - 1;
			Отступ = Лев(Отступ, СтрДлина(Отступ)-ДлинаСимволаОтступа);
			Имя = СтекУзлов[СтекУзлов.ВГраница()];
			СтекУзлов.Удалить(СтекУзлов.ВГраница());
			Если ПредыдущийТипУзла = ЧтениеXML.ТипУзла Тогда
				Текст = Текст + СимволПереноса + Отступ;
			КонецЕсли;

			Текст = Текст + "</" + Имя + ">";
			
		КонецЕсли;
		
		ПредыдущийТипУзла = ЧтениеXML.ТипУзла;
		
		Если Не ЧтениеXML.Прочитать() Тогда
			Прервать;
		КонецЕсли;
		
		Если Уровень = 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция ПрочитатьСодержимоеТекущегоУзлаXML(ЧтениеXML, Отступ=Истина) Экспорт

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.Отступ = Отступ;
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Содержимое");
	
	Уровень = 0;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
			Если Уровень=0 Тогда
				Прервать;
			Иначе
				Уровень = Уровень - 1;
			КонецЕсли;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
			Уровень = Уровень + 1;
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьТекущий(ЧтениеXML);
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Текст = ЗаписьXML.Закрыть();
	Если Текст="<Содержимое/>" Тогда
		Текст = "";
	Иначе
		Текст = Сред(Текст, СтрДлина("<Содержимое>")+1, СтрДлина(Текст)-СтрДлина("<Содержимое>")-СтрДлина("</Содержимое>"));
		Текст = СокрЛП(Текст);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

