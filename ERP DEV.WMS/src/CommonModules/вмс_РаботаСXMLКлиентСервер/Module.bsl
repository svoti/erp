Функция ДесериализоватьИзXMLНаСервере(Значение) Экспорт  
	
	Если ЗначениеЗаполнено(Значение) Тогда 
		
		тСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO); 		
		тЧтениеXML = Новый ЧтениеXML;
		тЧтениеXML.УстановитьСтроку(Значение);	
		тСсылка = тСериализаторXDTO.ПрочитатьXML(тЧтениеXML); 	
		Возврат тСсылка;
		
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

