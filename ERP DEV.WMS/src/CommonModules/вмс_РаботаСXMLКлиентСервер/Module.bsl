Функция ПолучитьСтруктуруТекстаXML(ИсточникXML) Экспорт
	
	Перем РаботаСКоллекциями, ОбщегоНазначенияКлиентСервер;
	
	РаботаСКоллекциями = глОбщийМодуль("РаботаСКоллекциями");
	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
	Если ТипЗнч(ИсточникXML) = Тип("ЧтениеXML") Тогда
		ЧтениеXML = ИсточникXML;
		локЧтениеXML = Неопределено;
	ИначеЕсли ТипЗнч(ИсточникXML) = Тип("Строка") Тогда
		ЧтениеXML = Новый ЧтениеXML;
		Если СтрНайти(ИсточникXML, "<") > 0 Тогда
			ЧтениеXML.УстановитьСтроку(ИсточникXML);
		Иначе
			ИмяФайла = ИсточникXML;
			ТекстФайла = ОбщегоНазначенияКлиентСервер.ПолучитьТекстИзФайла(ИмяФайла);
			ЧтениеXML.УстановитьСтроку(ТекстФайла);
		КонецЕсли;
		локЧтениеXML = ЧтениеXML;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураXML = НовыйУзелСтруктурыТекстаXML(Неопределено);
	ТекущийЭлемент = СтруктураXML;
	СтекЭлементов = Новый Массив;
	УровеньЭлемента = 0;
	ПредыдущийТипУзла = Неопределено;
	
	Пока Истина Цикл
		
		Если Не (ЧтениеXML.ТипУзла = ТипУзлаXML.ОбъявлениеXML ИЛИ ЧтениеXML.ТипУзла = ТипУзлаXML.Ничего) Тогда
			
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				
				СтекЭлементов.Добавить(Новый Структура("Элемент, Свойство", ТекущийЭлемент, ЧтениеXML.Имя));
				УровеньЭлемента = УровеньЭлемента + 1;
				
				ТекущийЭлемент = НовыйУзелСтруктурыТекстаXML(ЧтениеXML.Имя);
				
				Для НомерАтрибута=0 По ЧтениеXML.КоличествоАтрибутов()-1 Цикл
					ТекущийЭлемент.Атрибуты[ЧтениеXML.ИмяАтрибута(НомерАтрибута)] = ЧтениеXML.ЗначениеАтрибута(НомерАтрибута);
				КонецЦикла;
				
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
				
				ТекущийЭлемент.Значение = ЧтениеXML.Значение;
				
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				
				НовыйЭлемент = ТекущийЭлемент;
				
				ТекущийЭлемент = СтекЭлементов[СтекЭлементов.ВГраница()].Элемент;
				ТекущееСвойство = СтекЭлементов[СтекЭлементов.ВГраница()].Свойство;
				СтекЭлементов.Удалить(СтекЭлементов.ВГраница());
				УровеньЭлемента = УровеньЭлемента - 1;
				
				ВставитьУзелВСтруктуруТекстаXML(ТекущийЭлемент, НовыйЭлемент);
			
			КонецЕсли;
			
		КонецЕсли;
		
		ПредыдущийТипУзла = ЧтениеXML.ТипУзла;
		
		Если Не ЧтениеXML.Прочитать() Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если локЧтениеXML <> Неопределено Тогда
		локЧтениеXML.Закрыть();
	КонецЕсли;
	
	Возврат СтруктураXML;
	
КонецФункции

Функция ПолучитьУзелСтруктурыТекстаXML(СтруктураТекстаXML, Путь) Экспорт
	
	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = глОбщийМодуль("РаботаСКоллекциями");
	
	МассивЭлементовПути = РаботаСКоллекциями.СтрокуВМассив(Путь, ".");
	
	ТекущийУзел = СтруктураТекстаXML;
	Для Каждого ЭлементПути Из МассивЭлементовПути Цикл
		
		ТекущаяКоллекция = ТекущийУзел.Свойства[ЭлементПути];
		
		Если ТекущаяКоллекция = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ТекущийУзел = ТекущаяКоллекция[0];
		
	КонецЦикла;
	
	Возврат ТекущийУзел;
	
КонецФункции

Функция ВставитьУзелВСтруктуруТекстаXML(СтруктураТекстаXML, Узел) Экспорт

	Имя = Узел.Имя;
	ВложенныеЭлементыПоСвойству = СтруктураТекстаXML.Свойства[Имя];
	Если ВложенныеЭлементыПоСвойству = Неопределено Тогда
		ВложенныеЭлементыПоСвойству = Новый Массив;
		СтруктураТекстаXML.Свойства[Имя] = ВложенныеЭлементыПоСвойству;
	КонецЕсли;
	
	ВложенныеЭлементыПоСвойству.Добавить(Узел);
	
	СтруктураТекстаXML.ВложенныеЭлементы.Добавить(Узел);
	Узел.Номер = СтруктураТекстаXML.ВложенныеЭлементы.Количество();
	
КонецФункции

Функция НовыйУзелСтруктурыТекстаXML(Имя, Значение=Неопределено) Экспорт
	НовыйУзел = Новый Структура;
	НовыйУзел.Вставить("Имя", Имя);
	НовыйУзел.Вставить("Номер", 0);
	НовыйУзел.Вставить("Атрибуты", Новый Соответствие);
	НовыйУзел.Вставить("Свойства", Новый Соответствие);
	НовыйУзел.Вставить("ВложенныеЭлементы", Новый Массив);
	НовыйУзел.Вставить("Значение", Значение);
	Возврат НовыйУзел;
КонецФункции

Функция СкопироватьАтрибутыУзлаСтруктурыТекстаXML(УзелИсточник, УзелПриемник) Экспорт

	Для Каждого Атрибут Из УзелИсточник.Атрибуты Цикл
		УзелПриемник.Атрибуты[Атрибут.Ключ] = Атрибут.Значение;
	КонецЦикла;
	
КонецФункции

Функция УдалитьАтрибутыУзлаСтруктурыТекстаXML(УзелXML, Атрибуты) Экспорт

	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = глОбщийМодуль("РаботаСКоллекциями");
	
	МассивАтрибутов = РаботаСКоллекциями.ЗначениеВМассив(Атрибуты);
	
	Для Каждого ИмяАтрибута Из МассивАтрибутов  Цикл
		УзелXML.Атрибуты.Удалить(ИмяАтрибута);
	КонецЦикла;
	
КонецФункции

Функция ЗаписатьУзелСтруктурыТекстаXML(ЗаписьXML, УзелXML) Экспорт

	ЗаписьXML.ЗаписатьНачалоЭлемента(УзелXML.Имя);
	Для Каждого Атрибут Из УзелXML.Атрибуты Цикл
		ЗаписьXML.ЗаписатьАтрибут(Атрибут.Ключ, Атрибут.Значение);
	КонецЦикла;
	
	ВложенныеЭлементы = УзелXML.ВложенныеЭлементы;
	Если ВложенныеЭлементы.Количество() > 0 Тогда
		Для Каждого ВложенныйУзел Из ВложенныеЭлементы Цикл
			ЗаписатьУзелСтруктурыТекстаXML(ЗаписьXML, ВложенныйУзел);
		КонецЦикла;
	ИначеЕсли УзелXML.Значение <> Неопределено Тогда
		ЗаписьXML.ЗаписатьТекст(УзелXML.Значение);
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецФункции

Функция ПолучитьТекстУзлаСтруктурыТекстаXML(УзелXML) Экспорт

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ЗаписатьУзелСтруктурыТекстаXML(ЗаписьXML, УзелXML);
	Текст = ЗаписьXML.Закрыть();
	Возврат Текст;
	
КонецФункции

Функция ПолучитьМультиязычнуюСтрокуИзСтруктурыТекстаXML(УзелХML, Язык="ru") Экспорт
	
	Если УзелХML = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивИтемов = УзелХML.Свойства["v8:item"];
	Если МассивИтемов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Итем Из МассивИтемов Цикл
		Если Итем.Свойства["v8:lang"][0].Значение = Язык Тогда
			Возврат Итем.Свойства["v8:content"][0].Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции
