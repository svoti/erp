Функция НайтиМестоХранения(ТипМестаХранения, Фильтры = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестаХранения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК МестаХранения
	|ГДЕ
	|	НЕ МестаХранения.ЭтоГруппа
	|	И НЕ МестаХранения.ПометкаУдаления
	|	И МестаХранения.ТипЯчейки = &ТипЯчейки
	|	И &Отборы";
	
	Запрос.УстановитьПараметр("ТипЯчейки", ТипМестаХранения); 
	
	Если Фильтры <> Неопределено Тогда  
		
		ДопОтборы = "";
		
		Если Фильтры.Свойство("Склад") Тогда 
			Склад = Фильтры.Склад; 
			Если НЕ ЗначениеЗаполнено(Склад) Тогда
				Склад = вмс_ОперацииПоЯчейкамСервер.ПолучитьСкладПоУмолчанию();
			КонецЕсли;
			
			ДопОтборы = ДопОтборы + "МестаХранения.Владелец = &Склад" + Символы.ПС; 
			Запрос.УстановитьПараметр("Склад", Склад);
		КонецЕсли; 
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отборы", ДопОтборы);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отборы", "Истина");			
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.вмс_МестаХранения.ПустаяСсылка();
	
	
КонецФункции

