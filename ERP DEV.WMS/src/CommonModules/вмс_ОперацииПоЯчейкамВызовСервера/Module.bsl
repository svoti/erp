Функция УстановитьПометкуГотовДокумента(Ссылка) Экспорт
	Объект = Ссылка.ПолучитьОбъект();
	Объект.Готов = Истина;
	Объект.Записать();
КонецФункции

// Функция - Устанавливает ПометкаУдаления для объекта. Вызывает запись объекта в СУБД
//
// Параметры:
//  СсылкиНаОбъекты	 - Массив	 - массив ссылок на документы, справочники итп.
//  Пометка			 - Булево	 -значение параметра ПометкаУдаления
// 
// Возвращаемое значение:
//  Массив - обработанные объекты, которые удалось транзакционно записать
//
Функция УстановитьПометкуУдаленияОбъектов(СсылкиНаОбъекты, Пометка=Истина) Экспорт
	
	МассивСсылокНаОбъекты = вмс_РаботаСКоллекциями.ЗначениеВМассив(СсылкиНаОбъекты, , Ложь);
	Обработанные = Новый Массив; 
	СообщениеОбОшибке = "";
	
	Для Каждого СсылкаНаОбъект Из МассивСсылокНаОбъекты Цикл
		Объект = СсылкаНаОбъект.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Объект.УстановитьПометкуУдаления(Пометка);
			Обработанные.Добавить(СсылкаНаОбъект);
		Исключение
			СообщениеОбОшибке = СообщениеОбОшибке + СтрШаблон("Не удалось пометить на удаление объект %1 %2", СсылкаНаОбъект, Символы.ПС);
		КонецПопытки;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СообщениеОбОшибке;
		Сообщение.Сообщить();
	КонецЕсли;
	
	Возврат Обработанные;
	
КонецФункции

Функция ОтменитьПроведениеДокументов(СсылкиНаДокументы) Экспорт
	
	МассивСсылокНаДокументы = вмс_РаботаСКоллекциями.ЗначениеВМассив(СсылкиНаДокументы, , Ложь);
	
	Для Каждого СсылкаНаДокумент Из МассивСсылокНаДокументы Цикл
		Документ = СсылкаНаДокумент.ПолучитьОбъект();
		Если Документ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Документ.Проведен Тогда
			Продолжить;
		КонецЕсли;
		
		Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла;
	
КонецФункции

