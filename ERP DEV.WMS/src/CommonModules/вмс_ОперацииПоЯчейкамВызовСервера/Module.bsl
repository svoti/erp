Функция ПолучитьРезультатОбработчика(ПараметрыАлгоритма, ИмяОбработчика=Неопределено) Экспорт
	
	ДополнительныеДанные = Неопределено;
	Если ПараметрыАлгоритма.Свойство("ДополнительныеДанные", ДополнительныеДанные) Тогда
		Если ТипЗнч(ДополнительныеДанные) = Тип("Структура") Тогда
			Если ЗначениеЗаполнено(ИмяОбработчика) Тогда
				СтрокаОбработчика = вмс_РаботаСКоллекциями.НайтиСтрокиКвазиТаблицыЗначений(ДополнительныеДанные, Новый Структура("ИмяОбработчика", ИмяОбработчика));
			Иначе
				СтрокаОбработчика = ДополнительныеДанные.Строки;		
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДополнительныеДанные) = Тип("ТаблицаЗначений") Тогда 
			Если ЗначениеЗаполнено(ИмяОбработчика) Тогда
				СтрокаОбработчика = ДополнительныеДанные.НайтиСтроки(Новый Структура("ИмяОбработчика", ИмяОбработчика));
			Иначе
				СтрокаОбработчика = ДополнительныеДанные;	
			КонецЕсли;
		Иначе
			Возврат Неопределено;	
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаОбработчика) Тогда
			Возврат СтрокаОбработчика[0].Результат;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции
