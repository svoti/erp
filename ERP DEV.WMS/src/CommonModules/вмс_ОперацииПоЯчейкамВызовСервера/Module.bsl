	КонецЦикла;
КонецФункции

// ТУ_Мовчан 21.02.2023  
Функция УстановитьСтатусСПроверкой(Документ, Операция, Ответственный=Неопределено, ДополнительныеДанные=Неопределено, НовыйСтатусВРаботе = Истина) Экспорт
	
	Помещение = Неопределено;
	Если ТипЗнч(ДополнительныеДанные)=Тип("Структура") Тогда
		ДополнительныеДанные.Свойство("Помещение", Помещение);
	КонецЕсли;
		
	СтатусЗавершен = ПолучитьСтатусЗавершенияОперации(Операция);

	ОперацияЗавершена = РегистрыСведений.вмс_СтатусыДокументов.ПолучитьДанныеОНаличииСтатусаДокумента(Документ, СтатусЗавершен, Помещение);
	Если Не ОперацияЗавершена Тогда 	
		Если НовыйСтатусВРаботе Тогда
			НовыйСтатус = ПолучитьСтатусСохраненияОперации(Операция);
		Иначе
			НовыйСтатус = СтатусЗавершен;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НовыйСтатус) Тогда
			ИзменитьСтатусДокумента(Документ, НовыйСтатус, , Ответственный, Помещение);
		КонецЕсли;
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// ТУ_Мовчан 21.02.2023  
Функция ПолучитьДанныеОНаличииСтатуса(Документ, Операция, Статус, Помещение=Неопределено) Экспорт
	
	Если Статус = "Завершен" Тогда
		ЕстьСтатус = РегистрыСведений.вмс_СтатусыДокументов.ПолучитьДанныеОНаличииСтатусаДокумента(Документ, ПолучитьСтатусЗавершенияОперации(Операция), Помещение);
	ИначеЕсли Статус = "ВРаботе" Тогда
		ЕстьСтатус = РегистрыСведений.вмс_СтатусыДокументов.ПолучитьДанныеОНаличииСтатусаДокумента(Документ, ПолучитьСтатусСохраненияОперации(Операция), Помещение);
	КонецЕсли;
	
	Возврат ЕстьСтатус;
	
КонецФункции 

