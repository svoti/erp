#Область ОбработкаОперацииВИС
// Инициализируется после завершения операции в МП
Функция ЗавершитьОперациюПоДокументу(Документ, ВидОперации, Ответственный=Неопределено, ДополнительныеДанные=Неопределено, ДокументТСД = Неопределено) Экспорт  
	
	НовыйСтатус = ПолучитьСтатусЗавершенияОперации(ВидОперации);
	Если ЗначениеЗаполнено(НовыйСтатус) Тогда
		ИзменитьСтатусДокумента(Документ, НовыйСтатус, , Ответственный);
	КонецЕсли; 
	
	АктивныеРассылки = ВидОперации.ПочтовыеРассылки.НайтиСтроки(Новый Структура("Активная", Истина));
	
	Для каждого Строка Из АктивныеРассылки Цикл
		ПочтоваяРассылка = Строка.Рассылка.ПолучитьОбъект();
		ПараметрыПечати = Новый Структура("Документ, Операция, Ответственный", Документ, ВидОперации, Ответственный);
		Справочники.вмс_ПочтовыеРассылки.Отправить(ПочтоваяРассылка, ПараметрыПечати);
	КонецЦикла;  
	
	// // ТУ_Самойленко 31.05.23 ++
	//Если ВидОперации = Справочники.вмс_Операции.НайтиПоРеквизиту("ИмяДляПоиска", "Выборочнаяинвентаризация") Тогда
	//	ПостобработкаВыборочнойИнвентаризации(Истина, Документ, ВидОперации, Ответственный, ДополнительныеДанные);
	//КонецЕсли;
	// // ТУ_Самойленко 31.05.23 -- -
	
	ИсполняемыеАлгоритмы = ВидОперации.Алгоритмы.НайтиСтроки(Новый Структура("ПриЗавершении", Истина));    
	
	ВходящиеПараметры = Новый Структура("Документ, ДокументТСД, ВидОперации, Ответственный, ДополнительныеДанные", Документ, ДокументТСД, ВидОперации, Ответственный, ДополнительныеДанные);
	
	// ТУ_Семенов 11.2025++
	// Изменение состояния задания кладовщику
	Если ЗначениеЗаполнено(Документ) И ТипЗнч(Документ) = Тип("ДокументСсылка.вмс_ЗаданиеКладовщику") Тогда 
		ИзменитьСостояниеЗаданияКладовщику(ВидОперации, Документ);
	КонецЕсли;
	// ТУ_Семенов 11.2025--
	
	Если ТипЗнч(Документ)=Тип("ДокументСсылка.вмс_ЗаданиеКладовщику") И ЗначениеЗаполнено(Документ.Распоряжение) Тогда
		Распоряжение = Документ.Распоряжение;
	Иначе
		Распоряжение = Документ;
	КонецЕсли; 
	
	Для каждого Строка Из ИсполняемыеАлгоритмы Цикл
		
		// ТУ_Васильев 13.10.24 ++
		Если ЗначениеЗаполнено(Строка.ПравилоКонвертации) Тогда
			ВыполнитьПравилоПоРаспоряжению(Распоряжение, ДокументТСД, ВидОперации, Строка.ПравилоКонвертации, ДополнительныеДанные);
		Иначе
			вмс_ОбщегоНазначенияКлиентСервер.ВыполнитьАлгоритм(Строка.Алгоритм, ВходящиеПараметры);
		КонецЕсли;
		// ТУ_Васильев 13.10.24 --
		
	КонецЦикла;
	
	СформироватьСледующиеЗаданияПоПравилуЗаполненияЗаданийКладовщикам(ДокументТСД);
	
	// ТУ_Прошин_17.04.25+
	вмс_РаботаСОповещениями.ДобавитьОповещениеВыполнениеОперации(ВходящиеПараметры);
	// ТУ_Прошин_17.04.25-
	
КонецФункции

Функция СформироватьСледующиеЗаданияПоПравилуЗаполненияЗаданийКладовщикам(ДокументТСД) Экспорт
	
	Если НЕ (ТипЗнч(ДокументТСД)=Тип("ДокументСсылка.вмс_ОперацияПоЯчейкам") И ЗначениеЗаполнено(ДокументТСД)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ (ЗначениеЗаполнено(ДокументТСД.ДокументОснование) И ЗначениеЗаполнено(ДокументТСД.ЗаданиеКладовщику)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Правило = ДокументТСД.ЗаданиеКладовщику.Правило.СледующееПравило;
	Если НЕ ЗначениеЗаполнено(Правило) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	вмс_ФормированиеЗаданийКладовщикам.СформироватьЗаданияПоПравилу(Правило, , ДокументТСД.ДокументОснование);
	Возврат Истина;

КонецФункции

// Инициализируется после сохранения операции в МП
Функция СохранитьОперациюПоДокументу(Документ, ВидОперации, Ответственный=Неопределено, ДополнительныеДанные=Неопределено, ДокументТСД = Неопределено) Экспорт
	// ТУ_Кошелев 28.05.24 ++
	УстановитьСтатусСПроверкой(Документ, ВидОперации, Ответственный, ДополнительныеДанные); 
	// ТУ_Кошелев 28.05.24 --
	
	// // ТУ_Самойленко 31.05.23 ++
	//Если ВидОперации = Справочники.вмс_Операции.НайтиПоРеквизиту("ИмяДляПоиска", "Выборочнаяинвентаризация") Тогда
	//	ПостобработкаВыборочнойИнвентаризации(Ложь, Документ, ВидОперации, Ответственный, ДополнительныеДанные);	
	//КонецЕсли;
	// // ТУ_Самойленко 31.05.23 --
	
	ИсполняемыеАлгоритмы = ВидОперации.Алгоритмы.НайтиСтроки(Новый Структура("ПриСохранении", Истина));
	ВходящиеПараметры = Новый Структура("Документ, ВидОперации, Ответственный, ДополнительныеДанные, ДокументТСД",Документ, ВидОперации, Ответственный, ДополнительныеДанные, ДокументТСД);
	
	Для каждого Строка Из ИсполняемыеАлгоритмы Цикл
