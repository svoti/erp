Функция РаботаСПаллетамиБезТоварногоНаполнения(Документ) Экспорт
	
	ДополнительныйРеквизитПризнака = Справочники.вмс_НастройкиПрограммы.ПолучитьЗначениеНастройкиПрограммы("ДополнительныйРеквизитПризнакаЗаданияДляРаботыСПаллетамиБезТоварногоНаполнения");
	
	Если ДополнительныйРеквизитПризнака <> Неопределено Тогда
		ИмяДокумента = вмс_ОбщегоНазначенияВызовСервера.ПолучитьИмяТипаОбъекта(Документ);
		Если ИмяДокумента <> Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Документ", Документ);
			Запрос.УстановитьПараметр("Свойство", ДополнительныйРеквизитПризнака);
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ДополнительныеРеквизитыДокумента.Ссылка КАК Ссылка,
			|	ДополнительныеРеквизитыДокумента.Свойство КАК Свойство,
			|	ДополнительныеРеквизитыДокумента.Значение КАК Значение
			|ИЗ
			|	Документ.ПриобретениеТоваровУслуг.ДополнительныеРеквизиты КАК ДополнительныеРеквизитыДокумента
			|ГДЕ
			|	ДополнительныеРеквизитыДокумента.Ссылка = &Документ
			|	И ДополнительныеРеквизитыДокумента.Свойство = &Свойство";
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ПриобретениеТоваровУслуг", ИмяДокумента);
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				ВыборкаЗапроса = РезультатЗапроса.Выбрать();
				ВыборкаЗапроса.Следующий();
				Возврат ВыборкаЗапроса.Значение = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЗапрашиватьЭтикеткиДляКонтрагента(Знач Контрагент) Экспорт
	
	ДополнительныйРеквизитПризнака = Справочники.вмс_НастройкиПрограммы.ПолучитьЗначениеНастройкиПрограммы("ПризнакЗапросаЭтикеток");
	
	Если ДополнительныйРеквизитПризнака <> Неопределено Тогда
		ИмяОбъекта = вмс_ОбщегоНазначенияВызовСервера.ПолучитьИмяТипаОбъекта(Контрагент);
		Если ИмяОбъекта <> Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Владелец", Контрагент);
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ДополнительныеРеквизитыДокумента.Ссылка КАК Ссылка,
			|	ДополнительныеРеквизитыДокумента.Свойство КАК Свойство,
			|	ДополнительныеРеквизитыДокумента.Значение КАК Значение
			|ИЗ
			|	Справочник.Контрагенты.ДополнительныеРеквизиты КАК ДополнительныеРеквизитыДокумента
			|ГДЕ
			|	ДополнительныеРеквизитыДокумента.Ссылка = &Владелец";
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				ВыборкаЗапроса = РезультатЗапроса.Выбрать();
				ВыборкаЗапроса.Следующий();
				Возврат ВыборкаЗапроса.Значение = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьКонтрагентовДляФормированияЭтикеток() Экспорт
	
	ДополнительныйРеквизитПризнака = Справочники.вмс_НастройкиПрограммы.ПолучитьЗначениеНастройкиПрограммы("ПризнакЗапросаЭтикеток");
	
	МассивКонтрагентов = Новый Массив;
	
	Если ДополнительныйРеквизитПризнака <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Свойство", ДополнительныйРеквизитПризнака);
		Запрос.Текст ="
		|ВЫБРАТЬ
