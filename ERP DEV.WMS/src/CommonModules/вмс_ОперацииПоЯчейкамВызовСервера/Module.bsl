Функция СоздатьПоступлениеТоваровУслугПоЗаказуПоставщику(ЗаказПоставщику,ВидОперации) Экспорт  
	
	// Кулалаев Е.С + 27.04.2022 18:49:14
	Адаптация = вмс_АдаптацияКонфигураций; 
	
	// ТУ_Мовчан 12.12.23
	ИмяДокумента = Адаптация.ПолучитьИмяПриходногоДокумента();
	ПриходныйДокумент = Документы[ИмяДокумента].СоздатьДокумент();
	ПриходныйДокумент.Заполнить(ЗаказПоставщику);
	ПриходныйДокумент.Дата = ТекущаяДата();
	
	ТаблицаПринятыхТоваров = вмс_ОперацииПоЯчейкамСервер.ПолучитьТаблицуПринятыхТоваров(ЗаказПоставщику, ВидОперации, Неопределено, Неопределено);
	ТаблицаНоменклатуры = ТаблицаПринятыхТоваров.Скопировать(,"Товар,Характеристика,Количество"); 
	ТаблицаНоменклатуры.Свернуть("Товар,Характеристика","Количество");
	
	// ТУ_Мовчан 12.12.23 ++
	ИменаТабличныхЧастей = Адаптация.ПолучитьИмяТабличнойЧасти(); 
	Если Тип("Массив") = ТипЗнч(ИменаТабличныхЧастей) Тогда
		МетаДанныеОбъекта = МетаДанные.НайтиПоПолномуИмени(ИмяДокумента);
		Если МетаДанныеОбъекта <> Неопределено И МетаДанные.Документы.Содержит(МетаДанныеОбъекта) Тогда
			Для Каждого ИмяТабЧасти Из ИменаТабличныхЧастей Цикл
				МетаДанныеТабличнойЧасти = МетаДанныеОбъекта.ТабличныеЧасти.Найти(ИмяТабЧасти);
				Если МетаДанныеТабличнойЧасти <> Неопределено Тогда
					ИмяТабличнойЧасти = ИмяТабЧасти;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		ИмяТабличнойЧасти = ИменаТабличныхЧастей;
	КонецЕсли;
	ТабличнаяЧасть = ПриходныйДокумент[ИмяТабличнойЧасти];
	// ТУ_Мовчан 12.12.23 --
	//ТабличнаяЧасть = ПриходныйДокумент[адап.ПолучитьИмяТабличнойЧасти()];
	ТабличнаяЧасть.Очистить();
	
	Для каждого Строка Из ТаблицаНоменклатуры Цикл 
		
		нСтрока = ТабличнаяЧасть.Добавить(); 
		ЗаполнитьЗначенияСвойств(нСтрока,Строка);
		нСтрока.Номенклатура = Строка.Товар;
		нСтрока[Адаптация.ИмяКолонкиЕдиницаИзмерения()] = Строка.Товар[Адаптация.ИмяРеквизитаНоменклатурыЕдиницаИзмерения()]
		
	КонецЦикла;   
	
	ПриходныйДокумент.Записать();	
	// Кулалаев Е.С -
	
	
КонецФункции

