Функция ПолучитьГруппуЯчеекОтветственногоХранения() Экспорт
	
	Наименование = "Ответственное хранение";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_МестаХранения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	вмс_МестаХранения.ЭтоГруппа
	|	И вмс_МестаХранения.Наименование = &Наименование
	|	И НЕ вмс_МестаХранения.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		НоваяГруппа = Справочники.вмс_МестаХранения.СоздатьГруппу();
		НоваяГруппа.Наименование = Наименование;
		НоваяГруппа.Записать();
		Возврат НоваяГруппа.Ссылка;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

