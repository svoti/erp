Функция ИзменитьСтатусыДокументовПоРаспоряжению(Рспоряжение, НовыйСтатус, Период=Неопределено, Ответственный=Неопределено ) Экспорт    
	
	Текст = "
	|ВЫБРАТЬ
	|	вмс_СтатусыДокументовСрезПоследних.Документ КАК Документ,
	|	вмс_СтатусыДокументовСрезПоследних.Помещение КАК Помещение,
	|	вмс_СтатусыДокументовСрезПоследних.Распоряжение КАК Распоряжение,
	|	вмс_СтатусыДокументовСрезПоследних.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.вмс_СтатусыДокументов.СрезПоследних(, Распоряжение = &Рспоряжение И Статус <> &Статус ) КАК вмс_СтатусыДокументовСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_СтатусыДокументовСрезПоследних.Документ,
	|	вмс_СтатусыДокументовСрезПоследних.Помещение,
	|	вмс_СтатусыДокументовСрезПоследних.Распоряжение,
	|	вмс_СтатусыДокументовСрезПоследних.Статус
	|";
	
	Запрос = Новый Запрос(Текст);
	
	Запрос.УстановитьПараметр("Рспоряжение", Рспоряжение);
	Запрос.УстановитьПараметр("Статус", НовыйСтатус);
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.вмс_СтатусыДокументов.ИзменитьСтатусДокумента(Выборка.Документ, НовыйСтатус, Период, Ответственный, Выборка.Помещение);
	КонецЦикла;
	
КонецФункции

