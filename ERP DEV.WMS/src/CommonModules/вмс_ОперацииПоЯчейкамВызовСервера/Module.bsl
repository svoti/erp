Функция ИспользуемыеТоварныеПоля(УдалитьУпаковки = Ложь) Экспорт
	
	ПараметрыПриложения = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПриложения();
	
	НастройкаТоварныхПолейСсылка = ПараметрыПриложения["НастройкаТоварныхПолейСсылка"];
	Если НастройкаТоварныхПолейСсылка=Неопределено Тогда
		НастройкаТоварныхПолейСсылка = Справочники.вмс_НастройкиПрограммы.ПолучитьНастройкуПрограммы("НастройкаТоварныхПолей");
		ПараметрыПриложения["НастройкаТоварныхПолейСсылка"] = НастройкаТоварныхПолейСсылка;
	КонецЕсли;
	
	ВерсияНастройкиТоварныхПолей = вмс_ОбщегоНазначенияВызовСервера.ВерсияДанных(НастройкаТоварныхПолейСсылка);
	Если ПараметрыПриложения["ВерсияНастройкиТоварныхПолей"]=ВерсияНастройкиТоварныхПолей Тогда
		// Возьмем из кэша так, как при частом обращении к этой функции добавляется заметная задержка выполнения кода
		ИспользуемыеТоварныеПоля = вмс_РаботаСКоллекциями.СкопироватьОбъект(ПараметрыПриложения["ИспользуемыеТоварныеПоля"]);
	Иначе
		НастройкаТоварныхПолей = вмс_ОперацииПоЯчейкамСервер.ПолучитьНастройкуТоварныхПолей();
		ИспользуемыеТоварныеПоля = вмс_ОперацииПоЯчейкамКлиентСервер.ИспользуемыеТоварныеПоляНастройкиТоварныхПолей(НастройкаТоварныхПолей);
		ПараметрыПриложения["ИспользуемыеТоварныеПоля"] = ИспользуемыеТоварныеПоля;
		ПараметрыПриложения["ВерсияНастройкиТоварныхПолей"] = ВерсияНастройкиТоварныхПолей;
	КонецЕсли;
	
	// ТУ_Кошелев 14.01.25 - перенес настройку в функцию чтобы не плодить лишние функции в модулях
	// ""Временное"" решение для работоспособности формы при включенных упаковках в товарных полях (их надо удалить из
	// товарныхъ полей в принципе)
	Если УдалитьУпаковки Тогда
		ИндексУпаковки = ИспользуемыеТоварныеПоля.Найти("Упаковка");
		Если ИндексУпаковки <> Неопределено Тогда
			ИспользуемыеТоварныеПоля.Удалить(ИндексУпаковки);
		КонецЕсли;
	КонецЕсли;
	//
	
	Возврат ИспользуемыеТоварныеПоля;
	
КонецФункции

Функция ПолучитьНастройкуТоварныхПолей() Экспорт
	
	НастройкаТоварныхПолей = вмс_ОперацииПоЯчейкамСервер.ПолучитьНастройкуТоварныхПолей();
	
	Если ТипЗнч(НастройкаТоварныхПолей.ТаблицаПолей) = Тип("ТаблицаЗначений") Тогда
		НастройкаТоварныхПолей.ТаблицаПолей = вмс_РаботаСКоллекциями.НоваяКвазиТаблицаЗначений(НастройкаТоварныхПолей.ТаблицаПолей);
	КонецЕсли;
	
	Возврат НастройкаТоварныхПолей;
	
КонецФункции

