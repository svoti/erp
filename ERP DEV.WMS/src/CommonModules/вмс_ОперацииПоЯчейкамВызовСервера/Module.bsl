Функция СоздатьМестоХранения(Склад, ТипЯчейки, Наименование=Неопределено) Экспорт
	
	Ячейка = Справочники.вмс_МестаХранения.СоздатьЭлемент();
	Ячейка.Заполнить(Неопределено);
	
	Ячейка.Владелец = Склад;
	Ячейка.ТипЯчейки = ТипЯчейки;
	
	Если Наименование = Неопределено Тогда
		Ячейка.Наименование = "" + ТипЯчейки + "(" + Склад + ")";	
	Иначе
		Ячейка.Наименование = "" + Наименование;	
	КонецЕсли; 
	
	Ячейка.Записать();
	
	Возврат Ячейка.Ссылка;
	
КонецФункции
