Функция ПостобработкаВыборочнойИнвентаризации(ЗавершениеОперации=Ложь, Документ=Неопределено, Операция=Неопределено, Ответственный=Неопределено, ДополнительныеДанные=Неопределено) Экспорт
	
	Если ЗавершениеОперации Тогда
		ВИ_ОтменаПроведенияПрошлогоРезультата(Документ, Операция, Ответственный, ДополнительныеДанные);
		ВИ_ЗаполнениеСтатусаИсполнителя(Документ, Операция, Ответственный, ДополнительныеДанные);
		ВИ_СменаСтатусаРаспоряжения(Документ, Операция, Ответственный, ДополнительныеДанные);
	Иначе
		ВИ_ОтменаПроведенияПрошлогоРезультата(Документ, Операция, Ответственный, ДополнительныеДанные);	
	КонецЕсли;
	
КонецФункции 

Функция ВИ_ЗаполнениеСтатусаИсполнителя(Документ=Неопределено, Операция=Неопределено, Ответственный=Неопределено, ДополнительныеДанные=Неопределено) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.вмс_ЖурналИсполнения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Заполнить(Неопределено);
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.Документ = Документ;
	МенеджерЗаписи.Ответственный = Ответственный;
	МенеджерЗаписи.Статус = Справочники.вмс_ЭтапыОперации.НайтиПоНаименованию("Завершена");
	МенеджерЗаписи.Записать();
	
КонецФункции

Функция ВИ_ОтменаПроведенияПрошлогоРезультата(Документ=Неопределено, Операция=Неопределено, Ответственный=Неопределено, ДополнительныеДанные=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкам.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.вмс_ОперацияПоЯчейкам КАК вмс_ОперацияПоЯчейкам
	|ГДЕ
	|	вмс_ОперацияПоЯчейкам.ДокументОснование = &Документ
	|	И вмс_ОперацияПоЯчейкам.ВидОперации = &ВидОперации
	|	И вмс_ОперацияПоЯчейкам.Ответственный = &Ответственный
	|	И вмс_ОперацияПоЯчейкам.Проведен = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка УБЫВ
	|";
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ВидОперации", Операция);
	Запрос.УстановитьПараметр("Ответственный", Ответственный);
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Количество() > 1 Тогда
		
		Результат.Следующий(); //Холостой прогон, для исключения последнего документа
		
		Пока Результат.Следующий() Цикл
			
			СтараяОперация = Результат.Ссылка.ПолучитьОбъект();
			СтараяОперация.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции 

Функция ВИ_СменаСтатусаРаспоряжения(Документ=Неопределено, Операция=Неопределено, Ответственный=Неопределено, ДополнительныеДанные=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	вмс_СтатусыИсполнителей.Ответственный КАК Исполнитель
	|ПОМЕСТИТЬ Завершили
	|ИЗ
	|	РегистрСведений.вмс_ЖурналИсполнения КАК вмс_СтатусыИсполнителей
	|ГДЕ
	|	вмс_СтатусыИсполнителей.Статус = &СтатусИсполнителя
	|	И вмс_СтатусыИсполнителей.Документ = &Документ
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_СтатусыИсполнителей.Ответственный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вмс_ВыборочнаяИнвентаризацияТовары.Исполнитель КАК Исполнитель
	|ПОМЕСТИТЬ Участники
	|ИЗ
	|	Документ.вмс_ВыборочнаяИнвентаризация.Товары КАК вмс_ВыборочнаяИнвентаризацияТовары
	|ГДЕ
	|	вмс_ВыборочнаяИнвентаризацияТовары.Ссылка = &Документ
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_ВыборочнаяИнвентаризацияТовары.Исполнитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Участники.Исполнитель КАК Исполнитель,
	|	ЕСТЬNULL(Завершили.Исполнитель, 0) КАК Завершил
	|ПОМЕСТИТЬ Результаты
	|ИЗ
	|	Участники КАК Участники
	|		ЛЕВОЕ СОЕДИНЕНИЕ Завершили КАК Завершили
	|		ПО Участники.Исполнитель = Завершили.Исполнитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Результаты.Исполнитель КАК Исполнитель
	|ИЗ
	|	Результаты КАК Результаты
	|ГДЕ
	|	Результаты.Завершил = 0
	|";
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("СтатусИсполнителя", Справочники.вмс_ЭтапыОперации.НайтиПоНаименованию("Завершена"));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка <> Неопределено Тогда
		Если Выборка.Количество() = 0 Тогда
			
			ДокументОбъект = Документ.ПолучитьОбъект();
			ДокументОбъект.Статус = Справочники.вмс_СтатусыДокументов.ПолучитьСтатус("Ожидает подтверждения", "Выборочная инвентаризация");
			ДокументОбъект.Записать();
			
			МенеджерЗаписи = РегистрыСведений.вмс_СтатусыДокументов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Заполнить(Неопределено);
			МенеджерЗаписи.Период = ТекущаяДата();
			МенеджерЗаписи.Документ = Документ;
			МенеджерЗаписи.Ответственный = Ответственный;
			МенеджерЗаписи.Статус = Справочники.вмс_СтатусыДокументов.ПолучитьСтатус("Ожидает подтверждения", "Выборочная инвентаризация");
			МенеджерЗаписи.Записать();
			
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

