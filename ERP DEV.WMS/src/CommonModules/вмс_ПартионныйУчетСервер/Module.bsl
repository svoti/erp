// СУС:
Функция ПолучитьДанныеДляОтгрузкиСПроверкой(ДокументОснование, ОперацияПлан, ОперацияОтгрузки) Экспорт     
	
	РК = вмс_РаботаСКоллекциями;	
	ВыходнаяСтруктура = Новый Структура;	
	ПараметрыОтбора = Новый Структура("ДокументОснование, ВидОперации, ВключаяДокументыОпераций", ДокументОснование, ОперацияПлан, Неопределено);
	
	ТаблицаОтобраных = вмс_ОперацииПоЯчейкамСервер.ПолучитьТаблицуПринятыхТоваровЧерезСтруктуру(ПараметрыОтбора);     
	
	ПолеКонтейнера = "Контейнер";
	ТаблицаКонтейнеров = ТаблицаОтобраных.Скопировать(, "Контейнер, ЯчейкаПриемник");
	ЗонаОтгрузки = Неопределено;
	Для Каждого Строка Из ТаблицаКонтейнеров Цикл
		Если ЗначениеЗаполнено(Строка.ЯчейкаПриемник) Тогда  
			ЗонаОтгрузки = Строка.ЯчейкаПриемник;
			Прервать;
		КонецЕсли;	
	КонецЦикла;  
	
	ВыходнаяСтруктура.Вставить("ЗонаОтгрузки", ЗонаОтгрузки);
		
	ТаблицаКонтейнеров.Свернуть(ПолеКонтейнера);
	КонтейнерыПоПлану = РК.ВыгрузитьЗначенияКолонкиКоллекции(ТаблицаКонтейнеров, ПолеКонтейнера);    
	РК.УдалитьПустыеСтрокиКоллекции(КонтейнерыПоПлану);
	
	ВыходнаяСтруктура.Вставить("ВходнойМассивКонтейнеров", КонтейнерыПоПлану);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вмс_ОперацияПоЯчейкамТовары.Контейнер КАК Контейнер
		|ИЗ
		|	Документ.вмс_ОперацияПоЯчейкам.Товары КАК вмс_ОперацияПоЯчейкамТовары
		|ГДЕ
		|	вмс_ОперацияПоЯчейкамТовары.Ссылка.ВидОперации = &ВидОперацииОтгрузки
		|	И вмс_ОперацияПоЯчейкамТовары.Ссылка.Проведен
		|	И вмс_ОперацияПоЯчейкамТовары.Ссылка.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ВидОперацииОтгрузки", ОперацияОтгрузки);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	ТаблицаВыполненныхКонтейнеров = Запрос.Выполнить().Выгрузить();
	
	ВыполненныеКонтейнеры = РК.ВыгрузитьЗначенияКолонкиКоллекции(ТаблицаВыполненныхКонтейнеров, ПолеКонтейнера);
	РК.УдалитьПустыеСтрокиКоллекции(ВыполненныеКонтейнеры);

	
	ВыходнаяСтруктура.Вставить("ВыполненныеКонтейнеры", ВыполненныеКонтейнеры);
	
	Возврат ВыходнаяСтруктура;
		
КонецФункции

//3.2.4
Функция ПолучитьКонтейнерРодитель(Контейнер) Экспорт
	
	ТаблицаМестоположенийКонтейнера = ПолучитьМестоположенияКонтейнеров(Контейнер);
	
	Если ТаблицаМестоположенийКонтейнера.Количество() > 0 Тогда
		Возврат ТаблицаМестоположенийКонтейнера[0].КонтейнерРодитель;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьМестоположенияКонтейнеров(Контейнеры, ДополнительныеПараметры=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_МестоположенияКонтейнеровСрезПоследних.Контейнер КАК Контейнер,
	|	вмс_МестоположенияКонтейнеровСрезПоследних.КонтейнерРодитель КАК КонтейнерРодитель,
	|	вмс_МестоположенияКонтейнеровСрезПоследних.КонтейнерОстатковВЯчейках КАК КонтейнерОстатковВЯчейках,
	|	вмс_МестоположенияКонтейнеровСрезПоследних.Ячейка КАК Ячейка
	|ИЗ
	|	РегистрСведений.вмс_МестоположенияКонтейнеров.СрезПоследних(
	|			&Дата,
	|			Контейнер В (&Контейнеры)
	|				И НЕ Регистратор В (&ИсключитьРегистраторы)) КАК вмс_МестоположенияКонтейнеровСрезПоследних";
	Запрос.УстановитьПараметр("Контейнеры", Контейнеры);

	Если ТипЗнч(ДополнительныеПараметры)=Тип("Структура") Тогда
		
		Если ДополнительныеПараметры.Свойство("ИсключитьРегистраторы") Тогда
			ИсключитьРегистраторы = ДополнительныеПараметры.ИсключитьРегистраторы;
		Иначе
			ИсключитьРегистраторы = Новый Массив;
		КонецЕсли;
		
		Если ДополнительныеПараметры.Свойство("Дата") Тогда
			Дата = ДополнительныеПараметры.Дата;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = '00010101';
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ИсключитьРегистраторы", ИсключитьРегистраторы);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаМестоположенийКонтейнеров = РезультатЗапроса.Выгрузить();
	Возврат ТаблицаМестоположенийКонтейнеров;
	
КонецФункции

//3.2.4
Функция НачальноеЗаполнениеВидовКонтейнеров() Экспорт

	НачатьТранзакцию();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТипыКонтейнеров.Ссылка КАК ТипКонтейнера
		|ИЗ
		|	ПланВидовХарактеристик.ТипыКонтейнеров КАК ТипыКонтейнеров";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		пОбъект = Выборка.ТипКонтейнера.ПолучитьОбъект();
		пОбъект.ВидКонтейнера = Перечисления.вмс_ВидыКонтейнеров.Короб;
		пОбъект.ОбменДанными.Загрузка = Истина;
		пОбъект.Записать();
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	
КонецФункции

#КонецОбласти 

#Область ПрограммныйИнтерфейс

// ОХ: Определение операций ОХ по контейнерам.
//
// Параметры:
//  МассивКонтейнеров - Массив - контейнеры, для которых требуется определить операции ОХ.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица соответствия типов контейнеров и операций ОХ.
//
Функция ПолучитьТаблицуОперацийКонтейнеров(МассивКонтейнеров) Экспорт
	Параметры = Новый Структура("МассивКонтейнеров", МассивКонтейнеров); 
	Возврат вмс_ОбщегоНазначенияВызовСервера.Модуль("вмс_ЗащищенныйМодуль").ВыполнитьФункциюКонтейнеров("ПолучитьТаблицуОперацийКонтейнеров", Параметры);
КонецФункции

Функция ПолучитьИнформациюСоставаКонтейнеров(Контейнеры, ДополнительныеПараметры=Неопределено) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ТаблицаСоставаПоКонтейнерам = ПолучитьТаблицуСоставаПоКонтейнерам(Контейнеры, ДополнительныеПараметры);
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////
	ТаблицаСоставаПоКонтейнерамСУчетомИерархии = ТаблицаСоставаПоКонтейнерам.Скопировать();
	ТаблицаСоставаПоКонтейнерамСУчетомИерархии.Колонки.Добавить("Расстояние"); // между контейнерами
	ТаблицаСоставаПоКонтейнерамСУчетомИерархии.ЗаполнитьЗначения(0, "Расстояние");
	
	ОтборПоКонтейнеру = Новый Структура("Контейнер");
	
	Для Каждого ЭлементСостава Из ТаблицаСоставаПоКонтейнерамСУчетомИерархии Цикл
		
		ОтборПоКонтейнеру.Контейнер = ЭлементСостава.Товар;
		ЭлементыСоставаПоИерархии = ТаблицаСоставаПоКонтейнерамСУчетомИерархии.НайтиСтроки(ОтборПоКонтейнеру);
		
		Для Каждого ЭлементСоставаПоИерархии Из ЭлементыСоставаПоИерархии Цикл
			
			ЭлементСоставаСУчетомИерархии = ТаблицаСоставаПоКонтейнерамСУчетомИерархии.Добавить();
			ЗаполнитьЗначенияСвойств(ЭлементСоставаСУчетомИерархии, ЭлементСоставаПоИерархии);
			ЭлементСоставаСУчетомИерархии.Контейнер = ЭлементСостава.Контейнер;
			ЭлементСоставаСУчетомИерархии.Расстояние = ЭлементСостава.Расстояние + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаСоставаПоКонтейнерамСУчетомИерархии.Сортировать("Товар, Расстояние УБЫВ");
	
	ТаблицаСоставаПоКонтейнерамСУчетомИерархии.Колонки.Добавить("ИнвертированноеРасстояние");
	Если ТаблицаСоставаПоКонтейнерамСУчетомИерархии.Количество() > 0 Тогда
		
		МаксРасстояние = Неопределено;
		Контейнер = Неопределено;
		
		Для Каждого ЭлементСостава Из ТаблицаСоставаПоКонтейнерамСУчетомИерархии Цикл
			
			Если Контейнер <> ЭлементСостава.Товар Тогда
				МаксРасстояние = ЭлементСостава.Расстояние;
				Контейнер = ЭлементСостава.Товар;
			КонецЕсли;
			
			ЭлементСостава.ИнвертированноеРасстояние = МаксРасстояние - ЭлементСостава.Расстояние;
			
		КонецЦикла;
		
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////
	ТаблицаКонтейнеровВерхнегоУровня = РК.НоваяКоллекцияЗначений("Контейнер, КонтейнерВерхнегоУровня");
	
	Для Каждого ЭлементСостава Из ТаблицаСоставаПоКонтейнерамСУчетомИерархии.НайтиСтроки(Новый Структура("ИнвертированноеРасстояние, СодержимоеКонтейнер", 0, Истина)) Цикл
		
		КонтейнерВерхнегоУровня = ТаблицаКонтейнеровВерхнегоУровня.Добавить();
		КонтейнерВерхнегоУровня.Контейнер = ЭлементСостава.Товар;
		КонтейнерВерхнегоУровня.КонтейнерВерхнегоУровня = ЭлементСостава.Контейнер;

