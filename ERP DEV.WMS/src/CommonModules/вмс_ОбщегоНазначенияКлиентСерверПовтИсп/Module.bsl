
Функция ШифтСоответствиеСимволов() Экспорт
	Строка1 = "1234567890qwertyuiopasdfghjklzxcvbnm";
	Строка2 = "!@#$%^&*()QWERTYUIOPASDFGHJKLZXCVBNM";
	Массив1 = вмс_РаботаСКоллекциями.СтрокуВМассивПосимвольно(Строка1);
	Массив2 = вмс_РаботаСКоллекциями.СтрокуВМассивПосимвольно(Строка2);
	Соответствие = Новый Соответствие;
	Для Индекс=0 По Массив1.ВГраница() Цикл
		Соответствие[Массив1[Индекс]] = Массив2[Индекс];
	КонецЦикла;
	Возврат Соответствие;
КонецФункции

Функция ШифтСоответствиеСимволовОбратное() Экспорт
	Соответствие = ШифтСоответствиеСимволов();
	СоответствиеОбратное = Новый Соответствие;
	Для Каждого Элемент Из Соответствие Цикл
		СоответствиеОбратное[Элемент.Значение] = Элемент.Ключ;
	КонецЦикла;
	Возврат СоответствиеОбратное;
КонецФункции

Функция МнжожественнаяФормаСлова(Слово) Экспорт
	
	Словарь = Новый Соответствие;
	Словарь["Документ"] = "Документы";
	Словарь["РегистрСведений"] = "РегистрыСведений";
	
	МножественнаяФорма = Словарь[Слово];
	Если МножественнаяФорма = Неопределено Тогда
		МножественнаяФорма = Слово;
	КонецЕсли;
	
	Возврат МножественнаяФорма;
	
КонецФункции

