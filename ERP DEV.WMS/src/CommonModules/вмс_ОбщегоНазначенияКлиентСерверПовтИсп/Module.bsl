КонецФункции

Функция СоответствиеВсехМодулей() Экспорт
	
	Соответствие = Новый Соответствие;
	
	СписокИменОбщихМодулей = вмс_ОбщегоНазначенияВызовСервера.ПолучитьСписокИменОбщихМодулей(вмс_ОбщегоНазначенияКлиентСервер.ЭтоКлиент());
	
	Для каждого ИмяМодуля Из СписокИменОбщихМодулей Цикл
		Попытка
			Модуль = Вычислить(ИмяМодуля);
		Исключение
			Продолжить;
		КонецПопытки;
		Соответствие.Вставить(Модуль, ИмяМодуля);
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция ПолучитьПараметрыПриложения(Номер=0) Экспорт
	
	Перем ПараметрыПриложения;
	
#Если Клиент И НЕ ТолстыйКлиентОбычноеПриложение И НЕ ТолстыйКлиентУправляемоеПриложение Тогда
		
		Возврат Неопределено;
		
#Иначе
		
		НомерКэшированияПараметровПриложения = ПараметрыСеанса.вмс_НомерКэшированияПараметровПриложения;

		Если Номер > НомерКэшированияПараметровПриложения Тогда
			
			// перекэшируем параметры с прошлого номера, чтобы пожили еще чутка
			ПараметрыПриложения = вмс_ОбщегоНазначенияКлиентСерверПовтИсп.ПолучитьПараметрыПриложения(Номер-1);
			
		Иначе
			
			Сериализация = Ложь;
			
			// попробуем восстановить из кэша временного хранилища
			ПараметрыПриложения = ПолучитьИзВременногоХранилища(ПараметрыСеанса.вмс_АдресХранилищаПараметровПриложения);
			
			Если ПараметрыПриложения <> Неопределено Тогда
				ДанныеДляОтладки = ПараметрыПриложения["ДанныеДляОтладки"];
				Сериализация = ДанныеДляОтладки.Ссылка1 <> ДанныеДляОтладки.Ссылка2;
				Если Сериализация Тогда
					// Кэш временного хранилища очистился
					// и параметры были восстановлены из сериализуемых данных
					// данные могут быть кривыми поэтому не используем их.
					// Такое может происходить если сеанс переехал на другой рабочий процесс на сервере
					ПараметрыПриложения = Неопределено;
				ИначеЕсли вмс_ОбщегоНазначенияКлиентСервер.ЭтоДержательМестаДляПараметровПриложения(ПараметрыПриложения) Тогда
					// Это всего лишь держатель места
					// не дождались, значит, когда параметры приложения займут свое законное место в кэше временного хранилища.
					// кэш модуля, с которого параметры должны были пересесть в хранилище, слетел раньше
					ПараметрыПриложения = Неопределено;
				Иначе
					// спасли из кэша временного хранилища
					ДанныеДляОтладки.ЧутьНеПотерялиКэш = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ПараметрыПриложения=Неопределено Тогда
				ПараметрыПриложения = вмс_ОбщегоНазначенияКлиентСервер.НовыеПараметрыПриложения();
				Если Сериализация Тогда
					ДанныеДляОтладки = ПараметрыПриложения["ДанныеДляОтладки"];
					ДанныеДляОтладки.ПотерялиКэш = Истина;
					ДанныеДляОтладки.ПричинаПотериКэша = "Сериализация";
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;

		ДанныеДляОтладки = ПараметрыПриложения["ДанныеДляОтладки"];
		ДанныеДляОтладки.ДатаКэширования = ТекущаяДата();
		
		// подкрепим кэшем хранилища
		ПоместитьВоВременноеХранилище(ПараметрыПриложения, ПараметрыСеанса.вмс_АдресХранилищаПараметровПриложения);
		
		Возврат ПараметрыПриложения;
		
#КонецЕсли
	
КонецФункции
