Функция ПолучитьЦифрыДесятичнойСистемы() Экспорт
	
	Цифры = Новый Массив;
	
	Цифры.Добавить("0");
	Цифры.Добавить("1");
	Цифры.Добавить("2");
	Цифры.Добавить("3");
	Цифры.Добавить("4");
	Цифры.Добавить("5");
	Цифры.Добавить("6");
	Цифры.Добавить("7");
	Цифры.Добавить("8");
	Цифры.Добавить("9");
	
