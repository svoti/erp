Функция ПолучитьСведенияОТипахЭлементовФормы() Экспорт
	
	РК = глОбщийМодуль("РаботаСКоллекциями");

	ТаблицаТиповЭлементов = РК.НоваяКоллекцияЗначений("ТипЭлемента, ВидЭлемента, Представление, Картинка, ДоступенДляВыбора, ЗначенияСвойствЭлементаПоУмолчанию, ЗначениеСвойстваВидЭлемента, ПредставлениеЗначенияСвойстваВидЭлемента");
	РК.ДобавитьИндексКоллекции(ТаблицаТиповЭлементов, "ТипЭлемента, ВидЭлемента");
	РК.ДобавитьИндексКоллекции(ТаблицаТиповЭлементов, "ЗначениеСвойстваВидЭлемента");

	ТаблицаСвойствЭлементов = РК.НоваяКоллекцияЗначений("ТипЭлемента, ВидЭлемента, ИмяСвойства, ПредставлениеСвойства, Тип, ЗначениеПоУмолчанию, СписокВыбора, НесколькоЗначений, СистемноеСвойство, СлабаяСсылка, ОбработчикУстановкиЗначения");
	РК.ДобавитьИндексКоллекции(ТаблицаСвойствЭлементов, "ТипЭлемента, ВидЭлемента, ИмяСвойства");
	
	ТаблицаСобытийЭлементов = РК.НоваяКоллекцияЗначений("ТипЭлемента, ВидЭлемента, ИмяСобытия");
	РК.ДобавитьИндексКоллекции(ТаблицаСобытийЭлементов, "ТипЭлемента, ВидЭлемента, ИмяСобытия");
	
	ТаблицаДопустимостиИерархииЭлементов = РК.НоваяКоллекцияЗначений("ТипЭлемента, ВидЭлемента, ТипПодчиненногоЭлемента, ВидПодчиненногоЭлемента");
	РК.ДобавитьИндексКоллекции(ТаблицаДопустимостиИерархииЭлементов, "ТипЭлемента, ВидЭлемента, ТипПодчиненногоЭлемента, ВидПодчиненногоЭлемента");
	
	СведенияОТипахЭлементовФормы = Новый Структура;
	СведенияОТипахЭлементовФормы.Вставить("ТаблицаТиповЭлементов", ТаблицаТиповЭлементов);
	СведенияОТипахЭлементовФормы.Вставить("ТекущийТипЭлемента");
	СведенияОТипахЭлементовФормы.Вставить("ТекущийВидЭлемента");
	СведенияОТипахЭлементовФормы.Вставить("ТаблицаСвойствЭлементов", ТаблицаСвойствЭлементов);
	СведенияОТипахЭлементовФормы.Вставить("ТаблицаСобытийЭлементов", ТаблицаСобытийЭлементов);
	СведенияОТипахЭлементовФормы.Вставить("ТаблицаДопустимостиИерархииЭлементов", ТаблицаДопустимостиИерархииЭлементов);
	СведенияОТипахЭлементовФормы.Вставить("ВидыЭлементовПоЗначениям", Новый Соответствие); // Имена типа и вида элемента по значению свойства "Вид" элемента
	
	ЗарегистрироватьТипФорма(СведенияОТипахЭлементовФормы);
	ЗарегистрироватьТипЭлементаГруппаФормы(СведенияОТипахЭлементовФормы);
	ЗарегистрироватьТипЭлементаДекорацияФормы(СведенияОТипахЭлементовФормы);
	ЗарегистрироватьТипЭлементаПолеФормы(СведенияОТипахЭлементовФормы);
	ЗарегистрироватьТипЭлементаКнопкаФормы(СведенияОТипахЭлементовФормы);
	ЗарегистрироватьТипТаблицаФормы(СведенияОТипахЭлементовФормы);

	Возврат СведенияОТипахЭлементовФормы;
	
КонецФункции

Функция ЗарегистрироватьТипФорма(СведенияОТипахЭлементовФормы)

	ЗарегистрироватьТипЭлементаФормы(СведенияОТипахЭлементовФормы, "ФормаКлиентскогоПриложения", "Форма", БиблиотекаКартинок.Форма, Ложь);

	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, "ГруппаФормы, ОбычнаяГруппа, Страницы, КоманднаяПанель");
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, "ПолеФормы, ПолеВвода, ПолеФлажка, ПолеНадписи, ПолеКартинки");
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, "ДекорацияФормы, Надпись, Картинка");
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, "КнопкаФормы, ОбычнаяКнопка, Гиперссылка");
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, "ТаблицаФормы");
	
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "АвтоЗаголовок", "Авто заголовок", "Булево", Истина);
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Заголовок", "Заголовок", "Строка", "");
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "РежимОткрытияОкна", "Режим открытия окна", "РежимОткрытияОкнаФормы", РежимОткрытияОкнаФормы.Независимый);
	
	ЗарегистрироватьСобытиеЭлементаФормы(СведенияОТипахЭлементовФормы, "ПриСозданииНаСервере");
	ЗарегистрироватьСобытиеЭлементаФормы(СведенияОТипахЭлементовФормы, "ПриОткрытии");
	ЗарегистрироватьСобытиеЭлементаФормы(СведенияОТипахЭлементовФормы, "ПередЗакрытием");
	ЗарегистрироватьСобытиеЭлементаФормы(СведенияОТипахЭлементовФормы, "ПриЗакрытии");
	ЗарегистрироватьСобытиеЭлементаФормы(СведенияОТипахЭлементовФормы, "ОбработкаОповещения");
	
КонецФункции

