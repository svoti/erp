Функция ЗарегистрироватьТипЭлементаФормы(СведенияОТипахЭлементовФормы, ИмяТипа, ПредставлениеТипаЭлемента, Картинка, ДоступенДляВыбора=Истина)

	СведенияОТипахЭлементовФормы.ТекущийТипЭлемента = ИмяТипа;
	
	СтрокаТипаЭлемента = ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, "", ПредставлениеТипаЭлемента, Картинка, ДоступенДляВыбора);
	
	Возврат СтрокаТипаЭлемента;
	
КонецФункции

Функция ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, ВидЭлемента, ПредставлениеВидаЭлемента, Картинка, ДоступенДляВыбора=Истина, ЗначенияСвойствЭлементаПоУмолчанию=Неопределено)

	РК = глОбщийМодуль("РаботаСКоллекциями");

	ТаблицаТиповЭлементов = СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов;
	ТипЭлемента = СведенияОТипахЭлементовФормы.ТекущийТипЭлемента;
	
	СтрокаТипаЭлемента = РК.ДобавитьЭлементКоллекции(ТаблицаТиповЭлементов);
	СтрокаТипаЭлемента.ТипЭлемента = ТипЭлемента;
	СтрокаТипаЭлемента.ВидЭлемента = ВидЭлемента;
	СтрокаТипаЭлемента.Представление = ПредставлениеВидаЭлемента;
	СтрокаТипаЭлемента.Картинка = Картинка;
	СтрокаТипаЭлемента.ДоступенДляВыбора = ДоступенДляВыбора;
	СтрокаТипаЭлемента.ЗначенияСвойствЭлементаПоУмолчанию = Новый Структура;
	
	Если ТипЗнч(ЗначенияСвойствЭлементаПоУмолчанию)=Тип("Структура") Тогда
		Для Каждого ЗначениеСвойства Из ЗначенияСвойствЭлементаПоУмолчанию Цикл
			СтрокаТипаЭлемента.ЗначенияСвойствЭлементаПоУмолчанию.Вставить(ЗначениеСвойства.Ключ, ЗначениеСвойства.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ВидЭлемента <> "" Тогда
		// скопировать общие свойства
		ОбщиеСвойства = ПолучитьСвойстваЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, "");
		Для Каждого ОбщееСвойство Из ОбщиеСвойства Цикл
			Если РК.НайтиЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента, ИмяСвойства", ТипЭлемента, ВидЭлемента, ОбщееСвойство.ИмяСвойства))<>Неопределено Тогда
				Продолжить;
			КонецЕсли;			
			СтрокаСвойства = РК.ДобавитьЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов);
			ЗаполнитьЗначенияСвойств(СтрокаСвойства, ОбщееСвойство);
			СтрокаСвойства.ВидЭлемента = ВидЭлемента;
			РК.ИндексироватьКоллекцию(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов, СтрокаСвойства);
		КонецЦикла;

		// заполнить значение вида элемента
		СвойствоВидЭлемента = ПолучитьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента, "Вид");
		Если СвойствоВидЭлемента <> Неопределено Тогда
			ПеречислениеВидовЭлемента = Вычислить(СвойствоВидЭлемента.Тип);
			СтрокаТипаЭлемента.ЗначениеСвойстваВидЭлемента = ПеречислениеВидовЭлемента[ВидЭлемента];
			СтрокаТипаЭлемента.ПредставлениеЗначенияСвойстваВидЭлемента = Строка(СтрокаТипаЭлемента.ЗначениеСвойстваВидЭлемента);
			СвойствоВидЭлемента.ЗначениеПоУмолчанию = ПеречислениеВидовЭлемента[ВидЭлемента];
		Иначе
			СтрокаТипаЭлемента.ПредставлениеЗначенияСвойстваВидЭлемента = "";
		КонецЕсли;

		// скопировать общие события
		ОбщиеСобытия = ПолучитьСобытияЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, "");
		Для Каждого ОбщееСобытие Из ОбщиеСобытия Цикл
			Если РК.НайтиЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента, ИмяСобытия", ТипЭлемента, ВидЭлемента, ОбщееСобытие.ИмяСобытия))<>Неопределено Тогда
				Продолжить;
			КонецЕсли;			
			СтрокаСобытия = РК.ДобавитьЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов);
			ЗаполнитьЗначенияСвойств(СтрокаСобытия, ОбщееСобытие);
			СтрокаСобытия.ВидЭлемента = ВидЭлемента;
			РК.ИндексироватьКоллекцию(СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов, СтрокаСобытия);
		КонецЦикла;
	КонецЕсли;

	РК.ИндексироватьКоллекцию(ТаблицаТиповЭлементов, СтрокаТипаЭлемента);
	
	СведенияОТипахЭлементовФормы.ТекущийВидЭлемента = ВидЭлемента;
	
	Если СтрокаТипаЭлемента.ЗначениеСвойстваВидЭлемента <> Неопределено Тогда
		СведенияОТипахЭлементовФормы.ВидыЭлементовПоЗначениям[СтрокаТипаЭлемента.ЗначениеСвойстваВидЭлемента] = Новый Структура("ТипЭлемента, ВидЭлемента", ТипЭлемента, ВидЭлемента);
	КонецЕсли;
	
	Возврат СтрокаТипаЭлемента;
	
КонецФункции

Функция ПолучитьСведенияОТипеЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента) Экспорт

	РК = глОбщийМодуль("РаботаСКоллекциями");

	Возврат РК.НайтиЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента", ТипЭлемента, ВидЭлемента));
	
КонецФункции

Функция ПолучитьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента="", ИмяСвойства) Экспорт

	РК = глОбщийМодуль("РаботаСКоллекциями");

	СвойствоЭлемента = РК.НайтиЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента, ИмяСвойства", ТипЭлемента, ВидЭлемента, ИмяСвойства));
	
	Возврат СвойствоЭлемента;
	
КонецФункции

Функция ПолучитьСвойстваЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента="") Экспорт
	
	РК = глОбщийМодуль("РаботаСКоллекциями");

	МассивСвойств = РК.НайтиЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента", ТипЭлемента, ВидЭлемента));
	
	Возврат МассивСвойств;
	
КонецФункции

Функция ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, ИмяСвойства, знач ПредставлениеСвойства=Неопределено, знач Тип=Неопределено, ЗначениеПоУмолчанию=Неопределено, знач СписокВыбора=Неопределено, СистемноеСвойство=Ложь) Экспорт

	Перем РК, ОбщегоНазначенияКлиентСервер;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
	Если СписокВыбора=Неопределено Тогда
		ДанныеТипаОбъекта = ОбщегоНазначенияКлиентСервер.ПолучитьДанныеТипаОбъекта(Тип);
		Если ДанныеТипаОбъекта.ЭтоПеречисление И ДанныеТипаОбъекта.МенеджерОбъектов<>Неопределено Тогда
			СписокВыбора = Новый СписокЗначений;
			Для Каждого ЭлементПеречисления Из ДанныеТипаОбъекта.МенеджерОбъектов Цикл
				СписокВыбора.Добавить(ЭлементПеречисления, Строка(ЭлементПеречисления));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаСвойства = РК.ДобавитьЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов);
	СтрокаСвойства.ТипЭлемента = СведенияОТипахЭлементовФормы.ТекущийТипЭлемента;
	СтрокаСвойства.ВидЭлемента = СведенияОТипахЭлементовФормы.ТекущийВидЭлемента;
	СтрокаСвойства.ИмяСвойства = ИмяСвойства;
	СтрокаСвойства.ПредставлениеСвойства = ПредставлениеСвойства;
	СтрокаСвойства.Тип = Тип;
	СтрокаСвойства.ЗначениеПоУмолчанию = ЗначениеПоУмолчанию;
	СтрокаСвойства.СписокВыбора = СписокВыбора;
	СтрокаСвойства.НесколькоЗначений = Ложь;
	СтрокаСвойства.СистемноеСвойство = СистемноеСвойство;
	СтрокаСвойства.СлабаяСсылка = Ложь;
	РК.ИндексироватьКоллекцию(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов, СтрокаСвойства);
	
	Возврат СтрокаСвойства;
	
КонецФункции

Функция УдалитьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, ИмяСвойства) Экспорт

	РК = глОбщийМодуль("РаботаСКоллекциями");

	Свойство = РК.НайтиЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента, ИмяСвойства", СведенияОТипахЭлементовФормы.ТекущийТипЭлемента, СведенияОТипахЭлементовФормы.ТекущийВидЭлемента, ИмяСвойства));
	РК.УдалитьЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов, Свойство);
	
КонецФункции

Функция ПолучитьСобытияЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента="") Экспорт

	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	СтрокиСобытий = РК.НайтиЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента", ТипЭлемента, ВидЭлемента));
	
	Возврат СтрокиСобытий;

КонецФункции

Функция ЗарегистрироватьСобытиеЭлементаФормы(СведенияОТипахЭлементовФормы, ИмяСобытия)
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	СтрокаСобытияЭлемента = РК.ДобавитьЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов);
	СтрокаСобытияЭлемента.ТипЭлемента = СведенияОТипахЭлементовФормы.ТекущийТипЭлемента;
	СтрокаСобытияЭлемента.ВидЭлемента = СведенияОТипахЭлементовФормы.ТекущийВидЭлемента;
	СтрокаСобытияЭлемента.ИмяСобытия = ИмяСобытия;
	РК.ИндексироватьКоллекцию(СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов, СтрокаСобытияЭлемента);
	
	Возврат СтрокаСобытияЭлемента;
	
КонецФункции

Функция ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, ПодчиненныеТипыЭлементов) Экспорт
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	МассивПодчиненныхТиповЭлементов = РК.СтрокуВМассив(ПодчиненныеТипыЭлементов, Символы.ПС);
	
	ДанныеЭлемента = Новый Структура("ТипЭлемента, ВидЭлемента, ТипПодчиненногоЭлемента, ВидПодчиненногоЭлемента");
	ДанныеЭлемента.ТипЭлемента = СведенияОТипахЭлементовФормы.ТекущийТипЭлемента;
	ДанныеЭлемента.ВидЭлемента = СведенияОТипахЭлементовФормы.ТекущийВидЭлемента;
	
	Для Каждого ПодчиненныйТипЭлемента Из МассивПодчиненныхТиповЭлементов Цикл
		
		МассивСвойствПодчиненногоТипаЭлемента = РК.СтрокуВМассив(ПодчиненныйТипЭлемента, ",");
		ДанныеЭлемента.ТипПодчиненногоЭлемента = МассивСвойствПодчиненногоТипаЭлемента[0];
		Если МассивСвойствПодчиненногоТипаЭлемента.Количество() < 2 Тогда
			// вид элемента не указан, добавим пустой вид
			МассивСвойствПодчиненногоТипаЭлемента.Добавить("");
		КонецЕсли;
		
		Для НомерСвойства=1 По МассивСвойствПодчиненногоТипаЭлемента.ВГраница() Цикл
			ДанныеЭлемента.ВидПодчиненногоЭлемента = МассивСвойствПодчиненногоТипаЭлемента[НомерСвойства];
			РК.ДобавитьЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаДопустимостиИерархииЭлементов, ДанныеЭлемента);
		КонецЦикла
		
	КонецЦикла;
	
КонецФункции

Функция СкопироватьТипЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента, НовыйТипЭлемента, НовыйВидЭлемента) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	ТаблицыТипаЭлемента = Новый Массив;
	ТаблицыТипаЭлемента.Добавить(СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов);
	ТаблицыТипаЭлемента.Добавить(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов);
	ТаблицыТипаЭлемента.Добавить(СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов);
	ТаблицыТипаЭлемента.Добавить(СведенияОТипахЭлементовФормы.ТаблицаДопустимостиИерархииЭлементов);
	
	Отбор = Новый Структура("ТипЭлемента, ВидЭлемента", ТипЭлемента, ВидЭлемента);
	Для Каждого ТаблицаТипаЭлемента Из ТаблицыТипаЭлемента Цикл
		Для Каждого СвойствоТипаЭлемента Из РК.НайтиЭлементыКоллекции(ТаблицаТипаЭлемента, Отбор) Цикл
			СвойствоНовогоТипаЭлемента = РК.ДобавитьЭлементКоллекции(ТаблицаТипаЭлемента);
			ЗаполнитьЗначенияСвойств(СвойствоНовогоТипаЭлемента, СвойствоТипаЭлемента);
			СвойствоНовогоТипаЭлемента.ТипЭлемента = НовыйТипЭлемента;
			СвойствоНовогоТипаЭлемента.ВидЭлемента = НовыйВидЭлемента;
			РК.ИндексироватьКоллекцию(ТаблицаТипаЭлемента, СвойствоНовогоТипаЭлемента);
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаТипаЭлемента = СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов;
	СведенияОТипеЭлемента = ПолучитьСведенияОТипеЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента);
	СведенияОНовомТипеЭлемента = ПолучитьСведенияОТипеЭлементаФормы(СведенияОТипахЭлементовФормы, НовыйТипЭлемента, НовыйВидЭлемента);
	РК.СдвинутьЭлементКоллекции(ТаблицаТипаЭлемента, СведенияОНовомТипеЭлемента, РК.НомерЭлементаКоллекции(ТаблицаТипаЭлемента, СведенияОТипеЭлемента)+1);
	СведенияОНовомТипеЭлемента.Представление = НовыйТипЭлемента;
	Если ЗначениеЗаполнено(НовыйВидЭлемента) Тогда
		СведенияОНовомТипеЭлемента.Представление = СведенияОНовомТипеЭлемента.Представление + " - " + НовыйВидЭлемента;
	КонецЕсли;
	
	Для Каждого СвойствоЭлементаФормы Из ПолучитьСвойстваЭлементаФормы(СведенияОТипахЭлементовФормы, НовыйТипЭлемента, НовыйВидЭлемента) Цикл
		СвойствоЭлементаФормы.СписокВыбора = РК.СкопироватьОбъект(СвойствоЭлементаФормы.СписокВыбора);
	КонецЦикла;
	
	ТаблицаТипаЭлемента = СведенияОТипахЭлементовФормы.ТаблицаДопустимостиИерархииЭлементов;
	Отбор = Новый Структура("ТипПодчиненногоЭлемента, ВидПодчиненногоЭлемента", ТипЭлемента, ВидЭлемента);
	Для Каждого СвойствоТипаЭлемента Из РК.НайтиЭлементыКоллекции(ТаблицаТипаЭлемента, Отбор) Цикл
		СвойствоНовогоТипаЭлемента = РК.ДобавитьЭлементКоллекции(ТаблицаТипаЭлемента);
		ЗаполнитьЗначенияСвойств(СвойствоНовогоТипаЭлемента, СвойствоТипаЭлемента);
		СвойствоНовогоТипаЭлемента.ТипПодчиненногоЭлемента = НовыйТипЭлемента;
		СвойствоНовогоТипаЭлемента.ВидПодчиненногоЭлемента = НовыйВидЭлемента;
		РК.ИндексироватьКоллекцию(ТаблицаТипаЭлемента, СвойствоНовогоТипаЭлемента);
	КонецЦикла;
	
	СведенияОТипахЭлементовФормы.ТекущийТипЭлемента = НовыйТипЭлемента;
	СведенияОТипахЭлементовФормы.ТекущийВидЭлемента = НовыйВидЭлемента;
	
КонецФункции

Функция ПолучитьСписокВыбораДоступныхВидовЭлемента(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента, РодительскиеЭлементы=Неопределено) Экспорт

	ДоступныеВидыЭлемента = ПолучитьДоступныеВидыЭлемента(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента, РодительскиеЭлементы);
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого ДоступныйВидЭлемента Из ДоступныеВидыЭлемента Цикл
		СписокВыбора.Добавить(ДоступныйВидЭлемента, ДоступныйВидЭлемента.ПредставлениеЗначенияСвойстваВидЭлемента);
	КонецЦикла;
	
	Возврат СписокВыбора;

КонецФункции

Функция ПолучитьДоступныеВидыЭлемента(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента, РодительскиеЭлементы=Неопределено) Экспорт

	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	СтрокаОбщегоТипаЭлемента = РК.НайтиЭлементКоллекции(СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента", ТипЭлемента, ""));
	Если СтрокаОбщегоТипаЭлемента<>Неопределено И Не СтрокаОбщегоТипаЭлемента.ДоступенДляВыбора И ВидЭлемента<>"" Тогда
		
		// Общий тип недоступен для выбора
		// при создании элемента сразу укзывается его вид и далее не меняется
		// ограничим список выбора только текущим видом элемента
		ДоступныеВидыЭлемента = РК.НайтиЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента", ТипЭлемента, ВидЭлемента))
		
	Иначе
	
		ДоступныеВидыЭлемента = ПолучитьДоступныеТипыИВидыЭлементов(СведенияОТипахЭлементовФормы, ТипЭлемента, РодительскиеЭлементы);
		
		Для Каждого ДоступныйВидЭлемента Из ДоступныеВидыЭлемента Цикл
			
			Если ДоступныйВидЭлемента.ВидЭлемента="" Тогда
				
				НайденныеВидыЭлементов = РК.НайтиЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов, Новый Структура("ТипЭлемента", ДоступныйВидЭлемента.ТипЭлемента));
				
				Для Каждого НайденныйВидЭлемента Из НайденныеВидыЭлементов Цикл
					Если НайденныйВидЭлемента.ВидЭлемента="" Тогда
						Продолжить;
					КонецЕсли;
					
					Если РодительскиеЭлементы<>Неопределено Тогда
						Если Не ПроверитьВозможностьПодчиненияЭлементов(СведенияОТипахЭлементовФормы, РодительскиеЭлементы, НайденныйВидЭлемента) Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
						
					ДоступныеВидыЭлемента.Добавить(НайденныйВидЭлемента);
				КонецЦикла;

			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

	ЗарегистрированныеВидыЭлементов = Новый Соответствие;
	
	НомерВидаЭлемента = ДоступныеВидыЭлемента.Количество();
	Пока НомерВидаЭлемента>0 Цикл
		НомерВидаЭлемента = НомерВидаЭлемента - 1;
		
		ДоступныйВидЭлемента = ДоступныеВидыЭлемента[НомерВидаЭлемента];

		Если ДоступныйВидЭлемента.ВидЭлемента="" Тогда
			ДоступныеВидыЭлемента.Удалить(НомерВидаЭлемента);
			Продолжить;
		КонецЕсли;
		
		Если ЗарегистрированныеВидыЭлементов[ДоступныйВидЭлемента.ВидЭлемента]=Истина Тогда
			// Могут повторяться как квази виды (одинаковые виды, но с разными начальными значениями свойств)
			// для выбора значения свойства "вид" повторы не нужны
			ДоступныеВидыЭлемента.Удалить(НомерВидаЭлемента);
			Продолжить;
		КонецЕсли;
		
		ЗарегистрированныеВидыЭлементов[ДоступныйВидЭлемента.ВидЭлемента] = Истина;
	КонецЦикла;
	
	Возврат ДоступныеВидыЭлемента;

КонецФункции

Функция ПолучитьСписокВыбораДоступныхТиповИВидовЭлементов(СведенияОТипахЭлементовФормы, ТипЭлемента=Неопределено, РодительскиеЭлементы=Неопределено) Экспорт
	
	ДоступныеТипыИВидыЭлементов = ПолучитьДоступныеТипыИВидыЭлементов(СведенияОТипахЭлементовФормы, ТипЭлемента, РодительскиеЭлементы);
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого ДоступныйТипИВидЭлемента Из ДоступныеТипыИВидыЭлементов Цикл
		СписокВыбора.Добавить(ДоступныйТипИВидЭлемента, ДоступныйТипИВидЭлемента.Представление);
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

Функция ПолучитьДоступныеТипыИВидыЭлементов(СведенияОТипахЭлементовФормы, ТипЭлемента=Неопределено, РодительскиеЭлементы=Неопределено) Экспорт
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	Если ЗначениеЗаполнено(ТипЭлемента) Тогда
		СтрокиТиповИВидовЭлементов = РК.НайтиЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов, Новый Структура("ТипЭлемента", ТипЭлемента));
	Иначе
		СтрокиТиповИВидовЭлементов = РК.ПолучитьЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов);
	КонецЕсли;
	
	ДоступныеТипыИВидыЭлементов = Новый Массив;
	Для Каждого СтрокаТипаИВидаЭлемента Из СтрокиТиповИВидовЭлементов Цикл
		
		Если Не СтрокаТипаИВидаЭлемента.ДоступенДляВыбора Тогда
			Продолжить;
		КонецЕсли;
		
		Если РодительскиеЭлементы<>Неопределено Тогда
			
			Если РодительскиеЭлементы<>Неопределено Тогда
				Если Не ПроверитьВозможностьПодчиненияЭлементов(СведенияОТипахЭлементовФормы, РодительскиеЭлементы, СтрокаТипаИВидаЭлемента) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		ДоступныеТипыИВидыЭлементов.Добавить(СтрокаТипаИВидаЭлемента);
		
	КонецЦикла;
	
	Возврат ДоступныеТипыИВидыЭлементов;
	
КонецФункции

Функция ПроверитьВозможностьПодчиненияЭлементов(СведенияОТипахЭлементовФормы, Элементы, ПодчиненныеЭлементы) Экспорт
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	МассивЭлементов = РК.ЗначениеВМассив(Элементы, , Ложь);
	МассивПодчиненныхЭлементов = РК.ЗначениеВМассив(ПодчиненныеЭлементы, , Ложь);
	
	Результат = Ложь;
	Для Каждого Элемент Из МассивЭлементов Цикл
		
		Если Элемент=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Истина;

		Для Каждого ПодчиненныйЭлемент Из МассивПодчиненныхЭлементов Цикл
			Если Не ПроверитьВозможностьПодчиненияЭлемента(СведенияОТипахЭлементовФормы, Элемент.ТипЭлемента, Элемент.ВидЭлемента, ПодчиненныйЭлемент.ТипЭлемента, ПодчиненныйЭлемент.ВидЭлемента) Тогда
				Результат = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Если Результат Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьВозможностьПодчиненияЭлемента(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента, ТипПодчиненногоЭлемента, ВидПодчиненногоЭлемента) Экспорт
	
	Возврат ПолучитьТипыПодчиненныхЭлементов(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента, ТипПодчиненногоЭлемента, ВидПодчиненногоЭлемента).Количество()>0;
	
КонецФункции

Функция ПолучитьТипыПодчиненныхЭлементов(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента, ТипПодчиненногоЭлемента=Неопределено, ВидПодчиненногоЭлемента=Неопределено) Экспорт

    РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ТаблицаДопустимостиИерархииЭлементов = СведенияОТипахЭлементовФормы.ТаблицаДопустимостиИерархииЭлементов;
	
	Отбор = Новый Структура("ТипЭлемента, ВидЭлемента", ТипЭлемента, ВидЭлемента);
	Если ЗначениеЗаполнено(ТипПодчиненногоЭлемента) Тогда
		Отбор.Вставить("ТипПодчиненногоЭлемента", ТипПодчиненногоЭлемента);
		
		Если ЗначениеЗаполнено(ВидПодчиненногоЭлемента) Тогда
			Отбор.Вставить("ВидПодчиненногоЭлемента", ВидПодчиненногоЭлемента);
		КонецЕсли;
	КонецЕсли;
	
	ТипыПодчиненныхЭлементов = РК.НайтиЭлементыКоллекции(ТаблицаДопустимостиИерархииЭлементов, Отбор);
	
	Возврат ТипыПодчиненныхЭлементов;
	
КонецФункции

Функция ПолучитьСписокЗначенийБулевоПлюсНеопределено()
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить(Неопределено, "Авто");
	СписокВыбора.Добавить(Ложь, "Нет");
	СписокВыбора.Добавить(Истина, "Да");
	
	Возврат СписокВыбора;
	
КонецФункции

Функция ПолучитьТекстРеквизитовМодуляКласса(ОписаниеФормы) Экспорт

	НативныеПоляМассив = Новый Массив;
	НативныеПоляМассив.Добавить("Элементы");
	
	Для Каждого РеквизитФормы Из ОписаниеФормы.ПодчиненныеРеквизиты Цикл
		НативныеПоляМассив.Добавить(РеквизитФормы.ИмяРеквизита);
	КонецЦикла;

	Если НативныеПоляМассив.Количество() > 0 Тогда
		ТекстРеквизитов = "&НаКлиентеНаСервере" + Символы.ПС + "Перем ";
		Разделитель = ", ";
		Для Каждого НативноеПоле Из НативныеПоляМассив Цикл
			ТекстРеквизитов = ТекстРеквизитов + НативноеПоле + " НАТИВНЫЙ" + Разделитель;
		КонецЦикла;
		
		ТекстРеквизитов = Лев(ТекстРеквизитов, СтрДлина(ТекстРеквизитов)-СтрДлина(Разделитель));
		ТекстРеквизитов = ТекстРеквизитов + ";" + Символы.ПС + Символы.ПС;
	Иначе
		ТекстРеквизитов = "";
	КонецЕсли;
	
	Возврат ТекстРеквизитов;
	
КонецФункции

Функция ПолучитьТекстНативныхМетодовМодуляКласса(ОписаниеФормы) Экспорт
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");

	НативныеМетоды =
	"
	|Открыть
	|Открыта
	|Закрыть
	|ИзменитьРеквизиты
	|ВводДоступен
	|";
	
	НативныеМетодыМассив = РК.СтрокуВМассив(НативныеМетоды, Символы.ПС);
	
	ТекстМетодов = "";
	Для Каждого ИмяМетода Из НативныеМетодыМассив Цикл
		ТекстМетодов = ТекстМетодов + "&НаКлиентеНаСервере" + Символы.ПС;
		ТекстМетодов = ТекстМетодов + "Функция " + ИмяМетода + "() НАТИВНАЯ КонецФункции" + Символы.ПС;
	КонецЦикла;
	
	ТекстМетодов = ТекстМетодов + Символы.ПС;

    Возврат ТекстМетодов;
	
КонецФункции

