Функция ПолучитьИмяКлассаМодуляФормы(НаименованиеФормы) Экспорт
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	ИмяКласса = "Форма" + НаименованиеФормы;
	ИмяКласса = РК.ПолучитьИмяПрограммнойПеременнойИзСтроки(ИмяКласса);
	Возврат ИмяКласса;
	
КонецФункции

Функция ПолучитьТекстМодуляКласса(ИмяКласса, ОписаниеФормы) Экспорт
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ДПС = Символы.ПС + Символы.ПС;
	
	ТекстРеквизитов = ПолучитьТекстРеквизитовМодуляКласса(ОписаниеФормы);
	ТекстНативныхМетодов = ПолучитьТекстНативныхМетодовМодуляКласса(ОписаниеФормы);
	
	ТекстМодуля = "";
	ТекстМодуля = ТекстМодуля + "ИспользоватьНативныеМетоды" + Символы.ПС;
	ТекстМодуля = ТекстМодуля + "ИдентификаторыУказателейТекущегоОбъекта ЭтотОбъект, ЭтаФорма" + Символы.ПС;
	ТекстМодуля = ТекстМодуля + "ДирективаКомпиляцииПоУмолчанию НаСервере" + ДПС;
	ТекстМодуля = ТекстМодуля + ТекстРеквизитов + ТекстНативныхМетодов + ОписаниеФормы.ТекстМодуля;
	ТекстМодуля = СокрЛП(ТекстМодуля);
	
	ТекстМодуляКласса = "";
	ТекстМодуляКласса = ТекстМодуляКласса + "#Включить ""БазовыйКласс""" + Символы.ПС;
	ТекстМодуляКласса = ТекстМодуляКласса + "#Включить ""КласснаяСтруктура""" + ДПС;
	ТекстМодуляКласса = ТекстМодуляКласса + "Класс " + ИмяКласса + ДПС;
	ТекстМодуляКласса = ТекстМодуляКласса + РК.ДобавитьОтступСтрок(ТекстМодуля);
	ТекстМодуляКласса = ТекстМодуляКласса + ДПС + "КонецКласса";
	Возврат ТекстМодуляКласса;
	
КонецФункции
