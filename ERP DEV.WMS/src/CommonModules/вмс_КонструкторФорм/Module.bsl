Функция ЗагрузитьОписаниеИзНативногоТекстаXML(ТекстXML) Экспорт

	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	СведенияОТипахЭлементовФормы = ПолучитьСведенияОТипахЭлементовФормыНативногоXML();
	ТаблицаТиповЭлементов = СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов;
	ТаблицаСвойствЭлементов = СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов;
	
	СведенияОТипах = Новый Соответствие;
	СведенияОТипах["string"] = "Строка";
	СведенияОТипах["decimal"] = "Число";
	СведенияОТипах["dateTime"] = "Дата";
	СведенияОТипах["boolean"] = "Булево";
	СведенияОТипах["ValueTable"] = "ТаблицаЗначений";
	СведенияОТипах["ValueListType"] = "СписокЗначений";
	СведенияОТипах["FormattedString"] = "ФорматированнаяСтрока";
	
	ПараметрыЗагрузкиНативногоXML = Новый Структура;
	ПараметрыЗагрузкиНативногоXML.Вставить("СведенияОТипах", СведенияОТипах);
	ПараметрыЗагрузкиНативногоXML.Вставить("СведенияОТипахЭлементовФормы", СведенияОТипахЭлементовФормы);
	
	ОписаниеФормы = НовоеОписаниеФормы();
	ЗаполнитьСвойстваОписанияЭлементаПоУмолчанию(ОписаниеФормы, СведенияОТипахЭлементовФормы);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстXML);
	Если Не (ЧтениеXML.Прочитать() И ЧтениеXML.Имя="Form") Тогда
		Возврат ОписаниеФормы;
	КонецЕсли;
	
	ОписаниеЭлемента = ОписаниеФормы;
	ОписаниеРодителя = Неопределено;
	
	СтекЭлементов = Новый Массив;
	
	ЧтениеНовогоЭлемента = Ложь;

	ОтборТипаЭлемента = Новый Структура("ИмяТипаXML");
	ОтборСвойстваЭлемента = Новый Структура("ТипЭлемента, ВидЭлемента, ИмяСвойстваXML");
	
	ЧтениеXML.Прочитать();
	Пока Истина Цикл
		
		ТипУзла = ЧтениеXML.ТипУзла;
		Если ТипУзла=ТипУзлаXML.Ничего Тогда
			Прервать;
		КонецЕсли;
		
		ИмяУзла = ЧтениеXML.Имя;
		Если ЧтениеНовогоЭлемента Тогда
			
			Если ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
				
				// новый подчиненный элемент
				ОтборТипаЭлемента.ИмяТипаXML = ИмяУзла;
				ОписаниеТипаЭлемента = РК.НайтиЭлементКоллекции(ТаблицаТиповЭлементов, ОтборТипаЭлемента);
				Если ОписаниеТипаЭлемента = Неопределено Тогда
					ЧтениеXML.Пропустить();
					ЧтениеXML.Прочитать();
					Продолжить;
				КонецЕсли;

				ОписаниеЭлемента = НовоеОписаниеЭлемента();
				ОписаниеЭлемента.ИмяЭлемента = ЧтениеXML.ЗначениеАтрибута("name");
				ОписаниеЭлемента.ТипЭлемента = ОписаниеТипаЭлемента.ТипЭлемента;
				ОписаниеЭлемента.ВидЭлемента = ОписаниеТипаЭлемента.ВидЭлемента;
				ЗаполнитьСвойстваОписанияЭлементаПоУмолчанию(ОписаниеЭлемента, СведенияОТипахЭлементовФормы);
				ЗаполнитьЗначенияСвойств(ОписаниеЭлемента.Свойства, ОписаниеТипаЭлемента.ЗначенияСвойствЭлементаПоУмолчанию);
				
				ОписаниеРодителя.ПодчиненныеЭлементы.Добавить(ОписаниеЭлемента);
				
			Иначе
				
				// Подчиненные элементы закончились, вернемся к чтению свойств родительского элемента
				ОписаниеЭлемента = ОписаниеРодителя;

				ОписаниеРодителя = СтекЭлементов[СтекЭлементов.ВГраница()];
				СтекЭлементов.Удалить(СтекЭлементов.ВГраница());
				
			КонецЕсли;

			ЧтениеНовогоЭлемента = Ложь;
			ЧтениеXML.Прочитать();
			
		ИначеЕсли ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
			
			// чтение свойств элемента
			Если ИмяУзла="ChildItems" Тогда
				
				СтекЭлементов.Добавить(ОписаниеРодителя);
				ОписаниеРодителя = ОписаниеЭлемента;
				
				ЧтениеНовогоЭлемента = Истина;
				ЧтениеXML.Прочитать();
				
			ИначеЕсли ИмяУзла="AutoCommandBar" Тогда
				
				// Свойство содержит вложенный элемент
				// перейдем к его чтению
				СтекЭлементов.Добавить(ОписаниеРодителя);
				ОписаниеРодителя = ОписаниеЭлемента;
				
				ЧтениеНовогоЭлемента = Истина;
				
			ИначеЕсли ИмяУзла="Attributes" Тогда
				
				ЗагрузитьРеквизитыНативногоXML(ЧтениеXML, ОписаниеЭлемента, ПараметрыЗагрузкиНативногоXML);
				
			ИначеЕсли ИмяУзла="Commands" Тогда
				
				ЗагрузитьКомандыНативногоXML(ЧтениеXML, ОписаниеЭлемента, ПараметрыЗагрузкиНативногоXML);
				
			ИначеЕсли ИмяУзла="Events" Тогда
				
				ЗагрузитьСобытияНативногоXML(ЧтениеXML, ОписаниеЭлемента, ПараметрыЗагрузкиНативногоXML);
				
			Иначе
				
				ОтборСвойстваЭлемента.ТипЭлемента = ОписаниеЭлемента.ТипЭлемента;
				ОтборСвойстваЭлемента.ВидЭлемента = ОписаниеЭлемента.ВидЭлемента;
				ОтборСвойстваЭлемента.ИмяСвойстваXML = ИмяУзла;
				ОписаниеСвойстваЭлемента = РК.НайтиЭлементКоллекции(ТаблицаСвойствЭлементов, ОтборСвойстваЭлемента);
				Если ОписаниеСвойстваЭлемента=Неопределено Тогда
					ЧтениеXML.Пропустить();
					ЧтениеXML.Прочитать();
					Продолжить;
				КонецЕсли;
				
				ЗначениеСвойства = ПрочитатьЗначениеСвойстваЭлементаФормыНативногоXML(ЧтениеXML, ОписаниеСвойстваЭлемента, ПараметрыЗагрузкиНативногоXML);
				
				Если ОписаниеСвойстваЭлемента.ИмяСвойства="Вид" Тогда
					// уточнение вида элемента
					ОписаниеТипаЭлемента = РК.НайтиЭлементКоллекции(ТаблицаТиповЭлементов, Новый Структура("ЗначениеСвойстваВидЭлемента", ЗначениеСвойства));
					ОписаниеЭлемента.ВидЭлемента = ОписаниеТипаЭлемента.ВидЭлемента;
					ЗаполнитьСвойстваОписанияЭлементаПоУмолчанию(ОписаниеЭлемента, СведенияОТипахЭлементовФормы);
					ЗаполнитьЗначенияСвойств(ОписаниеЭлемента.Свойства, ОписаниеТипаЭлемента.ЗначенияСвойствЭлементаПоУмолчанию);
				КонецЕсли;
				
				ОписаниеЭлемента.Свойства[ОписаниеСвойстваЭлемента.ИмяСвойства] = ЗначениеСвойства;
				
			КонецЕсли;
			
		Иначе
			
			Если ИмяУзла="AutoCommandBar" Тогда
				// Прочитали вложенный элемент в списке свойств родительского элемента
				// возвращаемся к чтению следующих свойств родительского элемента
				ОписаниеРодителя.Вставить("КоманднаяПанель", ОписаниеЭлемента);
				
				ОписаниеЭлемента = ОписаниеРодителя;
				ОписаниеРодителя = СтекЭлементов[СтекЭлементов.ВГраница()];
				СтекЭлементов.Удалить(СтекЭлементов.ВГраница());
			Иначе
				// свойства элемента закончились, ожидаем чтение следующего элемента
				ЧтениеНовогоЭлемента = Истина;
			КонецЕсли;
			
			ЧтениеXML.Прочитать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьДополнительныеСвойстваОписанияФормы(ОписаниеФормы);
	
	Для Каждого ОписаниеЭлемента Из ОписаниеФормы.Элементы Цикл
		
		Если ОписаниеЭлемента.ТипЭлемента="КнопкаФормы" Тогда
			
			МассивЧастейИмениКоманды = РК.СтрокуВМассив(ОписаниеЭлемента.Свойства.ИмяКоманды, ".");
			ОписаниеЭлемента.Свойства.ИмяКоманды = МассивЧастейИмениКоманды[МассивЧастейИмениКоманды.ВГраница()];
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОписаниеФормы;
	
КонецФункции

Функция ПрочитатьЗначениеСвойстваЭлементаФормыНативногоXML(ЧтениеXML, ОписаниеСвойстваЭлемента, ПараметрыЗагрузкиНативногоXML)
	
	Значение = ПрочитатьЗначениеСвойстваНативногоXML(ЧтениеXML, ОписаниеСвойстваЭлемента.Тип, ПараметрыЗагрузкиНативногоXML);
	Возврат Значение;
	
КонецФункции

Функция ПрочитатьЗначениеСвойстваНативногоXML(ЧтениеXML, Тип, ПараметрыЗагрузкиНативногоXML)
	
	Перем РК, ОбщегоНазначенияКлиентСервер;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
	Если Тип="Строка" Тогда
		ЧтениеXML.Прочитать();
		Если ЧтениеXML.ТипУзла=ТипУзлаXML.Текст Тогда
			// обычная строка
			Значение = ЧтениеXML.Значение;
			ЧтениеXML.Прочитать();
			ЧтениеXML.Прочитать();
			Возврат Значение;
		ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
			// пустая строка
			Значение = "";
			ЧтениеXML.Прочитать();
			Возврат Значение;
		Иначе
			// мультиязычная строка
			Уровень = 1;
			ЧастиСтроки = Новый Массив;
			Пока Истина Цикл
				Если ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
					Уровень = Уровень + 1;
					Имя = ЧтениеXML.Имя;
					Если Имя="v8:item" Тогда
						ЧастьСтроки = Новый Структура("Язык, Содердимое", "", "");
					ИначеЕсли Имя="v8:lang" Тогда
						Имя = "Язык";
					ИначеЕсли Имя="v8:content" Тогда
						Имя = "Содержимое";
					Иначе
						Имя = Неопределено;
					КонецЕсли;
				ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.Текст Тогда
					Если Имя<>Неопределено Тогда
						ЧастьСтроки.Вставить(Имя, ЧтениеXML.Значение);
					КонецЕсли;
				Иначе
					Уровень = Уровень - 1;
					Если Уровень=0 Тогда
						Прервать;
					ИначеЕсли Уровень=1 Тогда
						ЧастиСтроки.Добавить(ЧастьСтроки);
					КонецЕсли;
				КонецЕсли;
				ЧтениеXML.Прочитать();
			КонецЦикла;
			ЧтениеXML.Прочитать();
			
			МультиЯзычнаяСтрока = "";
			Для Каждого ЧастьСтроки Из ЧастиСтроки Цикл
				Если МультиЯзычнаяСтрока<>"" Тогда
					МультиЯзычнаяСтрока = МультиЯзычнаяСтрока + "; ";
				КонецЕсли;
				МультиЯзычнаяСтрока = МультиЯзычнаяСтрока + ЧастьСтроки.Язык + " = '" + ЧастьСтроки.Содержимое + "'";
			КонецЦикла;
			Значение = НСтр(МультиЯзычнаяСтрока);
			Возврат Значение;
		КонецЕсли;
		
	ИначеЕсли Тип="Цвет" Тогда
		
		ЧтениеXML.Прочитать();
		ТекстЦвета = ЧтениеXML.Значение;
		ЧтениеXML.Прочитать();
		ЧтениеXML.Прочитать();
		
		ЧастиЦвета = РК.СтрокуВМассив(ТекстЦвета, ":");
		Если ЧастиЦвета.Количество() = 1 Тогда
			// абсолютный цвет
			ТипДанныхXML = СериализаторXDTO.XMLТип(Тип(Тип));
			ТипОбъектаXDTO = ФабрикаXDTO.Тип(ТипДанныхXML);
			ЦветXDTO = ФабрикаXDTO.Создать(ТипОбъектаXDTO, ТекстЦвета);
			Значение = ЦветXDTO.Значение;
		Иначе
			ИмяКоллекцииЦветов = ЧастиЦвета[0];
			ИмяЦвета = ЧастиЦвета[1];
			
			Если ИмяКоллекцииЦветов = "style" Тогда
				Значение = ОбщегоНазначенияКлиентСервер.ЦветСтиля(ИмяЦвета);
			Иначе
				Значение = WebЦвета[ИмяЦвета];
			КонецЕсли;
		КонецЕсли;
		
		Возврат Значение;
		
	ИначеЕсли Тип="ОписаниеТипов" Тогда
		
		МассивИменТипов = Новый Массив;
		
		Пока Истина Цикл
			
			ЧтениеXML.Прочитать();
			Если ЧтениеXML.ТипУзла<>ТипУзлаXML.НачалоЭлемента Тогда
				Если ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
					ЧтениеXML.Прочитать();
				КонецЕсли;
				Прервать;
			КонецЕсли;
			
			Если ЧтениеXML.Имя="v8:Type" Тогда
				ЧтениеXML.Прочитать();
				ИмяТипаXML = ЧтениеXML.Значение;
				ЧтениеXML.Прочитать();
				
				ИмяТипа = ПолучитьИмяТипаИзНативногоXML(ИмяТипаXML, ПараметрыЗагрузкиНативногоXML);
				МассивИменТипов.Добавить(ИмяТипа);
			Иначе
				ЧтениеXML.Пропустить();
			КонецЕсли;
			
		КонецЦикла;
		
		Значение = ОбщегоНазначенияКлиентСервер.НовоеКвазиОписаниеТипов(МассивИменТипов);
		Возврат Значение;
		
	ИначеЕсли Тип="Картинка" Тогда
		
		ЧтениеXML.Прочитать();
		Пока Истина Цикл
			
			Если ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
				Если ЧтениеXML.Имя="xr:Ref" Тогда
					ЧтениеXML.Прочитать();
					ИмяКартинки = ЧтениеXML.Значение;
					ЧтениеXML.Прочитать();
					ЧтениеXML.Прочитать();
					
					ПозицияВТексте = СтрНайти(ИмяКартинки, ".");
					Если ПозицияВТексте>0 Тогда
						ИмяКартинки = Сред(ИмяКартинки, ПозицияВТексте+1);
					КонецЕсли;
					
					Попытка
						Значение = БиблиотекаКартинок[ИмяКартинки];
					Исключение
					КонецПопытки;
				Иначе
					ЧтениеXML.Пропустить();
					ЧтениеXML.Прочитать();
					Продолжить;
				КонецЕсли;
			Иначе
				Если ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
					ЧтениеXML.Прочитать();
				КонецЕсли;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат Значение;
		
	Иначе
		
		Если Тип="ОтображениеКнопки" Тогда
			Значение = ПрочитатьЗначениеТипаОтображениеКнопкиXML(ЧтениеXML);
			Возврат Значение;
		КонецЕсли;
		
		НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
		ТипДанныхXML = НовыйСериализаторXDTO.XMLТип(Тип(Тип));
		Если ТипДанныхXML<>Неопределено Тогда
			ТипОбъектаXDTO = ФабрикаXDTO.Тип(ТипДанныхXML);
			ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипОбъектаXDTO);
			Значение = НовыйСериализаторXDTO.ПрочитатьXDTO(ОбъектXDTO);

			Возврат Значение;
		КонецЕсли;
		
		ЧтениеXML.Прочитать();
		Если ЧтениеXML.ТипУзла=ТипУзлаXML.Текст Тогда
			ТекстXML = ЧтениеXML.Значение;
			ЧтениеXML.Прочитать();
		Иначе
			ТекстXML = "";
		КонецЕсли;
		ЧтениеXML.Прочитать();
		
		ДанныеТипа = ОбщегоНазначенияКлиентСервер.ПолучитьДанныеТипаОбъекта(Тип);
		Если ДанныеТипа.ЭтоПеречисление Тогда
			Значение = ДанныеТипа.МенеджерОбъектов[ТекстXML];
		Иначе
			Значение = XMLЗначение(Тип(Тип), ТекстXML);
		КонецЕсли;
		
		Возврат Значение;
		
	КонецЕсли;
	
КонецФункции

Функция ПрочитатьЗначениеТипаОтображениеКнопкиXML(ЧтениеXML)

	ЧтениеXML.Прочитать();
	Если ЧтениеXML.ТипУзла=ТипУзлаXML.Текст Тогда
		ТекстXML = ЧтениеXML.Значение;
		ЧтениеXML.Прочитать();
	Иначе
		ТекстXML = "";
	КонецЕсли;
	ЧтениеXML.Прочитать();
	
	Если ТекстXML="TextPicture" Тогда
		ИмяЗначения = "КартинкаИТекст";
	Иначе
		ИмяЗначения = ТекстXML;
	КонецЕсли;
	
	Значение = ОтображениеКнопки[ИмяЗначения];
	
	Возврат Значение;
	
КонецФункции

Функция ЗагрузитьРеквизитыНативногоXML(ЧтениеXML, ОписаниеФормы, ПараметрыЗагрузкиНативногоXML)
	
	Перем РК, ОбщегоНазначенияКлиентСервер;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
	ЧтениеНовогоРеквизита = Истина;
	СтекРеквизитов = Новый Массив;
	
	ОписаниеРодителяРеквизита = ОписаниеФормы;
	
	ЧтениеXML.Прочитать();
	Пока Истина Цикл
		
		Если ЧтениеНовогоРеквизита Тогда
			
			Если ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда

				ОписаниеРеквизита = НовоеОписаниеРеквизита();
				ОписаниеРодителяРеквизита.ПодчиненныеРеквизиты.Добавить(ОписаниеРеквизита);
				Если ЧтениеXML.Имя="AdditionalColumns" Тогда
					ОписаниеРеквизита.Статический = Истина;
					ПутьРеквизита = ЧтениеXML.ЗначениеАтрибута("table");
					ПутьРеквизитаМассив = РК.СтрокуВМассив(ПутьРеквизита, ".");
					ОписаниеРеквизита.ИмяРеквизита = ПутьРеквизитаМассив[ПутьРеквизитаМассив.ВГраница()];
					ОписаниеРеквизита.ТипРеквизита = ОбщегоНазначенияКлиентСервер.НовоеКвазиОписаниеТипов("ТабличнаяЧасть");
					
					СтекРеквизитов.Добавить(ОписаниеРодителяРеквизита);
					ОписаниеРодителяРеквизита = ОписаниеРеквизита;
					
					ЧтениеXML.Прочитать();
					Продолжить;
				КонецЕсли;
				
				ОписаниеРеквизита.ИмяРеквизита = ЧтениеXML.ЗначениеАтрибута("name");
				ЧтениеXML.Прочитать();
				
			ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
				
				// реквизиты закончились
				Если СтекРеквизитов.Количество() > 0 Тогда
					// вернемся к родительскому реквизиту
					ОписаниеРеквизита = ОписаниеРодителяРеквизита;
					ОписаниеРодителяРеквизита = СтекРеквизитов[СтекРеквизитов.ВГраница()];
					СтекРеквизитов.Удалить(СтекРеквизитов.ВГраница());
				Иначе
					// реквизиты закончились на верхнем уровне, то есть совсем
					ЧтениеXML.Прочитать();
					Возврат Истина;
				КонецЕсли;
			
				Если ЧтениеXML.Имя="AdditionalColumns" Тогда
					// "AdditionalColumns" - это отдельный реквизит
					// сначала достали его из стека, а потом достанем родительский реквизит
					ЧтениеXML.Прочитать();
					Продолжить;
				КонецЕсли;
				
				ЧтениеXML.Прочитать();
				
			Иначе
				
				// что-то пошло не так
				Возврат Ложь;
				
			КонецЕсли;

			ЧтениеНовогоРеквизита = Ложь;
			
		ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
			
			// чтение свойств реквизита
			Если ЧтениеXML.Имя="Title" Тогда
				Тип = "Строка";
				ИмяСвойства = "Заголовок";
			ИначеЕсли ЧтениеXML.Имя="Type" Тогда
				Тип = "ОписаниеТипов";
				ИмяСвойства = "ТипРеквизита";
			ИначеЕсли ЧтениеXML.Имя="Columns" Тогда
				// чтение вложенных реквизитов
				ЧтениеНовогоРеквизита = Истина;
				СтекРеквизитов.Добавить(ОписаниеРодителяРеквизита);
				ОписаниеРодителяРеквизита = ОписаниеРеквизита;
				ЧтениеXML.Прочитать();
				Продолжить;
			Иначе
				ЧтениеXML.Пропустить();
				ЧтениеXML.Прочитать();
				Продолжить;
			КонецЕсли;
				
			ЗначениеСвойства = ПрочитатьЗначениеСвойстваНативногоXML(ЧтениеXML, Тип, ПараметрыЗагрузкиНативногоXML);
			ОписаниеРеквизита[ИмяСвойства] = ЗначениеСвойства;
			
		ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
			
			// свойства реквизита закончились, чтение следующего реквизита
			ЧтениеНовогоРеквизита = Истина;
			ЧтениеXML.Прочитать();

		Иначе
			
			// что-то пошло не так
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ПолучитьИмяТипаИзНативногоXML(ИмяТипаXML, ПараметрыЗагрузкиНативногоXML)
	
	ПозицияВТексте = СтрНайти(ИмяТипаXML, ":");
	
	Если ПозицияВТексте>0 Тогда
		// да и без префикса понятно, что за тип
		ИмяТипаXML = Сред(ИмяТипаXML, ПозицияВТексте+1);
	КонецЕсли;
	
	ИмяТипа = ПараметрыЗагрузкиНативногоXML.СведенияОТипах[ИмяТипаXML];
	Если ИмяТипа=Неопределено Тогда
		ИмяТипа = ИмяТипаXML;
	КонецЕсли;
	
	Возврат ИмяТипа;
	
КонецФункции

Функция ЗагрузитьКомандыНативногоXML(ЧтениеXML, ОписаниеФормы, ПараметрыЗагрузкиНативногоXML)
	
	ЧтениеXML.Прочитать();
	
	Пока Истина Цикл
		
		Если ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
			// новая команда
			ОписаниеКоманды = НовоеОписаниеКоманды();
			ОписаниеКоманды.Имя = ЧтениеXML.ЗначениеАтрибута("name");
			ОписаниеФормы.Команды.Добавить(ОписаниеКоманды);
			
			// свойства команды
			ЧтениеXML.Прочитать();
			Пока Истина Цикл
				
				Если ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
					// начало свойства
					ИмяСвойстваXML = ЧтениеXML.Имя;
					Если ИмяСвойстваXML="Title" Тогда
						Тип = "Строка";
						ИмяСвойства = "Заголовок";
					ИначеЕсли ИмяСвойстваXML="Action" Тогда
						Тип = "Строка";
						ИмяСвойства = "Действие";
					ИначеЕсли ИмяСвойстваXML="Representation" Тогда
						Тип = "ОтображениеКнопки";
						ИмяСвойства = "Отображение";
					ИначеЕсли ИмяСвойстваXML="Picture" Тогда
						Тип = "Картинка";
						ИмяСвойства = "Картинка";
					Иначе
						ЧтениеXML.Пропустить();
						ЧтениеXML.Прочитать();
						Продолжить;
					КонецЕсли;
					
					ЗначениеСвойства = ПрочитатьЗначениеСвойстваНативногоXML(ЧтениеXML, Тип, ПараметрыЗагрузкиНативногоXML);
					ОписаниеКоманды[ИмяСвойства] = ЗначениеСвойства;
				ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
					// конец списка свойств
					ЧтениеXML.Прочитать();
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
			
			ЧтениеXML.Прочитать();
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ЗагрузитьСобытияНативногоXML(ЧтениеXML, ОписаниеЭлемента, ПараметрыЗагрузкиНативногоXML)
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ТаблицаСобытийЭлементов = ПараметрыЗагрузкиНативногоXML.СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов;
	ОтборСобытия = Новый Структура;
	ОтборСобытия.Вставить("ТипЭлемента", ОписаниеЭлемента.ТипЭлемента);
	ОтборСобытия.Вставить("ВидЭлемента", ОписаниеЭлемента.ВидЭлемента);
	ОтборСобытия.Вставить("ИмяСобытияXML");
	
	ЧтениеXML.Прочитать();
	
	Пока Истина Цикл
		
		Если ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяСобытияXML = ЧтениеXML.ЗначениеАтрибута("name");
			ИмяОбработчика = ПрочитатьЗначениеСвойстваНативногоXML(ЧтениеXML, "Строка", ПараметрыЗагрузкиНативногоXML);
			
			ОтборСобытия.ИмяСобытияXML = ИмяСобытияXML;
			ОписаниеСобытия = РК.НайтиЭлементКоллекции(ТаблицаСобытийЭлементов, ОтборСобытия);
			
			Если ОписаниеСобытия<>Неопределено Тогда
				ИмяСобытия = ОписаниеСобытия.ИмяСобытия;
				ОписаниеЭлемента.События.Вставить(ИмяСобытия, ИмяОбработчика);
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
			
			ЧтениеXML.Прочитать();
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

