	ОписаниеРеквизита.Вставить("Путь", "");
	ОписаниеРеквизита.Вставить("ПолноеИмяРеквизита", "");
	ОписаниеРеквизита.Вставить("Родитель");
	ОписаниеРеквизита.Вставить("ПодчиненныеРеквизиты", Новый Массив);
	ОписаниеРеквизита.Вставить("Реквизиты", Новый Массив);
	ОписаниеРеквизита.Вставить("Статический", Ложь);
	
	Возврат ОписаниеРеквизита;
	
КонецФункции

