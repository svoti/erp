Функция ЗарегистрироватьТипНативногоЭлементаФормы(СведенияОТипахЭлементовФормы, ИмяТипаXML, ТипЭлемента, ВидЭлемента)
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	СтрокаТипаЭлементаФормы = ПолучитьСведенияОТипеЭлементаФормы(СведенияОТипахЭлементовФормы, ТипЭлемента, ВидЭлемента);
	Если СтрокаТипаЭлементаФормы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаТиповЭлементов = СведенияОТипахЭлементовФормы.ТаблицаТиповЭлементов;
	СтрокаНативногоТипаЭлементаФормы = РК.ДобавитьЭлементКоллекции(ТаблицаТиповЭлементов);
	ЗаполнитьЗначенияСвойств(СтрокаНативногоТипаЭлементаФормы, СтрокаТипаЭлементаФормы);
	СтрокаНативногоТипаЭлементаФормы.ИмяТипаXML = ИмяТипаXML;
	РК.ИндексироватьКоллекцию(ТаблицаТиповЭлементов, СтрокаНативногоТипаЭлементаФормы);
	
	Возврат СтрокаНативногоТипаЭлементаФормы;
	
КонецФункции

Функция ЗарегистрироватьИмяСвойстваНативногоЭлементаФормы(СведенияОТипахЭлементовФормы, ИмяСвойстваXML, ИмяСвойства, ТипЭлемента=Неопределено)

	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ТаблицаСвойствЭлементов = СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов;
	ОтборСвойствЭлементов = Новый Структура("ИмяСвойства", ИмяСвойства);
	Если ТипЭлемента<>Неопределено Тогда
		ОтборСвойствЭлементов.Вставить("ТипЭлемента", ТипЭлемента);
	КонецЕсли;
	
	СтрокиСвойств = РК.НайтиЭлементыКоллекции(ТаблицаСвойствЭлементов, ОтборСвойствЭлементов);
	Для Каждого СтрокаСвойства Из СтрокиСвойств Цикл
		СтрокаСвойства.ИмяСвойстваXML = ИмяСвойстваXML;
	КонецЦикла;
	РК.ИндексироватьКоллекцию(ТаблицаСвойствЭлементов, СтрокиСвойств);
	
	Возврат СтрокиСвойств;
	
КонецФункции

Функция ЗарегистрироватьСобытиеНативногоЭлементаФормы(СведенияОТипахЭлементовФормы, ИмяСобытияXML, ИмяСобытия)

	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ОтборСобытий = Новый Структура;
	ОтборСобытий.Вставить("ИмяСобытия", ИмяСобытия);
	
	НайденныеСобытия = РК.НайтиЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов, ОтборСобытий);
	Для Каждого Событие Из НайденныеСобытия Цикл
		Событие.ИмяСобытияXML = ИмяСобытияXML;
	КонецЦикла;
	РК.ИндексироватьКоллекцию(СведенияОТипахЭлементовФормы.ТаблицаСобытийЭлементов, НайденныеСобытия);
	
КонецФункции

Функция НовоеОписаниеФормы() Экспорт
	
	ОписаниеФормы = НовоеОписаниеЭлемента();
	ОписаниеФормы.ИмяЭлемента = "Форма";
	ОписаниеФормы.ТипЭлемента = "ФормаКлиентскогоПриложения";
	ОписаниеФормы.Вставить("ПодчиненныеРеквизиты", Новый Массив);
	ОписаниеФормы.Вставить("Команды", Новый Массив);
	ОписаниеФормы.Вставить("ТекстМодуля", "");
	ОписаниеФормы.Вставить("Реквизиты", Новый Массив);
	
	Возврат ОписаниеФормы;
	
КонецФункции

// тут заполняются свойства элементов и реквизитов на основе главных свойств
Функция ЗаполнитьДополнительныеСвойстваОписанияФормы(ОписаниеФормы) Экспорт
	
	ОписаниеФормы.Родитель = Неопределено;
	
	ОбходЭлементов = Новый Массив;
	ОбходЭлементов.Добавить(ОписаниеФормы);
	Для Каждого ОписаниеЭлемента Из ОбходЭлементов Цикл
		
		ОписаниеРодителя = ОписаниеЭлемента.Родитель;
		Пока ОписаниеРодителя<>Неопределено Цикл
			ОписаниеРодителя.Элементы.Добавить(ОписаниеЭлемента);
			ОписаниеРодителя = ОписаниеРодителя.Родитель;
		КонецЦикла;
		
		ОписаниеЭлемента.Элементы.Очистить();
		
		Для Каждого ОписаниеПодчиненногоЭлемента Из ОписаниеЭлемента.ПодчиненныеЭлементы Цикл
			ОписаниеПодчиненногоЭлемента.Родитель = ОписаниеЭлемента;
			ОбходЭлементов.Добавить(ОписаниеПодчиненногоЭлемента);
		КонецЦикла;
		
	КонецЦикла;
	
	ОбходРеквизитов = Новый Массив;
	ОписаниеФормы.Реквизиты.Очистить();
	Для Каждого ОписаниеРеквизита Из ОписаниеФормы.ПодчиненныеРеквизиты Цикл
		ОписаниеРеквизита.Путь = "";
		ОписаниеРеквизита.ПолноеИмяРеквизита = ОписаниеРеквизита.ИмяРеквизита;
		ОписаниеРеквизита.Родитель = ОписаниеФормы;
		ОбходРеквизитов.Добавить(ОписаниеРеквизита);
	КонецЦикла;
	
	Для Каждого ОписаниеРеквизита Из ОбходРеквизитов Цикл
		ОписаниеРодителя = ОписаниеРеквизита.Родитель;
		Пока ОписаниеРодителя<>Неопределено Цикл
			ОписаниеРодителя.Реквизиты.Добавить(ОписаниеРеквизита);
			ОписаниеРодителя = ОписаниеРодителя.Родитель;
		КонецЦикла;
		
		ОписаниеРеквизита.Реквизиты.Очистить();
		Для Каждого ОписаниеПодчиненногоРеквизита Из ОписаниеРеквизита.ПодчиненныеРеквизиты Цикл
			ОписаниеПодчиненногоРеквизита.Родитель = ОписаниеРеквизита;
			ОписаниеПодчиненногоРеквизита.Путь = ОписаниеРеквизита.ПолноеИмяРеквизита;
			ОписаниеПодчиненногоРеквизита.ПолноеИмяРеквизита = ОписаниеПодчиненногоРеквизита.Путь + "." + ОписаниеПодчиненногоРеквизита.ИмяРеквизита;
			ОбходРеквизитов.Добавить(ОписаниеПодчиненногоРеквизита);
		КонецЦикла;
	КонецЦикла;
	
КонецФункции

Функция НовоеОписаниеРеквизита() Экспорт
	
	ОписаниеРеквизита = Новый Структура;
