Функция ЗаполнитьСвойстваОписанияЭлементаПоУмолчанию(ОписаниеЭлемента, СведенияОТипахЭлементовФормы) Экспорт
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	СвойстваЭлемента = РК.НайтиЭлементыКоллекции(СведенияОТипахЭлементовФормы.ТаблицаСвойствЭлементов, Новый Структура("ТипЭлемента, ВидЭлемента", ОписаниеЭлемента.ТипЭлемента, ОписаниеЭлемента.ВидЭлемента));
	ОписаниеЭлемента.Свойства.Очистить();
	Для Каждого СвойствоЭлемента Из СвойстваЭлемента Цикл
		ОписаниеЭлемента.Свойства.Вставить(СвойствоЭлемента.ИмяСвойства, СвойствоЭлемента.ЗначениеПоУмолчанию);
	КонецЦикла;
	
КонецФункции

Функция ЗарегистрироватьТипЭлементаГруппаФормы(СведенияОТипахЭлементовФормы)
	
	КартинкаГруппы = БиблиотекаКартинок.вмс_Папка;

	
	// ------------------------------
	ЗарегистрироватьТипЭлементаФормы(СведенияОТипахЭлементовФормы, "ГруппаФормы", "Группа", КартинкаГруппы, Ложь);

	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Имя", "Имя", "Строка", "");
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Вид", "Вид", "ВидГруппыФормы", ВидГруппыФормы.ОбычнаяГруппа);
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Заголовок", "Заголовок", "Строка", "");
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Видимость", "Видимость", "Булево", Истина);
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "РастягиватьПоГоризонтали", "Растягивать по горизонтали", "Булево", Неопределено, ПолучитьСписокЗначенийБулевоПлюсНеопределено());
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "РастягиватьПоВертикали", "Растягивать по вертикали", "Булево", Неопределено, ПолучитьСписокЗначенийБулевоПлюсНеопределено());
	
	
	// ------------------------------
	ПодчиненныеТипыЭлементовОбычнойГруппы =
	"ГруппаФормы, ОбычнаяГруппа, Страницы
	|ПолеФормы, ПолеВвода, ПолеФлажка, ПолеНадписи, ПолеКартинки
	|ДекорацияФормы, Надпись, Картинка
	|КнопкаФормы, ОбычнаяКнопка, Гиперссылка
	|ТаблицаФормы";
	
	ПодчиненныеТипыЭлементовКоманднойПанели =
	"ГруппаФормы, ГруппаКнопок, Подменю
	|КнопкаФормы, КнопкаКоманднойПанели";
	
	// ------------------------------
	ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, "ОбычнаяГруппа", "Группа - обычная", КартинкаГруппы, Истина);
	ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, "ОбычнаяГруппа", "Группа - обычная без отображения", КартинкаГруппы, Истина, Новый Структура("Отображение, ОтображатьЗаголовок", ОтображениеОбычнойГруппы.Нет, Ложь));
	
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, ПодчиненныеТипыЭлементовОбычнойГруппы);

	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Группировка", "Группировка", "ГруппировкаПодчиненныхЭлементовФормы", ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно);
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Отображение", "Отображение", "ОтображениеОбычнойГруппы", ОтображениеОбычнойГруппы.ОбычноеВыделение);
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "ОтображатьЗаголовок", "Отображать заголовок", "Булево", Истина);
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Объединенная", "Объединенная", "Булево", Истина);

	
	// ------------------------------
	ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, "Страницы", "Группа - страницы", КартинкаГруппы, Истина);
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, "ГруппаФормы, Страница");

	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "ОтображениеСтраниц", "Отображение страниц", "ОтображениеСтраницФормы", ОтображениеСтраницФормы.ЗакладкиСверху);
	
	ЗарегистрироватьСобытиеЭлементаФормы(СведенияОТипахЭлементовФормы, "ПриСменеСтраницы");
	
	// ------------------------------
	ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, "Страница", "Группа - страница", КартинкаГруппы, Истина, Новый Структура("Группировка", ГруппировкаПодчиненныхЭлементовФормы.Вертикальная));
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, ПодчиненныеТипыЭлементовОбычнойГруппы);
	
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Группировка", "Группировка", "ГруппировкаПодчиненныхЭлементовФормы", ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно);
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "ОтображатьЗаголовок", "Отображать заголовок", "Булево", Истина);
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Картинка", "Картинка", "Картинка", Новый Картинка);
	
	
	//ГруппаКолонок
	ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, "ГруппаКолонок", "Группа колонок", КартинкаГруппы, Истина);
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, "ГруппаФормы, ГруппаКолонок");
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, "ПолеФормы, ПолеВвода, ПолеФлажка, ПолеНадписи, ПолеКартинки");
	
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Группировка", "Группировка", "ГруппировкаКолонок", ГруппировкаКолонок.Горизонтальная);
	
	//КоманднаяПанель
	ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, "КоманднаяПанель", "Группа - командная панель", КартинкаГруппы, Истина);
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, ПодчиненныеТипыЭлементовКоманднойПанели);
	
	//ГруппаКнопок
	ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, "ГруппаКнопок", "Группа кнопок", КартинкаГруппы, Истина);
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, ПодчиненныеТипыЭлементовКоманднойПанели);
	
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Отображение", "Отображение", "ОтображениеГруппыКнопок", ОтображениеГруппыКнопок.Авто);
	
	//Подменю
	ЗарегистрироватьВидЭлементаФормы(СведенияОТипахЭлементовФормы, "Подменю", "Подменю", КартинкаГруппы, Истина);
	ЗарегистрироватьПодчиненныеТипыЭлементов(СведенияОТипахЭлементовФормы, ПодчиненныеТипыЭлементовКоманднойПанели);

	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Отображение", "Отображение", "ОтображениеКнопки", ОтображениеКнопки.Авто);
	ЗарегистрироватьСвойствоЭлементаФормы(СведенияОТипахЭлементовФормы, "Картинка", "Картинка", "Картинка", Новый Картинка);
	
КонецФункции

Функция ЗарегистрироватьТипЭлементаДекорацияФормы(СведенияОТипахЭлементовФормы)
	
	Перем ОбщегоНазначенияКлиентСервер;
	
	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
