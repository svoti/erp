Функция СоздатьТипизированнуюСериюВмс(РеквизитыСерии) Экспорт
	// Типизация_18.08.25+
	НоваяСерия = Справочники.вмс_СерииНоменклатуры.СоздатьЭлемент();
	НоваяСерия.Заполнить(Неопределено);
	ЗаполнитьЗначенияСвойств(НоваяСерия, РеквизитыСерии);
	НоваяСерия.Наименование = вмс_СерииТоваровСервер.ПолучитьПредставлениеСерии(РеквизитыСерии);
	НоваяСерия.Записать();
	СсылкаНаСерию = НоваяСерия.Ссылка;
	
	Возврат СсылкаНаСерию;
