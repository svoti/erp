Функция ПодготовитьТаблицуТоваровДляРазмещенияКонтейнеров(ТаблицаТоваров, Правило) 
	
	РК = вмс_РаботаСКоллекциями;
	
	ПустойКонтейнер = Справочники.вмс_Контейнеры.ПустаяСсылка();
	ТаблицаТоваровПромежуточная = ТаблицаТоваров.Скопировать();
	
	Если Правило.РазмещатьКонтейнерыБезПересчета Тогда
		
		// Необходимо получить состав
		МассивКонтейнеров = ТаблицаТоваров.ВыгрузитьКолонку("Контейнер");
		РК.УдалитьДублиВМассиве(МассивКонтейнеров);
		РК.УдалитьПустыеСтрокиКоллекции(МассивКонтейнеров);
		ТаблицаСоставКонтейнеров = вмс_ПартионныйУчетСервер.ПолучитьТаблицуСоставаПоКонтейнерам(МассивКонтейнеров);
		ТаблицаСоставКонтейнеров.Колонки.КоличествоОстаток.Имя = "Количество";
		Для Каждого Контейнер Из МассивКонтейнеров Цикл
			Отбор = Новый Структура("Контейнер", Контейнер);
			НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(Отбор);
			РК.УдалитьЭлементыКоллекции(ТаблицаТоваров,НайденныеСтроки);
		КонецЦикла;
		
		РК.ДобавитьЭлементыКоллекции(ТаблицаТоваров,ТаблицаСоставКонтейнеров);
	КонецЕсли;
	
	УстановитьОбъемТарыКонтейнеровВТаблицеТоваров(ТаблицаТоваров);
	
КонецФункции 

Функция УстановитьОбъемТарыКонтейнеровВТаблицеТоваров(ТаблицаТоваров)
	
	Для Каждого Строка Из ТаблицаТоваров Цикл
		Строка.ОбъемТары = Строка.Контейнер.ТипТары.Объем;
	КонецЦикла;
	
КонецФункции 

Функция ОпределитьОбъемТарыДляКонтейнеров(ТаблицаТоваров) 
	
	РК = вмс_РаботаСКоллекциями;
	МассивКонтейнеров = ТаблицаТоваров.ВыгрузитьКолонку("Контейнер");
	РК.УдалитьДублиВМассиве(МассивКонтейнеров);
	РК.УдалитьПустыеСтрокиКоллекции(МассивКонтейнеров);
	
	Если МассивКонтейнеров.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	// Необходимо определить что больше объем самой тары или объем на таре от этого и плясать
	Для Каждого Контейнер Из МассивКонтейнеров Цикл
		Отбор = Новый Структура("Контейнер", Контейнер);
		НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(Отбор);
		ОбъемНаКонтейнере = 0; 
		ОбъемТары = Контейнер.ТипТары.Объем;   
		Для Каждого Строка Из НайденныеСтроки Цикл
			ОбъемНаКонтейнере = ОбъемНаКонтейнере + (Строка.ОбъемЕдиницыТовара * Строка.Количество);
		КонецЦикла;
		
		Если ОбъемНаКонтейнере > ОбъемТары Тогда 
			РК.ЗаполнитьЗначенияКоллекции(НайденныеСтроки,ОбъемНаКонтейнере,"ОбъемТары");
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции
