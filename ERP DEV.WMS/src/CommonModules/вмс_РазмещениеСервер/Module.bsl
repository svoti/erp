Функция ПолучитьЯчейкуДляКонтейнера(Контейнер, Склад, НастройкиРазмещения)
	
	
	Запрос = Новый Запрос;
	
	// Установка значений параметров
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	вмс_Контейнеры.Ссылка КАК Ссылка,
	|	&ПоляТоваров
	|	СУММА(вмс_ОстаткиВКонтейнерахОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.вмс_ОстаткиВКонтейнерах.Остатки КАК вмс_ОстаткиВКонтейнерахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.вмс_Контейнеры КАК вмс_Контейнеры
	|		ПО вмс_ОстаткиВКонтейнерахОстатки.Контейнер = вмс_Контейнеры.Ссылка
	|ГДЕ
	|	вмс_ОстаткиВКонтейнерахОстатки.Контейнер = &Контейнер
	|СГРУППИРОВАТЬ ПО  
	|	&ГруппировкаТоваров
	|	вмс_Контейнеры.Ссылка
	|;";

	ПоляДляМонотоварности = Новый Массив;
	
	
	Если НастройкиРазмещения.МонотоварностьПоТовару Тогда
		ПоляДляМонотоварности.Добавить("Товар");
	КонецЕсли;
	Если НастройкиРазмещения.МонотоварностьПоТоваруХарактеристике Тогда
		ПоляДляМонотоварности.Добавить("Характеристика");
	КонецЕсли;
		Если НастройкиРазмещения.МонотоварностьПоСерии Тогда
		ПоляДляМонотоварности.Добавить("Серия");
	КонецЕсли;
	
	СтрокаПоляй = "";
	СтрокаГруппировки = "";
	Для Каждого Поле Из ПоляДляМонотоварности Цикл
		СтрокаПоляй = СтрокаПоляй + СтрШаблон("вмс_ОстаткиВКонтейнерахОстатки.%1 КАК %1,", Поле);
		СтрокаГруппировки = СтрокаГруппировки + СтрШаблон("вмс_ОстаткиВКонтейнерахОстатки.%1,", Поле)
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляТоваров", СтрокаПоляй);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ГруппировкаТоваров", СтрокаГруппировки);
	
	ТоварыКонтейнера = Запрос.Выполнить().Выгрузить();
	
	ОбщаяТаблицаЗначений = СоздатьОбщуюТаблицуЯчеек();
	МенеджерВременныхТаблиц 	= МенеджерВременныхТаблиц_ВходящиеТовары(ТоварыКонтейнера);
 
	Если ТоварыКонтейнера.Количество() = 1 Тогда //Это монотоварный контейнер
		ТаблицаМонотоварныхЯчеек = ПолучитьМонотоварныеЯчейкиДляРазмещения(МенеджерВременныхТаблиц, Склад, НастройкиРазмещения);
		ДополнитьТаблицу(ТаблицаМонотоварныхЯчеек, ОбщаяТаблицаЗначений);
	КонецЕсли;
	
	ТаблицаМонотоварныхЯчеек 	= ПолучитьМонотоварныеЯчейкиДляРазмещения(МенеджерВременныхТаблиц, Склад, НастройкиРазмещения);
	ДополнитьТаблицу(ТаблицаМонотоварныхЯчеек, ОбщаяТаблицаЗначений);
	
	ТаблицаСмешанныеЯчейки 		= ПолучитьСмешанныеЯчейкиДляРазмещения(МенеджерВременныхТаблиц, Склад, НастройкиРазмещения);
	ДополнитьТаблицу(ТаблицаСмешанныеЯчейки, ОбщаяТаблицаЗначений);

	ТаблицаПустыеЯчейки 		= ПолучитьПустыеЯчейкиДляРазмещения(МенеджерВременныхТаблиц, Склад, НастройкиРазмещения);
	ДополнитьТаблицу(ТаблицаПустыеЯчейки, ОбщаяТаблицаЗначений);
	
	ТаблицаИсторическиеЯчейки 	= ПолучитьЯчейкиПоИсторииТовара(МенеджерВременныхТаблиц, Склад, НастройкиРазмещения);
	ДополнитьТаблицу(ТаблицаИсторическиеЯчейки, ОбщаяТаблицаЗначений);
	
	// прочие - ячейки вообще с другим товаром.
	ТаблицаПрочиеЯчейки 		= ПолучитьПрочиеЯчейкиДляРазмещения(МенеджерВременныхТаблиц, Склад, ОбщаяТаблицаЗначений, НастройкиРазмещения);
	ДополнитьТаблицу(ТаблицаПрочиеЯчейки, ОбщаяТаблицаЗначений);
	
	// ТУ_Васильев 01.10.25 ++
	ТаблицаСтатическиеЯчейки =  ПолучитьСтатическиеЯчейкиДляРазмещения(МенеджерВременныхТаблиц, Склад, НастройкиРазмещения);
	ДополнитьТаблицу(ТаблицаСтатическиеЯчейки, ОбщаяТаблицаЗначений);
	ОбщаяТаблицаЗначений.Свернуть("Приоритет,СвободныйОбъем,Серия,Товар,Упаковка,Характеристика,Ячейка");

КонецФункции

