Функция ПроверитьИменаКонфигурации(Имена) Экспорт
	
	МассивДопустимыхИмен = вмс_РаботаСКоллекциями.ЗначениеВМассив(Имена, , Ложь);
	
	ИмяКонфигурации = Метаданные.Имя;
	
	Для Каждого Имя Из МассивДопустимыхИмен Цикл  		
		Если СтрНайти(ИмяКонфигурации, Имя) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ИерархическийСправочник(Знач ИмяСправочника) Экспорт
	
	ПолноеИмяСправочника = ИмяСправочника; 
	
	ПозицияТочки = Найти(ПолноеИмяСправочника, ".");
	Если ПозицияТочки = 0 Тогда
		ПолноеИмяСправочника = "Справочник."+ПолноеИмяСправочника;		
	КонецЕсли; 
	
	ПозицияТипа = Найти(ПолноеИмяСправочника, "Справочник");
	Если ПозицияТипа = 0 Тогда
		ПолноеИмяСправочника = "Справочник."+ПолноеИмяСправочника;		
	КонецЕсли;

	ИмяМенеджера = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьИмяМенеджераОбъектаПоИмениТипа(ПолноеИмяСправочника); 
	
	Если ИмяМенеджера <> Неопределено Тогда
		Возврат Метаданные.Справочники[ИмяСправочника].Иерархический И Метаданные.Справочники[ИмяСправочника].ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	КонецЕсли;
	
	
КонецФункции

