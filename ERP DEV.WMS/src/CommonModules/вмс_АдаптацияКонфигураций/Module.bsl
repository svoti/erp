Функция ВыполнитьМетодАдаптации(ИмяМетода, Параметр1=null, Параметр2=null, Параметр3=null, Параметр4=null)

	ПрефиксФункции = ПрефиксФункции();
	Если ПрефиксФункции=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолноеИмяМетода = ПрефиксФункции + ИмяМетода;
	
	Параметры = Новый Массив;
	Параметры.Добавить(Параметр1);
	Параметры.Добавить(Параметр2);
	Параметры.Добавить(Параметр3);
	Параметры.Добавить(Параметр4);
	СтрокаПараметров = вмс_ОбщегоНазначенияКлиентСервер.ПолучитьСтрокуПараметровМетода(Параметры);
	
	Попытка
		Результат = Вычислить(ПолноеИмяМетода + СтрокаПараметров);
		Возврат Результат;
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Если СтрНайти(ОписаниеОшибки, "не определена (" + ИмяМетода + ")") > 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если СтрНайти(ОписаниеОшибки, "Метод объекта не обнаружен (" + ИмяМетода + ")") > 0 ИЛИ СтрНайти(ОписаниеОшибки, "Object method not found (" + ИмяМетода + ")") > 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ВызватьИсключение ОписаниеОшибки;
	КонецПопытки

КонецФункции

Функция ПрефиксФункции() Экспорт
	
	Если ЭтоУТ103() Тогда
		Возврат "вмс_АдаптацияКонфигурацийУТ10.";
	ИначеЕсли ЭтоУТ() Тогда 
		Возврат "вмс_АдаптацияКонфигурацийУТ.";
	ИначеЕсли ЭтоУНФ() Тогда
		Возврат "вмс_АдаптацияКонфигурацийУНФ.";
	ИначеЕсли ЭтоБП() Тогда 
		Возврат "вмс_АдаптацияКонфигурацийБП.";
	ИначеЕсли ЭтоАвтосалон() Тогда 
		Возврат "вмс_АдаптацияКонфигурацийАвтасалон.";   
	ИначеЕсли ЭтоЕРП() Тогда
		Возврат "вмс_АдаптацияКонфигурацийЕРП."; 
	ИначеЕсли ЭтоУАТ() Тогда 
		Возврат "вмс_АдаптацияКонфигурацийУАТ.";
	КонецЕсли;
		
КонецФункции

