Функция ПолучитьОбщуюТаблицуОстатков(ПараметрыЗаполения, МенеджерВременныхТаблиц)
	
	// ПО СЕРИЯМ:
	// 1. При способе ввода "План" - ищем остатки с серией из документа
	// 2. При способе ввода "не указывается" и "факт" - не учитываем серию при соединении. 
	
	// ТУ_Прошин_13.01.26
	// Измерение склад РН Остатки в ячейках упразненл
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
	// сортируем ячейки по приоритету для сборки
	"ВЫБРАТЬ
	|	вмс_ТипыЯчеек.Ссылка КАК ТипЯчейки,
	|	ВЫБОР
	|		КОГДА вмс_ТипыЯчеек.Ссылка = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаОтбора)
	|			ТОГДА 0
	|		КОГДА вмс_ТипыЯчеек.Ссылка = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ХРАНЕНИЕ)
	|			ТОГДА 1
	|		КОГДА вмс_ТипыЯчеек.Ссылка = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаПриемки)
	|			ТОГДА 2
	|		ИНАЧЕ 1000
	|	КОНЕЦ КАК ПриоритетЗоны
	|ПОМЕСТИТЬ ПриоритетыЗон
	|ИЗ
	|	Перечисление.вмс_ТипыЯчеек КАК вмс_ТипыЯчеек
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ЕСТЬNULL(вмс_РеестрОстаточныхСроковГодностиСрезПоследних.ПоказательОСГ, 0)) КАК ПоказательОСГ,
	|	ТаблицаТоваров.Товар КАК Товар
	|ПОМЕСТИТЬ ДанныеОСГ
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.вмс_РеестрОстаточныхСроковГодности.СрезПоследних(, Контрагент = &Контрагент) КАК вмс_РеестрОстаточныхСроковГодностиСрезПоследних
	|		ПО ТаблицаТоваров.Товар = вмс_РеестрОстаточныхСроковГодностиСрезПоследних.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоваров.Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вмс_ОперацияПоЯчейкамОстатки.Ячейка КАК Ячейка,
	|	вмс_ОперацияПоЯчейкамОстатки.Контейнер КАК Контейнер,
	|	вмс_ОперацияПоЯчейкамОстатки.Товар КАК Товар,
	|	вмс_ОперацияПоЯчейкамОстатки.Характеристика КАК Характеристика,
	|	вмс_ОперацияПоЯчейкамОстатки.Серия КАК Серия,
	|	вмс_ОперацияПоЯчейкамОстатки.Партия КАК Партия,
	|	вмс_ОперацияПоЯчейкамОстатки.Упаковка КАК Упаковка,
	|	вмс_ОперацияПоЯчейкамОстатки.Качество КАК Качество,
	|	вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	вмс_ОперацияПоЯчейкамОстатки.ВесОстаток КАК ВесОстаток,
	|	вмс_ОперацияПоЯчейкамОстатки.ПланируемыйРасходОстаток КАК ПланируемыйРасходОстаток,
	|	вмс_ОперацияПоЯчейкамОстатки.ПланируемыйПриходОстаток КАК ПланируемыйПриходОстаток
	|ПОМЕСТИТЬ ОстаткиТоваров1
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.вмс_ОперацияПоЯчейкам.Остатки(
	|				,
	|				Ячейка.ТипЯчейки В (&ТипыЯчеекОтбора)
	|					И &ОтборПоСкладу
	|					И &ОтборПоПомещению) КАК вмс_ОперацияПоЯчейкамОстатки
	|		ПО ТаблицаТоваров.Товар = вмс_ОперацияПоЯчейкамОстатки.Товар
	|			И ТаблицаТоваров.Характеристика = вмс_ОперацияПоЯчейкамОстатки.Характеристика
	|			И (ВЫБОР
	|				КОГДА ТаблицаТоваров.СпособВводаСерии = ЗНАЧЕНИЕ(Перечисление.вмс_СпособВводаСерии.ВПлане)
	|					ТОГДА ТаблицаТоваров.Серия = вмс_ОперацияПоЯчейкамОстатки.Серия
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаДвиженийЗаданий.Ячейка,
	|	ТаблицаДвиженийЗаданий.Контейнер,
	|	ТаблицаДвиженийЗаданий.Товар,
	|	ТаблицаДвиженийЗаданий.Характеристика,
	|	ТаблицаДвиженийЗаданий.Серия,
	|	ТаблицаДвиженийЗаданий.Партия,
	|	ТаблицаДвиженийЗаданий.Упаковка,
	|	ТаблицаДвиженийЗаданий.Качество,
	|	ТаблицаДвиженийЗаданий.КоличествоОборот,
	|	ТаблицаДвиженийЗаданий.ВесОборот,
	|	ТаблицаДвиженийЗаданий.ПланируемыйРасходОборот,
	|	ТаблицаДвиженийЗаданий.ПланируемыйПриходОборот
	|ИЗ
	|	ТаблицаДвиженийЗаданий КАК ТаблицаДвиженийЗаданий
	|ГДЕ
	|	ВЫРАЗИТЬ(ТаблицаДвиженийЗаданий.Ячейка КАК Справочник.вмс_МестаХранения).ТипЯчейки В (&ТипыЯчеекОтбора)
	|	И &ОтборПоСкладу
	|	И &ОтборПоПомещению
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиТоваров1.Ячейка КАК Ячейка,
	|	ОстаткиТоваров1.Контейнер КАК Контейнер,
	|	ОстаткиТоваров1.Товар КАК Товар,
	|	ОстаткиТоваров1.Характеристика КАК Характеристика,
	|	ОстаткиТоваров1.Серия КАК Серия,
	|	ОстаткиТоваров1.Партия КАК Партия,
	|	ОстаткиТоваров1.Упаковка КАК Упаковка,
	|	ОстаткиТоваров1.Качество КАК Качество,
	|	СУММА(ОстаткиТоваров1.КоличествоОстаток) КАК КоличествоОстаток,
	|	СУММА(ОстаткиТоваров1.ВесОстаток) КАК ВесОстаток,
	|	СУММА(ОстаткиТоваров1.ПланируемыйРасходОстаток) КАК ПланируемыйРасходОстаток,
	|	СУММА(ОстаткиТоваров1.ПланируемыйПриходОстаток) КАК ПланируемыйПриходОстаток
	|ПОМЕСТИТЬ ОстаткиТоваров2
	|ИЗ
	|	ОстаткиТоваров1 КАК ОстаткиТоваров1
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваров1.Ячейка,
	|	ОстаткиТоваров1.Контейнер,
	|	ОстаткиТоваров1.Товар,
	|	ОстаткиТоваров1.Характеристика,
	|	ОстаткиТоваров1.Серия,
	|	ОстаткиТоваров1.Партия,
	|	ОстаткиТоваров1.Упаковка,
	|	ОстаткиТоваров1.Качество
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.Серия, ЗНАЧЕНИЕ(Справочник.вмс_СерииНоменклатуры.ПустаяСсылка)) КАК Серия,
	|	ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.Контейнер, ЗНАЧЕНИЕ(Справочник.вмс_Контейнеры.ПустаяСсылка)) КАК Контейнер,
	|	ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.Ячейка, ЗНАЧЕНИЕ(Справочник.вмс_МестаХранения.ПустаяСсылка)) КАК Ячейка,
	|	ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.Ячейка.Владелец, &ПустаяСсылкаСклад) КАК Склад,
	|	ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.КоличествоОстаток, 0) - ВЫБОР
	|		КОГДА ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.ПланируемыйРасходОстаток, 0) > 0
	|			ТОГДА ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.ПланируемыйРасходОстаток, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СвободныйОстаток,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.Ячейка, ЗНАЧЕНИЕ(Справочник.вмс_МестаХранения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.вмс_МестаХранения.ПустаяСсылка)
	|			ТОГДА 10000000
	|		ИНАЧЕ вмс_ОперацияПоЯчейкамОстатки.Ячейка.Приоритет
	|	КОНЕЦ КАК Приоритет,
	|	ТаблицаТоваров.Товар КАК Товар,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	вмс_ОперацияПоЯчейкамОстатки.Ячейка.ТипЯчейки КАК ТипЯчейки,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.Серия, ЗНАЧЕНИЕ(Справочник.вмс_СерииНоменклатуры.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.вмс_СерииНоменклатуры.ПустаяСсылка)
	|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	|		ИНАЧЕ вмс_ОперацияПоЯчейкамОстатки.Серия.ГоденДо
	|	КОНЕЦ КАК ГоденДо,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.Серия, ЗНАЧЕНИЕ(Справочник.вмс_СерииНоменклатуры.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.вмс_СерииНоменклатуры.ПустаяСсылка)
	|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	|		ИНАЧЕ вмс_ОперацияПоЯчейкамОстатки.Серия.ДатаПроизводства
	|	КОНЕЦ КАК ДатаПроизводства,
	|	вмс_ОперацияПоЯчейкамОстатки.Ячейка.Помещение КАК Помещение,
	|	10000 + вмс_ОперацияПоЯчейкамОстатки.Ячейка.Помещение.Приоритет КАК ПриоритетПомещения,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.Контейнер, ЗНАЧЕНИЕ(Справочник.вмс_Контейнеры.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.вмс_Контейнеры.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПриоритетВКонтейнере,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(вмс_ОперацияПоЯчейкамОстатки.Контейнер, ЗНАЧЕНИЕ(Справочник.вмс_Контейнеры.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.вмс_Контейнеры.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ вмс_ОперацияПоЯчейкамОстатки.Контейнер.Вскрыт
	|	КОНЕЦ КАК КонтейнерВскрыт
	|ПОМЕСТИТЬ ОстаткиТоваров
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиТоваров2 КАК вмс_ОперацияПоЯчейкамОстатки
	|		ПО ТаблицаТоваров.Товар = вмс_ОперацияПоЯчейкамОстатки.Товар
	|			И ТаблицаТоваров.Характеристика = вмс_ОперацияПоЯчейкамОстатки.Характеристика
	|			И (ВЫБОР
	|				КОГДА ТаблицаТоваров.СпособВводаСерии = ЗНАЧЕНИЕ(Перечисление.вмс_СпособВводаСерии.ВПлане)
	|					ТОГДА ТаблицаТоваров.Серия = вмс_ОперацияПоЯчейкамОстатки.Серия
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиТоваров.Контейнер КАК Контейнер,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вмс_ОстаткиВКонтейнерахОстатки.Товар) КАК КоличествоТоваровВКонтейнере,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вмс_ОстаткиВКонтейнерахОстатки.Характеристика) КАК КоличествоХарактеристикВКонтейнере
	|ПОМЕСТИТЬ КоличествоСкюВКонтейнере
	|ИЗ
	|	ОстаткиТоваров КАК ОстаткиТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.вмс_ОстаткиВКонтейнерах.Остатки КАК вмс_ОстаткиВКонтейнерахОстатки
	|		ПО ОстаткиТоваров.Контейнер = вмс_ОстаткиВКонтейнерахОстатки.Контейнер
	|ГДЕ
	|	ОстаткиТоваров.Контейнер <> ЗНАЧЕНИЕ(Справочник.вмс_Контейнеры.ПустаяСсылка)
	|	И ОстаткиТоваров.СвободныйОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваров.Контейнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиТоваров.Серия КАК Серия,
	|	ОстаткиТоваров.Контейнер КАК Контейнер,
	|	ОстаткиТоваров.Ячейка КАК Ячейка,
	|	ОстаткиТоваров.Склад КАК Склад,
	|	ОстаткиТоваров.СвободныйОстаток КАК СвободныйОстаток,
	|	ОстаткиТоваров.Приоритет + ОстаткиТоваров.ПриоритетПомещения КАК Приоритет,
	|	ОстаткиТоваров.Товар КАК Товар,
	|	ОстаткиТоваров.Характеристика КАК Характеристика,
	|	ОстаткиТоваров.ТипЯчейки КАК ТипЯчейки,
	|	ОстаткиТоваров.ГоденДо КАК ГоденДо,
	|	ОстаткиТоваров.ДатаПроизводства КАК ДатаПроизводства,
	|	ДанныеОСГ.ПоказательОСГ КАК ПоказательОСГ,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.Серия = ЗНАЧЕНИЕ(Справочник.вмс_СерииНоменклатуры.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ 100 / РАЗНОСТЬДАТ(ОстаткиТоваров.ГоденДо, ОстаткиТоваров.ДатаПроизводства, ДЕНЬ) * РАЗНОСТЬДАТ(ОстаткиТоваров.ГоденДо, &ТекущаяДата, ДЕНЬ)
	|	КОНЕЦ КАК ОстатокОСГ,
	|	ОстаткиТоваров.Помещение КАК Помещение,
	|	ОстаткиТоваров.ПриоритетВКонтейнере КАК ПриоритетВКонтейнере,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КоличествоСкюВКонтейнере.КоличествоТоваровВКонтейнере, 0) = 0
	|			ТОГДА 1000
	|		КОГДА ЕСТЬNULL(КоличествоСкюВКонтейнере.КоличествоТоваровВКонтейнере, 0) = 1
	|				И ЕСТЬNULL(КоличествоСкюВКонтейнере.КоличествоХарактеристикВКонтейнере, 1) = 1
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПриоритетМоноКонтейнера,
	|	ЕСТЬNULL(КоличествоСкюВКонтейнере.КоличествоТоваровВКонтейнере, 0) КАК КоличествоТоваровВКонтейнере,
	|	ЕСТЬNULL(КоличествоСкюВКонтейнере.КоличествоХарактеристикВКонтейнере, 1) КАК КоличествоХарактеристикВКонтейнере,
	|	ОстаткиТоваров.КонтейнерВскрыт КАК КонтейнерВскрыт,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.КонтейнерВскрыт = НЕОПРЕДЕЛЕНО
	|			ТОГДА 1000
	|		КОГДА ОстаткиТоваров.КонтейнерВскрыт = ЛОЖЬ
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПриоритетЦелыхКонтейнеров
	|ПОМЕСТИТЬ ОстаткиТоваровСОсг
	|ИЗ
	|	ОстаткиТоваров КАК ОстаткиТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОСГ КАК ДанныеОСГ
	|		ПО ОстаткиТоваров.Товар = ДанныеОСГ.Товар
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоСкюВКонтейнере КАК КоличествоСкюВКонтейнере
	|		ПО ОстаткиТоваров.Контейнер = КоличествоСкюВКонтейнере.Контейнер
	|ГДЕ
	|	ОстаткиТоваров.СвободныйОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиТоваровСОсг.Серия КАК Серия,
	|	ОстаткиТоваровСОсг.Контейнер КАК Контейнер,
	|	ОстаткиТоваровСОсг.Ячейка КАК Ячейка,
	|	ОстаткиТоваровСОсг.Склад КАК Склад,
	|	ОстаткиТоваровСОсг.СвободныйОстаток КАК СвободныйОстаток,
	|	ОстаткиТоваровСОсг.Приоритет КАК Приоритет,
	|	ОстаткиТоваровСОсг.Товар КАК Товар,
	|	ОстаткиТоваровСОсг.Характеристика КАК Характеристика,
	|	ОстаткиТоваровСОсг.ТипЯчейки КАК ТипЯчейки,
	|	ПриоритетыЗон.ПриоритетЗоны КАК ПриоритетЗоны,
	|	ОстаткиТоваровСОсг.ГоденДо КАК ГоденДо,
	|	ОстаткиТоваровСОсг.ДатаПроизводства КАК ДатаПроизводства,
	|	ОстаткиТоваровСОсг.ОстатокОСГ КАК ОстатокОСГ,
	|	ОстаткиТоваровСОсг.ПоказательОСГ КАК ПоказательОСГ,
	|	ОстаткиТоваровСОсг.Помещение КАК Помещение,
	|	ОстаткиТоваровСОсг.ПриоритетВКонтейнере КАК ПриоритетВКонтейнере,
	|	ОстаткиТоваровСОсг.ПриоритетМоноКонтейнера КАК ПриоритетМоноКонтейнера,
	|	ОстаткиТоваровСОсг.ПриоритетЦелыхКонтейнеров КАК ПриоритетЦелыхКонтейнеров
	|ИЗ
	|	ОстаткиТоваровСОсг КАК ОстаткиТоваровСОсг
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПриоритетыЗон КАК ПриоритетыЗон
	|		ПО ОстаткиТоваровСОсг.ТипЯчейки = ПриоритетыЗон.ТипЯчейки
	|ГДЕ
	|	&ОтборПоОсг
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОстатокОСГ,
	|	ГоденДо,
	|	ПриоритетЗоны,
	|	Приоритет,
	|	&ПравилаПриоритетовКонтейнера,
	|	Ячейка";  
	
	
	Запрос.УстановитьПараметр("ТипыЯчеекОтбора", ПараметрыЗаполения.ТипыЯчеек);
	
	// ТУ_Алфимов 16.07.26 ++ 3.2.5
	Если ЗначениеЗаполнено(ПараметрыЗаполения.Контрагент) Тогда
		Запрос.УстановитьПараметр("Контрагент", ПараметрыЗаполения.Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ", Контрагент = &Контрагент", "");
	КонецЕсли;
	// ТУ_Алфимов 16.07.26 -- 3.2.5
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("ПустаяСсылкаСклад", вмс_АдаптацияКонфигураций.ПустойСклад());
	
	Если ПараметрыЗаполения.Правило.ПодбиратьЯчейкиПоСкладам Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСкладу", "Ячейка.Владелец = &Склад");
		Запрос.УстановитьПараметр("Склад", ПараметрыЗаполения.Склад);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСкладу", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыЗаполения.Помещение) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоПомещению", "Ячейка.Помещение = &Помещение");
		Запрос.УстановитьПараметр("Помещение", ПараметрыЗаполения.Помещение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоПомещению", "ИСТИНА");
	КонецЕсли;
	
	Если ПараметрыЗаполения.Правило.ИспользоватьОСГНаОтбор Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоОсг", "ОстаткиТоваровСОсг.ОстатокОСГ >= ОстаткиТоваровСОсг.ПоказательОСГ");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоОсг", "ИСТИНА");
	КонецЕсли;
	
	// ТУ_Прошин_24.11.25++ И ТУ_Алфимов_16.07.26 ++ 3.2.5
	ПриоритетКонтейнеров = "";
	
	Если ПараметрыЗаполения.Правило.ОтгрузкаКонтейнеров_СначалаКонтейнеры Тогда
		ПриоритетКонтейнеров = "ПриоритетВКонтейнере УБЫВ";
	Иначе 
		ПриоритетКонтейнеров = "ПриоритетВКонтейнере";
	КонецЕсли;
	
	Если ПараметрыЗаполения.Правило.ОтгрузкаКонтейнеров_СначалаМонотоварныеКонтейнеры Тогда
		ПриоритетКонтейнеров = ПриоритетКонтейнеров + "," + Символы.ПС + "ПриоритетМоноКонтейнера";
	Иначе 
		ПриоритетКонтейнеров = ПриоритетКонтейнеров + "," + Символы.ПС + "ПриоритетМоноКонтейнера УБЫВ";
	КонецЕсли;
	
	Если ПараметрыЗаполения.Правило.ОтгрузкаКонтейнеров_СначалаЦелые Тогда
		ПриоритетКонтейнеров = ПриоритетКонтейнеров + "," + Символы.ПС + "ПриоритетЦелыхКонтейнеров";
	Иначе 
		ПриоритетКонтейнеров = ПриоритетКонтейнеров + "," + Символы.ПС + "ПриоритетЦелыхКонтейнеров УБЫВ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПриоритетКонтейнеров) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПравилаПриоритетовКонтейнера", ПриоритетКонтейнеров);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПравилаПриоритетовКонтейнера,", ПриоритетКонтейнеров);
	КонецЕсли;
	// ТУ_Прошин_24.11.25- И ТУ_Алфимов_16.07.26 -- 3.2.5
	
	ТаблицаОбщихОстатков = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаОбщихОстатков;
	
КонецФункции 

Функция ОбработатьТаблицуОстатковПоСкладу(ТаблицаОстатков, Склад)
	
	СтрокиДляУдаления = Новый Массив;
	
	Для Каждого Строка Из ТаблицаОстатков Цикл    
		
		Если Строка.Склад <> Склад Тогда
			СтрокиДляУдаления.Добавить(Строка);
		КонецЕсли;  
		
	КонецЦикла;
	
	Для Каждого Строка Из СтрокиДляУдаления Цикл
		ТаблицаОстатков.Удалить(Строка);	
	КонецЦикла;
		
КонецФункции  

Функция ОбработатьТаблицуОстатковПоПомещению(ТаблицаОстатков, Помещение)
	
	СтрокиДляУдаления = Новый Массив;
	
	Для Каждого Строка Из ТаблицаОстатков Цикл    
		
		Если Строка.Ячейка.Помещение <> Помещение Тогда
			СтрокиДляУдаления.Добавить(Строка);
		КонецЕсли;  
		
	КонецЦикла;
	
	Для Каждого Строка Из СтрокиДляУдаления Цикл
		ТаблицаОстатков.Удалить(Строка);	
	КонецЦикла;	    
	
КонецФункции  

Функция ОбработатьТаблицуОстатковПоЗонам(ТаблицаОстатков)   
	
	МассивЗонДостыпныхДляОтбора = Новый Массив; 
	
	ЗонаОтбора = Перечисления.вмс_ТипыЯчеек.ЗонаОтбора;
	ЗонаХранения = Перечисления.вмс_ТипыЯчеек.Хранение;
	ЗонаПриемки = Перечисления.вмс_ТипыЯчеек.ЗонаПриемки; 
	
	МассивЗонДостыпныхДляОтбора.Добавить(ЗонаОтбора);  
	МассивЗонДостыпныхДляОтбора.Добавить(ЗонаХранения);
	МассивЗонДостыпныхДляОтбора.Добавить(ЗонаПриемки);
	
	КопияТаблицы = ТаблицаОстатков.Скопировать();
	ТаблицаОстатков.Очистить();
	
	Для Каждого Зона Из МассивЗонДостыпныхДляОтбора Цикл  
		
		Отбор = Новый Структура("ТипЯчейки", Зона);
		НайденныеСтроки = КопияТаблицы.НайтиСтроки(Отбор);
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			НоваяСтрока = ТаблицаОстатков.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;      
		
	КонецЦикла;	
	
КонецФункции

Функция ПолучитьТаблицуСоставаПоКонтейнерам(МассивКонтейнеров)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	вмс_ОстаткиВКонтейнерахОстатки.Контейнер КАК Контейнер,
		|	вмс_ОстаткиВКонтейнерахОстатки.Товар КАК Товар,
		|	вмс_ОстаткиВКонтейнерахОстатки.Характеристика КАК Характеристика,
		|	вмс_ОстаткиВКонтейнерахОстатки.Серия КАК Серия,
		|	вмс_ОстаткиВКонтейнерахОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.вмс_ОстаткиВКонтейнерах.Остатки(, Контейнер В (&МассивКонтейнеров)) КАК вмс_ОстаткиВКонтейнерахОстатки";
	
	Запрос.УстановитьПараметр("МассивКонтейнеров", МассивКонтейнеров);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаСоставаПоКонтейнерам = РезультатЗапроса.Выгрузить();	
	
	Возврат ТаблицаСоставаПоКонтейнерам;
	
КонецФункции  

Функция ПолучитьВложенныеКонтейнерыКонтейнера(Контейнер, Правило) 
	
		лТекст = "
		|ВЫБРАТЬ
		|	вмс_ОстаткиВКонтейнерахОстатки.Контейнер КАК Родитель,
		|	вмс_ОстаткиВКонтейнерахОстатки.Товар КАК Контейнер,
		|	вмс_ОстаткиВКонтейнерахОстатки.Товар.Вскрыт КАК КонтейнерВскрыт
		|ПОМЕСТИТЬ ВТ_ВложенныеКонтейнеры
		|ИЗ
		|	РегистрНакопления.вмс_ОстаткиВКонтейнерах.Остатки(
		|			,
		|			Контейнер = &ТекущийКонтейнер
		|				И Товар <> &ТекущийКонтейнер
		|				И ТИПЗНАЧЕНИЯ(Товар) = ТИП(Справочник.вмс_Контейнеры)) КАК вмс_ОстаткиВКонтейнерахОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вмс_ОстаткиВКонтейнерахОстатки.Товар) КАК КоличествоТовараВКонтейнере,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вмс_ОстаткиВКонтейнерахОстатки.Характеристика) КАК КоличествоХарактеристикВКонтейнере,
		|	ВТ_ВложенныеКонтейнеры.КонтейнерВскрыт КАК КонтейнерВскрыт,
		|	ВТ_ВложенныеКонтейнеры.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ ВТ_КоличествоСкюВКонтейнере
		|ИЗ
		|	ВТ_ВложенныеКонтейнеры КАК ВТ_ВложенныеКонтейнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.вмс_ОстаткиВКонтейнерах.Остатки КАК вмс_ОстаткиВКонтейнерахОстатки
		|		ПО ВТ_ВложенныеКонтейнеры.Контейнер = вмс_ОстаткиВКонтейнерахОстатки.Контейнер
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ВложенныеКонтейнеры.КонтейнерВскрыт,
		|	ВТ_ВложенныеКонтейнеры.Контейнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КоличествоСкюВКонтейнере.КоличествоТовараВКонтейнере КАК КоличествоТовараВКонтейнере,
		|	ВТ_КоличествоСкюВКонтейнере.КоличествоХарактеристикВКонтейнере КАК КоличествоХарактеристикВКонтейнере,
		|	ВЫБОР
		|		КОГДА ВТ_КоличествоСкюВКонтейнере.КоличествоТовараВКонтейнере = 0
		|			ТОГДА 1000
		|		КОГДА ВТ_КоличествоСкюВКонтейнере.КоличествоТовараВКонтейнере = 1
		|				И ВТ_КоличествоСкюВКонтейнере.КоличествоХарактеристикВКонтейнере = 1
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПриоритетМоноКонтейнера,
		|	ВТ_КоличествоСкюВКонтейнере.Контейнер КАК Контейнер,
		|	ВТ_КоличествоСкюВКонтейнере.КонтейнерВскрыт КАК КонтейнерВскрыт,
		|	ВЫБОР
		|		КОГДА ВТ_КоличествоСкюВКонтейнере.КонтейнерВскрыт = ЛОЖЬ
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПриоритетЦелыхКонтейнеров
		|ПОМЕСТИТЬ ВТ_ПредварительнаяТаблица
		|ИЗ
		|	ВТ_КоличествоСкюВКонтейнере КАК ВТ_КоличествоСкюВКонтейнере
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПредварительнаяТаблица.КоличествоТовараВКонтейнере КАК КоличествоТовараВКонтейнере,
		|	ВТ_ПредварительнаяТаблица.КоличествоХарактеристикВКонтейнере КАК КоличествоХарактеристикВКонтейнере,
		|	ВТ_ПредварительнаяТаблица.ПриоритетМоноКонтейнера КАК ПриоритетМоноКонтейнера,
		|	ВТ_ПредварительнаяТаблица.Контейнер КАК Контейнер,
		|	ВТ_ПредварительнаяТаблица.КонтейнерВскрыт КАК КонтейнерВскрыт,
		|	ВТ_ПредварительнаяТаблица.ПриоритетЦелыхКонтейнеров КАК ПриоритетЦелыхКонтейнеров
		|ИЗ
		|	ВТ_ПредварительнаяТаблица КАК ВТ_ПредварительнаяТаблица
		|
		|УПОРЯДОЧИТЬ ПО
		|	&ПравилаПриоритетовКонтейнера
		|";
		
	Запрос = Новый Запрос(лТекст);

	Запрос.УстановитьПараметр("ТекущийКонтейнер", Контейнер);
	
	ПриоритетКонтейнеров = "";
	//Если ПараметрыЗаполения.Правило.ОтгрузкаКонтейнеров_СначалаКонтейнеры Тогда   
	//	ПриоритетКонтейнеров = "ПриоритетВКонтейнере УБЫВ";
	//Иначе 
	//	ПриоритетКонтейнеров = "ПриоритетВКонтейнере";		
	//КонецЕсли; 
	
	Если Правило.ОтгрузкаКонтейнеров_СначалаМонотоварныеКонтейнеры Тогда   
		ПриоритетКонтейнеров = "ПриоритетМоноКонтейнера";
	Иначе 
		ПриоритетКонтейнеров = "ПриоритетМоноКонтейнера УБЫВ";	
	КонецЕсли;	  
	
	Если Правило.ОтгрузкаКонтейнеров_СначалаЦелые Тогда   
		ПриоритетКонтейнеров = ПриоритетКонтейнеров + "," + Символы.ПС + "ПриоритетЦелыхКонтейнеров";
	Иначе 
		ПриоритетКонтейнеров = ПриоритетКонтейнеров + "," + Символы.ПС + "ПриоритетЦелыхКонтейнеров УБЫВ";	
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПравилаПриоритетовКонтейнера", ПриоритетКонтейнеров);
	
	ТаблицаКонтейнеров = Запрос.Выполнить().Выгрузить();

	Возврат ТаблицаКонтейнеров.ВыгрузитьКолонку("Контейнер"); 

КонецФункции   

Функция ПолучитьТоварыНаМастерКонтейнереБезВложенногоКонтейнера(МассивСоставаКонтейнера) 
	РК = вмс_РаботаСКоллекциями;     
	МассивТовараНаКонтейнере = Новый Массив; 
	
	Для Каждого Строка Из МассивСоставаКонтейнера Цикл    
		
		Если ТипЗнч(Строка.Товар) = Тип("СправочникСсылка.Номенклатура") Тогда   
			МассивТовараНаКонтейнере.Добавить(Строка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивТовараНаКонтейнере;
КонецФункции

Функция РазобратьМастерКонтейнерНаВложенныеКонтейнерыПоПлану(ТаблицаПлан, МассивВложенныхКонтейнеров, МастерКонтейнер, Правило)     
	
	РК = вмс_РаботаСКоллекциями;
	Отбор = Новый Структура("Контейнер", МастерКонтейнер);  
	ПустаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	ПустаяХарактеристика = вмс_АдаптацияКонфигураций.ПустаяХарактеристика();
	ПустаяСерия = Справочники.вмс_СерииНоменклатуры.ПустаяСсылка();  
	ПустойКонтейнер = Справочники.вмс_Контейнеры.ПустаяСсылка();
	
	Для Каждого ВложенныйКонтейнер Из МассивВложенныхКонтейнеров Цикл
		ВложенныйКонтейнерОтгружаетсяЦеликом = Истина;
		НайденныеСтрокиПлана = ТаблицаПлан.НайтиСтроки(Отбор);
		
		Если НайденныеСтрокиПлана.Количество() = 0 Тогда    
			//Значит уже строк с иерархическим контейнером не осталось
			Прервать;	
		КонецЕсли;
		
		МассивСКонтейнером = Новый Массив;
		МассивСКонтейнером.Добавить(ВложенныйКонтейнер);
		ТаблицаПолныйСоставВложенногоКонтейнера = ПолучитьТаблицуСоставаПоКонтейнерам(МассивСКонтейнером);							        
		
		Для Каждого СтрокаВложенногоКонтейнера Из ТаблицаПолныйСоставВложенногоКонтейнера Цикл
			ОтборСтрокиПлана = Новый Структура("Товар, Характеристика, Серия, Контейнер", СтрокаВложенногоКонтейнера.Товар, СтрокаВложенногоКонтейнера.Характеристика, СтрокаВложенногоКонтейнера.Серия, МастерКонтейнер);
			
			СтрокиПлана = ТаблицаПлан.НайтиСтроки(ОтборСтрокиПлана);     
			Если НЕ ЗначениеЗаполнено(СтрокиПлана) Тогда    
				ВложенныйКонтейнерОтгружаетсяЦеликом = Ложь; 
				Продолжить;      
			Иначе
				СтрокаПлана = СтрокиПлана[0];	
			КонецЕсли;
			
			Если СтрокаПлана.Количество > СтрокаВложенногоКонтейнера.КоличествоОстаток Тогда     
				НоваяСтрока = ТаблицаПлан.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлана);
				НоваяСтрока.Контейнер = ВложенныйКонтейнер;
				НоваяСтрока.Количество = СтрокаВложенногоКонтейнера.КоличествоОстаток; 
				
				СтрокаПлана.Количество = СтрокаПлана.Количество - СтрокаВложенногоКонтейнера.КоличествоОстаток;
			ИначеЕсли СтрокаПлана.Количество = СтрокаВложенногоКонтейнера.КоличествоОстаток Тогда
				СтрокаПлана.Контейнер = ВложенныйКонтейнер;
			Иначе
				СтрокаПлана.Контейнер = ВложенныйКонтейнер;
				ВложенныйКонтейнерОтгружаетсяЦеликом = Ложь;
			КонецЕсли;
			
		КонецЦикла;     
		
		ОтборСтрокВложенногоКонтейнера = Новый Структура("Контейнер", ВложенныйКонтейнер);
		ПереопределенныеСтрокиПлана = ТаблицаПлан.НайтиСтроки(ОтборСтрокВложенногоКонтейнера);				
		Если ВложенныйКонтейнерОтгружаетсяЦеликом Тогда     
			Если ПереопределенныеСтрокиПлана.Количество() <> ТаблицаПолныйСоставВложенногоКонтейнера.Количество() Тогда
				ВложенныйКонтейнерОтгружаетсяЦеликом = Ложь;	
			КонецЕсли;
		КонецЕсли;
		
		Если ВложенныйКонтейнерОтгружаетсяЦеликом Тогда   
			Если Правило.ОтгружатьКонтейнерыБезПересчета Тогда
				НоваяСтрока = ТаблицаПлан.Добавить();  
				
				СтрокаПлана = ПереопределенныеСтрокиПлана[0]; 
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаПлана);   
				НоваяСтрока.Контейнер = ВложенныйКонтейнер;
				НоваяСтрока.Номенклатура = ПустаяНоменклатура;
				НоваяСтрока.Характеристика = ПустаяХарактеристика;
				НоваяСтрока.Серия = ПустаяСерия;    
				НоваяСтрока.СпособВводаСерии = Перечисления.вмс_СпособВводаСерии.ПустаяСсылка(); 
				НоваяСтрока.Количество = 1;
				
				РК.УдалитьЭлементыКоллекции(ТаблицаПлан, ПереопределенныеСтрокиПлана); 
			КонецЕсли;
		Иначе
			РК.ЗаполнитьЗначенияКоллекции(ПереопределенныеСтрокиПлана, ВложенныйКонтейнер, "КонтейнерОтправитель");
			РК.ЗаполнитьЗначенияКоллекции(ПереопределенныеСтрокиПлана, ПустойКонтейнер, "Контейнер");
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции  

Функция РазобратьТоварСМастерКонтейнераПоПлану(ТаблицаПлан, МассивТоваровНаМастерКонтейнере, МастерКонтейнер)  
	
	Отбор = Новый Структура("Контейнер", МастерКонтейнер);
	РК = вмс_РаботаСКоллекциями;
	ПустойКонтейнер = Справочники.вмс_Контейнеры.ПустаяСсылка();
	
	Если МассивТоваровНаМастерКонтейнере.Количество() > 0 Тогда   
		Для Каждого СтрокаТовара Из МассивТоваровНаМастерКонтейнере Цикл 
			НайденныеСтрокиПлана = ТаблицаПлан.НайтиСтроки(Отбор);    
			
			Если НайденныеСтрокиПлана.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ОтборСоставаКонтейнера = Новый Структура("Товар, Характеристика, Серия", СтрокаТовара.Товар, СтрокаТовара.Характеристика, СтрокаТовара.Серия);
			СтрокаПлана = РК.НайтиЭлементКоллекции(НайденныеСтрокиПлана, ОтборСоставаКонтейнера);         
			Если ЗначениеЗаполнено(СтрокаПлана) Тогда   
				
				Если СтрокаПлана.Количество > СтрокаТовара.КоличествоОстаток Тогда     
					НоваяСтрока = ТаблицаПлан.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлана);
					НоваяСтрока.КонтейнерОтправитель = МастерКонтейнер;     
					НоваяСтрока.Контейнер = ПустойКонтейнер;
					НоваяСтрока.Количество = СтрокаТовара.КоличествоОстаток; 
					
					СтрокаПлана.Количество = СтрокаПлана.Количество - СтрокаТовара.КоличествоОстаток;  
				Иначе							
					СтрокаПлана.КонтейнерОтправитель = МастерКонтейнер;  
					СтрокаПлана.Контейнер = ПустойКонтейнер;
				КонецЕсли;
				
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли; 
	
КонецФункции

Функция ПолучитьТаблицуВсехТоваровИзТаблицыСоставовКонтейнеров(ТаблицаСоставовКонтейнеров)
	
	РК = вмс_РаботаСКоллекциями;
	
	ТаблицаВсехТоваровКонтейнеров = РК.ПостроитьТаблицуБлизостиЭлементов(ТаблицаСоставовКонтейнеров, "Контейнер", "Товар");
	
	ТипТовар = Тип("СправочникСсылка.Номенклатура");
	
	УдаляемыеСтроки = Новый Массив;
	Для Каждого СтрокаТовара Из ТаблицаВсехТоваровКонтейнеров Цикл
		
		Если ТипЗнч(СтрокаТовара.Товар) <> ТипТовар Тогда
			УдаляемыеСтроки.Добавить(СтрокаТовара);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		
		ТаблицаВсехТоваровКонтейнеров.Удалить(УдаляемаяСтрока);
		
	КонецЦикла;
	
	Возврат ТаблицаВсехТоваровКонтейнеров;
	
КонецФункции

Функция ПолучитьДанныеЗаполненияПланаПоКонтейнерам(Контейнеры, Правило)

	РК = вмс_РаботаСКоллекциями;   
	
	Данные = РК.НоваяКоллекцияЗначений("КонтейнерВерхнегоУровня, Контейнер, Товары, Целиком");
	
	ИнформацияСоставаКонтейнеров = вмс_ПартионныйУчетСервер.ПолучитьИнформациюСоставаКонтейнеров(Контейнеры);
	
	ПустойКонтейнер = Справочники.вмс_Контейнеры.ПустаяСсылка();
	ТипКонтейнер = ТипЗнч(ПустойКонтейнер);
	
	ОтборПоКонтейнеру = Новый Структура("Контейнер");
	
	ИндексОбратнойИерархии = 0;
	
	КонтейнерыНаУровне = Контейнеры;
	
	СначалаКонтейнеры = Правило.ОтгрузкаКонтейнеров_СначалаКонтейнеры;
	
	Пока КонтейнерыНаУровне.Количество() > 0 Цикл
		
		КонтейнерыНаСледующемУровне = Новый Массив;
		Для Каждого Контейнер Из КонтейнерыНаУровне Цикл
			
			ОтборПоКонтейнеру.Контейнер = Контейнер;
			КонтейнерВерхнегоУровняМассив = ИнформацияСоставаКонтейнеров.ТаблицаКонтейнеровВерхнегоУровня.НайтиСтроки(ОтборПоКонтейнеру);
			Если КонтейнерВерхнегоУровняМассив.Количество()=0 Тогда
				КонтейнерВерхнегоУровня = Контейнер;
			Иначе
				КонтейнерВерхнегоУровня = КонтейнерВерхнегоУровняМассив[0].КонтейнерВерхнегоУровня;
			КонецЕсли;
			
			ЭлементДанных = Данные.Вставить(ИндексОбратнойИерархии);
			ЭлементДанных.КонтейнерВерхнегоУровня = КонтейнерВерхнегоУровня;
			ЭлементДанных.Контейнер = Контейнер;
			ЭлементДанных.Товары = ИнформацияСоставаКонтейнеров.ТаблицаТоваровПоКонтейнерамСУчетомИерархии.Скопировать(ОтборПоКонтейнеру);
			ЭлементДанных.Целиком = Истина;
			ИндексОбратнойИерархии = ИндексОбратнойИерархии + 1;
			
			Если НЕ СначалаКонтейнеры Тогда
				// добавим обработку перед вложенными контейнерами
				ЭлементДанных = Данные.Вставить(ИндексОбратнойИерархии);
				ЭлементДанных.КонтейнерВерхнегоУровня = КонтейнерВерхнегоУровня;
				ЭлементДанных.Контейнер = Контейнер;
				ЭлементДанных.Товары = ИнформацияСоставаКонтейнеров.ТаблицаТоваровПоКонтейнерам.Скопировать(ОтборПоКонтейнеру);
				ЭлементДанных.Целиком = Ложь;
				ИндексОбратнойИерархии = ИндексОбратнойИерархии + 1;
			КонецЕсли;
			
			ВложенныеКонтейнеры = ИнформацияСоставаКонтейнеров.ТаблицаКонтейнеров.Скопировать(ОтборПоКонтейнеру).ВыгрузитьКолонку("Товар");
			Для Каждого ВложенныйКонтейнер Из ВложенныеКонтейнеры Цикл
				КонтейнерыНаСледующемУровне.Добавить(ВложенныйКонтейнер);
			КонецЦикла;
			
			Если СначалаКонтейнеры Тогда
				// добавим обработку после вложенных контейнеров
				ЭлементДанных = Данные.Вставить(ИндексОбратнойИерархии+1);
				ЭлементДанных.КонтейнерВерхнегоУровня = КонтейнерВерхнегоУровня;
				ЭлементДанных.Контейнер = Контейнер;
				ЭлементДанных.Товары = ИнформацияСоставаКонтейнеров.ТаблицаТоваровПоКонтейнерам.Скопировать(ОтборПоКонтейнеру);
				ЭлементДанных.Целиком = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		КонтейнерыНаУровне = КонтейнерыНаСледующемУровне;
		
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

#КонецОбласти

