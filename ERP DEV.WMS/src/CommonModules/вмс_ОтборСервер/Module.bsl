#Область ПрограммныйИнтерфейс

Функция ПодобратьЯчейкиОтправители(ПараметрыЗаполения) Экспорт 

	// Свертка и типизация перед отправкой в алгоритм
	ТаблицаТоваров				= ПодготовитьВходящуюТаблицу(ПараметрыЗаполения.Товары);

	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ДобавитьТаблицуЗапросаВходящиеТовары(МенеджерВременныхТаблиц, ТаблицаТоваров);
	ДобавитьТаблицуЗапросаДвиженияЗадания(МенеджерВременныхТаблиц, ПараметрыЗаполения.ЗаданиеКладовщику);
	ДобавитьТаблицуЗапросаДвиженияЗаданий(МенеджерВременныхТаблиц, ПараметрыЗаполения.ТаблицаДвиженийЗаданий);
	
	ТаблицаОстатковПоЯчейкам = ПолучитьОбщуюТаблицуОстатков(ПараметрыЗаполения, МенеджерВременныхТаблиц);

	Возврат ТаблицаОстатковПоЯчейкам; 
	
КонецФункции

Функция НовыйПараметрыЗаполненияОтбора() Экспорт
	
	Перем ПараметрыЗаполения;
	
	// для учета подобранных ячеек в предыдущих заданиях при последовательном расчете остатков в ячейках по нескольким заданиям (без записи заданий в базу)
	// чтобы система не подбирала одни и те же остатки для разных заданий
	МетаданныеРегистра = Метаданные.РегистрыНакопления.вмс_ОперацияПоЯчейкам;
	ТаблицаДвиженийЗаданий = Новый ТаблицаЗначений;
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		ТаблицаДвиженийЗаданий.Колонки.Добавить(Измерение.Имя, Измерение.Тип);
	КонецЦикла;

	Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
		ТаблицаДвиженийЗаданий.Колонки.Добавить(Ресурс.Имя + "Оборот", Ресурс.Тип);
	КонецЦикла;
	
	ПараметрыЗаполения = Новый Структура;
	ПараметрыЗаполения.Вставить("ЗаданиеКладовщику");
	ПараметрыЗаполения.Вставить("ТаблицаДвиженийЗаданий", ТаблицаДвиженийЗаданий);
	ПараметрыЗаполения.Вставить("Товары", Неопределено);
	ПараметрыЗаполения.Вставить("Склад", Неопределено);
	ПараметрыЗаполения.Вставить("Правило", Неопределено);
	ПараметрыЗаполения.Вставить("Помещение", Неопределено);
	ПараметрыЗаполения.Вставить("Контрагент", Неопределено);
	ПараметрыЗаполения.Вставить("ТипыЯчеек", вмс_ОтборВызовСервера.ТипыЯчеекДляОтбора());
	ПараметрыЗаполения.Вставить("ПараметрыВГХ", вмс_РазмещениеСервер.НастройкиРазмещения()); 
	
	Возврат ПараметрыЗаполения;
	
КонецФункции

Функция ПолучитьЗонуКонтроля(Склад) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	вмс_МестаХранения.Ссылка КАК ЗонаКонтроля
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	вмс_МестаХранения.Владелец = &Склад
	|	И вмс_МестаХранения.ПометкаУдаления = ЛОЖЬ
	|	И вмс_МестаХранения.ТипЯчейки = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаКонтроля)";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(); 
	Выборка.Следующий();
	
	Возврат Выборка.ЗонаКонтроля;
	
КонецФункции

Функция НовыеПараметрыКонтроля() Экспорт
	
	ПараметрыРазмещения = Новый Структура;  
	ПараметрыРазмещения.Вставить("Процесс");
	ПараметрыРазмещения.Вставить("Операция");   
	ПараметрыРазмещения.Вставить("Автор");
	ПараметрыРазмещения.Вставить("Склад");
	ПараметрыРазмещения.Вставить("ЗонаОтгрузки");
	ПараметрыРазмещения.Вставить("ЗонаКонтроля");
	ПараметрыРазмещения.Вставить("ТаблицаКонтроля");
		
	Возврат ПараметрыРазмещения;
	
КонецФункции 

Функция ПодготовитьПланЗаданияДляОтгрузкиКонтейнеров(ТаблицаПлан, КонтейнерыЗадания, Правило) Экспорт    
	
	РК = вмс_РаботаСКоллекциями;
	
	ДанныеЗаполненияПланаПоКонтейнерам = ПолучитьДанныеЗаполненияПланаПоКонтейнерам(КонтейнерыЗадания, Правило);
	
	ПустаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	ПустаяХарактеристика = вмс_АдаптацияКонфигураций.ПустаяХарактеристика();
	ПустаяСерия = Справочники.вмс_СерииНоменклатуры.ПустаяСсылка();  
	ПустойКонтейнер = Справочники.вмс_Контейнеры.ПустаяСсылка();
	ТипКонтейнер = ТипЗнч(ПустойКонтейнер);

	ОтборПоКонтейнеру = Новый Структура("Контейнер");
	ОтборПоКонтейнеру.Вставить("ОбработаноКонтейнеры", Ложь);
	
	ОтборПоТовару = Новый Структура("Контейнер, Товар, Характеристика, Серия");
	ОтборПоТовару.Вставить("ОбработаноКонтейнеры", Ложь);
	Для Каждого ДанныеЗаполненияПоКонтейнеру Из ДанныеЗаполненияПланаПоКонтейнерам Цикл
		
		КонтейнерПодходитЦеликом = ДанныеЗаполненияПоКонтейнеру.Целиком;

		Если ДанныеЗаполненияПоКонтейнеру.Целиком Тогда
			// сначала попробуем подобрать товары в отдельной таблице
			// если получится, то перенесем в основную
			// если не получится, то не будем ничего делать с основной таблицей
			ОтборПоКонтейнеру.Контейнер = ДанныеЗаполненияПоКонтейнеру.КонтейнерВерхнегоУровня;
			ЭлементыПланаПоКонтейнеру = ТаблицаПлан.НайтиСтроки(ОтборПоКонтейнеру);
			ТаблицаПланПоКонтейнеру = ТаблицаПлан.Скопировать(ЭлементыПланаПоКонтейнеру);
		Иначе
			ТаблицаПланПоКонтейнеру = ТаблицаПлан;
		КонецЕсли;
		
		Для Каждого ТоварКонтейнера Из ДанныеЗаполненияПоКонтейнеру.Товары Цикл
			ЗаполнитьЗначенияСвойств(ОтборПоТовару, ТоварКонтейнера);
			ОтборПоТовару.Контейнер = ДанныеЗаполненияПоКонтейнеру.КонтейнерВерхнегоУровня;
			ЭлементыТовараПлана = ТаблицаПланПоКонтейнеру.НайтиСтроки(ОтборПоТовару);
			
			КоличествоОстаток = ТоварКонтейнера.КоличествоОстаток;
			Для Каждого ЭлементТовараПлана Из ЭлементыТовараПлана Цикл
				
				КоличествоДоступно = Мин(ЭлементТовараПлана.Количество, КоличествоОстаток);
				Если КоличествоДоступно <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НовыйЭлементТовараПлана = ТаблицаПланПоКонтейнеру.Добавить();
				ЗаполнитьЗначенияСвойств(НовыйЭлементТовараПлана, ЭлементТовараПлана);
				Если КонтейнерПодходитЦеликом Тогда
					НовыйЭлементТовараПлана.Контейнер = ДанныеЗаполненияПоКонтейнеру.Контейнер;
				Иначе
					// разбор контейнера
					НовыйЭлементТовараПлана.КонтейнерОтправитель = ДанныеЗаполненияПоКонтейнеру.Контейнер;
					НовыйЭлементТовараПлана.Контейнер = ПустойКонтейнер;
				КонецЕсли;
				НовыйЭлементТовараПлана.Количество = КоличествоДоступно;
				НовыйЭлементТовараПлана.ОбработаноКонтейнеры = Истина;
				
				КоличествоОстаток = КоличествоОстаток - КоличествоДоступно;
				ЭлементТовараПлана.Количество = ЭлементТовараПлана.Количество - КоличествоДоступно;
				
				Если ЭлементТовараПлана.Количество=0 Тогда
					ТаблицаПланПоКонтейнеру.Удалить(ЭлементТовараПлана);
				КонецЕсли;
				
			КонецЦикла;
			
			Если КонтейнерПодходитЦеликом Тогда
				Если КоличествоОстаток > 0 Тогда
					КонтейнерПодходитЦеликом = Ложь;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ДанныеЗаполненияПоКонтейнеру.Целиком И КонтейнерПодходитЦеликом Тогда
			// переносим информацию по контейнеру в основную таблицу
			Для Каждого ЭлементПланаПоКонтейнеру Из ЭлементыПланаПоКонтейнеру Цикл
				ТаблицаПлан.Удалить(ЭлементПланаПоКонтейнеру);
			КонецЦикла;

			Для Каждого ЭлементПланаПоКонтейнеру Из ТаблицаПланПоКонтейнеру Цикл
				НовыйЭлементПланаПоКонтейнеру = ТаблицаПлан.Добавить();
				ЗаполнитьЗначенияСвойств(НовыйЭлементПланаПоКонтейнеру, ЭлементПланаПоКонтейнеру);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс 

Функция ПодготовитьВходящуюТаблицу(Товары)
	
	ТаблицаТоваров = вмс_РаботаСКоллекциями.НоваяТаблицаЗначений("Номенклатура, Характеристика, Серия, СпособВводаСерии, Упаковка, Количество, ВесЕдиницыТовара, ОбъемЕдиницыТовара", Товары);
	
	вмс_РаботаСКоллекциями.ДобавитьЭлементыКоллекции(ТаблицаТоваров, Товары);	  
	
	// ТУ_КС+
	// Пока без учета серий, так как замножает остатки при соединении по строкам с серией и без серии
	ТаблицаТоваров.ЗаполнитьЗначения(Перечисления.вмс_СпособВводаСерии.ПоФакту, "СпособВводаСерии");
	ТаблицаТоваров.ЗаполнитьЗначения(Справочники.вмс_СерииНоменклатуры.ПустаяСсылка(), "Серия");
	// ТУ_КС-
	
	ТаблицаТоваров.Свернуть("Номенклатура, Характеристика, Серия, СпособВводаСерии, Упаковка, ВесЕдиницыТовара, ОбъемЕдиницыТовара", "Количество");
	
	вмс_РаботаСКоллекциями.ТипизироватьТаблицуЗначений(ТаблицаТоваров);
	
	вмс_РаботаСКоллекциями.ПереименоватьКолонкуКоллекцииЗначений(ТаблицаТоваров, "Номенклатура", "Товар");
	
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Функция СоздатьОбщуюТаблицуЯчеек()
	
	ОбщаяТаблицаЗначений = Новый ТаблицаЗначений;
	
	
	ОбщаяТаблицаЗначений.Колонки.Добавить("Ячейка", Новый ОписаниеТипов("СправочникСсылка.вмс_МестаХранения"));
	ОбщаяТаблицаЗначений.Колонки.Добавить("Товар", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ОбщаяТаблицаЗначений.Колонки.Добавить("Характеристика", Новый ОписаниеТипов(вмс_РаботаСКоллекциями.ЗначениеВМассив(ТипЗнч(вмс_АдаптацияКонфигураций.ПустаяХарактеристика()))));
	ОбщаяТаблицаЗначений.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.вмс_СерииНоменклатуры"));
	ОбщаяТаблицаЗначений.Колонки.Добавить("Упаковка", Новый ОписаниеТипов(вмс_АдаптацияКонфигураций.ПолучитьИмяТипаСправочникаУпаковки()));
	ОбщаяТаблицаЗначений.Колонки.Добавить("СвободныйОбъем",  Новый ОписаниеТипов("Число"));
	ОбщаяТаблицаЗначений.Колонки.Добавить("Приоритет",  Новый ОписаниеТипов("Число"));
	
	Возврат ОбщаяТаблицаЗначений; 
	
КонецФункции   

Функция ДобавитьТаблицуЗапросаВходящиеТовары(МенеджерВременныхТаблиц, ТаблицаТоваров)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	//// ПАКЕТ ДЛЯ ОТЛАДКИ ЧЕРЕЗ ССЫЛКУ, А НЕ ЧЕРЕЗ ВРЕМ.ТАБ +
	//"ВЫБРАТЬ
	//|	вмс_ЗаданиеКладовщикуТовары.Номенклатура КАК Номенклатура,
	//|	вмс_ЗаданиеКладовщикуТовары.Характеристика КАК Характеристика,
	//|	вмс_ЗаданиеКладовщикуТовары.Серия КАК Серия,
	//|	вмс_ЗаданиеКладовщикуТовары.Упаковка КАК Упаковка,
	//|	вмс_ЗаданиеКладовщикуТовары.Количество КАК Количество
	//|ПОМЕСТИТЬ ТЗ
	//|ИЗ
	//|	Документ.вмс_ЗаданиеКладовщику.Товары КАК вмс_ЗаданиеКладовщикуТовары
	//|ГДЕ
	//|	вмс_ЗаданиеКладовщикуТовары.Ссылка = &Ссылка"
	//// ПАКЕТ ДЛЯ ОТЛАДКИ ЧЕРЕЗ ССЫЛКУ, А НЕ ЧЕРЕЗ ВРЕМ.ТАБ -
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ТаблицаТоваров.Товар КАК Товар,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.Упаковка ЕСТЬ NULL
	|			ТОГДА &УпаковкиПустаяСсылка
	|		ИНАЧЕ ТаблицаТоваров.Упаковка
	|	КОНЕЦ КАК Упаковка,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.СпособВводаСерии КАК СпособВводаСерии,
	|	ТаблицаТоваров.Серия КАК Серия
	|ПОМЕСТИТЬ ТЗ
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Товар,
	|	ТЗ.Характеристика КАК Характеристика,
	|	ТЗ.Упаковка КАК Упаковка,
	|	ТЗ.Количество КАК Количество,
	|	&ТекстЗапросаОбъемНоменклатуры КАК ОбъемЕдиницыТовара,
	|	&ТекстЗапросаВесНоменклатуры КАК ВесЕдиницыТовара,
	|	ТЗ.СпособВводаСерии КАК СпособВводаСерии,
	|	ТЗ.Серия КАК Серия
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЗ КАК ТЗ
	|		ПО Номенклатура.Ссылка = ТЗ.Товар";
	
	Запрос.УстановитьПараметр("УпаковкиПустаяСсылка", вмс_АдаптацияКонфигураций.ПустаяУпаковка());
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаОбъемНоменклатуры", вмс_АдаптацияКонфигураций.ТекстЗапросаОбъемНоменклатуры("ТЗ.Упаковка","Номенклатура.Ссылка"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаВесНоменклатуры", вмс_АдаптацияКонфигураций.ТекстЗапросаВесНоменклатуры("ТЗ.Упаковка","Номенклатура.Ссылка"));
	
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	
	Запрос.Выполнить();
	ТаблицаТоваров = Запрос.МенеджерВременныхТаблиц.Таблицы["ТаблицаТоваров"].ПолучитьДанные().Выгрузить();
	
	Возврат Запрос.МенеджерВременныхТаблиц;
	
КонецФункции 

Функция ДобавитьТаблицуЗапросаДвиженияЗадания(МенеджерВременныхТаблиц, ЗаданиеКладовщику)
	
	// отминусем старые движения, приплюсуем новые
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаДвижений.Ячейка КАК Ячейка,
	|	ТаблицаДвижений.Контейнер КАК Контейнер,
	|	ТаблицаДвижений.Товар КАК Товар,
	|	ТаблицаДвижений.Характеристика КАК Характеристика,
	|	ТаблицаДвижений.Серия КАК Серия,
	|	ТаблицаДвижений.Партия КАК Партия,
	|	ТаблицаДвижений.Упаковка КАК Упаковка,
	|	ТаблицаДвижений.Качество КАК Качество,
	|	ВЫБОР
	|		КОГДА ТаблицаДвижений.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА ТаблицаДвижений.Количество
	|		ИНАЧЕ -ТаблицаДвижений.Количество
	|	КОНЕЦ КАК КоличествоОборот,
	|	ВЫБОР
	|		КОГДА ТаблицаДвижений.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА ТаблицаДвижений.Вес
	|		ИНАЧЕ -ТаблицаДвижений.Вес
	|	КОНЕЦ КАК ВесОборот,
	|	ВЫБОР
	|		КОГДА ТаблицаДвижений.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
