Функция ПодключитьСистемуШтрихкодирования(Форма, КлавиатурнаяПанель=Неопределено) Экспорт
		
	Если Не ПодключитьСистемуШтрихкодированияЧерезГорячиеКлавиши(Форма, , , КлавиатурнаяПанель) Тогда
		ПодключитьСистемуШтрихкодированияЧерезДрайвер(Форма);
	КонецЕсли;
	
	ЗаполнитьПодменюСканирование(Форма);
	
КонецФункции
 
Функция ОтключитьСистемуШтрихкодирования(Форма) Экспорт
	
	ОтключитьСистемуШтрихкодированияЧерезДрайвер(Форма);
	ОтключитьСистемуШтрихкодированияЧерезГорячиеКлавиши(Форма);
	
КонецФункции

Функция ЗаполнитьПодменюСканирование(Форма) Экспорт
	
	Если НЕ вмс_РаботаСФормамиКлиентСервер.ПроверитьНаличиеСлужебногоСерверногоМетодаФормы(Форма) Тогда
		// не будем работать с такой формой
		Возврат Ложь;
	КонецЕсли;
	
	ИмяПодменю = "ПодменюСканирование";
	ПодменюСканирование = Форма.Элементы.Найти(ИмяПодменю);
	Если ПодменюСканирование = Неопределено Тогда
		Форма.СлужебнаяФункцияВызовСервера("Форма.Элементы.Добавить(""" + ИмяПодменю + """, Тип(""ГруппаФормы""))");
	КонецЕсли;
	
	Команды = вмс_ПодключаемыеКомандыКлиентСервер.ТаблицаКоманд();
	Команда = вмс_РаботаСКоллекциями.ДобавитьСтрокуКвазиТаблицыЗначений(Команды);
	Команда.ИмяВФорме = "ВводШтрихкодаЧерезПолеВвода";
	Команда.Картинка = БиблиотекаКартинок.вмс_Штрихкод;
	Команда.Подменю = ИмяПодменю;
	Команда.Обработчик = "вмс_РаботаСФормамиКлиент.ОткрытьФормуВводаШтрихкодаЧерезПолеВвода";
	
	Команда = вмс_РаботаСКоллекциями.ДобавитьСтрокуКвазиТаблицыЗначений(Команды);
	Команда.ИмяВФорме = "ВводШтрихкодаЧерезКамеру";
	Команда.Картинка = БиблиотекаКартинок.вмс_Фотокамера;
	Команда.Подменю = ИмяПодменю;
	Команда.Обработчик = "вмс_РаботаСФормамиКлиент.ОткрытьФормуВводаШтрихкодаЧерезСредстваМультимедиа";

	вмс_ПодключаемыеКомандыКлиент.ВывестиКоманды(Форма, Команды.Строки);
	
	Возврат Истина;
	
КонецФункции

Функция ОбработатьВнешнееСобытие(Форма, Источник, Событие, Данные) Экспорт
	
	ПараметрыПодключения = вмс_ПараметрыПриложения["СистемаШтрихкодирования"].Клиенты[Форма];
	Если ПараметрыПодключения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыПодключения.Тип <> ПредопределенноеЗначение("Перечисление.вмс_ТипыСистемШтрихкодирования.ЧерезДрайвер") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Форма.ВводДоступен() Тогда
		Если Событие = "Штрихкод" Тогда
			ВыполнитьОбработкуОповещения(ПараметрыПодключения.ОповещениеВводШтрихкода, Данные);
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ОбработатьШтрихкод(Форма, Штрихкод) Экспорт
	
	КэшШтрихкодов = вмс_РаботаСКоллекциями.ПолучитьПолеСоответствия(ПолучитьКлиентскиеПеременныеОбъекта(Форма), "КэшШтрихкодов", Новый Соответствие);
	Результат = КэшШтрихкодов[Штрихкод];
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = вмс_ОбработкаШтрихкодовВызовСервера.ОбработатьШтрихкод(Штрихкод);
	КэшШтрихкодов[Штрихкод] = Результат;
	Возврат Результат;
	
КонецФункции

