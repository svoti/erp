Функция ПодключитьСистемуШтрихкодированияЧерезГорячиеКлавиши(Форма, Префикс="!", Суффикс="%", КлавиатурнаяПанель=Неопределено, ГруппаРазмещенияКлавиатурнойПанели=Неопределено, знач ОповещениеВводШтрихкода=Неопределено) Экспорт
	
	Если КлавиатурнаяПанель = Неопределено Тогда
		КлавиатурнаяПанель = вмс_РаботаСФормамиКлиент.НоваяКлавиатурнаяПанель(Форма, ГруппаРазмещенияКлавиатурнойПанели);
		Если КлавиатурнаяПанель = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		СобственнаяКлавиатурнаяПанель = Истина;
	Иначе
		СобственнаяКлавиатурнаяПанель = Ложь;
	КонецЕсли;
	
	СтрокаКнопок = Префикс + Суффикс + "!@#$%^&*()QWERTYUIOPASDFGHJKLZXCVBNM1234567890qwertyuiopasdfghjklzxcvbnm";
	
	вмс_РаботаСФормамиКлиент.ДобавитьКнопкиИКомандыКлавиатурнойПанели(КлавиатурнаяПанель, СтрокаКнопок);
	
	Если ТипЗнч(ОповещениеВводШтрихкода) <> Тип("ОписаниеОповещения") Тогда
		Если ТипЗнч(ОповещениеВводШтрихкода) = Тип("Строка") Тогда
			ИмяМетодаОбработчикаОповещения = ОповещениеВводШтрихкода;
		Иначе
			ИмяМетодаОбработчикаОповещения = "ОбработкаВводаШтрихкода";
		КонецЕсли;
		
		ОповещениеВводШтрихкода = Новый ОписаниеОповещения(ИмяМетодаОбработчикаОповещения, Форма);
	КонецЕсли;
	
	ИмяСистемы = "СистемаШтрихкодированияЧерезГорячиеКлавиши";
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("ИмяСистемы", ИмяСистемы);
	ПараметрыПодключения.Вставить("Форма");
	ПараметрыПодключения.Вставить("Тип", ПредопределенноеЗначение("Перечисление.вмс_ТипыСистемШтрихкодирования.ЧерезКлавиатуруИГорячиеКлавиши"));
	ПараметрыПодключения.Вставить("Префикс", Префикс);
	ПараметрыПодключения.Вставить("Суффикс", Суффикс);
	ПараметрыПодключения.Вставить("КлавиатурнаяПанель", КлавиатурнаяПанель);
	ПараметрыПодключения.Вставить("СобственнаяКлавиатурнаяПанель", СобственнаяКлавиатурнаяПанель);
	ПараметрыПодключения.Вставить("ДлинаПрефикса", СтрДлина(Префикс));
	ПараметрыПодключения.Вставить("ДлинаСуффикса", СтрДлина(Суффикс));
	ПараметрыПодключения.Вставить("СостояниеВвода", 0);
	ПараметрыПодключения.Вставить("БуфферВвода", "");
	ПараметрыПодключения.Вставить("ДлинаБуффера", 0);
	ПараметрыПодключения.Вставить("Штрихкод", "");
	ПараметрыПодключения.Вставить("ОповещениеВводШтрихкода", ОповещениеВводШтрихкода);
	
	вмс_РаботаСФормамиКлиент.КлавиатурнаяПанель_ДобавитьСлушателя(КлавиатурнаяПанель, ИмяСистемы, Новый ОписаниеОповещения("ОбработатьВводСимволаШтрихкодаПоГорячейКлавише", ЭтотОбъект, ПараметрыПодключения));
	
	вмс_ПараметрыПриложения["СистемаШтрихкодирования"].Клиенты[Форма] = ПараметрыПодключения;
	Возврат Истина;
	
КонецФункции

Функция ОтключитьСистемуШтрихкодированияЧерезГорячиеКлавиши(Форма) Экспорт
	
	ПараметрыПодключения = вмс_ПараметрыПриложения["СистемаШтрихкодирования"].Клиенты[Форма];
	Если НЕ (ПараметрыПодключения <> Неопределено И ПараметрыПодключения.Тип = ПредопределенноеЗначение("Перечисление.вмс_ТипыСистемШтрихкодирования.ЧерезКлавиатуруИГорячиеКлавиши")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	вмс_РаботаСФормамиКлиент.КлавиатурнаяПанель_УдалитьСлушателя(ПараметрыПодключения.КлавиатурнаяПанель, ПараметрыПодключения.ИмяСистемы);
	Если ПараметрыПодключения.СобственнаяКлавиатурнаяПанель Тогда
		вмс_РаботаСФормамиКлиент.КлавиатурнаяПанель_Поломать(ПараметрыПодключения.КлавиатурнаяПанель);
	КонецЕсли;
	
	вмс_ПараметрыПриложения["СистемаШтрихкодирования"].Клиенты.Удалить(Форма);
	
	Возврат Истина;
	
КонецФункции

Функция ОбработатьВводСимволаШтрихкодаПоГорячейКлавише(БуфферВвода, СистемаШтрихкодирования) Экспорт
	
	ТекущийБуффер = СистемаШтрихкодирования.БуфферВвода + БуфферВвода;
	ДлинаТекущегоБуффера = СтрДлина(ТекущийБуффер);
	
	Сброс = Ложь;
	Если СистемаШтрихкодирования.СостояниеВвода = 0 Тогда
		
		// ожидание префикса
		Если ДлинаТекущегоБуффера <= СистемаШтрихкодирования.ДлинаПрефикса Тогда
			ЧастьПрефикса = Лев(СистемаШтрихкодирования.Префикс, ДлинаТекущегоБуффера);
			Если ЧастьПрефикса = ТекущийБуффер Тогда
				//ок
				Если ДлинаТекущегоБуффера = СистемаШтрихкодирования.ДлинаПрефикса Тогда
					СистемаШтрихкодирования.СостояниеВвода = 1;
					ТекущийБуффер = "";
					ДлинаТекущегоБуффера = 0;
				КонецЕсли;
			Иначе
				Сброс = Истина;
			КонецЕсли;
		Иначе
			Сброс = Истина;
		КонецЕсли;
		
	ИначеЕсли СистемаШтрихкодирования.СостояниеВвода = 1 Тогда
		
		Если Прав(ТекущийБуффер, СистемаШтрихкодирования.ДлинаСуффикса) = СистемаШтрихкодирования.Суффикс Тогда
			СистемаШтрихкодирования.Штрихкод = Лев(ТекущийБуффер, ДлинаТекущегоБуффера-СистемаШтрихкодирования.ДлинаСуффикса);
			ВыполнитьОбработкуОповещения(СистемаШтрихкодирования.ОповещениеВводШтрихкода, СистемаШтрихкодирования.Штрихкод);
			СистемаШтрихкодирования.СостояниеВвода = 0;
			ТекущийБуффер = "";
			ДлинаТекущегоБуффера = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Сброс Тогда
		СистемаШтрихкодирования.БуфферВвода = "";
		СистемаШтрихкодирования.ДлинаБуффера = 0;
		СистемаШтрихкодирования.СостояниеВвода = 0;
		БуфферВвода = ТекущийБуффер;
	Иначе
		СистемаШтрихкодирования.БуфферВвода = ТекущийБуффер;
		СистемаШтрихкодирования.ДлинаБуффера = ДлинаТекущегоБуффера;
		БуфферВвода = "";
	КонецЕсли; 
	
	Возврат Истина;
	
КонецФункции

