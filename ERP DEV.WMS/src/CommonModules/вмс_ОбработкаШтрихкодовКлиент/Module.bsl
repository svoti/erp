Функция ПодключитьОборудованиеЗавершение(РезультатВыполнения, ПараметрыПодключения) Экспорт
	
	МенеджерОборудованияКлиент.ПодключитьОборудованиеЗавершениеПоУмолчанию(РезультатВыполнения, Неопределено);
	
	Если РезультатВыполнения.Результат Тогда
		вмс_ПараметрыПриложения["СистемаШтрихкодирования"].Клиенты[ПараметрыПодключения.Форма] = ПараметрыПодключения;
	КонецЕсли;
	
КонецФункции

Функция ПодключитьСистемуШтрихкодированияЧерезДрайвер(Форма, ОповещениеВводШтрихкода=Неопределено) Экспорт
		
	Если ТипЗнч(ОповещениеВводШтрихкода) <> Тип("ОписаниеОповещения") Тогда
		Если ТипЗнч(ОповещениеВводШтрихкода) = Тип("Строка") Тогда
			ИмяМетодаОбработчикаОповещения = ОповещениеВводШтрихкода;
		Иначе
			ИмяМетодаОбработчикаОповещения = "ОбработкаВводаШтрихкода";
		КонецЕсли;
		
		Попытка
			ОповещениеВводШтрихкода = Новый ОписаниеОповещения(ИмяМетодаОбработчикаОповещения, Форма);
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	ИмяСистемы = "СистемаШтрихкодированияЧерезДрайвер";
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("ИмяСистемы", ИмяСистемы);
	ПараметрыПодключения.Вставить("Форма", Форма);
	ПараметрыПодключения.Вставить("Тип", ПредопределенноеЗначение("Перечисление.вмс_ТипыСистемШтрихкодирования.ЧерезДрайвер"));
	ПараметрыПодключения.Вставить("ОповещениеВводШтрихкода", ОповещениеВводШтрихкода);
	
	ОповещениеПриПодключении = Новый ОписаниеОповещения("ПодключитьОборудованиеЗавершение", ЭтотОбъект, ПараметрыПодключения);
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(ОповещениеПриПодключении, Форма.УникальныйИдентификатор,
					МенеджерОборудованияКлиент.ПреобразоватьСписокСтрокойВМассив("СканерШтрихкода"));
					
	Возврат Истина;
	
КонецФункции

Функция ОтключитьСистемуШтрихкодированияЧерезДрайвер(Форма) Экспорт
	
	ОповещениеПриОтключении = Неопределено;
	
	Если ОповещениеПриОтключении = Неопределено Тогда
		ОповещениеПриОтключении = Новый ОписаниеОповещения("ОтключитьОборудованиеЗавершениеПоУмолчанию", МенеджерОборудованияКлиент);
	КонецЕсли;
	
	//Попытка
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПоТипу(ОповещениеПриОтключении, Форма.УникальныйИдентификатор, ПреобразоватьСписокСтрокойВМассив("СканерШтрихкода"));
	//Исключение
	//КонецПопытки;
	
	ОтключитьСистемуШтрихкодированияЧерезГорячиеКлавиши(Форма);
	
КонецФункции

