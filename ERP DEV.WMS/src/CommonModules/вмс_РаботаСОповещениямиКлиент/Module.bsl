// Отображает пользователю все актуальные оповещения и очищает очередь
// Точка вызова - вмс_МодульПриложенияГлобальный
//
// Параметры:
//  Отсутствуют
//
// Описание:
//  Получает список актуальных оповещений для текущего пользователя,
//  отображает их через стандартный механизм оповещений 1С
//  и очищает очередь показанных сообщений.
//  Выполняется с проверкой прав и обработкой возможных ошибок.
//
Процедура ПоказатьОповещениеКлиента() Экспорт
	
	Если НЕ вмс_РаботаСПользователямиСервер.ПроверитьПраваНаВМС() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		МассивОповещений = вмс_РаботаСОповещениями.ПолучитьСписокАктуальныхОповещений();
		Если МассивОповещений.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Заголовок = "Оповещение AS WMS";
		
		Для Каждого Строка Из МассивОповещений Цикл
			ТекстОповещения = Строка.ТекстОповещения;
			ДополнитьТекстОповещенияПереопределяемый(Строка, ТекстОповещения);
			ПоказатьОповещениеПользователя(Заголовок, , ТекстОповещения, , СтатусОповещенияПользователя.Важное);
		КонецЦикла; 
		
		Если НЕ вмс_РаботаСОповещениями.УдалитьЗапланированныеОповещенияПользователю() Тогда
			вмс_Журналирование.Ошибка("Не удалось очистить очередь оповещений");
		КонецЕсли;
		
	Исключение
		вмс_Журналирование.Ошибка(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// Формирует итоговый текст оповещения с возможностью его дополнения
//
// Параметры:
//  ДанныеОповещения - Структура - данные оповещения для анализа и дополнения
//  ТекстОповещения - Строка - базовый текст оповещения (по умолчанию пустая строка)
//
// Возвращаемое значение:
//  Строка - сформированный текст оповещения с возможными дополнениями
//
// Описание:
//  Предоставляет точку расширения для модификации текста оповещения.
//  В базовой реализации возвращает исходный текст без изменений.
//  Предназначена для переопределения в дочерних конфигурациях.
//
Функция ДополнитьТекстОповещенияПереопределяемый(ДанныеОповещения, ТекстОповещения)
	
	Если Не ЗначениеЗаполнено(ТекстОповещения) Тогда
		ТекстОповещения = "";
	КонецЕсли;
	
	Дополнение = "";
	
	// Возмможность переопределить текст оповещения
	ДополненныйТекст = ТекстОповещения + Дополнение;
	
	Возврат ДополненныйТекст;
	
КонецФункции
