Функция ВерсияКвазиТаблицы()
	Возврат 5;
КонецФункции

Функция НоваяКвазиТаблицаЗначений(Источник=Неопределено) Экспорт
	
	МенеджерИндексирования = НовыйМенеджерИндексирования();
	
	НумерацияСтрок = Новый Структура;
	НумерацияСтрок.Вставить("ТекущийНомер", 1);
	НумерацияСтрок.Вставить("НомераИСтроки", Новый Соответствие);
	
	КакБыТаблица = Новый Структура;
	КакБыТаблица.Вставить("Колонки", Новый Структура);
	КакБыТаблица.Вставить("Строки", Новый Массив);
	КакБыТаблица.Вставить("НумерацияСтрок", НумерацияСтрок);
	КакБыТаблица.Вставить("МенеджерИндексирования", МенеджерИндексирования);
	КакБыТаблица.Вставить("Удостоверение", "Йа квази таблицо");
	КакБыТаблица.Вставить("Версия", ВерсияКвазиТаблицы());
	КакБыТаблица.Вставить("ДопускатьНарушениеСсылочнойЦелостности", Ложь);
	
	СписокКолонок = Неопределено;
	Строки = Неопределено;
	#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Если ТипЗнч(Источник) = Тип("ТаблицаЗначений") Тогда
			СписокКолонок = ВыгрузитьЗначенияКолонкиКоллекции(Источник.Колонки, "Имя");
			Строки = Источник;
		КонецЕсли;
	#КонецЕсли
	
	Если СписокКолонок = Неопределено Тогда
		СписокКолонок = Источник;
	КонецЕсли;
	
	Если СписокКолонок <> Неопределено Тогда
		ДобавитьКолонкиКвазиТаблицыЗначений(КакБыТаблица, СписокКолонок);
	КонецЕсли;
	
	Если Строки <> Неопределено Тогда
		ДобавитьСтрокиКвазиТаблицыЗначений(КакБыТаблица, Строки);
	КонецЕсли;
	
	Возврат КакБыТаблица;
	
КонецФункции

Функция ЭтоКвазиТаблицаЗначений(Таблица) Экспорт
	
	Если ТипЗнч(Таблица) = Тип("Структура") И
			Таблица.Свойство("Удостоверение") И Таблица.Удостоверение = "Йа квази таблицо" И
				Таблица.Свойство("Версия") И Таблица.Версия = ВерсияКвазиТаблицы() Тогда
		Возврат Истина;
	КонецЕсли; 
	
	Возврат Ложь;
	
КонецФункции

Функция ДобавитьИндексыКвазиТаблицыЗначений(Таблица, Индексы) Экспорт
	МенеджерИндексирования_ДобавитьИндексКоллекции(Таблица.МенеджерИндексирования, Таблица.Строки, Индексы);
КонецФункции

Функция ИндексироватьСтрокиКвазиТаблицы(Таблица, Строки) Экспорт
	
	МенеджерИндексирования_ИндексироватьКоллекцию(Таблица.МенеджерИндексирования, Строки);
	
	Возврат Истина;
	
КонецФункции

Функция ИндексироватьКвазиТаблицу(Таблица) Экспорт
	
	МенеджерИндексирования_ОчиститьИндексы(Таблица.МенеджерИндексирования);
	МенеджерИндексирования_ИндексироватьКоллекцию(Таблица.МенеджерИндексирования, Таблица.Строки)
	
КонецФункции

Функция НайтиСтрокиКвазиТаблицыЗначенийПоИндексу(Таблица, Отбор, ОтборБезИндекса, Упорядочить) Экспорт
	
	СистемаИндексирования = МенеджерИндексирования_ПодобратьИндекс(Таблица.МенеджерИндексирования, Отбор);
	Если СистемаИндексирования = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Если СистемаИндексирования.ПоляИндексированияМассив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не Таблица.ДопускатьНарушениеСсылочнойЦелостности Тогда
		Если Таблица.Строки.Количество() > 0 Тогда
			ПерваяСтрока = Таблица.Строки[0];
			Если СистемаИндексирования.ИндексыСтрок[ПерваяСтрока] = Неопределено Тогда
				// Нарушена ссылочная целостность индекса
				// искать перебором строк
				Возврат Неопределено;
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 

	НайденныеСтроки = НайтиСтрокиКоллекцииВИндексе(СистемаИндексирования, Отбор, ОтборБезИндекса);
	
	Если НайденныеСтроки.Количество() > 1 Тогда
		Если Не Упорядочить Тогда
			Возврат НайденныеСтроки;
		КонецЕсли; 
		
		// восстановить порядок строк так, как порядок в индексе не поддерживается
		НомераИСтроки = Таблица.НумерацияСтрок.НомераИСтроки;
		НомерСтроки = НомераИСтроки[НайденныеСтроки[0]];
		Если НомерСтроки = Неопределено Тогда
			// Нарушена ссылочная целостность таблицы, упорядочить не получится
			// при работе с найденными строками надо учитывать, что это не ссылки на строки, а копии строк
			// для чтения информации это может быть приемлемо, но для изменения недопустимо
			Возврат НайденныеСтроки;
		КонецЕсли;
		
		НомераСтрок = Новый Массив;
		НомераСтрок.Добавить(НомерСтроки);
		Для Индекс=1 По НайденныеСтроки.ВГраница() Цикл
			НомераСтрок.Добавить(НомераИСтроки[НайденныеСтроки[Индекс]]);
		КонецЦикла;
		СортироватьМассив(НомераСтрок);
		
		НайденныеСтроки.Очистить();
		Для Каждого НомерСтроки Из НомераСтрок Цикл
			НайденныеСтроки.Добавить(НомераИСтроки[НомерСтроки]);
		КонецЦикла;
	КонецЕсли;
	
	Возврат НайденныеСтроки;

КонецФункции

Функция БинарнаяСортировка(знач Элементы, Поле=Неопределено) Экспорт
	
	КоличествоЭлементов = Элементы.Количество();
	
	Шаг = 1;
	
	Пока Шаг < КоличествоЭлементов Цикл
		
		ОтсортированныеЭлементы = Новый Массив;

		ЛевыйИндекс = 0;

		ПравыйИндекс = Шаг;
		
		Пока ЛевыйИндекс < КоличествоЭлементов Цикл
			
			КонецЛевогоИнтервала = ЛевыйИндекс + Шаг-1;
			Если КонецЛевогоИнтервала > КоличествоЭлементов-1 Тогда
				КонецЛевогоИнтервала = КоличествоЭлементов-1;
			КонецЕсли;
			
			КонецПравогоИнтервала = ПравыйИндекс + Шаг-1;
			Если КонецПравогоИнтервала > КоличествоЭлементов-1 Тогда
				КонецПравогоИнтервала = КоличествоЭлементов-1;
			КонецЕсли;
			
			Если Поле=Неопределено Тогда
				Если ЛевыйИндекс <= КонецЛевогоИнтервала И ПравыйИндекс <= КонецПравогоИнтервала Тогда
					ЛевыйЭлемент = Элементы[ЛевыйИндекс];
					ПравыйЭлемент = Элементы[ПравыйИндекс];
					Пока Истина Цикл
						Если ПравыйЭлемент < ЛевыйЭлемент Тогда
							ОтсортированныеЭлементы.Добавить(ПравыйЭлемент);
							ПравыйИндекс = ПравыйИндекс + 1;
							Если ПравыйИндекс > КонецПравогоИнтервала Тогда
								Прервать;
							КонецЕсли;
							ПравыйЭлемент = Элементы[ПравыйИндекс];
						Иначе
							ОтсортированныеЭлементы.Добавить(ЛевыйЭлемент);
							ЛевыйИндекс = ЛевыйИндекс + 1;
							Если ЛевыйИндекс > КонецЛевогоИнтервала Тогда
								Прервать;
							КонецЕсли;
							ЛевыйЭлемент = Элементы[ЛевыйИндекс];
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Иначе
				Пока ЛевыйИндекс <= КонецЛевогоИнтервала И ПравыйИндекс <= КонецПравогоИнтервала Цикл
					ЛевыйЭлемент = Элементы[ЛевыйИндекс];
					ПравыйЭлемент = Элементы[ПравыйИндекс];
					
					Если ПравыйЭлемент[Поле] < ЛевыйЭлемент[Поле] Тогда
						ОтсортированныеЭлементы.Добавить(ПравыйЭлемент);
						ПравыйИндекс = ПравыйИндекс + 1;
					Иначе
						ОтсортированныеЭлементы.Добавить(ЛевыйЭлемент);
						ЛевыйИндекс = ЛевыйИндекс + 1;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Пока ЛевыйИндекс <= КонецЛевогоИнтервала Цикл
				ОтсортированныеЭлементы.Добавить(Элементы[ЛевыйИндекс]);
				ЛевыйИндекс = ЛевыйИндекс + 1;
			КонецЦикла;
			ЛевыйИндекс = ЛевыйИндекс + Шаг;
				
			Пока ПравыйИндекс <= КонецПравогоИнтервала Цикл
				ОтсортированныеЭлементы.Добавить(Элементы[ПравыйИндекс]);
				ПравыйИндекс = ПравыйИндекс + 1;
			КонецЦикла;
			ПравыйИндекс = ПравыйИндекс + Шаг;
			
		КонецЦикла;
		
		Шаг = Шаг * 2;
		
		Элементы = ОтсортированныеЭлементы;
		
	КонецЦикла;
	
	Возврат Элементы;
	
КонецФункции

Функция НоваяКолонкаКвазиТаблицыЗначений() Экспорт
	КакБыКолонкаКакБыТаблицы = Новый Структура;
	КакБыКолонкаКакБыТаблицы.Вставить("Имя", "");
	КакБыКолонкаКакБыТаблицы.Вставить("ТипЗначения");
	Возврат КакБыКолонкаКакБыТаблицы;
КонецФункции

Функция НоваяСтрокаКвазиТаблицыЗначений(Колонки) Экспорт
	НоваяСтрока = Новый Структура;
	Для Каждого ЭлмКолонка Из Колонки Цикл
		Колонка = ЭлмКолонка.Значение;
		Значение = ?(Колонка.ТипЗначения=Неопределено, Неопределено, Колонка.ТипЗначения.ПривестиЗначение());
		НоваяСтрока.Вставить(Колонка.Имя, Значение);
	КонецЦикла; 
	Возврат НоваяСтрока;
КонецФункции

Функция СкопироватьКвазиТаблицуЗначений(Таблица, Строки=Неопределено, Колонки=Неопределено) Экспорт
	
	НоваяТаблица = НоваяКвазиТаблицаЗначений();
	
	Если Строки <> Неопределено Тогда
		Если ТипЗнч(Строки) = Тип("Структура") Тогда
			// отбор строк
			МассивСтрок = НайтиСтрокиКвазиТаблицыЗначений(Таблица, Строки);
		Иначе
			МассивСтрок = Строки;
		КонецЕсли;
	Иначе
		МассивСтрок = Таблица.Строки;
	КонецЕсли;
	
	Если Колонки <> Неопределено Тогда
		МассивИменКолонок = СтрокуВМассив(Колонки);
		Для Каждого ЭлмКолонка Из Таблица.Колонки Цикл
			Колонка = ЭлмКолонка.Значение;
			Если МассивИменКолонок.Найти(Колонка.Имя) <> Неопределено Тогда
				ДобавитьКолонкуКвазиТаблицыЗначений(НоваяТаблица, Колонка.Имя, Колонка.ТипЗначения);
			КонецЕсли; 
		КонецЦикла; 
	Иначе
		Для Каждого ЭлмКолонка Из Таблица.Колонки Цикл
			Колонка = ЭлмКолонка.Значение;
			ДобавитьКолонкуКвазиТаблицыЗначений(НоваяТаблица, Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла; 
	КонецЕсли;
	
	Для Каждого ЭлмСистемыИндексирования Из Таблица.МенеджерИндексирования.СистемыИндексирования Цикл
		ДобавитьИндексыКвазиТаблицыЗначений(НоваяТаблица, ЭлмСистемыИндексирования.Ключ);
	КонецЦикла; 
	
	ДобавитьСтрокиКвазиТаблицыЗначений(НоваяТаблица, МассивСтрок);
	
	Возврат НоваяТаблица;
	
КонецФункции

Функция ДобавитьКолонкуКвазиТаблицыЗначений(Таблица, ИмяКолонки, ТипЗначенияКолонки=Неопределено) Экспорт
	НоваяКолонка = НоваяКолонкаКвазиТаблицыЗначений();
	НоваяКолонка.Имя = ИмяКолонки;
	НоваяКолонка.ТипЗначения = ТипЗначенияКолонки;
	Таблица.Колонки.Вставить(ИмяКолонки, НоваяКолонка);
	Для Каждого Строка Из Таблица.Строки Цикл
		Строка.Вставить(ИмяКолонки);
	КонецЦикла;
	Возврат НоваяКолонка;
КонецФункции

Функция ДобавитьКолонкиКвазиТаблицыЗначений(Таблица, СписокКолонок) Экспорт
	Если СписокКолонок <> Неопределено И ЗначениеЗаполнено(СписокКолонок) Тогда
		МассивКолонок = ЗначениеВМассив(СписокКолонок, , Ложь);
		Для Каждого ИмяКолонки Из МассивКолонок Цикл
			ДобавитьКолонкуКвазиТаблицыЗначений(Таблица, ИмяКолонки);
		КонецЦикла; 
	КонецЕсли; 
КонецФункции

Функция ДобавитьСтрокуКвазиТаблицыЗначений(Таблица, ЗначенияКолонок=Неопределено) Экспорт
	
	НоваяСтрока = НоваяСтрокаКвазиТаблицыЗначений(Таблица.Колонки);
	Таблица.Строки.Добавить(НоваяСтрока);

	Если ЗначенияКолонок <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияКолонок);
		ИндексироватьСтрокиКвазиТаблицы(Таблица, НоваяСтрока);
	КонецЕсли;
	
	НумерацияСтрок = Таблица.НумерацияСтрок;
	НомерСтроки = НумерацияСтрок.ТекущийНомер;
	НумерацияСтрок.ТекущийНомер = НомерСтроки + 1;
	НумерацияСтрок.НомераИСтроки[НомерСтроки] = НоваяСтрока;
	НумерацияСтрок.НомераИСтроки[НоваяСтрока] = НомерСтроки;
	
	Возврат НоваяСтрока;
	
КонецФункции

Функция СдвинутьСтрокуКвазиТаблицыЗначений(Таблица, знач Строка, знач НовыйНомер) Экспорт
	
	Если ТипЗнч(Строка)=Тип("Число") Тогда
		ТекущийНомер = Строка;
		Строка = Таблица.НумерацияСтрок.НомераИСтроки[ТекущийНомер];
		Если Строка=Неопределено Тогда
			Возврат Ложь;
		КонецЕсли; 
	Иначе
		ТекущийНомер = Таблица.НумерацияСтрок.НомераИСтроки[Строка];
		Если ТекущийНомер=Неопределено Тогда
			Возврат Ложь;
		КонецЕсли; 
	КонецЕсли;
	
	Если НовыйНомер < 1 Тогда
		НовыйНомер = 1;
	КонецЕсли;
	
	Если НовыйНомер > Таблица.Строки.Количество()+1 Тогда
		НовыйНомер = Таблица.Строки.Количество()+1;
	КонецЕсли;
	
	Если ТекущийНомер=НовыйНомер Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Таблица.Строки.Вставить(НовыйНомер-1, Строка);
	
	Если НовыйНомер < ТекущийНомер Тогда
		// так исходная строка сдвинулась вперед после вставки
		ТекущийНомер = ТекущийНомер + 1;
	КонецЕсли; 
	Таблица.Строки.Удалить(ТекущийНомер-1);
	
	ПеренумероватьСтрокиКвазиТаблицыЗначений(Таблица);
	
	Возврат Истина;
	
КонецФункции

Функция УпорядочитьСтрокиКвазиТаблицыЗначенийПоМассиву(Таблица, МассивСтрок)
	
	НомераИСтроки = Таблица.НумерацияСтрок.НомераИСтроки;
	Строки = Таблица.Строки;
	НомерСтроки = 1;
	Для Каждого Строка Из МассивСтрок Цикл
		ТекущийНомер = НомераИСтроки[Строка];
		Если ТекущийНомер=Неопределено Тогда
			// не принадлежит коллекции
			Продолжить;
		КонецЕсли;
		
		Если НомерСтроки=ТекущийНомер Тогда
			// уже упорядочена
			НомерСтроки = НомерСтроки + 1;
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока = НомераИСтроки[НомерСтроки];
		НомераИСтроки[ТекущийНомер] = ТекущаяСтрока;
		НомераИСтроки[ТекущаяСтрока] = ТекущийНомер;
		Строки[ТекущийНомер-1] = ТекущаяСтрока;
		
		НомераИСтроки[НомерСтроки] = Строка;
		НомераИСтроки[Строка] = НомерСтроки;
		Строки[НомерСтроки-1] = Строка;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ДобавитьСтрокиКвазиТаблицыЗначений(Таблица, Коллекция) Экспорт
	
	НовыеСтроки = Новый Массив;
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		МассивСтрок = Коллекция.Строки;
	Иначе
		МассивСтрок = Коллекция;
	КонецЕсли; 
	
	Для Каждого Строка Из МассивСтрок Цикл
		НоваяСтрока = ДобавитьСтрокуКвазиТаблицыЗначений(Таблица);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НовыеСтроки.Добавить(НоваяСтрока);
	КонецЦикла; 
	
	ИндексироватьСтрокиКвазиТаблицы(Таблица, НовыеСтроки);
	
КонецФункции

Функция НайтиСтрокиКвазиТаблицыЗначений(Таблица, Отбор, Упорядочить=Истина) Экспорт
	
	ОтборБезИндекса = Неопределено;
	НайденныеСтроки = НайтиСтрокиКвазиТаблицыЗначенийПоИндексу(Таблица, Отбор, ОтборБезИндекса, Упорядочить);
	Если НайденныеСтроки = Неопределено Тогда
		НайденныеСтроки = Таблица.Строки;
		ОтборБезИндекса = Отбор;
	Иначе
		Если ОтборБезИндекса.Количество() = 0 Тогда
			Возврат НайденныеСтроки;
		КонецЕсли; 
	КонецЕсли; 
	
	НайденныеСтроки = НайтиЭлементыКоллекции(НайденныеСтроки, ОтборБезИндекса);
	Возврат НайденныеСтроки;
	
КонецФункции

Функция НайтиСтрокуКвазиТаблицыЗначений(Таблица, ИмяРеквизита, ЗначениеРеквизита) Экспорт
	НайденныеСтроки = НайтиСтрокиКвазиТаблицыЗначений(Таблица, Новый Структура(ИмяРеквизита, ЗначениеРеквизита));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0];
	КонецЕсли;
КонецФункции

Функция ОчиститьИндексыСтрокКвазиТаблицы(Таблица, Строки)
	
	МенеджерИндексирования_ОчиститьИндексыСтрок(Таблица.МенеджерИндексирования, Строки);
	
КонецФункции

Функция УдалитьНумерациюСтрокКвазиТаблицыЗначений(Таблица, Строки)
	НомераИСтроки = Таблица.НумерацияСтрок.НомераИСтроки;
	Для каждого Строка Из Строки Цикл
		НомерСтроки = НомераИСтроки[Строка];
		НомераИСтроки.Удалить(Строка);
		НомераИСтроки.Удалить(НомерСтроки);
	КонецЦикла;
КонецФункции

Функция УдалитьСтрокиКвазиТаблицыЗначений(Таблица, знач Строки=Неопределено) Экспорт
	Если Строки = Неопределено Тогда
		Строки = Таблица.Строки;
	Иначе
		Строки = ЗначениеВМассив(Строки);
	КонецЕсли; 
	ОчиститьИндексыСтрокКвазиТаблицы(Таблица, Строки);
	Если Таблица.Строки=Строки Тогда
		Таблица.Строки.Очистить();
		Таблица.НумерацияСтрок.НомераИСтроки.Очистить();
		Таблица.НумерацияСтрок.ТекущийНомер = 1;
	Иначе
		УдалитьЭлементыКоллекции(Таблица.Строки, Строки);
		УдалитьНумерациюСтрокКвазиТаблицыЗначений(Таблица, Строки);
	КонецЕсли; 
КонецФункции

Функция НомерЭлементаКвазиТаблицыЗначений(Таблица, Элемент) Экспорт
	
	Возврат Таблица.НумерацияСтрок.НомераИСтроки[Элемент];
	
КонецФункции

Функция АгрегироватьЗначенияПолейГруппировкиСумма(СтрокаИтогов, СтрокиЗначений, МассивПолей)
	
	Для Каждого Поле Из МассивПолей Цикл
		Сумма = 0;
		Значение = СтрокаИтогов[Поле];
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Сумма = Сумма + СтрокаИтогов[Поле];
		КонецЕсли;
		Для Каждого СтрокаЗначения Из СтрокиЗначений Цикл
			Значение = СтрокаЗначения[Поле];
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Сумма = Сумма + СтрокаЗначения[Поле];
			КонецЕсли; 
		КонецЦикла; 
		СтрокаИтогов[Поле] = Сумма;
	КонецЦикла;
	
КонецФункции

Функция АгрегироватьЗначенияПолейГруппировкиСписокЗначений(СтрокаИтогов, СтрокиЗначений, МассивПолей)
	
	Для Каждого Поле Из МассивПолей Цикл
		СписокЗначений = Новый СписокЗначений;
		СписокЗначений.Добавить(СтрокаИтогов[Поле]);
		Для Каждого СтрокаЗначения Из СтрокиЗначений Цикл
			СписокЗначений.Добавить(СтрокаЗначения[Поле]);
		КонецЦикла; 
		СтрокаИтогов[Поле] = СписокЗначений;
	КонецЦикла;
	
КонецФункции

Функция АгрегироватьЗначенияПолейГруппировкиМассив(СтрокаИтогов, СтрокиЗначений, МассивПолей)
	
	Для Каждого Поле Из МассивПолей Цикл
		Массив = Новый Массив;
		Массив.Добавить(СтрокаИтогов[Поле]);
		Для Каждого СтрокаЗначения Из СтрокиЗначений Цикл
			Массив.Добавить(СтрокаЗначения[Поле]);
		КонецЦикла; 
		СтрокаИтогов[Поле] = Массив;
	КонецЦикла;
	
КонецФункции

Функция АгрегироватьЗначенияПолейГруппировкиСтрока(СтрокаИтогов, СтрокиЗначений, МассивПолей)
	
	Для Каждого Поле Из МассивПолей Цикл
		Массив = Новый Массив;
		Массив.Добавить(СтрокаИтогов[Поле]);
		Для Каждого СтрокаЗначения Из СтрокиЗначений Цикл
			Массив.Добавить(СтрокаЗначения[Поле]);
		КонецЦикла; 
		СтрокаИтогов[Поле] = МассивВСтроку(Массив);
	КонецЦикла;
	
КонецФункции

Функция СвернутьКоллекциюЗначений(знач Коллекция, знач ПоляГруппировки=Неопределено, знач ПоляСуммы=Неопределено, АгрегатнаяФункция=Неопределено) Экспорт
	
	Если ПоляСуммы = Неопределено Тогда
		МассивПолейСуммы = Новый Массив;
	Иначе
		МассивПолейСуммы = ЗначениеВМассив(ПоляСуммы);
	КонецЕсли; 
	
	ЭтоКвазиТаблицаЗначений = ЭтоКвазиТаблицаЗначений(Коллекция);

	Если ПоляГруппировки = Неопределено Тогда
		Если ЭтоКвазиТаблицаЗначений Тогда
			МассивКолонок = ВыгрузитьЗначенияКолонкиКоллекции(Коллекция.Колонки, "Значение");
			МассивПолейГруппировки = ВыгрузитьЗначенияКолонкиКоллекции(МассивКолонок, "Имя");
		ИначеЕсли ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда 
			МассивПолейГруппировки = ВыгрузитьЗначенияКолонкиКоллекции(Коллекция.Колонки, "Имя");
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		МассивПолейГруппировки = ЗначениеВМассив(ПоляГруппировки);
	КонецЕсли;
	
	Если ЭтоКвазиТаблицаЗначений Тогда
		Строки = Коллекция.Строки;
	Иначе
		Строки = Коллекция;
	КонецЕсли; 
	
	ВычестьМассив(МассивПолейГруппировки, МассивПолейСуммы);
	
	ПоляГруппировки = МассивВСтроку(МассивПолейГруппировки);
	Отбор = Новый Структура(ПоляГруппировки);
	Индекс = 0;
	Для Каждого Строка Из Строки Цикл
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		Если ЭтоКвазиТаблицаЗначений Тогда
			НайденныеСтроки = НайтиСтрокиКвазиТаблицыЗначений(Коллекция, Отбор, Ложь);
		Иначе
			НайденныеСтроки = НайтиЭлементыКоллекции(Строки, Отбор);
		КонецЕсли;
		
		ИндексСтроки = НайденныеСтроки.Найти(Строка);
		Если ИндексСтроки <> Неопределено Тогда
			НайденныеСтроки.Удалить(ИндексСтроки);
		КонецЕсли;
		
		Если МассивПолейСуммы.Количество() > 0 Тогда
			Если АгрегатнаяФункция = "СписокЗначений" Тогда
				АгрегироватьЗначенияПолейГруппировкиСписокЗначений(Строка, НайденныеСтроки, МассивПолейСуммы);
			ИначеЕсли АгрегатнаяФункция = "Массив" Тогда
				АгрегироватьЗначенияПолейГруппировкиМассив(Строка, НайденныеСтроки, МассивПолейСуммы);
			ИначеЕсли АгрегатнаяФункция = "Строка" Тогда
				АгрегироватьЗначенияПолейГруппировкиСтрока(Строка, НайденныеСтроки, МассивПолейСуммы);
			Иначе
				АгрегироватьЗначенияПолейГруппировкиСумма(Строка, НайденныеСтроки, МассивПолейСуммы);
			КонецЕсли; 
		КонецЕсли;
		
		Если ЭтоКвазиТаблицаЗначений Тогда
			УдалитьСтрокиКвазиТаблицыЗначений(Коллекция, НайденныеСтроки);
		Иначе
			УдалитьЭлементыКоллекции(Строки, НайденныеСтроки);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СвернутьТаблицуЗначений(Коллекция, знач ПоляГруппировки=Неопределено, знач ПоляСуммы=Неопределено) Экспорт

	Если ПоляСуммы = Неопределено Тогда
		МассивПолейСуммы = Новый Массив;
	Иначе
		МассивПолейСуммы = ЗначениеВМассив(ПоляСуммы);
	КонецЕсли; 
	
	Если ПоляГруппировки = Неопределено Тогда
		МассивПолейГруппировки = ВыгрузитьЗначенияКолонкиКоллекции(Коллекция.Колонки, "Имя");
	Иначе
		МассивПолейГруппировки = ЗначениеВМассив(ПоляГруппировки);
	КонецЕсли;
	
	ВычестьМассив(МассивПолейГруппировки, МассивПолейСуммы);
	
	ПоляГруппировки = МассивВСтроку(МассивПолейГруппировки);
	ПоляСуммы = МассивВСтроку(МассивПолейСуммы);
	Коллекция.Свернуть(ПоляГруппировки, ПоляСуммы);

КонецФункции

Функция ЗаполнитьЗначенияКоллекции(Коллекция, Значение, Поля=Неопределено) Экспорт
	
	ЭтоКвазиТаблицаЗначений = ЭтоКвазиТаблицаЗначений(Коллекция);
	Если ЭтоКвазиТаблицаЗначений Тогда
		МассивСтрок = Коллекция.Строки;
	Иначе
		МассивСтрок = Коллекция;
	КонецЕсли;
	
	Если Поля <> Неопределено Тогда
		ПоляМассив = ЗначениеВМассив(Поля, , Ложь);
	Иначе
		Если ЭтоКвазиТаблицаЗначений Тогда
			ПоляМассив = ВыгрузитьЗначенияКолонкиКоллекции(Коллекция.Колонки, "Имя");
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураЗначений = Новый Структура;
	Для Каждого Поле Из ПоляМассив Цикл
		СтруктураЗначений.Вставить(Поле, Значение);
	КонецЦикла;
	
	Для Каждого Строка Из МассивСтрок Цикл
		ЗаполнитьЗначенияСвойств(Строка, СтруктураЗначений);
	КонецЦикла;
	
	Если ЭтоКвазиТаблицаЗначений Тогда
		ИндексироватьКвазиТаблицу(Коллекция);
	КонецЕсли;
	
КонецФункции

Функция УдалитьКолонкуКвазиТаблицы(Таблица, ИмяКолонки) Экспорт
	
	Таблица.Колонки.Удалить(ИмяКолонки);
	Для Каждого Строка Из Таблица.Строки Цикл
		Строка.Удалить(ИмяКолонки);
	КонецЦикла;
	
	СистемыИндексирования = Таблица.МенеджерИндексирования.СистемыИндексирования;
	МассивИндексов = ВыгрузитьЗначенияКолонокКоллекции(СистемыИндексирования, "Значение");
	Для Каждого Индекс Из МассивИндексов Цикл
		НомерПоля = Индекс.ПоляИндексированияМассив.Найти(ИмяКолонки);
		Если НомерПоля <> Неопределено Тогда
			СистемыИндексирования.Удалить(Индекс.ПоляИндексирования);
			ОчиститьСистемуИндексирования(Индекс);
			Если Индекс.ПоляИндексированияМассив.Количество() > 1 Тогда
				Индекс.ПоляИндексированияМассив.Удалить(НомерПоля);
				Индекс.ПоляИндексирования = МассивВСтроку(Индекс.ПоляИндексированияМассив);
				ИндексироватьЭлементыКоллекции(Индекс, Таблица.Строки);
				СистемыИндексирования[Индекс.ПоляИндексирования] = Индекс;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецФункции

Функция ПереименоватьКолонкуКвазиТаблицыЗначений(Таблица, ИмяКолонки, НовоеИмяКолонки) Экспорт
	
	Если ИмяКолонки=НовоеИмяКолонки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеКолонки = Таблица.Колонки[ИмяКолонки];
	ОписаниеКолонки.Имя = НовоеИмяКолонки;
	Таблица.Колонки.Вставить(НовоеИмяКолонки, ОписаниеКолонки);
	Таблица.Колонки.Удалить(ИмяКолонки);
	Для Каждого Строка Из Таблица.Строки Цикл
		Строка.Вставить(НовоеИмяКолонки, Строка[ИмяКолонки]);
		Строка.Удалить(ИмяКолонки);
	КонецЦикла;
	
	МассивИндексов = ВыгрузитьЗначенияКолонокКоллекции(Таблица.МенеджерИндексирования.СистемыИндексирования, "Значение");
	Для Каждого Индекс Из МассивИндексов Цикл
		НомерПоля = Индекс.ПоляИндексированияМассив.Найти(ИмяКолонки);
		Если НомерПоля <> Неопределено Тогда
			Таблица.МенеджерИндексирования.СистемыИндексирования.Удалить(Индекс.ПоляИндексирования);
			Индекс.ПоляИндексированияМассив[НомерПоля] = НовоеИмяКолонки;
			Индекс.ПоляИндексирования = МассивВСтроку(Индекс.ПоляИндексированияМассив);
			Таблица.МенеджерИндексирования.СистемыИндексирования[Индекс.ПоляИндексирования] = Индекс;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ДополнитьКолонкиКвазиТаблицыЗначений(Таблица, СписокКолонок) Экспорт
	Если СписокКолонок <> Неопределено И ЗначениеЗаполнено(СписокКолонок) Тогда
		МассивКолонок = ЗначениеВМассив(СписокКолонок, , Ложь);
		Для Каждого ИмяКолонки Из МассивКолонок Цикл
			Если Не Таблица.Колонки.Свойство(ИмяКолонки) Тогда
				ДобавитьКолонкуКвазиТаблицыЗначений(Таблица, ИмяКолонки);
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли; 
КонецФункции

