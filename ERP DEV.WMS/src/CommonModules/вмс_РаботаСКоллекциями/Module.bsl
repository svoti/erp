Функция ПолучитьУдостоверениеКвазиСсылки()
	
	Возврат вмс_Обмен_с_КИС_КлиентСервер.ПолучитьУдостоверениеКвазиСсылки();
	
КонецФункции

#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
Функция ПреобразоватьТаблицыЗначенийВКвазиТаблицыЗначенийВДанных(Данные) Экспорт
	
	Если ТипЗнч(Данные) = Тип("ТаблицаЗначений") Тогда
		МассивЗначений = Новый Массив;
		МассивЗначений.Добавить(Данные);
		МассивСсылокНаЗначения = РазложитьСтруктуруДанныхВМассивСсылокНаЗначения(МассивЗначений);
	Иначе
		МассивСсылокНаЗначения = РазложитьСтруктуруДанныхВМассивСсылокНаЗначения(Данные);
	КонецЕсли;
	
	МассивСсылокНаТаблицыЗначений = Новый Массив;
	Для Каждого СсылкаНаЗначение Из МассивСсылокНаЗначения Цикл
		Если ТипЗнч(СсылкаНаЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
			МассивСсылокНаТаблицыЗначений.Добавить(СсылкаНаЗначение);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСсылокНаТаблицыЗначений.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли; 
	
	РазтипизироватьКолонкиТаблицЗначенийВМассивеСсылокНаЗначения(МассивСсылокНаТаблицыЗначений);
	РазвернутьЭлементыМассива(МассивСсылокНаТаблицыЗначений); //сначала преобразуем вложенные таблицы, иначе ссылки на значения станут невалидными
	
	Для Каждого СсылкаНаТаблицуЗначений Из МассивСсылокНаТаблицыЗначений Цикл
		КвазиТаблицаЗначений = НоваяКвазиТаблицаЗначений(СсылкаНаТаблицуЗначений.Значение);
		УстановитьЗначениеПоСсылкеНаЗначение(СсылкаНаТаблицуЗначений, КвазиТаблицаЗначений);
	КонецЦикла;
	
	Если ТипЗнч(Данные) = Тип("ТаблицаЗначений") Тогда
		Данные = МассивЗначений[0];
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьКолонкиТаблицЗначенийВМассивеСсылокНаЗначения(МассивСсылокНаЗначения) Экспорт
	
	СписокТаблиц = Новый Соответствие;
	
	Для Каждого СсылкаНаЗначение Из МассивСсылокНаЗначения Цикл
		Если ТипЗнч(СсылкаНаЗначение.Коллекция) = Тип("СтрокаТаблицыЗначений") Тогда
			Таблица = СсылкаНаЗначение.Коллекция.Владелец();
			КолонкаТаблицы = Таблица.Колонки[СсылкаНаЗначение.ИмяПоля];
			
			КолонкиТаблицы = СписокТаблиц[Таблица];
			Если КолонкиТаблицы = Неопределено Тогда
				КолонкиТаблицы = Новый Соответствие;
				СписокТаблиц[Таблица] = КолонкиТаблицы;
			КонецЕсли;
			
			КолонкиТаблицы[СсылкаНаЗначение.ИмяПоля] = КолонкаТаблицы;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокТаблиц;
	
КонецФункции


Функция РазтипизироватьКолонкиТаблицЗначений(СписокТаблиц) Экспорт
	
	Для Каждого ЭлементКолонкиТаблицы Из СписокТаблиц Цикл
		Таблица = ЭлементКолонкиТаблицы.Ключ;
		КолонкиТаблицы = ЭлементКолонкиТаблицы.Значение;
		Для Каждого ЭлементКолонкаТаблицы Из КолонкиТаблицы Цикл
			ИмяКолонки = ЭлементКолонкаТаблицы.Ключ;
			ИзменитьТипКолонкиТаблицыЗначений(Таблица, ИмяКолонки, Неопределено);
		КонецЦикла;
	КонецЦикла;
	
КонецФункции

Функция ТипизироватьТаблицуЗначений(Таблица, Колонки=Неопределено) Экспорт
	
	Если Колонки = Неопределено Тогда
		МассивКолонок = ПолучитьКолонкиКоллекции(Таблица);
	Иначе
		МассивКолонок = ЗначениеВМассив(Колонки);
	КонецЕсли;
	
	ТипНеопределено = Тип("Неопределено");
	ТипNull = Тип("Null");
	ТипСтрока = Тип("Строка");
	ТипПоУмолчанию = ТипСтрока;
	
	Для Каждого ИмяКолонки Из МассивКолонок Цикл
		
		Колонка = Таблица.Колонки[ИмяКолонки];
		ТипыКолонки = Колонка.ТипЗначения.Типы();
		Если ТипыКолонки.Количество() > 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипыКолонки.Количество() = 1 Тогда
			Если ТипыКолонки[0] <> ТипNull Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ЕстьТипНеопределено = Ложь;
		ЗарегистрированныеТипы = Новый Соответствие;
		ТипыКолонки = Новый Массив;
		ЗначенияКолонки = Новый Массив;
		МаксимальнаяДлинаСтроки = 0;
		
		// проанализируем значения колонки
		Для Каждого Строка Из Таблица Цикл
			Значение = Строка[ИмяКолонки];
			ТипЗначения = ТипЗнч(Значение);
			Если ТипЗначения = ТипНеопределено Тогда
				ЕстьТипНеопределено = Истина;
			ИначеЕсли ЗарегистрированныеТипы[ТипЗначения] <> Истина Тогда
				ЗарегистрированныеТипы[ТипЗначения] = Истина;
				ТипыКолонки.Добавить(ТипЗначения);
			КонецЕсли;
			
			Если ТипЗначения=ТипСтрока Тогда
				ДлинаСтроки = СтрДлина(Значение) + 1;
				Если МаксимальнаяДлинаСтроки < ДлинаСтроки Тогда
					МаксимальнаяДлинаСтроки = ДлинаСтроки;
				КонецЕсли;
			КонецЕсли;
			ЗначенияКолонки.Добавить(Значение);
		КонецЦикла;
		
		Если ТипыКолонки.Количество()=0 Тогда
			// нету ни одного типа, добавим "Строку" по умолчанию
			ТипыКолонки.Добавить(ТипПоУмолчанию);
			
			Если ЕстьТипНеопределено Тогда
				// Чтобы в колонке можно было хранить "Неопределено" требуется составной тип (минимум из 2-х типов)
				// так что добавим еще "Null"
				ТипыКолонки.Добавить(ТипNull);
			КонецЕсли;
			МаксимальнаяДлинаСтроки = 1;
		ИначеЕсли ТипыКолонки.Количество()=1 Тогда
			Если ТипыКолонки[0]=ТипNull Тогда
				// Тип не может состоять только из "Null",
				// запрос не хавает такое
				// добавим еще "Строку"
				ТипыКолонки.Добавить(ТипПоУмолчанию);
			ИначеЕсли ЕстьТипНеопределено Тогда
				// Чтобы в колонке можно было хранить "Неопределено" требуется составной тип (минимум из 2-х типов)
				ТипыКолонки.Добавить(ТипNull);
			КонецЕсли;
		КонецЕсли;
		
		НовыйТипЗначенияКолонки = Новый ОписаниеТипов(ТипыКолонки, , Новый КвалификаторыСтроки(МаксимальнаяДлинаСтроки));
		ИндексКолонки = Таблица.Колонки.Индекс(Колонка);
		Заголовок = Колонка.Заголовок;
		Если Таблица.Колонки.Количество()=1 Тогда
			// Если колонка одна, то при ее удалении удалятся также и строки таблицы
			// поэтому сначала добавим новую колонку
			НовоеИмяСтаройКолонки = ИмяКолонки + "_";
			Колонка.Имя = НовоеИмяСтаройКолонки;
			Таблица.Колонки.Вставить(ИндексКолонки, ИмяКолонки, НовыйТипЗначенияКолонки, Заголовок);
			Таблица.Колонки.Удалить(НовоеИмяСтаройКолонки);
		Иначе
			Таблица.Колонки.Удалить(ИмяКолонки);
			Таблица.Колонки.Вставить(ИндексКолонки, ИмяКолонки, НовыйТипЗначенияКолонки, Заголовок);
		КонецЕсли;
		
		Таблица.ЗагрузитьКолонку(ЗначенияКолонки, ИмяКолонки);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция РазтипизироватьТаблицуЗначений(Таблица, Колонки=Неопределено) Экспорт
	
	Если Колонки = Неопределено Тогда
		МассивКолонок = ПолучитьКолонкиКоллекции(Таблица);
	Иначе
		МассивКолонок = ЗначениеВМассив(Колонки);
	КонецЕсли;
	
	Результат = Ложь;
	Колонки = Таблица.Колонки;
	Для Каждого Имя Из МассивКолонок Цикл
		Колонка = Колонки[Имя];
		Если Колонка.ТипЗначения.Типы().Количество() = 0 Тогда
			// уже разтипизирована
			Продолжить;
		КонецЕсли;
		
		Имя = Колонка.Имя;
		Индекс = Колонки.Индекс(Колонка);
		Значения = Таблица.ВыгрузитьКолонку(Имя);
		Заголовок = Колонка.Заголовок;
		
		Если Колонки.Количество() = 1 Тогда
			// Сначала добавим новую, потом старую удалим
			// иначе удалятся строки таблицы
			НовоеИмяСтаройКолонки = Имя + "_";
			Колонка.Имя = НовоеИмяСтаройКолонки;
			Колонки.Вставить(Индекс, Имя, , Заголовок);
			Колонки.Удалить(НовоеИмяСтаройКолонки);
		Иначе
			Колонки.Удалить(Имя);
			Колонки.Вставить(Индекс, Имя, , Заголовок);
		КонецЕсли;
		
		Таблица.ЗагрузитьКолонку(Значения, Имя);
		Результат = Истина;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


Функция РазтипизироватьКолонкиТаблицЗначенийВМассивеСсылокНаЗначения(МассивСсылокНаЗначения) Экспорт
	
	Возврат РазтипизироватьКолонкиТаблицЗначений(ПолучитьКолонкиТаблицЗначенийВМассивеСсылокНаЗначения(МассивСсылокНаЗначения));
	
КонецФункции

Функция МассивОбъектовВМассивИменТипов(МассивОбъектов) Экспорт
	Индекс = Новый Соответствие;
	МассивИменТипов = Новый Массив;
	Для Каждого Объект Из МассивОбъектов Цикл
		ТипОбъекта = ТипЗнч(Объект);
		Если Индекс[ТипОбъекта] = Неопределено Тогда
			Индекс[ТипОбъекта] = Истина;
			МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипОбъекта);
			Если МетаданныеОбъекта <> Неопределено Тогда
				МассивИменТипов.Добавить(МетаданныеОбъекта.ПолноеИмя());
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла;
	Возврат МассивИменТипов;
КонецФункции

Процедура ДобавитьКолонкиВТаблицуЗначенийПоСсылке(ОпрошенныеТипы, Ссылка, ТаблицаДокументов) Экспорт
	
	ОпрошенныеТипы.Добавить(ТипЗнч(Ссылка));
	пМетаданные = Ссылка.Метаданные();
	
	Если пМетаданные.Реквизиты.Найти("Склад") <> Неопределено
		И ТаблицаДокументов.Колонки.Найти("Склад") = Неопределено Тогда
		ТаблицаДокументов.Колонки.Добавить("Склад");
	КонецЕсли;
	
	Если пМетаданные.Реквизиты.Найти("Дата") <> Неопределено 
		И ТаблицаДокументов.Колонки.Найти("Дата") = Неопределено Тогда
		ТаблицаДокументов.Колонки.Добавить("Дата");
	КонецЕсли;
	
	Если пМетаданные.Реквизиты.Найти("Номер") <> Неопределено 
		И ТаблицаДокументов.Колонки.Найти("Номер") = Неопределено Тогда
		ТаблицаДокументов.Колонки.Добавить("Номер");
	КонецЕсли;  
	
	Если пМетаданные.Реквизиты.Найти("Контрагент") <> Неопределено 
		И ТаблицаДокументов.Колонки.Найти("Контрагент") = Неопределено Тогда
		ТаблицаДокументов.Колонки.Добавить("Контрагент");
	КонецЕсли;
	
	Если пМетаданные.Реквизиты.Найти("Комментарий") <> Неопределено
		И ТаблицаДокументов.Колонки.Найти("Комментарий") = Неопределено Тогда
		ТаблицаДокументов.Колонки.Добавить("Комментарий");
	КонецЕсли;   
	
	//ИмяТабличнойЧасти = вмс_АдаптацияКонфигураций.ПолучитьИмяТабличнойЧасти();
	// ТУ_Мовчан 12.12.23 ++
	ИменаТабличныхЧастей = вмс_АдаптацияКонфигураций.ПолучитьИмяТабличнойЧасти();
	Если Тип("Массив") = ТипЗнч(ИменаТабличныхЧастей) Тогда 
		Для каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
			ЕстьТабличнаяЧасть = пМетаданные.ТабличныеЧасти.Найти(ИмяТабличнойЧасти) <> Неопределено;
			Прервать;
		КонецЦикла;
	Иначе  
		ЕстьТабличнаяЧасть = пМетаданные.ТабличныеЧасти.Найти(ИменаТабличныхЧастей) <> Неопределено;	
	КонецЕсли;
	Если ЕстьТабличнаяЧасть Тогда	
		// ТУ_Мовчан 12.12.23 --
		//Если пМетаданные.ТабличныеЧасти.Найти(ИмяТабличнойЧасти) <> Неопределено Тогда
		
		Если ТаблицаДокументов.Колонки.Найти("КоличествоСтрок") = Неопределено Тогда
			ТаблицаДокументов.Колонки.Добавить("КоличествоСтрок");
		КонецЕсли;
		
		Если ТаблицаДокументов.Колонки.Найти("Количество") = Неопределено Тогда
			ТаблицаДокументов.Колонки.Добавить("Количество");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
#КонецЕсли

&НаКлиенте
Функция ВосстановитьКвазиТаблицыЗначенийВДанных(Данные) Экспорт
	
	МассивЗначений = Новый Массив;
	МассивЗначений.Добавить(Данные);
	МассивСсылокНаЗначения = РазложитьСтруктуруДанныхВМассивСсылокНаЗначения(МассивЗначений, Истина);
	
	Для Каждого СсылкаНаЗначение Из МассивСсылокНаЗначения Цикл
		Если ЭтоКвазиТаблицаЗначений(СсылкаНаЗначение.Значение) Тогда
			ВосстановитьКвазиТаблицуЗначений(СсылкаНаЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция ПреобразоватьКоллекциюВСоответствие(Коллекция, КолонкаКлюча, КолонкаЗначения) Экспорт
	
	Соответствие = Новый Соответствие;
	
	Для Каждого ЭлементКоллекции Из Коллекция Цикл
		Соответствие[ЭлементКоллекции[КолонкаКлюча]] = ЭлементКоллекции[КолонкаЗначения];
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция ПреобразоватьМассивВСоответствие(Массив, Значение=Истина) Экспорт
	
	Соответствие = Новый Соответствие;
	
	Для Каждого ЭлементКоллекции Из Массив Цикл
		Соответствие[ЭлементКоллекции] = Значение;
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция ЗаменитьЗначенияВМассивеСсылокНаЗначения(МассивСсылокНаЗначения, НовыеЗначения) Экспорт
	
	Для Каждого СсылкаНаЗначение Из МассивСсылокНаЗначения Цикл
		СсылкаНаЗначение.Значение = НовыеЗначения[СсылкаНаЗначение.Значение];
		СсылкаНаЗначение.Коллекция[СсылкаНаЗначение.ИмяПоля] = СсылкаНаЗначение.Значение;
	КонецЦикла;
	
КонецФункции

Функция ПолучитьИмяНовогоЭлементаКоллекции(ЖелаемоеИмя, Коллекция, Реквизит="Имя") Экспорт
	
	Отбор = Новый Структура(Реквизит);
	СвободноеИмя = ЖелаемоеИмя;
	
	Если Реквизит="Имя" Тогда
		ТипыСМетодомНайти = Новый Массив;
		ТипыСМетодомНайти.Добавить(Тип("ВсеЭлементыФормы"));
		ТипыСМетодомНайти.Добавить(Тип("КомандыФормы"));
		#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
			ТипыСМетодомНайти.Добавить(Тип("КоллекцияКолонокТаблицыЗначений"));
		#КонецЕсли
		ИспользоватьМетодНайти = ТипыСМетодомНайти.Найти(ТипЗнч(Коллекция)) <> Неопределено;
	Иначе
		ИспользоватьМетодНайти = Ложь;
	КонецЕсли;
	
	Номер = 1;
	Пока Истина Цикл
		Если ИспользоватьМетодНайти Тогда
			Элемент = Коллекция.Найти(СвободноеИмя);
		Иначе
			Отбор[Реквизит] = СвободноеИмя;
			Элемент = НайтиЭлементКоллекции(Коллекция, Отбор);
		КонецЕсли;
		
		Если Элемент = Неопределено Тогда
			Возврат СвободноеИмя;
		КонецЕсли;
		
		Номер = Номер + 1;
		НомерСтрокой = Формат(Номер, "ЧГ=0");
		СвободноеИмя = ЖелаемоеИмя + НомерСтрокой;
	КонецЦикла; 
	
КонецФункции

Функция РаспределитьРесурсыКоллекции(Коллекция, КоллекцияРесурсов, КолонкаПоказатель, КолонкаРесурс, знач ПоляПоиска, знач ПоляЗаполнения=Неопределено) Экспорт
	
	Если ТипЗнч(ПоляПоиска) = Тип("Строка") Тогда
		ПоляПоискаМассив = ЗначениеВМассив(ПоляПоиска, , Ложь);
	ИначеЕсли ТипЗнч(ПоляПоиска) = Тип("Массив") Тогда
		ПоляПоискаМассив = ПоляПоиска;
		ПоляПоиска = МассивВСтроку(ПоляПоискаМассив);
	Иначе
		ПоляПоискаМассив = Новый Массив;
		ПоляПоиска = "";
	КонецЕсли;

	Если ТипЗнч(ПоляЗаполнения) = Тип("Строка") Тогда
		ПоляЗаполненияМассив = ЗначениеВМассив(ПоляЗаполнения, , Ложь);
	ИначеЕсли ТипЗнч(ПоляЗаполнения) = Тип("Массив") Тогда
		ПоляЗаполненияМассив = ПоляЗаполнения;
		ПоляЗаполнения = МассивВСтроку(ПоляЗаполненияМассив);
	Иначе
		ПоляЗаполненияМассив = Новый Массив;
		ПоляЗаполнения = "";
	КонецЕсли;
	
	КолонкиМассив = ПолучитьКолонкиКоллекции(Коллекция);
	ДобавитьЭлементыКоллекции(КолонкиМассив, ПоляЗаполнения);
	УдалитьДублиВМассиве(КолонкиМассив);
	Если ЭтоТаблицаЗначений(Коллекция) Тогда
		КоллекцияРезультат = НоваяТаблицаЗначений(КолонкиМассив, Коллекция);
	Иначе
		КоллекцияРезультат = НоваяКвазиТаблицаЗначений(КолонкиМассив);
	КонецЕсли;

	Элементы = ПолучитьЭлементыКоллекции(Коллекция);
	
	ОтборРесурсов = Новый Структура(ПоляПоиска);
	СтруктураЗаполнения = Новый Структура(ПоляЗаполнения);
	СтруктураЗаполнения.Вставить(КолонкаПоказатель);
	
	Для Каждого Элемент Из Элементы Цикл
		
		КоличествоТребуемое = Элемент[КолонкаПоказатель];
		Если КоличествоТребуемое > 0 Тогда
			ЗаполнитьЗначенияСвойств(ОтборРесурсов, Элемент, ПоляПоиска);
			ЭлементыРесурсов = НайтиЭлементыКоллекции(КоллекцияРесурсов, ОтборРесурсов);
			Для Каждого ЭлементРесурса Из ЭлементыРесурсов Цикл
				КоличествоРесурс = ЭлементРесурса[КолонкаРесурс];
				КоличествоЗабрать = Макс(Мин(КоличествоРесурс, КоличествоТребуемое), 0);
				Если КоличествоЗабрать = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НовыйЭлемент = НовыйЭлементКоллекции(КоллекцияРезультат);
				ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элемент);
				ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, ЭлементРесурса, ПоляЗаполнения);
				СтруктураЗаполнения[КолонкаПоказатель] = КоличествоЗабрать;
				СтруктураЗаполнения[КолонкаРесурс] = КоличествоЗабрать;
				ЗаполнитьЗначенияСвойств(НовыйЭлемент, СтруктураЗаполнения);
				
				КоличествоТребуемое = КоличествоТребуемое - КоличествоЗабрать;
				ЭлементРесурса[КолонкаРесурс] = ЭлементРесурса[КолонкаРесурс] - КоличествоЗабрать;
			КонецЦикла;
			
			Если КоличествоТребуемое > 0 Тогда
				НовыйЭлемент = НовыйЭлементКоллекции(КоллекцияРезультат);
				ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элемент);
				НовыйЭлемент[КолонкаПоказатель] = КоличествоТребуемое;
			КонецЕсли; 
		Иначе
			НовыйЭлемент = НовыйЭлементКоллекции(КоллекцияРезультат);
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элемент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КоллекцияРезультат;
	
КонецФункции

Функция ПреобразоватьИерархическуюКоллекциюВПлоскую(Коллекция, ПолеИерархии, МаксУровень=-1) Экспорт

	ПлоскаяКоллекция = Новый Массив;

	ДобавленныеЭлементы = Новый Соответствие;
	ЭлементыДляОбхода = Новый Массив;
	
	Для Каждого Элемент Из Коллекция Цикл
		ПлоскаяКоллекция.Добавить(Элемент);
		ЭлементыДляОбхода.Добавить(Элемент);
		ДобавленныеЭлементы[Элемент] = Истина;
	КонецЦикла;
	
	Уровень = 0;
	Пока ЭлементыДляОбхода.Количество() > 0 Цикл
		ЭлементыДляОбхода2 = Новый Массив;
		Для Каждого Элемент Из ЭлементыДляОбхода Цикл
			СтруктураЗаполнения = Новый Структура(ПолеИерархии);
			ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, Элемент);
			ПодчиненнаяКоллекция = СтруктураЗаполнения[ПолеИерархии];
			Если ПодчиненнаяКоллекция <> Неопределено Тогда
				Для Каждого ПодЭлемент Из ПодчиненнаяКоллекция Цикл
					Если ДобавленныеЭлементы[ПодЭлемент] = Истина Тогда
						ТочкаОстановы = 0;
					Иначе
						ПлоскаяКоллекция.Добавить(ПодЭлемент);
						ЭлементыДляОбхода2.Добавить(ПодЭлемент);
						ДобавленныеЭлементы[ПодЭлемент] = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Если Уровень = МаксУровень Тогда
			Прервать;
		КонецЕсли;
		
		Уровень = Уровень + 1;
		
		ЭлементыДляОбхода = ЭлементыДляОбхода2;
	КонецЦикла;
	
	Возврат ПлоскаяКоллекция;

КонецФункции

Функция СделатьСлепокДанных0(Данные, Описание) Экспорт

	ОписаниеСоответствие = Новый Соответствие;
	
	ОписаниеПолейМассив = Новый Массив;
	ОписаниеМассив = СтрокуВМассив(Описание, Символы.ПС);
	Для Каждого ОписаниеСтрока Из ОписаниеМассив Цикл
		ПозицияВТексте = СтрНайти(ОписаниеСтрока, ",");
		ИмяПоля = СтрЗаменить(Лев(ОписаниеСтрока, ПозицияВТексте-1), " ", "");
		ИмяПоляМассив = МассивВСтроку(ИмяПоля, ".");
		ОписаниеПоля = СтрЗаменить(Прав(ОписаниеСтрока, СтрДлина(ОписаниеСтрока)-ПозицияВТексте), " ", "");
		Если ОписаниеПоля = "[]" Тогда
			ЗначениеПоля = Новый Массив;
		Иначе
			Если Лев(ОписаниеПоля, 1) = "(" Тогда
				ОписаниеПоля = Сред(ОписаниеПоля, 2);
			КонецЕсли;

			Если Прав(ОписаниеПоля, 1) = ")" Тогда
				ОписаниеПоля = Лев(ОписаниеПоля, СтрДлина(ОписаниеПоля)-1);
			КонецЕсли;
			
			ЗначениеПоля = Новый Структура(ОписаниеПоля);
		КонецЕсли;
		
		ОписаниеПоляСтруктура = Новый Структура;
		ОписаниеПоляСтруктура.Вставить("ЗначениеПоля", ЗначениеПоля);
		ОписаниеПоляСтруктура.Вставить("ИмяПоляМассив", ИмяПоляМассив);
		ОписаниеПоляСтруктура.Вставить("ИмяПоля", ИмяПоля);
		ОписаниеПоляСтруктура.Вставить("Уровень", ИмяПоляМассив.Количество());
		ОписаниеСоответствие[ИмяПоля] = ОписаниеПоляСтруктура;
		
		ОписаниеПолейМассив.Добавить(ОписаниеПоляСтруктура);
	КонецЦикла;
	
	СортироватьКоллекцию(ОписаниеПолейМассив, "Уровень");
	
	Слепок = Новый Структура;
	
	Для Каждого ОписаниеПоляСтруктура Из ОписаниеПолейМассив Цикл
		ИмяРодителя = "";
		Родитель = Слепок;
		РодительДанные = Данные;
		Для Каждого ЧастьИмени Из ОписаниеПоляСтруктура.ИмяПоляМассив Цикл
			ИмяРодителя = ИмяРодителя + ЧастьИмени;
			ОписаниеПоляСтруктураРодитель = ОписаниеСоответствие[ИмяРодителя];
			Если ОписаниеПоляСтруктураРодитель = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Родитель = Родитель[ИмяРодителя];
			РодительДанные = РодительДанные[ИмяРодителя];
		КонецЦикла;
	КонецЦикла;
	
КонецФункции

Функция СделатьСлепокДанных(Данные, знач ОписаниеДанных) Экспорт

	Если ТипЗнч(ОписаниеДанных) = Тип("Строка") Тогда
		ОписаниеДанных = ТекстовыйПарсер_РазпарситьСтроку(НовыйТекстовыйПарсер(), ОписаниеДанных);
	КонецЕсли;
	
	Слепок = Новый Структура;
	
	СоответствиеСлепокОписание = Новый Соответствие;
	СоответствиеСлепокОписание[Слепок] = ОписаниеДанных;

	СоответствиеСлепокДанные = Новый Соответствие;
	СоответствиеСлепокДанные[Слепок] = Данные;
	
	ДополнительныеПараметры = Новый Соответствие;
	
	ОбходЭлементов = Новый Массив;
	ОбходЭлементов.Добавить(Слепок);
	
	ТипСтруктура = Тип("Структура");
	ТипМассив = Тип("Массив");
	
	Для Каждого ЭлементСлепка Из ОбходЭлементов Цикл
		ЭлементОписания = СоответствиеСлепокОписание[ЭлементСлепка];
		ЭлементДанных = СоответствиеСлепокДанные[ЭлементСлепка];
		
		ТипЭлемента = ТипЗнч(ЭлементОписания);
		
		Если ТипЭлемента = ТипСтруктура Тогда
			
			ПараметрыЭлемента = ДополнительныеПараметры[ЭлементОписания];
			Если ПараметрыЭлемента = Неопределено Тогда
				ПоляМассив = ВыгрузитьЗначенияКолонкиКоллекции(ЭлементОписания, "Ключ");
				ПоляСтрока = МассивВСтроку(ПоляМассив);
				
				ПараметрыЭлемента = Новый Структура;
				ПараметрыЭлемента.Вставить("ПоляСтрока", ПоляСтрока);
				
				ДополнительныеПараметры[ЭлементОписания] = ПараметрыЭлемента;
			КонецЕсли;
			
			ПоляЭлементаДанных = Новый Структура(ПараметрыЭлемента.ПоляСтрока);
			ЗаполнитьЗначенияСвойств(ПоляЭлементаДанных, ЭлементДанных);
			
			Для Каждого КлючИЗначения Из ЭлементОписания Цикл
				ИмяПоля = КлючИЗначения.Ключ;
				ЗначениеПоля = КлючИЗначения.Значение;
				ПодЭлементДанных = ПоляЭлементаДанных[ИмяПоля];
				
				ТипЗначения = ТипЗнч(ЗначениеПоля);
				Если ТипЗначения = ТипСтруктура ИЛИ ТипЗначения = ТипМассив Тогда
					Если ПодЭлементДанных <> Неопределено Тогда
						НовоеЗначение = Новый(ТипЗначения);
						СоответствиеСлепокОписание[НовоеЗначение] = ЗначениеПоля;
						СоответствиеСлепокДанные[НовоеЗначение] = ПодЭлементДанных;
						ОбходЭлементов.Добавить(НовоеЗначение);
					Иначе
						НовоеЗначение = Неопределено;
					КонецЕсли;
					ЭлементСлепка.Вставить(ИмяПоля, НовоеЗначение);
				Иначе
					ЭлементСлепка.Вставить(ИмяПоля, ПодЭлементДанных);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТипЭлемента = ТипМассив Тогда
			
			Если ЭлементОписания.Количество() = 0 Тогда
				ТипЭлементаМассива = Неопределено;
			Иначе
				ОписаниеЭлементаМассива = ЭлементОписания[0];
				ТипЭлементаМассива = ТипЗнч(ОписаниеЭлементаМассива);
			КонецЕсли;
		
			Если ТипЭлементаМассива = ТипСтруктура ИЛИ ТипЭлементаМассива = ТипМассив Тогда
				
				Для Каждого ПодЭлементДанных Из ЭлементДанных Цикл
					ПодЭлементСлепка = Новый(ТипЭлементаМассива);
					ЭлементСлепка.Добавить(ПодЭлементСлепка);
					СоответствиеСлепокОписание[ПодЭлементСлепка] = ОписаниеЭлементаМассива;
					СоответствиеСлепокДанные[ПодЭлементСлепка] = ПодЭлементДанных;
					ОбходЭлементов.Добавить(ПодЭлементСлепка);
				КонецЦикла;
				
			Иначе
				
				Для Каждого ПодЭлементДанных Из ЭлементДанных Цикл
					ЭлементСлепка.Добавить(ПодЭлементДанных);
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			
			
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Слепок;
	
КонецФункции

Функция НовоеПеречисление(Элементы, Тип="Число") Экспорт
	
	МассивЭлементов = ЗначениеВМассив(Элементы, , Ложь);
	
	Перечисление = Новый Структура;
	
	Если Тип = "Число" Тогда
		Для НомерЭлемента=1 По МассивЭлементов.Количество() Цикл
			Перечисление.Вставить(МассивЭлементов[НомерЭлемента-1], НомерЭлемента);
		КонецЦикла;
	Иначе
		Для Каждого Имя Из МассивЭлементов Цикл
			Перечисление.Вставить(Имя, Имя);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Перечисление;
	
КонецФункции

