Функция ВыгрузитьКвазиТаблицуЗначенийВИстиннуюТаблицуЗначений(КвазиТаблица) Экспорт
	Таблица = Новый ТаблицаЗначений;
	Для Каждого ЭлмКакБыКолонки Из КвазиТаблица.Колонки Цикл
		КакБыКолонка = ЭлмКакБыКолонки.Значение;
		Таблица.Колонки.Добавить(КакБыКолонка.Имя, КакБыКолонка.ТипЗначения);
	КонецЦикла;
	
	Для Каждого СтрокаКакБыТаблицы Из КвазиТаблица.Строки Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКакБыТаблицы);
	КонецЦикла;
	
	Возврат Таблица;
КонецФункции

Функция ЗагрузитьКвазиТаблицуЗначенийИзТаблицыЗначений(Таблица) Экспорт
	КвазиТаблица = НоваяКвазиТаблицаЗначений();
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ДобавитьКолонкуКвазиТаблицыЗначений(КвазиТаблица, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла; 
	
	Для Каждого Строка Из Таблица Цикл
		СтрокаКакБыТаблицы = ДобавитьСтрокуКвазиТаблицыЗначений(КвазиТаблица);
		ЗаполнитьЗначенияСвойств(СтрокаКакБыТаблицы, Строка);
	КонецЦикла;
	
	Возврат КвазиТаблица;
КонецФункции

Функция ИзменитьТипКолонкиТаблицыЗначений(Таблица, ИмяКолонки, ТипЗначения=Неопределено) Экспорт
	
	Колонка = Таблица.Колонки[ИмяКолонки];
	
	Если ТипЗначения=Неопределено И Колонка.ТипЗначения.Типы().Количество() = 0 Тогда
		// уже разтипизирована
		Возврат Истина;
	КонецЕсли;
	
	СвойстваКолонки = Новый Структура("Имя, Ширина, Заголовок");
	ЗаполнитьЗначенияСвойств(СвойстваКолонки, Колонка);
	СвойстваКолонки.Вставить("Индекс", Таблица.Колонки.Индекс(Колонка));
	СвойстваКолонки.Вставить("Значения", Таблица.ВыгрузитьКолонку(СвойстваКолонки.Имя));
	
	ВременноеИмяКолонки = ПолучитьИмяНовогоЭлементаКоллекции("Колонка", Таблица.Колонки, "Имя");
	НоваяКолонка = Таблица.Колонки.Вставить(СвойстваКолонки.Индекс, ВременноеИмяКолонки, ТипЗначения, СвойстваКолонки.Заголовок, СвойстваКолонки.Ширина);
	Таблица.Колонки.Удалить(Колонка);
	НоваяКолонка.Имя = СвойстваКолонки.Имя;
	Таблица.ЗагрузитьКолонку(СвойстваКолонки.Значения, СвойстваКолонки.Имя);
	Возврат Истина;
	
КонецФункции

Функция СкопироватьТаблицуЗначений(ТаблицаИсточник, знач Строки=Неопределено, Разтипизировать=Ложь) Экспорт
	
	Если Разтипизировать Тогда
		
		Таблица = Новый ТаблицаЗначений;
		Для Каждого Колонка Из ТаблицаИсточник.Колонки Цикл
			Таблица.Колонки.Добавить(Колонка.Имя, , Колонка.Заголовок, Колонка.Ширина);
		КонецЦикла;
		
		Если Строки = Неопределено Тогда
			Строки = ТаблицаИсточник;
		КонецЕсли;
		
		Для Каждого Строка Из ТаблицаИсточник Цикл
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;
		
	Иначе
		
		// используем стандартный метод
		Таблица = ТаблицаИсточник.Скопировать(Строки);
		
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции
