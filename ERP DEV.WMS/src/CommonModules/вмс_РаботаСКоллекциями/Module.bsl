#Область ПрограммныйИнтерфейс

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Функция МассивВСтроку(Массив, Разделитель=", ") Экспорт
	
	Строка = "";
	
	Если Массив.Количество() > 0 Тогда
		Для Каждого Элемент Из Массив Цикл
			Строка = Строка + Разделитель + Элемент;
		КонецЦикла;
		
		Строка = Прав(Строка, СтрДлина(Строка)-СтрДлина(Разделитель));
	КонецЕсли;
	
	Возврат Строка;
				
КонецФункции

Функция СтрокуВМассив(знач Строка, Разделитель=",", УбратьЛишниеПробелы=Истина, ДобавлятьПустуюСтроку=Ложь) Экспорт
	
	Массив = Новый Массив;
	
	Если УбратьЛишниеПробелы Тогда
		Строка = СокрЛП(Строка);
	КонецЕсли;
	
	ДлинаСтроки = СтрДлина(Строка);
	ДлинаРазделителя = СтрДлина(Разделитель);
	
	Если ДлинаСтроки = 0 Тогда
		Если ДобавлятьПустуюСтроку Тогда
			Массив.Добавить("");
		КонецЕсли; 
		
		Возврат Массив;
	КонецЕсли; 
	
	Пока ДлинаСтроки > 0 Цикл
		Позиция = Найти(Строка, Разделитель);
		Если Позиция = 0 Тогда
			Слово = Строка;
			ДлинаСтроки = 0;
		Иначе
			Слово = Лев(Строка, Позиция-1);
			ДлинаСтроки = ДлинаСтроки - (Позиция+ДлинаРазделителя-1);
			Строка = Прав(Строка, ДлинаСтроки);
		КонецЕсли;
		
		Если УбратьЛишниеПробелы Тогда
			Слово = СокрЛП(Слово);
		КонецЕсли;
		
		Массив.Добавить(Слово);
	КонецЦикла; 
	
	Возврат Массив;
	
КонецФункции

Функция СтрокуВМассивПосимвольно(Строка) Экспорт
	МассивСимволов = Новый Массив;
	ДлинаСтроки = СтрДлина(Строка);
	Для НомерСимвола=1 По ДлинаСтроки Цикл
		Символ = Сред(Строка, НомерСимвола, 1);
		МассивСимволов.Добавить(Символ);
	КонецЦикла;
	Возврат МассивСимволов;
КонецФункции

Функция МассивСНеопределено(знач Строка, Разделитель=",", УбратьЛишниеПробелы=Истина, ДобавлятьПустуюСтроку=Ложь) Экспорт
	Результат = СтрокуВМассив(Строка, Разделитель, УбратьЛишниеПробелы, ДобавлятьПустуюСтроку); 
	
	Для Индекс = 0 По Результат.Количество()-1 Цикл
		Результат[Индекс] = СокрЛП(Результат[Индекс]);
		Если Результат[Индекс] = "Неопределено" Тогда
			Результат[Индекс] = Неопределено;		
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ДобавитьЗначенияВСтроку(Строка, Значения, Разделитель=", ") Экспорт
	
	МассивЗначений = ЗначениеВМассив(Значения, , Ложь, Ложь);

	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Строка = "";
	КонецЕсли;
	
	ПустаяСтрока = ПустаяСтрока(Строка);
	
	Для Каждого Значение Из МассивЗначений Цикл
		
		Если ПустаяСтрока Тогда
			ПустаяСтрока = Ложь;
		Иначе
			Строка = Строка + Разделитель;
		КонецЕсли;
		
		Строка = Строка + Значение;
		
	КонецЦикла;
	
КонецФункции

Функция ВрезатьСтроку(Текст, СтрокаВставки, знач Позиция, ПозицияДоСтрока, ПозицияПослеСтрока) Экспорт
	
	Если ТипЗнч(Позиция) <> Тип("Число") Тогда
		Позиция = СтрНайти(Текст, Позиция);
	КонецЕсли;

	Если Позиция = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	
	ТекстЛев = Лев(Текст, Позиция-1);
	ТекстПрав = Сред(Текст, Позиция);
	
	ПозицияДо = СтрНайти(ТекстЛев, ПозицияДоСтрока, НаправлениеПоиска.СКонца);
	ТекстЛев = Лев(ТекстЛев, ПозицияДо-1+СтрДлина(ПозицияДоСтрока));
	
	ПозицияПосле = СтрНайти(ТекстПрав, ПозицияПослеСтрока);
	ТекстПрав = Сред(ТекстПрав, ПозицияПосле);
	
	Возврат ТекстЛев + СтрокаВставки + ТекстПрав;
	
КонецФункции

Функция ВычленитьСтроку(Текст, ТекстВнутри, ТекстГраницаСлева, ТекстГраницаСправа) Экспорт
	
	Позиция = СтрНайти(Текст, ТекстВнутри);

	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЛев = Лев(Текст, Позиция-1);
	
	ПозицияЛев = СтрНайти(ТекстЛев, ТекстГраницаСлева, НаправлениеПоиска.СКонца);
	Если ПозицияЛев = 0 Тогда
		Возврат "";
	КонецЕсли;
	ПозицияЛев = ПозицияЛев + СтрДлина(ТекстГраницаСлева);
	
	НачалоТекстаПрав = Позиция + СтрДлина(ТекстВнутри);
	ТекстПрав = Сред(Текст, НачалоТекстаПрав);
	ПозицияПрав = СтрНайти(ТекстПрав, ТекстГраницаСправа);
	Если ПозицияПрав = 0 Тогда
		Возврат "";
	КонецЕсли;
	ПозицияПрав = НачалоТекстаПрав-1 + ПозицияПрав-1;
	
	Строка = Сред(Текст, ПозицияЛев, ПозицияПрав-ПозицияЛев+1);
	
	Возврат Строка;
	
КонецФункции

Функция ЗакодироватьСтрокуВМассивКодов(Строка) Экспорт
	МассивКодов = Новый Массив;
	ДлинаСтроки = СтрДлина(Строка);
	Для НомерСимвола=1 По ДлинаСтроки Цикл
		Символ = Сред(Строка, НомерСимвола, 1);
		МассивКодов.Добавить(КодСимвола(Символ));
	КонецЦикла;
	Возврат МассивКодов;
КонецФункции

Функция ПолучитьСтрокуИзМассиваКодов(МассивКодов) Экспорт
	Строка = "";
	Для Каждого КодСимвола Из МассивКодов Цикл
		Строка = Строка + Символ(КодСимвола);
	КонецЦикла;
	Возврат Строка;
КонецФункции

Функция ЗаменитьЗначенияОбъекта(Объект, Что, Чем) Экспорт
	
	МассивСсылок = РазложитьСтруктуруДанныхВМассивСсылокНаЗначения(Объект);
	КоличествоЗамен = 0;
	
	Для Каждого Ссылка Из МассивСсылок Цикл
		
		Если Ссылка.Значение=Что Тогда
			Ссылка.Коллекция[Ссылка.ИмяПоля] = Чем;
			КоличествоЗамен = КоличествоЗамен + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КоличествоЗамен;
	
КонецФункции

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Функция СкопироватьКоллекцию(Коллекция, Строки=Неопределено) Экспорт
	
	#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
			Возврат СкопироватьТаблицуЗначений(Коллекция, Строки);
		КонецЕсли;
	#КонецЕсли
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		Возврат СкопироватьКвазиТаблицуЗначений(Коллекция, Строки);
	КонецЕсли; 
	
КонецФункции

Функция ПолучитьЭлементыКоллекции(Коллекция) Экспорт
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		Возврат Коллекция.Строки;
	КонецЕсли;
	
	Если ТипЗнч(Коллекция) = Тип("Строка") Тогда
		Возврат СтрокуВМассив(Коллекция);
	КонецЕсли;
	
	Возврат Коллекция;
	
КонецФункции

Функция ПолучитьКолонкиКоллекции(знач Коллекция, ИсключитьКолонки=Неопределено) Экспорт
	
	МассивКолонок = Неопределено;
	
	Если ТипЗнч(Коллекция)=Тип("Массив") И Коллекция.Количество() > 0 Тогда
		Элемент = Коллекция[0];
		Если ТипЗнч(Элемент)=ТипСтрокаТаблицыЗначений() Тогда
			Коллекция = Элемент.Владелец();
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоТаблицаЗначений(Коллекция) Тогда
		МассивКолонок = ВыгрузитьЗначенияКолонокКоллекции(Коллекция.Колонки, "Имя");
	ИначеЕсли ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		МассивКолонок = ВыгрузитьЗначенияКолонокКоллекции(Коллекция.Колонки, "Ключ");
	КонецЕсли;
	
	Если МассивКолонок <> Неопределено Тогда
		Если ИсключитьКолонки <> Неопределено Тогда
			ВычестьМассив(МассивКолонок, ИсключитьКолонки);
		КонецЕсли;
		Возврат МассивКолонок;
	КонецЕсли;
	
КонецФункции

Функция НоваяКоллекцияЗначений(Колонки=Неопределено, Тип=Неопределено) Экспорт
	
	Если Тип=Неопределено Тогда
		#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
			ИмяТипа = "ТаблицаЗначений";
		#Иначе
			ИмяТипа = "КвазиТаблицаЗначений";
		#КонецЕсли
	Иначе
		
		ИмяТипа = Строка(Тип);
		ИмяТипа = СтрЗаменить(ИмяТипа, " ", "");
		
	КонецЕсли;
	
	ИмяТипа = нрег(ИмяТипа);
	
	Если ИмяТипа="таблицазначений" Тогда
		
		Коллекция = НоваяТаблицаЗначений(Колонки);
		
	Иначе
		
		Коллекция = НоваяКвазиТаблицаЗначений(Колонки);
		
	КонецЕсли;
	
	Возврат Коллекция;
	
КонецФункции

Функция НовыйЭлементКоллекции(Коллекция) Экспорт
	
#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
			Возврат Коллекция.Добавить();
		КонецЕсли;
#КонецЕсли
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		Возврат ДобавитьСтрокуКвазиТаблицыЗначений(Коллекция);
	КонецЕсли;
	
КонецФункции

Функция ЗагрузитьКоллекциюЗначенийИзТабличногоДокумента(ТабличныйДокумент, ТипКоллекции=Неопределено, НомерПервойСтроки=1) Экспорт
	
	НомерСтроки = НомерПервойСтроки;
	НомерКолонки = 1;
	Колонки = Новый Массив;
	Для НомерКолонки=1 По ТабличныйДокумент.ШиринаТаблицы Цикл
		ИмяКолонки = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст;
		Если Не ЗначениеЗаполнено(ИмяКолонки) Тогда
			Прервать;
		КонецЕсли;
		Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	
	Таблица = НоваяКоллекцияЗначений(Колонки, ТипКоллекции);
	Для НомерСтроки=НомерСтроки+1 По ТабличныйДокумент.ВысотаТаблицы Цикл
		СтрокаТаблицы = НовыйЭлементКоллекции(Таблица);
		Для НомерКолонки=1 По Колонки.Количество() Цикл
			Значение = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст;
			ИмяКолонки = Колонки[НомерКолонки-1];
			СтрокаТаблицы[ИмяКолонки] = Значение;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ЗагрузитьКоллекциюЗначенийИзМассиваСтруктур(МассивСтруктур, ТипКоллекции=Неопределено, знач Колонки=Неопределено) Экспорт
	
	Если Колонки=Неопределено Тогда
		Если МассивСтруктур.Количество() > 0 Тогда
			ЭлементМассива = МассивСтруктур[0];
			Колонки = Новый Массив;
			Для Каждого КлючЗначение Из ЭлементМассива Цикл
				Колонки.Добавить(КлючЗначение.Ключ);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Коллекция = НоваяКоллекцияЗначений(Колонки, ТипКоллекции);
	
	Для Каждого ЭлементМассива Из МассивСтруктур Цикл
		ДобавитьЭлементКоллекции(Коллекция, ЭлементМассива);
	КонецЦикла;
	
	Возврат Коллекция;
	
КонецФункции

Функция УстановитьЭлементыКоллекции(Коллекция, Элементы) Экспорт
	
	УдалитьЭлементыКоллекции(Коллекция);
	
	Возврат ДобавитьЭлементыКоллекции(Коллекция, Элементы);
	
КонецФункции

Функция ДобавитьЭлементыКоллекции(Коллекция, Элементы) Экспорт

	МассивЭлементов = ПолучитьЭлементыКоллекции(Элементы);
	
	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		
		Для Каждого Элемент Из МассивЭлементов Цикл
			Коллекция.Добавить(Элемент);
		КонецЦикла;
		
	ИначеЕсли ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		ДобавитьСтрокиКвазиТаблицыЗначений(Коллекция, МассивЭлементов);
		
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Структура") ИЛИ ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		
		Если ТипЗнч(МассивЭлементов) = Тип("Структура") ИЛИ ТипЗнч(МассивЭлементов) = Тип("Соответствие") Тогда
			
			Для Каждого Элемент Из МассивЭлементов Цикл
				
				Коллекция.Вставить(Элемент.Ключ, Элемент.Значение);
				
			КонецЦикла; 
			
		КонецЕсли;
		
	ИначеЕсли МассивЭлементов <> Неопределено Тогда
		
		Для Каждого Элемент Из МассивЭлементов Цикл
			НовыйЭлемент = Коллекция.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элемент);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Коллекция;
	
КонецФункции

Функция ДобавитьЭлементКоллекции(Коллекция, ДанныеЭлемента=Неопределено) Экспорт
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		НовыйЭлемент = ДобавитьСтрокуКвазиТаблицыЗначений(Коллекция, ДанныеЭлемента);
		
	Иначе
		
		НовыйЭлемент = Коллекция.Добавить();
		Если ДанныеЭлемента <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ДанныеЭлемента);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НовыйЭлемент;
	
КонецФункции

Функция ДобавитьКолонкуКоллекции(Коллекция, Имя, Тип=Неопределено, Заголовок="", Ширина=0) Экспорт
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		Колонка = ДобавитьКолонкуКвазиТаблицыЗначений(Коллекция, Имя, Тип);
		
	Иначе
		
		Колонка = Коллекция.Колонки.Добавить(Имя, Тип, Заголовок, Ширина);
		
	КонецЕсли;
	
	Возврат Колонка;
	
КонецФункции

Функция ИнвертироватьЗначенияКоллекции(Коллекция, КолонкиКоллекции=Неопределено) Экспорт

	Если КолонкиКоллекции <> Неопределено Тогда
		МассивКолонокКоллекции = ЗначениеВМассив(КолонкиКоллекции);
	КонецЕсли;
	
	ЭлементыКоллекции = ПолучитьЭлементыКоллекции(Коллекция);
	
	Если КолонкиКоллекции <> Неопределено Тогда
		Для Каждого ЭлементКоллекции Из ЭлементыКоллекции Цикл
			Для Каждого Колонка Из МассивКолонокКоллекции Цикл
				ЭлементКоллекции[Колонка] = -ЭлементКоллекции[Колонка];
			КонецЦикла;
		КонецЦикла;
	Иначе
		Для Индекс=0 По ЭлементыКоллекции.ВГраница() Цикл
			ЭлементыКоллекции[Индекс] = -ЭлементыКоллекции[Индекс];
		КонецЦикла;
	КонецЕсли;

КонецФункции

Функция ПолучитьИтогКоллекции(Коллекция, ПолеИтога) Экспорт
	
	Возврат ПолучитьИтогиКоллекции(Коллекция, ПолеИтога)[ПолеИтога];
	
КонецФункции

Функция ПолучитьИтогиКоллекции(Коллекция, ПоляИтогов) Экспорт
	
	ПоляИтоговМассив = ЗначениеВМассив(ПоляИтогов);
	Итоги = Новый Структура;
	Для Каждого ПолеИтога Из ПоляИтоговМассив Цикл
		Итоги.Вставить(ПолеИтога, 0);
	КонецЦикла;
	
	ТипЧисло = Тип("Число");
	
	Для Каждого Элемент Из ПолучитьЭлементыКоллекции(Коллекция) Цикл
		Для Каждого ПолеИтога Из ПоляИтоговМассив Цикл
			Значение = Элемент[ПолеИтога];
			Если ТипЗнч(Значение) = ТипЧисло Тогда
				Итоги[ПолеИтога] = Итоги[ПолеИтога] + Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Итоги;
	
КонецФункции

Функция ОчиститьЭлементыКоллекции(Коллекция) Экспорт
	
	#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
			Коллекция.Очистить();
		КонецЕсли;
	#КонецЕсли
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		УдалитьСтрокиКвазиТаблицыЗначений(Коллекция);
	КонецЕсли; 
	
КонецФункции

// Возвращает таблицу, в которой указаны прямые и косвенные (через другие элементы) связи элементов из таблицы иерархии элементов (элемент-родитель) с только непосредственными связями
//
// Параметры:
//  - ТаблицаЭлементов - Таблица элементов с колонками типа "Элемент", "Родитель элемента"
//  - КолонкаЭлемента - Строка, Имя колонки элемента
//  - КолонкаРодителяЭлемента - Строка, Имя колонки родителя элемента
//
// Возвращаемое значение:
//  - ТаблицаЗначений - Таблица всех связей элементов
//
Функция ПостроитьТаблицуБлизостиЭлементов(ТаблицаЭлементов, КолонкаРодителяЭлемента, КолонкаЭлемента) Экспорт
	
	ТаблицаБлизостиЭлементов = СкопироватьКоллекцию(ТаблицаЭлементов);
	
	ОтборПоРодителю = Новый Структура;
	ОтборПоРодителю.Вставить(КолонкаРодителяЭлемента);
	
	//ОтборПоСвязи = Новый Структура;
	//ОтборПоСвязи.Вставить(КолонкаРодителяЭлемента);
	//ОтборПоСвязи.Вставить(КолонкаЭлемента);
	
	// добавим транзитивные связи элементов через другие элементы
	Для Каждого СтрокаРодителя Из ПолучитьЭлементыКоллекции(ТаблицаБлизостиЭлементов) Цикл
		ОтборПоРодителю[КолонкаРодителяЭлемента] = СтрокаРодителя[КолонкаЭлемента];
		СтрокиТранзита = НайтиЭлементыКоллекции(ТаблицаБлизостиЭлементов, ОтборПоРодителю);
		Для Каждого СтрокаТранзита Из СтрокиТранзита Цикл
			//ОтборПоСвязи[КолонкаРодителяЭлемента] = СтрокаРодителя[КолонкаРодителяЭлемента];
			//ОтборПоСвязи[КолонкаЭлемента] = СтрокаТранзита[КолонкаЭлемента];
			//Если НайтиЭлементКоллекции(ТаблицаБлизостиЭлементов, ОтборПоСвязи)=Неопределено Тогда
				СтрокаТранзитнойСвязи = ДобавитьЭлементКоллекции(ТаблицаБлизостиЭлементов);
				ЗаполнитьЗначенияСвойств(СтрокаТранзитнойСвязи, СтрокаТранзита);
				СтрокаТранзитнойСвязи[КолонкаЭлемента] = СтрокаТранзита[КолонкаЭлемента];
				СтрокаТранзитнойСвязи[КолонкаРодителяЭлемента] = СтрокаРодителя[КолонкаРодителяЭлемента];
				ИндексироватьКоллекцию(ТаблицаБлизостиЭлементов, СтрокаТранзитнойСвязи);
			//КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаБлизостиЭлементов;
	
КонецФункции

// Параметры
//	СписокКолонок - список имен добавляемых колонок
//	Источник - свойства колонок (ТаблицаЗначений, КолонкиТаблицыЗначений, Строка, Массив)
Функция ДополнитьКолонкиТаблицыЗначений(Таблица, знач СписокКолонок=Неопределено, знач Источник=Неопределено) Экспорт
	
	Если Не ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если ТипЗнч(Источник) = Тип("ТаблицаЗначений") Тогда
		Источник = Источник.Колонки;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("КоллекцияКолонокТаблицыЗначений") Тогда
		Если СписокКолонок = Неопределено Тогда
			СписокКолонок = ВыгрузитьЗначенияКолонкиКоллекции(Источник, "Имя");
		КонецЕсли;
	ИначеЕсли ТипЗнч(Источник)=Тип("Строка") Тогда
		СписокКолонок = СтрокуВМассив(Источник);
		Источник = Неопределено;
	ИначеЕсли ТипЗнч(Источник)=Тип("Массив") Тогда
		СписокКолонок = Источник;
		Источник = Неопределено;
	Иначе
		Источник = Неопределено;
	КонецЕсли;
	
	МассивКолонок = ЗначениеВМассив(СписокКолонок);
	Для Каждого ИмяКолонки Из МассивКолонок Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			Если Источник <> Неопределено Тогда
				КолонкаИсточника = Источник.Найти(ИмяКолонки);
				Если КолонкаИсточника <> Неопределено Тогда
					ТипЗначения = КолонкаИсточника.ТипЗначения;
					Заголовок = КолонкаИсточника.Заголовок;
					Ширина = КолонкаИсточника.Ширина;
				Иначе
					ТипЗначения = Неопределено;
					Заголовок = Неопределено;
					Ширина = Неопределено;
				КонецЕсли; 
			КонецЕсли; 
			НоваяКолонка = Таблица.Колонки.Добавить(ИмяКолонки, ТипЗначения, Заголовок, Ширина);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЭтоЦифра(Символ) Экспорт
	
	Возврат Найти(Символ, "1234567890") <> Неопределено;
	
КонецФункции

Функция СтрокуВМассивСепарироватьЦифры(Строка) Экспорт
	
	МассивЭлементов = Новый Массив;
	СимволЦифровой = Ложь;
	Элемент = "";
	Для НомерСимвола=1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, НомерСимвола, 1);
		ПредыдущийСимволЦифровой = СимволЦифровой;
		СимволЦифровой = вмс_РаботаСКоллекциямиПовтИсп.ЭтоЦифровойСимвол(Символ);
		Если СимволЦифровой <> ПредыдущийСимволЦифровой Тогда
			Если Элемент <> "" Тогда
				МассивЭлементов.Добавить(Элемент);
				Элемент = "";
			КонецЕсли;
		КонецЕсли;
		Элемент = Элемент + Символ;
	КонецЦикла;
	
	Если Элемент <> "" Тогда
		МассивЭлементов.Добавить(Элемент);
	КонецЕсли;
	
	Возврат МассивЭлементов;
	
КонецФункции

Функция ДобавитьЛидирующиеНулиЧиселВСтроке(Строка, КоличествоРазрядов) Экспорт
	
	МассивЭлементов = СтрокуВМассивСепарироватьЦифры(Строка);

	НоваяСтрока = "";
	ФорматнаяСтрока = "ЧЦ=" + Формат(КоличествоРазрядов, "ЧГ=0") + "; ЧН=; ЧВН=; ЧГ=0";
	Для Каждого Элемент Из МассивЭлементов Цикл
		Символ = Лев(Элемент, 1);
		Если вмс_РаботаСКоллекциямиПовтИсп.ЭтоЦифровойСимвол(Символ) Тогда
			Элемент = Формат(Число(Элемент), ФорматнаяСтрока);
		КонецЕсли;
		НоваяСтрока = НоваяСтрока + Элемент;
	КонецЦикла;
	
	Возврат НоваяСтрока;
	
КонецФункции

Функция ПолучитьСинонимИзИмени(Имя) Экспорт

	Слова = Новый Массив;
	
	ДлинаИмени = СтрДлина(Имя);
	ВР0 = Неопределено;
	ВР1 = Неопределено;
	Ч0 = Неопределено;
	Ч1 = Неопределено;
	НачалоСлова = 1;
	Для НомерСимвола=1 По ДлинаИмени Цикл
		Символ = Сред(Имя, НомерСимвола, 1);
		ВР1 = ВРег(Символ) = Символ И НРег(Символ) <> Символ;
		Ч1 = ЭтоЦифра(Символ);
		Если ВР1 = Истина И ВР0 = Ложь ИЛИ Ч1 = Истина И Ч0 = Ложь ИЛИ Ч1 = Ложь И Ч0 = Истина Тогда
			Если НачалоСлова < НомерСимвола Тогда
				Слово = Сред(Имя, НачалоСлова, НомерСимвола-НачалоСлова);
				Слова.Добавить(НРег(Слово));
				НачалоСлова = НомерСимвола;
			КонецЕсли;
		КонецЕсли;
		ВР0 = ВР1;
		Ч0 = Ч1;
	КонецЦикла;
	
	Если НачалоСлова < НомерСимвола Тогда
		Слово = Сред(Имя, НачалоСлова, НомерСимвола-НачалоСлова);
		Слова.Добавить(НРег(Слово));
	КонецЕсли;
	
	Синоним = МассивВСтроку(Слова, " ");
	Синоним = ВРег(Лев(Синоним, 1)) + Прав(Синоним, СтрДлина(Синоним)-1);
	Возврат Синоним;
	
КонецФункции

Функция ПолучитьСочетанияЭлементов(Данные) Экспорт
	
	МассивСочетаний = Новый Массив;

	МассивДвумерный = Новый Массив;
	ТипЗначения = ТипЗнч(Данные);
	ТипМассив = Тип("Массив");
	ТипСтруктура = Тип("Структура");
	Если ТипЗначения = ТипМассив Тогда
		Для Каждого Элемент Из Данные Цикл
			ЗначенияЭлемента = ЗначениеВМассив(Элемент, , Ложь);
			МассивДвумерный.Добавить(ЗначенияЭлемента);
		КонецЦикла;
	ИначеЕсли ТипЗначения = ТипСтруктура Тогда
		ИменаПолей = Новый Массив;
		Для Каждого Элемент Из Данные Цикл
			ИменаПолей.Добавить(Элемент.Ключ);
			ЗначенияЭлемента = ЗначениеВМассив(Элемент.Значение, , Ложь);
			МассивДвумерный.Добавить(ЗначенияЭлемента);
		КонецЦикла;
	Иначе
		Возврат МассивСочетаний;
	КонецЕсли;
	
	МассивИндексный = Новый Массив;
	Для НомерМассива=0 По МассивДвумерный.ВГраница() Цикл
		МассивИндексный.Добавить(0);
	КонецЦикла;
	
	Пока Истина Цикл
		
		Если ТипЗначения = ТипМассив Тогда
			Сочетание = Новый Массив;
			Для НомерИндекса=0 По МассивИндексный.ВГраница() Цикл
				Значение = МассивДвумерный[НомерИндекса][МассивИндексный[НомерИндекса]];
				Сочетание.Добавить(Значение);
			КонецЦикла;
		Иначе
			Сочетание = Новый Структура;
			Для НомерИндекса=0 По МассивИндексный.ВГраница() Цикл
				Значение = МассивДвумерный[НомерИндекса][МассивИндексный[НомерИндекса]];
				ИмяПоля = ИменаПолей[НомерИндекса];
				Сочетание.Вставить(ИмяПоля, Значение);
			КонецЦикла;
		КонецЕсли;
		МассивСочетаний.Добавить(Сочетание);

		Для НомерИндекса=0 По МассивИндексный.ВГраница() Цикл
			Если МассивИндексный[НомерИндекса] = МассивДвумерный[НомерИндекса].ВГраница() Тогда
				МассивИндексный[НомерИндекса] = 0;
			Иначе
				МассивИндексный[НомерИндекса] = МассивИндексный[НомерИндекса] + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НомерИндекса > МассивИндексный.ВГраница() Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивСочетаний;
	
КонецФункции

Функция НоваяТаблицаЗначений(знач СписокКолонок=Неопределено, знач Источник=Неопределено) Экспорт
	
	Таблица = Новый("ТаблицаЗначений");
	ДополнитьКолонкиТаблицыЗначений(Таблица, СписокКолонок, Источник);
	Возврат Таблица;
	
КонецФункции

Функция УпорядочитьСтрокиТаблицыЗначенийПоМассиву(Таблица, МассивСтрок)
	
	ИндексСтроки = 0;
	Для Каждого Строка Из МассивСтрок Цикл
		
		ТекущийИндексСтроки = Таблица.Индекс(Строка);
		Если ТекущийИндексСтроки=-1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИндексСтроки <> ТекущийИндексСтроки Тогда
			Таблица.Сдвинуть(ТекущийИндексСтроки, ИндексСтроки-ТекущийИндексСтроки);
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
Функция ЗначениеВТаблицуЗначений(знач Значение, ПолеПоУмолчанию="Объект") Экспорт

	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		
		// ужо таблица и есть
		ТаблицаЗначений = Значение;
		
	ИначеЕсли ЭтоКвазиТаблицаЗначений(Значение) Тогда
		
		ТаблицаЗначений = ВыгрузитьКвазиТаблицуЗначенийВИстиннуюТаблицуЗначений(Значение);
		
	Иначе
		
		Если ТипЗначения <> Тип("Массив") Тогда
		
			ЭлементДанных = Значение;
			Значение = Новый Массив;
			Значение.Добавить(ЭлементДанных);
			
		КонецЕсли;
		
		МассивЭлементов = Новый Массив;
		Колонки = Новый Массив;
		
		Для Каждого Элемент Из Значение Цикл
			
			Если ТипЗнч(Элемент) = Тип("Структура") Тогда
				ЭлементСтруктура = Элемент;
			Иначе
				ЭлементСтруктура = Новый Структура(ПолеПоУмолчанию, Элемент);
			КонецЕсли;
			
			МассивЭлементов.Добавить(ЭлементСтруктура);
			
			Для Каждого Поле Из ЭлементСтруктура Цикл
				Если Колонки.Найти(Поле.Ключ) = Неопределено Тогда
					Колонки.Добавить(Поле.Ключ);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		ТаблицаЗначений = Новый ТаблицаЗначений;
		Для Каждого Колонка Из Колонки Цикл
			ТаблицаЗначений.Колонки.Добавить(Колонка);
		КонецЦикла;
		
		Значение = Неопределено;
		Для Каждого ЭлементСтруктура Из МассивЭлементов Цикл
			СтрокаТаблицыЗначений = ТаблицаЗначений.Добавить();
			Для Каждого Колонка Из Колонки Цикл
				Если Не ЭлементСтруктура.Свойство(Колонка, Значение) Тогда
					Значение = Null;
				КонецЕсли;
				СтрокаТаблицыЗначений[Колонка] = Значение;
			КонецЦикла;
		КонецЦикла;
			
	КонецЕсли;
	
	Возврат ТаблицаЗначений;

КонецФункции
#КонецЕсли

Функция СтрокуТаблицыЗначенийВСтруктуру(Строка) Экспорт
	
	Структура = Новый Структура;
	Таблица = Строка.Владелец();
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ИмяЯчейки = Колонка.Имя;
		Структура.Вставить(ИмяЯчейки, Строка[ИмяЯчейки]);
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

Функция ВыгрузитьКоллекциюВМассивСтруктур(Коллекция) Экспорт
	
	ПоляСтроки = МассивВСтроку(ПолучитьКолонкиКоллекции(Коллекция));
	
	МассивСтруктур = Новый Массив;
	Для Каждого СтрокаКоллекции Из ПолучитьЭлементыКоллекции(Коллекция) Цикл
		Структура = Новый Структура(ПоляСтроки);
		ЗаполнитьЗначенияСвойств(Структура, СтрокаКоллекции);
		МассивСтруктур.Добавить(Структура);
	КонецЦикла;
	
	Возврат МассивСтруктур;
	
КонецФункции

Функция ДобавитьСтрокуТЗ(ТЗ, Поле1, Поле2=Неопределено, Поле3=Неопределено, Поле4=Неопределено, Поле5=Неопределено) Экспорт
	
	Количество = ТЗ.Колонки.Количество();
	Стр = ТЗ.Добавить();
	Если Количество > 0 Тогда
		Стр.Установить(0, Поле1);
		Если Количество > 1 Тогда
			Стр.Установить(1, Поле2);
			Если Количество > 2 Тогда
				Стр.Установить(2, Поле3);
				Если Количество > 3 Тогда
					Стр.Установить(3, Поле4);
					Если Количество > 4 Тогда
						Стр.Установить(4, Поле5);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Стр;
	
КонецФункции

Функция СортироватьКоллекцию(Коллекция, СтрокаСортировки=Неопределено, знач НачальныйИндекс=Неопределено, знач КонечныйИндекс=Неопределено) Экспорт
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		Возврат СортироватьКвазиТаблицуЗначений(Коллекция, СтрокаСортировки);
		
	КонецЕсли;
	
	Если Не (СтрокаСортировки <> Неопределено И ЗначениеЗаполнено(СтрокаСортировки)) Тогда
		Возврат СортироватьКоллекциюОбщ(Коллекция, , НачальныйИндекс, КонечныйИндекс);
	КонецЕсли;
	
	// получить поля сортировки из строки сортировки
	ПоляСортировки = ЗначениеВМассив(СтрокаСортировки);
	ПоляСортировки2 = Новый Массив;
	Для Каждого ПолеСортировкиСтрока Из ПоляСортировки Цикл
		ПолеСортировкиМассив = СтрокуВМассив(ПолеСортировкиСтрока, " ");
		ПолеСортировки = Новый Структура;
		ПолеСортировки.Вставить("Имя", ПолеСортировкиМассив[0]);
		ПолеСортировки.Вставить("ПоВозрастанию", Истина);
		Если ПолеСортировкиМассив.Количество() > 1 Тогда
			Если НРег(ПолеСортировкиМассив[1]) = "убыв" Тогда
				ПолеСортировки.ПоВозрастанию = Ложь;
			КонецЕсли;
		КонецЕсли;
		ПоляСортировки2.Добавить(ПолеСортировки);
	КонецЦикла;
	ПоляСортировки = ПоляСортировки2;
	
	///////////////////////////////////////////////
	Если НачальныйИндекс = Неопределено Тогда
		НачальныйИндекс = 0;
	КонецЕсли;
	
	Если КонечныйИндекс = Неопределено Тогда
		КонечныйИндекс = Коллекция.Количество()-1;
	КонецЕсли;
	
	ДиапазоныСортировки = Новый Массив;
	ДиапазоныСортировки.Добавить(Новый Структура("НачальныйИндекс, КонечныйИндекс", НачальныйИндекс, КонечныйИндекс));
	
	Для Каждого ПолеСортировки Из ПоляСортировки Цикл
		
		ИмяПоля = ПолеСортировки.Имя;
		ДиапазоныСортировки2 = Новый Массив;
		
		Для Каждого ДиапазонСортировки Из ДиапазоныСортировки Цикл
			
			СортироватьКоллекциюОбщ(Коллекция, ИмяПоля, ДиапазонСортировки.НачальныйИндекс, ДиапазонСортировки.КонечныйИндекс, ПолеСортировки.ПоВозрастанию);
			
			Если ДиапазонСортировки.КонечныйИндекс > ДиапазонСортировки.НачальныйИндекс Тогда
				Индекс = ДиапазонСортировки.НачальныйИндекс;
				Значение0 = Коллекция[Индекс][ИмяПоля];
				Индекс0 = Индекс;
				Для Индекс=Индекс+1 По ДиапазонСортировки.КонечныйИндекс Цикл
					Значение = Коллекция[Индекс][ИмяПоля];
					Если Значение <> Значение0 Тогда
						Если Индекс - Индекс0 > 1 Тогда
							ДиапазоныСортировки2.Добавить(Новый Структура("НачальныйИндекс, КонечныйИндекс", Индекс0, Индекс-1));
						КонецЕсли; 
						Значение0 = Значение;
						Индекс0 = Индекс;
					КонецЕсли; 
				КонецЦикла;
				
				Если Индекс - Индекс0 > 1 Тогда
					ДиапазоныСортировки2.Добавить(Новый Структура("НачальныйИндекс, КонечныйИндекс", Индекс0, Индекс-1));
				КонецЕсли; 
			КонецЕсли;
			
			ДиапазоныСортировки = ДиапазоныСортировки2;
			
		КонецЦикла; 
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СортироватьКоллекциюОбщ(знач Коллекция, ИмяПоля=Неопределено, знач НачальныйИндекс=Неопределено, знач КонечныйИндекс=Неопределено, ПоВозрастанию=Истина)
	
	Возврат СортироватьКоллекциюСпискомЗначений(Коллекция, ИмяПоля, НачальныйИндекс, КонечныйИндекс, ПоВозрастанию);
	
КонецФункции

Функция СортироватьКоллекциюСпискомЗначений(знач Коллекция, ИмяПоля=Неопределено, знач НачальныйИндекс=Неопределено, знач КонечныйИндекс=Неопределено, ПоВозрастанию=Истина) Экспорт
	
	Если НачальныйИндекс = Неопределено Тогда
		НачальныйИндекс = 0;
	КонецЕсли; 
	
	Если КонечныйИндекс = Неопределено Тогда
		КонечныйИндекс = Коллекция.Количество()-1;
	КонецЕсли; 
	
	КоличествоЭлементов = КонечныйИндекс - НачальныйИндекс + 1;
	Если КоличествоЭлементов < 2 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТипКоллекции = ТипЗнч(Коллекция);
	
	ПолеЗадано = ИмяПоля <> Неопределено И ЗначениеЗаполнено(ИмяПоля);
	
	Индекс = НачальныйИндекс;
	СписокСортировки = Новый СписокЗначений;
	МассивЭлементов = Новый Массив;
	
	Если ПолеЗадано И НачальныйИндекс = 0 И КоличествоЭлементов = Коллекция.Количество() Тогда
		// самая частая ситуация
		Для Каждого Элемент Из Коллекция Цикл
			ЗначениеЭлемента = Элемент[ИмяПоля];
			СписокСортировки.Добавить(ЗначениеЭлемента, Индекс);
			МассивЭлементов.Добавить(Элемент);
			Индекс = Индекс + 1;
		КонецЦикла;
	Иначе
		Для НомерЭлемента=1 По КоличествоЭлементов Цикл
			Элемент = Коллекция[Индекс];
			ЗначениеЭлемента = ?(ПолеЗадано, Элемент[ИмяПоля], Элемент);
			СписокСортировки.Добавить(ЗначениеЭлемента, Индекс);
			МассивЭлементов.Добавить(Элемент);
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЕсли;
	
	СписокСортировки.СортироватьПоЗначению(?(ПоВозрастанию=Истина, НаправлениеСортировки.Возр, НаправлениеСортировки.Убыв));
	
	//Постобработка
	// по отсортированному списку упорядочим исходную коллекцию
	Если ТипКоллекции = Тип("Массив") Тогда
		НовыйИндекс = НачальныйИндекс;
		Для Каждого ЭлементСписка Из СписокСортировки Цикл
			Индекс = Число(ЭлементСписка.Представление) - НачальныйИндекс;
			Коллекция[НовыйИндекс] = МассивЭлементов[Индекс];
			НовыйИндекс = НовыйИндекс + 1;
		КонецЦикла;
	Иначе
		НовыйИндекс = НачальныйИндекс;
		Для Каждого ЭлементСписка Из СписокСортировки Цикл
			Индекс = Число(ЭлементСписка.Представление) - НачальныйИндекс;
			Элемент = МассивЭлементов[Индекс];
			ТекущийИндекс = Коллекция.Индекс(Элемент);
			Если ТекущийИндекс <> НовыйИндекс Тогда
				Коллекция.Сдвинуть(ТекущийИндекс, НовыйИндекс-ТекущийИндекс);
			КонецЕсли;
			НовыйИндекс = НовыйИндекс + 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

///////////////////////////////////////////////////////////////////
//
//				Массивы+
//

#Область Массивы
Функция НовыйМассив(Значение1=null, Значение2=null, Значение3=null, Значение4=null, Значение5=null) Экспорт
	
	НовыйМассив = Новый Массив;
	Если Значение1 <> null Тогда
		НовыйМассив.Добавить(Значение1);
		Если Значение2 <> null Тогда
			НовыйМассив.Добавить(Значение2);
			Если Значение3 <> null Тогда
				НовыйМассив.Добавить(Значение3);
				Если Значение4 <> null Тогда
					НовыйМассив.Добавить(Значение4);
					Если Значение5 <> null Тогда
						НовыйМассив.Добавить(Значение5);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат НовыйМассив;
	
КонецФункции

Функция НовыйДиапазон(Начало, Конец) Экспорт
	
	Диапазон = Новый Массив;
	
	Если Начало > Конец Тогда
		Для Номер=0 По Начало-Конец Цикл
			Диапазон.Добавить(Начало-Номер);
		КонецЦикла;
	Иначе
		Для Номер=0 По Конец-Начало Цикл
			Диапазон.Добавить(Начало+Номер);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Диапазон;
	
КонецФункции

Функция СортироватьМассив(Массив, НачальныйИндекс=Неопределено, КонечныйИндекс=Неопределено, ПоВозрастанию=Истина) Экспорт
	
	Возврат СортироватьКоллекциюОбщ(Массив, , НачальныйИндекс, КонечныйИндекс, ПоВозрастанию);
	
КонецФункции

Функция СортироватьМассивБинарно(Массив, РасширенныйРезультат=Неопределено) Экспорт
	
	МассивСортированный = Новый Массив;
	ДвиженияЗначений = ДобавитьЗначенияВОтсортированныйМассив(МассивСортированный, Массив);
	
	ИндексыЗначений = Новый Массив;
	Для НомерЭлемента=0 По Массив.Количество()-1 Цикл
		ИндексыЗначений.Вставить(ДвиженияЗначений[НомерЭлемента], НомерЭлемента);
	КонецЦикла;
	
	РасширенныйРезультат = Новый Структура;
	РасширенныйРезультат.Вставить("МассивСортированный", МассивСортированный);
	РасширенныйРезультат.Вставить("ДвиженияЗначений", ДвиженияЗначений);
	РасширенныйРезультат.Вставить("ИндексыЗначений", ИндексыЗначений);
	
	Возврат МассивСортированный;
	
КонецФункции

Функция ДобавитьЗначенияВОтсортированныйМассив(Массив, Значения) Экспорт
	
	ДвиженияЗначений = Новый Массив;
	КоличествоЗначений = Значения.Количество();
	
	НомерЗначения = 0;
	
	Если Массив.Количество()=0 Тогда
		Номер = 0;
		Массив.Вставить(Номер, Значения[НомерЗначения]);
		ДвиженияЗначений.Добавить(Номер);
		НомерЗначения = НомерЗначения + 1;
	КонецЕсли;
	
	Пока НомерЗначения < КоличествоЗначений Цикл
		Значение = Значения[НомерЗначения];
		Начало = 0;
		Конец = Массив.Количество()-1;
		Пока Истина Цикл
			Номер = Цел((Начало+Конец)/2);
			ЗначениеВМассиве = Массив[Номер];
			Если Значение < ЗначениеВМассиве Тогда
				Если Номер=Начало Тогда
					Прервать;
				КонецЕсли;
				Конец = Номер-1;
			ИначеЕсли Значение > ЗначениеВМассиве Тогда
				Если Номер=Конец Тогда
					Номер = Номер + 1;
					Прервать;
				КонецЕсли;
				Начало = Номер+1;
			Иначе
				Номер = Номер + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Массив.Вставить(Номер, Значение);
		ДвиженияЗначений.Добавить(Номер);
		НомерЗначения = НомерЗначения + 1;
	КонецЦикла;
	
	Возврат ДвиженияЗначений;
	
КонецФункции

Функция ПеремешатьМассив(Массив) Экспорт
	
	ГенераторСлучайныхЧисел = Новый ГенераторСлучайныхЧисел;
	
	ПоследнийНомер = Массив.Количество()-1;
	Для Номер=0 По ПоследнийНомер Цикл
		
		ВыбранныйНомер = ГенераторСлучайныхЧисел.СлучайноеЧисло(Номер, ПоследнийНомер);
		
		Если Номер <> ВыбранныйНомер Тогда
			 Элемент = Массив[Номер];
			 Массив[Номер] = Массив[ВыбранныйНомер];
			 Массив[ВыбранныйНомер] = Элемент;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

// Помещает значение в массив. Если значение уже в массиве - вернет тот же массив
//
// Параметры:
//  Значение				ЛюбоеЗначение - 	 - если передать массив - то вернется он же или его копия. Если строка, то массив значений в строке через разделитель
//  Разделитель				Строка - 	 - Разделитель значений (для строки)
//  НовыйМассив				Булево - 	 - Истина - копирует массив, Ложь - возвращает переданный
//  УбратьЛишниеПробелы		Булево - 	 - Убирает пробелы (для строки)
//  ДобавлятьПустуюСтроку	Булево - 	 - Если есть пустая строка - добавить в массив (для строки)
// 
// Возвращаемое значение:
//   - Массив
//
Функция ЗначениеВМассив(Значение, Разделитель=",", НовыйМассив=Истина, УбратьЛишниеПробелы=Истина, ДобавлятьПустуюСтроку=Ложь) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Если НовыйМассив Тогда
			Возврат СкопироватьМассив(Значение);
		Иначе
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ЭтоТаблица(Значение) Тогда
		Если НовыйМассив Тогда
			Возврат ВыгрузитьЭлементыКоллекцииВМассив(Значение)
		Иначе
			Возврат ПолучитьЭлементыКоллекции(Значение);
		КонецЕсли;
	КонецЕсли;
		
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СтрокуВМассив(Значение, Разделитель, УбратьЛишниеПробелы, ДобавлятьПустуюСтроку);
	КонецЕсли;
	
	НовыйМассив = Новый Массив;
	НовыйМассив.Добавить(Значение);
	Возврат НовыйМассив;
	
КонецФункции

Функция СкопироватьМассив(Массив) Экспорт
	
	НовыйМассив = Новый Массив;
	ДобавитьЭлементыКоллекции(НовыйМассив, Массив);
	Возврат НовыйМассив;
	
КонецФункции

Функция ВычестьМассив(Массив, ЗначениеВычитатель) Экспорт
	Удалено = 0;
	МассивВычитатель = ЗначениеВМассив(ЗначениеВычитатель, , Ложь);
	Для Каждого Элемент Из МассивВычитатель Цикл
		Индекс = Массив.Найти(Элемент);
		Если Индекс <> Неопределено Тогда
			Массив.Удалить(Индекс);
			Удалено = Удалено + 1;
		КонецЕсли; 
	КонецЦикла;
	Возврат Удалено;
КонецФункции

Функция ВычитаниеМассивов(Массив, МассивВычитатель) Экспорт
	НовыйМассив = СкопироватьМассив(Массив);
	ВычестьМассив(НовыйМассив, МассивВычитатель);
	Возврат НовыйМассив;
КонецФункции

Функция СложениеМассивов(Массив1, Массив2) Экспорт
	НовыйМассив = Новый Массив;
	ДобавитьЭлементыКоллекции(НовыйМассив, Массив1);
	ДобавитьЭлементыКоллекции(НовыйМассив, Массив2);
	Возврат НовыйМассив;
КонецФункции

Функция ПересечениеМассивов(знач Массив1, знач Массив2, СохранятьПорядок=Ложь) Экспорт
	
	НовыйМассив = Новый Массив;
	
	/////////////////////////////////////
	// Допустимы массивы в виде строк (будут преобразованы в массив)
	
	Массив1 = ЗначениеВМассив(Массив1, , Ложь);
	Массив2 = ЗначениеВМассив(Массив2, , Ложь);
	/////////////////////////////////////
	
	Если Не СохранятьПорядок И Массив1.Количество() > Массив2.Количество() Тогда
		ВремМассив = Массив1;
		Массив1 = Массив2;
		Массив2 = ВремМассив;
	КонецЕсли; 
	
	Для Каждого Элм1 Из Массив1 Цикл
		Если Массив2.Найти(Элм1) <> Неопределено Тогда
			НовыйМассив.Добавить(Элм1);
		КонецЕсли; 
	КонецЦикла;
	
	Возврат НовыйМассив;
	
КонецФункции

Функция РазвернутьЭлементыМассива(Массив, знач НачальныйИндекс=Неопределено, знач КонечныйИндекс=Неопределено) Экспорт
	
	Если НачальныйИндекс = Неопределено Тогда
		НачальныйИндекс = 0;
	КонецЕсли; 
	
	Если КонечныйИндекс = Неопределено Тогда
		КонечныйИндекс = Массив.Количество()-1;
	КонецЕсли; 
	
	КоличествоЭлементов = КонечныйИндекс - НачальныйИндекс + 1;
	
	Серединка = Цел(КоличествоЭлементов / 2) - 1 + НачальныйИндекс;
	ОбратныйИндекс = КонечныйИндекс;
	Для Индекс=НачальныйИндекс По Серединка Цикл
		Элм = Массив[Индекс];
		Массив[Индекс] = Массив[ОбратныйИндекс];
		Массив[ОбратныйИндекс] = Элм;
		ОбратныйИндекс = ОбратныйИндекс - 1;
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция УдалитьДублиВМассиве(Массив, ВОбратномПорядке=Ложь) Экспорт
	
	Найдено = Новый Соответствие;
	
	Если ВОбратномПорядке Тогда
		Индекс = Массив.Количество();
		Пока Индекс > 0 Цикл
			Индекс = Индекс - 1;
			Значение = Массив[Индекс];
			Если Найдено[Значение] = Неопределено Тогда
				Найдено[Значение] = Истина;
			Иначе
				Массив.Удалить(Индекс);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Индекс = 0;
		Количество = Массив.Количество();
		Пока Индекс < Количество Цикл
			Значение = Массив[Индекс];
			Если Найдено[Значение] = Неопределено Тогда
				Найдено[Значение] = Истина;
				Индекс = Индекс + 1;
			Иначе
				Массив.Удалить(Индекс);
				Количество = Количество - 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

Функция ПересчитатьНомераЭлементовПриУдалении(знач НомераЭлементов, знач НомераУдаляемыхЭлементов) Экспорт
	
	РасширенныйРезультатСортировки = Неопределено;
	НомераЭлементов = СортироватьМассивБинарно(НомераЭлементов, РасширенныйРезультатСортировки);
	ИндексыНомеров = РасширенныйРезультатСортировки.ИндексыЗначений;
	
	НомераУдаляемыхЭлементов = СортироватьМассивБинарно(НомераУдаляемыхЭлементов);
	
	НомерЭлементаВСписке = НомераЭлементов.Количество()-1;
	НомерУдаляемогоЭлементаВСписке = НомераУдаляемыхЭлементов.Количество()-1;

	Индексы_и_НомераЭлементов = Новый Массив;
	
	Если НомерЭлементаВСписке >= 0 И НомерУдаляемогоЭлементаВСписке >= 0 Тогда

		НомерЭлемента = НомераЭлементов[НомерЭлементаВСписке];
		НомерУдаляемогоЭлемента = НомераУдаляемыхЭлементов[НомерУдаляемогоЭлементаВСписке];

		Пока Истина Цикл
			
			Если НомерУдаляемогоЭлемента >= НомерЭлемента Тогда
				
				Если НомерУдаляемогоЭлемента=НомерЭлемента Тогда
					Если НомерЭлементаВСписке=0 Тогда
						Прервать;
					КонецЕсли;
					
					НомерЭлементаВСписке = НомерЭлементаВСписке - 1;
					НомерЭлемента = НомераЭлементов[НомерЭлементаВСписке];
				КонецЕсли;

				Если НомерУдаляемогоЭлементаВСписке=0 Тогда
					Прервать;
				КонецЕсли;

				НомерУдаляемогоЭлементаВСписке = НомерУдаляемогоЭлементаВСписке - 1;
				НомерУдаляемогоЭлемента = НомераУдаляемыхЭлементов[НомерУдаляемогоЭлементаВСписке];

			Иначе
				
				НовыйНомерЭлемента = НомерЭлемента - НомерУдаляемогоЭлементаВСписке - 1;
				
				Индекс_и_НомерЭлемента = Новый Массив;
				Индекс_и_НомерЭлемента.Добавить(ИндексыНомеров[НомерЭлементаВСписке]);
				Индекс_и_НомерЭлемента.Добавить(НовыйНомерЭлемента);
				Индексы_и_НомераЭлементов.Добавить(Индекс_и_НомерЭлемента);
				
				Если НомерЭлементаВСписке=0 Тогда
					Прервать;
				КонецЕсли;
				
				НомерЭлементаВСписке = НомерЭлементаВСписке - 1;
				НомерЭлемента = НомераЭлементов[НомерЭлементаВСписке];
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Индексы_и_НомераЭлементов;
	
КонецФункции
#КонецОбласти

//
//				Массивы-
//
///////////////////////////////////////////////////////////////////

Функция НайтиИндексыЭлементовКоллекции(Коллекция, Отбор, НачальныйИндекс=0, ОстановитьсяПослеПервого=Ложь) Экспорт
	НайденныеЭлементы = Новый Массив;
	ПоляЭлемента = СкопироватьСтруктуру(Отбор);
	Индекс = 0;
	Для Каждого Элм Из Коллекция Цикл
		Если Индекс >= НачальныйИндекс Тогда
			ЗаполнитьЗначенияСвойств(ПоляЭлемента, Элм);
			Если СравнитьСтруктуры(ПоляЭлемента, Отбор) Тогда
				НайденныеЭлементы.Добавить(Индекс);
				Если ОстановитьсяПослеПервого Тогда
					Прервать;
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли; 
		Индекс = Индекс + 1;
	КонецЦикла; 
	Возврат НайденныеЭлементы;
КонецФункции

Функция МассивИндексовВМассивЭлементов(Коллекция, МассивИндексов) Экспорт
	МассивЭлементов = Новый Массив;
	Для каждого Индекс Из МассивИндексов Цикл
		Элм = Коллекция[Индекс];
		МассивЭлементов.Добавить(Элм);
	КонецЦикла;
	Возврат МассивЭлементов;
КонецФункции

Функция ПроверитьЕстьИндексКоллекции(Коллекция, СтрокаИндекса) Экспорт

	Если ЭтоТаблицаЗначений(Коллекция) Тогда
		
		Для Каждого Индекс Из Коллекция.Индексы Цикл
			Если Строка(Индекс) = СтрокаИндекса Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		Возврат Коллекция.МенеджерИндексирования.СистемыИндексирования[СтрокаИндекса] <> Неопределено;
		
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ДобавитьИндексКоллекции(Коллекция, СтрокаИндекса) Экспорт
	
	Если ЭтоТаблицаЗначений(Коллекция) Тогда

		Коллекция.Индексы.Добавить(СтрокаИндекса);
		
	ИначеЕсли ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		ДобавитьИндексыКвазиТаблицыЗначений(Коллекция, СтрокаИндекса);
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ИндексироватьКоллекцию(Коллекция, знач Строки=Неопределено) Экспорт
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		Если Строки = Неопределено Тогда
			Строки = Коллекция.Строки;
		КонецЕсли;

		Если Строки = Коллекция.Строки Тогда
			// Переиндексируем все строки
			// делаем ускоренную очистку индекса
			МенеджерИндексирования_ОчиститьИндексы(Коллекция.МенеджерИндексирования);
		КонецЕсли;
		
		МенеджерИндексирования_ИндексироватьКоллекцию(Коллекция.МенеджерИндексирования, Строки);
		
	КонецЕсли;
	
КонецФункции

Функция НайтиЭлементыКоллекции(Коллекция, Отбор, НачальныйИндекс=0, ОстановитьсяПослеПервого=Ложь) Экспорт
	
	#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
			Если Отбор.Количество() > 0 Тогда
				НайденныеСтроки = Коллекция.НайтиСтроки(Отбор);
			Иначе
				НайденныеСтроки = ВыгрузитьЭлементыКоллекцииВМассив(Коллекция);
			КонецЕсли;
			Возврат НайденныеСтроки;
		КонецЕсли; 
	#КонецЕсли
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		Возврат НайтиСтрокиКвазиТаблицыЗначений(Коллекция, Отбор);
	КонецЕсли; 
	
	//////////////////////////////////////////////////////////////
	// универсальный алгоритм
	НайденныеЭлементы = Новый Массив;
	ПоляЭлемента = СкопироватьСтруктуру(Отбор);
	Индекс = 0;
	Для Каждого Элм Из Коллекция Цикл
		Если Индекс >= НачальныйИндекс Тогда
			ЗаполнитьЗначенияСвойств(ПоляЭлемента, Элм);
			Если СравнитьСтруктуры(ПоляЭлемента, Отбор) Тогда
				НайденныеЭлементы.Добавить(Элм);
				Если ОстановитьсяПослеПервого Тогда
					Прервать;
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли; 
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат НайденныеЭлементы;
	
КонецФункции

Функция НайтиЭлементКоллекции(Коллекция, Отбор, НачальныйИндекс=0) Экспорт
	НайденныеЭлементы = НайтиЭлементыКоллекции(Коллекция, Отбор, НачальныйИндекс, Истина);
	Если НайденныеЭлементы.Количество() > 0 Тогда
		Элемент = НайденныеЭлементы[0];
		Возврат Элемент;
	КонецЕсли; 
КонецФункции

// Находит элементы коллекции по указанным параметрам
//
// Параметры:
//  - ОтборИлиЗначение - Структура, Массив, Произвольный - структура с полями отбора, массив элементов или один элемент
//  - ПолеИмени - Строка, Неопределено - в какой колонке искать переданные значения
//  - Коллекция - Массив, ТаблицаЗначений - коллекция, в которой производится поиск элементов
//  - ПоляПоискаПоЗначению - Строка, Массив, Неопределено - имена полей, по которым выполняется поиск значения, 
//                                                          если элемент не найден напрямую
//  - ДополнительныйРезультат - Структура - содержит массивы непринадлежащих коллекции и ненайденных по имени элементов 
//                                          (структура заполняется внутри)
//
// Возвращаемое значение:
//  - Массив - массив найденных элементов коллекции
//
Функция ОтобратьЭлементыКоллекции(Коллекция, знач ОтборИлиЗначение, ПолеИмени=Неопределено, ПоляПоискаПоЗначению=Неопределено, ДополнительныйРезультат=Неопределено) Экспорт
	
	ДополнительныйРезультат = Новый Структура;
	ДополнительныйРезультат.Вставить("НепринадлежащиеКоллекции", Новый Массив);
	ДополнительныйРезультат.Вставить("НенайденныеПоИмени", Новый Массив);
	
	Если ОтборИлиЗначение=Неопределено Тогда
		// Вернем все элементы
		Возврат ВыгрузитьЭлементыКоллекцииВМассив(Коллекция);
	КонецЕсли;
	
	ТипОтбора = ТипЗнч(ОтборИлиЗначение);
	
	Если ТипОтбора=Тип("Структура") Тогда
		
		// Поищем по полям структуры отбора
		Возврат НайтиЭлементыКоллекции(Коллекция, ОтборИлиЗначение);
		
	КонецЕсли;
	
	НайденныеЭлементы = Новый Массив;
	Если ТипОтбора=Тип("Строка") Тогда
		Отбор = СтрокуВМассив(ОтборИлиЗначение);
	ИначеЕсли ТипОтбора <> Тип("Массив") Тогда
		ЭлементОтбора = ОтборИлиЗначение;
		Отбор = Новый Массив;
		Отбор.Добавить(ЭлементОтбора);
	Иначе
		Отбор = ОтборИлиЗначение;
	КонецЕсли;
	
	ЭлементыКоллекции = ПолучитьЭлементыКоллекции(Коллекция);
	
	ТипКоллекции = 0;
	Если ТипЗнч(ЭлементыКоллекции)=Тип("Массив") Тогда
		ТипКоллекции = 1;
	Иначе
		#Если Сервер Тогда
			Если ТипЗнч(ЭлементыКоллекции)=Тип("ТаблицаЗначений") Тогда
				ТипКоллекции = 2;
			КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
	Если ПоляПоискаПоЗначению=Неопределено Тогда
		ПоляПоискаПоЗначению = ПолеИмени;
	КонецЕсли;
	
	Если ПоляПоискаПоЗначению=Неопределено Тогда
		ПоляПоискаПоЗначениюМассив = Новый Массив;
	Иначе
		ПоляПоискаПоЗначениюМассив = ЗначениеВМассив(ПоляПоискаПоЗначению, , Ложь);
	КонецЕсли;
	
	ПоискПоИмени = ПоляПоискаПоЗначениюМассив.Найти(ПолеИмени) <> Неопределено;
	
	Для Каждого Элемент Из Отбор Цикл
		
		Если ТипКоллекции=1 Тогда
			Если ЭлементыКоллекции.Найти(Элемент) <> Неопределено Тогда
				НайденныеЭлементы.Добавить(Элемент);
				Продолжить;
			КонецЕсли;
		ИначеЕсли ТипКоллекции=2 Тогда
			Если ТипЗнч(Элемент)=Тип("СтрокаТаблицыЗначений") И ЭлементыКоллекции=Элемент.Владелец() И ЭлементыКоллекции.Индекс(Элемент) <> -1 Тогда
				НайденныеЭлементы.Добавить(Элемент);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ПоляПоискаПоЗначениюМассив.Количество() > 0 Тогда
			НайденныеЭлементыПоИмени = Новый Массив;
			Для Каждого ПолеПоиска Из ПоляПоискаПоЗначениюМассив Цикл
				ОтборПоЗначению = Новый Структура(ПолеПоиска, Элемент);
				НайденныеЭлементыПоИмени = НайтиЭлементыКоллекции(Коллекция, ОтборПоЗначению);
				Если НайденныеЭлементыПоИмени.Количество() > 0 Тогда
					ДобавитьЭлементыКоллекции(НайденныеЭлементы, НайденныеЭлементыПоИмени);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НайденныеЭлементыПоИмени.Количество()=0 Тогда
				Если ПоискПоИмени И ТипЗнч(Элемент)=Тип("Строка") Тогда
					ДополнительныйРезультат.НенайденныеПоИмени.Добавить(Элемент);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НайденныеЭлементы;
	
КонецФункции

Функция УдалитьЭлементыКоллекцииПоИндексам(Коллекция, МассивИндексов, ОтсортироватьИндексы=Истина) Экспорт
	Если ОтсортироватьИндексы Тогда
		СортироватьМассив(МассивИндексов, , , Ложь);
	КонецЕсли; 
	
	Для Каждого Индекс Из МассивИндексов Цикл
		Коллекция.Удалить(Индекс);
	КонецЦикла; 
КонецФункции

Функция УдалениеЭлементовКоллекции(Коллекция, Элементы) Экспорт
	
	Возврат УдалитьЭлементыКоллекции(СкопироватьОбъект(Коллекция), Элементы);
	
КонецФункции

Функция УдалитьЭлементыКоллекции(Коллекция, Элементы=Неопределено) Экспорт
	
	Если ЭтоТаблицаЗначений(Коллекция) И ТипЗнч(Элементы)=Тип("Структура") Тогда
		МассивЭлементов = Коллекция.НайтиСтроки(Элементы);
	Иначе
		Если Элементы <> Неопределено Тогда
			МассивЭлементов = ЗначениеВМассив(Элементы, , Ложь);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Коллекция)=Тип("Массив") Тогда
		
		Если Элементы=Неопределено Тогда
			Коллекция.Очистить();
		Иначе
			Для Каждого Элемент Из МассивЭлементов Цикл
				Индекс = Коллекция.Найти(Элемент);
				Если Индекс <> Неопределено Тогда
					Коллекция.Удалить(Индекс);
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		УдалитьСтрокиКвазиТаблицыЗначений(Коллекция, Элементы);
		
	ИначеЕсли ТипЗнч(Коллекция)=Тип("ДанныеФормыДерево") Тогда

		Если Элементы=Неопределено Тогда
			Коллекция.ПолучитьЭлементы().Очистить();
		Иначе
			Для Каждого Элемент Из МассивЭлементов Цикл
				РодительЭлемента = Элемент.ПолучитьРодителя();
				Если РодительЭлемента=Неопределено Тогда
					РодительЭлемента = Коллекция;
				КонецЕсли;
				РодительЭлемента.ПолучитьЭлементы().Удалить(Элемент);
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		
		Если Элементы=Неопределено Тогда
			Коллекция.Очистить();
		Иначе
			Для Каждого Элемент Из МассивЭлементов Цикл
				Коллекция.Удалить(Элемент);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Коллекция;
	
КонецФункции

Функция ВыгрузитьЗначенияКолонкиКоллекции(Коллекция, ИмяКолонки) Экспорт
	Значения = Новый Массив;
	Для Каждого Элемент Из ПолучитьЭлементыКоллекции(Коллекция) Цикл
		Значения.Добавить(Элемент[ИмяКолонки]);
	КонецЦикла;
	Возврат Значения;
КонецФункции

Функция ВыгрузитьЗначенияКолонокКоллекции(Коллекция, Колонки=Неопределено) Экспорт
	
	Значения = Новый Массив;
	
	Если Колонки = Неопределено Тогда
		МассивКолонок = ПолучитьКолонкиКоллекции(Коллекция);
		Если МассивКолонок = Неопределено Тогда
			Возврат Значения;
		КонецЕсли;
	Иначе
		МассивКолонок = ЗначениеВМассив(Колонки);
	КонецЕсли;
	
	Для Индекс=0 По МассивКолонок.ВГраница() Цикл
		МассивКолонок[Индекс] = СтрокуВМассив(МассивКолонок[Индекс], ".");
	КонецЦикла;
	
	ЭлементыКоллекции = ПолучитьЭлементыКоллекции(Коллекция);

	Для Каждого Элемент Из ЭлементыКоллекции Цикл
		Для Каждого Колонка Из МассивКолонок Цикл
			Если Колонка.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Значение = Элемент;
			Ошибка = Ложь;
			Для Каждого ЭлмКолонки Из Колонка Цикл
				Попытка
					Значение = Значение[ЭлмКолонки];
				Исключение
					Ошибка = Истина;
					Прервать;
				КонецПопытки;
			КонецЦикла;
			
			Если Не Ошибка Тогда
				Значения.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Значения;

КонецФункции

Функция УпорядочитьЭлементыКоллекцииЗначенийПоМассиву(Коллекция, МассивЭлементов) Экспорт
	
	Если ЭтоТаблицаЗначений(Коллекция) Тогда
		УпорядочитьСтрокиТаблицыЗначенийПоМассиву(Коллекция, МассивЭлементов);
	ИначеЕсли ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		УпорядочитьСтрокиКвазиТаблицыЗначенийПоМассиву(Коллекция, МассивЭлементов);
	КонецЕсли;
	
КонецФункции

Функция ЭтоТаблицаЗначений(Объект) Экспорт
	#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Возврат ТипЗнч(Объект) = Тип("ТаблицаЗначений");
	#Иначе
		Возврат Ложь;
	#КонецЕсли
КонецФункции

Функция ЭтоТипТаблицаЗначений(Тип) Экспорт
	Возврат Тип = ТипТаблицаЗначений();
КонецФункции

Функция ТипТаблицаЗначений() Экспорт
	#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Возврат Тип("ТаблицаЗначений");
	#КонецЕсли
КонецФункции

Функция ТипСтрокаТаблицыЗначений() Экспорт
	#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Возврат Тип("СтрокаТаблицыЗначений");
	#КонецЕсли
КонецФункции

Функция ЭтоТаблица(Объект) Экспорт
	
	Если ЭтоКвазиТаблицаЗначений(Объект) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЭтоТаблицаЗначений(Объект) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ДоступенОбходКоллекции(Коллекция) Экспорт
	
	Попытка
		Для Каждого Элемент Из Коллекция Цикл
			Прервать;
		КонецЦикла;
		Возврат Истина;
	Исключение
	    Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ВыгрузитьЭлементыКоллекцииВМассив(Коллекция, УровеньВложенности=0) Экспорт
	
	МассивЭлементов = Новый Массив;
	
	Для Каждого Элемент Из ПолучитьЭлементыКоллекции(Коллекция) Цикл
		Если УровеньВложенности > 0 Тогда
			ДобавитьЭлементыКоллекции(МассивЭлементов, ВыгрузитьЭлементыКоллекцииВМассив(Элемент, УровеньВложенности-1));
		Иначе
			МассивЭлементов.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЭлементов;
	
КонецФункции

Функция ЗагрузитьЭлементыВКоллекцию(Коллекция, Элементы) Экспорт
	ПоследнийИндекс = Мин(Коллекция.Количество(), Элементы.Количество()) - 1;
	Для Индекс=0 По ПоследнийИндекс Цикл
		ЗаполнитьЗначенияСвойств(Коллекция[Индекс], Элементы[Индекс]);
	КонецЦикла;
КонецФункции

Функция УдалитьПустыеСтрокиКоллекции(Коллекция, Поля=Неопределено) Экспорт
	
	МассивПолей = Неопределено;
	Если Поля = Неопределено Тогда
		#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
			Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
				МассивПолей = ВыгрузитьЗначенияКолонкиКоллекции(Коллекция, "Имя");
			КонецЕсли;
		#КонецЕсли
	Иначе
		МассивПолей = ЗначениеВМассив(Поля);
	КонецЕсли;
	
	УдаляемыеЭлементы = Новый Массив;
	
	НетПолей = МассивПолей = Неопределено;
	
	МассивЭлементовДляУдаления = Новый Массив;
	Для Каждого Элемент Из ПолучитьЭлементыКоллекции(Коллекция) Цикл
		Если НетПолей Тогда
			Заполнено = Элемент <> Неопределено И ЗначениеЗаполнено(Элемент);
		Иначе
			Заполнено = Ложь;
			Для Каждого Поле Из МассивПолей Цикл
				Значение = Элемент[Поле];
				Если Значение <> Неопределено И ЗначениеЗаполнено(Значение) Тогда
					Заполнено = Истина;
					Прервать;
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли;
		
		Если Не Заполнено Тогда
			УдаляемыеЭлементы.Добавить(Элемент);
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьЭлементыКоллекции(Коллекция, УдаляемыеЭлементы);
	
КонецФункции

Функция УдалитьНеположительныеСтрокиКоллекции(Коллекция, Поля=Неопределено) Экспорт
	
	МассивПолей = Неопределено;
	Если Поля = Неопределено Тогда
		#Если Сервер Тогда
			Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
				МассивПолей = ВыгрузитьЗначенияКолонкиКоллекции(Коллекция.Колонки, "Имя");
			КонецЕсли;
		#КонецЕсли
	Иначе
		МассивПолей = ЗначениеВМассив(Поля);
	КонецЕсли;
	
	НетПолей = МассивПолей = Неопределено;
	
	МассивЭлементовДляУдаления = Новый Массив;
	ИндексЭлемента = Коллекция.Количество()-1;
	Для НомерЭлемента=1 По Коллекция.Количество() Цикл
		Элемент = Коллекция[ИндексЭлемента];
		Если НетПолей Тогда
			Положительный = Элемент <> Неопределено И Элемент > 0;
		Иначе
			Положительный = Ложь;
			Для Каждого Поле Из МассивПолей Цикл
				Значение = Элемент[Поле];
				Если Значение <> Неопределено И Значение > 0 Тогда
					Положительный = Истина;
					Прервать;
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли;
		
		Если Не Положительный Тогда
			Коллекция.Удалить(ИндексЭлемента);
		КонецЕсли;
		
		ИндексЭлемента = ИндексЭлемента - 1;
	КонецЦикла;
	
КонецФункции

Функция СоединитьТаблицы(Таблица1, Таблица2, КолонкиСоединения, КолонкиЗаполнения, знач Левое=Истина, знач Правое=Истина) Экспорт
	
	Поиск = Новый Структура(КолонкиСоединения);
	
	Если Не Левое И Правое Тогда
		Левое = Истина;
		Правое = Ложь;
		ТаблицаВрем = Таблица1;
		Таблица1 = Таблица2;
		Таблица2 = Таблица1;
	КонецЕсли;
	
	ДополнитьКолонкиКоллекции(Таблица1, КолонкиЗаполнения);
	ИсходнаяТаблица1 = СкопироватьКоллекцию(Таблица1);
	ОчиститьЭлементыКоллекции(Таблица1);
	
	Внутреннее = Не Левое И Не Правое;
	ВсеНайденныеСтрокиТаблицы2 = Новый Соответствие;
	СтрокиИсходнойТаблицы1 = ПолучитьЭлементыКоллекции(ИсходнаяТаблица1);
	Для Каждого ИсходнаяСтрокаТаблицы1 Из СтрокиИсходнойТаблицы1 Цикл
		ЗаполнитьЗначенияСвойств(Поиск, ИсходнаяСтрокаТаблицы1);
		НайденныеСтрокиТаблицы2 = НайтиЭлементыКоллекции(Таблица2, Поиск);
		Если НайденныеСтрокиТаблицы2.Количество() > 0 Тогда
			Для Каждого СтрокаТаблицы2 Из НайденныеСтрокиТаблицы2 Цикл
				СтрокаТаблицы1 = НовыйЭлементКоллекции(Таблица1);
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы1, ИсходнаяСтрокаТаблицы1);
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы1, СтрокаТаблицы2, КолонкиЗаполнения);
				ВсеНайденныеСтрокиТаблицы2[СтрокаТаблицы2] = Истина;
			КонецЦикла;
		Иначе
			Если Не Внутреннее Тогда
				СтрокаТаблицы1 = НовыйЭлементКоллекции(Таблица1);
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы1, ИсходнаяСтрокаТаблицы1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
	Если Правое Тогда
		СтрокиТаблицы2 = ПолучитьЭлементыКоллекции(Таблица2); 
		Для Каждого СтрокаТаблицы2 Из СтрокиТаблицы2 Цикл
			Если Не ВсеНайденныеСтрокиТаблицы2[СтрокаТаблицы2] = Истина Тогда
				СтрокаТаблицы1 = НовыйЭлементКоллекции(Таблица1);
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы1, СтрокаТаблицы2, КолонкиСоединения);
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы1, СтрокаТаблицы2, КолонкиЗаполнения);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Таблица1;
	
КонецФункции

Функция СравнитьСтруктуры(Структура1, Структура2) Экспорт
	
	Перем Значение2;
	
	Для Каждого Элм1 Из Структура1 Цикл
		Если Не Структура2.Свойство(Элм1.Ключ, Значение2) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Значение1 = Элм1.Значение;
		Если Значение1 <> Значение2 Тогда
			Возврат Ложь;
		КонецЕсли; 
	КонецЦикла;
	
	Для Каждого Элм2 Из Структура2 Цикл
		Если Не Структура1.Свойство(Элм2.Ключ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Получает новую ссылку на новую структуру
//
// Параметры:
//   Структура - Структура - исходная структура.
//
// Возвращаемое значение:
//   Структура - новая структура с данными аналогичными исходной структуре.
//
Функция СкопироватьСтруктуру(Структура) Экспорт
	
	Возврат СкопироватьПоляСтруктуры(Структура, Новый Структура);
	
КонецФункции

// Сохраняет исходную ссылку на структуру.
//
// Параметры:
//   СтруктураИсточник - Структура - структура, из которой копируются поля.
//   СтруктураПриемник - Структура - структура, в которую копируются поля.
//
// Возвращаемое значение:
//   СтруктураПриемник - Cтруктура - приёмник, содеражщий данные аналогичные СтруктураИсточник.
//
Функция СкопироватьПоляСтруктуры(СтруктураИсточник, СтруктураПриемник) Экспорт
	
	Если СтруктураИсточник=СтруктураПриемник Тогда
		Возврат СтруктураПриемник;
	КонецЕсли;
	
	СтруктураПриемник.Очистить();
	
	Для Каждого Элм Из СтруктураИсточник Цикл
		СтруктураПриемник.Вставить(Элм.Ключ, Элм.Значение);
	КонецЦикла;
	
	Возврат СтруктураПриемник;
	
КонецФункции

Функция ПолучитьЗначениеПоляСтруктуры(Структура, ИмяПоля) Экспорт
	
	Перем ЗначениеПоля;
	
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(ИмяПоля, ЗначениеПоля) Тогда
		
		Возврат ЗначениеПоля;
		
	КонецЕсли;
	
КонецФункции

Функция СкопироватьОбъект(знач Объект, Рекурсивно=Ложь, знач МаксимальныйУровень=-1) Экспорт
	
	ПервыйОбъект = Объект;
	
	ТипМассив = Тип("Массив");
	ТипСтруктура = Тип("Структура");
	ТипСоответствие = Тип("Соответствие");
	ТипСписокЗначений = Тип("СписокЗначений");
	ТипТаблицаЗначений = ТипТаблицаЗначений();
	ТипСтрокаТаблицыЗначений = ТипСтрокаТаблицыЗначений();
	
	КопииОбъектов = Новый Соответствие;
	
	КопируемыеОбъекты = Новый Массив;
	
	ОбходОбъектов = Новый Массив;
	ОбходОбъектов.Добавить(ПервыйОбъект);
	
	Уровень = 0;
	Если НЕ Рекурсивно Тогда
		МаксимальныйУровень = 0;
	КонецЕсли;
	
	// Создадим пустые копии объектов и элементов так, как перед тем как заполнять элементы объектов элементы надо также скопировать
	Пока ОбходОбъектов.Количество() > 0 Цикл
		
		ОбходЭлементовОбъектов = Новый Массив;
		Для Каждого Объект Из ОбходОбъектов Цикл
			
			Если Объект=Неопределено ИЛИ КопииОбъектов[Объект] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТипОбъекта = ТипЗнч(Объект);
			Если ТипОбъекта=ТипМассив Тогда
				КопииОбъектов[Объект] = Новый Массив;
				Для Каждого ЭлементОбъекта Из Объект Цикл
					ОбходЭлементовОбъектов.Добавить(ЭлементОбъекта);
				КонецЦикла;
				КопируемыеОбъекты.Добавить(Объект);
			ИначеЕсли ТипОбъекта=ТипСтруктура Тогда
				КопииОбъектов[Объект] = Новый Структура;
				Для Каждого ЭлементОбъекта Из Объект Цикл
					ОбходЭлементовОбъектов.Добавить(ЭлементОбъекта.Значение);
				КонецЦикла;
				КопируемыеОбъекты.Добавить(Объект);
			ИначеЕсли ТипОбъекта=ТипСоответствие Тогда
				КопииОбъектов[Объект] = Новый Соответствие;
				Для Каждого ЭлементОбъекта Из Объект Цикл
					ОбходЭлементовОбъектов.Добавить(ЭлементОбъекта.Ключ);
					ОбходЭлементовОбъектов.Добавить(ЭлементОбъекта.Значение);
				КонецЦикла;
				КопируемыеОбъекты.Добавить(Объект);
			ИначеЕсли ТипОбъекта=ТипСписокЗначений Тогда
				КопииОбъектов[Объект] = Новый СписокЗначений;
				Для Каждого ЭлементОбъекта Из Объект Цикл
					ОбходЭлементовОбъектов.Добавить(ЭлементОбъекта.Значение);
				КонецЦикла;
				КопируемыеОбъекты.Добавить(Объект);
			ИначеЕсли ТипОбъекта=ТипТаблицаЗначений ИЛИ ТипОбъекта=ТипСтрокаТаблицыЗначений Тогда
				Если ТипОбъекта=ТипСтрокаТаблицыЗначений Тогда
					// копируем таблицу целиком
					Объект = Объект.Владелец();
				КонецЕсли;
				
				КопияТаблицы = Объект.СкопироватьКолонки();
				КопииОбъектов[Объект] = КопияТаблицы;
				
				Для Каждого ЭлементОбъекта Из Объект Цикл
					КопииОбъектов[ЭлементОбъекта] = КопияТаблицы.Добавить();
					Для Каждого ЗначениеЯчейки Из ЭлементОбъекта Цикл
						ОбходЭлементовОбъектов.Добавить(ЗначениеЯчейки);
					КонецЦикла;
				КонецЦикла;
				
				КопируемыеОбъекты.Добавить(Объект);
			Иначе
				КопииОбъектов[Объект] = Объект;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Уровень=МаксимальныйУровень Тогда
			// Достигнут максимальный уровень копирования
			// далее элементы объектов не копируются, в копии объектов будут вставлены первоначальные элементы
			Для Каждого Объект Из ОбходЭлементовОбъектов Цикл
				Если КопииОбъектов[Объект]=Неопределено Тогда
					КопииОбъектов[Объект] = Объект;
				КонецЕсли;
			КонецЦикла;
			Прервать;
		КонецЕсли;
		
		ОбходОбъектов = ОбходЭлементовОбъектов;
		
		Уровень = Уровень + 1;
		
	КонецЦикла;
	
	// Заполним элементы копий объектов после того, как их элементы также были скопированы
	Для Каждого Объект Из КопируемыеОбъекты Цикл
		
		КопияОбъекта = КопииОбъектов[Объект];
		
		ТипОбъекта = ТипЗнч(Объект);
		
		Если ТипОбъекта=ТипМассив Тогда
			Для Каждого ЭлементОбъекта Из Объект Цикл
				КопияЭлемента = КопииОбъектов[ЭлементОбъекта];
				КопияОбъекта.Добавить(КопияЭлемента);
			КонецЦикла;
		ИначеЕсли ТипОбъекта=ТипСтруктура Тогда
			Для Каждого ЭлементОбъекта Из Объект Цикл
				КопияЭлемента = КопииОбъектов[ЭлементОбъекта.Значение];
				КопияОбъекта.Вставить(ЭлементОбъекта.Ключ, КопияЭлемента);
			КонецЦикла;
		ИначеЕсли ТипОбъекта=ТипСоответствие Тогда
			Для Каждого ЭлементОбъекта Из Объект Цикл
				КопияКлюча = КопииОбъектов[ЭлементОбъекта.Ключ];
				КопияЗначения = КопииОбъектов[ЭлементОбъекта.Значение];
				КопияОбъекта.Вставить(КопияКлюча, КопияЗначения);
			КонецЦикла;
		ИначеЕсли ТипОбъекта=ТипСписокЗначений Тогда
			Для Каждого ЭлементОбъекта Из Объект Цикл
				КопияЭлементаОбъекта = КопияОбъекта.Добавить();
				ЗаполнитьЗначенияСвойств(КопияЭлементаОбъекта, ЭлементОбъекта);
				КопияЗначения = КопииОбъектов[ЭлементОбъекта.Значение];
				КопияЭлементаОбъекта.Значение = КопияЗначения;
			КонецЦикла;
		ИначеЕсли ТипОбъекта=ТипТаблицаЗначений Тогда
			Для Каждого ЭлементОбъекта Из Объект Цикл
				КопияЭлемента = КопииОбъектов[ЭлементОбъекта];
				ИндексЯчейки = 0;
				Для Каждого ЗначениеЯчейки Из ЭлементОбъекта Цикл
					КопияЭлемента[ИндексЯчейки] = КопииОбъектов[ЗначениеЯчейки];
					ИндексЯчейки = ИндексЯчейки + 1;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	КопияОбъекта = КопииОбъектов[ПервыйОбъект];
	
	Возврат КопияОбъекта;
	
КонецФункции

Функция СкопироватьОбъектСтар(Объект, Рекурсивно=Ложь, МаксимальныйУровень=-1) Экспорт
	
	Если Рекурсивно Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("СоответствиеОбъектов", Новый Соответствие);
		ДополнительныеПараметры.Вставить("МаксимальныйУровень", МаксимальныйУровень);
		ДополнительныеПараметры.Вставить("Уровень", 0);
	Иначе
		ДополнительныеПараметры = Неопределено;
	КонецЕсли;
	
	Возврат СкопироватьОбъектВнутр(Объект, Рекурсивно, ДополнительныеПараметры);
	
КонецФункции

Функция СкопироватьОбъектВнутр(Объект, Рекурсивно, ДополнительныеПараметры)

	Если Рекурсивно Тогда
		
		Если ДополнительныеПараметры.Уровень = ДополнительныеПараметры.МаксимальныйУровень Тогда
			Возврат Объект;
		КонецЕсли;
		
		Если Объект = Неопределено Тогда
			Возврат Объект;
		КонецЕсли;
		
		НовыйОбъект = ДополнительныеПараметры.СоответствиеОбъектов[Объект];
		Если НовыйОбъект <> Неопределено Тогда
			Возврат НовыйОбъект;
		КонецЕсли;
		
		ДополнительныеПараметры.Уровень = ДополнительныеПараметры.Уровень + 1;
		
	КонецЕсли;
	
	ТипОбъекта = ТипЗнч(Объект);
	ТипТаблицаЗначений = ТипТаблицаЗначений();
	ТипСтрокаТаблицыЗначений = ТипСтрокаТаблицыЗначений();
	
	Если ТипОбъекта = Тип("Структура") ИЛИ ТипОбъекта = Тип("Соответствие") Тогда
		
		Если ТипОбъекта = Тип("Структура") Тогда
			НовыйОбъект = Новый Структура;
		Иначе
			НовыйОбъект = Новый Соответствие;
		КонецЕсли; 
		
		Если Рекурсивно Тогда
			СоответствиеОбъектов = ДополнительныеПараметры.СоответствиеОбъектов;
			СоответствиеОбъектов[Объект] = НовыйОбъект;
			Для Каждого КлючЗначение Из Объект Цикл
				НовыйОбъект.Вставить(СкопироватьОбъектВнутр(КлючЗначение.Ключ, Рекурсивно, ДополнительныеПараметры), СкопироватьОбъектВнутр(КлючЗначение.Значение, Рекурсивно, ДополнительныеПараметры));
			КонецЦикла;
		Иначе
			Для Каждого КлючЗначение Из Объект Цикл
				НовыйОбъект.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = Тип("Массив") Тогда

		НовыйОбъект = Новый Массив;
		
		Если Рекурсивно Тогда
			СоответствиеОбъектов = ДополнительныеПараметры.СоответствиеОбъектов;
			СоответствиеОбъектов[Объект] = НовыйОбъект;
			Для Каждого Элемент Из Объект Цикл
				НовыйОбъект.Добавить(СкопироватьОбъектВнутр(Элемент, Рекурсивно, ДополнительныеПараметры));
			КонецЦикла;
		Иначе
			Для Каждого Элемент Из Объект Цикл
				НовыйОбъект.Добавить(Элемент);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = ТипСтрокаТаблицыЗначений Тогда
		
		Если Рекурсивно Тогда
			ТаблицаЗначений = Объект.Владелец();
			КопияТаблицыЗначений = СкопироватьОбъектВнутр(ТаблицаЗначений, Рекурсивно, ДополнительныеПараметры);

			ИндекЭлемента = ТаблицаЗначений.Индекс(Объект);
			НовыйОбъект = КопияТаблицыЗначений[ИндекЭлемента];

			СоответствиеОбъектов = ДополнительныеПараметры.СоответствиеОбъектов;
			СоответствиеОбъектов[Объект] = НовыйОбъект;
		Иначе
			НовыйОбъект = Объект;
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = ТипТаблицаЗначений Тогда
		
		Если Рекурсивно Тогда
			НовыйОбъект = Объект.Скопировать();

			СоответствиеОбъектов = ДополнительныеПараметры.СоответствиеОбъектов;
			СоответствиеОбъектов[Объект] = НовыйОбъект;
		Иначе
			НовыйОбъект = Объект;
		КонецЕсли;
		
	Иначе
		
		НовыйОбъект = Объект;
		
	КонецЕсли;
	
	Возврат НовыйОбъект;
	
КонецФункции

Функция ОбщаяЧастьСтрокЛев(Строка1, Строка2) Экспорт
	
	Длина = Мин(СтрДлина(Строка1), СтрДлина(Строка2));
	
	ОбщаяЧасть = "";
	Для Номер=1 По Длина Цикл
		с1 = Сред(Строка1, Номер, 1);
		с2 = Сред(Строка2, Номер, 1);
		Если с1 <> с2 Тогда
			Прервать;
		КонецЕсли;
		
		ОбщаяЧасть = ОбщаяЧасть + с1;
	КонецЦикла;
	
	Возврат ОбщаяЧасть;
	
КонецФункции

Функция МассивОбъектовВМассивТипов(МассивОбъектов) Экспорт
	МассивТипов = Новый Массив;
	Для Каждого Объект Из МассивОбъектов Цикл
		ТипОбъекта = ТипЗнч(Объект);
		Если МассивТипов.Найти(ТипОбъекта) = Неопределено Тогда
			МассивТипов.Добавить(ТипОбъекта);
		КонецЕсли; 
	КонецЦикла;
	Возврат МассивТипов;
КонецФункции

Функция ПолучитьПолеСоответствия(Соответствие, Ключ, ЗначениеПоУмолчанию) Экспорт
	Значение = Соответствие[Ключ];
	Если Значение = Неопределено Тогда
		Если ТипЗнч(ЗначениеПоУмолчанию) = Тип("Тип") Тогда
			Значение = Новый(ЗначениеПоУмолчанию);
		Иначе
			Значение = ЗначениеПоУмолчанию;
		КонецЕсли;
		Соответствие[Ключ] = Значение;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция РазложитьСтрокуНаПрефиксИЧисловойСуффикс(Строка, Префикс="", Суффикс="") Экспорт
	
	ДлинаСтроки = СтрДлина(Строка);
	НомерСимвола = ДлинаСтроки;
	Пока НомерСимвола > 0 Цикл
		Символ = Сред(Строка, НомерСимвола, 1);
		Если Найти("1234567890", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		
		НомерСимвола = НомерСимвола - 1;
	КонецЦикла;
	
	Префикс = Лев(Строка, НомерСимвола);
	Суффикс = Прав(Строка, ДлинаСтроки-НомерСимвола);
	
КонецФункции

// Функция - Получить имя программной переменной
// Получает имя, отвечающее правилам написания имени программной переменной (имя не должно содержать пробелов и
// начинаться с цифры)
//
// Параметры:
//  Строка - Строка - произвольная строка.
// 
// Возвращаемое значение:
//  Строка - имя программной переменной 
//
Функция ПолучитьИмяПрограммнойПеременнойИзСтроки(знач Строка) Экспорт
	
	// Удалим лишние пробелы
	Строка = СокрЛП(Строка);
	Если Строка = "" Тогда
		Возврат "_";
	КонецЕсли;
	
	Строка = УдалитьМножественныеПробелы(Строка);
	
	Если вмс_РаботаСКоллекциямиПовтИсп.ЭтоЦифровойСимвол(Лев(Строка, 1)) Тогда
		Строка = "_" + Строка;
	КонецЕсли;
	
	// Разобьем на слова
	МассивПодстрок = СтрокуВМассив(Строка, " ");
	Строка = "";
	Для Каждого Подстрока Из МассивПодстрок Цикл
		Подстрока = УдалитьНедопустимыеСимволыДляИмениПрограммнойПеременной(Подстрока);
		Строка = Строка + ВРег(Лев(Подстрока, 1)) + Сред(Подстрока, 2);
	КонецЦикла;
	
	Возврат Строка;
	
КонецФункции

Функция ПроверитьИмяПрограммнойПеременной(Имя) Экспорт
	
	КорректноеИмя = ПолучитьИмяПрограммнойПеременнойИзСтроки(Имя);
	
	Возврат НРег(КорректноеИмя) = НРег(Имя);
	
КонецФункции

Функция УдалитьМножественныеПробелы(знач Строка) Экспорт
	
	Пока Истина Цикл
		ДлинаДо = СтрДлина(Строка);
		Строка = СтрЗаменить(Строка, "  ", " ");
		Если ДлинаДо = СтрДлина(Строка) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Строка;
	
КонецФункции

Функция УдалитьНедопустимыеСимволыДляИмениПрограммнойПеременной(Строка) Экспорт
	
	МассивДопустимыхСимволов = вмс_РаботаСКоллекциямиПовтИсп.ПолучитьМассивДопустимыхСимволовИмениПрограммнойПеременной();
	
	НоваяСтрока = "";
	Для НомерСимвола=1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, НомерСимвола, 1);
		Если МассивДопустимыхСимволов.Найти(Символ) <> Неопределено Тогда
			НоваяСтрока = НоваяСтрока + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НоваяСтрока;
	
КонецФункции

Функция ДобавитьОтступСтрок(МультиСтрока, знач СимволыОтступа=Неопределено) Экспорт
	
	Если СимволыОтступа = Неопределено Тогда
		СимволыОтступа = Символы.Таб;
	КонецЕсли;
	
	МассивСтрок = ЗначениеВМассив(МультиСтрока, Символы.ПС, Ложь, Ложь);
	МассивСтрокСОтступами = Новый Массив;
	Для Каждого Строка Из МассивСтрок Цикл
		МассивСтрокСОтступами.Добавить(СимволыОтступа + Строка);
	КонецЦикла;
	МультиСтрокаСОтступами = МассивВСтроку(МассивСтрокСОтступами, Символы.ПС);
	
	Возврат МультиСтрокаСОтступами;
	
КонецФункции

// Ссылка на значение это коллекция + имя поля в коллекции
// С помощью нее можно получать и устанавливать значения
//
// Параметры:
//  Данные - Структура, Соответствие, Массив, ТаблицаЗначений - исходные данные,
//           для которых требуется получить ссылки на вложенные значения.
//  ДополнительныеПараметры - Структура, Неопределено - параметры разложения
//                            и контейнер дополнительного результата.
//
// Возвращаемое значение:
//  Массив - массив ссылок на значения.
//
Функция РазложитьСтруктуруДанныхВМассивСсылокНаЗначения(Данные, ДополнительныеПараметры=Неопределено) Экспорт
	
	Перем Удостоверение;
	
	ПоляСсылкиНаЗначение = ПоляСсылкиНаЗначение();
	
	Контейнер = Новый Массив;
	Контейнер.Добавить(Данные);
	СсылкаНаЗначение = Новый Структура(ПоляСсылкиНаЗначение, Контейнер, 0, Данные);
	
	СсылкиНаЗначения = Новый Массив;
	СсылкиНаЗначения.Добавить(СсылкаНаЗначение);
	
	УдалитьСсылкиНаЗначения = Новый Массив;
	УдалитьСсылкиНаЗначения.Добавить(0);
	
	ТипСтруктура = Тип("Структура");
	ТипСоответствие = Тип("Соответствие");
	ТипМассив = Тип("Массив");
	ТипУсловноеОформлениеКомпоновкиДанных = Тип("УсловноеОформлениеКомпоновкиДанных");
	ТипЭлементОтбораКомпоновкиДанных = Тип("ЭлементОтбораКомпоновкиДанных");
	#Если Сервер Тогда
		ТипТаблицаЗначений = Тип("ТаблицаЗначений");
	#КонецЕсли
	
	УдостоверениеКЗ = ПолучитьУдостоверениеКвазиСсылки();
	
	НеРазлагатьТаблицы = ПолучитьЗначениеПоляСтруктуры(ДополнительныеПараметры, "НеРазлагатьТаблицы") = Истина;
	НеРазлагатьКвазиСсылки = ПолучитьЗначениеПоляСтруктуры(ДополнительныеПараметры, "НеРазлагатьКвазиСсылки");
	Если НеРазлагатьКвазиСсылки = Неопределено Тогда
		НеРазлагатьКвазиСсылки = Истина;
	Иначе
		НеРазлагатьКвазиСсылки = НеРазлагатьКвазиСсылки = Истина;
	КонецЕсли;
	
	МассивСсылокНаКвазиСсылки = Новый Массив;
	МассивСсылокНаКвазиТаблицы = Новый Массив;
	МассивСсылокНаТаблицы = Новый Массив;
	МассивЗаменКлючейСоответствий = Новый Массив;
	
	ОбработанныеЭлементы = Новый Соответствие;
	
	Для Каждого ОбходСсылкиНаЗначение Из СсылкиНаЗначения Цикл
		
		ЭлементКоллекции = ОбходСсылкиНаЗначение.Значение;
		
		ТипЭлемента = ТипЗнч(ЭлементКоллекции);
		
		Если ТипЭлемента = ТипСтруктура ИЛИ ТипЭлемента = ТипСоответствие Тогда
			
			Если ТипЭлемента = ТипСтруктура Тогда
				
				Если ЭлементКоллекции.Свойство("Удостоверение", Удостоверение) И Удостоверение = УдостоверениеКЗ Тогда
					
					МассивСсылокНаКвазиСсылки.Добавить(ОбходСсылкиНаЗначение);
					
					Если НеРазлагатьКвазиСсылки Тогда
						Продолжить;
					КонецЕсли;
					
				ИначеЕсли ЭтоКвазиТаблицаЗначений(ЭлементКоллекции) Тогда
					
					МассивСсылокНаКвазиТаблицы.Добавить(ОбходСсылкиНаЗначение);
					
					Если НеРазлагатьТаблицы Тогда
						Продолжить;
					КонецЕсли;
					
					Если ОбработанныеЭлементы[ЭлементКоллекции] = Истина Тогда
						Продолжить;
					КонецЕсли;
					ОбработанныеЭлементы[ЭлементКоллекции] = Истина;
					
					Для Каждого СтрокаТаблицы Из ЭлементКоллекции.Строки Цикл
						ОбработанныеЭлементы[СтрокаТаблицы] = Истина;
						Для Каждого Колонка Из ЭлементКоллекции.Колонки Цикл
							ИмяКолонки = Колонка.Ключ;
							СсылкаНаЗначение = Новый Структура(ПоляСсылкиНаЗначение, СтрокаТаблицы, ИмяКолонки, СтрокаТаблицы[ИмяКолонки]);
							СсылкиНаЗначения.Добавить(СсылкаНаЗначение);
						КонецЦикла;
					КонецЦикла;
					
					Продолжить;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ОбработанныеЭлементы[ЭлементКоллекции] = Истина Тогда
				Продолжить;
			КонецЕсли;
			ОбработанныеЭлементы[ЭлементКоллекции] = Истина;
			
			Для Каждого ПодЭлемент Из ЭлементКоллекции Цикл
				СсылкаНаЗначение = Новый Структура(ПоляСсылкиНаЗначение, ЭлементКоллекции, ПодЭлемент.Ключ, ПодЭлемент.Значение);
				СсылкиНаЗначения.Добавить(СсылкаНаЗначение);
			КонецЦикла;
			
			Если ТипЭлемента = ТипСоответствие Тогда
				// добавить также обработку ключей
				Для Каждого ПодЭлемент Из ЭлементКоллекции Цикл
					Ключ = ПодЭлемент.Ключ;
					ЗаменаКлючаСоответствия = Новый Структура("Соответствие, Ключ, НовыйКлюч", ЭлементКоллекции, Ключ, Ключ);
					МассивЗаменКлючейСоответствий.Добавить(ЗаменаКлючаСоответствия);
					
					СсылкаНаЗначение = Новый Структура(ПоляСсылкиНаЗначение, ЗаменаКлючаСоответствия, "НовыйКлюч", Ключ);
					СсылкиНаЗначения.Добавить(СсылкаНаЗначение);
				КонецЦикла;
			КонецЕсли;
			
		ИначеЕсли ТипЭлемента = ТипМассив Тогда
			
			Если ОбработанныеЭлементы[ЭлементКоллекции] = Истина Тогда
				Продолжить;
			КонецЕсли;
			ОбработанныеЭлементы[ЭлементКоллекции] = Истина;
			
			ИндексПодЭлемента = 0;
			Для Каждого ПодЭлемент Из ЭлементКоллекции Цикл
				СсылкаНаЗначение = Новый Структура(ПоляСсылкиНаЗначение, ЭлементКоллекции, ИндексПодЭлемента, ПодЭлемент);
				СсылкиНаЗначения.Добавить(СсылкаНаЗначение);
				ИндексПодЭлемента = ИндексПодЭлемента + 1;
			КонецЦикла;
			
		ИначеЕсли ТипЭлемента = ТипЭлементОтбораКомпоновкиДанных Тогда
			
			Если ОбработанныеЭлементы[ЭлементКоллекции] = Истина Тогда
				Продолжить;
			КонецЕсли;
			ОбработанныеЭлементы[ЭлементКоллекции] = Истина;
			
			ИмяКолонки = "ПравоеЗначение";
			Значение = ЭлементКоллекции[ИмяКолонки];
			СсылкаНаЗначение = Новый Структура(ПоляСсылкиНаЗначение, ЭлементКоллекции, ИмяКолонки, Значение);
			СсылкиНаЗначения.Добавить(СсылкаНаЗначение);
			
		ИначеЕсли ТипЭлемента = ТипУсловноеОформлениеКомпоновкиДанных Тогда
			
			Если ОбработанныеЭлементы[ЭлементКоллекции] = Истина Тогда
				Продолжить;
			КонецЕсли;
			ОбработанныеЭлементы[ЭлементКоллекции] = Истина;
			
			Для Каждого ЭлементОформления Из ЭлементКоллекции.Элементы Цикл
				Для Каждого ЭлементОтбораКомпоновкиДанных Из ЭлементОформления.Отбор.Элементы Цикл
					СсылкаНаЗначение = Новый Структура(ПоляСсылкиНаЗначение, , , ЭлементОтбораКомпоновкиДанных);
					СсылкиНаЗначения.Добавить(СсылкаНаЗначение);
					УдалитьСсылкиНаЗначения.Добавить(СсылкиНаЗначения.ВГраница());
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
		#Если Сервер Тогда
			Если ТипЭлемента = ТипТаблицаЗначений Тогда
				
				МассивСсылокНаТаблицы.Добавить(ОбходСсылкиНаЗначение);
				
				Если НеРазлагатьТаблицы Тогда
					Продолжить;
				КонецЕсли;
				
				Если ОбработанныеЭлементы[ЭлементКоллекции] = Истина Тогда
					Продолжить;
				КонецЕсли;
				ОбработанныеЭлементы[ЭлементКоллекции] = Истина;
				
				ИндексПоследнейКолонки = ЭлементКоллекции.Колонки.Количество()-1;
				Для Каждого СтрокаТаблицы Из ЭлементКоллекции Цикл
					ОбработанныеЭлементы[СтрокаТаблицы] = Истина;
					Для ИндексКолонки=0 По ИндексПоследнейКолонки Цикл
						СсылкаНаЗначение = Новый Структура(ПоляСсылкиНаЗначение, СтрокаТаблицы, ИндексКолонки, СтрокаТаблицы[ИндексКолонки]);
						СсылкиНаЗначения.Добавить(СсылкаНаЗначение);
					КонецЦикла;
				КонецЦикла;
				
				Продолжить;
				
			КонецЕсли;
		#КонецЕсли
		
	КонецЦикла;
	
	//очистка
	Индекс = УдалитьСсылкиНаЗначения.Количество();
	Пока Индекс > 0 Цикл
		Индекс = Индекс - 1;
		ИндексСсылки = УдалитьСсылкиНаЗначения[Индекс];
		СсылкиНаЗначения.Удалить(ИндексСсылки);
	КонецЦикла;
	
	// дополнительный результат
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Вставить("МассивСсылокНаКвазиСсылки", МассивСсылокНаКвазиСсылки);
		ДополнительныеПараметры.Вставить("МассивСсылокНаКвазиТаблицы", МассивСсылокНаКвазиТаблицы);
		ДополнительныеПараметры.Вставить("МассивСсылокНаТаблицы", МассивСсылокНаТаблицы);
		ДополнительныеПараметры.Вставить("МассивЗаменКлючейСоответствий", МассивЗаменКлючейСоответствий);
	КонецЕсли;
	
	// основной результат
	Возврат СсылкиНаЗначения;
	
КонецФункции

Функция ЗаменитьКлючиСоответствий(ЗаменыКлючейСоответствий) Экспорт
	
	МассивЗаменКлючейСоответствий = ЗначениеВМассив(ЗаменыКлючейСоответствий, , Ложь);
	
	Для Каждого ЗаменаКлючаСоответствия Из МассивЗаменКлючейСоответствий Цикл
		Соответствие = ЗаменаКлючаСоответствия.Соответствие;
		ДанныеКлюча = Соответствие[ЗаменаКлючаСоответствия.Ключ];
		Соответствие.Удалить(ЗаменаКлючаСоответствия.Ключ);
		Соответствие.Вставить(ЗаменаКлючаСоответствия.НовыйКлюч, ДанныеКлюча);
	КонецЦикла;
	
КонецФункции

Функция НоваяСсылкаНаЗначение(Коллекция=Неопределено, ИмяПоля=Неопределено, Значение=Неопределено) Экспорт
	
