//
//				Деревья+
//

Функция ПолучитьПодчиненныеЭлементыКоллекции(Коллекция, МаксимальныйУровеньВложенности=0) Экспорт
	
	Элементы = Новый Массив;
	
	Если ТипЗнч(Коллекция)=Тип("Массив") Тогда
		Для Каждого Элемент Из Коллекция Цикл
			Элементы.Добавить(Элемент);
		КонецЦикла;
	Иначе
		Элементы.Добавить(Коллекция);
	КонецЕсли;
	
	// понадобится при удалении корней
	КоличествоКорней = Элементы.Количество();

	НомерЭлемента = 0;
	КоличествоЭлементов = Элементы.Количество();
	Уровень = 0;
	Пока НомерЭлемента < КоличествоЭлементов Цикл

		Пока НомерЭлемента < КоличествоЭлементов Цикл
			
			Элемент = Элементы[НомерЭлемента];
			
			ИмяТипа = Строка(ТипЗнч(Элемент));
			
			Если ИмяТипа="ДеревоЗначений" ИЛИ ИмяТипа="СтрокаДереваЗначений" Тогда
				ПодчиненныеЭлементыКоллекции = Элемент.Строки;
			ИначеЕсли ИмяТипа="ДанныеФормыДерево" ИЛИ ИмяТипа="ДанныеФормыЭлементДерева" Тогда
				ПодчиненныеЭлементыКоллекции = Элемент.ПолучитьЭлементы();
			Иначе
				ПодчиненныеЭлементыКоллекции = Новый Массив;
			КонецЕсли;
			
			Для Каждого ПодчиненныйЭлемент Из ПодчиненныеЭлементыКоллекции Цикл
				Элементы.Добавить(ПодчиненныйЭлемент);
			КонецЦикла;
			
			НомерЭлемента = НомерЭлемента + 1;

		КонецЦикла;
		
		Уровень = Уровень + 1;
		
		Если Уровень=МаксимальныйУровеньВложенности Тогда
			Прервать;
		КонецЕсли;
		
		КоличествоЭлементов = Элементы.Количество();
		
	КонецЦикла;

	Для НомерЭлемента=0 По КоличествоКорней-1 Цикл
		ОбратныйНомер = КоличествоКорней-1-НомерЭлемента;
		Элементы.Удалить(ОбратныйНомер);
	КонецЦикла;

	Возврат Элементы;
	
КонецФункции

Функция НайтиЭлементДерева(Коллекция, Отбор) Экспорт
	
	НайденныеЭлементы = НайтиЭлементыДерева(Коллекция, Отбор, Истина);
	
	Если НайденныеЭлементы.Количество() > 0 Тогда
		
		Возврат НайденныеЭлементы[0];
		
	КонецЕсли;
	
КонецФункции

Функция НайтиЭлементыДерева(Коллекция, Отбор, ОстановитьсяПослеПервого=Ложь) Экспорт

	Возврат НайтиЭлементыКоллекции(ПолучитьПодчиненныеЭлементыКоллекции(Коллекция), Отбор, , ОстановитьсяПослеПервого);

КонецФункции

Функция ПолучитьРодителяЭлементаКоллекции(Элемент, Коллекция=Неопределено) Экспорт

	ИмяТипа = Строка(ТипЗнч(Элемент));
	
	Если ИмяТипа="СтрокаДереваЗначений" Тогда
		Родитель = Элемент.Родитель;
	ИначеЕсли ИмяТипа="ДанныеФормыЭлементДерева" Тогда
		Родитель = Элемент.ПолучитьРодителя();
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если Родитель=Неопределено Тогда
		Родитель = Коллекция;
	КонецЕсли;
	
	Возврат Родитель;
	
КонецФункции

