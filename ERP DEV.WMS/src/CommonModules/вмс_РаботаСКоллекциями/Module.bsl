Функция ПеренумероватьСтрокиКвазиТаблицыЗначений(Таблица)
	
	НомераИСтроки = Таблица.НумерацияСтрок.НомераИСтроки;
	НомераИСтроки.Очистить();
	
	НомерСтроки = 1;
	Для Каждого Строка Из Таблица.Строки Цикл
		НомераИСтроки[Строка] = НомерСтроки;
		НомераИСтроки[НомерСтроки] = Строка;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Таблица.НумерацияСтрок.ТекущийНомер = НомерСтроки;
	
КонецФункции

Функция СортироватьКвазиТаблицуЗначений(Таблица, СтрокаСортировки) Экспорт
	
	Если Не ЗначениеЗаполнено(СтрокаСортировки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СортироватьКоллекцию(Таблица.Строки, СтрокаСортировки);
	ПеренумероватьСтрокиКвазиТаблицыЗначений(Таблица);
	Возврат Истина;
	
КонецФункции

Функция ВосстановитьКвазиТаблицуЗначений(Таблица) Экспорт
	Если Таблица.Строки.Количество() > 0 Тогда
		Если Таблица.НумерацияСтрок.НомераИСтроки[Таблица.Строки[0]] = Неопределено Тогда
			ПеренумероватьСтрокиКвазиТаблицыЗначений(Таблица);
		КонецЕсли;
	КонецЕсли;
	
	Если Не МенеджерИндексирования_ПроверитьСсылочнуюЦелостность(Таблица.МенеджерИндексирования) Тогда
		ИндексироватьКвазиТаблицу(Таблица);
	КонецЕсли;
КонецФункции

