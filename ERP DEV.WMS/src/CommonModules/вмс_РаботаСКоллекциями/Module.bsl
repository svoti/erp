КонецФункции

Функция ДобавитьТаблицуФормы(Форма, МассивНовыхРеквизитов, ИмяТаблицы, ИменаКолонок) Экспорт
	МассивКолонок = ЗначениеВМассив(ИменаКолонок);
	ДобавитьРеквизитФормы(Форма, МассивНовыхРеквизитов, ИмяТаблицы, , "ТаблицаЗначений");
	Для Каждого ИмяКолонки Из МассивКолонок Цикл
		ДобавитьРеквизитФормы(Форма, МассивНовыхРеквизитов, ИмяКолонки, ИмяТаблицы);
	КонецЦикла; 
КонецФункции
#КонецЕсли

Функция ПронумероватьКоллекцию(Коллекция, ПоляГруппы, ПоляНомеров) Экспорт
	
	Если Коллекция.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли; 
	
	ПоляГруппыМассив = ЗначениеВМассив(ПоляГруппы);
	ПоляНомеровМассив = СтрокуВМассив(ПоляНомеров);
	Если ПоляГруппыМассив.Количество() <> ПоляНомеровМассив.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КоличествоПолей = ПоляГруппыМассив.Количество();
	
	Строка = Коллекция[0];
	ТекущаяГруппировка = Новый Структура;
	НомераГруппировок = Новый Структура;
	Для Каждого ПолеГруппы Из ПоляГруппыМассив Цикл
		ТекущаяГруппировка.Вставить(ПолеГруппы, Строка[ПолеГруппы]);
		НомераГруппировок.Вставить(ПолеГруппы, 1);
	КонецЦикла;
	
	Для Каждого Строка Из Коллекция Цикл
		
		Для НомерПоля=1 По КоличествоПолей Цикл
			ПолеГруппы = ПоляГруппыМассив[НомерПоля-1];
			Значение = Строка[ПолеГруппы];
			Если Значение <> ТекущаяГруппировка[ПолеГруппы] Тогда
				ТекущаяГруппировка[ПолеГруппы] = Значение;
				НомераГруппировок[ПолеГруппы] = НомераГруппировок[ПолеГруппы] + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для НомерПоля=НомерПоля+1 По КоличествоПолей Цикл
			ПолеГруппы = ПоляГруппыМассив[НомерПоля-1];
			НомераГруппировок[ПолеГруппы] = 1;
			ТекущаяГруппировка[ПолеГруппы] = Строка[ПолеГруппы];
		КонецЦикла;
		
		Для НомерПоля=1 По КоличествоПолей Цикл
			ПолеГруппы = ПоляГруппыМассив[НомерПоля-1];
			ПолеНомера = ПоляНомеровМассив[НомерПоля-1];
			Строка[ПолеНомера] = НомераГруппировок[ПолеГруппы]
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ДополнитьКолонкиКоллекции(Коллекция, СписокКолонок) Экспорт
	
#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
			Возврат ДополнитьКолонкиТаблицыЗначений(Коллекция, СписокКолонок);
		КонецЕсли;
#КонецЕсли
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		Возврат ДополнитьКолонкиКвазиТаблицыЗначений(Коллекция, СписокКолонок);
	КонецЕсли;
	
КонецФункции

Функция ПереименоватьКолонкуКоллекцииЗначений(Коллекция, ИмяКолонки, НовоеИмяКолонки) Экспорт
	
	#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение Тогда
		Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
			Коллекция.Колонки[ИмяКолонки].Имя = НовоеИмяКолонки;
			Возврат Истина;
		КонецЕсли;
	#КонецЕсли
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		Возврат ПереименоватьКолонкуКвазиТаблицыЗначений(Коллекция, ИмяКолонки, НовоеИмяКолонки);
	КонецЕсли;
	
КонецФункции

Функция СдвинутьЭлементКоллекции(Коллекция, знач Элемент, НовыйНомер) Экспорт
	
	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		СдвинутьСтрокуКвазиТаблицыЗначений(Коллекция, Элемент, НовыйНомер);
		
	Иначе
		
		Если ТипЗнч(Элемент)=Тип("Число") Тогда
			ТекущийИндекс = Элемент - 1;
		Иначе
			ТекущийИндекс = Коллекция.Индекс(Элемент);
		КонецЕсли;
		ТекущийНомер = ТекущийИндекс + 1;
		Если ТекущийНомер <> НовыйНомер Тогда
			Смещение = НовыйНомер - ТекущийНомер;
			Если НовыйНомер > ТекущийНомер Тогда
				Смещение = Смещение - 1;
			КонецЕсли;
			Коллекция.Сдвинуть(ТекущийИндекс, Смещение);
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Функция СдвинутьЭлементыКоллекции(Коллекция, знач Элементы, НовыйНомер) Экспорт
	
	Для Каждого Элемент Из Элементы Цикл
		СдвинутьЭлементКоллекции(Коллекция, Элемент, НовыйНомер);
	КонецЦикла;

КонецФункции

Функция НомерЭлементаКоллекции(Коллекция, Элемент) Экспорт

	Если ЭтоКвазиТаблицаЗначений(Коллекция) Тогда
		
		НомерЭлемента = Коллекция.НумерацияСтрок.НомераИСтроки[Элемент];
		
	Иначе
		
		НомерЭлемента = Коллекция.Индекс(Элемент) + 1;
		
	КонецЕсли;
	
	Возврат НомерЭлемента;
	
КонецФункции

#КонецОбласти

Функция РазложитьЧислоНаРазряды(Число, Основание=10, КоличествоРазрядов=0) Экспорт
	
	Если Основание <= 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Разряды = Новый Массив;
	
	Остаток = Число;
	
	Пока Остаток > 0 Цикл
		
		Остаток2 = Цел(Остаток / Основание);
		Разряд = Остаток - Остаток2*Основание;
		Разряды.Добавить(Разряд);
		Остаток = Остаток2;
		
	КонецЦикла;
	
	Пока Разряды.Количество() < КоличествоРазрядов Цикл
		Разряды.Добавить(0);
	КонецЦикла;
	
	Возврат Разряды;
	
КонецФункции