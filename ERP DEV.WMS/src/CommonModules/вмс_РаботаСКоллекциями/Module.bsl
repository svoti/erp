Функция НовыйТекстовыйПарсер() Экспорт

	ЛогическиеБлоки = Новый Соответствие;
	
	Парсер = Новый Структура;
	Парсер.Вставить("ЛогическиеБлоки", ЛогическиеБлоки);
	Парсер.Вставить("РазделительПолей", ",");
	Парсер.Вставить("РазделительЗначения", ":");
	
	ТекстовыйПарсер_ДобавитьЛогическийБлок(Парсер, "(", ")", Тип("Структура"));
	ТекстовыйПарсер_ДобавитьЛогическийБлок(Парсер, "[", "]", Тип("Массив"));
	
	Возврат Парсер;
	
КонецФункции

Функция ТекстовыйПарсер_ДобавитьЛогическийБлок(Парсер, Начало, Конец, Тип=Неопределено) Экспорт
	
	ЛогическийБлок = Новый Структура("Начало, Конец, Тип", Начало, Конец, Тип);
	Если ЛогическийБлок.Тип = Неопределено Тогда
		ЛогическийБлок.Тип = Тип("Структура");
	КонецЕсли;
	Парсер.ЛогическиеБлоки[Начало] = ЛогическийБлок;
	
КонецФункции

Функция ТекстовыйПарсер_РазпарситьСтроку(знач Парсер=Неопределено, Строка) Экспорт
	
	Если Парсер = Неопределено Тогда
		Парсер = НовыйТекстовыйПарсер();
	КонецЕсли;
	
	////////////////////////////////////////////////
	Кавычка = """";
	СпецСимволы = Новый Соответствие;
	Для Каждого ЭлмЛогическийБлок Из Парсер.ЛогическиеБлоки Цикл
		СпецСимволы[ЭлмЛогическийБлок.Ключ] = Истина;
	КонецЦикла;
	СпецСимволы[Парсер.РазделительЗначения] = Истина;
	СпецСимволы[Парсер.РазделительПолей] = Истина;
	СпецСимволы[Кавычка] = Истина;
	СпецСимволы["%"] = Истина;
	
	ПустыеСимволы = Новый Соответствие;
	ПустыеСимволы[" "] = Истина;
	ПустыеСимволы[Символы.ПС] = Истина;
	ПустыеСимволы[Символы.Таб] = Истина;
	
	ТипСтруктура = Тип("Структура");
	ТипСоответствие = Тип("Соответствие");
	ТипМассив = Тип("Массив");
	
	////////////////////////////////////////////////
	НомерСимвола = 1;
	ДлинаСтроки = СтрДлина(Строка);
	СтекЭлементов = Новый Массив;
	ДанныеПоУмолчанию = Новый Структура;
	ДанныеПоУмолчанию.Вставить("Коллекция", Новый Структура);
	ДанныеПоУмолчанию.Вставить("Поле", "");
	ДанныеПоУмолчанию.Вставить("Значение");
	ДанныеПоУмолчанию.Вставить("Слово", "");
	ДанныеПоУмолчанию.Вставить("ЗакодированноеСлово", "");
	ДанныеПоУмолчанию.Вставить("ЛогическийБлок", Неопределено);
	ДанныеПоУмолчанию.Вставить("КонецЛогическогоБлока", Неопределено);
	ДанныеПоУмолчанию.Вставить("ТипЛогическогоБлока", ТипСтруктура);
	ДанныеПоУмолчанию.Вставить("ЧтениеСлова", Ложь);
	ДанныеПоУмолчанию.Вставить("КодирующийСимвол", "");
	ДанныеПоУмолчанию.Вставить("ПрочитатьСимволыКодированногоСлова", 0);
	ДанныеПоУмолчанию.Вставить("ЧтениеЗначения", Ложь);
	ДанныеПоУмолчанию.Вставить("ЗначениеВКавычках", Неопределено);
	
	ТекущиеДанные = СкопироватьОбъект(ДанныеПоУмолчанию);
	
	Пока НомерСимвола <= ДлинаСтроки Цикл
		Символ = Сред(Строка, НомерСимвола, 1);
		ЭтоПустойСимвол = ПустыеСимволы[Символ] = Истина;
		Если Не ЭтоПустойСимвол Тогда
			Прервать;
		КонецЕсли;
		НомерСимвола = НомерСимвола + 1;
	КонецЦикла;
	
	Символ = Сред(Строка, НомерСимвола, 1);
	ЛогическийБлок = Парсер.ЛогическиеБлоки[Символ];
	Если ЛогическийБлок = Неопределено Тогда
		// по умолчанию результат - структура
		НоваяКоллекция = Новый Структура;
		ТекущиеДанные.Значение = НоваяКоллекция;
		СтекЭлементов.Добавить(ТекущиеДанные);
		
		ТекущиеДанные = СкопироватьОбъект(ДанныеПоУмолчанию);
		ТекущиеДанные.Коллекция = НоваяКоллекция;
		ТекущиеДанные.КонецЛогическогоБлока = "";
		ТекущиеДанные.ТипЛогическогоБлока = ТипСтруктура;
	КонецЕсли;
	
	Пока НомерСимвола <= ДлинаСтроки+1 Цикл
		Символ = Сред(Строка, НомерСимвола, 1);
		
		ЭтоПустойСимвол = ПустыеСимволы[Символ] = Истина;
		ЭтоКонец = Символ = "";
		
		ЭтоКонецЛогическогоБлока = Символ = ТекущиеДанные.КонецЛогическогоБлока;
		ЭтоСпецСимвол = СпецСимволы[Символ] = Истина ИЛИ ЭтоКонецЛогическогоБлока ИЛИ ЭтоПустойСимвол ИЛИ ЭтоКонец;
		
		ЗаписатьЗначение = Ложь;
		ПоднятьсяПоСтеку = Ложь;
		
		/////////////////////////////////////////////////////////////////////////////////////////////////////////////
		Если ТекущиеДанные.ЧтениеСлова Тогда
			
			Если ТекущиеДанные.ПрочитатьСимволыКодированногоСлова > 0 Тогда
				
				ТекущиеДанные.ПрочитатьСимволыКодированногоСлова = ТекущиеДанные.ПрочитатьСимволыКодированногоСлова - 1;
				ТекущиеДанные.ЗакодированноеСлово = ТекущиеДанные.ЗакодированноеСлово + Символ;
				
				Если ТекущиеДанные.КодирующийСимвол = Кавычка Тогда
					
					Если ТекущиеДанные.ЗакодированноеСлово = Кавычка Тогда
						ТекущиеДанные.Слово = ТекущиеДанные.Слово + ТекущиеДанные.ЗакодированноеСлово;
						НомерСимвола = НомерСимвола + 1;
						Продолжить;
					Иначе
						ТекущиеДанные.ЧтениеСлова = Ложь;
					КонецЕсли;
					
				Иначе
					
					Если ТекущиеДанные.ЗакодированноеСлово = "r" Тогда
						ТекущиеДанные.ПрочитатьСимволыКодированногоСлова = 1;
					КонецЕсли;
					НомерСимвола = НомерСимвола + 1;
					
					Если ТекущиеДанные.ПрочитатьСимволыКодированногоСлова = 0 Тогда
						// закончить чтение закодированного слова
						Если ТекущиеДанные.ЗакодированноеСлово = "r1" ИЛИ ТекущиеДанные.ЗакодированноеСлово = "r2" Тогда
							// Рекурсия ссылок
							Уровень = СтекЭлементов.ВГраница() - ?(ТекущиеДанные.ЗакодированноеСлово = "r1", 0, 1);
							ТекущиеДанные.Значение = СтекЭлементов[Уровень].Коллекция;
							ТекущиеДанные.ЧтениеСлова = Ложь;
						Иначе
							ТекущиеДанные.Слово = ТекущиеДанные.Слово + ТекущиеДанные.ЗакодированноеСлово;
						КонецЕсли;
					КонецЕсли;
					
					Продолжить;
					
				КонецЕсли;
				
			ИначеЕсли ТекущиеДанные.ЗначениеВКавычках Тогда
				
				Если Символ = Кавычка Тогда
					ТекущиеДанные.ПрочитатьСимволыКодированногоСлова = 1;
					ТекущиеДанные.ЗакодированноеСлово = "";
					ТекущиеДанные.КодирующийСимвол = Символ;
					НомерСимвола = НомерСимвола + 1;
					Продолжить;
				КонецЕсли;
				
				ТекущиеДанные.Слово = ТекущиеДанные.Слово + Символ;
				
			Иначе
				
				Если ЭтоПустойСимвол Тогда
					НомерСимвола = НомерСимвола + 1;
					Продолжить;
				КонецЕсли;
				
				Если ЭтоСпецСимвол Тогда
					Если Символ = Кавычка Тогда
						ТекущиеДанные.ЗначениеВКавычках = Истина;
					ИначеЕсли Символ = "%" Тогда
						ТекущиеДанные.ПрочитатьСимволыКодированногоСлова = 1;
						ТекущиеДанные.ЗакодированноеСлово = "";
						ТекущиеДанные.КодирующийСимвол = Символ;
					Иначе
						ТекущиеДанные.ЧтениеСлова = Ложь;
					КонецЕсли;
				Иначе
					ТекущиеДанные.Слово = ТекущиеДанные.Слово + Символ;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ТекущиеДанные.ЧтениеСлова Тогда
				
				НомерСимвола = НомерСимвола + 1;
				
			Иначе
				
				// закончить чтение слова
				Если ТекущиеДанные.ЧтениеЗначения Тогда
					ТекущиеДанные.ЧтениеЗначения = Ложь;
					ТекущиеДанные.Значение = ТекущиеДанные.Слово;
				Иначе
					ТекущиеДанные.Поле = ТекущиеДанные.Слово;
					Если Символ = Парсер.РазделительЗначения Тогда
						ТекущиеДанные.ЧтениеЗначения = Истина;
						НомерСимвола = НомерСимвола + 1;
					Иначе
						// значение не указано, записать пустое значение
						ТекущиеДанные.Значение = "";
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если ЭтоПустойСимвол Тогда
				НомерСимвола = НомерСимвола + 1;
				Продолжить;
			КонецЕсли;
			
			Если Символ = Кавычка ИЛИ Символ = "%" ИЛИ Не ЭтоСпецСимвол Тогда
				ТекущиеДанные.Слово = "";
				ТекущиеДанные.ЗначениеВКавычках = Ложь;
				ТекущиеДанные.ЗакодированноеСлово = "";
				ТекущиеДанные.ПрочитатьСимволыКодированногоСлова = 0;
				ТекущиеДанные.ЧтениеСлова = Истина;
				
				Если ТекущиеДанные.ТипЛогическогоБлока = Тип("Массив") Тогда
					ТекущиеДанные.ЧтениеЗначения = Истина;
				КонецЕсли;
				
				Продолжить;
			КонецЕсли;
			
			/////////////////////////////////////////////////////////////////////////////////////////////////////////////
			ЛогическийБлок = Парсер.ЛогическиеБлоки[Символ];
			Если ЛогическийБлок <> Неопределено Тогда
				
				НоваяКоллекция = Новый(ЛогическийБлок.Тип);
				ТекущиеДанные.Значение = НоваяКоллекция;
				СтекЭлементов.Добавить(ТекущиеДанные);
				
				ТекущиеДанные = СкопироватьОбъект(ДанныеПоУмолчанию);
				ТекущиеДанные.Коллекция = НоваяКоллекция;
				ТекущиеДанные.ЛогическийБлок = ЛогическийБлок;
				ТекущиеДанные.КонецЛогическогоБлока = ЛогическийБлок.Конец;
				ТекущиеДанные.ТипЛогическогоБлока = ЛогическийБлок.Тип;
				
			ИначеЕсли Символ = Парсер.РазделительПолей Тогда
				
				ЗаписатьЗначение = Истина;
				
			ИначеЕсли ЭтоКонецЛогическогоБлока Тогда
				
				ЗаписатьЗначение = Истина;
				ПоднятьсяПоСтеку = Истина;
				
			КонецЕсли;
			
			НомерСимвола = НомерСимвола + 1;
			
		КонецЕсли;
		
		Если ЗаписатьЗначение Тогда
			Если ТекущиеДанные.ТипЛогическогоБлока = ТипСтруктура ИЛИ ТекущиеДанные.ТипЛогическогоБлока = ТипСоответствие Тогда
				Если ТекущиеДанные.Поле <> "" Тогда
					ТекущиеДанные.Коллекция.Вставить(ТекущиеДанные.Поле, ТекущиеДанные.Значение);
				КонецЕсли;
			ИначеЕсли ТекущиеДанные.ТипЛогическогоБлока = ТипМассив Тогда
				ТекущиеДанные.Коллекция.Добавить(ТекущиеДанные.Значение);
			КонецЕсли;
			ТекущиеДанные.Поле = "";
			ТекущиеДанные.Значение = "";
		КонецЕсли;
		
		Если ПоднятьсяПоСтеку Тогда
			ТекущиеДанные = СтекЭлементов[СтекЭлементов.ВГраница()];
			СтекЭлементов.Удалить(СтекЭлементов.ВГраница());
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекущиеДанные.Значение;
	
КонецФункции

Функция ТекстовыйПарсер_ПолучитьСтруктуруШаблона(СтрокаШаблона) Экспорт
	
	ДлинаСтроки = СтрДлина(СтрокаШаблона);
	НомерСимвола = 1;
	КодирующийСимвол = "\";
	Звездочка = "*";
	НачалоПараметра = "[";
	КонецПараметра = "]";
	КонецШаблона = "";
	
	
	СтруктураШаблона = Новый Массив;
	ЭлементШаблонаПоУмолчанию = Новый Структура;
	ЭлементШаблонаПоУмолчанию.Вставить("Значение", "");
	ЭлементШаблонаПоУмолчанию.Вставить("Тип", 0);
	
	ЭлементШаблона = СкопироватьОбъект(ЭлементШаблонаПоУмолчанию);
	Состояние = 0;
	
	Пока НомерСимвола <= ДлинаСтроки+1 Цикл
		
		Символ = Сред(СтрокаШаблона, НомерСимвола, 1);
		
		Если Состояние = 0 Тогда
			
			Если Символ = НачалоПараметра Тогда
				Состояние = 1;
			ИначеЕсли Символ = Звездочка Тогда
				Состояние = 2;
			ИначеЕсли Символ = КодирующийСимвол Тогда
				Состояние = 3;
			ИначеЕсли Символ = КонецШаблона Тогда
				Состояние = 4;
			КонецЕсли;
			
			Если Состояние = 0 Тогда
				ЭлементШаблона.Значение = ЭлементШаблона.Значение + Символ;
			Иначе
				Если Состояние <> 3 И ЭлементШаблона.Значение <> "" Тогда
					ЭлементШаблона.Тип = 0;
					СтруктураШаблона.Добавить(ЭлементШаблона);
					ЭлементШаблона = СкопироватьОбъект(ЭлементШаблонаПоУмолчанию);
				КонецЕсли;
				
				Если Состояние = 2 Тогда
					ЭлементШаблона.Тип = 2;
					СтруктураШаблона.Добавить(ЭлементШаблона);
					ЭлементШаблона = СкопироватьОбъект(ЭлементШаблонаПоУмолчанию);
					Состояние = 0;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли Состояние = 1 Тогда
			
			//параметр
			Если Символ = КонецПараметра Тогда
				ЭлементШаблона.Тип = 1;
				СтруктураШаблона.Добавить(ЭлементШаблона);
				ЭлементШаблона = СкопироватьОбъект(ЭлементШаблонаПоУмолчанию);
				Состояние = 0;
			Иначе
				ЭлементШаблона.Значение = ЭлементШаблона.Значение + Символ;
			КонецЕсли;
			
		ИначеЕсли Состояние = 3 Тогда
			
			// закодированный символ
			ЭлементШаблона.Значение = ЭлементШаблона.Значение + Символ;
			
			Состояние = 0;
			
		КонецЕсли;
		
		НомерСимвола = НомерСимвола + 1;
		
	КонецЦикла;
	
	Возврат СтруктураШаблона;
	
КонецФункции

Функция ТекстовыйПарсер_ПолучитьПараметрыИзСтроки(Шаблон, знач Строка) Экспорт

	Если ТипЗнч(Шаблон) = Тип("Строка") Тогда
		СтруктураШаблона = ТекстовыйПарсер_ПолучитьСтруктуруШаблона(Шаблон);
	Иначе
		СтруктураШаблона = Шаблон;
	КонецЕсли;
	
	Параметры = Новый Структура;
	
	ЭлементШаблона = Неопределено;
	ЗначениеЭлемента = "";
	ТипЭлемента = 0;
	ЭтоПараметр = Ложь;
	НомерЭлемента = 0;
	КоличествоЭлементовШаблона = СтруктураШаблона.Количество();
	
	Пока НомерЭлемента < КоличествоЭлементовШаблона Цикл
		
		ЭлементШаблона0 = ЭлементШаблона;
		ТипЭлемента0 = ТипЭлемента;
		ЭтоПараметр0 = ЭтоПараметр;
		ЗначениеЭлемента0 = ЗначениеЭлемента;
		ЭлементШаблона = СтруктураШаблона[НомерЭлемента];
		ТипЭлемента = ЭлементШаблона.Тип;
		ЭтоПараметр = ТипЭлемента <> 0;
		ЗначениеЭлемента = ЭлементШаблона.Значение;
		
		Если ЭтоПараметр Тогда

			Если ЭтоПараметр0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Если ТипЭлемента = 1 И НомерЭлемента = КоличествоЭлементовШаблона-1 Тогда
				ИмяПараметра = ЗначениеЭлемента;
				ЗначениеПараметра = Строка;
				Параметры.Вставить(ИмяПараметра, ЗначениеПараметра);
			КонецЕсли;
				
		Иначе
			
			ДлинаЭлемента = СтрДлина(ЗначениеЭлемента);
			
			Если ЭтоПараметр0 Тогда
				
				Позиция = СтрНайти(Строка, ЗначениеЭлемента);
				Если Позиция = 0 Тогда
					Возврат Неопределено;
				КонецЕсли;
				
				Если ТипЭлемента0 = 1 Тогда
					ИмяПараметра = ЗначениеЭлемента0;
					ЗначениеПараметра = Лев(Строка, Позиция-1);
					Параметры.Вставить(ИмяПараметра, ЗначениеПараметра);
				КонецЕсли;
				
			Иначе
				
				Позиция = 1;
				Если Не Лев(Строка, ДлинаЭлемента) = ЗначениеЭлемента Тогда
					Возврат Неопределено;
				КонецЕсли;
				
			КонецЕсли;

			Строка = Сред(Строка, Позиция+ДлинаЭлемента);
			
		КонецЕсли;
		
		НомерЭлемента = НомерЭлемента + 1;
		
	КонецЦикла;
	
	Возврат Параметры;
	
КонецФункции

Функция ТекстовыйПарсер_ПодставитьПараметрыВСтроку(Строка, Параметры) Экспорт
	
	СтрокаСПараметрами = Строка;
	
	Для Каждого Параметр Из Параметры Цикл
		СтрокаСПараметрами = СтрЗаменить(СтрокаСПараметрами, "[" + Параметр.Ключ + "]", Параметр.Значение);
	КонецЦикла;
	
	Возврат СтрокаСПараметрами;
	
КонецФункции

