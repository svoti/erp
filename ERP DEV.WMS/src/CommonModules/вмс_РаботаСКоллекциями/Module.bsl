Функция НовыйЭлементИндексаСИ()
	ЭлементИндекса = Новый Структура;
	ЭлементИндекса.Вставить("Номер", 0);
	ЭлементИндекса.Вставить("Уровень", 0);
	ЭлементИндекса.Вставить("СодержитДанные", Ложь);
	ЭлементИндекса.Вставить("НомерРодителя");
	ЭлементИндекса.Вставить("Ключ");
	ЭлементИндекса.Вставить("Индексы", Новый Соответствие);
	ЭлементИндекса.Вставить("ИндексДляНеопределено");
	ЭлементИндекса.Вставить("МассивИндексов", Новый Массив);
	Возврат ЭлементИндекса;
КонецФункции

Функция ДобавитьЭлементИндексаСИ(СИ, Родитель=Неопределено, Ключ=Неопределено) Экспорт
	ЭлементИндекса = НовыйЭлементИндексаСИ();
	ЭлементИндекса.Номер = СИ.ТекущийНомерЭлементаИндекса;
	ЭлементИндекса.Ключ = Ключ;
	Если Родитель <> Неопределено Тогда
		ЭлементИндекса.Уровень = Родитель.Уровень + 1;
		ЭлементИндекса.НомерРодителя = Родитель.Номер;
		Если Ключ = Неопределено Тогда
			Родитель.ИндексДляНеопределено = ЭлементИндекса;
		Иначе
			Родитель.Индексы[Ключ] = ЭлементИндекса;
		КонецЕсли;
		Родитель.МассивИндексов.Добавить(ЭлементИндекса);
		ЭлементИндекса.СодержитДанные = СИ.Глубина = ЭлементИндекса.Уровень;
	КонецЕсли;
	СИ.ИндексыНомеров[ЭлементИндекса.Номер] = ЭлементИндекса;
	СИ.ТекущийНомерЭлементаИндекса = СИ.ТекущийНомерЭлементаИндекса + 1;
	Возврат ЭлементИндекса;
КонецФункции

Функция НоваяСистемаИндексированияКоллекций(КоллекцияСтрок=Неопределено, знач ПоляИндексирования=Неопределено) Экспорт
	
	СИ = Новый Структура;
	СИ.Вставить("ПоляИндексирования", "");
	СИ.Вставить("ПоляИндексированияМассив", Новый Массив);
	СИ.Вставить("Глубина", 0);
	СИ.Вставить("ТекущийНомерЭлементаИндекса", 0);
	СИ.Вставить("ИндексыСтрок", Новый Соответствие);
	СИ.Вставить("ИндексыНомеров", Новый Соответствие);
	СИ.Вставить("СтруктураИндексов", ДобавитьЭлементИндексаСИ(СИ));
	
	Если ПоляИндексирования <> Неопределено Тогда
		ПоляИндексированияМассив = ЗначениеВМассив(ПоляИндексирования);
		ПоляИндексирования = МассивВСтроку(ПоляИндексированияМассив);
		
		СИ.ПоляИндексирования = ПоляИндексирования;
		СИ.ПоляИндексированияМассив = ПоляИндексированияМассив;
		СИ.Глубина = ПоляИндексированияМассив.Количество();
	КонецЕсли;
	
	Если КоллекцияСтрок <> Неопределено Тогда
		ИндексироватьЭлементыКоллекции(СИ, КоллекцияСтрок);
	КонецЕсли; 
	
	Возврат СИ;
	
КонецФункции

Функция ОчиститьЭлементИндекса(СИ, ЭлементИндекса=Неопределено) Экспорт
	
	Если ЭлементИндекса = Неопределено Тогда
		// очистить всю систему
		ОчиститьСистемуИндексирования(СИ);
		Возврат Истина;
	КонецЕсли;
	
	ИндексыНомеров = СИ.ИндексыНомеров;
	ИндексыСтрок = СИ.ИндексыСтрок;
	
	МассивИндексов = Новый Массив;
	МассивИндексов.Добавить(ЭлементИндекса);
	
	Для Каждого ТекущийЭлементИндекса Из МассивИндексов Цикл
		Если ТекущийЭлементИндекса.СодержитДанные Тогда
			МассивДанных = ТекущийЭлементИндекса.МассивИндексов;
			Для Каждого СтрокаДанных Из МассивДанных Цикл
				ИндексыСтрок.Удалить(СтрокаДанных);
			КонецЦикла; 
		Иначе
			ДобавитьЭлементыКоллекции(МассивИндексов, ТекущийЭлементИндекса.МассивИндексов);
		КонецЕсли;
		
		ТекущийЭлементИндекса.Индексы.Очистить();
		ТекущийЭлементИндекса.МассивИндексов.Очистить();
		ИндексыНомеров.Удалить(ТекущийЭлементИндекса.Номер);
	КонецЦикла;
	
	// восстановим номер элемента
	ИндексыНомеров[ЭлементИндекса.Номер] = ЭлементИндекса;
	
	Возврат Истина;
	
КонецФункции

Функция ОчиститьИндексыКоллекции(СИ, СтрокиКоллекции) Экспорт
	
	МассивСтрокКоллекции = ЗначениеВМассив(СтрокиКоллекции, , Ложь);
	ИндексыНомеров = СИ.ИндексыНомеров;
	ИндексыСтрок = СИ.ИндексыСтрок;
	
	Для Каждого Строка Из МассивСтрокКоллекции Цикл
		ЭлементИндексаСтроки = ИндексыСтрок[Строка];
		Если ЭлементИндексаСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИндексыСтрок.Удалить(Строка);
		ЭлементИндексаСтроки.МассивИндексов.Удалить(ЭлементИндексаСтроки.МассивИндексов.Найти(Строка));
		ЭлементИндексаСтроки.Индексы.Удалить(Строка);
		
		ЭлементИндекса = ЭлементИндексаСтроки;
		Пока Истина Цикл
			Если ЭлементИндекса.Индексы.Количество() > 0 Тогда
				Прервать;
			КонецЕсли;
			
			ЭлементРодителяИндекса = ИндексыНомеров[ЭлементИндекса.НомерРодителя];
			Если ЭлементРодителяИндекса = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			ЭлементРодителяИндекса.МассивИндексов.Удалить(ЭлементРодителяИндекса.МассивИндексов.Найти(ЭлементИндекса));
			Если ЭлементИндекса.Ключ = Неопределено Тогда
				ЭлементРодителяИндекса.ИндексДляНеопределено = Неопределено;
			Иначе
				ЭлементРодителяИндекса.Индексы.Удалить(ЭлементИндекса.Ключ);
			КонецЕсли;
			ИндексыНомеров.Удалить(ЭлементИндекса.Номер);
			
			ЭлементИндекса = ЭлементРодителяИндекса;
		КонецЦикла; 
	КонецЦикла; 
	
КонецФункции

Функция ОчиститьСистемуИндексирования(СИ) Экспорт
	СИ.ИндексыСтрок.Очистить();
	СИ.ИндексыНомеров.Очистить();
	СИ.ИндексыНомеров[СИ.СтруктураИндексов.Номер] = СИ.СтруктураИндексов;
	СИ.СтруктураИндексов.МассивИндексов.Очистить();
	СИ.СтруктураИндексов.Индексы.Очистить();
	СИ.СтруктураИндексов.ИндексДляНеопределено = Неопределено;
	СИ.ТекущийНомерЭлементаИндекса = СИ.СтруктураИндексов.Номер + 1;
КонецФункции

Функция ИндексироватьЭлементыКоллекции(СИ, СтрокиКоллекции) Экспорт
	
	МассивСтрокКоллекции = ЗначениеВМассив(СтрокиКоллекции, , Ложь);
	ПоляИндексированияМассив = СИ.ПоляИндексированияМассив;
	СтруктураИндексов = СИ.СтруктураИндексов;
	ИндексыСтрок = СИ.ИндексыСтрок;
	
	ОчиститьИндексыКоллекции(СИ, МассивСтрокКоллекции);
	
	МаксИндексСтроки = МассивСтрокКоллекции.ВГраница();
	МаксИндексПоля = ПоляИндексированияМассив.ВГраница();
	Для ИндексСтроки=0 По МаксИндексСтроки Цикл
		Строка = МассивСтрокКоллекции[ИндексСтроки];
		Дерево = СтруктураИндексов;
		Для ИндексПоля=0 По МаксИндексПоля Цикл
			ЗначениеПоля = Строка[ПоляИндексированияМассив[ИндексПоля]];
			ПодДерево = Дерево.Индексы[ЗначениеПоля];
			Если ПодДерево = Неопределено Тогда
				Если ЗначениеПоля = Неопределено И Дерево.ИндексДляНеопределено <> Неопределено Тогда
					ПодДерево = Дерево.ИндексДляНеопределено;
				Иначе
					ПодДерево = ДобавитьЭлементИндексаСИ(СИ, Дерево, ЗначениеПоля);
				КонецЕсли; 
			КонецЕсли;
			Дерево = ПодДерево;
		КонецЦикла;
		Дерево.МассивИндексов.Добавить(Строка);
		Дерево.Индексы[Строка] = Строка;
		ИндексыСтрок[Строка] = Дерево;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьЭлементИндекса(ЭлементИндексаРодитель, ЗначениеПоля) Экспорт
	
	Если ЗначениеПоля = Неопределено Тогда
		ПодДерево = ЭлементИндексаРодитель.ИндексДляНеопределено;
	Иначе
		ПодДерево = ЭлементИндексаРодитель.Индексы[ЗначениеПоля];
	КонецЕсли;
	
	Возврат ПодДерево;
	
КонецФункции

Функция НайтиЭлементыИндекса(СИ, СтруктураОтбора, НачальныйИндекс=Неопределено) Экспорт
	
	Если НачальныйИндекс = Неопределено Тогда
		Дерево = СИ.СтруктураИндексов;
	Иначе
		Дерево = НачальныйИндекс;
	КонецЕсли; 
	
	ИндексПоля = Дерево.Уровень;
	
	ПоляИндексированияМассив = СИ.ПоляИндексированияМассив;
	
	НайденныеИндексы = Новый Массив;
	НайденныеИндексы.Добавить(Дерево);
	
	Пока ИндексПоля < ПоляИндексированияМассив.Количество() Цикл
		
		ПолеИндексирования = ПоляИндексированияМассив[ИндексПоля];
		НайденныеИндексы2 = Новый Массив;
		
		Если СтруктураОтбора.Свойство(ПолеИндексирования) Тогда
			ЗначениеПоля = СтруктураОтбора[ПолеИндексирования];
			Если ЗначениеПоля = Неопределено Тогда
				Для Каждого НайденныйИндекс Из НайденныеИндексы Цикл
					Если НайденныйИндекс.ИндексДляНеопределено <> Неопределено Тогда
						НайденныеИндексы2.Добавить(НайденныйИндекс.ИндексДляНеопределено);
					КонецЕсли; 
				КонецЦикла;
			Иначе
				Для Каждого НайденныйИндекс Из НайденныеИндексы Цикл
					ПодДерево = НайденныйИндекс.Индексы[ЗначениеПоля];
					Если ПодДерево <> Неопределено Тогда
						НайденныеИндексы2.Добавить(ПодДерево);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		Иначе
			Для Каждого НайденныйИндекс Из НайденныеИндексы Цикл
				ДобавитьЭлементыКоллекции(НайденныеИндексы2, НайденныйИндекс.МассивИндексов);
			КонецЦикла;
		КонецЕсли;
			
		НайденныеИндексы = НайденныеИндексы2;
		Если НайденныеИндексы.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ИндексПоля = ИндексПоля + 1;
		
	КонецЦикла;
	
	Возврат НайденныеИндексы;
	
КонецФункции

Функция НайтиЭлементИндекса(СИ, СтруктураОтбора, НачальныйИндекс=Неопределено) Экспорт
	
	НайденныеИндексы = НайтиЭлементыИндекса(СИ, СтруктураОтбора, НачальныйИндекс);
	Если НайденныеИндексы.Количество() > 0 Тогда
		Возврат НайденныеИндексы[0];
	КонецЕсли;
	
КонецФункции

Функция НайтиКлючиЭлементаИндекса(СИ, СтруктураОтбора) Экспорт
	
	МассивКлючей = Новый Массив;
	
	Дерево = НайтиЭлементИндекса(СИ, СтруктураОтбора);
	Если Дерево <> Неопределено Тогда
		Для Каждого ЭлементИндекса Из Дерево.Индексы Цикл
			МассивКлючей.Добавить(ЭлементИндекса.Значение.Ключ);
		КонецЦикла;
		
		Если Дерево.ИндексДляНеопределено <> Неопределено Тогда
			МассивКлючей.Добавить(Дерево.ИндексДляНеопределено.Ключ);
		КонецЕсли;
	КонецЕсли;
	
	Возврат МассивКлючей;
	
КонецФункции

Функция НайтиСтрокиКоллекцииВИндексе(СИ, СтруктураОтбора, СтруктураОтбораБезИндекса=Неопределено) Экспорт
	
	СтруктураИндексов = СИ.СтруктураИндексов;
	ПоляИндексированияМассив = СИ.ПоляИндексированияМассив;
	
	МассивДеревьев = Новый Массив;
	МассивДеревьев.Добавить(СтруктураИндексов);
	
	СтруктураОтбораБезИндекса = СкопироватьСтруктуру(СтруктураОтбора);
	Для Каждого ПолеИндексирования Из ПоляИндексированияМассив Цикл
		НайденныеДеревья = Новый Массив;
		Если СтруктураОтбора.Свойство(ПолеИндексирования) Тогда
			СтруктураОтбораБезИндекса.Удалить(ПолеИндексирования);
			ЗначениеПоля = СтруктураОтбора[ПолеИндексирования];
			Для Каждого Дерево Из МассивДеревьев Цикл
				Если ЗначениеПоля = Неопределено Тогда
					ПодДерево = Дерево.ИндексДляНеопределено;
				Иначе
					ПодДерево = Дерево.Индексы[ЗначениеПоля];
				КонецЕсли;
				
				Если ПодДерево <> Неопределено Тогда
					НайденныеДеревья.Добавить(ПодДерево);
				КонецЕсли; 
			КонецЦикла;
		Иначе
			Для Каждого Дерево Из МассивДеревьев Цикл
				Для Каждого ЭлементПодДерева Из Дерево.Индексы Цикл;
					ПодДерево = ЭлементПодДерева.Значение;
					НайденныеДеревья.Добавить(ПодДерево);
				КонецЦикла;
				
				Если Дерево.ИндексДляНеопределено <> Неопределено Тогда
					НайденныеДеревья.Добавить(Дерево.ИндексДляНеопределено);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли; 
		МассивДеревьев = НайденныеДеревья;
	КонецЦикла;
	
	НайденныеСтроки = Новый Массив;
	Для Каждого Дерево Из МассивДеревьев Цикл
		Для Каждого ЭлементСтроки Из Дерево.Индексы Цикл
			Строка = ЭлементСтроки.Значение;
			НайденныеСтроки.Добавить(Строка);
		КонецЦикла;
	КонецЦикла;
	
	Возврат НайденныеСтроки;
	
КонецФункции

Функция ПроверитьСсылочнуюЦелостностьСистемыИндексирования(СИ) Экспорт
	
	Если СИ.ИндексыНомеров[СИ.СтруктураИндексов.Номер] <> СИ.СтруктураИндексов Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

///////////////////////////////////////////////////////////////////
Функция НовыйМенеджерИндексирования()
	МенеджерИндексирования = Новый Структура;
	МенеджерИндексирования.Вставить("СистемыИндексирования", Новый Соответствие);
	Возврат МенеджерИндексирования;
КонецФункции

Функция МенеджерИндексирования_ДобавитьИндексКоллекции(Менеджер, Коллекция, ПоляИндексирования) Экспорт

	СИ = Менеджер.СистемыИндексирования[ПоляИндексирования];

	Если СИ=Неопределено Тогда
		СИ = НоваяСистемаИндексированияКоллекций(Коллекция, ПоляИндексирования);
		Менеджер.СистемыИндексирования[СИ.ПоляИндексирования] = СИ;
	КонецЕсли;
	
	Возврат СИ;
	
КонецФункции

Функция МенеджерИндексирования_ПодобратьИндекс(Менеджер, знач ПоляИндексирования) Экспорт
	
	Если Менеджер.СистемыИндексирования.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Если ТипЗнч(ПоляИндексирования)=Тип("Структура") Тогда
		СтруктураОтбора = ПоляИндексирования;
		ПоляИндексирования = "";
		РазделительСтроки = ", ";
		Для Каждого ПолеСтруктуры Из СтруктураОтбора Цикл
			ПоляИндексирования = ПоляИндексирования + ПолеСтруктуры.Ключ + РазделительСтроки;
		КонецЦикла;
		
		Если ПоляИндексирования="" Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПоляИндексирования = Лев(ПоляИндексирования, СтрДлина(ПоляИндексирования)-СтрДлина(РазделительСтроки));
		СИ = Менеджер.СистемыИндексирования[ПоляИндексирования];
		Если СИ <> Неопределено Тогда
			Возврат СИ;
		КонецЕсли;

		ПоляИндексированияМассив = ВыгрузитьЗначенияКолонкиКоллекции(СтруктураОтбора, "Ключ");
	Иначе
		ПоляИндексированияМассив = ЗначениеВМассив(ПоляИндексирования);
		Если ПоляИндексированияМассив.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПоляИндексирования = МассивВСтроку(ПоляИндексированияМассив);
		СИ = Менеджер.СистемыИндексирования[ПоляИндексирования];
		Если СИ <> Неопределено Тогда
			Возврат СИ;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ЭлементСИ Из Менеджер.СистемыИндексирования Цикл
		СИ = ЭлементСИ.Значение;
		Если СИ.ПоляИндексированияМассив[0] = ПоляИндексированияМассив[0] Тогда
			Возврат СИ;
		КонецЕсли; 
	КонецЦикла; 
	
	Для Каждого ЭлементСИ Из Менеджер.СистемыИндексирования Цикл
		СИ = ЭлементСИ.Значение;
		Если СИ.ПоляИндексированияМассив.Найти(ПоляИндексированияМассив[0]) <> Неопределено Тогда
			Возврат СИ;
		КонецЕсли; 
	КонецЦикла;
	
КонецФункции

Функция МенеджерИндексирования_ИндексироватьКоллекцию(Менеджер, Коллекция)
	Для Каждого ЭлементСИ Из Менеджер.СистемыИндексирования Цикл
		СИ = ЭлементСИ.Значение;
		ИндексироватьЭлементыКоллекции(СИ, Коллекция);
	КонецЦикла;
КонецФункции

Функция МенеджерИндексирования_ОчиститьИндексы(Менеджер)
	Для Каждого ЭлементСИ Из Менеджер.СистемыИндексирования Цикл
		СИ = ЭлементСИ.Значение;
		ОчиститьСистемуИндексирования(СИ);
	КонецЦикла;
КонецФункции

Функция МенеджерИндексирования_ОчиститьИндексыСтрок(Менеджер, Строки)
	Для Каждого ЭлементСИ Из Менеджер.СистемыИндексирования Цикл
		СИ = ЭлементСИ.Значение;
		ОчиститьИндексыКоллекции(СИ, Строки);
	КонецЦикла;
КонецФункции

Функция МенеджерИндексирования_ПроверитьСсылочнуюЦелостность(Менеджер)
	
	Для Каждого ЭлементСИ Из Менеджер.СистемыИндексирования Цикл
		СИ = ЭлементСИ.Значение;
		Если Не ПроверитьСсылочнуюЦелостностьСистемыИндексирования(СИ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

