Функция ПолучитьВидыТоваров(Товары) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Товар,
	|	Номенклатура.ВидНоменклатуры КАК ВидТовара
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&Товары)";
	Запрос.УстановитьПараметр("Товары", Товары);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаВидыНоменклатуры = РезультатЗапроса.Выгрузить();
	Возврат ТаблицаВидыНоменклатуры;
	
КонецФункции

Функция ПолучитьДинамическиеПараметрыНоменклатуры(ПараметрыОтбора) Экспорт
	
	// ТУ_Мовчан 06.06.23 ++
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Номенклатура КАК Товар,
	|	Таблица.Характеристика КАК Характеристика,
	|	Таблица.Назначение КАК Партия,
	|	Таблица.Серия КАК Серия,
	|	НЕОПРЕДЕЛЕНО КАК УчетныйПараметр1,
	|	НЕОПРЕДЕЛЕНО КАК УчетныйПараметр2
	|ИЗ
	|	Справочник.КлючиАналитикиУчетаНоменклатуры КАК Таблица
	|ГДЕ
	|	Таблица.Номенклатура = &Товар
	| 	И &ДопОтбор 
	|
	|СГРУППИРОВАТЬ ПО
	|	Таблица.Номенклатура,
	|	Таблица.Характеристика,
	|	Таблица.Назначение,
	|	Таблица.Серия
	|
	|УПОРЯДОЧИТЬ ПО
	|	Таблица.Назначение УБЫВ";
	
	ДопОтбор = "";
	
	Для каждого Строка Из ПараметрыОтбора Цикл	
		Если Строка.Ключ <> "Товар" Тогда
			ДопОтбор = ДопОтбор + "
			|	И Таблица." + Строка.Ключ + " = &" + Строка.Ключ;
		КонецЕсли;
		
		Запрос.УстановитьПараметр(Строка.Ключ, Строка.Значение);
	КонецЦикла;     
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ДопОтбор", ДопОтбор);  
	// ТУ_Мовчан 06.06.23 --
	ТаблицаВозможных = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаВозможных;
	
КонецФункции

Функция ПолучитьСтатическиеПараметрыНоменклатуры() Экспорт
	
	ТаблицаВозможных = Новый ТаблицаЗначений;
	ТаблицаВозможных.Колонки.Добавить("Качество");
	
	ИндексКачествоТовара = 0;
	Пока ИндексКачествоТовара < Перечисления.вмс_КачествоТовара.Количество() Цикл
		Строка = ТаблицаВозможных.Добавить();
		Строка.Качество = Перечисления.вмс_КачествоТовара.Получить(ИндексКачествоТовара);	
		ИндексКачествоТовара = ИндексКачествоТовара + 1;	
	КонецЦикла;
	
	Возврат ТаблицаВозможных;
	
КонецФункции

Функция ПолучитьУпаковкиТоваров(Товары) Экспорт  
	
	Если Товары = Неопределено Тогда	
		Возврат вмс_РаботаСКоллекциями.НоваяТаблицаЗначений("Товар, Упаковка, Коэффициент, ЭтоБаза");
	КонецЕсли;
	
	//Кулалаев 
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Товар,
	|	УпаковкиЕдиницыИзмерения.Ссылка КАК Упаковка,
	|	УпаковкиЕдиницыИзмерения.Числитель / УпаковкиЕдиницыИзмерения.Знаменатель КАК Коэффициент,
	|	УпаковкиЕдиницыИзмерения.Числитель = 1 КАК ЭтоБаза
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиНоменклатуры КАК УпаковкиЕдиницыИзмерения
	|		ПО (УпаковкиЕдиницыИзмерения.Владелец = Номенклатура.Ссылка
	|				ИЛИ УпаковкиЕдиницыИзмерения.Владелец = Номенклатура.НаборУпаковок)
	|ГДЕ
	|	Номенклатура.Ссылка В (&Товары)
	|";
	
	
	// Установка параметров.
	Запрос.УстановитьПараметр("Товары", Товары);
	Возврат Запрос.Выполнить().Выгрузить();    
	
КонецФункции

Функция СоздатьИПолучитьУпаковкуТовара(Товар, Коэффициент) Экспорт    
	
	НаименованиеПолное = "" + Коэффициент + " шт";
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	УпаковкиЕдиницыИзмерения.Ссылка КАК Упаковка
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК УпаковкиЕдиницыИзмерения
	|ГДЕ
	|	УпаковкиЕдиницыИзмерения.Владелец = &Товар
	|   И УпаковкиЕдиницыИзмерения.Числитель / УпаковкиЕдиницыИзмерения.Знаменатель = &Коэффициент
	|";
	
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.УстановитьПараметр("Коэффициент", Коэффициент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Упаковка = Выборка.Упаковка;
		Прервать;
	КонецЦикла;	
	
	Если Упаковка = Неопределено Тогда
		
		НовыйЭлемент = Справочники.УпаковкиНоменклатуры.СоздатьЭлемент();
		НовыйЭлемент.Заполнить(Неопределено);
		НовыйЭлемент.Владелец = Товар;
		НовыйЭлемент.Числитель = Коэффициент;
		НовыйЭлемент.Знаменатель = 1;
		НовыйЭлемент.Наименование = НаименованиеПолное;
		
		НовыйЭлемент.Записать();
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Упаковка = Выборка.Упаковка;
			Прервать;
		КонецЦикла;  
		
	КонецЕсли;
	
	Возврат Упаковка;  
	
КонецФункции

