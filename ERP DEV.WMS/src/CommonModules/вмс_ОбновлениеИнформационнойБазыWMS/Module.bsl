// ТУ_Кошелев 07.06.24 - Обновления функций, осветственных за создание запросов в СКД распоряжений операций
Функция СоздатьРаспоряжение(РаспоряжениеИмя, ПриставкаНаименования)   
	Наименование = Строка(Метаданные.НайтиПоПолномуИмени(РаспоряжениеИмя)) + ПриставкаНаименования; 
	
	НовоеРаспоряжение = Справочники.вмс_РаспоряженияОпераций.СоздатьЭлемент();
	НовоеРаспоряжение.Заполнить(Неопределено);
	НовоеРаспоряжение.РаспоряжениеКонфигуратор = РаспоряжениеИмя;
	НовоеРаспоряжение.Наименование = Наименование;
	НовоеРаспоряжение.Записать();   
	
	Возврат Наименование;
КонецФункции

Функция СоздатьПредопределенныеРаспоряжения_и_Операции() Экспорт     
	РК = вмс_РаботаСКоллекциями;
	
	// Очистка имеющихся элементов
	Выборка = Справочники.вмс_РаспоряженияОпераций.Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.ПолучитьОбъект().Удалить();
	КонецЦикла;   
	
	Распоряжения = вмс_АдаптацияКонфигураций.ПолучитьИменаРаспоряжений();  
	НаименованияРаспоряжений = Новый Структура("Поступление, Выбытие", Новый Массив, Новый Массив);     
	
	// Создание распоряжений
	Для Каждого РаспоряжениеТип Из Распоряжения Цикл
		Для Каждого РаспоряжениеИмя Из РаспоряжениеТип.Значение Цикл 
			Попытка
				Если РаспоряжениеТип.Ключ = "Гибрид" Тогда
					НаименованияРаспоряжений["Поступление"].Добавить(СоздатьРаспоряжение(РаспоряжениеИмя, " (Поступление)")); //По "Поступление/Выбытие" осуществляется поиск в дальнейнем, при изменении изменить в других местах где используется
					НаименованияРаспоряжений["Выбытие"].Добавить(СоздатьРаспоряжение(РаспоряжениеИмя, " (Выбытие)"));		  //Не делал реквизит, т.к. используется только для создания запросов при инициализации распоряжения
				Иначе                          
					НаименованияРаспоряжений[РаспоряжениеТип.Ключ].Добавить(СоздатьРаспоряжение(РаспоряжениеИмя, ""));
				КонецЕсли;	
			Исключение
				// Распоряжения нет в конфигурации, такое возможно для разных версий конфигурации
				ТекстОшибки = ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("AS:WMS", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			КонецПопытки;	
		КонецЦикла;
	КонецЦикла;
	
	// Создание операций
	СоздатьОперацию("Приемка",				"Приемка",			   Ложь,   НаименованияРаспоряжений, "Поступление");
	СоздатьОперацию("Приемка в ячейки",		"ПриемкаВЯчейки",	   Ложь,   НаименованияРаспоряжений, "Поступление");
	СоздатьОперацию("Размещение",			"Размещение",		   Ложь,   НаименованияРаспоряжений, "Поступление");
	СоздатьОперацию("Отбор",				"Отбор",			   Ложь,   НаименованияРаспоряжений, "Выбытие");
	СоздатьОперацию("Отбор в контейнер",	"ОтборВКонтейнер",	   Ложь,   НаименованияРаспоряжений, "Выбытие");
	СоздатьОперацию("Контроль",				"Контроль",			   Ложь,   НаименованияРаспоряжений, "Выбытие");
	СоздатьОперацию("Отгрузка",				"Отгрузка",			   Истина, НаименованияРаспоряжений, "Выбытие");
	СоздатьОперацию("Присвоение штрихкода", "ПрисвоениеШтрихкода", Ложь,   Новый Массив); // ТУ_Кошелев 01.07.24 - добавил форму автономного присвоения штрихкода	
КонецФункции   

Процедура СоздатьОперацию(Наименование, ИмяДляПоиска, ОбработкаВФормеСписка, НаименованияРаспоряжений, ТипОперации = Неопределено)
	
	СсылкаНаОперацию = Справочники.вмс_Операции.НайтиПоРеквизиту("ИмяДляПоиска", ИмяДляПоиска);
	Если ЗначениеЗаполнено(СсылкаНаОперацию) Тогда
		Операция = СсылкаНаОперацию.ПолучитьОбъект();
		Операция.Распоряжения.Очистить();
	Иначе
		Операция = Справочники.вмс_Операции.СоздатьЭлемент();
		Операция.Заполнить(Неопределено);
	КонецЕсли;
	
	Операция.Наименование = Наименование;
	Операция.ИмяДляПоиска = ИмяДляПоиска;                              
	Операция.ОбработкаВФормеСписка = ОбработкаВФормеСписка;
	Операция.ПоРаспоряжению = НаименованияРаспоряжений.Количество() > 0;  
	
	Если Операция.ПоРаспоряжению Тогда
		Для Каждого РаспоряжениеИмя Из НаименованияРаспоряжений[ТипОперации] Цикл
			Распоряжение = Операция.Распоряжения.Добавить();
			Распоряжение.СсылкаНаРаспоряжение = Справочники.вмс_РаспоряженияОпераций.НайтиПоНаименованию(РаспоряжениеИмя, Истина);
		КонецЦикла;
	КонецЕсли;
	
	Операция.Записать();
	
КонецПроцедуры

Функция СоздатьПредопределенныеЛицензииПодсистем() Экспорт
	ИменаВсехПодсистем = вмс_ОбщегоНазначенияКлиентСервер.ИменаВсехПодсистем();
	
	ПредопределенныеЭлементы = Новый ТаблицаЗначений;
	ПредопределенныеЭлементы.Колонки.Добавить("Подсистема", Новый ОписаниеТипов("Строка"), "Подсистема");
	ПредопределенныеЭлементы.Колонки.Добавить("Отображение", Новый ОписаниеТипов("Строка"), "Отображение");
	
	Для Индекс = 1 По ИменаВсехПодсистем.Имена.Количество() Цикл
		ПредопределенныеЭлементы.Добавить();
	КонецЦикла;  
	
	ПредопределенныеЭлементы.ЗагрузитьКолонку(ИменаВсехПодсистем.Имена, "Подсистема");
	ПредопределенныеЭлементы.ЗагрузитьКолонку(ИменаВсехПодсистем.Отображения, "Отображение");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПредопределенныеЭлементы.Подсистема КАК Подсистема,
	|	ПредопределенныеЭлементы.Отображение КАК Отображение
	|ПОМЕСТИТЬ Предпоределенные
	|ИЗ
	|	&ПредопределенныеЭлементы КАК ПредопределенныеЭлементы
	|;

	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Предпоределенные.Подсистема КАК Подсистема,
	|	Предпоределенные.Отображение КАК Отображение
	|ИЗ
	|	Предпоределенные КАК Предпоределенные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.вмс_ЛицензииПодсистем КАК вмс_ЛицензииПодсистем
	|		ПО ((ВЫРАЗИТЬ(Предпоределенные.Подсистема КАК СТРОКА(100))) = вмс_ЛицензииПодсистем.Подсистема)
	|ГДЕ
	|	вмс_ЛицензииПодсистем.Подсистема ЕСТЬ NULL"; 
	Запрос.УстановитьПараметр("ПредопределенныеЭлементы", ПредопределенныеЭлементы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяЛицензияПодсистем = РегистрыСведений.вмс_ЛицензииПодсистем.СоздатьМенеджерЗаписи();
		НоваяЛицензияПодсистем.Заполнить(Неопределено);
		НоваяЛицензияПодсистем.Подсистема  = Выборка.Подсистема;
		НоваяЛицензияПодсистем.Отображение = Выборка.Отображение; 
		НоваяЛицензияПодсистем.Лицензия    = "";
		НоваяЛицензияПодсистем.Записать(Ложь);
	КонецЦикла;
КонецФункции

