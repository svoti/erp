Функция ОбновитьПравилаЗаполненияЗаданийКладовщику() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_ПравилаЗаполненияЗадачиКладовщику.Ссылка КАК Правило,
	|	вмс_Операции.Ссылка КАК ОперацияПлана
	|ИЗ
	|	Справочник.вмс_ПравилаЗаполненияЗадачиКладовщику КАК вмс_ПравилаЗаполненияЗадачиКладовщику
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.вмс_Операции КАК вмс_Операции
	|		ПО вмс_ПравилаЗаполненияЗадачиКладовщику.Удалить_Товары_ОперацияПлана = вмс_Операции.Ссылка";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПравилоОбъект = Выборка.Правило.ПолучитьОбъект();
		Если ПравилоОбъект.ПредыдущиеОперации.Количество() = 0 Тогда
			ЭлементПредыдущаяОперация = ПравилоОбъект.ПредыдущиеОперации.Добавить();
			ЭлементПредыдущаяОперация.ПредыдущаяОперация = ПравилоОбъект.Удалить_Товары_ОперацияПлана;
		КонецЕсли;
