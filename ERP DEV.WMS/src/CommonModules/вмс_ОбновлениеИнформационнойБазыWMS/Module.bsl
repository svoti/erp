#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

Функция Имя() Экспорт
	
	Возврат "WMS";
	
КонецФункции

// Функция - Версия
// Возвращает версию модуля. 
//
// Возвращаемое значение:
//   Строка - версия модуля.
//
Функция Версия() Экспорт
	
	РасширениеКонфигурации = РасширениеКонфигурации();
	
	Если РасширениеКонфигурации <> Неопределено Тогда
		Возврат РасширениеКонфигурации.Версия;
	КонецЕсли;
	
	//Возврат "1.0.0.4";
	
КонецФункции

// проверяет изменено ли расширение после запуска сеанса
//
// Возвращаемое значение:
//   Булево - Истина, если хеш-сумма расширения конфигурации изменилась.
//
Функция РасширениеКонфигурацииИзменено() Экспорт
	
	Возврат ПараметрыСеанса.вмс_ХешСуммаРасширенияКонфигурации <> ХешСуммаРасширенияКонфигурации();
	
КонецФункции

Функция ХешСуммаРасширенияКонфигурации() Экспорт
	
	РасширениеКонфигурации = РасширениеКонфигурации();
	
	Если РасширениеКонфигурации <> Неопределено Тогда
		Возврат РасширениеКонфигурации.ХешСумма;
	КонецЕсли;
	
	Возврат ПолучитьДвоичныеДанныеИзСтроки("");
	
КонецФункции

Функция РасширениеКонфигурации() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	РасширениеКонфигурацииМассив = РасширенияКонфигурации.Получить(Новый Структура("Имя", Имя()));
	Если РасширениеКонфигурацииМассив.Количество() > 0 Тогда
		РасширениеКонфигурации = РасширениеКонфигурацииМассив[0];
		Возврат РасширениеКонфигурации;
	КонецЕсли;
КонецФункции

// Функция - Версия совместимости
// Возвращает номер текущей версии для работы мобильного приложения. 
// В мобильном приложении при авторизации сверяется Версия МП и версия совместимости.
//
// Возвращаемое значение:
//   Строка - версия для мобильного приложения
//
Функция ВерсияСовместимости() Экспорт
	Возврат "1.0.0.4";		
КонецФункции


