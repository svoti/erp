Функция ОбщийОбработчик() Экспорт
	
	ВерсияОт = вмс_ОбновлениеИнформационнойБазыСлужебный.ВерсияИБ(Имя());
	
	вмс_ОбновлениеИнформационнойБазы.ЗагрузитьЭлементыИзМакета("ПредопределенныеЭлементыНастроекПрограммы", "Справочник.вмс_НастройкиПрограммы", ВерсияОт);	
	//вмс_ОбновлениеИнформационнойБазы.ЗагрузитьПредопределенныеОбъектыИБИзОбщегоМакета("ПредопределенныеЭлементыОперацииТСД", , ВерсияОт);
	
	//3.2.4+
	Если вмс_АдаптацияКонфигураций.ЭтоУТ() Тогда
		вмс_ОбновлениеИнформационнойБазы.ЗагрузитьЭлементыИзМакета("ПредопределенныеЭлементыПравилЗаполненияЗадачиКладовщикуУТ", , ВерсияОт);
	ИначеЕсли вмс_АдаптацияКонфигураций.ЭтоКА() Тогда
		вмс_ОбновлениеИнформационнойБазы.ЗагрузитьЭлементыИзМакета("ПредопределенныеЭлементыПравилЗаполненияЗадачиКладовщикуУТ", , ВерсияОт);
	ИначеЕсли вмс_АдаптацияКонфигураций.ЭтоЕРП() Тогда
