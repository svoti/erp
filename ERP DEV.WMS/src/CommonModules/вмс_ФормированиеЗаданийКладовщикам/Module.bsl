КонецФункции

Функция НовоеЗаполнениеТабличнойЧастиЗадания(ИмяТабличнойЧасти, Данные=Неопределено, Ресурсы=Неопределено)
	
	РК = вмс_РаботаСКоллекциями;
	
	ЗаполнениеТабличнойЧастиЗадания = Новый Структура;
	ЗаполнениеТабличнойЧастиЗадания.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	ЗаполнениеТабличнойЧастиЗадания.Вставить("Данные", Новый ТаблицаЗначений);
	ЗаполнениеТабличнойЧастиЗадания.Вставить("ПоляДанных", Новый Массив);
	ЗаполнениеТабличнойЧастиЗадания.Вставить("ПоляГруппы", Новый Массив);
	ЗаполнениеТабличнойЧастиЗадания.Вставить("Ресурсы", Новый Массив);
	ЗаполнениеТабличнойЧастиЗадания.Вставить("КолонкаИтога", "Количество");
	
	Если Данные <> Неопределено Тогда
		ПоляДанных = РК.ПолучитьКолонкиКоллекции(Данные);
		РК.ДобавитьЭлементыКоллекции(ЗаполнениеТабличнойЧастиЗадания.ПоляДанных, ПоляДанных);
		РК.ДополнитьКолонкиТаблицыЗначений(ЗаполнениеТабличнойЧастиЗадания.Данные, ЗаполнениеТабличнойЧастиЗадания.ПоляДанных);
		РК.ДобавитьЭлементыКоллекции(ЗаполнениеТабличнойЧастиЗадания.Данные, Данные);
	КонецЕсли;
	
	Если Ресурсы <> Неопределено Тогда
		РК.ДобавитьЭлементыКоллекции(ЗаполнениеТабличнойЧастиЗадания.Ресурсы, Ресурсы);
	КонецЕсли;
	
	РК.ДобавитьЭлементыКоллекции(ЗаполнениеТабличнойЧастиЗадания.ПоляГруппы, ЗаполнениеТабличнойЧастиЗадания.ПоляДанных);
	РК.ВычестьМассив(ЗаполнениеТабличнойЧастиЗадания.ПоляГруппы, ЗаполнениеТабличнойЧастиЗадания.Ресурсы);
	
	// предопределенный ресурс
	РК.ДобавитьЭлементыКоллекции(ЗаполнениеТабличнойЧастиЗадания.Ресурсы, "Количество");
	РК.УдалитьДублиВМассиве(ЗаполнениеТабличнойЧастиЗадания.Ресурсы);
	ЗаполнениеТабличнойЧастиЗадания.Ресурсы = РК.ПересечениеМассивов(ЗаполнениеТабличнойЧастиЗадания.Ресурсы, ЗаполнениеТабличнойЧастиЗадания.ПоляДанных);
	
	Возврат ЗаполнениеТабличнойЧастиЗадания;
	
КонецФункции
