				КонецЕсли;
				
			КонецЕсли;
			
			// Развернем входящие параметры, в которых может быть вызов других методов или подпрограмм
			// чтобы исключить двойной вызов вложенных подпрограмм (сначала при попытке вызова переопределенного метода, а потом нативного)
