				КонецЕсли;

				
				
				// Также развернем выражение контекстного объекта так, как
				// оно по сути тоже является главным параметром при вызове сервисной функции
				опОбъект = опВызовМетода.Операторы[0];
				Если РазворачиватьТипыОператоровПриВызовеМетодов[опОбъект.ТипОператора]=Истина И НЕ(опОбъект.ДополнительныеДанные.Свойство("НеПреобразовывать") И опОбъект.ДополнительныеДанные.НеПреобразовывать=Истина) Тогда
