Функция ЗакрытьОператорСкобки(опСкобки, ТекстовыйПарсер)

	НовыйОператор(ТекстовыйПарсер, опСкобки, Слово(ТекстовыйПарсер.ТипыСловИОператоров.Спецсимвол, ")"));
	
КонецФункции

Функция НовыйОператор(ТекстовыйПарсер, Родитель=Неопределено, Слово=Неопределено, знач Индекс=Неопределено)

	НовыйОператор = Новый Структура(ТекстовыйПарсер.ПоляОператоров);
	НовыйОператор.Операторы = Новый Массив;
	НовыйОператор.ЛевоеЗначение = Истина;
	НовыйОператор.ДополнительныеДанные = Новый Структура;
	
	Если Слово <> Неопределено Тогда
		НовыйОператор.ТипОператора = Слово.ТипСлова;
		НовыйОператор.Код = Слово.Слово;
		НовыйОператор.НомерСтроки = Слово.НомерСтроки;
	КонецЕсли;
	
	ПоместитьОператор(ТекстовыйПарсер, Родитель, НовыйОператор, Индекс);
	
	Возврат НовыйОператор;
	
КонецФункции

Функция ПоместитьОператор(ТекстовыйПарсер, знач Родитель=Неопределено, Оператор, знач Индекс=Неопределено)
	
	ПредыдущийРодитель = Оператор.Родитель;
	Если ПредыдущийРодитель<>Неопределено Тогда
		ПредыдущийИндекс = ПредыдущийРодитель.Операторы.Найти(Оператор);
		Если ПредыдущийИндекс<>Неопределено Тогда
			ПредыдущийРодитель.Операторы.Удалить(ПредыдущийИндекс);
		КонецЕсли;
	КонецЕсли;
	
	Если Индекс=Неопределено Тогда
		Если Родитель<>Неопределено Тогда
			Индекс = Родитель.Операторы.Количество();
			Родитель.Операторы.Добавить(Оператор);
		КонецЕсли;
	Иначе
		Если ТипЗнч(Индекс) <> Тип("Число") Тогда
			ОператорПозиции = Индекс;
			Родитель = ОператорПозиции.Родитель;
			Если Родитель<>Неопределено Тогда
				Индекс = Родитель.Операторы.Найти(ОператорПозиции);
			Иначе
				Индекс = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		Если Родитель<>Неопределено Тогда
			Если Индекс <> Неопределено Тогда
				Родитель.Операторы.Вставить(Индекс, Оператор);
			Иначе
				Индекс = Родитель.Операторы.Количество();
				Родитель.Операторы.Добавить(Оператор);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Оператор.Родитель = Родитель;
	Если Родитель<>Неопределено Тогда
		Если Оператор.ЛевоеЗначение Тогда
			Оператор.ЛевоеЗначение = Родитель.ЛевоеЗначение;
		КонецЕсли;
		Оператор.ПространствоИмен = Родитель.ПространствоИмен;
		
		Если Оператор.НомерСтроки=Неопределено Тогда
			Если ОператорПозиции=Неопределено Тогда
				Если Индекс>0 Тогда
					ОператорПозиции = Родитель.Операторы[Индекс-1];
					Оператор.НомерСтроки = ОператорПозиции.НомерСтроки;
				Иначе
					Оператор.НомерСтроки = Родитель.НомерСтроки;
				КонецЕсли;
			Иначе
				Оператор.НомерСтроки = ОператорПозиции.НомерСтроки;
			КонецЕсли;
		Иначе
			Если Родитель.НомерСтроки=Неопределено ИЛИ Родитель.Операторы.Количество()=1 Тогда
				Родитель.НомерСтроки = Оператор.НомерСтроки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция СкопироватьОператор(ТекстовыйПарсер, ОператорИсточник, знач Родитель=Неопределено)
	
	СкопированныеОператоры = ТекстовыйПарсер.ДополнительныеДанные.СкопированныеОператоры;
	СкопированныеОператоры.Очистить();

	Если Родитель=Неопределено Тогда
		Родитель = ОператорИсточник.Родитель;
	КонецЕсли;
	
	СкопированныеОператоры[ОператорИсточник.Родитель] = Родитель;
	
	ВсеОператоры = ПолучитьВсеОператоры(ОператорИсточник);
	Для Каждого Оператор Из ВсеОператоры Цикл
		КопияОператора = НовыйОператор(ТекстовыйПарсер, , , Оператор);
		ЗаполнитьЗначенияСвойств(КопияОператора, Оператор, "ТипОператора, Код, ЛевоеЗначение");

		ОператорРодитель = Оператор.Родитель;
		КопияОператораРодителя = СкопированныеОператоры[ОператорРодитель];
		Если КопияОператораРодителя<>ОператорРодитель Тогда
			ПоместитьОператор(ТекстовыйПарсер, КопияОператораРодителя, КопияОператора);
		КонецЕсли;
		
		СкопированныеОператоры[Оператор] = КопияОператора;
	КонецЦикла;
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	МассивПолейОператоровКопируемыхЗначений = ТекстовыйПарсер.МассивПолейОператоровКопируемыхЗначений;
	Для Каждого Оператор Из ВсеОператоры Цикл

		КопияОператора = СкопированныеОператоры[Оператор];
		Для Каждого Поле Из МассивПолейОператоровКопируемыхЗначений Цикл
			Значение = Оператор[Поле];
			КопияЗначения = СкопированныеОператоры[Значение];
			Если КопияЗначения<>Неопределено Тогда
				КопияОператора[Поле] = КопияЗначения;
			Иначе
				КопияОператора[Поле] = Значение;
			КонецЕсли;
			
		КонецЦикла;
		
		ДополнительныеДанные = КопияОператора.ДополнительныеДанные;
		Для Каждого ЭлементДанных Из Оператор.ДополнительныеДанные Цикл
			
			Значение = ЭлементДанных.Значение;
			Если ТипЗнч(Значение)=Тип("Массив") Тогда
				КопияЗначения = Новый Массив;
				Для ИндексЭлемента=0 По Значение.ВГраница() Цикл
					ЭлементЗначения = Значение[ИндексЭлемента];
					КопияЭлементаЗначения = СкопированныеОператоры[ЭлементЗначения];
					Если КопияЭлементаЗначения<>Неопределено Тогда
						КопияЗначения.Добавить(КопияЭлементаЗначения);
					Иначе
						КопияЗначения.Добавить(ЭлементЗначения);
					КонецЕсли;
				КонецЦикла;
				ДополнительныеДанные.Вставить(ЭлементДанных.Ключ, КопияЗначения);
			Иначе
				КопияЗначения = СкопированныеОператоры[Значение];
				Если КопияЗначения<>Неопределено Тогда
					ДополнительныеДанные.Вставить(ЭлементДанных.Ключ, КопияЗначения);
				Иначе
					ДополнительныеДанные.Вставить(ЭлементДанных.Ключ, Значение);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;

	КопияОператора = СкопированныеОператоры[ОператорИсточник];
	
	Возврат КопияОператора;
	
КонецФункции

Функция УдалитьОператор(Оператор)
	
	Операторы = Оператор.Родитель.Операторы;
	ИндексОператора = Операторы.Найти(Оператор);
	Операторы.Удалить(ИндексОператора);
	
КонецФункции

Функция ПолучитьВсеОператоры(ГлавныеОператоры, знач РеверсироватьГоризонтально=Ложь, знач РеверсироватьВертикально=Ложь)
	
	ТекущийУровеньОператоров = Новый Массив;
	Если ТипЗнч(ГлавныеОператоры)=Тип("Массив") Тогда
		Для Каждого Оператор Из ГлавныеОператоры Цикл
			ТекущийУровеньОператоров.Добавить(Оператор);
		КонецЦикла;
	Иначе
		ТекущийУровеньОператоров.Добавить(ГлавныеОператоры);
	КонецЕсли;
	
	ВсеОператоры = Новый Массив;
	Для Каждого Оператор Из ТекущийУровеньОператоров Цикл
		ВсеОператоры.Добавить(Оператор);
	КонецЦикла;
	Индекс = 1;
	
	Пока ТекущийУровеньОператоров.Количество() > 0 Цикл
		Если РеверсироватьВертикально Тогда
			Индекс = 0;
		КонецЕсли;
		
		СледующийУровеньОператоров = Новый Массив;
		Для Каждого Оператор Из ТекущийУровеньОператоров Цикл
			Для Каждого СубОператор Из Оператор.Операторы Цикл
				ВсеОператоры.Вставить(Индекс, СубОператор);
				СледующийУровеньОператоров.Добавить(СубОператор);
				Если Не РеверсироватьГоризонтально Тогда
					Индекс = Индекс + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ТекущийУровеньОператоров = СледующийУровеньОператоров;
		
	КонецЦикла;
	
	Возврат ВсеОператоры;
	
КонецФункции



Функция ТекстовыйПарсер_РазобратьОператорПодпрограммы(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)

	Если ТекстовыйПарсер.ТекущееСлово.ТипСлова=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорЛогическийБлок(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорВозвратИзПодпрограммы(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТекстовыйПарсер_РазобратьОператорПеременные(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТекстовыйПарсер_РазобратьОператорПрисвоениеЗначения(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТекстовыйПарсер_РазобратьОперандВыражения(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорВыражение(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТекстовыйПарсер_РазобратьОператорСпецсимвол(ТекстовыйПарсер, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорПеременные(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)

	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Не (Слово.ТипСлова=ТипыСловИОператоров.Идентификатор И Слово.ВРСлово="ПЕРЕМ") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КонтекстИсполнения = ТекстовыйПарсер.КонтекстИсполнения;
	ПараметрыДирективыКомпиляции = ПолучитьПараметрыДирективыКомпиляции(Подпрограмма.ДополнительныеДанные.ДирективаКомпиляции);
	Если ПараметрыДирективыКомпиляции[КонтекстИсполнения] Тогда
		// оператор предназначен для данного контекста исполнения
		ТаблицаПеременных = Подпрограмма.ТаблицаПеременных;
		
		ОператорЛокальныеПеременные = НовыйОператор(ТекстовыйПарсер, ОператорВладелец, Слово(ТипыСловИОператоров.ЛокальныеПеременные));
		НовыйОператор(ТекстовыйПарсер, ОператорЛокальныеПеременные, Слово);

		СледующееСлово(ТекстовыйПарсер);
		
		НомерИдентификатора = 0;
		Пока Истина Цикл
			
			Слово = ТекстовыйПарсер.ТекущееСлово;
			Если Слово.ТипСлова = ТипыСловИОператоров.Спецсимвол И Слово.Слово = ";" Тогда
				Прервать;
			КонецЕсли;
			
			НовыйОператор(ТекстовыйПарсер, ОператорЛокальныеПеременные, Слово);
			
			Если Слово.ТипСлова = ТипыСловИОператоров.Спецсимвол И Слово.Слово = "," Тогда
				
				НомерИдентификатора = 0;
				
			ИначеЕсли Слово.ТипСлова = ТипыСловИОператоров.Идентификатор Тогда
				
				НомерИдентификатора = НомерИдентификатора + 1;
				Если НомерИдентификатора = 1 Тогда
					ИмяПеременной = Слово.Слово;
					Переменная = РаботаСКоллекциями.ДобавитьЭлементКоллекции(ТаблицаПеременных);
					Переменная.Имя = ИмяПеременной;
					Переменная.Экспорт = Ложь;
					Переменная.Нативный = Ложь;
				ИначеЕсли Слово.ВРСлово = "ЭКСПОРТ" ИЛИ Слово.ВРСлово = "НАТИВНЫЙ" Тогда
					Переменная[Слово.ВРСлово] = Истина;
				Иначе
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
			СледующееСлово(ТекстовыйПарсер);
			
		КонецЦикла;
		
	Иначе
		
		// оператор не предназначен для данного контекста исполнения
		Пока Истина Цикл
			
			Слово = СледующееСлово(ТекстовыйПарсер);
			Если Слово.ТипСлова=Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Если Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово = ";" Тогда
				СледующееСлово(ТекстовыйПарсер);
				Прервать;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорЛогическийБлок(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)

	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Слово.ТипСлова<>ТипыСловИОператоров.Идентификатор Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачалаЛогическихБлоков = ТекстовыйПарсер.ЛогическиеБлоки.НачалаЛогическихБлоков;
	ЛогическийБлок = НачалаЛогическихБлоков[Слово.ВРСлово];
	Если ЛогическийБлок = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Слово.ВРСлово="ОБЛАСТЬ" Тогда
		// используются только для операторов препроцессора
		Возврат Ложь;
	КонецЕсли;
	
	ЛогическийБлокЦиклДля = НачалаЛогическихБлоков["ДЛЯ"];
	
	тЛогическийБлок = ТипыСловИОператоров.ЛогическийБлок;
	
	ЭтоЦикл = ЛогическийБлок.Начало="ДЛЯ" ИЛИ ЛогическийБлок.Начало="ПОКА";
	
	КлючевыеСловаБлоков = ТекстовыйПарсер.ЛогическиеБлоки.КлючевыеСлова;
	Слово.Слово = КлючевыеСловаБлоков[Слово.ВРСлово];
	
	ОператорЛогическийБлок = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
	ОператорЛогическийБлок.Вставить("Тип", ЛогическийБлок);
	ОператорЛогическийБлок.ДополнительныеДанные.Вставить("Цепь", Ложь);
	ОператорЛогическийБлок.ДополнительныеДанные.Вставить("ЭтоЦикл", ЭтоЦикл);
	ОператорЛогическийБлок.ТипОператора = тЛогическийБлок;
	НовыйОператор(ТекстовыйПарсер, ОператорЛогическийБлок, Слово);
	СледующееСлово(ТекстовыйПарсер);

	Если ЛогическийБлок.ЕстьЗаголовок Тогда
		ПустаяСтрока = "";
		ОператорЗаголовок = НовыйОператор(ТекстовыйПарсер, ОператорЛогическийБлок);
		ОператорЗаголовок.ТипОператора = ТипыСловИОператоров.ЗаголовокЛогическогоБлока;
		Пока Истина Цикл
			Слово = ТекстовыйПарсер.ТекущееСлово;
			Если Слово.ТипСлова=ТипыСловИОператоров.Идентификатор Тогда
				Если Слово.ВРСлово=ЛогическийБлок.КонецЗаголовка Тогда
					Слово.Слово = КлючевыеСловаБлоков[Слово.ВРСлово];
					НовыйОператор(ТекстовыйПарсер, ОператорЛогическийБлок, Слово);
					СледующееСлово(ТекстовыйПарсер);
					Прервать;
				КонецЕсли;
				
				Если ОператорЗаголовок.ЛевоеЗначение Тогда
					Если ЛогическийБлок=ЛогическийБлокЦиклДля Тогда
						Если Слово.ВРСлово="КАЖДОГО" ИЛИ Слово.ВРСлово="ПО" Тогда
							ОператорЗаголовок.ЛевоеЗначение = Ложь;
						КонецЕсли;
					Иначе
						ОператорЗаголовок.ЛевоеЗначение = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если Не ТекстовыйПарсер_РазобратьОператорПодпрограммы(ТекстовыйПарсер, Подпрограмма, ОператорЗаголовок) Тогда
				Прервать;
			КонецЕсли;
			
			Если ЛогическийБлок.КонецЗаголовка=ПустаяСтрока Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		 
		ОператорЗаголовок.ЛевоеЗначение = Ложь;
	КонецЕсли;
	
	ТелоБлока = НовыйОператор(ТекстовыйПарсер, ОператорЛогическийБлок);
	ТелоБлока.ТипОператора = ТипыСловИОператоров.ТелоЛогическогоБлока;
	Пока Истина Цикл
		
		Слово = ТекстовыйПарсер.ТекущееСлово;
		Если Слово.ТипСлова=ТипыСловИОператоров.Идентификатор Тогда

			Если ЛогическийБлок.Концы[Слово.ВРСлово]=Истина Тогда
				Слово.Слово = КлючевыеСловаБлоков[Слово.ВРСлово];
				СледующийЛогическийБлок = НачалаЛогическихБлоков[Слово.ВРСлово];
				Если СледующийЛогическийБлок<>Неопределено Тогда
					// паравозиком идут следующие блоки
					ОператорЛогическийБлок.ДополнительныеДанные.Цепь = Истина;
				Иначе
					// этот блок последний в цепи, добавляем закрывающее ключевое слово
					НовыйОператор(ТекстовыйПарсер, ОператорЛогическийБлок, Слово);
					СледующееСлово(ТекстовыйПарсер);
				КонецЕсли;
		
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
		Пока Истина Цикл
			Если Не ТекстовыйПарсер_РазобратьОператорПодпрограммы(ТекстовыйПарсер, Подпрограмма, ТелоБлока) Тогда
				СледующееСлово(ТекстовыйПарсер);
				Прервать;
			КонецЕсли;
			
			Оператор = ТелоБлока.Операторы[ТелоБлока.Операторы.ВГраница()];
			Если Оператор.ТипОператора=тЛогическийБлок И Оператор.ДополнительныеДанные.Цепь Тогда
				// прочитан блок, соединенный с другими блоками, продолжим чтение цепочки блоков
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ОператорЛогическийБлок.ДополнительныеДанные.Вставить("Заголовок", ОператорЗаголовок);
	ОператорЛогическийБлок.ДополнительныеДанные.Вставить("Тело", ТелоБлока);
	
	Если ЭтоЦикл Тогда
		Подпрограмма.ДополнительныеДанные.ОператорыЦиклов.Добавить(ОператорЛогическийБлок);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорИдентификатор(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)

	Перем РаботаСКоллекциями;
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Не Слово.ТипСлова=ТипыСловИОператоров.Идентификатор Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТекстовыйПарсер.ЗарезервированныеИдентификаторы[Слово.ВРСлово]<>Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	тВызовПодпрограммы = ТипыСловИОператоров.ВызовПодпрограммы;
	тСкобки = ТипыСловИОператоров.Скобки;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	ОператорГруппа = Неопределено;
	ПространствоИмен = ОператорВладелец.ПространствоИмен;
	
	ПрочитатьИдентификатор = Истина;
	ТипОператора = тИдентификатор;
	Пока Истина Цикл

		Слово = ТекстовыйПарсер.ТекущееСлово;
		
		Если ПрочитатьИдентификатор Тогда
			
			Если Слово.ТипСлова=тИдентификатор Тогда
				ПрочитатьИдентификатор = Ложь;
				Если ОператорГруппа=Неопределено Тогда
					ОператорГруппа = НовыйОператор(ТекстовыйПарсер, ОператорВладелец, Слово);
				Иначе
					Оператор = НовыйОператор(ТекстовыйПарсер, ОператорГруппа, Слово);
					Оператор.ПространствоИмен = ПространствоИмен;
				КонецЕсли;
			Иначе
				Прервать;
			КонецЕсли;
			
		Иначе
			
			Если Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово="." Тогда
				
				ПрочитатьИдентификатор = Истина;
				ТипОператора = ТипыСловИОператоров.Поле;
				Оператор = ОператорГруппа;
				ОператорГруппа = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
				ОператорГруппа.ТипОператора = ТипОператора;
				ПоместитьОператор(ТекстовыйПарсер, ОператорГруппа, Оператор);
				Оператор.ЛевоеЗначение = Ложь;
				НовыйОператор(ТекстовыйПарсер, ОператорГруппа, Слово);
				ПространствоИмен = Оператор;
			
			ИначеЕсли Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово="[" Тогда
				
				ТипОператора = ТипыСловИОператоров.Поле;
				Пока Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово="[" Цикл
					Оператор = ОператорГруппа;
					
					ОператорГруппа = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
					ОператорГруппа.ТипОператора = ТипОператора;
					Если Оператор<>Неопределено Тогда
						ПоместитьОператор(ТекстовыйПарсер, ОператорГруппа, Оператор);
						Оператор.ЛевоеЗначение = Ложь;
					КонецЕсли;
					ПространствоИмен = Оператор;
					ТекстовыйПарсер_РазобратьОператорСкобки(ТекстовыйПарсер, Подпрограмма, ОператорГруппа);
					Слово = ТекстовыйПарсер.ТекущееСлово;
				КонецЦикла;
				Продолжить;
				
			ИначеЕсли Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово="(" Тогда

				Если ТипОператора = ТипыСловИОператоров.Поле Тогда
					ТипОператора = ТипыСловИОператоров.ВызовМетода;
				ИначеЕсли ТипОператора = тИдентификатор Тогда
					ТипОператора = тВызовПодпрограммы;
				КонецЕсли;
				
				Если ТипОператора = ТипыСловИОператоров.ВызовМетода Тогда
					ОператорОбъект = ОператорГруппа.Операторы[0];
					ОператорВызываемаяПодпрограмма = ОператорГруппа.Операторы[2];
				Иначе
					ОператорОбъект = Неопределено;
					ОператорВызываемаяПодпрограмма = ОператорГруппа;

					ОператорГруппа = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
					ПоместитьОператор(ТекстовыйПарсер, ОператорГруппа, ОператорВызываемаяПодпрограмма);
				КонецЕсли;
				
				ОператорГруппа.ТипОператора = ТипОператора;
				ОператорГруппа.ДополнительныеДанные.Вставить("Объект", ОператорОбъект);
				ОператорГруппа.ДополнительныеДанные.Вставить("ИмяКласса");
				ОператорГруппа.ДополнительныеДанные.Вставить("МетодОпределен", Ложь);
				ОператорГруппа.ДополнительныеДанные.Вставить("ИспользоватьНативныеМетоды", Ложь);
				ОператорГруппа.ДополнительныеДанные.Вставить("ВызываемаяПодпрограмма", ОператорВызываемаяПодпрограмма);
				
				ТекстовыйПарсер_РазобратьОператорСкобки(ТекстовыйПарсер, Подпрограмма, ОператорГруппа);
				ОператорГруппа.ДополнительныеДанные.Вставить("ОператорСкобки", ОператорГруппа.Операторы[ОператорГруппа.Операторы.ВГраница()]);
				
				ТекстовыйПарсер_РазобратьПараметрыВызоваПодпрограммы(ТекстовыйПарсер, Подпрограмма, ОператорГруппа);
				Продолжить;
				
			Иначе
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СледующееСлово(ТекстовыйПарсер);
		
	КонецЦикла;
	
	Если ОператорГруппа=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипОператора=тВызовПодпрограммы И ОператорГруппа.ТипОператора<>ТипОператора Тогда
		
		// Оператор вызова подпрограммы не завершен
		// не указаны параметры вызова, добавим пустые
		опВызываемаяПодпрограмма = ОператорГруппа;
		опВызовПодпрограммы = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
		опВызовПодпрограммы.ТипОператора = ТипОператора;
		ПоместитьОператор(ТекстовыйПарсер, опВызовПодпрограммы, опВызываемаяПодпрограмма);

		опВызовПодпрограммы.ДополнительныеДанные.Вставить("Объект");
		опВызовПодпрограммы.ДополнительныеДанные.Вставить("ИмяКласса");
		опВызовПодпрограммы.ДополнительныеДанные.Вставить("МетодОпределен", Ложь);
		опВызовПодпрограммы.ДополнительныеДанные.Вставить("ИспользоватьНативныеМетоды", Ложь);
		опВызовПодпрограммы.ДополнительныеДанные.Вставить("ВызываемаяПодпрограмма", опВызываемаяПодпрограмма);

		опСкобки = НовыйОператорСкобки(ТекстовыйПарсер, опВызовПодпрограммы);
		ЗакрытьОператорСкобки(опСкобки, ТекстовыйПарсер);
		опВызовПодпрограммы.ДополнительныеДанные.Вставить("ОператорСкобки", опСкобки);
		
		ТекстовыйПарсер_РазобратьПараметрыВызоваПодпрограммы(ТекстовыйПарсер, Подпрограмма, опВызовПодпрограммы);
		
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорПрисвоениеЗначения(ТекстовыйПарсер, Подпрограмма, знач ОператорВладелец)
	
	Если Не ОператорВладелец.ЛевоеЗначение Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КоличествоОператоров = ОператорВладелец.Операторы.Количество();
	Если КоличествоОператоров<1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Не Слово.Слово="=" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	Если Не Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол Тогда
		Возврат Ложь;
	КонецЕсли;
	
	опЛевоеЗначение = ОператорВладелец.Операторы[КоличествоОператоров-1];
	Если Не (опЛевоеЗначение.ТипОператора=ТипыСловИОператоров.Идентификатор ИЛИ опЛевоеЗначение.ТипОператора=ТипыСловИОператоров.Поле) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	опПрисвоениеЗначения = НовыйОператор(ТекстовыйПарсер, , , опЛевоеЗначение);
	опПрисвоениеЗначения.ТипОператора = ТипыСловИОператоров.ПрисвоениеЗначения;
	ПоместитьОператор(ТекстовыйПарсер, опПрисвоениеЗначения, опЛевоеЗначение);
	НовыйОператор(ТекстовыйПарсер, опПрисвоениеЗначения, Слово); //"="
	СледующееСлово(ТекстовыйПарсер);
	ТекстовыйПарсер_РазобратьОператорВыражение(ТекстовыйПарсер, Подпрограмма, опПрисвоениеЗначения);
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорНовыйОбъект(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Не (Слово.ТипСлова=тИдентификатор И Слово.ВРСлово="НОВЫЙ") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	опНовыйОбъект = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
	опНовыйОбъект.ТипОператора = ТипыСловИОператоров.НовыйОбъект;
	НовыйОператор(ТекстовыйПарсер, опНовыйОбъект, Слово);
	
	Слово = СледующееСлово(ТекстовыйПарсер);
	Если Слово.ТипСлова=тИдентификатор Тогда
		опТипОбъекта = НовыйОператор(ТекстовыйПарсер, опНовыйОбъект, Слово);
		Слово = СледующееСлово(ТекстовыйПарсер);
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорСкобки(ТекстовыйПарсер, Подпрограмма, опНовыйОбъект) Тогда
		опСкобки = ТекстовыйПарсер.ТекущийОператор;
	Иначе
		опСкобки = НовыйОператорСкобки(ТекстовыйПарсер, опНовыйОбъект);
		ЗакрытьОператорСкобки(опСкобки, ТекстовыйПарсер);
	КонецЕсли;
	
	опНовыйОбъект.ДополнительныеДанные.Вставить("ОператорТипОбъекта", опТипОбъекта);
	опНовыйОбъект.ДополнительныеДанные.Вставить("ОператорСкобки", опСкобки);
	ТекстовыйПарсер_РазобратьПараметрыВызоваПодпрограммы(ТекстовыйПарсер, Подпрограмма, опНовыйОбъект);
	ТекстовыйПарсер.ТекущийОператор = опНовыйОбъект;
	
	Подпрограмма.ДополнительныеДанные.ОператорыСозданияНовыхОбъектов.Добавить(опНовыйОбъект);
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорВыражение(ТекстовыйПарсер, Подпрограмма, знач ОператорВладелец)
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тВыражение = ТипыСловИОператоров.Выражение;
	тОперацияВыражения = ТипыСловИОператоров.ОперацияВыражения;
	
	Если ТекстовыйПарсер_РазобратьОперандВыражения(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
	
		КоличествоОператоров = ОператорВладелец.Операторы.Количество();
		ПервыйОперанд = ОператорВладелец.Операторы[КоличествоОператоров-1];
		ОперацияВыражения = Неопределено;
		
	ИначеЕсли ТекстовыйПарсер_РазобратьОперациюВыражения(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		
		КоличествоОператоров = ОператорВладелец.Операторы.Количество();
		Если КоличествоОператоров > 1 Тогда
			// Первый операнд уже был прочитан вне выражения
			// поместим его внутрь выражения
			ПервыйОперанд = ОператорВладелец.Операторы[КоличествоОператоров-2];
		Иначе
			ПервыйОперанд = Неопределено;
		КонецЕсли;
		ОперацияВыражения = ОператорВладелец.Операторы[КоличествоОператоров-1];
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ОператорВыражение = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
	ОператорВыражение.ТипОператора = тВыражение;
	ОператорВыражение.ЛевоеЗначение = Ложь;
	Если ПервыйОперанд<>Неопределено Тогда
		ПоместитьОператор(ТекстовыйПарсер, ОператорВыражение, ПервыйОперанд);
		УнарнаяОперация = Ложь;
	Иначе
		// унарный оператор перед операндом так, как операнд еще не прочитан
		УнарнаяОперация = Истина;
	КонецЕсли;
	
	Если ОперацияВыражения<>Неопределено Тогда
		ПоместитьОператор(ТекстовыйПарсер, ОператорВыражение, ОперацияВыражения);
		РазобратьОперанд = Истина;
	Иначе
		РазобратьОперанд = Ложь;
	КонецЕсли;
	
	Пока Истина Цикл
		
		Если РазобратьОперанд Тогда
			Если ТекстовыйПарсер_РазобратьОперандВыражения(ТекстовыйПарсер, Подпрограмма, ОператорВыражение) Тогда
				Если УнарнаяОперация Тогда
					КоличествоОператоров = ОператорВыражение.Операторы.Количество();
					ОперацияВыражения = ОператорВыражение.Операторы[КоличествоОператоров-2];
					Операнд = ОператорВыражение.Операторы[КоличествоОператоров-1];
					
					// вложенное выражение с унарной операцией
					ОператорВложенноеВыражение = НовыйОператор(ТекстовыйПарсер, ОператорВыражение);
					ОператорВложенноеВыражение.ТипОператора = тВыражение;
					ПоместитьОператор(ТекстовыйПарсер, ОператорВложенноеВыражение, ОперацияВыражения);
					ПоместитьОператор(ТекстовыйПарсер, ОператорВложенноеВыражение, Операнд);
					УнарнаяОперация = Ложь;
				КонецЕсли;
			Иначе
				// может унарная операция?
				Если УнарнаяОперация Тогда
					//нет
					Прервать;
				КонецЕсли;
				УнарнаяОперация = Истина;
			КонецЕсли;
		Иначе
			Если Не ТекстовыйПарсер_РазобратьОперациюВыражения(ТекстовыйПарсер, Подпрограмма, ОператорВыражение) Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		РазобратьОперанд = Не РазобратьОперанд;
	КонецЦикла;
	
	ТекстовыйПарсер_СгруппироватьОперацииВыраженияПоПриоритетам(ТекстовыйПарсер, Подпрограмма, ОператорВыражение);
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_СгруппироватьОперацииВыраженияПоПриоритетам(ТекстовыйПарсер, Подпрограмма, ОператорВыражение)

	Перем РК;
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	ТипВыражение = ТипыСловИОператоров.Выражение;
	ТипОперацияВыражения = ТипыСловИОператоров.ОперацияВыражения;
	
	ПорядкиОпераций = Новый Массив;
	ОперацииПорядков = Новый Соответствие;
	Для Каждого ОператорВыражения Из ОператорВыражение.Операторы Цикл
		
		Если ОператорВыражения.ТипОператора<>ТипОперацияВыражения Тогда
			Продолжить;
		КонецЕсли;
		
		ОператорОперации = ОператорВыражения;
		
		ПорядокОпераций = ОператорОперации.Порядок;
		ОперацииПорядка = ОперацииПорядков[ПорядокОпераций];
		Если ОперацииПорядка=Неопределено Тогда
			ОперацииПорядка = Новый Массив;
			ОперацииПорядков[ПорядокОпераций] = ОперацииПорядка;
			
			ПорядкиОпераций.Добавить(ПорядокОпераций);
		КонецЕсли;
		ОперацииПорядка.Добавить(ОператорОперации);
		
	КонецЦикла;
	
	Если ПорядкиОпераций.Количество() < 2 Тогда
		// группировки не требуются
		Возврат Истина;
	КонецЕсли;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	РК.СортироватьКоллекцию(ПорядкиОпераций);
	
	Для Каждого ПорядокОпераций Из ПорядкиОпераций Цикл
		
		ПредыдущийОператор = Неопределено;
		НачалоГруппы = Неопределено;
		КонецГруппы = Неопределено;
		ИскатьНачалоГруппы = Истина;
		ОбработатьКонецГруппы = Ложь;
		ИндексОператора = ОператорВыражение.Операторы.Количество();
		Пока ИндексОператора > 0 Цикл

			ИндексОператора = ИндексОператора - 1;
			ОператорВыражения = ОператорВыражение.Операторы[ИндексОператора];
				
			Если ОператорВыражения.ТипОператора=ТипОперацияВыражения Тогда
			
				Если ИскатьНачалоГруппы Тогда
					
					Если ОператорВыражения.Порядок=ПорядокОпераций Тогда
						НачалоГруппы = ПредыдущийОператор;
						ИскатьНачалоГруппы = Ложь;
					КонецЕсли;
					
				Иначе
					
					Если ОператорВыражения.Порядок<>ПорядокОпераций Тогда
						КонецГруппы = ПредыдущийОператор;
						ОбработатьКонецГруппы = Истина;
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЕсли;
			
			Если Не ИскатьНачалоГруппы Тогда
				Если ИндексОператора=0 Тогда
					КонецГруппы = ОператорВыражения;
					ОбработатьКонецГруппы = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ОбработатьКонецГруппы Тогда
				ИндексНачалаГруппы = ОператорВыражение.Операторы.Найти(НачалоГруппы);
				ИндексКонцаГруппы = ОператорВыражение.Операторы.Найти(КонецГруппы);
				Если ИндексНачалаГруппы > ИндексКонцаГруппы Тогда
					ВремПерем = ИндексНачалаГруппы;
					ИндексНачалаГруппы = ИндексКонцаГруппы;
					ИндексКонцаГруппы = ВремПерем;
				КонецЕсли;
				
				Если ИндексНачалаГруппы=0 И ИндексКонцаГруппы=ОператорВыражение.Операторы.Количество()-1 Тогда
					// Попали все операторы исходной группы
					// в таком случае нет смысла выделять внутреннюю группу
					Прервать;
				КонецЕсли;
				
				ОператорыГруппы = Новый Массив;
				Для ИндексОператораГруппы=ИндексНачалаГруппы По ИндексКонцаГруппы Цикл
					ОператорГруппы = ОператорВыражение.Операторы[ИндексОператораГруппы];
					ОператорыГруппы.Добавить(ОператорГруппы);
				КонецЦикла;

				ОператорГруппыВыражения = НовыйОператор(ТекстовыйПарсер, ОператорВыражение, , НачалоГруппы);
				ОператорГруппыВыражения.ТипОператора = ТипВыражение;
				Для Каждого ОператорГруппы Из ОператорыГруппы Цикл
					ПоместитьОператор(ТекстовыйПарсер, ОператорГруппыВыражения, ОператорГруппы);
				КонецЦикла;

				ИскатьНачалоГруппы = Истина;
				ОбработатьКонецГруппы = Ложь;
			КонецЕсли;
			
			ПредыдущийОператор = ОператорВыражения;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОперандВыражения(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)

	Если ТекстовыйПарсер.ТекущееСлово.ТипСлова=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорНовыйОбъект(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорИдентификатор(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТекстовыйПарсер_РазобратьОператорЧисло(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорСтрока(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорСкобки(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТекстовыйПарсер_РазобратьОператорЛинейныйУсловныйОператор(ТекстовыйПарсер, Подпрограмма, ОператорВладелец) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорЛинейныйУсловныйОператор(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)

	Перем РК;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если НЕ (Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово="?") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	опУсловныйОператор = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
	опУсловныйОператор.ЛевоеЗначение = Ложь;
	опУсловныйОператор.ТипОператора = ТипыСловИОператоров.ЛинейныйУсловныйОператор;
	НовыйОператор(ТекстовыйПарсер, опУсловныйОператор, Слово);

	СледующееСлово(ТекстовыйПарсер);
	Если НЕ ТекстовыйПарсер_РазобратьОператорСкобки(ТекстовыйПарсер, Подпрограмма, опУсловныйОператор) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции
	
Функция ТекстовыйПарсер_РазобратьОперациюВыражения(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	ТипСпецсимвол = ТипыСловИОператоров.Спецсимвол;
	ТипИдентификатор = ТипыСловИОператоров.Идентификатор;
	Слово = ТекстовыйПарсер.ТекущееСлово;

	Если НЕ (Слово.ТипСлова=ТипСпецсимвол ИЛИ Слово.ТипСлова=ТипИдентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОперацииВыражений = ТекстовыйПарсер.ОперацииВыражений;
	ОперацияВыражения = ОперацииВыражений[ВРег(Слово.Слово)];
	Если ОперацияВыражения=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СледующееСлово(ТекстовыйПарсер);
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Слово.ТипСлова=ТипСпецсимвол Тогда
		ОперацияВыражения2 = ОперацииВыражений[ОперацияВыражения.Тип + Слово.Слово];
		Если ОперацияВыражения2<>Неопределено Тогда
			// из двух символов
			ОперацияВыражения = ОперацияВыражения2;
			СледующееСлово(ТекстовыйПарсер);
		КонецЕсли;
	КонецЕсли;
	
	ОператорВыражения = НовыйОператор(ТекстовыйПарсер, ОператорВладелец, Слово(ТипыСловИОператоров.ОперацияВыражения, ОперацияВыражения.Тип));
	ОператорВыражения.Вставить("Порядок", ОперацияВыражения.Порядок);
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорСкобки(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)
	
	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Слово.ТипСлова<>ТипыСловИОператоров.Спецсимвол Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеСкобок = ТекстовыйПарсер.ОписанияСкобок.ЛевыеСкобки[Слово.Слово];
	Если ОписаниеСкобок=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗакрывающаяСкобка = ОписаниеСкобок.Конец;
	
	опСкобки = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
	опСкобки.ТипОператора = ТипыСловИОператоров.Скобки;
	опСкобки.ЛевоеЗначение = Ложь; //внутри может быть выражение, но без присвоения значения
	опСкобки.ПространствоИмен = Неопределено; //операторы внутри скобок будут в глобальном пространстве...
	
	НовыйОператор(ТекстовыйПарсер, опСкобки, Слово);
	СледующееСлово(ТекстовыйПарсер);
	
	Пока Истина Цикл

		Слово = ТекстовыйПарсер.ТекущееСлово;
		Если Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово=ЗакрывающаяСкобка Тогда
			НовыйОператор(ТекстовыйПарсер, опСкобки, Слово);
			СледующееСлово(ТекстовыйПарсер);
			// ... а сами скобки в указанном пространстве
			опСкобки.ПространствоИмен = ОператорВладелец.ПространствоИмен;
			ТекстовыйПарсер.ТекущийОператор = опСкобки;
			Возврат Истина;
		КонецЕсли;
		
		Если Не ТекстовыйПарсер_РазобратьОператорПодпрограммы(ТекстовыйПарсер, Подпрограмма, опСкобки) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорЧисло(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)
	
	НомерСловаПередРазбором = ТекстовыйПарсер.НомерТекущегоСлова;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	// проверим знак
	//Слово = ТекстовыйПарсер.ТекущееСлово;
	//Если Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И (Слово.Слово="+" ИЛИ Слово.Слово="-") Тогда
	//	СловоЗнак = Слово;
