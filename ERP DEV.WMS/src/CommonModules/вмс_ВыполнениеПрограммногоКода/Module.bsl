	слОпущенныйПараметр = Слово(тСтрока, "ОпущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162");
	
	РазворачиватьТипыОператоровПриВызовеМетодов = Новый Соответствие;
	РазворачиватьТипыОператоровПриВызовеМетодов[тВызовМетода] = Истина;
	РазворачиватьТипыОператоровПриВызовеМетодов[тВызовПодпрограммы] = Истина;
	РазворачиватьТипыОператоровПриВызовеМетодов[тНовыйОбъект] = Истина;
	РазворачиватьТипыОператоровПриВызовеМетодов[тСкобки] = Истина;
	РазворачиватьТипыОператоровПриВызовеМетодов[тВыражение] = Истина;
	
	СкопированныеОператоры = ТекстовыйПарсер.ДополнительныеДанные.СкопированныеОператоры;

	// сначала развернем вложенные вызовы в параметрах вызова и в выражениях
	
