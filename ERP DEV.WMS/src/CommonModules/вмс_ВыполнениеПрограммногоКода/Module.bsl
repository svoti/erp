Функция НовыйКомпиляторКода() Экспорт
	
	Перем РК, ОбщегоНазначенияКлиентСервер;
	
	ТекстовыйПарсер = НовыйТекстовыйПарсер();
	КонтекстыИсполнения = ТекстовыйПарсер.КонтекстыИсполнения;

	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	Если ОбщегоНазначенияКлиентСервер.ЭтоКлиент() Тогда
		КонтекстИсполнения = КонтекстыИсполнения.Клиент;
	Иначе
		КонтекстИсполнения = КонтекстыИсполнения.Сервер;
	КонецЕсли;

	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
	ОбработчикиОжидания = РК.НоваяКвазиТаблицаЗначений("ИмяПроцедуры, Интервал, Однократно, ВремяНачала");
	ОбработкаОжидания = Новый Структура;
	ОбработкаОжидания.Вставить("ОбработчикиОжидания", ОбработчикиОжидания);
	ОбработкаОжидания.Вставить("Время", 0);
	ОбработкаОжидания.Вставить("КратностьВремени", 10); //срабатывает 10 раз в секунду
	
	ТипыОписанийПодпрограмм = РК.НовоеПеречисление("Нативная, Код, Переход, Наследование");
	
	КомпиляторКода = Новый Структура;
	КомпиляторКода.Вставить("ФункцииДляВызововПодпрограмм", Новый Соответствие);
	КомпиляторКода.Вставить("ФункцииДляСозданияНовыхОбъектов", Новый Соответствие);
	КомпиляторКода.Вставить("ИдентификаторОбъектаКонтекста");
	КомпиляторКода.Вставить("ИспользоватьКэш", Истина);
	КомпиляторКода.Вставить("ТекстовыйПарсер", ТекстовыйПарсер);
	КомпиляторКода.Вставить("ОбработкаОжидания", ОбработкаОжидания);
	КомпиляторКода.Вставить("Данные", Новый Структура);
	КомпиляторКода.Вставить("КонтекстИсполнения", КонтекстИсполнения);
	КомпиляторКода.Вставить("Зависимости", ТекстовыйПарсер.Зависимости);
	
	КомпиляторКода.Вставить("ТипыОписанийПодпрограмм", ТипыОписанийПодпрограмм);
	КомпиляторКода.Вставить("КонтекстыИсполнения", КонтекстыИсполнения);
	КомпиляторКода.Вставить("ДирективыКонтекстовИсполнения", ТекстовыйПарсер.ДирективыКонтекстовИсполнения);
	КомпиляторКода.Вставить("ДирективыКонтекстовИсполненияМассив", ТекстовыйПарсер.ДирективыКонтекстовИсполненияМассив);
	
	ИменаПараметровВызоваПодпрограммы = "Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162";
	ИмяПеременнойРезультатПодпрограммы = "Результат_e8a17f9465ac4b1dbd98b4f6427d0162";
	КомпиляторКода_УказатьФункциюДляВызововПодпрограмм(КомпиляторКода, "ВызовПодпрограммы", "НаКлиенте, НаКлиентеБезКонтекста, НаСервере, НаСервереБезКонтекста", ИменаПараметровВызоваПодпрограммы, ИмяПеременнойРезультатПодпрограммы);
	КомпиляторКода_УказатьФункциюДляСозданияНовыхОбъектов(КомпиляторКода, "ПереопределениеСозданияНовогоОбъекта", "НаКлиенте, НаКлиентеБезКонтекста, НаСервере, НаСервереБезКонтекста", ИменаПараметровВызоваПодпрограммы);
	КомпиляторКода_УказатьИдентификаторОбъектаКонтекста(КомпиляторКода, "ОбъектКонтекста_e8a17f9465ac4b1dbd98b4f6427d0162");

	Возврат КомпиляторКода;
	
КонецФункции

Функция КомпиляторКода_Скомпилировать(КомпиляторКода, ТекстМодуля) Экспорт

	КомпиляторКода_РазобратьТекст(КомпиляторКода, ТекстМодуля);
	КомпиляторКода_ПреобразоватьКодМодуля(КомпиляторКода);
	ТекстовыйПарсер_СформироватьКодМодуля(КомпиляторКода.ТекстовыйПарсер);
	КомпиляторКода_ЗаполнитьДанные(КомпиляторКода);
	ТекстовыйПарсер_Очистить(КомпиляторКода.ТекстовыйПарсер);
	
КонецФункции

Функция КомпиляторКода_ЗаполнитьДанные(КомпиляторКода, ВспомогательныеДанные=Ложь) Экспорт

	Перем РК;
	
	ТипыОписанийПодпрограмм = КомпиляторКода.ТипыОписанийПодпрограмм;
	КонтекстИсполнения = КомпиляторКода.КонтекстИсполнения;
	
	ДирективыКонтекстаИсполнения = Новый Массив;
	Для Каждого ДирективаКонтекстаИсполнения Из КомпиляторКода.ДирективыКонтекстовИсполненияМассив Цикл
		
		Если ДирективаКонтекстаИсполнения.КонтекстИсполнения=КонтекстИсполнения Тогда
			
			ДирективыКонтекстаИсполнения.Добавить(ДирективаКонтекстаИсполнения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	МассивПодпрограмм = РК.ПолучитьЭлементыКоллекции(ТекстовыйПарсер.ТаблицаПодпрограмм);
	МассивКлассов = РК.ПолучитьЭлементыКоллекции(ТекстовыйПарсер.ТаблицаКлассов);
	
	ДанныеКонтекстаИсполнения = КомпиляторКода.Данные;
	
	Для Каждого Директива Из ДирективыКонтекстаИсполнения Цикл
		
		Если Директива.ИспользоватьДанныеКонтекста Тогда
			ДанныеДирективы = ДанныеКонтекстаИсполнения.СДаннымиКонтекста;
		Иначе
			ДанныеДирективы = ДанныеКонтекстаИсполнения.БезДанныхКонтекста;
		КонецЕсли;
		
		ДанныеКлассов = ДанныеДирективы.ДанныеКлассов;
		Для Каждого Класс Из МассивКлассов Цикл
			ДанныеКласса = Новый Структура;
			ДанныеКласса.Вставить("Поля", Новый Структура(Класс.ИменаПолей));
			ДанныеКласса.Вставить("КодыПодпрограмм", Новый Соответствие);
			ДанныеКласса.Вставить("ПереходыПодпрограмм", Новый Соответствие);
			ДанныеКласса.Вставить("НаследованиеМетодов", Новый Соответствие);
			ДанныеКласса.Вставить("ОписанияПодпрограмм", Новый Соответствие);
			ДанныеКласса.Вставить("НативныеМетоды", Новый Соответствие);
			ДанныеКласса.Вставить("ИспользоватьНативныеМетоды", Класс.ИспользоватьНативныеМетоды);
			ДанныеКласса.Вставить("Предки", Новый Массив);
			ДанныеКласса.Вставить("Конструкторы", Новый Массив);
			ДанныеКлассов[Класс.ВРИмя] = ДанныеКласса;
		КонецЦикла;
		
		Для Каждого Подпрограмма Из МассивПодпрограмм Цикл
			ИмяПодпрограммы = Подпрограмма.ВРИмя;

			ДополнительныеДанныеПодпрограммы = Подпрограмма.ДополнительныеДанные;
			ИмяКласса = ДополнительныеДанныеПодпрограммы.Класс.ВРИмя;
			ДанныеКласса = ДанныеКлассов[ИмяКласса];
			
			ДирективаПодпрограммы = Подпрограмма.Директива;
			
			Если Директива<>ДирективаПодпрограммы И Директива.ВозможныеПереходы[ДирективаПодпрограммы.Имя]<>Истина Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыПодпрограммы = РК.ПолучитьЭлементыКоллекции(Подпрограмма.ТаблицаПараметров);
			КоличествоОбязательныхПараметровПодпрограммы =ПараметрыПодпрограммы.Количество();
			Пока КоличествоОбязательныхПараметровПодпрограммы>0 Цикл
				Если ПараметрыПодпрограммы[КоличествоОбязательныхПараметровПодпрограммы-1].ЗначениеПоУмолчанию=Неопределено Тогда
					Прервать;
				КонецЕсли;
				КоличествоОбязательныхПараметровПодпрограммы = КоличествоОбязательныхПараметровПодпрограммы - 1;
			КонецЦикла;
			
			ОписаниеПодпрограммы = Новый Структура;
			ОписаниеПодпрограммы.Вставить("Имя", ИмяПодпрограммы);
			ОписаниеПодпрограммы.Вставить("Тип");
			ОписаниеПодпрограммы.Вставить("Данные");
			ОписаниеПодпрограммы.Вставить("КоличествоПараметров", ПараметрыПодпрограммы.Количество());
			ОписаниеПодпрограммы.Вставить("КоличествоОбязательныхПараметров", КоличествоОбязательныхПараметровПодпрограммы);
			
			Если Подпрограмма.Нативная Тогда
				
				ДанныеКласса.НативныеМетоды[ИмяПодпрограммы] = Истина;
				ОписаниеПодпрограммы.Тип = ТипыОписанийПодпрограмм.Нативная
					
			Иначе
				
				Если Директива=ДирективаПодпрограммы Тогда
					КодПодпрограммы = ДополнительныеДанныеПодпрограммы.Тело.Код;
					ДанныеКласса.КодыПодпрограмм[ИмяПодпрограммы] = КодПодпрограммы;
					ОписаниеПодпрограммы.Тип = ТипыОписанийПодпрограмм.Код;
					ОписаниеПодпрограммы.Данные = КодПодпрограммы;
				Иначе
					ДанныеКласса.ПереходыПодпрограмм[ИмяПодпрограммы] = ДирективаПодпрограммы;
					ОписаниеПодпрограммы.Тип = ТипыОписанийПодпрограмм.Переход;
					ОписаниеПодпрограммы.Данные = ДирективаПодпрограммы;
				КонецЕсли;
				
			КонецЕсли;
			
			ДанныеКласса.ОписанияПодпрограмм[ИмяПодпрограммы] = ОписаниеПодпрограммы;
			
		КонецЦикла;
		
		//наследование
		Для Каждого Класс Из МассивКлассов Цикл

			ИмяКласса = Класс.ВРИмя;
			ДанныеКласса = ДанныеКлассов[ИмяКласса];
			Для Каждого Предок Из Класс.Предки Цикл
				
				ДанныеПредкаКласса = ДанныеКлассов[Предок];
				Если ДанныеПредкаКласса=Неопределено И ДанныеКлассов<>Неопределено Тогда
					ДанныеПредкаКласса = ДанныеКлассов[Предок];
				КонецЕсли;
				
				Если ДанныеПредкаКласса=Неопределено Тогда
					ВызватьИсключение "Класс """ + Предок + """ не определен!";
				КонецЕсли;
				
				Для Каждого Поле Из ДанныеПредкаКласса.Поля Цикл
					ДанныеКласса.Поля.Вставить(Поле.Ключ);
				КонецЦикла;
					
				Для Каждого ЭлементОписанияПодпрограммы Из ДанныеПредкаКласса.ОписанияПодпрограмм Цикл
					ОписаниеПодпрограммыПредка = ЭлементОписанияПодпрограммы.Значение;
					ИмяПодпрограммы = ОписаниеПодпрограммыПредка.Имя;
					Если ДанныеКласса.ОписанияПодпрограмм[ИмяПодпрограммы]=Неопределено Тогда
						ОписаниеПодпрограммы = РК.СкопироватьОбъект(ОписаниеПодпрограммыПредка);
						ОписаниеПодпрограммы.Тип = ТипыОписанийПодпрограмм.Наследование;
						ОписаниеПодпрограммы.Данные = Предок;
						ДанныеКласса.ОписанияПодпрограмм[ИмяПодпрограммы] = ОписаниеПодпрограммы;
						ДанныеКласса.НаследованиеМетодов[ИмяПодпрограммы] = Предок;
					КонецЕсли;
				КонецЦикла;
				
				ДанныеКласса.Предки.Добавить(Предок);
				РК.ДобавитьЭлементыКоллекции(ДанныеКласса.Конструкторы, ДанныеПредкаКласса.Конструкторы);
				
			КонецЦикла;
			
			ИмяКонструктора = "@ГЛАВНАЯ@";
			Если ДанныеКласса.КодыПодпрограмм[ИмяКонструктора]<>Неопределено Тогда
				ДанныеКласса.Конструкторы.Добавить(ИмяКонструктора);
			КонецЕсли;
			
			ИмяКонструктора = ИмяКласса;
			Если ДанныеКласса.КодыПодпрограмм[ИмяКонструктора]<>Неопределено Тогда
				ДанныеКласса.Конструкторы.Добавить(ИмяКонструктора);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВспомогательныеДанные Тогда
			ДополнительныеДанные = Новый Структура;
			ДополнительныеДанные.Вставить("ЗаменаИдентификаторовОбщихОбъектовКлассов", Новый Соответствие);
			
			ПрефиксИдентификатораОбщегоОбъектаКласса = "ПроцессорКода.ТекущиеДанныеДляВыполненияКода.ОбщиеОбъектыКлассов.";
			Для Каждого Класс Из МассивКлассов Цикл

				ДанныеКласса = ДанныеКлассов[Класс.ВРИмя];
				ДополнительныеДанные.ЗаменаИдентификаторовОбщихОбъектовКлассов[Класс.ВРИмя] = ПрефиксИдентификатораОбщегоОбъектаКласса + Класс.ВРИмя;
				
				ДополнительныеДанныеКласса = Новый Структура;
				ДополнительныеДанныеКласса.Вставить("ДоступныеПоляМассив", Новый Массив);
				ДополнительныеДанныеКласса.Вставить("ОпределенныеПодпрограммыСоответствие", Новый Соответствие);
				ДополнительныеДанныеКласса.Вставить("ДоступныеПодпрограммыМассив", Новый Массив);
				ДополнительныеДанныеКласса.Вставить("ИдентификаторыУказателейТекущегоОбъекта", Класс.ИдентификаторыУказателейТекущегоОбъекта);

				Для Каждого ПолеКласса Из ДанныеКласса.Поля Цикл
					ДополнительныеДанныеКласса.ДоступныеПоляМассив.Добавить(ПолеКласса.Ключ);
				КонецЦикла;
				РК.ДобавитьЭлементыКоллекции(ДополнительныеДанныеКласса.ДоступныеПоляМассив, Класс.ИменаНативныхПолейМассив);
				
				Для Каждого ЭлементОписанияПодпрограммы Из ДанныеКласса.ОписанияПодпрограмм Цикл
					ИмяПодпрограммы = ЭлементОписанияПодпрограммы.Ключ;
					ОписаниеПодпрограммы = ЭлементОписанияПодпрограммы.Значение;
					Если ОписаниеПодпрограммы.Тип<>ТипыОписанийПодпрограмм.Нативная Тогда
						ДополнительныеДанныеКласса.ОпределенныеПодпрограммыСоответствие[ИмяПодпрограммы] = Истина;
					КонецЕсли;
					ДополнительныеДанныеКласса.ДоступныеПодпрограммыМассив.Добавить(ИмяПодпрограммы);
				КонецЦикла;
				
				ДанныеКласса.Вставить("ДополнительныеДанные", ДополнительныеДанныеКласса);
			КонецЦикла;
		КонецЕсли;
		
		ДанныеДирективы.ДополнительныеДанные = ДополнительныеДанные;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция КомпиляторКода_НовыеДанныеКомпиляцииКонтекстаИсполнения(КомпиляторКода, КонтекстИсполнения)
	
	ДанныеКомпиляцииКонтекста = Новый Структура;
	
	Для Каждого ДирективаКонтекстаИсполнения Из КомпиляторКода.ДирективыКонтекстовИсполненияМассив Цикл
		
		Если ДирективаКонтекстаИсполнения.КонтекстИсполнения=КонтекстИсполнения Тогда
			
			ДанныеКомпиляцииДирективы = КомпиляторКода_НовыеДанныеКомпиляцииДирективыКонтекстаИсполнения(КомпиляторКода, ДирективаКонтекстаИсполнения);
			
			Если ДанныеКомпиляцииДирективы.ИспользоватьДанныеКонтекста Тогда
				
				ДанныеКомпиляцииКонтекста.Вставить("СДаннымиКонтекста", ДанныеКомпиляцииДирективы);
				
			Иначе

				ДанныеКомпиляцииКонтекста.Вставить("БезДанныхКонтекста", ДанныеКомпиляцииДирективы);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДанныеКомпиляцииКонтекста;
	
КонецФункции

Функция КомпиляторКода_НовыеДанныеКомпиляцииДирективыКонтекстаИсполнения(КомпиляторКода, Директива)
	
	ДанныеКомпиляцииДирективы = Новый Структура;
	ДанныеКомпиляцииДирективы.Вставить("ДанныеКлассов", Новый Соответствие);
	ДанныеКомпиляцииДирективы.Вставить("Директива", Директива);
	ДанныеКомпиляцииДирективы.Вставить("КонтекстИсполнения", Директива.КонтекстИсполнения);
	ДанныеКомпиляцииДирективы.Вставить("ИспользоватьДанныеКонтекста", Директива.ИспользоватьДанныеКонтекста);
	ДанныеКомпиляцииДирективы.Вставить("ДополнительныеДанные");
	
	Возврат ДанныеКомпиляцииДирективы;

КонецФункции

Функция ПолучитьНастройкиКомпилятораКода(КомпиляторКода)
	
	НастройкиКомпилятора = Новый Структура("ФункцииДляВызововПодпрограмм, ФункцииДляСозданияНовыхОбъектов");
	ЗаполнитьЗначенияСвойств(НастройкиКомпилятора, КомпиляторКода);
	Возврат НастройкиКомпилятора;
	
КонецФункции

Функция УстановитьНастройкиКомпилятораКода(КомпиляторКода, НастройкиКомпилятора) Экспорт
	
	Если НастройкиКомпилятора=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(КомпиляторКода, НастройкиКомпилятора);
	Возврат Истина;
	
КонецФункции

Функция КомпиляторКода_РазобратьТекст(КомпиляторКода, ТекстМодуля) Экспорт

	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	
	ЗдесьОстановиПоБратски();
	
	
	ТекстовыйПарсер.КонтекстИсполнения = КомпиляторКода.КонтекстИсполнения;
	ТекстовыйПарсер_РазобратьТекст(ТекстовыйПарсер, ТекстМодуля);
	
	//ОТЛАДКА
	ТекстовыйПарсер_СформироватьКодМодуля(ТекстовыйПарсер);
	
	Возврат Истина;
	
КонецФункции

Функция КомпиляторКода_ПолучитьОписаниеПодпрограммы(КомпиляторКода, ИмяПодпрограммы) Экспорт
	
	Перем РК;
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ОписаниеПодпрограммы = РК.НайтиЭлементКоллекции(ТекстовыйПарсер.ТаблицаПодпрограмм, Новый Структура("ВРИмя", ВРЕГ(ИмяПодпрограммы)));

	Возврат ОписаниеПодпрограммы;
	
КонецФункции

Функция КомпиляторКода_УказатьФункциюДляВызововПодпрограмм(КомпиляторКода, ИмяФункции, ДирективыВыполнения, Параметры=Неопределено, ПеременнаяДляВозвратаРезультата=Неопределено) Экспорт
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ПараметрыМассив = РК.ЗначениеВМассив(Параметры, , Ложь);
	ДирективыВыполненияМассив = РК.ЗначениеВМассив(ДирективыВыполнения, , Ложь);
	
	ФункцияДляВызововПодпрограмм = Новый Структура;
	ФункцияДляВызововПодпрограмм.Вставить("Имя", ИмяФункции);
	ФункцияДляВызововПодпрограмм.Вставить("Параметры", ПараметрыМассив);
	ФункцияДляВызововПодпрограмм.Вставить("ПеременнаяДляВозвратаРезультата", ПеременнаяДляВозвратаРезультата);
	
	Для Каждого ДирективаВыполнения Из ДирективыВыполненияМассив Цикл
		КомпиляторКода.ФункцииДляВызововПодпрограмм[ВРЕГ(ДирективаВыполнения)] = ФункцияДляВызововПодпрограмм;
	КонецЦикла;
	
КонецФункции

Функция КомпиляторКода_УказатьФункциюДляСозданияНовыхОбъектов(КомпиляторКода, ИмяФункции, ДирективыВыполнения, Параметры=Неопределено) Экспорт
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ПараметрыМассив = РК.ЗначениеВМассив(Параметры);
	
	ФункцияДляСозданияНовыхОбъектов = Новый Структура;
	ФункцияДляСозданияНовыхОбъектов.Вставить("Имя", ИмяФункции);
	ФункцияДляСозданияНовыхОбъектов.Вставить("Параметры", ПараметрыМассив);
	
	МассивДирективВыполнения = РК.ЗначениеВМассив(ДирективыВыполнения, , Ложь);
	Для Каждого ДирективаВыполнения Из МассивДирективВыполнения Цикл
		ДирективаВыполнения = ВРЕГ(ДирективаВыполнения);
		КомпиляторКода.ФункцииДляСозданияНовыхОбъектов[ДирективаВыполнения] = ФункцияДляСозданияНовыхОбъектов;
	КонецЦикла;
	
КонецФункции

Функция КомпиляторКода_УказатьИдентификаторОбъектаКонтекста(КомпиляторКода, Идентификатор) Экспорт
	
	КомпиляторКода.ИдентификаторОбъектаКонтекста = Идентификатор;
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьКодМодуля(КомпиляторКода) Экспорт
	
	КомпиляторКода_ПреобразоватьКодПодпрограмм(КомпиляторКода);
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьКодПодпрограмм(КомпиляторКода, Подпрограммы=Неопределено) Экспорт

	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	Если Подпрограммы<>Неопределено Тогда
		МассивПодпрограмм = РК.ЗначениеВМассив(Подпрограммы, , Ложь);
	Иначе
		МассивПодпрограмм = РК.ПолучитьЭлементыКоллекции(КомпиляторКода.ТекстовыйПарсер.ТаблицаПодпрограмм);
	КонецЕсли;
	
	КомпиляторКода_ЗаполнитьДанные(КомпиляторКода, Истина);
	
	Для Каждого Подпрограмма Из МассивПодпрограмм Цикл
		
		Если Подпрограмма.Объявление Тогда
			Продолжить;
		КонецЕсли;
		
		КомпиляторКода_ПреобразоватьКодПодпрограммы(КомпиляторКода, Подпрограмма);
		
	КонецЦикла;
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьКодПодпрограммы(КомпиляторКода, Подпрограмма)
	
	КомпиляторКода_ПреобразоватьЛокальныеПеременныеПодпрограммы(КомпиляторКода, Подпрограмма);
	КомпиляторКода_ПреобразоватьПараметрыПодпрограммы(КомпиляторКода, Подпрограмма);
	КомпиляторКода_ПреобразоватьВозвратИзПодпрограммы(КомпиляторКода, Подпрограмма);
	КомпиляторКода_ПоместитьИдентификаторыПодпрограммыВКонтекстОбъекта(КомпиляторКода, Подпрограмма);
	КомпиляторКода_ПреобразоватьИдентификаторыОбщихОбъектовКлассовПодпрограммы(КомпиляторКода, Подпрограмма);
	//КомпиляторКода_ПреобразоватьВызовыПодпрограмм(КомпиляторКода, Подпрограмма);
	КомпиляторКода_ПреобразоватьСозданиеНовыхОбъектов(КомпиляторКода, Подпрограмма);
	КомпиляторКода_ПреобразоватьПодключениеОтключениеОбработчиковОжидания(КомпиляторКода, Подпрограмма);
	//КомпиляторКода_ПреобразоватьДобавленияКомандФормы(КомпиляторКода, Подпрограмма);
	
	КомпиляторКода_ПреобразоватьЦиклыПодпрограммы(КомпиляторКода, Подпрограмма);
	КомпиляторКода_РазорватьЦепочкиУсловныхОператоров(КомпиляторКода, Подпрограмма);
	КомпиляторКода_РазвернутьВыраженияПодпрограммы(КомпиляторКода, Подпрограмма);
	КомпиляторКода_ПреобразоватьВызовыМетодовПодпрограммы(КомпиляторКода, Подпрограмма);
	
КонецФункции

Функция КомпиляторКода_ПоместитьИдентификаторыПодпрограммыВКонтекстОбъекта(КомпиляторКода, Подпрограмма)

	ИмяКласса = Подпрограмма.ДополнительныеДанные.Класс.ВРИмя;
	ДанныеКонтекста = КомпиляторКода.Данные;
	Если Подпрограмма.Директива.ИспользоватьДанныеКонтекста Тогда
		ДанныеКласса = ДанныеКонтекста.СДаннымиКонтекста.ДанныеКлассов[ИмяКласса];
	Иначе
		//ДанныеКласса = ДанныеКонтекста.БезДанныхКонтекста.ДанныеКлассов[ИмяКласса];
		Возврат Ложь;
	КонецЕсли;
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ПрефиксОбъекта = КомпиляторКода.ИдентификаторОбъектаКонтекста + ".";
	
	////////////////
	ЗаменыИдентификаторовПолейКласса = Новый Соответствие;
	Для Каждого ИмяПоля Из ДанныеКласса.ДополнительныеДанные.ДоступныеПоляМассив Цикл
		ЗаменыИдентификаторовПолейКласса[ИмяПоля] = ПрефиксОбъекта + ИмяПоля;
	КонецЦикла;
	ТекстовыйПарсер_ЗаменитьИдентификаторыПодпрограммы(ТекстовыйПарсер, Подпрограмма, ЗаменыИдентификаторовПолейКласса, Ложь);
	
	////////////////
	ЗаменыИдентификаторовМетодовКласса = Новый Соответствие;
	Для Каждого ДоступнаяПодпрограмма Из ДанныеКласса.ДополнительныеДанные.ДоступныеПодпрограммыМассив Цикл
		ЗаменыИдентификаторовМетодовКласса[ДоступнаяПодпрограмма] = ПрефиксОбъекта + ДоступнаяПодпрограмма;
	КонецЦикла;
	
	ТекстовыйПарсер_ЗаменитьИдентификаторыПодпрограммы(ТекстовыйПарсер, Подпрограмма, ЗаменыИдентификаторовМетодовКласса, Истина);
	Для Каждого ПреобразованныйОператор Из Подпрограмма.ДополнительныеДанные.ПреобразованныеОператоры Цикл
		опВызовМетода = ПреобразованныйОператор;
		ИмяМетода = ВРЕГ(опВызовМетода.ДополнительныеДанные.ВызываемаяПодпрограмма.Код);
		опВызовМетода.ДополнительныеДанные.ИмяКласса = ИмяКласса;
		опВызовМетода.ДополнительныеДанные.МетодОпределен = ДанныеКласса.ДополнительныеДанные.ОпределенныеПодпрограммыСоответствие[ИмяМетода]=Истина;
		опВызовМетода.ДополнительныеДанные.ИспользоватьНативныеМетоды = ДанныеКласса.ИспользоватьНативныеМетоды;
	КонецЦикла;
	
	// заменим идентификаторы указателей текущего объекта на "ОбъектКонтекста"
	ЗаменаИдентификаторовУказателейТекущегоОбъекта = Новый Соответствие;
	Для Каждого ИдентификаторУказателяТекущегоОбъекта Из ДанныеКласса.ДополнительныеДанные.ИдентификаторыУказателейТекущегоОбъекта Цикл
		ЗаменаИдентификаторовУказателейТекущегоОбъекта[ИдентификаторУказателяТекущегоОбъекта] = КомпиляторКода.ИдентификаторОбъектаКонтекста;
	КонецЦикла;
	ТекстовыйПарсер_ЗаменитьИдентификаторыПодпрограммы(ТекстовыйПарсер, Подпрограмма, ЗаменаИдентификаторовУказателейТекущегоОбъекта, Ложь);

	тВызовМетода = ТекстовыйПарсер.ТипыСловИОператоров.ВызовМетода;
	Для Каждого ПреобразованныйОператор Из Подпрограмма.ДополнительныеДанные.ПреобразованныеОператоры Цикл
		опРодитель = ПреобразованныйОператор.Родитель;
		Если опРодитель.ТипОператора=тВызовМетода Тогда
			опВызовМетода = опРодитель;
			ИмяМетода = ВРЕГ(опВызовМетода.ДополнительныеДанные.ВызываемаяПодпрограмма.Код);
			опВызовМетода.ДополнительныеДанные.ИмяКласса = ИмяКласса;
			опВызовМетода.ДополнительныеДанные.МетодОпределен = ДанныеКласса.ДополнительныеДанные.ОпределенныеПодпрограммыСоответствие[ИмяМетода]=Истина;
			опВызовМетода.ДополнительныеДанные.ИспользоватьНативныеМетоды = ДанныеКласса.ИспользоватьНативныеМетоды;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

Функция КомпиляторКода_ПреобразоватьЛокальныеПеременныеПодпрограммы(КомпиляторКода, Подпрограмма)

	Перем РК;
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	МассивПеременных = РК.ПолучитьЭлементыКоллекции(Подпрограмма.ТаблицаПеременных);
	Если МассивПеременных.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТипыОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	МассивОператоровЛокальныеПеременные = РК.НайтиЭлементыКоллекции(Подпрограмма.ДополнительныеДанные.Тело.Операторы, Новый Структура("ТипОператора", ТипыОператоров.ЛокальныеПеременные));
	Если МассивОператоровЛокальныеПеременные.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	тСпецсимвол = ТипыОператоров.Спецсимвол;
	тИдентификатор = ТипыОператоров.Идентификатор;
	
	слНеопределено = Слово(тИдентификатор, "Неопределено");
	
	ЗаменаИдентификаторов = Новый Соответствие;
	КонтекстПеременных = "ЛокальныеПеременные_e8a17f9465ac4b1dbd98b4f6427d0162";
	ПрефиксПеременных = КонтекстПеременных + ".";
	Для Каждого ОператорЛокальныеПеременные Из МассивОператоровЛокальныеПеременные Цикл
		Операторы = ОператорЛокальныеПеременные.Операторы;
		Если Не (Операторы.Количество() > 0 И Операторы[0].ТипОператора=тИдентификатор И ВРЕГ(Операторы[0].Код)="ПЕРЕМ") Тогда
			Продолжить;
		КонецЕсли;
		
		Операторы.Удалить(0);
		
		Для Каждого Оператор Из Операторы Цикл
			Если Оператор.ТипОператора=тИдентификатор Тогда
				ИмяПеременной = Оператор.Код;
				НовыйОператор(ТекстовыйПарсер, , Слово("ПростоКод", ПрефиксПеременных + "Вставить(""" + ИмяПеременной + """)"), ОператорЛокальныеПеременные);
				ЗаменаИдентификаторов[ВРЕГ(ИмяПеременной)] = ПрефиксПеременных + ИмяПеременной;
			ИначеЕсли Оператор.ТипОператора=тСпецсимвол И Оператор.Код="," Тогда
				НовыйРазделительОператоров(ТекстовыйПарсер, , ОператорЛокальныеПеременные);
			КонецЕсли;
		КонецЦикла;
		
		УдалитьОператор(ОператорЛокальныеПеременные);
	КонецЦикла;
	
	ТелоПодпрограммы = Подпрограмма.ДополнительныеДанные.Тело;
	НовыйОператор(ТекстовыйПарсер, ТелоПодпрограммы, Слово("ПростоКод", КонтекстПеременных + " = Новый Структура"), 0);
	НовыйРазделительОператоров(ТекстовыйПарсер, ТелоПодпрограммы, 1);
	
	ТекстовыйПарсер_ЗаменитьИдентификаторыПодпрограммы(ТекстовыйПарсер, Подпрограмма, ЗаменаИдентификаторов, Ложь);
	
	Для Каждого ПреобразованныйОператор Из Подпрограмма.ДополнительныеДанные.ПреобразованныеОператоры Цикл
		ПреобразованныйОператор.ДополнительныеДанные.Вставить("Непреобразовывать", Истина);
	КонецЦикла;
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьИдентификаторыОбщихОбъектовКлассовПодпрограммы(КомпиляторКода, Подпрограмма)

	ДанныеКонтекста = КомпиляторКода.Данные.СДаннымиКонтекста;
	ЗаменаИдентификаторовОбщихОбъектовКлассов = ДанныеКонтекста.ДополнительныеДанные.ЗаменаИдентификаторовОбщихОбъектовКлассов;

	ТекстовыйПарсер_ЗаменитьИдентификаторыПодпрограммы(КомпиляторКода.ТекстовыйПарсер, Подпрограмма, ЗаменаИдентификаторовОбщихОбъектовКлассов, Ложь);

	Для Каждого Оператор Из ПолучитьВсеОператоры(Подпрограмма.ДополнительныеДанные.ПреобразованныеОператоры) Цикл
		Оператор.ДополнительныеДанные.Вставить("Непреобразовывать", Истина);
	КонецЦикла;
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьПараметрыПодпрограммы(КомпиляторКода, Подпрограмма)

	ПараметрыПодпрограммы = Подпрограмма.ТаблицаПараметров.Строки;
	Если ПараметрыПодпрограммы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ФункцияДляВызововПодпрограмм = КомпиляторКода.ФункцииДляВызововПодпрограмм[Подпрограмма.Директива.Имя];
	Если ФункцияДляВызововПодпрограмм=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыСФ = ФункцияДляВызововПодпрограмм.Параметры;
	Если ПараметрыПодпрограммы.Количество() > ПараметрыСФ.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	опТело = Подпрограмма.ДополнительныеДанные.Тело;
	Если опТело.Операторы.Количество()=0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	тСпецСимвол = ТипыСловИОператоров.СпецСимвол;
	тСтрока = ТипыСловИОператоров.Строка;
	
	слЗнакРавно = Слово(тСпецСимвол, "=");
	слИЛИ = Слово(тИдентификатор, "ИЛИ");
	слНеопределено = Слово(тИдентификатор, "НЕОПРЕДЕЛЕНО");
	слПропущенныйПараметр = Слово(тСтрока, "ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162");
	слОпущенныйПараметр = Слово(тСтрока, "ОпущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162");
	
	опПервый = опТело.Операторы[0];
	
	НомерПоследнегоПараметра = Мин(ПараметрыПодпрограммы.Количество(), ПараметрыСФ.Количество()) - 1;
	
	ЗаменаИдентификаторов = Новый Соответствие;
	Для НомерПараметра=0 По НомерПоследнегоПараметра Цикл
		ПараметрПодпрограммы = ПараметрыПодпрограммы[НомерПараметра];
		ИмяПараметраСервиснойФункции = ПараметрыСФ[НомерПараметра];
		слИмяПараметраСервиснойФункции = Слово(тИдентификатор, ИмяПараметраСервиснойФункции);

		// значение параметра по умолчанию
		опУсловный = НовыйУсловныйОператор(ТекстовыйПарсер, , опПервый);
		
		опЗаголовок = опУсловный.ДополнительныеДанные.Заголовок;
			НовыйОператор(ТекстовыйПарсер, опЗаголовок, слИмяПараметраСервиснойФункции);
			НовыйОператор(ТекстовыйПарсер, опЗаголовок, слЗнакРавно);
			НовыйОператор(ТекстовыйПарсер, опЗаголовок, слОпущенныйПараметр);
			НовыйОператор(ТекстовыйПарсер, опЗаголовок, слИЛИ);
			НовыйОператор(ТекстовыйПарсер, опЗаголовок, слИмяПараметраСервиснойФункции);
			НовыйОператор(ТекстовыйПарсер, опЗаголовок, слЗнакРавно);
			НовыйОператор(ТекстовыйПарсер, опЗаголовок, слПропущенныйПараметр);
		
		Если ПараметрПодпрограммы.ЗначениеПоУмолчанию<>Неопределено Тогда
			ЗначениеПоУмолчанию = ПараметрПодпрограммы.ЗначениеПоУмолчанию;
		Иначе
			ЗначениеПоУмолчанию = слНеопределено;
		КонецЕсли;
		
		опТело = опУсловный.ДополнительныеДанные.Тело; 
			НовыйОператорПрисвоениеЗначение(слИмяПараметраСервиснойФункции, ЗначениеПоУмолчанию, ТекстовыйПарсер, опТело);
			
		НовыйРазделительОператоров(ТекстовыйПарсер, , опПервый);
		
		// передач параметра по значению
		Если ПараметрПодпрограммы.ПоЗначению Тогда
			ИмяКопииПараметраСервиснойФункции = "Копия" + ИмяПараметраСервиснойФункции;
			слИмяКопииПараметраСервиснойФункции = Слово(тИдентификатор, ИмяКопииПараметраСервиснойФункции);
			НовыйОператорПрисвоениеЗначение(слИмяКопииПараметраСервиснойФункции, слИмяПараметраСервиснойФункции, ТекстовыйПарсер, , опПервый);
			НовыйРазделительОператоров(ТекстовыйПарсер, , опПервый);
			ИмяПараметраСервиснойФункции = ИмяКопииПараметраСервиснойФункции;
		КонецЕсли;
		
		ЗаменаИдентификаторов[ПараметрПодпрограммы.ВРИмя] = ИмяПараметраСервиснойФункции;
	КонецЦикла;
	
	ТекстовыйПарсер_ЗаменитьИдентификаторыПодпрограммы(ТекстовыйПарсер, Подпрограмма, ЗаменаИдентификаторов, Ложь);
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьВызовыПодпрограмм(КомпиляторКода, Подпрограмма)

	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	ТипИдентификатор = ТипыСловИОператоров.Идентификатор;
	ТипСтрока = ТипыСловИОператоров.Строка;
	ТипСпецсимвол = ТипыСловИОператоров.Спецсимвол;
	
	МассивОператоров = ТекстовыйПарсер_ПолучитьОператорыПодпрограммы(КомпиляторКода.ТекстовыйПарсер, Подпрограмма, "ВызовПодпрограммы");
	
	ФункцииДляВызововПодпрограмм = КомпиляторКода.ФункцииДляВызововПодпрограмм;
	ФункцияДляВызововПодпрограмм = ФункцииДляВызововПодпрограмм[Подпрограмма.Директива.Имя];
	Если ФункцияДляВызововПодпрограмм=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ИмяГлобальногоКласса = ТекстовыйПарсер.ГлобальныйКласс.ВРИмя;
	
	ДанныеКонтекста = КомпиляторКода.Данные;
	Если Подпрограмма.Директива.ИспользоватьДанныеКонтекста Тогда
		ДанныеДляВыполненияКода = ДанныеКонтекста.СДаннымиКонтекста.ДанныеКлассов[ИмяГлобальногоКласса];
	Иначе
		ДанныеДляВыполненияКода = ДанныеКонтекста.БезДанныхКонтекста.ДанныеКлассов[ИмяГлобальногоКласса];
	КонецЕсли;
	
	слНеопределено = Слово(ТипИдентификатор, "Неопределено");
	слОбъектКонтекста = слНеопределено;
	слТипОбъекта = Слово(ТипСтрока, ИмяГлобальногоКласса);
	слПроцессорКода = Слово(ТипИдентификатор, "ПроцессорКода");

	Для Каждого ОператорГруппа Из МассивОператоров Цикл
		
		Если ОператорГруппа.Операторы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОператорИдентификаторПодпрограммы = ОператорГруппа.Операторы[0];
		ИмяВызываемойПодпрограммы = ВРЕГ(ОператорИдентификаторПодпрограммы.Код);
		Если ДанныеДляВыполненияКода.КодыПодпрограмм[ИмяВызываемойПодпрограммы]=Неопределено И ДанныеДляВыполненияКода.ПереходыПодпрограмм[ИмяВызываемойПодпрограммы]=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ВызываемаяПодпрограмма = РК.НайтиЭлементКоллекции(ТекстовыйПарсер.ТаблицаПодпрограмм, Новый Структура("ВРИмя", ИмяВызываемойПодпрограммы));
		Если ВызываемаяПодпрограмма = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОператорИдентификаторПодпрограммы.Код = ФункцияДляВызововПодпрограмм.Имя;
		
		ОператорПараметрыВызоваПодпрограммы = ОператорГруппа.ДополнительныеДанные.ПараметрыВызоваПодпрограммы;
		
		// вставим значения параметров по умолчанию, если параметры не переданы
		НомерПараметра = 0;
		ПараметрыПодпрограммы = ВызываемаяПодпрограмма.ТаблицаПараметров.Строки;
		КоличествоПараметров = ПараметрыПодпрограммы.Количество();
		НомерПоследнегоПараметра = КоличествоПараметров-1;
		Для Каждого ПараметрВызоваПодпрограммы Из ОператорПараметрыВызоваПодпрограммы.Операторы Цикл
			Если ПараметрВызоваПодпрограммы.Операторы.Количество() = 0 Тогда
				// не заполнен
				Если НомерПараметра > НомерПоследнегоПараметра Тогда
					// Слишком много фактических параметров
					// выдаст ошибку
					Прервать;
				КонецЕсли;
				
				ПараметрПодпрограммы = ПараметрыПодпрограммы[НомерПараметра];
				Если ПараметрПодпрограммы.ЗначениеПоУмолчанию = Неопределено Тогда
					// Значение параметра по умолчанию не указано
					// при выполнении произойдет ошибка, ну и пущай
				Иначе
					НовыйОператор(ТекстовыйПарсер, ПараметрВызоваПодпрограммы, Слово("ПростоКод", ПараметрПодпрограммы.ЗначениеПоУмолчанию.Код));
				КонецЕсли;
			КонецЕсли;
			НомерПараметра = НомерПараметра + 1;
		КонецЦикла;
		
		// Если скобка закрылась раньше, чем были переданы все параметры, добавим их в конец
		Пока НомерПараметра <= НомерПоследнегоПараметра Цикл
			ПараметрПодпрограммы = ПараметрыПодпрограммы[НомерПараметра];
			Если ПараметрПодпрограммы.ЗначениеПоУмолчанию = Неопределено Тогда
				//ошибка
			Иначе
				ПараметрВызоваПодпрограммы = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, ОператорПараметрыВызоваПодпрограммы);
					НовыйОператор(ТекстовыйПарсер, ПараметрВызоваПодпрограммы, Слово("ПростоКод", ПараметрПодпрограммы.ЗначениеПоУмолчанию.Код));
			КонецЕсли;

			НомерПараметра = НомерПараметра + 1;
		КонецЦикла;
		
		// вставим дополнительные параметры вызываемой подпрограммы
		ПараметрВызоваПодпрограммы = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, ОператорПараметрыВызоваПодпрограммы, 0);
			НовыйОператор(ТекстовыйПарсер, ПараметрВызоваПодпрограммы, слОбъектКонтекста);

		ПараметрВызоваПодпрограммы = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, ОператорПараметрыВызоваПодпрограммы, 1);
			НовыйОператор(ТекстовыйПарсер, ПараметрВызоваПодпрограммы, слТипОбъекта);
			
		ПараметрВызоваПодпрограммы = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, ОператорПараметрыВызоваПодпрограммы, 2);
			НовыйОператор(ТекстовыйПарсер, ПараметрВызоваПодпрограммы, Слово(ТипСтрока, ИмяВызываемойПодпрограммы));
		
		ПараметрВызоваПодпрограммы = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, ОператорПараметрыВызоваПодпрограммы, 3);
			НовыйОператор(ТекстовыйПарсер, ПараметрВызоваПодпрограммы, слПроцессорКода);
	КонецЦикла;
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьВозвратИзПодпрограммы(КомпиляторКода, Подпрограмма)
	
	ТелоПодпрограммы = Подпрограмма.ДополнительныеДанные.Тело;
	Если ТелоПодпрограммы=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ФункцияДляВызововПодпрограмм = КомпиляторКода.ФункцииДляВызововПодпрограмм[Подпрограмма.Директива.Имя];
	Если ФункцияДляВызововПодпрограмм = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ПеременнаяДляВозвратаРезультата = ФункцияДляВызововПодпрограмм.ПеременнаяДляВозвратаРезультата;
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	МассивОператоров = ТекстовыйПарсер_ПолучитьОператорыПодпрограммы(КомпиляторКода.ТекстовыйПарсер, ТелоПодпрограммы, ТипыСловИОператоров.ВозвратИзПодпрограммы);
	
	МеткаПерехода = "~КонецПодпрограммы";
	СловоЗнакРавенста = Слово(ТипыСловИОператоров.Спецсимвол, "=");
	СловоТочкаСЗапятой = Слово(ТипыСловИОператоров.Спецсимвол, ";");
	СловоПереход = Слово("ПростоКод", "Перейти " + МеткаПерехода);
	
	ЕстьОператорыВозврата = Ложь;
	Для Каждого ОператорГруппа Из МассивОператоров Цикл
		
		Операторы = ОператорГруппа.Операторы;
		Оператор1 = Операторы[0];
		Если Оператор1.Код = "Возврат" Тогда
			Если ОператорГруппа.Операторы.Количество() > 1 Тогда
				// Функция возвращает результат
				// поместим его в служебную переменную
				Оператор1.Код = ПеременнаяДляВозвратаРезультата;
				НовыйОператор(ТекстовыйПарсер, ОператорГруппа, СловоЗнакРавенста, 1);
				НовыйОператор(ТекстовыйПарсер, ОператорГруппа, СловоТочкаСЗапятой);
				НовыйОператор(ТекстовыйПарсер, ОператорГруппа, СловоПереход);
			Иначе
				// Это процедура
				// нет возвращаемого результата
				// просто преобразуем в выход из подпрограммы
				Оператор1.ТипОператора = СловоПереход.ТипСлова;
				Оператор1.Код = СловоПереход.Слово;
			КонецЕсли;
			ЕстьОператорыВозврата = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьОператорыВозврата Тогда
		ПоследнийОператор = ТелоПодпрограммы.Операторы[ТелоПодпрограммы.Операторы.ВГраница()];
		Если Не (ПоследнийОператор.ТипОператора=ТипыСловИОператоров.Спецсимвол И ПоследнийОператор.Код=";" ИЛИ ПоследнийОператор.ТипОператора=ТипыСловИОператоров.ЛогическийБлокПрепроцессора) Тогда
			НовыйОператор(ТекстовыйПарсер, ТелоПодпрограммы, СловоТочкаСЗапятой);
		КонецЕсли;
		
		НовыйОператор(ТекстовыйПарсер, ТелоПодпрограммы, Слово(ТипыСловИОператоров.Идентификатор, МеткаПерехода + ":"));
	КонецЕсли;
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьСозданиеНовыхОбъектов(КомпиляторКода, Подпрограмма)
	
	ФункцияДляСозданияНовыхОбъектов = КомпиляторКода.ФункцииДляСозданияНовыхОбъектов[Подпрограмма.Директива.Имя];
	Если ФункцияДляСозданияНовыхОбъектов=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяФункцииДляСозданияНовыхОбъектов = ФункцияДляСозданияНовыхОбъектов.Имя;
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тВызовПодпрограммы = ТипыСловИОператоров.ВызовПодпрограммы;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	тПрисвоениеЗначения = ТипыСловИОператоров.ПрисвоениеЗначения;
	тСтрока = ТипыСловИОператоров.Строка;
	
	слИмяФункции = Слово(тИдентификатор, ИмяФункцииДляСозданияНовыхОбъектов);
	слНеопределено = Слово(тИдентификатор, "НЕОПРЕДЕЛЕНО");
	слПроцессорКода = Слово(тИдентификатор, "ПроцессорКода");
	
	ОператорыСозданияНовыхОбъектов = Подпрограмма.ДополнительныеДанные.ОператорыСозданияНовыхОбъектов;
	
	Для Каждого опСозданиеНовогоОбъекта Из ОператорыСозданияНовыхОбъектов Цикл
		
		// вызов подпрограммы для переопредения создания нового объекта
		опВызовПодпрограммы = опСозданиеНовогоОбъекта;
		опВызовПодпрограммы.ТипОператора = тВызовПодпрограммы;
		опТипОбъекта = опВызовПодпрограммы.ДополнительныеДанные.ОператорТипОбъекта;
		опСкобки = опВызовПодпрограммы.ДополнительныеДанные.ОператорСкобки;
		опПараметрыВызоваПодпрограммы = опВызовПодпрограммы.ДополнительныеДанные.ПараметрыВызоваПодпрограммы;

		опВызовПодпрограммы.Операторы.Очистить();
		НовыйОператор(ТекстовыйПарсер, опВызовПодпрограммы, слИмяФункции);
		ПоместитьОператор(ТекстовыйПарсер, опВызовПодпрограммы, опСкобки);
		
		опПараметрВызова = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, опПараметрыВызоваПодпрограммы, 0);
			Если опТипОбъекта<>Неопределено Тогда
				НовыйОператор(ТекстовыйПарсер, опПараметрВызова, Слово(тСтрока, опТипОбъекта.Код));
			Иначе
				НовыйОператор(ТекстовыйПарсер, опПараметрВызова, слНеопределено);
			КонецЕсли;
			
		опПараметрВызова = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, опПараметрыВызоваПодпрограммы, 1);
			НовыйОператор(ТекстовыйПарсер, опПараметрВызова, слПроцессорКода);
		
	КонецЦикла;
		
	ОператорыСозданияНовыхОбъектов.Очистить();
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьПодключениеОтключениеОбработчиковОжидания(КомпиляторКода, Подпрограмма)
	
	МассивОператоровПодключениеОтключениеОбработчиковОжидания = КомпиляторКода_ПолучитьОператорыПодключениеОтключениеОбработчиковОжидания(КомпиляторКода, Подпрограмма);
	
	Для Каждого ОператорПодключениеОтключениеОбработчиковОжидания Из МассивОператоровПодключениеОтключениеОбработчиковОжидания Цикл
		
		ОператорИмяПроцедуры = ОператорПодключениеОтключениеОбработчиковОжидания.Операторы[0];
		
		ОператорИмяПроцедуры.Код = ОператорИмяПроцедуры.Код + "Переопределенная";
		
	КонецЦикла;
	
КонецФункции

Функция КомпиляторКода_ПолучитьОператорыПодключениеОтключениеОбработчиковОжидания(КомпиляторКода, Подпрограмма)
	
	МассивОператоровПодключениеОтключениеОбработчиковОжидания = Новый Массив;

	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	МассивОператоровВызовПодпрограммы = ТекстовыйПарсер_ПолучитьОператорыПодпрограммы(КомпиляторКода.ТекстовыйПарсер, Подпрограмма, ТипыСловИОператоров.ВызовПодпрограммы);
	
	Для Каждого ОператорВызовПодпрограммы Из МассивОператоровВызовПодпрограммы Цикл
		
		Если ОператорВызовПодпрограммы.Операторы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОператорИдентификатор = ОператорВызовПодпрограммы.Операторы[0];
		Если Не (ОператорИдентификатор.Код = "ПодключитьОбработчикОжидания" ИЛИ ОператорИдентификатор.Код = "ОтключитьОбработчикОжидания") Тогда
			Продолжить;
		КонецЕсли;
		
		МассивОператоровПодключениеОтключениеОбработчиковОжидания.Добавить(ОператорВызовПодпрограммы);
		
	КонецЦикла;
	
	Возврат МассивОператоровПодключениеОтключениеОбработчиковОжидания;
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьДобавленияКомандФормы(КомпиляторКода, Подпрограмма)
	
	Если Подпрограмма.Директива.Имя <> "НАСЕРВЕРЕ" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	МассивОператоровВызовМетода = ТекстовыйПарсер_ПолучитьОператорыПодпрограммы(КомпиляторКода.ТекстовыйПарсер, Подпрограмма, ТипыСловИОператоров.ВызовМетода);
	
	МассивОператоровВызовМетодаКомандФормыДобавить = Новый Массив;
	
	Для Каждого ОператорВызовМетода Из МассивОператоровВызовМетода Цикл
		
		СубОператоры = ОператорВызовМетода.Операторы;
		
		Если СубОператоры.Количество() = 6 Тогда
			Если СубОператоры[0].Код = "ЭтаФорма" И СубОператоры[2].Код = "Команды" И СубОператоры[4].Код = "Добавить" Тогда
				МассивОператоровВызовМетодаКомандФормыДобавить.Добавить(ОператорВызовМетода);
			КонецЕсли;
		ИначеЕсли СубОператоры.Количество() = 4 Тогда
			Если СубОператоры[0].Код = "Команды" И СубОператоры[2].Код = "Добавить" Тогда
				МассивОператоровВызовМетодаКомандФормыДобавить.Добавить(ОператорВызовМетода);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ОператорВызоваМетодаКомандФормыДобавить Из МассивОператоровВызовМетодаКомандФормыДобавить Цикл
		
		СубОператоры = ОператорВызоваМетодаКомандФормыДобавить.Операторы;
		
		Пока СубОператоры.Количество() > 2 Цикл
			СубОператоры.Удалить(1);
		КонецЦикла;
		
		СубОператоры[0].Код = "ДобавитьКомандуФормы";
		
	КонецЦикла;
	
КонецФункции

Функция КомпиляторКода_ПоместитьПеременныеПодпрограммВКонтекст(КомпиляторКода, Контекст, ИменаПеременных, Подпрограммы) Экспорт

	ТекстовыйПарсер_ПоместитьПеременныеПодпрограммВКонтекст(КомпиляторКода.ТекстовыйПарсер, Контекст, ИменаПеременных, Подпрограммы);
	
КонецФункции

Функция КомпиляторКода_ПодключитьОбработчикОжидания(КомпиляторКода, ИмяПроцедуры, Интервал, Однократно=Ложь) Экспорт

	Перем РаботаСКоллекциями;

	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ОбработкаОжидания = КомпиляторКода.ОбработкаОжидания;
	ОбработчикиОжидания = ОбработкаОжидания.ОбработчикиОжидания;
	
	ОбработчикОжидания = РаботаСКоллекциями.НайтиЭлементКоллекции(ОбработчикиОжидания, Новый Структура("ИмяПроцедуры", ИмяПроцедуры));
	Если ОбработчикОжидания = Неопределено Тогда
		ОбработчикОжидания = РаботаСКоллекциями.ДобавитьСтрокуКвазиТаблицыЗначений(ОбработчикиОжидания);
	КонецЕсли;
	
	ОбработчикОжидания.ИмяПроцедуры = ИмяПроцедуры;
	ОбработчикОжидания.Интервал = Интервал;
	ОбработчикОжидания.Однократно = Однократно;
	ОбработчикОжидания.ВремяНачала = ОбработкаОжидания.Время;
	
КонецФункции

Функция КомпиляторКода_ОбработкаОжидания(КомпиляторКода) Экспорт

	Перем РаботаСКоллекциями;

	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ОбработкаОжидания = КомпиляторКода.ОбработкаОжидания;
	ОбработчикиОжидания = ОбработкаОжидания.ОбработчикиОжидания;
	
	ОбработчикиОжидания = РаботаСКоллекциями.ПолучитьЭлементыКоллекции(ОбработкаОжидания.ОбработчикиОжидания);
	
	ОтработанныеОбработчикиОжидания = Новый Массив;
	
	Для Каждого ОбработчикОжидания Из ОбработчикиОжидания Цикл
		
		Если ОбработкаОжидания.Время - ОбработчикОжидания.ВремяНачала >= ОбработчикОжидания.Интервал*ОбработкаОжидания.КратностьВремени Тогда
			ОтработанныеОбработчикиОжидания.Добавить(ОбработчикОжидания);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбработкаОжидания.Время = ОбработкаОжидания.Время + 1;
	
	Для Каждого ОтработанныйОбработчикОжидания Из ОтработанныеОбработчикиОжидания Цикл
		Если ОтработанныйОбработчикОжидания.Однократно Тогда
			РаботаСКоллекциями.УдалитьЭлементыКоллекции(ОбработчикиОжидания, ОтработанныйОбработчикОжидания);
		Иначе
			ОтработанныйОбработчикОжидания.ВремяНачала = ОбработкаОжидания.Время;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОтработанныеОбработчикиОжидания;
	
КонецФункции

Функция КомпиляторКода_РазорватьЦепочкиУсловныхОператоров(КомпиляторКода, Подпрограмма)
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	тЛогическийБлок = ТипыСловИОператоров.ЛогическийБлок;
	
	ДополнительныеДанныеПодпрограммы = Подпрограмма.ДополнительныеДанные;
	ДополнительныеДанныеПодпрограммы.Вставить("НомерЦепочкиУсловныхОператоров", 1);
	
	слКонецЕсли = Слово(тИдентификатор, "КонецЕсли");
	
	ОбходОператоров = Новый Массив;
	ОбходОператоров.Добавить(Подпрограмма);
	
	ИскатьНачалоБлока = Истина;
	Цепочка = Новый Массив;
	
	Для Каждого Оператор Из ОбходОператоров Цикл
		
		Для Каждого СубОператор Из Оператор.Операторы Цикл
			ОбходОператоров.Добавить(СубОператор);
		КонецЦикла;
		
		Если Оператор.ТипОператора=тЛогическийБлок Тогда
			
			опПервый = Оператор.Операторы[0];
			опПоследний = Оператор.Операторы[Оператор.Операторы.ВГраница()];
			Если ИскатьНачалоБлока Тогда
				Если опПервый.Код="Если" Тогда
					Если опПоследний.Код="КонецЕсли" Тогда
						// отдельный блок
					Иначе
						ИскатьНачалоБлока = Ложь;
						Цепочка.Добавить(Оператор);
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если опПервый.Код="ИначеЕсли" ИЛИ опПервый.Код="Иначе" Тогда
					БезУсловия = опПервый.Код="Иначе";
					Цепочка.Добавить(Оператор);
					Если опПоследний.Код="КонецЕсли" Тогда
						// конец цепочки
						ИмяМеткиПерехода = "~КонецЦепочкиУсловныхОператоров" + Формат(ДополнительныеДанныеПодпрограммы.НомерЦепочкиУсловныхОператоров, "ЧГ=0");
						ДополнительныеДанныеПодпрограммы.НомерЦепочкиУсловныхОператоров = ДополнительныеДанныеПодпрограммы.НомерЦепочкиУсловныхОператоров + 1;
						слПереходНаКонецЦепочки = Слово("ПростоКод", "Перейти " + ИмяМеткиПерехода);
						ПоследнийУсловныйОператор = Цепочка[Цепочка.ВГраница()];
						Для Каждого опУсловныйОператор Из Цепочка Цикл
							
							опРодитель = опУсловныйОператор.Родитель;
							ИндексВставкиПослеУсловногоОператора = опРодитель.Операторы.Найти(опУсловныйОператор)+1;
							
							опПервый = опУсловныйОператор.Операторы[0];
							опПервый.Код = "Если";
							
							опТело = опУсловныйОператор.ДополнительныеДанные.Тело;
							Если опУсловныйОператор=ПоследнийУсловныйОператор Тогда
								НовыйОператор(ТекстовыйПарсер, опРодитель, Слово("ПростоКод", ИмяМеткиПерехода+":"), ИндексВставкиПослеУсловногоОператора);
								НовыйРазделительОператоров(ТекстовыйПарсер, опРодитель, ИндексВставкиПослеУсловногоОператора);
								Если БезУсловия Тогда
									// извлечь операторы
									Пока опТело.Операторы.Количество() > 0 Цикл
										опОператорТела = опТело.Операторы[0];
										ПоместитьОператор(ТекстовыйПарсер, , опОператорТела, опУсловныйОператор);
									КонецЦикла;
									УдалитьОператор(опУсловныйОператор);
								КонецЕсли;
							Иначе
								НовыйРазделительОператоров(ТекстовыйПарсер, опРодитель, ИндексВставкиПослеУсловногоОператора);
								НовыйОператор(ТекстовыйПарсер, опТело, слПереходНаКонецЦепочки);
								НовыйОператор(ТекстовыйПарсер, опУсловныйОператор, слКонецЕсли);
							КонецЕсли;
							
						КонецЦикла;
						
						ИскатьНачалоБлока = Истина;
						Цепочка.Очистить();
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьЦиклыПодпрограммы(КомпиляторКода, Подпрограмма)
	
	ТелоПодпрограммы = Подпрограмма.ДополнительныеДанные.Тело;
	Если ТелоПодпрограммы=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Подпрограмма.ДополнительныеДанные.Вставить("НомерЦикла", 1);
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	тПрисвоениеЗначения = ТипыСловИОператоров.ПрисвоениеЗначения;
	тЛогическиБлок = ТипыСловИОператоров.ЛогическийБлок;
	тСпецсимвол = ТипыСловИОператоров.Спецсимвол;
	
	слНЕ = Слово(тИдентификатор, "НЕ");
	слИстина = Слово(тИдентификатор, "ИСТИНА");
	слБольше = Слово(тСпецсимвол, ">");
	слПрервать = Слово(тИдентификатор, "Прервать");
	слПлюс = Слово(ТипыСловИОператоров.ОперацияВыражения, "+");
	слШаг = Слово(ТипыСловИОператоров.Число, "1");
	
	слПроцессорКода = Слово(тИдентификатор, "ПроцессорКода");

	Для Каждого опЦикл Из Подпрограмма.ДополнительныеДанные.ОператорыЦиклов Цикл
		
		опПервый = опЦикл.Операторы[0];
		опЗаголовокЦикла = опЦикл.ДополнительныеДанные.Заголовок;
		опТелоЦикла = опЦикл.ДополнительныеДанные.Тело;
		ТипЦикла = ВРЕГ(опПервый.Код);

		ОператорыУправленияЦиклом =ТекстовыйПарсер_ПолучитьОператорыУправленияЦиклом(ТекстовыйПарсер, Подпрограмма, опЦикл);
		ОператорыПродолжить = ОператорыУправленияЦиклом.ОператорыПродолжить;
		Если ОператорыПродолжить.Количество() > 0 Тогда
			МеткаПередКонцомЦикла = "~ПередКонцомЦикла" + Формат(Подпрограмма.ДополнительныеДанные.НомерЦикла, "ЧГ=0"); 
			Подпрограмма.ДополнительныеДанные.НомерЦикла = Подпрограмма.ДополнительныеДанные.НомерЦикла + 1;
			Для Каждого ОператорПродолжить Из ОператорыПродолжить Цикл
				ОператорПродолжить.Код = "Перейти " + МеткаПередКонцомЦикла;
				ОператорПродолжить.ТипОператора = "ПростоКод";
			КонецЦикла;
			
			НовыйОператор(ТекстовыйПарсер, опТелоЦикла, Слово("ПростоКод", МеткаПередКонцомЦикла + ":"));
		КонецЕсли;
		
		Если ТипЦикла="ПОКА" Тогда
			
			// Перенесем условие внутрь цикла
			// чтобы в дальнейшем можно было его декомпозировать,
			// и все элементы декомпозиции выполнялись при каждой итерации цикла
			опУсловный = НовыйУсловныйОператор(ТекстовыйПарсер, опТелоЦикла, 0);
			НовыйРазделительОператоров(ТекстовыйПарсер, опТелоЦикла, 1);
			опУсловие = опУсловный.ДополнительныеДанные.Заголовок;

			НовыйОператор(ТекстовыйПарсер, опУсловие, слНЕ);
			опСкобки = НовыйОператорСкобки(ТекстовыйПарсер, опУсловие);
			Пока опЗаголовокЦикла.Операторы.Количество() > 0 Цикл
				опУсловияЦикла = опЗаголовокЦикла.Операторы[0];
				ПоместитьОператор(ТекстовыйПарсер, опСкобки, опУсловияЦикла);
			КонецЦикла;
			ЗакрытьОператорСкобки(опСкобки, ТекстовыйПарсер);

			опТело = опУсловный.ДополнительныеДанные.Тело;
			НовыйОператор(ТекстовыйПарсер, опТело, слПрервать);
			
			// "Вечный" цикл :)
			НовыйОператор(ТекстовыйПарсер, опЗаголовокЦикла, слИстина);
			
		ИначеЕсли ТипЦикла="ДЛЯ" Тогда
			
			Если опЗаголовокЦикла.Операторы.Количество() > 3 Тогда
				
				Если ВРЕГ(опЗаголовокЦикла.Операторы[0].Код)="КАЖДОГО" Тогда
					
					опКоллекцияДляОбхода = опЗаголовокЦикла.Операторы[опЗаголовокЦикла.Операторы.Количество()-1];

					опВызовПодпрограммы = НовыйОператорВызовПодпрограммы("ПолучитьИтераторКоллекции", ТекстовыйПарсер, , опКоллекцияДляОбхода);
						опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
							ПоместитьОператор(ТекстовыйПарсер, опПараметрВызова, опКоллекцияДляОбхода);
						опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
							НовыйОператор(ТекстовыйПарсер, опПараметрВызова, слПроцессорКода);
							
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если опЗаголовокЦикла.Операторы.Количество()=3 Тогда
				ОпрераторЗаголовка = опЗаголовокЦикла.Операторы[1];
				Если ОпрераторЗаголовка.ТипОператора=тИдентификатор И ВРЕГ(ОпрераторЗаголовка.Код)="ПО" Тогда
					
					опИнициализацияПеременной = опЗаголовокЦикла.Операторы[0];
					опКонечноеЗначение = опЗаголовокЦикла.Операторы[2];
					Если опИнициализацияПеременной.ТипОператора=тПрисвоениеЗначения Тогда
						
						//преобразовать цикл
						опЗаголовокЦикла.Операторы.Очистить();
						НовыйОператор(ТекстовыйПарсер, опЗаголовокЦикла, слИстина);
						
						опПервый = опЦикл.Операторы[0];
						опПервый.Код = "Пока";
						
						// инициализация переменной
						ПоместитьОператор(ТекстовыйПарсер, , опИнициализацияПеременной, опЦикл);
						НовыйРазделительОператоров(ТекстовыйПарсер, , опЦикл);

						// условие выхода из цикла
						опПеременная = опИнициализацияПеременной.Операторы[0];
						опУсловный = НовыйУсловныйОператор(ТекстовыйПарсер, опТелоЦикла, 0);
						опУсловие = опУсловный.ДополнительныеДанные.Заголовок;
						опТело = опУсловный.ДополнительныеДанные.Тело;
						СкопироватьОператор(ТекстовыйПарсер, опПеременная, опУсловие);
						НовыйОператор(ТекстовыйПарсер, опУсловие, слБольше);
						ПоместитьОператор(ТекстовыйПарсер, опУсловие, опКонечноеЗначение);
						НовыйОператор(ТекстовыйПарсер, опТело, слПрервать);
						НовыйРазделительОператоров(ТекстовыйПарсер, опТелоЦикла, 1);
						
						// инкремент переменной
						опПеременная = СкопироватьОператор(ТекстовыйПарсер, опПеременная, опТелоЦикла);
						опПравоеВыражение = НовыйОператорВыражение(ТекстовыйПарсер, опТелоЦикла);
							опПравоеВыражение.ЛевоеЗначение = Ложь;
							СкопироватьОператор(ТекстовыйПарсер, опПеременная, опПравоеВыражение);
							НовыйОператор(ТекстовыйПарсер, опПравоеВыражение, слПлюс);
							НовыйОператор(ТекстовыйПарсер, опПравоеВыражение, слШаг);
						опИнкрементПеременной = НовыйОператорПрисвоениеЗначение(опПеременная, опПравоеВыражение, ТекстовыйПарсер, опТелоЦикла);
						
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция КомпиляторКода_ПреобразоватьВызовыМетодовПодпрограммы(КомпиляторКода, Подпрограмма)
	
	ЕстьПреобразования = Ложь;
	ДополнительныеДанныеПодпрограммы = Подпрограмма.ДополнительныеДанные;
	ТелоПодпрограммы = ДополнительныеДанныеПодпрограммы.Тело;
	Если ТелоПодпрограммы=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ФункцияДляОбработки = КомпиляторКода.ФункцииДляВызововПодпрограмм[Подпрограмма.Директива.Имя];
	Если ФункцияДляОбработки=Неопределено Тогда
		Возврат ЕстьПреобразования;
	КонецЕсли;
	
	ИмяОбработчикаВызовПодпрограммы = ФункцияДляОбработки.Имя;
	КоличествоПараметровСервиснойФункции = ФункцияДляОбработки.Параметры.Количество();
		
	ДополнительныеДанныеПодпрограммы.Вставить("НомерРезультатаВычисленияОбъектаКонтекста", 1);
	ДополнительныеДанныеПодпрограммы.Вставить("НомерРезультатаВызоваМетода", 1);
	ДополнительныеДанныеПодпрограммы.Вставить("НомерРезультатаВызоваПодпрограммы", 1);
	ДополнительныеДанныеПодпрограммы.Вставить("НомерРезультатаПараметраВызоваМетода", 1);
	ДополнительныеДанныеПодпрограммы.Вставить("НомерРезультатаПравогоЗначения", 1);
	ДополнительныеДанныеПодпрограммы.Вставить("НомерРезультатаПолученияЗначенияПоля", 1);
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	тВызовМетода = ТипыСловИОператоров.ВызовМетода;
	тПоле = ТипыСловИОператоров.Поле;
	тВызовПодпрограммы = ТипыСловИОператоров.ВызовПодпрограммы;
