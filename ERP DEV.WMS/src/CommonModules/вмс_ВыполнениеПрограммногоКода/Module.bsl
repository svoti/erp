Функция ТекстовыйПарсер_ПоместитьПеременныеПодпрограммВКонтекст(ТекстовыйПарсер, Контекст, ИменаПеременных, Подпрограммы=Неопределено) Экспорт

	Перем РаботаСКоллекциями;

	Если Не ЗначениеЗаполнено(Контекст) Тогда
		Возврат Ложь;
	КонецЕсли;

	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	Если ТипЗнч(ИменаПеременных) = Тип("Структура") Тогда
		ИменаПеременныхМассив = РаботаСКоллекциями.ВыгрузитьЗначенияКолонокКоллекции(ИменаПеременных, "Ключ");
	Иначе
		ИменаПеременныхМассив = РаботаСКоллекциями.ЗначениеВМассив(ИменаПеременных);
	КонецЕсли;
	
	ЗаменаИдентификаторов = Новый Соответствие;
	Для Каждого ИмяПеременной Из ИменаПеременныхМассив Цикл
		ЗаменаИдентификаторов[ВРЕГ(ИмяПеременной)] = Контекст + "." + ИмяПеременной;
	КонецЦикла;
	
	МассивПодпрограмм = ТекстовыйПарсер_ПолучитьМассивПодпрограмм(ТекстовыйПарсер, Подпрограммы);
	Для Каждого Подпрограмма Из МассивПодпрограмм Цикл

		Если НЕ Подпрограмма.Директива.ИспользоватьДанныеКонтекста Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстовыйПарсер_ЗаменитьИдентификаторыПодпрограммы(ТекстовыйПарсер, Подпрограмма, ЗаменаИдентификаторов, Ложь);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_ПолучитьМассивПодпрограмм(ТекстовыйПарсер, Подпрограммы=Неопределено) Экспорт
	
	Перем РаботаСКоллекциями;

	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	Если Подпрограммы = Неопределено Тогда
		МассивПодпрограмм = ТекстовыйПарсер.ТаблицаПодпрограмм.Строки;
	Иначе
		МассивПодпрограмм = РаботаСКоллекциями.ЗначениеВМассив(Подпрограммы);
	КонецЕсли;
	
	Возврат МассивПодпрограмм;
	
КонецФункции



Функция ВызватьКонтекстИсполнения(ПараметрыВызоваКонтекстаИсполнения)
	
	Перем РаботаСXMLКлиентСервер;
	
	ОбработанныеПараметрыВызоваКонтекстаИсполнения = Новый Структура;
	ОбработанныеПараметрыВызоваКонтекстаИсполнения.Вставить("Действие", ПараметрыВызоваКонтекстаИсполнения.Действие);
	ОбработанныеПараметрыВызоваКонтекстаИсполнения.Вставить("ИспользоватьКэш", ПараметрыВызоваКонтекстаИсполнения.ИспользоватьКэш);
	
	ПередатьДанные = Ложь;
	Если ПараметрыВызоваКонтекстаИсполнения.Действие="КомпиляцияКода" Тогда
		
		ОбработанныеПараметрыВызоваКонтекстаИсполнения.Вставить("КонтекстИсполнения", ПараметрыВызоваКонтекстаИсполнения.КонтекстИсполнения);
		ОбработанныеПараметрыВызоваКонтекстаИсполнения.Вставить("ПрограммныеМодули", ПараметрыВызоваКонтекстаИсполнения.ПрограммныеМодули);
		
		ДанныеКомпоновщикаКода = ПараметрыВызоваКонтекстаИсполнения.ДанныеКомпоновщикаКода;
		
	ИначеЕсли ПараметрыВызоваКонтекстаИсполнения.Действие="ИсполнениеКода" Тогда

		ДанныеДляВыполненияКода = ПараметрыВызоваКонтекстаИсполнения.ДанныеДляВыполненияКода;
		ОбработанныеПараметрыВызоваКонтекстаИсполнения.Вставить("ПараметрыВызоваПодпрограммы", ПараметрыВызоваКонтекстаИсполнения.ПараметрыВызоваПодпрограммы);
		Если Не ПараметрыВызоваКонтекстаИсполнения.ИспользоватьКэш ИЛИ ДанныеДляВыполненияКода.ОбновитьДанныеКонтекстаИсполнения Тогда
			ПередатьДанные = Истина;
			ДанныеДляВыполненияКода.ОбновитьДанныеКонтекстаИсполнения = Ложь;
		КонецЕсли;
		
		ОбработанныеПараметрыВызоваКонтекстаИсполнения.Вставить("Форма");
		ОбработанныеПараметрыВызоваКонтекстаИсполнения.Вставить("ИспользоватьДанныеКонтекста", ПараметрыВызоваКонтекстаИсполнения.ИспользоватьДанныеКонтекста);

		ОбработатьПараметрыВызоваПодпрограммыПередПереходом(ОбработанныеПараметрыВызоваКонтекстаИсполнения, ПараметрыВызоваКонтекстаИсполнения.ПроцессорКода);
		
		Форма = ОбработанныеПараметрыВызоваКонтекстаИсполнения.Форма;
		Если Форма <> Неопределено Тогда
			ОбработанныеПараметрыВызоваКонтекстаИсполнения.Форма = Неопределено;
			КодВызоваСервераНаФорме =
			"ПараметрыВызоваКонтекстаИсполнения = ДополнительныеПараметры;
			|ПараметрыВызоваКонтекстаИсполнения.Форма = Форма;
			|Результат = вмс_ВыполнениеПрограммногоКодаВызовСервера.ОбработатьПереходКонтекстаИсполнения(ПараметрыВызоваКонтекстаИсполнения);";
		КонецЕсли;
	КонецЕсли;
	
	РаботаСXMLКлиентСервер = глОбщийМодуль("РаботаСXMLКлиентСервер");

	ВызываемыйКонтекстИсполнения = ПараметрыВызоваКонтекстаИсполнения.КонтекстИсполнения;
	Для НомерВызова=1 По 2 Цикл
		
		Если ПередатьДанные Тогда
			Если ПараметрыВызоваКонтекстаИсполнения.Действие="КомпиляцияКода" Тогда
				ДанныеКомпоновщикаКодаXML = РаботаСXMLКлиентСервер.XMLСтрокаИзЗначенияУлучшенная(ДанныеКомпоновщикаКода);
				ОбработанныеПараметрыВызоваКонтекстаИсполнения.Вставить("ДанныеКомпоновщикаКодаXML", ДанныеКомпоновщикаКодаXML);
			ИначеЕсли ПараметрыВызоваКонтекстаИсполнения.Действие="ИсполнениеКода" Тогда
				ДанныеДляВыполненияКодаXML = РаботаСXMLКлиентСервер.XMLСтрокаИзЗначенияУлучшенная(ДанныеДляВыполненияКода);
				ОбработанныеПараметрыВызоваКонтекстаИсполнения.Вставить("ДанныеДляВыполненияКодаXML", ДанныеДляВыполненияКодаXML);
			КонецЕсли;
		КонецЕсли;
		
		Если ВызываемыйКонтекстИсполнения="Сервер" Тогда
			Если Форма <> Неопределено Тогда
				РезультатВызоваКонтекстаИсполнения = Форма.СлужебнаяФункцияВызовСервера(КодВызоваСервераНаФорме, ОбработанныеПараметрыВызоваКонтекстаИсполнения);
			Иначе
				РезультатВызоваКонтекстаИсполнения = вмс_ВыполнениеПрограммногоКодаВызовСервера.ОбработатьПереходКонтекстаИсполнения(ОбработанныеПараметрыВызоваКонтекстаИсполнения);
			КонецЕсли;
		Иначе
			ВызватьИсключение "Вызов неизвестного контекста исполнения """ + ВызываемыйКонтекстИсполнения + """";
		КонецЕсли;
		
		Если РезультатВызоваКонтекстаИсполнения.Успешно Тогда
			Если РезультатВызоваКонтекстаИсполнения.ФорматРезультатаВXML Тогда
				Возврат РаботаСXMLКлиентСервер.ПрочитатьТекстXMLУлучшенная(РезультатВызоваКонтекстаИсполнения.Результат);
			Иначе
				Возврат РезультатВызоваКонтекстаИсполнения.Результат;
			КонецЕсли;
		КонецЕсли;

		Если РезультатВызоваКонтекстаИсполнения.НетДанных Тогда
			ПередатьДанные = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	ВызватьИсключение "Ошибка вызова контекста исполнения """ + ВызываемыйКонтекстИсполнения + """";

КонецФункции

Функция ОбработатьПараметрыВызоваПодпрограммыПередПереходом(ПараметрыВызоваКонтекстаИсполнения, ПроцессорКода)

	ПараметрыВызоваКонтекстаИсполнения.Вставить("НативныйОбъектКонтекстаЗамещен", Ложь);

	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ОбъектКонтекста = ПараметрыВызоваКонтекстаИсполнения.ПараметрыВызоваПодпрограммы[0];
	КлассныйОбъект = вмс_КлассныеОбъекты.ПолучитьКлассныйОбъект(ОбъектКонтекста, ПроцессорКода);
	НативныйОбъект = КлассныйОбъект.НативныйОбъект;
	Если НативныйОбъект <> Неопределено Тогда
		
		Если ТипЗнч(НативныйОбъект)=Тип("ФормаКлиентскогоПриложения") Тогда
			Если ПараметрыВызоваКонтекстаИсполнения.ИспользоватьДанныеКонтекста Тогда
				ПараметрыВызоваКонтекстаИсполнения.Форма = НативныйОбъект;
			КонецЕсли;
			ПараметрыВызоваКонтекстаИсполнения.НативныйОбъектКонтекстаЗамещен = ОбъектКонтекста<>КлассныйОбъект;
			КлассныйОбъект = РК.СкопироватьОбъект(КлассныйОбъект);
			КлассныйОбъект.НативныйОбъект = Неопределено;
			Если ПараметрыВызоваКонтекстаИсполнения.НативныйОбъектКонтекстаЗамещен Тогда
				ПараметрыВызоваКонтекстаИсполнения.ПараметрыВызоваПодпрограммы[0] = КлассныйОбъект;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецФункции
