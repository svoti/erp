Функция НовыйУсловныйОператор(ТекстовыйПарсер, Родитель=Неопределено, Индекс=Неопределено)
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	
	опУсловныйОператор = НовыйОператор(ТекстовыйПарсер, Родитель, , Индекс);
	опУсловныйОператор.ТипОператора = ТипыСловИОператоров.ЛогическийБлок;
	НовыйОператор(ТекстовыйПарсер, опУсловныйОператор, Слово(тИдентификатор, "Если"));
	опЗаголовок = НовыйОператор(ТекстовыйПарсер, опУсловныйОператор, Слово(ТипыСловИОператоров.ЗаголовокЛогическогоБлока));
	опЗаголовок.ЛевоеЗначение = Ложь;
	НовыйОператор(ТекстовыйПарсер, опУсловныйОператор, Слово(тИдентификатор, "Тогда"));
	опТело = НовыйОператор(ТекстовыйПарсер, опУсловныйОператор, Слово(ТипыСловИОператоров.ТелоЛогическогоБлока));
	НовыйОператор(ТекстовыйПарсер, опУсловныйОператор, Слово(тИдентификатор, "КонецЕсли"));
	
	опУсловныйОператор.ДополнительныеДанные.Вставить("Заголовок", опЗаголовок);
	опУсловныйОператор.ДополнительныеДанные.Вставить("Тело", опТело);
	
	Возврат опУсловныйОператор;
	
КонецФункции

Функция НовыйЛинейныйУсловныйОператор(Выражение, ВеткаИстина, ВеткаЛожь, ТекстовыйПарсер, Родитель, Индекс=Неопределено)
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	ТипЛинейноеУсловие = ТипыСловИОператоров.ЛинейныйУсловныйОператор;
	ТипСкобки = ТипыСловИОператоров.Скобки;
	ТипСпецсимвол = ТипыСловИОператоров.Спецсимвол;

	УсловныйОператор = НовыйОператор(ТекстовыйПарсер, Родитель, , Индекс);
	УсловныйОператор.ТипОператора = ТипЛинейноеУсловие;
	НовыйОператор(ТекстовыйПарсер, УсловныйОператор, Слово(ТипСпецсимвол, "?"));
	Скобки = НовыйОператор(ТекстовыйПарсер, УсловныйОператор, Слово(ТипСкобки));
	НовыйОператор(ТекстовыйПарсер, Скобки, Слово(ТипСпецсимвол, "("));
	ПоместитьОператор(ТекстовыйПарсер, Скобки, Выражение);
	НовыйОператор(ТекстовыйПарсер, Скобки, Слово(ТипСпецсимвол, ","));
	ПоместитьОператор(ТекстовыйПарсер, Скобки, ВеткаИстина);
	НовыйОператор(ТекстовыйПарсер, Скобки, Слово(ТипСпецсимвол, ","));
	ПоместитьОператор(ТекстовыйПарсер, Скобки, ВеткаЛожь);
	НовыйОператор(ТекстовыйПарсер, Скобки, Слово(ТипСпецсимвол, ")"));
	
	Возврат УсловныйОператор;
	
КонецФункции

Функция НовыйОператорВызовПодпрограммы(ИмяПодпрограммы, ТекстовыйПарсер, Родитель=Неопределено, Индекс=Неопределено)
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	опВызовПодпрограммы = НовыйОператор(ТекстовыйПарсер, Родитель, , Индекс);
	опВызовПодпрограммы.ТипОператора = ТипыСловИОператоров.ВызовПодпрограммы;
	ИдентификаторПодпрограммы = НовыйОператор(ТекстовыйПарсер, опВызовПодпрограммы, Слово(ТипыСловИОператоров.Идентификатор, ИмяПодпрограммы));
	
	опСкобки = НовыйОператорСкобки(ТекстовыйПарсер, опВызовПодпрограммы);
	опПараметрыВызоваПодпрограммы = НовыйОператор(ТекстовыйПарсер, опСкобки);
	опПараметрыВызоваПодпрограммы.ТипОператора = ТипыСловИОператоров.ПараметрыВызоваПодпрограммы;
	ЗакрытьОператорСкобки(опСкобки, ТекстовыйПарсер);
	
	опВызовПодпрограммы.ДополнительныеДанные.Вставить("ПараметрыВызоваПодпрограммы", опПараметрыВызоваПодпрограммы);
	
	Возврат опВызовПодпрограммы;
	
КонецФункции

Функция НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, ОператорРодитель, Индекс=Неопределено)

