Функция ТекстовыйПарсер_РазобратьОператорВозвратИзПодпрограммы(ТекстовыйПарсер, Подпрограмма, ОператорВладелец)

	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Не (Слово.ТипСлова=ТипыСловИОператоров.Идентификатор И Слово.Слово="Возврат") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОператорВозвратИзПодпрограммы = НовыйОператор(ТекстовыйПарсер, ОператорВладелец);
	ОператорВозвратИзПодпрограммы.ТипОператора = ТипыСловИОператоров.ВозвратИзПодпрограммы;
	
	НовыйОператор(ТекстовыйПарсер, ОператорВозвратИзПодпрограммы, Слово);
	СледующееСлово(ТекстовыйПарсер);
	
	ТекстовыйПарсер_РазобратьОператорВыражение(ТекстовыйПарсер, Подпрограмма, ОператорВозвратИзПодпрограммы);
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьПараметрыВызоваПодпрограммы(ТекстовыйПарсер, Подпрограмма, ОператорВызоваПодпрограммы)
	
	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	ОператорСкобки = ОператорВызоваПодпрограммы.ДополнительныеДанные.ОператорСкобки;
	Если ОператорСкобки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Операторы = ОператорСкобки.Операторы;
	КоличествоОператоров = Операторы.Количество();
	Если КоличествоОператоров < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Оператор = Операторы[0];
	Если Не (Оператор.ТипОператора = ТипыСловИОператоров.Спецсимвол И Оператор.Код = "(") Тогда
		Возврат Ложь;
	КонецЕсли;
	ЛеваяСкобка = Оператор;
	
	Оператор = Операторы[КоличествоОператоров-1];
	Если Не (Оператор.ТипОператора = ТипыСловИОператоров.Спецсимвол И Оператор.Код = ")") Тогда
		Возврат Ложь;
	КонецЕсли;
	ПраваяСкобка = Оператор;
	
	КоличествоОператоров = КоличествоОператоров - 2;
	
	Операторы = РаботаСКоллекциями.СкопироватьОбъект(Операторы);
	ОператорСкобки.Операторы.Очистить();
	ОператорСкобки.Операторы.Добавить(ЛеваяСкобка);
	
	ПараметрыВызоваПодпрограммы = НовыйОператор(ТекстовыйПарсер, ОператорСкобки);
	ПараметрыВызоваПодпрограммы.ТипОператора = ТипыСловИОператоров.ПараметрыВызоваПодпрограммы;
	ОператорВызоваПодпрограммы.ДополнительныеДанные.Вставить("ПараметрыВызоваПодпрограммы", ПараметрыВызоваПодпрограммы);
	
	Если КоличествоОператоров > 0 Тогда
		
		ОператорПараметр = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, ПараметрыВызоваПодпрограммы);
		Для НомерОператора=1 По КоличествоОператоров Цикл

			Оператор = Операторы[НомерОператора];
			ЭтоРазделитель = Оператор.ТипОператора = ТипыСловИОператоров.Спецсимвол И Оператор.Код = ",";

			Если ЭтоРазделитель Тогда
				ОператорПараметр = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, ПараметрыВызоваПодпрограммы);
			Иначе
				Оператор.Родитель = ОператорПараметр;
				ОператорПараметр.Операторы.Добавить(Оператор);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

	ОператорСкобки.Операторы.Добавить(ПраваяСкобка);
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_ПолучитьОператорыПодпрограммы(ТекстовыйПарсер, Подпрограмма, ТипыОператоров)
	
	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТипыОператоровСоответствие = РаботаСКоллекциями.ПреобразоватьМассивВСоответствие(РаботаСКоллекциями.ЗначениеВМассив(ТипыОператоров, , Ложь));
	
	ОбходОператоров = Новый Массив;
	ОбходОператоров.Добавить(Подпрограмма);
	
	МассивОператоров = Новый Массив;
	Для Каждого Оператор Из ОбходОператоров Цикл
		Если ТипыОператоровСоответствие[Оператор.ТипОператора] = Истина Тогда
			МассивОператоров.Добавить(Оператор);
		КонецЕсли;
		
		СубОператоры = Оператор.Операторы;
		Если СубОператоры.Количество() > 0 Тогда
			Для Каждого СубОператор Из СубОператоры Цикл
				ОбходОператоров.Добавить(СубОператор);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивОператоров;
	
КонецФункции

Функция ТекстовыйПарсер_ПолучитьОператорыУправленияЦиклом(ТекстовыйПарсер, Подпрограмма, ОператорЦикла)
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	тЛогическийБлок = ТипыСловИОператоров.ЛогическийБлок;
	тИдентификатор =  ТипыСловИОператоров.Идентификатор;
	
	ОператорТелоЦикла = ОператорЦикла.ДополнительныеДанные.Тело;
	
	ОператорыУправления = Новый Структура;
	ОператорыУправления.Вставить("ОператорыПродолжить", Новый Массив);
	ОператорыУправления.Вставить("ОператорыПрервать", Новый Массив);
	
	ОбходОператоров = Новый Массив;
	РК.ДобавитьЭлементыКоллекции(ОбходОператоров, ОператорТелоЦикла.Операторы);
	Для Каждого Оператор Из ОбходОператоров Цикл
		
		Если Оператор.ТипОператора=тЛогическийБлок Тогда
			
			Если Оператор.ДополнительныеДанные.ЭтоЦикл Тогда
				// Не искать во вложенных циклах, так
				// как это будут операторы управления другим циклом
				Продолжить;
			КонецЕсли;
			
			РК.ДобавитьЭлементыКоллекции(ОбходОператоров, Оператор.ДополнительныеДанные.Тело.Операторы);
			
		ИначеЕсли Оператор.ТипОператора=тИдентификатор Тогда
			
			КодОператора = ВРЕГ(Оператор.Код);
			Если КодОператора="ПРОДОЛЖИТЬ" Тогда
				ОператорыУправления.ОператорыПродолжить.Добавить(Оператор);
			ИначеЕсли КодОператора="ПРЕРВАТЬ" Тогда
				ОператорыУправления.ОператорыПрервать.Добавить(Оператор);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОператорыУправления;
	
КонецФункции

Функция ТекстовыйПарсер_ЗаменитьИдентификаторыПодпрограммы(ТекстовыйПарсер, Подпрограмма, ЗаменаИдентификаторов, ВызовыПодпрограмм) Экспорт
	
	Перем РК;
	
	ПреобразованныеОператоры = Подпрограмма.ДополнительныеДанные.ПреобразованныеОператоры;
	ПреобразованныеОператоры.Очистить();

	ТелоПодпрограммы = Подпрограмма.ДополнительныеДанные.Тело;
	Если ТелоПодпрограммы=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	тВызовПодпрограммы = ТипыСловИОператоров.ВызовПодпрограммы;
	тВызовМетода = ТипыСловИОператоров.ВызовМетода;
	тПоле = ТипыСловИОператоров.Поле;
	тСпецсимвол = ТипыСловИОператоров.Спецсимвол;
	
	слТочка = Слово(тСпецсимвол, ".");
	
	ОбходОператоров = Новый Массив;
	ОбходОператоров.Добавить(ТелоПодпрограммы);
	
	Для Каждого ЗаменаИдентификатора Из ЗаменаИдентификаторов Цикл
		Идентификатор = ЗаменаИдентификатора.Значение;
		ИдентификаторМассив = РК.ЗначениеВМассив(Идентификатор, ".", Ложь);
		ЗаменаИдентификаторов[ЗаменаИдентификатора.Ключ] = ИдентификаторМассив;
	КонецЦикла;
	
	Для Каждого Оператор Из ОбходОператоров Цикл
		
		Если Оператор.Операторы.Количество()=0 Тогда
			
			Если Оператор.ТипОператора=тИдентификатор И Оператор.ПространствоИмен=Неопределено
				И ВызовыПодпрограмм=(Оператор.Родитель.ТипОператора=тВызовПодпрограммы) Тогда
				НовыйИдентификаторМассив = ЗаменаИдентификаторов[ВРЕГ(Оператор.Код)];
				
				Если НовыйИдентификаторМассив <> Неопределено Тогда
					
					ИндексПоследнегоИдентификатора = НовыйИдентификаторМассив.ВГраница();
					Оператор.Код = НовыйИдентификаторМассив[ИндексПоследнегоИдентификатора];
					
					Если ИндексПоследнегоИдентификатора>0 Тогда
						НомерИдентификатора = ИндексПоследнегоИдентификатора;
						ОператорПравый = Оператор;
						
						Если ОператорПравый.Родитель.ТипОператора=тВызовПодпрограммы Тогда
							НомерИдентификатора = НомерИдентификатора - 1;
							ОператорГруппа = ОператорПравый.Родитель;
							Если ОператорГруппа.ТипОператора=тВызовПодпрограммы Тогда
								ОператорГруппа.ТипОператора = тВызовМетода;
							КонецЕсли;
							слЛевое = Слово(тИдентификатор, НовыйИдентификаторМассив[НомерИдентификатора]);
							ОператорЛевый = НовыйОператор(ТекстовыйПарсер, ОператорГруппа, слЛевое, 0);
							НовыйОператор(ТекстовыйПарсер, ОператорГруппа, слТочка, 1);
							ОператорПравый.ПространствоИмен = ОператорЛевый;

							ОператорПравый = ОператорЛевый;
						КонецЕсли;
						
						Пока НомерИдентификатора>0 Цикл
							НомерИдентификатора = НомерИдентификатора - 1;
							слЛевое = Слово(тИдентификатор, НовыйИдентификаторМассив[НомерИдентификатора]);
							ОператорГруппа = НовыйОператор(ТекстовыйПарсер, , , ОператорПравый);
							ОператорГруппа.ТипОператора = тПоле;
							ОператорГруппа.ЛевоеЗначение = ОператорПравый.ЛевоеЗначение;
							ОператорЛевый = НовыйОператор(ТекстовыйПарсер, ОператорГруппа, слЛевое);
							НовыйОператор(ТекстовыйПарсер, ОператорГруппа, слТочка);
							ПоместитьОператор(ТекстовыйПарсер, ОператорГруппа, ОператорПравый);
							ОператорПравый.ПространствоИмен = ОператорЛевый;
							
							ОператорПравый = ОператорЛевый;
						КонецЦикла;
						
						ПреобразованныеОператоры.Добавить(Оператор.Родитель);
					Иначе
						ПреобразованныеОператоры.Добавить(Оператор);
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			Для Каждого СубОператор Из Оператор.Операторы Цикл
				
				ОбходОператоров.Добавить(СубОператор);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

//
// } Разбор операторов подпрограмм

//
// { Формирование кода операторов

Функция ТекстовыйПарсер_СформироватьКодМодуля(ТекстовыйПарсер) Экспорт
	
	ТекстовыйПарсер_СформироватьКодОператора(ТекстовыйПарсер, ТекстовыйПарсер.ГлобальнаяОбласть);
	ТекстМодуля = ТекстовыйПарсер.ГлобальнаяОбласть.Код;
	
	ТекстовыйПарсер.СформированныйТекст = ТекстМодуля;
	
	Возврат ТекстМодуля;
	
КонецФункции

Функция ТекстовыйПарсер_СформироватьКодОператора(ТекстовыйПарсер, ОператорГруппа)
	
	// Получить полный список операторов вместе с вложенными,
	// причем сначала идут вложенные, потом родительские операторы
	// так, как код родительских операторов формируется на основе вложенных
	Операторы = ПолучитьВсеОператоры(ОператорГруппа, Ложь, Истина);
	
	// формирование кода каждого оператора
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	Для Каждого Оператор Из Операторы Цикл
		
		Если Оператор.ТипОператора=ТипыСловИОператоров.Идентификатор ИЛИ Оператор.ТипОператора=ТипыСловИОператоров.Поле ИЛИ Оператор.ТипОператора=ТипыСловИОператоров.ВызовПодпрограммы ИЛИ Оператор.ТипОператора=ТипыСловИОператоров.ВызовМетода Тогда
			ТекстовыйПарсер_СформироватьКодОператораИдентификатор(ТекстовыйПарсер, Оператор);
		ИначеЕсли Оператор.ТипОператора=ТипыСловИОператоров.Число Тогда
			ТекстовыйПарсер_СформироватьКодОператораЧисло(ТекстовыйПарсер, Оператор);
		ИначеЕсли Оператор.ТипОператора=ТипыСловИОператоров.ЛогическийБлок ИЛИ Оператор.ТипОператора=ТипыСловИОператоров.ЛогическийБлокПрепроцессора ИЛИ Оператор.ТипОператора=ТипыСловИОператоров.Подпрограмма Тогда
			ТекстовыйПарсер_СформироватьКодОператораЛогическиБлок(ТекстовыйПарсер, Оператор);
		ИначеЕсли Оператор.ТипОператора=ТипыСловИОператоров.ПараметрыВызоваПодпрограммы Тогда
			ТекстовыйПарсер_СформироватьКодОператораПараметрыВызоваПодпрограммы(ТекстовыйПарсер, Оператор);
		Иначе
			ТекстовыйПарсер_СформироватьКодОператораОбщий(ТекстовыйПарсер, Оператор);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ТекстовыйПарсер_СформироватьКодОператораПараметрыВызоваПодпрограммы(ТекстовыйПарсер, ОператорГруппа)

	Операторы = ОператорГруппа.Операторы;
	
	Код = "";
	
	Если Операторы.Количество() > 0 Тогда
		Разделитель = ", ";
		Для Каждого Оператор Из Операторы Цикл
			Код = Код + Оператор.Код + Разделитель;
		КонецЦикла;
		Код = Лев(Код, СтрДлина(Код)-СтрДлина(Разделитель));
	КонецЕсли;
	
	ОператорГруппа.Код = Код;
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_СформироватьКодОператораИдентификатор(ТекстовыйПарсер, ОператорГруппа)

	Операторы = ОператорГруппа.Операторы;
	Если Операторы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	// код лепим сплошняком без пробелов и отступов
	Код = "";
	Для Каждого Оператор Из Операторы Цикл
		Код = Код + Оператор.Код;
	КонецЦикла;
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	ОператорГруппа.Код = Код;
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_СформироватьКодОператораЧисло(ТекстовыйПарсер, ОператорГруппа)

	Операторы = ОператорГруппа.Операторы;
	Если Операторы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	// код лепим сплошняком без пробелов и отступов
	Код = "";
	Для Каждого Оператор Из Операторы Цикл
		Код = Код + Оператор.Код;
	КонецЦикла;
	
	ОператорГруппа.Код = Код;
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_СформироватьКодОператораЛогическиБлок(ТекстовыйПарсер, ОператорГруппа)
	
	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	Операторы = ОператорГруппа.Операторы;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	ПереводСтроки = ТекстовыйПарсер.ПереводСтроки;
	Пробел = ТекстовыйПарсер.Пробел;
	
	ПоследнийОператор = Операторы.Количество()-1;
	
	Код = "";
	ПредыдущийОператор = Неопределено;
	Для НомерОператора=0 По ПоследнийОператор Цикл
		Оператор = Операторы[НомерОператора]; 
		Если Оператор.ТипОператора = ТипыСловИОператоров.ТелоЛогическогоБлока Тогда
			Код = Код + ПереводСтроки + РаботаСКоллекциями.ДобавитьОтступСтрок(Оператор.Код);
			НомерОператора = НомерОператора + 1;
			Прервать;
		Иначе
			Если ПредыдущийОператор <> Неопределено И ПредыдущийОператор.ТипОператора = ТипыСловИОператоров.Спецсимвол И ПредыдущийОператор.Код = "#" Тогда
				Код = Код + Оператор.Код;
			Иначе
				Код = Код + Пробел + Оператор.Код;
			КонецЕсли;
		КонецЕсли;
		ПредыдущийОператор = Оператор;
	КонецЦикла;
	Код = СокрЛ(Код);
	
	// должен остаться конец блока, его добавляем с новой строки
	Если НомерОператора <= ПоследнийОператор Тогда
		Код = Код + ПереводСтроки;
		Для НомерОператора=НомерОператора По ПоследнийОператор Цикл
			Оператор = Операторы[НомерОператора]; 
			Код = Код + Оператор.Код;
		КонецЦикла;
	КонецЕсли;
	
	ОператорГруппа.Код = Код;
	Возврат Истина;

КонецФункции

Функция ТекстовыйПарсер_СформироватьКодСтроки(ТекстовыйПарсер, Строка)
	
	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	Кавычка = ТекстовыйПарсер.Кавычка;
	
	Строки = РаботаСКоллекциями.СтрокуВМассив(Строка, Символы.ПС, Ложь, Истина);
	
	СимволыПереносаСтроки = Символы.ПС + "|";
	НоваяСтрока = Строки[0];
	Для НомерСтроки=1 По Строки.ВГраница() Цикл
		НоваяСтрока = НоваяСтрока + СимволыПереносаСтроки + Строки[НомерСтроки];
	КонецЦикла;
	
	НоваяСтрока = СтрЗаменить(НоваяСтрока, Кавычка, Кавычка+Кавычка);
	
	Возврат НоваяСтрока;
	
КонецФункции

Функция ТекстовыйПарсер_СформироватьКодОператораОбщий(ТекстовыйПарсер, ОператорГруппа)
	
	Перем РаботаСКоллекциями;
	
	Операторы = ОператорГруппа.Операторы;

	Если Операторы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	РаботаСКоллекциями = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	тЛогическийБлок = ТипыСловИОператоров.ЛогическийБлок;
	тПодпрограмма = ТипыСловИОператоров.Подпрограмма;
	
	ПереводСтроки = ТекстовыйПарсер.ПереводСтроки;
	Пробел = ТекстовыйПарсер.Пробел;
	Кавычка = ТекстовыйПарсер.Кавычка;
	ОписанияСкобок = ТекстовыйПарсер.ОписанияСкобок;
	ОператорыСравнения = ТекстовыйПарсер.ОператорыСравнения;
	
	Код = "";
	КодСтроки = "";
	ЭтоОткрывающаяСкобка = Ложь;
	ЭтоЗакрывающаяСкобка = Ложь;
	ЭтоСпецСимвол = Ложь;
	ЭтоОператорСравнения = Ложь;
	ПредыдущийТипОператора = Неопределено;
	
	Для Каждого Оператор Из Операторы Цикл
		
		КодОператора = Оператор.Код;
		ТипОператора = Оператор.ТипОператора;
		
		ПредыдущийОператорЭтоСпецсимвол = ЭтоСпецСимвол;
		ПредыдущийОператорЭтоОператорСравнения = ЭтоОператорСравнения;
		ЭтоСпецСимвол = ТипОператора=ТипыСловИОператоров.СпецСимвол;
		ЭтоОператорСравнения = ЭтоСпецСимвол И ОператорыСравнения[КодОператора]=Истина;
		
		ПредыдущийОператорЭтоОткрывающаяСкобка = ЭтоОткрывающаяСкобка;
		ПредыдущийОператорЭтоЗакрывающаяСкобка = ЭтоЗакрывающаяСкобка;
		ЭтоОткрывающаяСкобка = ЭтоСпецСимвол И ОписанияСкобок.ЛевыеСкобки[КодОператора] <> Неопределено;
		ЭтоЗакрывающаяСкобка = ЭтоСпецСимвол И ОписанияСкобок.ПравыеСкобки[КодОператора] <> Неопределено;
		ЭтоРазделитель = ЭтоСпецСимвол И КодОператора = ";";
		ЭтоЛогическийБлок = ТипОператора=тЛогическийБлок ИЛИ ТипОператора=тПодпрограмма;
		ЭтоЛогическийБлокПрепроцессора = ТипОператора = ТипыСловИОператоров.ЛогическийБлокПрепроцессора;
		ЭтоЗапятая = ЭтоСпецСимвол И КодОператора = ",";
		
		Если ЭтоЗакрывающаяСкобка Тогда
			КодСтроки = КодСтроки + КодОператора;
		ИначеЕсли ЭтоЛогическийБлок ИЛИ ЭтоЛогическийБлокПрепроцессора Тогда
			Если КодСтроки<>"" Тогда
				// блок с новой строки
				Код = Код + ПереводСтроки + СокрЛП(КодСтроки);
			КонецЕсли;
			КодСтроки = КодОператора;
		ИначеЕсли ЭтоРазделитель Тогда
			КодСтроки = КодСтроки + КодОператора;
			Код = Код + ПереводСтроки + СокрЛП(КодСтроки);
			КодСтроки = "";
		ИначеЕсли ЭтоЗапятая Тогда
			КодСтроки = КодСтроки + КодОператора;
		Иначе
			Если ТипОператора=тИдентификатор И ТипОператора=ПредыдущийТипОператора Тогда
				КодСтроки = КодСтроки + Пробел;
			ИначеЕсли Не ПредыдущийОператорЭтоОткрывающаяСкобка И НЕ (ЭтоОператорСравнения И ПредыдущийОператорЭтоОператорСравнения) Тогда
				КодСтроки = КодСтроки + Пробел;
			КонецЕсли;
			
			Если ТипОператора = ТипыСловИОператоров.Строка Тогда
				КодСтроки = КодСтроки + Кавычка + ТекстовыйПарсер_СформироватьКодСтроки(ТекстовыйПарсер, КодОператора) + Кавычка;
			Иначе
				КодСтроки = КодСтроки + КодОператора;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоЛогическийБлокПрепроцессора Тогда
			// после блока препроцессора сделать перевод строки
			Код = Код + ПереводСтроки + СокрЛП(КодСтроки);
			КодСтроки = "";
		КонецЕсли;
		
		ПредыдущийТипОператора = ТипОператора;
		
	КонецЦикла;
	
	Если КодСтроки <> "" Тогда
		Код = Код + ПереводСтроки + СокрЛП(КодСтроки);
	КонецЕсли;
	
	Код = СокрЛП(Код);
	
	ОператорГруппа.Код = Код;
	
	Возврат Истина;
	
КонецФункции

//
// } Формирование кода операторов

//
// { Разбор слов

Функция ТекстовыйПарсер_РазобратьСловаСтарая(ТекстовыйПарсер) Экспорт

	Слова = ТекстовыйПарсер.Слова;
	Слова.Очистить();
	
	Пока ТекстовыйПарсер_РазобратьСлово(ТекстовыйПарсер) Цикл
		Слова.Добавить(ТекстовыйПарсер.ТекущееСлово);
	КонецЦикла;
	
	ТекстовыйПарсер.КоличествоСлов = Слова.Количество();
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьСлова(ТекстовыйПарсер) Экспорт
	
	ПустаяСтрока = "";
	Кавычка = """";
	Пробел = " ";
	Слэш = "/";
	ПереносСтроки = "|";
	
	Цифры = ТекстовыйПарсер.ЦифрыСоответствие;
	ТипыСлов = ТекстовыйПарсер.ТипыСловИОператоров;
	СимволыИдентификаторов = ТекстовыйПарсер.ДопустимыеСимволыИдентификаторовСоответствие;
	
	ПустыеСимволы = Новый Соответствие;
	ПустыеСимволы[Пробел] = Истина;
	ПустыеСимволы[Символы.Таб] = Истина;
	
	ТекстовыйПарсер.НомерСимвола = 1;
	ТекстовыйПарсер.НомерСтроки = 0;
	ТекстовыйПарсер.ДлинаСтроки = 0;
	
	Слова = ТекстовыйПарсер.Слова;
	Слова.Очистить();
	
	Пока Истина Цикл
		
		Если ТекстовыйПарсер.НомерСимвола>ТекстовыйПарсер.ДлинаСтроки Тогда
			Если Не ТекстовыйПарсер_ПолучитьСтроку(ТекстовыйПарсер) Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;

		Символ = Сред(ТекстовыйПарсер.Строка, ТекстовыйПарсер.НомерСимвола, 1);
		ТекстовыйПарсер.НомерСимвола = ТекстовыйПарсер.НомерСимвола + 1;
		
		Если ПустыеСимволы[Символ]=Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если Символ=Слэш Тогда
			СледующийСимвол = Сред(ТекстовыйПарсер.Строка, ТекстовыйПарсер.НомерСимвола, 1);
			Если СледующийСимвол=Слэш Тогда
				// комментарий строки, прыгаем в конец строки
				ТекстовыйПарсер.НомерСимвола = ТекстовыйПарсер.ДлинаСтроки + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Символ=Кавычка Тогда
			
			//строка
			ТекстСлова = ПустаяСтрока;
			Пока Истина Цикл
				
				Если ТекстовыйПарсер.НомерСимвола>ТекстовыйПарсер.ДлинаСтроки Тогда
					Если Не ТекстовыйПарсер_ПолучитьСтроку(ТекстовыйПарсер) Тогда
						// не прочитана кавычка
						ВызватьИсключение "Обнаружена незавершенная строка";
					КонецЕсли;
					
					// новая строка, обработать перенос строки
					Пока Истина Цикл
						Символ = Сред(ТекстовыйПарсер.Строка, ТекстовыйПарсер.НомерСимвола, 1);
						ТекстовыйПарсер.НомерСимвола = ТекстовыйПарсер.НомерСимвола + 1;
						Если Символ=ПереносСтроки Тогда
							ТекстСлова = ТекстСлова + Символы.ПС;
							Прервать;
						ИначеЕсли ПустыеСимволы[Символ]=Истина Тогда
							
						Иначе
							ВызватьИсключение "Обнаружена незавершенная строка";
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;

				Символ = Сред(ТекстовыйПарсер.Строка, ТекстовыйПарсер.НомерСимвола, 1);
				ТекстовыйПарсер.НомерСимвола = ТекстовыйПарсер.НомерСимвола + 1;
				
				Если Символ=Кавычка Тогда
					СледующийСимвол = Сред(ТекстовыйПарсер.Строка, ТекстовыйПарсер.НомерСимвола, 1);
					Если СледующийСимвол=Кавычка Тогда
						// символ "кавычка"
						ТекстовыйПарсер.НомерСимвола = ТекстовыйПарсер.НомерСимвола + 1;
					Иначе
						// конец строки
						Слова.Добавить(Новый Структура("Слово, ТипСлова, НомерСтроки, ВРСлово", ТекстСлова, ТипыСлов.Строка, ТекстовыйПарсер.НомерСтроки, ВРЕГ(ТекстСлова)));
						Прервать;
					КонецЕсли;
				КонецЕсли;
				
				ТекстСлова = ТекстСлова + Символ;
				
			КонецЦикла;
			
		ИначеЕсли СимволыИдентификаторов[Символ]=Истина Тогда

			ТекстСлова = Символ;
			
			Если Цифры[Символ]=Истина Тогда
				ТипСлова = ТипыСлов.Число;
			Иначе
				ТипСлова = ТипыСлов.Идентификатор;
			КонецЕсли;
			
			Пока Истина Цикл
				
				Если ТекстовыйПарсер.НомерСимвола>ТекстовыйПарсер.ДлинаСтроки Тогда
					// конец строки
					Символ = Неопределено;
				Иначе
					Символ = Сред(ТекстовыйПарсер.Строка, ТекстовыйПарсер.НомерСимвола, 1);
				КонецЕсли;
				
				Если НЕ СимволыИдентификаторов[Символ]=Истина Тогда
					// конец идентификатора
					Слова.Добавить(Новый Структура("Слово, ТипСлова, НомерСтроки, ВРСлово", ТекстСлова, ТипСлова, ТекстовыйПарсер.НомерСтроки, ВРЕГ(ТекстСлова)));
					Прервать;
				КонецЕсли;

				ТекстСлова = ТекстСлова + Символ;
				ТекстовыйПарсер.НомерСимвола = ТекстовыйПарсер.НомерСимвола + 1;
				
			КонецЦикла;
			
		Иначе
			
			ТекстСлова = Символ;
			Слова.Добавить(Новый Структура("Слово, ТипСлова, НомерСтроки, ВРСлово", ТекстСлова, ТипыСлов.СпецСимвол, ТекстовыйПарсер.НомерСтроки, ВРЕГ(ТекстСлова)));
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстовыйПарсер.КоличествоСлов = Слова.Количество();
	
КонецФункции

Функция ТекстовыйПарсер_ПолучитьСтроку(ТекстовыйПарсер) Экспорт

	Если ТекстовыйПарсер.ЧтениеТекста = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Пока Истина Цикл
		Строка = ТекстовыйПарсер.ЧтениеТекста.ПрочитатьСтроку();
		Если Строка = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Строка = СокрП(Строка);
		ДлинаСтроки = СтрДлина(Строка);
		Если ДлинаСтроки=0 Тогда
			ТекстовыйПарсер.НомерСтроки = ТекстовыйПарсер.НомерСтроки + 1;
			Продолжить;
		КонецЕсли;
		
		ТекстовыйПарсер.Строка = Строка;
		ТекстовыйПарсер.НомерСимвола = 1;
		ТекстовыйПарсер.НомерСтроки = ТекстовыйПарсер.НомерСтроки + 1;
		ТекстовыйПарсер.ДлинаСтроки = ДлинаСтроки;
		Прервать;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьСлово(ТекстовыйПарсер) Экспорт
	
	СимволыИдентификаторов = ТекстовыйПарсер.ДопустимыеСимволыИдентификаторовСоответствие;
	Цифры = ТекстовыйПарсер.ЦифрыСоответствие;
	ТипыСлов = ТекстовыйПарсер.ТипыСловИОператоров;
	
	ПустаяСтрока = "";
	Слово = ПустаяСтрока;
	Кавычка = """";
	Пробел = " ";
	Слэш = "/";
	Строка = ТекстовыйПарсер.Строка;
	НомерСтроки = ТекстовыйПарсер.НомерСтроки;

	Литер = 0;
	ТипСлова = 0;
	Пока Истина Цикл
			
		Если Строка = Неопределено Тогда
			Если ТекстовыйПарсер.ЧтениеТекста = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Строка = ТекстовыйПарсер.ЧтениеТекста.ПрочитатьСтроку();
			Если Строка = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			Строка = СокрП(Строка);
			НомерСтроки = НомерСтроки + 1;
		КонецЕсли;

		НомерСлэша = 0;
		Идентификатор = Ложь;
		Строка = СокрЛ(Строка);
		ДлинаСтроки = СтрДлина(Строка);
		Для НомерСимвола=1 По ДлинаСтроки Цикл
			
			Символ = Сред(Строка, НомерСимвола, 1);
			
			// Обработать кавычки
			Если ТипСлова = 0 ИЛИ ТипСлова = ТипыСлов.Строка Тогда
				Если Символ = Кавычка Тогда
					ТипСлова = ТипыСлов.Строка;
					Если Литер = 2 Тогда
						// двойная кавычка
						Слово = Слово + Кавычка;
						Литер = 1;
					Иначе
						Литер = Литер + 1;
					КонецЕсли;
					Продолжить;
				Иначе
					Если Литер > 0 Тогда
						Если Литер = 2 Тогда
							// конец строки
							Прервать;
						КонецЕсли;
						
						Если Символ = "|" Тогда
							// символ переноса строки
							Слово = Слово + Символы.ПС;
						Иначе
							// слово в кавычках
							Слово = Слово + Символ;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			// Обработать слэши
			Если ТипСлова = 0 ИЛИ ТипСлова = ТипыСлов.Спецсимвол Тогда
				Если Символ = Слэш Тогда
					НомерСлэша = НомерСлэша + 1;
					Если НомерСлэша = 2 Тогда
						// двойной слэш
						Прервать; //чтение строки
					КонецЕсли;
					Продолжить;
				Иначе
					Если НомерСлэша = 1 Тогда
						// одинарный слэш
						Слово = Слово + Слэш;
						ТипСлова = ТипыСлов.Спецсимвол;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
				
			//Идентификатор
			Если ТипСлова = 0 ИЛИ ТипСлова = ТипыСлов.Идентификатор Тогда
				
				Если СимволыИдентификаторов[Символ] = Истина Тогда
					Слово = Слово + Символ;
					ТипСлова = ТипыСлов.Идентификатор;
				Иначе
					Если ТипСлова = ТипыСлов.Идентификатор Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			// спец. символ
			Если ТипСлова = 0 Тогда
				Если Символ <> Пробел Тогда
					Слово = Слово + Символ;
					ТипСлова = ТипыСлов.Спецсимвол;
					НомерСимвола = НомерСимвола + 1;
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НомерСлэша = 2 Тогда
			// строка закоментированна
			Строка = Неопределено
		ИначеЕсли НомерСимвола > ДлинаСтроки Тогда
			Строка = Неопределено;
		Иначе
			Строка = Прав(Строка, ДлинаСтроки - НомерСимвола + 1);
		КонецЕсли;
		
		Если ТипСлова = ТипыСлов.Строка Тогда
			Если Литер = 2 Тогда
				// строка закрылась кавычкой
				Прервать;
			Иначе
				// мультистрока, продолжение следует
			КонецЕсли;
		ИначеЕсли Слово <> ПустаяСтрока Тогда
			Прервать;
		Иначе
			ТипСлова = 0;
		КонецЕсли;
		
		
	КонецЦикла;
	
	Если ТипСлова = ТипыСлов.Идентификатор Тогда
		Если Цифры[Лев(Слово, 1)] = Истина Тогда
			// цифровая константа
			ТипСлова = ТипыСлов.Число;
		КонецЕсли;
	КонецЕсли;
	
	ТекстовыйПарсер.ТекущееСлово = Новый Структура("Слово, ТипСлова, НомерСтроки, ВРСлово", Слово, ТипСлова, НомерСтроки, ВРЕГ(Слово));
	
	ТекстовыйПарсер.Строка = Строка;
	ТекстовыйПарсер.НомерСтроки = НомерСтроки;
	Возврат Истина;
	
КонецФункции

Функция Слово(ТипСлова=Неопределено, Слово="")
	
	СтруктураСлова = Новый Структура("ТипСлова, Слово, НомерСтроки", ТипСлова, Слово);
	
	Возврат СтруктураСлова;
	
КонецФункции

Функция СледующееСлово(ТекстовыйПарсер)
	
	Возврат УстановитьТекущееСлово(ТекстовыйПарсер, ТекстовыйПарсер.НомерТекущегоСлова + 1);
	
КонецФункции

Функция ПредыдущееСлово(ТекстовыйПарсер)

	Возврат УстановитьТекущееСлово(ТекстовыйПарсер, ТекстовыйПарсер.НомерТекущегоСлова - 1);
	
КонецФункции

Функция УстановитьТекущееСлово(ТекстовыйПарсер, НомерСлова)

	Если НомерСлова < 0 ИЛИ НомерСлова >= ТекстовыйПарсер.КоличествоСлов Тогда
		ТекстовыйПарсер.ТекущееСлово = ТекстовыйПарсер.ПустоеСлово;
	Иначе
		ТекстовыйПарсер.ТекущееСлово = ТекстовыйПарсер.Слова[НомерСлова];
	КонецЕсли;

	ТекстовыйПарсер.НомерТекущегоСлова = НомерСлова;
	
	Возврат ТекстовыйПарсер.ТекущееСлово;
	
КонецФункции

Функция УдалитьСлова(ТекстовыйПарсер, ИндексСлова, знач ИндексСловаДо=Неопределено)
	
	Если ИндексСловаДо=Неопределено Тогда
		ИндексСловаДо = ТекстовыйПарсер.НомерТекущегоСлова;
	КонецЕсли;
	
	Если ИндексСловаДо <= ИндексСлова Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КоличествоСловУдалить = ИндексСловаДо-ИндексСлова;
	
	Слова = ТекстовыйПарсер.Слова;
	
	Для НомерСловаУдалить=1 По КоличествоСловУдалить Цикл
		Слова.Удалить(ИндексСлова);
	КонецЦикла;
	
	Если ТекстовыйПарсер.НомерТекущегоСлова>=ИндексСлова Тогда
		Если ТекстовыйПарсер.НомерТекущегоСлова<ИндексСловаДо Тогда
			УстановитьТекущееСлово(ТекстовыйПарсер, ИндексСлова);
		Иначе
			ТекстовыйПарсер.НомерТекущегоСлова = ТекстовыйПарсер.НомерТекущегоСлова - КоличествоСловУдалить;
		КонецЕсли;
	КонецЕсли;
	
	ТекстовыйПарсер.КоличествоСлов = ТекстовыйПарсер.КоличествоСлов - КоличествоСловУдалить;
	Возврат Истина;
	
КонецФункции

