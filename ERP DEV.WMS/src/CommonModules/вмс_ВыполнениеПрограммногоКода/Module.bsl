Функция ДобавитьВызовПодпрограммыВСтек(Объект, ТипОбъекта, ИмяМетода, ПроцессорКода, Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162)
	
	ПараметрыМассив = Новый Массив;
	ПараметрыМассив.Добавить(Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162);
	ПараметрыМассив.Добавить(Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162);
	ПараметрыМассив.Добавить(Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162);
	ПараметрыМассив.Добавить(Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162);
	ПараметрыМассив.Добавить(Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162);
	ПараметрыМассив.Добавить(Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162);
	ПараметрыМассив.Добавить(Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162);
	ПараметрыМассив.Добавить(Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162);
	
	КоличествоПереданныхПараметров = ПараметрыМассив.Количество();
	Пока КоличествоПереданныхПараметров > 0 Цикл
		Если ПараметрыМассив[КоличествоПереданныхПараметров-1]<>"ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162" Тогда
			Прервать;
		КонецЕсли;
		КоличествоПереданныхПараметров = КоличествоПереданныхПараметров - 1;
	КонецЦикла;
	
	КадрСтека = Новый Структура;
	КадрСтека.Вставить("Объект", Объект);
	КадрСтека.Вставить("ТипОбъекта", ТипОбъекта);
	КадрСтека.Вставить("ИмяМетода", ИмяМетода);
	КадрСтека.Вставить("Параметр1", Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162);
	КадрСтека.Вставить("Параметр2", Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162);
	КадрСтека.Вставить("Параметр3", Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162);
	КадрСтека.Вставить("Параметр4", Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162);
	КадрСтека.Вставить("Параметр5", Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162);
	КадрСтека.Вставить("Параметр6", Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162);
	КадрСтека.Вставить("Параметр7", Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162);
	КадрСтека.Вставить("Параметр8", Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162);
	КадрСтека.Вставить("КоличествоПереданныхПараметров", КоличествоПереданныхПараметров);
	ПроцессорКода.СтекВызововПодпрограмм.Добавить(КадрСтека);
	Возврат КадрСтека;
	
КонецФункции

Функция ПолучитьВызовПодпрограммыИзСтека(Номер=0, ПроцессорКода)

	СтекВызовов = ПроцессорКода.СтекВызововПодпрограмм;
	Если Номер>СтекВызовов.Количество()-1 Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	КадрСтека = СтекВызовов[СтекВызовов.Количество()-1-Номер];
	
	Возврат КадрСтека;
	
КонецФункции

Функция УдалитьВызовПодпрограммыИзСтека(ПроцессорКода)

	СтекВызовов = ПроцессорКода.СтекВызововПодпрограмм;
	СтекВызовов.Удалить(СтекВызовов.ВГраница());
	
КонецФункции

Функция ПолучитьИтераторКоллекции(Коллекция, ПроцессорКода)

	ИтераторКоллекции = ВызовПодпрограммы(Коллекция, Неопределено, "ИТЕРАТОРКОЛЛЕКЦИИ", ПроцессорКода);
	
	Если ПроцессорКода.ДанныеВыполненияМетода.ВыполнитьНативныйМетод Тогда
		
		ИтераторКоллекции = ПроцессорКода.ДанныеВыполненияМетода.НативныйОбъект;
		
	КонецЕсли;
	
	Возврат ИтераторКоллекции;

КонецФункции

Функция ПереопределениеСозданияНовогоОбъекта(знач ТипОбъекта, ПроцессорКода, знач Параметр1=null, знач Параметр2=null, знач Параметр3=null, знач Параметр4=null) Экспорт
	
	Если ТипОбъекта=Неопределено Тогда
		ТипОбъекта = ВРЕГ(Параметр1);
		ПараметрыСоздания = Параметр2;
	Иначе
		ПараметрыСоздания = Новый Массив;
		ПараметрыСоздания.Добавить(Параметр1);
		ПараметрыСоздания.Добавить(Параметр2);
		ПараметрыСоздания.Добавить(Параметр3);
		ПараметрыСоздания.Добавить(Параметр4);
		НомерЭлемента = ПараметрыСоздания.Количество();
		Пока НомерЭлемента>0 Цикл
			НомерЭлемента = НомерЭлемента - 1;
			Если ПараметрыСоздания.Получить(НомерЭлемента)<>null Тогда
				Прервать;
			КонецЕсли;
			ПараметрыСоздания.Удалить(НомерЭлемента);
		КонецЦикла;
	КонецЕсли;

	ТипОбъекта = ВРЕГ(ТипОбъекта);
	НовыйОбъект = вмс_КлассныеОбъекты.НовыйОбъект(ТипОбъекта, , ПроцессорКода);
	Если НовыйОбъект<>Неопределено Тогда
		Возврат НовыйОбъект;
	КонецЕсли;
	
	Если ТипОбъекта="ОПИСАНИЕОПОВЕЩЕНИЯ" Тогда
		
		СОО = ПереопределениеСозданияНовогоОписанияОповещения(ПараметрыСоздания, ПроцессорКода);
		
		Если СОО<>Неопределено Тогда
			Возврат СОО;
		КонецЕсли;
			
	КонецЕсли;
	
	// стандартное создание объекта
	НовыйОбъект = Новый(ТипОбъекта, ПараметрыСоздания);
	Возврат НовыйОбъект;
	
КонецФункции

Функция ПереопределениеСозданияНовогоОписанияОповещения(ПараметрыСоздания, ПроцессорКода)

	Модуль = ПараметрыСоздания[1];
	КлассныйОбъектМодуля = вмс_КлассныеОбъекты.ПолучитьКлассныйОбъект(Модуль, ПроцессорКода);
	Если КлассныйОбъектМодуля=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяОбработчика = ВРег(ПараметрыСоздания[0]);
		
	ДанныеКласса = ПроцессорКода.ТекущиеДанныеДляВыполненияКода.ДанныеКлассов[КлассныйОбъектМодуля.ИмяКласса];
	ОписаниеПодпрограммы = ДанныеКласса.ОписанияПодпрограмм[ИмяОбработчика];
	Если ОписаниеПодпрограммы=Неопределено Тогда
		ВызватьИсключение "Обработчик оповещения """ + КлассныйОбъектМодуля.ИмяКласса + "." + ИмяОбработчика + """ не обнаружен!";
	КонецЕсли;
	
	Если ОписаниеПодпрограммы.КоличествоПараметров=1 Тогда
		ИмяСервисногоОбработчикаОповещения = "ОбработчикОповещенияСОднимПараметром";
	Иначе
		ИмяСервисногоОбработчикаОповещения = "ОбработчикОповещенияСДвумяПараметрами";
	КонецЕсли;
	
	Если ТипЗнч(Модуль)=Тип("ФормаКлиентскогоПриложения") И Модуль.ИмяФормы="ОбщаяФорма.вмс_ФормаШаблон" Тогда
		// Для пущей натуральности интерпретации кода укажем обработчик на шаблонной форме,
		// коли есть такая возможность
		МодульСОО = Модуль;
	Иначе
		// в общем случае используем текущий модуль
		МодульСОО = вмс_ВыполнениеПрограммногоКода;
	КонецЕсли;
		
	ДополнительныеПараметрыСОО = Новый Структура;
	ДополнительныеПараметрыСОО.Вставить("ИмяОбработчика", ИмяОбработчика);
	ДополнительныеПараметрыСОО.Вставить("Модуль", Модуль);
	ДополнительныеПараметрыСОО.Вставить("ИмяКласса", КлассныйОбъектМодуля.ИмяКласса);
	ДополнительныеПараметрыСОО.Вставить("ДополнительныеПараметры", ПараметрыСоздания[2]);
	ДополнительныеПараметрыСОО.Вставить("ПроцессорКода", ПроцессорКода);

	ПараметрыСозданияСОО = Новый Массив;
	ПараметрыСозданияСОО.Добавить(ИмяСервисногоОбработчикаОповещения);
	ПараметрыСозданияСОО.Добавить(МодульСОО);
	ПараметрыСозданияСОО.Добавить(ДополнительныеПараметрыСОО);
	СОО = Новый ("ОписаниеОповещения", ПараметрыСозданияСОО);
		
	Возврат СОО;
		

КонецФункции

Функция ОбработчикОповещенияСОднимПараметром(ДополнительныеПараметрыСОО) Экспорт
	
	ВызовПодпрограммы(ДополнительныеПараметрыСОО.Модуль, ДополнительныеПараметрыСОО.ИмяКласса, ДополнительныеПараметрыСОО.ИмяОбработчика,  ДополнительныеПараметрыСОО.ПроцессорКода, ДополнительныеПараметрыСОО.ДополнительныеПараметры);
	
КонецФункции

Функция ОбработчикОповещенияСДвумяПараметрами(Результат, ДополнительныеПараметрыСОО) Экспорт

	ВызовПодпрограммы(ДополнительныеПараметрыСОО.Модуль, ДополнительныеПараметрыСОО.ИмяКласса, ДополнительныеПараметрыСОО.ИмяОбработчика,  ДополнительныеПараметрыСОО.ПроцессорКода, Результат, ДополнительныеПараметрыСОО.ДополнительныеПараметры);
	
КонецФункции

