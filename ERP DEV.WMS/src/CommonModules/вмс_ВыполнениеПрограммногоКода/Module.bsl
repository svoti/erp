					// подменим обращение к объекту переменной с результатом вычисления
					опЗаменаОбъекта = НовыйОператор(ТекстовыйПарсер, опВызовМетода, слРезультатВычисления, опОбъект);
					опВызовМетода.ДополнительныеДанные.Объект = опЗаменаОбъекта;

