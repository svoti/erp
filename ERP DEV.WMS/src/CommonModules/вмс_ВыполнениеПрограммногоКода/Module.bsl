				опПрисвоениеЗначения = опРодитель;
				ТочкаИнжекции = опПрисвоениеЗначения;
				СкопироватьОператор(ТекстовыйПарсер, опПрисвоениеЗначения);
				опВызовПодпрограммы = СкопированныеОператоры[опВызовМетода];
				опГруппа = опПрисвоениеЗначения;
			Иначе
				ТочкаИнжекции = опВызовМетода;
				опВызовПодпрограммы = СкопироватьОператор(ТекстовыйПарсер, опВызовМетода);
				опГруппа = опВызовМетода;
			КонецЕсли;
			
		КонецЕсли;
		
		опВызовПодпрограммы.ТипОператора = тВызовПодпрограммы;
		опОбъект = опВызовПодпрограммы.Операторы[0];
		опМетод = опВызовПодпрограммы.Операторы[2];
		ИмяМетода = ВРЕГ(опМетод.Код);
		опСкобки = опВызовПодпрограммы.Операторы[3];
		
		опПараметрыВызоваПодпрограммы = опВызовПодпрограммы.ДополнительныеДанные.ПараметрыВызоваПодпрограммы;
		Для Каждого опПараметрВызоваПодпрограммы Из опПараметрыВызоваПодпрограммы.Операторы Цикл
			Если опПараметрВызоваПодпрограммы.Операторы.Количество()=0 Тогда
				НовыйОператор(ТекстовыйПарсер, опПараметрВызоваПодпрограммы, слОпущенныйПараметр);
			КонецЕсли;
		КонецЦикла;
			опПараметрВызоваПодпрограммы = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, опПараметрыВызоваПодпрограммы, 0);
				ПоместитьОператор(ТекстовыйПарсер, опПараметрВызоваПодпрограммы, опОбъект);
			опПараметрВызоваПодпрограммы = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, опПараметрыВызоваПодпрограммы, 1);
				НовыйОператор(ТекстовыйПарсер, опПараметрВызоваПодпрограммы, слИмяКласса);
			опПараметрВызоваПодпрограммы = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, опПараметрыВызоваПодпрограммы, 2);
				НовыйОператор(ТекстовыйПарсер, опПараметрВызоваПодпрограммы, Слово(тСтрока, ИмяМетода));
			опПараметрВызоваПодпрограммы = НовыйОператорПараметрВызоваПодпрограммы(ТекстовыйПарсер, опПараметрыВызоваПодпрограммы, 3);
				НовыйОператор(ТекстовыйПарсер, опПараметрВызоваПодпрограммы, слПроцессорКода);

		опВызовПодпрограммы.Операторы.Очистить();
			НовыйОператор(ТекстовыйПарсер, опВызовПодпрограммы, слФункцияДляОбработки);
			ПоместитьОператор(ТекстовыйПарсер, опВызовПодпрограммы, опСкобки);

		Если Не МетодОпределен Тогда
			
			опОбъект = опВызовМетода.ДополнительныеДанные.Объект;
