Функция НовыйОператорПрисвоениеЗначение(знач ЛевоеЗначение, знач ПравоеЗначение, ТекстовыйПарсер, Родитель=Неопределено, Индекс=Неопределено)
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	ПрисвоениеЗначения = НовыйОператор(ТекстовыйПарсер, Родитель, , Индекс);
	ПрисвоениеЗначения.ТипОператора = ТипыСловИОператоров.ПрисвоениеЗначения;
	Если ЛевоеЗначение.Свойство("Слово") Тогда
		НовыйОператор(ТекстовыйПарсер, ПрисвоениеЗначения, ЛевоеЗначение);
	Иначе
		ПоместитьОператор(ТекстовыйПарсер, ПрисвоениеЗначения, ЛевоеЗначение);
	КонецЕсли;
	
	НовыйОператор(ТекстовыйПарсер, ПрисвоениеЗначения, Слово(ТипыСловИОператоров.ОперацияВыражения, "="));

	Если ПравоеЗначение<>Неопределено Тогда
		Если ПравоеЗначение.Свойство("Слово") Тогда
			ПравоеЗначение = НовыйОператор(ТекстовыйПарсер, ПрисвоениеЗначения, ПравоеЗначение);
		Иначе
			ПоместитьОператор(ТекстовыйПарсер, ПрисвоениеЗначения, ПравоеЗначение);
		КонецЕсли;
		ПравоеЗначение.ЛевоеЗначение = Ложь;
	КонецЕсли;
	
	Возврат ПрисвоениеЗначения;
	
КонецФункции

