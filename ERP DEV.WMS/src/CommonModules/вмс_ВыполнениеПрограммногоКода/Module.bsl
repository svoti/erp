//{
//	Компоновщик кода+
//
//	Собирает данные программных модулей, в том числе клиентские и серверные части модулей,
//	анализирует актуальность программных модулей и зависимости от других модулей
//

Функция НовыйКомпоновщикКода() Экспорт
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	КомпиляторКода = НовыйКомпиляторКода();
	
	ТаблицаПрограммныхМодулей = РК.НоваяКоллекцияЗначений("Ссылка, СкомпилированныйТекст, Текст, Зависимости, Проверен, Актуальность");
	РК.ДобавитьИндексКоллекции(ТаблицаПрограммныхМодулей, "Ссылка");
	
	КонтекстИсполнения = КомпиляторКода.КонтекстИсполнения;
	КонтекстыИсполнения = КомпиляторКода.КонтекстыИсполнения;
	ВызываемыеКонтекстыИсполненияМассив = Новый Массив;
	КонтекстИсполненияНайден = Ложь;
	Для Каждого ЭлементКонтекстаИсполнения Из КонтекстыИсполнения Цикл
		Если КонтекстИсполненияНайден Тогда
			ВызываемыеКонтекстыИсполненияМассив.Добавить(ЭлементКонтекстаИсполнения.Ключ);
		Иначе
			Если КонтекстИсполнения=ЭлементКонтекстаИсполнения.Ключ Тогда
				КонтекстИсполненияНайден = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	КомпоновщикКода = Новый Структура;
	КомпоновщикКода.Вставить("КомпиляторКода", КомпиляторКода);
	КомпоновщикКода.Вставить("КонтекстыИсполнения", КонтекстыИсполнения);
	КомпоновщикКода.Вставить("КонтекстИсполнения", КонтекстИсполнения);
	КомпоновщикКода.Вставить("ВызываемыеКонтекстыИсполненияМассив", ВызываемыеКонтекстыИсполненияМассив);
	КомпоновщикКода.Вставить("ТаблицаПрограммныхМодулей", ТаблицаПрограммныхМодулей);
	КомпоновщикКода.Вставить("ТекущиеДанныеКомпоновкиПрограммногоМодуля");
	КомпоновщикКода.Вставить("Данные", Новый Структура);
	КомпоновщикКода.Вставить("ДанныеМассив", Новый Массив);
	КомпоновщикКода.Вставить("ТипыОписанийПодпрограмм", КомпиляторКода.ТипыОписанийПодпрограмм);
	
	КомпоновщикКода_ИнициализироватьДанныеКомпиляции(КомпоновщикКода);
	
	Возврат КомпоновщикКода;
	
КонецФункции

Функция КомпоновщикКода_ИнициализироватьДанныеКомпиляции(КомпоновщикКода)

	КомпоновщикКода.Данные.Очистить();
	КомпоновщикКода.ДанныеМассив.Очистить();
	
	Для Каждого ЭлементКонтекстаИсполнения Из КомпоновщикКода.КонтекстыИсполнения Цикл
		
		КонтекстИсполнения = ЭлементКонтекстаИсполнения.Ключ;
		ДанныеКомпиляцииКонтекстаИсполнения = КомпиляторКода_НовыеДанныеКомпиляцииКонтекстаИсполнения(КомпоновщикКода.КомпиляторКода, КонтекстИсполнения);
		
		КомпоновщикКода.Данные.Вставить(КонтекстИсполнения, ДанныеКомпиляцииКонтекстаИсполнения);
		Для Каждого ЭлементДанныеДирективы Из ДанныеКомпиляцииКонтекстаИсполнения Цикл
			ДанныеДирективы = ЭлементДанныеДирективы.Значение;
			КомпоновщикКода.ДанныеМассив.Добавить(ДанныеДирективы);
		КонецЦикла;
		
	КонецЦикла;

КонецФункции

Функция КомпоновщикКода_Скомпилировать(КомпоновщикКода, ПрограммныеМодули) Экспорт
	
	Если Не КомпоновщикКода_СкомпилироватьКонтекстИсполнения(КомпоновщикКода, ПрограммныеМодули, КомпоновщикКода.КонтекстИсполнения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ВызываемыйКонтекстИсполнения Из КомпоновщикКода.ВызываемыеКонтекстыИсполненияМассив Цикл
		КомпоновщикКода_СкомпилироватьВызываемыйКонтекстИсполнения(КомпоновщикКода, ПрограммныеМодули, ВызываемыйКонтекстИсполнения);
	КонецЦикла;
	
	КомпоновщикКода_АктуализироватьПрограммныеМодули(КомпоновщикКода);

	Возврат Истина;
	
КонецФункции

Функция КомпоновщикКода_СкомпилироватьКонтекстИсполнения(КомпоновщикКода, ПрограммныеМодули, КонтекстИсполнения) Экспорт
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	МассивКомпилируемыхПрограммныхМодулей = РК.ЗначениеВМассив(ПрограммныеМодули);
	
	Для Каждого ДанныеКомпоновкиМодуля Из РК.ПолучитьЭлементыКоллекции(КомпоновщикКода.ТаблицаПрограммныхМодулей) Цикл
		ДанныеКомпоновкиМодуля.Проверен = Ложь;
	КонецЦикла;
	
	КомпиляторКода = КомпоновщикКода.КомпиляторКода;
	КомпиляторКода.КонтекстИсполнения = КонтекстИсполнения;
	КомпиляторКода.Данные = КомпоновщикКода.Данные[КонтекстИсполнения];
	
	ДанныеОбновленны = Ложь;
	
	Для Каждого ПрограммныйМодуль Из МассивКомпилируемыхПрограммныхМодулей Цикл
		
		Если КомпоновщикКода_ПроверитьАктуальностьПрограммногоМодуля(КомпоновщикКода, ПрограммныйМодуль, МассивКомпилируемыхПрограммныхМодулей) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеКомпоновкиМодуля = КомпоновщикКода.ТекущиеДанныеКомпоновкиПрограммногоМодуля;
		КомпиляторКода_Скомпилировать(КомпиляторКода, ДанныеКомпоновкиМодуля.Текст);
		КомпоновщикКода_ЗаполнитьЗависимостиМодуля(КомпоновщикКода, ДанныеКомпоновкиМодуля, КомпиляторКода.Зависимости);
		
		ДанныеОбновленны = Истина;
		
	КонецЦикла;
	
	Возврат ДанныеОбновленны;
	
КонецФункции

Функция КомпоновщикКода_СкомпилироватьВызываемыйКонтекстИсполнения(КомпоновщикКода, ПрограммныеМодули, КонтекстИсполнения) Экспорт

	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	

	ДанныеКомпоновщикаКода = Новый Структура;
	ДанныеКомпоновщикаКода.Вставить("ТаблицаПрограммныхМодулей", РК.ПолучитьЭлементыКоллекции(КомпоновщикКода.ТаблицаПрограммныхМодулей));
	ДанныеКомпоновщикаКода.Вставить("ДанныеКомпиляцииДирективКонтекстаИсполнения", КомпоновщикКода_ПолучитьДанныеКомпиляцииДирективКонтекстаИсполнения(КомпоновщикКода, КонтекстИсполнения));
	
	ПараметрыВызоваКонтекстаИсполнения = Новый Структура;
	ПараметрыВызоваКонтекстаИсполнения.Вставить("Действие", "КомпиляцияКода");
	ПараметрыВызоваКонтекстаИсполнения.Вставить("ИспользоватьКэш", Истина);
	ПараметрыВызоваКонтекстаИсполнения.Вставить("ПрограммныеМодули", ПрограммныеМодули);
	ПараметрыВызоваКонтекстаИсполнения.Вставить("КонтекстИсполнения", КонтекстИсполнения);
	ПараметрыВызоваКонтекстаИсполнения.Вставить("ДанныеКомпоновщикаКода", ДанныеКомпоновщикаКода);

	ДанныеКомпоновщикаКода = ВызватьКонтекстИсполнения(ПараметрыВызоваКонтекстаИсполнения);
	
	КомпоновщикКода_ЗагрузитьДанныеКомпиляцииДирективКонтекстовИсполнения(КомпоновщикКода, ДанныеКомпоновщикаКода.ДанныеКомпиляцииДирективКонтекстаИсполнения);
	
КонецФункции

Функция КомпоновщикКода_ПолучитьДанныеКомпиляцииДирективКонтекстаИсполнения(КомпоновщикКода, КонтекстИсполнения) Экспорт
	
	ДанныеКомпиляцииДирективКонтекстаИсполнения = Новый Массив;
	Для Каждого ДанныеКомпиляцииДирективыКонтекстаИсполнения Из КомпоновщикКода.ДанныеМассив Цикл
		Если ДанныеКомпиляцииДирективыКонтекстаИсполнения.КонтекстИсполнения=КонтекстИсполнения Тогда
			ДанныеКомпиляцииДирективКонтекстаИсполнения.Добавить(ДанныеКомпиляцииДирективыКонтекстаИсполнения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеКомпиляцииДирективКонтекстаИсполнения;
	
КонецФункции

Функция КомпоновщикКода_ЗагрузитьДанныеКомпиляцииДирективКонтекстовИсполнения(КомпоновщикКода, ДанныеКомпиляцииДирективКонтекстовИсполнения) Экспорт
	
	Для Каждого ДанныеКомпиляцииДирективыКонтекстаИсполнения Из ДанныеКомпиляцииДирективКонтекстовИсполнения Цикл
		
		ДанныеКомпиляцииКонтекстаИсполненияПриемник = КомпоновщикКода.Данные[ДанныеКомпиляцииДирективыКонтекстаИсполнения.КонтекстИсполнения];
		
		Если ДанныеКомпиляцииДирективыКонтекстаИсполнения.ИспользоватьДанныеКонтекста Тогда
			ДанныеКомпиляцииДирективыКонтекстаИсполненияПриемник = ДанныеКомпиляцииКонтекстаИсполненияПриемник.СДаннымиКонтекста;
		Иначе
			ДанныеКомпиляцииДирективыКонтекстаИсполненияПриемник = ДанныеКомпиляцииКонтекстаИсполненияПриемник.БезДанныхКонтекста;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДанныеКомпиляцииДирективыКонтекстаИсполненияПриемник, ДанныеКомпиляцииДирективыКонтекстаИсполнения);
		
	КонецЦикла;
	
КонецФункции

Функция КомпоновщикКода_ЗаполнитьЗависимостиМодуля(КомпоновщикКода, ДанныеКомпоновкиМодуля, Зависимости)
	
	Для Каждого Включение Из Зависимости.Включения Цикл
		
		Если ДанныеКомпоновкиМодуля.Зависимости.Включения.Найти(Включение)=Неопределено Тогда
			ДанныеКомпоновкиМодуля.Зависимости.Включения.Добавить(Включение);
			КомпоновщикКода_ПроверитьАктуальностьПрограммногоМодуля(КомпоновщикКода, Включение);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Использование Из Зависимости.Использования Цикл
		
		Если ДанныеКомпоновкиМодуля.Зависимости.Использования.Найти(Использование)=Неопределено Тогда
			ДанныеКомпоновкиМодуля.Зависимости.Использования.Добавить(Использование);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция КомпоновщикКода_ПроверитьАктуальностьПрограммногоМодуля(КомпоновщикКода, ПрограммныйМодуль, МассивКомпилируемыхПрограммныхМодулей=Неопределено)
	
	Если ТипЗнч(ПрограммныйМодуль)=Тип("Структура") Тогда
		Ссылка = ПрограммныйМодуль.Ссылка;
	ИначеЕсли ТипЗнч(ПрограммныйМодуль)=Тип("СправочникСсылка.вмс_ПрограммныеМодули") Тогда
		Ссылка = ПрограммныйМодуль;
	Иначе
		Ссылка = вмс_ВыполнениеПрограммногоКодаВызовСервера.НайтиПрограммныйМодуль(ПрограммныйМодуль);
	КонецЕсли;

	ДанныеКомпоновкиМодуля = КомпоновщикКода_ПолучитьДанныеКомпоновкиПрограммногоМодуля(КомпоновщикКода, Ссылка);
	Если ДанныеКомпоновкиМодуля.Проверен Тогда
		КомпоновщикКода.ТекущиеДанныеКомпоновкиПрограммногоМодуля = ДанныеКомпоновкиМодуля;
		Возврат ДанныеКомпоновкиМодуля.Актуальность;
	КонецЕсли;
	
	Если ТипЗнч(ПрограммныйМодуль)=Тип("Структура") Тогда
		ДанныеМодуля = ПрограммныйМодуль;
	Иначе
		ДанныеМодуля = вмс_ВыполнениеПрограммногоКодаВызовСервера.ПолучитьДанныеПрограммногоМодуля(ПрограммныйМодуль);
	КонецЕсли;
	
	ДанныеКомпоновкиМодуля.Проверен = Истина;
	ДанныеКомпоновкиМодуля.Актуальность = Истина;
	ДанныеКомпоновкиМодуля.Текст = ДанныеМодуля.Текст;
	
	Если ДанныеКомпоновкиМодуля.СкомпилированныйТекст<>ДанныеКомпоновкиМодуля.Текст Тогда
		ДанныеКомпоновкиМодуля.Актуальность = Ложь;
	КонецЕсли;
	
	Если ДанныеКомпоновкиМодуля.Актуальность Тогда
		
		Для Каждого ВключаемыйМодуль Из ДанныеКомпоновкиМодуля.Зависимости.Включения Цикл
			
			Если Не КомпоновщикКода_ПроверитьАктуальностьПрограммногоМодуля(КомпоновщикКода, ВключаемыйМодуль, МассивКомпилируемыхПрограммныхМодулей) Тогда
				// Включаемый модуль изменился
				// требуется перекомпилировать текущий модуль
				ДанныеКомпоновкиМодуля.Актуальность = Ложь;
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;

	Если МассивКомпилируемыхПрограммныхМодулей=Неопределено Тогда
		МассивКомпилируемыхПрограммныхМодулей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИспользуемыйМодуль Из ДанныеКомпоновкиМодуля.Зависимости.Использования Цикл
		
		Если Не КомпоновщикКода_ПроверитьАктуальностьПрограммногоМодуля(КомпоновщикКода, ИспользуемыйМодуль, МассивКомпилируемыхПрограммныхМодулей) Тогда
			Если МассивКомпилируемыхПрограммныхМодулей.Найти(ИспользуемыйМодуль)=Неопределено Тогда
				// Используемый модуль изменился, его надо перекомпилировать для взаимодействия с текущим модулем
				МассивКомпилируемыхПрограммныхМодулей.Добавить(ИспользуемыйМодуль);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ДанныеКомпоновкиМодуля.Актуальность Тогда
		
		ДанныеКомпоновкиМодуля.Зависимости.Включения.Очистить();
		ДанныеКомпоновкиМодуля.Зависимости.Использования.Очистить();
		
	КонецЕсли;
	
	КомпоновщикКода.ТекущиеДанныеКомпоновкиПрограммногоМодуля = ДанныеКомпоновкиМодуля;
	Возврат ДанныеКомпоновкиМодуля.Актуальность;
	
КонецФункции

Функция КомпоновщикКода_АктуализироватьПрограммныеМодули(КомпоновщикКода)

	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");

	Для Каждого ДанныеКомпоновкиМодуля Из РК.ПолучитьЭлементыКоллекции(КомпоновщикКода.ТаблицаПрограммныхМодулей) Цикл
		ДанныеКомпоновкиМодуля.СкомпилированныйТекст = ДанныеКомпоновкиМодуля.Текст;
	КонецЦикла;
	
КонецФункции

Функция КомпоновщикКода_ПолучитьДанныеКомпоновкиПрограммногоМодуля(КомпоновщикКода, Ссылка)
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	Отбор = Новый Структура("Ссылка", Ссылка);
	ДанныеКомпоновкиМодуля = РК.НайтиЭлементКоллекции(КомпоновщикКода.ТаблицаПрограммныхМодулей, Отбор);
	
	Если ДанныеКомпоновкиМодуля=Неопределено Тогда
		ДанныеКомпоновкиМодуля = РК.ДобавитьЭлементКоллекции(КомпоновщикКода.ТаблицаПрограммныхМодулей, Отбор);
		ДанныеКомпоновкиМодуля.Проверен = Ложь;
		ДанныеКомпоновкиМодуля.Актуальность = Ложь;
		ДанныеКомпоновкиМодуля.Зависимости = Новый Структура;
		ДанныеКомпоновкиМодуля.Зависимости.Вставить("Включения", Новый Массив);
		ДанныеКомпоновкиМодуля.Зависимости.Вставить("Использования", Новый Массив);
	КонецЕсли;
	
	Возврат ДанныеКомпоновкиМодуля;
	
КонецФункции

