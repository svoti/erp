Функция НовыйТекстовыйПарсер(Текст=Неопределено) Экспорт
	
	Перем РК, РаботаСXML;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	РаботаСXML = глОбщийМодуль("РаботаСXMLКлиентСервер");

	ОбщиеМодули = Новый Соответствие;
	ОбщиеМодули["РаботаСКоллекциями"] = РК;
	ОбщиеМодули["РаботаСXML"] = РаботаСXML;
	
	Цифры = "1234567890";
	ЦифрыМассив = РК.СтрокуВМассивПосимвольно(Цифры);
	ЦифрыСоответствие = РК.ПреобразоватьМассивВСоответствие(ЦифрыМассив);
	ДопустимыеСимволыИдентификаторовНРЕГ = "йцукенгшщзхъфывапролджэячсмитьбюqwertyuiopasdfghjklzxcvbnm";
	ДопустимыеСимволыИдентификаторов = ДопустимыеСимволыИдентификаторовНРЕГ + ВРЕГ(ДопустимыеСимволыИдентификаторовНРЕГ) + Цифры + "_";
	ДопустимыеСимволыИдентификаторовМассив = РК.СтрокуВМассивПосимвольно(ДопустимыеСимволыИдентификаторов);
	ДопустимыеСимволыИдентификаторовСоответствие = РК.ПреобразоватьМассивВСоответствие(ДопустимыеСимволыИдентификаторовМассив);
	
	ПоляОператоров = "Код, ТипОператора, НомерСтроки, ЛевоеЗначение, ПространствоИмен, Операторы, Родитель, ДополнительныеДанные";
	ПоляПодпрограммы = "ВРИмя, Имя, ВРИмяКласса, Объявление, Директива, Тип, Нативная, Экспорт, НепосредственныйДоступКПолямОбъекта, ТаблицаПараметров, ТаблицаПеременных";
	ПоляПодпрограммы = ПоляПодпрограммы + ", " + ПоляОператоров;
	
	ПоляКласса = ПоляОператоров + ", " + "ВРИмя, Имя, Директива, ИдентификаторыУказателейТекущегоОбъекта, ИменаПолей, ИменаПолейМассив, ИменаНативныхПолейМассив, Поля, Методы, ИспользоватьНативныеМетоды, ТаблицаПеременных, Предки";
	
	Слова = Новый Массив;
	ТаблицаПодпрограмм = РК.НоваяКвазиТаблицаЗначений(ПоляПодпрограммы);
	РК.ДобавитьИндексКоллекции(ТаблицаПодпрограмм, "ВРИмя, ВРИмяКласса");
	ТаблицаКлассов = РК.НоваяКвазиТаблицаЗначений(ПоляКласса);
	РК.ДобавитьИндексКоллекции(ТаблицаКлассов, "ВРИмя");
	
	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("ОбщиеМодули", ОбщиеМодули);
	ДополнительныеДанные.Вставить("СкопированныеОператоры", Новый Соответствие);

	ТипыСловИОператоров = РК.НовоеПеречисление
	(
		"Спецсимвол, Идентификатор, Выражение, ПрисвоениеЗначения, ЛинейноеУсловие, ЛевоеЗначение, ПравоеЗначение, ОперацияВыражения, Строка, Число, ЛокальныеПеременные, Переменная, Подпрограмма, Класс, НовыйОбъект, ВызовПодпрограммы, ПараметрыВызоваПодпрограммы, ПараметрВызоваПодпрограммы, Поле, ВызовМетода, Скобки, ЛинейныйУсловныйОператор, ЛогическийБлок, ЛогическийБлокПрепроцессора, ЗаголовокЛогическогоБлока, ТелоЛогическогоБлока, ВыражениеВозврата, ВозвратИзПодпрограммы",
		"Строка"
	);
	
	КонтекстыИсполнения = РК.НовоеПеречисление
	(	"Клиент, Сервер", //Бэкенд
		"Строка"
	);
	
	МассивПолейОператоровКопируемыхЗначений = Новый Массив;
	МассивПолейОператоровКопируемыхЗначений.Добавить("ПространствоИмен");
	
	Зависимости = Новый Структура;
	Зависимости.Вставить("Включения", Новый Массив);
	Зависимости.Вставить("Использования", Новый Массив);
	
	ТекстовыйПарсер = Новый Структура;
	ТекстовыйПарсер.Вставить("МассивПолейОператоровКопируемыхЗначений", МассивПолейОператоровКопируемыхЗначений);
	ТекстовыйПарсер.Вставить("ДопустимыеСимволыИдентификаторов", ДопустимыеСимволыИдентификаторов);
	ТекстовыйПарсер.Вставить("ДопустимыеСимволыИдентификаторовМассив", ДопустимыеСимволыИдентификаторовМассив);
	ТекстовыйПарсер.Вставить("ДопустимыеСимволыИдентификаторовСоответствие", ДопустимыеСимволыИдентификаторовСоответствие);
	ТекстовыйПарсер.Вставить("Цифры", Цифры);
	ТекстовыйПарсер.Вставить("ЦифрыМассив", ЦифрыМассив);
	ТекстовыйПарсер.Вставить("ЦифрыСоответствие", ЦифрыСоответствие);
	ТекстовыйПарсер.Вставить("ТипыСловИОператоров", ТипыСловИОператоров);
	ТекстовыйПарсер.Вставить("КонтекстыИсполнения", КонтекстыИсполнения);
	ТекстовыйПарсер.Вставить("КонтекстИсполнения", КонтекстыИсполнения.Клиент);
	ТекстовыйПарсер.Вставить("ЧтениеТекста");
	ТекстовыйПарсер.Вставить("Текст", "");
	ТекстовыйПарсер.Вставить("СформированныйТекст", "");
	ТекстовыйПарсер.Вставить("Строка");
	ТекстовыйПарсер.Вставить("ДлинаСтроки", 0);
	ТекстовыйПарсер.Вставить("НомерСимвола", 0);
	ТекстовыйПарсер.Вставить("НомерСтроки", 0);
	ТекстовыйПарсер.Вставить("Слова", Слова);
	ТекстовыйПарсер.Вставить("КоличествоСлов", 0);
	ТекстовыйПарсер.Вставить("ТекущееСлово");
	ТекстовыйПарсер.Вставить("НомерТекущегоСлова", 0);
	ТекстовыйПарсер.Вставить("ПустоеСлово", Слово());
	ТекстовыйПарсер.Вставить("ГлобальнаяОбласть");
	ТекстовыйПарсер.Вставить("ГлобальныйКласс");
	ТекстовыйПарсер.Вставить("ТаблицаПодпрограмм", ТаблицаПодпрограмм);
	ТекстовыйПарсер.Вставить("ТаблицаКлассов", ТаблицаКлассов);
	ТекстовыйПарсер.Вставить("Пробел", " ");
	ТекстовыйПарсер.Вставить("ПереводСтроки", Символы.ПС);
	ТекстовыйПарсер.Вставить("Кавычка", """");
	ТекстовыйПарсер.Вставить("ПоляПодпрограммы", ПоляПодпрограммы);
	ТекстовыйПарсер.Вставить("ПоляОператоров", ПоляОператоров);
	ТекстовыйПарсер.Вставить("ЛогическиеБлоки", ПолучитьЛогическиеБлоки());
	ТекстовыйПарсер.Вставить("ОписанияСкобок", ПолучитьОписанияСкобок());
	ТекстовыйПарсер.Вставить("ОператорыСравнения", ПолучитьОператорыСравнения());
	ТекстовыйПарсер.Вставить("ОперацииВыражений", ПолучитьОперацииВыражений());
	ТекстовыйПарсер.Вставить("ДополнительныеДанные", ДополнительныеДанные);
	ТекстовыйПарсер.Вставить("ТекущийОператор");
	ТекстовыйПарсер.Вставить("ИдентификаторыПрепроцессора", Новый Соответствие);
	ТекстовыйПарсер.Вставить("Зависимости", Зависимости);
	
	ТекстовыйПарсер_УстановитьИдентификаторыПрепроцессораПоУмолчанию(ТекстовыйПарсер);

	ЗаполнитьГраницыЛогическихБлоков(ТекстовыйПарсер);
	
	ЗаполнитьЗарезервированныеИдентификаторы(ТекстовыйПарсер);
	
	ЗарегистрироватьДирективыКонтекстовИсполнения(ТекстовыйПарсер);
	
	Если Текст <> Неопределено Тогда
		ТекстовыйПарсер_РазобратьТекст(ТекстовыйПарсер, Текст);
	КонецЕсли;
	
	Возврат ТекстовыйПарсер;
КонецФункции

Функция ТекстовыйПарсер_УстановитьИдентификаторыПрепроцессораПоУмолчанию(ТекстовыйПарсер)
	
	Перем ОбщегоНазначенияКлиентСервер;
	
	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
	ТекстовыйПарсер.ИдентификаторыПрепроцессора.Очистить();
	ТекстовыйПарсер.ИдентификаторыПрепроцессора["НЕОПРЕДЕЛЕНО"] = "НЕОПРЕДЕЛЕНО";
	ТекстовыйПарсер.ИдентификаторыПрепроцессора["NULL"] = "NULL";
	ТекстовыйПарсер.ИдентификаторыПрепроцессора["ИСТИНА"] = 0;
	ТекстовыйПарсер.ИдентификаторыПрепроцессора["ЛОЖЬ"] = 1;
	ТекстовыйПарсер.ИдентификаторыПрепроцессора["БЭКЕНД"] = ?(ОбщегоНазначенияКлиентСервер.ЭтоБэкенд(), 1, 0);
	
КонецФункции

Функция ЗарегистрироватьДирективыКонтекстовИсполнения(ТекстовыйПарсер)

	ТекстовыйПарсер.Вставить("ДирективыКонтекстовИсполненияМассив", Новый Массив);
	ТекстовыйПарсер.Вставить("ДирективыКонтекстовИсполнения", Новый Соответствие);
	
	ЗарегистрироватьДирективуКонтекстаИсполнения(ТекстовыйПарсер, "НаКлиенте",				"Клиент",	Истина,		"НаКлиентеБезКонтекста, НаСервере, НаСервереБезКонтекста");
	ЗарегистрироватьДирективуКонтекстаИсполнения(ТекстовыйПарсер, "НаКлиентеБезКонтекста",	"Клиент",	Ложь,		"НаСервереБезКонтекста");
	ЗарегистрироватьДирективуКонтекстаИсполнения(ТекстовыйПарсер, "НаСервере",				"Сервер",	Истина,		"НаСервереБезКонтекста");
	ЗарегистрироватьДирективуКонтекстаИсполнения(ТекстовыйПарсер, "НаСервереБезКонтекста",	"Сервер",	Ложь);

КонецФункции

Функция ЗарегистрироватьДирективуКонтекстаИсполнения(ТекстовыйПарсер, Имя, КонтекстИсполнения, ИспользоватьДанныеКонтекста, ВозможныеПереходы=Неопределено)
	
	Перем РК;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	Директива = Новый Структура;
	Директива.Вставить("Имя", ВРЕГ(Имя));
	Директива.Вставить("КонтекстИсполнения", КонтекстИсполнения);
	Директива.Вставить("ИспользоватьДанныеКонтекста", ИспользоватьДанныеКонтекста);
	Директива.Вставить("ВозможныеПереходы", Новый Соответствие);
	
	Если ВозможныеПереходы<>Неопределено Тогда
		ВозможныеПереходыМассив = РК.ЗначениеВМассив(ВозможныеПереходы, , Ложь);
		Для Каждого ВозможныйПереход Из ВозможныеПереходыМассив Цикл
			Директива.ВозможныеПереходы[ВРЕГ(ВозможныйПереход)] = Истина;
		КонецЦикла;
	КонецЕсли;
	
	ТекстовыйПарсер.ДирективыКонтекстовИсполненияМассив.Добавить(Директива);
	ТекстовыйПарсер.ДирективыКонтекстовИсполнения[Директива.Имя] = Директива;
	
КонецФункции

Функция ЗаполнитьЗарезервированныеИдентификаторы(ТекстовыйПарсер)
	
	ЗарезервированныеИдентификаторы = Новый Соответствие;
	
	Для Каждого ЭлементКлючевогоСлова Из ТекстовыйПарсер.ЛогическиеБлоки.КлючевыеСлова Цикл
		ЗарезервированныеИдентификаторы[ЭлементКлючевогоСлова.Ключ] = Истина;
	КонецЦикла;
	
	ЗарезервированныеИдентификаторы["И"] = Истина;
	ЗарезервированныеИдентификаторы["НЕ"] = Истина;
	ЗарезервированныеИдентификаторы["ИЛИ"] = Истина;
	
	ЗарезервированныеИдентификаторы["ФУНКЦИЯ"] = Истина;
	ЗарезервированныеИдентификаторы["КОНЕЦФУНКЦИИ"] = Истина;
	ЗарезервированныеИдентификаторы["ПРОЦЕДУРА"] = Истина;
	ЗарезервированныеИдентификаторы["КОНЕЦПРОЦЕДУРЫ"] = Истина;
	ЗарезервированныеИдентификаторы["НОВЫЙ"] = Истина;
	
	// Ключевые только для операторов препроцессора
	// а так можно пользовать
	ЗарезервированныеИдентификаторы.Удалить("ОБЛАСТЬ");
	ЗарезервированныеИдентификаторы.Удалить("КОНЕЦОБЛАСТИ");
	
	ТекстовыйПарсер.Вставить("ЗарезервированныеИдентификаторы", ЗарезервированныеИдентификаторы);
	
КонецФункции

Функция ПолучитьОперацииВыражений()
	
	Порядок = 1;
	Поля = "Тип, Порядок";
	ОперацииВыраженийМассив = Новый Массив;
	
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "НЕ", Порядок));
	Порядок = Порядок + 1;

	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "*", Порядок));
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "/", Порядок));
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "%", Порядок));
	Порядок = Порядок + 1;

	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "+", Порядок));
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "-", Порядок));
	Порядок = Порядок + 1;
	
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "=", Порядок));
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "<>", Порядок));
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, ">", Порядок));
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, ">=", Порядок));
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "<", Порядок));
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "<=", Порядок));
	Порядок = Порядок + 1;
	
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "И", Порядок));
	Порядок = Порядок + 1;
	
	ОперацииВыраженийМассив.Добавить(Новый Структура(Поля, "ИЛИ", Порядок));
	Порядок = Порядок + 1;

	ОперацииВыражений = Новый Соответствие;
	Для Каждого ОперацияВыражения Из ОперацииВыраженийМассив Цикл
		ОперацииВыражений[ОперацияВыражения.Тип] = ОперацияВыражения;
	КонецЦикла;
	
	Возврат ОперацииВыражений;

КонецФункции

Функция ЗаполнитьГраницыЛогическихБлоков(ТекстовыйПарсер)

	ГраницыЛогическихБлоков = Новый Соответствие;
	Для Каждого Элемент Из ТекстовыйПарсер.ЛогическиеБлоки.НачалаЛогическихБлоков Цикл
		ГраницыЛогическихБлоков[Элемент.Ключ] = Истина;
	КонецЦикла;
	
	Для Каждого Элемент Из ТекстовыйПарсер.ЛогическиеБлоки.ЭтоКонецЛогическогоБлока Цикл
		ГраницыЛогическихБлоков[Элемент.Ключ] = Истина;
	КонецЦикла;
	
	ТекстовыйПарсер.Вставить("ГраницыЛогическихБлоков", ГраницыЛогическихБлоков);
	
КонецФункции

Функция ПолучитьЛогическиеБлоки()
	
	Перем РК, ПарсированиеТекста;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	ПарсированиеТекста = глОбщийМодуль("ПарсированиеТекста");

	ОписаниеБлоковТекст =
	"[
	|	[Если,		[КонецЕсли, ИначеЕсли, Иначе], Тогда],
	|	[ИначеЕсли,	[КонецЕсли, ИначеЕсли, Иначе], Тогда],
	|	[Иначе,		КонецЕсли],
	|
	|	[Для, КонецЦикла, Цикл],
	|	[Пока, КонецЦикла, Цикл],
	|
	|	[Область, КонецОбласти, ],
	|
	|	[Попытка, Исключение],
	|	[Исключение, КонецПопытки]
	|]";

	ОписаниеБлоков = ПарсированиеТекста.ТекстовыйПарсер_РазобратьТекст(ОписаниеБлоковТекст);
	
	СписокЛогическихБлоков = Новый Массив;
	НачалаЛогическихБлоков = Новый Соответствие;
	ЭтоКонецЛогическогоБлока = Новый Соответствие;
	Для Каждого ОписаниеБлока Из ОписаниеБлоков Цикл
		КонцыБлокаМассив = РК.ЗначениеВМассив(ОписаниеБлока[1], , Ложь);
		КонцыЛогическогоБлока = Новый Соответствие;
		Для Каждого КонецБлока Из КонцыБлокаМассив Цикл
			ЭтоКонецЛогическогоБлока[ВРЕГ(КонецБлока)] = Истина;
			КонцыЛогическогоБлока[ВРЕГ(КонецБлока)] = Истина;
		КонецЦикла;
		
		ЛогическийБлок = Новый Структура;
		ЛогическийБлок.Вставить("Начало", ВРЕГ(ОписаниеБлока[0]));
		ЛогическийБлок.Вставить("Концы", КонцыЛогическогоБлока);
		Если ОписаниеБлока.Количество() > 2 Тогда
			ЛогическийБлок.Вставить("КонецЗаголовка", ВРЕГ(ОписаниеБлока[2]));
		Иначе
			ЛогическийБлок.Вставить("КонецЗаголовка");
		КонецЕсли;
		
		ЛогическийБлок.Вставить("ЕстьЗаголовок", ЛогическийБлок.КонецЗаголовка <> Неопределено);
		СписокЛогическихБлоков.Добавить(ЛогическийБлок);
		
		НачалаЛогическихБлоков[ЛогическийБлок.Начало] = ЛогическийБлок;
	КонецЦикла;

	КлючевыеСлова = Новый Соответствие;
	ОбходКлючевыхСловБлока = Новый Массив;
	ОбходКлючевыхСловБлока.Добавить(ОписаниеБлоков);
	Для Каждого ЭлементОбходаКлючевыхСловБлока Из ОбходКлючевыхСловБлока Цикл
		
		Если ТипЗнч(ЭлементОбходаКлючевыхСловБлока)=Тип("Массив") Тогда
			
			Для Каждого ВложенныйЭлементОбходаКлючевыхСловБлока Из ЭлементОбходаКлючевыхСловБлока Цикл
				ОбходКлючевыхСловБлока.Добавить(ВложенныйЭлементОбходаКлючевыхСловБлока);
			КонецЦикла;
			
		Иначе
			
			Слово = ЭлементОбходаКлючевыхСловБлока;
			КлючевыеСлова[ВРЕГ(Слово)] = Слово;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЛогическиеБлоки = Новый Структура;
	ЛогическиеБлоки.Вставить("СписокЛогическихБлоков", СписокЛогическихБлоков);
	ЛогическиеБлоки.Вставить("НачалаЛогическихБлоков", НачалаЛогическихБлоков);
	ЛогическиеБлоки.Вставить("ЭтоКонецЛогическогоБлока", ЭтоКонецЛогическогоБлока);
	ЛогическиеБлоки.Вставить("КлючевыеСлова", КлючевыеСлова);
	
	Возврат ЛогическиеБлоки;
	
КонецФункции

Функция ПолучитьОписанияСкобок()
	
	Перем РаботаСКоллекциями;
	
	РаботаСКоллекциями = глОбщийМодуль("РаботаСКоллекциями");
	
	ОписаниеСкобок =
	"[,]
	|(,)";
	//|<,>";

	СписокОписанийСкобок = Новый Массив;
	ОписаниеСкобокСтроки = РаботаСКоллекциями.СтрокуВМассив(ОписаниеСкобок, Символы.ПС);
	ЛевыеСкобки = Новый Соответствие;
	ПравыеСкобки = Новый Соответствие;
	Для Каждого ОписаниеСкобкиСтрока Из ОписаниеСкобокСтроки Цикл
		ОписаниеСкобкиМассив = РаботаСКоллекциями.СтрокуВМассив(ОписаниеСкобкиСтрока, ",");
		ОписаниеСкобки = Новый Структура;
		ОписаниеСкобки.Вставить("Начало", ОписаниеСкобкиМассив[0]);
		ОписаниеСкобки.Вставить("Конец", ОписаниеСкобкиМассив[1]);
		
		СписокОписанийСкобок.Добавить(ОписаниеСкобки);
		
		ЛевыеСкобки[ОписаниеСкобки.Начало] = ОписаниеСкобки;
		ПравыеСкобки[ОписаниеСкобки.Конец] = ОписаниеСкобки;
	КонецЦикла;
	
	ОписанияСкобок = Новый Структура;
	ОписанияСкобок.Вставить("СписокОписанийСкобок", СписокОписанийСкобок);
	ОписанияСкобок.Вставить("ЛевыеСкобки", ЛевыеСкобки);
	ОписанияСкобок.Вставить("ПравыеСкобки", ПравыеСкобки);
	
	Возврат ОписанияСкобок;
	
КонецФункции

Функция ПолучитьОператорыСравнения()
	
	ОператорыСравнения = Новый Соответствие;
	ОператорыСравнения[">"] = Истина;
	ОператорыСравнения["<"] = Истина;
	ОператорыСравнения["="] = Истина;
	
	Возврат ОператорыСравнения;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьТекст(ТекстовыйПарсер, Текст) Экспорт
	ТекстовыйПарсер_УстановитьТекст(ТекстовыйПарсер, Текст);
	ТекстовыйПарсер_РазобратьСлова(ТекстовыйПарсер);
	ТекстовыйПарсер_РазобратьМодуль(ТекстовыйПарсер);
	Возврат Истина;
КонецФункции

Функция ТекстовыйПарсер_УстановитьТекст(ТекстовыйПарсер, Текст) Экспорт

	ЗдесьОстановиПоБратски("Гагаринский дом 3");
	
	Кодировка = КодировкаТекста.UTF8;
	
	Поток = Новый ПотокВПамяти;
	ЗаписьТекста = Новый ЗаписьТекста;
	ЗаписьТекста.Открыть(Поток, Кодировка);
	ЗаписьТекста.ЗаписатьСтроку(Текст);
	ЗаписьТекста.Закрыть();
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	
	ТекстовыйПарсер.ЧтениеТекста = Новый ЧтениеТекста(Поток, Кодировка);
	ТекстовыйПарсер.Текст = Текст;
	ТекстовыйПарсер.НомерСимвола = 1;
	ТекстовыйПарсер.НомерСтроки = 0;
	ТекстовыйПарсер.ДлинаСтроки = 0;
	ТекстовыйПарсер.Строка = Неопределено;

КонецФункции

Функция ТекстовыйПарсер_РазобратьМодуль(ТекстовыйПарсер) Экспорт

	ОписаниеОшибки = Новый Структура;
	ОписаниеОшибки.Вставить("Текст");
	ОписаниеОшибки.Вставить("Строка");
	ОписаниеОшибки.Вставить("Ошибка", Ложь);
	ТекстовыйПарсер.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	
	ТекстовыйПарсер_Очистить(ТекстовыйПарсер);
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	ДирективаПоУмолчанию = ТекстовыйПарсер.ДирективыКонтекстовИсполнения["НАСЕРВЕРЕ"];

	ГлобальнаяОбласть = Новый Структура(ТекстовыйПарсер.ПоляПодпрограммы);
	ИнициализироватьНовуюПодпрограмму(ТекстовыйПарсер, ГлобальнаяОбласть);
	ГлобальнаяОбласть.ТипОператора = Неопределено;
	ГлобальнаяОбласть.ДополнительныеДанные.ДирективаКомпиляции = ДирективаПоУмолчанию;
	
	ТекстовыйПарсер.ГлобальнаяОбласть = ГлобальнаяОбласть;
	ТекстовыйПарсер.ТекущийОператор = Неопределено;
	
	ГлобальныйКласс = НовыйКласс(ТекстовыйПарсер, "");
	ГлобальныйКласс.ИспользоватьНативныеМетоды = Истина;
	ТекстовыйПарсер.ГлобальныйКласс = ГлобальныйКласс;
	
	КонтекстыИсполнения = ТекстовыйПарсер.КонтекстыИсполнения;
	ИдентификаторыПрепроцессора = ТекстовыйПарсер.ИдентификаторыПрепроцессора;
	Если ТекстовыйПарсер.КонтекстИсполнения=КонтекстыИсполнения.Клиент Тогда
		ИдентификаторыПрепроцессора["КЛИЕНТ"] = 1;
		ИдентификаторыПрепроцессора["СЕРВЕР"] = 0;
	ИначеЕсли ТекстовыйПарсер.КонтекстИсполнения=КонтекстыИсполнения.Сервер Тогда
		ИдентификаторыПрепроцессора["КЛИЕНТ"] = 0;
		ИдентификаторыПрепроцессора["СЕРВЕР"] = 1;
	КонецЕсли;
	
	ТекстовыйПарсер_ОбработатьДирективыПрепроцессора(ТекстовыйПарсер);
	
	УстановитьТекущееСлово(ТекстовыйПарсер, 0);
	Пока Истина Цикл
		
		Слово = ТекстовыйПарсер.ТекущееСлово;
		Если Слово.ТипСлова=Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол Тогда
			
			Если ТекстовыйПарсер_ПрочитатьДирективуКомпиляции(ТекстовыйПарсер, ГлобальнаяОбласть) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
		ИначеЕсли Слово.ТипСлова=ТипыСловИОператоров.Идентификатор Тогда
			
			Если ТекстовыйПарсер_ПрочитатьОписаниеКласса(ТекстовыйПарсер, ГлобальнаяОбласть) Тогда
				
				Продолжить;
				
			ИначеЕсли ТекстовыйПарсер_РазобратьОператорПеременные(ТекстовыйПарсер, ГлобальныйКласс, ГлобальнаяОбласть) Тогда
				
				ГлобальнаяОбласть.ДополнительныеДанные.ДирективаКомпиляции = ДирективаПоУмолчанию;
				Продолжить;
				
			ИначеЕсли ТекстовыйПарсер_РазобратьОператорПодпрограмма(ТекстовыйПарсер, ГлобальныйКласс, ГлобальнаяОбласть) Тогда
				
				ГлобальнаяОбласть.ДополнительныеДанные.ДирективаКомпиляции = ДирективаПоУмолчанию;
				Продолжить;
				
			ИначеЕсли ТекстовыйПарсер_РазобратьОператорГлавнаяПодпрограмма(ТекстовыйПарсер, ГлобальныйКласс) Тогда
				
				Продолжить;

			Иначе
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
			
		НовыйОператор(ТекстовыйПарсер, ГлобальнаяОбласть, Слово);
		СледующееСлово(ТекстовыйПарсер);
		
	КонецЦикла;
	
КонецФункции

Функция ТекстовыйПарсер_Очистить(ТекстовыйПарсер)
	
	Перем РК;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];

	ТекстовыйПарсер.ТекущийОператор = Неопределено;
	ТекстовыйПарсер.ДополнительныеДанные.СкопированныеОператоры.Очистить();
	ТекстовыйПарсер.ГлобальныйКласс = Неопределено;
	ТекстовыйПарсер.ГлобальнаяОбласть = Неопределено;
	
	РК.ОчиститьЭлементыКоллекции(ТекстовыйПарсер.ТаблицаКлассов);
	РК.ОчиститьЭлементыКоллекции(ТекстовыйПарсер.ТаблицаПодпрограмм);
	ТекстовыйПарсер_ОчиститьЗависимости(ТекстовыйПарсер);
	ТекстовыйПарсер_УстановитьИдентификаторыПрепроцессораПоУмолчанию(ТекстовыйПарсер);
	
КонецФункции

Функция ТекстовыйПарсер_ОчиститьЗависимости(ТекстовыйПарсер)
	
	ТекстовыйПарсер.Зависимости.Включения.Очистить();
	ТекстовыйПарсер.Зависимости.Использования.Очистить();
	
КонецФункции

//
//{ Препроцессор

Функция ТекстовыйПарсер_ОбработатьДирективыПрепроцессора(ТекстовыйПарсер)

	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	тСпецсивол = ТипыСловИОператоров.Спецсимвол;
	УстановитьТекущееСлово(ТекстовыйПарсер, 0);
	
	Пока Истина Цикл
		
		Слово = ТекстовыйПарсер.ТекущееСлово;
		Если Слово.ТипСлова=Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если Слово.ТипСлова=тСпецсивол И Слово.Слово="#" Тогда
			
			Если ТекстовыйПарсер_ОбработатьДирективуПрепроцессораЛогическийБлок(ТекстовыйПарсер) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекстовыйПарсер_ОбработатьДирективуПрепроцессораВключить(ТекстовыйПарсер) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекстовыйПарсер_ОбработатьДирективуПрепроцессораОпределить(ТекстовыйПарсер) Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		СледующееСлово(ТекстовыйПарсер);
		
	КонецЦикла;
	
КонецФункции

Функция ТекстовыйПарсер_ОбработатьДирективуПрепроцессораЛогическийБлок(ТекстовыйПарсер)

	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тСпецсимвол = ТипыСловИОператоров.Спецсимвол;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если НЕ (Слово.ТипСлова=тСпецсимвол И Слово.Слово="#") Тогда
		Возврат Ложь;
	КонецЕсли;
	НомерПервогоСлова = ТекстовыйПарсер.НомерТекущегоСлова;
	
	Слово = СледующееСлово(ТекстовыйПарсер);
	Директива = Слово.ВРСлово;
	Если НЕ (Директива="ЕСЛИ" ИЛИ Директива="ИНАЧЕЕСЛИ" ИЛИ Директива="ИНАЧЕ" ИЛИ Директива="ОБЛАСТЬ") Тогда
		УстановитьТекущееСлово(ТекстовыйПарсер, НомерПервогоСлова);
		Возврат Ложь;
	КонецЕсли;
	
	ЛогическиеБлоки = ТекстовыйПарсер.ЛогическиеБлоки;
	ЛогическийБлок = ЛогическиеБлоки.НачалаЛогическихБлоков[Директива];
	Если ЛогическийБлок = Неопределено Тогда
		УстановитьТекущееСлово(ТекстовыйПарсер, НомерПервогоСлова);
		Возврат Ложь;
	КонецЕсли;
	СледующееСлово(ТекстовыйПарсер);
	
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	СловаВыражения = Новый Массив;
	Если Директива="ОБЛАСТЬ" Тогда
		КлючевоеСловоНачалоЦепиБлоков = "ОБЛАСТЬ";
		КлючевоеСловоКонецЦепиБлоков = "КОНЕЦОБЛАСТИ";
		
		Если Слово.ТипСлова=тИдентификатор Тогда //Имя области
			СледующееСлово(ТекстовыйПарсер);
		КонецЕсли;
	Иначе
		КлючевоеСловоНачалоЦепиБлоков = "ЕСЛИ";
		КлючевоеСловоКонецЦепиБлоков = "КОНЕЦЕСЛИ";

		Если ЛогическийБлок.ЕстьЗаголовок Тогда
			Пока Истина Цикл
				
				Слово = ТекстовыйПарсер.ТекущееСлово;
				Если Слово.ТипСлова=тИдентификатор Тогда
					Если Слово.ВРСлово=ЛогическийБлок.КонецЗаголовка Тогда
						СледующееСлово(ТекстовыйПарсер);
						Прервать;
					КонецЕсли;
				КонецЕсли;
				
				СловаВыражения.Добавить(Слово);
				
				СледующееСлово(ТекстовыйПарсер);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	НомерСловаНачалоБлока = ТекстовыйПарсер.НомерТекущегоСлова;
	
	Если СловаВыражения.Количество() > 0 Тогда
		ИдентификаторыПрепроцессора = ТекстовыйПарсер.ИдентификаторыПрепроцессора;
		ЗарезервированныеИдентификаторы = ТекстовыйПарсер.ЗарезервированныеИдентификаторы;
		Пробел = ТекстовыйПарсер.Пробел;
		Выражение = "";
		ЭтоСловоИдентификатор = Ложь;
		ЭтоОткрывающаяСкобка = Ложь;
		ЭтоЗакрывающаяСкобка = Ложь;
		Для Каждого СловоВыражения Из СловаВыражения Цикл
			ПредыдущееСловоЭтоИдентификатор = ЭтоСловоИдентификатор;
			ПредыдущееСловоЭтоОткрывающаяСкобка = ЭтоОткрывающаяСкобка;
			ПредыдущееСловоЭтоЗакрывающаяСкобка = ЭтоЗакрывающаяСкобка;

			ЭтоСловоИдентификатор = СловоВыражения.ТипСлова=тИдентификатор;
			ЭтоОткрывающаяСкобка = СловоВыражения.ТипСлова=тСпецсимвол И СловоВыражения.Слово="(";
			ЭтоЗакрывающаяСкобка = СловоВыражения.ТипСлова=тСпецсимвол И СловоВыражения.Слово=")";
			
			Если НЕ ЭтоОткрывающаяСкобка И ЭтоСловоИдентификатор ИЛИ ПредыдущееСловоЭтоИдентификатор И НЕ ЭтоСловоИдентификатор И НЕ ЭтоЗакрывающаяСкобка Тогда
				Выражение = Выражение + Пробел;
			КонецЕсли;
			
			Если ЭтоСловоИдентификатор И ЗарезервированныеИдентификаторы[СловоВыражения.ВРСлово]=Неопределено Тогда
				ЗначениеИдентификатора = ИдентификаторыПрепроцессора[СловоВыражения.ВРСлово];
				Если ЗначениеИдентификатора=Неопределено Тогда
					ЗначениеИдентификатора = 0;
				КонецЕсли;
				Выражение = Выражение + ЗначениеИдентификатора;
			Иначе
				Выражение = Выражение + СловоВыражения.Слово;
			КонецЕсли;
		КонецЦикла;
		ЗначениеВыражения = Вычислить(Выражение);
	Иначе
		ЗначениеВыражения = Истина;
	КонецЕсли;
	
	// ищем конец блока
	Уровень = 0;
	Пока Истина Цикл
		
		Слово = ТекстовыйПарсер.ТекущееСлово;
		Если Слово.ТипСлова=Неопределено Тогда
			//ОШИБКА
			Возврат Ложь;
		КонецЕсли;
		
		Если Слово.ТипСлова=тСпецсимвол И Слово.Слово="#" Тогда
			Слово = СледующееСлово(ТекстовыйПарсер);
			
			Если Слово.ВРСлово=КлючевоеСловоНачалоЦепиБлоков Тогда
				
				Уровень = Уровень + 1;
				
			ИначеЕсли Уровень=0 Тогда
				
				Если ЛогическийБлок.Концы[Слово.ВРСлово]<>Неопределено Тогда
					Прервать;
				КонецЕсли;
				
			ИначеЕсли Слово.ВРСлово=КлючевоеСловоКонецЦепиБлоков Тогда
				
				Уровень = Уровень - 1;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СледующееСлово(ТекстовыйПарсер);
		
	КонецЦикла;
	НомерСловаКонецБлока = ТекстовыйПарсер.НомерТекущегоСлова;
	НомерСловаКонецБлока = НомерСловаКонецБлока - 1; //встанем на решетку "#"
	УстановитьТекущееСлово(ТекстовыйПарсер, НомерСловаКонецБлока);
	
	Если ЗначениеВыражения Тогда
		
		// ицем конец паравозика-цепочки условных операторов
		Уровень = 0;
		Пока Истина Цикл
			
			Слово = ТекстовыйПарсер.ТекущееСлово;
			Если Слово.ТипСлова=Неопределено Тогда
				//ОШИБКА
				Возврат Ложь;
			КонецЕсли;
			
			Если Слово.ТипСлова=тСпецсимвол И Слово.Слово="#" Тогда
				Слово = СледующееСлово(ТекстовыйПарсер);
				
				Если Слово.ВРСлово=КлючевоеСловоНачалоЦепиБлоков Тогда
					
					Уровень = Уровень + 1;
					
				ИначеЕсли Слово.ВРСлово=КлючевоеСловоКонецЦепиБлоков Тогда
					
					Если Уровень=0 Тогда
						СледующееСлово(ТекстовыйПарсер);
						Прервать;
					КонецЕсли;
					
					Уровень = Уровень - 1;
					
				КонецЕсли;
				
			КонецЕсли;
			
			СледующееСлово(ТекстовыйПарсер);
			
		КонецЦикла;
		
		НомерСловаКонецЦепиБлоков = ТекстовыйПарсер.НомерТекущегоСлова;
		
		// вырежем цепь блоков
		КоличествоСловВырезать = НомерСловаКонецЦепиБлоков-НомерСловаКонецБлока;
		Для НомерСловаВырезать=1 По КоличествоСловВырезать Цикл
			ТекстовыйПарсер.Слова.Удалить(НомерСловаКонецБлока);
		КонецЦикла;
		ТекстовыйПарсер.КоличествоСлов = ТекстовыйПарсер.КоличествоСлов-КоличествоСловВырезать;
		
		// вырежем заголовок блока
		КоличествоСловВырезать = НомерСловаНачалоБлока-НомерПервогоСлова;
		Для НомерСловаВырезать=1 По КоличествоСловВырезать Цикл
			ТекстовыйПарсер.Слова.Удалить(НомерПервогоСлова);
		КонецЦикла;
		ТекстовыйПарсер.КоличествоСлов = ТекстовыйПарсер.КоличествоСлов-КоличествоСловВырезать;
	Иначе

		// вырежем текущий блок
		Если Слово.ВРСлово=КлючевоеСловоКонецЦепиБлоков Тогда
			НомерСловаКонецБлока = НомерСловаКонецБлока + 2;
		КонецЕсли;
		
		КоличествоСловВырезать = НомерСловаКонецБлока-НомерПервогоСлова;
		Для НомерСловаВырезать=1 По КоличествоСловВырезать Цикл
			ТекстовыйПарсер.Слова.Удалить(НомерПервогоСлова);
		КонецЦикла;
		ТекстовыйПарсер.КоличествоСлов = ТекстовыйПарсер.КоличествоСлов-КоличествоСловВырезать;
		
	КонецЕсли;
	
	УстановитьТекущееСлово(ТекстовыйПарсер, НомерПервогоСлова);
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_ОбработатьДирективуПрепроцессораВключить(ТекстовыйПарсер)

	Слово = ТекстовыйПарсер.ТекущееСлово;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	Если Не (Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово="#") Тогда
		Возврат Ложь;
	КонецЕсли;
	НомерПервогоСлова = ТекстовыйПарсер.НомерТекущегоСлова;

	Слово = СледующееСлово(ТекстовыйПарсер);
	Если Не (Слово.ТипСлова=ТипыСловИОператоров.Идентификатор И Слово.ВРСлово = "ВКЛЮЧИТЬ") Тогда
		УстановитьТекущееСлово(ТекстовыйПарсер, НомерПервогоСлова);
		Возврат Ложь;
	КонецЕсли;
	
	Слово = СледующееСлово(ТекстовыйПарсер);
	ИмяПрограммногоМодуля = Слово.Слово;
	СледующееСлово(ТекстовыйПарсер);
	
	Слова = ТекстовыйПарсер.Слова;
	УдалитьСлова(ТекстовыйПарсер, НомерПервогоСлова);
	
	ДанныеМодуля = вмс_ВыполнениеПрограммногоКодаВызовСервера.ПолучитьДанныеПрограммногоМодуля(ИмяПрограммногоМодуля);
	Если ДанныеМодуля=Неопределено Тогда
		ВызватьИсключение "Программный модуль """ + ИмяПрограммногоМодуля + """ не обнаружен";
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекстовыйПарсер.Зависимости.Включения.Найти(ДанныеМодуля.Ссылка)=Неопределено Тогда
		ТекстовыйПарсер.Зависимости.Включения.Добавить(ДанныеМодуля.Ссылка);
	КонецЕсли;
	
	СловаВключенногоМодуля = Новый Массив;
	ТекстовыйПарсер.Слова = СловаВключенногоМодуля;
	ТекстовыйПарсер_УстановитьТекст(ТекстовыйПарсер, ДанныеМодуля.Текст);
	ТекстовыйПарсер_РазобратьСлова(ТекстовыйПарсер);
	
	ИндексСлова = НомерПервогоСлова;
	Для Каждого Слово Из СловаВключенногоМодуля Цикл
		Слова.Вставить(ИндексСлова, Слово);
		ИндексСлова = ИндексСлова + 1;
	КонецЦикла;
	
	ТекстовыйПарсер.Слова = Слова;
	ТекстовыйПарсер.КоличествоСлов = Слова.Количество();
	УстановитьТекущееСлово(ТекстовыйПарсер, НомерПервогоСлова);

	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_ОбработатьДирективуПрепроцессораОпределить(ТекстовыйПарсер)

	Слово = ТекстовыйПарсер.ТекущееСлово;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	Если Не (Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово="#") Тогда
		Возврат Ложь;
	КонецЕсли;
	НомерПервогоСлова = ТекстовыйПарсер.НомерТекущегоСлова;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;

	Слово = СледующееСлово(ТекстовыйПарсер);
	Если Не (Слово.ТипСлова=тИдентификатор И Слово.ВРСлово = "ОПРЕДЕЛИТЬ") Тогда
		УстановитьТекущееСлово(ТекстовыйПарсер, НомерПервогоСлова);
		Возврат Ложь;
	КонецЕсли;
	
	Слово = СледующееСлово(ТекстовыйПарсер);
	Если НЕ Слово.ТипСлова=тИдентификатор Тогда
		Возврат Ложь;
	КонецЕсли;
	НомерСтрокиИмяИдентификатора = Слово.НомерСтроки;
	ИмяИдентификатора = Слово.ВРСлово;

	Слово = СледующееСлово(ТекстовыйПарсер);
	Если Слово.НомерСтроки=НомерСтрокиИмяИдентификатора Тогда
		ЗначениеИдентификатора = Слово.ВРСлово;
		СледующееСлово(ТекстовыйПарсер);
	Иначе
		ЗначениеИдентификатора = "ИСТИНА";
	КонецЕсли;
	
	ТекстовыйПарсер.ИдентификаторыПрепроцессора[ИмяИдентификатора] = ЗначениеИдентификатора;
	
	УдалитьСлова(ТекстовыйПарсер, НомерПервогоСлова);
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_ПрочитатьДирективуКомпиляции(ТекстовыйПарсер, Область)

	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если НЕ (Слово.ТипСлова=ТипыСловИОператоров.Спецсимвол И Слово.Слово = "&") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Слово = СледующееСлово(ТекстовыйПарсер);
	Если Слово.ТипСлова<>ТипыСловИОператоров.Идентификатор Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Область.ДополнительныеДанные.ДирективаКомпиляции = Слово.ВРСлово;
	СледующееСлово(ТекстовыйПарсер);

	Возврат Истина;

КонецФункции

Функция ПолучитьПараметрыДирективыКомпиляции(Директива)
	
	ПараметрыДирективы = Новый Структура;
	ПараметрыДирективы.Вставить("Клиент", СтрНайти(Директива, "НАКЛИЕНТЕ")>0);
	ПараметрыДирективы.Вставить("Сервер", СтрНайти(Директива, "НАСЕРВЕРЕ")>0);
	ПараметрыДирективы.Вставить("Бэкенд", СтрНайти(Директива, "НАБЭКЕНДЕ")>0);
	ПараметрыДирективы.Вставить("ИспользоватьДанныеКонтекста", СтрНайти(Директива, "БЕЗКОНТЕКСТА")=0);
	
	Возврат ПараметрыДирективы;
	
КонецФункции

//
//} Препроцессор

Функция ТекстовыйПарсер_ПрочитатьОписаниеКласса(ТекстовыйПарсер, ОператорВладелец)
	
	Перем РК;
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Не (Слово.ТипСлова=тИдентификатор И Слово.ВРСлово="КЛАСС") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СловоИмяКласса = СледующееСлово(ТекстовыйПарсер);
	Если СловоИмяКласса.ТипСлова<>тИдентификатор Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяКласса = СловоИмяКласса.Слово;
	
	Класс = НовыйКласс(ТекстовыйПарсер, ИмяКласса);
	ПоместитьОператор(ТекстовыйПарсер, ОператорВладелец, Класс);
	Класс.ДополнительныеДанные.Вставить("ДирективаПоУмолчанию", "НАКЛИЕНТЕНАСЕРВЕРЕ");
	
	НовыйОператор(ТекстовыйПарсер, Класс, Слово);
	НовыйОператор(ТекстовыйПарсер, Класс, СловоИмяКласса);
	СледующееСлово(ТекстовыйПарсер);
	
	ТекстовыйПарсер_ПрочитатьПредковКласса(ТекстовыйПарсер, Класс);
	ТекстовыйПарсер_ПрочитатьМодификаторыКласса(ТекстовыйПарсер, Класс);
	
	Класс.ДополнительныеДанные.Вставить("ДирективаКомпиляции", Класс.ДополнительныеДанные.ДирективаПоУмолчанию);
	
	Пока Истина Цикл
		
		Слово = ТекстовыйПарсер.ТекущееСлово;
		Если Слово.ТипСлова=тИдентификатор Тогда
			Если Слово.ВРСлово="КОНЕЦКЛАССА" Тогда
				НовыйОператор(ТекстовыйПарсер, Класс, Слово);
				СледующееСлово(ТекстовыйПарсер);
				Прервать;
			КонецЕсли;

			Если Слово.ВРСлово="КЛАСС" Тогда
				// Допускается определение класса внутри другого класса (удобно при описании в модуле формы, который потом
				// трансформируется в класс), но при этом классы никак не связаны с друг другом(не включают другие классы, не наследуют)
				ТекстовыйПарсер_ПрочитатьОписаниеКласса(ТекстовыйПарсер, ОператорВладелец);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ТекстовыйПарсер_РазобратьОператорКласса(ТекстовыйПарсер, Класс) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	Для Каждого Переменная Из РК.ПолучитьЭлементыКоллекции(Класс.ТаблицаПеременных) Цикл
		ИмяПеременной = ВРЕГ(Переменная.Имя);
		Если Переменная.Нативный Тогда
			// Поле уже есть во встроенном объекте
			// соответственно не добавляем его в главный объект
			Класс.ИменаНативныхПолейМассив.Добавить(ИмяПеременной);
		Иначе
			Класс.Поля.Добавить(Переменная);
			Класс.ИменаПолейМассив.Добавить(ИмяПеременной);
		КонецЕсли;
	КонецЦикла;
	Класс.ИменаПолей = РК.МассивВСтроку(Класс.ИменаПолейМассив);
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_ПрочитатьПредковКласса(ТекстовыйПарсер, Класс)
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	тСпецсимвол = ТипыСловИОператоров.Спецсимвол;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Не (Слово.ТипСлова=тСпецсимвол И Слово.Слово=":") Тогда
		Возврат Ложь;
	КонецЕсли;

	НовыйОператор(ТекстовыйПарсер, Класс, Слово);
	
	Пока Истина Цикл
		
		Слово = СледующееСлово(ТекстовыйПарсер);
		Если Слово.ТипСлова=тИдентификатор Тогда
			Класс.Предки.Добавить(Слово.ВРСлово);
			НовыйОператор(ТекстовыйПарсер, Класс, Слово);
		Иначе
			Прервать;
		КонецЕсли;
			
		Слово = СледующееСлово(ТекстовыйПарсер);
		Если Слово.ТипСлова=тСпецсимвол И Слово.Слово="," Тогда
			НовыйОператор(ТекстовыйПарсер, Класс, Слово);
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;

	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_ПрочитатьМодификаторыКласса(ТекстовыйПарсер, Класс)

	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	тСпецсимвол = ТипыСловИОператоров.Спецсимвол;
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Пока Истина Цикл
		
		Если Слово.ВРСлово="ДИРЕКТИВАКОМПИЛЯЦИИПОУМОЛЧАНИЮ" Тогда
			
			Слово = СледующееСлово(ТекстовыйПарсер);
			Если Слово.ТипСлова=тИдентификатор Тогда
				ДирективаПоУмолчанию = Слово.ВРСлово;
				Класс.ДополнительныеДанные.ДирективаПоУмолчанию = ДирективаПоУмолчанию;
				Слово = СледующееСлово(ТекстовыйПарсер);
			КонецЕсли;
			
		ИначеЕсли Слово.ВРСлово="ИСПОЛЬЗОВАТЬНАТИВНЫЕМЕТОДЫ" Тогда
			
			Класс[Слово.ВРСлово] = Истина;
			Слово = СледующееСлово(ТекстовыйПарсер);
			
		ИначеЕсли Слово.ВРСлово="ИДЕНТИФИКАТОРЫУКАЗАТЕЛЕЙТЕКУЩЕГООБЪЕКТА" Тогда
			
			Класс.ИдентификаторыУказателейТекущегоОбъекта.Очистить();
			Слово = СледующееСлово(ТекстовыйПарсер);
			
			Пока Истина Цикл
				
				Если Слово.ТипСлова=тИдентификатор Тогда
					Класс.ИдентификаторыУказателейТекущегоОбъекта.Добавить(Слово.ВРСлово);
					Слово = СледующееСлово(ТекстовыйПарсер);
					Если Слово.ТипСлова=тСпецсимвол И Слово.ВРСлово="," Тогда
						Слово = СледующееСлово(ТекстовыйПарсер);
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Прервать;
				
			КонецЦикла;
			
		Иначе
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорКласса(ТекстовыйПарсер, Класс)
	
	Если ТекстовыйПарсер_ПрочитатьДирективуКомпиляции(ТекстовыйПарсер, Класс) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорПеременные(ТекстовыйПарсер, Класс, Класс) Тогда
		Класс.ДополнительныеДанные.ДирективаКомпиляции = Класс.ДополнительныеДанные.ДирективаПоУмолчанию;
		Возврат Истина;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорПодпрограмма(ТекстовыйПарсер, Класс) Тогда
		Класс.ДополнительныеДанные.ДирективаКомпиляции = Класс.ДополнительныеДанные.ДирективаПоУмолчанию;
		Возврат Истина;
	КонецЕсли;
	
	Если ТекстовыйПарсер_РазобратьОператорГлавнаяПодпрограмма(ТекстовыйПарсер, Класс) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТекстовыйПарсер_РазобратьОператорСпецсимвол(ТекстовыйПарсер, Класс) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

Функция НовыйКласс(ТекстовыйПарсер, Имя)
	
	Перем РК;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТаблицаКлассов = ТекстовыйПарсер.ТаблицаКлассов;

	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("ДирективаКомпиляции");
	
	Класс = РК.НовыйЭлементКоллекции(ТаблицаКлассов);
	Класс.ВРИмя = ВРЕГ(Имя);
	Класс.Имя = Имя;
	Класс.ДополнительныеДанные = ДополнительныеДанные;
	РК.ИндексироватьКоллекцию(ТаблицаКлассов, Класс);
	
	Класс.ТаблицаПеременных = НоваяТаблицаПеременных(ТекстовыйПарсер);
	Класс.ИдентификаторыУказателейТекущегоОбъекта = Новый Массив;
	Класс.Предки = Новый Массив;
	Класс.Поля = Новый Массив;
	Класс.ИменаПолейМассив = Новый Массив;
	Класс.ИменаНативныхПолейМассив = Новый Массив;
	Класс.Методы = Новый Массив;
	Класс.ИспользоватьНативныеМетоды = Ложь;
	Класс.Операторы = Новый Массив;
	Класс.ЛевоеЗначение = Истина;
	
	Класс.ИдентификаторыУказателейТекущегоОбъекта.Добавить("ЭТОТОБЪЕКТ");
	
	Если Класс.ВРИмя<>"БАЗОВЫЙКЛАСС" Тогда
		Класс.Предки.Добавить("БАЗОВЫЙКЛАСС");
	КонецЕсли;
	
	Возврат Класс;
	
КонецФункции

Функция НоваяПодпрограмма(ТекстовыйПарсер, Имя, Класс)

	Перем РК;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	ТаблицаПодпрограмм = ТекстовыйПарсер.ТаблицаПодпрограмм;

	Подпрограмма = РК.ДобавитьСтрокуКвазиТаблицыЗначений(ТаблицаПодпрограмм);
	
	ИнициализироватьНовуюПодпрограмму(ТекстовыйПарсер, Подпрограмма);
	Подпрограмма.ДополнительныеДанные.Класс = Класс;
	
	Подпрограмма.Имя = Имя;
	Подпрограмма.ВРИмя = ВРЕГ(Имя);
	Подпрограмма.ВРИмяКласса = Класс.ВРИмя;
	РК.ИндексироватьКоллекцию(ТаблицаПодпрограмм, Подпрограмма);
	
	Возврат Подпрограмма;

КонецФункции

Функция ИнициализироватьНовуюПодпрограмму(ТекстовыйПарсер, Подпрограмма)

	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("ДирективаКомпиляции");
	ДополнительныеДанные.Вставить("ПреобразованныеОператоры", Новый Массив);
	ДополнительныеДанные.Вставить("Описание");
	ДополнительныеДанные.Вставить("Тело");
	ДополнительныеДанные.Вставить("Класс");
	ДополнительныеДанные.Вставить("ОператорыСозданияНовыхОбъектов", Новый Массив);
	ДополнительныеДанные.Вставить("ОператорыЦиклов", Новый Массив);
	
	Подпрограмма.Объявление = Ложь;
	Подпрограмма.Нативная = Ложь;
	Подпрограмма.Экспорт = Ложь;
	Подпрограмма.НепосредственныйДоступКПолямОбъекта = Ложь;
	Подпрограмма.ТаблицаПараметров = НоваяТаблицаПараметров(ТекстовыйПарсер);
	Подпрограмма.ТаблицаПеременных = НоваяТаблицаПеременных(ТекстовыйПарсер);
	Подпрограмма.ТипОператора = ТекстовыйПарсер.ТипыСловИОператоров.Подпрограмма; //подпрограмма это большой оператор
	Подпрограмма.ЛевоеЗначение = Истина;
	Подпрограмма.Операторы = Новый Массив;
	Подпрограмма.ДополнительныеДанные = ДополнительныеДанные;

КонецФункции

Функция НоваяТаблицаПараметров(ТекстовыйПарсер)
	
	Перем РК;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];

	ТаблицаПараметров = РК.НоваяКвазиТаблицаЗначений("Имя, ВРИмя, ПоЗначению, ЗначениеПоУмолчанию");
	
	Возврат ТаблицаПараметров;
	
КонецФункции

Функция НоваяТаблицаПеременных(ТекстовыйПарсер)
	
	Перем РК;
	
	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];

	ТаблицаПеременных = РК.НоваяКвазиТаблицаЗначений("Имя, Экспорт, Нативный");
	
	Возврат ТаблицаПеременных;
	
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорГлавнаяПодпрограмма(ТекстовыйПарсер, Класс)
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Слово.ТипСлова <> тИдентификатор Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтопСлова = Новый Соответствие;
	СтопСлова["ПРОЦЕДУРА"] = Истина;
	СтопСлова["ФУНКЦИЯ"] = Истина;
	СтопСлова["КЛАСС"] = Истина;
	СтопСлова["КОНЕЦКЛАССА"] = Истина;
	Если СтопСлова[Слово.ВРСлово]=Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КонтекстИсполнения = ТекстовыйПарсер.КонтекстИсполнения;
	КонтекстыИсполнения = ТекстовыйПарсер.КонтекстыИсполнения;
	
	Если КонтекстИсполнения=КонтекстыИсполнения.Клиент Тогда
		ИмяДирективыПодпрограммы = "НАКЛИЕНТЕ";
	ИначеЕсли КонтекстИсполнения=КонтекстыИсполнения.Сервер Тогда
		ИмяДирективыПодпрограммы = "НАСЕРВЕРЕ";
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	
	Подпрограмма = НоваяПодпрограмма(ТекстовыйПарсер, "@ГЛАВНАЯ@", Класс);
	Подпрограмма.Директива = ТекстовыйПарсер.ДирективыКонтекстовИсполнения[ИмяДирективыПодпрограммы];
	Подпрограмма.Тип = "ФУНКЦИЯ";
	Подпрограмма.НомерСтроки = Слово.НомерСтроки;
	
	ПоместитьОператор(ТекстовыйПарсер, ТекстовыйПарсер.ГлобальнаяОбласть, Подпрограмма);

	опТелоПодпрограммы = НовыйОператор(ТекстовыйПарсер, Подпрограмма, Слово(ТипыСловИОператоров.ТелоЛогическогоБлока));
	
	Пока Истина Цикл
		
		Слово = ТекстовыйПарсер.ТекущееСлово;
		Если Слово.ТипСлова=Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		Если Слово.ТипСлова=тИдентификатор Тогда
			
			Если СтопСлова[Слово.ВРСлово]=Истина Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ТекстовыйПарсер_РазобратьОператорПодпрограммы(ТекстовыйПарсер, Подпрограмма, опТелоПодпрограммы) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Подпрограмма.ДополнительныеДанные.Тело = опТелоПодпрограммы;
	
	Возврат Истина;
	
КонецФункции

Функция ТекстовыйПарсер_ПропуститьОператорПодпрограмма(ТекстовыйПарсер)

	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;

	Пока Истина Цикл
		
		Слово = ТекстовыйПарсер.ТекущееСлово;
		Если Слово.ТипСлова=Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если Слово.ТипСлова=тИдентификатор Тогда
			
			ВРСлово = Слово.ВРСлово;
			Если ВРСлово="КОНЕЦФУНКЦИИ" ИЛИ ВРСлово="КОНЕЦПРОЦЕДУРЫ" Тогда
				СледующееСлово(ТекстовыйПарсер);
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
		СледующееСлово(ТекстовыйПарсер);
		
	КонецЦикла;
	
	Возврат Истина;
		
КонецФункции

Функция ТекстовыйПарсер_РазобратьОператорПодпрограмма(ТекстовыйПарсер, Класс, знач ОператорВладелец=Неопределено)

	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Слово.ТипСлова<>тИдентификатор Тогда
		Возврат Ложь;
	КонецЕсли;
	
	слТипПодпрограммы = Слово;
	ТипПодпрограммы = слТипПодпрограммы.ВРСлово;
	Если НЕ (ТипПодпрограммы="ПРОЦЕДУРА" ИЛИ ТипПодпрограммы="ФУНКЦИЯ") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеОшибки = ТекстовыйПарсер.ОписаниеОшибки;
	
	Если ОператорВладелец=Неопределено Тогда
		ОператорВладелец = Класс;
	КонецЕсли;
	
	ДирективаКомпиляции = ОператорВладелец.ДополнительныеДанные.ДирективаКомпиляции;
	
	слИмяПодпрограммы = СледующееСлово(ТекстовыйПарсер);
	ИмяПодпрограммы = слИмяПодпрограммы.Слово;
	СледующееСлово(ТекстовыйПарсер);
	
	КонтекстИсполнения = ТекстовыйПарсер.КонтекстИсполнения;
	КонтекстыИсполнения = ТекстовыйПарсер.КонтекстыИсполнения;
	ПараметрыДирективыКомпиляции = ПолучитьПараметрыДирективыКомпиляции(ДирективаКомпиляции);
	КонтекстИсполненияПодпрограммы = Неопределено;
	ВызовСервера = Ложь;
	Если ПараметрыДирективыКомпиляции[КонтекстИсполнения] Тогда
		// подпрограмма выполняется в текущем контексте
		КонтекстИсполненияПодпрограммы = КонтекстИсполнения;
	ИначеЕсли КонтекстИсполнения=КонтекстыИсполнения.Клиент Тогда
		// с клиента возможен вызов других контекстов исполнения
		Если ПараметрыДирективыКомпиляции.Сервер Тогда
			КонтекстИсполненияПодпрограммы = КонтекстыИсполнения.Сервер;
			ВызовСервера = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если КонтекстИсполненияПодпрограммы=Неопределено Тогда
		// Подпрограмма не предназначена для данного контекста исполнения
		Возврат ТекстовыйПарсер_ПропуститьОператорПодпрограмма(ТекстовыйПарсер);
	КонецЕсли;
		
	Подпрограмма = НоваяПодпрограмма(ТекстовыйПарсер, ИмяПодпрограммы, Класс);
	Подпрограмма.Тип = ТипПодпрограммы;
	Подпрограмма.НомерСтроки = слТипПодпрограммы.НомерСтроки;
	
	ПоместитьОператор(ТекстовыйПарсер, ОператорВладелец, Подпрограмма);

	опОписаниеПодпрограммы = НовыйОператор(ТекстовыйПарсер, Подпрограмма, Слово(ТипыСловИОператоров.ЗаголовокЛогическогоБлока));
	Подпрограмма.ДополнительныеДанные.Описание = опОписаниеПодпрограммы;

	НовыйОператор(ТекстовыйПарсер, опОписаниеПодпрограммы, слТипПодпрограммы);
	НовыйОператор(ТекстовыйПарсер, опОписаниеПодпрограммы, слИмяПодпрограммы);
	ТекстовыйПарсер_РазобратьПараметрыОписанияПодпрограммы(ТекстовыйПарсер, Подпрограмма, опОписаниеПодпрограммы, ОписаниеОшибки);
	Если ОписаниеОшибки.Ошибка Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстовыйПарсер_ПрочитатьМодификаторыПодпрограммы(ТекстовыйПарсер, Подпрограмма);

	Если КонтекстИсполненияПодпрограммы=КонтекстыИсполнения.Клиент Тогда
		ИмяДирективыПодпрограммы = "НАКЛИЕНТЕ";
	ИначеЕсли КонтекстИсполненияПодпрограммы=КонтекстыИсполнения.Сервер Тогда
		ИмяДирективыПодпрограммы = "НАСЕРВЕРЕ";
	КонецЕсли;
	
	Если НЕ ПараметрыДирективыКомпиляции.ИспользоватьДанныеКонтекста Тогда
		ИмяДирективыПодпрограммы = ИмяДирективыПодпрограммы + "БЕЗКОНТЕКСТА";
	КонецЕсли;
	
	Подпрограмма.Директива = ТекстовыйПарсер.ДирективыКонтекстовИсполнения[ИмяДирективыПодпрограммы];

	Подпрограмма.Объявление = Подпрограмма.Нативная ИЛИ КонтекстИсполненияПодпрограммы<>КонтекстИсполнения;
	
	Если Подпрограмма.Объявление Тогда
		
		// только заголовок подпрограммы
		Если Не ТекстовыйПарсер_ПропуститьОператорПодпрограмма(ТекстовыйПарсер) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		НовыйРазделительОператоров(ТекстовыйПарсер, ОператорВладелец);
		
	Иначе
		
		// полный код подпрограммы
		Подпрограмма.ДополнительныеДанные.ДирективаКомпиляции = ДирективаКомпиляции;
		опТелоПодпрограммы = НовыйОператор(ТекстовыйПарсер, Подпрограмма, Слово(ТипыСловИОператоров.ТелоЛогическогоБлока));
		опТелоПодпрограммы.НомерСтроки = Неопределено;
		
		Пока Истина Цикл
			
			Слово = ТекстовыйПарсер.ТекущееСлово;
			Если Слово.ТипСлова=тИдентификатор Тогда
				
				ВРСлово = Слово.ВРСлово;
				Если ВРСлово="КОНЕЦФУНКЦИИ" ИЛИ ВРСлово="КОНЕЦПРОЦЕДУРЫ" Тогда
					НовыйОператор(ТекстовыйПарсер, Подпрограмма, Слово);
					СледующееСлово(ТекстовыйПарсер);
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ТекстовыйПарсер_РазобратьОператорПодпрограммы(ТекстовыйПарсер, Подпрограмма, опТелоПодпрограммы) Тогда
				Возврат Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		Подпрограмма.ДополнительныеДанные.Тело = опТелоПодпрограммы;
		
	КонецЕсли;

	Возврат Истина;
			
КонецФункции

Функция ТекстовыйПарсер_ПрочитатьМодификаторыПодпрограммы(ТекстовыйПарсер, Подпрограмма)

	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тИдентификатор = ТипыСловИОператоров.Идентификатор;
	
	опОписаниеПодпрограммы = Подпрограмма.ДополнительныеДанные.Описание;

	Слово = ТекстовыйПарсер.ТекущееСлово;
	Пока Истина Цикл
		
		Если Слово.ТипСлова=тИдентификатор Тогда
			Если Слово.ВРСлово="ЭКСПОРТ" ИЛИ Слово.ВРСлово="НАТИВНАЯ" ИЛИ Слово.ВРСлово="НЕПОСРЕДСТВЕННЫЙДОСТУПКПОЛЯМОБЪЕКТА" Тогда
				НовыйОператор(ТекстовыйПарсер, опОписаниеПодпрограммы, Слово);
				Подпрограмма[Слово.ВРСлово] = Истина;
				Слово = СледующееСлово(ТекстовыйПарсер);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Прервать;
		
	КонецЦикла;

КонецФункции

Функция ТекстовыйПарсер_РазобратьПараметрыОписанияПодпрограммы(ТекстовыйПарсер, Подпрограмма, ОператорВладелец, ОписаниеОшибки)
	
	Перем РК;
	
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;

	Слово = ТекстовыйПарсер.ТекущееСлово;
	Если Не (Слово.ТипСлова = ТипыСловИОператоров.Спецсимвол И Слово.Слово = "(") Тогда
		ОписаниеОшибки.Ошибка = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	опСкобки = НовыйОператор(ТекстовыйПарсер, ОператорВладелец, Слово(ТипыСловИОператоров.Скобки));
	НовыйОператор(ТекстовыйПарсер, опСкобки, Слово);
	СледующееСлово(ТекстовыйПарсер);

	РК = ТекстовыйПарсер.ДополнительныеДанные.ОбщиеМодули["РаботаСКоллекциями"];
	
	НайденаЗакрываюшаяСкобка = Ложь;
	Этап = 1;
	ПрочитатьЗначениеПоУмолчанию = Ложь;
	ПараметрПоЗначению = Ложь;
	ТаблицаПараметров = Подпрограмма.ТаблицаПараметров;
	СтрокаПараметра = Неопределено;

	Пока Истина Цикл
		
		Слово = ТекстовыйПарсер.ТекущееСлово;
		Если Слово.ТипСлова=Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если ПрочитатьЗначениеПоУмолчанию Тогда
			
			ПрочитатьЗначениеПоУмолчанию = Ложь;
			ЗначениеПоУмолчанию = НовыйОператор(ТекстовыйПарсер, опСкобки);
			Если ТекстовыйПарсер_РазобратьОператорПодпрограммы(ТекстовыйПарсер, опСкобки, ЗначениеПоУмолчанию) Тогда
				ТекстовыйПарсер_СформироватьКодОператора(ТекстовыйПарсер, ЗначениеПоУмолчанию);
				СтрокаПараметра.ЗначениеПоУмолчанию = ЗначениеПоУмолчанию;
				Продолжить;
			КонецЕсли;
			
		ИначеЕсли Слово.ТипСлова = ТипыСловИОператоров.Идентификатор Тогда
			
			Если Этап = 1 И НРЕГ(Слово.Слово) = "знач" Тогда
				ПараметрПоЗначению = Истина;
			ИначеЕсли Этап = 3 Тогда
				ОписаниеОшибки.Ошибка = Истина;
				Прервать;
			Иначе
				СтрокаПараметра = РК.ДобавитьЭлементКоллекции(ТаблицаПараметров);
				СтрокаПараметра.Имя = Слово.Слово;
				СтрокаПараметра.ВРИмя = Слово.ВРСлово;
				СтрокаПараметра.ПоЗначению = ПараметрПоЗначению;
			КонецЕсли;

			НовыйОператор(ТекстовыйПарсер, опСкобки, Слово);
			
			Этап = Этап + 1;
			
		ИначеЕсли Слово.ТипСлова = ТипыСловИОператоров.Спецсимвол Тогда
			
			Если Слово.Слово = "," Тогда
				Этап = 1;
				ПараметрПоЗначению = Ложь;
			ИначеЕсли Слово.Слово = "=" Тогда
				ПрочитатьЗначениеПоУмолчанию = Истина;
			ИначеЕсли Слово.Слово = ")" Тогда
				НайденаЗакрываюшаяСкобка = Истина;
				СледующееСлово(ТекстовыйПарсер);
			Иначе
				ОписаниеОшибки.Ошибка = Истина;
				Прервать;
			КонецЕсли;
			
			НовыйОператор(ТекстовыйПарсер, опСкобки, Слово);
			Если НайденаЗакрываюшаяСкобка Тогда
				Прервать;
			КонецЕсли;
			
		Иначе
			
			ОписаниеОшибки.Ошибка = Истина;
			Прервать;
			
		КонецЕсли;
		
		СледующееСлово(ТекстовыйПарсер);
		
	КонецЦикла;
	
	Если Не НайденаЗакрываюшаяСкобка Тогда
		ОписаниеОшибки.Ошибка = Истина;
	КонецЕсли;
	
	Если ОписаниеОшибки.Ошибка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаПараметров;
	
КонецФункции

