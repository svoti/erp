			опОбъект.Код = слНативныйОбъект.Слово;
				
			НовыйРазделительОператоров(ТекстовыйПарсер, , ТочкаИнжекции);
			
			// вставим проверку необходимости вызова встроенного метода 1с
			опУсловныйОператор = НовыйУсловныйОператор(ТекстовыйПарсер, , ТочкаИнжекции);
			опУсловие = опУсловныйОператор.ДополнительныеДанные.Заголовок;
				НовыйОператор(ТекстовыйПарсер, опУсловие, слВыполнитьНативныйМетод);
			
			опТело = опУсловныйОператор.ДополнительныеДанные.Тело;
			ПоместитьОператор(ТекстовыйПарсер, опТело, опГруппа);
		КонецЕсли;

	КонецЦикла;

	слИмяКласса = слНеопределено;
	слУстановитьЗначениеПоля = Слово(тСтрока, "УСТАНОВИТЬЗНАЧЕНИЕПОЛЯ");
	слПолучитьЗначениеПоля = Слово(тСтрока, "ПОЛУЧИТЬЗНАЧЕНИЕПОЛЯ");
	Для Каждого Оператор Из ОператорыУстановкиПолученияЗначенийПолей Цикл
		
		Если Оператор.Операторы.Количество()<>3 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Оператор.Операторы[1].Код<>"." Тогда
			Продолжить;
		КонецЕсли;
		
		опОбъект = Оператор.Операторы[0];
		опПоле = Оператор.Операторы[2];
		
		ОператорРодитель = Оператор.Родитель;
		
		Если ОператорРодитель.ТипОператора=тПрисвоениеЗначения Тогда
			
			опПрисвоениеЗначения = ОператорРодитель;
			опЛевоеЗначение = опПрисвоениеЗначения.Операторы[0];
			опПравоеЗначение = опПрисвоениеЗначения.Операторы[2];
			ТочкаИнжекции = опПрисвоениеЗначения;
			
			Если Оператор.ЛевоеЗначение Тогда

				// установка значения поля
				опВызовПодпрограммы = НовыйОператорВызовПодпрограммы(ИмяОбработчикаВызовПодпрограммы, ТекстовыйПарсер, , ТочкаИнжекции); 
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						СкопироватьОператор(ТекстовыйПарсер, опОбъект, опПараметрВызова);
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						НовыйОператор(ТекстовыйПарсер, опПараметрВызова, слИмяКласса);
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						НовыйОператор(ТекстовыйПарсер, опПараметрВызова, слУстановитьЗначениеПоля);
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						НовыйОператор(ТекстовыйПарсер, опПараметрВызова, слПроцессорКода);
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						НовыйОператор(ТекстовыйПарсер, опПараметрВызова, Слово(тСтрока, опПоле.Код));
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						СкопироватьОператор(ТекстовыйПарсер, опПравоеЗначение, опПараметрВызова);
				
			Иначе

				// получить значения поля
				опПрисвоениеЗначенияОпределяемый = НовыйОператорПрисвоениеЗначение(СкопироватьОператор(ТекстовыйПарсер, опЛевоеЗначение), Неопределено, ТекстовыйПарсер, , ТочкаИнжекции); 
				
				опВызовПодпрограммы = НовыйОператорВызовПодпрограммы(ИмяОбработчикаВызовПодпрограммы, ТекстовыйПарсер, опПрисвоениеЗначенияОпределяемый); 
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						СкопироватьОператор(ТекстовыйПарсер, опОбъект, опПараметрВызова);
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						НовыйОператор(ТекстовыйПарсер, опПараметрВызова, слИмяКласса);
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						НовыйОператор(ТекстовыйПарсер, опПараметрВызова, слПолучитьЗначениеПоля);
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						НовыйОператор(ТекстовыйПарсер, опПараметрВызова, слПроцессорКода);
					опПараметрВызова = ДобавитьПараметрВызоваПодпрограммы(опВызовПодпрограммы, ТекстовыйПарсер);
						НовыйОператор(ТекстовыйПарсер, опПараметрВызова, Слово(тСтрока, опПоле.Код));

			КонецЕсли;
			
			// вставим проверку необходимости вызова встроенного метода 1с
			НовыйРазделительОператоров(ТекстовыйПарсер, , ТочкаИнжекции);
			опУсловныйОператор = НовыйУсловныйОператор(ТекстовыйПарсер, , ТочкаИнжекции);
			опУсловие = опУсловныйОператор.ДополнительныеДанные.Заголовок;
				НовыйОператор(ТекстовыйПарсер, опУсловие, слВыполнитьНативныйМетод);
			
			опТело = опУсловныйОператор.ДополнительныеДанные.Тело;
			ПоместитьОператор(ТекстовыйПарсер, опТело, опПрисвоениеЗначения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьПреобразования;
	
КонецФункции

Функция КомпиляторКода_РазвернутьВыраженияПодпрограммы(КомпиляторКода, Подпрограмма) Экспорт
	
	ТекстовыйПарсер = КомпиляторКода.ТекстовыйПарсер;
	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	
	ТипВыражение = ТипыСловИОператоров.Выражение;
	ТипОперацияВыражения = ТипыСловИОператоров.ОперацияВыражения;
	ТипИдентификатор = ТипыСловИОператоров.Идентификатор;
	ТипПравоеЗначение = ТипыСловИОператоров.ПравоеЗначение;
	ТипСкобки = ТипыСловИОператоров.Скобки;

	СловоИ = Слово(ТипИдентификатор, "И");
	СловоИстины = Слово(ТипИдентификатор, "ИСТИНА");
	
	Подпрограмма.ДополнительныеДанные.Вставить("НомерВыражения", 1);
	Подпрограмма.ДополнительныеДанные.Вставить("НомерРезультатаВыражения", 1);

	ОбходОператоров = Новый Массив;
	ОбходОператоров.Добавить(Подпрограмма);
	Для Каждого Оператор Из ОбходОператоров Цикл
		
		ЭтоЛогическоеВыражение = Ложь;
		Если Оператор.ТипОператора=ТипВыражение Тогда
			
			ОператорВыражение = Оператор;
			ОперандыВыражения = Новый Массив;
			Для Каждого ОператорВыражения Из ОператорВыражение.Операторы Цикл
				
				Если ОператорВыражения.ТипОператора=ТипОперацияВыражения Тогда
					Если Не ЭтоЛогическоеВыражение Тогда
						КодОперации = ВРег(ОператорВыражения.Код);
						Если КодОперации="И" ИЛИ КодОперации="ИЛИ" Тогда
							ЭтоЛогическоеВыражение = Истина;
						КонецЕсли;
					КонецЕсли;
				Иначе
					ОперандыВыражения.Добавить(ОператорВыражения);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЭтоЛогическоеВыражение Тогда
			
			// Особенность логических выражений в том,
			// что результат одного операнда влияет на то, будут ли рассчитаны результаты следующих операндов или нет
			
			Если ОператорВыражение.ДополнительныеДанные.Свойство("ОбработкаВыражения") Тогда
				// заполнены параметры обработки вложенного выражения
				ОбработкаВыражения = ОператорВыражение.ДополнительныеДанные.ОбработкаВыражения;
				ОператорПрисвоенияРезультатаВыражения = ОбработкаВыражения.ОператорПрисвоенияРезультатаВыражения;
				ТочкаЭкстракции = ОбработкаВыражения.ТочкаЭкстракции;
				ИмяПеременнойРезультатВыражения = ОбработкаВыражения.ИмяПеременнойРезультатВыражения;

				// Для первого операнда можно использовать существующий оператор присвоения, в котором находится текущее выражение
				// вытащим выражение из оператора присвоения и оставим там лишь первый операнд
				ПервыйОперанд = ОперандыВыражения[0];
				ПоместитьОператор(ТекстовыйПарсер, ОператорВыражение.Родитель, ПервыйОперанд, ОператорВыражение);
				ПоместитьОператор(ТекстовыйПарсер, ТочкаЭкстракции.Родитель, ОператорВыражение, ТочкаЭкстракции);
				ВложенноеВыражение = Истина;
			Иначе
				// новое выражение
				ОператорПрисвоенияРезультатаВыражения = Неопределено;
				ТочкаЭкстракции = КомпиляторКода_ПолучитьТочкуЭкстракцииВыражения(ТекстовыйПарсер, ОператорВыражение);
				ИмяПеременнойРезультатВыражения = "РезультатВыражения" + Формат(Подпрограмма.ДополнительныеДанные.НомерРезультатаВыражения, "ЧГ=0");
				Подпрограмма.ДополнительныеДанные.НомерРезультатаВыражения = Подпрограмма.ДополнительныеДанные.НомерРезультатаВыражения + 1;
				ВложенноеВыражение = Ложь;
			КонецЕсли;
			
			ИмяМеткиКонцаВыражения = "~КонецВыражения" + Формат(Подпрограмма.ДополнительныеДанные.НомерВыражения, "ЧГ=0");
			Подпрограмма.ДополнительныеДанные.НомерВыражения = Подпрограмма.ДополнительныеДанные.НомерВыражения + 1;

			КодУсловногоПерехода = "Если ";
			Если КодОперации="И" Тогда
				КодУсловногоПерехода = КодУсловногоПерехода + "НЕ ";
			КонецЕсли;
			КодУсловногоПерехода = КодУсловногоПерехода + ИмяПеременнойРезультатВыражения + " Тогда Перейти " + ИмяМеткиКонцаВыражения + " КонецЕсли";

			СловоРезультатВыражения = Слово(ТипИдентификатор, ИмяПеременнойРезультатВыражения);
			ПоследнийОперанд = ОперандыВыражения[ОперандыВыражения.ВГраница()];
			Для Каждого ОперандВыражения Из ОперандыВыражения Цикл
				
				Если ОператорПрисвоенияРезультатаВыражения=Неопределено Тогда
					ОператорРезультатВыражения = НовыйОператор(ТекстовыйПарсер, ТочкаЭкстракции.Родитель, СловоРезультатВыражения, ТочкаЭкстракции);
					ОператорПрисвоенияРезультатаВыражения = НовыйОператорПрисвоениеЗначение(ОператорРезультатВыражения, ОперандВыражения, ТекстовыйПарсер, , ТочкаЭкстракции);
					НовыйРазделительОператоров(ТекстовыйПарсер, , ТочкаЭкстракции);
				КонецЕсли;
				
				Если ОперандВыражения=ПоследнийОперанд Тогда
					ОператорУсловногоПереходаИлиКонецВыражения = НовыйОператор(ТекстовыйПарсер, ТочкаЭкстракции.Родитель, Слово(ТипИдентификатор, ИмяМеткиКонцаВыражения+":"), ТочкаЭкстракции);
				Иначе
					ОператорУсловногоПереходаИлиКонецВыражения = НовыйОператор(ТекстовыйПарсер, ТочкаЭкстракции.Родитель, Слово("ПростоКод", КодУсловногоПерехода), ТочкаЭкстракции);
					НовыйРазделительОператоров(ТекстовыйПарсер, , ТочкаЭкстракции);
				КонецЕсли;

				ОбработкаВыражения = Новый Структура;
				ОбработкаВыражения.Вставить("ОператорПрисвоенияРезультатаВыражения", ОператорПрисвоенияРезультатаВыражения);
				ОбработкаВыражения.Вставить("ТочкаЭкстракции", ОператорУсловногоПереходаИлиКонецВыражения);
				ОбработкаВыражения.Вставить("ИмяПеременнойРезультатВыражения", ИмяПеременнойРезультатВыражения);
				ОперандВыражения.ДополнительныеДанные.Вставить("ОбработкаВыражения", ОбработкаВыражения);

				ОбходОператоров.Добавить(ОперандВыражения);
				
				ОператорПрисвоенияРезультатаВыражения = Неопределено;
				
			КонецЦикла;
			
			Если ВложенноеВыражение Тогда
				УдалитьОператор(ОператорВыражение);
			Иначе
				// Само выражение подменим идентификатором переменной, в которой рассчитан результат выражения
				ОператорВыражение.Операторы.Очистить();
				НовыйОператор(ТекстовыйПарсер, ОператорВыражение, Слово(ТипИдентификатор, ИмяПеременнойРезультатВыражения));
				// для преобразования выражения в булевый тип
				НовыйОператор(ТекстовыйПарсер, ОператорВыражение, СловоИ);
				НовыйОператор(ТекстовыйПарсер, ОператорВыражение, СловоИстины);
			КонецЕсли;
	
		Иначе
			
			Если Оператор.ДополнительныеДанные.Свойство("ОбработкаВыражения") Тогда
				// оператор выражения
				Если Оператор.ТипОператора=ТипСкобки Тогда
					// Скобки в выражении можно раскрыть так, как операторы уже сгруппированы с учетом приоритетов операций
					ОператорСкобки = Оператор;
					ОператорВыражение = ОператорСкобки.Операторы[1];
					ОператорВыражение.ДополнительныеДанные.Вставить("ОбработкаВыражения", ОператорСкобки.ДополнительныеДанные.ОбработкаВыражения);
					ПоместитьОператор(ТекстовыйПарсер, ОператорСкобки.Родитель, ОператорВыражение, ОператорСкобки);
					УдалитьОператор(ОператорСкобки);
					
					ОбходОператоров.Добавить(ОператорВыражение);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Для Каждого СубОператор Из Оператор.Операторы Цикл
				ОбходОператоров.Добавить(СубОператор);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат Истина;
	
КонецФункции

Функция КомпиляторКода_ПолучитьТочкуЭкстракцииВыражения(ТекстовыйПарсер, ОператорВыражение)

	ТипыСловИОператоров = ТекстовыйПарсер.ТипыСловИОператоров;
	тТелоЛогическогоБлока = ТипыСловИОператоров.ТелоЛогическогоБлока;
	
	Оператор = ОператорВыражение;
	Пока Истина Цикл
		
		ОператорРодитель = Оператор.Родитель;
		Если ОператорРодитель=Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если ОператорРодитель.ТипОператора=тТелоЛогическогоБлока Тогда
			Возврат Оператор;
		КонецЕсли;
		
		Оператор = ОператорРодитель;
		
	КонецЦикла;
	
КонецФункции

