Функция ВыполнитьКод(Код) Экспорт
	
	ПроцессорКода = НовыйПроцессорКода();
	КомпиляторКода_Скомпилировать(ПроцессорКода.КомпиляторКода, Код);
	ПроцессорКода_ЗаполнитьДанныеДляВыполненияКода(ПроцессорКода);
	
	ДанныеДляВыполненияКода = ПроцессорКода.ДанныеДляВыполненияКода;

	ИмяГлобальногоКласса = ПроцессорКода.КомпиляторКода.ТекстовыйПарсер.ГлобальныйКласс.ВРИмя;
	Если ДанныеДляВыполненияКода.ДанныеКлассов[ИмяГлобальногоКласса].КодыПодпрограмм["@ГЛАВНАЯ@"] <> Неопределено Тогда
		Результат = ВызовПодпрограммы(Неопределено, "", "@ГЛАВНАЯ@", ДанныеДляВыполненияКода);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГлобальныйПроцессорКода() Экспорт
	
	Перем ОбщегоНазначенияКлиентСервер;
	
	ОбщегоНазначенияКлиентСервер = глОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	ПроцессорКода = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрПриложения("ПроцессорКода");
	Если ПроцессорКода=Неопределено Тогда
		ПроцессорКода = НовыйПроцессорКода();
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрПриложения("ПроцессорКода", ПроцессорКода);
	КонецЕсли;
	
	Возврат ПроцессорКода;
	
КонецФункции

Функция НовыйПроцессорКода() Экспорт
	
	Перем РК;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	КомпоновщикКода = НовыйКомпоновщикКода();
	
	ДанныеВыполненияМетода = Новый Структура;
	ДанныеВыполненияМетода.Вставить("ВыполнитьНативныйМетод", Ложь);
	ДанныеВыполненияМетода.Вставить("НативныйОбъект");
	
	ПроцессорКода = Новый Структура;
	ПроцессорКода.Вставить("КонтекстыИсполнения", КомпоновщикКода.КонтекстыИсполнения);
	ПроцессорКода.Вставить("КонтекстИсполнения", КомпоновщикКода.КонтекстИсполнения);
	ПроцессорКода.Вставить("КомпоновщикКода", КомпоновщикКода);
	ПроцессорКода.Вставить("СтекВызововПодпрограмм", Новый Массив);
	ПроцессорКода.Вставить("ДанныеВыполненияМетода", ДанныеВыполненияМетода);
	ПроцессорКода.Вставить("ДанныеДляВыполненияКода");
	ПроцессорКода.Вставить("ТекущиеДанныеДляВыполненияКода");
	ПроцессорКода.Вставить("ИдентификаторНовогоОбъекта", 1);
	ПроцессорКода.Вставить("ПулОбъектов", Новый Соответствие);
	ПроцессорКода.Вставить("ТипыОписанийПодпрограмм", КомпоновщикКода.ТипыОписанийПодпрограмм);
	ПроцессорКода.Вставить("ЕстьДанныеКомпиляции", Ложь);
	ПроцессорКода.Вставить("ЕстьДанныеВыполнения", Ложь);
	
	Возврат ПроцессорКода;
	
КонецФункции

Функция ПроцессорКода_ЗаполнитьДанныеДляВыполненияКода(ПроцессорКода) Экспорт
	
	Перем РК;
	
	КомпоновщикКода = ПроцессорКода.КомпоновщикКода;
	ДанныеКомпиляции = КомпоновщикКода.Данные;
	Если НЕ ДанныеКомпиляции.Свойство(ПроцессорКода.КонтекстИсполнения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеКомпиляцииГлавногоКонтекстаИсполнения = ДанныеКомпиляции[ПроцессорКода.КонтекстИсполнения];
	Если НЕ ДанныеКомпиляцииГлавногоКонтекстаИсполнения.Свойство("СДаннымиКонтекста") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РК = глОбщийМодуль("РаботаСКоллекциями");
	
	ДанныеДляВыполненияКода = ДанныеКомпиляцииГлавногоКонтекстаИсполнения.СДаннымиКонтекста;
	
	ТипыОписанийПодпрограмм = КомпоновщикКода.ТипыОписанийПодпрограмм;
	
	Для Каждого ДанныеДляВыполненияКодаКонтекста Из КомпоновщикКода.ДанныеМассив Цикл
		
		// обновим данные при переходе в другой контекст исполнения
		ДанныеДляВыполненияКодаКонтекста.Вставить("ОбновитьДанныеКонтекстаИсполнения", Истина);
		
		ОбщиеОбъектыКлассов = Новый Структура;
		ДанныеДляВыполненияКодаКонтекста.Вставить("ОбщиеОбъектыКлассов", ОбщиеОбъектыКлассов);

		Для Каждого ЭлементДанныеКласса Из ДанныеДляВыполненияКодаКонтекста.ДанныеКлассов Цикл
			
			ДанныеКласса = ЭлементДанныеКласса.Значение;

			Для Каждого ЭлементОписанияПодпрограммы Из ДанныеКласса.ОписанияПодпрограмм Цикл
				ОписаниеПодпрограммы = ЭлементОписанияПодпрограммы.Значение;
				Если ОписаниеПодпрограммы.Тип=ТипыОписанийПодпрограмм.Переход Тогда
					ДирективаПерехода = ОписаниеПодпрограммы.Данные;
					ДанныеДляВыполненияКодаКонтекстаИсполненияПослеПерехода = ДанныеКомпиляции[ДирективаПерехода.КонтекстИсполнения];
					Если ДирективаПерехода.ИспользоватьДанныеКонтекста Тогда
						ДанныеДляВыполненияКодаКонтекстаИсполненияПослеПерехода = ДанныеДляВыполненияКодаКонтекстаИсполненияПослеПерехода.СДаннымиКонтекста;
					Иначе
						ДанныеДляВыполненияКодаКонтекстаИсполненияПослеПерехода = ДанныеДляВыполненияКодаКонтекстаИсполненияПослеПерехода.БезДанныхКонтекста;
					КонецЕсли;
					ОписаниеПодпрограммы.Данные = ДанныеДляВыполненияКодаКонтекстаИсполненияПослеПерехода;
				КонецЕсли;
			КонецЦикла;
			
			//ИмяКласса = ЭлементДанныеКласса.Ключ;
			//Если ИмяКласса<>"" Тогда
			//	ПроцессорКода.ТекущиеДанныеДляВыполненияКода = ДанныеДляВыполненияКодаКонтекста;
			//	ОбщийОбъектКласса = вмс_КлассныеОбъекты.НовыйОбъект(ИмяКласса, , ПроцессорКода);
			//	ОбщиеОбъектыКлассов.Вставить(ИмяКласса, ОбщийОбъектКласса);
			//КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПроцессорКода.ДанныеДляВыполненияКода = ДанныеДляВыполненияКода;
	ПроцессорКода.ТекущиеДанныеДляВыполненияКода = ДанныеДляВыполненияКода;
	
КонецФункции

Функция ПроцессорКода_ДобавитьПрограммныйМодуль(ПрограммныйМодуль) Экспорт
	
	ПроцессорКода = ГлобальныйПроцессорКода();
	
	Если КомпоновщикКода_Скомпилировать(ПроцессорКода.КомпоновщикКода, ПрограммныйМодуль) Тогда
		ПроцессорКода_ЗаполнитьДанныеДляВыполненияКода(ПроцессорКода);
	КонецЕсли;
	
КонецФункции

//{
//	Процессорные функции+
//

Функция ВызовПодпрограммы(ОбъектКонтекста_e8a17f9465ac4b1dbd98b4f6427d0162, ТипОбъекта, ИмяМетода, ПроцессорКода, Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162", Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162="ПропущенныйПараметр_e8a17f9465ac4b1dbd98b4f6427d0162") Экспорт

	КлассныйОбъект = вмс_КлассныеОбъекты.ПолучитьКлассныйОбъект(ОбъектКонтекста_e8a17f9465ac4b1dbd98b4f6427d0162, ПроцессорКода);
	
	Если ТипОбъекта=Неопределено Тогда
		
		// неявная типизация
		Если КлассныйОбъект <> Неопределено Тогда
			ТипОбъекта = КлассныйОбъект.ИмяКлассаДляВыполненияКода;
		Иначе
			// Не удалось определить тип объекта
			// будет вызван его нативный метод
			ПроцессорКода.ДанныеВыполненияМетода.НативныйОбъект = ОбъектКонтекста_e8a17f9465ac4b1dbd98b4f6427d0162;
			ПроцессорКода.ДанныеВыполненияМетода.ВыполнитьНативныйМетод = Истина;
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	ТипыОписанийПодпрограмм = ПроцессорКода.ТипыОписанийПодпрограмм;

	ДанныеКласса = ПроцессорКода.ТекущиеДанныеДляВыполненияКода.ДанныеКлассов[ТипОбъекта];
	ОписаниеПодпрограммы = ДанныеКласса.ОписанияПодпрограмм[ИмяМетода];
	Если ОписаниеПодпрограммы=Неопределено ИЛИ ОписаниеПодпрограммы.Тип=ТипыОписанийПодпрограмм.Нативная Тогда
		// метод не определен
		Если ДанныеКласса.ИспользоватьНативныеМетоды Тогда
			// попробуем вызвать нативный метод
			ПроцессорКода.ДанныеВыполненияМетода.НативныйОбъект = КлассныйОбъект.НативныйОбъект;
			ПроцессорКода.ДанныеВыполненияМетода.ВыполнитьНативныйМетод = Истина;
		Иначе
			ВызватьИсключение "Метод """ + ИмяМетода + """ класса """ + ТипОбъекта + """ не определен!";
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	КадрСтека = ДобавитьВызовПодпрограммыВСтек(ОбъектКонтекста_e8a17f9465ac4b1dbd98b4f6427d0162, ТипОбъекта, ИмяМетода, ПроцессорКода, Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162);
	
	Если КадрСтека.КоличествоПереданныхПараметров < ОписаниеПодпрограммы.КоличествоОбязательныхПараметров Тогда
		УдалитьВызовПодпрограммыИзСтека(ПроцессорКода);
		ВызватьИсключение "Недостаточно фактических парамеров";
	КонецЕсли;
	
	Если КадрСтека.КоличествоПереданныхПараметров > ОписаниеПодпрограммы.КоличествоПараметров Тогда
		УдалитьВызовПодпрограммыИзСтека(ПроцессорКода);
		ВызватьИсключение "Слишком много фактических парамеров";
	КонецЕсли;
	
	Если ОписаниеПодпрограммы.Тип=ТипыОписанийПодпрограмм.Код Тогда
		
		КодПодпрограммы = ОписаниеПодпрограммы.Данные;
		
		Результат_e8a17f9465ac4b1dbd98b4f6427d0162 = Неопределено;
		Выполнить(КодПодпрограммы);
		Результат = Результат_e8a17f9465ac4b1dbd98b4f6427d0162;
		
	ИначеЕсли ОписаниеПодпрограммы.Тип=ТипыОписанийПодпрограмм.Переход Тогда

		ПереходПодпрограммы = ОписаниеПодпрограммы.Данные;
		
		Если ПереходПодпрограммы.КонтекстИсполнения=ПроцессорКода.ТекущиеДанныеДляВыполненияКода.КонтекстИсполнения Тогда
			// Ближний переход (просто меняем данные для выполнения кода и останемся в текущем контексте исполнения кода)
			ТекущиеДанныеДляВыполненияКода = ПроцессорКода.ТекущиеДанныеДляВыполненияКода;
			ПроцессорКода.ТекущиеДанныеДляВыполненияКода = ПереходПодпрограммы;
			Результат =
				ВызовПодпрограммы(ОбъектКонтекста_e8a17f9465ac4b1dbd98b4f6427d0162, ТипОбъекта, ИмяМетода, ПроцессорКода, Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162);
			ПроцессорКода.ТекущиеДанныеДляВыполненияКода = ТекущиеДанныеДляВыполненияКода;
		Иначе
			// Дальний переход в другой контекст исполнения кода (на сервер или на бэкенд). Reise, Reise, эээх...
			Результат =
				ВызовПодпрограммыПередПереходом(ОбъектКонтекста_e8a17f9465ac4b1dbd98b4f6427d0162, ТипОбъекта, ИмяМетода, ПроцессорКода, ПереходПодпрограммы, Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162);
		КонецЕсли;
		
	ИначеЕсли ОписаниеПодпрограммы.Тип=ТипыОписанийПодпрограмм.Наследование Тогда
		
		ИмяКлассаПредка = ОписаниеПодпрограммы.Данные;
		
		КлассныйОбъект.ИмяКлассаДляВыполненияКода = ИмяКлассаПредка;
		Результат =
			ВызовПодпрограммы(ОбъектКонтекста_e8a17f9465ac4b1dbd98b4f6427d0162, ИмяКлассаПредка, ИмяМетода, ПроцессорКода, Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162);
		КлассныйОбъект.ИмяКлассаДляВыполненияКода = ТипОбъекта;
		
	КонецЕсли;
	
	ПроцессорКода.ДанныеВыполненияМетода.НативныйОбъект = Неопределено;
	ПроцессорКода.ДанныеВыполненияМетода.ВыполнитьНативныйМетод = Ложь;

	УдалитьВызовПодпрограммыИзСтека(ПроцессорКода);
	
	Возврат Результат;
	
КонецФункции

Функция ВызовПодпрограммыПередПереходом(знач ОбъектКонтекста, ТипОбъекта, ИмяМетода, ПроцессорКода, ДанныеДляВыполненияКодаПослеПерехода, Параметр1_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр2_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр3_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр4_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр5_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр6_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр7_e8a17f9465ac4b1dbd98b4f6427d0162, Параметр8_e8a17f9465ac4b1dbd98b4f6427d0162) Экспорт

	ПараметрыВызоваПодпрограммы = Новый Массив;
	ПараметрыВызоваПодпрограммы.Добавить(ОбъектКонтекста);
