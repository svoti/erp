&НаСервере
Процедура ДобавитьВсеОперацииНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_Операции.Ссылка КАК Операция,
	|	вмс_Операции.Родитель КАК МастерОперация
	|ИЗ
	|	Справочник.вмс_Операции КАК вмс_Операции
	|ГДЕ
	|	вмс_Операции.ПометкаУдаления = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	вмс_Операции.Код ВОЗР";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Объект.Операции.Очистить(); 
	
	Пока Выборка.Следующий() Цикл
    	НоваяСтрока = Объект.Операции.Добавить();
		НоваяСтрока.Операция = Выборка.Операция;
		НоваяСтрока.МастерОперация = Выборка.МастерОперация;
	КонецЦикла;  
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВсеОперации(Команда)
	ДобавитьВсеОперацииНаСервере(); 
	ЗаполнитьСписокОперацийФормы();
КонецПроцедуры

