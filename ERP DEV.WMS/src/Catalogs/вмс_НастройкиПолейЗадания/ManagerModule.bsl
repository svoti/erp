Функция ЗаполнитьНастройкуПолейПоУмолчанию1(НастройкиИБ) Экспорт
	
	Настройка = ПолучитьНастройкуПолейПоУмолчанию1();
	
	вмс_НастройкиПолейЗадания1.СохранитьНастройку(Настройка, НастройкиИБ);
	
КонецФункции

Функция ПолучитьНастройкуПолейПоУмолчанию1() Экспорт

	НПЗ = вмс_НастройкиПолейЗадания1;
	
	Настройка = НПЗ.НоваяНастройка();
	НПЗ.ДобавитьЭлементВывода(Настройка, "ФормаКлиентскогоПриложения", , , "Форма");
	НПЗ.ДобавитьЭлементВывода(Настройка, "ГруппаФормы", "Страницы", "Форма", "ГлавнаяПанель");
	
	НачатьКонструированиеЭлементов(Настройка);
	
		ДобавитьСтраницуВводаДанных(Настройка, "Инфо");
		ДобавитьСборщикДанных(Настройка, "СборщикДанныхИнфо", "СборщикДанныхСтандартный");
		ЗакончитьКонструированиеСтраницыВводаДанных(Настройка);

		ДобавитьСтраницуВводаДанных(Настройка, "ВводДанных");
		ДобавитьСтраницуВводаДанных(Настройка, "ПланФакт");
		ДобавитьСборщикДанных(Настройка, "СборщикДанныхТоваров", "СборщикДанныхТоваров");
		ДобавитьСборщикДанных(Настройка, "СборщикДанныхМаркировки", "СборщикДанныхМаркировки");
		ЗакончитьКонструированиеСтраницыВводаДанных(Настройка);
		ЗакончитьКонструированиеСтраницыВводаДанных(Настройка);
	
		ДобавитьСтраницуВводаДанных(Настройка, "Завершение");
		ДобавитьСборщикДанных(Настройка, "СборщикДанныхЗавершение", "СборщикДанныхСтандартный");
		ЗакончитьКонструированиеСтраницыВводаДанных(Настройка);
		
	ЗакончитьКонструированиеЭлементов(Настройка);
	
	Возврат Настройка;
	
КонецФункции

