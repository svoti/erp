Функция ПолучитьЗонуСклада(Склад, ТипЯчейки, СоздатьПриОтсутствии = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_МестаХранения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	НЕ вмс_МестаХранения.ЭтоГруппа
	|	И НЕ вмс_МестаХранения.ПометкаУдаления
	|	И вмс_МестаХранения.ТипЯчейки = &ТипЯчейки
	|	И вмс_МестаХранения.Владелец = &Склад";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ТипЯчейки", ТипЯчейки);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	Иначе
		СлужебнаяЗона = СоздатьЭлемент();
		СлужебнаяЗона.Владелец = Склад;
		СлужебнаяЗона.ТипЯчейки = ТипЯчейки;
		СлужебнаяЗона.Наименование = СтрШаблон("%1 (%2)", ТипЯчейки, Склад);
		СлужебнаяЗона.Записать();
		Возврат СлужебнаяЗона.Ссылка;
	КонецЕсли;
	
	Возврат ПустаяСсылка();
	
КонецФункции

