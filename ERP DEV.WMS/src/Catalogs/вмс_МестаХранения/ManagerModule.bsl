#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
	
Процедура ЗарегистрироватьНаОбмен() Экспорт
	
	МассивУзлов = вмс_Обмен_с_КИС_ВызовСервера.ПолучитьУзлыДляОбмена();
	ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, Метаданные.Справочники.вмс_МестаХранения);
	
КонецПроцедуры

Функция ПолучитьЯчейкиПоРодителю(Родитель) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_МестаХранения.Ссылка КАК Ячейка
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	вмс_МестаХранения.Ссылка В ИЕРАРХИИ(&Группа)
	|	И вмс_МестаХранения.Родитель = &Родитель
	|	И вмс_МестаХранения.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Родитель", Родитель);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(); 
	
	Возврат РезультатЗапроса.ВыгрузитьКолонку("Ячейка");
	
КонецФункции

Функция ПолучитьЗонуПриемки(Склад, СоздатьПриОтсутствии = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_МестаХранения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	НЕ вмс_МестаХранения.ЭтоГруппа
	|	И НЕ вмс_МестаХранения.ПометкаУдаления
	|	И вмс_МестаХранения.ТипЯчейки = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаПриемки)
	|	И вмс_МестаХранения.Владелец = &Склад";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	Иначе
		ЗонаПриемки = СоздатьЭлемент();
		ЗонаПриемки.Владелец = Склад;
		ЗонаПриемки.ТипЯчейки = Перечисления.вмс_ТипыЯчеек.ЗонаПриемки;
		ЗонаПриемки.Наименование = СтрШаблон("Зона приемки (%1)", Склад);
		ЗонаПриемки.Записать();
		Возврат ЗонаПриемки.Ссылка;
	КонецЕсли;
	
	Возврат ПустаяСсылка();
	
КонецФункции

