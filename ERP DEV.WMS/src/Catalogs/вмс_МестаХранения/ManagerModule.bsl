Функция ЗаполнитьРеквизитШтрихкод() Экспорт
	
	НачатьТранзакцию();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	вмс_МестаХранения.Ссылка КАК МестоХранения
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|ГДЕ
	|	вмс_МестаХранения.ЭтоГруппа = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		пОбъект = Выборка.МестоХранения.ПолучитьОбъект();
		пОбъект.ОбменДанными.Загрузка = Истина;
		пОбъект.Штрихкод = пОбъект.Код;
		пОбъект.Записать();
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
КонецФункции

