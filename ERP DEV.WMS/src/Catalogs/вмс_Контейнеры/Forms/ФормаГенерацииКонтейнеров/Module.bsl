&НаСервере
Функция СгенерироватьНаСервере_Старая(ТипКонтейнера, КоличествоКонтейнеров)  
	
	РезультатМетода = Справочники.вмс_Контейнеры.ПолучитьМассивУникальныхИдентификаторов(КоличествоКонтейнеров);
	МассивКонтейнеров = Новый Массив;    
	Префикс = СтрЗаменить(ТипКонтейнера.Префикс,"_","");  
	ДатаГенерации = Формат(ТекущаяДата(), "ДФ=ddMMyymmss");
	Счетчик = 1;
	ПервыйСимвол = Лев(Строка(ТипКонтейнера),1) + "_";
	Если РезультатМетода.Результат = Истина Тогда   
		
		Для Каждого УИСтрока ИЗ РезультатМетода.Данные Цикл                     
			
			НовыйКонтейнер = Справочники.вмс_Контейнеры.СоздатьЭлемент();
			НовыйКонтейнер.Заполнить(Неопределено);
			НовыйКонтейнер.УстановитьСсылкуНового(Справочники.вмс_Контейнеры.ПолучитьСсылку(УИСтрока.УникальныйИдентификатор));
			НовыйКонтейнер.ТипТары = ТипКонтейнера;
			НовыйКонтейнер.Штрихкод = ?(УИСтрока.Наименование = "",Префикс + УИСтрока.УникальныйИдентификатор,УИСтрока.Наименование);
			//Если ЕстьОснование Тогда
			//	НовыйКонтейнер.ИдентификаторОснования = ДокументОснование.GUID;
			//	НовыйКонтейнер.ОснованиеСтрокой = ДокументОснование.ИмяТипа;
			//	Попытка
			//		НовыйКонтейнер.Распоряжение = ДокументОснование;	
			//	Исключение
			//	    //ОписаниеОшибки()
			//	КонецПопытки;
			//КонецЕсли;			
			НовыйКонтейнер.Наименование = ?(УИСтрока.Наименование = "",ПервыйСимвол+ ДатаГенерации + "_" + Строка(Счетчик) + " (" + ТипКонтейнера + ")",УИСтрока.Наименование); 			
			НовыйКонтейнер.Записать();     
			
			МассивКонтейнеров.Добавить(НовыйКонтейнер.Ссылка);
			Счетчик = Счетчик + 1;
		КонецЦикла;  
		Возврат МассивКонтейнеров;
	Иначе
		Ошибка = РезультатМетода.Данные;
	КонецЕсли;
	
КонецФункции


&НаСервере
Функция СгенерироватьНаСервере(ТипКонтейнера, КоличествоКонтейнеров)
	МассивКонтейнеров = Новый Массив;
	
	ДокументОснование = ЭтаФорма.Распоряжение;
	
	ДанныеЗаполнения = Справочники.вмс_Контейнеры.НовыеПараметрыСозданияКонтейнеров();
	ДанныеЗаполнения.ТипКонтейнера	= ТипКонтейнера;
	ДанныеЗаполнения.Количество		= КоличествоКонтейнеров;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		ДанныеЗаполнения.Распоряжение	= ДокументОснование;
		ДанныеЗаполнения.Контрагент		= ДокументОснование.Контрагент;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивКонтейнеров, Справочники.вмс_Контейнеры.СоздатьКонтейнеры(ДанныеЗаполнения));
	
	Возврат МассивКонтейнеров;
КонецФункции
