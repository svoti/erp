&НаКлиенте
Процедура Сгенерировать(Команда) 
	
	// ТУ_Кулалаев Е.С ++ 31.05.2024 17:59:26 
	// Рефакторинг: Заменил вмс_Печать на вмс_Печать
	
	
	Если НЕ ЗначениеЗаполнено(ТипКонтейнера) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выберите тип контейнера";
		Сообщение.Сообщить();   
		Возврат;
	КонецЕсли;
	Если КоличествоКонтейнеров <= 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Введите количество создаваемых контейнеров";
		Сообщение.Сообщить();	
		Возврат;
	КонецЕсли;
	
	МассивДокументов = СгенерироватьНаСервере(ТипКонтейнера, КоличествоКонтейнеров) ;
	Если ЗначениеЗаполнено(МассивДокументов) Тогда    
		Результат = вмс_Печать.СформироватьТабличныйДокументЭтикеткиКонтейнеров(МассивДокументов);
		Результат.Показать();
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры
