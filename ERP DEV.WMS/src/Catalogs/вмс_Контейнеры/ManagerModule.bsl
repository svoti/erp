Функция НовыеПараметрыСозданияКонтейнеров() Экспорт
	
	ПараметрыСоздания = Новый Структура();
	ПараметрыСоздания.Вставить("Количество", 1);
	ПараметрыСоздания.Вставить("ТипКонтейнера", Неопределено);
	ПараметрыСоздания.Вставить("Контрагент", Неопределено);
	ПараметрыСоздания.Вставить("Распоряжение", Неопределено);
	ПараметрыСоздания.Вставить("ДатаПартии", ТекущаяДатаСеанса());
	
	Возврат ПараметрыСоздания;
	
КонецФункции



Функция ПолучитьНовыйНомерТары(типТары) Экспорт
	
	ДлинаНаименования 		   = Метаданные.Справочники.вмс_Контейнеры.ДлинаНаименования;
	Префикс          		   = типТары.Префикс;
	ДлинаПрефикса     		   = СтрДлина(Префикс);
	ДлинаНаНомер      		   = ДлинаНаименования - ДлинаПрефикса;
	НезанятыйНомер   		   = ПолучитьКоличествоТарыВБазе() + 1;
	ДлинаЛидирующихНулей       = ДлинаНаНомер - СтрДлина(Строка(НезанятыйНомер)); 
	
	ВедущиеНули = Формат(0,"ЧЦ=" + ДлинаЛидирующихНулей + ";ЧН=; ЧВН=; ЧГ=0");
	
	// Кулалаев Е.С + 09.03.2022 15:37:10
	// -----Описание-----
	// Убрал ведущие нули 
	// ------------------ 
	//НовыйНомер = "" + Префикс + ВедущиеНули + НезанятыйНомер; 
	НовыйНомер = "" + Префикс + НезанятыйНомер;
	// Кулалаев Е.С -   
	
	НовыйНомер = СтрЗаменить(НовыйНомер, Символы.НПП, "");
	
	Возврат НовыйНомер;
	
КонецФункции  

Функция ПолучитьМассивУникальныхИдентификаторов(КоличествоДанных = 1,ИспользоватьЭтикеткиКонтрагента = Ложь, Контрагент = Неопределено) Экспорт  
	
	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Колонки.Добавить("УникальныйИдентификатор");
	ТаблицаСсылок.Колонки.Добавить("Наименование",Новый ОписаниеТипов("Строка"));
	
	МассивИспользованныхЗаписей = Новый Массив;
	
	Если ИспользоватьЭтикеткиКонтрагента Тогда 
		
		НаборЗаписей = РегистрыСведений.ШтрихкодыКонтрагентов.СоздатьНаборЗаписей();
		НаборЗаписей.Заполнить(Неопределено);
		НаборЗаписей.Отбор.Контрагент.Установить(Контрагент); 
		НаборЗаписей.Отбор.Использовано.Установить(Ложь);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда  
			Возврат Новый Структура("Результат,Данные",Ложь,"Нет подходящих штрихкодов для использования");		
		КонецЕсли;
		
		Если НаборЗаписей.Количество() < КоличествоДанных  Тогда   
			Разница = КоличествоДанных - НаборЗаписей.Количество(); 
			Возврат Новый Структура("Результат,Данные",Ложь,"Не хватает " + Разница + " этикеток для печати");	
		КонецЕсли;
		
	КонецЕсли;

	// Пробежим по записям
	Для Счетчик = 1 По КоличествоДанных Цикл 
		нСтр = ТаблицаСсылок.Добавить();
		нСтр.УникальныйИдентификатор = ПолучитьСсылку().УникальныйИдентификатор(); 
		Если ИспользоватьЭтикеткиКонтрагента Тогда 
			Запись = НаборЗаписей.Получить(ТаблицаСсылок.Индекс(нСтр));
			МассивИспользованныхЗаписей.Добавить(Запись);
			нСтр.Наименование = Запись.Штрихкод;
		КонецЕсли;
	КонецЦикла;
	// Пробежим по записям

	// Пометим что использовали
	Если ИспользоватьЭтикеткиКонтрагента Тогда	
		
		Для каждого Запись Из МассивИспользованныхЗаписей Цикл 
			
			МенеджерЗаписи = РегистрыСведений.ШтрихкодыКонтрагентов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Запись); 
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.Использовано = Истина; 
				МенеджерЗаписи.Записать(Истина);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	// Пометим что использовали
	
	Возврат Новый Структура("Результат,Данные",Истина,ТаблицаСсылок);
		
КонецФункции

Функция ПолучитьКоличествоТарыВБазе() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕстьNULL(СУММА(1),0) КАК КоличествоЭлементов
	|ИЗ
	|	Справочник.вмс_Контейнеры КАК вмс_Контейнеры";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоЭлементов
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТаблицуРазузлованнойТары(ТараДляРазузлования) Экспорт

	ДеревоТары = Новый ДеревоЗначений;
	ДеревоТары.Колонки.Добавить("Контейнер");
	ДеревоТары.Колонки.Добавить("МастерТара"); 
	
	Продолжаем = Истина;
	
	Пока Продолжаем Цикл  
		РазузловатьТару(ДеревоТары,ТараДляРазузлования);
		Продолжаем = Ложь;
	КонецЦикла; 
	
	Возврат ДеревоТары;
	
КонецФункции

Функция РазузловатьТару(КоллекцияТары,ТараДляРазузлования)
	
	ПодчиненныеЭлементы = Справочники.вмс_Контейнеры.Выбрать(ТараДляРазузлования);
	
	Пока ПодчиненныеЭлементы.Следующий() Цикл
		нСтр = КоллекцияТары.Строки.Добавить();	
		нСтр.МастерТара = ТараДляРазузлования;
		нСтр.Тара = ПодчиненныеЭлементы.Ссылка;
		РазузловатьТару(нСтр, ПодчиненныеЭлементы.Ссылка);
	КонецЦикла;
	
	
КонецФункции

Функция ЗаполнитьМассивТаройНижнегоУровня(КоллекцияСтрок,МассивЗначений) Экспорт
	
	Для каждого Строка Из КоллекцияСтрок Цикл
		
		Если Строка.Строки.Количество() = 0 Тогда
			МассивЗначений.Добавить(Строка.Тара);	
		Иначе  
			ЗаполнитьМассивТаройНижнегоУровня(Строка.Строки,МассивЗначений);
		КонецЕсли;
	
	КонецЦикла;


КонецФункции

// ТУ_Прошин_03.05.24++
Функция ПолучитьШтрихкодСозданногоКонтейнера(ДокументОснование, ГуидДокумента, ИмяТипаДокумента) Экспорт
	
	КоличествоКонтейнеров = 1;
	ТипКонтейнера = ПланыВидовХарактеристик.ТипыКонтейнеров.НайтиПоНаименованию("Паллета", Истина);
	
	МенеджерКонтейнеров = Справочники.вмс_Контейнеры;
	Префикс = СтрЗаменить(ТипКонтейнера.Префикс,"_","");
	п_МассивКонтейнеров = Новый Массив;
	ДатаГенерации = Формат(ТекущаяДата(), "ДФ=ddMMyymmssms"); 
	
	РезультатМетода = ПолучитьМассивУникальныхИдентификаторов(КоличествоКонтейнеров);
	Если РезультатМетода.Результат = Истина Тогда   
		
		Для Каждого УИСтрока Из РезультатМетода.Данные Цикл                     
			
			НовыйКонтейнер = Справочники.вмс_Контейнеры.СоздатьЭлемент();
			НовыйКонтейнер.Заполнить(Неопределено);
			НовыйКонтейнер.УстановитьСсылкуНового(Справочники.вмс_Контейнеры.ПолучитьСсылку(УИСтрока.УникальныйИдентификатор));
			НовыйКонтейнер.ТипТары = ТипКонтейнера;
			НовыйКонтейнер.Штрихкод = ?(УИСтрока.Наименование = "",Префикс + УИСтрока.УникальныйИдентификатор,УИСтрока.Наименование);
			НовыйКонтейнер.ИдентификаторОснования = ГуидДокумента;
			НовыйКонтейнер.ОснованиеСтрокой = ИмяТипаДокумента; 
			
			НовыйКонтейнер.Распоряжение = ДокументОснование;	
			
			НовыйКонтейнер.Наименование = ?(УИСтрока.Наименование = "", ДатаГенерации  + " (" + ТипКонтейнера + ")",УИСтрока.Наименование); 
			НовыйКонтейнер.Записать();     
			
			п_МассивКонтейнеров.Добавить(НовыйКонтейнер.Ссылка);
		КонецЦикла;
	Иначе
		Ошибка = РезультатМетода.Данные;	
	КонецЕсли;  
	
	Возврат п_МассивКонтейнеров[0].Штрихкод;
	
	
КонецФункции
