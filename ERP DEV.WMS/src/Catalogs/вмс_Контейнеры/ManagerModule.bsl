Функция СоздатьКонтейнеры_Старая(ДанныеЗаполнения) Экспорт
	
	МассивКонтейнеров = Новый Массив;
	
	Для сч = 1 По ДанныеЗаполнения.Количество Цикл
		
		НовоеНаименование = Справочники.вмс_Контейнеры.ПолучитьНовыйНомерТары(ДанныеЗаполнения.ТипКонтейнера);
		
		НовыйКонтейнер = Справочники.вмс_Контейнеры.СоздатьЭлемент();
		НовыйКонтейнер.Заполнить(Неопределено);
		ЗаполнитьЗначенияСвойств(НовыйКонтейнер, ДанныеЗаполнения);
		
		НовыйКонтейнер.ТипТары = ДанныеЗаполнения.ТипКонтейнера;
		НовыйКонтейнер.Наименование = НовоеНаименование;
		НовыйКонтейнер.Штрихкод = НовоеНаименование;
		НовыйКонтейнер.ОснованиеСтрокой = Строка(ДанныеЗаполнения.Распоряжение);
		НовыйКонтейнер.Записать();
		
		МассивКонтейнеров.Добавить(НовыйКонтейнер.Ссылка);
		
	КонецЦикла;
	
	Возврат МассивКонтейнеров;
	
КонецФункции

// Создает заданное Количество контейнеров определенного типа
//
// Параметры:
//  ДанныеЗаполнения - Структура - Данные для заполнения (см. "НовыеПараметрыСозданияКонтейнеров")
// 
// Возвращаемое значение:
//   - Массив - созданные контейнеры
//
Функция СоздатьКонтейнеры(ДанныеЗаполнения) Экспорт
	
	КоличествоКонтейнеров = ДанныеЗаполнения.Количество;
	ТипКонтейнера		  = ДанныеЗаполнения.ТипКонтейнера;
	ДокументОснование	  = ДанныеЗаполнения.Распоряжение;
	
	РезультатМетода = Справочники.вмс_Контейнеры.ПолучитьМассивУникальныхИдентификаторов(КоличествоКонтейнеров);
	МассивКонтейнеров = Новый Массив;
	Префикс = СтрЗаменить(ТипКонтейнера.Префикс,"_","");
	ДатаГенерации = Формат(ДанныеЗаполнения.ДатаПартии, "ДФ=ddMMyymmss");
	Счетчик = 1;
	ПервыйСимвол = Лев(Строка(ТипКонтейнера), 1) + "_";
	
	Если РезультатМетода.Результат = Истина Тогда
		Для Каждого УИСтрока ИЗ РезультатМетода.Данные Цикл
			
			НовыйКонтейнер = Справочники.вмс_Контейнеры.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НовыйКонтейнер, ДанныеЗаполнения);
			
			НовыйКонтейнер.УстановитьСсылкуНового(Справочники.вмс_Контейнеры.ПолучитьСсылку(УИСтрока.УникальныйИдентификатор));
			НовыйКонтейнер.ТипТары = ТипКонтейнера;
			НовыйКонтейнер.Штрихкод = ?(УИСтрока.Наименование = ""
										, Префикс + УИСтрока.УникальныйИдентификатор
										, УИСтрока.Наименование);
			НовыйКонтейнер.Наименование = ?(УИСтрока.Наименование = ""
											, ПервыйСимвол + ДатаГенерации + "_" + Строка(Счетчик) + " (" + ТипКонтейнера + ")"
											, УИСтрока.Наименование);
			
			НовыйКонтейнер.Записать();     
			
			МассивКонтейнеров.Добавить(НовыйКонтейнер.Ссылка);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	Иначе
		Ошибка = РезультатМетода.Данные;
	КонецЕсли;
	
	Возврат МассивКонтейнеров;
КонецФункции //СоздатьКонтейнеры_Новая

