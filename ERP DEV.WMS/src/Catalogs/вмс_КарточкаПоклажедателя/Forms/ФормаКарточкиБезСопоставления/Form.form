  <attributes>
    <name>ТЧКарточкиБезСопоставления</name>
    <title>
      <key>ru</key>
      <value>ТЧКарточки без сопоставления</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	вмс_КарточкаПоклажедателя.Ссылка КАК Ссылка, 
	вмс_КарточкаПоклажедателя.УпаковкаПоклажедателя КАК УпаковкаПоклажедателя,
	вмс_КарточкаПоклажедателя.ХарактеристикаПоклажедателя КАК ХарактеристикаПоклажедателя,
	вмс_КарточкаПоклажедателя.Контрагент КАК Контрагент,
	вмс_КарточкаПоклажедателя.Код КАК Код 
ИЗ
	Справочник.вмс_КарточкаПоклажедателя КАК вмс_КарточкаПоклажедателя
ГДЕ
	(вмс_КарточкаПоклажедателя.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
			ИЛИ вмс_КарточкаПоклажедателя.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
				И ВЫБОР
					КОГДА вмс_КарточкаПоклажедателя.БезХарактеристики = ЛОЖЬ
						ТОГДА вмс_КарточкаПоклажедателя.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
				КОНЕЦ)
	И вмс_КарточкаПоклажедателя.ПометкаУдаления = ЛОЖЬ
	И вмс_КарточкаПоклажедателя.ЭтоГруппа = ЛОЖЬ</queryText>
      <mainTable>Catalog.вмс_КарточкаПоклажедателя</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
  <extInfo xsi:type="form:DynamicListFormExtInfo"/>
