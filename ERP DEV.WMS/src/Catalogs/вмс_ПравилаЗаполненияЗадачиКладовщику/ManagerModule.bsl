#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда

Функция НайтиПравилоЗаполненияЗадания(ВидОперации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	вмс_ПравилаЗаполненияЗадачиКладовщику.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.вмс_ПравилаЗаполненияЗадачиКладовщику КАК вмс_ПравилаЗаполненияЗадачиКладовщику
	|ГДЕ
	|	НЕ вмс_ПравилаЗаполненияЗадачиКладовщику.ПометкаУдаления
	|	И вмс_ПравилаЗаполненияЗадачиКладовщику.ОперацияНазначение = &ОперацияНазначение";
	Запрос.УстановитьПараметр("ОперацияНазначение", ВидОперации);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

