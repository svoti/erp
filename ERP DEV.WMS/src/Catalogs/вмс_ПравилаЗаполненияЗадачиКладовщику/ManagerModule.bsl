Функция ЗаписатьНастройкуПолейПоУмолчаниюСтарая(Правило)
	
	СсылкаНастройкиПолей = Справочники.вмс_НастройкиПолейЗадания.ПолучитьНастройкуПолейПоВладельцу(Правило.Ссылка);
	СтруктураНастройкиПолей = СтруктураНастройкиПолейПоУмолчанию(Правило);
	Справочники.вмс_НастройкиПолейЗадания.ОбновитьНастройкуПолей(СсылкаНастройкиПолей, СтруктураНастройкиПолей);
	
КонецФункции

Функция СтруктураНастройкиПолей(Правило) Экспорт

	Если Правило.АвтоНастройкаПолей Тогда
		Возврат СтруктураНастройкиПолейПоУмолчанию(Правило);
	Иначе
		Если ЗначениеЗаполнено(Правило.Ссылка) Тогда
			СсылкаНастройкиПолей = Справочники.вмс_НастройкиПолейЗадания.НайтиНастройкуПолейПоВладельцу(Правило.Ссылка);
		КонецЕсли;
		Если ЗначениеЗаполнено(СсылкаНастройкиПолей) Тогда
			Возврат Справочники.вмс_НастройкиПолейЗадания.СтруктураНастройкиПолей(СсылкаНастройкиПолей);
		Иначе
			Возврат Справочники.вмс_НастройкиПолейЗадания.СтруктураНастройкиПолейПоУмолчанию();
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция СтруктураНастройкиПолейПоУмолчанию(Правило) Экспорт
	
	СтруктураНастройкиПолей = Справочники.вмс_НастройкиПолейЗадания.СтруктураНастройкиПолейПоУмолчанию();
	
	СвойстваПолей = ПолучитьСвойстваПолейДокументаПоУмолчанию(Правило);
	вмс_РаботаСКоллекциями.УстановитьЭлементыКоллекции(СтруктураНастройкиПолей.НастройкаПолей, СвойстваПолей);
	
	Возврат СтруктураНастройкиПолей;

КонецФункции

Функция ПолучитьСвойстваПолейДокументаПоУмолчанию(Правило) Экспорт
	
	РК = вмс_РаботаСКоллекциями;
	
	// инициализируется полями из задания кладовищку
	// по умолчанию все свойства = Ложь, явное определенение не требуется
	ТаблицаНастройки = вмс_СерверУправляемыеОперации.ТаблицаЗначенийСвойствПолейОперацииПоУмолчанию();
	
	Отбирать = Ложь;
	Размещать = Ложь;

	ВключитьИнфоПоле(ТаблицаНастройки, "Операция");
	ВключитьИнфоПоле(ТаблицаНастройки, "Распоряжение");
	ВключитьИнфоПоле(ТаблицаНастройки, "Ссылка");
	ВключитьИнфоПоле(ТаблицаНастройки, "Комментарий");
	
	// ПОДСКАЗКА СЛЕДУЮЩЕГО ДЕЙСТВИЯ
	ВключитьПолеПодсказки(ТаблицаНастройки);
	
	// ЯЧЕЙКА ОТПРАВИТЕЛЬ     
	Если Правило.ПодбиратьЯчейкиОтправители Тогда
		Если Правило.ИспользоватьЗонуОтправитель ИЛИ Правило.ОтгружатьСоСлужебнойЗоныОтправителя ИЛИ Правило.УстанавливатьЯчейкуОтправитель Тогда
			Настройка = ВключитьИнфоПоле(ТаблицаНастройки, "ЗонаОтправитель");
			Настройка.План = Истина;
			
			Настройка = ВключитьПоле(ТаблицаНастройки, "Ячейка");
			Настройка.Ввод = Ложь;
			Настройка.Вывод = Ложь;
			Настройка.ПутьКДаннымЗаполнения = "ЗонаОтправитель";
		Иначе
			Настройка = ВключитьПоле(ТаблицаНастройки, "Ячейка"); 
			Если Правило.НестрогоеПланированиеЯчейкиОтбора Тогда
				Настройка.План = Ложь;
			КонецЕсли;
			Отбирать = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ЛицензияКонтейнерыДоступна = вмс_УправлениеОстаткамиНовыйВызовСервера.ЛицензияКонтейнерыДоступна();
	Если ЛицензияКонтейнерыДоступна Тогда
		Если Правило.Контейнеры_РазбиратьКонтейнеры Тогда
			Настройка = ВключитьПоле(ТаблицаНастройки, "КонтейнерОтправитель");
			Настройка.План = НЕ Правило.Контейнеры_РазбиратьКонтейнеры_НестрогоеПланирование;
		КонецЕсли;

		Если Правило.Контейнеры_ПеремещатьЦелыми Тогда
			Настройка = ВключитьПоле(ТаблицаНастройки, "Контейнер");
			Настройка.План = НЕ Правило.Контейнеры_ПеремещатьЦелыми_НестрогоеПланирование;
		КонецЕсли;

		Если Правило.Контейнеры_СобиратьКонтейнеры Тогда
			Настройка = ВключитьПоле(ТаблицаНастройки, "КонтейнерПриемник");
			Настройка.План = НЕ Правило.Контейнеры_СобиратьКонтейнеры_НестрогоеПланирование;
		КонецЕсли;
	КонецЕсли;
	
	
	// ТОВАРНЫЕ ПОЛЯ
	ТоварныеПоля = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля();

	ИспользуетсяКачество = ТоварныеПоля.Найти("Качество") <> Неопределено; РК.ВычестьМассив(ТоварныеПоля, "Качество");
	Для Каждого ТоварноеПоле Из ТоварныеПоля Цикл
		Если ТоварноеПоле="Товар" Тогда
			НастройкаТовара = НастройкаПоля(ТаблицаНастройки, "Товар");
			НастройкаАртикула = ВключитьИнфоПоле(ТаблицаНастройки, "Артикул");
			НастройкаАртикула.Страница = НастройкаТовара.Страница;
			НастройкаАртикула.ПоложениеЗаголовка = "Авто";

			НастройкаМаркировка = ВключитьПоле(ТаблицаНастройки, "Маркировка");
			НастройкаМаркировка.План = Ложь;
			НастройкаМаркировка.Вывод = Ложь;
			НастройкаМаркировка.ОбязательноеЗаполнение = Ложь;
		КонецЕсли;
		Настройка = ВключитьПоле(ТаблицаНастройки, ТоварноеПоле);
	КонецЦикла;
	
	// КАЧЕСТВО
	Если ИспользуетсяКачество Тогда 
		Настройка = ВключитьПоле(ТаблицаНастройки, "Качество"); 
		Настройка.ПутьКДаннымЗаполнения = "Задание.КачествоПоУмолчанию";
		Настройка.ПутьКДаннымСохранения = "ОперацияПоЯчейкам.Товары.Качество";
		Настройка.ПутьРодителяДанныхЗаполнения = "Задание";
		Настройка.ПутьРодителяДанныхСохранения = "ОперацияПоЯчейкам.Товары";
		Настройка.План = Ложь;
		Настройка.ОбязательныйВвод = Ложь;
	КонецЕсли;
	
	
	// УПАКОВКИ
	Если Справочники.вмс_НастройкиПрограммы.ПолучитьЗначениеНастройкиПрограммы("Упаковки_ВестиУчетОстатковПоУпаковкам") = Истина Тогда;
		Настройка = ВключитьПоле(ТаблицаНастройки, "Упаковка"); 
		Настройка.План = Правило.Упаковка_ВводПоПлану; 		
	КонецЕсли;
	
	Если Отбирать Тогда
		Настройка = ВключитьПоле(ТаблицаНастройки, "КоличествоОтобрано");
	КонецЕсли;
	
	// ЯЧЕЙКА ПОЛУЧАТЕЛЬ
	Если Правило.ПриниматьНаСлужебнуюЗонуПолучатель ИЛИ Правило.УстанавливатьЯчейкуПолучатель ИЛИ Правило.РучнойВводЗоныПолучателя Тогда
		// если заполнена зона получаетель - то она дозаполняет ввод автоматически
		Настройка = ВключитьИнфоПоле(ТаблицаНастройки, "ЗонаПолучатель");
		Настройка.План = Истина;
		
		Если Правило.ПодтверждатьЗонуПолучатель Тогда
			Настройка.Ввод = Истина;
			// если заполнена зона получатель - то она дозаполняет ввод автоматически
			Настройка = ВключитьПоле(ТаблицаНастройки, "ЯчейкаПриемник");
			Настройка.Ввод = Ложь;
			Настройка.Вывод = Ложь;
			Настройка.ПутьКДаннымЗаполнения = "ДанныеВвода.ЗонаПолучатель";
		Иначе
			// если заполнена зона получатель - то она дозаполняет ввод автоматически
			Настройка = ВключитьПоле(ТаблицаНастройки, "ЯчейкаПриемник");
			Настройка.Ввод = Ложь;
			Настройка.Вывод = Ложь;
			Настройка.ПутьКДаннымЗаполнения = "ЗонаПолучатель";
		КонецЕсли;
		
	ИначеЕсли Правило.ПодбиратьЯчейкиПолучатели Тогда
		
		// При заполнении в строке и отсутствии общей ячейки вводится пользователем.
		Настройка = ВключитьПоле(ТаблицаНастройки, "ЯчейкаПриемник");
		Если Правило.СтрогоеПланированиеЯчейки = Ложь Тогда
			Настройка.План = Ложь;
		КонецЕсли;
		Размещать = Истина;
		
	КонецЕсли;

	Если Размещать Тогда
		Настройка = ВключитьПоле(ТаблицаНастройки, "КоличествоРазмещено");
	КонецЕсли;
	
	Если НЕ Отбирать И НЕ Размещать Тогда
		Настройка = ВключитьПоле(ТаблицаНастройки, "Количество");
	КонецЕсли;
	
	УдалитьНеиспользуемыеПоля(ТаблицаНастройки);

	ТаблицаНастройки.Сортировать("ПорядокВвода");
	
	Возврат ТаблицаНастройки;
	
КонецФункции

Функция НастройкаПоля(ТаблицаНастройки, ИмяПоля)
	
	ПолеМассив = ТаблицаНастройки.НайтиСтроки(Новый Структура("Имя", ИмяПоля));
	
	Если ПолеМассив.Количество()=0 Тогда
		Поле = ТаблицаНастройки.Добавить();
		Поле.Имя = ИмяПоля;
		Поле.Использование = Ложь;
	Иначе
		Поле = ПолеМассив[0];
	КонецЕсли;
	
	Возврат Поле;
		
КонецФункции

Функция ВключитьПолеПодсказки(ТаблицаНастройки)
	
	Поле = ВключитьПоле(ТаблицаНастройки, "Подсказка");
	
	Поле.Страница = "ГлавнаяПанельСтраницаВводДанных";
	Поле.ПоложениеЗаголовка = "Нет";
	Поле.План = Ложь;
	Поле.Ввод = Ложь;
	Поле.Сборка = Ложь;
	Поле.ОбязательноеЗаполнение = Ложь;
	
	Возврат Поле;
	
КонецФункции

Функция ВключитьПоле(ТаблицаНастройки, ИмяПоля)
	
	Поле = НастройкаПоля(ТаблицаНастройки, ИмяПоля);
	Если НЕ Поле.Использование Тогда
		Поле.ПорядокВвода = ПолучитьПорядокДляНовогоПоля(ТаблицаНастройки);
		Поле.Использование = Истина;
	КонецЕсли;
	Поле.План = Истина; 
	Поле.Ввод = Истина;
	Поле.Сборка = Истина;
	Поле.Вывод = Истина;
	Поле.ОбязательныйВвод = Истина;
	Поле.ОбязательноеЗаполнение = Истина;
	
	Возврат Поле;
	
КонецФункции

Функция ВключитьИнфоПоле(ТаблицаНастройки, ИмяПоля)
	
	Поле = ВключитьПоле(ТаблицаНастройки, ИмяПоля);
	Поле.План = Ложь; 
	Поле.Ввод = Ложь;
	Поле.Сборка = Ложь;
	Поле.Вывод = Истина;
	Поле.Страница = Обработки.вмс_СерверУправляемыйМодульОперацияПоЯчейкамУниверсальная.ПрефиксСтраницОперации() + "Инфо";
	Поле.ПоложениеЗаголовка = "Нет";
	
	Возврат Поле;
	
КонецФункции 

Функция ПолучитьПорядокДляНовогоПоля(ТаблицаНастройки)
	
	Порядок = 0;
	ВключенныеПоля = ТаблицаНастройки.НайтиСтроки(Новый Структура("Использование", Истина));
	Для Каждого Поле Из ВключенныеПоля Цикл
		Если Порядок < Поле.ПорядокВвода Тогда
			Порядок = Поле.ПорядокВвода;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Порядок+1;
	
КонецФункции

Функция УдалитьНеиспользуемыеПоля(ТаблицаНастройки)
	
	Для Каждого Поле Из ТаблицаНастройки.НайтиСтроки(Новый Структура("Использование", Ложь)) Цикл
		
		ТаблицаНастройки.Удалить(Поле);
		
	КонецЦикла;
	
КонецФункции

