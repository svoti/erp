// ТУ_Мовчан 04.07.23
Функция ПолучитьСтатусЗавершения(Распоряжение, Операция, Оператор) Экспорт
	
	лТекст = "ВЫБРАТЬ
	|	вмс_АктивныеСеансы.Завершается КАК Завершается
	|ИЗ
	|	РегистрСведений.вмс_АктивныеСеансы КАК вмс_АктивныеСеансы
	|ГДЕ
	|	вмс_АктивныеСеансы.Операция = &Операция
	|	И вмс_АктивныеСеансы.Распоряжение = &Распоряжение
	|	И вмс_АктивныеСеансы.Завершается = ИСТИНА
	|	И вмс_АктивныеСеансы.Оператор <> &Оператор";	
	
	Запрос = Новый Запрос(лТекст);
	Запрос.УстановитьПараметр("Операция" ,Операция);
	Запрос.УстановитьПараметр("Распоряжение" ,Распоряжение);
	Запрос.УстановитьПараметр("Оператор" , Оператор);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Ложь;
	Пока Выборка.Следующий() Цикл
		Результат = Истина;
		Прервать;
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьАктивностьСеансаПоОператору(СтруктураДанных) Экспорт
	
	Запись = ПолучитьЗаписьПоОператору(СтруктураДанных.Оператор);
	Если Запись = Неопределено Тогда
		Возврат Ложь;
	ИначеЕсли Запись.УникальныйИдентификаторБазы = СтруктураДанных.УникальныйИдентификаторБазы Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

Функция ЗакончитьАктивныйСеансОператора(Оператор) Экспорт	
	Если Не ЗначениеЗаполнено(Оператор) Тогда
		Возврат Ложь;
	КонецЕсли;
	СтруктураСеанса =  ПолучитьЗаписьПоОператору(Оператор);
	Если СтруктураСеанса = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	УдалитьЗаписьСеанса(СтруктураСеанса);
КонецФункции 

Процедура УдалитьЗаписьСеанса(СтруктураСеанса)
	Запись = РегистрыСведений.вмс_АктивныеСеансы.СоздатьМенеджерЗаписи();
	Запись.Заполнить(Неопределено);
	ЗаполнитьЗначенияСвойств(Запись, СтруктураСеанса);
	Запись.Удалить();
КонецПроцедуры
