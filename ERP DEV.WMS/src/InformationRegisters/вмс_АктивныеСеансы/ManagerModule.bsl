Функция ИзменитьСтатусСеанса(УникальныйИдентификаторБазы = Неопределено, Оператор, Распоряжение = Неопределено, Операция = Неопределено, ВидВзаимодействия) Экспорт
	Если Не ЗначениеЗаполнено(Оператор) Тогда
		Возврат Ложь;
	КонецЕсли;
	СтруктураСеанса = ПолучитьЗаписьПоОператору(Оператор);
	Если Не ЗначениеЗаполнено(СтруктураСеанса) Тогда
		Возврат Ложь;
	КонецЕсли;
	УдалитьЗаписьСеанса(СтруктураСеанса);
	СоздатьНовуюЗапись(Новый Структура("УникальныйИдентификаторБазы, Оператор, Распоряжение, Операция, ВидВзаимодействия", УникальныйИдентификаторБазы, Оператор, Распоряжение, Операция, ВидВзаимодействия));
	
КонецФункции 

Функция ИзменитьСтатусСеансаПоСтруктуре(СтруктураСеанса) Экспорт
	Если Не ЗначениеЗаполнено(СтруктураСеанса.Оператор) Тогда
		Возврат Ложь;
	КонецЕсли;
	СтруктураПрошлогоСеанса = ПолучитьЗаписьПоОператору(СтруктураСеанса.Оператор);
	Если Не ЗначениеЗаполнено(СтруктураПрошлогоСеанса) Тогда
		СоздатьНовуюЗапись(СтруктураСеанса);
	КонецЕсли;	
	УдалитьЗаписьСеанса(СтруктураПрошлогоСеанса);
	СоздатьНовуюЗапись(СтруктураСеанса);
КонецФункции

Процедура СоздатьНовуюЗапись(СтруктураСеанса) Экспорт
	Запись =  РегистрыСведений.вмс_АктивныеСеансы.СоздатьМенеджерЗаписи();
	Запись.Заполнить(Неопределено);
	Запись.ДатаВремя = ТекущаяДатаСеанса();
	ЗаполнитьЗначенияСвойств(Запись, СтруктураСеанса);
	Запись.Записать();
КонецПроцедуры

