
&НаСервере
Процедура ЗаписатьНаСервере()
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|	И НЕ Номенклатура.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда	
		Возврат
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.вмс_РеестрОстаточныхСроковГодности.СоздатьНаборЗаписей();
	НаборЗаписей.Заполнить(Неопределено);
	НаборЗаписей.Отбор.Контрагент.Установить(Контрагент); 
	
	НаборЗаписей.Прочитать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЗаписьРегистра = НаборЗаписей.Добавить();
		ЗаписьРегистра.Период = ТекущаяДата();
		ЗаписьРегистра.Номенклатура = ВыборкаДетальныеЗаписи.Ссылка;
		ЗаписьРегистра.Контрагент = Контрагент;
		ЗаписьРегистра.ПоказательОСГ = ОСГ;     
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
		
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда) 
	
	Если НЕ ПроверитьЗаполнение()Тогда
		Возврат;
	КонецЕсли; 
	
	Если ОСГ > 100 Тогда 
		Сообщение = новый СообщениеПользователю;
		Сообщение.Поле = "ОСГ";
		Сообщение.Текст = "ОСГ не может превышать 100";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли; 
	
	
	ЗаписатьНаСервере(); 
	Закрыть();
	
КонецПроцедуры
