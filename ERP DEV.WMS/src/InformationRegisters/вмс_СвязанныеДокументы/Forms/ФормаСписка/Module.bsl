
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВыделенныйЭлементСписка = Элемент.ТекущиеДанные[Поле.Имя];
	Если ЗначениеЗаполнено(ВыделенныйЭлементСписка) Тогда
		ПоказатьЗначение(,ВыделенныйЭлементСписка);
	КонецЕсли;
	
КонецПроцедуры
