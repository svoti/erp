Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	// Заголовок общих данных
	Макет = ПолучитьМакет("Макет");
	ОбластьОбщаяЗаголовок = Макет.ПолучитьОбласть("ОбластьОбщаяЗаголовок");
	ДокументРезультат.Вывести(ОбластьОбщаяЗаголовок);
	
	// Заполнение общих данных
	
	ОбщиеДанные = Новый Соответствие;
	ЛицензииПодсистем = ЛицензииПодсистем();
	Для каждого Лицензия Из ЛицензииПодсистем Цикл
		ОбщиеДанные.Вставить(Лицензия.Отображение, Лицензия.Лицензия);
	КонецЦикла;
	ОбщиеДанные.Вставить("Рег. номер", Справочники.вмс_НастройкиПрограммы.ПолучитьЗначениеНастройкиПрограммы("РегистрационныйНомер"));
	ОбщиеДанные.Вставить("Количество лицензий", КоличествоЛицензийТСД());
	
	Для каждого Настройка Из ОбщиеДанные Цикл
		ОбластьОбщаяСтрока = Макет.ПолучитьОбласть("ОбластьОбщаяСтрока");
		ОбластьОбщаяСтрока.Параметры.Название = Настройка.Ключ;
		ОбластьОбщаяСтрока.Параметры.Значение = Настройка.Значение;
		ДокументРезультат.Вывести(ОбластьОбщаяСтрока);
	КонецЦикла;
	
	// Заголовок настройки модуля
	Макет = ПолучитьМакет("Макет");
	ОбластьНастройкиМодуляЗаголовок = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляЗаголовок");
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляЗаголовок);
	
	// Заполнение настройки модуля	
	Настройка = Справочники.вмс_НастройкиПрограммы.ПолучитьНастройкуПрограммы("ИспользоватьКодыМаркировкиТоваров");
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = Настройка.Наименование;
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = Настройка.Значение;
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	Настройка = Справочники.вмс_НастройкиПрограммы.ПолучитьНастройкуПрограммы("ИспользоватьТару");
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = Настройка.Наименование;
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = Настройка.Значение;
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	Настройка = Справочники.вмс_НастройкиПрограммы.ПолучитьНастройкуПрограммы("ИспользоватьПомещения");
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = Настройка.Наименование;
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = Настройка.Значение;
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	Настройка = Справочники.вмс_НастройкиПрограммы.ПолучитьНастройкуПрограммы("Упаковки_ВестиУчетОстатковПоУпаковкам");
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = Настройка.Наименование;
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = Настройка.Значение;
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	Настройка = Справочники.вмс_НастройкиПрограммы.ПолучитьНастройкуПрограммы("ИспользоватьОтветственноеХранение");
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = Настройка.Наименование;
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = Настройка.Значение;
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = "Количество услуг ОХ";
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = КоличествоУслугОХ();
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = "Использовать характеристики";
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = вмс_АдаптацияКонфигураций.ИспользуютсяХарактеристики();
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = "Использовать серии";
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = вмс_ОперацииПоЯчейкамВызовСервера.ИспользуемыеТоварныеПоля().Найти("Серия") <> Неопределено;
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = "Видов серийных товаров";
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = КоличествоВидовСерийногоТовара();
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	ОбластьНастройкиМодуляСтрока = Макет.ПолучитьОбласть("ОбластьНастройкиМодуляСтрока");
	ОбластьНастройкиМодуляСтрока.Параметры.Название = "Использовать ВГХ";
	НастройкиРазмещения = вмс_РазмещениеСервер.НастройкиРазмещения();
	ВГХ_ИспользоватьВесогабариты = НастройкиРазмещения.ИспользоватьВГХ;
	ОбластьНастройкиМодуляСтрока.Параметры.Значение = ВГХ_ИспользоватьВесогабариты;
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляСтрока);
	
	// Заголовок топология
	Макет = ПолучитьМакет("Макет");
	ОбластьНастройкиМодуляЗаголовок = Макет.ПолучитьОбласть("ОбластьТопологияСкладаЗаголовок");
	ДокументРезультат.Вывести(ОбластьНастройкиМодуляЗаголовок);
	
	// Заполнение топология
	ТаблицаЗаполненияТопологии = ТаблицаЗаполненияТопологии();
	Для каждого Строка Из ТаблицаЗаполненияТопологии Цикл
		ОбластьТопологияСкладаСтрока = Макет.ПолучитьОбласть("ОбластьТопологияСкладаСтрока");
		ОбластьТопологияСкладаСтрока.Параметры.Заполнить(Строка);
		ДокументРезультат.Вывести(ОбластьТопологияСкладаСтрока);	
	КонецЦикла;
	
	// Заголовок операции
	Макет = ПолучитьМакет("Макет");
	ОбластьОперацииЗаголовок = Макет.ПолучитьОбласть("ОбластьОперацииЗаголовок");
	ДокументРезультат.Вывести(ОбластьОперацииЗаголовок);
	
	// Заполнение операции
	ТаблицаЗаполненияОпераций = ТаблицаЗаполненияОпераций();
	Для каждого Строка Из ТаблицаЗаполненияОпераций Цикл
		ОбластьОперацииСтрока = Макет.ПолучитьОбласть("ОбластьОперацииСтрока");
		ОбластьОперацииСтрока.Параметры.Заполнить(Строка);
		
		ТекстАлгоритмы = "";
		
		Для каждого СтрокаАлгоритмы Из Строка.Операция.Алгоритмы Цикл
			
			Если ЗначениеЗаполнено(СтрокаАлгоритмы.Алгоритм) И (СтрокаАлгоритмы.ПриСохранении ИЛИ СтрокаАлгоритмы.ПриЗавершении) Тогда	
				ТекстАлгоритмы = ТекстАлгоритмы + СтрШаблон("А: %1 (%2)", СтрокаАлгоритмы.Алгоритм, ?(СтрокаАлгоритмы.ПриЗавершении, "завершение", "сохранение"));
				ТекстАлгоритмы = ТекстАлгоритмы + Символы.ПС;
			КонецЕсли;
			
			
			Если ЗначениеЗаполнено(СтрокаАлгоритмы.ПравилоКонвертации) И (СтрокаАлгоритмы.ПриСохранении ИЛИ СтрокаАлгоритмы.ПриЗавершении) Тогда	
				ТекстАлгоритмы = ТекстАлгоритмы + СтрШаблон("ПК: %1 (%2)", СтрокаАлгоритмы.ПравилоКонвертации, ?(СтрокаАлгоритмы.ПриЗавершении, "завершение", "сохранение"));
				ТекстАлгоритмы = ТекстАлгоритмы + Символы.ПС;
			КонецЕсли;
			
		КонецЦикла;
		
		ОбластьОперацииСтрока.Параметры.Алгоритмы = ТекстАлгоритмы;
		
		ДокументРезультат.Вывести(ОбластьОперацииСтрока);
	КонецЦикла;
	
	
	
КонецПроцедуры

