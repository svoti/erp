Функция КоличествоЛицензийТСД()
	
	НаборЗаписей = РегистрыСведений.вмс_Лицензии.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	Возврат НаборЗаписей.Количество();
	
КонецФункции

Функция ЛицензииПодсистем()
	
	НаборЗаписей = РегистрыСведений.вмс_ЛицензииПодсистем.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	Возврат НаборЗаписей;
	
КонецФункции

Функция КоличествоУслугОХ()
	
	Текст = "
	|ВЫБРАТЬ
	|	вмс_УслугиОтветственногоХранения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.вмс_УслугиОтветственногоХранения КАК вмс_УслугиОтветственногоХранения
	|ГДЕ
	|	НЕ вмс_УслугиОтветственногоХранения.ПометкаУдаления
	|	И НЕ вмс_УслугиОтветственногоХранения.ЭтоГруппа
	|";
	
	Запрос = Новый Запрос(Текст);
	
	Возврат Запрос.Выполнить().Выбрать().Количество();
	
КонецФункции

Функция КоличествоВидовСерийногоТовара()
	
	НаборЗаписей = РегистрыСведений.вмс_СоединениеОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Схема.Установить(вмс_ОперацииПоЯчейкамВызовСервера.СхемаСоединения_ИспользованиеСерий());
	НаборЗаписей.Прочитать();
	
	Возврат НаборЗаписей.Количество();
	
КонецФункции

Функция ТаблицаЗаполненияТопологии()
	
	Текст = "
	|ВЫБРАТЬ
	|	вмс_МестаХранения.Владелец КАК НазваниеСклада,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вмс_МестаХранения.Ссылка) КАК КоличествоЯчеек,
	|	СУММА(ВЫБОР
	|			КОГДА вмс_МестаХранения.ТипЯчейки = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаПриемки)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЗонПриемки,
	|	СУММА(ВЫБОР
	|			КОГДА вмс_МестаХранения.ТипЯчейки = ЗНАЧЕНИЕ(Перечисление.вмс_ТипыЯчеек.ЗонаОтгрузки)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЗонОтгрузки
	|ИЗ
	|	Справочник.вмс_МестаХранения КАК вмс_МестаХранения
	|
	|СГРУППИРОВАТЬ ПО
	|	вмс_МестаХранения.Владелец
	|УПОРЯДОЧИТЬ ПО
	|	КоличествоЯчеек УБЫВ
	|";
	
	Запрос = Новый Запрос(Текст);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ТаблицаЗаполненияОпераций()
	Текст = "
	|ВЫБРАТЬ
	|	вмс_Операции.Ссылка КАК Операция,
	|	вмс_ПравилаЗаполненияЗадачиКладовщику.Ссылка КАК Правило,
	|	вмс_ПравилаЗаполненияЗадачиКладовщику.РаспоряжениеКонфигуратор КАК Распоряжение,
	|	вмс_ПравилаЗаполненияЗадачиКладовщику.ПодбиратьЯчейкиОтправители КАК ИспользоватьОтбор,
	|	вмс_ПравилаЗаполненияЗадачиКладовщику.ПодбиратьЯчейкиПолучатели КАК ИспользоватьРазмещение
	|ИЗ
	|	Справочник.вмс_Операции КАК вмс_Операции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.вмс_ПравилаЗаполненияЗадачиКладовщику КАК вмс_ПравилаЗаполненияЗадачиКладовщику
	|		ПО вмс_Операции.Ссылка = вмс_ПравилаЗаполненияЗадачиКладовщику.ОперацияНазначение
	|			И (НЕ вмс_ПравилаЗаполненияЗадачиКладовщику.ПометкаУдаления)
	|ГДЕ
	|	НЕ вмс_Операции.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Правило
	|";
	
	Запрос = Новый Запрос(Текст);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции




