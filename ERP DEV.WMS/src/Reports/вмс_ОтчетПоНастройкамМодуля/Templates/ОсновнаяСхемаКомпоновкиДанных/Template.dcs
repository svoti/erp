		<field xsi:type="DataSetFieldField">
			<dataPath>НастройкаОператора</dataPath>
			<field>НастройкаОператора</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Настройка оператора</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КодОператора</dataPath>
			<field>КодОператора</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Код оператора</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ФизическоеЛицоОператора</dataPath>
			<field>ФизическоеЛицоОператора</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Физическое лицо оператора</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЯчейкаОператора</dataPath>
			<field>ЯчейкаОператора</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ячейка оператора</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	вмс_НастройкиОператора.Ссылка КАК НастройкаОператора,
	ВЫРАЗИТЬ(вмс_НастройкиОператора.Код КАК СТРОКА(20)) КАК КодОператора,
	вмс_НастройкиОператора.Оператор КАК ФизическоеЛицоОператора,
	вмс_НастройкиОператора.Операции.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Операция КАК Операция,
		МастерОперация КАК МастерОперация
	) КАК Операции,
	вмс_НастройкиОператора.Принтеры.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		ТипПринтера КАК ТипПринтера,
		ПоУмолчанию КАК ПоУмолчанию,
		ИмяКомпьютера КАК ИмяКомпьютера,
		ПутьКПринтеру КАК ПутьКПринтеру,
		Принтер КАК Принтер
	) КАК Принтеры,
	вмс_НастройкиОператора.Склады.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Склад КАК Склад
	) КАК Склады,
	вмс_НастройкиОператора.Ячейки.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Ячейка КАК Ячейка
	) КАК Ячейки,
	вмс_НастройкиОператора.Помещения.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Помещение КАК Помещение
	) КАК Помещения,
	вмс_НастройкиОператора.ЯчейкаОтветственногоХранения КАК ЯчейкаОператора
ИЗ
	Справочник.вмс_НастройкиОператора КАК вмс_НастройкиОператора
ГДЕ
	вмс_НастройкиОператора.ПометкаУдаления = ЛОЖЬ</query>
	</dataSet>
