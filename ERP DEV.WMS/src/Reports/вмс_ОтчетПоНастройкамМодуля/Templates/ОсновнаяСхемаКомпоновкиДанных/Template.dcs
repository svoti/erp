					<v8:content>При сохранении</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТЧОперациАлгоритмы.ПриЗавершении</dataPath>
			<field>ТЧОперациАлгоритмы.ПриЗавершении</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>При завершении</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТЧОперациАлгоритмы.Комментарий</dataPath>
			<field>ТЧОперациАлгоритмы.Комментарий</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Комментарий</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	вмс_Операции.Ссылка КАК ОперацииСсылка,
	вмс_Операции.Код КАК ОперацииКод,
	вмс_Операции.Наименование КАК ОперацииНаименование,
	вмс_Операции.ИмяДляПоиска КАК ОперацииИмяДляПоиска,
	вмс_Операции.ПоРаспоряжению КАК ОперацииПоРаспоряжению,
	вмс_Операции.ОбработкаВФормеСписка КАК ОперацииОбработкаВФормеСписка,
	ВЫРАЗИТЬ(вмс_Операции.ЗапрашиватьУслугиХранения КАК БУЛЕВО) КАК ОперацииЗапрашиватьУслугиХранения,
	вмс_Операции.ИмяФормы КАК ОперацииИмяФормы,
	вмс_Операции.КлассОперации КАК ОперацииКлассОперации,
	вмс_Операции.ЭтоИнвентаризация КАК ОперацииЭтоИнвентаризация,
	вмс_Операции.Распоряжения.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Имя КАК Имя,
		Представление КАК Представление,
		СсылкаНаРаспоряжение КАК СсылкаНаРаспоряжение
	) КАК ТЧОперациРаспоряжения,
	вмс_Операции.ЭтапыОперации.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Этап КАК Этап,
		Статус КАК Статус
	) КАК ТЧОперациЭтапыОперации,
	вмс_Операции.ОтветственноеХранение.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Операция КАК Операция
	) КАК ТЧОперациОтветственноеХранение,
	вмс_Операции.Алгоритмы.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Алгоритм КАК Алгоритм,
		ПриСохранении КАК ПриСохранении,
		ПриЗавершении КАК ПриЗавершении,
		Комментарий КАК Комментарий,
		ПравилоКонвертации КАК ПравилоКонвертации
	) КАК ТЧОперациАлгоритмы
ИЗ
	Справочник.вмс_Операции КАК вмс_Операции
ГДЕ
	вмс_Операции.ПометкаУдаления = ЛОЖЬ</query>
	</dataSet>
