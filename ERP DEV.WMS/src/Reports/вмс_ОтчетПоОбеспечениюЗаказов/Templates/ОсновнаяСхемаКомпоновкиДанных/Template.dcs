		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОстаткиПодобраны</dataPath>
			<field>ОстаткиПодобраны</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Остатки подобраны</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОтгружатьСоСлужебнойЗоныОтправителя</dataPath>
			<field>ОтгружатьСоСлужебнойЗоныОтправителя</field>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИспользоватьЗонуОтправитель</dataPath>
			<field>ИспользоватьЗонуОтправитель</field>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Правило</dataPath>
			<field>Правило</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Правило</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Состояние</dataPath>
			<field>Состояние</field>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	вмс_ЗаданиеКладовщику.Распоряжение КАК Распоряжение,
	вмс_ЗаданиеКладовщику.Дата КАК Дата,
	вмс_ЗаданиеКладовщику.Ссылка КАК Задание,
	вмс_ЗаданиеКладовщику.Состояние КАК Состояние,
	ВЫБОР
		КОГДА вмс_ЗаданиеКладовщику.Состояние = ЗНАЧЕНИЕ(Перечисление.вмс_СостоянияЗаявокКладовщику.Подготовлена)
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ОстаткиПодобраны,
	вмс_ПравилаЗаполненияЗадачиКладовщику.Ссылка КАК Правило,
	вмс_ПравилаЗаполненияЗадачиКладовщику.ПодбиратьЯчейкиОтправители КАК ПодбиратьЯчейкиОтправители,
	вмс_ПравилаЗаполненияЗадачиКладовщику.ИспользоватьЗонуОтправитель КАК ИспользоватьЗонуОтправитель,
	вмс_ПравилаЗаполненияЗадачиКладовщику.ОтгружатьСоСлужебнойЗоныОтправителя КАК ОтгружатьСоСлужебнойЗоныОтправителя
ИЗ
	Документ.вмс_ЗаданиеКладовщику КАК вмс_ЗаданиеКладовщику
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.вмс_ПравилаЗаполненияЗадачиКладовщику КАК вмс_ПравилаЗаполненияЗадачиКладовщику
		ПО вмс_ЗаданиеКладовщику.Правило = вмс_ПравилаЗаполненияЗадачиКладовщику.Ссылка

УПОРЯДОЧИТЬ ПО
	Дата</query>
	</dataSet>
