	<dataSet xsi:type="DataSetQuery">
		<name>ОСГ</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПроизводства</dataPath>
			<field>ДатаПроизводства</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ГоденДо</dataPath>
			<field>ГоденДо</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СрокГодности</dataPath>
			<field>СрокГодности</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Срок годности</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОСГ</dataPath>
			<field>ОСГ</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>ОСГ</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Серия</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:required>true</dcscom:required>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	вмс_СерииНоменклатуры.Ссылка КАК Серия,
	вмс_СерииНоменклатуры.ДатаПроизводства КАК ДатаПроизводства,
	вмс_СерииНоменклатуры.ГоденДо КАК ГоденДо,
	РАЗНОСТЬДАТ(вмс_СерииНоменклатуры.ДатаПроизводства, вмс_СерииНоменклатуры.ГоденДо, ДЕНЬ) КАК СрокГодности,
	ВЫБОР
		КОГДА РАЗНОСТЬДАТ(вмс_СерииНоменклатуры.ДатаПроизводства, вмс_СерииНоменклатуры.ГоденДо, ДЕНЬ) &gt; 0
				И РАЗНОСТЬДАТ(&amp;ТекущаяДата, вмс_СерииНоменклатуры.ГоденДо, ДЕНЬ) &gt; 0
			ТОГДА ВЫРАЗИТЬ(100 * РАЗНОСТЬДАТ(&amp;ТекущаяДата, вмс_СерииНоменклатуры.ГоденДо, ДЕНЬ) / РАЗНОСТЬДАТ(вмс_СерииНоменклатуры.ДатаПроизводства, вмс_СерииНоменклатуры.ГоденДо, ДЕНЬ) КАК ЧИСЛО(15,2))
		ИНАЧЕ 0
	КОНЕЦ КАК ОСГ
ИЗ
	Справочник.вмс_СерииНоменклатуры КАК вмс_СерииНоменклатуры</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>ТаблицаРезультата</sourceDataSet>
		<destinationDataSet>ОСГ</destinationDataSet>
		<sourceExpression>Серия</sourceExpression>
		<destinationExpression>Серия</destinationExpression>
	</dataSetLink>
	<calculatedField>
		<dataPath>КоличествоНеОбеспечено</dataPath>
		<expression>ВЫБОР
	КОГДА КоличествоЗаказано &gt; КоличествоОбеспечено ТОГДА
		КоличествоЗаказано - КоличествоОбеспечено
	ИНАЧЕ
		0
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Количество не обеспечено</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>КоличествоЗаказано</dataPath>
		<expression>Сумма(КоличествоЗаказано)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоОбеспечено</dataPath>
		<expression>Сумма(КоличествоОбеспечено)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоНеОбеспечено</dataPath>
		<expression>Сумма(КоличествоНеОбеспечено)</expression>
	</totalField>
	<totalField>
		<dataPath>ОСГ</dataPath>
		<expression>Максимум(ОСГ)</expression>
		<group>Серия</group>
	</totalField>
	<parameter>
		<name>ТекущаяДата</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Текущая дата</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>ТекущаяДата()</expression>
	</parameter>
	<settingsVariant>
		<dcsset:name>ОбеспечениеЗаказов</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Обеспечение заказов</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:pal="http://v8.1c.ru/8.1/data/ui/colors/palette" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Распоряжение</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Номенклатура</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ОСГ</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КоличествоЗаказано</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КоличествоОбеспечено</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:filter>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:left xsi:type="dcscor:Field">Распоряжение</dcsset:left>
					<dcsset:comparisonType>Filled</dcsset:comparisonType>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:left xsi:type="dcscor:Field">Состояние</dcsset:left>
					<dcsset:comparisonType>InList</dcsset:comparisonType>
					<dcsset:right xsi:type="dcscor:DesignTimeValue">Перечисление.вмс_СостоянияЗаявокКладовщику.Подготовлена</dcsset:right>
					<dcsset:right xsi:type="dcscor:DesignTimeValue">Перечисление.вмс_СостоянияЗаявокКладовщику.Обрабатывается</dcsset:right>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:left xsi:type="dcscor:Field">ПодбиратьЯчейкиОтправители</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:left xsi:type="dcscor:Field">ОтгружатьСоСлужебнойЗоныОтправителя</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:left xsi:type="dcscor:Field">ИспользоватьЗонуОтправитель</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:left xsi:type="dcscor:Field">КоличествоНеОбеспечено</dcsset:left>
					<dcsset:comparisonType>Greater</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:decimal">0</dcsset:right>
					<dcsset:presentation xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Только необеспеченные</v8:content>
						</v8:item>
					</dcsset:presentation>
					<dcsset:userSettingID>c44c0b5a-b557-484d-b327-7ec23c0f7f5c</dcsset:userSettingID>
				</dcsset:item>
			</dcsset:filter>
			<dcsset:conditionalAppearance>
				<dcsset:item>
					<dcsset:selection/>
					<dcsset:filter>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:left xsi:type="dcscor:Field">КоличествоНеОбеспечено</dcsset:left>
							<dcsset:comparisonType>Greater</dcsset:comparisonType>
							<dcsset:right xsi:type="xs:decimal">0</dcsset:right>
						</dcsset:item>
					</dcsset:filter>
					<dcsset:appearance>
						<dcscor:item xsi:type="dcsset:SettingsParameterValue">
							<dcscor:parameter>ЦветФона</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Color">#FFC8C8</dcscor:value>
						</dcscor:item>
					</dcsset:appearance>
					<dcsset:useInFieldsHeader>DontUse</dcsset:useInFieldsHeader>
					<dcsset:useInHeader>DontUse</dcsset:useInHeader>
					<dcsset:useInParameters>DontUse</dcsset:useInParameters>
					<dcsset:useInFilter>DontUse</dcsset:useInFilter>
				</dcsset:item>
				<dcsset:item>
					<dcsset:selection>
						<dcsset:item>
