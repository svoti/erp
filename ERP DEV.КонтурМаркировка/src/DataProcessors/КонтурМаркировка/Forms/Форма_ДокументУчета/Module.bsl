		ДоступностьКнопки = Истина;
	КонецЕсли;
	
	Кнопка.Заголовок = ЗаголовокКнопки;
	Кнопка.Доступность = ДоступностьКнопки;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокКодыМаркировки()
	
	КодыМаркировки.ТекстЗапроса = ТекстЗапросаКодыМаркировки();
	
	РезультатыПроверкиКодов = МодульОбъекта().Перечисление_РезультатыПроверкиКодовДокументов();
	
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПустаяДата", '00010101');
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ДокументУчета", Ссылка);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПоказатьСписанные", Не Элементы.Кнопка_СкрытьСписанныеКоды.Пометка);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПустойКонтрагент", Справочники.КонтурМаркировка_Контрагенты.ПустаяСсылка());
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусКода_Списан", МодульОбъекта().Перечисление_СтатусыКодов().Списан);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("Проверен", РезультатыПроверкиКодов.Проверен);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("НеТребуется", РезультатыПроверкиКодов.НеТребуется);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСпискиКодовИАгрегатов()
	
	ОбновитьСписокКодовМаркировки();
	ОбновитьСписокАгрегатов();
	
	ЗаполнитьКоличествоКодовПоСтатусам();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокКодовМаркировки()
	
	ЗаполнитьКоличествоКодов();
	ЗаполнитьКоличествоЗаводскихСерийныхНомеров();
	
	Элементы.КодыМаркировки.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокАгрегатовПослеОткрытияВкладки() Экспорт
	
	ОбновитьСписокАгрегатов();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокАгрегатов()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	КодыДокументов.КлючПроверкиКода КАК КлючПроверкиКода,
	|	ИнформацияОКодах.Товар КАК Товар,
	|	ИнформацияОКодах.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ИнформацияОКодах.ДатаПечати КАК ДатаПечати,
	|	КодыМаркировки.КлючСтатусаКода КАК КлючСтатусаКода,
	|	КодыМаркировки.КоличествоУпаковок КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ТабКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ИнформацияОКодах.КлючИнформацииОКоде = КодыМаркировки.КлючИнформацииОКоде
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО (КодыМаркировки.КлючКода = КодыДокументов.КлючКода)
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	ИнформацияОКодах.ОбщийТипУпаковки = &ТранспортнаяУпаковка
	|	И КодыДокументов.КлючКода ЕСТЬ НЕ NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыДокумента.ПредставлениеСтроки КАК СтрокаДокумента,
	|	ТабКодов.КодМаркировки КАК КодМаркировки,
	|	ЕСТЬNULL(ТоварыАгрегатов.Товар, ТабКодов.Товар) КАК Товар,
	|	ЕСТЬNULL(ТоварыАгрегатов.КлючНоменклатуры1С, ТабКодов.КлючНоменклатуры1С) КАК КлючНоменклатуры1С,
	|	ЕСТЬNULL(ТоварыАгрегатов.КоличествоУпаковок, ТабКодов.КоличествоУпаковок) КАК КоличествоУпаковок,
	|	ТабКодов.КлючКода КАК КлючКода,
	|	ТабКодов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	СтатусыКодов.Владелец КАК Владелец,
	|	СтатусыКодов.Статус КАК СтатусКода,
	|	СтатусыКодов.ОсобоеСостояниеКода КАК ОсобоеСостояниеКода,
	|	ВЫБОР
	|		КОГДА ТабКодов.ДатаПечати > &ПустаяДата
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Напечатан,
	|	ЛОЖЬ КАК УровеньАгрегата,
	|	ВЫБОР
	|		КОГДА ТоварыДокумента.КлючСтрокиДокумента ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьСтрокаДокумента,
	|	РезультатыПроверкиКодов.ПроверкаРД КАК ПроверкаРД,
	|	ВЫБОР
	|		КОГДА РезультатыПроверкиКодов.ПроверкаРД ЕСТЬ NULL
	|				ИЛИ РезультатыПроверкиКодов.ПроверкаРД = &НеТребуется
	|			ТОГДА -1
	|		КОГДА РезультатыПроверкиКодов.ПроверкаРД = &Проверен
	|			ТОГДА 4
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ИндексКартинкиПроверкаРД,
	|	РезультатыПроверкиКодов.ПроверкаСтатуса КАК ПроверкаСтатуса,
	|	ВЫБОР
	|		КОГДА РезультатыПроверкиКодов.ПроверкаСтатуса ЕСТЬ NULL
	|				ИЛИ РезультатыПроверкиКодов.ПроверкаСтатуса = &НеТребуется
	|			ТОГДА -1
	|		КОГДА РезультатыПроверкиКодов.ПроверкаСтатуса = &Проверен
	|			ТОГДА 4
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ИндексКартинкиПроверкаСтатуса,
	|	РезультатыПроверкиКодов.ПроверкаВладельца КАК ПроверкаВладельца,
	|	ВЫБОР
	|		КОГДА РезультатыПроверкиКодов.ПроверкаВладельца ЕСТЬ NULL
	|				ИЛИ РезультатыПроверкиКодов.ПроверкаВладельца = &НеТребуется
	|			ТОГДА -1
	|		КОГДА РезультатыПроверкиКодов.ПроверкаВладельца = &Проверен
	|			ТОГДА 4
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ИндексКартинкиПроверкаВладельца,
	|	РезультатыПроверкиКодов.ДопПроверка1 КАК ДопПроверка1,
	|	ВЫБОР
	|		КОГДА РезультатыПроверкиКодов.ДопПроверка1 ЕСТЬ NULL
	|				ИЛИ РезультатыПроверкиКодов.ДопПроверка1 = &НеТребуется
	|			ТОГДА -1
	|		КОГДА РезультатыПроверкиКодов.ДопПроверка1 = &Проверен
	|			ТОГДА 4
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ИндексКартинкиДопПроверка1,
	|	РезультатыПроверкиКодов.ДопПроверка2 КАК ДопПроверка2,
	|	ВЫБОР
	|		КОГДА РезультатыПроверкиКодов.ДопПроверка2 ЕСТЬ NULL
	|				ИЛИ РезультатыПроверкиКодов.ДопПроверка2 = &НеТребуется
	|			ТОГДА -1
	|		КОГДА РезультатыПроверкиКодов.ДопПроверка2 = &Проверен
	|			ТОГДА 4
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ИндексКартинкиДопПроверка2
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО ТабКодов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО ТабКодов.КлючКода = ТоварыАгрегатов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО ТабКодов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_РезультатыПроверкиКодов КАК РезультатыПроверкиКодов
	|		ПО ТабКодов.КлючПроверкиКода = РезультатыПроверкиКодов.КлючПроверкиКода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕстьСтрокаДокумента УБЫВ,
	|	СтрокаДокумента,
	|	КодМаркировки
	|ИТОГИ
	|	МАКСИМУМ(СтрокаДокумента),
	|	МАКСИМУМ(КодМаркировки),
	|	СУММА(КоличествоУпаковок),
	|	МАКСИМУМ(КлючСтрокиДокумента),
	|	МАКСИМУМ(Владелец),
	|	МАКСИМУМ(СтатусКода),
	|	МАКСИМУМ(ОсобоеСостояниеКода),
	|	МАКСИМУМ(Напечатан),
	|	МАКСИМУМ(ЕстьСтрокаДокумента),
	|	МАКСИМУМ(ПроверкаРД),
	|	МАКСИМУМ(ИндексКартинкиПроверкаРД),
	|	МАКСИМУМ(ПроверкаСтатуса),
	|	МАКСИМУМ(ИндексКартинкиПроверкаСтатуса),
	|	МАКСИМУМ(ПроверкаВладельца),
	|	МАКСИМУМ(ИндексКартинкиПроверкаВладельца),
	|	МАКСИМУМ(ДопПроверка1),
	|	МАКСИМУМ(ИндексКартинкиДопПроверка1),
	|	МАКСИМУМ(ДопПроверка2),
	|	МАКСИМУМ(ИндексКартинкиДопПроверка2)
	|ПО
	|	КлючКода");
	
	РезультатыПроверкиКодов = МодульОбъекта().Перечисление_РезультатыПроверкиКодовДокументов();
	
	Запрос.УстановитьПараметр("ДокументУчета", Ссылка);
	Запрос.УстановитьПараметр("ПустаяДата", МодульОбъекта().ПустаяДата());
	Запрос.УстановитьПараметр("ТранспортнаяУпаковка", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	Запрос.УстановитьПараметр("НеТребуется", РезультатыПроверкиКодов.НеТребуется);
	Запрос.УстановитьПараметр("Проверен", РезультатыПроверкиКодов.Проверен);
	
	АгрегатыСТоварами = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	Для Каждого СтрАгрегата Из АгрегатыСТоварами.Строки Цикл
		СтрАгрегата.УровеньАгрегата = Истина;
		
		Для Каждого СтрТовара Из СтрАгрегата.Строки Цикл
			
			СтрТовара.ИндексКартинкиПроверкаРД = -1;
			СтрТовара.ИндексКартинкиПроверкаСтатуса = -1;
			СтрТовара.ИндексКартинкиПроверкаВладельца = -1;
			СтрТовара.ИндексКартинкиДопПроверка1 = -1;
			СтрТовара.ИндексКартинкиДопПроверка2 = -1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(АгрегатыСТоварами, "Агрегаты");
	
	ПосчитатьКоличествоСтрокТаблицФормы();
	ЗаполнитьКоличествоКодов();
	
	СписокАгрегатовЗаполнен = Истина;
	
КонецПроцедуры

&НаСервере
Функция СоответствиеЭлементовИКомандДокументов()
	
	НаборКоманд = МодульОбъекта().Перечисление_КомандыДокумента();
	
	Результат = Новый Соответствие;
	Результат.Вставить("Кнопка_ЗаказатьКоды",         НаборКоманд.ЗаказКодов);
	Результат.Вставить("Кнопка_ПодобратьКодыИзПула",  НаборКоманд.ПодборСвободныхОстатков);
	Результат.Вставить("Кнопка_НаполнитьКодамиНаТСД", НаборКоманд.НаполнитьНаТСД);
	
	Результат.Вставить("Кнопка_НаполнитьКодамиНаТСДНачатьРаботу",               НаборКоманд.НаполнитьНаТСДНачатьРаботу);
	Результат.Вставить("Кнопка_НаполнитьКодамиИзВнешнегоИсточникаНачатьРаботу", НаборКоманд.НаполнитьКодамиИзВнешнегоИсточникаНачатьРаботу);
	Результат.Вставить("Кнопка_НаполнитьКодамиИзДругогоДокументаНачатьРаботу",  НаборКоманд.НаполнитьКодамиИзДругогоДокументаНачатьРаботу);
	Результат.Вставить("Кнопка_НаполнитьКодамиИзФайловНачатьРаботу",            НаборКоманд.НаполнитьКодамиИзФайловНачатьРаботу);
	
	Результат.Вставить("Кнопка_НаполнитьКодамиИзВнешнегоИсточника",    НаборКоманд.НаполнитьКодамиИзВнешнегоИсточника);
	Результат.Вставить("Кнопка_НаполнитьКодамиИзДругогоДокумента",     НаборКоманд.НаполнитьКодамиИзДругогоДокумента);
	Результат.Вставить("Кнопка_НаполнитьКодамиИзДокументаОснования",   НаборКоманд.НаполнитьКодамиИзОснования);
	Результат.Вставить("Кнопка_НаполнитьКодамиИзВходящегоУПД",         НаборКоманд.НаполнитьКодамиИзВходящегоУПД);
	Результат.Вставить("Кнопка_НаполнитьКодамиИзФайлов",               НаборКоманд.НаполнитьКодамиИзФайлов);
	Результат.Вставить("Кнопка_НаполнитьКодамиИзТабличногоДокумента",  НаборКоманд.НаполнитьКодамиИзТабличногоДокумента);
	Результат.Вставить("Кнопка_НаполнитьКодамиСПомощьюСканера",        НаборКоманд.НаполнитьКодамиСПомощьюСканера);
	Результат.Вставить("Кнопка_НаполнитьАгрегамиИзДокументаОснования", НаборКоманд.НаполнитьАгрегатамиИзОснования);
	
	Результат.Вставить("Кнопка_ЗаполнитьПартииИзКодов",        НаборКоманд.ЗаполнитьПартииИзКодов);
	Результат.Вставить("Кнопка_ЗаполнитьПартииИзВходящегоУПД", НаборКоманд.ЗаполнитьПартииИзВходящегоУПД);
	
	Результат.Вставить("Кнопка_КорректироватьСведения",   НаборКоманд.КорректировкаСведений);
	Результат.Вставить("Кнопка_УведомитьОСостоянииКодов", НаборКоманд.УведомлениеОСостоянииКодов);
	
	Результат.Вставить("Кнопка_НапечататьЭтикетки",  НаборКоманд.ПечатьКодов);
	Результат.Вставить("Кнопка_НапечататьЭтикетки1", НаборКоманд.ПечатьКодов);
	
	Результат.Вставить("Кнопка_СоздатьОтчетОНанесении",         НаборКоманд.ОтчетОНанесении);
	Результат.Вставить("Кнопка_СоздатьОтчетОНанесении1",        НаборКоманд.ОтчетОНанесении);
	Результат.Вставить("Кнопка_НаполнитьОтчетОНанесенииНаТСД",  НаборКоманд.ОтчетОНанесенииНаТСД);
	Результат.Вставить("Кнопка_НаполнитьОтчетОНанесенииНаТСД1", НаборКоманд.ОтчетОНанесенииНаТСД);
	
	Результат.Вставить("Кнопка_ВвестиВОборот",  НаборКоманд.ВводВоборот);
	Результат.Вставить("Кнопка_ВвестиВОборот1", НаборКоманд.ВводВоборот);
	
	Результат.Вставить("Кнопка_ВывестиИзОборота",  НаборКоманд.ВыводИзОборота);
	Результат.Вставить("Кнопка_ВывестиИзОборота1", НаборКоманд.ВыводИзОборота);
	
	Результат.Вставить("Кнопка_ВернутьВОборот",  НаборКоманд.ВозвратВОборот);
	Результат.Вставить("Кнопка_ВернутьВОборот1", НаборКоманд.ВозвратВОборот);
	
	Результат.Вставить("Кнопка_НаполнитьВозвратВОборотНаТСД",  НаборКоманд.ВозвратВОборотНаТСД);
	Результат.Вставить("Кнопка_НаполнитьВозвратВОборотНаТСД1", НаборКоманд.ВозвратВОборотНаТСД);
	
	Результат.Вставить("Кнопка_СоздатьОтчетОВыбытии",         НаборКоманд.ОтчетОВыбытии);
	Результат.Вставить("Кнопка_СоздатьОтчетОВыбытии1",        НаборКоманд.ОтчетОВыбытии);
	Результат.Вставить("Кнопка_НаполнитьОтчетОВыбытииНаТСД",  НаборКоманд.ОтчетОВыбытииНаТСД);
	Результат.Вставить("Кнопка_НаполнитьОтчетОВыбытииНаТСД1", НаборКоманд.ОтчетОВыбытииНаТСД);
	
	Результат.Вставить("Кнопка_АгрегироватьКоды",        НаборКоманд.АгрегацияКоды);
	Результат.Вставить("Кнопка_АгрегироватьКоды1",       НаборКоманд.АгрегацияКоды);
