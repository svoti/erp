&НаСервере
Процедура СформироватьДополнительныеКнопки()
	
	РазмещенияКнопок = МодульОбъекта().Перечисление_РазмещениеДополнительныхКнопок();
	
	// Шапка
	Действие = "Шапка_ДополнительнаяКнопкаНажатие";
	ГруппаКнопок = Элементы.ШапкаДопКнопки;
	НастройкиКнопок = МодульОбъекта().НастройкиДополнительныхКнопок(РазмещенияКнопок.ДокументУчетаШапка, ТипДокумента);
	МодульОбъекта().ДобавитьНаФормуДополнительныеКнопки(ЭтаФорма, НастройкиКнопок, ГруппаКнопок, Действие);
	
	// Коды маркировки
	Действие = "КодыМаркировки_ДополнительнаяКнопкаНажатие";
	ГруппаКнопок = Элементы.СписокКодовДопКнопки;
	НастройкиКнопок = МодульОбъекта().НастройкиДополнительныхКнопок(РазмещенияКнопок.ДокументУчетаСписокКодов, ТипДокумента);
	МодульОбъекта().ДобавитьНаФормуДополнительныеКнопки(ЭтаФорма, НастройкиКнопок, ГруппаКнопок, Действие);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеПриОткрытии()
	
	Если ДействиеПриОткрытии = "ПроверитьЗаполнениеПолей" Тогда
		ПроверитьЗаполнениеПолей();
	КонецЕсли;
	
	Если ДействиеПриОткрытии = "ПроверитьВозможностьЗавершитьРаботу" Тогда
		Если Не ПроверитьВозможностьЗавершитьРаботу() Тогда
			ТоварыДокумента_СообщитьОбОшибках();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КонтекстОтчетаПоВиртуальномуСкладу()
	
	Если ТоварыМаркировки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = МодульОбъекта().Новый_ОтчетПоВиртуальномуСкладу_Контекст();
	
	Результат.Организация = Организация;
	Результат.ФормаИнициатор = "Форма_ДокументУчета";
	Для Каждого Строка Из ТоварыМаркировки Цикл
		Результат.СписокТоваров.Добавить(Строка.Товар);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПровестиОпросПользователяИЗакрыть()
	
	КлючиСценариев = МодульКлиента().Перечисление_КлючиСценариевДляОпросов();
	ОписаниеОпроса = МодульКлиента().ОпросПользователяПоСценарию(КлючиСценариев.ДокументУчета);
	
	Если ЗначениеЗаполнено(ОписаниеОпроса) Тогда
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПослеОпросаПользователя", ЭтаФорма);
		МодульКлиента().ОткрытьФормуОпросаПользователя(ОписаниеОпроса, ЭтаФорма, ОписаниеОбработчика);
		Возврат;
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОпросаПользователя(РезультатВыбора, ДопПараметры = Неопределено) Экспорт
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура Агрегаты_Сортировать(ИмяКолонки, Направление)
	
	КолонкаСортировки = ИмяКолонки + " " + Направление;
	СортироватьПодчиненные = (ИмяКолонки = "Товар" Или ИмяКолонки = "КлючНоменклатуры1С");
	
	ДеревоАгрегатов = РеквизитФормыВЗначение("Агрегаты");
	ДеревоАгрегатов.Строки.Сортировать(КолонкаСортировки, СортироватьПодчиненные, Новый СравнениеЗначений);
	ЗначениеВРеквизитФормы(ДеревоАгрегатов, "Агрегаты");
	
КонецПроцедуры

&НаКлиенте
Процедура Агрегаты_УдалитьИзДокументаПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Агрегаты_УдалитьИзДокументаПослеСогласияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура Агрегаты_УдалитьИзДокументаПослеСогласияНаСервере() Экспорт
	
	КлючиКодов = Новый Массив;
	Для каждого ИдентификаторСтроки Из Элементы.Агрегаты.ВыделенныеСтроки Цикл
		Стр = Агрегаты.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Стр.УровеньАгрегата Тогда
			КлючиКодов.Добавить(Стр.КлючКода);
		КонецЕсли;
	КонецЦикла;
	
	МодульОбъекта().КодыДокументов_УдалитьКоды(Ссылка, КлючиКодов);
	
	ОбновитьРезультатыПроверкиКодов();
	ОбновитьСписокАгрегатов();
	ПосчитатьКоличествоСтрокТаблицФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_УдалитьИзДокументаПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Коды_УдалитьИзДокументаПослеСогласияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура Коды_УдалитьИзДокументаПослеСогласияНаСервере()
	
	КлючиКодов = Новый Массив;
	Для каждого Стр Из Элементы.КодыМаркировки.ВыделенныеСтроки Цикл
		КлючиКодов.Добавить(Стр.КлючКода);
	КонецЦикла;
	
	МодульОбъекта().КодыДокументов_УдалитьКоды(Ссылка, КлючиКодов);
	
	ОбновитьРезультатыПроверкиКодов();
	ОбновитьСписокКодовМаркировки();
	ПосчитатьКоличествоСтрокТаблицФормы();
	
КонецПроцедуры

&НаСервере
Функция ДокументуДоступнаРоль(РольДокумента)
	
	Возврат МодульОбъекта().ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РольДокумента);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПартииИВесИзВходящегоУПД(РезультатВыбора, ОчиститьПартии)
	
	ВходящийУПД = РезультатВыбора.Объект;
	ТаблицаПартий = МодульОбъекта().Операция_ВходящийУПД_ПартииТоваров(ВходящийУПД);
	ТаблицаПартий.Колонки.Добавить("Распределено", МодульОбъекта().ОписаниеТипа_Булево());
	
	ТаблицаТоваров = ТоварыМаркировки.Выгрузить();
	Если ОчиститьПартии Тогда
		МодульОбъекта().ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаТоваров, "КоличествоУпаковок", "НомерПартии");
	КонецЕсли;
	
	МодульОбъекта().ДокументУчета_РаспределитьПартии(ТаблицаТоваров, ТаблицаПартий);
	ТоварыМаркировки.Загрузить(ТаблицаТоваров);
	
	ЗаполнитьПризнакПеременныйВес();
	ЗаполнитьДоступностьПартионногоУчета();
	
	ТоварыДокумента_ОбновитьОтраженияВЭДО();
	НастроитьВидимостьЭлементовФормы();
	
	ПроверитьТоварыМаркировки();
	ТоварыМаркировки_ПроверитьРаспределениеПартий();
	
	Функциональность = МодульОбъекта().Перечисление_ФункциональностьМодуля().ЗаполнитьПартииИзВходящегоУПД;
	МодульОбъекта().Метрика_Функциональность_ЗаполнитьПартииВДокументеУчета(Ссылка, Функциональность);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ТоварыМаркировки_ПроверитьРаспределениеПартий()
	
	ПравилаОтражения = МодульОбъекта().Перечисление_ПравилаОтраженияВЭДО();
	
	ОтборТоварБезПарт = Новый Структура("ДоступенПартионныйУчет, НомерПартии", Истина, "");
	СтрокиБезПартий = ТоварыМаркировки.Выгрузить(ОтборТоварБезПарт, "КлючСтрокиДокумента, Товар, КоличествоУпаковок");
	СтрокиБезПартий.Свернуть("КлючСтрокиДокумента, Товар", "КоличествоУпаковок");
	
	ШаблонОшибки = НСтр("ru='Строка товара %1. Для товара %2 не заполнена партия для %3 уп.'");
	
	ОтборКлючСтроки = Новый Структура("КлючСтрокиДокумента");
	ОтборКлючСтрокиТовар = Новый Структура("КлючСтрокиДокумента, Товар");
	
	Для Каждого Стр Из СтрокиБезПартий Цикл
		
		Если Стр.КоличествоУпаковок < 1 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОтборКлючСтроки, Стр);
		ЗаполнитьЗначенияСвойств(ОтборКлючСтрокиТовар, Стр);
		
		Для каждого СтрДокумента Из ТоварыДокумента.НайтиСтроки(ОтборКлючСтроки) Цикл
			Если СтрДокумента.ОтражениеВЭДО <> ПравилаОтражения.ПартионныйУчет Тогда
				Продолжить;
			КонецЕсли;
			ТекстОшибки = МодульОбъекта().ПараметрыВСтроку(ШаблонОшибки
			, СтрДокумента.ПредставлениеСтроки
			, Стр.Товар
			, Стр.КоличествоУпаковок);
			МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ТоварыМаркировки_Свернуть()
	
	ВременнаяТаблица = ТоварыМаркировки.Выгрузить();
	МодульОбъекта().ТаблицаЗначений_СвернутьПоВсемКолонкам(ВременнаяТаблица, "Количество, КоличествоУпаковок");
	
	ТоварыМаркировки.Очистить();
	ТоварыМаркировки.Загрузить(ВременнаяТаблица);
	
КонецПроцедуры

&НаСервере
Функция ТоварыМаркировки_ИтогиПоПартиям()
	
	ОтборДоступенПартионныйУчет = Новый Структура("ДоступенПартионныйУчет", Истина);
	
	Результат = ТоварыМаркировки.Выгрузить(ОтборДоступенПартионныйУчет);
	Результат.Свернуть("КлючСтрокиДокумента, Товар, НомерПартии", "КоличествоУпаковок, Количество");
	
	МодульОбъекта().ТаблицаЗначений_УдалитьЗначение(Результат, "НомерПартии", "");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ТоварыДокумента_ОбновитьОтраженияВЭДО(КлючСтрокиДокумента = Неопределено)
	
	ТаблицаПартий = ТоварыМаркировки_ИтогиПоПартиям();
	ПравилаОтражения = МодульОбъекта().Перечисление_ПравилаОтраженияВЭДО();
	
	Если ЗначениеЗаполнено(КлючСтрокиДокумента) Тогда
		МодульОбъекта().ТаблицаЗначений_УдалитьДругиеЗначения(ТаблицаПартий
		, "КлючСтрокиДокумента"
		, МодульОбъекта().ЗначениеВМассиве(КлючСтрокиДокумента));
	КонецЕсли;
	
	ШаблонСообщения = НСтр("ru='В строке %1 установлено отражение в ЭДО ""%2""'");
	КлючиСтрокСПартиями = МодульОбъекта().ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаПартий, "КлючСтрокиДокумента", Истина);
	
	ОтборПоКлючу = Новый Структура("КлючСтрокиДокумента");
	Для Каждого КлючСтроки Из КлючиСтрокСПартиями Цикл
		ОтборПоКлючу.КлючСтрокиДокумента = КлючСтроки;
		Для Каждого СтрДокумента Из ТоварыДокумента.НайтиСтроки(ОтборПоКлючу) Цикл
			Если СтрДокумента.ОтражениеВЭДО = ПравилаОтражения.ПартионныйУчет Тогда
				Продолжить;
			КонецЕсли;
			СтрДокумента.ОтражениеВЭДО = ПравилаОтражения.ПартионныйУчет;
			ТекстСообщения = МодульОбъекта().ПараметрыВСтроку(ШаблонСообщения
			, СтрДокумента.ПредставлениеСтроки
			, СтрДокумента.ОтражениеВЭДО);
			МодульОбъекта().СообщитьПользователюЛок(ТекстСообщения);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПартииИВесИзКодовМаркировки()
	
	Если Не МодульОбъекта().КодыДокументов_ЕстьПартионныйУчет(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПравилаОтражения = МодульОбъекта().Перечисление_ПравилаОтраженияВЭДО();
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		
		КлючСтрокиДокумента = Стр.КлючСтрокиДокумента;
		
		Если Стр.ОтражениеВЭДО <> ПравилаОтражения.ОСУ
			И Стр.ОтражениеВЭДО <> ПравилаОтражения.ПартионныйУчет Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ТоварыМаркировки_ДоступенПартионныйУчет(КлючСтрокиДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьПартииИВесИзКодовМаркировкиДляСтрокиДокумента(КлючСтрокиДокумента);
		
	КонецЦикла;
	
	ЗаполнитьПризнакПеременныйВес();
	ЗаполнитьДоступностьПартионногоУчета();
	
	ТоварыДокумента_ОбновитьОтраженияВЭДО();
	НастроитьВидимостьЭлементовФормы();
	
	ПроверитьТоварыМаркировки();
	ТоварыМаркировки_ПроверитьРаспределениеПартий();
	
	Функциональность = МодульОбъекта().Перечисление_ФункциональностьМодуля().ЗаполнитьПартииПоКодам;
	МодульОбъекта().Метрика_Функциональность_ЗаполнитьПартииВДокументеУчета(Ссылка, Функциональность);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПартииИВесИзКодовМаркировкиДляСтрокиДокумента(КлючСтрокиДокумента)
	
	ТаблицаПартий = МодульОбъекта().КодыДокументов_КоличествоКодовПоПартиям(Ссылка, КлючСтрокиДокумента);
	
	Если Не ЗначениеЗаполнено(ТаблицаПартий) Тогда
		Возврат;
	КонецЕсли;
	
	ОтборКлючСтроки = Новый Структура("КлючСтрокиДокумента", КлючСтрокиДокумента);
	ТаблицаТоваровБезПартий = ТоварыМаркировки.Выгрузить(ОтборКлючСтроки, "Товар, КоличествоУпаковок");
	ТаблицаТоваровБезПартий.Свернуть("Товар", "КоличествоУпаковок");
	
	МодульОбъекта().ТаблицаЗначений_УдалитьЗначение(ТоварыМаркировки, "КлючСтрокиДокумента", КлючСтрокиДокумента);
	
	Для Каждого СтрПарт Из ТаблицаПартий Цикл
		
		СтрТов = ТоварыМаркировки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТов, СтрПарт);
		СтрТов.КлючСтрокиДокумента = КлючСтрокиДокумента;
		
		СтрБезПарт = ТаблицаТоваровБезПартий.Найти(СтрПарт.Товар, "Товар");
		Если СтрБезПарт <> Неопределено Тогда
			Если СтрБезПарт.КоличествоУпаковок > СтрПарт.КоличествоУпаковок Тогда
				СтрБезПарт.КоличествоУпаковок = СтрБезПарт.КоличествоУпаковок - СтрПарт.КоличествоУпаковок;
			Иначе
				ТаблицаТоваровБезПартий.Удалить(СтрБезПарт);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ОтборТоварБезПарт = Новый Структура("КлючСтрокиДокумента, НомерПартии, Товар", КлючСтрокиДокумента, "");
	
	Для Каждого СтрБезПарт Из ТаблицаТоваровБезПартий Цикл
		
		ОтборТоварБезПарт.Товар = СтрБезПарт.Товар;
		СтрТов = МодульОбъекта().ТаблицаЗначений_НайтиСтроку(ТоварыМаркировки, ОтборТоварБезПарт);
		
		Если СтрТов = Неопределено Тогда
			СтрТов = ТоварыМаркировки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТов, СтрБезПарт);
			СтрТов.КлючСтрокиДокумента = КлючСтрокиДокумента;
		Иначе
			СтрТов.КоличествоУпаковок = СтрТов.КоличествоУпаковок + СтрБезПарт.КоличествоУпаковок;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти // СлужебныеПроцедурыИФункции

