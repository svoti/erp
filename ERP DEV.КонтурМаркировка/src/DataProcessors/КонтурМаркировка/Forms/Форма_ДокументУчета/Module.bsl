&НаКлиенте
Процедура ГруппаЗакладкиПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.Закладка_Агрегаты И Не СписокАгрегатовЗаполнен Тогда
		ИнтервалОжидания = 0.1;
		ПодключитьОбработчикОжидания("ОбновитьСписокАгрегатовПослеОткрытияВкладки", ИнтервалОжидания, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКорректировкиПриИзменении(Элемент)
	
	УстановитьЗаголовкиСтраницФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсправляемыйДокументУчетаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ИсправляемыйДокумент) Тогда
		ИсправляемыйДокументУчета = МодульКлиента().ДокументУчета_НайтиИлиСоздать(ИсправляемыйДокумент, ЭтаФорма);
		Если ЗначениеЗаполнено(ИсправляемыйДокументУчета) Тогда
			МодульКлиента().ОткрытьФормуДокументаУчета(ИсправляемыйДокументУчета, ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьКакИсправитьОшибкуНажатие(Элемент)
	
	МодульКлиента().ОткрытьСправкуКакИсправитьОшибкиКодов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПодробнееОРаботеСМаршрутамиДокументаНажатие(Элемент)
	
	МодульКлиента().ОткрытьСправкуОРаботеСМаршрутамиДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПодробнееОРаботеСМаршрутамиДокумента82Нажатие(Элемент)
	
	МодульКлиента().ОткрытьСправкуОРаботеСМаршрутамиДокумента();
	
КонецПроцедуры

// #КонецОбласти // ОбработчикиСобытийЭлементовФормы

// #Область ЭтапыМаркировки

&НаСервере
Процедура ОбновитьСтатусыДокумента()
	
	ВсеСтатусы = МодульОбъекта().СтатусыДокументаУчета_Прочитать(Ссылка);
	ЗаполнитьЗначенияСвойств(Статусы, ВсеСтатусы);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГруппуЭтаповМаркировки()
	
	Если Не ЗначениеЗаполнено(МаршрутМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеЭтапы = ТекущиеЭтапыМаршрутаМаркировки();
	
	ТекТребДействие = Статусы.ТребуемоеДействиеПоМаршруту;
	ТребуемыеДействия = МодульОбъекта().Перечисление_ТребуемыеДействияДокументовУчета();
	
	ЭтоПредыдущийЭтап = Ложь;
	Для Каждого Элемент Из ТекущиеЭтапы Цикл
		Если Элемент.ТекущийЭтап Тогда
			ЭтоПредыдущийЭтап = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ЭтоСледующийЭтап = Ложь;
	КоличествоЭтапов = ТекущиеЭтапы.Количество();
	КартинкаТочкиПоследнегоЭтапа = Неопределено;
	Для сц = 1 По 3 Цикл
		
		Элементы["ГруппаЭтап" + сц].Видимость = (сц <= КоличествоЭтапов);
		Если сц > КоличествоЭтапов Тогда
			Продолжить;
		КонецЕсли;
		
		Элемент = ТекущиеЭтапы[сц - 1];
		
		ЭтоСледующийЭтап = Не (ЭтоПредыдущийЭтап Или Элемент.ТекущийЭтап);
		
		Если Элемент.ТекущийЭтап Тогда
			ЭтоПредыдущийЭтап = Ложь;
			КартинкаТочки = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяТочкаКонтурная;
			КартинкаЛинии = БиблиотекаКартинок.КонтурМаркировка_СераяЛинияГоризонт;
		КонецЕсли;
		
		Если ЭтоПредыдущийЭтап Тогда
			КартинкаТочки = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяТочка;
			КартинкаЛинии = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяЛинияГоризонт;
		КонецЕсли;
		
		Если ЭтоСледующийЭтап Или Элемент.Пропущен Тогда
			КартинкаТочки = БиблиотекаКартинок.КонтурМаркировка_СераяТочкаКонтурная;
			КартинкаЛинии = БиблиотекаКартинок.КонтурМаркировка_СераяЛинияГоризонт;
		КонецЕсли;
		
		Если ТекТребДействие = ТребуемыеДействия.РаботаЗавершена
			И Не Элемент.Пропущен Тогда
			КартинкаТочки = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяТочка;
			КартинкаЛинии = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяЛинияГоризонт;
		КонецЕсли;
		
		Если Элемент.ПоследнийЭтап Тогда
			КартинкаТочкиПоследнегоЭтапа = КартинкаТочки;
		КонецЕсли;
		
		Элементы["Картинка_Точка" + сц].Картинка = КартинкаТочки;
		Элементы["Картинка_ЛинияЭтап" + сц].Картинка = КартинкаЛинии;
		Элементы["Надпись_Этап" + сц].Заголовок = Элемент.ТребуемоеДействие;
		
	КонецЦикла;
	
	Этап = ТекущиеЭтапы[ТекущиеЭтапы.ВГраница()];
	Если Этап.ПоследнийЭтап Тогда
		Элементы.Картинка_Точка4.Картинка = КартинкаТочкиПоследнегоЭтапа;
	Иначе
		
		Если ТекТребДействие = ТребуемыеДействия.РаботаЗавершена Тогда
			Элементы.Картинка_Точка4.Картинка = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяТочка;
		Иначе
			Элементы.Картинка_Точка4.Картинка = БиблиотекаКартинок.КонтурМаркировка_СераяТочкаКонтурная;
		КонецЕсли;
		
	КонецЕсли;
	
	Если МодульОбъекта().ВерсияПлатформыНиже("8.3.12")
		Или МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
		
		Для сц = 1 По 4 Цикл
			Элементы["Картинка_Точка" + сц].Высота = 1;
			Элементы["Картинка_Точка" + сц].Ширина = 2;
		КонецЦикла;
		
		Для сц = 1 По 3 Цикл
			Элементы["Картинка_ЛинияЭтап" + сц].Высота = 1;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТекущиеЭтапыМаршрутаМаркировки()
	
	Результат = Новый Массив;
	
	ТекТребДействие = Статусы.ТребуемоеДействиеПоМаршруту;
	ТребуемыеДействия = МодульОбъекта().Перечисление_ТребуемыеДействияДокументовУчета();
	
	МаксИндекс = ЭтапыМаркировки.Количество() - 1;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТребуемоеДействие", ТекТребДействие);
	
	Строки = ЭтапыМаркировки.НайтиСтроки(ПараметрыОтбора);
	Если ТекТребДействие = ТребуемыеДействия.РаботаЗавершена Тогда
		Индекс = МаксИндекс;
	ИначеЕсли Строки.Количество() = 0 Тогда
		Индекс = 0;
	Иначе
		Индекс = ЭтапыМаркировки.Индекс(Строки[0]);
	КонецЕсли;
	
	Если Индекс = 0 Тогда
		сцМин = Индекс;
		сцМакс = Мин(2, МаксИндекс);
	ИначеЕсли Индекс = МаксИндекс Тогда
		сцМин = Макс(0, МаксИндекс - 2);
		сцМакс = Индекс;
	Иначе
		сцМин = Индекс - 1;
		сцМакс = Индекс + 1;
	КонецЕсли;
	
	Для сц = сцМин По сцМакс Цикл
		
		Стр = ЭтапыМаркировки.Получить(сц);
		ТекущийЭтап = сц = Индекс;
		
		Элемент = Новый Структура;
		Элемент.Вставить("ТребуемоеДействие", Стр.ТребуемоеДействие);
		Элемент.Вставить("ТекущийЭтап", ТекущийЭтап);
		Элемент.Вставить("Пропущен", Стр.Пропущен);
		Элемент.Вставить("ПоследнийЭтап", сц = МаксИндекс);
		
		Результат.Добавить(Элемент);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьГруппуМаршрутМаркировки()
	
	Если МодульОбъекта().ВерсияПлатформыНиже("8.3.12")
		Или МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
		
		Элементы.ГруппаМаршрутДокумента.Видимость = Ложь;
		Элементы.Закладка_МаршрутДокумента.Видимость = Истина;
		РодительЭлемента = Элементы.ГруппаМаршрутДокументаДанные82;
		ДекорацииРучногоВыбораЭтапа = Элементы.ДекорацияУстановитьЭтапВручную82;
		
	Иначе
		
		Элементы.ГруппаМаршрутДокумента.Видимость = Истина;
		Элементы.Закладка_МаршрутДокумента.Видимость = Ложь;
		РодительЭлемента = Элементы.ГруппаМаршрутДокументаДанные;
		ДекорацииРучногоВыбораЭтапа = Элементы.ДекорацияУстановитьЭтапВручную;
		
	КонецЕсли;
	
	ОбновитьЗаголовокДекорацииРучногоВыбораЭтапа(ЭтаФорма, ДекорацииРучногоВыбораЭтапа);
	
	УдалитьПодчиненныеЭлементы(РодительЭлемента);
	УдалитьДобавленныеРеквизиты();
	
	ОписаниеТипа_Булево = МодульОбъекта().ОписаниеТипа_Булево();
	ГруппировкаВерт = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппировкаГоризонт = ГоризонтальнаяГруппировкаПодчиненныхЭлементовФормы();
	
	КлючиЭтапов = МодульОбъекта().КлючиПеречисления_ЭтапыМаркировки();
	КлючиТребДействий = МодульОбъекта().КлючиПеречисления_ТребуемыеДействияДокументовУчета();
	ТребуемыеДействия = МодульОбъекта().Перечисление_ТребуемыеДействияДокументовУчета();
	СтатусыДокументовУчета = МодульОбъекта().Перечисление_СтатусыДокументовУчета();
	
	ДобавляемыеРеквизиты = Новый Массив;
	ПутиКДанным = Новый Массив;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТребуемоеДействие", Статусы.ТребуемоеДействиеПоМаршруту);
	Строки = ЭтапыМаркировки.НайтиСтроки(ПараметрыОтбора);
	Если Статусы.ТребуемоеДействиеПоМаршруту = ТребуемыеДействия.РаботаЗавершена Тогда
		ИндексТребДействие = ЭтапыМаркировки.Количество();
	ИначеЕсли Строки.Количество() = 0 Тогда
		ИндексТребДействие = -1;
	Иначе
		ИндексТребДействие = ЭтапыМаркировки.Индекс(Строки[0]);
	КонецЕсли;
	
	Этап = Неопределено;
	Для Каждого Стр Из ЭтапыМаркировки Цикл
		
		КлючЭтапа = КлючиЭтапов[Стр.Этап];
		КлючТребДействие = КлючиТребДействий[Стр.ТребуемоеДействие];
		
		Если Этап <> Стр.Этап Тогда
			
			Этап = Стр.Этап;
			
			ИмяЭлемента = "ГруппаЭтапМаршрутаДокумента_" + КлючЭтапа;
			ГруппаФормы = СоздатьГруппуЭтапаМаршрутаДокумента(ИмяЭлемента, РодительЭлемента);
			
			ИмяЭлемента = "ГруппаКартинкиМаршрутаДокумента_" + КлючЭтапа;
			ГруппаКартинки = СоздатьОбычнуюГруппуФормы(ИмяЭлемента, ГруппаФормы, ГруппировкаВерт);
			СоздатьКартинкиМаршрутаДокумента(Стр.Этап, ГруппаКартинки);
			
			ИмяЭлемента = "ГруппаЭтапДетально_" + КлючЭтапа;
			ГруппаЭтапДетально = СоздатьОбычнуюГруппуФормы(ИмяЭлемента, ГруппаФормы, ГруппировкаВерт);
			
			ИмяЭлемента = "Надпись_" + КлючЭтапа;
			ДекорацияЭтап = СоздатьДекорациюНадпись(ИмяЭлемента, ГруппаЭтапДетально, Стр.Этап);
			ДекорацияЭтап.РастягиватьПоГоризонтали = Истина;
			ПолужирныйШрифт = Новый Шрифт(ДекорацияЭтап.Шрифт,,, Истина);
			ДекорацияЭтап.Шрифт = ПолужирныйШрифт;
			
		КонецЕсли;
		
		ИмяЭлемента = "ГруппаТребуемыеДействия_" + КлючЭтапа + "_" + КлючТребДействие;
		ГруппаТребуемыеДействия = СоздатьОбычнуюГруппуФормы(ИмяЭлемента, ГруппаЭтапДетально, ГруппировкаГоризонт);
		
		ИмяЭлемента = "Флажок_" + КлючЭтапа + "_" + КлючТребДействие;
		ВидПоля = ВидПоляФормы.ПолеФлажка;
		ПолеФлажок = СоздатьПолеФормы(ИмяЭлемента, ГруппаТребуемыеДействия, ВидПоля);
		ПолеФлажок.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ПолеФлажок.Видимость = Ложь;
		ПолеФлажок.УстановитьДействие("ПриИзменении", "ВыбратьЭтап");
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяЭлемента, ОписаниеТипа_Булево));
		ПутиКДанным.Добавить(Новый Структура("ПолеФормы, ПутьКДанным", ПолеФлажок, ИмяЭлемента));
		
		ИмяЭлемента = "Картинка_" + КлючЭтапа + "_" + КлючТребДействие;
		ТекИндекс = ЭтапыМаркировки.Индекс(Стр);
		Если Стр.ТребуемоеДействие = Статусы.ТребуемоеДействиеПоМаршруту И Не Стр.Пропущен Тогда
			Картинка = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяТочкаМалая;
		ИначеЕсли ТекИндекс < ИндексТребДействие И Не Стр.Пропущен Тогда
			Картинка = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяГалка;
		Иначе
			Картинка = БиблиотекаКартинок.КонтурМаркировка_СераяТочкаМалая;
		КонецЕсли;
		СоздатьДекорациюКартинка(ИмяЭлемента, ГруппаТребуемыеДействия, Картинка);
		
		ИмяЭлемента = "Надпись_" + КлючЭтапа + "_" + КлючТребДействие;
		СоздатьДекорациюНадпись(ИмяЭлемента, ГруппаТребуемыеДействия, Стр.ТребуемоеДействие);
		
		Если Стр.ТребуемоеДействие = Статусы.ТребуемоеДействиеПоМаршруту
			И Стр.ТребуемоеДействие <> ТребуемыеДействия.ЗавершитьРаботу Тогда
			ИмяЭлемента = "НадписьПропуститьЭтап_" + КлючЭтапа + "_" + КлючТребДействие;
			ЗаголовокЭлемента =  НСтр("ru = 'Пропустить этап'");
			ДекорацияПропуститьЭтап = СоздатьДекорациюНадпись(ИмяЭлемента, ГруппаТребуемыеДействия, ЗаголовокЭлемента);
			ДекорацияПропуститьЭтап.Гиперссылка = Истина;
			ДекорацияПропуститьЭтап.УстановитьДействие("Нажатие", "ПропуститьЭтап");
			ДекорацияПропуститьЭтап.Доступность = (Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Новый
			Или Статусы.ОсновнойСтатус = СтатусыДокументовУчета.ВРаботе);
		КонецЕсли;
		
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Для Каждого Элемент Из ПутиКДанным Цикл
		Элемент.ПолеФормы.ПутьКДанным = Элемент.ПутьКДанным;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовокДекорацииРучногоВыбораЭтапа(ЭтаФорма, Элемент)
	
	Если ЭтаФорма.РучнойВыборЭтапа Тогда
		ТекстЗаголовка = НСтр("ru = 'Подтвердить выбор'");
	Иначе
		ТекстЗаголовка = НСтр("ru = 'Установить этап вручную'");
	КонецЕсли;
	
	Элемент.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПодчиненныеЭлементы(Элемент)
	
	Пока Элемент.ПодчиненныеЭлементы.Количество() Цикл
		ПодчиненныйЭлемент = Элемент.ПодчиненныеЭлементы[0];
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы")
			И ПодчиненныйЭлемент.ПодчиненныеЭлементы.Количество() > 0 Тогда
			УдалитьПодчиненныеЭлементы(ПодчиненныйЭлемент);
		КонецЕсли;
		Элементы.Удалить(ПодчиненныйЭлемент);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьДобавленныеРеквизиты()
	
	ИменаРеквизитов = Новый Массив;
	РеквизитыФормы = ПолучитьРеквизиты();
	Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
		ИменаРеквизитов.Добавить(РеквизитФормы.Имя);
	КонецЦикла;
	
	КлючиЭтапов = МодульОбъекта().КлючиПеречисления_ЭтапыМаркировки();
	КлючиТребДействий = МодульОбъекта().КлючиПеречисления_ТребуемыеДействияДокументовУчета();
	
	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого Стр Из ЭтапыМаркировки Цикл
		КлючЭтапа = КлючиЭтапов[Стр.Этап];
		КлючТребДействие = КлючиТребДействий[Стр.ТребуемоеДействие];
		ИмяЭлемента = "Флажок_" + КлючЭтапа + "_" + КлючТребДействие;
		Если ИменаРеквизитов.Найти(ИмяЭлемента) <> Неопределено Тогда
			УдаляемыеРеквизиты.Добавить(ИмяЭлемента);
		КонецЕсли;
	КонецЦикла;
	
	ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	
КонецПроцедуры

&НаСервере
Функция СоздатьГруппуЭтапаМаршрутаДокумента(ИмяЭлемента, РодительЭлемента)
	
	ТипЭлемента = Тип("ГруппаФормы");
	
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, ТипЭлемента, РодительЭлемента);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	НовыйЭлемент.Группировка = ГоризонтальнаяГруппировкаПодчиненныхЭлементовФормы();
	НовыйЭлемент.РастягиватьПоВертикали = Ложь;
	
	Возврат НовыйЭлемент;
	
КонецФункции

&НаСервере
Функция СоздатьОбычнуюГруппуФормы(ИмяЭлемента, РодительЭлемента, Группировка)
	
	ТипЭлемента = Тип("ГруппаФормы");
	
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, ТипЭлемента, РодительЭлемента);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	НовыйЭлемент.Группировка = Группировка;
	
	Возврат НовыйЭлемент;
	
КонецФункции

&НаСервере
Процедура СоздатьКартинкиМаршрутаДокумента(Этап, РодительЭлемента)
	
	ТребуемыеДействия = МодульОбъекта().Перечисление_ТребуемыеДействияДокументовУчета();
	
	КлючиЭтапов = МодульОбъекта().КлючиПеречисления_ЭтапыМаркировки();
	КлючЭтапа = КлючиЭтапов[Этап];
	
	ЭтоПоследнийЭтап = Ложь;
	Если ЭтапыМаркировки.Количество() > 0 Тогда
		ЭтоПоследнийЭтап = Этап = ЭтапыМаркировки[ЭтапыМаркировки.Количество() - 1].Этап;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТребуемоеДействие", Статусы.ТребуемоеДействиеПоМаршруту);
	Строки = ЭтапыМаркировки.НайтиСтроки(ПараметрыОтбора);
	
	Если Статусы.ТребуемоеДействиеПоМаршруту = ТребуемыеДействия.РаботаЗавершена Тогда
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Этап", Этап);
		ПараметрыОтбора.Вставить("Пропущен", Ложь);
		Строки = ЭтапыМаркировки.НайтиСтроки(ПараметрыОтбора);
		ЭтапЗавершен = Строки.Количество() > 0;
		
		Если ЭтапЗавершен Тогда
			КартинкаТочка = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяТочка;
			КартинкаЛинияВерт = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяЛинияВерт;
		Иначе
			КартинкаТочка = БиблиотекаКартинок.КонтурМаркировка_СераяТочкаКонтурная;
			КартинкаЛинияВерт = БиблиотекаКартинок.КонтурМаркировка_СераяЛинияВерт;
		КонецЕсли;
		
	ИначеЕсли Строки.Количество() = 0 Тогда
		
		// текущего требуемого действия нет в маршруте маркировки, что-то пошло не так
		КартинкаТочка = БиблиотекаКартинок.КонтурМаркировка_СераяТочкаКонтурная;
		КартинкаЛинияВерт = БиблиотекаКартинок.КонтурМаркировка_СераяЛинияВерт;
		
	Иначе
		
		ИндексТребДействие = ЭтапыМаркировки.Индекс(Строки[0]);
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Этап", Этап);
		ПараметрыОтбора.Вставить("ТребуемоеДействие", Статусы.ТребуемоеДействиеПоМаршруту);
		
		Строки = ЭтапыМаркировки.НайтиСтроки(ПараметрыОтбора);
		ЭтапВРаботе = Строки.Количество() > 0;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Этап", Этап);
		Строки = ЭтапыМаркировки.НайтиСтроки(ПараметрыОтбора);
		МаксИндексЭтапа = ЭтапыМаркировки.Индекс(Строки[Строки.ВГраница()]);
		ЭтапЗавершен = ИндексТребДействие > МаксИндексЭтапа;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Этап", Этап);
		ПараметрыОтбора.Вставить("Пропущен", Ложь);
		Строки = ЭтапыМаркировки.НайтиСтроки(ПараметрыОтбора);
		ЭтапПропущен = Строки.Количество() = 0;
		
		Если ЭтапВРаботе И Не ЭтапПропущен Тогда
			КартинкаТочка = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяТочкаКонтурная;
			КартинкаЛинияВерт = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяЛинияВерт;
		ИначеЕсли ЭтапЗавершен И Не ЭтапПропущен Тогда
			КартинкаТочка = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяТочка;
			КартинкаЛинияВерт = БиблиотекаКартинок.КонтурМаркировка_ЗеленаяЛинияВерт;
		Иначе
			КартинкаТочка = БиблиотекаКартинок.КонтурМаркировка_СераяТочкаКонтурная;
			КартинкаЛинияВерт = БиблиотекаКартинок.КонтурМаркировка_СераяЛинияВерт;
		КонецЕсли;
		
	КонецЕсли;
	
	ИмяЭлемента = "КартинкаТочка_" + КлючЭтапа;
	ДекорацияТочка = СоздатьДекорациюКартинка(ИмяЭлемента, РодительЭлемента, КартинкаТочка);
	ДекорацияТочка.РазмерКартинки = РазмерКартинки.РеальныйРазмер;
	
	Если Не ЭтоПоследнийЭтап Тогда
		ИмяЭлемента = "КартинкаЛинияВерт_" + КлючЭтапа;
		ДекорацияЛинияВерт = СоздатьДекорациюКартинка(ИмяЭлемента, РодительЭлемента, КартинкаЛинияВерт);
		ДекорацияЛинияВерт.РазмерКартинки = РазмерКартинки.Растянуть;
		ДекорацияЛинияВерт.РастягиватьПоВертикали = Истина;
	КонецЕсли;
	
	Если МодульОбъекта().ВерсияПлатформыНиже("8.3.12")
		Или МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
		
		Элементы["КартинкаТочка_" + КлючЭтапа].Высота = 1;
		Элементы["КартинкаТочка_" + КлючЭтапа].Ширина = 2;
		
		Если Не ЭтоПоследнийЭтап Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Этап", Этап);
			Строки = ЭтапыМаркировки.НайтиСтроки(ПараметрыОтбора);
			Элементы["КартинкаЛинияВерт_" + КлючЭтапа].Высота = Строки.Количество();
			Элементы["КартинкаЛинияВерт_" + КлючЭтапа].Ширина = 2;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьДекорациюКартинка(ИмяЭлемента, РодительЭлемента, Картинка)
	
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), РодительЭлемента);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Картинка;
	НовыйЭлемент.Картинка = Картинка;
	
	Если МодульОбъекта().ВерсияПлатформыНиже("8.3.12")
		Или МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
		
		НовыйЭлемент.Высота = 1;
		НовыйЭлемент.Ширина = 2;
		
	КонецЕсли;
	
	Возврат НовыйЭлемент;
	
КонецФункции

&НаСервере
Функция СоздатьДекорациюНадпись(ИмяЭлемента, РодительЭлемента, ЗаголовокЭлемента)
	
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), РодительЭлемента);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = ЗаголовокЭлемента;
	
	Возврат НовыйЭлемент;
	
КонецФункции

&НаСервере
Функция СоздатьПолеФормы(ИмяЭлемента, РодительЭлемента, ВидПоля)
	
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), РодительЭлемента);
	НовыйЭлемент.Вид = ВидПоля;
	
	Возврат НовыйЭлемент;
	
КонецФункции

&НаСервере
Функция ГоризонтальнаяГруппировкаПодчиненныхЭлементовФормы()
	
	Если МодульОбъекта().ВерсияПлатформыНиже("8.3.12") Тогда
		Результат = Вычислить("ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная");
	Иначе
		Результат = Вычислить("ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДекорацияУстановитьЭтапВручнуюНажатие(Элемент)
	
	ДекорацияУстановитьЭтапВручнуюНажатиеНаСервере();
	
	Если РучнойВыборЭтапа Тогда
		
		РучнойВыборЭтапа = Ложь;
		
		Если МодульКлиента().ВерсияПлатформыНиже("8.3.12")
			Или МодульКлиента().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
			ДекорацииРучногоВыбораЭтапа = Элементы.ДекорацияУстановитьЭтапВручную82;
		Иначе
			ДекорацииРучногоВыбораЭтапа = Элементы.ДекорацияУстановитьЭтапВручную;
		КонецЕсли;
		ОбновитьЗаголовокДекорацииРучногоВыбораЭтапа(ЭтаФорма, ДекорацииРучногоВыбораЭтапа);
		
		Оповестить("КонтурМаркировка_ДокументУчета_Изменен", Ссылка);
		ОповеститьОбИзменении(Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДекорацияУстановитьЭтапВручнуюНажатиеНаСервере()
	
	КлючиЭтапов = МодульОбъекта().КлючиПеречисления_ЭтапыМаркировки();
	КлючиТребДействий = МодульОбъекта().КлючиПеречисления_ТребуемыеДействияДокументовУчета();
	
	Если РучнойВыборЭтапа Тогда
		
		Если МодульОбъекта().ВерсияПлатформыНиже("8.3.12")
			Или МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
			ДекорацииРучногоВыбораЭтапа = Элементы.ДекорацияУстановитьЭтапВручную82;
		Иначе
			ДекорацииРучногоВыбораЭтапа = Элементы.ДекорацияУстановитьЭтапВручную;
		КонецЕсли;
		ОбновитьЗаголовокДекорацииРучногоВыбораЭтапа(ЭтаФорма, ДекорацииРучногоВыбораЭтапа);
		
		ТекСтрокаНайдена = Ложь;
		Для Каждого Стр Из ЭтапыМаркировки Цикл
			
			Стр.Пропущен = Не ТекСтрокаНайдена;
			
			КлючЭтапа = КлючиЭтапов[Стр.Этап];
			КлючТребДействие = КлючиТребДействий[Стр.ТребуемоеДействие];
			
			ИмяЭлемента = "Флажок_" + КлючЭтапа + "_" + КлючТребДействие;
			
			Если ЭтаФорма[ИмяЭлемента] Тогда
				
				Стр.Пропущен = Ложь;
				ТекСтрокаНайдена = Истина;
				Статусы.ТребуемоеДействие = Стр.ТребуемоеДействие;
				МодульОбъекта().СтатусыДокументаУчета_Записать(Ссылка, Статусы);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// установка видимости для флажков и надписи Пропустить этап
	Для Каждого Стр Из ЭтапыМаркировки Цикл
		
		КлючЭтапа = КлючиЭтапов[Стр.Этап];
		КлючТребДействие = КлючиТребДействий[Стр.ТребуемоеДействие];
		
		ИмяЭлемента = "Флажок_" + КлючЭтапа + "_" + КлючТребДействие;
		Элементы[ИмяЭлемента].Видимость = Не Элементы[ИмяЭлемента].Видимость;
		Если Элементы[ИмяЭлемента].Видимость Тогда
			ЭтаФорма[ИмяЭлемента] = Ложь;
		КонецЕсли;
		
		Если Стр.ТребуемоеДействие = Статусы.ТребуемоеДействие Тогда
			ИмяЭлемента = "НадписьПропуститьЭтап_" + КлючЭтапа + "_" + КлючТребДействие;
			Если Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда
				Элементы[ИмяЭлемента].Видимость = Не Элементы[ИмяЭлемента].Видимость;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если РучнойВыборЭтапа Тогда
		
		ЗаписатьДокументУчетаНаСервере();
		
		НастроитьВидимостьКомандФормы();
		НастроитьВидимостьЭлементовФормы();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПропуститьЭтап(Элемент)
	
	ПропуститьЭтапНаСервере(Элемент.Имя);
	
	Оповестить("КонтурМаркировка_ДокументУчета_Изменен", Ссылка);
	ОповеститьОбИзменении(Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПропуститьЭтапНаСервере(Знач ИмяЭлемента)
	
	ЧастиТекста = МодульОбъекта().РазделитьСтроку(ИмяЭлемента, "_");
	КлючЭтапа = ЧастиТекста[1];
	КлючТребДействие = ЧастиТекста[2];
	
	КлючиЭтапов = МодульОбъекта().КлючиПеречисления_ЭтапыМаркировки();
	КлючиТребДействий = МодульОбъекта().КлючиПеречисления_ТребуемыеДействияДокументовУчета();
	
	ТекСтрокаНайдена = Ложь;
	ЭтоЗавершениеМаршрута = Истина;
	Для Каждого Стр Из ЭтапыМаркировки Цикл
		
		ТекКлючЭтапа = КлючиЭтапов[Стр.Этап];
		ТекКлючТребДействие = КлючиТребДействий[Стр.ТребуемоеДействие];
		
		Если ТекСтрокаНайдена Тогда
			
			Статусы.ТребуемоеДействие = Стр.ТребуемоеДействие;
			МодульОбъекта().СтатусыДокументаУчета_Записать(Ссылка, Статусы);
			Прервать;
			
		Иначе
			
			Если ТекКлючЭтапа = КлючЭтапа И ТекКлючТребДействие = КлючТребДействие Тогда
				
				ТекСтрокаНайдена = Истина;
				Стр.Пропущен = Истина;
				МодульОбъекта().Метрика_МаршрутДокументаПропускШагаЭтапаМаркировки(Стр.Этап, Стр.ТребуемоеДействие);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьДокументУчетаНаСервере();
	
	НастроитьВидимостьКомандФормы();
	НастроитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЭтап(Элемент)
	
	РучнойВыборЭтапа = Истина;
	Если МодульКлиента().ВерсияПлатформыНиже("8.3.12")
		Или МодульКлиента().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
		ДекорацииРучногоВыбораЭтапа = Элементы.ДекорацияУстановитьЭтапВручную82;
	Иначе
		ДекорацииРучногоВыбораЭтапа = Элементы.ДекорацияУстановитьЭтапВручную;
	КонецЕсли;
	ОбновитьЗаголовокДекорацииРучногоВыбораЭтапа(ЭтаФорма, ДекорацииРучногоВыбораЭтапа);
	
	КлючиЭтапов = МодульКлиента().КлючиПеречисления_ЭтапыМаркировки();
	КлючиТребДействий = МодульКлиента().КлючиПеречисления_ТребуемыеДействияДокументовУчета();
	
	Для Каждого Стр Из ЭтапыМаркировки Цикл
		
		КлючЭтапа = КлючиЭтапов[Стр.Этап];
		КлючТребДействие = КлючиТребДействий[Стр.ТребуемоеДействие];
		
		ИмяЭлемента = "Флажок_" + КлючЭтапа + "_" + КлючТребДействие;
		
		ЭтаФорма[ИмяЭлемента] = ИмяЭлемента = Элемент.Имя;
		
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти // ЭтапыМаркировки

// #Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ВсеТоварыПодобраны()
	
	Результат = Истина;
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		Если Стр.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		Если Стр.КоличествоУпаковок <> Стр.КоличествоПодобрано Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьСписокОпераций()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	
	ПодходящиеТипыОпераций = МодульОбъекта().ТипыИнтерактивныхОпераций();
	МодульОбъекта().УдалитьЗначениеИзМассива(ПодходящиеТипыОпераций, ТипыОпераций.РезервированиеПартий);
	
	СписокОпераций.Загрузить(МодульОбъекта().ДокументУчета_СписокОпераций(Ссылка, ПодходящиеТипыОпераций));
	
	Для Каждого Стр Из СписокОпераций Цикл
		
		Если Стр.Статус = СтатусыОпераций.Новый Тогда
			Стр.ТребуемоеДействие = "Начать работу";
			Стр.Активная = Истина;
			Стр.НомерКартинки = 0;
		ИначеЕсли Стр.Статус = СтатусыОпераций.ОперацияЗавершена
			Или Стр.Статус = СтатусыОпераций.ОперацияОтменена
			Или Стр.Статус = СтатусыОпераций.ПринятЧастично Тогда
			Стр.ТребуемоеДействие = "Работа завершена";
			Стр.Активная = Ложь;
			Стр.НомерКартинки = 4;
		ИначеЕсли Стр.Статус = СтатусыОпераций.ОшибкаЗаполнения
			Или Стр.Статус = СтатусыОпераций.ОшибкаОбработки
			Или Стр.Статус = СтатусыОпераций.ОшибкаОтменыОперации Тогда
			Стр.ТребуемоеДействие = "Исправить ошибки";
			Стр.Активная = Истина;
			Стр.НомерКартинки = 2;
		ИначеЕсли Стр.Статус = СтатусыОпераций.НеУдалосьРаспознатьКоды Тогда
			Стр.ТребуемоеДействие = "Редактировать список кодов";
			Стр.Активная = Истина;
			Стр.НомерКартинки = 3;
		Иначе
			Стр.ТребуемоеДействие = "Обрабатывается";
			Стр.Активная = Ложь;
			Стр.НомерКартинки = 3;
		КонецЕсли;
		
	КонецЦикла;
	
	ПосчитатьКоличествоСтрокТаблицФормы();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовки()
	
	УстановитьЗаголовокФормы();
	УстановитьЗаголовкиСтраницФормы();
	УстановитьЗаголовкиКолонокДопПроверкиКодов();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	Заголовок = МодульОбъекта().ПараметрыВСтроку(НСтр("ru = 'Маркировка: %1'"), Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиСтраницФормы()
	
	Если МодульОбъекта().ДокументУчета_ЕстьРольКорректировкаОтгрузки(Ссылка) Тогда
		ВидыКорректировки = МодульОбъекта().Перечисление_ВидыКорректировкиДокумента();
		Если ВидКорректировки = ВидыКорректировки.Возврат Тогда
			Элементы.Закладка_Товары.Заголовок = НСтр("ru = 'Товары (возвращаемые)'");
			Элементы.Закладка_КодыМаркировки.Заголовок = НСтр("ru = 'Коды маркировки (возвращаемые)'");
			Элементы.Закладка_Агрегаты.Заголовок = НСтр("ru = 'Транспортные упаковки (возвращаемые)'");
		Иначе
			Элементы.Закладка_Товары.Заголовок = НСтр("ru = 'Товары (после корректировки)'");
			Элементы.Закладка_КодыМаркировки.Заголовок = НСтр("ru = 'Коды маркировки (после корректировки)'");
			Элементы.Закладка_Агрегаты.Заголовок = НСтр("ru = 'Транспортные упаковки (после корректировки)'");
		КонецЕсли;
	Иначе
		Элементы.Закладка_Товары.Заголовок = НСтр("ru = 'Товары'");
		Элементы.Закладка_КодыМаркировки.Заголовок = НСтр("ru = 'Коды маркировки'");
		Элементы.Закладка_Агрегаты.Заголовок = НСтр("ru = 'Транспортные упаковки'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиКолонокДопПроверкиКодов()

	НастройкиДокумента = МодульОбъекта().НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента);
	ОписаниеНастроек = МодульОбъекта().НастройкиДокументаУчета_Прочитать(НастройкиДокумента);
	
	ЗаголовокКолонкиДопПроверкаКодов1 = СокрЛП(ОписаниеНастроек.ЗаголовокКолонкиДопПроверкаКодов1);
	Если ЗначениеЗаполнено(ЗаголовокКолонкиДопПроверкаКодов1) Тогда
		Элементы.НадписьДопПроверкаКодов1.Заголовок = ЗаголовокКолонкиДопПроверкаКодов1;
		Элементы.КодыМаркировкиДопПроверка1.Заголовок = ЗаголовокКолонкиДопПроверкаКодов1;
		Элементы.АгрегатыДопПроверка1.Заголовок = ЗаголовокКолонкиДопПроверкаКодов1;
	КонецЕсли;
	
	ЗаголовокКолонкиДопПроверкаКодов2 = СокрЛП(ОписаниеНастроек.ЗаголовокКолонкиДопПроверкаКодов2);
	Если ЗначениеЗаполнено(ЗаголовокКолонкиДопПроверкаКодов2) Тогда
		Элементы.НадписьДопПроверкаКодов2.Заголовок = ЗаголовокКолонкиДопПроверкаКодов2;
		Элементы.КодыМаркировкиДопПроверка2.Заголовок = ЗаголовокКолонкиДопПроверкаКодов2;
		Элементы.АгрегатыДопПроверка2.Заголовок = ЗаголовокКолонкиДопПроверкаКодов2;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	ТипыОбъектов = МодульОбъекта().ТипыОбъектовИС();
	МодульОбъекта().УстановитьОграничениеПоТипу(Элементы.Контрагент1С, ТипыОбъектов.Контрагент);
	МодульОбъекта().УстановитьОграничениеПоТипу(Элементы.ИсправляемыйДокумент, МодульОбъекта().ОписаниеТипа_ЛюбойДокумент());
	
	НастроитьПодвалДля82();
	ПоказатьКнопкиПоискаДля82();
	СформироватьДополнительныеКнопки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтекстФормы()
	
	ЗаполнитьРеквизитыПоДокументуУчета();
	ЗаполнитьТребуетсяЗСН();
	ЗаполнитьПризнакПеременныйВес();
	ЗаполнитьДоступностьПартионногоУчета();
	ЗаполнитьКоличествоКодов();
	ЗаполнитьКоличествоКодовПоСтатусам();
	ЗаполнитьКоличествоЗаводскихСерийныхНомеров();
	ОбновитьСписокОпераций();
	ПосчитатьКоличествоСтрокТаблицФормы();
	ОбновитьРезультатыПроверкиКодов();
	ЗаполнитьГруппуЭтаповМаркировки();
	ЗаполнитьГруппуМаршрутМаркировки();
	
	ОбъектВПроцессеОбновления = Не МодульОбъекта().ПроверитьОбъектВПроцессеОбновления(Ссылка, Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПоДокументуУчета()
	
	ОписаниеДокумента = МодульОбъекта().ДокументУчета_ПрочитатьДокумент(Ссылка);
	ВсегоСтрокДокумента = ОписаниеДокумента.ТоварыДокумента.Количество();
	ЕстьАртикул = МодульОбъекта().Интеграция_Номенклатура1С_ЕстьАртикул();
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеДокумента, , "ТоварыДокумента, ТоварыМаркировки, ЭтапыМаркировки");
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеДокумента.ДопРеквизиты);
	
	ТоварыМаркировки.Очистить();
	Для Каждого Стр Из ОписаниеДокумента.ТоварыМаркировки Цикл
		НоваяСтрока = ТоварыМаркировки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;
	
	КэшНоменклатуры = Новый Соответствие;
	НомерСтроки = 0;
	
	ТоварыДокумента.Очистить();
	Для Каждого Стр Из ОписаниеДокумента.ТоварыДокумента Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока = ТоварыДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НоваяСтрока.КоличествоПодобрано = КоличествоУпаковокТоваровМаркировки(Стр.КлючСтрокиДокумента, ЭтаФорма);
		
		НоваяСтрока.ПредставлениеСтроки = МодульОбъекта().ПредставлениеСтрокиСНомером(НомерСтроки
		, МодульОбъекта().ПредставлениеНоменклатуры1С(Стр, КэшНоменклатуры)
		, ВсегоСтрокДокумента);
		
		Если ЕстьАртикул И ЗначениеЗаполнено(НоваяСтрока.КлючНоменклатуры1С) Тогда
			НоваяСтрока.Артикул = МодульОбъекта().КлючНоменклатуры1С_Артикул(НоваяСтрока.КлючНоменклатуры1С);
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтапыМаркировки.Очистить();
	Для Каждого Стр Из ОписаниеДокумента.ЭтапыМаркировки Цикл
		НоваяСтрока = ЭтапыМаркировки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр,, "СпособыВыполнения");
		НоваяСтрока.СпособыВыполнения.ЗагрузитьЗначения(Стр.СпособыВыполнения);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоКодов()
	
	КоличествоКодовПоСтрокам = МодульОбъекта().КодыДокументов_КоличествоКодовПоСтрокам(Ссылка);
	КоличествоКодовСОшибкамиПоСтрокам = МодульОбъекта().КодыДокументов_КоличествоКодовСОшибкамиПоСтрокам(Ссылка);
	
	ОтборПоСтроке = Новый Структура();
	ОтборПоСтроке.Вставить("КлючСтрокиДокумента");
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		
		КодовВсего = 0;
		КодовСОшибками = 0;
		
		ОтборПоСтроке.КлючСтрокиДокумента = Стр.КлючСтрокиДокумента;
		
		СтрКоличествоВсего = КоличествоКодовПоСтрокам.Найти(Стр.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		СтрКоличествоСОшибками = КоличествоКодовСОшибкамиПоСтрокам.Найти(Стр.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		
		Если ЗначениеЗаполнено(СтрКоличествоВсего) Тогда
			КодовВсего = СтрКоличествоВсего.Количество;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрКоличествоСОшибками) Тогда
			КодовСОшибками = СтрКоличествоСОшибками.Количество;
		КонецЕсли;
		
		Стр.КоличествоКодовСОшибками = КодовСОшибками;
		Стр.КоличествоКодов = КодовВсего - КодовСОшибками;
		
	КонецЦикла;
	
	УстановитьВидимостьКолонкиТоваров("КоличествоКодовСОшибками");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоКодовПоСтатусам()
	
	ИтогоПоСтатусам = "";
	
	СтатусыКодовДокумента = МодульОбъекта().КодыДокументов_КоличествоКодовПоСтатусам(Ссылка);
	
	ПредставлениеПустогоСтатуса = НСтр("ru='Неизвестный'");
	ПустойСтатус = "";
	Разделитель = "";
	ШаблонСтатуса = "%1: %2";
	
	ЭтоПервыйСтатус = Истина;
	
	Для Каждого Стр Из СтатусыКодовДокумента Цикл
		
		СтатусКодов = Стр.СтатусКодов;
		Если СтатусКодов = ПустойСтатус Тогда
			СтатусКодов = ПредставлениеПустогоСтатуса;
		КонецЕсли;
		
		ПредставлениеСтатуса = МодульОбъекта().ПараметрыВСтроку(ШаблонСтатуса, СтатусКодов, Стр.Количество);
		
		ИтогоПоСтатусам = ИтогоПоСтатусам + Разделитель + ПредставлениеСтатуса;
		
		Если ЭтоПервыйСтатус Тогда
			Разделитель = ", ";
			ЭтоПервыйСтатус = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.НадписьИтогоПоСтатусам.Заголовок = ИтогоПоСтатусам;
	
	ЕстьСписанные = СтатусыКодовДокумента.Найти(МодульОбъекта().Перечисление_СтатусыКодов().Списан, "СтатусКодов") <> Неопределено;
	УстановитьВидимостьКнопкиСкрытьСписанные(ЕстьСписанные);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоЗаводскихСерийныхНомеров()
	
	Если Не ТоварыДокумента_ТребуютсяЗаводскиеСерийныеНомера() Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрДок Из ТоварыДокумента Цикл
		СтрДок.КоличествоЗСН = 0;
	КонецЦикла;
	
	Отбор = Новый Структура("КлючСтрокиДокумента");
	Для каждого СтрЗСН Из МодульОбъекта().КодыДокументов_КоличествоЗаводскихСерийныхНомеров(Ссылка) Цикл
		Отбор.КлючСтрокиДокумента = СтрЗСН.КлючСтрокиДокумента;
		Для каждого СтрТовара Из ТоварыДокумента.НайтиСтроки(Отбор) Цикл
			СтрТовара.КоличествоЗСН = СтрЗСН.КоличествоЗСН;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТребуетсяЗСН(КлючСтрокиДокумента = Неопределено)
	
	КэшТоваров = Новый Соответствие;
	
	Для Каждого СтрДок Из ТоварыДокумента Цикл
		
		Если ЗначениеЗаполнено(КлючСтрокиДокумента)
			И СтрДок.КлючСтрокиДокумента <> КлючСтрокиДокумента Тогда
			Продолжить;
		КонецЕсли;
		
		ТребуетсяЗСН = Ложь;
		Отбор = Новый Структура("КлючСтрокиДокумента", СтрДок.КлючСтрокиДокумента);
		Для Каждого СтрТов Из ТоварыМаркировки.НайтиСтроки(Отбор) Цикл
			Если ЗначениеЗаполнено(СтрТов.Товар) Тогда
				ОписаниеТовара = МодульОбъекта().Товар_Прочитать(СтрТов.Товар, КэшТоваров);
				ТребуетсяЗСН = ОписаниеТовара.ДопРеквизиты.ИспользоватьЗаводскойСН;
				Если ТребуетсяЗСН Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		СтрДок.ТребуетсяЗСН = ТребуетсяЗСН;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоступностьПартионногоУчета(КлючСтрокиДокумента = Неопределено)
	
	ДопустимыеВидыПродукции = МодульОбъекта().ДопустимыеВидыПродукцииДляПартионногоУчета();
	ДопустимыеТипыКодов = МодульОбъекта().ДопустимыеТипыКодовМаркировкиДляПартионногоУчета();
	
	СтрокиТоваров = ТоварыМаркировки;
	Если ЗначениеЗаполнено(КлючСтрокиДокумента) Тогда
		СтрокиТоваров = ТоварыМаркировки.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", КлючСтрокиДокумента));
	КонецЕсли;
	
	Для Каждого СтрТов Из СтрокиТоваров Цикл
		
		СтрТов.ДоступенПартионныйУчет = Ложь;
		
		Если ЗначениеЗаполнено(СтрТов.Товар)
			И МодульОбъекта().МассивСодержитЗначение(ДопустимыеТипыКодов, СтрТов.Товар.ТипКодаМаркировки)
			И МодульОбъекта().МассивСодержитЗначение(ДопустимыеВидыПродукции, СтрТов.Товар.ВидПродукции) Тогда
			СтрТов.ДоступенПартионныйУчет = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПризнакПеременныйВес(КлючСтрокиДокумента = Неопределено)
	
	СтрокиТоваров = ТоварыМаркировки;
	Если ЗначениеЗаполнено(КлючСтрокиДокумента) Тогда
		СтрокиТоваров = ТоварыМаркировки.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", КлючСтрокиДокумента));
	КонецЕсли;
	
	Для Каждого СтрТов Из СтрокиТоваров Цикл
		СтрТов.ПеременныйВес = СтрТов.Товар.ПеременныйВес;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПодобратьТоварыМаркировки(КлючСтрокиДокумента)
	
	СтрДок = СтрокаДокументаПоКлючуСтроки(КлючСтрокиДокумента);
	
	МассивТоваров = МодульОбъекта().Товары_НайтиПоШтрихкодуИлиАртикулуНоменклатуры1С(СтрДок.КлючНоменклатуры1С, Организация);
	Если Не ЗначениеЗаполнено(МассивТоваров) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Отбор = Новый Структура("КлючСтрокиДокумента", КлючСтрокиДокумента);
	Для Каждого Стр Из ТоварыМаркировки.НайтиСтроки(Отбор) Цикл
		ТоварыМаркировки.Удалить(Стр);
	КонецЦикла;
	
	СопоставленОдинТовар = (МассивТоваров.Количество() = 1);
	
	Для Каждого Товар Из МассивТоваров Цикл
		
		НоваяСтрока = ТоварыМаркировки.Добавить();
		НоваяСтрока.Товар = Товар;
		НоваяСтрока.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		
		Если СопоставленОдинТовар Тогда
			НоваяСтрока.КоличествоУпаковок = СтрДок.КоличествоУпаковок;
			СтрДок.КоличествоПодобрано = СтрДок.КоличествоУпаковок;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьТребуетсяЗСН(КлючСтрокиДокумента);
	ЗаполнитьПризнакПеременныйВес(КлючСтрокиДокумента);
	ЗаполнитьДоступностьПартионногоУчета(КлючСтрокиДокумента);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура Агрегаты_ПослеВыбораКлючаНоменклатуры1С(РезультатВыбора, ДопПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ИдентификаторСтроки Из Элементы.Агрегаты.ВыделенныеСтроки Цикл
		Стр = Агрегаты.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ЗначениеЗаполнено(Стр.Товар) Тогда
			Стр.КлючНоменклатуры1С = РезультатВыбора;
		КонецЕсли;
		Если Стр.УровеньАгрегата Тогда
			Для Каждого СтрТовара Из Стр.ПолучитьЭлементы() Цикл
				СтрТовара.КлючНоменклатуры1С = РезультатВыбора;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Агрегаты_ОбновитьТоварыАгрегатов();
	
КонецПроцедуры

&НаСервере
Процедура Агрегаты_ОбновитьТоварыАгрегатов()
	
	ТоварыАгрегатов = МодульОбъекта().Новый_ТоварыАгрегатов();
	
	Для каждого ИдентификаторСтроки Из Элементы.Агрегаты.ВыделенныеСтроки Цикл
		
		Стр = Агрегаты.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		Если Стр.УровеньАгрегата Тогда
			СтрАгрегата = Стр;
		Иначе
			СтрАгрегата = Стр.ПолучитьРодителя();
		КонецЕсли;
		
		Для Каждого СтрТовара Из СтрАгрегата.ПолучитьЭлементы() Цикл
			ЗаполнитьЗначенияСвойств(ТоварыАгрегатов.Добавить(), СтрТовара);
		КонецЦикла;
		
	КонецЦикла;
	
	МодульОбъекта().ТаблицаЗначений_СвернутьПоВсемКолонкам(ТоварыАгрегатов, "Количество, КоличествоУпаковок");
	
	МодульОбъекта().ТоварыАгрегатов_Записать(ТоварыАгрегатов);
	
КонецПроцедуры

&НаКлиенте
Процедура Агрегаты_ПослеВыбораСтрокиДокумента(РезультатВыбора, ДопПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовыйКлючСтрокиДокумента = РезультатВыбора.Значение;
	НоваяСтрокаДокумента = РезультатВыбора.Представление;
	
	Если Не ЗначениеЗаполнено(НовыйКлючСтрокиДокумента) Тогда
		НоваяСтрокаДокумента = "";
	КонецЕсли;
	
	Для каждого ИдентификаторСтроки Из Элементы.Агрегаты.ВыделенныеСтроки Цикл
		Стр = Агрегаты.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Стр.УровеньАгрегата Тогда
			Стр.КлючСтрокиДокумента = НовыйКлючСтрокиДокумента;
			Стр.СтрокаДокумента = НоваяСтрокаДокумента;
		КонецЕсли;
	КонецЦикла;
	
	Агрегаты_УстановитьКлючСтрокиДокументаНаСервере(НовыйКлючСтрокиДокумента);
	
КонецПроцедуры

&НаСервере
Процедура Агрегаты_УстановитьКлючСтрокиДокументаНаСервере(НовыйКлючСтрокиДокумента)
	
	ТаблицаКодов = МодульОбъекта().Новый_ТаблицаКодов();
	Для каждого ИдентификаторСтроки Из Элементы.Агрегаты.ВыделенныеСтроки Цикл
		Стр = Агрегаты.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Стр.УровеньАгрегата Тогда
			ТаблицаКодов.Добавить().КлючКода = Стр.КлючКода;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов.ЗаполнитьЗначения(НовыйКлючСтрокиДокумента, "КлючСтрокиДокумента");
	
	МодульОбъекта().КодыДокументов_Записать(ТаблицаКодов, Ссылка, Ложь, Истина);
	
	ЗаполнитьКоличествоКодов();
	
КонецПроцедуры

&НаКлиенте
Процедура КодыМаркировки_ПослеВыбораСтрокиДокумента(РезультатВыбора, ДопПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КодыМаркировки_УстановитьКлючСтрокиДокументаНаСервере(РезультатВыбора.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторЗаводскихСерийныхНомеров(СтрДок)
	
	Если Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Необходимо сохранить изменения, продолжить?'");
		Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("ОткрытьРедакторЗаводскихСерийныхНомеровПослеСогласияСохранения", ЭтаФорма, СтрДок);
		МодульКлиента().ПоказатьДиалогВопроса(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("КлючСтрокиДокумента", СтрДок.КлючСтрокиДокумента);
	СтрокиТоваров = ТоварыМаркировки.НайтиСтроки(ПараметрыОтбора);
	
	Если Не ЗначениеЗаполнено(СтрокиТоваров) Тогда
		ТекстСообщения = НСтр("ru = 'Необходимо указать GTIN'");
		МодульКлиента().СообщитьПользователюЛок(ТекстСообщения, УникальныйИдентификатор);
		Возврат;
	КонецЕсли;
	
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("ОбновитьКоличествоЗСН", ЭтаФорма, СтрДок);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДокументУчета", Ссылка);
	ПараметрыФормы.Вставить("КлючСтрокиДокумента", СтрДок.КлючСтрокиДокумента);
	ПараметрыФормы.Вставить("КлючНоменклатуры1С", СтрДок.КлючНоменклатуры1С);
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	Если СтрокиТоваров.Количество() = 1 Тогда
		ПараметрыФормы.Вставить("Товар", СтрокиТоваров[0].Товар);
	КонецЕсли;
	
	МодульКлиента().ОткрытьРедакторЗаводскихСерийныхНомеров(ЭтаФорма, ПараметрыФормы, Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторЗаводскихСерийныхНомеровПослеСогласияСохранения(Ответ, СтрДок) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьДокументУчета();
	
	ОткрытьРедакторЗаводскихСерийныхНомеров(СтрДок);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКоличествоЗСН(Успешно, СтрокаТоваров) Экспорт
	
	Если Успешно = Истина Тогда
		ЗаполнитьКоличествоЗаводскихСерийныхНомеров();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НаполнитьКодамиНаТСДНачатьРаботуПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТребуемыеДействия = МодульКлиента().Перечисление_ТребуемыеДействияДокументовУчета();
	СтатусыДокументовУчета = МодульКлиента().Перечисление_СтатусыДокументовУчета();
	
	Если Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Новый Тогда
		Статусы.ОсновнойСтатус = СтатусыДокументовУчета.ВРаботе;
	КонецЕсли;
	
	ТоварыМаркировки.Очистить();
	
	СброситьКодыДокументаИСохранить();
	
	ТипОперации = МодульКлиента().Перечисление_ТипыОпераций().ПодборТоваровИКодовНаТСД;
	МодульКлиента().Операция_СоздатьИОткрыть(ТипОперации, Ссылка,,, ЭтаФорма);
	ОбновитьСписокОпераций();
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьКнопкиПоискаДля82()
	
	Если Не МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.КодыМаркировкиКнопкиПоискаДля82.Видимость = Истина;
	Элементы.АгрегатыКнопкиПоискаДля82.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПодвалДля82()
	
	Если Не МодульОбъекта().ВерсияПлатформыНиже("8.3.12")
		И Не МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаРезультатПроверкиКодов.Видимость = Ложь;
	
	Элементы.НадписьИтогоПоСтатусам.РастягиватьПоГоризонтали = Истина;
	Элементы.НадписьИтогоПоСтатусам.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
	
	Ширина15 = 15;
	Ширина75 = 75;
	
	ПрефиксГруппа = "Группа";
	ПрефиксНадпись = "Надпись";
	
	Для Каждого КлючЗначение Из МодульОбъекта().Перечисление_ТипыПроверкиКодов() Цикл
		
		ИмяЭлементаГруппы = ПрефиксГруппа + КлючЗначение.Ключ;
		ИмяЭлементаНадпись = ПрефиксНадпись + КлючЗначение.Ключ;
		
		Элементы[ИмяЭлементаГруппы].Ширина = Ширина75;
		Элементы[ИмяЭлементаНадпись].Ширина = Ширина15;
		
	КонецЦикла;
	
	НовыйРодительГруппаРезультат82 = Элементы.ГруппаРезультатПроверкиКодов82;
	
	Элементы.Переместить(Элементы.ГруппаПодсказкаПроверки, НовыйРодительГруппаРезультат82, Элементы.ГруппаРезультатыПроверки82);
	Элементы.Переместить(Элементы.ГруппаСтатусыПроверкиКодов, НовыйРодительГруппаРезультат82);
	Элементы.Переместить(Элементы.ГруппаКакИсправитьОшибку, НовыйРодительГруппаРезультат82);
	
	Элементы.Переместить(Элементы.ДатаВыполненияПроверки, Элементы.ГруппаРезультатыПроверки82);
	Элементы.Переместить(Элементы.ГруппаКоличествоКодовСОшибками, Элементы.ГруппаРезультатыПроверки82);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьКомандФормы()
	
	НастройкаДокумента = МодульОбъекта().НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента);
	ОписаниеНастройки = МодульОбъекта().НастройкиДокументаУчета_Прочитать(НастройкаДокумента);
	
	Для каждого Эл Из СоответствиеЭлементовИКомандДокументов() Цикл
		Элементы[Эл.Ключ].Видимость = Не МодульОбъекта().МассивСодержитЗначение(ОписаниеНастройки.ОтключенныеКоманды, Эл.Значение);
	КонецЦикла;
	
	РолиДокументов = МодульОбъекта().Перечисление_РолиДокументовУчета();
	ЕстьРольОтгрузка = ДокументуДоступнаРоль(РолиДокументов.Отгрузка);
	ЕстьРольКорректировка = ДокументуДоступнаРоль(РолиДокументов.КорректировкаОтгрузки);
	
	Если ЕстьРольОтгрузка Или ЕстьРольКорректировка Тогда
		
		Элементы.Кнопка_ОтчетПоВиртуальномуСкладу.Видимость = ТоварыДокумента_ЕстьОтражениеВЭДООСУ();
		Элементы.Кнопка_СообщитьОбОтгрузке.Видимость = Истина;
		Элементы.Кнопка_ПроверитьКоды.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьКартинкиКомандФормы()
	
	ОписаниеТарифа = МодульОбъекта().Тариф(Организация);
	
	Для Каждого Элемент Из СоответствиеКомандИТиповОперацийДляПодписок() Цикл
		
		Команда = Элемент.Ключ;
		ТипОперации = Элемент.Значение;
		
		Если ТипОперации = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если МодульОбъекта().СозданиеОперацииОграниченоТарифом(ТипОперации, ОписаниеТарифа) Тогда
			Команда.Картинка = БиблиотекаКартинок.КонтурМаркировка_Замок;
		Иначе
			Команда.Картинка = Новый Картинка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СоответствиеКомандИТиповОперацийДляПодписок()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(Команды.Коды_Заказать,                      ТипыОпераций.ЗаказКодов);
	
	Результат.Вставить(Команды.Коды_СоздатьОтчетОНанесении,        ТипыОпераций.ОтчетОНанесении);
	Результат.Вставить(Команды.Коды_НаполнитьОтчетОНанесенииНаТСД, ТипыОпераций.ОтчетОНанесенииНаТСД);
	
	Результат.Вставить(Команды.Коды_ВыполнитьВводВОборот,          ТипыОпераций.ВводВОборот);
	Результат.Вставить(Команды.Коды_ВывестиИзОборота,              ТипыОпераций.ВыводИзОборота);
	
	Результат.Вставить(Команды.Коды_ВернутьВОборот,                ТипыОпераций.ВозвратВОборот);
	Результат.Вставить(Команды.Коды_НаполнитьВозвратВОборотНаТСД,  ТипыОпераций.ВозвратВОборотНаТСД);
	
	Результат.Вставить(Команды.Коды_НаполнитьНаборыНаТСД,          ТипыОпераций.НаполнениеНаборовНаТСД);
	Результат.Вставить(Команды.Коды_ЗарегистрироватьНаборы,        ТипыОпераций.РегистрацияНаборов);
	Результат.Вставить(Команды.Коды_РасформироватьНаборы,          ТипыОпераций.РасформированиеНаборов);
	
	Результат.Вставить(Команды.Коды_Агрегировать,                  ТипыОпераций.АгрегацияКодов);
	Результат.Вставить(Команды.Коды_ЗарегистрироватьКИТУ,          ТипыОпераций.РегистрацияАгрегатов);
	Результат.Вставить(Команды.Коды_Разагрегировать,               ТипыОпераций.РасформированиеАгрегатов);
	Результат.Вставить(Команды.Коды_НаполнитьАгрегатыНаТСД,        ТипыОпераций.НаполнениеАгрегатовНаТСД);
	
	Результат.Вставить(Команды.Коды_АгрегироватьКИГУ,              ТипыОпераций.ФормированиеКИГУ);
	Результат.Вставить(Команды.Коды_НаполнитьКИГУНаТСД,            ТипыОпераций.НаполнениеКИГУНаТСД);
	Результат.Вставить(Команды.Коды_ЗарегистрироватьКИГУ,          ТипыОпераций.РегистрацияКИГУ);
	
	Результат.Вставить(Команды.Коды_СформироватьАТК,               ТипыОпераций.ФормированиеАТК);
	Результат.Вставить(Команды.Коды_РасформироватьАТК,             ТипыОпераций.РасформированиеАТК);
	
	Результат.Вставить(Команды.Коды_СоздатьОтчетОВыбытии,          ТипыОпераций.ОтчетОВыбытии);
	Результат.Вставить(Команды.Коды_НаполнитьОтчетОВыбытииНаТСД,   ТипыОпераций.ОтчетОВыбытииНаТСД);
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Возврат Результат;
	
КонецФункции

