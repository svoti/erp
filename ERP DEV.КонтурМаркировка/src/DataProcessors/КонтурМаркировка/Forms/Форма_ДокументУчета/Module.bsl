КонецПроцедуры

&НаСервере
Процедура ОтключитьПроверкуКодовПоТипу(ТипПроверки)
	
	СтатусыПроверкиКодов = МодульОбъекта().Перечисление_СтатусыПроверкиКодовДокумента();
	ДопИнформацияСтатусов = МодульОбъекта().Перечисление_ДопИнформацияСтатусовПроверкиКодовДокумента();
	
	СтатусыРезультатаПроверки = МодульОбъекта().ДокументУчета_СтатусыРезультатаПроверкиКодов(Ссылка);
	ИмяПоляДопИнформация = МодульОбъекта().ИмяПоляДопИнформация(ТипПроверки);
	
	Если СтатусыРезультатаПроверки[ТипПроверки] = СтатусыПроверкиКодов.Отключена Тогда
		СтатусыРезультатаПроверки[ТипПроверки] = СтатусыПроверкиКодов.НеАктуален;
		СтатусыРезультатаПроверки[ИмяПоляДопИнформация] = ДопИнформацияСтатусов.ПроверкаКодовНеактуальнаПерезапустить;
	Иначе
		СтатусыРезультатаПроверки[ТипПроверки] = СтатусыПроверкиКодов.Отключена;
		СтатусыРезультатаПроверки[ИмяПоляДопИнформация] = ДопИнформацияСтатусов.ПроверкаКодовОтключенаВДокументе;
	КонецЕсли;
	
	МодульОбъекта().ДокументУчета_ЗаписатьРезультатыПроверкиКодов(Ссылка, СтатусыРезультатаПроверки);
	
	ОбновитьРезультатыПроверкиКодов();
	ЗаполнитьКоличествоКодов();
	
КонецПроцедуры

