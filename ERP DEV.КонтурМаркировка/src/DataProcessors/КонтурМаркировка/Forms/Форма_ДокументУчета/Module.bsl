КонецФункции

&НаСервере
Функция ПодсказкаКонтрольКодовОтключен()
	
	Результат = "";
	СтатусыПроверкиКодов = МодульОбъекта().Перечисление_СтатусыПроверкиКодовДокумента();
	СтатусыРезультатаПроверки = МодульОбъекта().ДокументУчета_СтатусыРезультатаПроверкиКодов(Ссылка);
	
	ШаблонПодсказки = НСтр("ru='Контроль кодов отключен. В документ отгрузки могут попасть коды товаров %1'");
	
	ДопТекст = Новый Массив;
	
	Если СтатусыРезультатаПроверки.ПроверкаСтатусаКодов = СтатусыПроверкиКодов.Отключена Тогда
		ДопТекст.Добавить(НСтр("ru='в некорректном статусе'"));
	КонецЕсли;
	
	Если СтатусыРезультатаПроверки.ПроверкаРДКодов = СтатусыПроверкиКодов.Отключена Тогда
		ДопТекст.Добавить(НСтр("ru='с недоступными РД'"));
	КонецЕсли;
	
	Если СтатусыРезультатаПроверки.ПроверкаВладельцаКодов = СтатусыПроверкиКодов.Отключена Тогда
		ДопТекст.Добавить(НСтр("ru='не принадлежащие организации'"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДопТекст) Тогда
		Результат = МодульОбъекта().ПараметрыВСтроку(ШаблонПодсказки, МодульОбъекта().СоединитьСтроку(ДопТекст, ", "));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

