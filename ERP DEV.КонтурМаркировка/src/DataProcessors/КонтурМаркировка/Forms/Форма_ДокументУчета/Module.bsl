&НаКлиенте
Процедура ОткрытьФормуРедактораОперации(Команда)
	
	Операция = Неопределено;
	
	Если Элементы.ГруппаЗакладки.ТекущаяСтраница = Элементы.Закладка_Операции Тогда
		ТекущиеДанные = Элементы.СписокОпераций.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Операция = ТекущиеДанные.Операция;
	КонецЕсли;
	
	МодульКлиента().ОткрытьФормуРедактораОперации(Операция, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедакторКода(Команда)
	
	ТекущийКлючКода = Неопределено;
	
	Если Элементы.ГруппаЗакладки.ТекущаяСтраница = Элементы.Закладка_КодыМаркировки Тогда
		ТекущиеДанные = Элементы.КодыМаркировки.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаЗакладки.ТекущаяСтраница = Элементы.Закладка_Агрегаты Тогда
		ТекущиеДанные = Элементы.Агрегаты.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Неопределено;
	КонецЕсли;
	
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущийКлючКода = ТекущиеДанные.КлючКода;
	КонецЕсли;
	
	МодульКлиента().ОткрытьФормуРедактораКодаМаркировки(ТекущийКлючКода, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКодыДокумента(Команда)
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗапуститьПроверкуКодов() Тогда
		ОбновитьСтатусПроверкиКодов();
	Иначе
		ТекстПредупреждения = НСтр("ru = 'Нет кодов для проверки'");
		МодульКлиента().ПоказатьДиалогПредупреждения(ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьПроверкуКодов()
	
	Если Не МодульОбъекта().КодыДокументов_ЕстьКоды(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МодульОбъекта().ЗапуститьПроверкуКодовДокумента(Ссылка);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСтатусПроверкиКодовПриОткрытии()
	
	Если МодульКлиента().ПроверкаКодовДокументаВыполняется(Ссылка) Тогда
		ИнтервалОжидания = 5;
		ПодключитьОбработчикОжидания("ОбновитьСтатусПроверкиКодов", ИнтервалОжидания, Истина);
		НастроитьКнопкуПроверкиКодов(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусПроверкиКодов() Экспорт
	
	ПроверкаКодовВыполняется = МодульКлиента().ПроверкаКодовДокументаВыполняется(Ссылка);
	
	НастроитьКнопкуПроверкиКодов(ПроверкаКодовВыполняется);
	
	Если ПроверкаКодовВыполняется Тогда
		ИнтервалОжидания = 5;
		ПодключитьОбработчикОжидания("ОбновитьСтатусПроверкиКодов", ИнтервалОжидания, Истина);
	Иначе
		ОбновитьРезультатыПроверкиКодов();
		ОбновитьСпискиКодовИАгрегатов();
		УстановитьПодсказку();
	КонецЕсли;
	
КонецПроцедуры

