Процедура НастроитьКнопкуОбновленияСтатусовКодов(ОбновлениеСтатусовВыполняется)
	
	Если ОбновлениеСтатусовВыполняется Тогда
		ЗаголовокКнопки = НСтр("ru = 'Обновляются статусы кодов...'");
		ДоступностьКнопки = Ложь;
	Иначе
		ЗаголовокКнопки = НСтр("ru = 'Обновить статусы кодов'");
		ДоступностьКнопки = Истина;
	КонецЕсли;
	
	Элементы.Кнопка_ОбновитьСтатусыКодов.Заголовок = ЗаголовокКнопки;
	Элементы.Кнопка_ОбновитьСтатусыКодов1.Заголовок = ЗаголовокКнопки;
	
	Элементы.Кнопка_ОбновитьСтатусыКодов.Доступность = ДоступностьКнопки;
	Элементы.Кнопка_ОбновитьСтатусыКодов1.Доступность = ДоступностьКнопки;
	
