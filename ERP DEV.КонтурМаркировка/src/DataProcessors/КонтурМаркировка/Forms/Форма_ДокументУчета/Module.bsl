&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ТоварыКоличествоЗСН Тогда
		СтандартнаяОбработка = Ложь;
		Если ТекущиеДанные.ТребуетсяЗСН Тогда
			ОткрытьРедакторЗаводскихСерийныхНомеров(ТекущиеДанные);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ТоварыНоменклатура Тогда
		СсылкаНаОбъект = ТекущиеДанные.Номенклатура;
	ИначеЕсли Поле = Элементы.ТоварыХарактеристика Тогда
		СсылкаНаОбъект = ТекущиеДанные.Характеристика;
	ИначеЕсли Поле = Элементы.ТоварыУпаковка Тогда
		СсылкаНаОбъект = ТекущиеДанные.Упаковка;
	ИначеЕсли Поле = Элементы.ТоварыСерия Тогда
		СсылкаНаОбъект = ТекущиеДанные.Серия;
	Иначе
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ОткрытьФормуОбъектаИС(СсылкаНаОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	СтрокаДокумента = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если СтрокаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючСтрокиДокумента = СтрокаДокумента.КлючСтрокиДокумента;
	НеПодлежитМаркировке = СтрокаДокумента.НеПодлежитМаркировке;
	
	Элементы.Кнопка_ТоварНеПодлежитМаркировке.Пометка = НеПодлежитМаркировке;
	
	Если СтрокаДокумента.НеПодлежитМаркировке Тогда
		ПараметрыОтбора = Новый ФиксированнаяСтруктура("КлючСтрокиДокумента", МодульКлиента().ПустойУникальныйИдентификатор());
	Иначе
		ПараметрыОтбора = Новый ФиксированнаяСтруктура("КлючСтрокиДокумента", КлючСтрокиДокумента);
	КонецЕсли;
	Элементы.ТоварыМаркировки.ОтборСтрок = ПараметрыОтбора;
	
	ОбновитьТекстСообщенияОбОшибке();
	ОбновитьТекстОстатка();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	Стр = Элементы.ТоварыДокумента.ТекущиеДанные;
	Если Стр.КоличествоУпаковок = 0 Тогда
