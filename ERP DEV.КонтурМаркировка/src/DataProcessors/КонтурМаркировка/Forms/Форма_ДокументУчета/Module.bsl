&НаКлиенте
Процедура КодыМаркировкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Поле = Элементы.КодыМаркировкиКодМаркировки Тогда
		
		Если ЗначениеЗаполнено(ТекущиеДанные.КлючКода) Тогда
			МодульКлиента().ОткрытьФормуКодаМаркировки(ТекущиеДанные.КлючКода, Организация, ЭтаФорма);
		КонецЕсли;
		
	ИначеЕсли Поле = Элементы.КодыМаркировкиСтрокаДокумента Тогда
		
		Если ТолькоПросмотр Тогда
			Возврат;
		КонецЕсли;
		
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
		"КодыМаркировки_ПослеВыбораСтрокиДокумента", ЭтаФорма);
		
		МодульКлиента().ПоказатьДиалогВыбораИзСписка(ОписаниеОбработчика
		, СписокСтрокДокумента()
		, Элемент
		, ЭтаФорма
		, ТекущиеДанные.КлючСтрокиДокумента);
		
	КонецЕсли;
	
КонецПроцедуры

