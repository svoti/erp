&НаКлиенте
Процедура УстановитьОтборПоказатьСписанныеКодыМаркировки()
	
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПоказатьСписанные"
	, Не Элементы.Кнопка_СкрытьСписанныеКоды.Пометка);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьЭлементовФормы(ПриСозданииНаСервере = Ложь)
	
	Если ПриСозданииНаСервере Тогда
		
		Если МодульОбъекта().ДокументУчета_ЕстьРолиДляОтраженияВЭДО(Ссылка) Тогда
			Элементы.ТоварыОтражениеВЭДО.Видимость = Истина;
		КонецЕсли;
		
		Если МодульОбъекта().ДокументУчета_ЕстьРольКорректировкаОтгрузки(Ссылка) Тогда
			Элементы.ГруппаКорректировка.Видимость = Истина;
			Элементы.Кнопка_НаполнитьКодамиИзИсправляемогоДокумента.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	СтатусыДокументовУчета = МодульОбъекта().Перечисление_СтатусыДокументовУчета();
	
	Элементы.ГруппаИтого.Видимость = ЗначениеЗаполнено(ИтогоПоСтатусам);
	
	Элементы.ТоварыНоменклатура.Ширина = 10;
	
	Элементы.Документ1С.Видимость = ЗначениеЗаполнено(Документ1С);
	Элементы.ГруппаЭтапыМаркировки.Видимость = ЗначениеЗаполнено(МаршрутМаркировки);
	
	ТребуютсяЗСН = ТоварыДокумента_ТребуютсяЗаводскиеСерийныеНомера();
	ДоступенПартионныйУчет = ТоварыМаркировки_ДоступенПартионныйУчет() И МодульОбъекта().ДокументУчета_ЕстьРолиДляПартионногоУчета(Ссылка);
	ВключенПартионныйУчет = ТоварыДокумента_ЕстьОтражениеВЭДОПартионныйУчет();
	ЕстьПеременныйВес = ТоварыМаркировки_ЕстьПеременныйВес();
	
	УстановитьТолькоПросмотр(Ложь);
	
	Если Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Новый Тогда
		
		Элементы.Кнопка_НачатьРаботу.КнопкаПоУмолчанию		= Истина;
		Элементы.Кнопка_НачатьРаботу.Видимость				= Истина;
		
		Элементы.Кнопка_Перезаполнить.Видимость				= ЗначениеЗаполнено(Документ1С);
		Элементы.Кнопка_НеПодлежитМаркировке.Видимость		= Истина;
		Элементы.Кнопка_ЗавершитьРаботу.Видимость			= Ложь;
		Элементы.Кнопка_Записать.Видимость					= Истина;
		Элементы.Кнопка_ВозобновитьРаботу.Видимость			= Ложь;
		
		Элементы.ДекорацияУстановитьЭтапВручную.Доступность = Истина;
		Элементы.ДекорацияУстановитьЭтапВручную82.Доступность = Истина;
		
		Элементы.ГруппаТоваровМаркировки.ТолькоПросмотр = Ложь;
		Элементы.ТоварыМаркировкиГруппаКнопок.Доступность = Истина;
		
		Элементы.Закладка_Операции.Видимость = Ложь;
		
		Элементы.Меню_ПодобратьКодыНачатьРаботу.Видимость = Истина;
		Элементы.Меню_ЗаполнитьПартии.Видимость = Ложь;
		Элементы.Меню_ПодобратьКоды.Видимость = Ложь;
		Элементы.Меню_УдалитьКоды.Видимость = Ложь;
		Элементы.Кнопка_ВыполнитьОбмен.Видимость = Ложь;
		Элементы.Кнопка_ОбновитьЗадачи.Видимость = Ложь;
		Элементы.Закладка_КодыМаркировки.Видимость = Ложь;
		Элементы.Закладка_Агрегаты.Видимость = Ложь;
		Элементы.Кнопка_СообщитьОбОтгрузке.Видимость = Ложь;
		Элементы.ТоварыКоличествоКодов.Видимость = Ложь;
		Элементы.ТоварыКоличествоУпаковок.ТолькоПросмотр = Ложь;
		Элементы.ТоварыКоличествоЗСН.Видимость = Ложь;
		Элементы.КодыМаркировкиЗаводскойСерийныйНомер.Видимость = Ложь;
		Элементы.КодыМаркировкиНомерПартии.Видимость = ДоступенПартионныйУчет;
		Элементы.Кнопка_ДобавитьЗСН.Видимость = Ложь;
		Элементы.ТоварыМаркировкиНомерПартии.Видимость = Ложь;
		Элементы.ТоварыМаркировкиКоличество.Видимость = Ложь;
		Элементы.Кнопка_ПроверитьКоды.Видимость = Ложь;
		
	ИначеЕсли Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Пропущен Тогда
		
		Элементы.Кнопка_НачатьРаботу.Видимость = Ложь;
		Элементы.Кнопка_Перезаполнить.Видимость = Ложь;
		Элементы.Кнопка_НеПодлежитМаркировке.Видимость = Ложь;
		Элементы.Кнопка_ЗавершитьРаботу.Видимость = Ложь;
		Элементы.Кнопка_Записать.Видимость = Ложь;
		Элементы.Кнопка_ВозобновитьРаботу.Видимость = Истина;
		
		Элементы.ДекорацияУстановитьЭтапВручную.Доступность = Ложь;
		Элементы.ДекорацияУстановитьЭтапВручную82.Доступность = Ложь;
		
		Элементы.ГруппаТоваровМаркировки.ТолькоПросмотр = Истина;
		Элементы.ТоварыМаркировкиГруппаКнопок.Доступность = Ложь;
		
		Элементы.Закладка_Операции.Видимость = Ложь;
		
		Элементы.Меню_ПодобратьКодыНачатьРаботу.Видимость = Ложь;
		Элементы.Меню_ЗаполнитьПартии.Видимость = Ложь;
		Элементы.Меню_ПодобратьКоды.Видимость = Ложь;
		Элементы.Меню_УдалитьКоды.Видимость = Ложь;
		Элементы.Кнопка_ВыполнитьОбмен.Видимость = Ложь;
		Элементы.Кнопка_ОбновитьЗадачи.Видимость = Ложь;
		Элементы.Закладка_КодыМаркировки.Видимость = Ложь;
		Элементы.Закладка_Агрегаты.Видимость = Ложь;
		Элементы.Кнопка_СообщитьОбОтгрузке.Видимость = Ложь;
		Элементы.ТоварыКоличествоКодов.Видимость = Ложь;
		Элементы.ТоварыКоличествоУпаковок.ТолькоПросмотр = Ложь;
		Элементы.ТоварыКоличествоЗСН.Видимость = Ложь;
		Элементы.КодыМаркировкиЗаводскойСерийныйНомер.Видимость = Ложь;
		Элементы.Кнопка_ДобавитьЗСН.Видимость = Ложь;
		Элементы.ТоварыМаркировкиНомерПартии.Видимость = Ложь;
		Элементы.ТоварыМаркировкиКоличество.Видимость = Ложь;
		Элементы.Кнопка_ПроверитьКоды.Видимость = Ложь;
		
	ИначеЕсли Статусы.ОсновнойСтатус = СтатусыДокументовУчета.ВРаботе Тогда
		
		Элементы.Кнопка_НачатьРаботу.Видимость				= Ложь;
		Элементы.Кнопка_Перезаполнить.Видимость				= ЗначениеЗаполнено(Документ1С);
		Элементы.Кнопка_НеПодлежитМаркировке.Видимость 		= Ложь;
		Элементы.Кнопка_ЗавершитьРаботу.Видимость			= Истина;
		Элементы.Кнопка_Записать.Видимость					= Истина;
		Элементы.Кнопка_ВозобновитьРаботу.Видимость			= Ложь;
		
		Элементы.ДекорацияУстановитьЭтапВручную.Доступность = Истина;
		Элементы.ДекорацияУстановитьЭтапВручную82.Доступность = Истина;
		
		Элементы.Кнопка_ЗавершитьРаботу.КнопкаПоУмолчанию = Истина;
		
		Элементы.КодыМаркировки.ТолькоПросмотр = Ложь;
		
		Элементы.ГруппаТоваровМаркировки.ТолькоПросмотр = Ложь;
		Элементы.ТоварыМаркировкиГруппаКнопок.Доступность = Истина;
		
		Элементы.Закладка_Операции.Видимость = Истина;
		
		Элементы.Меню_ПодобратьКодыНачатьРаботу.Видимость = Ложь;
		Элементы.Меню_ПодобратьКоды.Видимость = Истина;
		Элементы.Меню_ЗаполнитьПартии.Видимость = ДоступенПартионныйУчет;
		Элементы.Меню_УдалитьКоды.Видимость = Истина;
		Элементы.Кнопка_ВыполнитьОбмен.Видимость = Истина;
		Элементы.Кнопка_ОбновитьЗадачи.Видимость = Истина;
		Элементы.Закладка_КодыМаркировки.Видимость = Истина;
		Элементы.Закладка_Агрегаты.Видимость = Истина;
		Элементы.ТоварыКоличествоКодов.Видимость = Истина;
		Элементы.ТоварыКоличествоУпаковок.ТолькоПросмотр = Истина;
		Элементы.Меню_ОперацииСКодами.Видимость = Истина;
		Элементы.Меню_ОперацииСАгрегатами.Видимость = Истина;
		Элементы.КодыМаркировкиЗаводскойСерийныйНомер.Видимость = ТребуютсяЗСН;
		Элементы.ТоварыКоличествоЗСН.Видимость = ТребуютсяЗСН;
		Элементы.Кнопка_ДобавитьЗСН.Видимость = ТребуютсяЗСН;
		Элементы.ТоварыМаркировкиНомерПартии.Видимость = ДоступенПартионныйУчет И ВключенПартионныйУчет;
		Элементы.ТоварыМаркировкиКоличество.Видимость = ДоступенПартионныйУчет И ВключенПартионныйУчет И ЕстьПеременныйВес;
		Элементы.КодыМаркировкиНомерПартии.Видимость = ДоступенПартионныйУчет;
		
	ИначеЕсли Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Завершен Тогда
		
		УстановитьТолькоПросмотр(Истина);
		
		Элементы.Кнопка_НачатьРаботу.Видимость = Ложь;
		Элементы.Кнопка_Перезаполнить.Видимость = Ложь;
		Элементы.Кнопка_НеПодлежитМаркировке.Видимость = Ложь;
		Элементы.Кнопка_ЗавершитьРаботу.Видимость = Ложь;
		Элементы.Кнопка_Записать.Видимость = Ложь;
		Элементы.Кнопка_ВозобновитьРаботу.Видимость = Истина;
		
		Элементы.ДекорацияУстановитьЭтапВручную.Доступность = Ложь;
		Элементы.ДекорацияУстановитьЭтапВручную82.Доступность = Ложь;
		
		Элементы.КодыМаркировки.ТолькоПросмотр = Истина;
		
		Элементы.ГруппаТоваровМаркировки.ТолькоПросмотр = Истина;
		Элементы.ТоварыМаркировкиГруппаКнопок.Доступность = Ложь;
		Элементы.ТоварыКоличествоЗСН.Видимость = ТребуютсяЗСН;
		Элементы.КодыМаркировкиЗаводскойСерийныйНомер.Видимость = ТребуютсяЗСН;
		Элементы.ТоварыМаркировкиНомерПартии.Видимость = ДоступенПартионныйУчет И ВключенПартионныйУчет;
		Элементы.ТоварыМаркировкиКоличество.Видимость = ДоступенПартионныйУчет И ВключенПартионныйУчет И ЕстьПеременныйВес;
		Элементы.КодыМаркировкиНомерПартии.Видимость = ДоступенПартионныйУчет;
		
		Элементы.Меню_ПодобратьКодыНачатьРаботу.Видимость = Ложь;
		Элементы.Меню_ПодобратьКоды.Видимость = Ложь;
		Элементы.Меню_ЗаполнитьПартии.Видимость = Ложь;
		Элементы.Меню_УдалитьКоды.Видимость = Ложь;
		Элементы.Кнопка_ВыполнитьОбмен.Видимость = Ложь;
		Элементы.Кнопка_ОбновитьЗадачи.Видимость = Ложь;
		Элементы.Меню_ОперацииСКодами.Видимость = Ложь;
		Элементы.Меню_ОперацииСАгрегатами.Видимость = Ложь;
		Элементы.Кнопка_ДобавитьЗСН.Видимость = Ложь;
		
		Элементы.Кнопка_СообщитьОбОтгрузке.Видимость = Ложь;
		Элементы.Кнопка_ПроверитьКоды.Видимость = Ложь;
		
	Иначе
		ВызватьИсключение НСтр("ru = 'Документ учета имеет неизвестный статус: '") + Статусы.ОсновнойСтатус;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТоварыДокумента) Тогда
		УстановитьВидимостьКолонкиТоваров("Характеристика");
		УстановитьВидимостьКолонкиТоваров("Упаковка");
		УстановитьВидимостьКолонкиТоваров("Артикул");
		УстановитьВидимостьКолонкиТоваров("Серия");
		УстановитьВидимостьКолонкиТоваров("Цена");
	КонецЕсли;
	
	Если ОбъектВПроцессеОбновления Тогда
		УстановитьТолькоПросмотр(Истина);
	КонецЕсли;
	
	РежимТехническогоСпециалиста = МодульОбъекта().ВключенРежимТехническогоСпециалиста();
	НастроитьВидимостьПодменюТехническогоСпециалиста(РежимТехническогоСпециалиста);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКолонкиТоваров(ИмяКолонки)
	
	ЕстьЗначения = Ложь;
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		Если ЗначениеЗаполнено(Стр[ИмяКолонки]) Тогда
			ЕстьЗначения = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы["Товары" + ИмяКолонки].Видимость = ЕстьЗначения;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТолькоПросмотр(Значение)
	
	ЭтаФорма.ТолькоПросмотр = Значение;
	Элементы.Закладка_Агрегаты.ТолькоПросмотр = Значение;
	Элементы.Закладка_КодыМаркировки.ТолькоПросмотр = Значение;
	Элементы.Закладка_Дополнительно.ТолькоПросмотр = Значение;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьПодменюТехническогоСпециалиста(РежимТехническогоСпециалиста)
	
	Элементы.Группа_ФункцииТехническогоСпециалиста.Видимость = РежимТехническогоСпециалиста;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКнопкиСкрытьСписанные(Значение)
	
	Элементы.Кнопка_СкрытьСписанныеКоды.Видимость = Значение;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРезультатыПроверкиКодов()
	
	СтатусыРезультатаПроверки = МодульОбъекта().ДокументУчета_СтатусыРезультатаПроверкиКодов(Ссылка);
	ЗаполнитьКонтекстРезультатаПроверкиКодов(СтатусыРезультатаПроверки);
	НастроитьЭлементыРезультатаПроверкиКодов(СтатусыРезультатаПроверки);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыРезультатаПроверкиКодов(СтатусыПроверокКодов)
	
	СтатусыПроверкиКодов = МодульОбъекта().Перечисление_СтатусыПроверкиКодовДокумента();
	ТипыПроверкиКодов = МодульОбъекта().Перечисление_ТипыПроверкиКодов();
	
	Если МодульОбъекта().ВерсияПлатформыНиже("8.3.12")
		Или МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
		ГруппаРезультатПроверки = Элементы.ГруппаРезультатПроверкиКодов82;
		ЭлементРезультатПроверки = Элементы.НадписьРезультатыПроверки82;
		ИмяСвойстваЦвет = "ЦветТекста";
	Иначе
		ГруппаРезультатПроверки = Элементы.ГруппаРезультатПроверкиКодов;
		ЭлементРезультатПроверки = Элементы.ГруппаРезультатыПроверки;
		ИмяСвойстваЦвет = "ЦветТекстаЗаголовка";
	КонецЕсли;
	
	КоличествоКодов = МодульОбъекта().КодыДокументов_ОбщееКоличествоТоварныхКодов(Ссылка);
	КоличествоАгрегатов = МодульОбъекта().КодыДокументов_ОбщееКоличествоТранспортныхУпаковок(Ссылка);
	ЕстьРезультатПроверки = ЗначениеЗаполнено(СтатусыПроверокКодов.РезультатПроверкиКодовДокумента);
	
	ГруппаРезультатПроверки.Видимость = ЕстьРезультатПроверки;
	
	Элементы.ГруппаКоличествоКодовСОшибками.Видимость = КоличествоКодовСОшибками > 0;
	Элементы.КодыМаркировкиГруппаСтатусПроверки.Видимость = (КоличествоКодов > 0 И ЕстьРезультатПроверки);
	Элементы.АгрегатыГруппаСтатусПроверки.Видимость = (КоличествоАгрегатов > 0 И ЕстьРезультатПроверки);
	
	Если Не ЕстьРезультатПроверки Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьРезультатДопПроверки1 = ЗначениеЗаполнено(СтатусыПроверокКодов.ДопПроверкаКодов1);
	ЕстьРезультатДопПроверки2 = ЗначениеЗаполнено(СтатусыПроверокКодов.ДопПроверкаКодов2);
	
	Элементы.ГруппаДопПроверкаКодов1.Видимость = ЕстьРезультатДопПроверки1;
	Элементы.ГруппаДопПроверкаКодов2.Видимость = ЕстьРезультатДопПроверки2;
	
	ПрефиксЭлементаГруппа = "ГруппаНадписи";
	ПрефиксЭлементаКоманды = "Кнопка_Отключить";
	ПрефиксГруппыКолонокАгрегаты = "АгрегатыГруппа";
	ПрефиксГруппыКолонокКодыМаркировки = "КодыМаркировкиГруппа";
	
	Для Каждого КлючЗначение Из ТипыПроверкиКодов Цикл
		
		ЭтоДопПроверка = (КлючЗначение.Значение = ТипыПроверкиКодов.ДопПроверкаКодов1
		Или КлючЗначение.Значение = ТипыПроверкиКодов.ДопПроверкаКодов2);
		
		ТипПроверкиОтключен = (СтатусыПроверокКодов[КлючЗначение.Ключ] = СтатусыПроверкиКодов.Отключена);
		ТипПроверкиОтключенВНастройках = (Не ЭтоДопПроверка И Не МодульОбъекта().ДокументУчета_ВключенТипПроверкиКодов(Ссылка, КлючЗначение.Значение));
		
		ИмяЭлементаГруппа = (ПрефиксЭлементаГруппа + КлючЗначение.Ключ);
		Элементы[ИмяЭлементаГруппа].Доступность = Не ТипПроверкиОтключен;
		
		ИмяЭлементаКоманда = (ПрефиксЭлементаКоманды + КлючЗначение.Ключ);
		Элементы[ИмяЭлементаКоманда].Видимость = (ЭтоДопПроверка Или Не ТипПроверкиОтключенВНастройках);
		
		ВидимостьКолонкиПроверки = (ЗначениеЗаполнено(СтатусыПроверокКодов[КлючЗначение.Ключ]) И Не ТипПроверкиОтключен);
		
		ИмяЭлементаГруппаКолонокКодыМаркировки = (ПрефиксГруппыКолонокКодыМаркировки + КлючЗначение.Ключ);
		Элементы[ИмяЭлементаГруппаКолонокКодыМаркировки].Видимость = ВидимостьКолонкиПроверки;
		
		ИмяЭлементаГруппаКолонокАгрегаты = (ПрефиксГруппыКолонокАгрегаты + КлючЗначение.Ключ);
		Элементы[ИмяЭлементаГруппаКолонокАгрегаты].Видимость = ВидимостьКолонкиПроверки;
		
		Если ТипПроверкиОтключен Тогда
			Элементы[ИмяЭлементаКоманда].Заголовок = НСтр("ru='включить'");
		Иначе
			Элементы[ИмяЭлементаКоманда].Заголовок = НСтр("ru='отключить'");
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтатусыПроверокКодов.РезультатПроверкиКодовДокумента = СтатусыПроверкиКодов.ЕстьОшибки
		Или СтатусыПроверокКодов.РезультатПроверкиКодовДокумента = СтатусыПроверкиКодов.НеАктуален
		Или СтатусыПроверокКодов.РезультатПроверкиКодовДокумента = СтатусыПроверкиКодов.Предупреждение Тогда
		ЭлементРезультатПроверки[ИмяСвойстваЦвет] = WebЦвета.Красный;
	ИначеЕсли СтатусыПроверокКодов.РезультатПроверкиКодовДокумента = СтатусыПроверкиКодов.Отключена Тогда
		ЭлементРезультатПроверки[ИмяСвойстваЦвет] = WebЦвета.Серый;
	Иначе
		ЭлементРезультатПроверки[ИмяСвойстваЦвет] = WebЦвета.Зеленый;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтекстРезультатаПроверкиКодов(СтатусыПроверокКодов)
	
	КоличествоКодовСОшибками = МодульОбъекта().КодыДокументов_КоличествоКодовСОшибками(Ссылка);
	СтатусыПроверкиКодов = МодульОбъекта().Перечисление_СтатусыПроверкиКодовДокумента();
	ТипыПроверкиКодов = МодульОбъекта().Перечисление_ТипыПроверкиКодов();
	
	Если МодульОбъекта().ВерсияПлатформыНиже("8.3.12")
		Или МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
		ГруппаРезультатПроверки = Элементы.ГруппаРезультатПроверкиКодов82;
		ЭлементРезультатПроверки = Элементы.НадписьРезультатыПроверки82;
	Иначе
		ГруппаРезультатПроверки = Элементы.ГруппаРезультатПроверкиКодов;
		ЭлементРезультатПроверки = Элементы.ГруппаРезультатыПроверки;
	КонецЕсли;
	
	ЭлементРезультатПроверки.Заголовок = СтатусыПроверокКодов.ДопИнформация_РезультатПроверкиКодовДокумента;
	Элементы.ДатаВыполненияПроверки.Заголовок = СтатусыПроверокКодов.ДатаСтатуса_РезультатПроверкиКодовДокумента;
	
	ПрефиксЭлементаКартинки = "Картинка";
	ПрефиксЭлементаНадписьСтатус = "НадписьСтатус";
	
	Для Каждого КлючЗначение Из ТипыПроверкиКодов Цикл
		
		ИмяПоляДопИнформация = МодульОбъекта().ИмяПоляДопИнформация(КлючЗначение.Ключ);
		
		РезультатПроверки = СтатусыПроверокКодов[КлючЗначение.Ключ];
		ДопИнформация = СтатусыПроверокКодов[ИмяПоляДопИнформация];
		
		ИмяЭлементаКартинки = (ПрефиксЭлементаКартинки + КлючЗначение.Ключ);
		ИмяЭлементаДопИнформация = (ПрефиксЭлементаНадписьСтатус + КлючЗначение.Ключ);
		
		Если РезультатПроверки = СтатусыПроверкиКодов.Успешно Тогда
			Элементы[ИмяЭлементаКартинки].Картинка = БиблиотекаКартинок.КонтурМаркировка_ГалочкаВКруге;
		ИначеЕсли РезультатПроверки = СтатусыПроверкиКодов.ЕстьОшибки
			Или РезультатПроверки = СтатусыПроверкиКодов.Предупреждение
			Или РезультатПроверки = СтатусыПроверкиКодов.Неактуален Тогда
			Элементы[ИмяЭлементаКартинки].Картинка = БиблиотекаКартинок.КонтурМаркировка_ВосклицательныйЗнак;
		Иначе
			Элементы[ИмяЭлементаКартинки].Картинка = БиблиотекаКартинок.КонтурМаркировка_Запрещено;
		КонецЕсли;
		
		Элементы[ИмяЭлементаДопИнформация].Заголовок = ДопИнформация;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция СписокСтрокДокумента()
	
	Результат = Новый СписокЗначений;
	
	Результат.Добавить(Неопределено, "<Очистить>");
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		Если Стр.НеПодлежитМаркировке = Ложь Тогда
			Результат.Добавить(Стр.КлючСтрокиДокумента, Стр.ПредставлениеСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьКодыВДокументе()
	
	Возврат МодульОбъекта().КодыДокументов_ЕстьКоды(Ссылка);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КоличествоУпаковокТоваровМаркировки(КлючСтрокиДокумента, Форма)
	
	МассивСтрок = Форма.ТоварыМаркировки.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", КлючСтрокиДокумента));
	
	Результат = 0;
	Для Каждого Стр Из МассивСтрок Цикл
		Результат = Результат + Стр.КоличествоУпаковок;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СтрокаДокументаПоКлючуСтроки(КлючСтрокиДокумента)
	
	МассивСтрок = ТоварыДокумента.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", КлючСтрокиДокумента));
	
	Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось найти строку документа по ключу: '") + КлючСтрокиДокумента;
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат МассивСтрок[0];
	
КонецФункции

&НаКлиенте
Процедура ОбновитьТекстОстатка()
	
	ТекСтрока = Элементы.ТоварыДокумента.ТекущиеДанные;
	
	Если НЕ ТекСтрока = Неопределено Тогда
		
		Если ТекСтрока.НеПодлежитМаркировке Тогда
			
			ТекстОстатокПодбора = "Номенклатура не подлежит маркировке";
			//Элементы.ТекстОстатокПодбора.ЦветТекста = Новый Цвет(51,51,51);
			//Элементы.ТекстОстатокПодбора.ЦветФона = Новый Цвет(240,240,240);
			
			Элементы.ТоварыМаркировки.ТолькоПросмотр = Истина;
			Элементы.Кнопка_НайтиТоварПоРеквизитам.Доступность = Ложь;
			
		Иначе
			
			Остаток = ТекСтрока.КоличествоУпаковок - ТекСтрока.КоличествоПодобрано;
			Если Остаток > 0 Тогда
				ТекстОстатокПодбора = "Осталось подобрать: "+Остаток;
				//Элементы.ТекстОстатокПодбора.ЦветТекста = Новый Цвет(83,106,194);
				//Элементы.ТекстОстатокПодбора.ЦветФона = Новый Цвет(255,255,255);
			ИначеЕсли Остаток < 0 Тогда
				ТекстОстатокПодбора = "Уберите лишний товар: "+(-1*Остаток);
				//Элементы.ТекстОстатокПодбора.ЦветТекста = Новый Цвет(255,0,0);
				//Элементы.ТекстОстатокПодбора.ЦветФона = Новый Цвет(255,240,240);
			Иначе
				ТекстОстатокПодбора = "Товары подобраны";
				//Элементы.ТекстОстатокПодбора.ЦветТекста = Новый Цвет(47,80,80);
				//Элементы.ТекстОстатокПодбора.ЦветФона = Новый Цвет(240,255,240);
			КонецЕсли;
			
			Элементы.ТоварыМаркировки.ТолькоПросмотр = Ложь;
			Элементы.Кнопка_НайтиТоварПоРеквизитам.Доступность = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТекстСообщенияОбОшибке()
	
	ТекущиеДанные = Элементы.ТоварыДокумента.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ТекстСообщениеОбОшибке = "";
	Иначе
		ТекстСообщениеОбОшибке = ТекущиеДанные.СообщениеобОшибке;
	КонецЕсли;
	
	Элементы.ТекстРезультатПроверкиТоваров.Видимость = ЗначениеЗаполнено(ТекстСообщениеОбОшибке);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьСоообщениеОбОшибкеВСтроке(СтрокаДокумента)
	
	СтрокаДокумента.СообщениеОбОшибке = "";
	СтрокаДокумента.ИндексКартинки = -1;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДокументУчета()
	
	Если Не ПроверитьВозможностьЗаписатьДокумент() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьДокументУчетаНаСервере();
	
	Оповестить("КонтурМаркировка_ДокументУчета_Изменен", Ссылка);
	
	ОповеститьОбИзменении(Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьКодыДокументаИСохранить()
	
	ДокументУчета_СброситьКодыИСохранитьНаСервере();
	
	Модифицированность = Ложь;
	
	Оповестить("КонтурМаркировка_ДокументУчета_Изменен", Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ДокументУчета_СброситьКодыИСохранитьНаСервере()
	
	МодульОбъекта().КодыДокументов_Записать(МодульОбъекта().Новый_ТаблицаКодов(), Ссылка);
	
	ЗаписатьДокументУчетаНаСервере();
	
	НастроитьВидимостьКомандФормы();
	НастроитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЗаполнениеПолей(Знач ОписаниеДокумента = Неопределено)
	
	Если ОписаниеДокумента = Неопределено Тогда
		ОписаниеДокумента = ОписаниеДокументаПоДаннымФормы();
	КонецЕсли;
	
	ОшибкиЗаполнения = МодульОбъекта().ДокументУчета_ПроверитьЗаполнениеПолей(ОписаниеДокумента);
	МодульОбъекта().СообщитьОбОшибкахЗаполнения(ЭтаФорма, ОшибкиЗаполнения);
	
	Возврат Не ЗначениеЗаполнено(ОшибкиЗаполнения);
	
КонецФункции

&НаСервере
Процедура ЗаписатьДокументУчетаНаСервере()
	
	ОписаниеДокумента = ОписаниеДокументаПоДаннымФормы();
	
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	Попытка
		СохранитьСвязиНоменклатуры();
		СохранитьКоэффициентыПересчета();
		МодульОбъекта().ДокументУчета_Записать(ОписаниеДокумента);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Если ИзмененоОтражениеВЭДО Тогда
		ИзмененоОтражениеВЭДО = Ложь;
		МодульОбъекта().ДокументУчета_УстановитьСтатусРезультатаПроверкиКодовНеактуален(Ссылка);
	КонецЕсли;
	
	ЗаполнитьКонтекстФормы();
	
	ПроверитьТоварыМаркировки();
	
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ОписаниеДокументаПоДаннымФормы()
	
	Результат = МодульОбъекта().Новый_ДокументУчета();
	
	ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма, , "ТоварыДокумента, ТоварыМаркировки, ЭтапыМаркировки");
	ЗаполнитьЗначенияСвойств(Результат.ДопРеквизиты, ЭтаФорма);
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		ЗаполнитьЗначенияСвойств(Результат.ТоварыДокумента.Добавить(), Стр);
	КонецЦикла;
	
	Для Каждого Стр Из ТоварыМаркировки Цикл
		СтрокиДок = ТоварыДокумента.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", Стр.КлючСтрокиДокумента));
		Если ЗначениеЗаполнено(СтрокиДок) И СтрокиДок[0].НеПодлежитМаркировке = Ложь Тогда
			ЗаполнитьЗначенияСвойств(Результат.ТоварыМаркировки.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из ЭтапыМаркировки Цикл
		НоваяСтрока = Результат.ЭтапыМаркировки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр,, "СпособыВыполнения");
		НоваяСтрока.СпособыВыполнения = Стр.СпособыВыполнения.ВыгрузитьЗначения();
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверитьВозможностьЗавершитьРаботу()
	
	ЕстьОшибки = Ложь;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ОперацииПечати = МодульОбъекта().ДокументУчета_СписокОпераций(Ссылка, ТипыОпераций.ПечатьКодов);
	Если ЗначениеЗаполнено(ОперацииПечати) Тогда
		Ошибка = МодульОбъекта().Новый_ОшибкаЗаполнения("СписокОпераций");
		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо завершить операции печати'");
		МодульОбъекта().СообщитьОбОшибкахЗаполнения(ЭтаФорма, Ошибка);
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	ОписаниеДокумента = ОписаниеДокументаПоДаннымФормы();
	
	Если Не ПроверитьЗаполнениеПолей(ОписаниеДокумента) Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ПроверитьТоварыМаркировки(ОписаниеДокумента) Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если МодульОбъекта().ДокументУчета_ЕстьРольКорректировкаОтгрузки(ОписаниеДокумента)
		И Не МодульОбъекта().ДокументУчета_ПроверитьСопоставлениеКодов(Ссылка) Тогда
		Ошибка = МодульОбъекта().Новый_ОшибкаЗаполнения("КодыМаркировки");
		Ошибка.ТекстОшибки = НСтр("ru = 'Не все коды сопоставлены со строками документа. Выполните сопоставление и затем завершите работу с документом'");
		МодульОбъекта().СообщитьОбОшибкахЗаполнения(ЭтаФорма, Ошибка);
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаСервере
Функция ПроверитьТоварыМаркировки(Знач ОписаниеДокумента = Неопределено)
	
	СтатусыДокументовУчета = МодульОбъекта().Перечисление_СтатусыДокументовУчета();
	
	Если Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Новый Тогда
		Для Каждого СтрокаДокумента Из ТоварыДокумента Цикл
			ОчиститьСоообщениеОбОшибкеВСтроке(СтрокаДокумента);
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	
	Если ОписаниеДокумента = Неопределено Тогда
		ОписаниеДокумента = ОписаниеДокументаПоДаннымФормы();
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	ОшибкиGTIN = МодульОбъекта().ДокументУчета_ПроверитьТоварыМаркировки(ОписаниеДокумента);
	Для Каждого СтрокаДокумента Из ТоварыДокумента Цикл
		
		ОписаниеОшибки = МодульОбъекта().МассивСтруктур_Найти(ОшибкиGTIN, СтрокаДокумента.НомерСтроки, "НомерСтроки");
		
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			СтрокаДокумента.СообщениеОбОшибке = ОписаниеОшибки.ТекстОшибки;
			СтрокаДокумента.ИндексКартинки = 2;
			ЕстьОшибки = Истина;
		Иначе
			ОчиститьСоообщениеОбОшибкеВСтроке(СтрокаДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		МодульОбъекта().Метрика_Функциональность_ОшибкиПроверкиGTINВДокументеУчета(Организация);
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаСервере
Процедура СохранитьСвязиНоменклатуры()
	
	Для Каждого Стр Из ТоварыМаркировки Цикл
		
		Если Не Стр.ДобавленВручную Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.Товар)
			Или Не ЗначениеЗаполнено(Стр.КоличествоУпаковок) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиДокумента = ТоварыДокумента.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", Стр.КлючСтрокиДокумента));
		Если Не ЗначениеЗаполнено(СтрокиДокумента) Тогда
			Возврат;
		КонецЕсли;
		
		СтрДок = СтрокиДокумента[0];
		Если СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		МодульОбъекта().СвязьНоменклатуры_Добавить(Стр.Товар
		, СтрДок.КлючНоменклатуры1С);
		
		Стр.ДобавленВручную = Ложь;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьКоэффициентыПересчета()
	
	Для Каждого Стр Из ТоварыДокумента Цикл
		
		Если Не Стр.РучнойВводКоличества
			Или Стр.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.КоличествоУпаковок)
			Или Не ЗначениеЗаполнено(Стр.Количество) Тогда
			Продолжить;
		КонецЕсли;
		
		Числитель = Стр.КоличествоУпаковок;
		Знаменатель = Стр.Количество;
		КлючНоменклатуры1С = Стр.КлючНоменклатуры1С;
		
		МодульОбъекта().КоэффициентПересчета_Записать(КлючНоменклатуры1С, Числитель, Знаменатель);
		МодульОбъекта().Метрика_Функциональность_ЗаписьКоэффициентаПересчетаВДокументе();
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПосчитатьКоличествоСтрокТаблицФормы()
	
	КоличествоОпераций = СписокОпераций.Количество();
	КоличествоТоваровДокумента = ТоварыДокумента.Количество();
	КоличествоКодов = МодульОбъекта().КодыДокументов_ОбщееКоличествоТоварныхКодов(Ссылка);
	КоличествоАгрегатов = МодульОбъекта().КодыДокументов_ОбщееКоличествоТранспортныхУпаковок(Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКодыИзВходящегоУПД()
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
