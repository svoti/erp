	НЕОПРЕДЕЛЕНО КАК КлючКода,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(200)) КАК КодМаркировки,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(50)) КАК ЗаводскойСерийныйНомер,
	ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка) КАК Товар,
	ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка) КАК КлючНоменклатуры1С,
	ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ПустаяСсылка) КАК ОбщийТипУпаковки,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(300)) КАК СтрокаДокумента,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(50)) КАК СтатусКода,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(50)) КАК ОсобоеСостояниеКода,
	ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Контрагенты.ПустаяСсылка) КАК Владелец,
	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПечати,
	ЛОЖЬ КАК Напечатан,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(50)) КАК НомерПартии,
	-1 КАК ИндексКартинкиПроверкаРД,
	-1 КАК ИндексКартинкиПроверкаСтатуса,
	-1 КАК ИндексКартинкиПроверкаВладельца,
	-1 КАК ИндексКартинкиДопПроверка1,
	-1 КАК ИндексКартинкиДопПроверка2,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(250)) КАК ПроверкаРД,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(250)) КАК ПроверкаСтатуса,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(250)) КАК ПроверкаВладельца,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(250)) КАК ДопПроверка1,
	ВЫРАЗИТЬ(&quot;&quot; КАК Строка(250)) КАК ДопПроверка2
ИЗ
	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
ГДЕ
	КодыДокументов.ДокументУчета = &amp;ДокументУчета</queryText>
      <mainTable>InformationRegister.КонтурМаркировка_КодыДокументов</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
