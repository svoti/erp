
// #Область СлужебныеПеременныеИМетодыФормы

&НаСервере
Перем КэшМодуляОбъекта;

&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Если КэшМодуляОбъекта <> Неопределено Тогда
		Возврат КэшМодуляОбъекта;
	КонецЕсли;
	
	КэшМодуляОбъекта = ВзаимодействиеКонтурМаркировка.МодульМаркировки(Истина);
	
	Возврат КэшМодуляОбъекта;
	
КонецФункции

&НаКлиенте
Функция МодульКлиента()
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	КэшМодуляКлиента = ВзаимодействиеКонтурМаркировкаКлиент.МодульМаркировкиКлиент(Истина);
	
	Возврат КэшМодуляКлиента;
	
КонецФункции

// КонецОбласти // СлужебныеПеременныеИМетодыФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьОформлениеСпискаОрганизаций();
	ОбновитьСписокОрганизаций();
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурМаркировка_Организация_Изменен" Тогда
		ОбновитьСписокОрганизаций()
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеСпискаОрганизаций()
	
	ТаблицаФормы = Элементы.Список;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ТаблицаФормы.ПутьКДанным + "УведомлениеЗаполнитеАнкету");
	
	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаФормы.Имя + ".УведомлениеЗаполнитеАнкету");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокОрганизаций()
	
	Список.Очистить();
	
	ВсеОрганизации = МодульОбъекта().Организация_ВсеОрганизации();
	
	Для каждого Организация Из ВсеОрганизации Цикл
		Стр = Список.Добавить();
		Стр.Ссылка = Организация;
		Стр.Наименование = Строка(Организация);
		Стр.ИННКПП = СтрокаИННКПП(Организация.ИНН, Организация.КПП);
	КонецЦикла;
	
	ПоказатьУведомленияЗаполнитеАнкету();
	
КонецПроцедуры

&НаСервере
Функция СтрокаИННКПП(ИНН, КПП)
	
	Результат = "ИНН " + ИНН;
	
	Если ЗначениеЗаполнено(КПП) Тогда
		Результат = Результат + "  КПП " + КПП;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПоказатьУведомленияЗаполнитеАнкету()
	
	ТипыУведомлений = МодульОбъекта().Перечисление_ТипыУведомлений();
	ОформлениеУведомлений = МодульОбъекта().ОформлениеУведомлений();
	Оформление = ОформлениеУведомлений[ТипыУведомлений.ЗаполнитеАнкету];
	
	Для каждого Стр Из Список Цикл
		Если МодульОбъекта().НужноЗаполнитьАнкету(Стр.Ссылка) Тогда
			Стр.УведомлениеЗаполнитеАнкету = Оформление.Заголовок;
		КонецЕсли;
	КонецЦикла;
	
	Элемент = Элементы.СписокУведомлениеЗаполнитеАнкету;
	ЗаполнитьЗначенияСвойств(Элемент, Оформление);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	Элементы.Кнопка_Выбрать.Видимость = Параметры.РежимВыбора;
	Элементы.Список.РежимВыбора = Параметры.РежимВыбора;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОрганизацию(Команда)
	
	МодульКлиента().ОткрытьФормуОрганизации(Неопределено, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	
	ОбновитьСписокОрганизаций();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьОрганизацию(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(ТекДанные.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОрганизацийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекДанные = Список.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Организация = ТекДанные.Ссылка;
	
	Если Поле = Элементы.СписокУведомлениеЗаполнитеАнкету
		И ЗначениеЗаполнено(ТекДанные.УведомлениеЗаполнитеАнкету) Тогда
		МодульКлиента().ОткрытьСтраницуНастроекОрганизации(Организация);
		Возврат;
	КонецЕсли;
	
	Если Элемент.РежимВыбора Тогда
		ОповеститьОВыборе(Организация);
	Иначе
		МодульКлиента().ОткрытьФормуОрганизации(Организация, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры
