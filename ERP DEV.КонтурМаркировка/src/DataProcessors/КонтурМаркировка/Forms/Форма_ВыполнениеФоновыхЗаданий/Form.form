<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <title>
    <key>ru</key>
    <value>Выполнение фоновых заданий (Контур.Маркировка)</value>
  </title>
  <items xsi:type="form:Decoration">
    <name>НадписьРекомендуетсяОтдельныйСеанс</name>
    <id>1</id>
    <title>
      <key>ru</key>
      <value>Для выполнения фоновых заданий рекомендуется открыть отдельный сеанс (окно программы)</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>НадписьРекомендуетсяОтдельныйСеансРасширеннаяПодсказка</name>
      <id>3</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>НадписьРекомендуетсяОтдельныйСеансКонтекстноеМеню</name>
      <id>2</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <type>Label</type>
    <height>1</height>
    <autoMaxHeight>true</autoMaxHeight>
    <horizontalStretch>true</horizontalStretch>
    <extInfo xsi:type="form:LabelDecorationExtInfo">
      <horizontalAlign>Left</horizontalAlign>
      <backColor xsi:type="core:ColorDef">
        <red>255</red>
        <green>250</green>
        <blue>217</blue>
      </backColor>
    </extInfo>
  </items>
  <items xsi:type="form:Decoration">
    <name>НадписьНеПодходятУсловия</name>
    <id>13</id>
    <title>
      <key>ru</key>
      <value>&lt;fontsize 10>Выполнить фоновые задания можно только в файловой базе и платформе &lt;/>&lt;fontsize 10>версии &lt;/>&lt;fontsize 10>ниже &lt;/>&lt;fontsize 10>&lt;b>8.3.5&lt;/>&lt;/></value>
    </title>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
