    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	НЕОПРЕДЕЛЕНО КАК КлючКода,
	ВЫРАЗИТЬ(&quot;&quot; КАК СТРОКА(200)) КАК КодМаркировки,
	ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_КлючиНоменклатуры1С.ПустаяСсылка) КАК КлючНоменклатуры1С,
	ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка) КАК Товар,
	ВЫРАЗИТЬ(&quot;&quot; КАК СТРОКА(50)) КАК СтатусКода,
	ВЫРАЗИТЬ(&quot;&quot; КАК СТРОКА(50)) КАК ОсобоеСостояниеКода
ИЗ
	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
ГДЕ
	ЛОЖЬ</queryText>
      <mainTable>InformationRegister.КонтурМаркировка_КодыОпераций</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
