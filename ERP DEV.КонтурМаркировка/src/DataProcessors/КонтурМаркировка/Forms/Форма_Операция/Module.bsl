&НаКлиенте
Процедура УведомлениеОПриемке_ОтклонитьВсе(Команда)
	
	Если ОперацияОграниченаТарифом Тогда
		МодульКлиента().ОткрытьФормуОграниченияПоТарифу(ЭтаФорма, Организация, ТипОперации);
		Возврат;
	КонецЕсли;
	
	Действие = НСтр("ru = 'Отклонить все'");
	Если Не МодульКлиента().ДоступенPATCHЗапрос(Действие) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаголовокВопроса = НСтр("ru = 'Отправить отказ в приемке входящего документа?'");
	ТекстВопроса = НСтр("ru = 'Уведомление об отказе будет отправлено в ГИС МТ ""Чесный Знак""'");
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да,  "Продолжить");
	Кнопки.Добавить(КодВозвратаДиалога.Нет, "Отмена");
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("УведомлениеОПриемке_ОтклонитьВсе_ПослеСогласия", ЭтаФорма);
	
	МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, Кнопки, ЗаголовокВопроса);
	
КонецПроцедуры

