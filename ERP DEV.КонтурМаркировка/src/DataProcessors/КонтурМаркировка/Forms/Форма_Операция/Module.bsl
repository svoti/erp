	ТекущиеДанные = Элементы.Агрегаты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Стр = Агрегаты.ПолучитьЭлементы().Добавить();
	Иначе
		Стр = ТекущиеДанные.ПолучитьЭлементы().Добавить();
		Элементы.Агрегаты.Развернуть(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	
	Стр.НомерКартинки = 1;
	Стр.КоличествоАгрегатов = 1;
	Стр.ВидАгрегата = РезультатВыбора.Значение;
	
