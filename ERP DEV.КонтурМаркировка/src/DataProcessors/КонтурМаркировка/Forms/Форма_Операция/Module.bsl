&НаСервере
Процедура ЗаполнитьТоварПоКлючуНоменклатуры1С(ИдентификаторСтроки)
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Стр = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если Не ЗначениеЗаполнено(Стр.КлючНоменклатуры1С)
		И (ТипОперации = ТипыОпераций.ОтчетОНанесении
		Или ТипОперации = ТипыОпераций.ВводВОборот) Тогда
		Возврат;
	КонецЕсли;
	
	МассивТоваров = МодульОбъекта().ПодходящиеТоварыМаркировки(Стр.КлючНоменклатуры1С, Организация);
	
	Стр.Товар = Неопределено;
	Если МассивТоваров.Количество() = 1 Тогда
		Стр.Товар = МассивТоваров[0];
	КонецЕсли;
	
	ЗаполнитьСтрокуТоваровДаннымиИБ(Стр);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуТоваровДаннымиИБ(Стр)
	
	ЗаполнитьВСтрокеТоваровКодТНВЭД(Стр);
	ЗаполнитьВСтрокеТоваровВложенныйТовар(Стр);
	ЗаполнитьВСтрокеТоваровРазрешительнуюДокументацию(Стр);
	
	Стр.ЭтоКег = Неопределено;
	Стр.ТребуетсяЗСН = Неопределено;
	Стр.ПеременныйВес = Неопределено;
	Стр.ТипКодаМаркировки = Неопределено;
	Стр.ЕдиницаМаркировки = Неопределено;
	Стр.НоминальноеКоличество = Неопределено;
	Стр.СрокГодностиМеньше72Часов = Неопределено;
	Стр.ПодлежитВетеринарномуКонтролю = Неопределено;
	
	Если МодульОбъекта().Интеграция_Номенклатура1С_ЕстьАртикул() Тогда
		Стр.Артикул = МодульОбъекта().КлючНоменклатуры1С_Артикул(Стр.КлючНоменклатуры1С);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеТовара = МодульОбъекта().Товар_Прочитать(Стр.Товар);
	
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	ТипыСроковГодности = МодульОбъекта().Перечисление_ТипыСроковГодности();
	ТипыКодовМаркировки = МодульОбъекта().Перечисление_ТипыКодовМаркировки();
	
	ТоварСоСрокомГодностиМеньше72 = (ОписаниеТовара.ТипСрокаГодности = ТипыСроковГодности.СрокГодностиМеньше72);
	
	Если ОписаниеТовара.ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка Тогда
		ДопустимоУказаниеСрокаГодности = 
		МодульОбъекта().ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесенииДляКИГУ(ОписаниеТовара.ВидПродукции, ТипОтчетаОНанесении);
	ИначеЕсли ОписаниеТовара.ТипКодаМаркировки = ТипыКодовМаркировки.Набор Тогда
		ДопустимоУказаниеСрокаГодности = 
		МодульОбъекта().ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесенииДляКИН(ОписаниеТовара.ВидПродукции, ТипОтчетаОНанесении);
	Иначе
		ДопустимоУказаниеСрокаГодности = 
		МодульОбъекта().ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесении(ОписаниеТовара.ВидПродукции, ТипОтчетаОНанесении);
	КонецЕсли;
	
	ПеременноеКоличество = ОписаниеТовара.ПеременныйВес;
	ВидПродукцииТребуетУказатьКоличество = МодульОбъекта().ВидПродукцииТребуетУказанияКоличестваВОтчетеОНанесении(ВидПродукции, ТипОтчетаОНанесении);
	
	Стр.ЕдиницаМаркировки = ОписаниеТовара.ЕдиницаМаркировки;
	Стр.ЭтоКег = ОписаниеТовара.ДопРеквизиты.ЭтоКег;
	Стр.ТребуетсяЗСН = ОписаниеТовара.ДопРеквизиты.ИспользоватьЗаводскойСН;
	Стр.ПеременныйВес = ПеременноеКоличество;
	Стр.НоминальноеКоличество = ОписаниеТовара.ДопРеквизиты.НоминальноеКоличество;
	Стр.СрокГодностиМеньше72Часов = ТоварСоСрокомГодностиМеньше72;
	Стр.ТипКодаМаркировки = ОписаниеТовара.ТипКодаМаркировки;
	Стр.ТребуетсяУказатьКоличество = (ПеременноеКоличество И ВидПродукцииТребуетУказатьКоличество);
	Стр.ДопустимоУказаниеСрокаГодности = ДопустимоУказаниеСрокаГодности;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВСтрокеТоваровКодТНВЭД(Стр)
	
	Стр.КодТНВЭД = Неопределено;
	
	Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	СпособыВыпуска = МодульОбъекта().Перечисление_СпособыВыпускаТоваров();
	
	Если ТипОперации = ТипыОпераций.ФормированиеАТК Тогда
		Стр.КодТНВЭД = Стр.Товар.КодТНВЭД;
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ВводВОборот
		И МодульОбъекта().СпособВводаВОборотТребуетТНВЭД(СпособВводаВОборот) Тогда
		Стр.КодТНВЭД = Стр.Товар.КодТНВЭД;
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ЗаказКодов
		И СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка Тогда
		Стр.КодТНВЭД = Стр.Товар.КодТНВЭД;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыВложеннымиТоварами()
	
	Для Каждого Стр Из Товары Цикл
		ЗаполнитьВСтрокеТоваровВложенныйТовар(Стр);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВСтрокеТоваровВложенныйТовар(Стр)
	
	Стр.ВложенныйТовар = Неопределено;
	Стр.КоличествоКодовВложенногоТовара = Неопределено;
	
	Если Не ЗаказатьКодыДляВложенныхТоваров
		Или Не ЗначениеЗаполнено(Стр.Товар) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.Товар.ВложенныйТовар) Тогда
		Возврат;
	КонецЕсли;
	
	Стр.ВложенныйТовар = Стр.Товар.ВложенныйТовар;
	Стр.КоличествоУпаковокВложенногоТовара = Стр.КоличествоУпаковок * Стр.Товар.КоличествоВложений;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВСтрокеТоваровРазрешительнуюДокументацию(Стр)
	
	Если Не ДопускаетсяУказаниеРазрешительнойДокументации() Тогда
		Возврат;
	КонецЕсли;
	
	РазрешительнаяДокументация = РазрешительнаяДокументацияПоТовару(Стр.Товар);
	
	Стр.РазрешительнаяДокументация.ЗагрузитьЗначения(РазрешительнаяДокументация);
	
	Если Не МодульОбъекта().МассивСодержитЗначение(РазрешительнаяДокументация, Стр.РазрешительныйДокумент) Тогда
		Стр.РазрешительныйДокумент = МодульОбъекта().Товар_ОсновнойРазрешительныйДокумент(Стр.Товар);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

