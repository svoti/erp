&НаКлиенте
Процедура ДобавитьАгрегаты(Команда)
	
	Если Модифицированность Тогда
		СохранитьОперацию();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо выбрать вид продукции'");
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ВидПродукции");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВидАгрегата) Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо выбрать вид агрегата'");
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "ВидАгрегата");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КоличествоАгрегатов) Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо указать количество агрегатов'");
		МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "КоличествоАгрегатов");
		Возврат;
	КонецЕсли;
	
	СтрокиДерева = Агрегаты.ПолучитьЭлементы();
	СтрокиДерева.Очистить();
	Стр = СтрокиДерева.Добавить();
	Стр.КоличествоАгрегатов = КоличествоАгрегатов;
	Стр.ВидАгрегата = ВидАгрегата;
	
	СоздатьТранспортныеУпаковки();
	
КонецПроцедуры

