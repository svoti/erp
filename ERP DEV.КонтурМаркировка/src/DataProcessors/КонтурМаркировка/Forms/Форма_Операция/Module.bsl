Процедура Агрегаты_Создать(Команда)
	
	СоздатьАгрегаты();
	
КонецПроцедуры

&НаКлиенте
Функция СоздатьАгрегаты()
	
	Если Не АгрегатыСозданы() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Оповестить("КонтурМаркировка_КодыВДокументах_Изменен", ДокументУчета);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция АгрегатыСозданы()
	
	Если Товары.Итог("КоличествоКодов") = 0 Тогда
		ПодобратьКодыДляАгрегации();
	КонецЕсли;
	
	Результат = Ложь;
	
	Если Не СозданиеАгрегатов_ЕстьОшибки() Тогда
		СоздатьТранспортныеУпаковки();
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СоздатьТранспортныеУпаковки()
	
	Если Не ПроверитьНаличиеСерийныхНомеровДляНовыхАгрегатов() Тогда
		Возврат;
	КонецЕсли;
	
	ДеревоУпаковок = РеквизитФормыВЗначение("Агрегаты");
	
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	Попытка
		МодульОбъекта().Операция_СоздатьИЗаполнитьТранспортныеУпаковки(ДеревоУпаковок, Ссылка);
		ОсновнойСтатус = МодульОбъекта().Перечисление_СтатусыОпераций().СозданыАгрегаты;
		МодульОбъекта().СтатусыОперации_ЗаписатьОсновнойСтатус(Ссылка, ОсновнойСтатус);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	ПосчитатьКоличествоСтрокТаблицФормы();
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьКИГУ()
	
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	Попытка
		МодульОбъекта().Операция_ЗаполнитьГрупповыеУпаковки(Ссылка, ДокументУчета);
		ОсновнойСтатус = МодульОбъекта().Перечисление_СтатусыОпераций().КИГУНаполнены;
		МодульОбъекта().СтатусыОперации_ЗаписатьОсновнойСтатус(Ссылка, ОсновнойСтатус);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	МодульОбъекта().Метрика_Функциональность_ФормированиеКИГУ(Организация);
	
КонецПроцедуры

