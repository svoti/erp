Процедура УведомлениеОПриемке_ПринятьВсе(Команда)
	
	Если ОперацияОграниченаТарифом Тогда
		МодульКлиента().ОткрытьФормуОграниченияПоТарифу(ЭтаФорма, Организация, ТипОперации);
		Возврат;
	КонецЕсли;
	
	СтатусыОпераций = МодульКлиента().Перечисление_СтатусыОпераций();
	
	Если Не ПроверитьОбязательныеРеквизитыУведомленияОПриемке() Тогда
		Возврат;
	КонецЕсли;
	
	Действие = НСтр("ru = 'Принять все'");
	Если Не МодульКлиента().ДоступенPATCHЗапрос(Действие) Тогда
		Возврат;
	КонецЕсли;
	
	УведомлениеОПриемке_ПринятьВсеНаСервере();
	
	МодульКлиента().ВыполнитьОбменПоОрганизации(ЭтаФорма, Организация);
	
	ЗаполнитьКонтекстФормыИУстановитьВидимость();
	
	Оповестить("КонтурМаркировка_Операция_Изменен");
	
	Если ОсновнойСтатус <> СтатусыОпераций.ОшибкаОбработки Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

