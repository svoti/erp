&НаСервере
Процедура ЗаполнитьСпискиВыбораФормированияАТК()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ФормированиеАТК Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Элементы.ГруппаТНВЭД.СписокВыбора;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыТНВЭД.Значение КАК ГруппаТНВЭД
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК ТоварыМаркировки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ГруппыТНВЭД
	|		ПО ТоварыМаркировки.Товар = ГруппыТНВЭД.Объект
	|			И (ГруппыТНВЭД.ИмяРеквизита = ""ГруппаТНВЭД"")
	|ГДЕ
	|	ТоварыМаркировки.Ссылка = &ДокументУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппаТНВЭД УБЫВ");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	ЗначенияСписка = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ГруппаТНВЭД");
	
	// На случай если ГруппаТНВЭД заполнена в операции, а в товаре её изменили,
	// добавим текущее значение в список, чтобы корректно отобразить в операции
	Если ЗначениеЗаполнено(ГруппаТНВЭД) И ЗначенияСписка.Найти(ГруппаТНВЭД) = Неопределено Тогда
		ЗначенияСписка.Добавить(ГруппаТНВЭД);
	КонецЕсли;
	
	МодульОбъекта().ЗаполнитьСписокВыбора(СписокВыбора, ЗначенияСписка);
	
КонецПроцедуры

