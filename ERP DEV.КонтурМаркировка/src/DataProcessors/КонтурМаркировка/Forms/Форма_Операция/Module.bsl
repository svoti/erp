&НаКлиенте
Процедура ПричинаВыводаИзОборотаПриИзменении(Элемент)
	
	ДопустимыеВиды = МодульКлиента().ДопустимыеВидыПервичногоДокумента(ПричинаВыводаИзОборота);
	Если Не МодульКлиента().МассивСодержитЗначение(ДопустимыеВиды, ВидПервичногоДокумента) Тогда
		ВидПервичногоДокумента = "";
	КонецЕсли;
	
	Если ДопустимыеВиды.Количество() = 1 Тогда
		ВидПервичногоДокумента = ДопустимыеВиды[0];
	КонецЕсли;
	
	ПричинаВыводаИзОборотаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПричинаВыводаИзОборотаПриИзмененииНаСервере()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ТипОснования = МодульОбъекта().ЗначениеРеквизитаОбъектаЛок(ОперацияОснование, "ТипОперации");
	
	Если ТипОснования = ТипыОпераций.УведомлениеОСостоянииКодов Тогда
		ОписаниеОперации = ОписаниеОперацииПоКонтекстуФормы();
		МодульОбъекта().Операция_ВыводИзОборота_ЗаполнитьШапку_ПоУведомлениюОбЭкспорте(ОписаниеОперации);
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеОперации.ДопРеквизиты, "Площадка, ИННПолучателя, КодСтраныПолучателя");
	КонецЕсли;
	
	ЗаполнитьВидПервичногоДокумента();
	ОчиститьПлощадкуДляНеподходящихПричинВыводаИзОборота();
	ПерезаполнитьТаблицыОперации();
	УстановитьВидимостьПолей_ВыводИзОборота();
	
КонецПроцедуры

