&НаКлиенте
Функция ПроверитьОбязательныеРеквизитыУведомленияОПриемке(ЭтоЧастичнаяПриемка = Ложь)
	
	ТипыИсходныхОтгрузок = МодульКлиента().Перечисление_ТипыИсходныхОтгрузок();
	
	Если ТипИсходнойОтгрузки = ТипыИсходныхОтгрузок.ТрансграничнаяОтгрузкаОСУ Тогда
		Результат = ПроверитьОбязательныеРеквизитыУведомленияОПриемкеОСУ(ЭтоЧастичнаяПриемка);
	Иначе
		Результат = ПроверитьОбязательныеРеквизитыУведомленияОПриемкеПУ(ЭтоЧастичнаяПриемка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПроверитьОбязательныеРеквизитыУведомленияОПриемкеПУ(ЭтоЧастичнаяПриемка = Ложь, СтрокиДерева = Неопределено)
	
	Если СтрокиДерева = Неопределено Тогда
		СтрокиДерева = СведенияОТоварах.ПолучитьЭлементы();
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	Для Каждого Стр Из СтрокиДерева Цикл
		
		Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтатусТовараНаСверкеТребуетУказатьЦенуКодТНВЭД(Стр, ЭтоЧастичнаяПриемка) Тогда
			Если Не ЗначениеЗаполнено(Стр.КодТНВЭД) Тогда
				ШаблонОшибки = НСтр("ru = 'Необходимо указать код ТНВЭД для товара: %1'");
				ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
				МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "СведенияОТоварах");
				ЕстьОшибки = Истина;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Стр.Цена) Тогда
				ШаблонОшибки = НСтр("ru = 'Необходимо указать цену для товара: %1'");
				ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
				МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "СведенияОТоварах");
				ЕстьОшибки = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПроверитьОбязательныеРеквизитыУведомленияОПриемкеПУ(ЭтоЧастичнаяПриемка, Стр.ПолучитьЭлементы()) Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Функция ПроверитьОбязательныеРеквизитыУведомленияОПриемкеОСУ(ЭтоЧастичнаяПриемка = Ложь)
	
	СтатусыТовараНаСверке = МодульКлиента().Перечисление_СтатусыТовараНаСверке();
	
	ЕстьОшибки = Ложь;
	
	Для Каждого Стр Из СведенияОТоварах.ПолучитьЭлементы() Цикл
		
		Если Не ЗначениеЗаполнено(Стр.КодТНВЭД) Тогда
			ШаблонОшибки = НСтр("ru = 'Необходимо указать код ТНВЭД для товара: %1'");
			ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
			МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор);
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.Цена) Тогда
			ШаблонОшибки = НСтр("ru = 'Необходимо указать цену для товара: %1'");
			ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
			МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор);
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если Стр.ПеременныйВес И Не ЗначениеЗаполнено(Стр.Количество) Тогда
			ШаблонОшибки = НСтр("ru = 'Необходимо указать вес для товара: %1'");
			ТекстОшибки = МодульКлиента().ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
			МодульКлиента().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор);
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаСервере
Функция ПроверитьКоличествоКодовВиртуальныхАгрегатов(СтрокиАгрегатов)
	
	ДопустимоеКоличествоКодов = МодульОбъекта().ДопустимоеКоличествоКодовВКИТУ();
	
	Для Каждого Стр Из СтрокиАгрегатов Цикл
		
		ВложенныеСтроки = Стр.ПолучитьЭлементы();
		Если Не ЗначениеЗаполнено(ВложенныеСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоКодовВАгрегате = 0;
		Для каждого СтрВлож Из ВложенныеСтроки Цикл
			КоличествоКодовВАгрегате = КоличествоКодовВАгрегате + СтрВлож.КоличествоКодов;
		КонецЦикла;
		
		Если КоличествоКодовВАгрегате > ДопустимоеКоличествоКодов Тогда
			ТекстСообщения = НСтр("ru = 'В одном агрегате не может быть больше %1 кодов'");
			ТекстСообщения = МодульОбъекта().ПараметрыВСтроку(ТекстСообщения, ДопустимоеКоличествоКодов);
			МодульОбъекта().СообщитьПользователюЛок(ТекстСообщения, УникальныйИдентификатор);
			Возврат Ложь;
		КонецЕсли;
		
		Если Не ПроверитьКоличествоКодовВиртуальныхАгрегатов(ВложенныеСтроки) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

