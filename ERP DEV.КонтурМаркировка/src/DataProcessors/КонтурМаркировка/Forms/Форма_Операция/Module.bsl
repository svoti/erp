&НаКлиенте
Процедура УдалитьВремяСрокаГодностиВСтрокеТовара(СтрокаТовара)
	
	Если Не СтрокаТовара.СрокГодностиМеньше72Часов Тогда
		СтрокаТовара.ДатаСрокаГодности = НачалоДня(СтрокаТовара.ДатаСрокаГодности);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеПоВложеннымТоварам(Стр)
	
	ВложеныйТовар = МодульКлиента().ЗначениеРеквизитаОбъектаЛок(Стр.Товар, "ВложенныйТовар");
	КоличествоВложений = МодульКлиента().ЗначениеРеквизитаОбъектаЛок(Стр.Товар, "КоличествоВложений");
	
	Если Не ЗначениеЗаполнено(ВложеныйТовар) Тогда
		Возврат;
	КонецЕсли;
	
	Стр.ВложенныйТовар = ВложеныйТовар;
	Стр.КоличествоУпаковокВложенногоТовара = Стр.КоличествоУпаковок * КоличествоВложений;
	
КонецПроцедуры

