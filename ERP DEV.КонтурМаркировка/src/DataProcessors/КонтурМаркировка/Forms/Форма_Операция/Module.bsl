&НаСервере
Процедура ЗаполнитьВидПервичногоДокумента()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Если МодульОбъекта().ЭтоВозвратВОборот(ТипОперации) Тогда
		ДопустимыеВиды = МодульОбъекта().ДопустимыеВидыПервичныхДокументовДляВозвратаВОборот(ПричинаВозвратаВОборот);
	ИначеЕсли ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		ДопустимыеВиды = МодульОбъекта().ДопустимыеВидыПервичногоДокумента(ПричинаВыводаИзОборота);
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ДопустимыеВиды.Найти(ВидПервичногоДокумента) = Неопределено Тогда
		ВидПервичногоДокумента = "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидПервичногоДокумента) И ДопустимыеВиды.Количество() = 1 Тогда
		ВидПервичногоДокумента = ДопустимыеВиды[0];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПечатиЭтикетокПоШаблону()
	
	Если ТипОперации <> МодульОбъекта().Перечисление_ТипыОпераций().ПечатьКодов Тогда
		Возврат;
	КонецЕсли;
	
	Этикетки.Очистить();
	Этикетки.ОбластьПечати = Неопределено;
	Этикетки.КлючПараметровПечати = Неопределено;
	Этикетки.ОтображатьЗаголовки = Ложь;
	Этикетки.ОтображатьСетку = Ложь;
	Этикетки.ТолькоПросмотр = Истина;
	
	ПараметрыПечати = МодульОбъекта().Новый_ПараметрыПечатиЭтикеток();
	ПараметрыПечати.ТабличныйДокумент = Этикетки;
	
	Если ПечататьТоварныеЭтикетки Тогда
		ПараметрыПечати.ШаблоныЭтикеток.ШаблонТоварнойЭтикетки = ШаблонТоварнойЭтикетки;
	КонецЕсли;
	Если ПечататьГрупповыеЭтикетки Тогда
		ПараметрыПечати.ШаблоныЭтикеток.ШаблонГрупповойЭтикетки = ШаблонГрупповойЭтикетки;
	КонецЕсли;
	Если ПечататьЭтикеткиНаборов Тогда
		ПараметрыПечати.ШаблоныЭтикеток.ШаблонЭтикеткиНабора = ШаблонЭтикеткиНабора;
	КонецЕсли;
	Если ПечататьТранспортныеЭтикетки Тогда
		ПараметрыПечати.ШаблоныЭтикеток.ШаблонТранспортнойЭтикетки = ШаблонТранспортнойЭтикетки;
	КонецЕсли;
	
	МодульОбъекта().Этикетки_ЗаполнитьРазмерыСтраницы(ПараметрыПечати);
	
	ШиринаЭтикеткиПоШаблону = 0;
	ВысотаЭтикеткиПоШаблону = 0;
	
	ЗаполнитьРазмерЭтикетки();
	
	ШиринаЭтикеткиПоШаблону = ШиринаЭтикетки;
	ВысотаЭтикеткиПоШаблону = ВысотаЭтикетки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРазмерЭтикетки()
	
	ШиринаЭтикетки = Этикетки.ШиринаСтраницы;
	ВысотаЭтикетки = Этикетки.ВысотаСтраницы;
	
	РазмерЭтикетки = "";
	Если ЗначениеЗаполнено(ШиринаЭтикетки) Тогда
		РазмерЭтикетки = Формат(ШиринаЭтикетки, "ЧФ='Ч мм'") + " x " + Формат(ВысотаЭтикетки, "ЧФ='Ч мм'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ИмяФайлаДляСохраненияЭтикеток()
	
	Состав = "";
	Если ПечататьТоварныеЭтикетки Тогда
		Состав = Состав + "_unit";
	КонецЕсли;
	Если ПечататьГрупповыеЭтикетки Тогда
		Состав = Состав + "_group";
	КонецЕсли;
	Если ПечататьТранспортныеЭтикетки Тогда
		Состав = Состав + "_transport";
	КонецЕсли;
	
	Результат = "codes_" + Номер + "_" + Формат(Дата, "ДФ=dd-MM-yyyy") + Состав;
	
	Возврат Результат;
	
КонецФункции

