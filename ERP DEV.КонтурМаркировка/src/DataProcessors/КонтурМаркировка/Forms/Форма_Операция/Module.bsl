Процедура НастроитьЭлементыФормы_ОперацииСтрокАгрегатов()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	ПодходящиеТипы = Новый Массив;
	ПодходящиеТипы.Добавить(ТипыОпераций.РегистрацияПакетаАгрегатов);
	ПодходящиеТипы.Добавить(ТипыОпераций.РасформированиеАгрегатаВГИС);
	ПодходящиеТипы.Добавить(ТипыОпераций.НаполнениеОдногоАгрегатаНаТСД);
	ПодходящиеТипы.Добавить(ТипыОпераций.НаполнениеПакетаАгрегатовНаТСД);
	ПодходящиеТипы.Добавить(ТипыОпераций.РегистрацияОдногоАгрегатаВГИС);
	
	Если Не МодульОбъекта().МассивСодержитЗначение(ПодходящиеТипы, ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Агрегат.Видимость = (ТипОперации <> ТипыОпераций.РегистрацияПакетаАгрегатов);
	
	Если ТипОперации = ТипыОпераций.РегистрацияПакетаАгрегатов
		Или ТипОперации = ТипыОпераций.РегистрацияОдногоАгрегатаВГИС Тогда
		
		СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
		
		Элементы.КодыМаркировкиГруппаПодчиненнаяОперация.Видимость = Истина;
		
		Если ОсновнойСтатус <> СтатусыОпераций.Новый Тогда
			Элементы.ЗакладкаКодыМаркировки.Видимость = (КоличествоКодов > 0);
			Элементы.ЗакладкаКодыМаркировки.Заголовок = НСтр("ru = 'Вложенные агрегаты'");
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.РегистрацияПакетаАгрегатов Тогда
			Элементы.ЗакладкаКодыПакетаАгрегатов.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

