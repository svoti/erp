Функция ПодсказкаКорректировкаСведенийОКодах()
	
	Результат = "";
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	
	Если ТипОперации <> ТипыОпераций.КорректировкаСведенийоКодах
		Или Не ЗначениеЗаполнено(ВидКорректируемыхСведений) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыСведений = МодульКлиента().Перечисление_ВидыКорректируемыхСведений();
	Если ВидКорректируемыхСведений = ВидыСведений.ИдентификаторВСД Тогда
		Результат = НСтр("ru = 'Изменение ВСД доступно только для единиц товара в статусах"
		+ " «В обороте», «Выведен из оборота», «Списан». Коды не должны входить в состав групповой упаковки.'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ДатаПроизводства Тогда
		Результат = НСтр("ru = 'Изменение даты производства доступно для единиц товара и комплектов в статусах"
		+ " «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.СрокГодности Тогда
		Результат = НСтр("ru = 'Изменение срока годности доступно только для единиц товара в статусах"
		+ " «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ВариативныйСрокГодности Тогда
		Результат = НСтр("ru = 'Изменение вариативного срока годности доступно только для единиц товара в статусах"
		+ " «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.КодТНВЭД Тогда
		Результат = НСтр("ru = 'Изменение кода ТН ВЭД доступно только для единиц товара в статусе «В обороте»"
		+ " с любым способом выпуска товаров, кроме «Импорт в РФ». Коды не должны входить в состав групповой упаковки.'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ФактическийВес Тогда
		Результат = НСтр("ru = 'Изменение фактического веса доступно только для единиц товара в статусах"
		+ " «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.РазрешительныйДокумент Тогда
		Результат = НСтр("ru = 'Изменение данных о разрешительных документах доступно"
		+ " для единиц товара и комплектов в статусах «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ЛицензияНаНедра Тогда
		Результат = НСтр("ru = 'Изменение данных о лицензии на пользование недрами доступно только"
		+ " для единиц товара в статусах «Нанесен» и «В обороте».'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.СпособВыпускаТоваров Тогда
		Результат = НСтр("ru = 'Изменение способа выпуска товаров доступно только для единиц товара в статусах"
		+ " «Эмитирован» или «Нанесен» с ранее указанным способом выпуска «Импорт в РФ» или «Производство в РФ»."
		+ " Коды не должны входить в состав комплектов, наборов, групповых и транспортных упаковок.'");
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.НомерПартии Тогда
		Результат = НСтр("ru = 'Изменение номера партии доступно только для единиц товара.'");
	КонецЕсли;
	
	Возврат Результат;
	
