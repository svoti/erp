&НаКлиенте
Процедура ЗаполнитьТоварыПоКодуМаркировки(Команда)
	
	ЗаполнитьТоварыПоКодуМаркировкиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыПоКодуМаркировкиНаСервере()
	
	ТипыЗаказаКодов = МодульОбъекта().Перечисление_ТипыЗаказаКодов();
		
	Если Не ЗначениеЗаполнено(КлючКода) Тогда
		ТекстОшибки = НСтр("ru='Не указан код маркировки для заполнения товаров заказа'");
		МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "КодМаркировки");
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = МодульОбъекта().Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = КлючКода;
	
	МодульОбъекта().ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Если ТипЗаказаКодов = ТипыЗаказаКодов.РазделениеТовара Тогда
		
		Если ТаблицаКодов[0].ОбщийТипУпаковки <> Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
			ТекстОшибки = НСтр("ru='Разделение товара доступно только для кодов единиц товара'");
			МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "КодМаркировки");
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ТипЗаказаКодов = ТипыЗаказаКодов.РасформированиеНабора Тогда
			
		Если ТаблицаКодов[0].ОбщийТипУпаковки <> Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор Тогда
			ТекстОшибки = НСтр("ru='Маркировка товаров расформированного набора доступна только для кодов набора'");
			МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "КодМаркировки");
			Возврат;
		КонецЕсли;
		
		МодульОбъекта().ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
		Если ТаблицаКодов.Количество() = 1 Тогда
			ТекстОшибки = НСтр("ru='Не удалось заполнить товары заказа, не найдены вложенные коды набора'");
			МодульОбъекта().СообщитьПользователюЛок(ТекстОшибки, УникальныйИдентификатор, "КодМаркировки");
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ПерезаполнитьТаблицыОперации();
	
КонецПроцедуры

