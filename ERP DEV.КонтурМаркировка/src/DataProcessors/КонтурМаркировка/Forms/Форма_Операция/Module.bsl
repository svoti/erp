&НаСервере
Процедура УстановитьПодсказкуДатаПервичногоДокумента()
	
	Если Не Элементы.ГруппаОтчетОНанесенииНомерДата.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПодсказки = НСтр(
	"ru = 'Указывается номер и дата первичного учетного документа,
	|подтверждающего факт производства продукции (для произведенной в РФ продукции)'");
	
	Отображение = МодульОбъекта().Перечисление_ВариантыОтображенияПодсказки().Кнопка;
	МодульОбъекта().УстановитьПодсказку(Элементы.ДатаДокументаОтчетОНанесении, ТекстПодсказки, Отображение);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПодсказкуМод()
	
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	
	Если ВидПродукции = ВидыПродукции.Бады Тогда
		ТекстПодсказки = НСтр("ru = 'Производственная площадка из ФГИС ""ВетИС"", если товары подлежат ветеринарному контролю'");
	ИначеЕсли ВидПродукции = ВидыПродукции.Пиво Или ВидПродукции = ВидыПродукции.БезалкогольноеПиво Тогда
		ТекстПодсказки = НСтр("ru = 'Место осуществления деятельности из ЕГАИС'");
	Иначе
		ТекстПодсказки = "";
	КонецЕсли;
	
	Отображение = МодульОбъекта().Перечисление_ВариантыОтображенияПодсказки().Кнопка;
	МодульОбъекта().УстановитьПодсказку(Элементы.ПлощадкаВводВОборот, ТекстПодсказки, Отображение);
	МодульОбъекта().УстановитьПодсказку(Элементы.ПлощадкаОтчетОНанесении, ТекстПодсказки, Отображение);
	
КонецПроцедуры

