&НаСервере
Процедура ЭтаФормаУстановитьТолькоПросмотр()
	
	ЭтаФорма.ТолькоПросмотр = РежимТолькоПросмотр;
	Элементы.ЗакладкаОсновная.ТолькоПросмотр = РежимТолькоПросмотр;
	Элементы.ЗаказКодовДляСервисПровайдера.ТолькоПросмотр = РежимТолькоПросмотр;
	
	Элементы.Кнопка_ДобавитьКодАТК.Доступность = Не РежимТолькоПросмотр;
	Элементы.Кнопка_ДобавитьКодАгрегата.Доступность = Не РежимТолькоПросмотр;
	Элементы.ДобавитьКодМаркировкиЗаказаКодов.Доступность = Не РежимТолькоПросмотр;
	Элементы.ДобавитьКодМаркировкиОтчетаОНанесении.Доступность = Не РежимТолькоПросмотр;
	
	ЭтаФормаУстановитьТолькоПросмотрОФ();
	
КонецПроцедуры

&НаСервере
Процедура ЭтаФормаУстановитьТолькоПросмотрОФ()
	
	Если Не ЭтаФорма.ТолькоПросмотр
		Или МодульОбъекта().ВерсияПлатформыНиже("8.5")
		Или Не МодульОбъекта().ЭтоОбычноеПриложение() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ТолькоПросмотр = Ложь;
	
	МодульОбъекта = МодульОбъекта();
	МодульОбщегоНазначения = МодульОбъекта.МодульОбщегоНазначения();
	РеквизитыФормы = ПолучитьРеквизиты();
	
	Для Каждого Элемент Из Элементы Цикл
		
		Видимость = МодульОбщегоНазначения.СвойствоОбъекта(Элемент, "Видимость", Истина);
		Если Не Видимость Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКоманды = МодульОбщегоНазначения.СвойствоОбъекта(Элемент, "ИмяКоманды");
		ПутьКДанным = МодульОбщегоНазначения.СвойствоОбъекта(Элемент, "ПутьКДанным");
		
		Если ЗначениеЗаполнено(ИмяКоманды) Тогда
			Команда = Команды.Найти(ИмяКоманды);
			ИзменяетСохраняемыеДанные = МодульОбщегоНазначения.СвойствоОбъекта(Команда, "ИзменяетСохраняемыеДанные", Ложь);
			Если ИзменяетСохраняемыеДанные Тогда
				Элемент.Доступность = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПутьКДанным) Тогда
			ИмяРеквизита = МодульОбщегоНазначения.РазделитьСтроку(ПутьКДанным, ".")[0];
			РеквизитФормы = МодульОбъекта.МассивСтруктур_Найти(РеквизитыФормы, ИмяРеквизита, "Имя");
			СохраняемыеДанные = МодульОбщегоНазначения.СвойствоОбъекта(РеквизитФормы, "СохраняемыеДанные", Ложь);
			Если СохраняемыеДанные Тогда
				Элемент.ТолькоПросмотр = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокКодыМаркировки()
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	ТипыСтатусов = МодульОбъекта().Перечисление_ТипыСтатусов();
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	ПустаяОперация = Справочники.КонтурМаркировка_Операции.ПустаяСсылка();
	ПустойИдентификатор = МодульОбъекта().ПустойУникальныйИдентификатор();
	
	КодыМаркировки.ТекстЗапроса = ТекстЗапросаКодыМаркировки();
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПустойИдентификатор", ПустойИдентификатор);
	
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("Операция", Ссылка);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПустаяДата", '00010101');
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ПустаяОперация", ПустаяОперация);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ТипСтатуса_ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_Новый", СтатусыОпераций.Новый);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_ОперацияЗавершена", СтатусыОпераций.ОперацияЗавершена);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_ПринятЧастично", СтатусыОпераций.ПринятЧастично);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_ОшибкаОбработки", СтатусыОпераций.ОшибкаОбработки);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_НеУдалосьРаспознатьКоды", СтатусыОпераций.НеУдалосьРаспознатьКоды);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("ИмяДопРеквизитаАртикул", МодульОбъекта().Перечисление_ИменаДопРеквизитов().Артикул);
	КодыМаркировки.Параметры.УстановитьЗначениеПараметра("СтатусОперации_ОбнаруженоДублированиеВАгрегатах", СтатусыОпераций.ОбнаруженоДублированиеВАгрегатах);
	
КонецПроцедуры

