КонецФункции

&НаКлиенте
Функция СтатусТовараНаСверкеТребуетУказатьЦенуКодТНВЭД(СтрокаДЗ, ЭтоЧастичнаяПриемка)
	
	Результат = Ложь;
	
	СтатусыТовараНаСверке = МодульКлиента().Перечисление_СтатусыТовараНаСверке();
	
	Для Каждого Стр Из СтрокаДЗ.ПолучитьЭлементы() Цикл
		
		Если ЭтоЧастичнаяПриемка Тогда
			Если Стр.СтатусТовараНаСверке = СтатусыТовараНаСверке.НайденВДокументе Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		Иначе
			Если Стр.СтатусТовараНаСверке = СтатусыТовараНаСверке.НайденВДокументе
				Или Стр.СтатусТовараНаСверке = СтатусыТовараНаСверке.НеОтсканированНаСкладе Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		Если СтатусТовараНаСверкеТребуетУказатьЦенуКодТНВЭД(Стр, ЭтоЧастичнаяПриемка) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

