&НаКлиенте
Процедура Операция_Выполнить(Команда)
	
	Если Не МодульКлиента().ПроверитьУстановленнуюВерсиюМодуля() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьДоступностьОперацииПоТарифу() Тогда
		МодульКлиента().ОткрытьФормуОграниченияПоТарифу(ЭтаФорма, Организация, ТипОперации);
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульКлиента().Перечисление_СтатусыОпераций();
	
	Если ТипОперации = ТипыОпераций.АгрегацияКодов Тогда
		
		Если ОсновнойСтатус <> СтатусыОпераций.СозданыАгрегаты Тогда
			Если Не СоздатьАгрегаты() Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ЗавершитьОперацию();
		
	ИначеЕсли ТипОперации = ТипыОпераций.ПечатьКодов Тогда
		
		ТекстВопроса = НСтр("ru = 'Операция печати будет удалена, напечатать этикетки повторно будет невозможно, продолжить?'");
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("УдалитьОперациюПечати_ПослеСогласия", ЭтаФорма);
		МодульКлиента().ПоказатьДиалогВопроса(ОписаниеОбработчика, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	ИначеЕсли ТипОперации = ТипыОпераций.ФормированиеКИГУ Тогда
		
		Если ОсновнойСтатус <> СтатусыОпераций.КИГУНаполнены Тогда
			СформироватьКИГУ();
		КонецЕсли;
		
		ЗавершитьОперацию();
		
	Иначе
		
		СохранитьИСоздатьЗадачу();
		
		МодульКлиента().ВыполнитьОбменПоОрганизации(ЭтаФорма, Организация, ДокументУчета);
		
		ЗаполнитьКонтекстФормыИУстановитьВидимость();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Оповестить("КонтурМаркировка_КодыВДокументах_Изменен", ДокументУчета);
	КонецЕсли;
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	
	Если ОсновнойСтатус <> СтатусыОпераций.Новый
		И ОсновнойСтатус <> СтатусыОпераций.ОшибкаОбработки Тогда
		ПровестиОпросПользователяИЗакрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОперациюПечати_ПослеСогласия(Ответ, ДопПараметры = Неопределено) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	УдалитьОперациюНаСервере();
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Оповестить("КонтурМаркировка_КодыВДокументах_Изменен", ДокументУчета);
	КонецЕсли;
	
	ПровестиОпросПользователяИЗакрыть();
	
КонецПроцедуры

&НаСервере
Функция СформироватьВсеЭтикетки(ДоступнаПечатьШтрихкодовНаКлиенте)
	
	Этикетки.Очистить();
	
	Если Модифицированность Тогда
		СохранитьОперацию();
	КонецЕсли;
	
	ПараметрыПечати = МодульОбъекта().Этикетки_ПараметрыПечатиЭтикетокПоОперации(Ссылка);
	ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере = Не ДоступнаПечатьШтрихкодовНаКлиенте;
	ПараметрыПечати.ИспользоватьКодыОперации = Истина;
	ПараметрыПечати.ПечататьВложенныеКоды = Истина;
	ПараметрыПечати.ТабличныйДокумент = Этикетки;
	
	МодульОбъекта().Этикетки_СформироватьТаблицуЭтикеток(ПараметрыПечати);
	МодульОбъекта().Операция_ПечатьКодов_СформироватьЭтикетки(Ссылка, ПараметрыПечати);
	
	ЗаполнитьРазмерЭтикетки(); // Если шаблоны этикеток заполнили в ПМ
	
	ПараметрыКартинок = Неопределено;
	Если Не ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере Тогда
		ПараметрыКартинок = МодульОбъекта().Этикетки_ПараметрыЗаполненияКартинокШтрихкодовНаКлиенте(ПараметрыПечати);
	КонецЕсли;
	
	Возврат ПараметрыКартинок;
	
КонецФункции

&НаСервере
Функция СформироватьПорциюЭтикеток(АдресПараметровПечати, НомерПорции)
	
	Этикетки.Очистить();
	
	ПараметрыПечати = ПолучитьИзВременногоХранилища(АдресПараметровПечати);
	ТаблицаЭтикеток = ПолучитьИзВременногоХранилища(ПараметрыПечати.ТаблицаЭтикеток);
	
	ПараметрыПечатиПорции = МодульОбъекта().Новый_ПараметрыПечатиЭтикеток();
	ПараметрыПечатиПорции.ТабличныйДокумент = Этикетки;
	ЗаполнитьЗначенияСвойств(ПараметрыПечатиПорции, ПараметрыПечати, , "ТаблицаЭтикеток, ТабличныйДокумент");
	ЗаполнитьВПорцииТаблицуЭтикеток(ПараметрыПечатиПорции, НомерПорции, ТаблицаЭтикеток);
	
	Если Не ЗначениеЗаполнено(ПараметрыПечатиПорции.ТаблицаЭтикеток) Тогда
		УдалитьИзВременногоХранилища(АдресПараметровПечати);
		УдалитьИзВременногоХранилища(ПараметрыПечати.ТаблицаЭтикеток);
		Возврат Неопределено;
	КонецЕсли;
	
	МодульОбъекта().Операция_ПечатьКодов_СформироватьЭтикетки(Ссылка, ПараметрыПечатиПорции);
	
	ЗаполнитьЗначенияСвойств(ПараметрыПечати, ПараметрыПечатиПорции, , "ТаблицаЭтикеток, ТабличныйДокумент");
	ПоместитьВоВременноеХранилище(ПараметрыПечати, АдресПараметровПечати);
	
	ЗаполнитьРазмерЭтикетки(); // Если шаблоны этикеток заполнили в ПМ
	
	ПараметрыКартинок = Неопределено;
	Если Не ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере Тогда
		ПараметрыКартинок = МодульОбъекта().Этикетки_ПараметрыЗаполненияКартинокШтрихкодовНаКлиенте(ПараметрыПечатиПорции);
	КонецЕсли;
	
	Возврат ПараметрыКартинок;
	
КонецФункции

&НаСервере
Функция СформироватьПервуюПорциюЭтикеток(АдресПараметровПечати)
	
	НомерПорции = 1;
	
	Этикетки.Очистить();
	
	ПараметрыПечати = ПолучитьИзВременногоХранилища(АдресПараметровПечати);
	ТаблицаЭтикеток = ПолучитьИзВременногоХранилища(ПараметрыПечати.ТаблицаЭтикеток);
	
	УдалитьИзВременногоХранилища(АдресПараметровПечати);
	УдалитьИзВременногоХранилища(ПараметрыПечати.ТаблицаЭтикеток);
	
	ПараметрыПечати.ТабличныйДокумент = Этикетки;
	ПараметрыПечати.ТаблицаЭтикеток = ТаблицаЭтикеток;
	
	МодульОбъекта().Операция_ПечатьКодов_СформироватьЭтикетки(Ссылка, ПараметрыПечати);
	
	ЗаполнитьРазмерЭтикетки(); // Если шаблоны этикеток заполнили в ПМ
	
	ПараметрыКартинок = Неопределено;
	Если Не ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере Тогда
		ПараметрыКартинок = МодульОбъекта().Этикетки_ПараметрыЗаполненияКартинокШтрихкодовНаКлиенте(ПараметрыПечати);
	КонецЕсли;
	
	Возврат ПараметрыКартинок;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьВПорцииТаблицуЭтикеток(ПараметрыПечатиПорции, НомерПорции, ОбщаяТаблицаЭтикеток)
	
	РазмерПорции = ПараметрыПечатиПорции.РазмерПорции;
	НомерПоследЭтикетки = ПараметрыПечатиПорции.НомерПоследнейНапечатаннойЭтикетки;
	ВсегоЭтикеток = ОбщаяТаблицаЭтикеток.Количество();
	
	ИндексПоследЭтикетки = -1;
	Если ЗначениеЗаполнено(НомерПоследЭтикетки) Тогда
		ИндексПоследЭтикетки = ОбщаяТаблицаЭтикеток.Индекс(ОбщаяТаблицаЭтикеток.Найти(НомерПоследЭтикетки, "НомерЭтикеткиПоПорядку"));
	КонецЕсли;
	
	ВыбраноЭтикеток = 0;
	Для Сч = ИндексПоследЭтикетки + 1 По ВсегоЭтикеток - 1 Цикл
		
		Стр = ОбщаяТаблицаЭтикеток[Сч];
		
		ЗаполнитьЗначенияСвойств(ПараметрыПечатиПорции.ТаблицаЭтикеток.Добавить(), Стр);
		
		ПараметрыПечатиПорции.НомерПоследнейНапечатаннойЭтикетки = Стр.НомерЭтикеткиПоПорядку;
		
		ВыбраноЭтикеток = ВыбраноЭтикеток + 1;
		Если ВыбраноЭтикеток = РазмерПорции Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыПечатиЭтикетокПорциями(ДоступнаПечатьШтрихкодовНаКлиенте, ТолькоПервуюПорцию = Ложь)
	
	Если Модифицированность Тогда
		СохранитьОперацию();
	КонецЕсли;
	
	РазмерПорции = МодульОбъекта().НастройкиМодуля().КоличествоЭтикетокВОднойПорцииПоУмолчанию;
	
	ПараметрыПечати = МодульОбъекта().Этикетки_ПараметрыПечатиЭтикетокПоОперации(Ссылка);
	ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере = Не ДоступнаПечатьШтрихкодовНаКлиенте;
	ПараметрыПечати.РазмерПорции = РазмерПорции;
	ПараметрыПечати.ПечататьВложенныеКоды = Истина;
	ПараметрыПечати.ИспользоватьКодыОперации = Истина;
	
	Если ТолькоПервуюПорцию Тогда
		ПараметрыПечати.КоличествоЭтикеток = РазмерПорции;
	КонецЕсли;
	
	МодульОбъекта().Этикетки_СформироватьТаблицуЭтикеток(ПараметрыПечати);
	КоличествоЭтикеток = ПараметрыПечати.ТаблицаЭтикеток.Количество();
	
	ПараметрыПечати.ТаблицаЭтикеток = ПоместитьВоВременноеХранилище(ПараметрыПечати.ТаблицаЭтикеток, УникальныйИдентификатор);
	
	Результат = Новый Структура;
	Результат.Вставить("РазмерПорции", РазмерПорции);
	Результат.Вставить("КоличествоЭтикеток", КоличествоЭтикеток);
	Результат.Вставить("АдресПараметровПечати", ПоместитьВоВременноеХранилище(ПараметрыПечати, УникальныйИдентификатор));
	
	Возврат Результат;
	
КонецФункции

