&НаКлиенте
Процедура ТоварыКлючНоменклатуры1СНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ТоварыКлючНоменклатуры1СПослеВыбора", ЭтаФорма, Элементы.Товары.ТекущаяСтрока);
	
	МодульКлиента().ОткрытьФормуВыбораКлючаНоменклатуры1С(ОписаниеОбработчика, ТекДанные.КлючНоменклатуры1С, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКлючНоменклатуры1СПослеВыбора(РезультатВыбора, ИдентификаторСтроки) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Стр = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	Стр.КлючНоменклатуры1С = РезультатВыбора;
	
	ЗаполнитьТоварПоКлючуНоменклатуры1С(ИдентификаторСтроки);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоУпаковокПриИзменении(Элемент)
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	
	Если ТипОперации <> ТипыОпераций.ФормированиеКИГУ Тогда
		Возврат;
	КонецЕсли;
	
	Стр = Элементы.Товары.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоВложений = МодульКлиента().ЗначениеРеквизитаОбъектаЛок(Стр.Товар, "КоличествоВложений");
	Стр.КоличествоУпаковокВложенногоТовара = Стр.КоличествоУпаковок * КоличествоВложений;
	
КонецПроцедуры

