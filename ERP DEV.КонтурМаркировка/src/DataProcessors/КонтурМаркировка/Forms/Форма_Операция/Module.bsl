КонецПроцедуры

&НаСервере
Процедура ПересчитатьСрокиГодностиПоДатеПроизводстваВШапкеНаСервере()
	
	ТипыСроковГодности = МодульОбъекта().Перечисление_ТипыСроковГодности();
	ПересчитатьАльтСроки = (ТипСрокаГодности = ТипыСроковГодности.СрокГодностиБольше72СУсловием);
	
	Для Каждого Стр Из Товары Цикл
		Если Не ЗначениеЗаполнено(Стр.ДатаПроизводства) Тогда
			ПересчитатьСрокиГодностиТовара(Стр, ДатаПроизводства, ПересчитатьАльтСроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСрокиГодностиТовара(СтрокаТовара, ПарамДатаПроизводства, ПересчитатьАльтСроки)
	
	Если ТипЗнч(СтрокаТовара) = Тип("Число") Тогда
		Стр = Товары.НайтиПоИдентификатору(СтрокаТовара);
	Иначе
		Стр = СтрокаТовара;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.Товар)
		Или Не ЗначениеЗаполнено(ПарамДатаПроизводства)
		Или Не Стр.ДопустимоУказаниеСрокаГодности Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСрокаГодности = МодульОбъекта().Товар_ДатаСрокаГодности(Стр.Товар, ПарамДатаПроизводства);
	Если ЗначениеЗаполнено(ДатаСрокаГодности) Тогда
		Стр.ДатаСрокаГодности = ДатаСрокаГодности;
	КонецЕсли;
	
	Если ПересчитатьАльтСроки Тогда
		
		УсловияХранения = Стр.Товар.УсловияХранения;
		Отбор = Новый Структура("КлючСтрокиОперации", Стр.КлючСтрокиОперации);
		Для Каждого АльтСрок Из АльтернативныеСрокиГодности.НайтиСтроки(Отбор) Цикл
			Условие = УсловияХранения.Найти(АльтСрок.Тип, "Тип");
			Если Условие <> Неопределено И ЗначениеЗаполнено(Условие.СрокХранения) Тогда
				АльтСрок.ДатаСрокаГодности = ПарамДатаПроизводства + Условие.СрокХранения * МодульОбъекта().СекундВСутках();
			КонецЕсли;
		КонецЦикла;
		
		ОбновитьПризнакЗаполненияАльтернативныхСроковГодности(ЭтаФорма, Стр);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПризнакЗаполненияАльтернативныхСроковГодности(Форма, СтрТовара)
	
	АльтСроки = АльтСрокиГодностиТовара(Форма, СтрТовара.КлючСтрокиОперации);
	
	Если Не ЗначениеЗаполнено(АльтСроки) Тогда
		СтрТовара.АльтернативныйСрокГодностиЗаполнен = Ложь;
		Возврат;
	КонецЕсли;
	
	СтрТовара.АльтернативныйСрокГодностиЗаполнен = Истина;
	Для каждого Элемент Из АльтСроки Цикл
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			СтрТовара.АльтернативныйСрокГодностиЗаполнен = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СписокТиповКодовМаркировкиКИНКИГУ()
	
	Результат = Новый СписокЗначений;
	Результат.Добавить(Перечисления.КонтурМаркировка_ТипыКодовМаркировки.ГрупповаяУпаковка);
	Результат.Добавить(Перечисления.КонтурМаркировка_ТипыКодовМаркировки.Набор);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьОграничениеЗаказаКодов(ОписаниеТарифа)
	
	Результат = Ложь;
	
	Если ТипОперации <> МодульОбъекта().Перечисление_ТипыОпераций().ЗаказКодов Тогда
		Возврат Результат;
	КонецЕсли;
	
	СпособыВыпуска = МодульОбъекта().Перечисление_СпособыВыпускаТоваров();
	
	Если СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка
		Или СпособВыпускаТоваров = СпособыВыпуска.МаркировкаВнеПроизводстваИлиИмпорта Тогда
		Сервис = МодульОбъекта().Перечисление_СервисыПодписок().ЗаказКодовПеремаркировка;
		Результат = Не МодульОбъекта().СервисДоступенПоТарифу(Сервис, ОписаниеТарифа);
	Иначе
		Результат = Не МодульОбъекта().ОперацияДоступнаПоТарифу(ТипОперации, ОписаниеТарифа);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьОграничениеОтчетаОНанесении(ОписаниеТарифа)
	
	Результат = Ложь;
	
	Если ТипОперации <> МодульОбъекта().Перечисление_ТипыОпераций().ОтчетОнанесении Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЕстьКодыСоСпособомВыпускаПеремаркировка() Тогда
		Сервис = МодульОбъекта().Перечисление_СервисыПодписок().Перемаркировка;
		Если Не МодульОбъекта().СервисДоступенПоТарифу(Сервис, ОписаниеТарифа) Тогда
			Результат = Истина;
		КонецЕсли;
	Иначе
		Если Не МодульОбъекта().ОперацияДоступнаПоТарифу(ТипОперации, ОписаниеТарифа) Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОписаниеПараметровПечатиДляМетрики()
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаполненТовар", ЗначениеЗаполнено(Товар));
	Результат.Вставить("ЗаполненаНоменклатура1С", ЗначениеЗаполнено(КлючНоменклатуры1С));
	Результат.Вставить("КоличествоКодовТребуется", КоличествоКодовТребуется);
	Результат.Вставить("КоличествоКодовПодобрано", КоличествоКодов);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОчиститьПлощадкуДляНеподходящихПричинВыводаИзОборота()
	
	Если Не МодульОбъекта().ВидПродукцииДопускаетПлощадкуВВыводеИзОборота(ВидПродукции, ПричинаВыводаИзОборота) Тогда
		Площадка = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьКодыСоСтатусомВыпущен()
	
	СтатусВыпущен = МодульОбъекта().Перечисление_СтатусыКодов().Выпущен;
	
	Возврат МодульОбъекта().КодыОпераций_ЕстьКодыВСтатусе(Ссылка, СтатусВыпущен);
	
КонецФункции

&НаСервере
Функция ЕстьКодыСоСпособомВыпускаПеремаркировка()
	
	СпособВыпускаПеремаркировка = МодульОбъекта().Перечисление_СпособыВыпускаТоваров().Перемаркировка;
	
	Возврат МодульОбъекта().КодыОпераций_ЕстьКодыСоСпособамиВыпуска(Ссылка, СпособВыпускаПеремаркировка);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьВидАгрегата()
	
	Если ТипОперации <> МодульОбъекта().Перечисление_ТипыОпераций().НаполнениеАгрегатовНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидАгрегата.Организация <> Организация Тогда
		ВидАгрегата = МодульОбъекта().Организация_ОсновнойВидАгрегата(Организация);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция Новый_ПараметрыСортировкиЭтикеток()
	
	Возврат МодульОбъекта().Новый_ПараметрыСортировкиЭтикеток();
	
КонецФункции

&НаСервере
Функция РазрешительнаяДокументацияПоТовару(Товар)
	
	Результат = Новый Массив;
	
	Для Каждого Стр Из Товар.РазрешительнаяДокументация Цикл
		Если Стр.РазрешительныйДокумент.Активен Тогда
			Результат.Добавить(Стр.РазрешительныйДокумент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДопускаетсяУказаниеРазрешительнойДокументации()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ВидыСведений = МодульОбъекта().Перечисление_ВидыКорректируемыхСведений();
	
	Если ТипОперации = ТипыОпераций.ВводВОборот
		Или ТипОперации = ТипыОпераций.Перемаркировка Тогда
		Результат = МодульОбъекта().ВидПродукцииДопускаетУказаниеРазрешительнойДокументации(ВидПродукции);
	ИначеЕсли ТипОперации = ТипыОпераций.ВозвратВОборот Тогда
		Результат = МодульОбъекта().ВидПродукцииДопускаетУказаниеРазрешительнойДокументации(ВидПродукции)
					И МодульОбъекта().ПричинаВозвратаВОборотДопускаетУказаниеРазрешительнойДокументации(ПричинаВозвратаВОборот);
	ИначеЕсли ТипОперации = ТипыОпераций.КорректировкаСведенийОКодах Тогда
		Результат = (ВидКорректируемыхСведений = ВидыСведений.РазрешительныйДокумент);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #Область РедактированиеОперации

&НаКлиенте
Процедура НачатьРедактированиеОперации(Команда)
	
	НачатьРедактированиеОперацииНаСервере();
	УстановитьПодсказкуФормы();
	
КонецПроцедуры

&НаСервере
Процедура НачатьРедактированиеОперацииНаСервере()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		МодульОбъекта().ОчередьОбмена_ОтчетОНанесенииНаТСД_НачатьРедактирование(Ссылка);
	КонецЕсли;
	
	ЗаполнитьКонтекстФормы();
	УстановитьВидимостьПоСтатусу();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРедактированиеОперации(Команда)
	
	ЗавершитьРедактированиеОперацииНаСервере();
	УстановитьПодсказкуФормы();
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьРедактированиеОперацииНаСервере()
	
	СохранитьОперацию();
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		МодульОбъекта().ОчередьОбмена_ОтчетОНанесенииНаТСД_ЗавершитьРедактирование(Ссылка);
	КонецЕсли;
	
	ЗаполнитьКонтекстФормы();
	УстановитьВидимостьПоСтатусу();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПризнакОперацияОграниченаТарифом()
	
	ОперацияОграниченаТарифом = Ложь;
	
	Если Не ПроверитьДоступностьОперацииПоТарифу() Тогда
		ОперацияОграниченаТарифом = Истина;
	КонецЕсли;
	
КонецПроцедуры

