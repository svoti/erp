	СписокВыбора = Элементы.ОтражениеВЭДО.СписокВыбора;
	МодульОбъекта().ЗаполнитьСписокВыбора(СписокВыбора, МодульОбъекта().ДопустимыеОтраженияВЭДОДляПодбораКодовНаТСД());
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСписокВыбораРазрешительногоДокументаВсемиРД(Форма, Модуль)
	
	ЗначенияСписка = Новый Соответствие;
	Для каждого Стр Из Форма.Товары Цикл
		Если ЗначениеЗаполнено(Стр.РазрешительныйДокумент) Тогда
			ЗначенияСписка.Вставить(Стр.РазрешительныйДокумент, Стр.РазрешительныйДокумент);
		КонецЕсли;
	КонецЦикла;
	
	Модуль.ЗаполнитьСписокВыбора(Форма.Элементы.ТоварыРазрешительныйДокумент_ВводВОборот.СписокВыбора, ЗначенияСписка);
	Модуль.ЗаполнитьСписокВыбора(Форма.Элементы.ТоварыРазрешительныйДокумент_ВозвратВОборот.СписокВыбора, ЗначенияСписка);
	Модуль.ЗаполнитьСписокВыбора(Форма.Элементы.ТоварыРазрешительныйДокумент_Перемаркировка.СписокВыбора, ЗначенияСписка);
	Модуль.ЗаполнитьСписокВыбора(Форма.Элементы.ТоварыРазрешительныйДокумент_Корректировка.СписокВыбора, ЗначенияСписка);
	
КонецПроцедуры

&НаСервере
Функция Заголовок_ИННКПП()
	
	Если МодульОбъекта().ЭтоИП(КонтрагентИНН) Тогда
		Возврат КонтрагентИНН;
	КонецЕсли;
	
	ТекстИНН = "<ИНН>";
	Если ЗначениеЗаполнено(КонтрагентИНН) Тогда
		ТекстИНН = КонтрагентИНН;
	КонецЕсли;
	
	ТекстКПП = "<КПП>";
	Если ЗначениеЗаполнено(КонтрагентКПП) Тогда
		ТекстКПП = КонтрагентКПП;
	КонецЕсли;
	
	Результат = МодульОбъекта().ПараметрыВСтроку("%1/%2", ТекстИНН, ТекстКПП);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Заголовок_ИнформацияОДоставке()
	
	Если Не ЗначениеЗаполнено(АдресДоставки)
		И Не ЗначениеЗаполнено(КонтактныйТелефон) Тогда
		Возврат НСтр("ru = '<Информация о доставке>'");
	КонецЕсли;
	
	Результат = "";
	
	ШаблонЗаголовка = НСтр("ru = 'Адрес: %1, телефон: %2'");
	ТекстАдресДоставки = "";
	
	Если ЗначениеЗаполнено(АдресДоставки) Тогда
		ТекстАдресДоставки = АдресДоставки;
		Если СтрДлина(ТекстАдресДоставки) > 52 Тогда
			ТекстАдресДоставки = Лев(ТекстАдресДоставки, 49) + "...";
		КонецЕсли;
	КонецЕсли;
	
	Результат = МодульОбъекта().ПараметрыВСтроку(ШаблонЗаголовка, ТекстАдресДоставки, КонтактныйТелефон);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СохранитьИСоздатьЗадачу(Повторно = Ложь)
	
	СохранитьОперацию();
	
	МодульОбъекта().Задача_Создать(Ссылка);
	
	Если Повторно И ЗначениеЗаполнено(ОперацияОснование) Тогда
		ВосстановитьПодчиненные = Ложь;
		МодульОбъекта().Операция_ВосстановитьОбменСМоментаОшибки(ОперацияОснование, ВосстановитьПодчиненные);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьОперацию()
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	
	Если ОсновнойСтатус <> СтатусыОпераций.ОперацияЗавершена Тогда
		ОсновнойСтатус = СтатусыОпераций.ОперацияЗавершена;
		МодульОбъекта().СтатусыОперации_ЗаписатьОсновнойСтатус(Ссылка, ОсновнойСтатус);
	КонецЕсли;
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПодчиненнойОперацииНаУровнеСтроки(ТаблицаФормы, ВыбраннаяСтрока)
	
	ДанныеСтроки = ТаблицаФормы.ДанныеСтроки(ВыбраннаяСтрока);
	
	Если Не ЗначениеЗаполнено(ДанныеСтроки.Операция) Тогда
		Возврат;
	КонецЕсли;
	
	МодульКлиента().ОткрытьФормуОперации(ДанныеСтроки.Операция, ЭтаФорма);
	
	МодульКлиента().Метрика_Функциональность_ОткрытиеПодчиненнойОперацииСтроки(Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторПеременныхХарактеристик(СтрокаТовара)
	
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ТоварыОбновитьКоличествоПослеРедактирования", ЭтаФорма, СтрокаТовара);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Операция", Ссылка);
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("КлючСтрокиОперации", СтрокаТовара.КлючСтрокиОперации);
	ПараметрыФормы.Вставить("Товар", СтрокаТовара.Товар);
	ПараметрыФормы.Вставить("НоминальноеКоличество", СтрокаТовара.НоминальноеКоличество);
	ПараметрыФормы.Вставить("ИспользоватьНоминальноеКоличество", ИспользоватьНоминальноеКоличество);
	
	МодульКлиента().ОткрытьФормуОбработкиМодально("Форма_РедакторПеременныхХарактеристик", ЭтаФорма, ПараметрыФормы, Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыОбновитьКоличествоПослеРедактирования(НовыйОбъем, СтрокаТоваров) Экспорт
	
	Если НовыйОбъем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТоваров.Количество = НовыйОбъем;
	СохранитьОперацию();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторЗаводскихСерийныхНомеров(СтрокаТоваров)
	
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения(
	"ТоварыОбновитьДанныеЗСНПослеРедактирования", ЭтаФорма, СтрокаТоваров);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Операция", Ссылка);
	ПараметрыФормы.Вставить("Товар", СтрокаТоваров.Товар);
	ПараметрыФормы.Вставить("КлючНоменклатуры1С", СтрокаТоваров.КлючНоменклатуры1С);
	ПараметрыФормы.Вставить("КлючСтрокиОперации", СтрокаТоваров.КлючСтрокиОперации);
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	МодульКлиента().ОткрытьРедакторЗаводскихСерийныхНомеров(ЭтаФорма, ПараметрыФормы, Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыОбновитьДанныеЗСНПослеРедактирования(Успешно, СтрокаТоваров) Экспорт
	
	Если Успешно <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьКоличествоЗаводскихСерийныхНомеров();
	
	Оповестить("КонтурМаркировка_Операция_КоличествоЗСНИзменено", ДокументУчета);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторАльтСроковГодности(СтрТовара)
	
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения(
	"АльтСрокиГодностиПослеРедактирования", ЭтаФорма, СтрТовара);
	
	ДатаПроизводстваТовара = ДатаПроизводства;
	Если ЗначениеЗаполнено(СтрТовара.ДатаПроизводства) Тогда
		ДатаПроизводстваТовара = СтрТовара.ДатаПроизводства;
	КонецЕсли;
	
	АльтСрокиГодности = АльтСрокиГодностиТовара(ЭтаФорма, СтрТовара.КлючСтрокиОперации);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Товар", СтрТовара.Товар);
	ПараметрыФормы.Вставить("ДатаПроизводства", ДатаПроизводстваТовара);
	ПараметрыФормы.Вставить("АльтернативныеСрокиГодности", АльтСрокиГодности);
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	МодульКлиента().ОткрытьАльтернативныеСрокиГодности(ЭтаФорма, ПараметрыФормы, Обработчик);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция АльтСрокиГодностиТовара(Форма, КлючСтрокиОперации)
	
	Результат = Новый Соответствие;
	
	Отбор = Новый Структура("КлючСтрокиОперации", КлючСтрокиОперации);
	Для каждого Стр Из Форма.АльтернативныеСрокиГодности.НайтиСтроки(Отбор) Цикл
		Результат.Вставить(Стр.Тип, Стр.ДатаСрокаГодности);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура АльтСрокиГодностиПослеРедактирования(Результат, СтрТовара) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
	
	Отбор = Новый Структура("КлючСтрокиОперации", КлючСтрокиОперации);
	Для Каждого Стр Из АльтернативныеСрокиГодности.НайтиСтроки(Отбор) Цикл
		АльтернативныеСрокиГодности.Удалить(Стр);
	КонецЦикла;
	
	Для Каждого Элемент Из Результат Цикл
		НоваяСтрока = АльтернативныеСрокиГодности.Добавить();
		НоваяСтрока.Тип = Элемент.Ключ;
		НоваяСтрока.ДатаСрокаГодности = Элемент.Значение;
		НоваяСтрока.КлючСтрокиОперации = КлючСтрокиОперации;
	КонецЦикла;
	
	ОбновитьПризнакЗаполненияАльтернативныхСроковГодности(ЭтаФорма, СтрТовара);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьОперацию(Знач ОписаниеОперации = Неопределено, Знач ТаблицаКодов = Неопределено)
	
	Если ОписаниеОперации = Неопределено Тогда
		ОписаниеОперации = ОписаниеОперацииПоКонтекстуФормы();
	КонецЕсли;
	
	НачатьТранзакцию(МодульОбъекта().РежимУправленияБлокировкой());
	Попытка
		
		МодульОбъекта().Операция_Записать(ОписаниеОперации);
		ВерсияДанных = ОписаниеОперации.ВерсияДанных;
		Ссылка = ОписаниеОперации.Ссылка;
		
		Если ТаблицаКодов = Неопределено Тогда
			
			Если ИзмененСоставТоваров Тогда
				
				КлючиСтрокОперации = Товары.Выгрузить(, "КлючСтрокиОперации").ВыгрузитьКолонку("КлючСтрокиОперации");
				
				ТаблицаКодов = МодульОбъекта().КодыОпераций_Прочитать(Ссылка);
				КоличествоДо = ТаблицаКодов.Количество();
				МодульОбъекта().ТаблицаЗначений_УдалитьДругиеЗначения(ТаблицаКодов, "КлючСтрокиОперации", КлючиСтрокОперации);
				
				Если КоличествоДо > ТаблицаКодов.Количество() Тогда
					МодульОбъекта().КодыОпераций_Записать(ТаблицаКодов, Ссылка);
					ОбновитьСписокКодовМаркировки();
				КонецЕсли;
				
				ПосчитатьКоличествоСтрокТаблицФормы();
				
				ИзмененСоставТоваров = Ложь;
				
			КонецЕсли;
			
		Иначе
			МодульОбъекта().КодыОпераций_Записать(ТаблицаКодов, Ссылка);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ТребуетсяЗакрытьОперациюПослеРедактированияКодов(ОперацияРедактораКодов)
	
	Результат = Ложь;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если (Ссылка = ОперацияРедактораКодов
		ИЛИ Ссылка = ОперацияРедактораКодов.ОперацияОснование)
		И ТипОперации <> ТипыОпераций.ДобавлениеВАгрегат
		И ТипОперации <> ТипыОпераций.ИзъятиеИзАгрегата
		И ТипОперации <> ТипыОпераций.ДобавлениеВАТК
		И ТипОперации <> ТипыОпераций.ИзъятиеИзАТК
		И ТипОперации <> ТипыОпераций.КорректировкаСведенийОКодах Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	СохранитьОперацию();
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если ТипОперации = МодульКлиента().Перечисление_ТипыОпераций().КорректировкаСведенийОКодах Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	ИзмененСоставТоваров = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока Тогда
		ИзмененСоставТоваров = Истина;
	КонецЕсли;
	
	Если Найти(Элемент.ТекущийЭлемент.Имя, "ТоварыРазрешительныйДокумент") = 1 Тогда
		ЗаполнитьСписокВыбораРазрешительногоДокументаВсемиРД(ЭтаФорма, МодульКлиента());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ДанныеСтроки = Элемент.ДанныеСтроки(ВыбраннаяСтрока);
	
	Если Поле = Элементы.ТоварыОперация Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуПодчиненнойОперацииНаУровнеСтроки(Элемент, ВыбраннаяСтрока);
	КонецЕсли;
	
	Если ТолькоПросмотр Или Поле.ТолькоПросмотр Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ЭтоТовар = (Поле = Элементы.ТоварыТовар И ЗначениеЗаполнено(ДанныеСтроки.Товар));
		Если ЭтоТовар Тогда
			МодульКлиента().ОткрытьФормуТовара(ДанныеСтроки.Товар, ЭтаФорма);
			Возврат;
		КонецЕсли;
		
		ЭтоКлючНоменклатуры1С = (Поле = Элементы.ТоварыКлючНоменклатуры1С И ЗначениеЗаполнено(ДанныеСтроки.КлючНоменклатуры1С));
		Если ЭтоКлючНоменклатуры1С Тогда
			МодульКлиента().ОткрытьФормуКлючаНоменклатуры1С(ДанныеСтроки.КлючНоменклатуры1С, ЭтаФорма);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ТоварыРедактироватьЗначение(Поле, ДанныеСтроки, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРедактироватьЗначение(Поле, ДанныеСтроки, СтандартнаяОбработка)
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	
	Если Поле = Элементы.ТоварыКоличество И ДанныеСтроки.ТребуетсяУказатьКоличество Тогда
		СтандартнаяОбработка = Ложь;
		Если ТипОперации = ТипыОпераций.ОтчетОНанесении Тогда
			ОткрытьРедакторПеременныхХарактеристик(ДанныеСтроки);
		КонецЕсли;
	КонецЕсли;
	
	Если Поле = Элементы.ТоварыКоличествоЗСН Тогда
		СтандартнаяОбработка = Ложь;
		Если ДанныеСтроки.ТребуетсяЗСН Тогда
			ОткрытьРедакторЗаводскихСерийныхНомеров(ДанныеСтроки);
		КонецЕсли;
	КонецЕсли;
	
	Если Поле = Элементы.ТоварыКодСтраныПроизводителя Тогда
		СтандартнаяОбработка = Ложь;
		ЗначенияСписка = МодульКлиента().СписокСтранМира();
		ЗначенияСписка.Вставить(0, "00", "НЕИЗВЕСТНО");
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("Товары_ПослеВыбораКодСтраныПроизводителя", ЭтаФорма);
		МодульКлиента().ПоказатьДиалогВыбораИзСписка(ОписаниеОбработчика
			, ЗначенияСписка
			, Элементы.ТоварыКодСтраныПроизводителя
			, ЭтаФорма
			, ДанныеСтроки.КодСтраныПроизводителя);
	КонецЕсли;
	
	ЭтоАльтСрок = (Поле = Элементы.ТоварыАльтернативныйСрокГодности Или Поле = Элементы.ТоварыКорректировкаВариативныйСрокГодности);
	Если ЭтоАльтСрок И ДанныеСтроки.ДопустимоУказаниеСрокаГодности Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьРедакторАльтСроковГодности(ДанныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Товары_ПослеВыбораКодСтраныПроизводителя(РезультатВыбора, ДопПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Товары_КодСтраныПроизводителяНаСервере(РезультатВыбора.Значение);
	
КонецПроцедуры

&НаСервере
Процедура Товары_КодСтраныПроизводителяНаСервере(НовыйКодСтраныПроизводителя)
	
	ВыделенныеСтроки = Элементы.Товары.ВыделенныеСтроки;
	
	Если Не ЗначениеЗаполнено(ВыделенныеСтроки) Тогда
		ВыделенныеСтроки.Добавить(Элементы.Товары.ТекущаяСтрока);
	КонецЕсли;
	
	Для каждого Идентификатор Из ВыделенныеСтроки Цикл
		Стр = Товары.НайтиПоИдентификатору(Идентификатор);
		Стр.КодСтраныПроизводителя = НовыйКодСтраныПроизводителя;
	КонецЦикла;
	
КонецПроцедуры

