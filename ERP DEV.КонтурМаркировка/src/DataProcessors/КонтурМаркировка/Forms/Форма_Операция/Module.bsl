&НаКлиенте
Процедура ОбъемноСортовойУчетПриИзменении(Элемент)
	
	ДопустимыеПричины = МодульКлиента().ДопустимыеПричиныВыводаИзОборота(ВидПродукции, ОбъемноСортовойУчет);
	Если ДопустимыеПричины.Найти(ПричинаВыводаИзОборота) = Неопределено Тогда
		ПричинаВыводаИзОборота = Неопределено;
		ПричинаВыводаИзОборота = "";
	КонецЕсли;
	
	ДопустимыеВидыПродукции = МодульКлиента().ДопустимыеВидыПродукцииДляВыводаИзОборота(ОбъемноСортовойУчет);
	Если ДопустимыеВидыПродукции.Найти(ВидПродукции) = Неопределено Тогда
		ВидПродукции = Неопределено;
	КонецЕсли;
	
	ОбъемноСортовойУчетПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбъемноСортовойУчетПриИзмененииНаСервере()
	
	ПерезаполнитьТаблицыОперации();
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура НоминальныйОбъемВКегахПриИзменении(Элемент)
	
	ПерезаполнитьТаблицыОперации();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтражениеВЭДОПриИзменении(Элемент)
	
	ПерезаполнитьТаблицыОперации();
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьЗначенияПоУмолчаниюОперации()
	
	ОписаниеОперации = ОписаниеОперацииПоКонтекстуФормы();
	МодульОбъекта().Операция_ЗаполнитьЗначенияПоУмолчанию(ОписаниеОперации);
	СохранитьОперацию(ОписаниеОперации);
	
	ЗаполнитьКонтекстФормы();
	НастроитьКнопки();
	УстановитьУсловноеОформление();
	ЗаполнитьСпискиВыбора();
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьТаблицыОперации()
	
	ТаблицаКодов = МодульОбъекта().Новый_ТаблицаКодов();
	ОписаниеОперации = ОписаниеОперацииПоКонтекстуФормы();
	
	МодульОбъекта().Операция_ПерезаполнитьТаблицыОперации(ОписаниеОперации, ТаблицаКодов);
	
	СохранитьОперацию(ОписаниеОперации, ТаблицаКодов);
	
	ЗаполнитьКонтекстФормы();
	НастроитьКнопки();
	УстановитьУсловноеОформление();
	ЗаполнитьСпискиВыбора();
	
	ОбновитьСписокКодовМаркировки();
	
КонецПроцедуры

&НаКлиенте
Процедура Товары_ДобавитьИзВходящегоУПД(Команда)
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	СозданоТоваров = Товары_ДобавитьИзВходящегоУПДНаСервере();
	
	Если ЗначениеЗаполнено(СозданоТоваров) Тогда
		КодыВходящегоУПДПриАктивизацииСтроки(Элементы.КодыВходящегоУПД);
	КонецЕсли;
	
	ТекстСообщения = МодульКлиента().ПараметрыВСтроку(НСтр(
	"ru = 'Добавлено %1 новых товаров'"), СозданоТоваров);
	
	Сообщить(ТекстСообщения);
	
КонецПроцедуры

&НаСервере
Функция Товары_ДобавитьИзВходящегоУПДНаСервере()
	
	Возврат МодульОбъекта().Товары_ДобавитьИзВходящегоУПД(Ссылка);
	
КонецФункции

&НаКлиенте
Процедура СохранитьКодыВФайлCSV(Команда)
	
	ФорматыФайловСКодами = МодульКлиента().Перечисление_ФорматыФайловСКодами();
	СохранитьКодыВФайл(ФорматыФайловСКодами.csv);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКодыВФайлXLS(Команда)
	
	ФорматыФайловСКодами = МодульКлиента().Перечисление_ФорматыФайловСКодами();
	СохранитьКодыВФайл(ФорматыФайловСКодами.xlsx);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКодыВФайл(ФорматФайла)
	
	ТипыФайловСКодами = МодульКлиента().Перечисление_ТипыФайловСКодами();
	
	ПараметрыСохранения = МодульКлиента().Новый_ПараметрыСохраненияФайлаСКодами();
	
	ПараметрыСохранения.Ссылка = Ссылка;
	ПараметрыСохранения.ФорматФайла = ФорматФайла;
	ПараметрыСохранения.ТипФайлаСКодами = ТипыФайловСКодами.ФайлКодовОперации;
	
	МодульКлиента().СохранитьКодыВФайл(ПараметрыСохранения);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусКодыВыгружены()
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	Если ОсновнойСтатус <> СтатусыОпераций.КодыВыгружены Тогда
		ОсновнойСтатус = СтатусыОпераций.КодыВыгружены;
		МодульОбъекта().СтатусыОперации_ЗаписатьОсновнойСтатус(Ссылка, ОсновнойСтатус);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусКодыНапечатаны()
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	Если ОсновнойСтатус <> СтатусыОпераций.КодыНапечатаны Тогда
		ОсновнойСтатус = СтатусыОпераций.КодыНапечатаны;
		МодульОбъекта().СтатусыОперации_ЗаписатьОсновнойСтатус(Ссылка, ОсновнойСтатус);
		НастроитьЭлементыФормы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_ПолучитьПовторноИзТСД(Команда)
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	Коды_ПолучитьПовторноИзТСДНаСервере();
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	Оповестить("КонтурМаркировка_КодыВДокументах_Изменен", ДокументУчета);
	
	Если ОсновнойСтатус <> МодульКлиента().Перечисление_СтатусыОпераций().ОшибкаОбработки Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура Коды_ПолучитьПовторноИзТСДНаСервере()
	
	МодульОбъекта().Операция_ПолучитьПовторноКодыИзТСД(Ссылка);
	ЗаполнитьКонтекстФормыИУстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура Коды_ВозвратНаТСДНаСервере(Комментарий)
	
	СохранитьОперацию();
	
	МодульОбъекта().Операция_ВернутьКодыНаТСД(Ссылка, Комментарий);
	
	ЗаполнитьКонтекстФормыИУстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_ВернутьНаТСД(Команда)
	
	Действие = НСтр("ru = 'Вернуть наполнение на ТСД'");
	Если Не МодульКлиента().ДоступенPATCHЗапрос(Действие) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	Подсказка = НСтр("ru = 'Комментарий для сотрудника'");
	ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("Коды_ВозвратНаТСДПослеВводаКомментария", ЭтаФорма);
	МодульКлиента().ПоказатьДиалогВводаСтроки(ОписаниеОбработчика, , Подсказка, , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_Перемаркировать(Команда)
	
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	
	ОперацияПеремаркировки = МодульКлиента().Операция_Создать(ТипыОпераций.Перемаркировка, ДокументУчета, Ссылка);
	
	МодульКлиента().ОткрытьФормуОперации(ОперацияПеремаркировки, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_ОтчитатьсяОНанесении(Команда)
	
	ТипОперации = МодульКлиента().Перечисление_ТипыОпераций().ОтчетОНанесении;
	Операция = МодульКлиента().Операция_Создать(ТипОперации, ДокументУчета, Ссылка);
	МодульКлиента().ОткрытьФормуОперации(Операция, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_ВозвратНаТСДПослеВводаКомментария(Значение, Параметры) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомментарийВозвратаНаТСД = Значение;
	
	Коды_ВозвратНаТСДНаСервере(Значение);
	
	Оповестить("КонтурМаркировка_Операция_Изменен", ДокументУчета);
	
	Если ОсновнойСтатус <> МодульКлиента().Перечисление_СтатусыОпераций().ОшибкаОбработки Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_КорректироватьСведения(Команда)
	
	ТипОперации = МодульКлиента().Перечисление_ТипыОпераций().КорректировкаСведенийОКодах;
	Операция = МодульКлиента().Операция_Создать(ТипОперации, ДокументУчета, Ссылка);
	МодульКлиента().ОткрытьФормуОперации(Операция, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_ВыполнитьВводВОборот(Команда)
	
	ТипОперации = МодульКлиента().Перечисление_ТипыОпераций().ВводВОборот;
	Операция = МодульКлиента().Операция_Создать(ТипОперации, ДокументУчета, Ссылка);
	МодульКлиента().ОткрытьФормуОперации(Операция, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Коды_ВывестиИзОборота(Команда)
	
	ТипОперации = МодульКлиента().Перечисление_ТипыОпераций().ВыводИзОборота;
	Операция = МодульКлиента().Операция_Создать(ТипОперации, ДокументУчета, Ссылка);
	МодульКлиента().ОткрытьФормуОперации(Операция, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКодыИзТабличногоДокумента(Команда)
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("ЗагрузитьКодыИзТабличногоДокумента_ПослеУказанияКодов", ЭтаФорма);
	
	МодульКлиента().ОткрытьФормуЗагрузкиКодов(ЭтаФорма, Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКодыИзТабличногоДокумента_ПослеУказанияКодов(Результат, ДопПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДобавитьИзТабличногоДокумента(Результат) Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Операция", Ссылка);
		ПараметрыФормы.Вставить("ТипОперации", ТипОперации);
		
		МодульКлиента().ОткрытьФормуОбработкиМодально("Форма_РедакторКодов", ЭтаФорма, ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьИзТабличногоДокумента(Результат)
	
	Если Модифицированность Тогда
		СохранитьОперацию();
	КонецЕсли;
	
	КодыДобавлены = МодульОбъекта().КодыОпераций_ДобавитьИзТабличногоДокумента(Ссылка, Результат);
	
	Если КодыДобавлены Тогда
		ЗаполнитьКонтекстФормы();
		ОбновитьСписокКодовМаркировки();
	КонецЕсли;
	
	Возврат КодыДобавлены;
	
КонецФункции

&НаКлиенте
Процедура Коды_ОбновитьСтатусы(Команда)
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьОбновлениеСтатусовКодов();
	ОбновитьСписокКодовМаркировки();
	
КонецПроцедуры

&НаСервере
Процедура ЗапуститьОбновлениеСтатусовКодов()
	
	МодульОбъекта().ЗапуститьОбновлениеСтатусовКодовОперации(Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокКодовМаркировки()
	
	Элементы.КодыМаркировки.Обновить();
	Элементы.АгрегатыВПакете.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУчетаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МодульКлиента().ОткрытьФормуДокументаУчета(ДокументУчета, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеталиОшибкиНажатие(Элемент)
	
	Элементы.ПанельЗакладок.ТекущаяСтраница = Элементы.ЗакладкаОсновная;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПодсказкуФормы()
	
	Подсказки = Новый Массив;
	Подсказки.Добавить(ПодсказкаПередачиКодовСервисПровайдеру());
	Подсказки.Добавить(ПодсказкаРегистрацииОтчетаОНанесенииВГИС());
	Подсказки.Добавить(ПодсказкаРегистрацииОтчетаОВыбытииВГИС());
	Подсказки.Добавить(ПодсказкаАвтоматическойРегистрацииВГИС());
	Подсказки.Добавить(ПодсказкаПечати());
	Подсказки.Добавить(ПодсказкаВыполняетсяОбновлениеДанных());
	Подсказки.Добавить(ПодсказкаЗаказКодовНаборовНаОстатки());
	Подсказки.Добавить(ПодсказкаВыводИЗОборотаОСУВес());
	Подсказки.Добавить(ПодсказкаКорректировкаСведенийОКодах());
	Подсказки.Добавить(ПодсказкаАвтоподборПозицииНаТСД());
	Подсказки.Добавить(ПодсказкаУведомлениеОСостоянииКодов());
	Подсказки.Добавить(ПодсказкаОтчетОНанесенииНаТСДРЭП());
	Подсказки.Добавить(ПодсказкаЗаказКодовМаркировкаТоваровРасформированногоНабора());
	
	Разделитель = "";
	ОбщийТекстПодсказки = "";
	Для Каждого ТекстПодсказки Из Подсказки Цикл
		Если ЗначениеЗаполнено(ТекстПодсказки) Тогда
			ОбщийТекстПодсказки = ОбщийТекстПодсказки + Разделитель + ТекстПодсказки;
			Разделитель = Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ТекстПодсказки.Заголовок = ОбщийТекстПодсказки;
	Элементы.ГруппаПодсказки.Видимость = ЗначениеЗаполнено(ОбщийТекстПодсказки);
	Элементы.СсылкаПодсказки.Видимость = ЗначениеЗаполнено(ПодсказкаАвтоподборПозицииНаТСД());
	
КонецПроцедуры

&НаКлиенте
Функция ПодсказкаПечати()
	
	Результат = "";
	
	Если ТипОперации = МодульКлиента().Перечисление_ТипыОпераций().ПечатьКодов Тогда
		Результат = НСтр("ru = 'Напечатанные коды нельзя подобрать в документ учета со свободного остатка.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодсказкаПередачиКодовСервисПровайдеру()
	
	Результат = "";
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	
	Если ТипОперации = ТипыОпераций.ЗаказКодов И ЗаказКодовДляСервисПровайдера Тогда
		
		Результат = НСтр("ru = 'Коды маркировки будут переданы сервис-провайдеру.'");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			Результат = Результат + Символы.ПС + НСтр(
			"ru = 'Чтобы добавить коды в документ, необходимо сканировать их с этикеток в «Отчет о нанесении».'");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодсказкаРегистрацииОтчетаОНанесенииВГИС()
	
	Результат = "";
	ТипыОпераций = МодульКлиента().Перечисление_ТипыОпераций();
	СтатусыОпераций = МодульКлиента().Перечисление_СтатусыОпераций();
	
	Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		Результат = НСтр("ru = 'После наполнения на ТСД, отчет автоматически отправляется на регистрацию в ГИС МТ.'");
		Если ОсновнойСтатус = СтатусыОпераций.ОжиданиеЗавершенияИзменений Тогда
			Результат = НСтр("ru = 'Задание на ТСД можно продолжить наполнять,"
