&НаСервере
Функция ДопускаетсяУказаниеДатыПроизводстваВоВводеВОборот()
	
	Если Не МодульОбъекта().ВидПродукцииДопускаетДатуПроизводстваПриВводеВОборот(ВидПродукции) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	СпособыВвода = МодульОбъекта().Перечисление_СпособыВводаВОборот();
	
	Если СпособВводаВОборот = СпособыВвода.ПроизводствоРФ Тогда
		Результат = Истина;
	ИначеЕсли СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		Результат = (ВидПродукции = ВидыПродукции.Молоко);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВидПродукцииДопускаетУказаниеПлощадкиПоТипуОперации()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	
	Если ТипОперации = ТипыОпераций.ВводВОборот Тогда
		
		Результат = (ВидПродукции = ВидыПродукции.Пиво);
		
	ИначеЕсли МодульОбъекта().ЭтоОтчетОНанесении(ТипОперации) Тогда
		
		Результат = МодульОбъекта().ВидПродукцииДопускаетПлощадкуВОтчетеОНанесении(ВидПродукции, ТипОтчетаОНанесении);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		
		Результат = МодульОбъекта().ВидПродукцииДопускаетПлощадкуВВыводеИзОборота(ВидПродукции, ПричинаВыводаИзОборота);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

