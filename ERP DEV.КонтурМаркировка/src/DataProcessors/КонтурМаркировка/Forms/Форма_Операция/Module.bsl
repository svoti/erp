&НаСервере
Процедура НастроитьЭлементыФормыОФ()
	
	Если Не МодульОбъекта().ЭтоОбычноеПриложение() Тогда
		Возврат;
	КонецЕсли;
	
	Если МодульОбъекта().ВерсияПлатформыНиже("8.3") Тогда
		Элементы.СсылкаПодсказки.РастягиватьПоГоризонтали = Истина;
	Иначе
		Элементы.ТекстПодсказки.РастягиватьПоГоризонтали = Истина;
	КонецЕсли;
	
	Если Не МодульОбъекта().ВерсияПлатформыНиже("8.3") Тогда
		
		ЭлементыРД = Новый Массив;
		ЭлементыРД.Добавить(Элементы.ТоварыРазрешительныйДокумент_ВводВОборот);
		ЭлементыРД.Добавить(Элементы.ТоварыРазрешительныйДокумент_ВозвратВОборот);
		ЭлементыРД.Добавить(Элементы.ТоварыРазрешительныйДокумент_Корректировка);
		ЭлементыРД.Добавить(Элементы.ТоварыРазрешительныйДокумент_Перемаркировка);
		
		Для каждого Элемент Из ЭлементыРД Цикл
			Элемент.КнопкаСпискаВыбора = Истина;
			Элемент.УстановитьДействие("НачалоВыбораИзСписка", "ТоварыРазрешительныйДокументНачалоВыбора");
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СброситьВидимость()
	
	Элементы.ЗакладкаКодыПакетаАгрегатов.Видимость = Ложь;
	Элементы.ЗакладкаКодыМаркировки.Видимость = Ложь;
	Элементы.ЗакладкаАгрегаты.Видимость = Ложь;
	Элементы.ЗакладкаТовары.Видимость = Ложь;
	Элементы.ЗакладкаКодыВходящегоУПД.Видимость = Ложь;
	Элементы.ЗакладкаЛишниеКодыВходящегоУПД.Видимость = Ложь;
	Элементы.ЗакладкаСведенияОТоварах.Видимость = Ложь;
	Элементы.ЗакладкаПечатьЭтикеток.Видимость = Ложь;
	
	Элементы.ТоварыПодчиненнаяОперация.Видимость = Ложь;
	Элементы.КодыМаркировкиГруппаПодчиненнаяОперация.Видимость = Ложь;
	
	Элементы.Кнопка_ДобавитьТовар.Видимость = Ложь;
	Элементы.Кнопка_ПодобратьКодыДляКИГУ.Видимость = Ложь;
	Элементы.Кнопка_ЗаполнитьТоварыПоКодуМаркировки.Видимость = Ложь;
	Элементы.Кнопка_ПодобратьКоды.Видимость = Ложь;
	Элементы.Кнопка_ДобавитьАгрегат.Видимость = Ложь;
	Элементы.Кнопка_СоздатьАгрегаты.Видимость = Ложь;
	Элементы.Кнопка_ПолучитьПовторноКодыИзТСД.Видимость = Ложь;
	Элементы.Кнопка_ВернутьНаТСД.Видимость = Ложь;
	Элементы.Кнопка_НазначитьДругойТСД.Видимость = Ложь;
	Элементы.Кнопка_НапечататьЭтикетки.Видимость = Ложь;
	Элементы.Кнопка_ЗаказКодовНапечататьЭтикетки.Видимость = Ложь;
	Элементы.Кнопка_Перемаркировать.Видимость = Ложь;
	Элементы.Кнопка_ОтчитатьсяОНанесении.Видимость = Ложь;
	Элементы.ПодменюВернутьНаУстройство.Видимость = Ложь;
	Элементы.Кнопка_ЗагрузитьКодыИзТабличногоДокумента.Видимость = Ложь;
	Элементы.Кнопка_ОбновитьСтатусыКодов.Видимость = Ложь;
	Элементы.Кнопка_ДобавитьКодАТК.Видимость = Ложь;
	
	Элементы.Агрегат.Видимость = Ложь;
	Элементы.МенюСохранитьКодыВФайл.Видимость = Ложь;
	Элементы.КомментарийВозвратаНаТСД.Видимость = Ложь;
	Элементы.ОбъемноСортовойУчет.Видимость = Ложь;
	Элементы.ГруппаДобавленияАгрегатов.Видимость = Ложь;
	Элементы.ГруппаПараметрыПечати.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПоСтатусу()
	
	// BSLLS:CognitiveComplexity-off
	// BSLLS:CyclomaticComplexity-off
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	СпособыВыпуска = МодульОбъекта().Перечисление_СпособыВыпускаТоваров();
	СостоянияКодов = МодульОбъекта().Перечисление_СостоянияКодов();
	
	РежимТолькоПросмотр = Ложь;
	Элементы.Кнопка_УдалитьОперацию.Видимость = Ложь;
	Элементы.Кнопка_ВыполнитьОперацию.Видимость = Ложь;
	
	Элементы.ОписаниеОшибки.Видимость = Ложь;
	Элементы.ДеталиОшибки.Видимость = Ложь;
	Элементы.Кнопка_ПовторитьОтправкуСначала.Видимость = Ложь;
	Элементы.Кнопка_ПовторитьОбменСМоментаОшибки.Видимость = Ложь;
	Элементы.Кнопка_НачатьРедактирование.Видимость = Ложь;
	Элементы.Кнопка_ЗавершитьРедактирование.Видимость = Ложь;
	Элементы.РедакторКодовГиперссылка.Видимость = Ложь;
	Элементы.Кнопка_ОтменитьВыводИзОборота.Видимость = Ложь;
	Элементы.Кнопки_УведомлениеОПриемке.Видимость = Ложь;
	Элементы.Кнопка_ВывестиИзОборота.Видимость = Ложь;
	
	Если МодульОбъекта().УдаляемыеСтатусыОпераций().Найти(ОсновнойСтатус) <> Неопределено Тогда
		Если ОсновнойСтатус = СтатусыОпераций.Новый Тогда
			Элементы.Кнопка_УдалитьОперацию.Видимость = МодульОбъекта().ЭтоИнтерактивнаяОперация(ТипОперации);
		Иначе
			Элементы.Кнопка_УдалитьОперацию.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ОсновнойСтатус = СтатусыОпераций.Новый
		Или ОсновнойСтатус = СтатусыОпераций.ОшибкаЗаполнения Тогда
		
		Если ТипОперации <> ТипыОпераций.ПечатьКодов
			И ТипОперации <> ТипыОпераций.ОтменаВыводаИзоборота Тогда
			Элементы.Кнопка_ВыполнитьОперацию.Видимость = Истина;
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.ДобавлениеВАгрегат
			Или ТипОперации = ТипыОпераций.ИзъятиеИзАгрегата
			Или ТипОперации = ТипыОпераций.ДобавлениеВАТК 
			Или ТипОперации = ТипыОпераций.ИзъятиеИзАТК Тогда
			Элементы.РедакторКодовГиперссылка.Видимость = Истина;
		КонецЕсли;
		
	Иначе
		
		Если ТипОперации = ТипыОпераций.ПечатьКодов Тогда
			Элементы.Кнопка_ВыполнитьОперацию.Видимость = Истина;
		КонецЕсли;
		
		Если (ТипОперации = ТипыОпераций.АгрегацияКодов
			Или ТипОперации = ТипыОпераций.НаполнениеАгрегатовНаТСД)
			И ОсновнойСтатус = СтатусыОпераций.СозданыАгрегаты Тогда
			Элементы.Кнопка_ВыполнитьОперацию.Видимость = Истина;
		КонецЕсли;
		
		Если ОсновнойСтатус <> СтатусыОпераций.ОшибкаОбработки
			И ОсновнойСтатус <> СтатусыОпераций.СозданыАгрегаты
			И ТипОперации <> ТипыОпераций.ПечатьКодов Тогда
			РежимТолькоПросмотр = Истина;
		КонецЕсли;
		
		Если ОсновнойСтатус = СтатусыОпераций.ОшибкаОбработки
			Или ОсновнойСтатус = СтатусыОпераций.ОшибкаОбменаССервисом Тогда
			Элементы.ОписаниеОшибки.Видимость = Истина;
			Элементы.ДеталиОшибки.Видимость = Истина;
			Элементы.Кнопка_ПовторитьОбменСМоментаОшибки.Видимость = Истина;
		КонецЕсли;
		
		Если ОсновнойСтатус = СтатусыОпераций.ПринятЧастично Тогда
			Элементы.ОписаниеОшибки.Видимость = Истина;
			Элементы.ДеталиОшибки.Видимость = Истина;
		КонецЕсли;
		
		Если Не ОперацияПопадаетНаТСД()
			И ОсновнойСтатус = СтатусыОпераций.ОшибкаОбработки
			И Не ТипОперации = ТипыОпераций.УведомлениеОПриемке Тогда
			Элементы.Кнопка_ПовторитьОтправкуСначала.Видимость = Истина;
			Элементы.Кнопка_ПовторитьОтправкуСначала.КнопкаПоУмолчанию = Истина;
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
			
			Если ОсновнойСтатус = СтатусыОпераций.ОшибкаОбработки Тогда
				// На случай если не хватило денежных средств
				// и после пополнения счета нужно повторить отправку в ГИС МТ
				Элементы.Кнопка_ПовторитьОтправкуСначала.Видимость = Истина;
				Элементы.Кнопка_ПовторитьОтправкуСначала.КнопкаПоУмолчанию = Истина;
			КонецЕсли;
			
			Если ОсновнойСтатус = СтатусыОпераций.ОтправленНаТСД Тогда
				Элементы.Кнопка_НачатьРедактирование.Видимость = Истина;
			КонецЕсли;
			
			Если ОсновнойСтатус = СтатусыОпераций.ОжиданиеЗавершенияИзменений Тогда
				
				Элементы.Кнопка_ЗавершитьРедактирование.Видимость = Истина;
				
				РежимТолькоПросмотр = Ложь;
				
				Элементы.ГруппаВерхЛево.ТолькоПросмотр = Истина;
				Элементы.ЗакладкаОсновная.ТолькоПросмотр = Истина;
				Элементы.ВидПродукцииОтчетОНанесении.ТолькоПросмотр = Истина;
				Элементы.ТоварыТовар.ТолькоПросмотр = Истина;
				Элементы.ТоварыКлючНоменклатуры1С.ТолькоПросмотр = Истина;
				Элементы.ТоварыКоличествоУпаковок.ТолькоПросмотр = Истина;
				Элементы.ТоварыКоличествоКодов.ТолькоПросмотр = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если МодульОбъекта().ЭтоОтчетОНанесении(ТипОперации)
			И ОсновнойСтатус = СтатусыОпераций.ОперацияЗавершена Тогда
			Элементы.Кнопка_ВвестиВОборот.Видимость = Истина;
			Элементы.Кнопка_КорректироватьСведенияОКодах.Видимость = МодульОбъекта().ВидПродукцииДопускаетКорректировкуСведенийОКодах(ВидПродукции);
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.ВводВОборот Тогда
			Если ОсновнойСтатус = СтатусыОпераций.ОперацияЗавершена Тогда
				Элементы.Кнопка_КорректироватьСведенияОКодах.Видимость = МодульОбъекта().ВидПродукцииДопускаетКорректировкуСведенийОКодах(ВидПродукции);
			КонецЕсли;
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
			Если ОсновнойСтатус = СтатусыОпераций.ОшибкаОбработки Тогда
				РежимТолькоПросмотр = Истина;
				Элементы.Кнопка_ВернутьНаТСД.Видимость = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.НаполнениеКИГУНаТСД Тогда
			Если ОсновнойСтатус = СтатусыОпераций.ОшибкаОбработки Тогда
				РежимТолькоПросмотр = Истина;
				Элементы.Кнопка_ВернутьНаТСД.Видимость = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.ВыводИзОборота
			И ОсновнойСтатус = СтатусыОпераций.ОперацияЗавершена Тогда
			Если МодульОбъекта().ВидПродукцииДопускаетОтменуВыводаИзОборота(ВидПродукции, ОбъемноСортовойУчет) Тогда
				Элементы.Кнопка_ОтменитьВыводИзОборота.Видимость = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.ЗаказКодов
			И ОсновнойСтатус = СтатусыОпераций.ОперацияЗавершена
			И Не ЗначениеЗаполнено(ДокументУчета) Тогда
			
			Если СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка Тогда
				Элементы.Кнопка_Перемаркировать.Видимость = Истина;
				Элементы.Кнопка_ОбновитьСтатусыКодов.Видимость = Истина;
				Элементы.КодыМаркировки.ТолькоПросмотр = Истина;
			КонецЕсли;
			
			Если МодульОбъекта().ВидПродукцииПоддерживаетОтчетОНанесении(ВидПродукции) Тогда
				Если ЗначениеЗаполнено(ТипЗаказаКодов)
					Или СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка Тогда
					Элементы.Кнопка_ОтчитатьсяОНанесении.Видимость = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ОсновнойСтатус = СтатусыОпераций.НеУдалосьРаспознатьКоды
			Или ОсновнойСтатус = СтатусыОпераций.ОбнаруженоДублированиеВАгрегатах Тогда
			Элементы.РедакторКодовГиперссылка.Заголовок = НСтр("ru = 'Редактировать коды с ошибками'");
			Элементы.РедакторКодовГиперссылка.Видимость = Истина;
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.УведомлениеОПриемке Тогда
			РазрешеноИзменятьДокумент = СтатусУведомленияОПриемкеДопускаетИзменениеДокумента();
			Элементы.Кнопки_УведомлениеОПриемке.Видимость = РазрешеноИзменятьДокумент;
			Элементы.СведенияОТоварах.ТолькоПросмотр = Не РазрешеноИзменятьДокумент;
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.ПодборКодовНаТСД
			Или ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
			РежимТолькоПросмотр = Истина;
			Элементы.ПодборСПомощьюМобильногоУстройства.ТолькоПросмотр = Истина;
			Элементы.МобильноеУстройство.ТолькоПросмотр = Истина;
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.УведомлениеОСостоянииКодов
			И ОсновнойСтатус = СтатусыОпераций.ОперацияЗавершена Тогда
			РежимТолькоПросмотр = Истина;
			Элементы.Кнопка_ИзменитьСостояниеКодов.Видимость = Истина;
			Если СостояниеКодов = СостоянияКодов.ОтгрузкаНаЭкспорт Тогда
				Элементы.Кнопка_ВывестиИзОборота.Видимость = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.ФормированиеКИГУ
			И ОсновнойСтатус = СтатусыОпераций.ОперацияЗавершена Тогда
			РежимТолькоПросмотр = Истина;
			Элементы.ТоварыКоличествоКодовВложенногоТовара.Видимость = Ложь;
			Элементы.Кнопка_ПодобратьКодыДляКИГУ.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтаФормаУстановитьТолькоПросмотр();
	
	// BSLLS:CyclomaticComplexity-on
	// BSLLS:CognitiveComplexity-on
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолей_ВыводИзОборота()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ВыводИзОборота Тогда
		Возврат;
	КонецЕсли;

	Если МодульОбъекта().ВидПродукцииПоддерживаетВыводИзОборотаПоОСУ(ВидПродукции) Тогда
		Элементы.ОбъемноСортовойУчет.Видимость = Истина;
	Иначе
		Элементы.ОбъемноСортовойУчет.Видимость = Ложь;
	КонецЕсли;
	
	Если ОбъемноСортовойУчет Тогда
		Элементы.ТоварыЦена.Заголовок = "Общая стоимость с НДС, руб";
	Иначе
		Элементы.ТоварыЦена.Заголовок = "Цена, руб";
	КонецЕсли;
	Элементы.ТоварыВес.Видимость = ОбъемноСортовойУчет;
	Элементы.ТоварыВес.ОграничениеТипа = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(9, 3));
	
	ВидыДокументов = МодульОбъекта().Перечисление_ВидыПервичныхДокументов();
	ПричиныВывода = МодульОбъекта().Перечисление_ПричиныВыводаИзОборота();
	
	ЕстьИННПолучателя = ЗначениеЗаполнено(ИННПолучателя);
	ТребуетсяЦена = МодульОбъекта().ПричинаВыводаИзОборотаТребуетУказатьЦену(ПричинаВыводаИзОборота, ЕстьИННПолучателя);
	ДопускаетсяЦена = МодульОбъекта().ПричинаВыводаИзОборотаДопускаетУказаниеЦены(ПричинаВыводаИзОборота);
	
	ТребуетсяПервичныйДокумент = МодульОбъекта().ПричинаВыводаИзОборотаТребуетПервичныйДокумент(ПричинаВыводаИзОборота);
	ДопускаетсяПервичныйДокумент = МодульОбъекта().ПричинаВыводаИзОборотаДопускаетПервичныйДокумент(ПричинаВыводаИзОборота);
	
	ТребуетсяИННПолучателя = МодульОбъекта().ПричинаВыводаИзОборотаТребуетИННПолучателя(ПричинаВыводаИзОборота);
	ДопускаетсяИННПолучателя = МодульОбъекта().ПричинаВыводаИзОборотаДопускаетИННПолучателя(ПричинаВыводаИзОборота);
	
	ПоказатьЦену = (ТребуетсяЦена Или ДопускаетсяЦена);
	ПоказатьГосКонтракт = (ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоГосКонтракту
		Или ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоСделкеСГосударственнойТайной);
	ПоказатьНаименованиеПричины = (ПричинаВыводаИзОборота = ПричиныВывода.Прочее);
	ПоказатьПервичныйДокумент = (ТребуетсяПервичныйДокумент Или ДопускаетсяПервичныйДокумент);
	ПоказатьНаименованиеДокумента = (ПоказатьПервичныйДокумент И ВидПервичногоДокумента = ВидыДокументов.Прочее);
	ПоказатьКодСтраныПолучателя = (ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЕАЭС);
	ПоказатьИННПолучателя = (ТребуетсяИННПолучателя Или ДопускаетсяИННПолучателя);
	ПоказатьНомерПартии = ОбъемноСортовойУчет И МодульОбъекта().ВидПродукцииПоддерживаетПартионныйУчет(ВидПродукции);
	
	Элементы.ТоварыЦена.Видимость = ПоказатьЦену;
	Элементы.ВидПервичногоДокумента.Видимость = ПоказатьПервичныйДокумент;
	Элементы.НомерДокументаВыводаИзОборота.Видимость = ПоказатьПервичныйДокумент;
	Элементы.ДатаДокументаВыводаИзОборота.Видимость = ПоказатьПервичныйДокумент;
	Элементы.НаименованиеПервичногоДокумента.Видимость = ПоказатьНаименованиеДокумента;
	Элементы.НаименованиеПричиныВыводаИзОборота.Видимость = ПоказатьНаименованиеПричины;
	Элементы.ИдентификаторГосКонтрактаВыводИзОборота.Видимость = ПоказатьГосКонтракт;
	Элементы.КодСтраныПолучателяВыводИзОборота.Видимость = ПоказатьКодСтраныПолучателя;
	Элементы.ИННПолучателяВыводИзОборота.Видимость = ПоказатьИННПолучателя;
	
	Элементы.ПлощадкаВыводИзОборота.Видимость = ВидПродукцииДопускаетУказаниеПлощадкиПоТипуОперации();
	
	Элемент = Элементы.ВидПервичногоДокумента;
	Элемент.АвтоОтметкаНезаполненного = ТребуетсяПервичныйДокумент;
	Элемент.ОтметкаНезаполненного = Элемент.АвтоОтметкаНезаполненного И Не ЗначениеЗаполнено(ВидПервичногоДокумента);
	
	Элемент = Элементы.НомерДокументаВыводаИзОборота;
	Элемент.АвтоОтметкаНезаполненного = ЗначениеЗаполнено(ВидПервичногоДокумента);
	Элемент.ОтметкаНезаполненного = Элемент.АвтоОтметкаНезаполненного И Не ЗначениеЗаполнено(НомерДокумента);
	
	Элемент = Элементы.ДатаДокументаВыводаИзОборота;
	Элемент.АвтоОтметкаНезаполненного = ЗначениеЗаполнено(ВидПервичногоДокумента);
	Элемент.ОтметкаНезаполненного = Элемент.АвтоОтметкаНезаполненного И Не ЗначениеЗаполнено(ДатаДокумента);
	
	Элемент = Элементы.ИННПолучателяВыводИзОборота;
	Элемент.АвтоОтметкаНезаполненного = ТребуетсяИННПолучателя;
	Элемент.ОтметкаНезаполненного = Элемент.АвтоОтметкаНезаполненного И Не ЗначениеЗаполнено(ИННПолучателя);
	
	Элементы.ТоварыЦена.АвтоОтметкаНезаполненного = ТребуетсяЦена;
	
	Элементы.НомерПартииВыводИзОборота.Видимость = ПоказатьНомерПартии;
	Элементы.ТоварыНомерПартииВыводИзОборота.Видимость = ПоказатьНомерПартии;
	
	УстановитьПодсказкуНомераДекларации();
	УстановитьПодсказкуИдентификатораГосКонтракта();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолей_ВводВОборот()

	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ВводВОборот Тогда
		Возврат;
	КонецЕсли;
	
	ТипыЗаказов = МодульОбъекта().Перечисление_ТипыПроизводственныхЗаказов();
	СпособыВвода = МодульОбъекта().Перечисление_СпособыВводаВОборот();
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	
	ЭтоИмпорт = (СпособВводаВОборот = СпособыВвода.Импорт);
	ЭтоОстатки = (СпособВводаВОборот = СпособыВвода.Остатки);
	ЭтоИмпортФТС = (СпособВводаВОборот = СпособыВвода.ИмпортФТС);
	ЭтоТрансгран = (СпособВводаВОборот = СпособыВвода.Трансгран);
	ЭтоПроизводствоРФ = (СпособВводаВОборот = СпособыВвода.ПроизводствоРФ);
	ЭтоПроизводствоЕАЭС = (СпособВводаВОборот = СпособыВвода.ПроизводствоЕАЭС);
	ЭтоВводВОборотСПричиной = (СпособВводаВОборот = СпособыВвода.СПричиной);
	
	ПоказатьРазрешение = Не ЭтоОстатки И Не ЭтоИмпортФТС;
	ПоказатьИННСобственника = ЭтоПроизводствоРФ И (ТипПроизводственногоЗаказа = ТипыЗаказов.КонтрактноеПроизводство);
	ПоказатьЛицензиюНаНедра = МодульОбъекта().ВидПродукцииТребуетЛицензиюНаНедра(ВидПродукции, СпособВводаВОборот);
	ПоказатьПлощадку = (ЭтоТрансгран Или ЭтоИмпортФТС) И ВидПродукцииДопускаетУказаниеПлощадкиПоТипуОперации();
	ПоказатьДатуПроизводства = ДопускаетсяУказаниеДатыПроизводстваВоВводеВОборот();
	ПоказатьНеОблагаетсяНДС = ЭтоТрансгран И МодульОбъекта().ВидПродукцииТребуетСуммуНДСПриВводеВОборот(ВидПродукции);
	ПоказатьКолонкиЗакрытогоСегмента = ЭтоИмпортФТС И ТоварыЗакрытогоСегмента;
	
	ДопустимВетКонтроль = Ложь;
	ВТоварахЕстьВетКонтроль = Ложь;
	Если МодульОбъекта().ВидПродукцииПоддерживаетВСД(ВидПродукции) Тогда
		ДопустимВетКонтроль = (ЭтоПроизводствоРФ Или ЭтоТрансгран Или ЭтоИмпорт Или ЭтоИмпортФТС);
		ВТоварахЕстьВетКонтроль = Товары_ЕстьВетеринарныйКонтроль();
	КонецЕсли;
	
	Элементы.СобственникТовараИННВводВОборот.Видимость = ПоказатьИННСобственника;
	Элементы.ПроизводительИНН.Видимость = ПоказатьИННСобственника;
	Элементы.ТипУчастникаВводящегоВОборот.Видимость = ПоказатьИННСобственника;
	Элементы.НеОблагаетсяНДС.Видимость = ПоказатьНеОблагаетсяНДС;
	
	Элементы.ВводВОборот_Импорт.Видимость = ЭтоИмпорт Или ЭтоИмпортФТС;
	Элементы.ВводВОборот_ПроизводствоРФ.Видимость = ЭтоПроизводствоРФ;
	Элементы.ВводВОборот_Трансгран.Видимость = ЭтоТрансгран Или ЭтоПроизводствоЕАЭС;
	Элементы.ВводВОборот_СПричиной.Видимость = ЭтоВводВОборотСПричиной;
	
	Элементы.КодТаможни.Видимость = ЭтоИмпорт;
	Элементы.ПринятоеРешение.Видимость = ЭтоИмпорт;
	
	Элементы.ТоварыЗакрытогоСегмента.Видимость = ЭтоИмпортФТС;
	
	Элементы.ТоварыКодТНВЭД.Видимость = ПоказатьРазрешение Или ПоказатьКолонкиЗакрытогоСегмента;
	Элементы.ТоварыКодСтраныПроизводителя.Видимость = ПоказатьКолонкиЗакрытогоСегмента;
	Элементы.ТоварыГруппаВводВОборотПоля.Видимость = ПоказатьРазрешение;
	Элементы.ТоварыГруппаЛицензияНаНедра.Видимость = ПоказатьЛицензиюНаНедра;
	
	Элементы.ТоварыЦенаТрансгран.Видимость = ЭтоТрансгран;
	Элементы.ТоварыСуммаНДС.Видимость = ЭтоТрансгран;
	
	Элементы.ТоварыДатаПроизводства.Видимость = ПоказатьДатуПроизводства;
	Элементы.ДатаПроизводства.Видимость = ПоказатьДатуПроизводства;
	
	Элементы.ИдентификаторВСД.Видимость = ДопустимВетКонтроль Или ЭтоПроизводствоЕАЭС;
	Элементы.ТоварыИдентификаторВСД.Видимость = ДопустимВетКонтроль Или ВТоварахЕстьВетКонтроль;
	
	Элементы.ПлощадкаВводВОборот.Видимость = ПоказатьПлощадку;
	
	Элементы.ТоварыСуммаАкциза.Видимость = ЭтоТрансгран И (ВидПродукции = ВидыПродукции.Пиво);
	
	Элементы.ТоварыРазрешительныйДокумент_ВводВОборот.Видимость =  ЭтоИмпортФТС Или ДопускаетсяУказаниеРазрешительнойДокументации();
	
	УстановитьПодсказкуМод();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолей_ОтчетОНанесении()
	
	Если Не МодульОбъекта().ЭтоОтчетОНанесении(ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	ТипыОтчетаОНанесении = МодульОбъекта().Перечисление_ТипыОтчетаОНанесении();
	
	ЭтоМаркировкаТоваровРасформированногоНабора = (ТипОтчетаОНанесении = ТипыОтчетаОНанесении.РасформированиеНабора);
	ЭтоРазделениеТовара = (ТипОтчетаОНанесении = ТипыОтчетаОНанесении.РазделениеТовара);
	
	ПоказатьПлощадку = ВидПродукцииДопускаетУказаниеПлощадкиПоТипуОперации();
	ПоказатьСрокГодности = ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесении();
	ПоказатьДатуПроизводства = МодульОбъекта().ВидПродукцииДопускаетДатуПроизводстваВОтчетеОНанесении(ВидПродукции, ТипОтчетаОНанесении);
	ПоказатьНомерПартии = МодульОбъекта().ВидПродукцииДопускаетНомерПартииВОтчетеОНанесении(ВидПродукции);
	ПоказатьНомерСерии = МодульОбъекта().ВидПродукцииДопускаетНомерСерииВОтчетеОНанесении(ВидПродукции);
	ПоказатьЗСН = Товары_ТребуютсяЗаводскиеСерийныеНомера();
	ПоказатьТипСрокаГодности = МодульОбъекта().ВидПродукцииТребуетУказатьТипСрокаГодности(ВидПродукции);
	ПоказатьСодержаниеСпирта = МодульОбъекта().ВидПродукцииДопускаетУказаниеФактическогоСодержанияСпирта(ВидПродукции, ТипОтчетаОНанесении);
	ПоказатьНомерИДатуПервичногоДокумента = МодульОбъекта().ВидПродукцииДопускаетУказаниеНомераИДатыДокументаВОтчетеОНанесении(ВидПродукции);
	ПоказатьКоличество = МодульОбъекта().ВидПродукцииПоддерживаетКоличествоВСтруктуреКодаОтчетаОНанесении(ВидПродукции, ТипОтчетаОНанесении);
	ПоказатьИспользоватьНоминальноеКоличество = ПоказатьКоличество И МодульОбъекта().ВидПродукцииПоддерживаетНоминальноеКоличество(ВидПродукции);
	ПоказатьРезервированиеПартий = МодульОбъекта().ВидПродукцииДопускаетРезервированиеПартийВОтчетеОНанесении(ВидПродукции);
	ПоказатьТипОтчета = МодульОбъекта().ВидПродукцииДопускаетУказаниеТипаОтчетаОНанесении(ВидПродукции);
	ПоказатьКодМаркировки = (ЭтоМаркировкаТоваровРасформированногоНабора Или ЭтоРазделениеТовара);
	
	Элементы.ТоварыДатаСрокаГодности.Видимость = ПоказатьСрокГодности;
	Элементы.ДатаПроизводстваОтчетОНанесении.Видимость = ПоказатьДатуПроизводства;
	Элементы.ТоварыДатаПроизводстваОтчетОНанесении.Видимость = ПоказатьДатуПроизводства;
	Элементы.ПлощадкаОтчетОНанесении.Видимость = ПоказатьПлощадку;
	Элементы.НомерПартииОтчетОНанесении.Видимость = ПоказатьНомерПартии;
	Элементы.НомерСерииОтчетОНанесении.Видимость = ПоказатьНомерСерии;
	Элементы.ТоварыНомерПартии.Видимость = ПоказатьНомерПартии;
	Элементы.ТоварыНомерСерии.Видимость = ПоказатьНомерСерии;
	Элементы.ТипСрокаГодности.Видимость = ПоказатьТипСрокаГодности;
	Элементы.ТоварыАльтернативныйСрокГодности.Видимость = Ложь;
	
	Элементы.ИспользоватьНоминальноеКоличество.Видимость = ПоказатьИспользоватьНоминальноеКоличество;
	Элементы.ТоварыКоличество.Видимость = ПоказатьКоличество;
	Элементы.ТоварыКоличество.ТолькоПросмотр = ПоказатьКоличество;
	
	Если ПоказатьКоличество Тогда
		Если ТипОперации = ТипыОпераций.ОтчетОНанесении Тогда
			Элементы.ТоварыКоличество.ГиперссылкаЯчейки = Истина;
			Элементы.ТоварыКоличество.ЦветТекста = МодульОбъекта().ЦветГиперСсылки();
		КонецЕсли;
	Иначе
		Элементы.ТоварыКоличество.ГиперссылкаЯчейки = Ложь;
		Элементы.ТоварыКоличество.ЦветТекста = Новый Цвет;
	КонецЕсли;
	
	Если ПоказатьТипСрокаГодности Тогда
		ТипыСрокаГодности = МодульОбъекта().Перечисление_ТипыСроковГодности();
		Если ТипСрокаГодности = ТипыСрокаГодности.СрокГодностиБольше72СУсловием Тогда
			Элементы.ТоварыАльтернативныйСрокГодности.Видимость = Истина;
			Элементы.ТоварыДатаСрокаГодности.Видимость = Ложь;
		Иначе
			Элементы.ТоварыДатаСрокаГодности.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоМаркировкаТоваровРасформированногоНабора Тогда
		Элементы.КодМаркировкиОтчетаОНанесении.Заголовок = НСтр("ru='Код набора'");
	Иначе
		Элементы.КодМаркировкиОтчетаОНанесении.Заголовок = НСтр("ru='Код маркировки'");
	КонецЕсли;
	
	Элементы.ТоварыКоличествоЗСН.Видимость = ПоказатьЗСН;
	Элементы.КодыМаркировкиЗаводскойСерийныйНомер.Видимость = ПоказатьЗСН;
	
	Элементы.ТоварыСодержаниеСпирта.Видимость = ПоказатьСодержаниеСпирта;
	Элементы.ТоварыНомерДокументаОтчетОНанесении.Видимость = ПоказатьНомерИДатуПервичногоДокумента;
	Элементы.ТоварыДатаДокументаОтчетОНанесении.Видимость = ПоказатьНомерИДатуПервичногоДокумента;
	Элементы.ГруппаОтчетОНанесенииНомерДата.Видимость = ПоказатьНомерИДатуПервичногоДокумента;
	Элементы.ГруппаТипОтчетаОНанесении.Видимость = ПоказатьТипОтчета;
	Элементы.ГруппаКодМаркировкиОтчетОНанесении.Видимость = ПоказатьКодМаркировки;
	Элементы.РезервироватьПартии.Видимость = ПоказатьРезервированиеПартий;
	
	Элементы.Товары.ТолькоПросмотр = ЭтоМаркировкаТоваровРасформированногоНабора;
	Элементы.КодыМаркировки.ТолькоПросмотр = ЭтоМаркировкаТоваровРасформированногоНабора;
	Элементы.Кнопка_ЗагрузитьКодыИзТабличногоДокумента.Доступность = Не ЭтоМаркировкаТоваровРасформированногоНабора;
	
	УстановитьПодсказкуМОД();
	УстановитьПодсказкуНомераСерии();
	УстановитьПодсказкуНомераПартии();
	УстановитьПодсказкуДатаПервичногоДокумента();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы_РезервированиеПартий()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	
	Если ТипОперации <> ТипыОпераций.РезервированиеПартий
		И ТипОперации <> ТипыОпераций.РезервированиеОднойПартии Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.РезервированиеПартий Тогда
		
		Элементы.ЗакладкаТовары.Видимость = Истина;
		Элементы.ТоварыПодчиненнаяОперация.Видимость = Истина;
		Элементы.ТоварыРезервированиеПартий.Видимость = Истина;
		Элементы.Товары.ТолькоПросмотр = Истина;
		
	Иначе
		
		Элементы.РезервированиеПартий.Видимость = Истина;
		Элементы.ПоляТиповОпераций.ТекущаяСтраница = Элементы.РезервированиеПартий;
		
	КонецЕсли;
	
	Элементы.Кнопка_ВыполнитьОперацию.Заголовок = НСтр("ru = 'Отправить'");
	Элементы.Кнопка_ПовторитьОтправкуСначала.Заголовок = НСтр("ru = 'Повторно отправить'");
	
КонецПроцедуры

&НаСервере
Функция ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесении()
	
	Возврат МодульОбъекта().ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесении(ВидПродукции, ТипОтчетаОНанесении);
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьВыгрузкиКодов()
	
	ПодходящиеОперации = МодульОбъекта().ТипыОперацийСВыгрузкойКодов();
	ПоказатьМенюВыгрузкиКодовВФайл = МодульОбъекта().МассивСодержитЗначение(ПодходящиеОперации, ТипОперации);
	
	Элементы.МенюСохранитьКодыВФайл.Видимость = ПоказатьМенюВыгрузкиКодовВФайл;
	Элементы.МенюСохранитьКодыВФайл1.Видимость = ПоказатьМенюВыгрузкиКодовВФайл;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьОбщихИтоговВходящегоУПД(ДанныеВходящегоУПД)
	
	КоличествоКодовПоОСУСОшибками = ДанныеВходящегоУПД.ОбщиеИтоги.КоличествоКодовПоОСУСОшибками;
	КоличествоКодовСОшибками = ДанныеВходящегоУПД.ОбщиеИтоги.КоличествоКодовСОшибками;
	Отсканировано = ДанныеВходящегоУПД.ОбщиеИтоги.ПроцентОтсканированных;
	
	Если ЗначениеЗаполнено(КоличествоКодовПоОСУСОшибками) Тогда
		Элементы.КоличествоНедопустимыхКодовПоОСУ.Видимость = Истина;
		Элементы.КоличествоНедопустимыхКодовПоОСУ.Заголовок = "Недопустимых кодов по ОСУ: " + КоличествоКодовПоОСУСОшибками;
	Иначе
		Элементы.КоличествоНедопустимыхКодовПоОСУ.Видимость = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КоличествоКодовСОшибками) Тогда
		Элементы.КоличествоНедопустимыхКодов.Видимость = Истина;
		Элементы.КоличествоНедопустимыхКодов.Заголовок = "Недопустимых кодов маркировки: " + КоличествоКодовСОшибками;
	Иначе
		Элементы.КоличествоНедопустимыхКодов.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.Отсканировано.Заголовок = "Отсканировано " + Отсканировано + "%"
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолей_ВозвратВОборот()

	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ВозвратВОборот
		И ТипОперации <> ТипыОпераций.ВозвратВОборотНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	ТребуетсяПервичныйДокумент = МодульОбъекта().ПричинаВозвратаВОборотТребуетПервичныйДокумент(ПричинаВозвратаВОборот, ТоварОплачен);
	
	Элемент = Элементы.ВидПервичногоДокументаВозвратВОборот;
	Элемент.АвтоОтметкаНезаполненного = ТребуетсяПервичныйДокумент;
	Элемент.ОтметкаНезаполненного = Элемент.АвтоОтметкаНезаполненного И Не ЗначениеЗаполнено(ВидПервичногоДокумента);
	
	Элемент = Элементы.НомерДокументаВозвратВОборот;
	Элемент.АвтоОтметкаНезаполненного = ТребуетсяПервичныйДокумент;
	Элемент.ОтметкаНезаполненного = Элемент.АвтоОтметкаНезаполненного И Не ЗначениеЗаполнено(НомерДокумента);
	
	Элемент = Элементы.ДатаДокументаВозвратВОборот;
	Элемент.АвтоОтметкаНезаполненного = ТребуетсяПервичныйДокумент;
	Элемент.ОтметкаНезаполненного = Элемент.АвтоОтметкаНезаполненного И Не ЗначениеЗаполнено(ДатаДокумента);
	
	ВидыПервичныхДокументов = МодульОбъекта().Перечисление_ВидыПервичныхДокументов();
	ТребуетсяНаименованиеДокумента = (ВидПервичногоДокумента = ВидыПервичныхДокументов.Прочее);
	
	Элемент = Элементы.НаименованиеПервичногоДокументаВозвратВОборот;
	Элемент.Видимость = ТребуетсяНаименованиеДокумента;
	Элемент.АвтоОтметкаНезаполненного = ТребуетсяНаименованиеДокумента;
	Элемент.ОтметкаНезаполненного = Элемент.АвтоОтметкаНезаполненного И Не ЗначениеЗаполнено(НаименованиеПервичногоДокумента);
	
	ПричиныВозвратаВОборот = МодульОбъекта().Перечисление_ПричиныВозвратаВОборот();
	
	Элементы.ИдентификаторГосКонтрактаВозвратВОборот.Видимость =
		(ПричинаВозвратаВОборот = ПричиныВозвратаВОборот.Гостайна);
	
	Элементы.ТоварОплачен.Видимость = (ПричинаВозвратаВОборот = ПричиныВозвратаВОборот.ДистанционныйСпособПродажи);
	
	Элементы.ТоварыРазрешительныйДокумент_ВозвратВОборот.Видимость = ДопускаетсяУказаниеРазрешительнойДокументации();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолей_ЗаказКодов()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ЗаказКодов Тогда
		Возврат;
	КонецЕсли;
	
	ВидыПродукции = МодульОбъекта().Перечисление_ВидыПродукции();
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	ТипыЗаказаКодов = МодульОбъекта().Перечисление_ТипыЗаказаКодов();
	ТипыКодовМаркировки = МодульОбъекта().Перечисление_ТипыКодовМаркировки();
	СпособыВыпускаТоваров = МодульОбъекта().Перечисление_СпособыВыпускаТоваров();
	
	Элементы.ГруппаОстаткиИмпорт.Видимость = Ложь;
	Элементы.СервисПровайдер.Видимость = ЗаказКодовДляСервисПровайдера;
	
	Если МодульОбъекта().ВидПродукцииТребуетТипОплатыКодов(ВидПродукции) Тогда
		Элементы.ТипОплатыКодов.Видимость = Истина;
		Элементы.ТипОплатыКодов.АвтоОтметкаНезаполненного = Истина;
	Иначе
		Элементы.ТипОплатыКодов.Видимость = Ложь;
		Элементы.ТипОплатыКодов.АвтоОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	ЭтоПеремаркировка = (СпособВыпускаТоваров = СпособыВыпускаТоваров.Перемаркировка);
	ЭтоМаркировкаОстатков = (СпособВыпускаТоваров = СпособыВыпускаТоваров.Остатки);
	ЭтоМаркировкаВнеПроизводстваИлиИмпорта = (СпособВыпускаТоваров = СпособыВыпускаТоваров.МаркировкаВнеПроизводстваИлиИмпорта);
	ЭтоКИГУ = (ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка);
	ЭтоМаркировкаТоваровРасформированногоНабора = (ТипЗаказаКодов = ТипыЗаказаКодов.РасформированиеНабора);
	ЭтоРазделениеТовара = (ТипЗаказаКодов = ТипыЗаказаКодов.РазделениеТовара);
	
	ПоказатьФорматКодов = МодульОбъекта().ВидПродукцииПоддерживаетУкороченныйФорматКодов(ВидПродукции);
	ПоказатьСобственника = (ЭтоМаркировкаОстатков Или ЭтоПеремаркировка Или ЭтоМаркировкаВнеПроизводстваИлиИмпорта);
	ПоказатьТипЗаказаКодов = МодульОбъекта().ВидПродукцииДопускаетУказаниеТипаЗаказаКодов(ВидПродукции, СпособВыпускаТоваров);
	
	Если ОсновнойСтатус <> СтатусыОпераций.Новый
		И ЭтоПеремаркировка
		И Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Элементы.ЗакладкаКодыМаркировки.Видимость = Истина;
		Элементы.ЗакладкаКодыМаркировки.Заголовок = НСтр("ru = 'Коды для перемаркировки'");
	КонецЕсли;
	
	Если ЭтоМаркировкаТоваровРасформированногоНабора Тогда
		Элементы.КодМаркировкиЗаказаКодов.Заголовок = НСтр("ru='Код набора'");
		Элементы.Кнопка_ЗаполнитьТоварыПоКодуМаркировки.Заголовок = НСтр("ru='Заполнить товары по коду набора'");
	Иначе
		Элементы.КодМаркировкиЗаказаКодов.Заголовок = НСтр("ru='Код маркировки'");
		Элементы.Кнопка_ЗаполнитьТоварыПоКодуМаркировки.Заголовок = НСтр("ru='Заполнить товары по коду маркировки'");
	КонецЕсли;
	
	Элементы.ТоварыКодТНВЭД.Видимость = ЭтоПеремаркировка;
	Элементы.ЗаказКодовДляСервисПровайдера.ТолькоПросмотр = ЭтоПеремаркировка;
	Элементы.ЗаказатьКодыДляВложенныхТоваров.Видимость = ЭтоКИГУ И Не ЭтоПеремаркировка;
	Элементы.ТоварыПодчиненнаяОперация.Видимость = ЗаказатьКодыДляВложенныхТоваров;
	Элементы.ТоварыЗаказИФормированиеКИГУ.Видимость = ЗаказатьКодыДляВложенныхТоваров;
	Элементы.ГруппаФорматКодов.Видимость = ПоказатьФорматКодов;
	Элементы.ГруппаСобственникТоваров.Видимость = ПоказатьСобственника;
	Элементы.СобственникТовараИННЗаказКодов.Видимость = КарточкиТоваровПринадлежатДругойОрганизации;
	Элементы.ГруппаТипЗаказа.Видимость = ПоказатьТипЗаказаКодов;
	Элементы.ГруппаКодМаркировкиЗаказаКодов.Видимость = (ЭтоМаркировкаТоваровРасформированногоНабора Или ЭтоРазделениеТовара);
	Элементы.Кнопка_ЗаполнитьТоварыПоКодуМаркировки.Видимость = (ЭтоМаркировкаТоваровРасформированногоНабора Или ЭтоРазделениеТовара);
	Элементы.Товары.ТолькоПросмотр = ЭтоМаркировкаТоваровРасформированногоНабора;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолей_НаполнениеАгрегатовНаТСД()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.НаполнениеАгрегатовНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	
	Если МодульОбъекта().ВидПродукцииПоддерживаетОтчетОНанесении(ВидПродукции) Тогда
		Элементы.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД.Видимость = Истина;
	Иначе
		Элементы.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД.Видимость = Ложь;
	КонецЕсли;
	
	Если ОсновнойСтатус <> СтатусыОпераций.ОперацияЗавершена Тогда
		Элементы.Кнопка_НапечататьЭтикетки.Видимость = Истина;
	КонецЕсли;
	
	Если ОсновнойСтатус = СтатусыОпераций.Новый Тогда
		Элементы.ГруппаДобавленияАгрегатов.Видимость = Истина;
	КонецЕсли;
	
	Элементы.РегистрироватьАгрегатыПослеНаполнения.Видимость = Не НаполнитьАгрегатыВОдномЗадании;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолей_УведомлениеОСостоянииКодов()
	
	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	СостоянияКодов = МодульОбъекта().Перечисление_СостоянияКодов();
	Если ТипОперации <> ТипыОпераций.УведомлениеОСостоянииКодов Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоОтменаОтгрузкиНаЭкспорт = (СостояниеКодов = СостоянияКодов.ОтменаОтгрузкиНаЭкспорт);
	
	Элементы.ПлощадкаУведомлениеОСостоянииКодов.Видимость = Не ЭтоОтменаОтгрузкиНаЭкспорт;
	Элементы.ДатаОтгрузкиУведомлениеОСостоянииКодов.Видимость = Не ЭтоОтменаОтгрузкиНаЭкспорт;
	Элементы.ГруппаПолучатель.Видимость = Не ЭтоОтменаОтгрузкиНаЭкспорт;
	Элементы.ГруппаТранспортныеРеквизиты.Видимость = Не ЭтоОтменаОтгрузкиНаЭкспорт;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы_ДляВсехОпераций()

	ЭтаФорма.Заголовок = Ссылка;
	
	Элементы.ГруппаОграничениеПоТарифу.Видимость = ОперацияОграниченаТарифом;
	
	Если ЗначениеЗаполнено(Подписант) Тогда
		Элементы.ГруппаДанныеОПодписании.Видимость = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Элементы.ДокументУчета.Видимость = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторДокумента)
		И МодульОбъекта().ОперациюМожноОткрытьВСервисе(ТипОперации) Тогда
		Элементы.Кнопка_ОткрытьВСервисе.Видимость = Истина;
	Иначе
		Элементы.Кнопка_ОткрытьВСервисе.Видимость = Ложь;
	КонецЕсли;
	
	РежимТехническогоСпециалиста = МодульОбъекта().ВключенРежимТехническогоСпециалиста();
	НастроитьЭлементыФормы_РежимТехническогоСпециалиста(РежимТехническогоСпециалиста);
	
	Элементы.Кнопка_ЗаписатьОперацию.Видимость = Не ЭтаФорма.ТолькоПросмотр;
	Элементы.Кнопка_ЗагрузитьКодыИзТабличногоДокумента.Видимость = Не ЭтаФорма.ТолькоПросмотр;
	Элементы.КодыМаркировки.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр;
	Элементы.КодыМаркировкиАртикул.Видимость = МодульОбъекта().Интеграция_Номенклатура1С_ЕстьАртикул();
	
	Элементы.ТоварыНомерСтроки.Ширина = 2;
	
	УстановитьВидимостьКолонкиТоваров("Артикул");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКолонкиТоваров(ИмяКолонки)
	
	ЕстьЗначения = Ложь;
	
	Для Каждого Стр Из Товары Цикл
		Если ЗначениеЗаполнено(Стр[ИмяКолонки]) Тогда
			ЕстьЗначения = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы["Товары" + ИмяКолонки].Видимость = ЕстьЗначения;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы_РежимТехническогоСпециалиста(РежимТехническогоСпециалиста)
	
	Элементы.Группа_ФункцииТехническогоСпециалиста.Видимость = РежимТехническогоСпециалиста;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы_ПодборНаТСД()

	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ПодборКодовНаТСД
		И ТипОперации <> ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыОпераций = МодульОбъекта().Перечисление_СтатусыОпераций();
	СтатусыДокументовУчета = МодульОбъекта().Перечисление_СтатусыДокументовУчета();
	
	ОсновнойСтатусДокументаУчета = "";
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		ОсновнойСтатусДокументаУчета = МодульОбъекта().ДокументУчета_ОсновнойСтатус(ДокументУчета);
	КонецЕсли;
	
	Элементы.ТоварыКоличествоУпаковок.Видимость = Истина;
	
	Если ТипОперации = ТипыОпераций.ПодборКодовНаТСД Тогда
		
		Если ОсновнойСтатус <> СтатусыОпераций.Новый Тогда
			Элементы.ЗакладкаКодыМаркировки.Видимость = Истина;
		КонецЕсли;
		
		Элементы.ОтражениеВЭДО.Видимость = МодульОбъекта().ДокументУчета_ЕстьРолиДляОтраженияВЭДО(ДокументУчета);
		
	КонецЕсли;
		
	Если ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		
		Элементы.ТоварыТовар.Видимость = Ложь;
		Элементы.ОтражениеВЭДО.Видимость = Ложь;
		
	КонецЕсли;
	
	Если ОсновнойСтатус = СтатусыОпераций.ОперацияЗавершена
		Или ОсновнойСтатус = СтатусыОпераций.НеУдалосьРаспознатьКоды Тогда
		
		Элементы.Кнопка_ПолучитьПовторноКодыИзТСД.Видимость = Истина;
		
		Если ОсновнойСтатусДокументаУчета = СтатусыДокументовУчета.ВРаботе Тогда
			Если ПодборСПомощьюМобильногоУстройства Тогда
				Элементы.ПодменюВернутьНаУстройство.Видимость = Истина;
			Иначе
				Элементы.Кнопка_ВернутьНаТСД.Видимость = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОсновнойСтатус = СтатусыОпераций.ОтправленВСервис Тогда
		Элементы.Кнопка_НазначитьДругойТСД.Видимость = ПодборСПомощьюМобильногоУстройства;
	КонецЕсли;
	
	Элементы.ГруппаМобильноеУстройство.Видимость = ПодборСПомощьюМобильногоУстройства;
	
	Элементы.ПодборКодовНаТСД.Видимость = Истина;
	Элементы.ПоляТиповОпераций.ТекущаяСтраница = Элементы.ПодборКодовНаТСД;
	
	Элементы.КомментарийВозвратаНаТСД.Видимость = Истина;
	
	Элементы.Кнопка_ВыполнитьОперацию.Заголовок = НСтр("ru = 'Отправить на ТСД'");
	
	Элементы.ЗакладкаТовары.Видимость = Истина;
	
	Элементы.ТоварыКлючНоменклатуры1С.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы_ЗаказКодов()

	ТипыОпераций = МодульОбъекта().Перечисление_ТипыОпераций();
	Если ТипОперации <> ТипыОпераций.ЗаказКодов Тогда
		Возврат;
	КонецЕсли;
	
