Процедура УстановитьОформлениеТоварыКодСтраныПроизводителя()
	
	ТаблицаФормы = Элементы.Товары;
	СписокСтран = МодульОбъекта().СписокСтранМира();
	СписокСтран.Вставить(0, "00", "НЕИЗВЕСТНО");
	
	Для Каждого ЭлементСписка Из СписокСтран Цикл
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ТаблицаФормы.ПутьКДанным + "КодСтраныПроизводителя");
		
