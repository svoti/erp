	УведомлениеОПриемке_ОтклонитьВсеНаСервере();
	
	МодульКлиента().ВыполнитьОбменПоОрганизации(ЭтаФорма, Организация);
	
	ЗаполнитьКонтекстФормыИУстановитьВидимость();
	
