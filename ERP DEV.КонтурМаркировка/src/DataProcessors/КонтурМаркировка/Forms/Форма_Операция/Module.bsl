		Элементы.ЗакладкаКодыМаркировки.Заголовок = НСтр("ru = 'Коды для добавления'");
	Иначе
		Элементы.РедакторКодовГиперссылка.Заголовок = НСтр("ru = 'Заполнить коды для изъятия'");
		Элементы.ЗакладкаКодыМаркировки.Заголовок = НСтр("ru = 'Коды для изъятия'");
	КонецЕсли;
	
	Элементы.Кнопка_ДобавитьКодАТК.Доступность = ЗначениеЗаполнено(ВидПродукции);
	
	Элементы.Кнопка_ДобавитьКодАТК.Видимость = Истина;
	
	Элементы.ЗакладкаКодыМаркировки.Видимость = Истина;
	
