	Элементы.ЗакладкаТовары.Видимость = Истина;
	Элементы.ТоварыОтчетОНанесении.Видимость = Истина;
	
	Элементы.ЗакладкаКодыМаркировки.Видимость = Истина;
	
	Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		Элементы.ИспользоватьНоминальноеКоличество.ТолькоПросмотр = Истина;
		Элементы.ТоварыКоличествоУпаковок.Видимость = Истина;
		Элементы.Кнопка_ВыполнитьОперацию.Заголовок = НСтр("ru = 'Отправить на ТСД'");
	Иначе
		Элементы.ИспользоватьНоминальноеКоличество.ТолькоПросмотр = Ложь;
		Элементы.ТоварыКоличествоКодов.Видимость = Истина;
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Электроника Тогда
		Элементы.ТоварыКоличество.Заголовок = НСтр("ru='Переменная характеристика'");
	Иначе
		Элементы.ТоварыКоличество.Заголовок = НСтр("ru='Вес / Объем'");
	КонецЕсли;
	
	Элементы.РезервироватьПартии.Заголовок = НСтр("ru='Зарезервировать партии перед подачей отчета'");
	
	Элементы.ТоварыПодчиненнаяОперация.Видимость = Истина;
	
