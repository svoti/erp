	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УдалитьКонтурМаркировка_СвязиКлючейКодов КАК СвязиКлючейКодов
	|		ПО КодыМаркировки.КлючКода = СвязиКлючейКодов.КлючКода
	|ГДЕ
	|	КодыМаркировки.ПорцияЗаписей = &ПорцияЗаписей");
	ЗапросКоды.УстановитьПараметр("ПустойФайл", ПустойФайл());
	
	ЗапросИнформацияОКодах = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.*
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК Т
	|ГДЕ
	|	Т.КлючИнформацииОКоде = &КлючИнформацииОКоде");
	
	МодульЯдро = МодульЯдро();
	КэшКлючейИнформации = Новый Соответствие;
	ОтборКлючИнформации = Новый Структура("КлючИнформацииОКоде, ЕстьПолныйКод");
	
	Набор = МодульЯдро.КодыМаркировки_ОписаниеНабораЗаписей();
	Набор.РежимЗаписи = МодульЯдро.Перечисление_РежимыЗаписиНабора().Обновление;
	Если ВерсияПлатформыНиже("8.3.26.1318") Тогда
		Набор.РежимЗаписи = МодульЯдро.Перечисление_РежимыЗаписиНабора().Замещение;
	КонецЕсли;
	
	ПустаяИнформация = МодульЯдро.Новый_ТаблицаКодов();
	ПустаяИнформация.Добавить();
	
	// BSLLS:CreateQueryInCycle-off
	
	ВыборкаПорция = ЗапросПорция.Выполнить().Выбрать();
	Пока ВыборкаПорция.Следующий() Цикл
		
		ЗапросКоды.УстановитьПараметр("ПорцияЗаписей", ВыборкаПорция.ПорцияЗаписей);
		
		ТаблицаКодов = ЗапросКоды.Выполнить().Выгрузить();
		ТаблицаКодов.Колонки.Добавить("Обработан", ОписаниеТипа_Булево());
		ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючИнформацииОКоде, ЕстьПолныйКод");
		
		Пока Истина Цикл
			
			Стр = ТаблицаКодов.Найти(Ложь, "Обработан");
			Если Стр = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			ОтборКлючИнформации.КлючИнформацииОКоде = Стр.КлючИнформацииОКоде;
			ОтборКлючИнформации.ЕстьПолныйКод = Стр.ЕстьПолныйКод;
			
			Если Не ЗначениеЗаполнено(Стр.КлючИнформацииОКоде) Тогда
				
				ПустаяИнформация[0].ЕстьПолныйКод = Стр.ЕстьПолныйКод;
				НовыйКлючИнформацииОКоде = МодульЯдро.КлючИнформацииОКоде_Подобрать(ПустаяИнформация[0], КэшКлючейИнформации);
				
			ИначеЕсли Стр.ЕстьПолныйКод Тогда
				
				ЗапросИнформацияОКодах.УстановитьПараметр("КлючИнформацииОКоде", Стр.КлючИнформацииОКоде);
				
				ТаблицаИнформации = ЗапросИнформацияОКодах.Выполнить().Выгрузить();
				
				Если ЗначениеЗаполнено(ТаблицаИнформации) Тогда
					КлючевыеРеквизиты = ТаблицаИнформации[0];
				Иначе
					КлючевыеРеквизиты = ПустаяИнформация[0];
				КонецЕсли;
				
				КлючевыеРеквизиты.ЕстьПолныйКод = Стр.ЕстьПолныйКод;
				НовыйКлючИнформацииОКоде = МодульЯдро.КлючИнформацииОКоде_Подобрать(КлючевыеРеквизиты, КэшКлючейИнформации);
				
			Иначе
				
				НовыйКлючИнформацииОКоде = Стр.КлючИнформацииОКоде;
				
			КонецЕсли;
			
			Для Каждого СтрКода Из ТаблицаКодов.НайтиСтроки(ОтборКлючИнформации) Цикл
				СтрКода.КлючИнформацииОКоде = НовыйКлючИнформацииОКоде;
				СтрКода.Обработан = Истина;
			КонецЦикла;
			
		КонецЦикла;
		
		ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючИнформацииОКоде, ЕстьПолныйКод");
		ТаблицаКодов.Колонки.Удалить("Обработан");
		
		Набор.ТаблицаНабора = ТаблицаКодов;
		ЗаписатьНаборРегистраСведений(Набор);
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
КонецПроцедуры

Процедура ПерейтиНаВерсиюДанных_3_16_0_РазбитьНаПорцииЗаписейФайлыСПолнымиКодами()
	
	ТипФайлаПолныеКоды = Перечисление_ТипыФайлов().ПолныеКоды;
	ВерсияФормата_3_16 = Перечисление_ВерсииФорматовФайлов().Версия_3_16;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Идентификатор КАК Идентификатор
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.ТипФайла = &ПолныеКоды
	|	И Т.ВерсияФормата = &ВерсияФормата_3_16");
	Запрос.УстановитьПараметр("ПолныеКоды", ТипФайлаПолныеКоды);
	Запрос.УстановитьПараметр("ВерсияФормата_3_16", ВерсияФормата_3_16);
	
	ОбработанныеПорции = Запрос.Выполнить().Выгрузить();
	ОбработанныеПорции.Колонки.Добавить("ПорцияЗаписей", ОписаниеТипа_Идентификатор());
	Для Каждого Стр Из ОбработанныеПорции Цикл
		Стр.ПорцияЗаписей = Новый УникальныйИдентификатор(Стр.Идентификатор);
	КонецЦикла;
	ОбработанныеПорции.Колонки.Удалить("Идентификатор");
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ОбработанныеПорции, "ОбработанныеПорции", "ПорцияЗаписей");
	ОбработанныеПорции.Очистить();
	
	ЗапросПорции = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбработанныеПорции КАК ОбработанныеПорции
	|		ПО КодыМаркировки.ПорцияЗаписей = ОбработанныеПорции.ПорцияЗаписей
	|ГДЕ
	|	КодыМаркировки.УдалитьФайлСПолнымКодом <> &ПустойФайл
	|	И ОбработанныеПорции.ПорцияЗаписей ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОбработанныеПорции");
	ЗапросПорции.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросПорции.УстановитьПараметр("ПустойФайл", ПустойФайл());
	
	ЗапросСтарыеФайлы = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.УдалитьФайлСПолнымКодом КАК СтарыйФайл
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК Т
	|ГДЕ
	|	Т.ПорцияЗаписей = &ПорцияЗаписей
	|	И Т.УдалитьФайлСПолнымКодом <> &ПустойФайл
	|ИТОГИ ПО
	|	СтарыйФайл");
	ЗапросСтарыеФайлы.УстановитьПараметр("ПустойФайл", ПустойФайл());
	
	МодульЯдро = МодульЯдро();
	КэшПолныхКодов = Новый Соответствие;
	
	// BSLLS:CreateQueryInCycle-off
	
	ВыборкаПорция = ЗапросПорции.Выполнить().Выбрать();
	Пока ВыборкаПорция.Следующий() Цикл
		
		ЗаписатьФайл = Ложь;
		
		ОписаниеНовогоФайла = МодульЯдро.Новый_ОписаниеФайла();
		ОписаниеНовогоФайла.ДанныеФайла = МодульЯдро.Новый_ТаблицаПолныхКодов();
		ОписаниеНовогоФайла.Идентификатор = ВыборкаПорция.ПорцияЗаписей;
		ОписаниеНовогоФайла.ВерсияФормата = ВерсияФормата_3_16;
		ОписаниеНовогоФайла.ТипФайла = ТипФайлаПолныеКоды;
		
		ЗапросСтарыеФайлы.УстановитьПараметр("ПорцияЗаписей", ВыборкаПорция.ПорцияЗаписей);
		
		ВыборкаСтарыйФайл = ЗапросСтарыеФайлы.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСтарыйФайл.Следующий() Цикл
			
			ТаблицаПолныхКодов = КэшПолныхКодов[ВыборкаСтарыйФайл.СтарыйФайл];
			
			Если ТаблицаПолныхКодов = Неопределено Тогда
				
				ОписаниеСтарогоФайла = Файл_Прочитать(ВыборкаСтарыйФайл.СтарыйФайл);
				Если ОписаниеСтарогоФайла = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ТаблицаПолныхКодов = ОписаниеСтарогоФайла.ДанныеФайла;
				Если Не ЗначениеЗаполнено(ТаблицаПолныхКодов) Тогда
					Продолжить;
				КонецЕсли;
				
				ТаблицаПолныхКодов.Колонки.Добавить("Перенесен", ОписаниеТипа_Булево());
				ТаблицаЗначений_ДобавитьИндекс(ТаблицаПолныхКодов, "КлючКода");
				
				КэшПолныхКодов.Вставить(ВыборкаСтарыйФайл.СтарыйФайл, ТаблицаПолныхКодов);
				
			КонецЕсли;
			
			Выборка = ВыборкаСтарыйФайл.Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрСтар = ТаблицаПолныхКодов.Найти(Выборка.КлючКода, "КлючКода");
				Если СтрСтар <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(ОписаниеНовогоФайла.ДанныеФайла.Добавить(), СтрСтар);
					СтрСтар.Перенесен = Истина;
					ЗаписатьФайл = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ТаблицаПолныхКодов.Найти(Ложь, "Перенесен") = Неопределено Тогда
				ТаблицаПолныхКодов.Очистить();
				КэшПолныхКодов.Удалить(ВыборкаСтарыйФайл.СтарыйФайл);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗаписатьФайл Тогда
			Файл_Записать(ОписаниеНовогоФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
КонецПроцедуры

Процедура ПерейтиНаВерсиюДанных_3_16_0_ЗаполнитьНастройкиПроверкиКодовДокументов()
	
	РолиДокументов = Перечисление_РолиДокументовУчета();
	ТипыПроверкиКодов = Перечисление_ТипыПроверкиКодов();
	
	Для Каждого НастройкиДокумента Из ДействующиеНастройкиДокументовУчета() Цикл
		
		ЕстьРольОтгрузка = МассивСодержитЗначение(НастройкиДокумента.РолиДокумента, РолиДокументов.Отгрузка);
		ЕстьРольКорректировка = МассивСодержитЗначение(НастройкиДокумента.РолиДокумента, РолиДокументов.КорректировкаОтгрузки);
		
		Если ЕстьРольОтгрузка Или ЕстьРольКорректировка Тогда
			
			НастройкиДокумента.ПроверкиКодовДокумента.Добавить(ТипыПроверкиКодов.ПроверкаРДКодов);
			НастройкиДокумента.ПроверкиКодовДокумента.Добавить(ТипыПроверкиКодов.ПроверкаВладельцаКодов);
			НастройкиДокумента.ПроверкиКодовДокумента.Добавить(ТипыПроверкиКодов.ПроверкаСтатусаКодов);
			
			НастройкиДокументаУчета_Записать(НастройкиДокумента);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПерейтиНаВерсиюДанных_3_16_0_ОбновитьРезультатыПроверкиКодовДокументов()
	
	ТипыСтатусовПроверки = Перечисление_ТипыСтатусовПроверкиКодов();
	СтатусыПроверкиКодов = Перечисление_СтатусыПроверкиКодовДокумента();
	ДопИнформацияСтатусов = Перечисление_ДопИнформацияСтатусовПроверкиКодовДокумента();
	
	СтатусыОшибокРД = Новый Массив;
	СтатусыОшибокРД.Добавить(ДопИнформацияСтатусов.ЧастьКодовНедоступныДляОтгрузки);
	СтатусыОшибокРД.Добавить(ДопИнформацияСтатусов.ВсеКодыНедоступныДляОтгрузки);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ДокументУчета КАК ДокументУчета,
	|	Т.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК Т
	|ГДЕ
	|	Т.ТипСтатуса = &ТипСтатуса");
	Запрос.УстановитьПараметр("ТипСтатуса", ТипыСтатусовПроверки.ПроверкаРДКодов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтатусыПроверок = МодульЯдро().Новый_ДокументУчета_СтатусыПроверокКодов();
		
		Если МассивСодержитЗначение(СтатусыОшибокРД, Выборка.Статус) Тогда
			СтатусПроверкиРД = СтатусыПроверкиКодов.Предупреждение;
		Иначе
			СтатусПроверкиРД = СтатусыПроверкиКодов.Успешно;
		КонецЕсли;
		
		СтатусыПроверок.ПроверкаРДКодов = СтатусПроверкиРД;
		СтатусыПроверок.ДопИнформация_ПроверкаРДКодов = Выборка.Статус;
		
		ДокументУчета_ЗаписатьРезультатыПроверкиКодов(Выборка.ДокументУчета, СтатусыПроверок);
		
	КонецЦикла;
	
КонецПроцедуры

