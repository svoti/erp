// Контракт обработчика обновления
//
// Параметры:
//  ВерсияДанных - Строка - версия данных, на которую выполняется обновление, см. функцию Перечисление_ВерсииДанныхПодсистемы(),
//                          в модуле объекта должна быть процедура с версией данных, например: ПерейтиНаВерсиюДанных_3_0_0;
//  ДлительноеОбновление - Булево - (необязательный) Истина, если синхронное обновление данных может занять много времени;
// 
// Возвращаемое значение:
//  Структура - поля:
//   * ВерсияДанных - Строка - значение входящего параметра;
//   * ФоновоеОбновление - Булево - Истина, если после синхронного обновления нужно выполнить фоновое обновление данных;
//   * ДлительноеОбновление - Булево - Истина, если синхронное обновление данных может занять много времени;
//
Функция Новый_ОбработчикОбновления(ВерсияДанных, ДлительноеОбновление = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияДанных", ВерсияДанных);
	Результат.Вставить("ФоновоеОбновление", Ложь);
	Результат.Вставить("ДлительноеОбновление", ДлительноеОбновление);
	
	Возврат Результат;
	
КонецФункции

