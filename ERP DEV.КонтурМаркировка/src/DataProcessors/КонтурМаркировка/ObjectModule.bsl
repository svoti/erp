Функция СпособыОтраженияВЧЗПоЭтапуМаркировки(ЭтапМаркировки) Экспорт
	
	Результат = Новый Массив;
	
	ЭтапыМаркировки = Перечисление_ЭтапыМаркировки();
	СпособыОтраженияВЧЗ = Перечисление_СпособыОтраженияВЧЗ();
	
	Если ЭтапМаркировки <> ЭтапыМаркировки.НаполнениеДокументаКодами
		И ЭтапМаркировки <> ЭтапыМаркировки.ЗавершениеРаботы Тогда
		Результат.Добавить(СпособыОтраженияВЧЗ.СоздатьИОтправить);
		Результат.Добавить(СпособыОтраженияВЧЗ.СоздатьИНеОтправлять);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СпособОтраженияВЧЗПоУмолчанию(ЭтапМаркировки) Экспорт
	
	Результат = Неопределено;
	
	СпособыОтражения = СпособыОтраженияВЧЗПоЭтапуМаркировки(ЭтапМаркировки);
	Если СпособыОтражения.Количество() > 0 Тогда
		Результат = СпособыОтражения[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПорядокОбработкиЭтапаМаркировки(ЭтапМаркировки) Экспорт
	
	ЭтапыМаркировки = Перечисление_ЭтапыМаркировки();
	
	Если ЭтапМаркировки = ЭтапыМаркировки.Нанесение Тогда
		Результат = Новый_ПорядокОбработкиНанесение();
	ИначеЕсли ЭтапМаркировки = ЭтапыМаркировки.ВводВОборот Тогда
		Результат = Новый_ПорядокОбработкиВводВОборот();
	ИначеЕсли ЭтапМаркировки = ЭтапыМаркировки.НаполнениеДокументаКодами Тогда
		Результат = Новый_ПорядокОбработкиНаполнениеДокументаКодами();
	ИначеЕсли ЭтапМаркировки = ЭтапыМаркировки.ЗавершениеРаботы Тогда
		Результат = Новый_ПорядокОбработкиЗавершениеРаботы();
	Иначе
		Результат = Новый Структура;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПорядокОбработкиЭтапаМаркировки()
	
	ОписаниеТипа_Массив = Новый ОписаниеТипов("Массив");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТребуемоеДействие", ОписаниеТипа_Строка());
	Результат.Колонки.Добавить("СпособыВыполнения", ОписаниеТипа_Массив);
	Результат.Колонки.Добавить("Пропущен",          ОписаниеТипа_Булево());
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПорядокОбработкиНанесение()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	Результат = Новый_ПорядокОбработкиЭтапаМаркировки();
	
	ДобавитьДействиеВПорядокОбработки(Результат, ТребуемыеДействия.НапечататьЭтикетки);
	ДобавитьДействиеВПорядокОбработки(Результат, ТребуемыеДействия.ОтчитатьсяОНанесении);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПорядокОбработкиВводВОборот()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	Результат = Новый_ПорядокОбработкиЭтапаМаркировки();
	
	ДобавитьДействиеВПорядокОбработки(Результат, ТребуемыеДействия.ВвестиВОборот);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПорядокОбработкиНаполнениеДокументаКодами()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	СпособыВыполнения = Перечисление_СпособыВыполнения();
	
	Результат = Новый_ПорядокОбработкиЭтапаМаркировки();
	
	НоваяСтрока = ДобавитьДействиеВПорядокОбработки(Результат, ТребуемыеДействия.НаполнитьКодами);
	НоваяСтрока.СпособыВыполнения.Добавить(СпособыВыполнения.Заказать);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПорядокОбработкиЗавершениеРаботы()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	Результат = Новый_ПорядокОбработкиЭтапаМаркировки();
	
	ДобавитьДействиеВПорядокОбработки(Результат, ТребуемыеДействия.ЗавершитьРаботу);
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьДействиеВПорядокОбработки(ПорядокОбработки, ТребуемоеДействие, Пропущен = Ложь)
	
	НоваяСтрока = ПорядокОбработки.Добавить();
	НоваяСтрока.ТребуемоеДействие = ТребуемоеДействие;
	НоваяСтрока.Пропущен = Пропущен;
	
	Возврат НоваяСтрока;
	
КонецФункции

Функция СпособыВыполненияЭтапаМаркировки(ЭтапМаркировки) Экспорт
	
	ЭтапыМаркировки = Перечисление_ЭтапыМаркировки();
	
	Если ЭтапМаркировки = ЭтапыМаркировки.НаполнениеДокументаКодами Тогда
		Результат = Новый_СпособВыполненияНаполнениеДокументаКодами();
	Иначе
		Результат = Новый Структура;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_СпособВыполненияНаполнениеДокументаКодами()
	
	Ключи = КлючиПеречисления_СпособыВыполнения();
	СпособыВыполнения = Перечисление_СпособыВыполнения();
	
	Результат = Новый Структура;
	Результат.Вставить(Ключи[СпособыВыполнения.Заказать], Ложь);
	Результат.Вставить(Ключи[СпособыВыполнения.ПодобратьСоСвободногоОстатка], Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_МаршрутМаркировки() Экспорт
	
	Возврат МодульЯдро().Новый_МаршрутМаркировки();
	
КонецФункции

Функция МаршрутМаркировки_Прочитать(МаршрутМаркировки) Экспорт
	
	Возврат МодульЯдро().МаршрутМаркировки_Прочитать(МаршрутМаркировки);
	
КонецФункции

Функция МаршрутМаркировки_ПрочитатьШаблон(ИмяШаблона) Экспорт
	
	ШаблоныМаршрутов = Перечисление_ШаблоныМаршрутовМаркировки();
	Если ИмяШаблона = ШаблоныМаршрутов.ШаблонНанесениеИВводВОборот Тогда
		Результат = ШаблонМаршрута_НанесениеИВводВОборот();
	ИначеЕсли ИмяШаблона = ШаблоныМаршрутов.ШаблонНаполнениеУПД Тогда
		Результат = ШаблонМаршрута_НаполнениеУПД();
	Иначе
		ТекстОшибки = ПараметрыВСтроку(НРег("ru = 'Неизвестный шаблон маршрута маркировки: %1'"), ИмяШаблона);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура МаршрутМаркировки_Записать(ОписаниеМаршрута) Экспорт
	
	Если ЗначениеЗаполнено(ОписаниеМаршрута.Ссылка) Тогда
		ДанныеИБ = ДопСправочник_Прочитать(ОписаниеМаршрута.Ссылка);
	Иначе
		ИмяСправочника = Перечисление_ИменаДопСправочников().МаршрутыМаркировки;
		ДанныеИБ = Новый_ЭлементДопСправочника(ИмяСправочника);
	КонецЕсли;
	
	ДанныеИБ.Наименование = ОписаниеМаршрута.Наименование;
	
	ДопРеквизиты = ДанныеИБ.ДопРеквизиты;
	ДопРеквизиты.Очистить();
	
	ДопРеквизиты.Вставить("ЭтапыМаркировки", ОписаниеМаршрута.ЭтапыМаркировки);
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

Функция ШаблонМаршрута_НанесениеИВводВОборот()
	
	ЭтапыМаркировки = Перечисление_ЭтапыМаркировки();
	
	Результат = Новый_МаршрутМаркировки();
	Результат.Наименование = НСтр("ru = 'Нанесение и ввод в оборот'");
	
	ДобавитьЭтапМаркировки(Результат.ЭтапыМаркировки, ЭтапыМаркировки.НаполнениеДокументаКодами);
	ДобавитьЭтапМаркировки(Результат.ЭтапыМаркировки, ЭтапыМаркировки.Нанесение);
	ДобавитьЭтапМаркировки(Результат.ЭтапыМаркировки, ЭтапыМаркировки.ВводВОборот);
	ДобавитьЭтапМаркировки(Результат.ЭтапыМаркировки, ЭтапыМаркировки.ЗавершениеРаботы);
	
	Возврат Результат;
	
КонецФункции

Функция ШаблонМаршрута_НаполнениеУПД()
	
	ЭтапыМаркировки = Перечисление_ЭтапыМаркировки();
	
	Результат = Новый_МаршрутМаркировки();
	Результат.Наименование = НСтр("ru = 'Наполнение УПД'");
	
	ДобавитьЭтапМаркировки(Результат.ЭтапыМаркировки, ЭтапыМаркировки.НаполнениеДокументаКодами);
	ДобавитьЭтапМаркировки(Результат.ЭтапыМаркировки, ЭтапыМаркировки.ЗавершениеРаботы);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьЭтапМаркировки(ЭтапыМаркировки, Этап)
	
	СпособОтражения = СпособОтраженияВЧЗПоУмолчанию(Этап);
	
	ПорядокОбработки = ПорядокОбработкиЭтапаМаркировки(Этап);
	Для Каждого Стр Из ПорядокОбработки Цикл
		
		НоваяСтрока = ЭтапыМаркировки.Добавить();
		НоваяСтрока.Этап = Этап;
		НоваяСтрока.СпособОтражения = СпособОтражения;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
	КонецЦикла;
	
КонецПроцедуры

