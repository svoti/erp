	Если Не ЗначениеЗаполнено(ИмяТипа) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИмяТипа) = Тип("ОписаниеТипов") Тогда
		ОписаниеТипа = ИмяТипа;
	Иначе
		ОписаниеТипа = Новый ОписаниеТипов(ИмяТипа);
