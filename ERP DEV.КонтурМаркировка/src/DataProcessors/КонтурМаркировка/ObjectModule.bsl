			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокументыУчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК ТоварыСПартиями
	|		ПО ДокументыУчета.Ссылка = ТоварыСПартиями.Ссылка
	|			И (ТоварыСПартиями.НомерПартии <> &ПустойНомерПартии)
	|ГДЕ
	|	ДокументыУчета.Дата >= &ДатаНачалаОбработки
	|	И ДокументыУчета.ТипДокумента В(&НужныеТипыДокументов)
	|	И ТоварыСПартиями.Товар.ВидПродукции = &ВидПродукцииМолоко");
	
	Запрос.УстановитьПараметр("ПустойНомерПартии", "");
	Запрос.УстановитьПараметр("НужныеТипыДокументов", НужныеТипыДокументов);
	Запрос.УстановитьПараметр("ДатаНачалаОбработки", ДатаНачалаОбработки);
	Запрос.УстановитьПараметр("ВидПродукцииМолоко", Перечисление_ВидыПродукции().Молоко);
	Запрос.УстановитьПараметр("ОсновнойСтатус", Перечисление_ТипыСтатусов().ОсновнойСтатус);
	
	ОбновлениеДанных_ДобавитьОбъекты(МассивИзРезультатаЗапроса(Запрос), ОписаниеОбработчика.ВерсияДанных);
	
