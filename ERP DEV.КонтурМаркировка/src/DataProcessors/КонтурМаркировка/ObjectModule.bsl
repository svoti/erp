	Результат = ХранилищеНастроекДанныхФорм.Загрузить(СписокДокументов_КлючНастроекСКД(),
									Перечисление_СлужебныеОтборы().ТекущийОтбор);
	
	Возврат Результат;
	
	
КонецФункции

Функция СписокСохраненныхОтборовБезСлужебных() Экспорт
	
	Результат = ХранилищеНастроекДанныхФорм.ПолучитьСписок(СписокДокументов_КлючНастроекСКД());
	
	СлужебныеОтборы = Перечисление_СлужебныеОтборы();
	
	Для Каждого СлужебныйОтбор Из СлужебныеОтборы Цикл
		
		НайденныйСлужебныйЭлемент = Результат.НайтиПоЗначению(СлужебныйОтбор.Значение);
		Если НайденныйСлужебныйЭлемент <> Неопределено Тогда
			Результат.Удалить(НайденныйСлужебныйЭлемент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

