Процедура Операция_ЗаполнитьТЧ_РегистрацияКИГу(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ПодходящиеСтатусы = Операция_РегистрацияКИГУ_ПодходящиеСтатусыКодов();
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	НаполнениеКИГУНаТСД = Перечисление_ТипыОпераций().НаполнениеКИГУНаТСД;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	
	ТаблицаКодов_ВТ_ЗаменитьТранспортныеАгрегатыНаКИГУ(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, НаполнениеКИГУНаТСД, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_УдалитьКодыБезВложенныхКодов(МенеджерВТ);
	ТаблицаКодов_ВТ_ДобавитьКоличествоВложенныхКодов(МенеджерВТ);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусы);
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ОписаниеОперации.ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	ЕстьПартионныйУчет =  ВидПродукцииПоддерживаетПартионныйУчет(ОписаниеОперации.ВидПродукции);
	Если ЕстьПартионныйУчет Тогда
		НомераПартийВложенныхКодов = ТаблицаКодов_ВТ_НомераПартийВложенныхКодов(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.КоличествоВложенныхКодов КАК КоличествоВложенныхКодов
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ОбщийТипУпаковки = &ГрупповаяУпаковка
	|	И Т.ВидПродукции = &ВидПродукции");
	Запрос.УстановитьПараметр("ГрупповаяУпаковка", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ГрупповаяУпаковка);
	Запрос.УстановитьПараметр("ВидПродукции", ОписаниеОперации.ВидПродукции);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	ОписаниеОперации.Товары.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		НомерПартииВложенныхКодов = "";
		Если ЕстьПартионныйУчет Тогда
			НомерПартииВложенныхКодов = НомераПартийВложенныхКодов.Найти(Выборка.КлючКода, "КлючКода").НомерПартии;
		КонецЕсли;
		
		КоличествоКИГУ = 1;
		БудетДобавленоКодов = Выборка.КоличествоВложенныхКодов + КоличествоКИГУ;
		
		СтрТовара = Неопределено;
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			КодовВСтроке = Стр.КоличествоУпаковок + Стр.КоличествоУпаковокВложенногоТовара + БудетДобавленоКодов;
			Если Стр.Товар = Выборка.Товар
				И Стр.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С
				И Стр.НомерПартииВложенныхКодов = НомерПартииВложенныхКодов
				И КодовВСтроке < ДопустимоеКоличествоКодовВСтроке Тогда
				СтрТовара = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрТовара = Неопределено Тогда
			СтрТовара = ОписаниеОперации.Товары.Добавить();
			СтрТовара.КлючСтрокиОперации = Новый УникальныйИдентификатор;
			СтрТовара.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С;
			СтрТовара.Товар = Выборка.Товар;
			СтрТовара.НомерПартииВложенныхКодов = НомерПартииВложенныхКодов;
		КонецЕсли;
		
		СтрТовара.КоличествоУпаковок = СтрТовара.КоличествоУпаковок + КоличествоКИГУ;
		СтрТовара.КоличествоУпаковокВложенногоТовара =
		СтрТовара.КоличествоУпаковокВложенногоТовара + Выборка.КоличествоВложенныхКодов;
		
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ВозвратВОборот(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ПодходящиеСтатусы = Операция_ВозвратВОборот_ПодходящиеСтатусыКодов();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусы);
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ОписаниеОперации.ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	РазрешительнаяДокументация = Неопределено;
	Если ВидПродукцииДопускаетУказаниеРазрешительнойДокументации(ОписаниеОперации.ВидПродукции)
		И ПричинаВозвратаВОборотДопускаетУказаниеРазрешительнойДокументации(ОписаниеОперации.ДопРеквизиты.ПричинаВозвратаВОборот) Тогда
		РазрешительнаяДокументация = ТаблицаКодов_ВТ_РазрешительнаяДокументация(МенеджерВТ);
	КонецЕсли;
	
	ПодходящиеОбщиеТипыУпаковок = Новый Массив;
	ПодходящиеОбщиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор);
	ПодходящиеОбщиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Комплект);
	ПодходящиеОбщиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара);
	ПодходящиеОбщиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ГрупповаяУпаковка);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ВидПродукции = &ВидПродукции
	|	И Т.ОбщийТипУпаковки В (&ПодходящиеОбщиеТипыУпаковок)");
	Запрос.УстановитьПараметр("ВидПродукции", ОписаниеОперации.ВидПродукции);
	Запрос.УстановитьПараметр("ПодходящиеОбщиеТипыУпаковок", ПодходящиеОбщиеТипыУпаковок);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ПоляТоваров = "Товар, КлючНоменклатуры1С";
	Операция_ЗаполнитьТаблицуТоваров(ОписаниеОперации.Товары, ТаблицаЗапроса, ПоляТоваров);
	
	Для Каждого СтрТов Из ОписаниеОперации.Товары Цикл
		Если ЗначениеЗаполнено(РазрешительнаяДокументация) Тогда
			СтрТов.РазрешительныйДокумент = РазрешительнаяДокументация[СтрТов.Товар];
		КонецЕсли;
	КонецЦикла;
	
	Отбор = Новый Структура(ПоляТоваров);
	ОписаниеОперации.Товары.Индексы.Добавить(ПоляТоваров);
	Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрЗапроса);
		СтрТовара = ОписаниеОперации.Товары.НайтиСтроки(Отбор)[0];
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = СтрЗапроса.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ФормированиеАТК(ОписаниеОперации, ТаблицаКодов)
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ДопустимоеКоличествоКодов = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	
	Если Не ЗначениеЗаполнено(ДокументУчета.ТоварыМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	Операция_ЗаполнитьТЧ_ФормированиеАТК_ВТ_ОставитьПодходящиеКоды(МенеджерВТ);
	
	ГруппаТНВЭД = ОписаниеОперации.ДопРеквизиты.ГруппаТНВЭД;
	Если Не ЗначениеЗаполнено(ГруппаТНВЭД) Тогда
		ГруппаТНВЭД = ТаблицаКодов_ВТ_ПервыйКодГруппыТНВЭД(МенеджерВТ);
	КонецЕсли;
	Операция_ЗаполнитьТЧ_ФормированиеАТК_ВТ_ОставитьПодходящийКодГруппыТНВЭД(МенеджерВТ, ГруппаТНВЭД);
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаКодов.Товар КАК Товар,
	|	ТаблицаКодов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТаблицаКодов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ТаблицаКодов.КлючКода КАК КлючКода
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|ГДЕ
	|	ТаблицаКодов.Товар.ВидПродукции = &ВидПродукции";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", ТекстЗапросаВыбратьПервые(ДопустимоеКоличествоКодов));
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.УстановитьПараметр("ГруппаТНВЭД", ГруппаТНВЭД);
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ПоляТоваров = "Товар, КлючНоменклатуры1С, КлючСтрокиДокумента";
	Операция_ЗаполнитьТаблицуТоваров(ОписаниеОперации.Товары, ТаблицаЗапроса, ПоляТоваров);
	Для каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		СтрТовара.КодТНВЭД = СтрТовара.Товар.КодТНВЭД;
	КонецЦикла;
	
	Отбор = Новый Структура(ПоляТоваров);
	ОписаниеОперации.Товары.Индексы.Добавить(ПоляТоваров);
	Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрЗапроса);
		СтрТовара = ОписаниеОперации.Товары.НайтиСтроки(Отбор)[0];
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = СтрЗапроса.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ФормированиеАТК_ВТ_ОставитьПодходящиеКоды(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.Статус = &СтатусНанесен
	|	И Т.ОбщийТипУпаковки <> &АТК
	|	И Т.Товар.ВидПродукции В(&ВидыПродукцииАТК)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Результат КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ВидыПродукцииАТК", ДопустимыеВидыПродукцииДляФормированияАТК());
	Запрос.УстановитьПараметр("СтатусНанесен", Перечисление_СтатусыКодов().Нанесен);
	Запрос.УстановитьПараметр("АТК", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК);
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ФормированиеАТК_ВТ_ОставитьПодходящийКодГруппыТНВЭД(МенеджерВТ, КодГруппыТНВЭД)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.*
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК КодГруппыТНВЭД
	|		ПО ТаблицаКодов.Товар = КодГруппыТНВЭД.Объект
	|			И (КодГруппыТНВЭД.ИмяРеквизита = ""ГруппаТНВЭД"")
	|ГДЕ
	|	КодГруппыТНВЭД.Значение = &КодГруппыТНВЭД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Результат КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("КодГруппыТНВЭД", КодГруппыТНВЭД);
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_РасформированиеАТК(ОписаниеОперации, ТаблицаКодов)
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	Операция_ЗаполнитьТЧ_РасформированиеАТК_ВТ_ОставитьПодходящиеКоды(МенеджерВТ);
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	ЕСТЬNULL(Т.Товар.ВидПродукции, Т.ВидПродукции) = &ВидПродукции");
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	Пока Выборка.Следующий() Цикл
		ТаблицаКодов.Добавить().КлючКода = Выборка.КлючКода;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_РасформированиеАТК_ВТ_ОставитьПодходящиеКоды(МенеджерВТ)
	
