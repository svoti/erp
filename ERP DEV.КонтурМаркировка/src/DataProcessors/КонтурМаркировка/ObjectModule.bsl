Функция НастройкиРабочегоСтола_Прочитать() Экспорт
	
	Результат = Новый_НастройкиРабочегоСтола();
	
	Пользователь = ТекущийПользовательМаркировки();
	ИмяСправочника = Перечисление_ИменаДопСправочников().НастройкиРабочегоСтола;
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника, "Пользователь", Пользователь);
	Если ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
		ЗаполнитьЗначенияСвойств(Результат, ДанныеИБ.ДопРеквизиты, , "БлокиРабочегоСтола");
		ЗаполнитьПоляСтруктуры(Результат.БлокиРабочегоСтола, ДанныеИБ.ДопРеквизиты.БлокиРабочегоСтола, , , Истина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура НастройкиРабочегоСтола_Записать(ОписаниеНастроек) Экспорт
	
	Пользователь = ТекущийПользовательМаркировки();
	ИмяСправочника = Перечисление_ИменаДопСправочников().НастройкиРабочегоСтола;
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника, "Пользователь", Пользователь);
	ДанныеИБ.Наименование = Пользователь.Наименование;
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	Для каждого Элемент Из ОписаниеНастроек Цикл
		ДанныеИБ.ДопРеквизиты.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	ДанныеИБ.ДопРеквизиты.Пользователь = Пользователь;
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

Функция НастройкиРабочегоСтола_ТипыДокументов()
	
	Результат = Новый Массив;
	
	Для Каждого Элемент Из НастройкиРабочегоСтола_Прочитать().ТипыДокументов Цикл
		Результат.Добавить(НастройкиДокументаУчета_Прочитать(Элемент).ТипДокумента);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_НастройкиРабочегоСтола() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Пользователь");
	
	БлокиРабочегоСтола = Новый Структура;
	
	// Документы учета
	БлокДокументыУчета = Новый_НастройкиРабочегоСтола_НастройкаБлока("Документы учета");
	БлокДокументыУчета.ЭлементыБлока.Вставить("Строка1"
	, Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Новые"));
	БлокДокументыУчета.ЭлементыБлока.Вставить("Строка2"
	, Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("В работе"));
	БлокДокументыУчета.ЭлементыБлока.Вставить("Строка3"
	, Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Не подобраны товары"));
	БлокДокументыУчета.ЭлементыБлока.Вставить("Строка4"
	, Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Отсутствуют коды"));
	
	// Заказ и печать кодов
	БлокЗаказПечатьКодов = Новый_НастройкиРабочегоСтола_НастройкаБлока("Заказ и печать кодов");
	БлокЗаказПечатьКодов.ЭлементыБлока.Вставить(
	"Строка1", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Заказ кодов"));
	БлокЗаказПечатьКодов.ЭлементыБлока.Вставить(
	"Строка3", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Печать кодов"));
	
	// Маркировка
	БлокМаркировка = Новый_НастройкиРабочегоСтола_НастройкаБлока("Маркировка");
	БлокМаркировка.ЭлементыБлока.Вставить(
	"Строка1", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Отчет о нанесении"));
	БлокМаркировка.ЭлементыБлока.Вставить(
	"Строка2", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Ввод в оборот"));
	БлокМаркировка.ЭлементыБлока.Вставить(
	"Строка3", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Перемаркировка"));
	БлокМаркировка.ЭлементыБлока.Вставить(
	"Строка4", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Корректировка сведений о кодах"));
	
	// Приемка
	БлокПриемка = Новый_НастройкиРабочегоСтола_НастройкаБлока("Приемка");
	БлокПриемка.ЭлементыБлока.Вставить(
	"Строка1", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Входящий УПД"));
	БлокПриемка.ЭлементыБлока.Вставить(
	"Строка3", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Уведомление о приемке"));
	
	// Товародвижение
	БлокТовародвижение = Новый_НастройкиРабочегоСтола_НастройкаБлока("Товародвижение");
	ЭлементыБлока = БлокТовародвижение.ЭлементыБлока;
	ЭлементыБлока.Вставить(
	"Строка1", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Вывод из оборота"));
	ЭлементыБлока.Вставить(
	"Строка2", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Отчет о нанесении"));
	ЭлементыБлока.Вставить(
	"Строка3", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Возврат в оборот"));
	ЭлементыБлока.Вставить(
	"Строка4", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Сообщение об отгрузке"));
	ЭлементыБлока.Вставить(
	"Строка5", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Уведомление о состоянии кодов"));
	
	// Транспортные упаковки
	БлокТранспортныеУпаковки = Новый_НастройкиРабочегоСтола_НастройкаБлока("Транспортные упаковки");
	ЭлементыБлока = БлокТранспортныеУпаковки.ЭлементыБлока;
	ЭлементыБлока.Вставить(
	"Строка1", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Регистрация агрегатов"));
	ЭлементыБлока.Вставить(
	"Строка2", Новый_НастройкиРабочегоСтола_НастройкаЭлементаБлока("Наполнение агрегатов на ТСД"));
	
	// 1 строка
	БлокиРабочегоСтола.Вставить("БлокДокументыУчета", БлокДокументыУчета);
	БлокиРабочегоСтола.Вставить("БлокЗаказПечатьКодов", БлокЗаказПечатьКодов);
	БлокиРабочегоСтола.Вставить("БлокМаркировка", БлокМаркировка);
	
	// 2 строка
	БлокиРабочегоСтола.Вставить("БлокПриемка", БлокПриемка);
	БлокиРабочегоСтола.Вставить("БлокТовародвижение", БлокТовародвижение);
	
	// 3 строка
	БлокиРабочегоСтола.Вставить("БлокТранспортныеУпаковки", БлокТранспортныеУпаковки);
	
	Результат.Вставить("БлокиРабочегоСтола", БлокиРабочегоСтола);
	
	Результат.Вставить("ТипыДокументов", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

