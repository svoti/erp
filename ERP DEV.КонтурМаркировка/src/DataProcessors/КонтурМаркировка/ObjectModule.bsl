	|		ПО ПустойКлюч.Ключ = КодыМаркировки.КлючИнформацииОКоде
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПустойКлюч");
	ЗапросПорция.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ЗапросКоды = Новый Запрос(
	"ВЫБРАТЬ
	|	СвязиКлючейКодов.КлючАгрегата КАК КлючАгрегата,
	|	СвязиКлючейКодов.КлючСтатусаКода КАК КлючСтатусаКода,
