	ИмяФайла = ИмяФайлаМодуляКонтроль();
	ИмяМакета = ИмяМакетаПоИмениФайла(ИмяФайла);
	Результат = ДвоичныеДанныеВложеннойОбработки(ИмяФайла, ИмяМакета);
	
	Возврат Результат;
	
КонецФункции

Функция ДвоичныеДанныеБиблиотекиКонтроляИзСервиса(Версия)
	
	ПродуктКонтроля = Перечисление_ПродуктыВСервисеОбновлений().БиблиотекаКонтроля;
	ТипКонтента = Перечисление_ТипыКонтентовВСервисеОбновлений().Обработка;
	
	Попытка
		Результат = СервисОбновлений_ФайлВерсии(ПродуктКонтроля, Версия, ТипКонтента);
	Исключение
		Действие = НСтр("ru = 'Получение из сервиса файла библиотеки контроля'");
		ОбработатьОшибку(Действие, ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияБиблиотекиКонтроляИзСервиса(ВерсияМодуля)
	
	Продукт = Перечисление_ПродуктыВСервисеОбновлений().Модуль;
	
	Попытка
		Ответ = СервисОбновлений_ОписаниеВерсии(Продукт, ВерсияМодуля);
		description = ЗначениеИзСтрокиJSON(СвойствоСтруктуры(Ответ, "description"));
	Исключение
		Действие = НСтр("ru = 'Обновление библиотеки контроля'");
		ОбработатьОшибку(Действие, ИнформацияОбОшибке());
	КонецПопытки;
	
	Результат = СвойствоСтруктуры(description, "controlVersion", "");
	
	Возврат Результат;
	
КонецФункции

Функция ХешСуммаБиблиотекиКонтроляИзСервиса(Версия)
	
	Продукт = Перечисление_ПродуктыВСервисеОбновлений().БиблиотекаКонтроля;
	ТипКонтента = Перечисление_ТипыКонтентовВСервисеОбновлений().Обработка;
	
	Попытка
		Ответ = СервисОбновлений_ОписаниеВерсии(Продукт, Версия);
	Исключение
		Действие = НСтр("ru = 'Получение из сервиса хеш-суммы библиотеки контроля'");
		ОбработатьОшибку(Действие, ИнформацияОбОшибке());
	КонецПопытки;
	
	content = СвойствоСтруктуры(Ответ, "content");
	item = СвойствоСтруктуры(content, ТипКонтента);
	
	Возврат СвойствоСтруктуры(item, "md5hash", "");
	
КонецФункции

Процедура ОбновитьБиблиотекуКонтроля(ОдинРазВДень = Истина, СкачатьБиблиотеку = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ОписаниеДоработокМодуля()) Тогда
		Возврат;
	КонецЕсли;
	
	ВерсияМодуля = ВерсияОбработки();
	ВерсияПоУмолчанию = ВерсияБиблиотекиКонтроляПоУмолчанию();
	УстановленнаяВерсия = ВерсияУстановленнойБиблиотекиКонтроля();
	УстановленнаяХешСумма = ХешСуммаУстановленнойБиблиотекиКонтроля();
	ДатаПроверки = ДатаПроверкиОбновленияБиблиотекиКонтроля();
	ТекущаяДатаПроверки = ТекущаяУниверсальнаяДата();
	ПроверитьПринудительно = (СравнитьВерсии(УстановленнаяВерсия, ВерсияПоУмолчанию) < 0);
	
	Если Не ПроверитьПринудительно И ОдинРазВДень
		И НачалоДня(ДатаПроверки) = НачалоДня(ТекущаяДатаПроверки) Тогда
		Возврат;
	КонецЕсли;
	
	ЗафиксироватьДатуПроверкиОбновленияБиблиотекиКонтроля(ТекущаяДатаПроверки);
	
	ВерсияИзСервиса = ВерсияБиблиотекиКонтроляИзСервиса(ВерсияМодуля);
	Если Не ЗначениеЗаполнено(ВерсияИзСервиса) Тогда
		ВерсияИзСервиса = ВерсияПоУмолчанию;
	КонецЕсли;
	
	ХешСуммаИзСервиса = ХешСуммаБиблиотекиКонтроляИзСервиса(ВерсияИзСервиса);
	
	Если СкачатьБиблиотеку Тогда
		ДвоичныеДанные = ДвоичныеДанныеБиблиотекиКонтроляИзСервиса(ВерсияИзСервиса);
		Если Не ЗначениеЗаполнено(ДвоичныеДанные) Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось скачать из сервиса обновлений библиотеку контроля № %1'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ВерсияИзСервиса);
		КонецЕсли;
	ИначеЕсли (ВерсияИзСервиса = УстановленнаяВерсия Или Не ЗначениеЗаполнено(ВерсияИзСервиса))
		И (ХешСуммаИзСервиса = УстановленнаяХешСумма Или Не ЗначениеЗаполнено(ХешСуммаИзСервиса)) Тогда
		Возврат; // Ничего не изменилось, скачивать не нужно
	Иначе
		ДвоичныеДанные = ДвоичныеДанныеБиблиотекиКонтроляИзСервиса(ВерсияИзСервиса);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		ЗаписатьБиблиотекуКонтроля(ВерсияИзСервиса, ДвоичныеДанные, ХешСуммаИзСервиса);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗафиксироватьДатуПроверкиОбновленияБиблиотекиКонтроля(ДатаПроверки)
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(Перечисление_ИменаДопСправочников().БиблиотекаКонтроля);
	ДанныеИБ.ДоПреквизиты.Вставить("ДатаПроверки", ДатаПроверки);
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

Процедура ЗаписатьБиблиотекуКонтроля(Версия, ДвоичныеДанные, ХешСумма)
	
	ТипФайла = Перечисление_ТипыФайлов().БиблиотекаКонтроля;
	ИмяСправочника = Перечисление_ИменаДопСправочников().БиблиотекаКонтроля;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
		ДанныеИБ.Наименование = ИмяСправочника;
		ДанныеИБ.Комментарий = Версия;
		ДанныеИБ.ДопРеквизиты.Вставить("ХешСумма", ХешСумма);
		ДопСправочник_Записать(ДанныеИБ);
		
		ОписаниеФайла = Новый_ОписаниеФайла(ТипФайла);
		ОписаниеФайла.ИмяФайла = ИмяФайлаМодуляКонтроль();
		ОписаниеФайла.ДанныеФайла = ДвоичныеДанные;
		ОписаниеФайла.ВладелецФайла = ДанныеИБ.Ссылка;
		ОписаниеФайла.Идентификатор = ДанныеИБ.Ссылка.УникальныйИдентификатор();
		Файл_Записать(ОписаниеФайла);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Запись библиотеки контроля'");
		ДопИнформация = Новый Структура("Версия", Версия);
		ТекстСообщения = НСтр("ru = 'Не удалось записать в базу данных библиотеку контроля версии %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, Версия);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #Область БиблиотекаПлагинов

Функция МодульБиблиотекаПлагинов() Экспорт
	
	ИмяФайла = ИмяФайлаМодуляБиблиотекаПлагинов();
	
	Если НастройкиМодуля().РежимОтладки Тогда
		Попытка
			Результат = ОбъектВложеннойОбработки(ИмяФайла);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если Результат = Неопределено И МодульМаркировкиОткрытИзКонфигурации() Тогда
		Результат = ОбъектВложеннойОбработкиИзКонфигурации(ИмяФайла);
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = ОбъектВложеннойОбработки(ИмяФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеМодуляБиблиотекаПлагинов()
	
	Результат = Новый_ОписаниеОбработки();
	Результат.ПутьКФайлу = ПутьКФайлуМодуляБиблиотекаПлагинов();
	Результат.ДвоичныеДанные = ДвоичныеДанныеМодуляБиблиотекаПлагинов();
	Результат.ИмяОбработки = ИмяОбработкиПоИмениФайла(ИмяФайлаМодуляБиблиотекаПлагинов());
	
	Возврат Результат;
	
КонецФункции

Функция ДвоичныеДанныеМодуляБиблиотекаПлагинов()
	
	ИмяФайла = ИмяФайлаМодуляБиблиотекаПлагинов();
	ИмяМакета = ИмяМакетаПоИмениФайла(ИмяФайла);
	Результат = ДвоичныеДанныеВложеннойОбработки(ИмяФайла, ИмяМакета);
	
	Возврат Результат;
	
КонецФункции

Функция ПутьКФайлуМодуляБиблиотекаПлагинов()
	
	ИмяФайла = ИмяФайлаМодуляБиблиотекаПлагинов();
	Результат = ПутьКФайлуВложеннойОбработки(ИмяФайла);
	
	Возврат Результат;
	
КонецФункции

Функция ИмяФайлаМодуляБиблиотекаПлагинов()
	
	Возврат "БиблиотекаПлагинов.epf";
	
КонецФункции

// #КонецОбласти

// #Область ПодключаемыйМодуль

Функция МодульПМ(Знач Настройки = Неопределено, ВызыватьИсключение = Ложь)
	
	КлючКэш = "ПодключаемыйМодуль";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Настройки = Неопределено Тогда
		Настройки = НастройкиМодуля();
	КонецЕсли;
	
	Если Не Настройки.ПМ_Использовать Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	Попытка
		
		Если Настройки.ПМ_Расположение = ВариантыРасположения.НаДиске Тогда
			Результат = СоздатьПодключаемыйМодульИзФайла(Настройки.ПМ_Путь);
		ИначеЕсли Настройки.ПМ_Расположение = ВариантыРасположения.ВСправочнике Тогда
			Результат = СоздатьПодключаемыйМодульИзСправочника(Настройки.ПМ_Ссылка);
		Иначе
			Результат = СоздатьПодключаемыйМодульИзКонфигурации(Настройки.ПМ_ИмяОбработки);
		КонецЕсли;
		
		ПроверитьМинимальнуюВерсиюПМ(Результат);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Загрузка подключаемого модуля'");
		ТекстСообщения = НСтр("ru = 'Не удалось загрузить подключаемый модуль'");
		ОбработатьОшибку(Действие, Ошибка, Настройки, ТекстСообщения);
		
		Если ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
		
	КонецПопытки;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьПодключаемыйМодульИзФайла(ПутьКФайлу)
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не указан путь к файлу подключаемого модуля ""%1""'"), ПутьКФайлу);
	КонецЕсли;
	
	Если Не МодульОбщегоНазначения().ФайлСуществует(ПутьКФайлу) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не найден файл подключаемого модуля ""%1""'"), ПутьКФайлу);
	КонецЕсли;
	
	Результат = МодульОбщегоНазначения().СоздатьВнешнююОбработкуБезПредупреждений(ПутьКФайлу);
	
	СведенияОбОбработке = Результат.СведенияОВнешнейОбработке();
	
	Если Не МассивСодержитЗначение(ДопустимыеНаименованияОбработкиПМ(), СведенияОбОбработке.Наименование) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Обработка не является подключаемым модулем ""%1""'"), ПутьКФайлу);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьПодключаемыйМодульИзСправочника(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение НСтр(
		"ru = 'Не указан элемент справочника с подключаемым модулем'");
	КонецЕсли;
	
	ПолеХранилища = Интеграция_ИмяХранилищаФайлаВнешнейОбработки(Ссылка);
	Если Не ЗначениеЗаполнено(ПолеХранилища) Тогда
		ИмяСправочника = Ссылка.Метаданные().Имя;
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'В справочнике ""%1"" не удалось найти реквизит с файлом подключаемого модуля ""%1""'")
		, ИмяСправочника, Ссылка);
	КонецЕсли;
	
	ДвоичныеДанные = ЗначениеРеквизитаОбъектаЛок(Ссылка, ПолеХранилища).Получить();
	
	Если Не ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не заполнен файл подключаемого модуля ""%1""'"), Ссылка);
	КонецЕсли;
	
	Результат = МодульОбщегоНазначения().СоздатьВнешнююОбработкуБезПредупреждений(ДвоичныеДанные);
	
	СведенияОбОбработке = Результат.СведенияОВнешнейОбработке();
	
	Если Не МассивСодержитЗначение(ДопустимыеНаименованияОбработкиПМ(), СведенияОбОбработке.Наименование) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Обработка не является подключаемым модулем ""%1""'"), Ссылка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьПодключаемыйМодульИзКонфигурации(ИмяОбработки)
	
	Если Не ЗначениеЗаполнено(ИмяОбработки) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не указано имя обработки подключаемого модуля ""%1""'"), ИмяОбработки);
	КонецЕсли;
		
	Если Метаданные.Обработки.Найти(ИмяОбработки) = Неопределено Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'В составе конфигурации не найдена обработка подключаемого модуля ""%1""'"), ИмяОбработки);
	КонецЕсли;
	
	Результат = МодульОбщегоНазначения().СоздатьОбработкуИзКонфигурации(ИмяОбработки);
	
	СведенияОбОбработке = Результат.СведенияОВнешнейОбработке();
	
	Если Не МассивСодержитЗначение(ДопустимыеНаименованияОбработкиПМ(), СведенияОбОбработке.Наименование) Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Обработка не является подключаемым модулем ""%1""'"), ИмяОбработки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеНаименованияОбработкиПМ()
	
	Результат = Новый Массив;
	Результат.Добавить("Контур.Маркировка (подключаемый модуль)");
	Результат.Добавить("Подключаемый модуль (Контур.Маркировка)");
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьПодключениеПМ(Настройки) Экспорт
	
	Попытка
		МодульПМ = МодульПМ(Настройки, Истина);
		Результат = Истина;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользоватьПМ()
	
	Возврат НастройкиМодуля().ПМ_Использовать;
	
КонецФункции

Функция СобытияПодключаемогоМодуля() Экспорт
	
	КлючКэш = "СобытияПодключаемогоМодуля";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	МодульПМ = МодульПМ();
	ВерсияПМ = ВерсияОбработкиПМ(МодульПМ);
	ИменаСобытийПМ = Перечисление_ИменаСобытийПодключаемогоМодуля();
	
	Если Не ЗначениеЗаполнено(ВерсияПМ) Тогда
		Результат = Новый Массив;
	ИначеЕсли СравнитьВерсии(ВерсияПМ, "3.20") < 0 Тогда
		Результат = НовыйМассив(ИменаСобытийПМ.ВсеСобытия);
	Иначе
		
		ОчиститьОсновнойМодуль = Ложь;
		ОчиститьОсновнойМодульПМ = Ложь;
		
		Попытка
			
			Если ОсновнойМодуль = Неопределено Тогда
				ОчиститьОсновнойМодуль = Истина;
				ОсновнойМодуль = ЭтотОбъект; // Поддержка вызова ОсновнойМодуль.ОсновнойМодуль для ОФ
			КонецЕсли;
			Если МодульПМ.ОсновнойМодуль = Неопределено Тогда
				ОчиститьОсновнойМодульПМ = Истина;
				МодульПМ.ОсновнойМодуль = ЭтотОбъект;
			КонецЕсли;
			
			Результат = Новый Массив;
			ДополнитьМассив(Результат, МодульПМ.СобытияПодключаемогоМодуля());
			УдалитьЗначениеИзМассива(Результат, ИменаСобытийПМ.ВсеСобытия);
			
			Если ОчиститьОсновнойМодульПМ Тогда
				МодульПМ.ОсновнойМодуль = Неопределено;
			КонецЕсли;
			Если ОчиститьОсновнойМодуль Тогда
				ОсновнойМодуль = Неопределено;
			КонецЕсли;
			
		Исключение
			
			Если ОчиститьОсновнойМодульПМ Тогда
				МодульПМ.ОсновнойМодуль = Неопределено;
			КонецЕсли;
			Если ОчиститьОсновнойМодуль Тогда
				ОсновнойМодуль = Неопределено;
			КонецЕсли;
			
			Ошибка = ИнформацияОбОшибке();
			
		КонецПопытки;
		
	КонецЕсли;
	
	Результат = Новый ФиксированныйМассив(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СобытиеОбрабатываетсяПМ(ИмяСобытия, ПараметрыСобытия)
	
	КлючКэш = "СобытиеОбрабатываетсяПМ: " + ИмяСобытия;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	СобытияПМ = СобытияПодключаемогоМодуля();
	ИменаСобытийПМ = Перечисление_ИменаСобытийПодключаемогоМодуля();
	РазрешеныВсеСобытия = МассивСодержитЗначение(СобытияПМ, ИменаСобытийПМ.ВсеСобытия);
	РазрешеноТекущееСобытие = МассивСодержитЗначение(СобытияПМ, ИмяСобытия);
	
	Если РазрешеноТекущееСобытие Тогда
		Метрика_Функциональность_СобытиеПМ(ИмяСобытия, ПараметрыСобытия);
	КонецЕсли;
	
	Результат = РазрешеноТекущееСобытие Или РазрешеныВсеСобытия;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияОбработкиПМ(Знач МодульПМ = Неопределено) Экспорт
	
	Если МодульПМ = Неопределено Тогда
		МодульПМ = МодульПМ();
	КонецЕсли;
	
	Если МодульПМ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СведенияОбОбработке = МодульПМ.СведенияОВнешнейОбработке();
	
	Возврат СведенияОбОбработке.Версия;
	
КонецФункции

Функция ПутьКФормеМодуляКлиентаПМ() Экспорт
	
	Если СравнитьВерсии(ВерсияОбработкиПМ(), "2.8") < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = МодульПМ().Метаданные().ПолноеИмя() + ".Форма.МодульКлиента";
	
	Возврат Результат;
	
КонецФункции

Функция ДополнительныеПараметрыПМ(Настройки) Экспорт
	
	Результат = Новый Структура;
	
	МодульПМ = МодульПМ(Настройки);
	Если МодульПМ = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОчиститьОсновнойМодуль = Ложь;
	ОчиститьОсновнойМодульПМ = Ложь;
	
	Попытка
		
		Если ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодуль = Истина;
			ОсновнойМодуль = ЭтотОбъект; // Поддержка вызова ОсновнойМодуль.ОсновнойМодуль для ОФ
		КонецЕсли;
		Если МодульПМ.ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодульПМ = Истина;
			МодульПМ.ОсновнойМодуль = ЭтотОбъект;
		КонецЕсли;
		
		Результат = МодульПМ.ДополнительныеПараметры();
		
		Если ОчиститьОсновнойМодульПМ Тогда
			МодульПМ.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		Если ОчиститьОсновнойМодуль Тогда
			ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
	Исключение
		
		Если ОчиститьОсновнойМодульПМ Тогда
			МодульПМ.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		Если ОчиститьОсновнойМодуль Тогда
			ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
		Ошибка = ИнформацияОбОшибке();
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция БезопасныеДополнительныеПараметрыПМ(Настройки) Экспорт
	
	Результат = Новый Структура;
	
	МодульПМ = МодульПМ(Настройки);
	Если МодульПМ = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОчиститьОсновнойМодуль = Ложь;
	ОчиститьОсновнойМодульПМ = Ложь;
	
	Попытка
		
		Если ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодуль = Истина;
			ОсновнойМодуль = ЭтотОбъект; // Поддержка вызова ОсновнойМодуль.ОсновнойМодуль для ОФ
		КонецЕсли;
		Если МодульПМ.ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодульПМ = Истина;
			МодульПМ.ОсновнойМодуль = ЭтотОбъект;
		КонецЕсли;
		
		Результат = МодульПМ.БезопасныеДополнительныеПараметры();
		
		Если ОчиститьОсновнойМодульПМ Тогда
			МодульПМ.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		Если ОчиститьОсновнойМодуль Тогда
			ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
	Исключение
		
		Если ОчиститьОсновнойМодульПМ Тогда
			МодульПМ.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		Если ОчиститьОсновнойМодуль Тогда
			ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
		Ошибка = ИнформацияОбОшибке();
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьМинимальнуюВерсиюПМ(МодульПМ)
	
	ДопустимаяВерсия = "2.0.0";
	ТекущаяВерсия = ВерсияОбработкиПМ(МодульПМ);
	
	Если СравнитьВерсии(ДопустимаяВерсия, ТекущаяВерсия) > 0 Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Текущая версия подключаемого модуля (ПМ) не поддерживается.
		|Необходимо сохранить шаблон новой версии ПМ на диск и перенести в него доработки.
		|Текущая версия ПМ: %1
		|Требуется версия ПМ: %2 и выше'")
		, ТекущаяВерсия, ДопустимаяВерсия);
	КонецЕсли;
	
КонецПроцедуры

