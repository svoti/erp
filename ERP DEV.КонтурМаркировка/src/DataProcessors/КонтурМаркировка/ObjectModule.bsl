// Версия обработки в стандартном формате
//
// Возвращаемое значение:
//  Строка - версия в формате РР.ВВ.ФФ.СС, где:
//   * РР - номер редакции    - в рамках одной редакции гарантируется обратная совместимость;
//   * ВВ - номер версии      - новая функциональность (или несколько);
//   * ФФ - номер исправления - исправление ошибки;
Функция ВерсияОбработки() Экспорт
	
	Возврат "3.24.1";
	
КонецФункции

// Содержит признак того, что текущий модуль является тестовым
//
// Возвращаемое значение:
//  Булево - Истина, если это бета-версия модуля
//
Функция ЭтоБетаВерсия() Экспорт
	
	ЧастиВерсии = РазделитьСтроку(ВерсияОбработки(), ".");
	
	Возврат ЧастиВерсии[ЧастиВерсии.ВГраница()] = "0";
	
КонецФункции

// Содержит суть изменений, которые были сделаны в модуле под требования клиента
//
// Если описание заполнено:
// * Отключается автоматическое обновление модуля,
//   чтобы не потерять внесенные изменения;
// * В заголовке основной формы будет указано что модуль доработан;
// * В настройках модуля будет видна закладка с описанием доработок;
// 
// Возвращаемое значение:
//  Строка - описание изменений
//
Функция ОписаниеДоработокМодуля() Экспорт
	
	Возврат "";
	
КонецФункции

// Сведения о внешней обработке совместимые со стандартной подсистемой ДополнительныеОтчетыИОбработки
//
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * Версия          - Строка - версия обработки;
//   * Наименование    - Строка - представление для администратора (наименование элемента справочника),
//                                берется синоним объекта метаданных внешней обработки;
//   * Информация      - Строка - краткая информация о внешней обработке,
//                                берется комментарий объекта метаданных внешней обработки;
//   * БезопасныйРежим - Булево - признак подключения внешней обработки в безопасном режиме:
//                                 Игнорируется привилегированный режим
//                                 Запрещены внешние по отношению к платформе «1С:Предприятия» действия:
//                                  COM;
//                                  загрузка внешних компонент;
//                                  запуск внешних приложений и команд операционной системы;
//                                  доступ к файловой системе, кроме временных файлов;
//                                  доступ к Интернету.
//   * Вид             - Строка - содержит значение "ДополнительнаяОбработка";
//   * Команды         - ТаблицаЗначений - настройки команд, поставляемых внешней обработкой:
//      ** Идентификатор        - Строка- внутреннее имя команды;
//      ** Представление        - Строка- пользовательское представление команды;
//      ** Использование        - Строка- тип команды:
//                                         "ВызовКлиентскогоМетода",
//                                         "ВызовСерверногоМетода";
//      ** Модификатор          - Строка- дополнительная классификация команды;
//      ** ПоказыватьОповещение - Булево- если Истина, то при запуске команды выводится оповещение "Команда выполняется...";
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	МетаданныеОбработки = Метаданные();
	
	Результат = Новый Структура;
	Результат.Вставить("БезопасныйРежим", Ложь);
	Результат.Вставить("Наименование", МетаданныеОбработки.Синоним);
	Результат.Вставить("Информация", МетаданныеОбработки.Комментарий);
	Результат.Вставить("Команды", КомандыВнешнейОбработки());
	Результат.Вставить("Версия", ВерсияОбработки());
	Результат.Вставить("Вид", "ДополнительнаяОбработка");
	Результат.Вставить("ВерсияБСП", "1.2.1.4");
	
	Возврат Результат;
	
КонецФункции

// Версия подсистемы КонтурМаркировка, с которой может работать модуль
//
// Возвращаемое значение:
//  Строка
Функция ТребуемаяВерсияПодсистемы()
	
	Возврат "3.22.0";
	
КонецФункции

Функция КомандыВнешнейОбработки()
	
	МетаданныеОбработки = Метаданные();
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Представление", ТипСтрока);
	Результат.Колонки.Добавить("Идентификатор", ТипСтрока);
	Результат.Колонки.Добавить("Использование", ТипСтрока);
	Результат.Колонки.Добавить("Модификатор", ТипСтрока);
	Результат.Колонки.Добавить("ПоказыватьОповещение", ТипБулево);
	Результат.Колонки.Добавить("Скрыть", ТипБулево);
	
	Команды = Перечисление_КомандыОбработки();
	ПредставленияКоманд = Перечисление_ПредставленияКомандОбработки();
	ВариантыИспользования = Перечисление_ВариантыИспользованияКоманд();
	
	Если МетаданныеОбработки.Синоним = "Контур.Маркировка" Тогда
		Стр = Результат.Добавить();
		Стр.Идентификатор = Команды.ОткрытьФорму;
		Стр.Представление = МетаданныеОбработки.Синоним;
		Стр.Использование = ВариантыИспользования.ОткрытиеФормы;
	КонецЕсли;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ВыполнитьРегламентныеДействия;
	Стр.Представление = ПредставленияКоманд.ВыполнитьРегламентныеДействия;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбменССервисом;
	Стр.Представление = ПредставленияКоманд.ОбменССервисом;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновлениеМодуля;
	Стр.Представление = ПредставленияКоманд.ОбновлениеМодуля;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОчисткаУстаревшихДанных;
	Стр.Представление = ПредставленияКоманд.ОчисткаУстаревшихДанных;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновитьДанныеПодсистемы;
	Стр.Представление = ПредставленияКоманд.ОбновитьДанныеПодсистемы;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Ложь;
	Стр.Скрыть = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновитьСтатусыКодовДокумента;
	Стр.Представление = ПредставленияКоманд.ОбновитьСтатусыКодовДокумента;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Ложь;
	Стр.Скрыть = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ПроверитьКодыДокумента;
	Стр.Представление = ПредставленияКоманд.ПроверитьКодыДокумента;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Ложь;
	Стр.Скрыть = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновлениеПлагинов;
	Стр.Представление = ПредставленияКоманд.ОбновлениеПлагинов;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	Стр.Скрыть = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновлениеТарифов;
	Стр.Представление = ПредставленияКоманд.ОбновлениеТарифов;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	Стр.Скрыть = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_КомандыОбработки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОткрытьФорму"					, "ОткрытьФорму");
	Результат.Вставить("ВыполнитьРегламентныеДействия"	, "ВыполнитьРегламентныеДействия");
	Результат.Вставить("ОбменССервисом"					, "ОбменССервисом");
	Результат.Вставить("ОбновлениеМодуля"				, "ОбновлениеМодуля");
	Результат.Вставить("ОчисткаУстаревшихДанных"		, "ОчисткаУстаревшихДанных");
	Результат.Вставить("ОбновлениеПлагинов"				, "ОбновлениеПлагинов");
	Результат.Вставить("ОбновлениеТарифов"				, "ОбновлениеТарифов");
	
	// Служебные команды
	Результат.Вставить("ОбновитьДанныеПодсистемы"		, "ОбновитьДанныеПодсистемы");
	Результат.Вставить("ОбновитьСтатусыКодовДокумента"	, "ОбновитьСтатусыКодовДокумента");
	Результат.Вставить("ПроверитьКодыДокумента"			, "ПроверитьКодыДокумента");
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Перечисление_ПредставленияКомандОбработки()
	
	Команды = Перечисление_КомандыОбработки();
	
	Результат = Новый Структура;
	Результат.Вставить(Команды.ВыполнитьРегламентныеДействия, НСтр("ru = 'Регламентные действия'"));
	Результат.Вставить(Команды.ОбменССервисом				, НСтр("ru = 'Обмен с сервисом'"));
	Результат.Вставить(Команды.ОбновлениеМодуля				, НСтр("ru = 'Обновление модуля'"));
	Результат.Вставить(Команды.ОчисткаУстаревшихДанных		, НСтр("ru = 'Очистка устаревших данных'"));
	Результат.Вставить(Команды.ОбновлениеПлагинов			, НСтр("ru = 'Обновление плагинов'"));
	Результат.Вставить(Команды.ОбновлениеТарифов			, НСтр("ru = 'Обновление тарифов'"));
	
	// Служебные команды
	Результат.Вставить(Команды.ОбновитьДанныеПодсистемы		, НСтр("ru = 'Обновить данные подсистемы (служебная)'"));
	Результат.Вставить(Команды.ОбновитьСтатусыКодовДокумента, НСтр("ru = 'Обновить статусы кодов документа (служебная)'"));
	Результат.Вставить(Команды.ПроверитьКодыДокумента		, НСтр("ru = 'Проверить коды документа (служебная)'"));
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Перечисление_ВариантыИспользованияКоманд()
	
	Результат = Новый Структура;
	Результат.Вставить("ОткрытиеФормы", "ОткрытиеФормы");
	Результат.Вставить("ВызовСерверногоМетода", "ВызовСерверногоМетода");
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// #КонецОбласти // СведенияОВнешнейОбработке

// #Область СлужебныйПрограммныйИнтерфейс

// Выполняет команду обработки как в БСП
//
// Параметры:
//  ИдентификаторКоманды - Строка - см. Перечисление_КомандыОбработки();
//  ПараметрыКоманды - Структура - параметры для выполнения команды;
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыКоманды = Неопределено) Экспорт
	
	Если Не МодульИнициализирован() Тогда
		Инициализировать();
	КонецЕсли;
	
	Если ВыполняетсяОбновлениеДанныхПодсистемы() Тогда
		Возврат;
	КонецЕсли;
	
	Команды = Перечисление_КомандыОбработки();
	
	Если ИдентификаторКоманды = Команды.ВыполнитьРегламентныеДействия Тогда
		
		ВыполнитьРегламентныеДействия(ПараметрыКоманды);
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОчисткаУстаревшихДанных Тогда
		
		ОчиститьУстаревшиеДанные();
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновитьДанныеПодсистемы Тогда
		
		ОбновитьДанныеПодсистемы();
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновитьСтатусыКодовДокумента Тогда
		
		ДокументУчета = СвойствоСтруктуры(ПараметрыКоманды, "ДокументУчета");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ДокументУчета_ОбновитьСтатусыКодов(ДокументУчета);
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = Команды.ПроверитьКодыДокумента Тогда
		
		ДокументУчета = СвойствоСтруктуры(ПараметрыКоманды, "ДокументУчета");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ДокументУчета_ПроверитьКоды(ДокументУчета);
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбменССервисом Тогда
		
		КонтекстОбмена = СвойствоСтруктуры(ПараметрыКоманды, "КонтекстОбмена");
		
		Если ЗначениеЗаполнено(КонтекстОбмена) Тогда
			ВыполнитьОбменССервисом(КонтекстОбмена);
		Иначе
			ВыполнитьОбменПоВсемОрганизациям();
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновлениеМодуля Тогда
		
		ОбновитьМодуль();
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновлениеПлагинов Тогда
		
		ОбновитьПлагины();
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновлениеТарифов Тогда
		
		ОбновитьИнформациюОТарифах();
		
	Иначе
		ТекстОшибки = НСтр("ru = 'Неизвестный идентификатор команды: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ИдентификаторКоманды);
	КонецЕсли;
	
	ОтправитьМетрики();
	
КонецПроцедуры

// Вызывает одноименное событие в ПМ
//
// Параметры:
//  ДопПараметры - Произвольный - дополнительные параметры, которые можно передать в ПМ
//
Процедура ВыполнитьРегламентныеДействия(ДопПараметры = Неопределено) Экспорт
	
	МодульЯдро().ВыполнитьРегламентныеДействия(ДопПараметры);
	
КонецПроцедуры

// Сбрасывает кэш настроек модуля и включает использование mock
//
Процедура ВключитьРежимТестирования() Экспорт
	
	ОбновитьКэш = Истина;
	НастройкиМодуля = НастройкиМодуля(ОбновитьКэш);
	НастройкиМодуля.РежимТестирования = Истина;
	НастройкиМодуля_Записать(НастройкиМодуля);
	
КонецПроцедуры

// Сбрасывает кэш настроек модуля и включает режим отладки модуля
//
// Параметры:
//  КаталогОтладки - Строка - каталог с вложенными обработками;
//
Процедура ВключитьРежимОтладки(КаталогОтладки = "") Экспорт
	
	ОбновитьКэш = Истина;
	НастройкиМодуля = НастройкиМодуля(ОбновитьКэш);
	НастройкиМодуля.РежимОтладки = Истина;
	НастройкиМодуля.КаталогОтладки = КаталогОтладки;
	НастройкиМодуля_Записать(НастройкиМодуля);
	
КонецПроцедуры

// #Область БиблиотекаПлагинов

Процедура КонтурПлагины_ОбработатьСлужебнуюКоманду(ИмяКоманды, ПараметрыКоманды) Экспорт
	
	Контекст = КонтурПлагины_КонтекстВызова();
	
	МодульБиблиотекаПлагинов().ОбработатьСлужебнуюКоманду(ИмяКоманды, ПараметрыКоманды, Контекст);
	
КонецПроцедуры

Процедура КонтурПлагины_ОбработатьСлужебноеСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка) Экспорт
	
	ИмяСобытияНРег = НРег(ИмяСобытия);
	СтандартнаяОбработка = Ложь;
	
	Если ИмяСобытияНРег = НРег("ПриПолученииИдентификатораПроекта") Тогда
		
		ПараметрыСобытия.Результат = КонтурПлагины_ИдентификаторПроекта();
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриПолученииСпискаЗагруженныхПлагинов") Тогда
		
		КонтурПлагины_ПриПолученииСпискаЗагруженныхПлагинов(ПараметрыСобытия);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриВыполненииHTTPЗапроса") Тогда
		
		КонтурПлагины_ПриВыполненииHTTPЗапроса(
			ПараметрыСобытия.ОписаниеЗапроса,
			ПараметрыСобытия.ОписаниеОтвета
		);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриПроверкеВозможностиНастройки") Тогда
		
		КонтурПлагины_ПриПроверкеВозможностиНастройки(ПараметрыСобытия);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриЗагрузкеПлагина") Тогда
		
		КонтурПлагины_ПриЗагрузкеПлагина(ПараметрыСобытия);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПрочитатьФайлПлагина") Тогда
		
		КонтурПлагины_ПрочитатьФайлПлагина(ПараметрыСобытия);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриУдаленииПлагина") Тогда
		
		КонтурПлагины_ПриУдаленииПлагина(ПараметрыСобытия);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриВключенииПлагина") Тогда
		
		КонтурПлагины_ПриВключенииПлагина(ПараметрыСобытия);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриОтключенииПлагина") Тогда
		
		КонтурПлагины_ПриОтключенииПлагина(ПараметрыСобытия);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриПолученииНастроекПлагина") Тогда
		
		КонтурПлагины_ПриПолученииНастроекПлагина(ПараметрыСобытия);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриСохраненииНастроекПлагина") Тогда
		
		КонтурПлагины_ПриСохраненииНастроекПлагина(ПараметрыСобытия);
		
	Иначе
		
		СтандартнаяОбработка = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьПлагины() Экспорт
	
	СлужебныеКоманды = Перечисление_СлужебныеКомандыБиблиотекиПлагинов();
	ПараметрыСобытия = Новый Структура("Результат");
	
	Попытка
		КонтурПлагины_ОбработатьСлужебнуюКоманду(СлужебныеКоманды.ВыполнитьАвтоматическоеОбновление, ПараметрыСобытия);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Обновление плагинов'");
		ТекстСообщения = НСтр("ru = 'Не удалось проверить обновления плагинов'");
		ОбработатьОшибку(Действие, Ошибка,, ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

Функция ВыгрузитьВсеПлагиныВКаталогОтладки()
	
	Результат = Новый Массив;
	
	Контекст = КонтурПлагины_КонтекстВызова();
	Если Не ЗначениеЗаполнено(Контекст.КаталогОтладки) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяКоманды = "Плагины_ПолучитьСписок";
	ПараметрыКоманды = Новый Структура("Результат");
	МодульБиблиотекаПлагинов().ОбработатьСлужебнуюКоманду(ИмяКоманды, ПараметрыКоманды, Контекст);
	
	Для Каждого ОписаниеПлагина Из ПараметрыКоманды.Результат Цикл
		ПутьКФайлу = МодульОбщегоНазначения().ОбъединитьПути(Контекст.КаталогОтладки, ОписаниеПлагина.Идентификатор + ".epf");
		Если МодульОбщегоНазначения().ФайлСуществует(ПутьКФайлу) Тогда
			Результат.Добавить(ПутьКФайлу);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

