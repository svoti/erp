// Добавляет коды в документ учета из документа 1С через ПМ
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//  ДопПараметры - Булево - признак вызова функции из подключаемого модуля;
// 
// Возвращаемое значение:
//  Булево - Истина, если новые коды добавить удалось
//
Функция КодыДокументов_ДобавитьИзВнешнегоИсточника(ДокументУчета, ДопПараметры = Неопределено) Экспорт
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ1С", ДокументУчета_Документ1С(ДокументУчета));
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("ТаблицаКодов", Новый_ТаблицаКодов());
	ПараметрыПМ.Вставить("ДопПараметры", ДопПараметры);
	ПараметрыПМ.Вставить("ПараметрыЗагрузкиКодов", Новый_ПараметрыЗагрузкиНовыхКодовВДокумент());
	
	ПМ_ОбработатьСобытие_ПриЗагрузкеКодовИзВнешнегоИсточника(ПараметрыПМ);
	
	ТаблицаКодов = ПараметрыПМ.ТаблицаКодов;
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыПМ.ПараметрыЗагрузкиКодов);
	
	Функциональность = Перечисление_ФункциональностьМодуля().ЗагрузкаКодовИзВнешнегоИсточника;
	Метрика_Функциональность_ЗагрузкаКодовВДокумент(ДокументУчета, Функциональность);
	
	Возврат Истина;
	
КонецФункции

// Добавляет коды в документ учета из другого документа 1С
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//  ВыбранныйДокумент1С - ДокументСсылка - документ, из которого нужно получить коды;
// 
// Возвращаемое значение:
//  Булево - Истина, если новые коды добавить удалось
//
Функция КодыДокументов_ПодобратьИзДругогоДокумента(ДокументУчета, ДругойДокумент1С) Экспорт
	
	Организация = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "Организация");
	Документ1С = ДокументУчета_Документ1С(ДокументУчета);
	ДругойДокументУчета = ДокументУчета_НайтиПоДокументу1С(ДругойДокумент1С);
	ТаблицаКодов = Новый_ТаблицаКодов();
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ1С", Документ1С);
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("ДругойДокумент1С", ДругойДокумент1С);
	ПараметрыПМ.Вставить("ДругойДокументУчета", ДругойДокументУчета);
	ПараметрыПМ.Вставить("ТаблицаКодов", ТаблицаКодов);
	ПараметрыПМ.Вставить("ПараметрыЗагрузкиКодов", Новый_ПараметрыЗагрузкиНовыхКодовВДокумент());
	
	СтандартнаяОбработка = Истина;
	ПМ_ОбработатьСобытие_ПриЗагрузкеКодовИзДругогоДокумента(ПараметрыПМ, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		Если ЗначениеЗаполнено(ДругойДокументУчета) Тогда
			ТребуемыеКоды = ДокументУчета_ТребуемыеКоды(ДокументУчета);
			КодыПодобраны = КодыДокументов_Подобрать(ДокументУчета, ТребуемыеКоды, ДругойДокументУчета);
		КонецЕсли;
	Иначе
		ТаблицаКодов = ПараметрыПМ.ТаблицаКодов;
		КодыПодобраны = ЗначениеЗаполнено(ТаблицаКодов);
		КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыПМ.ПараметрыЗагрузкиКодов);
	КонецЕсли;
	
	Если КодыПодобраны Тогда
		Функциональность = Перечисление_ФункциональностьМодуля().ЗагрузкаКодовИзДругогоДокумента;
		Метрика_Функциональность_ЗагрузкаКодовВДокумент(ДокументУчета, Функциональность);
	КонецЕсли;
	
	Возврат КодыПодобраны;
	
КонецФункции

// Вызывает событие ПМ ПриЗагрузкеКодовИзФайловВДокументУчета и загружает коды из массива КодыМаркировки
// в документ учета
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//  ОписанияФайлов - Массив из Структура - см. функцию МодульКлиента.Новый_ОписаниеФайла();
//  ПараметрыВыбораФайлов - Структура - см. функцию МодульКлиента.Новый_ПараметрыДиалогаВыбораФайла();
// 
// Возвращаемое значение:
//  Булево - Истина, если коды были загружены;
//
Функция КодыДокументов_ЗагрузитьИзФайлов(ДокументУчета, ОписанияФайлов, ПараметрыВыбораФайлов) Экспорт 
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ1С", ДокументУчета_Документ1С(ДокументУчета));
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("ОписанияФайлов", ОписанияФайлов);
	ПараметрыПМ.Вставить("ПараметрыВыбораФайлов", ПараметрыВыбораФайлов);
	ПараметрыПМ.Вставить("ТаблицаКодов", ТаблицаКодов);
	ПараметрыПМ.Вставить("ПараметрыЗагрузкиКодов", Новый_ПараметрыЗагрузкиНовыхКодовВДокумент());
	
	СтандартнаяОбработка = Истина;
	ПМ_ОбработатьСобытие_ПриЗагрузкеКодовИзФайловВДокументУчета(ПараметрыПМ, СтандартнаяОбработка);
	
	Если Не СтандартнаяОбработка Тогда
		ТаблицаКодов = ПараметрыПМ.ТаблицаКодов;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыПМ.ПараметрыЗагрузкиКодов);
	
	Метрика_Функциональность_ЗагрузкаКодовВДокумент(ДокументУчета, Перечисление_ФункциональностьМодуля().ЗагрузкаКодовИзФайлов);
	
	Возврат Истина;
	
КонецФункции

// Добавляет коды в документ учета из входящего УПД
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - входящий УПД;
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
// 
// Возвращаемое значение:
//  Булево - Истина, если новые коды добавить удалось
//
Функция КодыДокументов_ДобавитьИзВходящегоУПД(Операция, ДокументУчета) Экспорт
	
	ТаблицаКодов = Операция_ВходящийУПД_ТаблицаКодов(Операция_ПрочитатьОперацию(Операция));
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыЗагрузки = Новый_ПараметрыЗагрузкиНовыхКодовВДокумент();
	ПараметрыЗагрузки.ЗаполнитьТоварыАгрегатов = НастройкиМодуля().ЗаполнятьТоварыАгрегатов;
	ПараметрыЗагрузки.УдалитьИзДокументаКодыВАгрегатах = ТаблицаКодов_ЕстьКодыАгрегатов(ТаблицаКодов);
	
	КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузки);
	
	Функциональность = Перечисление_ФункциональностьМодуля().ЗагрузкаКодовИзВходящегоУПД;
	Метрика_Функциональность_ЗагрузкаКодовВДокумент(ДокументУчета, Функциональность);
	
	Возврат Истина;
	
КонецФункции

Функция КодыДокументов_ДобавитьИзТабличногоДокумента_Сканера(ДокументУчета, ПараметрыЗагрузки) Экспорт
	
	Организация = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "Организация");
	ТаблицаКодов = ПолучитьИзВременногоХранилища(ПараметрыЗагрузки.АдресТаблицыКодов);
	УдалитьИзВременногоХранилища(ПараметрыЗагрузки.АдресТаблицыКодов);
	ЗагружатьПолныеКоды = ПараметрыЗагрузки.ЗагружатьПолныеКоды;
	УдалитьСтарыеКоды = ПараметрыЗагрузки.УдалитьСтарыеКоды;
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, Ложь) Тогда
		
		ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаКодов, , "ИсходныйКодМаркировки");
		
		ТаблицаКодов_ПрочитатьКлючиАгрегатов(ТаблицаКодов);
		
		ПараметрыЗагрузкиВДокумент = Новый_ПараметрыЗагрузкиНовыхКодовВДокумент();
		ПараметрыЗагрузкиВДокумент.УдалитьСтарыеКоды = УдалитьСтарыеКоды;
		ПараметрыЗагрузкиВДокумент.УдалитьИзДокументаКодыВАгрегатах = Ложь;
		
		КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузкиВДокумент);
		
	Иначе
		
		ДанныеРедактора = Новый_ДанныеРедактораКодов(ТаблицаКодов);
		ДанныеРедактора.УдалитьСтарыеКоды = УдалитьСтарыеКоды;
		ДанныеРедактора.ЗагружатьПолныеКоды = ЗагружатьПолныеКоды;
		ДанныеРедактора.УдалитьИзДокументаКодыВАгрегатах = Ложь;
		
		РедакторКодов_ЗаписатьФайл(ДокументУчета, ДанныеРедактора);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ПараметрыЗагрузки.РежимСканера Тогда
		Функциональность = Перечисление_ФункциональностьМодуля().ЗагрузкаКодовСканером;
	Иначе
		Функциональность = Перечисление_ФункциональностьМодуля().ЗагрузкаКодовИзТабличногоДокумента;
	КонецЕсли;
	
	Метрика_Функциональность_ЗагрузкаКодовВДокумент(ДокументУчета, Функциональность);
	
	Возврат Истина;
	
КонецФункции

Процедура КодыДокументов_ДобавитьИзРедактораКодов(ДокументУчета) Экспорт
	
	ДанныеРедактора = РедакторКодов_ПолучитьИзФайла(ДокументУчета);
	
	ТаблицаКодов = ДанныеРедактора.ТаблицаКодов;
	
	ТаблицаКодов_ПрочитатьКлючиАгрегатов(ТаблицаКодов);
	
	ПараметрыЗагрузки = Новый_ПараметрыЗагрузкиНовыхКодовВДокумент();
	ПараметрыЗагрузки.УдалитьСтарыеКоды = ДанныеРедактора.УдалитьСтарыеКоды;
	ПараметрыЗагрузки.ЗаполнитьТоварыАгрегатов = ДанныеРедактора.ЗаполнитьТоварыАгрегатов;
	ПараметрыЗагрузки.УдалитьИзДокументаКодыВАгрегатах = ДанныеРедактора.УдалитьИзДокументаКодыВАгрегатах;
	
	КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузки);
	
	РедакторКодов_УдалитьФайл(ДокументУчета);
	
	Функциональность = Перечисление_ФункциональностьМодуля().ЗагрузкаКодовИзТабличногоДокумента;
	Метрика_Функциональность_ЗагрузкаКодовВДокумент(ДокументУчета, Функциональность);
	
КонецПроцедуры

Функция КодыДокументов_КоличествоЗаводскихСерийныхНомеров(ДокументУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	КОЛИЧЕСТВО(*) КАК КоличествоЗСН
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И КодыМаркировки.ЗаводскойСерийныйНомер <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыДокументов.КлючСтрокиДокумента");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КодыДокументов_ПроверитьНаличиеКодов(КлючиКодов, ДокументУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО КодыМаркировки.КлючКода = КодыДокументов.КлючКода
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	КодыМаркировки.КлючКода В(&КлючиКодов)
	|	И КодыДокументов.КлючКода ЕСТЬ NULL");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючиКодов", КлючиКодов);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КодыДокументов_Подобрать(ДокументИлиОперация, ТребуемыеКоды, ДокументИсточник)
	
	Возврат МодульЯдро().КодыДокументов_Подобрать(ДокументИлиОперация, ТребуемыеКоды, ДокументИсточник);
	
КонецФункции

Функция КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузки) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УдалитьИзДокументаКодыВАгрегатах = ПараметрыЗагрузки.УдалитьИзДокументаКодыВАгрегатах;
	Если УдалитьИзДокументаКодыВАгрегатах = Неопределено Тогда
		УдалитьИзДокументаКодыВАгрегатах = ТаблицаКодов_ЕстьКодыАгрегатов(ТаблицаКодов);
	КонецЕсли;
	
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	ТоварыМаркировки = ОписаниеДокумента.ТоварыМаркировки;
	Организация = ОписаниеДокумента.Организация;
	
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаКодов);
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация);
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
	
	Если НастройкиМодуля().РазрешитьПечатьЗагруженныхКодов Тогда
		ТаблицаКодов_ПометитьДляНанесения(ТаблицаКодов);
	КонецЕсли;
	
	Если ПараметрыЗагрузки.ЗаполнитьТоварыДокумента Тогда
		ДокументУчета_ЗаполнитьТоварыДокументаИзТаблицыКодов(ТоварыДокумента, ТаблицаКодов);
		ДокументУчета = ДокументУчета_Записать(ОписаниеДокумента);
	Иначе
		ТаблицаКодов_РаспределитьКлючиСтрокДокумента(ТаблицаКодов, ТоварыДокумента, ТоварыМаркировки);
	КонецЕсли;
	
	ТаблицаКодов_УточнитьДанныеАгрегатов(ТаблицаКодов);
	ТаблицаКодов_УточнитьДанныеНаборов(ТаблицаКодов);
	КодыМаркировки_РасформироватьАгрегаты(ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КодАгрегата", Истина));
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
	ПолныеКоды_Записать(ТаблицаКодов);
	
	Если ПараметрыЗагрузки.ЗаполнитьТоварыАгрегатов Тогда
		ТоварыАгрегатов_ЗаполнитьИзГИСМТ(ТаблицаКодов, Организация);
		ТаблицаКодов_РаспределитьКлючиСтрокДокумента(ТаблицаКодов, ТоварыДокумента, ТоварыМаркировки);
	КонецЕсли;
	
	Если УдалитьИзДокументаКодыВАгрегатах Тогда
		ТаблицаКодов_ПометитьНаУдалениеИзДокументаКодыВАгрегатах(ТаблицаКодов);
	КонецЕсли;
	
	КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузки.УдалитьСтарыеКоды, Истина);
	
	Если ПараметрыЗагрузки.ЗаполнитьТоварыДокумента Тогда
		ДокументУчета_ЗаполнитьТоварыМаркировкиИзТаблицыКодов(ОписаниеДокумента, ТаблицаКодов);
		ДокументУчета_Записать(ОписаниеДокумента);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция КодыДокументов_КоличествоКодовПоСтатусам(ДокументУчета) Экспорт
	
	Возврат МодульЯдро().КодыДокументов_КоличествоКодовПоСтатусам(ДокументУчета);
	
КонецФункции

Функция КодыДокументов_КоличествоКодовПоПартиям(ДокументУчета, КлючСтрокиДокумента) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИнформацияОКодах.Товар КАК Товар,
	|	ИнформацияОКодах.НомерПартии КАК НомерПартии,
	|	СУММА(КодыМаркировки.Количество) КАК Количество,
	|	СУММА(ВЫБОР
	|			КОГДА КодыМаркировки.КоличествоУпаковок = 0
	|				ТОГДА 1
	|			ИНАЧЕ КодыМаркировки.КоличествоУпаковок
	|		КОНЕЦ) КАК КоличествоУпаковок
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И КодыДокументов.КлючСтрокиДокумента = &КлючСтрокиДокумента
	|	И ИнформацияОКодах.НомерПартии <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	ИнформацияОКодах.НомерПартии,
	|	ИнформацияОКодах.Товар
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПартии УБЫВ");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючСтрокиДокумента", КлючСтрокиДокумента);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КодыДокументов_КоличествоКодовСОшибкамиПоСтрокам(ДокументУчета) Экспорт
	
	ВалидныеСтатусы = Перечисление_ВалидныеСтатусыПроверкиКодаДокумента();
	СтатусыРезультатаПроверки = ДокументУчета_СтатусыРезультатаПроверкиКодов(ДокументУчета);
	СтатусыПроверкиКодов = Перечисление_СтатусыПроверкиКодовДокумента();
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	СУММА(К.КоличествоКодов) КАК Количество
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК К
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_РезультатыПроверкиКодов КАК Р
	|		ПО К.КлючПроверкиКода = Р.КлючПроверкиКода
	|			И (Р.ЕстьОшибка = ИСТИНА)
	|ГДЕ
	|	К.ДокументУчета = &ДокументУчета
	|	И (&УчитыватьПроверкуРД
	|				И НЕ Р.ПроверкаРД В (&ВалидныеСтатусы)
	|			ИЛИ &УчитыватьПроверкуВладельца
	|				И НЕ Р.ПроверкаВладельца В (&ВалидныеСтатусы)
	|			ИЛИ &УчитыватьПроверкуСтатуса
	|				И НЕ Р.ПроверкаСтатуса В (&ВалидныеСтатусы)
	|			ИЛИ &УчитыватьДопПроверка1
	|				И НЕ Р.ДопПроверка1 В (&ВалидныеСтатусы)
	|			ИЛИ &УчитыватьДопПроверка2
	|				И НЕ Р.ДопПроверка2 В (&ВалидныеСтатусы))
	|
	|СГРУППИРОВАТЬ ПО
	|	К.КлючСтрокиДокумента");
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	
	ПроверкаРДОтключена = (СтатусыРезультатаПроверки.ПроверкаРДКодов = СтатусыПроверкиКодов.Отключена);
	ПроверкаСтатусаОтключена = (СтатусыРезультатаПроверки.ПроверкаСтатусаКодов = СтатусыПроверкиКодов.Отключена);
	ПроверкаВладельцаОтключена = (СтатусыРезультатаПроверки.ПроверкаВладельцаКодов = СтатусыПроверкиКодов.Отключена);
	ДопПроверка1Отключена = (СтатусыРезультатаПроверки.ДопПроверкаКодов1 = СтатусыПроверкиКодов.Отключена);
	ДопПроверка2Отключена = (СтатусыРезультатаПроверки.ДопПроверкаКодов1 = СтатусыПроверкиКодов.Отключена);
	
	Запрос.УстановитьПараметр("УчитыватьПроверкуРД", Не ПроверкаРДОтключена);
	Запрос.УстановитьПараметр("УчитыватьПроверкуВладельца", Не ПроверкаВладельцаОтключена);
	Запрос.УстановитьПараметр("УчитыватьПроверкуСтатуса", Не ПроверкаСтатусаОтключена);
	Запрос.УстановитьПараметр("УчитыватьДопПроверка1", Не ДопПроверка1Отключена);
	Запрос.УстановитьПараметр("УчитыватьДопПроверка2", Не ДопПроверка2Отключена);
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ВалидныеСтатусы", ВалидныеСтатусы);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КодыДокументов_КоличествоКодовСОшибками(ДокументУчета) Экспорт
	
	КоличествоКодовСОшибками = КодыДокументов_КоличествоКодовСОшибкамиПоСтрокам(ДокументУчета);
	КоличествоКодовСОшибками.Свернуть(, "Количество");
	
	Если ЗначениеЗаполнено(КоличествоКодовСОшибками) Тогда
		Результат = КоличествоКодовСОшибками[0].Количество;
	Иначе
		Результат = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодыДокументов_КоличествоКодовПоСтрокам(ДокументУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	СУММА(Т.КоличествоКодов) КАК Количество
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючСтрокиДокумента");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КодыДокументов_ПолныеКодыДляНанесения(ДокументУчета, ПараметрыПодбора)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыДокументов.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И ИнформацияОКодах.ЕстьПолныйКод
	|	И ИнформацияОКодах.ДляНанесения
	|	И ИнформацияОКодах.ДатаПечати = ДАТАВРЕМЯ(1, 1, 1)
	|	И &Товар
	|	И &КлючНоменклатуры1С";
	
	Если ПараметрыПодбора.Товар = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", "ИСТИНА");
	Иначе
		Условие = "ИнформацияОКодах.Товар = &Товар";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", Условие);
	КонецЕсли;
	
	Если ПараметрыПодбора.КлючНоменклатуры1С = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючНоменклатуры1С", "ИСТИНА");
	Иначе
		Условие = "ИнформацияОКодах.КлючНоменклатуры1С = &КлючНоменклатуры1С";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючНоменклатуры1С", Условие);
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("Товар", ПараметрыПодбора.Товар);
	Запрос.УстановитьПараметр("КлючНоменклатуры1С", ПараметрыПодбора.КлючНоменклатуры1С);
	Запрос.Выполнить();
	
	ТекстЗапроса = "ВЫБРАТЬ Т.КлючКода ИЗ ТаблицаКодов КАК Т";
	Если ЗначениеЗаполнено(ПараметрыПодбора.КоличествоКодовТребуется) Тогда
		КоличествоКодов = ПараметрыПодбора.КоличествоКодовТребуется - ПараметрыПодбора.КоличествоКодовПодобрано;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", ТекстЗапросаВыбратьПервые(КоличествоКодов));
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаКодов = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	ПараметрыПодбора.КоличествоКодовПодобрано = ТаблицаКодов.Количество();
	
	Возврат ТаблицаКодов.ВыгрузитьКолонку("ПолныйКод");
	
КонецФункции

Функция КодыДокументов_ЕстьКоды(ДокументУчета, КлючСтрокиДокумента = Неопределено) Экспорт
	
	Возврат МодульЯдро().КодыДокументов_ЕстьКоды(ДокументУчета, КлючСтрокиДокумента);
	
КонецФункции

Функция КодыДокументов_ЕстьАгрегатыБезСтрокиДокумента(ДокументыУчета)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КодыДокументов.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлюч
	|		ПО КодыДокументов.КлючСтрокиДокумента = ПустойКлюч.Ключ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КодыДокументов.ДокументУчета В(&ДокументыУчета)
	|	И ИнформацияОКодах.ОбщийТипУпаковки = &ТранспортнаяУпаковка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ДокументыУчета", ДокументыУчета);
	Запрос.УстановитьПараметр("ТранспортнаяУпаковка", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция КодыДокументов_ЕстьМультитоварныеАгрегаты(ДокументыУчета)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьМультитоварныеАгрегаты
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК КоличествоКодовДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КоличествоКодовДокументов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КоличествоКодовДокументов.ДокументУчета В(&ДокументыУчета)
	|	И ИнформацияОКодах.ТипУпаковки = &Мультитоварная");
	
	Запрос.УстановитьПараметр("ДокументыУчета", ДокументыУчета);
	Запрос.УстановитьПараметр("Мультитоварная", Перечисления.КонтурМаркировка_ТипыУпаковок.МультитоварнаяУпаковка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция КодыДокументов_ЕстьПартионныйУчет(ДокументыУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьПартионныйУчет
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК КоличествоКодовДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КоличествоКодовДокументов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КоличествоКодовДокументов.ДокументУчета В(&ДокументыУчета)
	|	И ИнформацияОКодах.ОбщийТипУпаковки В (&ДопустимыеОбщиеТипыУпаковок)
	|	И ИнформацияОКодах.ВидПродукции В (&ДопустимыеВидыПродукции)");
	
	Запрос.УстановитьПараметр("ДокументыУчета", ДокументыУчета);
	Запрос.УстановитьПараметр("ДопустимыеОбщиеТипыУпаковок", ДопустимыеОбщиеТипыУпаковокДляПартионногоУчета());
	Запрос.УстановитьПараметр("ДопустимыеВидыПродукции", ДопустимыеВидыПродукцииДляПартионногоУчета());
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода");
