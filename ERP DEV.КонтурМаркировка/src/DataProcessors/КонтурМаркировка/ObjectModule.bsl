Процедура ТаблицаКодов_НайтиКлючиПоСерийнымНомерам(ТаблицаКодов)
	
	ГруппаGTIN = "01";
	ГруппаСерийныйНомер = "21";
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		Если Не ЗначениеЗаполнено(Стр.СерийныйНомер) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
			ШаблонОшибки = НСтр("ru = 'Не удалось найти код маркировки для серийного номера ""%1"", не указан товар'");
			ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Стр.СерийныйНомер);
		КонецЕсли;
		
		Стр.КодМаркировки = ГруппаGTIN + Стр.Товар.GTIN + ГруппаСерийныйНомер + Стр.СерийныйНомер;
		
	КонецЦикла;
	
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Не ЗначениеЗаполнено(Стр.КлючКода) И ЗначениеЗаполнено(Стр.СерийныйНомер) Тогда
			Стр.КодМаркировки = ""; // Не удалось найти такой код в базе
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаКодов_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(ТаблицаКодов)
	
	ИмяТаблицы = "ТаблицаКодов";
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
