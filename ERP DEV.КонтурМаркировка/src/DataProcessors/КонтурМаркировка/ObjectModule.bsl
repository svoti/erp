Процедура СведенияОМаркировке_Заполнить(ТоварыДокументов, ОшибкиМаркировки)
	
	Если СведенияОМаркировке_ЭтоКорректировка(ТоварыДокументов) Тогда
		Если СведенияОМаркировке_ЭтоКорректировкаНаВозврат(ТоварыДокументов) Тогда
			СведенияОМаркировке_Заполнить_Возврат(ТоварыДокументов, ОшибкиМаркировки);
		Иначе
			СведенияОМаркировке_Заполнить_Корректировка(ТоварыДокументов, ОшибкиМаркировки);
		КонецЕсли;
	Иначе
		СведенияОМаркировке_Заполнить_Отгрузка(ТоварыДокументов, ОшибкиМаркировки);
	КонецЕсли;
	
	СведенияОМаркировке_ЗаполнитьКодТоварнойГруппы(ТоварыДокументов);
	
КонецПроцедуры

Процедура СведенияОМаркировке_Заполнить_Отгрузка(ТоварыДокументов, ОшибкиМаркировки)
	
	МенеджерВТ = СведенияОМаркировке_ВТ_Таблицы_ОСУ_ПУ(ТоварыДокументов);
	СведенияОМаркировке_Распределить(ТоварыДокументов, ОшибкиМаркировки, МенеджерВТ);
	
КонецПроцедуры

Процедура СведенияОМаркировке_Заполнить_Корректировка(ТоварыДокументов, ОшибкиМаркировки)
	
	ТипыИзменения = Перечисление_ТипыИзмененияСтрокиУКД();
	
	ТоварыДокументовДо = ТоварыДокументов.Скопировать(Новый Структура("ТипИзменения", ТипыИзменения.До));
	ТоварыДокументовПосле = ТоварыДокументов.Скопировать(Новый Структура("ТипИзменения", ТипыИзменения.После));
	
	МенеджерВТ = СведенияОМаркировке_ВТ_Таблицы_ОСУ_ПУ_До(ТоварыДокументов);
	СведенияОМаркировке_Распределить(ТоварыДокументовДо, ОшибкиМаркировки, МенеджерВТ);
	
	МенеджерВТ = СведенияОМаркировке_ВТ_Таблицы_ОСУ_ПУ_После(ТоварыДокументов);
	СведенияОМаркировке_Распределить(ТоварыДокументовПосле, ОшибкиМаркировки, МенеджерВТ);
	
КонецПроцедуры

Процедура СведенияОМаркировке_Заполнить_Возврат(ТоварыДокументов, ОшибкиМаркировки)
	
	СведенияОМаркировке_Заполнить_Возврат_ПУ(ТоварыДокументов, ОшибкиМаркировки);
	СведенияОМаркировке_Заполнить_Возврат_ОСУ(ТоварыДокументов, ОшибкиМаркировки);
	
КонецПроцедуры

Процедура СведенияОМаркировке_Заполнить_Возврат_ПУ(ТоварыДокументов, ОшибкиМаркировки)
	
	КлючСтроки = СведенияОМаркировке_КлючСтрокиУКД();
	ТипыИзменения = Перечисление_ТипыИзмененияСтрокиУКД();
	
	ТоварыДокументовДо = ТоварыДокументов.Скопировать(Новый Структура("ТипИзменения", ТипыИзменения.До));
	
	КлючСтроки.ТипИзменения = ТипыИзменения.После;
	Для Каждого СтрДо Из ТоварыДокументовДо Цикл
		ЗаполнитьЗначенияСвойств(КлючСтроки, СтрДо, , "ТипИзменения");
		СтрПосле = ТаблицаЗначений_НайтиСтроку(ТоварыДокументов, КлючСтроки);
		Если СтрПосле <> Неопределено Тогда
			// Для распределения КИ по количеству возврата
			СтрДо.Количество = Макс(СтрДо.Количество - СтрПосле.Количество, 0);
		КонецЕсли;
	КонецЦикла;
	
	МенеджерВТ = СведенияОМаркировке_ВТ_Таблицы_ПУ_Возврат(ТоварыДокументов);
	СведенияОМаркировке_Распределить(ТоварыДокументовДо, ОшибкиМаркировки, МенеджерВТ);
	
	Для Каждого СтрМарк Из ТоварыДокументовДо Цикл
		
		ЗаполнитьЗначенияСвойств(КлючСтроки, СтрМарк);
		СтрДок = ТаблицаЗначений_НайтиСтроку(ТоварыДокументов, КлючСтроки);
		
		СтрДок.ПолученоКоличество = СтрМарк.ПолученоКоличество;
		СтрДок.ПолученоКИ = СтрМарк.ПолученоКИ;
		СтрДок.ВсеКодыПолучены = СтрМарк.ВсеКодыПолучены;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Заполнить_Возврат_ОСУ(ТоварыДокументов, ОшибкиМаркировки)
	
	КлючСтроки = СведенияОМаркировке_КлючСтрокиУКД();
	ТипыИзменения = Перечисление_ТипыИзмененияСтрокиУКД();
	
	ТоварыДокументовДо = ТоварыДокументов.Скопировать(Новый Структура("ТипИзменения", ТипыИзменения.До));
	МенеджерВТ = СведенияОМаркировке_ВТ_Таблицы_ОСУ_Возврат_До(ТоварыДокументов);
	СведенияОМаркировке_Распределить(ТоварыДокументовДо, ОшибкиМаркировки, МенеджерВТ);
	
	ТоварыДокументовПосле = ТоварыДокументов.Скопировать(Новый Структура("ТипИзменения", ТипыИзменения.После));
	МенеджерВТ = СведенияОМаркировке_ВТ_Таблицы_ОСУ_Возврат_После(ТоварыДокументов);
	СведенияОМаркировке_Распределить(ТоварыДокументовПосле, ОшибкиМаркировки, МенеджерВТ);
	
	Для Каждого СтрДок Из ТоварыДокументов Цикл
		
		ЗаполнитьЗначенияСвойств(КлючСтроки, СтрДок);
		Если СтрДок.ТипИзменения = ТипыИзменения.До Тогда
			СтрМарк = ТаблицаЗначений_НайтиСтроку(ТоварыДокументовДо, КлючСтроки);
		Иначе
			СтрМарк = ТаблицаЗначений_НайтиСтроку(ТоварыДокументовПосле, КлючСтроки);
		КонецЕсли;
		
		СтрДок.ПолученоКоличество = СтрМарк.ПолученоКоличество;
		СтрДок.ПолученоКИ = СтрМарк.ПолученоКИ;
		СтрДок.ВсеКодыПолучены = СтрМарк.ВсеКодыПолучены;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить(ТоварыДокументов, ОшибкиМаркировки, МенеджерВТ)
	
	ТаблицаМаркировки = СведенияОМаркировке_ТаблицаМаркировки(ТоварыДокументов, МенеджерВТ, ОшибкиМаркировки);
	ТаблицаМаркировки.Индексы.Добавить("ОбъемноСортовойУчет, ВсеКодыПереданы");
	
	СведенияОМаркировке_ДобавитьАгрегаты(ТоварыДокументов, ТаблицаМаркировки, ОшибкиМаркировки, МенеджерВТ);
	
	СведенияОМаркировке_РаспределитьТаблицуКодов(ТоварыДокументов, ТаблицаМаркировки);
	СведенияОМаркировке_РаспределитьТаблицуОСУ(ТоварыДокументов, ТаблицаМаркировки);
	
	СведенияОМаркировке_Проверить_РаспределениеКодов(ТаблицаМаркировки, ОшибкиМаркировки);
	
КонецПроцедуры

Процедура СведенияОМаркировке_ДобавитьАгрегаты(ТоварыДокументов, ТаблицаМаркировки, ОшибкиМаркировки, МенеджерВТ)
	
	ТаблицаАгрегатов = СведенияОМаркировке_ТаблицаАгрегатов(ТоварыДокументов, МенеджерВТ);
	Если Не ЗначениеЗаполнено(ТаблицаАгрегатов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаТоваров = СведенияОМаркировке_ТаблицаТоваров(ТоварыДокументов, МенеджерВТ);
	
	ПорядокСортировки = СведенияОМаркировке_ПорядокСортировкиСтрокДокумента();
	ТаблицаАгрегатов.Сортировать(ПорядокСортировки, Новый СравнениеЗначений);
	ТаблицаТоваров.Сортировать(ПорядокСортировки, Новый СравнениеЗначений);
	ТаблицаАгрегатов.Индексы.Добавить("ВсеКодыПереданы");
	
	КлючСтроки = СведенияОМаркировке_КлючСтрокиДокумента_Номенклатура_Товар();
	Для Каждого СтрТов Из ТаблицаТоваров Цикл
		ЗаполнитьЗначенияСвойств(КлючСтроки, СтрТов);
		Для Каждого СтрМарк Из ТаблицаМаркировки.НайтиСтроки(КлючСтроки) Цикл
			СтрТов.ПолученоКИ = СтрТов.ПолученоКИ + СтрМарк.КоличествоКИ;
		КонецЦикла;
		СтрТов.ВсеКодыПолучены = (СтрТов.ПолученоКИ = СтрТов.КоличествоУпаковок);
	КонецЦикла;
	
	СведенияОМаркировке_РаспределитьТаблицуАгрегатов(ТаблицаАгрегатов, ТаблицаТоваров);
	Если СведенияОМаркировке_ДополнитьВАгрегатыВложенныеТоварыКИГУ(ТаблицаАгрегатов) Тогда
		СведенияОМаркировке_РаспределитьТаблицуАгрегатов(ТаблицаАгрегатов, ТаблицаТоваров);
	КонецЕсли;
	
	Для Каждого СтрТов Из ТаблицаТоваров Цикл
		Если ЗначениеЗаполнено(СтрТов.СведенияОМаркировке) Тогда
			НоваяСтрока = ТаблицаМаркировки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрТов);
			НоваяСтрока.Количество = СтрТов.КоличествоВУпаковке * СтрТов.КоличествоКИ;
		КонецЕсли;
	КонецЦикла;
	
	СведенияОМаркировке_Проверить_РаспределениеАгрегатов(ТаблицаАгрегатов, ОшибкиМаркировки);
	
	ТаблицаМаркировки.Сортировать(ПорядокСортировки, Новый СравнениеЗначений);
	
КонецПроцедуры

Процедура СведенияОМаркировке_РаспределитьТаблицуАгрегатов(ТаблицаАгрегатов, ТаблицаТоваров)
	
	ПараметрыРаспределения = Новый_ПараметрыРаспределенияКодов();
	Отбор = Новый Структура("ВсеКодыПереданы", Ложь);
	
	Для Каждого СтрАгр Из ТаблицаАгрегатов.НайтиСтроки(Отбор) Цикл
		СведенияОМаркировке_РаспределитьАгрегаты(СтрАгр, ТаблицаТоваров, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюСериюИсточника = Истина;
	Для Каждого СтрАгр Из ТаблицаАгрегатов.НайтиСтроки(Отбор) Цикл
		СведенияОМаркировке_РаспределитьАгрегаты(СтрАгр, ТаблицаТоваров, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюХарактеристикуИсточника = Истина;
	Для Каждого СтрАгр Из ТаблицаАгрегатов.НайтиСтроки(Отбор) Цикл
		СведенияОМаркировке_РаспределитьАгрегаты(СтрАгр, ТаблицаТоваров, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюСериюПриемника = Истина;
	Для Каждого СтрАгр Из ТаблицаАгрегатов.НайтиСтроки(Отбор) Цикл
		СведенияОМаркировке_РаспределитьАгрегаты(СтрАгр, ТаблицаТоваров, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюХарактеристикуПриемника = Истина;
	Для Каждого СтрАгр Из ТаблицаАгрегатов.НайтиСтроки(Отбор) Цикл
		СведенияОМаркировке_РаспределитьАгрегаты(СтрАгр, ТаблицаТоваров, ПараметрыРаспределения);
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_РаспределитьАгрегаты(СтрАгр, ТаблицаТоваров, ПараметрыРаспределения)
	
	СтрокиТоваров = СведенияОМаркировке_НайтиСтрокиМаркировки(СтрАгр, ТаблицаТоваров, ПараметрыРаспределения);
	Если Не ЗначениеЗаполнено(СтрокиТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	// Распределяем КИТУ где количество КИ совпадает с количеством упаковок
	СведенияОМаркировке_РаспределитьАгрегаты_Совпадает(СтрАгр, СтрокиТоваров);
	
	Если Не СтрАгр.ВсеКодыПереданы Тогда
		// Распределяем КИТУ где все вложенные КИ влазят в одну строку товаров
		СведенияОМаркировке_РаспределитьАгрегаты_МеньшеРавно(СтрАгр, СтрокиТоваров);
	КонецЕсли;
	
	Если Не СтрАгр.ВсеКодыПереданы Тогда
		// Распределяем КИТУ по нескольким строкам товаров
		СведенияОМаркировке_РаспределитьАгрегаты_БольшеРавно(СтрАгр, СтрокиТоваров);
	КонецЕсли;
	
КонецПроцедуры

Процедура СведенияОМаркировке_РаспределитьАгрегаты_Совпадает(СтрАгр, СтрокиТоваров)
	
	Для Каждого СтрСвед Из СведенияОМаркировке_ДоступныеСведения(СтрАгр.СведенияОМаркировке) Цикл
		
		Для Каждого СтрТов Из СтрокиТоваров Цикл
			
			Если СтрТов.ВсеКодыПолучены Тогда
				Продолжить;
			КонецЕсли;
			
			ТребуетсяКИ = СтрТов.КоличествоУпаковок - СтрТов.ПолученоКИ;
			Если Не ЗначениеЗаполнено(ТребуетсяКИ) Тогда
				Продолжить;
			КонецЕсли;
			
			ОсталосьКИ = СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ;
			Если ОсталосьКИ <> ТребуетсяКИ Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = СтрТов.СведенияОМаркировке.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед, , "ПереданоКИ, Передан");
			НоваяСтрока.КоличествоКИ = ОсталосьКИ;
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОсталосьКИ;
			СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
			
			СтрАгр.ПереданоКИ = СтрАгр.ПереданоКИ + ОсталосьКИ;
			СтрАгр.ВсеКодыПереданы = (СтрАгр.ПереданоКИ = СтрАгр.КоличествоКИ);
			
			СтрТов.ПолученоКИ = СтрТов.ПолученоКИ + ОсталосьКИ;
			СтрТов.КоличествоКИ = СтрТов.КоличествоКИ + ОсталосьКИ;
			СтрТов.ВсеКодыПолучены = (СтрТов.ПолученоКИ = СтрТов.КоличествоУпаковок);
			
			Если СтрСвед.Передан Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_РаспределитьАгрегаты_МеньшеРавно(СтрАгр, СтрокиТоваров)
	
	Для Каждого СтрТов Из СтрокиТоваров Цикл
		
		Если СтрТов.ВсеКодыПолучены Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрСвед Из СведенияОМаркировке_ДоступныеСведения(СтрАгр.СведенияОМаркировке) Цикл
			
			ТребуетсяКИ = СтрТов.КоличествоУпаковок - СтрТов.ПолученоКИ;
			ОсталосьКИ = СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ;
			
			Если ОсталосьКИ > ТребуетсяКИ Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = СтрТов.СведенияОМаркировке.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед, , "ПереданоКИ, Передан");
			НоваяСтрока.КоличествоКИ = ОсталосьКИ;
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОсталосьКИ;
			СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
			
			СтрАгр.ПереданоКИ = СтрАгр.ПереданоКИ + ОсталосьКИ;
			СтрАгр.ВсеКодыПереданы = (СтрАгр.ПереданоКИ = СтрАгр.КоличествоКИ);
			
			СтрТов.ПолученоКИ = СтрТов.ПолученоКИ + ОсталосьКИ;
			СтрТов.КоличествоКИ = СтрТов.КоличествоКИ + ОсталосьКИ;
			СтрТов.ВсеКодыПолучены = (СтрТов.ПолученоКИ = СтрТов.КоличествоУпаковок);
			
			Если СтрТов.ВсеКодыПолучены Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрАгр.ВсеКодыПереданы Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

