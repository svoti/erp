Функция ДокументУчета_ВключеныПроверкиКодов(ДокументУчета)
	
	ТипДокумента = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "ТипДокумента");
	
	КлючКэш = "ВключеныПроверкиКодов: " + ТипДокумента;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НастройкаДокумента = НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента);
	ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(НастройкаДокумента);
	Результат = ЗначениеЗаполнено(ОписаниеНастройки.ПроверкиКодовДокумента);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

