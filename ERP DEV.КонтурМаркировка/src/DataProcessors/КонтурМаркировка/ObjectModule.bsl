Функция ОбщийТипУпаковкиПоТипуКодаМаркировки(ТипКодаМаркировки)
	
	Если Не ЗначениеЗаполнено(ТипКодаМаркировки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючКэш = "ОбщийТипУпаковкиПоТипуКодаМаркировки: " + ТипКодаМаркировки;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = МодульЯдро().ОбщийТипУпаковкиПоТипуКодаМаркировки(ТипКодаМаркировки);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ОбщийТипУпаковкиПоВидуУпаковки(ВидУпаковки)
	
	Если Не ЗначениеЗаполнено(ВидУпаковки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючКэш = "ОбщийТипУпаковкиПоВидуУпаковки: " + ВидУпаковки;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыУпаковок = Перечисления.КонтурМаркировка_ВидыУпаковок;
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить(ВидыУпаковок.Потребительская, ОбщиеТипыУпаковок.ЕдиницаТовара);
	СоответствиеТипов.Вставить(ВидыУпаковок.Групповая, ОбщиеТипыУпаковок.ГрупповаяУпаковка);
	СоответствиеТипов.Вставить(ВидыУпаковок.Логистическая, ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Результат = СоответствиеТипов[ВидУпаковки];
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный вид упаковки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ВидУпаковки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

