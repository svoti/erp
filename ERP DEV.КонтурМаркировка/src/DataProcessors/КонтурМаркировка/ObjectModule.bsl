Функция СведенияОМаркировке_ТекстыОшибок()
	
	ТипыОшибок = Перечисление_ТипыОшибокСведенийОМаркировке();
	
	Результат = Новый Соответствие;
	Результат.Вставить(ТипыОшибок.НеВсеКодыПереданы, НСтр("ru = 'Не удалось распределить коды: %1'"));
	Результат.Вставить(ТипыОшибок.ЕстьОшибкиПроверкиКодов, НСтр("ru='Обнаружены ошибки проверки кодов'"));
	Результат.Вставить(ТипыОшибок.НеЗавершенаПроверкаКодов, НСтр("ru='Необходимо выполнить проверку кодов'"));
	Результат.Вставить(ТипыОшибок.НеУдалосьРаспределитьАгрегаты, НСтр("ru = 'Не удалось распределить агрегаты: %1'"));
	Результат.Вставить(ТипыОшибок.КодыОтсутствуют, НСтр("ru = 'Необходимо наполнить кодами маркировки документ: %1'"));
	Результат.Вставить(ТипыОшибок.ДокументНеЗавершен, НСтр("ru = 'Необходимо завершить работу с кодами маркировки в документе: %1'"));
	Результат.Вставить(ТипыОшибок.НеУказаноКоличествоУпаковок, НСтр("ru = 'Необходимо заполнить количество упаковок в документе: %1'"));
	Результат.Вставить(ТипыОшибок.НеЗаполненИсправляемыйДокументУчета, НСтр("ru = 'Необходимо заполнить исправляемый документ в: %1'"));
	Результат.Вставить(ТипыОшибок.КодыНеСопоставлены, НСтр("ru = 'Необходимо сопоставить коды маркировки с номенклатурой документа: %1'"));
	Результат.Вставить(ТипыОшибок.ТоварыНеСопоставлены, НСтр("ru = 'Необходимо сопоставить товары маркировки с номенклатурой документа: %1'"));
	
	Результат.Вставить(ТипыОшибок.НеРазрешенОСУ, СведенияОМаркировке_ТекстОшибки_НеРазрешенОСУ());
	Результат.Вставить(ТипыОшибок.НеЗаполненНомерПартии, СведенияОМаркировке_ТекстОшибки_НеЗаполненНомерПартии());
	Результат.Вставить(ТипыОшибок.НеРазрешенПартионныйУчет, СведенияОМаркировке_ТекстОшибки_НеРазрешенПартионныйУчет());
	Результат.Вставить(ТипыОшибок.ОтсутствуетРольОтгрузка, СведенияОМаркировке_ТекстОшибки_ОтсутствуютРоли());
	Результат.Вставить(ТипыОшибок.ТарифНеПоддерживаетНаполнениеУПД, СведенияОМаркировке_ТекстОшибки_ТарифНеПоддерживаетНаполнение());
	
	Возврат Результат;
	
КонецФункции

