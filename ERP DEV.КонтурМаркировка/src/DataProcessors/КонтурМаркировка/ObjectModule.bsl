Функция КонтурИнтеграция_ВсеКомандыДокументов1С() Экспорт
	
	КлючКэш = "ВсеКомандыДокументов1С";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	Результат = Новый СписокЗначений;
	Результат.Добавить(ТребуемыеДействия.НачатьРаботу         , НСтр("ru = 'Начать маркировку'"));
	Результат.Добавить(ТребуемыеДействия.ПодобратьТовары      , НСтр("ru = 'Заполнить товары маркировки'"));
	Результат.Добавить(ТребуемыеДействия.НаполнитьКодами      , НСтр("ru = 'Наполнить кодами маркировки'"));
	Результат.Добавить(ТребуемыеДействия.ЗаполнитьНаТСД       , НСтр("ru = 'Наполнить кодами маркировки на ТСД'"));
	Результат.Добавить(ТребуемыеДействия.НапечататьЭтикетки   , НСтр("ru = 'Напечатать этикетки с маркировкой'"));
	Результат.Добавить(ТребуемыеДействия.ОтчитатьсяОНанесении , НСтр("ru = 'Отчитаться о нанесении маркировки'"));
	Результат.Добавить(ТребуемыеДействия.ВвестиВОборот        , НСтр("ru = 'Ввести в оборот коды маркировки'"));
	Результат.Добавить(ТребуемыеДействия.ИсправитьОшибку      , НСтр("ru = 'Исправить ошибки маркировки'"));
	Результат.Добавить(ТребуемыеДействия.ЗавершитьРаботу      , НСтр("ru = 'Завершить маркировку'"));
	Результат.Добавить(ТребуемыеДействия.РаботаЗавершена      , НСтр("ru = 'Маркировка завершена'"));
	
	Для каждого Элемент Из ТребуемыеДействия Цикл
		Если Результат.НайтиПоЗначению(Элемент.Значение) = Неопределено Тогда
			Результат.Добавить(Элемент.Значение, НСтр("ru = 'Продолжить маркировку'"));
		КонецЕсли;
	КонецЦикла;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

