Процедура ПерейтиНаВерсиюДанных_3_2_0_ЗаполнитьТоварыПеремаркировкиПоУмолчанию()
	
	Отбор = Новый Структура("ТипОперации", Перечисление_ТипыОпераций().Перемаркировка);
	Выборка = Справочники.КонтурМаркировка_Операции.Выбрать( , , Отбор);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию(РежимУправленияБлокировкой());
		
		Попытка
			
			Операция_Заблокировать(Выборка.Ссылка);
			
			ОписаниеОперации = Операция_ПрочитатьОперацию(Выборка.Ссылка);
			
			Операция_ЗаполнитьТЧ_Перемаркировка(ОписаниеОперации, Новый_ТаблицаКодов());
			Операция_ЗаполнитьТЧЗначениямиПоУмолчанию(ОписаниеОперации);
			
			Операция_Записать(ОписаниеОперации);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			Ошибка = ИнформацияОбОшибке();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПерейтиНаВерсиюДанных_3_2_0_ОбновитьОбработкуРегламентныхДействий()
	
	Настройки = НастройкиВыполненияРегламентныхЗаданий();
	Если Не Настройки.ИспользоватьБСП Тогда
		Возврат;
	КонецЕсли;
	
	НаименованиеОбработки = "Регламентные действия (Контур.Маркировка)";
	
	ВнешняяОбработка = СсылкаНаДополнительнуюОбработку(НаименованиеОбработки);
	Если Не ЗначениеЗаполнено(ВнешняяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаОбъект = ВнешняяОбработка.ПолучитьОбъект();
	ОбработкаОбъект.ОбменДанными.Загрузка = Истина;
	ОбработкаОбъект.Удалить();
	
	МодульРегламентныеДействия();
	
КонецПроцедуры

Процедура ПерейтиНаВерсиюДанных_3_2_0_Товары_ЗаполнитьТипСрокаГодности()
	
	ТипыСрокаГодности = Перечисление_ТипыСроковГодности();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Товары.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(СрокГодностиМеньше72Часов.Значение, ЛОЖЬ) КАК СрокГодностиМеньше72Часов
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК СрокГодностиМеньше72Часов
	|		ПО Товары.Ссылка = СрокГодностиМеньше72Часов.Объект
	|			И (СрокГодностиМеньше72Часов.ИмяРеквизита = ""СрокГодностиМеньше72Часов"")
	|ГДЕ
	|	(ЕСТЬNULL(СрокГодностиМеньше72Часов.Значение, ЛОЖЬ) = ИСТИНА
	|				И Товары.ТипСрокаГодности <> &СрокГодностиМеньше72
	|			ИЛИ ЕСТЬNULL(СрокГодностиМеньше72Часов.Значение, ЛОЖЬ) = ЛОЖЬ
	|				И Товары.ТипСрокаГодности <> &СрокГодностиБольше72)");
	Запрос.УстановитьПараметр("СрокГодностиМеньше72", ТипыСрокаГодности.СрокГодностиМеньше72);
	Запрос.УстановитьПараметр("СрокГодностиБольше72", ТипыСрокаГодности.СрокГодностиБольше72);
	Выборка = Запрос.Выполнить().Выбрать();
	
	// BSLLS:CreateQueryInCycle-off
	
	Пока Выборка.Количество() > 0 Цикл
		
		НачатьТранзакцию(РежимУправленияБлокировкой());
		Попытка
			
			Пока Выборка.Следующий() Цикл
				
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				
				Если Выборка.СрокГодностиМеньше72Часов Тогда
					Объект.ТипСрокаГодности = ТипыСрокаГодности.СрокГодностиМеньше72;
				Иначе
					Объект.ТипСрокаГодности = ТипыСрокаГодности.СрокГодностиБольше72;
				КонецЕсли;
				
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Записать();
				
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			Ошибка = ИнформацияОбОшибке();
			ВызватьИсключение;
		КонецПопытки;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
КонецПроцедуры

