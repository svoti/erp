// Добавляет в функциональность использование загрузки кодов в документ
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//  Функциональность - Строка - см функцию Перечисление_ФункциональностьМодуля();
