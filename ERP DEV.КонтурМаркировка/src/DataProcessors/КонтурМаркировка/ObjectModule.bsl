	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Результат = Новый Соответствие;
	Результат.Вставить(ТипыОпераций.ЗаказКодов, "/codes/order/");
	Результат.Вставить(ТипыОпераций.ВыводИзОборота, "/codes/withdrawn/");
