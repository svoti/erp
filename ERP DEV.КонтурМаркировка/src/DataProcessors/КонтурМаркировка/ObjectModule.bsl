// Находит документ учета в маркировке по документу 1С
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//  ВызыватьИсключение - Булево - Истина, если нужно вызвать исключение, когда документ учета не найден;
//  СоздатьПерезаполнить - Булево - Истина, если нужно создать документ учета (если возможно)
//                         или перезаполнить документ учета, если версия документа 1С изменилась;
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов поиска;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДокументыУчета
//
Функция ДокументУчета_НайтиПоДокументу1С(Документ1С
	, ВызыватьИсключение = Ложь
	, СоздатьПерезаполнить = Ложь
	, КэшРезультатов = Неопределено) Экспорт
	
	Результат = МодульЯдро().ДокументУчета_НайтиПоДокументу1С(Документ1С, КэшРезультатов);
	
	Если Не ЗначениеЗаполнено(Результат) И ВызыватьИсключение Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось найти документ учета по документу 1С: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, Документ1С);
	КонецЕсли;
	
	Если СоздатьПерезаполнить Тогда
		Если ЗначениеЗаполнено(Результат) Тогда
			НоваяВерсия = ЗначениеРеквизитаОбъектаЛок(Документ1С, "ВерсияДанных");
			СтараяВерсия = ЗначениеРеквизитаОбъектаЛок(Результат, "ВерсияДанныхДокумента1С");
			Если СтараяВерсия <> НоваяВерсия
				И ДокументУчета_ОсновнойСтатус(Результат) = Перечисление_СтатусыДокументовУчета().Новый Тогда
				ДокументУчета_Перезаполнить(Результат, Документ1С);
			КонецЕсли;
		Иначе
			Если Результат <> Null Тогда
				Если ДокументУчета_МожноСоздатьАвтоматически(Документ1С) Тогда
					Результат = ДокументУчета_Создать(Документ1С);
				Иначе
					Результат = Null;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(Документ1С, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит документы учета в маркировке по документам 1С
//
// Параметры:
//  Документы1С - Массив - содержит ссылки на документы 1С;
//  СоздатьПерезаполнить - Булево - Истина, если нужно создавать документы учета (если возможно)
//                         или перезаполнять документы учета, если версия документов 1С изменилась;
// 
// Возвращаемое значение:
//  Массив - содержит значения СправочникСсылка.КонтурМаркировка_ДокументыУчета;
//
Функция ДокументыУчета_НайтиПоДокументам1С(Документы1С, СоздатьПерезаполнить = Ложь) Экспорт
	
	Результат = Новый Массив;
	ВызыватьИсключение = Ложь;
	
	Для каждого Документ1С Из Документы1С Цикл
		ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, ВызыватьИсключение, СоздатьПерезаполнить);
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			Результат.Добавить(ДокументУчета);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_МожноСоздатьАвтоматически(Документ1С) Экспорт
	
	Возврат ДокументДопустимВМаркировке(Документ1С)
			И ОрганизацияДокументаЗарегистрированаВМаркировке(Документ1С)
			И ДокументСодержитМаркируемыйТовар(Документ1С);
	
КонецФункции

// Создает документ в маркировке по документу из 1С
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//
Функция ДокументУчета_Создать(Документ1С, НачатьРаботу = Ложь, ЗагрузитьКоды = Истина) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
	ЭтоНовыйДокумент = Не ЗначениеЗаполнено(ДокументУчета);
	
	ТаблицаКодов = Неопределено;
	Если ЭтоНовыйДокумент Тогда
		ОписаниеДокумента = Новый_ДокументУчета();
		ДокументУчета_Заполнить(ОписаниеДокумента, Документ1С);
	Иначе
		ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	КонецЕсли;
	
	ПараметрыЗагрузки = Новый_ПараметрыЗагрузкиНовыхКодовВДокумент();
	ПараметрыЗагрузки.УдалитьСтарыеКоды = Истина;
	
	Если ЭтоНовыйДокумент И ЗагрузитьКоды Тогда
		
		РезультатПМ = ПМ_ТаблицаКодовДляНовогоДокумента(ОписаниеДокумента);
		
		ТаблицаКодов = РезультатПМ.ТаблицаКодов;
		ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, РезультатПМ.ПараметрыЗагрузкиКодов);
		
	КонецЕсли;
	
	Если ЭтоНовыйДокумент Тогда
		ДокументУчета = ДокументУчета_Записать(ОписаниеДокумента);
	КонецЕсли;
	
	Если НачатьРаботу Или ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ДокументУчета_ПроверитьГотовностьКРаботе(ОписаниеДокумента);
		КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузки);
		ОписаниеДокумента.Статусы.ОсновнойСтатус = Перечисление_СтатусыДокументовУчета().ВРаботе;
		ДокументУчета_ЗаписатьСтатусы(ОписаниеДокумента);
	КонецЕсли;
	
	Возврат ОписаниеДокумента.Ссылка;
	
КонецФункции

// Заполняет документ учета на основании документа 1С
//
// Параметры:
//  ОписаниеДокумента - Структура - см. Новый_ДокументУчета();
//  Документ1С - ДокументСсылка - документ в учетной системе;
//
Процедура ДокументУчета_Заполнить(ОписаниеДокумента, Документ1С) Экспорт
	
	Реквизиты = ДокументУчета_РеквизитыДокумента1С(Документ1С);
	
	ОписаниеДокумента.Номер = Реквизиты.Номер;
	ОписаниеДокумента.Дата = Реквизиты.Дата;
	
	Если ТипЗнч(Реквизиты.Организация) = Тип("СправочникСсылка.КонтурМаркировка_Организации") Тогда
		ОписаниеДокумента.Организация = Реквизиты.Организация;
	Иначе
		ОписаниеДокумента.Организация = Организация_НайтиПоОрганизации1С(Реквизиты.Организация);
	КонецЕсли;
	
	Если ТипЗнч(Реквизиты.Организация) = Тип("СправочникСсылка.КонтурМаркировка_Склады") Тогда
		ОписаниеДокумента.Склад = Реквизиты.Склад;
	Иначе
		ОписаниеДокумента.Склад = Склад_НайтиПоСкладу1С(Реквизиты.Склад, ОписаниеДокумента.Организация);
	КонецЕсли;
	
	ОписаниеДокумента.ТипДокумента = Реквизиты.ТипДокумента;
	ОписаниеДокумента.Документ1С = Документ1С;
	ОписаниеДокумента.Наименование = Реквизиты.Наименование;
	ОписаниеДокумента.ВерсияДанныхДокумента1С = Реквизиты.ВерсияДанных;
	ОписаниеДокумента.ДопРеквизиты.Контрагент1С = Реквизиты.Контрагент;
	ОписаниеДокумента.ДопРеквизиты.ДокументОснование = Реквизиты.ДокументОснование;
	ОписаниеДокумента.ДопРеквизиты.ВидКорректировки = Интеграция_ВидКорректировки(Документ1С);
	ОписаниеДокумента.МаршрутМаркировки = Реквизиты.МаршрутМаркировки;
	ОписаниеДокумента.Комментарий = Реквизиты.Комментарий;
	
	ДокументУчета_ЗаполнитьИсправляемыйДокумент(ОписаниеДокумента, Реквизиты);
	ДокументУчета_ЗаполнитьТоварыДокументаИзДокумента1С(ОписаниеДокумента, Реквизиты);
	ДокументУчета_ЗаполнитьСвойствоНеПодлежитМаркировке(ОписаниеДокумента);
	ДокументУчета_РассчитатьКоличествоУпаковок(ОписаниеДокумента);
	ДокументУчета_ПодобратьТоварыМаркировки(ОписаниеДокумента);
	ДокументУчета_ЗаполнитьПравилаОтраженияЭДО(ОписаниеДокумента);
	
	Если Не ЗначениеЗаполнено(ОписаниеДокумента.Склад) Тогда
		ОписаниеДокумента.Склад = Организация_ОсновнойСклад(ОписаниеДокумента.Организация);
	КонецЕсли;
	
	ДокументУчета_ЗаполнитьЭтапыМаркировки(ОписаниеДокумента);
	
	ПМ_ОбработатьСобытие_ПриЗаполненииДокументаУчета(Документ1С, ОписаниеДокумента);
	
	ДокументУчета_ЗаполнитьТоварыДокументаПослеВызоваПМ(ОписаниеДокумента);
	ДокументУчета_ОбновитьПредставлениеКлючейНоменклатуры1С(ОписаниеДокумента);
	
	Если Не ЗначениеЗаполнено(ОписаниеДокумента.ТоварыМаркировки) Тогда
		ДокументУчета_ПодобратьТоварыМаркировки(ОписаниеДокумента);
		ДокументУчета_ЗаполнитьПравилаОтраженияЭДО(ОписаниеДокумента);
	КонецЕсли;
	
КонецПроцедуры

Функция ДокументУчета_РеквизитыДокумента1С(Документ1С)
	
	Результат = Новый Структура;
	Результат.Вставить("Дата");
	Результат.Вставить("Номер");
	Результат.Вставить("ВерсияДанных");
	Результат.Вставить("Организация");
	Результат.Вставить("Склад");
	Результат.Вставить("ДокументОснование");
	Результат.Вставить("ТипДокумента");
	Результат.Вставить("Наименование");
	Результат.Вставить("Контрагент");
	Результат.Вставить("Комментарий");
	Результат.Вставить("МаршрутМаркировки");
	
	Результат.Вставить("Товары",Новый Массив);
	
	МетаданныеДокумента = Документ1С.Метаданные();
	ТипДокумента = МетаданныеДокумента.Имя;
	ПолноеИмя = МетаданныеДокумента.ПолноеИмя();
	
	НастройкаДокумента = НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента);
	
	Результат.ТипДокумента = ТипДокумента;
	
	ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(НастройкаДокумента);
	
	ЗапросШапки = Новый Запрос("ВЫБРАТЬ
	|	Документ1С.Номер КАК Номер,
	|	Документ1С.Дата КАК Дата,
	|	Документ1С.ВерсияДанных КАК ВерсияДанных,
	|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеДокументОснование,	"ДокументОснование")+",
	|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеОрганизация,		"Организация")+",
	|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеСклад,				"Склад")+",
	|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеКонтрагент,		"Контрагент")+",
	|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеКомментарий,		"Комментарий")+",
	|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеСумма,				"Сумма")+"
	|ИЗ
	|	" + ПолноеИмя + " КАК Документ1С
	|ГДЕ
	|	Документ1С.Ссылка = &Ссылка");
	
	ЗапросШапки.УстановитьПараметр("Ссылка", Документ1С);
	
	Выборка = ЗапросШапки.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат,Выборка);
		Результат.Наименование = ""+ОписаниеНастройки.Наименование+" "+Выборка.Номер+" от "+Формат(Выборка.Дата,"ДФ=dd.MM.yyyy");
		Результат.МаршрутМаркировки = ОписаниеНастройки.МаршрутМаркировки;
	Иначе
		ВызватьИсключение("Не удалось получить реквизиты документа "+Документ1С);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеНастройки.ТабличнаяЧасть) Тогда
		
		РеквизитыШапки = ОписаниеНастройки.ТабличнаяЧасть="<Реквизиты шапки>";
		
		ЗапросТоваров = Новый Запрос("ВЫБРАТЬ
		|	"+?(РеквизитыШапки, "0", "Документ1С.НомерСтроки")+" КАК НомерСтрокиДокумента,
		|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеНоменклатура,			"Номенклатура")+",
		|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеХарактеристика,		"Характеристика")+",
		|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеУпаковка,				"Упаковка")+",
		|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеСерия,					"Серия")+",
		|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеКоличество,			"Количество")+",
		|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеКоличествоУпаковок,	"КоличествоУпаковок")+",
		|	"+НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ОписаниеНастройки.ПолеЦена,					"Цена")+"
		|ИЗ
		|	" + ПолноеИмя + ?(РеквизитыШапки,"","."+ОписаниеНастройки.ТабличнаяЧасть) +" КАК Документ1С
		|ГДЕ
		|	Документ1С.Ссылка = &Ссылка
		|"+?(РеквизитыШапки,
		"",
		"УПОРЯДОЧИТЬ ПО
		|	Документ1С.НомерСтроки"));
		
		ЗапросТоваров.УстановитьПараметр("Ссылка", Документ1С);
		
		Выборка = ЗапросТоваров.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураСтроки = Новый Структура("Номенклатура, Характеристика, Упаковка, Серия, Количество, КоличествоУпаковок, Цена, НомерСтрокиДокумента");
			ЗаполнитьЗначенияСвойств(СтруктураСтроки,Выборка);
			
			Если ОписаниеНастройки.ПолеКоличество = "Идентификатор" Тогда
				СтруктураСтроки.Количество = 1;
			КонецЕсли;
			
			Результат.Товары.Добавить(СтруктураСтроки);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументУчета_Перезаполнить(ДокументУчета, Документ1С, ЗагрузитьКоды = Истина) Экспорт
	
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	
	СписокОпераций = ДокументУчета_СписокОпераций(ДокументУчета);
	Операции_ПроверитьЧтоВсеИзвестны(СписокОпераций);
	Операции_ПроверитьЧтоВсеЗавершены(СписокОпераций);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СтароеОписание = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
		
		ОписаниеДокумента = Новый_ДокументУчета();
		ОписаниеДокумента.Ссылка = СтароеОписание.Ссылка;
		ОписаниеДокумента.ВерсияДанных = СтароеОписание.ВерсияДанных;
		ОписаниеДокумента.Статусы = СтароеОписание.Статусы;
		
		ДокументУчета_Заполнить(ОписаниеДокумента, Документ1С);
		
		ТаблицаКодов = Неопределено;
		ПолученыНовыеКоды = Ложь;
		КодыДокументаОбновлены = Ложь;
		
		ПараметрыЗагрузки = Новый_ПараметрыЗагрузкиНовыхКодовВДокумент();
		ПараметрыЗагрузки.УдалитьСтарыеКоды = Истина;
		
		Если ЗагрузитьКоды Тогда
			
			РезультатПМ = ПМ_ТаблицаКодовДляНовогоДокумента(ОписаниеДокумента);
			
			ТаблицаКодов = РезультатПМ.ТаблицаКодов;
			ПолученыНовыеКоды = ЗначениеЗаполнено(ТаблицаКодов);
			
			ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, РезультатПМ.ПараметрыЗагрузкиКодов);
			
		КонецЕсли;
		
		Если Не ПолученыНовыеКоды Тогда
			ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
		КонецЕсли;
		
		ДокументУчета_ПодобратьСтарыеКлючиДокумента(ОписаниеДокумента, ТаблицаКодов, СтароеОписание, КодыДокументаОбновлены);
		ДокументУчета_ПодобратьСтарыеОтраженияВЭДО(ОписаниеДокумента, СтароеОписание);
		ДокументУчета_ПодобратьСтароеКоличествоУпаковок(ОписаниеДокумента, СтароеОписание);
		ДокументУчета_ПодобратьСтарыеПартии(ОписаниеДокумента, СтароеОписание);
		
		Если ОписаниеДокумента.Статусы.ОсновнойСтатус = СтатусыДокументовУчета.Новый И ПолученыНовыеКоды Тогда
			ОписаниеДокумента.Статусы.ОсновнойСтатус = СтатусыДокументовУчета.ВРаботе;
		КонецЕсли;
		
		ДокументУчета = ДокументУчета_Записать(ОписаниеДокумента);
		
		Если ПолученыНовыеКоды Тогда
			КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузки);
		Иначе
			Если КодыДокументаОбновлены Тогда
				КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, , Истина);
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ДокументУчета_ПодобратьСтарыеКлючиДокумента(ОписаниеДокумента, ТаблицаКодов, СтароеОписаниеДокумента, КодыДокументаОбновлены)
	
	ОтборКлючСтроки = Новый Структура("КлючСтрокиДокумента");
	
	ОписаниеДокумента.ТоварыДокумента.Колонки.Добавить("Обработан", ОписаниеТипа_Булево());
	СтароеОписаниеДокумента.ТоварыДокумента.Колонки.Добавить("Обработан", ОписаниеТипа_Булево());
	
	// Подбираем по совпадению полей от максимального к минимальному
	ВариантыОтбора = Новый Массив;
	ВариантыОтбора.Добавить(Новый Структура("НомерСтрокиДокумента, КлючНоменклатуры1С, Цена, Количество, КоличествоУпаковок, Обработан"));
	ВариантыОтбора.Добавить(Новый Структура("КлючНоменклатуры1С, Цена, Количество, КоличествоУпаковок, Обработан"));
	ВариантыОтбора.Добавить(Новый Структура("КлючНоменклатуры1С, Количество, КоличествоУпаковок, Обработан"));
	ВариантыОтбора.Добавить(Новый Структура("КлючНоменклатуры1С, Количество, Обработан"));
	ВариантыОтбора.Добавить(Новый Структура("КлючНоменклатуры1С, Обработан"));
	
	Для каждого Отбор Из ВариантыОтбора Цикл
		
		Для каждого СтрДокНов Из ОписаниеДокумента.ТоварыДокумента Цикл
			
			Если СтрДокНов.Обработан Тогда
				Продолжить;
			КонецЕсли;
			
			Отбор.Обработан = Ложь;
			ЗаполнитьЗначенияСвойств(Отбор, СтрДокНов);
			СтрДокСтар = ТаблицаЗначений_НайтиСтроку(СтароеОписаниеДокумента.ТоварыДокумента, Отбор);
			
			Если СтрДокСтар = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ОтборКлючСтроки.КлючСтрокиДокумента = СтрДокНов.КлючСтрокиДокумента;
			
			Для каждого СтрТов Из ОписаниеДокумента.ТоварыМаркировки.НайтиСтроки(ОтборКлючСтроки) Цикл
				СтрТов.КлючСтрокиДокумента = СтрДокСтар.КлючСтрокиДокумента;
			КонецЦикла;
			
			Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(ОтборКлючСтроки) Цикл
				СтрКода.КлючСтрокиДокумента = СтрДокСтар.КлючСтрокиДокумента;
				КодыДокументаОбновлены = Истина;
			КонецЦикла;
			
			Если СтрДокНов.КоличествоУпаковок < СтрДокСтар.КоличествоУпаковок Тогда
				// Сбрасываем ключи у лишних кодов
				ОтборКлючСтроки.КлючСтрокиДокумента = СтрДокСтар.КлючСтрокиДокумента;
				СтрокиКодов = ТаблицаКодов.НайтиСтроки(ОтборКлючСтроки);
				Для Сч = СтрДокНов.КоличествоУпаковок + 1 По СтрокиКодов.Количество() Цикл
					СтрокиКодов[Сч - 1].КлючСтрокиДокумента = Неопределено;
					КодыДокументаОбновлены = Истина;
				КонецЦикла;
			КонецЕсли;
			
			СтрДокНов.КлючСтрокиДокумента = СтрДокСтар.КлючСтрокиДокумента;
			СтрДокНов.Обработан = Истина;
			СтрДокСтар.Обработан = Истина;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Сбрасываем в кодах ключи, которые не удалось оставить в новом документе
	Для каждого СтрДокСтар Из СтароеОписаниеДокумента.ТоварыДокумента.НайтиСтроки(Новый Структура("Обработан", Ложь)) Цикл
		ОтборКлючСтроки.КлючСтрокиДокумента = СтрДокСтар.КлючСтрокиДокумента;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(ОтборКлючСтроки) Цикл
			СтрКода.КлючСтрокиДокумента = Неопределено;
			КодыДокументаОбновлены = Истина;
		КонецЦикла;
	КонецЦикла;
	
	ОписаниеДокумента.ТоварыДокумента.Колонки.Удалить("Обработан");
	СтароеОписаниеДокумента.ТоварыДокумента.Колонки.Удалить("Обработан");
	
КонецПроцедуры

Процедура ДокументУчета_ПодобратьСтарыеОтраженияВЭДО(ОписаниеДокумента, СтароеОписаниеДокумента)
	
	Для каждого СтрДокНов Из ОписаниеДокумента.ТоварыДокумента Цикл
		
		СтрДокСтар = СтароеОписаниеДокумента.ТоварыДокумента.Найти(СтрДокНов.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		
		Если СтрДокСтар = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрДокНов.ОтражениеВЭДО = СтрДокСтар.ОтражениеВЭДО;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ПодобратьСтароеКоличествоУпаковок(ОписаниеДокумента, СтароеОписаниеДокумента)
	
	Отбор = Новый Структура("КлючСтрокиДокумента");
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	ТоварыМаркировки = ОписаниеДокумента.ТоварыМаркировки;
	
	Для каждого СтрДокНов Из ТоварыДокумента Цикл
		
		КлючСтрокиДокумента = СтрДокНов.КлючСтрокиДокумента;
		СтрДокСтар = СтароеОписаниеДокумента.ТоварыДокумента.Найти(КлючСтрокиДокумента, "КлючСтрокиДокумента");
		
		Если СтрДокСтар = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрДокНов.КоличествоУпаковок <> СтрДокСтар.КоличествоУпаковок Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоляТовар = "Товар";
		Отбор.КлючСтрокиДокумента = КлючСтрокиДокумента;
		СтрокиТоваровМаркировки = МассивСтруктур_Сортировать(ТоварыМаркировки.НайтиСтроки(Отбор), ИмяПоляТовар);
		СтарыеСтрокиТоваровМаркировки = МассивСтруктур_Сортировать(СтароеОписаниеДокумента.ТоварыМаркировки.НайтиСтроки(Отбор), ИмяПоляТовар);
		
		Если СтрокиТоваровМаркировки.Количество() <> СтарыеСтрокиТоваровМаркировки.Количество() Тогда
			Продолжить;
		КонецЕсли;
		
		Товары = МассивСтруктур_Выгрузить(СтрокиТоваровМаркировки, ИмяПоляТовар);
		СтарыеТовары = МассивСтруктур_Выгрузить(СтарыеСтрокиТоваровМаркировки, ИмяПоляТовар);
		СвернутьМассивЛок(Товары, Истина);
		СвернутьМассивЛок(СтарыеТовары, Истина);
		
		ТоварыСтрокой = СоединитьСтроку(Товары);
		СтарыеТоварыСтрокой = СоединитьСтроку(СтарыеТовары);
		
		Если ТоварыСтрокой <> СтарыеТоварыСтрокой Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого СтрТоварыМаркировки Из СтрокиТоваровМаркировки Цикл
			
			ТоварыМаркировки.Удалить(ТоварыМаркировки.Индекс(СтрТоварыМаркировки));
			
		КонецЦикла;
		
		Для каждого СтрСтарыеТоварыМаркировки Из СтарыеСтрокиТоваровМаркировки Цикл
			
			СтрНов = ТоварыМаркировки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрНов, СтрСтарыеТоварыМаркировки);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ПодобратьСтарыеПартии(ОписаниеДокумента, СтароеОписаниеДокумента)
	
	ПравилаОтраженияВЭДО = Перечисление_ПравилаОтраженияВЭДО();
	
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	ТоварыМаркировки = ОписаниеДокумента.ТоварыМаркировки;
	
	Если ТоварыДокумента.Найти(ПравилаОтраженияВЭДО.ПартионныйУчет, "ОтражениеВЭДО") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Уже есть партии в новом документе, не подбираем старые
	ТоварыБезПартий = ТоварыМаркировки.НайтиСтроки(Новый Структура("НомерПартии", ""));
	Если ТоварыБезПартий.Количество() <> ТоварыМаркировки.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаПартий = СтароеОписаниеДокумента.ТоварыМаркировки.Скопировать();
	ТаблицаЗначений_УдалитьЗначение(ТаблицаПартий, "НомерПартии", "");
	
	Если Не ЗначениеЗаполнено(ТаблицаПартий) Тогда
		Возврат;
	КонецЕсли;
	
	ТипБулево = ОписаниеТипа_Булево();
	
	ТаблицаПартий.Колонки.Добавить("Распределено", ТипБулево);
	ТоварыМаркировки.Колонки.Добавить("ДоступенПартионныйУчет", ТипБулево);
	
	Для Каждого Стр Из ТоварыМаркировки Цикл
		СтрДокумента = ТоварыДокумента.Найти(Стр.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		Если СтрДокумента <> Неопределено Тогда
			Стр.ДоступенПартионныйУчет = (СтрДокумента.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ПартионныйУчет);
		КонецЕсли;
	КонецЦикла;
	
	ИспользоватьКлючСтрокиДокумента = Истина;
	ДокументУчета_РаспределитьПартии(ТоварыМаркировки, ТаблицаПартий, ИспользоватьКлючСтрокиДокумента);
	
	ТоварыМаркировки.Колонки.Удалить("ДоступенПартионныйУчет");
	
КонецПроцедуры

Процедура ДокументУчета_РаспределитьПартии(ТоварыМаркировки, ТаблицаПартий, ИспользоватьКлючСтрокиДокумента = Ложь) Экспорт
	
	ОтборПартийНеРаспределено = Новый Структура("Распределено", Ложь);
	
	ДокументУчета_РаспределитьПартии_КоличествоСовпадает(ТоварыМаркировки, ТаблицаПартий, ИспользоватьКлючСтрокиДокумента);
	
	НераспределенныеПартии = ТаблицаПартий.НайтиСтроки(ОтборПартийНеРаспределено);
	ДокументУчета_РаспределитьПартии_КоличествоБольше(ТоварыМаркировки, НераспределенныеПартии, ИспользоватьКлючСтрокиДокумента);
	
	НераспределенныеПартии = ТаблицаПартий.НайтиСтроки(ОтборПартийНеРаспределено);
	ДокументУчета_РаспределитьПартии_КоличествоМеньшеРавно(ТоварыМаркировки, НераспределенныеПартии, ИспользоватьКлючСтрокиДокумента);
	
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТоварыМаркировки, "Количество, КоличествоУпаковок");
	
КонецПроцедуры

Процедура ДокументУчета_РаспределитьПартии_КоличествоСовпадает(ТоварыМаркировки, ТаблицаПартий, ИспользоватьКлючСтрокиДокумента)
	
	ОтборТоварБезПарт = Новый Структура("ДоступенПартионныйУчет, НомерПартии, КоличествоУпаковок, Товар", Истина, "");
	СписокСвойств = "Товар, КоличествоУпаковок";
	
	Если ИспользоватьКлючСтрокиДокумента Тогда
		ОтборТоварБезПарт.Вставить("КлючСтрокиДокумента");
		СписокСвойств = "КлючСтрокиДокумента, Товар, КоличествоУпаковок";
	КонецЕсли;
	
	Для Каждого СтрПартии Из ТаблицаПартий Цикл
		
		ЗаполнитьЗначенияСвойств(ОтборТоварБезПарт, СтрПартии, СписокСвойств);
		СтрТоваровБезПарт = ТоварыМаркировки.НайтиСтроки(ОтборТоварБезПарт);
		
		Если СтрТоваровБезПарт.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрТоваровБезПарт[0], СтрПартии);
		СтрПартии.КоличествоУпаковок = (СтрПартии.КоличествоУпаковок - СтрТоваровБезПарт[0].КоличествоУпаковок);
		СтрПартии.Распределено = (СтрПартии.КоличествоУпаковок = 0);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_РаспределитьПартии_КоличествоМеньшеРавно(ТоварыМаркировки, ТаблицаПартий, ИспользоватьКлючСтрокиДокумента)
	
	ОтборТоварБезПарт = Новый Структура("ДоступенПартионныйУчет, НомерПартии, Товар", Истина, "");
	СписокСвойств = "Товар";
	
	Если ИспользоватьКлючСтрокиДокумента Тогда
		ОтборТоварБезПарт.Вставить("КлючСтрокиДокумента");
		СписокСвойств = "КлючСтрокиДокумента, Товар";
	КонецЕсли;
	
	Для Каждого СтрПартии Из ТаблицаПартий Цикл
		
		ЗаполнитьЗначенияСвойств(ОтборТоварБезПарт, СтрПартии, СписокСвойств);
		СтрТоваровБезПарт = ТоварыМаркировки.НайтиСтроки(ОтборТоварБезПарт);
		
		Для Каждого СтрТовара Из СтрТоваровБезПарт Цикл
			
			Если СтрТовара.КоличествоУпаковок > 0 И СтрТовара.КоличествоУпаковок <= СтрПартии.КоличествоУпаковок Тогда
				
				СтрТовара.НомерПартии = СтрПартии.НомерПартии;
				СтрПартии.КоличествоУпаковок = (СтрПартии.КоличествоУпаковок - СтрТовара.КоличествоУпаковок);
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтрПартии.Распределено = (СтрПартии.КоличествоУпаковок = 0);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_РаспределитьПартии_КоличествоБольше(ТоварыМаркировки, ТаблицаПартий, ИспользоватьКлючСтрокиДокумента)
	
	ОтборТоварБезПарт = Новый Структура("ДоступенПартионныйУчет, НомерПартии, Товар", Истина, "");
	СписокСвойств = "Товар";
	
	Если ИспользоватьКлючСтрокиДокумента Тогда
		ОтборТоварБезПарт.Вставить("КлючСтрокиДокумента");
		СписокСвойств = "КлючСтрокиДокумента, Товар";
	КонецЕсли;
	
	Для Каждого СтрПартии Из ТаблицаПартий Цикл
		
		ЗаполнитьЗначенияСвойств(ОтборТоварБезПарт, СтрПартии, СписокСвойств);
		СтрТоваровБезПарт = ТоварыМаркировки.НайтиСтроки(ОтборТоварБезПарт);
		
		Для Каждого СтрТовара Из СтрТоваровБезПарт Цикл
			
			Если СтрТовара.КоличествоУпаковок > 0 И СтрТовара.КоличествоУпаковок > СтрПартии.КоличествоУпаковок Тогда
				
				НоваяСтр = ТоварыМаркировки.Добавить();
				НоваяСтр.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
				ЗаполнитьЗначенияСвойств(НоваяСтр, СтрПартии);
				
				СтрТовара.КоличествоУпаковок = (СтрТовара.КоличествоУпаковок - НоваяСтр.КоличествоУпаковок);
				СтрПартии.КоличествоУпаковок = (СтрПартии.КоличествоУпаковок - НоваяСтр.КоличествоУпаковок);
				
				Продолжить;
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтрПартии.Распределено = (СтрПартии.КоличествоУпаковок = 0);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДокументУчета_ПрочитатьДокумент(ДокументУчета) Экспорт
	
	Возврат МодульЯдро().ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	
КонецФункции

Функция ДокументУчета_ТребуемыеКоды(ДокументУчета, ОбщийТипУпаковки = Неопределено)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыМаркировки.Товар КАК Товар,
	|	ТоварыМаркировки.КлючСтрокиДокумента КАК НовыйКлючСтрокиДокумента,
	|	ТоварыДокумента.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	МАКСИМУМ(ТоварыДокумента.КлючНоменклатуры1С.КлючНоменклатуры) КАК КлючНоменклатуры,
	|	МАКСИМУМ(ТоварыДокумента.КлючНоменклатуры1С.КлючХарактеристики) КАК КлючХарактеристики,
	|	МАКСИМУМ(ТоварыДокумента.КлючНоменклатуры1С.КлючУпаковки) КАК КлючУпаковки,
	|	МАКСИМУМ(ТоварыДокумента.КлючНоменклатуры1С.КлючСерии) КАК КлючСерии,
	|	МАКСИМУМ(ТоварыМаркировки.КоличествоУпаковок) - СУММА(ЕСТЬNULL(КолКодовДокумента.КоличествоКодов, 0)) КАК КоличествоКодовТребуется
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК ТоварыМаркировки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО ТоварыМаркировки.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК КолКодовДокумента
	|		ПО ТоварыМаркировки.КлючСтрокиДокумента = КолКодовДокумента.КлючСтрокиДокумента
	|			И (КолКодовДокумента.ДокументУчета = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КолКодовДокумента.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ТоварыМаркировки.Ссылка = &ДокументУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыМаркировки.Товар,
	|	ТоварыМаркировки.КлючСтрокиДокумента,
	|	ТоварыДокумента.КлючНоменклатуры1С
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ТоварыМаркировки.КоличествоУпаковок) - СУММА(ЕСТЬNULL(КолКодовДокумента.КоличествоКодов, 0)) > 0 И
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ИнформацияОКодах.ТипУпаковки = &МаркированныйТовар
	|					ИЛИ ИнформацияОКодах.ТипУпаковки ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) = ИСТИНА");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("МаркированныйТовар", Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_ТребуемыеКоды();
	ТаблицаЗначений_ДобавитьИзВыборки(Результат, Выборка);
	
	Если ЗначениеЗаполнено(ОбщийТипУпаковки) Тогда
		Результат.ЗаполнитьЗначения(Неопределено, "Товар");
		Результат.ЗаполнитьЗначения(ОбщийТипУпаковки, "ОбщийТипУпаковки");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ТребуемыеКодыПоНоменклатуре1С(ДокументУчета)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыДокумента.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ТоварыДокумента.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Товары.ПустаяСсылка) КАК Товар,
	|	МАКСИМУМ(ТоварыДокумента.КоличествоУпаковок) - КОЛИЧЕСТВО(КодыДокумента.КлючКода) КАК КоличествоУпаковок
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокумента
	|		ПО ТоварыДокумента.КлючСтрокиДокумента = КодыДокумента.КлючСтрокиДокумента
	|			И (КодыДокумента.ДокументУчета = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО (КодыДокумента.КлючКода = КодыМаркировки.КлючКода)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ТоварыДокумента.Ссылка = &ДокументУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыДокумента.КлючСтрокиДокумента,
	|	ТоварыДокумента.КлючНоменклатуры1С
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ТоварыДокумента.КоличествоУпаковок) - КОЛИЧЕСТВО(КодыДокумента.КлючКода) > 0 И
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ИнформацияОКодах.ТипУпаковки = &МаркированныйТовар
	|					ИЛИ ИнформацияОКодах.ТипУпаковки ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) = ИСТИНА");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("МаркированныйТовар", Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

