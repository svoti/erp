//
Функция НастройкиДокументаУчета_Прочитать(Настройка) Экспорт
	
	Возврат МодульЯдро().НастройкиДокументаУчета_Прочитать(Настройка);
	
КонецФункции

// Записывает в доп справочник настройки документа учета
//
// Параметры:
//  Настройки - Структура - см. Новый_НастройкиДокументаУчета()
//
Процедура НастройкиДокументаУчета_Записать(Настройки) Экспорт
	
	МодульЯдро().НастройкиДокументаУчета_Записать(Настройки);
	
КонецПроцедуры

Функция ДействующиеНастройкиДокументовУчета() Экспорт
	
	Результат = Новый Массив;
	
	НастройкиДокументов = НастройкиДокументовУчета_ВсеЭлементы();
	
	Для Каждого Настройка Из НастройкиДокументов Цикл
		ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(Настройка);
		Если ОписаниеНастройки.ЭтоДополнительныйТипДокумента
			Или Метаданные.Документы.Найти(ОписаниеНастройки.ТипДокумента) <> Неопределено Тогда
			Результат.Добавить(ОписаниеНастройки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_НастройкиДокументаУчета() Экспорт
	
	Возврат МодульЯдро().Новый_НастройкиДокументаУчета();
	
КонецФункции

// #КонецОбласти // НастройкиДокументов

// #Область НастройкиЗаполненияОпераций

Функция ПроверитьЗначениеНастройкиЗаполненияРеквизита(НастройкаРеквизита
	, ТипДокумента
	, ИдентификаторФормы
	, ТаблицаФормы
	, ИндексСтроки) Экспорт
	
	Результат = Истина;
	
	ПравилаЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов();
	
	Если Найти(ТипДокумента, "КонтурМаркировка_") Тогда
		ИмяТипа = "СправочникСсылка.КонтурМаркировка_ДокументыУчета";
	Иначе
		ИмяТипа = "ДокументСсылка." + ТипДокумента;
	КонецЕсли;
	
	Документ1С = ПолучитьПустуюСсылкуТипа(ИмяТипа);
	
	Если НастройкаРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.РеквизитДокумента1С Тогда
		ТекстОшибки = НСтр("ru = """
		+ "Неверное значение поля."
		+ " Необходимо указать реквизит документа 1С.""", "ru");
		Попытка
			Значение = Документ1С[НастройкаРеквизита.Значение];
		Исключение
			СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки, ИдентификаторФормы, ТаблицаФормы, "Значение", ИндексСтроки);
			Результат = Ложь;
		КонецПопытки;
	ИначеЕсли НастройкаРеквизита.ПравилоЗаполнения = ПравилаЗаполнения.Формула Тогда
		ТекстОшибки = НСтр("ru = """
		+ "Неверная формула."
		+ " Формула должна составляться по правилам написания выражения на встроенном языке 1С:Предприятия.""", "ru");
		Попытка
			Значение = Вычислить(НастройкаРеквизита.Значение);
		Исключение
			СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки, ИдентификаторФормы, ТаблицаФормы, "Значение", ИндексСтроки);
			Результат = Ложь;
		КонецПопытки;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Читает из доп справочника настройки заполнения операций
//
// Параметры:
//  Настройка - СправочникСсылка.КонтурМаркировка_ДопСправочники - настройка
// 
// Возвращаемое значение:
//  Структура - см. Новый_НастройкиЗаполненияОпераций()
//
Функция НастройкиЗаполненияОпераций_Прочитать(Настройка) Экспорт
	
	Результат = Новый_НастройкиЗаполненияОпераций();
	
	ДанныеИБ = ДопСправочник_Прочитать(Настройка);
	
	ЗаполнитьПоляСтруктуры(Результат, ДанныеИБ);
	ЗаполнитьПоляСтруктуры(Результат, ДанныеИБ.ДопРеквизиты, , "ТаблицаРеквизитов");
	
	Если ДанныеИБ.ДопРеквизиты.Свойство("ТаблицаРеквизитов") Тогда
		
		ТаблицаРеквизитов = Результат.ТаблицаРеквизитов;
		ТаблицаРеквизитовИБ = ДанныеИБ.ДопРеквизиты.ТаблицаРеквизитов;
		
		Для Каждого Строка Из ТаблицаРеквизитов Цикл
			Для Каждого СтрокаИБ Из ТаблицаРеквизитовИБ Цикл
				Если Строка.ТипОперации = СтрокаИБ.ТипОперации
					И Строка.ИмяРеквизита = СтрокаИБ.ИмяРеквизита Тогда
					ЗаполнитьЗначенияСвойств(Строка, СтрокаИБ);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Читает из доп справочника настройки заполнения операций по типу документа
//
// Параметры:
//  ТипДокумента - Строка - имя документа 1С;
// 
// Возвращаемое значение:
//  Структура - см. Новый_НастройкиЗаполненияОпераций()
//
Функция НастройкиЗаполненияОпераций_ПрочитатьПоТипуДокумента(ТипДокумента) Экспорт
	
	ДопСправочник = НастройкиЗаполненияОпераций_НайтиПоТипуДокумента(ТипДокумента);
	
	Если ЗначениеЗаполнено(ДопСправочник) Тогда
		Возврат НастройкиЗаполненияОпераций_Прочитать(ДопСправочник);
	Иначе
		Возврат Новый_НастройкиЗаполненияОпераций();
	КонецЕсли;
	
КонецФункции

// Находит настройки заполнения операций в доп справочниках по типу документа
//
// Параметры:
//  ТипДокумента - Строка - имя документа 1С;
// 
// Возвращаемое значение:
//  Структура - см. Новый_НастройкиЗаполненияОпераций()
//
Функция НастройкиЗаполненияОпераций_НайтиПоТипуДокумента(ТипДокумента) Экспорт
	
	ИмяРеквизита = "ТипДокумента";
	ИмяСправочника = Перечисление_ИменаДопСправочников().НастройкиЗаполненияОпераций;
	МассивСсылок = ДопСправочник_НайтиПоДопРеквизиту(ИмяСправочника, ИмяРеквизита, ТипДокумента);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		Результат = МассивСсылок[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает в доп справочник настройки заполнения операций
//
// Параметры:
//  ОписаниеНастроек - Структура - см. Новый_НастройкиЗаполненияОпераций()
//
Процедура НастройкиЗаполненияОпераций_Записать(ОписаниеНастроек) Экспорт
	
	ТипДокумента = ОписаниеНастроек.ТипДокумента;
	ИмяСправочника = Перечисление_ИменаДопСправочников().НастройкиЗаполненияОпераций;
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника, "ТипДокумента", ТипДокумента);
	ДанныеИБ.Наименование = ТипДокумента;
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	Для каждого Элемент Из ОписаниеНастроек Цикл
		ДанныеИБ.ДопРеквизиты.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

// Получает из базы список всех типов документов из настроек заполнения операций
//
// Параметры:
//  ТипОперации - Строка - тип операции, см. Перечисление_ТипыОпераций();
// 
// Возвращаемое значение:
//  Массив - содержит типы документов учета
//
Функция НастройкиЗаполненияОпераций_ТипыДокументов(ТипОперации)
	
	Результат = Новый Массив;
	
	Для каждого Настройка Из НастройкиЗаполненияОпераций_ВсеЭлементы() Цикл
		ОписаниеНастройки = НастройкиЗаполненияОпераций_Прочитать(Настройка);
		Если ОписаниеНастройки.ТипыОпераций.Найти(ТипОперации) <> Неопределено Тогда
			Результат.Добавить(ОписаниеНастройки.ТипДокумента);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает из базы список все настройки заполнения операций
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_ДопСправочники
//
Функция НастройкиЗаполненияОпераций_ВсеЭлементы()
	
	Возврат ДопСправочник_ВсеЭлементы(Перечисление_ИменаДопСправочников().НастройкиЗаполненияОпераций);
	
КонецФункции

Функция Новый_НастройкиЗаполненияОпераций() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТипДокумента");
	Результат.Вставить("ТипыОпераций", Новый Массив);
	
	ТипСтрока = ОписаниеТипа_Строка();
	
	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("ТипОперации", ТипСтрока);
	ТаблицаРеквизитов.Колонки.Добавить("ИмяРеквизита", ТипСтрока);
	ТаблицаРеквизитов.Колонки.Добавить("ПредставлениеРеквизита", ТипСтрока);
	ТаблицаРеквизитов.Колонки.Добавить("ПравилоЗаполнения", ТипСтрока);
	ТаблицаРеквизитов.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов"));
	ТаблицаРеквизитов.Колонки.Добавить("Значение");
	
	ПравилаЗаполнения = Перечисление_ПравилаЗаполненияРеквизитов();
	ПредставленияРеквизитов = ПредставленияРеквизитовОперацийДляАвтозаполнения();
	ТипыЗначенийРеквизитов = ТипыЗначенийРеквизитовОперацийДляАвтозаполнения();
	
	Для Каждого Элемент Из РеквизитыДляАвтозаполненияОперацийПоТипамОпераций() Цикл
		ТипОперации = Элемент.Ключ;
		РеквизитыОперации = Элемент.Значение;
		Для Каждого Реквизит Из РеквизитыОперации Цикл
			Стр = ТаблицаРеквизитов.Добавить();
			Стр.ТипОперации = ТипОперации;
			Стр.ПравилоЗаполнения = ПравилаЗаполнения.НеЗаполнять;
			Стр.ИмяРеквизита = Реквизит;
			Стр.ПредставлениеРеквизита = ПредставленияРеквизитов[Реквизит];
			Стр.ТипЗначения = ТипыЗначенийРеквизитов[Реквизит];
		КонецЦикла;
	КонецЦикла;
	
	Результат.Вставить("ТаблицаРеквизитов", ТаблицаРеквизитов);
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_ПравилаЗаполненияРеквизитов() Экспорт
	
	КлючКэш = "ПравилаЗаполненияРеквизитов";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НеЗаполнять", "Не заполнять");
	Результат.Вставить("ФиксированноеЗначение", "Фиксированное значение");
	Результат.Вставить("РеквизитДокумента1С", "Реквизит документа 1С");
	Результат.Вставить("Формула", "Формула");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_РеквизитыОперацийДляАвтозаполнения() Экспорт
	
	КлючКэш = "РеквизитыОперацийДляАвтозаполнения";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	// Вывод из оборота
	Результат.Вставить("ПричинаВыводаИзОборота", "ПричинаВыводаИзОборота");
	Результат.Вставить("НаименованиеПричиныВыводаИзОборота", "НаименованиеПричиныВыводаИзОборота");
	Результат.Вставить("ИННПолучателя", "ИННПолучателя");
	Результат.Вставить("КодСтраныПолучателя", "КодСтраныПолучателя");
	Результат.Вставить("ИдентификаторГосКонтракта", "ИдентификаторГосКонтракта");
	Результат.Вставить("ВидПервичногоДокумента", "ВидПервичногоДокумента");
	Результат.Вставить("НаименованиеПервичногоДокумента", "НаименованиеПервичногоДокумента");
	Результат.Вставить("НомерДокумента", "НомерДокумента");
	Результат.Вставить("ДатаДокумента", "ДатаДокумента");
	Результат.Вставить("ОбъемноСортовойУчет", "ОбъемноСортовойУчет");
	
	// Подбор кодов на ТСД
	Результат.Вставить("КонтактныйТелефон", "КонтактныйТелефон");
	Результат.Вставить("АдресДоставки", "АдресДоставки");
	Результат.Вставить("ПодборСПомощьюМобильногоУстройства", "ПодборСПомощьюМобильногоУстройства");
	Результат.Вставить("МобильноеУстройство", "МобильноеУстройство");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДляАвтозаполненияОперацийПоТипамОпераций()
	
	КлючКэш = "РеквизитыДляАвтозаполненияОперацийПоТипамОпераций";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ВсеРеквизиты = Перечисление_РеквизитыОперацийДляАвтозаполнения();
	
	Результат = Новый Соответствие;
	
	// Вывод из оборота
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(ВсеРеквизиты.ПричинаВыводаИзОборота);
	Реквизиты.Добавить(ВсеРеквизиты.НаименованиеПричиныВыводаИзОборота);
	Реквизиты.Добавить(ВсеРеквизиты.ИННПолучателя);
	Реквизиты.Добавить(ВсеРеквизиты.КодСтраныПолучателя);
	Реквизиты.Добавить(ВсеРеквизиты.ИдентификаторГосКонтракта);
	Реквизиты.Добавить(ВсеРеквизиты.ВидПервичногоДокумента);
	Реквизиты.Добавить(ВсеРеквизиты.НаименованиеПервичногоДокумента);
	Реквизиты.Добавить(ВсеРеквизиты.НомерДокумента);
	Реквизиты.Добавить(ВсеРеквизиты.ДатаДокумента);
	Реквизиты.Добавить(ВсеРеквизиты.ОбъемноСортовойУчет);
	
	Результат.Вставить(ТипыОпераций.ВыводИзОборота, Реквизиты);
	
	// Подбор кодов на ТСД
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(ВсеРеквизиты.КонтактныйТелефон);
	Реквизиты.Добавить(ВсеРеквизиты.АдресДоставки);
	Реквизиты.Добавить(ВсеРеквизиты.ПодборСПомощьюМобильногоУстройства);
	Реквизиты.Добавить(ВсеРеквизиты.МобильноеУстройство);
	
	Результат.Вставить(ТипыОпераций.ПодборКодовНаТСД, Реквизиты);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставленияРеквизитовОперацийДляАвтозаполнения()
	
	КлючКэш = "ПредставленияРеквизитовОперацийДляАвтозаполнения";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Реквизиты = Перечисление_РеквизитыОперацийДляАвтозаполнения();
	
	Результат = Новый Структура;
	Результат.Вставить(Реквизиты.ПричинаВыводаИзОборота, НСтр("ru = 'Причина вывода из оборота'"));
	Результат.Вставить(Реквизиты.НаименованиеПричиныВыводаИзОборота, НСтр("ru = 'Наименование причины вывода'"));
	Результат.Вставить(Реквизиты.ИННПолучателя, НСтр("ru = 'ИНН получателя'"));
	Результат.Вставить(Реквизиты.КодСтраныПолучателя, НСтр("ru = 'Страна-получатель'"));
	Результат.Вставить(Реквизиты.ИдентификаторГосКонтракта, НСтр("ru = 'Идентификатор гос.контракта'"));
	Результат.Вставить(Реквизиты.ВидПервичногоДокумента, НСтр("ru = 'Вид первичного документа'"));
	Результат.Вставить(Реквизиты.НаименованиеПервичногоДокумента, НСтр("ru = 'Наименование первичного документа'"));
	Результат.Вставить(Реквизиты.НомерДокумента, НСтр("ru = 'Номер первичного документа'"));
	Результат.Вставить(Реквизиты.ДатаДокумента, НСтр("ru = 'Дата первичного документа'"));
	Результат.Вставить(Реквизиты.ОбъемноСортовойУчет, НСтр("ru = 'Объемно-сортовой учет'"));
	Результат.Вставить(Реквизиты.КонтактныйТелефон, НСтр("ru = 'Контактный телефон'"));
	Результат.Вставить(Реквизиты.АдресДоставки, НСтр("ru = 'Адрес доставки'"));
	Результат.Вставить(Реквизиты.ПодборСПомощьюМобильногоУстройства, НСтр("ru = 'Назначить отгрузку на мобильное устройство'"));
	Результат.Вставить(Реквизиты.МобильноеУстройство, НСтр("ru = 'Мобильное устройство'"));
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

