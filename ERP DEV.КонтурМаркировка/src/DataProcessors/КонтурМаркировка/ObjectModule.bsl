// Ищет товары маркировки по штрихкодам
//
// Параметры:
//  МассивШтрихкодов - Массив - штрихкоды;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Товары
//
Функция Товары_НайтиПоШтрихкодам(МассивШтрихкодов, Организация)
	
	МассивGTIN = Новый Массив;
	Для Каждого Штрихкод Из МассивШтрихкодов Цикл
		МассивGTIN.Добавить(GTINизШтрихкодаEAN(Штрихкод));
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Производитель.ИНН КАК ПроизводительИНН
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.GTIN В(&МассивGTIN)");
	Запрос.УстановитьПараметр("МассивGTIN", МассивGTIN);
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = Новый Массив;
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	// У каждой организации свой GTIN на каждую карточку номенклатуры 1С
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Организация) И Выборка.ПроизводительИНН = Организация.ИНН Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	// У всех организаций общий GTIN на каждую карточку номенклатуры 1С
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Выборка.Сбросить();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ищет товары маркировки по артикулу
//
// Параметры:
//  Артикул - Строка - артикул;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Товары
//
Функция Товары_НайтиПоАртикулу(Артикул, Организация)
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Артикул) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Производитель.ИНН КАК ПроизводительИНН
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Артикул = &Артикул");
	Запрос.УстановитьПараметр("Артикул", Артикул);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	// У каждой организации свой GTIN на каждую карточку номенклатуру 1С
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Организация) И Выборка.ПроизводительИНН = Организация.ИНН Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	// У всех организаций общий GTIN на каждую карточку номенклатуры 1С
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Выборка.Сбросить();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив GTIN, для всех товаров
//
// Возвращаемое значение:
//  Массив - содержит строки GTIN;
