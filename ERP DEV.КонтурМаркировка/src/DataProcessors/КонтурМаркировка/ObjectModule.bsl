Функция ДокументУчета_ПроверитьСопоставлениеКодов(ДокументУчета) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	""Есть несопоставленные КИ"" КАК Вывод
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КодыДокументов.ДокументУчета = ТоварыДокумента.Ссылка
	|			И КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И ТоварыДокумента.Ссылка ЕСТЬ NULL
	|	И ИнформацияОКодах.ДляВнутреннегоУчета = ЛОЖЬ
	|	И ИнформацияОКодах.ОбщийТипУпаковки <> &АТК
	|	И ИнформацияОКодах.ОбщийТипУпаковки <> &Транспортная";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("Транспортная", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	Запрос.УстановитьПараметр("АТК", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДокументУчета_ПроверитьРезультатПроверкиКодов(ДокументУчета)
	
	Результат = Истина;
	
	Если Не ДокументУчета_ТребуетсяПроверкаКодов(ДокументУчета) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтатусыПроверки = Перечисление_СтатусыПроверкиКодовДокумента();
	РезультатПроверки = ДокументУчета_РезультатПроверкиКодов(ДокументУчета);
	
	Если Не ЗначениеЗаполнено(РезультатПроверки)
		Или РезультатПроверки = СтатусыПроверки.ЕстьОшибки
		Или РезультатПроверки = СтатусыПроверки.Неактуален Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыУчета_ПроверитьСопоставлениеКодов(ДокументыУчета)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	""Есть несопоставленные КИ"" КАК Вывод
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК КоличествоКодовДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлюч
	|		ПО КоличествоКодовДокументов.КлючСтрокиДокумента = ПустойКлюч.Ключ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КоличествоКодовДокументов.ДокументУчета = ТоварыДокумента.Ссылка
	|			И КоличествоКодовДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КоличествоКодовДокументов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КоличествоКодовДокументов.ДокументУчета В(&ДокументыУчета)
	|	И ТоварыДокумента.Ссылка ЕСТЬ NULL
	|	И ИнформацияОКодах.ДляВнутреннегоУчета = ЛОЖЬ
	|	И ИнформацияОКодах.ОбщийТипУпаковки <> &АТК
	|	И ИнформацияОКодах.ОбщийТипУпаковки <> &Транспортная";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ДокументыУчета", ЗначениеВМассиве(ДокументыУчета));
	Запрос.УстановитьПараметр("Транспортная", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	Запрос.УстановитьПараметр("АТК", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДокументыУчета_ПроверитьСопоставлениеТоваров(ДокументыУчета)
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	""Есть КИ без GTIN"" КАК Вывод
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК КоличествоКодовДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КоличествоКодовДокументов.ДокументУчета = ТоварыДокумента.Ссылка
	|			И КоличествоКодовДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КоличествоКодовДокументов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КоличествоКодовДокументов.ДокументУчета В (&ДокументыУчета)
	|	И ТоварыДокумента.НеПодлежитМаркировке = ЛОЖЬ
	|	И ТоварыДокумента.ОтражениеВЭДО = &ПУ
	|	И ИнформацияОКодах.ДляВнутреннегоУчета = ЛОЖЬ
	|	И ИнформацияОКодах.ОбщийТипУпаковки <> &АТК
	|	И ИнформацияОКодах.ОбщийТипУпаковки <> &Транспортная
	|	И ИнформацияОКодах.Товар = &ПустойТовар
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	""Есть ОСУ без GTIN""
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК ТоварыМаркировки
	|		ПО ТоварыДокумента.Ссылка = ТоварыМаркировки.Ссылка
	|			И ТоварыДокумента.КлючСтрокиДокумента = ТоварыМаркировки.КлючСтрокиДокумента
	|ГДЕ
	|	ТоварыДокумента.Ссылка В (&ДокументыУчета)
	|	И ТоварыДокумента.НеПодлежитМаркировке = ЛОЖЬ
	|	И ТоварыДокумента.ОтражениеВЭДО = &ОСУ
	|	И ЕСТЬNULL(ТоварыМаркировки.Товар, &ПустойТовар) = &ПустойТовар";
	
	ПравилаОтражения = Перечисление_ПравилаОтраженияВЭДО();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументыУчета", ДокументыУчета);
	Запрос.УстановитьПараметр("Транспортная", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	Запрос.УстановитьПараметр("АТК", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК);
	Запрос.УстановитьПараметр("ПустойТовар", ПустойТовар());
	Запрос.УстановитьПараметр("ОСУ", ПравилаОтражения.ОСУ);
	Запрос.УстановитьПараметр("ПУ", ПравилаОтражения.ПУ);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДокументыУчета_ПроверитьРезультатПроверкиКодов(ДокументыУчета)
	
	Для каждого ДокументУчета Из ДокументыУчета Цикл
		Если Не ДокументУчета_ПроверитьРезультатПроверкиКодов(ДокументУчета) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ДокументыУчета_СодержатТоварыДляОтраженияВЭДО(Документы1С)
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(Документы1С) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОтраженияВЭДО = Перечисление_ОтраженияВЭДО();
	
	Для каждого Документ1С Из Документы1С Цикл
		
		ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
		Иначе
			ОписаниеДокумента = Новый_ДокументУчета();
			ДокументУчета_Заполнить(ОписаниеДокумента, Документ1С);
		КонецЕсли;
		
		ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
		Если ТоварыДокумента.Найти(Ложь, "НеПодлежитМаркировке") <> Неопределено Тогда
			Отбор = Новый Структура("ОтражениеВЭДО", ОтраженияВЭДО.НеОтражать);
			Если ТоварыДокумента.Количество() > ТоварыДокумента.НайтиСтроки(Отбор).Количество() Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

