//
Функция СвязьНоменклатуры_ЕстьСвязь(Товар, КлючНоменклатуры1С)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СвязиНоменклатуры1С КАК Т
	|ГДЕ
	|	Т.Товар = &Товар
	|	И Т.КлючНоменклатуры1С = &КлючНоменклатуры1С");
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.УстановитьПараметр("КлючНоменклатуры1С", КлючНоменклатуры1С);
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	Возврат Результат;
	
КонецФункции

