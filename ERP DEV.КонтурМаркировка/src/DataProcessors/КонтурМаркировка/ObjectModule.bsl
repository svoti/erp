Функция ВидУпаковкиПоОбщемуТипуУпаковки(ТипУпаковки)
	
	КлючКэш = "ВидУпаковкиПоТипуУпаковкиКодаМаркировки: " + ТипУпаковки;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыУпаковок = Перечисления.КонтурМаркировка_ВидыУпаковок;
	ТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	СоответствиеВидов = Новый Соответствие;
	СоответствиеВидов.Вставить(ТипыУпаковок.ТранспортнаяУпаковка, ВидыУпаковок.Логистическая);
	СоответствиеВидов.Вставить(ТипыУпаковок.ГрупповаяУпаковка, ВидыУпаковок.Групповая);
	СоответствиеВидов.Вставить(ТипыУпаковок.ЕдиницаТовара, ВидыУпаковок.Потребительская);
	СоответствиеВидов.Вставить(ТипыУпаковок.Комплект, ВидыУпаковок.Потребительская);
	СоответствиеВидов.Вставить(ТипыУпаковок.Набор, ВидыУпаковок.Потребительская);
	
	Результат = СоответствиеВидов[ТипУпаковки];
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ШаблонОшибки = НСтр("ru = 'Не удалось определить вид упаковки по типу упаковки кода маркировки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, ТипУпаковки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТипЭтикеткиПоОбщемуТипуУпаковки(ОбщийТипУпаковки) Экспорт
	
	КлючКэш = "ТипЭтикеткиПоОбщемуТипуУпаковки: " + ОбщийТипУпаковки;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыЭтикеток = Перечисления.КонтурМаркировка_ТипыЭтикеток;
	ТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить(ТипыУпаковок.ТранспортнаяУпаковка, ТипыЭтикеток.Транспортная);
	СоответствиеТипов.Вставить(ТипыУпаковок.ГрупповаяУпаковка, ТипыЭтикеток.Групповая);
	СоответствиеТипов.Вставить(ТипыУпаковок.ЕдиницаТовара, ТипыЭтикеток.Товарная);
	СоответствиеТипов.Вставить(ТипыУпаковок.Комплект, ТипыЭтикеток.Товарная);
	СоответствиеТипов.Вставить(ТипыУпаковок.Набор, ТипыЭтикеток.Набор);
	
	Результат = СоответствиеТипов[ОбщийТипУпаковки];
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ШаблонОшибки = НСтр("ru = 'Не удалось определить тип этикетки по общему типу упаковки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, ОбщийТипУпаковки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ШаблонЭтикеткиПоТипуЭтикетки(ШаблоныЭтикеток, ТипЭтикетки)
	
