// #Область ДокументУчета

// Записывает документ учета в базу данных
//
// Параметры:
//  ОписаниеДокумента - Структура - см. Новый_ДокументУчета();
//  РассчитатьКоличествоУпаковок - Булево - (необязательный) Истина, если перед записю нужно рассчитать количество упаковок;
//
Процедура ЗаписатьДокументУчета(ОписаниеДокумента, РассчитатьКоличествоУпаковок = Ложь) Экспорт
	
	ВызыватьИсключение = Истина;
	ПроверитьУстановленнуюВерсиюМодуля(ВызыватьИсключение);
	
	Если РассчитатьКоличествоУпаковок Тогда
		ДокументУчета_РассчитатьКоличествоУпаковок(ОписаниеДокумента);
	КонецЕсли;
	
	ДокументУчета_Записать(ОписаниеДокумента);
	
КонецПроцедуры

// Возращает описание документа совместимый с ПМ
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ, который нужно прочитать
// 
// Возвращаемое значение:
//  Структура - см. Новый_ДокументУчета()
//
Функция ПрочитатьДокументУчета(ДокументУчета) Экспорт
	
	Результат = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	
	ЗаполнитьОписаниеДокументаДляСовместимостиПМ(Результат);
	
	Возврат Результат;
	
КонецФункции

// Находит документ учета в маркировке по документу 1С
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//
Функция НайтиДокументУчетаПоДокументу1С(Документ1С) Экспорт
	
	Возврат ДокументУчета_НайтиПоДокументу1С(Документ1С);
	
КонецФункции

// Находит документы учета в маркировке по документам 1С
//
// Параметры:
//  Документы1С - Массив - содержит ссылки на документы 1С;
// 
// Возвращаемое значение:
//  Массив - содержит значения СправочникСсылка.КонтурМаркировка_ДокументыУчета;
//
Функция НайтиДокументыУчетаПоДокументам1С(Документы1С) Экспорт
	
	Результат = Новый Массив;
	Для каждого Документ1С Из Документы1С Цикл
		ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			Результат.Добавить(ДокументУчета);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает документ в маркировке по документу из 1С
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//  НачатьРаботу - Булево - Истина, если нужно начать работу с документом;
//  ЗагрузитьКоды - Булево - Ложь, если нужно отключить загрузку кодов через ПМ;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//
Функция СоздатьДокументУчетаПоДокументу1С(Документ1С, НачатьРаботу = Ложь, ЗагрузитьКоды = Истина) Экспорт
	
	Возврат ДокументУчета_Создать(Документ1С, НачатьРаботу, ЗагрузитьКоды);
	
КонецФункции

// Перезаполняет документ учета
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ, который нужно прочитать
//  Документ1С - ДокументСсылка - документ 1С;
//  ЗагрузитьКоды - Булево - Ложь, если нужно отключить загрузку кодов через ПМ;
//
Процедура ПерезаполнитьДокументУчета(ДокументУчета, Документ1С, ЗагрузитьКоды = Истина) Экспорт
	
	ДокументУчета_Перезаполнить(ДокументУчета, Документ1С, ЗагрузитьКоды);
	
КонецПроцедуры

// Проверяет заполнение полей документа учета и товары маркировки
//
// Параметры:
//  ДокументУчета - ДокументСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
// 
// Возвращаемое значение:
//  Массив - содержит структуры с полями:
//   * ТекстОшибки - Строка - описание ошибки;
//   * ИмяПоля - Строка - Имя поля документа, связанного с ошибкой;
//   * ИмяТаблицы - Строка - Имя табличной, части связанной с ошибкой;
//   * НомерСтроки - Число - Номер строки табличной части;
//
Функция ПроверитьЗаполнениеДокументаУчета(ДокументУчета) Экспорт
	
	Результат = Новый Массив;
	
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	
	ОшибкиЗаполненияДокумента = ДокументУчета_ПроверитьЗаполнениеПолей(ОписаниеДокумента);
	ОшибкиТоваровМаркировки = ДокументУчета_ПроверитьТоварыМаркировки(ОписаниеДокумента);
	
	ДополнитьМассив(Результат, ОшибкиЗаполненияДокумента);
	ДополнитьМассив(Результат, ОшибкиТоваровМаркировки);
	
	Возврат Результат;
	
КонецФункции

// Возвращает основной статус документа учета
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета
// 
// Возвращаемое значение:
//  Строка - см. функцию Перечисление_СтатусыДокументовУчета()
//
Функция ОсновнойСтатусДокументаУчета(ДокументУчета) Экспорт
	
	Возврат ДокументУчета_ОсновнойСтатус(ДокументУчета);
	
КонецФункции

// Возвращает статус проверки кодов документа учета
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета
// 
// Возвращаемое значение:
//  Строка - см. функцию Перечисление_СтатусыПроверкиКодовДокумента()
//
Функция СтатусПроверкиКодовДокументаУчета(ДокументУчета) Экспорт
	
	Возврат ДокументУчета_РезультатПроверкиКодов(ДокументУчета);
	
КонецФункции

// Получает таблицу кодов маркировки по документу 1С
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//  ЗаменитьGS - Булево - Истина, если необходимо заменить разделитель GS1 на строку \u001d
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. Новый_ТаблицаКодов()
//
Функция ТаблицаКодовДокумента(Документ1С, ЗаменитьGS = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	Если ЗаменитьGS Тогда
		ТаблицаКодов_ЗаменитьРазделителиGS1(ТаблицаКодов);
	КонецЕсли;
	
	Возврат ТаблицаКодов;
	
КонецФункции

// Проверяет наличие в модуле настройки документа
//
// Параметры:
//  Документ1С - ДокументСсылка - документ, который нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если настройка есть
//
Функция ДокументДопустимВМаркировке(Документ1С) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НастройкаДокумента = НастройкиДокументовУчета_НайтиПоТипуДокумента(Документ1С.Метаданные().Имя, Ложь);
	
	Возврат ЗначениеЗаполнено(НастройкаДокумента);
	
КонецФункции

// Определяет наличие маркируемого товара в документе
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
// 
// Возвращаемое значение:
//  Булево - Истина, если в документе есть хотябы один маркируемый товар;
//
Функция ДокументСодержитМаркируемыйТовар(Документ1С) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан документ для определения наличия маркируемого товара'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	Иначе
		ОписаниеДокумента = Новый_ДокументУчета();
		ДокументУчета_Заполнить(ОписаниеДокумента, Документ1С);
	КонецЕсли;
	
	Возврат (ОписаниеДокумента.ТоварыДокумента.Найти(Ложь, "НеПодлежитМаркировке") <> Неопределено);
	
КонецФункции

// Проверяет в документе статус кодов "Выпущен" и наличие полных кодов
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
// 
// Возвращаемое значение:
//  Булево - Истина, если по документу можно сформировать отчет о нанесении
//
Функция МожноСформироватьОтчетОНанесенииПоДокументу(Документ1С) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
	Если ДокументУчета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТабКодов.КлючКода КАК КлючКода
	|ИЗ
	|	ТаблицаКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабКодов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (КодыМаркировки.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|ГДЕ
	|	ИнформацияОКодах.ЕстьПолныйКод
	|	И СтатусыКодов.Статус = &Выпущен");
	Запрос.УстановитьПараметр("Выпущен", Перечисление_СтатусыКодов().Выпущен);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Находит или создает документ учета по документу 1С и заполняет его свободными кодами из заказов
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//  ПодобратьЕслиДостаточно - Булево - (необязательнй) Истина, если кодов должно быть достаточно для всех позиций документа;
// 
// Возвращаемое значение:
//  Булево - Истина, если удалось подобрать хоть один код при "ПодобратьЕслиДостаточно = Ложь"
//           Истина, если удалось подобрать все коды при "ПодобратьЕслиДостаточно = Истина"
//
Функция ПодобратьКодыИзСвободногоОстаткаВДокумент(Документ1С, ПодобратьЕслиДостаточно = Ложь) Экспорт
	
	ДокументУчета = ДокументУчета_Создать(Документ1С, Истина);
	ТребуемыеКоды = ДокументУчета_ТребуемыеКоды(ДокументУчета);
	
	Если ПодобратьЕслиДостаточно Тогда
		
		ТаблицаКодов = ТаблицаКодовДокумента(Документ1С);
		ДокументУчета_ПодобратьНовыеКодыИзЗаказов(ДокументУчета, ТребуемыеКоды);
		
		УдалосьПодобрать = (ТребуемыеКоды.Итог("КоличествоКодовТребуется") = ТребуемыеКоды.Итог("КоличествоКодовПодобрано"));
		Если Не УдалосьПодобрать Тогда
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета);
		КонецЕсли;
		
	Иначе
		ДокументУчета_ПодобратьНовыеКодыИзЗаказов(ДокументУчета, ТребуемыеКоды);
		УдалосьПодобрать = (ТребуемыеКоды.Итог("КоличествоКодовПодобрано") > 0);
	КонецЕсли;
	
	Возврат УдалосьПодобрать;
	
КонецФункции

// Устанавливает дату печати кодов и основной статус операций печати по документу
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
//
Процедура ОтметитьНапечатанныеКодыПоДокументу(Документ1С) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		ТаблицаКодов_ПометитьКодыНапечатанными(ТаблицаКодов);
		
		Для Каждого Операция Из Операция_НайтиОперации(ТипыОпераций.ПечатьКодов, ДокументУчета) Цикл
			ОсновнойСтатус = Операция_ОсновнойСтатус(Операция);
			Если ОсновнойСтатус <> СтатусыОпераций.КодыНапечатаны Тогда
				ОсновнойСтатус = СтатусыОпераций.КодыНапечатаны;
				СтатусыОперации_ЗаписатьОсновнойСтатус(Операция, ОсновнойСтатус);
			КонецЕсли;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Получает статусы кодов маркировки по документу 1С из сервиса Контур.Маркировка
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
//  ОбновитьСтатусыВложенныхКодов - Булево - Истина, если требуется обновить статусы вложенных кодов
// 
// Возвращаемое значение:
//  Булево - Истина, если обновился статус хотя-бы у одного кода
//
Функция ОбновитьСтатусыКодовДокумента(Документ1С, ОбновитьСтатусыВложенныхКодов = Истина) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	Результат = ДокументУчета_ОбновитьСтатусыКодов(ДокументУчета, ОбновитьСтатусыВложенныхКодов);
	
	Возврат Результат;
	
КонецФункции

// Завершает работу с документом.
// У связанного с документом 1С документа учета устанавливает следующие значения:
//  ДокументУчета.Статусы.ОсновнойСтатус = Завершен
//  ДокументУчета.Статусы.ТребуемоеДействие = РаботаЗавершена
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
//
Процедура ЗавершитьРаботуСДокументом(Документ1С) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	СтатусыДокумента = Новый_ДокументУчета_Статусы();
	СтатусыДокумента.ОсновнойСтатус = Перечисление_СтатусыДокументовУчета().Завершен;
	СтатусыДокумента.ТребуемоеДействие = Перечисление_ТребуемыеДействияДокументовУчета().РаботаЗавершена;
	
	СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента);
	
КонецПроцедуры

// Проверяет наличие в документе учета завершенных операций вывода кодов из оборота
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
// 
// Возвращаемое значение:
//  Булево - Истина, если операции с выводом из оборота в документе учета есть
//
Функция ДокументСодержитВыводаИзОборота(Документ1С) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	ПодходящиеТипы = Новый Массив;
	ПодходящиеТипы.Добавить(ТипыОпераций.ВыводИзОборота);
	ПодходящиеТипы.Добавить(ТипыОпераций.СообщениеОбОтгрузке);
	
	СписокОпераций = ДокументУчета_СписокОпераций(ДокументУчета, ПодходящиеТипы, СтатусыОпераций.ОперацияЗавершена);
	
	Результат = ЗначениеЗаполнено(СписокОпераций);
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие организации маркировки, соответствующей организации документа
//
// Параметры:
//  Документ1С - ДокументСсылка - документ, который нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если организация есть
//
Функция ОрганизацияДокументаЗарегистрированаВМаркировке(Документ1С) Экспорт
	
	РеквизитыДокумента1С = ДокументУчета_РеквизитыДокумента1С(Документ1С);
	Организация = Организация_НайтиПоОрганизации1С(РеквизитыДокумента1С.Организация);
	
	Возврат ЗначениеЗаполнено(Организация);
	
КонецФункции

// Запускает проверку кодов документа учета
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//
Процедура ПроверитьКодыДокументаУчета(Документ) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	ДокументУчета_ПроверитьКоды(ДокументУчета);
	
КонецПроцедуры

// Проверяет необходимость выполнения проверки кодов в документе
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
// 
// Возвращаемое значение:
//  Булево - Истина, если требуется проверка кодов
//
Функция ТребуетсяПроверкаКодовДокумента(Документ) Экспорт

	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	Результат = ДокументУчета_ТребуетсяПроверкаКодов(ДокументУчета);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ДокументУчета

// #Область Операции

// Записывает операцию в базу
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
// 
// Возвращаемое значение:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - записанная операция
//
Функция ЗаписатьОперацию(ОписаниеОперации) Экспорт
	
	ВызыватьИсключение = Истина;
	ПроверитьУстановленнуюВерсиюМодуля(ВызыватьИсключение);
	
	Возврат Операция_Записать(ОписаниеОперации);
	
КонецФункции

// Возвращает описание операции совместимое с ПМ
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция
// 
// Возвращаемое значение:
//  Операция - Структура - см. НовоеОписаниеОперации()
//
Функция ПрочитатьОперацию(Операция) Экспорт
	
	Результат = Операция_ПрочитатьОперацию(Операция);
	
	ЗаполнитьОписаниеОперацииДляСовместимостиПМ(Результат);
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу операций по документу учета с отобром по типам и статусам
//
// Параметры:
//  Документ - СправочникСсылка.КонтурМаркировка_ДокументыУчета, ДокументСсылка - документ 1С или документ учета;
//  ТипыОпераций - Массив - (необязательный) фильтр по типам операций, см Перечисление_ТипыОпераций();
//  СтатусыОпераций - Массив - (необязательный) фильтр по статусам операций, см. Перечисление_СтатусыОпераций();
//  ОперацииОснования - Массив - (необязательный) фильтр по операциям основания;
//  БезОперацииОснования - Булево - (необязадельный) Истина, если нужны операции в которых нет операции основания;
//
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//   * ОперацияСсылка - СправочникСсылка.КонтурМаркировка_Операции;
//   * ТипОперации    - Строка - см. Перечисление_ТипыОпераций();
//   * Статус         - Строка - см. Перечисление_СтатусыОпераций();
//
Функция ОперацииДокумента(Документ
	, ТипыОпераций = Неопределено
	, СтатусыОпераций = Неопределено
	, ОперацииОснования = Неопределено
	, БезОперацииОснования = Ложь) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ);
	Результат = ДокументУчета_СписокОпераций(ДокументУчета, ТипыОпераций, СтатусыОпераций, ОперацииОснования, БезОперацииОснования);
	Результат.Колонки.Операция.Имя = "ОперацияСсылка";
	
	Возврат Результат;
	
КонецФункции

// Создает операцию указанного типа, заполняет ее данными документа и записывает в базу
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//             - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//  ТипОперации - Строка - см. Перечисление_ТипыОпераций();
//  ОперацияОснование - СправочникСсылка.КонтурМаркировка_Операции - (необязательный)
//                           операция, на основании которой создается новая операция;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции - созданная операция
//
Функция СоздатьОперациюПоДокументу(Документ1С, ТипОперации, ОперацияОснование = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОперации) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	Результат = Операция_Создать(ТипОперации, ДокументУчета, ОперацияОснование);
	
	Возврат Результат;
	
КонецФункции

// Создает и заполняет операцию по таблице кодов
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//  ТипОперации - Строка - см. Перечисление_ТипыОпераций();
//  ТаблицаКодов - ТаблицаЗначений - см. Новый_ТаблицаКодов()
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции - созданная операция
//
Функция СоздатьОперациюПоДокументуИЗагрузитьКоды(Документ1С, ТипОперации, ТаблицаКодов) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОперации) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, Истина);
	
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
	
	Возврат Операция_Создать(ТипОперации, ДокументУчета, , , ТаблицаКодов);
	
КонецФункции

// Создает и записывает новую операцию печати и заполняет ее кодами документа
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ОперацияОснование - СправочникСсылка.КонтурМаркировка_Операции - (необязательный) операция,
//                                               на основании которой создается новая операция;
//  ПараметрыПодбораКодов - Структура - (необязательный):
//   * Товар - СправочникСсылка.КонтурМаркировка_Товары - (необязательный), товар;
//   * КлючНоменклатуры1С - СправочникСсылка.КонтурМаркировка_Товары - (необязательный), ключ номенклатуры если есть;
//   * Номенклатура - СправочникСсылка - (необязательный), номенклатура 1С;
//   * Характеристика - СправочникСсылка - (необязательный), характеристика номенклатуры;
//   * Упаковка - СправочникСсылка - (необязательный), упаковка;
//   * Серия - СправочникСсылка - (необязательный), серия;
//   * КоличествоКодовТребуется - Число - количество кодов, которые нужно подобрать в операцию печати (может подобрать меньше );
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции - созданная операция печати
//
Функция СоздатьОперациюПечатиПоДокументу(Документ, ОперацияОснование = Неопределено, ПараметрыПодбораКодов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Невозможно создать операцию печати, не указан документ'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	
	ПараметрыПодбора = Неопределено;
	Если ПараметрыПодбораКодов <> Неопределено Тогда
		
		ПараметрыПодбора = Новый_ПараметрыПодбораКодовДляНанесения();
		ЗаполнитьЗначенияСвойств(ПараметрыПодбора, ПараметрыПодбораКодов);
		
		Если ПараметрыПодбораКодов.Свойство("Номенклатура")
			И Не ЗначениеЗаполнено(ПараметрыПодбора.КлючНоменклатуры1С) Тогда
			АналитикаНоменклатуры = Новый_АналитикаНоменклатуры1С(ПараметрыПодбораКодов);
			ПараметрыПодбора.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(АналитикаНоменклатуры);
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Операция_СоздатьИЗаполнитьОперациюПечати(ДокументУчета, ОперацияОснование, ПараметрыПодбора);
	
	Возврат Результат;
	
КонецФункции

// Возвращает коды из электронного документа, на основании которого создана сверка на приемке
//
// Параметры:
//  ОрганизацияПолучатель - СправочникСсылка - организация получатель электронного документа;
//  ИННОтправителя        - Строка - ИНН отправителя электронного документа;
//  НомерДокумента        - Строка - номер электронного документа;
//  ДатаДокумента         - Дата   - дата электронного документа (с точностью до дня);
//  ОписаниеОшибки        - Строка - исходящий параметр, содержит ошибку возникшую при выполнении функции;
// 
// Возвращаемое значение:
//  Массив - содержит структуры с полями:
//   * НомерСтроки        - Число  - номер строки в табличной части электронного документа;
//   * НаименованиеТовара - Строка - наименование товара;
//   * КодыМаркировки     - Массив - содержит структуры с полями:
//      ** КодМаркировки          - Строка - значение штрихкода;
//      ** ВложенныеКоды          - Массив - содержит аналогичные структуры с вложенными кодами;
//      ** Отсканирован           - Булево, Неопределено - Истина, если код был отсканирован;
//      ** ВведенВОборот          - Булево, Неопределено - Ложь, если код не введен в оборот;
//      ** ПринадлежитОтправителю - Булево, Неопределено - Ложь, если код не принадлежит отправителю;
//      ** КорректныйФорматКода   - Булево, Неопределено - Ложь, если код имеет некорректный формат передачи в УПД;
//      ** ПройденаПроверкаРД     - Булево, Неопределено - Ложь, если код имеет ошибки разрешительной документации;
//
Функция КодыДокументаИзСверкиНаПриемке(ОрганизацияПолучатель, ИННОтправителя, НомерДокумента, ДатаДокумента,
	ОписаниеОшибки = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Организация = Организация_НайтиПоОрганизации1С(ОрганизацияПолучатель);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		
		ТекстОшибки = НСтр("ru = 'Не удалось найти настройку организации ""%1"" в подсистеме маркировки'");
		ОписаниеОшибки = ПараметрыВСтроку(ТекстОшибки, ОрганизацияПолучатель);
		
		Возврат Результат;
		
	КонецЕсли;
	
	Операция = Операция_НайтиОперацию_ВходящийУПД(Организация, ИННОтправителя, НомерДокумента, ДатаДокумента);
	
	Если Не ЗначениеЗаполнено(Операция) Тогда
		
		ТекстОшибки = НСтр("ru = 'Не удалось найти операцию сверки на приемке по электронному документу №%1 от %2'");
		ДатаДокументаСтрокой = Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
		ОписаниеОшибки = ПараметрыВСтроку(ТекстОшибки, НомерДокумента, ДатаДокументаСтрокой);
		
		Возврат Результат;
		
	КонецЕсли;
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	РезультатСверки = Операция_ВходящийУПД_РезультатСверки(ОписаниеОперации);
	
	Результат = РезультатСверки.КодыДокумента;
	
	Возврат Результат;
	
КонецФункции

// Удаляет все операции указанного типа по документу 1С
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С;
//  ТипОпераций - Строка - см. Перечисление_ТипыОпераций();
//
Процедура УдалитьОперацииПоДокументу(Документ, ТипОпераций) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОпераций) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	МассивОпераций = Операция_НайтиОперации(ТипОпераций, ДокументУчета);
	
	УдалитьОперации(МассивОпераций);
	
КонецПроцедуры

// Удаляет операции маркировки из справочника
//
// Параметры:
//  МассивОпераций - Массив из СправочникСсылка.КонтурМаркировка_Операции
//
Процедура УдалитьОперации(МассивОпераций) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		Операции_Удалить(МассивОпераций);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Перезаполняет операцию маркировки
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция
//
Процедура ПерезаполнитьОперацию(Операция) Экспорт
	
	Операция_Перезаполнить(Операция);
	
КонецПроцедуры

// Возвращает статус первой незавершенной операции или статус последней если все операции завершены
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ТипОперации - Строка - см. Перечисление_ТипыОпераций();
//
// Возвращаемое значение:
//  Строка - статус операции;
//
Функция СтатусОперацииПоДокументу(Документ, ТипОперации) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОперации) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	СписокОпераций = ДокументУчета_СписокОпераций(ДокументУчета, ТипОперации);
	
	Если Не ЗначениеЗаполнено(СписокОпераций) Тогда
		ВызватьИсключение НСтр("ru = 'Не найдена подходящая операция для получения статуса'");
	КонецЕсли;
	
	ЗавершенныеСтатусы = ЗавершенныеСтатусыОпераций();
	
	Результат = Неопределено;
	Для Каждого Стр Из СписокОпераций Цикл
		Результат = Стр.Статус;
		Если Не МассивСодержитЗначение(ЗавершенныеСтатусы, Стр.Статус) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает основной статус операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция;
// 
// Возвращаемое значение:
//  Строка - см. Перечисление_СтатусыОпераций()
//
Функция ОсновнойСтатусОперации(Операция) Экспорт
	
	Если Не ЗначениеЗаполнено(Операция) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана операция для получения основного статуса'");
	КонецЕсли;
	
	Результат = Операция_ОсновнойСтатус(Операция);
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив операций указанного типа по документу
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ТипОпераций - Строка - см. Перечисление_ТипыОпераций();
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.КонтурМаркировка_Операции - операции;
//
Функция ОперацииПоДокументу(Документ, ТипОпераций) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ 1С'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОпераций) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен тип операции'");
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	Результат = Операция_НайтиОперации(ТипОпераций, ДокументУчета);
	
	Возврат Результат;
	
КонецФункции

// Добавляет операцию в регистр сведений очередь обмена
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция;
//
Процедура ДобавитьОперациюВОчередьОбмена(Операция) Экспорт
	
	Если Не ЗначениеЗаполнено(Операция) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана операция, которую надо добавить в очередь обмена'");
	КонецЕсли;
	
	Если Задача_Прочитать(Операция) <> Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Работа по операции уже начата'");
	КонецЕсли;
	
	Задача_Создать(Операция);
	
КонецПроцедуры

// Получает коды маркировки операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, коды которой нужно получить;
//  КлючСтрокиОперации - УникальныйИдентификатор - (необязательный) ключ строки операции основания;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. Новый_ТаблицаКодов();
//
Функция ПрочитатьКодыОперации(Операция, КлючСтрокиОперации = Неопределено) Экспорт
	
	Возврат КодыОпераций_Прочитать(Операция, КлючСтрокиОперации);
	
КонецФункции

// Проверяет заполнение операции
//
// Параметры:
//  Операция - СправочникСсылка.Операция, Структура - операция или см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  Массив - содержит структуры с полями:
//   * ТекстОшибки - Строка - описание ошибки;
//   * ИмяПоля - Строка - имя поля документа, связанного с ошибкой;
//   * ИмяТаблицы - Строка - имя табличной, части связанной с ошибкой;
//   * НомерСтроки - Число - номер строки табличной части;
//
Функция ПроверитьЗаполнениеОперации(Операция) Экспорт
	
	Если ТипЗнч(Операция) = Тип("СправочникСсылка.КонтурМаркировка_Операции") Тогда
		ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Иначе
		ОписаниеОперации = Операция;
	КонецЕсли;
	
	Возврат Операция_Проверить(ОписаниеОперации);
	
КонецФункции

// Создает, ставит в очередь обмена и возвращает операцию резервирования номеров партий
//
// Параметры:
//  НомераПартий - Массив, Строка - номера партий;
//  ВидПродукции - ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - вид продукции;
//  Организация1С - СправочникСсылка - организация 1С;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции - операция резервирования
//
Функция ЗарезервироватьНомераПартий(НомераПартий, ВидПродукции, Организация1С) Экспорт
	
	Если ТипЗнч(Организация1С) = Тип("СправочникСсылка.КонтурМаркировка_Организации") Тогда
		Организация = Организация1С;
	Иначе
		Организация = Организация_НайтиПоОрганизации1С(Организация1С, Истина);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомераПартий) Тогда
		ВызватьИсключение НСтр("ru='Не указаны номера партий для резервирования'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВызватьИсключение НСтр("ru='Не указан вид продукции для резервирования партий'");
	КонецЕсли;
	
	Склад = СкладОрганизации(Организация);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = НастройкиМодуля().СкладПоУмолчанию;
	КонецЕсли;
	
	ОписаниеОперации = Новый_Операция();
	ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().РезервированиеПартий;
	ОписаниеОперации.ВидПродукции = ВидПродукции;
	ОписаниеОперации.Организация = Организация;
	ОписаниеОперации.Склад = Склад;
	
	ТаблицаЗначений_ЗагрузитьМассив(ОписаниеОперации.Товары, ЗначениеВМассиве(НомераПартий), "НомерПартии");
	
	Операция = Операция_Записать(ОписаниеОперации);
	ДобавитьОперациюВОчередьОбмена(Операция);
	
	ОшибкиЗаполнения = ПроверитьЗаполнениеОперации(Операция);
	Если ЗначениеЗаполнено(ОшибкиЗаполнения) Тогда
		Ошибки = МассивСтруктур_Выгрузить(ОшибкиЗаполнения, "ТекстОшибки");
		ОписаниеЗадачи = Задача_Прочитать(Операция);
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, СоединитьСтроку(Ошибки, Символы.ПС));
	КонецЕсли;
	
	Возврат Операция;
	
КонецФункции

// Возвращает статус резервирования номеров партий указанных в операции
//
// Параметры:
//  ОперацияРезервирования - СправочникСсылка.КонтурМаркировка_Операции - операция резервирования;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//   * НомерПартии    - Строка - номер партии;
//   * СтатусОперации - Строка - см. Перечисление_СтатусыОпераций();
//   * ОписаниеОшибки - Строка - описание ошибки;
//
Функция СтатусРезервированияНомеровПартийПоОперации(ОперацияРезервирования) Экспорт
	
	Если Не ЗначениеЗаполнено(ОперацияРезервирования) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана операция резервирования партий'");
	КонецЕсли;
	
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	ИменаДопРеквизитов = Перечисление_ИменаДопРеквизитов();
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОперацияРезервирования);
	ОсновнойСтатус = Операция_ОсновнойСтатус(ОперацияРезервирования);
	НомераПартий = ТаблицаЗначений_ВыгрузитьКолонку(ОписаниеОперации.Товары, "НомерПартии", Истина);
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Операции.Ссылка КАК Операция,
	|	НомераПартий.Значение КАК НомерПартии,
	|	ОсновныеСтатусы.Статус КАК СтатусОперации,
	|	ОчередьОбмена.ОписаниеОшибки КАК ОписаниеОшибки
	|ПОМЕСТИТЬ СвоиОперации
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НомераПартий
	|		ПО Операции.Ссылка = НомераПартий.Объект
	|			И (НомераПартий.ИмяРеквизита = &РеквизитНомерПартии)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ПО Операции.Ссылка = ОчередьОбмена.Операция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК ОсновныеСтатусы
	|		ПО Операции.Ссылка = ОсновныеСтатусы.Операция
	|			И (ОсновныеСтатусы.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	Операции.ОперацияОснование = &ОперацияРезервирования
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Операция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомераПартий.Объект КАК Операция,
	|	НомераПартий.Значение КАК НомерПартии,
	|	ОсновныеСтатусы.Статус КАК СтатусОперации,
	|	ОчередьОбмена.ОписаниеОшибки КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ЧужиеОперации
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НомераПартий
	|		ЛЕВОЕ СОЕДИНЕНИЕ СвоиОперации КАК СвоиОперации
	|		ПО НомераПартий.Объект = СвоиОперации.Операция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ПО НомераПартий.Объект = ОчередьОбмена.Операция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК ОсновныеСтатусы
	|		ПО НомераПартий.Объект = ОсновныеСтатусы.Операция
	|			И (ОсновныеСтатусы.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	НомераПартий.Значение В(&НомераПартий)
	|	И НомераПартий.ИмяРеквизита = &РеквизитНомерПартии
	|	И НомераПартий.Объект ССЫЛКА Справочник.КонтурМаркировка_Операции
	|	И НомераПартий.Объект.ТипОперации = &РезервированиеОднойПартии
	|	И СвоиОперации.Операция ЕСТЬ NULL");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НомераПартий", НомераПартий);
	Запрос.УстановитьПараметр("ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	Запрос.УстановитьПараметр("РеквизитНомерПартии", ИменаДопРеквизитов.НомерПартии);
	Запрос.УстановитьПараметр("ОперацияРезервирования", ОперацияРезервирования);
	Запрос.УстановитьПараметр("РезервированиеОднойПартии", ТипыОпераций.РезервированиеОднойПартии);
	Запрос.Выполнить();
	
	СвоиОперации = ТаблицаИзЗапроса(МенеджерВТ, "СвоиОперации");
	ЧужиеОперации = ТаблицаИзЗапроса(МенеджерВТ, "ЧужиеОперации");
	МенеджерВТ.Закрыть();
	
	ТипСтрока = ОписаниеТипа_Строка();
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерПартии", ТипСтрока);
	Результат.Колонки.Добавить("СтатусОперации", ТипСтрока);
	Результат.Колонки.Добавить("ОписаниеОшибки", ТипСтрока);
	
	Для Каждого НомерПартии Из НомераПартий Цикл
		
		СтрПарт = Результат.Добавить();
		СтрПарт.НомерПартии = НомерПартии;
		СтрПарт.СтатусОперации = ОсновнойСтатус;
		
		СтрОпер = СвоиОперации.Найти(НомерПартии, "НомерПартии");
		Если СтрОпер = Неопределено Тогда
			СтрОпер = ЧужиеОперации.Найти(НомерПартии, "НомерПартии");
		КонецЕсли;
		
		Если СтрОпер <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрПарт, СтрОпер);
			Если ЗначениеЗаполнено(СтрОпер.ОписаниеОшибки) Тогда
				СтрПарт.ОписаниеОшибки = Задача_Прочитать(СтрОпер.Операция).ДопРеквизиты.КраткоеОписаниеОшибки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Операции

// #Область КодыМаркировки

// Добавляет коды в документ
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ТаблицаКодов  - ТаблицаЗначений - см. ТаблицаНовыхКодов();
//  ПараметрыЗагрузкиКодов - Структура - (необязательный), см. ПараметрыЗагрузкиНовыхКодовВДокумент()
//
Процедура ДобавитьНовыеКодыВДокумент(Документ, ТаблицаКодов, ПараметрыЗагрузкиКодов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен документ'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена коллекция кодов'");
	КонецЕсли;
	
	Если ПараметрыЗагрузкиКодов = Неопределено Тогда
		ПараметрыЗагрузкиКодов = Новый_ПараметрыЗагрузкиНовыхКодовВДокумент();
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	
	КодыДокументов_ДобавитьНовыеКоды(ТаблицаКодов, ДокументУчета, ПараметрыЗагрузкиКодов);
	
	Функциональность = Перечисление_ФункциональностьМодуля().ДобавитьКодыВДокумент;
	Метрика_Функциональность_ЗагрузкаКодовВДокумент(ДокументУчета, Функциональность);
	
КонецПроцедуры

// Нормализует коды маркировки и создает карточки товаров если их нет
//
// Параметры:
//  ОписанияИлиТаблицаКодов - Массив, Таблица значений - содержит структуры см. функцию ОписаниеКодаМаркировки()
//                            или строки см. функцию ТаблицаНовыхКодов(), в которых поле КодМаркировки должно быть заполнено
//  Организация1С - СправочникСсылка - организация;
// 
// Возвращаемое значение:
//  Булево - Ложь, если при распознавании кодов возникли ошибки,
//           детали указаны в поле ОписаниеОшибки
//
Функция РаспознатьКоды(ОписанияИлиТаблицаКодов, Организация1С) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписанияИлиТаблицаКодов) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Организация1С) = Тип("СправочникСсылка.КонтурМаркировка_Организации") Тогда
		Организация = Организация1С;
	Иначе
		Организация = Организация_НайтиПоОрганизации1С(Организация1С, Истина);
	КонецЕсли;
	
	Если ТипЗнч(ОписанияИлиТаблицаКодов) = Тип("ТаблицаЗначений") Тогда
		ТаблицаКодов = ОписанияИлиТаблицаКодов;
		ВосстановитьТаблицуКодовДляСовместимостиМодуль(ТаблицаКодов);
	Иначе
		ТаблицаКодов = ТаблицаКодовИзОписанийКодов(ОписанияИлиТаблицаКодов);
	КонецЕсли;
	
	Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
	
	Если ЭтоМассив(ОписанияИлиТаблицаКодов) Тогда
		ОписанияИлиТаблицаКодов = ОписанияКодовИзТаблицыКодов(ТаблицаКодов);
	ИначеЕсли ЭтоСтруктура(ОписанияИлиТаблицаКодов) Тогда
		ОписанияИлиТаблицаКодов = ОписанияКодовИзТаблицыКодов(ТаблицаКодов)[0];
	Иначе
		ОписанияИлиТаблицаКодов = ТаблицаКодов;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Генерирует нужное количество новых штрихкодов для агрегатов
//
// Параметры:
//  ВидАгрегата - СправочникСсылка.КонтурМаркировка_ВидыАгрегатов - вид агрегата;
//  КоличествоКодов - Число - (необязательный) количество кодов, которые нужно сгенерировать;
// 
// Возвращаемое значение:
//  Массив - содержит строки с новыми кодами
//
Функция СформироватьНовыеКодыАгрегатов(ВидАгрегата, КоличествоКодов = 1) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ТипШтрихкода = ВидАгрегата.ТипШтрихкода;
		КодыАгрегатов = НовыеКодыТранспортныхУпаковок(ВидАгрегата, КоличествоКодов);
		
		ТаблицаКодов = Новый_ТаблицаКодов();
		Для каждого КодАгрегата Из КодыАгрегатов Цикл
			Стр = ТаблицаКодов.Добавить();
			Стр.ДляНанесения = Истина;
			Стр.КодМаркировки = КодАгрегата;
			Стр.ПолныйКод = КодАгрегата;
			Стр.ТипШтрихкода = ТипШтрихкода;
			Стр.ВидАгрегата = ВидАгрегата;
			Стр.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка;
			Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
		КонецЦикла;
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		ПолныеКоды_Записать(ТаблицаКодов);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат КодыАгрегатов;
	
КонецФункции

// Генерирует нужное количество новых штрихкодов для агрегатов и добавляет их в документ учета
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ВидАгрегата - СправочникСсылка.КонтурМаркировка_ВидыАгрегатов - вид агрегата;
//  КоличествоКодов - Число - (необязательный) количество кодов, которые нужно сгенерировать;
//
// Возвращаемое значение:
//  ТаблицаКодов - ТаблицаЗначений - см. Новый_ТаблицаКодов();
//
Функция СформироватьНовыеКодыАгрегатовИДобавитьВДокумент(Документ, ВидАгрегата, КоличествоКодов = 1) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ТипШтрихкода = ВидАгрегата.ТипШтрихкода;
		КодыАгрегатов = НовыеКодыТранспортныхУпаковок(ВидАгрегата, КоличествоКодов);
		
		ТаблицаКодов = Новый_ТаблицаКодов();
		Для каждого КодАгрегата Из КодыАгрегатов Цикл
			Стр = ТаблицаКодов.Добавить();
			Стр.ДляНанесения = Истина;
			Стр.КодМаркировки = КодАгрегата;
			Стр.ПолныйКод = КодАгрегата;
			Стр.ТипШтрихкода = ТипШтрихкода;
			Стр.ВидАгрегата = ВидАгрегата;
			Стр.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка;
			Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
		КонецЦикла;
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		ПолныеКоды_Записать(ТаблицаКодов);
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат ТаблицаКодов;
	
КонецФункции

// Пытается распознать коды маркировки
// Требуется авторизация в сервсие
//
// Параметры:
//  ТаблицаКодов - Таблица значений - см. Новый_ТаблицаКодов()
//
Процедура НормализоватьКоды(ТаблицаКодов, Организация = Неопределено, ВызыватьИсключение = Истина) Экспорт
	
	ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, ВызыватьИсключение);
	
КонецПроцедуры

// Подбирает коды маркировки для печати этикеток по документу
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ПараметрыПодбораКодов - Структура - (необязательный) содержит поля:
//   * Товар - СправочникСсылка.КонтурМаркировка_Товары - товар маркировки;
//   * Номенклатура - СправочникСсылка - номенклатура 1С;
//   * Характеристика - СправочникСсылка - характеристика номенклатуры;
//   * Упаковка - СправочникСсылка - упаковка;
//   * Серия - СправочникСсылка - серия;
//   * КоличествоКодовТребуется - Число - количество кодов;
// 
// Возвращаемое значение:
//  Массив из Строка - коды маркировки с криптохвостами
//
Функция КодыМаркировкиДляНанесенияПоДокументу(Документ, ПараметрыПодбораКодов = Неопределено) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	ПараметрыПодбора = Новый_ПараметрыПодбораКодовДляНанесения();
	
	Если ПараметрыПодбораКодов <> Неопределено Тогда
		АналитикаНоменклатуры = Новый_АналитикаНоменклатуры1С(ПараметрыПодбораКодов);
		Если ПараметрыПодбораКодов.Свойство("Номенклатура1С") Тогда
			АналитикаНоменклатуры.Номенклатура = ПараметрыПодбораКодов.Номенклатура1С; // Для совместимости с 2.19
		КонецЕсли;
		ПараметрыПодбора.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(АналитикаНоменклатуры);
	КонецЕсли;
	
	Результат = КодыДокументов_ПолныеКодыДляНанесения(ДокументУчета, ПараметрыПодбора);
	
	Возврат Результат;
	
КонецФункции

// Вызывает событие ПМ ПриЗагрузкеКодовИзВнешнегоИсточника
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ДопПараметры - Структура - доп параметры для ПМ;
// 
// Возвращаемое значение:
//  Булево - Истина, если добавить коды удалось
//
Функция ДобавитьКодыВДокументИзВнешнегоИсточника(Документ1С, ДопПараметры = Неопределено) Экспорт
	
	ВызыватьИсключение = Истина;
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, ВызыватьИсключение);
	
	Возврат КодыДокументов_ДобавитьИзВнешнегоИсточника(ДокументУчета, ДопПараметры);
	
КонецФункции

// Выгружает коды документа 1С в файл
//
// Параметры:
//  Документ - ДокументСсылка, СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ 1С или документ учета;
//  ФорматФайла			 - Строка			 - см. функцию Перечисление_ФорматыФайловСКодами();
//  ВыгружатьПолныеКоды	 - Булево			 - (необязательный) если не указан используется настройка модуля, иначе:
//  			* Истина - если нужно выгрузить коды с криптохвостами;
//  			* Ложь   - если нужно выгрузить коды без криптохвостов;
// 
// Возвращаемое значение:
//  Массив - содержит по умолчанию один элемент, структуру со свойствами:
//  * ИмяФайла - имя, с которым нужно сохранить файл;
//  * ДвоичныеДанные - данные файла;
//
Функция ВыгрузитьКодыДокументаВФайл(Документ, ФорматФайла, ВыгружатьПолныеКоды = Неопределено) Экспорт
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ, Истина);
	
	Возврат ВыгрузитьКодыДокументаУчетаВФайл(ДокументУчета, ФорматФайла, ВыгружатьПолныеКоды);
	
КонецФункции

// Добавляет в базу информацию о кодах
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//  ДобавитьКоличествоВСоставКода - Булево - Истина, если необходимо добавить количество в полный код;
//
Процедура ДобавитьИнформациюОКодах(ТаблицаКодов, ДобавитьКоличествоВСоставКода = Ложь) Экспорт
	
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
	
	КодыБезКлючей = ТаблицаКодов_КодыМаркировкиБезКлючей(ТаблицаКодов);
	Если ЗначениеЗаполнено(КодыБезКлючей) Тогда
		ТекстОшибки = НСтр("ru = 'В базе не найдены коды для добавления информации: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыБезКлючей));
	КонецЕсли;
	
	ЗаписатьПолныеКоды = Ложь;
	Если ДобавитьКоличествоВСоставКода Тогда
		ЗаписатьПолныеКоды = Истина;
		ПолныеКоды_Прочитать(ТаблицаКодов);
		ТаблицаКодов_ДобавитьКоличествоВПолныеКоды(ТаблицаКодов);
	КонецЕсли;
	
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
	Если ЗаписатьПолныеКоды Тогда
		ПолныеКоды_Записать(ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

// Находит в базе коды по серийным номерам и товарам, которым они принадлежат,
// затем заполняет информацию о них в таблице кодов.
// Товары должны быть указаны в таблице кодов, либо переданы общим списком.
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//  Товары - Массив, СправочникСсылка.КонтурМаркировка_Товары - обязательный, если товары не указаны в таблице кодов;
//
Процедура ПрочитатьИнформациюОКодахПоСерийнымНомерам(ТаблицаКодов, Товары = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаКодов.Найти(Справочники.КонтурМаркировка_Товары.ПустаяСсылка(), "Товар") = Неопределено Тогда
		
		// Товары уже указаны в таблице кодов
		ТаблицаКодов_НайтиКлючиПоСерийнымНомерам(ТаблицаКодов);
		
	Иначе
		
		// Пробуем найти коды по списку товаров
		Если Не ЗначениеЗаполнено(Товары) Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось найти коды маркировки по серийным номерам, не указаны товары'");
		КонецЕсли;
		
		ПустойКлюч = ПустойУникальныйИдентификатор();
		ИндексСерийныйНомер = ТаблицаКодов.Индексы.Добавить("СерийныйНомер");
		
		Для каждого Товар Из ЗначениеВМассиве(Товары) Цикл
			
			ПустыеСтроки = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючКода", ПустойКлюч));
			Если Не ЗначениеЗаполнено(ПустыеСтроки) Тогда
				Прервать; // Нашли все коды
			КонецЕсли;
			
			ТаблицаДляПоиска = Новый_ТаблицаКодов();
			Для каждого СтрКода Из ПустыеСтроки Цикл
				Стр = ТаблицаДляПоиска.Добавить();
				Если ЗначениеЗаполнено(СтрКода.СерийныйНомер) Тогда
					Стр.СерийныйНомер = СтрКода.СерийныйНомер;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(СтрКода.Товар) Тогда
					Стр.Товар = Товар;
				КонецЕсли;
			КонецЦикла;
			ТаблицаКодов_НайтиКлючиПоСерийнымНомерам(ТаблицаДляПоиска);
			
			Для каждого Стр Из ТаблицаДляПоиска Цикл
				
				Если Не ЗначениеЗаполнено(Стр.КлючКода) Тогда
					Продолжить;
				КонецЕсли;
				
				Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Новый Структура("СерийныйНомер", Стр.СерийныйНомер)) Цикл
					
					Если ЗначениеЗаполнено(СтрКода.КлючКода) И СтрКода.КодМаркировки <> Стр.КодМаркировки Тогда
						ШаблонОшибки = НСтр("ru = 'Не удалось найти коды маркировки,
						|серийный номер ""%1"" подходит сразу к нескольким кодам маркировки: %2, %3'");
						ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Стр.СерийныйНомер, Стр.КодМаркировки, СтрКода.КодМаркировки);
					КонецЕсли;
					
					СтрКода.КлючКода = Стр.КлючКода;
					СтрКода.КодМаркировки = Стр.КодМаркировки;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
		ТаблицаКодов.Индексы.Удалить(ИндексСерийныйНомер);
		
	КонецЕсли;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

// Очищает в базе информацию о кодах по указанным полям
//
// Параметры:
//  КодыМаркировки - Массив, Строка - код или коллекция нормализованных кодов;
//  ИменаПолей - Массив, Строка - поля разделенные запятой или массив полей, которые нужно очистить;
//
Процедура ОчиститьИнформациюОКодах(КодыМаркировки, ИменаПолей) Экспорт
	
	Если ТипЗнч(ИменаПолей) = Тип("Строка") Тогда
		МассивПолей = РазделитьСтроку(ИменаПолей);
	Иначе
		МассивПолей = ИменаПолей;
	КонецЕсли;
	
	МассивДопустимыхПолей = РазделитьСтроку(ИнформацияОКодах_ИменаПолей());
	МассивДопустимыхПолей.Добавить("ЗаводскойСерийныйНомер");
	МассивДопустимыхПолей.Добавить("Количество");
	
	Для каждого ИмяПоля Из МассивПолей Цикл
		Если Не МассивСодержитЗначение(МассивДопустимыхПолей, ИмяПоля) Тогда
			ТекстОшибки = НСтр("ru = 'Недопустимое поле для очистки информации о кодах: %1'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(КодыМаркировки);
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	
	КодыБезКлючей = ТаблицаКодов_КодыМаркировкиБезКлючей(ТаблицаКодов);
	Если ЗначениеЗаполнено(КодыБезКлючей) Тогда
		ТекстОшибки = НСтр("ru = 'Не найдены коды для очистки информации: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыБезКлючей));
	КонецЕсли;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Для каждого ИмяПоля Из МассивПолей Цикл
		ТаблицаКодов.ЗаполнитьЗначения(Неопределено, ИмяПоля);
	КонецЦикла;
	
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

// Добавляет в таблицу кодов вложенные коды и читает информацию по ним
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//
Процедура ДобавитьВложенныеКодыВТаблицуКодов(ТаблицаКодов) Экспорт
	
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

