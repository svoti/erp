Функция Товар_ОсновнойРазрешительныйДокумент(Товар) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.РазрешительныйДокумент КАК РазрешительныйДокумент
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары.РазрешительнаяДокументация КАК Т
	|ГДЕ
	|	Т.Основной
	|	И Т.Ссылка = &Товар");
	Запрос.УстановитьПараметр("Товар", Товар);
	
	Результат = ПолучитьРезультатЗапроса(Запрос, "РазрешительныйДокумент", ПустойРазрешительныйДокумент());
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Т.РазрешительныйДокумент КАК РазрешительныйДокумент
		|ИЗ
		|	Справочник.КонтурМаркировка_Товары.РазрешительнаяДокументация КАК Т
		|ГДЕ
		|	Т.Ссылка = &Товар
		|	И Т.РазрешительныйДокумент.Активен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.РазрешительныйДокумент");
		Запрос.УстановитьПараметр("Товар", Товар);
		
		АктивныеДокументы = МассивИзРезультатаЗапроса(Запрос, "РазрешительныйДокумент");
		
		Если АктивныеДокументы.Количество() = 1 Тогда
			Результат = АктивныеДокументы[0];
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

