Процедура ПМ_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка = Ложь) Экспорт
	
	Если Не ИспользоватьПМ()
		И Не ИспользоватьПлагины()
		И Не ВключенРежимТестирования() Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = НастройкиМодуля();
	
	ПараметрыСобытия.Вставить("ДопПараметрыПМ", Настройки.ПМ_ДопПараметры);
	ПараметрыСобытия.Вставить("БезопасныеДопПараметрыПМ", Настройки.ПМ_БезопасныеДопПараметры);
	
	КонтурПлагины_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	ПМ_ОбработатьСобытие_ПослеКонтурПлагинов(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПослеКонтурПлагинов(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка = Ложь) Экспорт
	
	СобытиеОбработано = Мок_ПМ_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	Если СобытиеОбработано Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СобытиеОбрабатываетсяПМ(ИмяСобытия, ПараметрыСобытия) Тогда
		Возврат;
	КонецЕсли;
	
	МодульПМ = МодульПМ();
	Если МодульПМ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьОсновнойМодуль = Ложь;
	ОчиститьОсновнойМодульПМ = Ложь;
	
	Попытка
		
		Если ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодуль = Истина;
			ОсновнойМодуль = ЭтотОбъект; // Поддержка вызова ОсновнойМодуль.ОсновнойМодуль для ОФ
		КонецЕсли;
		Если МодульПМ.ОсновнойМодуль = Неопределено Тогда
			ОчиститьОсновнойМодульПМ = Истина;
			МодульПМ.ОсновнойМодуль = ЭтотОбъект;
		КонецЕсли;
		
		МодульПМ.ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
		
		Если ОчиститьОсновнойМодульПМ Тогда
			МодульПМ.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		Если ОчиститьОсновнойМодуль Тогда
			ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
	Исключение
		
		Если ОчиститьОсновнойМодульПМ Тогда
			МодульПМ.ОсновнойМодуль = Неопределено;
		КонецЕсли;
		Если ОчиститьОсновнойМодуль Тогда
			ОсновнойМодуль = Неопределено;
		КонецЕсли;
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Вызов события ПМ'");
		ОбработатьОшибку(Действие, Ошибка , ИмяСобытия);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПриЗагрузкеКодовВНовыйДокументУчета(ПараметрыПМ)
	
	Если Мок_ПМ_ОбработатьСобытие("ПриЗагрузкеКодовВНовыйДокументУчета", ПараметрыПМ) Тогда
		Возврат;
	КонецЕсли;
	
	// Для совместимости с ПМ ниже 2.17 и ВСО ниже 1.17
	ПараметрыПМ.Вставить("КодыМаркировки", Новый Массив);
	
	ЗаполнитьТаблицуКодовДляСовместимостиПМ(ПараметрыПМ.ТаблицаКодов);
	
	ВерсияПМ = ВерсияОбработкиПМ();
	ИмяСобытия = "ПриЗагрузкеКодовВНовыйДокументУчета";
	Если ЗначениеЗаполнено(ВерсияПМ) Тогда
		
		Если СравнитьВерсии(ВерсияПМ, "2.3") < 0 Тогда
			ИмяСобытия = "ПриДобавленииКодовВНовыйДокументУчета";
		КонецЕсли;
		
		Если СравнитьВерсии(ВерсияПМ, "3.15") < 0 Тогда
			
			ПараметрыПМ.Вставить("ЗаполнитьТоварыДокумента", Ложь);
			ПараметрыПМ.Вставить("ЗаполнитьТоварыАгрегатов", Ложь);
			ПараметрыПМ.Вставить("УдалитьИзДокументаКодыВАгрегатах", Неопределено);
			ЗаполнитьЗначенияСвойств(ПараметрыПМ, ПараметрыПМ.ПараметрыЗагрузкиКодов);
			
			ПараметрыПМ.Удалить("ПараметрыЗагрузкиКодов");
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПМ_ОбработатьСобытие(ИмяСобытия, ПараметрыПМ);
	
	ВосстановитьПараметрыЗагрузкиКодовДляСовместимостиПМ(ПараметрыПМ);
	
	Если ЗначениеЗаполнено(ПараметрыПМ.КодыМаркировки) Тогда
		ПараметрыПМ.ТаблицаКодов = ТаблицаКодовИзОписанийКодов(ПараметрыПМ.КодыМаркировки);
	Иначе
		ВосстановитьТаблицуКодовДляСовместимостиМодуль(ПараметрыПМ.ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

