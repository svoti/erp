// Формирует контекст обновления с данными из сервиса и параметрами текущего модуля
//
// Параметры:
//  ОдинРазВДень - Булево - (необязательный) Ложь, если не нужно учитывать, что проверка сегодня уже выполнялась
// 
// Возвращаемое значение:
//  Струткура - см. функцию Новый_КонтекстОбновленияМодуля()
//
Функция КонтекстОбновления(ОдинРазВДень = Истина) Экспорт
	
	Результат = Новый_КонтекстОбновленияМодуля();
	Настройки = НастройкиМодуля();
	
	Если Настройки.ОтключитьПроверкуОбновлений Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Настройки.ТестовоеОкружение И Не Настройки.РазрешитьОбновлениеВТестовомОкружении Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ОдинРазВДень И ПроверкаОбновленияСегодняУжеВыполнялась() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗафиксироватьДатуПроверкиОбновления();
	
	Результат.ОбновлятьАвтоматически = Настройки.ОбновлятьАвтоматически;
	
	ПроверитьЧтоОбновлениеУжеВыполнено(Результат);
	ДобавитьВКонтекстОбновленияПараметрыТекущегоМодуля(Результат);
	ДобавитьВКонтекстОбновленияДанныеСервиса(Результат);
	ПроверитьВозможностьУведомленияПользователяОНовойВерсии(Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьЧтоОбновлениеУжеВыполнено(КонтекстОбновления)
	
	СтараяВерсияМодуля = СтараяВерсияМодуля();
	
	Если СтараяВерсияМодуля <> ПустаяВерсия() Тогда
		КонтекстОбновления.ОбновлениеВыполнено = (СравнитьВерсии(ВерсияОбработки(), СтараяВерсияМодуля) > 0);
	КонецЕсли;
	
КонецПроцедуры

// Дополняет в контекст обновления параметры и настройки модуля
//
// Параметры:
//  КонтекстОбновления - Струткура - см. функцию Новый_КонтекстОбновленияМодуля()
//
Процедура ДобавитьВКонтекстОбновленияПараметрыТекущегоМодуля(КонтекстОбновления)
	
	Настройки = НастройкиМодуля();
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	КонтекстОбновления.ТекущаяВерсияМодуля = ВерсияОбработки();
	КонтекстОбновления.ТекущаяВерсияДанных = ТребуемаяВерсияДанныхПодсистемы();
	КонтекстОбновления.ТекущаяВерсияПодсистемы = ВерсияУстановленнойБиблиотеки();
	
	КонтекстОбновления.РасположениеМодуля  = РасположениеМодуля();
	КонтекстОбновления.ЕстьПодсистемаВСО   = ЕстьПодсистемаВСО();
	
	Если Не ВключенРежимТестирования() Тогда
		КонтекстОбновления.ЕстьДоработкиМодуля = ЗначениеЗаполнено(ОписаниеДоработокМодуля());
	КонецЕсли;
	
	Если КонтекстОбновления.ЕстьДоработкиМодуля
		Или КонтекстОбновления.ЕстьПодсистемаВСО
		Или КонтекстОбновления.РасположениеМодуля = ВариантыРасположения.ВКонфигурации Тогда
		
		КонтекстОбновления.НевозможноВыполнитьОбновление = Истина;
		
	Иначе
		
		Если КонтекстОбновления.РасположениеМодуля = ВариантыРасположения.НаДиске Тогда
			ПроверитьДоступностьФайлаМодуляНаСервере(КонтекстОбновления);
		ИначеЕсли КонтекстОбновления.РасположениеМодуля = ВариантыРасположения.ВСправочнике Тогда
			ЗаполнитьИнформациюОМодулеВДопОбработке(КонтекстОбновления);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Дополняет контекст информацию о новой версии модуля и подсистемы
//
// Параметры:
//  КонтекстОбновления - Струткура - см. функцию Новый_КонтекстОбновленияМодуля()
//
Процедура ДобавитьВКонтекстОбновленияДанныеСервиса(КонтекстОбновления)
	
	Попытка
		ДобавитьСведенияОНовойВерсииМодуля(КонтекстОбновления);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		КонтекстОбновления.ОписаниеОшибки = КраткоеПредставлениеОшибки(Ошибка);
		КонтекстОбновления.ПолученаОшибкаСервисаОбновлений = Истина;
	КонецПопытки;
	
	Если КонтекстОбновления.ЕстьОбновлениеПодсистемы Тогда
		КонтекстОбновления.НевозможноВыполнитьОбновление = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция СсылкаНаДополнительнуюОбработку(НаименованиеОбработки)
	
	ИмяСправочника = ИмяСправочникаВнешнихОбработок();
	
	Результат = Справочники[ИмяСправочника].НайтиПоНаименованию(НаименованиеОбработки);
	
	Возврат Результат;
	
КонецФункции

Функция ИмяСправочникаВнешнихОбработок()
	
	ТипыОбъектов = ТипыОбъектовИС();
	Результат = СтрЗаменить(ТипыОбъектов.ВнешняяОбработка, "СправочникСсылка.", "");
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьДоступностьФайлаМодуляНаСервере(КонтекстОбновления)
	
	Информация = КонтекстОбновления.ИнформацияОФайлеНаДиске;
	
	Информация.ПутьКФайлу = МодульОбщегоНазначения().ПутьКФайлуОбработки(ЭтотОбъект);
	Если Не МодульОбщегоНазначения().ФайлСуществует(Информация.ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	КаталогМодуля = МодульОбщегоНазначения().КаталогОбработки(ЭтотОбъект);
	ПутьКФайлу = МодульОбщегоНазначения().ОбъединитьПути(КаталогМодуля, "KonturMARK_WriteTest.txt");
	
	Попытка
		Запись = НовыйЗаписьТекста(ПутьКФайлу);
		Запись.Записать("Тест записи файла перед обновлением " + Информация.ПутьКФайлу);
		Запись.Закрыть();
		МодульОбщегоНазначения().УдалитьФайл(ПутьКФайлу);
		Информация.ДоступенНаСервере = Истина;
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьИнформациюОМодулеВДопОбработке(КонтекстОбновления)
	
	Ссылка = СсылкаНаДополнительнуюОбработку(Метаданные().Синоним);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОбработки = КонтекстОбновления.ИнформацияОДополнительнойОбработке;
	
	ОписаниеОбработки.Ссылка = Ссылка;
	ОписаниеОбработки.ИмяПоляВерсии = Интеграция_ИмяПоляВерсииВнешнейОбработки(Ссылка);
	ОписаниеОбработки.ИмяПоляХранилища = Интеграция_ИмяХранилищаФайлаВнешнейОбработки(Ссылка);
	ОписаниеОбработки.ИмяПоляИмяОбъекта = Интеграция_ИмяПоляИмяОбъектаВнешнейОбработки(Ссылка);
	ОписаниеОбработки.ИмяПоляВидОбработки = Интеграция_ИмяПоляВидВнешнейОбработки(Ссылка);
	ОписаниеОбработки.ИмяПоляПубликация = Интеграция_ИмяПоляПубликацияВнешнейОбработки(Ссылка);
	ОписаниеОбработки.ВидОбработки = Интеграция_ВидВнешнейОбработки();
	ОписаниеОбработки.Публикация = Интеграция_ПубликацияВнешнейОбработки();
	ОписаниеОбработки.ИмяОбъекта = ИмяМодуля();
	
КонецПроцедуры

Процедура ДобавитьСведенияОНовойВерсииМодуля(КонтекстОбновления)
	
	ПродуктыВСервисе = Перечисление_ПродуктыВСервисеОбновлений();
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	ТипыКонтентовВСервисеОбновлений = Перечисление_ТипыКонтентовВСервисеОбновлений();
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	Продукт = ПродуктыВСервисе.Модуль;
	Контент = КонтентДляПроверкиОбновления(ВерсияОбработки());
	ТекущаяВерсияПодсистемы = ВерсияУстановленнойБиблиотеки();
	
	Если КонтекстОбновления.РасположениеМодуля = ВариантыРасположения.ВРасширении Тогда
		ТипКонтента = ТипыКонтентовВСервисеОбновлений.Расширение;
	Иначе
		ТипКонтента = ТипыКонтентовВСервисеОбновлений.Обработка;
	КонецЕсли;
	
	Попытка
		Ответ = СервисОбновлений_ПроверитьОбновления(Контент, Продукт);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Проверка наличия новой версии модуля'");
		ОбработатьОшибку(Действие, Ошибка);
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или Ответ.contain_update <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстОбновления.ЕстьОбновлениеМодуля = Истина;
	КонтекстОбновления.НоваяВерсияМодуля = Ответ.name;
	КонтекстОбновления.АдресОбновления = АдресФайлаИзОтветаСервисаОбновлений(Ответ, ТипКонтента);
	
	Если ЗначениеЗаполнено(Ответ.description) Тогда
		
		ОписаниеОбновления = ЗначениеИзСтрокиJSON(Ответ.description);
		КонтекстОбновления.РазрешеноАвтообновление = СвойствоСтруктуры(ОписаниеОбновления, "autoUpdate", Ложь);
		НоваяВерсияДанных = СвойствоСтруктуры(ОписаниеОбновления, "newDataVersion");
		НоваяВерсияПодсистемы = СвойствоСтруктуры(ОписаниеОбновления, "subsystemVersion");
		
		Если ЗначениеЗаполнено(НоваяВерсияДанных) Тогда
			КонтекстОбновления.НоваяВерсияДанных = НоваяВерсияДанных;
			Если СравнитьВерсии(КонтекстОбновления.ТекущаяВерсияДанных, НоваяВерсияДанных) < 0 Тогда
				КонтекстОбновления.ТребуетсяОбновлениеДанных = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоваяВерсияПодсистемы)
			И КонтекстОбновления.РасположениеМодуля <> ВариантыРасположения.ВРасширении Тогда
			КонтекстОбновления.НоваяВерсияПодсистемы = НоваяВерсияПодсистемы;
			Если СравнитьВерсии(ТекущаяВерсияПодсистемы, НоваяВерсияПодсистемы) < 0 Тогда
				КонтекстОбновления.ЕстьОбновлениеПодсистемы = Истина;
				КонтекстОбновления.АдресОбновленияПодсистемы = АдресФайлаОбновленияПодсистемы(НоваяВерсияПодсистемы);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьОписаниеИзменений(КонтекстОбновления, Продукт);
	
КонецПроцедуры

Процедура ЗафиксироватьДатуПроверкиОбновления()
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().ПоследняяПроверкаОбновления;
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	ДанныеИБ.ДопРеквизиты.Вставить("ДатаПроверки", ТекущаяУниверсальнаяДата());
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

Функция ПроверкаОбновленияСегодняУжеВыполнялась()
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().ПоследняяПроверкаОбновления;
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	ДатаЗапуска = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, "ДатаПроверки", ПустаяДата());
	
	Возврат НачалоДня(ДатаЗапуска) = НачалоДня(ТекущаяУниверсальнаяДата());
	
КонецФункции

Функция АдресФайлаОбновленияПодсистемы(ВерсияПодсистемы)
	
	Продукт = Перечисление_ПродуктыВСервисеОбновлений().Подсистема;
	ТипКонтента = Перечисление_ТипыКонтентовВСервисеОбновлений().Подсистема;
	Результат = СервисОбновлений_ПубличнаяСсылка(Продукт, ВерсияПодсистемы, ТипКонтента);
	
	Возврат Результат;
	
КонецФункции

Функция АдресФайлаИзОтветаСервисаОбновлений(ОтветОтСервиса, ТипКонтента)
	
	ДанныеФайла = МассивСтруктур_Найти(ОтветОтСервиса.links, ТипКонтента, "content_type");
	Если Не ЗначениеЗаполнено(ДанныеФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеФайла.href;
	
КонецФункции

Функция КонтентДляПроверкиОбновления(ТекущаяВерсия = Неопределено)
	
	Возврат МодульЯдро().КонтентДляПроверкиОбновления(ТекущаяВерсия);
	
КонецФункции

