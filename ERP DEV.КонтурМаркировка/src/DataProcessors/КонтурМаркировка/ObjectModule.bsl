Процедура СведенияОМаркировке_Распределить_КИ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения)
	
	СтрокиДокумента = СведенияОМаркировке_ДоступныеСтрокиДокумента(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	Если Не ЗначениеЗаполнено(СтрокиДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоВсего = 0;
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		КоличествоВсего = КоличествоВсего + СтрДок.Количество;
	КонецЦикла;
	
	ОднаУпаковка = 1;
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		ТребуетсяКИ = СтрДок.Количество / КоличествоВсего * СтрМарк.КоличествоКИ;
		Если ТребуетсяКИ >= ОднаУпаковка Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиСвед = СведенияОМаркировке_ДоступныеКИ(СтрМарк.СведенияОМаркировке);
		Если Не ЗначениеЗаполнено(СтрокиСвед) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрСвед = СтрокиСвед[0];
		НоваяСтрока = СтрДок.СведенияОМаркировке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед);
		
		СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОднаУпаковка;
		СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
		
		ПереданоКоличество = ОднаУпаковка * СтрМарк.КоличествоВУпаковке;
		
		СведенияОМаркировке_ОбновитьИтогиСтрокиДокумента(СтрДок, ОднаУпаковка, ПереданоКоличество);
		СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ОднаУпаковка, ПереданоКоличество);
		
		Если СтрМарк.ВсеКодыПереданы Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_КИТУ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения)
	
	СтрокиДокумента = СведенияОМаркировке_ДоступныеСтрокиДокумента(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	Если Не ЗначениеЗаполнено(СтрокиДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоВсего = 0;
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		КоличествоВсего = КоличествоВсего + СтрДок.Количество;
	КонецЦикла;
	
	ОднаУпаковка = 1;
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		ТребуетсяКИ = СтрДок.Количество / КоличествоВсего * СтрМарк.КоличествоКИ;
		Если ТребуетсяКИ >= ОднаУпаковка Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиСвед = СведенияОМаркировке_ДоступныеКИТУ(СтрМарк.СведенияОМаркировке);
		Если Не ЗначениеЗаполнено(СтрокиСвед) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрСвед = СтрокиСвед[0];
		НоваяСтрока = СтрДок.СведенияОМаркировке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед);
		
		СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОднаУпаковка;
		СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
		
		ПереданоКоличество = ОднаУпаковка * СтрМарк.КоличествоВУпаковке;
		
		СведенияОМаркировке_ОбновитьИтогиСтрокиДокумента(СтрДок, ОднаУпаковка, ПереданоКоличество);
		СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ОднаУпаковка, ПереданоКоличество);
		
		Если СтрМарк.ВсеКодыПереданы Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_РаспределитьТаблицуКодов_КИТУ_БезСостава(ТоварыДокументов, ТаблицаМаркировки)
	
	Если Не СведенияОМаркировке_ЕстьКИТУБезСостава(ТаблицаМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиМаркировки = ТаблицаМаркировки.НайтиСтроки(Новый Структура("ОбъемноСортовойУчет", Ложь));
	
	ПараметрыРаспределения = Новый_ПараметрыРаспределенияКодов();
	
	Для Каждого СтрМарк Из СтрокиМаркировки Цикл
		СведенияОМаркировке_Распределить_КИТУ_БезСостава(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюСериюИсточника = Истина;
	Для Каждого СтрМарк Из СтрокиМаркировки Цикл
		СведенияОМаркировке_Распределить_КИТУ_БезСостава(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюХарактеристикуИсточника = Истина;
	Для Каждого СтрМарк Из СтрокиМаркировки Цикл
		СведенияОМаркировке_Распределить_КИТУ_БезСостава(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюСериюПриемника = Истина;
	Для Каждого СтрМарк Из СтрокиМаркировки Цикл
		СведенияОМаркировке_Распределить_КИТУ_БезСостава(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюХарактеристикуПриемника = Истина;
	Для Каждого СтрМарк Из СтрокиМаркировки Цикл
		СведенияОМаркировке_Распределить_КИТУ_БезСостава(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_КИТУ_БезСостава(СтрМарк, ТоварыДокументов, ПараметрыРаспределения)
	
	СтрокиДокумента = СведенияОМаркировке_ДоступныеСтрокиДокумента(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	Если Не ЗначениеЗаполнено(СтрокиДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрСвед Из СведенияОМаркировке_ДоступныеКИТУ_БезСостава(СтрМарк.СведенияОМаркировке) Цикл
		Для Каждого СтрДок Из СтрокиДокумента Цикл
			ЗаполнитьЗначенияСвойств(СтрДок.СведенияОМаркировке.Добавить(), СтрСвед);
		КонецЦикла;
		СтрСвед.Передан = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_ПУ(СтрМарк, ТоварыДокументов, ПараметрыРаспределения)
	
	СтрокиДокумента = СведенияОМаркировке_ДоступныеСтрокиДокумента(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	Если Не ЗначениеЗаполнено(СтрокиДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	// Распределяем любые коды где количество точно совпадает
	СведенияОМаркировке_Распределить_ПУ_Совпадает(СтрМарк, СтрокиДокумента);
	Если СтрМарк.ВсеКодыПереданы Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СведенияОМаркировке_ЕстьКИвКИТУ(СтрМарк.СведенияОМаркировке) Тогда
		СведенияОМаркировке_Распределить_КИ(СтрМарк, СтрокиДокумента);
		Возврат; // Выполняем только распределение КИ
	КонецЕсли;
	
	// Распределяем КИТУ по совпадающему количеству
	СведенияОМаркировке_Распределить_КИТУ_КоличествоСовпадает(СтрМарк, СтрокиДокумента);
	
	Если Не СтрМарк.ВсеКодыПереданы Тогда
		// Распределяем КИТУ по количеству где все КИ полностью входят в строку документа
		СведенияОМаркировке_Распределить_КИТУ_МеньшеРавно(СтрМарк, СтрокиДокумента);
	КонецЕсли;
	
	Если Не СтрМарк.ВсеКодыПереданы Тогда
		// Распределяем КИ по свободным позициям
		СведенияОМаркировке_Распределить_КИ(СтрМарк, СтрокиДокумента);
	КонецЕсли;
	
	Если Не СтрМарк.ВсеКодыПереданы Тогда
		// Распределяем КИТУ где вложенные КИ делятся по строкам документа
		СведенияОМаркировке_Распределить_КИТУ_Отличается(СтрМарк, СтрокиДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_ПУ_Совпадает(СтрМарк, СтрокиДокумента)
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		ОсталосьКоличество = СтрМарк.Количество - СтрМарк.ПереданоКоличество;
		
		Если СтрДок.ВсеКодыПолучены
			Или СтрДок.Количество <> ОсталосьКоличество Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиСвед = СведенияОМаркировке_ДоступныеСведения(СтрМарк.СведенияОМаркировке);
		Если Не ЗначениеЗаполнено(СтрокиСвед) Тогда
			Продолжить;
		КонецЕсли;
		
		ПереданоКИ = 0;
		
		Для Каждого СтрСвед Из СтрокиСвед Цикл
			
			ОсталосьКИ = СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ;
			
			НоваяСтрока = СтрДок.СведенияОМаркировке.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед);
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОсталосьКИ;
			СтрСвед.Передан = Истина;
			
			ПереданоКИ = ПереданоКИ + ОсталосьКИ;
			
		КонецЦикла;
		
		СтрДок.ПолученоКИ = СтрДок.ПолученоКИ + ПереданоКИ;
		СтрДок.ПолученоКоличество = СтрДок.ПолученоКоличество + ОсталосьКоличество;
		СтрДок.ВсеКодыПолучены = Истина;
		
		СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ПереданоКИ, ОсталосьКоличество);
		
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_КИ(СтрМарк, СтрокиДокумента)
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		Если СтрДок.ВсеКодыПолучены Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрСвед Из СведенияОМаркировке_ДоступныеКИ(СтрМарк.СведенияОМаркировке) Цикл
			
			ЗаполнитьЗначенияСвойств(СтрДок.СведенияОМаркировке.Добавить(), СтрСвед);
			
			ПереданоКИ = СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ;
			ПереданоКоличество = ПереданоКИ * СтрМарк.КоличествоВУпаковке;
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ПереданоКИ;
			СтрСвед.Передан = Истина;
			
			СведенияОМаркировке_ОбновитьИтогиСтрокиДокумента(СтрДок, ПереданоКИ, ПереданоКоличество);
			СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ПереданоКИ, ПереданоКоличество);
			
			Если СтрДок.ВсеКодыПолучены Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрМарк.ВсеКодыПереданы Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_КИТУ_КоличествоСовпадает(СтрМарк, СтрокиДокумента)
	
	Для Каждого СтрСвед Из СведенияОМаркировке_ДоступныеКИТУ(СтрМарк.СведенияОМаркировке) Цикл
		
		ОсталосьКИ = СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ;
		ОсталосьКоличество = ОсталосьКИ * СтрМарк.КоличествоВУпаковке;
		
		Для Каждого СтрДок Из СтрокиДокумента Цикл
			
			ТребуетсяКоличество = СтрДок.Количество - СтрДок.ПолученоКоличество;
			Если Не ЗначенияРавныВПределахПогрешности(ТребуетсяКоличество, ОсталосьКоличество) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрДок.СведенияОМаркировке.Добавить(), СтрСвед);
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОсталосьКИ;
			СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
			
			СтрДок.ПолученоКИ = СтрДок.ПолученоКИ + ОсталосьКИ;
			СтрДок.ПолученоКоличество = СтрДок.ПолученоКоличество + ОсталосьКоличество;
			СтрДок.ВсеКодыПолучены = Истина;
			
			СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ОсталосьКИ, ОсталосьКоличество);
			
			Прервать;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_КИТУ_МеньшеРавно(СтрМарк, СтрокиДокумента)
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		Если СтрДок.ВсеКодыПолучены Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрСвед Из СведенияОМаркировке_ДоступныеКИТУ(СтрМарк.СведенияОМаркировке) Цикл
			
			Если Не ЗначениеЗаполнено(СтрСвед.КоличествоКИ) Тогда
				Продолжить;
			КонецЕсли;
			
			ОсталосьКИ = СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ;
			ОсталосьКоличество = ОсталосьКИ * СтрМарк.КоличествоВУпаковке;
			ТребуетсяКоличество = СтрДок.Количество - СтрДок.ПолученоКоличество;
			
			// Если будет весовой товар, с разным количеством в каждом КИ, то расчет будет неверный
			Если ОсталосьКоличество > ТребуетсяКоличество Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрДок.СведенияОМаркировке.Добавить(), СтрСвед);
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОсталосьКИ;
			СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
			
			СведенияОМаркировке_ОбновитьИтогиСтрокиДокумента(СтрДок, ОсталосьКИ, ОсталосьКоличество);
			СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ОсталосьКИ, ОсталосьКоличество);
			
			Если СтрДок.ВсеКодыПолучены Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрМарк.ВсеКодыПереданы Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_КИТУ_Отличается(СтрМарк, СтрокиДокумента)
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		Если СтрДок.ВсеКодыПолучены Тогда
			Продолжить;
		КонецЕсли;
		
		ТребуетсяКоличество = СтрДок.Количество - СтрДок.ПолученоКоличество;
		ТребуетсяКИ = Макс(Цел(ТребуетсяКоличество / СтрМарк.КоличествоВУпаковке), 1);
		
		СтрокиСвед = СведенияОМаркировке_ДоступныеКИТУ(СтрМарк.СведенияОМаркировке);
		Если Не ЗначениеЗаполнено(СтрокиСвед) Тогда
			Продолжить;
		КонецЕсли;
		
		ПереданоКИ = 0;
		
		Для Каждого СтрСвед Из СтрокиСвед Цикл
			
			ОсталосьКИ = Мин(СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ, ТребуетсяКИ - ПереданоКИ);
			
			ЗаполнитьЗначенияСвойств(СтрДок.СведенияОМаркировке.Добавить(), СтрСвед);
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОсталосьКИ;
			СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
			
			ПереданоКИ = ПереданоКИ + ОсталосьКИ;
			
			Если ПереданоКИ = ТребуетсяКИ Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		ПереданоКоличество = ПереданоКИ * СтрМарк.КоличествоВУпаковке;
		
		СтрДок.ПолученоКИ = СтрДок.ПолученоКИ + ПереданоКИ;
		СтрДок.ПолученоКоличество = СтрДок.ПолученоКоличество + ПереданоКоличество;
		СтрДок.ВсеКодыПолучены = (ПереданоКИ = ТребуетсяКИ);
		
		СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ПереданоКИ, ПереданоКоличество);
		
		Если СтрМарк.ВсеКодыПереданы Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_ЗаполнитьКодТоварнойГруппы(ТоварыДокументов)
	
	// BSLLS:CognitiveComplexity-off
	
	Для Каждого СтрДок Из ТоварыДокументов Цикл
		
		КодТоварнойГруппы = 0;
		
		Для Каждого СтрСвед Из СтрДок.СведенияОМаркировке Цикл
			
			Если Не ЗначениеЗаполнено(СтрСвед.КодТоварнойГруппы) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КодТоварнойГруппы)
				И КодТоварнойГруппы <> СтрСвед.КодТоварнойГруппы Тогда
				КодТоварнойГруппы = -1; // Несколько ТГ
				Прервать;
			КонецЕсли;
			
			КодТоварнойГруппы = СтрСвед.КодТоварнойГруппы;
			
		КонецЦикла;
		
		СтрДок.КодТоварнойГруппы = КодТоварнойГруппы;
		
	КонецЦикла;
	
	СтрокиНетТГ = ТоварыДокументов.НайтиСтроки(Новый Структура("КодТоварнойГруппы", 0));
	
	Если ЗначениеЗаполнено(СтрокиНетТГ)
		И СведенияОМаркировке_ЭтоКорректировка(ТоварыДокументов) Тогда
		
		КлючСтроки = СведенияОМаркировке_КлючСтрокиУКД();
		ТипыИзменения = Перечисление_ТипыИзмененияСтрокиУКД();
		
		Для Каждого СтрДок Из СтрокиНетТГ Цикл
			
			ЗаполнитьЗначенияСвойств(КлючСтроки, СтрДок);
			Если СтрДок.ТипИзменения = ТипыИзменения.До Тогда
				КлючСтроки.ТипИзменения = ТипыИзменения.После;
			Иначе
				КлючСтроки.ТипИзменения = ТипыИзменения.До;
			КонецЕсли;
			
			СтрДокПара = ТаблицаЗначений_НайтиСтроку(ТоварыДокументов, КлючСтроки);
			Если СтрДокПара <> Неопределено Тогда
				СтрДок.КодТоварнойГруппы = СтрДокПара.КодТоварнойГруппы;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого СтрДок Из ТоварыДокументов.НайтиСтроки(Новый Структура("КодТоварнойГруппы", -1)) Цикл
		СтрДок.КодТоварнойГруппы = 0; // Несколько ТГ
	КонецЦикла;
	
	Для Каждого СтрДок Из ТоварыДокументов Цикл
		СтрДок.СведенияОМаркировке.Колонки.Удалить("КодТоварнойГруппы");
	КонецЦикла;
	
	// BSLLS:CognitiveComplexity-on
	
КонецПроцедуры

Процедура СведенияОМаркировке_ПересчитатьКоличествоВБазовыеЕдиницы(ТоварыДокументов)
	
	Если Интеграция_ВыводитьБазовыеЕдиницыИзмерения() Тогда
		Возврат; // Документ уже расчитан в базовых единицах
	КонецЕсли;
	
	ТоварыДокументов.Колонки.Добавить("КоличествоУпаковок", ОписаниеТипа_Число());
	
	Для Каждого СтрДокумента Из ТоварыДокументов Цикл
		
		// Заполнение количества упаковок (количества в единицах измерения, указанных в документе 1С)
		СтрДокумента.КоличествоУпаковок = СтрДокумента.Количество;
		
		Если ЗначениеЗаполнено(СтрДокумента.Упаковка) Тогда
			Интеграция_ПересчитатьКоличествоВБазовыеЕдиницы(СтрДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_ВосстановитьКоличествоВЕдиницахДокумента(ТоварыДокументов)
	
	Если Интеграция_ВыводитьБазовыеЕдиницыИзмерения() Тогда
		Возврат;
	КонецЕсли;
	
	ТоварыДокументов.Колонки.Удалить("Количество");
	ТоварыДокументов.Колонки.КоличествоУпаковок.Имя = "Количество";
	
КонецПроцедуры

Процедура СведенияОМаркировке_ТоварыДокументов_ДобавитьДокументыУчета(ТоварыДокументов, ПроверитьЗавершениеРаботы, ОшибкиМаркировки)
	
	ТипыОшибок = Перечисление_ТипыОшибокСведенийОМаркировке();
	СервисыПодписок = Перечисление_СервисыПодписок();
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	СоздатьПерезаполнить = НастройкиМодуля().СоздаватьДокументыУчетаАвтоматически;
	ЭтоКорректировка = СведенияОМаркировке_ЭтоКорректировка(ТоварыДокументов);
	
	КэшДокументов = Новый Соответствие;
	КэшПроверкиДокументов = Новый Соответствие;
	КэшИсправляемыхДокументов = Новый Соответствие;
	
	Для каждого СтрДок Из ТоварыДокументов Цикл
		
		Если Не ДокументДопустимВМаркировке(СтрДок.ПервичныйДокумент) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументУчета = ДокументУчета_НайтиПоДокументу1С(СтрДок.ПервичныйДокумент, , СоздатьПерезаполнить, КэшДокументов);
		
		Если Не ЗначениеЗаполнено(ДокументУчета)
			Или Не ДокументУчета_ЕстьТоварыДляОтраженияВЭДО(ДокументУчета) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоКорректировка Тогда
			ИсправляемыйДокументУчета = ДокументУчета_ИсходныйИсправляемыйДокументУчета(ДокументУчета, КэшИсправляемыхДокументов);
		КонецЕсли;
		
		ПроверкаПройдена = СведенияОМаркировке_ПроверитьДокумент(СтрДок.ПервичныйДокумент
		, ДокументУчета
		, ИсправляемыйДокументУчета
		, ПроверитьЗавершениеРаботы
		, ЭтоКорректировка
		, ОшибкиМаркировки
		, КэшПроверкиДокументов);
		
		Если Не ПроверкаПройдена Тогда
			Продолжить;
		КонецЕсли;
		
		СтрДок.ДокументУчета = ДокументУчета;
		
		Если ЭтоКорректировка Тогда
			СтрДок.ИсправляемыйДокументУчета = ИсправляемыйДокументУчета;
		КонецЕсли;
		
	КонецЦикла;
	
	СведенияОМаркировке_ИзвлечьКодыИзАрхивовДокументов(ТоварыДокументов, ПроверитьЗавершениеРаботы, ОшибкиМаркировки);
	
КонецПроцедуры

Процедура СведенияОМаркировке_ИзвлечьКодыИзАрхивовДокументов(ТоварыДокументов, ПроверитьЗавершениеРаботы, ОшибкиМаркировки)
	
	Для Каждого ДокументУчета Из ТаблицаЗначений_ВыгрузитьКолонку(ТоварыДокументов, "ДокументУчета", Истина) Цикл
		ДокументУчета_ИзвлечьКодыИзАрхива(ДокументУчета);
	КонецЦикла;
	
	Если СведенияОМаркировке_ЭтоКорректировка(ТоварыДокументов) Тогда
		Для Каждого ИсправляемыйДокументУчета Из ТаблицаЗначений_ВыгрузитьКолонку(ТоварыДокументов, "ИсправляемыйДокументУчета", Истина) Цикл
			ДокументУчета_ИзвлечьКодыИзАрхива(ИсправляемыйДокументУчета);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура СведенияОМаркировке_ЗафиксироватьЧтоСведенияПереданы(ТоварыДокументов)
	
	ДокументыУчета = ТаблицаЗначений_ВыгрузитьКолонку(ТоварыДокументов, "ДокументУчета", Истина);
	
	ДокументыУчета_ПереданыСведенияОМаркировке_Записать(ДокументыУчета);
	
КонецПроцедуры

Процедура СведенияОМаркировке_Проверить_РаспределениеАгрегатов(ТаблицаАгрегатов, ОшибкиМаркировки)
	
	// Временно отключен контроль распределения для исключения ошибок
	Возврат;
	
	ТипыОшибок = Перечисление_ТипыОшибокСведенийОМаркировке();
	
	Для Каждого СтрАгр Из СведенияОМаркировке_ДоступныеСтроки(ТаблицаАгрегатов) Цикл
		СтрокиСвед = СведенияОМаркировке_ДоступныеСведения(СтрАгр.СведенияОМаркировке);
		Если ЗначениеЗаполнено(СтрокиСвед) Тогда
			СтрОшибки = ОшибкиМаркировки.Добавить();
			СтрОшибки.ТипОшибки = ТипыОшибок.НеУдалосьРаспределитьАгрегаты;
			СтрОшибки.ПервичныйДокумент = СтрАгр.ПервичныйДокумент;
			СтрОшибки.ДокументУчета = СтрАгр.ДокументУчета;
			СтрОшибки.КодыМаркировки = МассивСтруктур_Выгрузить(СтрокиСвед, "ЗначениеШтрихкода");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Проверить_РаспределениеКодов(ТаблицаМаркировки, ОшибкиМаркировки)
	
	// Временно отключен контроль распределения для исключения ошибок
	Возврат;
	
	ТипыОшибок = Перечисление_ТипыОшибокСведенийОМаркировке();
	
	Для Каждого СтрМарк Из СведенияОМаркировке_ДоступныеСтроки(ТаблицаМаркировки) Цикл
		СтрокиСвед = СведенияОМаркировке_ДоступныеСведения(СтрМарк.СведенияОМаркировке);
		Если ЗначениеЗаполнено(СтрокиСвед) Тогда
			СтрОшибки = ОшибкиМаркировки.Добавить();
			СтрОшибки.ТипОшибки = ТипыОшибок.НеВсеКодыПереданы;
			СтрОшибки.ПервичныйДокумент = СтрМарк.ПервичныйДокумент;
			СтрОшибки.ДокументУчета = СтрМарк.ДокументУчета;
			СтрОшибки.КодыМаркировки = МассивСтруктур_Выгрузить(СтрокиСвед, "ЗначениеШтрихкода");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_ОбновитьИтогиСтрокиДокумента(СтрДок, ПереданоКИ, ПереданоКоличество)
	
	СтрДок.ПолученоКИ = СтрДок.ПолученоКИ + ПереданоКИ;
	СтрДок.ПолученоКоличество = СтрДок.ПолученоКоличество + ПереданоКоличество;
	
	Если СтрДок.ПолученоКоличество > СтрДок.Количество
		Или ЗначенияРавныВПределахПогрешности(СтрДок.ПолученоКоличество, СтрДок.Количество) Тогда
		СтрДок.ВсеКодыПолучены = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ПереданоКИ, ПереданоКоличество)
	
	СтрМарк.ПереданоКИ = СтрМарк.ПереданоКИ + ПереданоКИ;
	СтрМарк.ПереданоКоличество = СтрМарк.ПереданоКоличество + ПереданоКоличество;
	СтрМарк.ВсеКодыПереданы = (СтрМарк.ПереданоКИ = СтрМарк.КоличествоКИ);
	
КонецПроцедуры

Процедура СведенияОМаркировке_ДобавитьОшибкиЗаполнения(ОшибкиЗаполнения, ОшибкиМаркировки)
	
	ТипыОшибок = Перечисление_ТипыОшибокСведенийОМаркировке();
	ТекстыОшибок = СведенияОМаркировке_ТекстыОшибок();
	
	СведенияОМаркировке_СвернутьОшибкиМаркировки(ОшибкиМаркировки);
	
	Для Каждого Стр Из ОшибкиМаркировки Цикл
		
		ТекстОшибки = ТекстыОшибок[Стр.ТипОшибки];
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ВызватьИсключение ПараметрыВСтроку(НСтр("ru = 'Неизвестный тип ошибки в сведениях о маркировке: %1'"), Стр.ТипОшибки);
		КонецЕсли;
		
		Если Стр.ТипОшибки = ТипыОшибок.НеРазрешенОСУ
			Или Стр.ТипОшибки = ТипыОшибок.НеЗаполненНомерПартии
			Или Стр.ТипОшибки = ТипыОшибок.НеРазрешенПартионныйУчет Тогда
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СоединитьСтроку(Стр.МассивGTIN, ", "));
		ИначеЕсли Стр.ТипОшибки = ТипыОшибок.НеВсеКодыПереданы
			Или Стр.ТипОшибки = ТипыОшибок.НеУдалосьРаспределитьАгрегаты Тогда
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(Стр.КодыМаркировки));
		Иначе
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Стр.ПервичныйДокумент);
		КонецЕсли;
		
		ОшибкиЗаполнения.Добавить(Новый_ОшибкаЗаполненияРазвернутойТаблицыУпаковок(Стр.ПервичныйДокумент, Стр.ДокументУчета, ТекстОшибки));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_СвернутьОшибкиМаркировки(ОшибкиМаркировки)
	
	Для Каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ОшибкиМаркировки, "ПервичныйДокумент, ТипОшибки") Цикл
		
		ПерваяСтрока = ЧастьТаблицы.МассивСтрок[0];
		Если Не ЗначениеЗаполнено(ПерваяСтрока.МассивGTIN) Тогда
			ПерваяСтрока.МассивGTIN = Новый Массив;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПерваяСтрока.КодыМаркировки) Тогда
			ПерваяСтрока.КодыМаркировки = Новый Массив;
		КонецЕсли;
		
		Для Сч = 1 По ЧастьТаблицы.МассивСтрок.ВГраница() Цикл
			
			Стр = ЧастьТаблицы.МассивСтрок[Сч];
			
			Если ЗначениеЗаполнено(Стр.МассивGTIN) Тогда
				ДополнитьМассив(ПерваяСтрока.МассивGTIN, Стр.МассивGTIN);
			КонецЕсли;
			Если ЗначениеЗаполнено(Стр.КодыМаркировки) Тогда
				ДополнитьМассив(ПерваяСтрока.КодыМаркировки, Стр.КодыМаркировки);
			КонецЕсли;
			
			ОшибкиМаркировки.Удалить(Стр);
			
		КонецЦикла;
		
		СвернутьМассивЛок(ПерваяСтрока.МассивGTIN);
		СвернутьМассивЛок(ПерваяСтрока.КодыМаркировки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_СвернутьЗначенияШтрихкодовОСУ(ТоварыДокументов)
	
	ОтборОСУ = Новый Структура("ВидУпаковки");
	
	Для Каждого ВидУпаковкиОСУ Из СведенияОМаркировке_ВидыУпаковокОСУ() Цикл
		
		ОтборОСУ.ВидУпаковки = ВидУпаковкиОСУ;
		
		Для Каждого СтрДок Из ТоварыДокументов Цикл
			
			СведенияОСУ = СтрДок.СведенияОМаркировке.Скопировать(ОтборОСУ);
			Если Не ЗначениеЗаполнено(СведенияОСУ) Тогда
				Продолжить;
			КонецЕсли;
			
			СведенияОСУ.ЗаполнитьЗначения(Неопределено, "ЗначениеШтрихкода");
			ТаблицаЗначений_СвернутьПоВсемКолонкам(СведенияОСУ, "КоличествоУпаковок, Количество");
			
			Для Каждого Стр Из СведенияОСУ Цикл
				Стр.ЗначениеШтрихкода = ШтрихкодОбъемноСортовогоУчета(Стр.GTIN, Стр.КоличествоУпаковок);
			КонецЦикла;
			
			Для Каждого Стр Из СтрДок.СведенияОМаркировке.НайтиСтроки(ОтборОСУ) Цикл
				СтрДок.СведенияОМаркировке.Удалить(Стр);
			КонецЦикла;
			
			ТаблицаЗначений_Дополнить(СтрДок.СведенияОМаркировке, СведенияОСУ);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_ТоварыДокументов_ДобавитьСлужебныеКолонкиИндексы(ТоварыДокументов)
	
	ЭтоКорректировка = СведенияОМаркировке_ЭтоКорректировка(ТоварыДокументов);
	
	Если ТоварыДокументов.Колонки.Найти("СведенияОМаркировке") = Неопределено Тогда
		ТоварыДокументов.Колонки.Добавить("СведенияОМаркировке", ОписаниеТипа_ТаблицаЗначений());
	КонецЕсли;
	Для Каждого Стр Из ТоварыДокументов Цикл
		Стр.СведенияОМаркировке = Новый_СведенияОМаркировке();
	КонецЦикла;
	
	ТоварыДокументов.Колонки.Добавить("ПолученоКИ", ОписаниеТипа_Число());
	ТоварыДокументов.Колонки.Добавить("ВсеКодыПолучены", ОписаниеТипа_Булево());
	ТоварыДокументов.Колонки.Добавить("ПолученоКоличество", ОписаниеТипа_Число());
	ТоварыДокументов.Колонки.Добавить("ДокументУчета", ОписаниеТипа_ДокументыУчета());
	
	Если ЭтоКорректировка Тогда
		ТоварыДокументов.Колонки.Добавить("ИсправляемыйДокументУчета", ОписаниеТипа_ДокументыУчета());
	КонецЕсли;
	
	ТаблицаЗначений_ДобавитьИндекс(ТоварыДокументов, "ПервичныйДокумент, Номенклатура");
	
КонецПроцедуры

Процедура СведенияОМаркировке_ТоварыДокументов_УдалитьСлужебныеКолонкиИндексы(ТоварыДокументов)
	
	ТоварыДокументов.Колонки.Удалить("ПолученоКоличество");
	ТоварыДокументов.Колонки.Удалить("ПолученоКИ");
	ТоварыДокументов.Колонки.Удалить("ВсеКодыПолучены");
	ТоварыДокументов.Колонки.Удалить("ДокументУчета");
	
	Если ТоварыДокументов.Колонки.Найти("ИсправляемыйДокументУчета") <> Неопределено Тогда
		ТоварыДокументов.Колонки.Удалить("ИсправляемыйДокументУчета");
	КонецЕсли;
	
	Если ТоварыДокументов.Колонки.Найти("ТипИзменения") <> Неопределено Тогда
		ТоварыДокументов.Сортировать("ИндексСтроки, ТипИзменения");
	Иначе
		ТоварыДокументов.Сортировать("ИндексСтроки");
	КонецЕсли;
	
	ТаблицаЗначений_УдалитьИндекс(ТоварыДокументов, "ПервичныйДокумент, Номенклатура");
	
КонецПроцедуры

Процедура СведенияОМаркировке_ПривестиКВерсииКонтракта(ТоварыДокументов, ВерсияКонтракта)
	
	ВидыУпаковок = Перечисления.КонтурМаркировка_ВидыУпаковок;
	ВерсииКонтракта = Перечисление_ВерсииКонтрактаСведенийОМаркировке();
	
	Если Не ЗначениеЗаполнено(ВерсияКонтракта)
		Или СравнитьВерсии(ВерсияКонтракта, ВерсииКонтракта.Версия_3_22) < 0 Тогда
		
		ТипВидУпаковки = Новый ОписаниеТипов("ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок");
		
		Для Каждого СтрДок Из ТоварыДокументов Цикл
			
			Если СтрДок.СведенияОМаркировке.Колонки.Найти("КоличествоУпаковок") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого СтрСвед Из СтрДок.СведенияОМаркировке Цикл
				СтрСвед.Количество = СтрСвед.КоличествоУпаковок;
				Если СтрСвед.ВидУпаковки = ВидыУпаковок.ПартионныйУчет Тогда
					СтрСвед.ВидУпаковки = ВидыУпаковок.ОбъемноСортовойУчет;
				КонецЕсли;
			КонецЦикла;
			
			СтрДок.СведенияОМаркировке.Колонки.Удалить("КоличествоУпаковок");
			СтрДок.СведенияОМаркировке.Колонки.Удалить("ПеременнаяХарактеристика");
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СведенияОМаркировке_ПроверитьДокумент(ПервичныйДокумент
	, ДокументУчета
	, ИсправляемыйДокументУчета
	, ПроверитьЗавершениеРаботы
	, ЭтоКорректировка
	, ОшибкиМаркировки
	, КэшРезультатов = Неопределено)
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ПервичныйДокумент];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	СервисыПодписок = Перечисление_СервисыПодписок();
	РолиДокументов = Перечисление_РолиДокументовУчета();
	СтатусыПроверкиКодов = Перечисление_СтатусыПроверкиКодовДокумента();
	ТипыОшибок = Перечисление_ТипыОшибокСведенийОМаркировке();
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	Организация = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "Организация");
	
	СтатусПроверкиКодов = ДокументУчета_РезультатПроверкиКодов(ДокументУчета);
	СтатусДокумента = ДокументУчета_ОсновнойСтатус(ДокументУчета);
	Результат = (СтатусДокумента <> СтатусыДокументовУчета.Пропущен);
	
	Если Результат И Не СервисДоступенПоТарифу(СервисыПодписок.ЗаполнениеСведенийОМаркировке, Тариф(Организация)) Тогда
		СтрОшибки = ОшибкиМаркировки.Добавить();
		СтрОшибки.ТипОшибки = ТипыОшибок.ТарифНеПоддерживаетНаполнениеУПД;
		СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
		СтрОшибки.ДокументУчета = ДокументУчета;
		Метрика_ОграничениеТарифа(Организация, СервисыПодписок.ЗаполнениеСведенийОМаркировке);
		Результат = Ложь;
	КонецЕсли;
	
	Если Результат И Не ДокументУчета_ЕстьРолиДляОтраженияВЭДО(ДокументУчета) Тогда
		СтрОшибки = ОшибкиМаркировки.Добавить();
		СтрОшибки.ТипОшибки = ТипыОшибок.ОтсутствуетРольОтгрузка;
		СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
		СтрОшибки.ДокументУчета = ДокументУчета;
		Результат = Ложь;
	КонецЕсли;
	
	Если Результат И ПроверитьЗавершениеРаботы И СтатусДокумента <> СтатусыДокументовУчета.Завершен Тогда
		СтрОшибки = ОшибкиМаркировки.Добавить();
		СтрОшибки.ТипОшибки = ТипыОшибок.ДокументНеЗавершен;
		СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
		СтрОшибки.ДокументУчета = ДокументУчета;
		Результат = Ложь;
	КонецЕсли;
	
	Если Результат И ЭтоКорректировка И Не ЗначениеЗаполнено(ИсправляемыйДокументУчета) Тогда
		СтрОшибки = ОшибкиМаркировки.Добавить();
		СтрОшибки.ТипОшибки = ТипыОшибок.НеЗаполненИсправляемыйДокументУчета;
		СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
		СтрОшибки.ДокументУчета = ДокументУчета;
		Результат = Ложь;
	КонецЕсли;
	
	Если Результат И Не СведенияОМаркировке_Проверить_КодыОтсутствуют(ДокументУчета) Тогда
		СтрОшибки = ОшибкиМаркировки.Добавить();
		СтрОшибки.ТипОшибки = ТипыОшибок.КодыОтсутствуют;
		СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
		СтрОшибки.ДокументУчета = ДокументУчета;
		Результат = Ложь;
	КонецЕсли;
	
	Если Результат И Не СведенияОМаркировке_Проверить_ТоварыНеСопоставлены(ДокументУчета) Тогда
		СтрОшибки = ОшибкиМаркировки.Добавить();
		СтрОшибки.ТипОшибки = ТипыОшибок.ТоварыНеСопоставлены;
		СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
		СтрОшибки.ДокументУчета = ДокументУчета;
		Результат = Ложь;
	КонецЕсли;
	
	Если Результат И Не ДокументУчета_ПроверитьСопоставлениеКодов(ДокументУчета) Тогда
		СтрОшибки = ОшибкиМаркировки.Добавить();
		СтрОшибки.ТипОшибки = ТипыОшибок.КодыНеСопоставлены;
		СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
		СтрОшибки.ДокументУчета = ДокументУчета;
		Результат = Ложь;
	КонецЕсли;
	
	Если Результат И Не ЭтоКорректировка
		И Не ДокументУчета_ДоступнаРоль(ДокументУчета, РолиДокументов.КорректировкаОтгрузки)
		И Не СведенияОМаркировке_Проверить_НеУказаноКоличествоУпаковок(ДокументУчета) Тогда
		СтрОшибки = ОшибкиМаркировки.Добавить();
		СтрОшибки.ТипОшибки = ТипыОшибок.НеУказаноКоличествоУпаковок;
		СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
		СтрОшибки.ДокументУчета = ДокументУчета;
		Результат = Ложь;
	КонецЕсли;
	
	Если Результат Тогда
		МассивGTIN = СведенияОМаркировке_Проверить_НеРазрешенОСУ(ДокументУчета);
		Если ЗначениеЗаполнено(МассивGTIN) Тогда
			СтрОшибки = ОшибкиМаркировки.Добавить();
			СтрОшибки.ТипОшибки = ТипыОшибок.НеРазрешенОСУ;
			СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
			СтрОшибки.ДокументУчета = ДокументУчета;
			СтрОшибки.МассивGTIN = МассивGTIN;
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Результат Тогда
		МассивGTIN = СведенияОМаркировке_Проверить_НеРазрешенПартионныйУчет(ДокументУчета);
		Если ЗначениеЗаполнено(МассивGTIN) Тогда
			СтрОшибки = ОшибкиМаркировки.Добавить();
			СтрОшибки.ТипОшибки = ТипыОшибок.НеРазрешенПартионныйУчет;
			СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
			СтрОшибки.ДокументУчета = ДокументУчета;
			СтрОшибки.МассивGTIN = МассивGTIN;
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Результат Тогда
		МассивGTIN = СведенияОМаркировке_Проверить_ЗаполнениеНомераПартии(ДокументУчета);
		Если ЗначениеЗаполнено(МассивGTIN) Тогда
			СтрОшибки = ОшибкиМаркировки.Добавить();
			СтрОшибки.ТипОшибки = ТипыОшибок.НеЗаполненНомерПартии;
			СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
			СтрОшибки.ДокументУчета = ДокументУчета;
			СтрОшибки.МассивGTIN = МассивGTIN;
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Результат И ДокументУчета_ТребуетсяПроверкаКодов(ДокументУчета) И СтатусПроверкиКодов <> СтатусыПроверкиКодов.Отключена Тогда
		
		ТипОшибки = СведенияОМаркировке_Проверить_СтатусПроверкиКодов(СтатусПроверкиКодов);
		Если ЗначениеЗаполнено(ТипОшибки) Тогда
			СтрОшибки = ОшибкиМаркировки.Добавить();
			СтрОшибки.ТипОшибки = ТипОшибки;
			СтрОшибки.ПервичныйДокумент = ПервичныйДокумент;
			СтрОшибки.ДокументУчета = ДокументУчета;
			Результат = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(ПервичныйДокумент, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОМаркировке_ТаблицаТоваров(ТоварыДокументов, МенеджерВТ)
	
	Результат = Новый_ТаблицаМаркировки(ТоварыДокументов);
	Результат.Колонки.Добавить("ПолученоКИ", ОписаниеТипа_Число());
	Результат.Колонки.Добавить("ВсеКодыПолучены", ОписаниеТипа_Булево());
	Результат.Колонки.Добавить("КоличествоУпаковок", ОписаниеТипа_Число());
	
	РезультатТовары = СведенияОМаркировке_РезультатТовары(МенеджерВТ);
	
	КэшНоменклатуры = Новый Соответствие;
	
	ВыборкаДокументУчета = РезультатТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокументУчета.Следующий() Цикл
		
		Документ1С = ДокументУчета_Документ1С(ВыборкаДокументУчета.ДокументУчета);
		
		ВыборкаНоменклатура = ВыборкаДокументУчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаНоменклатура.Следующий() Цикл
			
			АналитикаНоменклатуры = АналитикаНоменклатуры1С(ВыборкаНоменклатура.КлючНоменклатуры1С, КэшНоменклатуры);
			
			Выборка = ВыборкаНоменклатура.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				СтрТов = Результат.Добавить();
				СтрТов.СведенияОМаркировке = Новый_ТаблицаМаркировки_СведенияОМаркировке();
				СтрТов.ДокументУчета = Выборка.ДокументУчета;
				СтрТов.ПервичныйДокумент = Документ1С;
				СтрТов.GTIN = Выборка.Товар.GTIN;
				СтрТов.Количество = Выборка.Количество;
				СтрТов.КоличествоУпаковок = Выборка.КоличествоКИ;
				СтрТов.КоличествоВУпаковке = Выборка.Количество / Выборка.КоличествоУпаковок;
				
				ЗаполнитьЗначенияСвойств(СтрТов, АналитикаНоменклатуры);
				
				СтрТов.СведенияОМаркировке = Новый_ТаблицаМаркировки_СведенияОМаркировке();
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОМаркировке_ТаблицаАгрегатов(ТоварыДокументов, МенеджерВТ)
	
	Результат = Новый_ТаблицаМаркировки(ТоварыДокументов);
	
	РезультатМаркировки = СведенияОМаркировке_РезультатАгрегаты(МенеджерВТ);
	
	КэшНоменклатуры = Новый Соответствие;
	
	ВыборкаДокументУчета = РезультатМаркировки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокументУчета.Следующий() Цикл
		
		Документ1С = ДокументУчета_Документ1С(ВыборкаДокументУчета.ДокументУчета);
		
		ВыборкаНоменклатура = ВыборкаДокументУчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаНоменклатура.Следующий() Цикл
			
			АналитикаНоменклатуры = АналитикаНоменклатуры1С(ВыборкаНоменклатура.КлючНоменклатуры1С, КэшНоменклатуры);
			
			ВыборкаТовар = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаТовар.Следующий() Цикл
				
				GTIN = ВыборкаТовар.Товар.GTIN;
				КодТоварнойГруппы = КодТоварнойГруппыГИСМТ(ВыборкаТовар.ВидПродукции);
				
				СтрАгр = Результат.Добавить();
				СтрАгр.ДокументУчета = ВыборкаДокументУчета.ДокументУчета;
				СтрАгр.ПервичныйДокумент = Документ1С;
				СтрАгр.GTIN = GTIN;
				
				ЗаполнитьЗначенияСвойств(СтрАгр, АналитикаНоменклатуры);
				
				СтрАгр.СведенияОМаркировке = Новый_ТаблицаМаркировки_СведенияОМаркировке();
				
				Выборка = ВыборкаТовар.Выбрать();
				Пока Выборка.Следующий() Цикл
					СтрСвед = СтрАгр.СведенияОМаркировке.Добавить();
					СтрСвед.GTIN = GTIN;
					СтрСвед.КодТоварнойГруппы = КодТоварнойГруппы;
					СтрСвед.ЗначениеШтрихкода = Выборка.КодМаркировки;
					СтрСвед.КоличествоКИ = Выборка.КоличествоКИ;
					СтрСвед.ВидУпаковки = ВидУпаковкиПоОбщемуТипуУпаковки(Выборка.ОбщийТипУпаковки);
				КонецЦикла;
				
				СтрАгр.КоличествоКИ = СтрАгр.СведенияОМаркировке.Итог("КоличествоКИ");
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОМаркировке_ТаблицаМаркировки(ТоварыДокументов, МенеджерВТ, ОшибкиМаркировки)
	
	// BSLLS:CognitiveComplexity-off
	// BSLLS:NestedStatements-off
	
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	ТипыПеременныхХарактеристик = Перечисление_ТипыПеременныхХарактеристикТовара();
	
	Результат = Новый_ТаблицаМаркировки(ТоварыДокументов);
	РезультатМаркировки = СведенияОМаркировке_РезультатМаркировки(МенеджерВТ);
	
	КэшНоменклатуры = Новый Соответствие;
	
	ВыборкаДокументУчета = РезультатМаркировки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокументУчета.Следующий() Цикл
		
		ДокументУчета = ВыборкаДокументУчета.ДокументУчета;
		ПервичныйДокумент = ДокументУчета_Документ1С(ДокументУчета);
		
		ВыборкаНоменклатура = ВыборкаДокументУчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаНоменклатура.Следующий() Цикл
			
			КоличествоНоменклатуры = ВыборкаНоменклатура.КоличествоНоменклатуры;
			КоличествоУпаковок = ВыборкаНоменклатура.КоличествоУпаковок;
			АналитикаНоменклатуры = АналитикаНоменклатуры1С(ВыборкаНоменклатура.КлючНоменклатуры1С, КэшНоменклатуры);
			
			ВыборкаСтрокаДокумента = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаСтрокаДокумента.Следующий() Цикл
				
				КодТоварнойГруппы = КодТоварнойГруппыГИСМТ(ВыборкаСтрокаДокумента.ВидПродукции);
				ПередаватьШтрихкодОСУ = СведенияОМаркировке_ПередаватьШтрихкодОСУ(ВыборкаСтрокаДокумента);
				
				ВыборкаТовар = ВыборкаСтрокаДокумента.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаТовар.Следующий() Цикл
					
					GTIN = ВыборкаТовар.Товар.GTIN;
					
					СтрМарк = Результат.Добавить();
					СтрМарк.ДокументУчета = ДокументУчета;
					СтрМарк.ПервичныйДокумент = ПервичныйДокумент;
					СтрМарк.GTIN = GTIN;
					СтрМарк.ОбъемноСортовойУчет = ПередаватьШтрихкодОСУ;
					СтрМарк.КоличествоВУпаковке = КоличествоНоменклатуры / КоличествоУпаковок;
					
					СтрМарк.СведенияОМаркировке = Новый_ТаблицаМаркировки_СведенияОМаркировке();
					
					ЗаполнитьЗначенияСвойств(СтрМарк, АналитикаНоменклатуры);
					
					ПеременнаяХарактеристика = ДопРеквизит_Прочитать(ВыборкаТовар.Товар, "ПеременнаяХарактеристика");
					
					Выборка = ВыборкаТовар.Выбрать();
					Пока Выборка.Следующий() Цикл
						
						СтрСвед = СтрМарк.СведенияОМаркировке.Добавить();
						СтрСвед.GTIN = GTIN;
						СтрСвед.КодТоварнойГруппы = КодТоварнойГруппы;
						
						Если СтрМарк.ОбъемноСортовойУчет Тогда
							
							СтрСвед.ВидУпаковки = СведенияОМаркировке_ВидУпаковкиОСУ(ВыборкаСтрокаДокумента.ОтражениеВЭДО);
							СтрСвед.КоличествоКИ = Выборка.КоличествоКИ;
							СтрСвед.ЗначениеШтрихкода = ШтрихкодОбъемноСортовогоУчета(GTIN, Выборка.КоличествоКИ);
							
							Если ВыборкаСтрокаДокумента.ОтражениеВЭДО = Перечисление_ПравилаОтраженияВЭДО().ПартионныйУчет Тогда
								СтрСвед.НомерПартии = Выборка.НомерПартии;
								СтрСвед.Количество = Выборка.Количество;
								Если ЗначениеЗаполнено(Выборка.Количество) Тогда
									СтрСвед.ПеременнаяХарактеристика = ПеременнаяХарактеристика;
								КонецЕсли;
							КонецЕсли;
							
						Иначе
							
							СтрСвед.ВидУпаковки = ВидУпаковкиПоОбщемуТипуУпаковки(Выборка.ОбщийТипУпаковки);
							СтрСвед.КоличествоКИ = Выборка.КоличествоКИ;
							СтрСвед.ЗначениеШтрихкода = Выборка.КодМаркировки;
							
							Если Не ЗначениеЗаполнено(СтрСвед.КоличествоКИ)
								И Выборка.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
								СтрСвед.КоличествоКИ = СведенияОМаркировке_КоличествоВложенныхКодов(Выборка.КлючКода);
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
					СтрМарк.КоличествоКИ = СтрМарк.СведенияОМаркировке.Итог("КоличествоКИ");
					СтрМарк.Количество = СтрМарк.КоличествоВУпаковке * СтрМарк.КоличествоКИ;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
	// BSLLS:CognitiveComplexity-on
	// BSLLS:NestedStatements-on
	
КонецФункции

Функция СведенияОМаркировке_РезультатТовары(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаТоваров.ДокументУчета КАК ДокументУчета,
	|	ТаблицаТоваров.Товар КАК Товар,
	|	ТаблицаТоваров.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТаблицаТоваров.КоличествоКИ КАК КоличествоКИ,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.КоличествоУпаковок КАК КоличествоУпаковок
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументУчета
	|ИТОГИ ПО
	|	ДокументУчета,
	|	КлючНоменклатуры1С");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция СведенияОМаркировке_РезультатАгрегаты(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаАгрегатов.ДокументУчета КАК ДокументУчета,
	|	ТаблицаАгрегатов.КлючКода КАК КлючКода,
	|	ТаблицаАгрегатов.КодМаркировки КАК КодМаркировки,
	|	ТаблицаАгрегатов.ОбщийТипУпаковки КАК ОбщийТипУпаковки,
	|	ТаблицаАгрегатов.НомерПартии КАК НомерПартии,
	|	ТаблицаАгрегатов.Товар КАК Товар,
	|	ТаблицаАгрегатов.ВидПродукции КАК ВидПродукции,
	|	ТаблицаАгрегатов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТаблицаАгрегатов.КоличествоКИ КАК КоличествоКИ
	|ИЗ
	|	ТаблицаАгрегатов КАК ТаблицаАгрегатов
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументУчета
	|ИТОГИ
	|	МАКСИМУМ(ВидПродукции)
	|ПО
	|	ДокументУчета,
	|	КлючНоменклатуры1С,
	|	Товар");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция СведенияОМаркировке_РезультатМаркировки(МенеджерВТ)
	
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	
	// BSLLS:MethodSize-off
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.ДокументУчета КАК ДокументУчета,
	|	ТаблицаКодов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТаблицаКодов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ТаблицаКодов.Товар КАК Товар,
	|	&ПУ КАК ОтражениеВЭДО,
	|	ТаблицаКодов.ВидПродукции КАК ВидПродукции,
	|	ТаблицаКодов.КодМаркировки КАК КодМаркировки,
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.ОбщийТипУпаковки КАК ОбщийТипУпаковки,
	|	ТаблицаКодов.НомерПартии КАК НомерПартии,
	|	0 КАК Количество,
	|	ТаблицаНоменклатуры.Количество КАК КоличествоНоменклатуры,
	|	ТаблицаНоменклатуры.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТаблицаКодов.ОбщийТипУпаковки = &Транспортная
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоличествоКИ
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|		ПО ТаблицаКодов.ДокументУчета = ТаблицаНоменклатуры.ДокументУчета
	|			И ТаблицаКодов.КлючНоменклатуры1С = ТаблицаНоменклатуры.КлючНоменклатуры1С
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаОСУ.ДокументУчета,
	|	ТаблицаОСУ.КлючНоменклатуры1С,
	|	ТаблицаОСУ.КлючСтрокиДокумента,
	|	ТаблицаОСУ.Товар,
	|	ТаблицаОСУ.ОтражениеВЭДО,
	|	ТаблицаОСУ.ВидПродукции,
	|	НЕОПРЕДЕЛЕНО,
	|	ПустойКлюч.Ключ,
	|	НЕОПРЕДЕЛЕНО,
	|	ТаблицаОСУ.НомерПартии,
	|	ТаблицаОСУ.ПеременноеКоличество,
	|	ТаблицаНоменклатурыОСУ.Количество,
	|	ТаблицаНоменклатурыОСУ.КоличествоУпаковок,
	|	ТаблицаОСУ.КоличествоКИ
	|ИЗ
	|	ТаблицаОСУ КАК ТаблицаОСУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаНоменклатурыОСУ КАК ТаблицаНоменклатурыОСУ
	|		ПО ТаблицаОСУ.ДокументУчета = ТаблицаНоменклатурыОСУ.ДокументУчета
	|			И ТаблицаОСУ.КлючНоменклатуры1С = ТаблицаНоменклатурыОСУ.КлючНоменклатуры1С
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлюч
	|		ПО (ИСТИНА)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Результат.КлючКода КАК КлючКода,
	|	СУММА(ЕСТЬNULL(ТоварыАгрегатов.КоличествоУпаковок, КодыМаркировки.КоличествоУпаковок)) КАК КоличествоКИ
	|ПОМЕСТИТЬ ТабКоличествоКИ
	|ИЗ
	|	Результат КАК Результат
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО Результат.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО Результат.КлючКода = ТоварыАгрегатов.КлючКода
	|ГДЕ
	|	Результат.ОбщийТипУпаковки = &Транспортная
	|	И ЕСТЬNULL(ТоварыАгрегатов.КоличествоУпаковок, КодыМаркировки.КоличествоУпаковок) > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Результат.КлючКода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Результат.ДокументУчета КАК ДокументУчета,
	|	Результат.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Результат.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	Результат.Товар КАК Товар,
	|	Результат.ОтражениеВЭДО КАК ОтражениеВЭДО,
	|	Результат.ВидПродукции КАК ВидПродукции,
	|	Результат.КодМаркировки КАК КодМаркировки,
	|	Результат.КлючКода КАК КлючКода,
	|	Результат.ОбщийТипУпаковки КАК ОбщийТипУпаковки,
	|	Результат.НомерПартии КАК НомерПартии,
	|	Результат.Количество КАК Количество,
	|	Результат.КоличествоНоменклатуры КАК КоличествоНоменклатуры,
	|	Результат.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ЕСТЬNULL(ТабКоличествоКИ.КоличествоКИ, Результат.КоличествоКИ) КАК КоличествоКИ
	|ИЗ
	|	Результат КАК Результат
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабКоличествоКИ КАК ТабКоличествоКИ
	|		ПО Результат.КлючКода = ТабКоличествоКИ.КлючКода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументУчета
	|ИТОГИ
	|	МАКСИМУМ(ОтражениеВЭДО),
	|	МАКСИМУМ(ВидПродукции),
	|	МАКСИМУМ(КоличествоНоменклатуры),
	|	МАКСИМУМ(КоличествоУпаковок),
	|	МАКСИМУМ(Количество),
	|	СУММА(КоличествоКИ)
	|ПО
	|	ДокументУчета,
	|	КлючНоменклатуры1С,
	|	КлючСтрокиДокумента,
	|	Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПустойКлюч
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКоличествоКИ");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПУ", Перечисление_ПравилаОтраженияВЭДО().ПУ);
	Запрос.УстановитьПараметр("ПустойКлюч", ПустойУникальныйИдентификатор());
	Запрос.УстановитьПараметр("Транспортная", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Возврат Запрос.Выполнить();
	
	// BSLLS:MethodSize-on
	
КонецФункции

Функция СведенияОМаркировке_КоличествоВложенныхКодов(КлючКода)
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = КлючКода;
	
	ТаблицаКодов_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(ТаблицаКодов);
	
	Возврат ТаблицаКодов.Количество();
	
КонецФункции

Функция СведенияОМаркировке_ДоступныеСтрокиДокумента(СтрМарк, ТоварыДокументов, ПараметрыПоиска)
	
	Результат = Новый Массив;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура", СтрМарк.Номенклатура);
	Отбор.Вставить("ПервичныйДокумент", СтрМарк.ПервичныйДокумент);
	Отбор.Вставить("ВсеКодыПолучены", Ложь);
	
	// BSLLS:EmptyCodeBlock-off
	
	Для Каждого СтрДок Из ТоварыДокументов.НайтиСтроки(Отбор) Цикл
		
		ПустаяСерияДок = Не ЗначениеЗаполнено(СтрДок.Серия);
		ПустаяСерияМарк = Не ЗначениеЗаполнено(СтрМарк.Серия);
		
		Если СтрМарк.Серия = СтрДок.Серия Или (ПустаяСерияДок И ПустаяСерияМарк) Тогда
			// Серии совпадают
		ИначеЕсли ПустаяСерияМарк И ПараметрыПоиска.РазрешитьПустуюСериюИсточника Тогда
			// Допускается пустая серия в маркировке
		ИначеЕсли ПустаяСерияДок И ПараметрыПоиска.РазрешитьПустуюСериюПриемника Тогда
			// Допускается пустая серия в позиции документа
		Иначе
			Продолжить;
		КонецЕсли;
		
		ПустаяХарактДок = Не ЗначениеЗаполнено(СтрДок.Характеристика);
		ПустаяХарактМарк = Не ЗначениеЗаполнено(СтрМарк.Характеристика);
		
		Если СтрМарк.Характеристика = СтрДок.Характеристика Или (ПустаяХарактМарк И ПустаяХарактДок) Тогда
			// Характеристики совпадают
		ИначеЕсли ПустаяХарактМарк И ПараметрыПоиска.РазрешитьПустуюХарактеристикуИсточника Тогда
			// Допускается пустая характеристика в маркировке
		ИначеЕсли ПустаяХарактДок И ПараметрыПоиска.РазрешитьПустуюХарактеристикуПриемника Тогда
			// Допускается пустая характеристика в позиции документа
		Иначе
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(СтрДок);
		
	КонецЦикла;
	
	// BSLLS:EmptyCodeBlock-on
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОМаркировке_НайтиСтрокиМаркировки(СтрАгр, ТоварыМаркировки, ПараметрыПоиска)
	
	Результат = Новый Массив;
	
	Отбор = Новый Структура("ПервичныйДокумент", СтрАгр.ПервичныйДокумент);
	
	// BSLLS:CognitiveComplexity-off
	// BSLLS:EmptyCodeBlock-off
	
	Для Каждого СтрМарк Из ТоварыМаркировки.НайтиСтроки(Отбор) Цикл
		
		Если (ЗначениеЗаполнено(СтрАгр.GTIN) Или ЗначениеЗаполнено(СтрМарк.GTIN))
			И СтрАгр.GTIN <> СтрМарк.GTIN Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрАгр.Номенклатура)
			И СтрАгр.Номенклатура <> СтрМарк.Номенклатура Тогда
			Продолжить;
		КонецЕсли;
		
		ПустаяСерияАгр = Не ЗначениеЗаполнено(СтрАгр.Серия);
		ПустаяСерияМарк = Не ЗначениеЗаполнено(СтрМарк.Серия);
		
		Если СтрАгр.Серия = СтрМарк.Серия Или (ПустаяСерияАгр И ПустаяСерияМарк) Тогда
			// Серии совпадают
		ИначеЕсли ПустаяСерияАгр И ПараметрыПоиска.РазрешитьПустуюСериюИсточника Тогда
			// Допускается пустая серия в агрегатах
		ИначеЕсли ПустаяСерияМарк И ПараметрыПоиска.РазрешитьПустуюСериюПриемника Тогда
			// Допускается пустая серия в маркировке
		Иначе
			Продолжить;
		КонецЕсли;
		
		ПустаяХарактАгр = Не ЗначениеЗаполнено(СтрАгр.Характеристика);
		ПустаяХарактМарк = Не ЗначениеЗаполнено(СтрМарк.Характеристика);
		
		Если СтрАгр.Характеристика = СтрМарк.Характеристика Или (ПустаяХарактАгр И ПустаяХарактМарк) Тогда
			// Характеристики совпадают
		ИначеЕсли ПустаяХарактАгр И ПараметрыПоиска.РазрешитьПустуюХарактеристикуИсточника Тогда
			// Допускается пустая характеристика в агрегатах
		ИначеЕсли ПустаяХарактМарк И ПараметрыПоиска.РазрешитьПустуюХарактеристикуПриемника Тогда
			// Допускается пустая характеристика в маркировке
		Иначе
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(СтрМарк);
		
	КонецЦикла;
	
	// BSLLS:CognitiveComplexity-on
	// BSLLS:EmptyCodeBlock-on
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОМаркировке_ДополнитьВАгрегатыВложенныеТоварыКИГУ(ТаблицаАгрегатов)
	
	Результат = Ложь;
	КэшТоваров = Новый Соответствие;
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	Для Каждого СтрАгр Из СведенияОМаркировке_ДоступныеСтроки(ТаблицаАгрегатов) Цикл
		
		Если Не ЗначениеЗаполнено(СтрАгр.GTIN) Тогда
			Продолжить;
		КонецЕсли;
		
		Товар = Товар_Найти(СтрАгр.GTIN, КэшТоваров);
		
		Если Товар.ТипКодаМаркировки <> ТипыКодовМаркировки.ГрупповаяУпаковка
			Или Не ЗначениеЗаполнено(Товар.ВложенныйТовар)
			Или Не ЗначениеЗаполнено(Товар.КоличествоВложений) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиСвед = СведенияОМаркировке_ДоступныеСведения(СтрАгр.СведенияОМаркировке);
		Если Не ЗначениеЗаполнено(СтрокиСвед) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрКИГУ = ТаблицаАгрегатов.Добавить();
		СтрКИГУ.СведенияОМаркировке = Новый_ТаблицаМаркировки_СведенияОМаркировке();
		ЗаполнитьЗначенияСвойств(СтрКИГУ, СтрАгр, , "СведенияОМаркировке, Номенклатура, GTIN");
		
		Для Каждого СтрСвед Из СтрокиСвед Цикл
			
			ОсталосьКИ = СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ;
			
			НоваяСтрока = СтрКИГУ.СведенияОМаркировке.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед, , "КоличествоКИ, ПереданоКИ");
			НоваяСтрока.КоличествоКИ = ОсталосьКИ * Товар.КоличествоВложений;
			
			Если ЗначениеЗаполнено(СтрСвед.ПереданоКИ) Тогда
				СтрСвед.КоличествоКИ = СтрСвед.КоличествоКИ - ОсталосьКИ;
				СтрСвед.Передан = Истина;
			Иначе
				СтрАгр.СведенияОМаркировке.Удалить(СтрСвед);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СтрАгр.ПереданоКИ) Тогда
			СтрАгр.КоличествоКИ = СтрАгр.КоличествоКИ - СтрАгр.ПереданоКИ;
			СтрАгр.ВсеКодыПереданы = Истина;
		Иначе
			ТаблицаАгрегатов.Удалить(СтрАгр);
		КонецЕсли;
		
		СтрКИГУ.GTIN = Товар.ВложенныйТовар.GTIN;
		СтрКИГУ.КоличествоКИ = СтрКИГУ.СведенияОМаркировке.Итог("КоличествоКИ");
		
		Результат = Истина;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

