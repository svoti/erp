Функция ОписаниеНастройкиДокументаДляМетрики(ОписаниеНастройки)
	
	Результат = Новый Структура;
	
	Для каждого Эл Из ОписаниеНастройки Цикл
		Если Лев(Эл.Ключ, 4) = "Поле" И ЗначениеЗаполнено(Эл.Значение) Тогда
			ЕстьПоле = "Есть" + СтрЗаменить(Эл.Ключ, "Поле", "");
			Результат.Вставить(ЕстьПоле, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОписаниеНастройки.ТабличнаяЧасть)
		И ОписаниеНастройки.ТабличнаяЧасть <> "<Реквизиты шапки>" Тогда
		Результат.Вставить("ЕстьТабличнаяЧасть", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеНастройки.ДополнительноеУсловиеОтбора) Тогда
		Результат.Вставить("ДопУсловиеОтбора", ОписаниеНастройки.ДополнительноеУсловиеОтбора);
	КонецЕсли;
	
	Если Не ОписаниеНастройки.ПоказатьВСпискеЕслиТоварыНеПодлежатМаркировке Тогда
		Результат.Вставить("ПоказатьТолькоЕслиТоварыПодлежатМаркировке", Истина);
	КонецЕсли;
	
	Если Не ОписаниеНастройки.ПоказатьВСпискеЕслиТоварыНеЗаполнены Тогда
		Результат.Вставить("ПоказатьТолькоЕслиЗаполненыТовары", Истина);
	КонецЕсли;
	
	Если Не ОписаниеНастройки.ПоказатьВСпискеЕслиНеПроведен Тогда
		Результат.Вставить("ПоказатьТолькоЕслиПроведен", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеНастройки.ОтключенныеКоманды) Тогда
		Результат.Вставить("ЕстьОграничениеКоманд", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеНастройки.МаршрутМаркировки) Тогда
		Результат.Вставить("ЕстьМаршрутМаркировки", Истина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

