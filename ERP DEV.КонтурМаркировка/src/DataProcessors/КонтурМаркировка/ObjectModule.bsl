	Операция_ЗаполнитьТаблицуТоваров(ОписаниеОперации.Товары, ТаблицаЗапроса, ПоляТоваров);
	
	КэшТоваров = Новый Соответствие;
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		ОписаниеТовара = Товар_Прочитать(Стр.Товар, КэшТоваров);
		Стр.ВложенныйТовар = ОписаниеТовара.ВложенныйТовар;
		Стр.КоличествоУпаковокВложенногоТовара = Стр.КоличествоУпаковок * ОписаниеТовара.КоличествоВложений;
