Функция КодМаркировки_СвязиОбъектов(КлючКода) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос("ВЫБРАТЬ &КлючКода КАК КлючКода ПОМЕСТИТЬ ТаблицаКодов");
	Запрос.УстановитьПараметр("КлючКода", КлючКода);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТаблицаКодов_ВТ_ДобавитьКлючиАгрегатовВерхнегоУровня(МенеджерВТ);
	
	// BSLLS:UnionAll-off
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Таб.КлючКода КАК КлючКода,
	|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	КодыДокументов.ДокументУчета КАК ДокументИлиОперация,
	|	СтатусыДокументов.Статус КАК СтатусДокументаИлиОперации
	|ИЗ
	|	ТаблицаКодов КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО Таб.КлючКода = КодыДокументов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО Таб.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК СтатусыДокументов
	|		ПО (КодыДокументов.ДокументУчета = СтатусыДокументов.ДокументУчета)
	|			И (СтатусыДокументов.ТипСтатуса = &ОсновнойСтатус)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таб.КлючКода,
	|	КодыМаркировки.КодМаркировки,
	|	КодыОпераций.Операция,
	|	СтатусыОпераций.Статус
	|ИЗ
	|	ТаблицаКодов КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО Таб.КлючКода = КодыОпераций.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО Таб.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО (КодыОпераций.Операция = СтатусыОпераций.Операция)
	|			И (СтатусыОпераций.ТипСтатуса = &ОсновнойСтатус)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Таб.КлючКода,
	|	КодыМаркировки.КодМаркировки,
	|	ДопРеквизиты.Объект,
	|	СтатусыОпераций.Статус
	|ИЗ
	|	ТаблицаКодов КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДопРеквизиты
	|		ПО Таб.КлючКода = ДопРеквизиты.ЗначениеКлюч
	|			И (ДопРеквизиты.ИмяРеквизита = ""КлючКода"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО Таб.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО (ДопРеквизиты.Объект = СтатусыОпераций.Операция)
	|			И (СтатусыОпераций.ТипСтатуса = &ОсновнойСтатус)");
	// BSLLS:UnionAll-on
	Запрос.УстановитьПараметр("ОсновнойСтатус", Перечисление_ТипыСтатусов().ОсновнойСтатус);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МенеджерВТ.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция КодМаркировки_ЕстьВложенныеКоды(КодМаркировкиИлиКлючКода) Экспорт
	
	Если ТипЗнч(КодМаркировкиИлиКлючКода) = Тип("УникальныйИдентификатор") Тогда
		КлючКода = КодМаркировкиИлиКлючКода;
	Иначе
		КлючКода = КодМаркировки_КлючКода(КодМаркировкиИлиКлючКода);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючКода) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК Т
	|ГДЕ
	|	Т.КлючАгрегата = &КлючАгрегата");
	
	Запрос.УстановитьПараметр("КлючАгрегата", КлючКода);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

