// #Область ПодборКодовНаТСД

Функция ПодборКодовНаТСД_ПоследниеКонтактныеДанные(ИННКонтрагента) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КонтактныйТелефон", "");
	Результат.Вставить("АдресДоставки", "");
	
	ОперацииПодбораКодовНаТСД = Новый Массив;
	ОперацииПодбораКодовНаТСД.Добавить(Перечисление_ТипыОпераций().ПодборКодовНаТСД);
	ОперацииПодбораКодовНаТСД.Добавить(Перечисление_ТипыОпераций().ПодборТоваровИКодовНаТСД);
	
	ДнейВГоду = 365;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	АдресаДоставки.Значение КАК АдресДоставки,
	|	КонтактныеТелефоны.Значение КАК КонтактныйТелефон,
	|	Операции.Дата КАК ДатаОперации
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ИННКонтрагентов
	|		ПО Операции.Ссылка = ИННКонтрагентов.Объект
	|			И (ИННКонтрагентов.ИмяРеквизита = &РеквизитКонтрагентИНН)
	|			И (ИННКонтрагентов.Значение = &ИННКонтрагента)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК АдресаДоставки
	|		ПО Операции.Ссылка = АдресаДоставки.Объект
	|			И (АдресаДоставки.ИмяРеквизита = &РеквизитАдресДоставки)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК КонтактныеТелефоны
	|		ПО Операции.Ссылка = КонтактныеТелефоны.Объект
	|			И (КонтактныеТелефоны.ИмяРеквизита = &РеквизитКонтактныйТелефон)
	|ГДЕ
	|	НЕ Операции.ПометкаУдаления
	|	И Операции.ТипОперации В(&ОперацииПодбораКодовНаТСД)
	|	И Операции.Дата >= &ПоследнийГод
	|	И АдресаДоставки.Значение ЕСТЬ НЕ NULL 
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОперации УБЫВ";
	
	Запрос.УстановитьПараметр("РеквизитКонтрагентИНН", "КонтрагентИНН");
	Запрос.УстановитьПараметр("РеквизитАдресДоставки", "АдресДоставки");
	Запрос.УстановитьПараметр("РеквизитКонтактныйТелефон", "КонтактныйТелефон");
	Запрос.УстановитьПараметр("ИННКонтрагента", ИННКонтрагента);
	Запрос.УстановитьПараметр("ОперацииПодбораКодовНаТСД", ОперацииПодбораКодовНаТСД);
	Запрос.УстановитьПараметр("ПоследнийГод", ТекущаяДатаСеанса() - СекундВСутках() * ДнейВГоду);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.КонтактныйТелефон = Выборка.КонтактныйТелефон;
		Результат.АдресДоставки     = Выборка.АдресДоставки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

