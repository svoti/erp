Функция СервисОбновлений_ПубличнаяСсылка(Продукт, Версия, ТипКонтента)
	
	Результат = Неопределено;
	
	Попытка
		Ответ = СервисОбновлений_ОписаниеВерсии(Продукт, Версия);
	Исключение
		Действие = НСтр("ru = 'Получение ссылки на файл версии продукта'");
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Версия", Версия);
		ДопИнформация.Вставить("Продукт", Продукт);
		ДопИнформация.Вставить("ТипКонтента", ТипКонтента);
		ОбработатьОшибку(Действие, ИнформацияОбОшибке(), ДопИнформация);
	КонецПопытки;
	
	content = СвойствоСтруктуры(Ответ, "content");
	Описание = СвойствоСтруктуры(content, ТипКонтента);
	Результат = СвойствоСтруктуры(Описание, "drive_public_link", "");
	
	Возврат Результат;
	
КонецФункции

