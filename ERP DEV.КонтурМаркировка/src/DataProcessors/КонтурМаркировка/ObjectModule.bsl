Функция ОписаниеНастроекЗаполненияОперацийДляМетрики(НастройкаРеквизита, ИспользуемыеОперации)
	
	Результат = Новый Структура;
	
	ИспользоватьНастройкиЗаполнения = (ИспользуемыеОперации.Найти(НастройкаРеквизита.ТипОперации) <> Неопределено);
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяПоля", НастройкаРеквизита.ИмяРеквизита);
	Результат.Вставить("ПравилоЗаполнения", НастройкаРеквизита.ПравилоЗаполнения);
	Результат.Вставить("Значение", НастройкаРеквизита.Значение);
	Результат.Вставить("ИспользоватьНастройкиЗаполнения", ИспользоватьНастройкиЗаполнения);
	
	Возврат Результат;
	
КонецФункции

Функция НастройкаСортировкиЭтикетокПоУмолчаниюДляМетрики(НастройкиМодуля)
	
	ШаблонСортировки = НСтр("ru='%1 %2'");
	СтрокиСортировки = Новый Массив;
	
	Для Сч = 1 По КоличествоПараметровСортировкиЭтикеток() Цикл
		
		Поле = НастройкиМодуля["ПолеСортировкиЭтикеток" + Сч + "ПоУмолчанию"];
		Направление = НастройкиМодуля["НаправлениеСортировкиЭтикеток" + Сч + "ПоУмолчанию"];
		
		Если Не ЗначениеЗаполнено(Поле) Тогда
			Прервать;
		КонецЕсли;
		
		КлючПоля = КлючиПеречисления_ПоляСортировкиЭтикеток().Получить(Поле);
		КлючНаправления = КлючиПеречисления_НаправленияСортировки().Получить(Направление);
		
		СтрокиСортировки.Добавить(ПараметрыВСтроку(ШаблонСортировки, КлючПоля, КлючНаправления));
		
	КонецЦикла;
	
	Возврат СоединитьСтроку(СтрокиСортировки, ", ");
	
КонецФункции

