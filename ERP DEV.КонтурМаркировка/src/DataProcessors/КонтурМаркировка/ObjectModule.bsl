// Находит товары маркировки по организации и аналитике номенклатуры
//
// Параметры:
//  КлючНоменклатуры1С - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С - ключ номенклатуры 1С;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Товары;
//
Функция Товары_НайтиПоКлючуНоменклатуры1С(КлючНоменклатуры1С, Организация) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Товар КАК Товар,
	|	Т.Товар.Производитель.ИНН КАК ПроизводительИНН
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СвязиНоменклатуры1С КАК Т
	|ГДЕ
	|	Т.КлючНоменклатуры1С = &КлючНоменклатуры1С
	|	И НЕ Т.Товар.ПометкаУдаления");
	Запрос.УстановитьПараметр("КлючНоменклатуры1С", КлючНоменклатуры1С);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	
	// Для каждой организации свой GTIN на одну номенклатуру 1С
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Организация) И Выборка.ПроизводительИНН = Организация.ИНН Тогда
			Результат.Добавить(Выборка.Товар);
		КонецЕсли;
	КонецЦикла;
	
	// У всех организаций один GTIN на одну номенклатуру 1С
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Выборка.Сбросить();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Товар);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Подбирает товары маркировки по штрихкоду или артикулу
//
// Параметры:
//  КлючНоменклатуры1С - Произвольный - содержит поля см. функцию Новый_АналитикаНоменклатуры1С();
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Товары;
//
Функция Товары_НайтиПоШтрихкодуИлиАртикулуНоменклатуры1С(КлючНоменклатуры1С, Организация) Экспорт
	
	АналитикаНоменклатуры = АналитикаНоменклатуры1С(КлючНоменклатуры1С);
	
	ПараметрыНоменклатуры = МодульЯдро().Интеграция_ПараметрыНоменклатуры1С(АналитикаНоменклатуры);
	Артикул = ПараметрыНоменклатуры.Артикул;
	МассивШтрихкодов = ПараметрыНоменклатуры.Штрихкоды;
	
	Если Не ЗначениеЗаполнено(Артикул)
		И Не ЗначениеЗаполнено(МассивШтрихкодов) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Результат = Товары_НайтиПоШтрихкодам(МассивШтрихкодов, Организация);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Товары_НайтиПоАртикулу(Артикул, Организация);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

