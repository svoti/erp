Функция РасположениеМодуля()
	
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	ПутьКФайлу = МодульОбщегоНазначения().ПутьКФайлуОбработки(ЭтотОбъект);
	
	Если ИспользуетсяРасширениеКонтурМаркировка() Тогда
		
		Результат = ВариантыРасположения.ВРасширении;
		
	ИначеЕсли Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		
		Результат = ВариантыРасположения.ВКонфигурации;
		
	Иначе
		
		Если МодульОбщегоНазначения().ЭтоАдресИзВременногоХранилища(ПутьКФайлу)
			Или МодульОбщегоНазначения().ЭтоКаталогВременныхФайлов(ПутьКФайлу) Тогда
			
			Результат = ВариантыРасположения.ВСправочнике;
			
		Иначе
			
			Результат = ВариантыРасположения.НаДиске;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяРасширениеКонтурМаркировка()
	
	КлючКэш = "ИспользуетсяРасширениеКонтурМаркировка";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Ложь;
	
	Если НЕ ВерсияПлатформыНиже("8.3.8") 
		И НЕ ЭтоВнешняяОбработка() Тогда
		
		РасширениеОбработки = Метаданные().РасширениеКонфигурации();
		
		Если РасширениеОбработки <> Неопределено Тогда
			
			ИмяРасширенияКонтурМаркировка = ИмяМодуля();
			Результат = (РасширениеОбработки.Имя = ИмяРасширенияКонтурМаркировка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоВнешняяОбработка()
	
