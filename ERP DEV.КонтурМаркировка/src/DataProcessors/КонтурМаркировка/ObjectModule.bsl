Функция МодульЯдро()
	
	ИмяФайла = ИмяФайлаМодуляЯдро();
	
	Если НастройкиМодуля_РежимОтладкиВключен() Тогда
		Попытка
			Результат = ОбъектВложеннойОбработки(ИмяФайла);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если Результат = Неопределено И МодульМаркировкиОткрытИзКонфигурации() Тогда
		Результат = ОбъектВложеннойОбработкиИзКонфигурации(ИмяФайла);
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = ОбъектВложеннойОбработки(ИмяФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеМодуляЯдро()
	
	Результат = Новый_ОписаниеОбработки();
	Результат.ПутьКФайлу = ПутьКФайлуМодуляЯдро();
	Результат.ДвоичныеДанные = ДвоичныеДанныеМодуляЯдро();
	Результат.ИмяОбработки = ИмяОбработкиПоИмениФайла(ИмяФайлаМодуляЯдро());
	
	Возврат Результат;
	
КонецФункции

Функция ПутьКФайлуМодуляЯдро()
	
