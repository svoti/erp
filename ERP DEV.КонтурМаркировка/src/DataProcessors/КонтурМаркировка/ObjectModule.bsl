КонецПроцедуры

Процедура НастроитьОтображениеСрокаТарифа(Форма, Организация) Экспорт
	
	ДатаОкончания = Тариф(Организация).ДатаОкончания;
	
	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Форма.Элементы.ГруппаИнформацияОТарифе.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Дней70 = 70;
	Дней40 = 40;
	ТекДата = НачалоДня(ТекущаяДатаСеанса());
	ДнейДоОкончанияПодписки = (ДатаОкончания - ТекДата) / СекундВСутках();
	
	Если ТекДата > ДатаОкончания Тогда
		ТекстЗаголовка = НСтр("ru = 'Срок действия тарифа истек'");
	Иначе
		ТекстЗаголовка = ПараметрыВСтроку(НСтр("ru = 'Оплачен до %1'"), Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Если ДнейДоОкончанияПодписки > Дней70 Тогда
		ЦветТекста = WebЦвета.Зеленый;
	ИначеЕсли ДнейДоОкончанияПодписки > Дней40 Тогда
		ЦветТекста = WebЦвета.Оранжевый;
	Иначе
		ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	
	Форма.Элементы.ГруппаИнформацияОТарифе.Видимость = Истина;
	Форма.Элементы.СрокДействияТарифа.Заголовок = ТекстЗаголовка;
	Форма.Элементы.СрокДействияТарифа.ЦветТекста = ЦветТекста;
	
КонецПроцедуры

Процедура НастроитьСсылкуТребуетсяПодписать(Элемент, КоличествоОперацийТребуетсяПодписать) Экспорт
	
	Если ЗначениеЗаполнено(КоличествоОперацийТребуетсяПодписать) Тогда
		ШаблонСтроки = НСтр("ru = 'Требуется подписать (%1)'");
		Элемент.Заголовок = ПараметрыВСтроку(ШаблонСтроки, КоличествоОперацийТребуетсяПодписать);
		Элемент.Видимость = Истина;
	Иначе
		Элемент.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура НастроитьСсылкуДатаПоследнегоОбмена(Элемент, Организация = Неопределено) Экспорт
	
	ТекущаяДата = ТекущаяДатаСеанса();
	ДатаПоследнегоОбмена = ДатаПоследнегоОбмена(Организация);
	
	Если ЗначениеЗаполнено(ДатаПоследнегоОбмена) Тогда
		
		ДатаПоследнегоОбмена = МестноеВремя(ДатаПоследнегоОбмена);
		
		МинутВЧасе = 60;
		СекундВЧасе = 3600;
		ПрошлоМинут = Цел((ТекущаяДата - ДатаПоследнегоОбмена) / МинутВЧасе);
		ПрошлоЧасов = Цел((ТекущаяДата - ДатаПоследнегоОбмена) / СекундВЧасе);
		
		Если НачалоДня(ДатаПоследнегоОбмена) < НачалоДня(ТекущаяДата) Тогда
			
			ДатаСтрокой = Строка(ДатаПоследнегоОбмена);
			
		ИначеЕсли ЗначениеЗаполнено(ПрошлоЧасов) Или ЗначениеЗаполнено(ПрошлоМинут) Тогда
			
			Если ЗначениеЗаполнено(ПрошлоЧасов) Тогда
				ПараметрыИсчисления = "час, часа, часов, м,,,,, 0";
				ДатаСтрокой = ЧислоСЕдиницейИзмерения(ПрошлоЧасов, ПараметрыИсчисления);
			Иначе
				ПараметрыИсчисления = "минута, минуты, минут, ж,,,,, 0";
				ДатаСтрокой = ЧислоСЕдиницейИзмерения(ПрошлоМинут, ПараметрыИсчисления);
			КонецЕсли;
			
			ДатаСтрокой = ДатаСтрокой + " " + НСтр("ru = 'назад'");
			
		Иначе
			ДатаСтрокой = НСтр("ru = 'только что'");
		КонецЕсли;
		
	Иначе
		ДатаСтрокой = НСтр("ru = 'никогда'");
	КонецЕсли;
	
	ТекстДатаОбмена = НСтр("ru = 'Обмен с сервисом: %1'");
	ТекстДатаОбмена = ПараметрыВСтроку(ТекстДатаОбмена, ДатаСтрокой);
	
	Элемент.Заголовок = ТекстДатаОбмена;
	
КонецПроцедуры

