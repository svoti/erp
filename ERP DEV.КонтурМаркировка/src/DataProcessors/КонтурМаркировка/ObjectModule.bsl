	|	ТоварыДокумента.ОтражениеВЭДО
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ТаблицаОСУДо.КоличествоКИ) - СУММА(ТоварыМаркировки.КоличествоУпаковок) > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументУчета,
	|	КлючНоменклатуры1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаОСУДо");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПустойКлюч", ПустойУникальныйИдентификатор());
