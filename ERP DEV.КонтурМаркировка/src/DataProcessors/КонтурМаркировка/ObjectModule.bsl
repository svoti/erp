// Возвращает описания всех библиотек конфигурации, включая описание самой конфигурации
// 
// Возвращаемое значение:
//  Соответствие:
//   * Ключ - Строка - имя подсистемы, например, "СтандартныеПодсистемы";
//   * Значение - Структура - описание подсистемы:
//     ** Имя - Строка - имя подсистемы;
//     ** Версия - Строка - версия подсистемы;
//     ** ЭтоКонфигурация - Булево - Истина, если данная подсистема является основной конфигурацией;
//     ** ИдентификаторИнтернетПоддержки - Строка - уникальное имя программы в сервисах интернет-поддержки;
//
Функция ОписанияПодсистемКонфигурации()
	
	КлючКэш = "ОписанияПодсистемКонфигурации";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Используем служебный интерфейс БСП, т.к. метод ОписанияПодсистем добавлен в
	// программный интерфейс модуля ОбщегоНазначения только в версии БСП 3.0.2 и выше
	Если ЕстьНеобходимыеМетаданные("ОбщийМодуль.СтандартныеПодсистемыПовтИсп") Тогда
		ОбщийМодульСтандартныеПодсистемы = ОбщийМодуль("СтандартныеПодсистемыПовтИсп");
		Результат = ОбщийМодульСтандартныеПодсистемы.ОписанияПодсистем().ПоИменам;
	Иначе
		Результат = Новый Соответствие;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияТорговойПодсистемы()
	
	КлючКэш = "ВерсияТорговойПодсистемы";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	МаркерыКонфигураций = Перечисление_МаркерыКонфигураций();
	МаркерКонфигурации = Интеграция_МаркерКонфигурации();
	Результат = "";
	
	Если МаркерКонфигурации = МаркерыКонфигураций.УТ11 Тогда
		
		ИмяПодсистемы = "УправлениеТорговлей";
		Если ОбщийМодуль("СтандартныеПодсистемыСервер").ЭтоБазоваяВерсияКонфигурации() Тогда
			ИмяПодсистемы = ИмяПодсистемы + "Базовая";
		КонецЕсли;
		
		Результат = ОписанияПодсистемКонфигурации().Получить(ИмяПодсистемы).Версия;
		
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыТекущейКонфигурации1С(ТекущееСемейство)
	
	КлючКэш = "ДокументыУчетаДляТекущейКонфигурации";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СемействаКонфигураций = Перечисление_СемействаКонфигураций();
	
	Результат = Новый Массив;
	
	Если ТекущееСемейство = СемействаКонфигураций.БП30 Тогда
		Результат.Добавить("РеализацияТоваровУслуг");
		Результат.Добавить("ВозвратТоваровПоставщику");
		Результат.Добавить("КорректировкаРеализации");
	ИначеЕсли ТекущееСемейство = СемействаКонфигураций.ERP Тогда
		Результат.Добавить("РеализацияТоваровУслуг");
		Результат.Добавить("КорректировкаРеализации");
		Результат.Добавить("ПередачаТоваровМеждуОрганизациями");
		Результат.Добавить("ВозвратТоваровМеждуОрганизациями");
		Результат.Добавить("ВозвратТоваровПоставщику");
		Результат.Добавить("АктОРасхожденияхПослеОтгрузки");
	ИначеЕсли ТекущееСемейство = СемействаКонфигураций.УНФ Тогда
		Результат.Добавить("РасходнаяНакладная");
		Результат.Добавить("ПередачаТоваровМеждуОрганизациями");
		Результат.Добавить("КорректировкаРеализации");
		Результат.Добавить("АктОРасхождениях");
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

