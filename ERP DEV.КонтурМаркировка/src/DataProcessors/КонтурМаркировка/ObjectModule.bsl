Функция ВключенРежимТехническогоСпециалиста() Экспорт
	
	Ключ = КлючКэшРежимТехническогоСпециалиста();
	Результат = ХранилищеНастроекДанныхФорм.Загрузить(Ключ);
	
	Если Результат = Истина Тогда
		Возврат Результат;
	Иначе
		
		Результат = ПараметрыСессии_Прочитать(Ключ);
		
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ИзменитьРежимТехническогоСпециалиста(НовыйСтатусРежима = Ложь) Экспорт
	
