Функция ПараметрыМетодаРегламентногоЗадания(ОписаниеЗадания, ПараметрыКоманды, ОписаниеОбработки = Неопределено)
	
	МетаданныеЗадания = МетаданныеРегламентногоЗадания(ОписаниеЗадания);
	
	Результат = Новый Массив;
	Настройки = НастройкиВыполненияРегламентныхЗаданий();
	
	Если Настройки.ИспользоватьБСП Тогда
		
		// БСП
		Результат.Добавить(Настройки.ВнешняяОбработка);
		Результат.Добавить(ПараметрыКоманды.ИдентификаторКоманды);
		
	ИначеЕсли МетаданныеЗадания = Метаданные.РегламентныеЗадания.КонтурМаркировка_ВыполнениеЗаданий Тогда
		
		АдресРезультата = "";
		Результат.Добавить(ПараметрыКоманды);
		Результат.Добавить(ОписаниеОбработки);
		Результат.Добавить(АдресРезультата);
		
	ИначеЕсли МетаданныеЗадания = Метаданные.РегламентныеЗадания.КонтурМаркировка_РегламентныеДействия Тогда
		
		Результат.Добавить(ПараметрыКоманды);
		Результат.Добавить(ОписаниеОбработки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыМетодаФоновогоЗадания(ПараметрыКоманды, ОписаниеОбработки = Неопределено, АдресРезультата = "")
	
	Результат = Новый Массив;
	
	Настройки = НастройкиВыполненияРегламентныхЗаданий();
	
	Если Настройки.ИспользоватьБСП Тогда
		
		ПараметрыКоманды.Вставить("ДополнительнаяОбработкаСсылка", Настройки.ВнешняяОбработка);
		
		Результат.Добавить(ПараметрыКоманды);
		
	Иначе
		Результат.Добавить(ПараметрыКоманды);
		Результат.Добавить(ОписаниеОбработки);
		Результат.Добавить(АдресРезультата);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

