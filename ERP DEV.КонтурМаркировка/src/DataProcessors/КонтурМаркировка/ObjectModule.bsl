// Записывает в базу все связи товаров маркировки с номенклтурой 1С
//
// Параметры:
//  ТаблицаНоменклатуры - ТаблицаЗначений - см. функцию Новый_ТаблицаНоменклатуры()
//
Процедура СвязиНоменклатуры_Записать(ТаблицаНоменклатуры) Экспорт
	
	Для каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаНоменклатуры, "Товар") Цикл
		
		Товар = ЧастьТаблицы.Товар;
		Набор = РегистрыСведений.КонтурМаркировка_СвязиНоменклатуры1С.СоздатьНаборЗаписей();
		Набор.Отбор.Товар.Установить(Товар);
		
		Для каждого Стр Из ЧастьТаблицы.МассивСтрок Цикл
			
			Если ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
				КлючНоменклатуры1С = Стр.КлючНоменклатуры1С;
			Иначе
				КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
				Запись = Набор.Добавить();
				Запись.Товар = Товар;
				Запись.КлючНоменклатуры1С = КлючНоменклатуры1С;
			КонецЕсли;
			
		КонецЦикла;
		
		Набор.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в базу связь товара с номенклтурой 1С
//
// Параметры:
//  Товар - Справчник.КонтурМаркировка_Товары - товар;
//  КлючНоменклатуры1С - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С - Ключ номенклатуры 1С;
//
Процедура СвязьНоменклатуры_Добавить(Товар, КлючНоменклатуры1С) Экспорт
	
	Если СвязьНоменклатуры_ЕстьСвязь(Товар, КлючНоменклатуры1С) Тогда
		Возврат;
	КонецЕсли;
	
	Запись = РегистрыСведений.КонтурМаркировка_СвязиНоменклатуры1С.СоздатьМенеджерЗаписи();
	Запись.Товар = Товар;
	Запись.КлючНоменклатуры1С = КлючНоменклатуры1С;
	
	Запись.Записать();
	
КонецПроцедуры

// Проверяет есть ли связь между аналитикой номенклатуры 1С и товаром маркировки
//
// Параметры:
//  Товар - Справчник.КонтурМаркировка_Товары - товар маркировки;
