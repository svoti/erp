Процедура ДокументУчета_ЗаполнитьТоварыДокументаИзДокумента1С(ОписаниеДокумента, РеквизитыДокумента1С)
	
	ОписаниеДокумента.ТоварыДокумента.Очистить();
	
	НомерСтроки = 0;
	КоличествоСтрок = РеквизитыДокумента1С.Товары.Количество();
	
	Для Сч = 1 По КоличествоСтрок Цикл
		
		Стр = РеквизитыДокумента1С.Товары[Сч - 1];
		
		НоваяСтрока = ОписаниеДокумента.ТоварыДокумента.Добавить();
		НоваяСтрока.НомерСтроки = Сч;
		НоваяСтрока.НомерСтрокиДокумента = Стр.НомерСтрокиДокумента;
		НоваяСтрока.Цена = Стр.Цена;
		НоваяСтрока.Номенклатура = Стр.Номенклатура;
		НоваяСтрока.Характеристика = Стр.Характеристика;
		НоваяСтрока.Упаковка = Стр.Упаковка;
		НоваяСтрока.Серия = Стр.Серия;
		НоваяСтрока.КлючСтрокиДокумента = Новый УникальныйИдентификатор;
		НоваяСтрока.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр);
		
		Если ЗначениеЗаполнено(Стр.Количество) Тогда
			НоваяСтрока.Количество = Стр.Количество;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КоличествоУпаковок) Тогда
			НоваяСтрока.КоличествоУпаковок = Стр.КоличествоУпаковок;
		КонецЕсли;
		
		ДокументУчета_ЗаполнитьПредставлениеСтроки(НоваяСтрока, КоличествоСтрок);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьИсправляемыйДокумент(ОписаниеДокумента, РеквизитыДокумента1С)
	
	ОписаниеДокумента.ДопРеквизиты.ИсправляемыйДокумент = Неопределено;
	
	ВидКорректировки = ОписаниеДокумента.ДопРеквизиты.ВидКорректировки;
	
	Если Не ЗначениеЗаполнено(ВидКорректировки)
		Или Не ЗначениеЗаполнено(РеквизитыДокумента1С.ДокументОснование)
		Или Не ДокументУчета_ЕстьРольКорректировкаОтгрузки(ОписаниеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ИменаДопРеквизитов = Перечисление_ИменаДопРеквизитов();
	ВидыКорректировки = Перечисление_ВидыКорректировкиДокумента();
	ЭтоИсправление = (ВидКорректировки = ВидыКорректировки.Исправление);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДокументыУчета.Дата КАК Дата,
	|	ДокументыУчета.Ссылка КАК ДокументУчета,
	|	ДокументыУчета.КлючДокумента1С КАК КлючДокумента1С,
	|	ДокументыУчета.ТипКлючаДокумента1С КАК ТипКлючаДокумента1С
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДокументыОснования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ПО ДокументыОснования.Объект = ДокументыУчета.Ссылка
	|			И ДокументыУчета.Ссылка <> &ДокументУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ВидКорректировки
	|		ПО ДокументыОснования.Объект = ВидКорректировки.Объект
	|			И (ВидКорректировки.ИмяРеквизита = &РеквизитВидКорректировки)
	|			И &ЭтоИсправление
	|ГДЕ
	|	ДокументыОснования.ИмяРеквизита = &РеквизитДокументОснование
	|	И ДокументыОснования.ЗначениеКлюч = &КлючОснования
	|	И ДокументыОснования.ТипКлючаЗначения = &ТипКлючаОснования
	|	И ДокументыУчета.Дата < &ДатаДокумента
	|	И &ФильтрВидКорректировки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Если ЭтоИсправление Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФильтрВидКорректировки", "ЕСТЬNULL(ВидКорректировки.Значение, """") <> &Исправление");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФильтрВидКорректировки", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ЭтоИсправление", ЭтоИсправление);
	Запрос.УстановитьПараметр("ДокументУчета", ОписаниеДокумента.Ссылка);
	Запрос.УстановитьПараметр("ДатаДокумента", РеквизитыДокумента1С.Дата);
	Запрос.УстановитьПараметр("КлючОснования", КлючОбъекта1С(РеквизитыДокумента1С.ДокументОснование));
	Запрос.УстановитьПараметр("ТипКлючаОснования", ТипКлючаОбъекта1С(РеквизитыДокумента1С.ДокументОснование));
	Запрос.УстановитьПараметр("РеквизитДокументОснование", ИменаДопРеквизитов.ДокументОснование);
	Запрос.УстановитьПараметр("РеквизитВидКорректировки", ИменаДопРеквизитов.ВидКорректировки);
	Запрос.УстановитьПараметр("Исправление", ВидыКорректировки.Исправление);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекДок = МодульОбщегоНазначения().СсылкаПоИдентификатору(Выборка.КлючДокумента1С, Выборка.ТипКлючаДокумента1С);
		Если ЗначениеРеквизитаОбъектаЛок(ТекДок, "Проведен") = Истина Тогда
			ОписаниеДокумента.ДопРеквизиты.ИсправляемыйДокумент = ТекДок;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеДокумента.ДопРеквизиты.ИсправляемыйДокумент = РеквизитыДокумента1С.ДокументОснование;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьСвойствоНеПодлежитМаркировке(ОписаниеДокумента)
	
	МассивНоменклатуры = ОписаниеДокумента.ТоварыДокумента.ВыгрузитьКолонку("Номенклатура");
	НоменклатураНеПодлежитМаркировке = Номенклатура1С_ПроверитьНеПодлежитМаркировке(МассивНоменклатуры);
	
	Для Каждого Стр Из ОписаниеДокумента.ТоварыДокумента Цикл
		Стр.НеПодлежитМаркировке = НоменклатураНеПодлежитМаркировке.Найти(Стр.Номенклатура) <> Неопределено;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_РассчитатьКоличествоУпаковок(ОписаниеДокумента)
	
	Настройки = НастройкиМодуля();
	КэшКоэффициентов = Новый Соответствие;
	КэшКлючейНоменклатуры = Новый Соответствие;
	
	Для Каждого Стр Из ОписаниеДокумента.ТоварыДокумента Цикл
		
		Если ЗначениеЗаполнено(Стр.КоличествоУпаковок) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Настройки.ИспользоватьКоэффициентыПересчета Тогда
			Если Не ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
				Стр.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр, КэшКлючейНоменклатуры);
			КонецЕсли;
			Коэффициент = КоэффициентПересчета(Стр.КлючНоменклатуры1С, КэшКоэффициентов);
			Стр.Коэффициент = Коэффициент.Числитель / Коэффициент.Знаменатель;
			Стр.КоличествоУпаковок = Стр.Количество * Коэффициент.Числитель / Коэффициент.Знаменатель;
		Иначе
			Стр.КоличествоУпаковок = Стр.Количество;
		КонецЕсли;
		
		ДокументУчета_ОкруглитьКоличествоУпаковокВСтрокеТовара(Стр, Настройки.РежимОкругленияПоУмолчанию);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ОкруглитьКоличествоУпаковокВСтрокеТовара(СтрокаТовара, РежимОкругленияУпаковок)
	
	РежимыОкругления = Перечисление_РежимыОкругления();
	ЦелаяЧасть = Цел(СтрокаТовара.КоличествоУпаковок);
	
	Если СтрокаТовара.КоличествоУпаковок > ЦелаяЧасть Тогда
		
		Если Не ЗначениеЗаполнено(РежимОкругленияУпаковок)
			Или РежимОкругленияУпаковок = РежимыОкругления.Окр15как20 Тогда
			СтрокаТовара.КоличествоУпаковок = Окр(СтрокаТовара.КоличествоУпаковок, 0, РежимОкругления.Окр15как20);
		ИначеЕсли РежимОкругленияУпаковок = РежимыОкругления.Окр15как10 Тогда
			СтрокаТовара.КоличествоУпаковок = Окр(СтрокаТовара.КоличествоУпаковок, 0, РежимОкругления.Окр15как10);
		ИначеЕсли РежимОкругленияУпаковок = РежимыОкругления.Окр11как20 Тогда
			СтрокаТовара.КоличествоУпаковок = ЦелаяЧасть + 1;
		ИначеЕсли РежимОкругленияУпаковок = РежимыОкругления.Окр19как10 Тогда
			СтрокаТовара.КоличествоУпаковок = ЦелаяЧасть;
		Иначе
			ТекстОшибки = НСтр("ru = 'Неизвестный режим округления: %1'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, РежимОкругленияУпаковок);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДокументУчета_ПодобратьТоварыМаркировки(ОписаниеДокумента)
	
	Организация = ОписаниеДокумента.Организация;
	
	ОписаниеДокумента.ТоварыМаркировки.Очистить();
	
	ВызыватьИсключение = Ложь;
	ДокументУчета_ЗагрузитьТоварыИзНацКаталога(ОписаниеДокумента, ВызыватьИсключение);
	
	КэшТоваров = Новый Соответствие;
	
	Для Каждого СтрДок Из ОписаниеДокумента.ТоварыДокумента Цикл
		
		Если СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		МассивТоваров = ПодходящиеТоварыМаркировки(СтрДок.КлючНоменклатуры1С, Организация, КэшТоваров);
		Если Не ЗначениеЗаполнено(МассивТоваров) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнятьКоличество = (МассивТоваров.Количество() = 1);
		
		Для Каждого Товар Из МассивТоваров Цикл
			
			СтрТоваров = ОписаниеДокумента.ТоварыМаркировки.Добавить();
			СтрТоваров.Товар = Товар;
			СтрТоваров.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
			
			Если ЗаполнятьКоличество Тогда
				СтрТоваров.КоличествоУпаковок = СтрДок.КоличествоУпаковок;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ЗагрузитьТоварыИзНацКаталога(ОписаниеДокумента, ВызыватьИсключение = Истина)
	
	Организация = ОписаниеДокумента.Организация;
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого СтрДок Из ОписаниеДокумента.ТоварыДокумента Цикл
		
		Если СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		МассивТоваров = ПодходящиеТоварыМаркировки(СтрДок.КлючНоменклатуры1С, Организация);
		Если ЗначениеЗаполнено(МассивТоваров) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивНоменклатуры.Добавить(СтрДок.Номенклатура);
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МассивНоменклатуры) Тогда
		МассивGTIN = Номенклатура1С_МассивGTIN(МассивНоменклатуры, ВызыватьИсключение);
		Товары_СоздатьОбновитьПоИнформацииИзСервиса(МассивGTIN, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьТоварыДокументаПослеВызоваПМ(ОписаниеДокумента)
	
	КоличествоСтрок = ОписаниеДокумента.ТоварыДокумента.Количество();
	
	Для Каждого СтрДок Из ОписаниеДокумента.ТоварыДокумента Цикл
		
		Если Не ЗначениеЗаполнено(СтрДок.КлючНоменклатуры1С) Тогда
			СтрДок.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(СтрДок);
			ДокументУчета_ЗаполнитьПредставлениеСтроки(СтрДок, КоличествоСтрок);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрДок.КлючСтрокиДокумента) Тогда
			СтрДок.КлючСтрокиДокумента = Новый УникальныйИдентификатор;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

