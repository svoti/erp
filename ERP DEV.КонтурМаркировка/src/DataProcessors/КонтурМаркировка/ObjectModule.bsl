// Проверяет, что версия модуля в базе равна текущей версии модуля
// 
// Если это первый запуск модуля, то в базу будет записана текущая версия модуля
//
// Параметры:
//  ВызыватьИсключение - Булево - Истина, если необходимо вызвать исключение когда
//                                версия установелнного модуля больше текущей;
// 
// Возвращаемое значение:
//  Структура - см. функцию Новый_РезультатПроверкиУстановленнойВерсииМодуля();
//
Функция ПроверитьУстановленнуюВерсиюМодуля(ВызыватьИсключение = Ложь) Экспорт
	
	Результат = Новый_РезультатПроверкиУстановленнойВерсииМодуля();
	
	ТекущаяВерсияМодуля = ВерсияОбработки();
	ВерсияМодуляВБазе = УстановленнаяВерсияМодуля();
	РезультатСравнения = СравнитьВерсии(ВерсияМодуляВБазе, ТекущаяВерсияМодуля);
	РасположениеМодуля = РасположениеМодуля();
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	Если РасположениеМодуля = ВариантыРасположения.ВРасширении Тогда
		Результат.ПоказатьКнопкуПерезапуска = Истина;
	КонецЕсли;
	
	Если РезультатСравнения < 0 Тогда
		
		Результат.Успешно = Истина;
		Результат.ПереходНаНовуюВерсию = Истина;
		УстановленнаяВерсияМодуля_Записать(ТекущаяВерсияМодуля);
		
	ИначеЕсли РезультатСравнения > 0 Тогда
		
		Результат.ТекстСообщения = ТекстСообщенияПроверкиУстановленнойВерсииМодуля();
		
		Если ВызыватьИсключение Тогда
			
			Действие = НСтр("ru = 'Проверка установленной версии модуля'");
			
			ДопИнформация = Новый Структура;
			ДопИнформация.Вставить("ВерсияМодуляВБазе", ВерсияМодуляВБазе);
			ДопИнформация.Вставить("ТекущаяВерсияМодуля", ТекущаяВерсияМодуля);
			ОбработатьОшибку(Действие, Результат.ТекстСообщения, ДопИнформация);
			
			ВызватьИсключение Результат.ТекстСообщения;
			
		КонецЕсли;
		
	Иначе
		
		Результат.Успешно = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УстановленнаяВерсияМодуля()
	
	Возврат ВерсияВДопСправочнике(Перечисление_ИменаДопСправочников().УстановленнаяВерсияМодуля);
	
