	Результат.Вставить(ТипыОпераций.РегистрацияОдногоАгрегатаВГИС, "/aggregation/aggregate/");
	Результат.Вставить(ТипыОпераций.РегистрацияПакетаАгрегатов, "/aggregation/multiple-aggregation/");
	Результат.Вставить(ТипыОпераций.НаполнениеОдногоАгрегатаНаТСД, "/aggregation/aggregate/");
	Результат.Вставить(ТипыОпераций.НаполнениеПакетаАгрегатовНаТСД, "/aggregation/multiple-aggregation/");
	Результат.Вставить(ТипыОпераций.ВозвратВОборот, "/codes/reintroduction/");
	Результат.Вставить(ТипыОпераций.ВозвратВОборотНаТСД, "/codes/reintroduction/");
	Результат.Вставить(ТипыОпераций.РегистрацияСтрокиОтчетаОНанесении, "/codes/report/");
	Результат.Вставить(ТипыОпераций.РегистрацияСтрокиВводаВОборот, "/codes/introduction/");
	Результат.Вставить(ТипыОпераций.РегистрацияСтрокиНаборов, "/aggregation/sets-aggregation/");
	Результат.Вставить(ТипыОпераций.РегистрацияСтрокиПеремаркировки, "/codes/remarking/");
	Результат.Вставить(ТипыОпераций.РегистрацияСтрокиКИГУ, "/aggregation/km-aggregation/");
	
