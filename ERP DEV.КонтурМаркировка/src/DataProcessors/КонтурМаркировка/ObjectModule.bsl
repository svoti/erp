// #Область ПечатьЭтикеток

Процедура Этикетки_ЗаполнитьТабличныйДокумент(ПараметрыПечати)
	
	ТаблицаЭтикеток = ПараметрыПечати.ТаблицаЭтикеток;
	ТабличныйДокумент = ПараметрыПечати.ТабличныйДокумент;
	НастройкиШаблонов = ПараметрыПечати.НастройкиШаблонов;
	
	Если Не ЗначениеЗаполнено(ТаблицаЭтикеток) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТабличныйДокумент.РазмерСтраницы) Тогда
		Этикетки_ЗаполнитьРазмерыСтраницы(ПараметрыПечати);
	КонецЕсли;
	
	НачалоФормата = 1;
	ТекущийШаблон = Неопределено;
	
	ТабличныйДокумент.Очистить();
	
	Для Каждого Стр Из ТаблицаЭтикеток Цикл
		
		ШаблонЭтикетки = Стр.ШаблонЭтикетки;
		
		Если Не ЗначениеЗаполнено(ТекущийШаблон) Тогда
			ТекущийШаблон = ШаблонЭтикетки;
		КонецЕсли;
		
		НастройкиШаблона = НастройкиШаблонов[ШаблонЭтикетки];
		ПараметрыМакета = НастройкиШаблона.ПараметрыМакета;
		МакетЭтикетки = НастройкиШаблона.МакетЭтикетки;
		
		Если ТекущийШаблон <> ШаблонЭтикетки Тогда
			
			// Фиксируем формат этикеток по предыдущему шаблону
			ТабличныйДокумент.Область(НачалоФормата, , ТабличныйДокумент.ВысотаТаблицы).СоздатьФорматСтрок();
			
			// Запоминаем строку начала нового шаблона
			ТекущийШаблон = ШаблонЭтикетки;
			НачалоФормата = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			// Устанавливаем ширину колонок по новому шаблону
			Для НомерКолонки = 1 По МакетЭтикетки.ШиринаТаблицы Цикл
				Колонка = ТабличныйДокумент.Область(НачалоФормата, НомерКолонки, , НомерКолонки);
				Колонка.ШиринаКолонки = МакетЭтикетки.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки;
			КонецЦикла;
			
		КонецЕсли;
		
		Этикетки_ЗаполнитьЗначенияПараметровМакета(Стр, МакетЭтикетки, ПараметрыМакета, ПараметрыПечати);
		
		Если ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере Тогда
			Этикетки_ЗаполнитьКартинкиШтрихкодов(МакетЭтикетки, Стр);
		Иначе
			Этикетки_ДобавитьНомерЭтикеткиВКартинкиШтрихкодов(МакетЭтикетки, Стр.НомерЭтикеткиПоПорядку);
		КонецЕсли;
		
		Стр.Напечатан = Истина;
		
		ТабличныйДокумент.Вывести(МакетЭтикетки);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_ЗаполнитьЗначенияПараметровМакета(СтрокаЭтикетки, МакетЭтикетки, ПараметрыМакета, ПараметрыПечати)
	
	ЗначенияПараметров = Новый Структура;
	
	Для Каждого Параметр Из ПараметрыМакета Цикл
		ЗначениеПараметра = Этикетки_ЗначениеПараметраЭтикетки(СтрокаЭтикетки, Параметр, ПараметрыПечати);
		ЗначенияПараметров.Вставить(Параметр.Имя, ЗначениеПараметра);
	КонецЦикла;
	
	МакетЭтикетки.Параметры.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры

Функция Этикетки_ЗначениеПараметраЭтикетки(СтрокаЭтикетки, ПараметрМакета, ПараметрыПечати)
	
	ИмяПараметра = ПараметрМакета.Имя;
	Результат = МодульОбщегоНазначения().СвойствоОбъекта(СтрокаЭтикетки, ИмяПараметра);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = МодульОбщегоНазначения().СвойствоОбъекта(ПараметрыПечати, ИмяПараметра);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ИмяПараметра = "ТекущаяДата" Тогда
		Результат = Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
		Возврат Результат;
	КонецЕсли;
	Если ИмяПараметра = "ТекущаяДатаВремя" Тогда
		Результат = Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'");
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрМакета.Формула) Тогда
		
		Результат = Печать_ЗначениеДопПараметра(ПараметрМакета, СтрокаЭтикетки, ПараметрыПечати);
		
	Иначе
		
		КэшЗначенийПараметра = ПараметрыПечати.КэшДопПараметровПМ[ИмяПараметра];
		Если КэшЗначенийПараметра = Неопределено Тогда
			КэшЗначенийПараметра = Новый Соответствие;
			ПараметрыПечати.КэшДопПараметровПМ.Вставить(ИмяПараметра, КэшЗначенийПараметра);
		КонецЕсли;
		
		ПараметрыПМ = Новый Структура;
		ПараметрыПМ.Вставить("ИмяПараметра", ИмяПараметра);
		ПараметрыПМ.Вставить("ЗначениеПараметра", Неопределено);
		ПараметрыПМ.Вставить("КэшЗначенийПараметра", КэшЗначенийПараметра);
		ПараметрыПМ.Вставить("Документ1С", ПараметрыПечати.Документ1С);
		ПараметрыПМ.Вставить("Организация1С", ПараметрыПечати.Организация1С);
		ПараметрыПМ.Вставить("ОперацияПечати", ПараметрыПечати.Операция);
		ПараметрыПМ.Вставить("СтрокаЭтикетки", СтрокаЭтикетки);
		ПМ_ОбработатьСобытие_ПриЗаполненииДополнительногоПараметраЭтикетки(ПараметрыПМ);
		
		Результат = ПараметрыПМ.ЗначениеПараметра;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Этикетки_ДобавитьНомерЭтикеткиВКартинкиШтрихкодов(МакетЭтикетки, НомерЭтикетки)
	
	ИменаКартинок = Перечисление_ИменаКартинокШтрихкодов();
	
	ПрефиксНомера = "_Этикетка";
	ПрефиксДубликата = "_Дубликат";
	СтрокаЭтикетка = ПрефиксНомера + Формат(НомерЭтикетки, "ЧГ=0");
	
	Для Каждого Рисунок Из МакетЭтикетки.Рисунки Цикл
		
		Для каждого Элемент Из ИменаКартинок Цикл
			
			ИмяКартинки = Элемент.Значение;
			Если Найти(Рисунок.Имя, ИмяКартинки) <> 1 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаДубликат = "";
			НачалоНомераЭтикетки = Найти(Рисунок.Имя, ПрефиксНомера);
			НачалоНомераДубликата = Найти(Рисунок.Имя, ПрефиксДубликата);
			Если НачалоНомераДубликата > 0 Тогда
				СтрокаДубликат = Сред(Рисунок.Имя, НачалоНомераДубликата, НачалоНомераЭтикетки - НачалоНомераДубликата);
			КонецЕсли;
			
			Рисунок.Имя = ИмяКартинки + СтрокаДубликат + СтрокаЭтикетка;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_ОчиститьКартинкиШтрихкодов(НастройкиШаблона)
	
	МакетЭтикетки = НастройкиШаблона.МакетЭтикетки;
	ИменаКартинок = Перечисление_ИменаКартинокШтрихкодов();
	
	Для Каждого Рисунок Из МакетЭтикетки.Рисунки Цикл
		Если ИменаКартинок.Свойство(Рисунок.Имя) Тогда
			Рисунок.Картинка = Новый Картинка;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_РасчитатьРазмерыКартинокВПикселях(НастройкиШаблона)
	
	МакетЭтикетки = НастройкиШаблона.МакетЭтикетки;
	РазмерыКартинок = НастройкиШаблона.РазмерыКартинок;
	ИменаКартинок = Перечисление_ИменаКартинокШтрихкодов();
	
	Этикетки_РасчитатьРазмерыКартинкиВПикселях(ИменаКартинок.GTIN, РазмерыКартинок.GTIN, МакетЭтикетки);
	Этикетки_РасчитатьРазмерыКартинкиВПикселях(ИменаКартинок.Агрегат, РазмерыКартинок.Агрегат, МакетЭтикетки);
	Этикетки_РасчитатьРазмерыКартинкиВПикселях(ИменаКартинок.DataMatrix, РазмерыКартинок.DataMatrix, МакетЭтикетки);
	
КонецПроцедуры

Процедура Этикетки_РасчитатьРазмерыКартинкиВПикселях(ИмяКартинки, РазмерыКартинки, Макет)
	
	КоличествоМиллиметровВПикселе = КоличествоМиллиметровВПикселе();
	
	Для Каждого Рисунок ИЗ Макет.Рисунки Цикл
		Если Рисунок.Имя = ИмяКартинки Тогда
			РазмерыКартинки.Ширина = Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе);
			РазмерыКартинки.Высота = Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_ПодогнатьРазмерыКартинокДоМинимальнойШирины(НастройкиШаблона)
	
	// Плагин не может напечатать EAN13 шириной меньше 110 пикселей
	МинимальнаяШирина = 110;
	РазмерыКартинки = НастройкиШаблона.РазмерыКартинок.GTIN;
	ПараметрыШтрихкода = НастройкиШаблона.ПараметрыШтрихкодов.GTIN;
	Этикетки_ПодогнатьРазмерыКартинкиДоМинимальнойШирины(РазмерыКартинки, ПараметрыШтрихкода, МинимальнаяШирина);
	
	// Плагин не может напечатать штрихкод агрегата шириной меньше 160 пикселей
	МинимальнаяШирина = 160;
	РазмерыКартинки = НастройкиШаблона.РазмерыКартинок.Агрегат;
	ПараметрыШтрихкода = НастройкиШаблона.ПараметрыШтрихкодов.Агрегат;
	Этикетки_ПодогнатьРазмерыКартинкиДоМинимальнойШирины(РазмерыКартинки, ПараметрыШтрихкода, МинимальнаяШирина);
	
	// DataMatrix должен быть квадратный
	РазмерыКартинки = НастройкиШаблона.РазмерыКартинок.DataMatrix;
	ПараметрыШтрихкода = НастройкиШаблона.ПараметрыШтрихкодов.DataMatrix;
	Этикетки_ПодогнатьРазмерыКартинкиДоРавныхСторон(РазмерыКартинки, ПараметрыШтрихкода, МинимальнаяШирина);
	
КонецПроцедуры

Процедура Этикетки_ПодогнатьРазмерыКартинкиДоМинимальнойШирины(РазмерыКартинки, ПараметрыШтрихкода, МинимальнаяШирина)
	
	Если РазмерыКартинки.Ширина = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыШтрихкода.УголПоворота = 0
		Или ПараметрыШтрихкода.УголПоворота = 180 Тогда
		ШиринаКартинки = РазмерыКартинки.Ширина;
	Иначе
		ШиринаКартинки = РазмерыКартинки.Высота;
	КонецЕсли;
	
	Если ШиринаКартинки < МинимальнаяШирина Тогда
		Коэф = (МинимальнаяШирина - ШиринаКартинки) / ШиринаКартинки;
		РазмерыКартинки.Ширина = РазмерыКартинки.Ширина + Окр(РазмерыКартинки.Ширина * Коэф);
		РазмерыКартинки.Высота = РазмерыКартинки.Высота + Окр(РазмерыКартинки.Высота * Коэф);
	КонецЕсли;
	
КонецПроцедуры

Процедура Этикетки_ПодогнатьРазмерыКартинкиДоРавныхСторон(РазмерыКартинки, ПараметрыШтрихкода, МинимальнаяШирина)
	
	Если РазмерыКартинки.Ширина = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МинимальныйРазмер = Мин(РазмерыКартинки.Ширина, РазмерыКартинки.Высота);
	РазмерыКартинки.Ширина = МинимальныйРазмер;
	РазмерыКартинки.Высота = МинимальныйРазмер;
	
КонецПроцедуры

Процедура Этикетки_ЗаполнитьКартинкиШтрихкодов(МакетЭтикетки, СтрокаЭтикетки)
	
	ИменаКартинок = Перечисление_ИменаКартинокШтрихкодов();
	
	Для Каждого Рисунок Из МакетЭтикетки.Рисунки Цикл
		Для каждого Элемент Из ИменаКартинок Цикл
			ИмяКартинки = Элемент.Значение;
			Если Найти(Рисунок.Имя, ИмяКартинки) = 1 Тогда
				Рисунок.Картинка = Новый Картинка(СтрокаЭтикетки[ИмяКартинки]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_СформироватьТаблицуЭтикеток(ПараметрыПечати) Экспорт
	
	Операция = ПараметрыПечати.Операция;
	Документ1С = ПараметрыПечати.Документ1С;
	ДокументУчета = ПараметрыПечати.ДокументУчета;
	Организация1С = ПараметрыПечати.Организация1С;
	ТаблицаЭтикеток = ПараметрыПечати.ТаблицаЭтикеток;
	ШаблоныЭтикеток = ПараметрыПечати.ШаблоныЭтикеток;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Этикетки_ДобавитьВТ_КодыДляПечати(МенеджерВТ, ПараметрыПечати);
	Этикетки_ДобавитьВТ_АналитикаНоменклатуры1С(МенеджерВТ);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыДляПечати.Уровень КАК Уровень,
	|	КодыДляПечати.КлючКода КАК КлючКода,
	|	КодыДляПечати.КлючАгрегата КАК КлючАгрегата,
	|	КодыДляПечати.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
	|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	КодыМаркировки.СерийныйНомер КАК СерийныйНомер,
	|	КодыМаркировки.Количество КАК Количество,
	|	КодыМаркировки.ЗаводскойСерийныйНомер КАК ЗаводскойСерийныйНомер,
	|	ИнформацияОКодах.ТипШтрихкода КАК ТипШтрихкода,
	|	ИнформацияОКодах.ОбщийТипУпаковки КАК ОбщийТипУпаковки,
	|	ИнформацияОКодах.Товар КАК Товар,
	|	ИнформацияОКодах.Товар.GTIN КАК GTIN,
	|	ИнформацияОКодах.Товар.НаименованиеТовара КАК НаименованиеТовара,
	|	ИнформацияОКодах.ВидАгрегата КАК ВидАгрегата,
	|	ИнформацияОКодах.ВидПродукции КАК ВидПродукции,
	|	ИнформацияОКодах.ДатаПроизводства КАК ДатаПроизводства,
	|	ИнформацияОКодах.ДатаСрокаГодности КАК ДатаСрокаГодности,
	|	ИнформацияОКодах.ИдентификаторВСД КАК ИдентификаторВСД,
	|	ИнформацияОКодах.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	АналитикаНоменклатуры1С.Номенклатура КАК Номенклатура,
	|	АналитикаНоменклатуры1С.Характеристика КАК Характеристика,
	|	АналитикаНоменклатуры1С.Серия КАК Серия,
	|	АналитикаНоменклатуры1С.Упаковка КАК Упаковка,
	|	АналитикаНоменклатуры1С.ПредставлениеНоменклатуры КАК ПредставлениеНоменклатуры
	|ИЗ
	|	КодыДляПечати КАК КодыДляПечати
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДляПечати.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ АналитикаНоменклатуры1С КАК АналитикаНоменклатуры1С
	|		ПО (ИнформацияОКодах.КлючНоменклатуры1С = АналитикаНоменклатуры1С.КлючНоменклатуры1С)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Уровень,
	|	&УсловиеСортировки";
	
	УсловиеСортировки = Этикетки_УсловиеСортировкиЗапроса(ПараметрыПечати);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСортировки", УсловиеСортировки);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ПустойКлючНоменклатуры1С", ПустойКлючНоменклатуры1С());
	ТаблицаКодов = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	ИндексКлючКода = Неопределено;
	Если ТаблицаКодов_ЕстьКлючиАгрегатов(ТаблицаКодов) Тогда
		ИндексКлючКода = ТаблицаЭтикеток.Индексы.Добавить("КлючКода");
	КонецЕсли;
	
	ДлинаКода18 = 18;
	ДлинаКода20 = 20;
	ЛидирующиеНули = "00";
	ДлинаЛидирующихНулей = СтрДлина(ЛидирующиеНули);
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		
		Если Не ЗначениеЗаполнено(СтрКода.ПолныйКод)
			И СтрКода.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix Тогда
			Продолжить;
		КонецЕсли;
		
		СтрАгрегата = Неопределено;
		Если ЗначениеЗаполнено(СтрКода.КлючАгрегата) Тогда
			СтрАгрегата = ТаблицаЭтикеток.Найти(СтрКода.КлючАгрегата, "КлючКода");
		КонецЕсли;
		Если СтрАгрегата = Неопределено Тогда
			Стр = ТаблицаЭтикеток.Добавить();
		Иначе
			Стр = ТаблицаЭтикеток.Вставить(ТаблицаЭтикеток.Индекс(СтрАгрегата));
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Стр, СтрКода);
		
		Стр.ТипЭтикетки = ТипЭтикеткиПоОбщемуТипуУпаковки(СтрКода.ОбщийТипУпаковки);
		Стр.ШаблонЭтикетки = ШаблонЭтикеткиПоТипуЭтикетки(ШаблоныЭтикеток, Стр.ТипЭтикетки);
		
		Стр.ДопСведения_ДатаПроизводства = Формат(СтрКода.ДатаПроизводства, "ДФ=dd.MM.yyyy");
		Стр.ДопСведения_ДатаСрокаГодности = Формат(СтрКода.ДатаСрокаГодности, "ДФ=dd.MM.yyyy");
		Стр.ДопСведения_ИдентификаторВСД = СтрКода.ИдентификаторВСД;
		Стр.ДопСведения_Количество = СтрКода.Количество;
		
		Если СтрКода.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix Тогда
			
			Стр.GTIN_Код = СтрКода.GTIN;
			Стр.GTIN_Штрихкод = ШтрихкодEANИзGTIN(СтрКода.GTIN);
			Стр.GTIN_НаименованиеТовара = СокрЛП(СтрКода.НаименованиеТовара);
			
			Стр.DataMatrix_Код = СтрКода.КодМаркировки;
			Стр.DataMatrix_Штрихкод = СтрКода.ПолныйКод;
			Стр.DataMatrix_СерийныйНомер = СтрКода.СерийныйНомер;
			Стр.DataMatrix_ЗаводскойСерийныйНомер = СтрКода.ЗаводскойСерийныйНомер;
			
		ИначеЕсли СтрКода.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.SSCC Тогда
			
			Если СтрДлина(СтрКода.КодМаркировки) = ДлинаКода20
				И Лев(СтрКода.КодМаркировки, ДлинаЛидирующихНулей) = ЛидирующиеНули Тогда
				КодАгрегата18 = Прав(СтрКода.КодМаркировки, ДлинаКода18);
			Иначе
				КодАгрегата18 = СтрКода.КодМаркировки;
			КонецЕсли;
			
			Стр.Агрегат_Код = "(00)" + Символы.НПП + КодАгрегата18;
			Стр.Агрегат_Штрихкод = ЛидирующиеНули + КодАгрегата18;
			Стр.Агрегат_ВидАгрегата = СтрКода.ВидАгрегата;
			
		ИначеЕсли СтрКода.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.Code128 Тогда
			
			Стр.Агрегат_Код = СтрКода.КодМаркировки;
			Стр.Агрегат_Штрихкод = СтрКода.КодМаркировки;
			Стр.Агрегат_ВидАгрегата = СтрКода.ВидАгрегата;
			
		ИначеЕсли СтрКода.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_128 Тогда
			
			Стр.Агрегат_Код = СтрКода.КодМаркировки;
			Стр.Агрегат_Штрихкод = СтрКода.ПолныйКод;
			Стр.Агрегат_ВидАгрегата = СтрКода.ВидАгрегата;
			
		Иначе
			
			ШаблонОшибки = НСтр("ru = 'Неизвестный тип штрихкода для печати этикетки: %1'");
			ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, СтрКода.ТипШтрихкода);
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИндексКлючКода <> Неопределено Тогда
		ТаблицаЭтикеток.Индексы.Удалить(ИндексКлючКода);
	КонецЕсли;
	
	НомераУпаковокПоПорядку = Новый Соответствие;
	НомерТоварнойЭтикеткиПоПорядку = 0;
	
	ИндексКлючАгрегата = ТаблицаЭтикеток.Индексы.Добавить("КлючАгрегата");
	
	Для Сч = 1 По ТаблицаЭтикеток.Количество() Цикл
		
		Стр = ТаблицаЭтикеток[Сч - 1];
		Стр.НомерЭтикеткиПоПорядку = Сч;
		
		Если Стр.ТипЭтикетки = Перечисления.КонтурМаркировка_ТипыЭтикеток.Товарная Тогда
			
			НомерТоварнойЭтикеткиПоПорядку = НомерТоварнойЭтикеткиПоПорядку + 1;
			Стр.НомерТоварнойЭтикеткиПоПорядку = НомерТоварнойЭтикеткиПоПорядку;
			
		Иначе
			
			Стр.НомерУпаковкиПоПорядку = ЗначениеСоответствия(НомераУпаковокПоПорядку, Стр.Уровень, 0) + 1;
			
			НомераУпаковокПоПорядку[Стр.Уровень] = Стр.НомерУпаковкиПоПорядку;
			
			Отбор = Новый Структура("КлючАгрегата", Стр.КлючКода);
			ВложенныеСтроки = ТаблицаЭтикеток.НайтиСтроки(Отбор);
			Для каждого Стр2 Из ВложенныеСтроки Цикл
				Стр2.НомерУпаковки = Стр.НомерУпаковкиПоПорядку;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаЭтикеток.Индексы.Удалить(ИндексКлючАгрегата);
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ1С", Документ1С);
	ПараметрыПМ.Вставить("Организация1С", Организация1С);
	ПараметрыПМ.Вставить("ОперацияПечати", Операция);
	ПараметрыПМ.Вставить("ТаблицаЭтикеток", ТаблицаЭтикеток);
	ПМ_ОбработатьСобытие_ПриФормированииСпискаЭтикетокДляПечати(ПараметрыПМ);
	ПараметрыПечати.ТаблицаЭтикеток = ПараметрыПМ.ТаблицаЭтикеток;
	
	Для Каждого Стр Из ТаблицаЭтикеток.НайтиСтроки(Новый Структура("ШаблонЭтикетки", ПустойШаблонЭтикетки())) Цикл
		ТаблицаЭтикеток.Удалить(Стр);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПараметрыПечати.КоличествоЭтикеток) Тогда
		Для Сч = -(ТаблицаЭтикеток.Количество() - 1) По - (ПараметрыПечати.КоличествоЭтикеток) Цикл
			ТаблицаЭтикеток.Удалить(-Сч);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Этикетки_ДобавитьВТ_КодыДляПечати(МенеджерВТ, ПараметрыПечати)
	
	Операция = ПараметрыПечати.Операция;
	ТаблицаКодов = ПараметрыПечати.ТаблицаКодов;
	ДокументУчета = ПараметрыПечати.ДокументУчета;
	
	Если ПараметрыПечати.ИспользоватьКодыОперации Тогда
		КодыОпераций_ВТ_Прочитать(Операция, МенеджерВТ);
	Иначе
		ПоместитьТаблицуВЗапрос(МенеджерВТ
		, ТаблицаКодов.Скопировать(, "КлючКода, КлючСтрокиДокумента")
		, "ТаблицаКодов", "КлючКода");
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТабКодов.КлючКода КАК КлючКода,
	|	КодыМаркировки.КлючАгрегата КАК КлючАгрегата,
	|	ЕСТЬNULL(ТоварыДокумента.НомерСтрокиДокумента, 0) КАК НомерСтрокиДокумента,
	|	ИнформацияОКодах.ОбщийТипУпаковки КАК ОбщийТипУпаковки
	|ПОМЕСТИТЬ Таб1
	|ИЗ
	|	ТаблицаКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабКодов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО ТабКодов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Уровень КАК Уровень,
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата,
	|	Т.НомерСтрокиДокумента КАК НомерСтрокиДокумента
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов";
	
	Уровень = 0;
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Уровень", Уровень);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	Если ПараметрыПечати.ПечататьВложенныеКоды Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	КодыМаркировки.КлючКода КАК КлючКода,
		|	КодыМаркировки.КлючАгрегата КАК КлючАгрегата,
		|	Таб.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
		|	ИнформацияОКодах.ОбщийТипУпаковки КАК ОбщийТипУпаковки
		|ПОМЕСТИТЬ Таб2
		|ИЗ
		|	Таб1 КАК Таб
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
		|		ПО Таб.КлючКода = КодыМаркировки.КлючАгрегата
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
		|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
		|ГДЕ
		|	Таб.ОбщийТипУпаковки <> ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючКода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.Уровень КАК Уровень,
		|	Т.КлючКода КАК КлючКода,
		|	Т.КлючАгрегата КАК КлючАгрегата,
		|	Т.НомерСтрокиДокумента КАК НомерСтрокиДокумента
		|ПОМЕСТИТЬ Итог2
		|ИЗ
		|	Итог1 КАК Т
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Уровень,
		|	Т.КлючКода,
		|	Т.КлючАгрегата,
		|	Т.НомерСтрокиДокумента
		|ИЗ
		|	Таб2 КАК Т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Таб1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Итог1";
		
		Пока Истина Цикл
			
			Уровень = Уровень + 1;
			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
			Запрос.УстановитьПараметр("Уровень", Уровень);
			Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
			Выборка.Следующий();
			Если Выборка.Количество = 0 Тогда
				Прервать;
			КонецЕсли;
			ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
			ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0 Тогда
		ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ КодыДляПечати ИЗ Итог1; УНИЧТОЖИТЬ Итог1; УНИЧТОЖИТЬ Таб1";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ КодыДляПечати ИЗ Итог2; УНИЧТОЖИТЬ Итог2; УНИЧТОЖИТЬ Таб2";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура Этикетки_ДобавитьВТ_АналитикаНоменклатуры1С(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИнформацияОКодах.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ИЗ
	|	КодыДляПечати КАК КодыДляПечати
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДляПечати.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	АналитикаНоменклатуры = Запрос.Выполнить().Выгрузить();
	
	ТипСтрока = ОписаниеТипа_Строка();
	ТипСправочники = Справочники.ТипВсеСсылки();
	
	АналитикаНоменклатуры.Колонки.Добавить("ПредставлениеНоменклатуры", ТипСтрока);
	
	АналитикаНоменклатуры.Колонки.Добавить("Номенклатура", ТипСправочники);
	АналитикаНоменклатуры.Колонки.Добавить("Характеристика", ТипСправочники);
	АналитикаНоменклатуры.Колонки.Добавить("Упаковка", ТипСправочники);
	АналитикаНоменклатуры.Колонки.Добавить("Серия", ТипСправочники);
	
	Для Каждого Стр Из АналитикаНоменклатуры Цикл
		
		Если ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
			ЗаполнитьЗначенияСвойств(Стр, АналитикаНоменклатуры1С(Стр.КлючНоменклатуры1С));
			Стр.ПредставлениеНоменклатуры = СокрЛП(Стр.Номенклатура);
		КонецЕсли;
		
	КонецЦикла;
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, АналитикаНоменклатуры, "АналитикаНоменклатуры1С", "КлючНоменклатуры1С");
	
КонецПроцедуры

Процедура Этикетки_СформироватьНастройкиШаблонов(ПараметрыПечати)
	
	ТаблицаЭтикеток = ПараметрыПечати.ТаблицаЭтикеток;
	НастройкиШаблонов = ПараметрыПечати.НастройкиШаблонов;
	
	Для каждого Стр Из ТаблицаЭтикеток Цикл
		
		ШаблонЭтикетки = Стр.ШаблонЭтикетки;
		
		Если НастройкиШаблонов[ШаблонЭтикетки] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкиШаблона = Новый_НастройкиШаблонаЭтикетки();
		НастройкиШаблонов.Вставить(ШаблонЭтикетки, НастройкиШаблона);
		
		ОписаниеШаблона = ШаблонЭтикетки_Прочитать(ШаблонЭтикетки);
		ЗаполнитьЗначенияСвойств(НастройкиШаблона, ОписаниеШаблона);
		Этикетки_ОчиститьКартинкиШтрихкодов(НастройкиШаблона);
		Этикетки_РасчитатьРазмерыКартинокВПикселях(НастройкиШаблона);
		Этикетки_ПодогнатьРазмерыКартинокДоМинимальнойШирины(НастройкиШаблона);
		
		Для Каждого Настройка Из ШаблонЭтикетки_НастройкиПараметров(ОписаниеШаблона.ТипЭтикетки) Цикл
			Если ОписаниеШаблона.ИспользуемыеПараметры.Найти(Настройка.Имя) <> Неопределено Тогда
				НастройкиШаблона.ПараметрыМакета.Добавить(Настройка);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_ЗаполнитьПараметрыНоменклатуры1С(ПараметрыПечати)
	
	МодульЯдро = МодульЯдро();
	КэшСтрНоменклатуры = Новый Соответствие;
	
	Для Каждого Стр Из ПараметрыПечати.ТаблицаЭтикеток Цикл
		
		Если Не ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		КлючКэш = МодульЯдро.СтрокаАналитикиНоменклатуры1С(Стр);
		СтрНоменклатуры = КэшСтрНоменклатуры[КлючКэш];
		Если СтрНоменклатуры <> Неопределено Тогда
			Стр.Номенклатура1С_Артикул = СтрНоменклатуры.Номенклатура1С_Артикул;
			Стр.Номенклатура1С_Представление = СтрНоменклатуры.Номенклатура1С_Представление;
			Стр.Номенклатура1С_ПолноеНаименование = СтрНоменклатуры.Номенклатура1С_ПолноеНаименование;
			Стр.Номенклатура1С_РабочееНаименование = СтрНоменклатуры.Номенклатура1С_РабочееНаименование;
			Стр.Номенклатура1С_НаименованиеХарактеристики = СтрНоменклатуры.Номенклатура1С_НаименованиеХарактеристики;
			Продолжить;
		КонецЕсли;
		
		Артикул = МодульЯдро.Интеграция_ПараметрыНоменклатуры1С(Стр).Артикул;
		ПолноеНаименование = МодульЯдро.ПолноеНаименованиеНоменклатуры1С(Стр.Номенклатура);
		НаименованиеХарактеристики = МодульЯдро.НаименованиеХарактеристики(Стр.Характеристика);
		
		Если ЗначениеЗаполнено(НаименованиеХарактеристики) Тогда
			Представление = ПараметрыВСтроку("%1 (%2)", ПолноеНаименование, НаименованиеХарактеристики);
		Иначе
			Представление = ПолноеНаименование;
		КонецЕсли;
		
		Стр.Номенклатура1С_Артикул = Артикул;
		Стр.Номенклатура1С_Представление = Представление;
		Стр.Номенклатура1С_ПолноеНаименование = ПолноеНаименование;
		Стр.Номенклатура1С_РабочееНаименование = СокрЛП(Стр.Номенклатура);
		Стр.Номенклатура1С_НаименованиеХарактеристики = НаименованиеХарактеристики;
		
		КэшСтрНоменклатуры.Вставить(КлючКэш, Стр);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_СформироватьКартинкиШтрихкодов(ПараметрыПечати)
	
	Если Не ПараметрыПечати.ЗаполнитьКартинкиШтрихкодовНаСервере Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЭтикеток = ПараметрыПечати.ТаблицаЭтикеток;
	ИндексШаблон = ТаблицаЭтикеток.Индексы.Добавить("ШаблонЭтикетки, ТипШтрихкода");
	
	Этикетки_СформироватьКартинкиGTIN(ПараметрыПечати);
	Этикетки_СформироватьКартинкиАгрегатов(ПараметрыПечати);
	Этикетки_СформироватьКартинкиDataMatrix(ПараметрыПечати);
	
	ТаблицаЭтикеток.Индексы.Удалить(ИндексШаблон);
	
КонецПроцедуры

Процедура Этикетки_СформироватьКартинкиGTIN(ПараметрыПечати)
	
	ТаблицаЭтикеток = ПараметрыПечати.ТаблицаЭтикеток;
	НастройкиШаблонов = ПараметрыПечати.НастройкиШаблонов;
	ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.EAN13;
	
	Для каждого Элемент Из НастройкиШаблонов Цикл
		
		ШаблонЭтикетки = Элемент.Ключ;
		НастройкиШаблона = Элемент.Значение;
		
		РазмерыКартинки = НастройкиШаблона.РазмерыКартинок.GTIN;
		ПараметрыШтрихкода = НастройкиШаблона.ПараметрыШтрихкодов.GTIN;
		
		Если РазмерыКартинки.Ширина = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("ШаблонЭтикетки", ШаблонЭтикетки);
		СтрокиЭтикеток = ТаблицаЭтикеток.НайтиСтроки(Отбор);
		
		Если Не ЗначениеЗаполнено(СтрокиЭтикеток) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыКартинки = Плагин_ПараметрыКартинкиШтрихкода(ТипШтрихкода);
		ЗаполнитьПоляСтруктуры(ПараметрыКартинки, ПараметрыШтрихкода);
		ЗаполнитьПоляСтруктуры(ПараметрыКартинки, РазмерыКартинки);
		
		МассивШтрихкодов = Новый Массив;
		Для Каждого Стр Из СтрокиЭтикеток Цикл
			Если ЗначениеЗаполнено(Стр.GTIN_Штрихкод)
				И МассивШтрихкодов.Найти(Стр.GTIN_Штрихкод) = Неопределено Тогда
				МассивШтрихкодов.Добавить(Стр.GTIN_Штрихкод);
			КонецЕсли;
		КонецЦикла;
		
		КартинкиШтрихкодов = Плагин_КартинкиШтрихкодов(МассивШтрихкодов, ПараметрыКартинки);
		
		Для Каждого Стр Из СтрокиЭтикеток Цикл
			ИндексКартинки = МассивШтрихкодов.Найти(Стр.GTIN_Штрихкод);
			Стр.GTIN_Картинка = КартинкиШтрихкодов[ИндексКартинки];
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_СформироватьКартинкиАгрегатов(ПараметрыПечати)
	
	ТаблицаЭтикеток = ПараметрыПечати.ТаблицаЭтикеток;
	НастройкиШаблонов = ПараметрыПечати.НастройкиШаблонов;
	ТипыШтрихкодов = Перечисления.КонтурМаркировка_ТипыШтрихкодов;
	
	НужныеТипыШтрихкодов = Новый Массив;
	НужныеТипыШтрихкодов.Добавить(ТипыШтрихкодов.SSCC);
	НужныеТипыШтрихкодов.Добавить(ТипыШтрихкодов.Code128);
	НужныеТипыШтрихкодов.Добавить(ТипыШтрихкодов.GS1_128);
	
	Для каждого Элемент Из НастройкиШаблонов Цикл
		
		ШаблонЭтикетки = Элемент.Ключ;
		НастройкиШаблона = Элемент.Значение;
		
		Для каждого ТипШтрихкода Из НужныеТипыШтрихкодов Цикл
			
			РазмерыКартинки = НастройкиШаблона.РазмерыКартинок.Агрегат;
			ПараметрыШтрихкода = НастройкиШаблона.ПараметрыШтрихкодов.Агрегат;
			
			Если РазмерыКартинки.Ширина = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Отбор = Новый Структура;
			Отбор.Вставить("ТипШтрихкода", ТипШтрихкода);
			Отбор.Вставить("ШаблонЭтикетки", ШаблонЭтикетки);
			СтрокиЭтикеток = ТаблицаЭтикеток.НайтиСтроки(Отбор);
			
			Если Не ЗначениеЗаполнено(СтрокиЭтикеток) Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыКартинки = Плагин_ПараметрыКартинкиШтрихкода(ТипШтрихкода);
			ЗаполнитьПоляСтруктуры(ПараметрыКартинки, ПараметрыШтрихкода);
			ЗаполнитьПоляСтруктуры(ПараметрыКартинки, РазмерыКартинки);
			ПараметрыКартинки.ПодогнатьРазмер = Истина;
			
			МассивШтрихкодов = Новый Массив;
			Для Каждого Стр Из СтрокиЭтикеток Цикл
				МассивШтрихкодов.Добавить(Стр.Агрегат_Штрихкод);
			КонецЦикла;
			
			КартинкиШтрихкодов = Плагин_КартинкиШтрихкодов(МассивШтрихкодов, ПараметрыКартинки);
			
			Для Индекс = 0 По СтрокиЭтикеток.ВГраница() Цикл
				СтрокиЭтикеток[Индекс].Агрегат_Картинка = КартинкиШтрихкодов[Индекс];
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_СформироватьКартинкиDataMatrix(ПараметрыПечати)
	
	ТаблицаЭтикеток = ПараметрыПечати.ТаблицаЭтикеток;
	НастройкиШаблонов = ПараметрыПечати.НастройкиШаблонов;
	ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix;
	
	Для каждого Элемент Из НастройкиШаблонов Цикл
		
		ШаблонЭтикетки = Элемент.Ключ;
		НастройкиШаблона = Элемент.Значение;
		
		РазмерыКартинки = НастройкиШаблона.РазмерыКартинок.DataMatrix;
		ПараметрыШтрихкода = НастройкиШаблона.ПараметрыШтрихкодов.DataMatrix;
		
		Если РазмерыКартинки.Ширина = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("ТипШтрихкода", ТипШтрихкода);
		Отбор.Вставить("ШаблонЭтикетки", ШаблонЭтикетки);
		СтрокиЭтикеток = ТаблицаЭтикеток.НайтиСтроки(Отбор);
		
		Если Не ЗначениеЗаполнено(СтрокиЭтикеток) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыКартинки = Плагин_ПараметрыКартинкиШтрихкода(ТипШтрихкода);
		ЗаполнитьПоляСтруктуры(ПараметрыКартинки, ПараметрыШтрихкода);
		ЗаполнитьПоляСтруктуры(ПараметрыКартинки, РазмерыКартинки);
		ПараметрыКартинки.ПодогнатьРазмер = Истина;
		
		МассивШтрихкодов = Новый Массив;
		Для Каждого Стр Из СтрокиЭтикеток Цикл
			МассивШтрихкодов.Добавить(Стр.DataMatrix_Штрихкод);
		КонецЦикла;
		
		КартинкиШтрихкодов = Плагин_КартинкиШтрихкодов(МассивШтрихкодов, ПараметрыКартинки);
		
		Для Индекс = 0 По СтрокиЭтикеток.ВГраница() Цикл
			СтрокиЭтикеток[Индекс].DataMatrix_Картинка = КартинкиШтрихкодов[Индекс];
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Этикетки_ЗаполнитьРазмерыСтраницы(ПараметрыПечати) Экспорт
	
	ВсеШаблоны = Этикетки_ВсеШаблоныЭтикеток(ПараметрыПечати);
	ШирокийШаблон = Этикетки_ШаблонСамойШирокойЭтикетки(ВсеШаблоны);
	ВысокийШаблон = Этикетки_ШаблонСамойВысокойЭтикетки(ВсеШаблоны);
	ТабличныйДокумент = ПараметрыПечати.ТабличныйДокумент;
	
	Если ЗначениеЗаполнено(ШирокийШаблон) Тогда
		
		МакетЭтикетки = ШаблонЭтикетки_Прочитать(ШирокийШаблон).МакетЭтикетки;
		ЗаполнитьЗначенияСвойств(ТабличныйДокумент, МакетЭтикетки);
		
		ТабличныйДокумент.ШиринаСтраницы = ШирокийШаблон.ШиринаСтраницы;
		ТабличныйДокумент.ВысотаСтраницы = ВысокийШаблон.ВысотаСтраницы;
		
	Иначе
		ТабличныйДокумент.ШиринаСтраницы = 0;
		ТабличныйДокумент.ВысотаСтраницы = 0;
	КонецЕсли;
	
КонецПроцедуры

Процедура Этикетки_ПометитьНапечатанныеКоды(ПараметрыПечати)
	
	Отбор = Новый Структура("Напечатан", Истина);
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Для Каждого Стр Из ПараметрыПечати.ТаблицаЭтикеток.НайтиСтроки(Отбор) Цикл
		ТаблицаКодов.Добавить().КлючКода = Стр.КлючКода;
	КонецЦикла;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов_ПометитьКодыНапечатанными(ТаблицаКодов);
	
КонецПроцедуры

Функция Этикетки_УсловиеСортировкиЗапроса(ПараметрыПечати)
	
	Результат = "НаименованиеТовара, КодМаркировки";
	
	ПараметрыСортировки = ПараметрыПечати.ПараметрыСортировки;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыСортировки.ПолеСортировкиЭтикеток1) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ШаблонСортировки = НСтр("ru='%1 %2'");
	СтрокиСортировки = Новый Массив;
	
	ВсегоПараметров = КоличествоПараметровСортировкиЭтикеток();
	Для Сч = 1 По ВсегоПараметров Цикл
		
		ПолеСортировкиЭтикеток = ПараметрыСортировки["ПолеСортировкиЭтикеток" + Сч];
		НаправлениеСортировкиЭтикеток = ПараметрыСортировки["НаправлениеСортировкиЭтикеток" + Сч];
		
		Если Не ЗначениеЗаполнено(ПолеСортировкиЭтикеток) Тогда
			Прервать;
		КонецЕсли;
		
		Поле = КлючиПеречисления_ПоляСортировкиЭтикеток().Получить(ПолеСортировкиЭтикеток);
		Направление = КлючиПеречисления_НаправленияСортировки().Получить(НаправлениеСортировкиЭтикеток);
		
		СтрокиСортировки.Добавить(ПараметрыВСтроку(ШаблонСортировки, Поле, Направление));
		
	КонецЦикла;
	
	Возврат СоединитьСтроку(СтрокиСортировки, ",");
	
КонецФункции

Функция Этикетки_ОписанияЭтикетокДляЗаполненияКартинокШтрихкодовНаКлиенте(ПараметрыПечати)
	
	Результат = Новый Массив;
	МодульЯдро = МодульЯдро();
	
	Для Каждого Стр Из ПараметрыПечати.ТаблицаЭтикеток Цикл
		
		Элемент = Новый_ОписаниеЭтикетки();
		Элемент.НомерЭтикетки = Стр.НомерЭтикеткиПоПорядку;
		Элемент.ШаблонЭтикетки = Стр.ШаблонЭтикетки;
		Элемент.ТипШтрихкода = Стр.ТипШтрихкода;
		Элемент.GTIN_Штрихкод = Стр.GTIN_Штрихкод;
		Элемент.Агрегат_Штрихкод = Стр.Агрегат_Штрихкод;
		Элемент.DataMatrix_Штрихкод = МодульЯдро.ЗаменитьРазделительGS1(Стр.DataMatrix_Штрихкод);
		
		Результат.Добавить(Элемент);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Этикетки_ПараметрыПечатиЭтикетокПоДокументу(ДокументУчета, Документ1С)
	
	Организация1С = Неопределено;
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Организация = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "Организация");
		Организация1С = Организация_Организация1С(Организация);
	КонецЕсли;
	
	Результат = Новый_ПараметрыПечатиЭтикеток();
	Результат.Документ1С = Документ1С;
	Результат.ДокументУчета = ДокументУчета;
	Результат.Организация1С = Организация1С;
	
	Если ЗначениеЗаполнено(Организация1С) Тогда
		Результат.Организация1С_СокращенноеНаименование = СокращенноеНаименованиеОрганизации1С(Организация1С);
		Результат.Организация1С_ПолноеНаименование = ПолноеНаименованиеОрганизации1С(Организация1С);
		Результат.Организация1С_РабочееНаименование = СокрЛП(Организация1С);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Документ1С) Тогда
		Реквизиты = ЗначенияРеквизитовОбъектаЛок(Документ1С, "Номер, Дата");
		Результат.Документ1С_Номер = Реквизиты.Номер;
		Результат.Документ1С_Дата = Формат(Реквизиты.Дата,"ДФ=dd.MM.yyyy");
		Результат.Документ1С_Представление = СокрЛП(Документ1С);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Этикетки_ЗаполнитьПараметрыПечатиПоУмолчанию(ПараметрыПечати)
	
	НастройкиМодуля = НастройкиМодуля();
	ЕстьНастройкиСортировки = ЗначениеЗаполнено(НастройкиМодуля.ПолеСортировкиЭтикеток1ПоУмолчанию);
	ПараметрыСортировки = ПараметрыПечати.ПараметрыСортировки;
	
	Если ЕстьНастройкиСортировки Тогда
		
		Для Сч = 1 По КоличествоПараметровСортировкиЭтикеток() Цикл
			
			КлючПолеСортировки = "ПолеСортировкиЭтикеток" + Сч;
			КлючНаправлениеСортировки = "НаправлениеСортировкиЭтикеток" + Сч;
			
			ПараметрыСортировки[КлючПолеСортировки] = НастройкиМодуля[КлючПолеСортировки + "ПоУмолчанию"];
			ПараметрыСортировки[КлючНаправлениеСортировки] = НастройкиМодуля[КлючНаправлениеСортировки + "ПоУмолчанию"];
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция Этикетки_ПараметрыПечатиЭтикетокПоОперации(Операция) Экспорт
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Организация1С = Организация_Организация1С(ОписаниеОперации.Организация);
	
	Документ1С = Неопределено;
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Документ1С = ДокументУчета_Документ1С(ДокументУчета);
	КонецЕсли;
	
	Результат = Новый_ПараметрыПечатиЭтикеток();
	Результат.Операция = Операция;
	Результат.Документ1С = Документ1С;
	Результат.Организация1С = Организация1С;
	Результат.ДокументУчета = ДокументУчета;
	
	Результат.ОперацияПечати_Номер = ОписаниеОперации.Номер;
	Результат.ДопПараметрПечати1 = ОписаниеОперации.ДопРеквизиты.ДопПараметрПечати1;
	Результат.ДопПараметрПечати2 = ОписаниеОперации.ДопРеквизиты.ДопПараметрПечати2;
	Результат.ДопПараметрПечати3 = ОписаниеОперации.ДопРеквизиты.ДопПараметрПечати3;
	
	Если ЗначениеЗаполнено(Организация1С) Тогда
		Результат.Организация1С_СокращенноеНаименование = СокращенноеНаименованиеОрганизации1С(Организация1С);
		Результат.Организация1С_ПолноеНаименование = ПолноеНаименованиеОрганизации1С(Организация1С);
		Результат.Организация1С_РабочееНаименование = СокрЛП(Организация1С);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Документ1С) Тогда
		Реквизиты = ЗначенияРеквизитовОбъектаЛок(Документ1С, "Номер, Дата");
		Результат.Документ1С_Номер = Реквизиты.Номер;
		Результат.Документ1С_Дата = Формат(Реквизиты.Дата,"ДФ=dd.MM.yyyy");
		Результат.Документ1С_Представление = СокрЛП(Документ1С);
	КонецЕсли;
	
	Если ОписаниеОперации.ДопРеквизиты.ПечататьТоварныеЭтикетки Тогда
		Результат.ШаблоныЭтикеток.ШаблонТоварнойЭтикетки = ОписаниеОперации.ДопРеквизиты.ШаблонТоварнойЭтикетки;
	КонецЕсли;
	Если ОписаниеОперации.ДопРеквизиты.ПечататьГрупповыеЭтикетки Тогда
		Результат.ШаблоныЭтикеток.ШаблонГрупповойЭтикетки = ОписаниеОперации.ДопРеквизиты.ШаблонГрупповойЭтикетки;
	КонецЕсли;
	Если ОписаниеОперации.ДопРеквизиты.ПечататьЭтикеткиНаборов Тогда
		Результат.ШаблоныЭтикеток.ШаблонЭтикеткиНабора = ОписаниеОперации.ДопРеквизиты.ШаблонЭтикеткиНабора;
	КонецЕсли;
	Если ОписаниеОперации.ДопРеквизиты.ПечататьТранспортныеЭтикетки Тогда
		Результат.ШаблоныЭтикеток.ШаблонТранспортнойЭтикетки = ОписаниеОперации.ДопРеквизиты.ШаблонТранспортнойЭтикетки;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Результат.ПараметрыСортировки, ОписаниеОперации.ДопРеквизиты);
	
	Возврат Результат;
	
КонецФункции

Функция Этикетки_РазмерЭталоннойЯчейкиВМиллиметрах() Экспорт
	
	Эталон = МакетОбработки("ЭталонРазмеровЯчеек");
	
	Картинка = Эталон.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	
	Картинка.Расположить(Эталон.Область("R1C1:R100C100"));
	ВысотаКартинкиВмм = Картинка.Высота;
	ШиринаКартинкиВмм = Картинка.Ширина;
	
	ВысотаЯчейки025мм = (ВысотаКартинкиВмм / 100);
	ШиринаЯчейки0125мм = (ШиринаКартинкиВмм / 100) / 4;
	
	Результат = Новый Структура;
	Результат.Вставить("ВысотаЯчейки025мм", ВысотаЯчейки025мм);
	Результат.Вставить("ШиринаЯчейки0125мм", ШиринаЯчейки0125мм);
	
	Возврат Результат;
	
КонецФункции

Функция Этикетки_ШаблонСамойШирокойЭтикетки(ШаблоныЭтикеток)
	
	Результат = Неопределено;
	МаксимальнаяШирина = -1;
	
	Для Каждого ШаблонЭтикетки Из ШаблоныЭтикеток Цикл
		МакетЭтикетки = ШаблонЭтикетки.МакетЭтикетки.Получить();
		Если МакетЭтикетки <> Неопределено
			И МакетЭтикетки.ШиринаСтраницы > МаксимальнаяШирина Тогда
			МаксимальнаяШирина = МакетЭтикетки.ШиринаСтраницы;
			Результат = ШаблонЭтикетки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Этикетки_ШаблонСамойВысокойЭтикетки(ШаблоныЭтикеток)
	
	Результат = Неопределено;
	МаксимальнаяВысота = -1;
	
	Для Каждого ШаблонЭтикетки Из ШаблоныЭтикеток Цикл
		МакетЭтикетки = ШаблонЭтикетки.МакетЭтикетки.Получить();
		Если МакетЭтикетки <> Неопределено
			И МакетЭтикетки.ВысотаСтраницы > МаксимальнаяВысота Тогда
			МаксимальнаяВысота = МакетЭтикетки.ВысотаСтраницы;
			Результат = ШаблонЭтикетки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Этикетки_ВсеШаблоныЭтикеток(ПараметрыПечати)
	
	Если ЗначениеЗаполнено(ПараметрыПечати.ТаблицаЭтикеток) Тогда
		
		Результат = ТаблицаЗначений_ВыгрузитьКолонку(ПараметрыПечати.ТаблицаЭтикеток, "ШаблонЭтикетки", Истина);
		
	Иначе
		
		Результат = Новый Массив;
		Для Каждого Элемент Из ПараметрыПечати.ШаблоныЭтикеток Цикл
			Если ЗначениеЗаполнено(Элемент.Значение) Тогда
				Результат.Добавить(Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
		СвернутьМассивЛок(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Этикетки_ПараметрыЗаполненияКартинокШтрихкодовНаКлиенте(ПараметрыПечати) Экспорт
	
	ОписанияЭтикеток = Этикетки_ОписанияЭтикетокДляЗаполненияКартинокШтрихкодовНаКлиенте(ПараметрыПечати);
	
	Результат = Новый Структура;
	Результат.Вставить("ОписанияЭтикеток", ОписанияЭтикеток);
	Результат.Вставить("НастройкиШаблонов", ПараметрыПечати.НастройкиШаблонов);
	
	Возврат Результат;
	
КонецФункции

Функция Печать_ЗначениеДопПараметра(ДопПараметр, СтрокаЭтикетки, ПараметрыПечати)
	
	// Глобальные переменные
	КэшПараметровЭтикеток = ПараметрыПечати.КэшДопПараметровЭтикеток;
	ПараметрыЭтикетки = СтрокаЭтикетки;
	Формула = ДопПараметр.Формула;
	
	ПараметрыЭтикетки = Новый Структура;
	ПараметрыЭтикетки.Вставить("Номенклатура", СтрокаЭтикетки.Номенклатура);
	ПараметрыЭтикетки.Вставить("Характеристика", СтрокаЭтикетки.Характеристика);
	ПараметрыЭтикетки.Вставить("Упаковка", СтрокаЭтикетки.Упаковка);
	ПараметрыЭтикетки.Вставить("Серия", СтрокаЭтикетки.Серия);
	ПараметрыЭтикетки.Вставить("Товар", СтрокаЭтикетки.Товар);
	ПараметрыЭтикетки.Вставить("Документ1С", ПараметрыПечати.Документ1С);
	ПараметрыЭтикетки.Вставить("Организация1С", ПараметрыПечати.Организация1С);
	
	// Для совместимости с 2.4
	Формула = СтрЗаменить(Формула, "Печать_ЗначениеСвойстваОбъекта", "Печать_ЗначениеДопСвойстваОбъекта");
	
	Попытка
		Результат = Вычислить(Формула);
	Исключение
		
		ПараметрыЭтикетки = Неопределено;
		КэшПараметровЭтикеток = Неопределено;
		
		Ошибка = ИнформацияОбОшибке();
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Имя", ДопПараметр.Имя);
		ДопИнформация.Вставить("Формула", ДопПараметр.Формула);
		Действие = НСтр("ru = 'Расчет доп параметра этикетки'");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		ШаблонСообщения = НСтр("ru = 'Не удалось расчитать доп параметр этикетки: %1'");
		ТекстСообщения = ПараметрыВСтроку(ШаблонСообщения, ДопПараметр.Имя);
		СообщениеОбОшибке = СоединитьСтроку(НовыйМассив(ТекстСообщения, ТекстОшибки), Символы.ПС);
		ВызватьИсключение СообщениеОбОшибке;
		
	КонецПопытки;
	
	ПараметрыЭтикетки = Неопределено;
	КэшПараметровЭтикеток = Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция Печать_ЗначениеРеквизитаОбъекта(Объект, ИмяРеквизита)
	
	Результат = КэшПараметровЭтикеток_Прочитать(Объект, ИмяРеквизита);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ЗначениеРеквизитаОбъектаЛок(Объект, ИмяРеквизита);
	
	КэшПараметровЭтикеток_Поместить(Объект, ИмяРеквизита, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Печать_ЗначениеДопСвойстваОбъекта(Объект, ИмяСвойства)
	
	Результат = КэшПараметровЭтикеток_Прочитать(Объект, ИмяСвойства);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ЗначениеДопСвойстваОбъекта(Объект, ИмяСвойства);
	
	КэшПараметровЭтикеток_Поместить(Объект, ИмяСвойства, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Печать_ЗначениеДопРеквизитаОбъекта(Объект, ИмяДопРеквизита)
	
	Результат = КэшПараметровЭтикеток_Прочитать(Объект, ИмяДопРеквизита);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ЗначениеДопРеквизитаОбъекта(Объект, ИмяДопРеквизита);
	
	КэшПараметровЭтикеток_Поместить(Объект, ИмяДопРеквизита, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ПустойШаблонЭтикетки()
	
	Возврат Справочники.КонтурМаркировка_ШаблоныЭтикеток.ПустаяСсылка();
	
КонецФункции

Функция КэшПараметровЭтикеток_Прочитать(Объект, ИмяСвойства)
	
	Результат = Неопределено;
	
	Отбор = Новый Структура("Объект, ИмяСвойства", Объект, ИмяСвойства);
	Стр = ТаблицаЗначений_НайтиСтроку(КэшПараметровЭтикеток, Отбор);
	
	Если Стр <> Неопределено Тогда
		Результат = Стр.Значение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

