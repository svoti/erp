Процедура ПерейтиНаВерсиюДанных_3_3_2_ПереименоватьУсловияХранения()
	
	СтарыйРеквизит = "УсловияХранения";
	НовыйРеквизит = "АльтернативныеСрокиГодности";
	ТипыСроковГодности = Перечисление_ТипыСроковГодности();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК Т
	|ГДЕ
	|	Т.ИмяРеквизита = ""ТипСрокаГодности""
	|	И Т.Значение = &СрокГодностиБольше72СУсловием
	|	И Т.Объект ССЫЛКА Справочник.КонтурМаркировка_Операции");
	Запрос.УстановитьПараметр("СрокГодностиБольше72СУсловием", ТипыСроковГодности.СрокГодностиБольше72СУсловием);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.Объект.ПолучитьОбъект();
		
		Для каждого Стр Из Объект.Товары Цикл
			
			ДопРеквизитыИБ = Стр.ДопРеквизиты.Получить();
			АльтСрокиГодности = СвойствоСтруктуры(ДопРеквизитыИБ, СтарыйРеквизит);
			
			Если ЗначениеЗаполнено(АльтСрокиГодности) Тогда
				ДопРеквизитыИБ.Удалить(СтарыйРеквизит);
				ДопРеквизитыИБ.Вставить(НовыйРеквизит, АльтСрокиГодности);
				Стр.ДопРеквизиты = ЗначениеВХранилище(ДопРеквизитыИБ);
			КонецЕсли;
			
		КонецЦикла;
		
		Если Объект.Модифицированность() Тогда
			Объект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

