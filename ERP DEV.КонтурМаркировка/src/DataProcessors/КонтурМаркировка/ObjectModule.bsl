// #Область ВерсияВДопСправочнике

Функция ВерсияВДопСправочнике(ИмяСправочника)
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	
	Результат = ДанныеИБ.Комментарий;
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, ИмяСправочника, ПустаяВерсия());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ВерсияВДопСправочнике_Записать(Версия, ИмяСправочника)
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	ДанныеИБ.ДопРеквизиты.Очистить();
	ДанныеИБ.Комментарий = Версия;
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

