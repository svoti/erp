Функция НастройкиМодуля_РежимОтладкиВключен()
	
	КлючКэш = "НастройкиМодуля_РежимОтладкиВключен";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДопСправочники КАК Спр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДопСправочники.ДопРеквизиты КАК ТЧ
	|		ПО (ТЧ.Ссылка = Спр.Ссылка)
	|ГДЕ
	|	Спр.ИмяСправочника = ""НастройкиМодуля""
	|	И НЕ Спр.ПометкаУдаления
	|	И ТЧ.ИмяРеквизита = ""РежимОтладки""
	|	И ТЧ.Значение = ИСТИНА";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Результат = Не Запрос.Выполнить().Пустой();
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиМодуля_КаталогОтладки() Экспорт
	
	КлючКэш = "НастройкиМодуля_КаталогОтладки";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТЧ.Значение КАК КаталогОтладки
	|ИЗ
	|	Справочник.КонтурМаркировка_ДопСправочники КАК Спр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДопСправочники.ДопРеквизиты КАК ТЧ
	|		ПО (ТЧ.Ссылка = Спр.Ссылка)
	|ГДЕ
	|	Спр.ИмяСправочника = ""НастройкиМодуля""
	|	И НЕ Спр.ПометкаУдаления
	|	И ТЧ.ИмяРеквизита = ""КаталогОтладки""";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.КаталогОтладки;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = МодульОбщегоНазначения().КаталогОбработки(ЭтотОбъект);
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

