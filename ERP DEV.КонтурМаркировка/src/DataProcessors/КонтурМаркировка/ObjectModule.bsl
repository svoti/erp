		СведенияОМаркировке_Распределить_ОСУ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюСериюПриемника = Истина;
	Для Каждого СтрМарк Из СведенияОМаркировке_ДоступныеСтрокиОСУ(ТаблицаМаркировки) Цикл
		СведенияОМаркировке_Распределить_ОСУ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПараметрыРаспределения.РазрешитьПустуюХарактеристикуПриемника = Истина;
	Для Каждого СтрМарк Из СведенияОМаркировке_ДоступныеСтрокиОСУ(ТаблицаМаркировки) Цикл
		СведенияОМаркировке_Распределить_ОСУ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	КонецЦикла;
	
	ПорядокСортировки = СведенияОМаркировке_ПорядокСортировкиСтрокДокумента();
	ТаблицаМаркировки.Сортировать(ПорядокСортировки, Новый СравнениеЗначений);
	ТоварыДокументов.Сортировать(ПорядокСортировки, Новый СравнениеЗначений);
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_ОСУ_МеньшеОднойУпаковки(СтрМарк, ТоварыДокументов, ПараметрыРаспределения)
	
	СтрокиДокумента = СведенияОМаркировке_ДоступныеСтрокиДокумента(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	Если Не ЗначениеЗаполнено(СтрокиДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоВсего = 0;
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		КоличествоВсего = КоличествоВсего + СтрДок.Количество;
	КонецЦикла;
	
	ОднаУпаковка = 1;
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		Если СтрДок.ВсеКодыПолучены Тогда
			Продолжить;
		КонецЕсли;
		
		ТребуетсяКИ = СтрДок.Количество / КоличествоВсего * СтрМарк.КоличествоКИ;
		Если ТребуетсяКИ >= ОднаУпаковка Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиСвед = СведенияОМаркировке_ДоступныеОСУ(СтрМарк.СведенияОМаркировке);
		Если Не ЗначениеЗаполнено(СтрокиСвед) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрСвед = СтрокиСвед[0];
		НоваяСтрока = СтрДок.СведенияОМаркировке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед);
		НоваяСтрока.КоличествоУпаковок = ОднаУпаковка;
		
		СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОднаУпаковка;
		СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
		
		ПереданоКоличество = ОднаУпаковка * СтрМарк.КоличествоВУпаковке;
		
		СведенияОМаркировке_ОбновитьИтогиСтрокиДокумента(СтрДок, ОднаУпаковка, ПереданоКоличество);
		СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ОднаУпаковка, ПереданоКоличество);
		
		Если СтрМарк.ВсеКодыПереданы Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_ОСУ(СтрМарк, ТоварыДокументов, ПараметрыРаспределения)
	
	СтрокиДокумента = СведенияОМаркировке_ДоступныеСтрокиДокумента(СтрМарк, ТоварыДокументов, ПараметрыРаспределения);
	Если Не ЗначениеЗаполнено(СтрокиДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СтрМарк.ВсеКодыПереданы И Не СведенияОМаркировке_ЭтоКорректировка(ТоварыДокументов) Тогда
		СведенияОМаркировке_Распределить_ОСУ_НеЗаполнено(СтрМарк, СтрокиДокумента);
	КонецЕсли;
	
	Если Не СтрМарк.ВсеКодыПереданы Тогда
		СведенияОМаркировке_Распределить_ОСУ_КоличествоСовпадает(СтрМарк, СтрокиДокумента);
	КонецЕсли;
	
	Если Не СтрМарк.ВсеКодыПереданы Тогда
		СведенияОМаркировке_Распределить_ОСУ_Отличается(СтрМарк, СтрокиДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_ОСУ_НеЗаполнено(СтрМарк, СтрокиДокумента)
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		Если ЗначениеЗаполнено(СтрДок.Количество) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиСвед = СведенияОМаркировке_ДоступныеОСУ(СтрМарк.СведенияОМаркировке);
		Если Не ЗначениеЗаполнено(СтрокиСвед) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрСвед = СтрокиСвед[0];
		ПереданоКИ = СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ;
		
		НоваяСтрока = СтрДок.СведенияОМаркировке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед);
		НоваяСтрока.КоличествоУпаковок = ПереданоКИ;
		
		СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ПереданоКИ;
		СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
		
		ПереданоКоличество = ПереданоКИ * СтрМарк.КоличествоВУпаковке;
		
		СтрДок.ПолученоКИ = СтрДок.ПолученоКИ + ПереданоКИ;
		СтрДок.ПолученоКоличество = СтрДок.ПолученоКоличество + ПереданоКоличество;
		СтрДок.ВсеКодыПолучены = Истина;
		
		СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ПереданоКИ, ПереданоКоличество);
		
		Если СтрМарк.ВсеКодыПереданы Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_ОСУ_КоличествоСовпадает(СтрМарк, СтрокиДокумента)
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		ОсталосьКоличество = СтрМарк.Количество - СтрМарк.ПереданоКоличество;
		
		Если СтрДок.ВсеКодыПолучены
			Или СтрДок.Количество <> ОсталосьКоличество Тогда
			Продолжить;
		КонецЕсли;
		
		ПереданоКИ = 0;
		
		Для Каждого СтрСвед Из СведенияОМаркировке_ДоступныеОСУ(СтрМарк.СведенияОМаркировке) Цикл
			
			ОсталосьКИ = СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ;
			
			НоваяСтрока = СтрДок.СведенияОМаркировке.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед);
			НоваяСтрока.КоличествоУпаковок = ОсталосьКИ;
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОсталосьКИ;
			СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
			
			ПереданоКИ = ПереданоКИ + ОсталосьКИ;
			
		КонецЦикла;
		
		СтрДок.ПолученоКИ = СтрДок.ПолученоКИ + ПереданоКИ;
		СтрДок.ПолученоКоличество = СтрДок.ПолученоКоличество + ОсталосьКоличество;
		СтрДок.ВсеКодыПолучены = Истина;
		
		СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ПереданоКИ, ОсталосьКоличество);
		
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СведенияОМаркировке_Распределить_ОСУ_Отличается(СтрМарк, СтрокиДокумента)
	
	КоличествоВсего = 0;
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		КоличествоВсего = КоличествоВсего + СтрДок.Количество;
	КонецЦикла;
	
	Для Каждого СтрДок Из СтрокиДокумента Цикл
		
		Если СтрДок.ВсеКодыПолучены Тогда
			Продолжить;
		КонецЕсли;
		
		ОсталосьКИ = СтрМарк.КоличествоКИ - СтрМарк.ПереданоКИ;
		ТребуетсяКИ = Макс(Окр(СтрДок.Количество / КоличествоВсего * СтрМарк.КоличествоКИ), 1);
		
		Если ТребуетсяКИ > ОсталосьКИ Тогда
			ТребуетсяКИ = ОсталосьКИ;
		КонецЕсли;
		
		ПереданоКИ = 0;
		
		Для Каждого СтрСвед Из СведенияОМаркировке_ДоступныеОСУ(СтрМарк.СведенияОМаркировке) Цикл
			
			ОсталосьКИ = Мин(СтрСвед.КоличествоКИ - СтрСвед.ПереданоКИ, ТребуетсяКИ - ПереданоКИ);
			
			НоваяСтрока = СтрДок.СведенияОМаркировке.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрСвед);
			НоваяСтрока.КоличествоУпаковок = ОсталосьКИ;
			
			СтрСвед.ПереданоКИ = СтрСвед.ПереданоКИ + ОсталосьКИ;
			СтрСвед.Передан = (СтрСвед.ПереданоКИ = СтрСвед.КоличествоКИ);
			
			ПереданоКИ = ПереданоКИ + ОсталосьКИ;
			
			Если ПереданоКИ = ТребуетсяКИ Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		ПереданоКоличество = ПереданоКИ * СтрМарк.КоличествоВУпаковке;
		
		СведенияОМаркировке_ОбновитьИтогиСтрокиДокумента(СтрДок, ПереданоКИ, ПереданоКоличество);
		СведенияОМаркировке_ОбновитьИтогиСтрокиМаркировки(СтрМарк, ПереданоКИ, ПереданоКоличество);
		
		Если СтрМарк.ВсеКодыПереданы Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

