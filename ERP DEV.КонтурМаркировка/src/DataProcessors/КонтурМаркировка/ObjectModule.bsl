// #Область ЭквивалентыРазделителяGS1

Функция ЭквивалентыРазделителяGS1() Экспорт
	
	ИмяСправочникаИРеквизита = Перечисление_ИменаДопСправочников().ЭквивалентыРазделителяGS1;
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочникаИРеквизита);
	
	Результат = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, ИмяСправочникаИРеквизита, Новый_ЭквивалентыРазделителяGS1());
	
	Возврат Результат;
	
КонецФункции

Процедура ЭквивалентыРазделителяGS1_Записать(ЭквивалентыРазделителяGS1) Экспорт
	
	ИмяСправочникаИРеквизита = Перечисление_ИменаДопСправочников().ЭквивалентыРазделителяGS1;
	
	Если Не ЗначениеЗаполнено(ЭквивалентыРазделителяGS1) Тогда
		ЭквивалентыРазделителяGS1 = Новый_ЭквивалентыРазделителяGS1();
	КонецЕсли;
	
	ЭквивалентыРазделителяGS1.Вставить(0, ЭквивалентРазделителяGS1());
	СвернутьМассивЛок(ЭквивалентыРазделителяGS1, Истина);
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочникаИРеквизита);
	ДанныеИБ.ДопРеквизиты.Вставить(ИмяСправочникаИРеквизита, ЭквивалентыРазделителяGS1);
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

Функция Новый_ЭквивалентыРазделителяGS1()
	
	Результат = Новый Массив();
	
	Результат.Добавить(ЭквивалентРазделителяGS1());
	Результат.Добавить("_x001d_");
	Результат.Добавить("[GS]");
	
	Возврат Результат;
	
КонецФункции

