Процедура ПерейтиНаВерсиюДанных_3_17_4_ДобавитьФайлыСПолнымиКодамиДляФоновогоОбновления(ОписаниеОбработчика)
	
	ДатаРелиза_3_16 = '20260224';
	ТипФайлаПолныеКоды = Перечисление_ТипыФайлов().ПолныеКоды;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ИнформацияОКодах.КлючИнформацииОКоде = КодыМаркировки.КлючИнформацииОКоде
	|ГДЕ
	|	ИнформацияОКодах.ДатаПечати >= &ДатаРелиза_3_16");
	Запрос.УстановитьПараметр("ДатаРелиза_3_16", ДатаРелиза_3_16);
	
	ДлинаИдентификатора = 36;
	ИдентификаторыФайлов = Запрос.Выполнить().Выгрузить();
