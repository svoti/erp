Функция Операция_ПечатьКодов_ТипыЭтикеток(Операция) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	КодыОпераций_ВТ_Прочитать(Операция, МенеджерВТ);
	ТаблицаКодов_ВТ_ПрочитатьКлючиАгрегатов(МенеджерВТ);
	ТаблицаКодов_ВТ_ДобавитьКлючиВсехВложенныхКодов(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИнформацияОКодах.ОбщийТипУпаковки КАК ОбщийТипУпаковки
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТаблицаКодов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ИнформацияОКодах.ОбщийТипУпаковки ЕСТЬ НЕ NULL ");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ОбщийТипУпаковки) Тогда
			Результат.Добавить(ТипЭтикеткиПоОбщемуТипуУпаковки(Выборка.ОбщийТипУпаковки));
		КонецЕсли;
	КонецЦикла;
	
	СвернутьМассивЛок(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ЭтоПечатьИзСвободногоОстатка(ОписаниеОперации) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СпособыВыпускаТоваров = Перечисление_СпособыВыпускаТоваров();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	
	Если ТипОперации <> ТипыОпераций.ПечатьКодов Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОперацияОснование) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Результат = Ложь;
	ТипОперацииОснования = ЗначениеРеквизитаОбъектаЛок(ОперацияОснование, "ТипОперации");
	Если ТипОперацииОснования = ТипыОпераций.ЗаказКодов Тогда
		ОписаниеОперацииОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
		ДопРеквизитыОснования = ОписаниеОперацииОснования.ДопРеквизиты;
		Если Не ДопРеквизитыОснования.ТипКодаМаркировки = ТипыКодовМаркировки.Набор
			И Не ДопРеквизитыОснования.СпособВыпускаТоваров = СпособыВыпускаТоваров.Перемаркировка Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_ПечатьКодов_ЗаполнитьШаблоныЭтикеток(ОписаниеОперации) Экспорт
	
	Настройки = НастройкиМодуля();
	ТипыЭтикеток = Перечисления.КонтурМаркировка_ТипыЭтикеток;
	ТипыЭтикетокВОперации = Операция_ПечатьКодов_ТипыЭтикеток(ОписаниеОперации.Ссылка);
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	Если МассивСодержитЗначение(ТипыЭтикетокВОперации, ТипыЭтикеток.Товарная) Тогда
		
		ДопРеквизиты.ЕстьТоварныеЭтикетки = Истина;
		
		Если Не ЗначениеЗаполнено(ДопРеквизиты.ШаблонТоварнойЭтикетки) Тогда
			ДопРеквизиты.ШаблонТоварнойЭтикетки = Настройки.ШаблонТоварнойЭтикеткиПоУмолчанию;
		КонецЕсли;
		ДопРеквизиты.ПечататьТоварныеЭтикетки = ЗначениеЗаполнено(ДопРеквизиты.ШаблонТоварнойЭтикетки);
		
	Иначе
		ДопРеквизиты.ЕстьТоварныеЭтикетки = Ложь;
		ДопРеквизиты.ПечататьТоварныеЭтикетки = Ложь;
		ДопРеквизиты.ШаблонТоварнойЭтикетки = Неопределено;
	КонецЕсли;
	
	Если МассивСодержитЗначение(ТипыЭтикетокВОперации, ТипыЭтикеток.Групповая) Тогда
		
		ДопРеквизиты.ЕстьГрупповыеЭтикетки = Истина;
		
		Если Не ЗначениеЗаполнено(ДопРеквизиты.ШаблонГрупповойЭтикетки) Тогда
			ДопРеквизиты.ШаблонГрупповойЭтикетки = Настройки.ШаблонГрупповойЭтикеткиПоУмолчанию;
		КонецЕсли;
		ДопРеквизиты.ПечататьГрупповыеЭтикетки = ЗначениеЗаполнено(ДопРеквизиты.ШаблонГрупповойЭтикетки);
		
	Иначе
		ДопРеквизиты.ЕстьГрупповыеЭтикетки = Ложь;
		ДопРеквизиты.ПечататьГрупповыеЭтикетки = Ложь;
		ДопРеквизиты.ШаблонГрупповойЭтикетки = Неопределено;
	КонецЕсли;
	
	Если МассивСодержитЗначение(ТипыЭтикетокВОперации, ТипыЭтикеток.Набор) Тогда
		
		ДопРеквизиты.ЕстьЭтикеткиНаборов = Истина;
		
		Если Не ЗначениеЗаполнено(ДопРеквизиты.ШаблонЭтикеткиНабора) Тогда
			ДопРеквизиты.ШаблонЭтикеткиНабора = Настройки.ШаблонЭтикеткиНабораПоУмолчанию;
		КонецЕсли;
		ДопРеквизиты.ПечататьЭтикеткиНаборов = ЗначениеЗаполнено(ДопРеквизиты.ШаблонЭтикеткиНабора);
		
	Иначе
		ДопРеквизиты.ЕстьЭтикеткиНаборов = Ложь;
		ДопРеквизиты.ПечататьЭтикеткиНаборов = Ложь;
		ДопРеквизиты.ШаблонЭтикеткиНабора = Неопределено;
	КонецЕсли;
	
	Если МассивСодержитЗначение(ТипыЭтикетокВОперации, ТипыЭтикеток.Транспортная) Тогда
		
		ДопРеквизиты.ЕстьТранспортныеЭтикетки = Истина;
		
		Если Не ЗначениеЗаполнено(ДопРеквизиты.ШаблонТранспортнойЭтикетки) Тогда
			ДопРеквизиты.ШаблонТранспортнойЭтикетки = Настройки.ШаблонТранспортнойЭтикеткиПоУмолчанию;
		КонецЕсли;
		ДопРеквизиты.ПечататьТранспортныеЭтикетки = ЗначениеЗаполнено(ДопРеквизиты.ШаблонТранспортнойЭтикетки);
		
	Иначе
		ДопРеквизиты.ЕстьТранспортныеЭтикетки = Ложь;
		ДопРеквизиты.ПечататьТранспортныеЭтикетки = Ложь;
		ДопРеквизиты.ШаблонТранспортнойЭтикетки = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

