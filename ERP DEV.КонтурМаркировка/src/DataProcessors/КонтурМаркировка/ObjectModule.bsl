// Возвращает количество созданных товаров на основании входящего УПД
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - входящий УПД;
// 
// Возвращаемое значение:
//  Число - количество созданных товаров;
//
Функция Товары_ДобавитьИзВходящегоУПД(Операция) Экспорт
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Организация = ОписаниеОперации.Организация;
	ТаблицаКодов = Операция_ВходящийУПД_ТаблицаКодов(ОписаниеОперации);
	ТаблицаКодовОСУ = Операция_ВходящийУПД_ТаблицаКодовОСУ(ОписаниеОперации);
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов)
		И Не ЗначениеЗаполнено(ТаблицаКодовОСУ) Тогда
		Возврат 0;
	КонецЕсли;
	
	ТоваровДо = Товары_ВсегоТоваров();
	
	ТаблицаКодов_ПодобратьТовары(ТаблицаКодовОСУ);
	ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, Ложь);
	
	ТоваровПосле = Товары_ВсегоТоваров();
	
	Возврат ТоваровПосле - ТоваровДо;
	
КонецФункции

