// Безопасно читает свойство структуры
// 
// Параметры:
//  Структура - Структура - структура;
//  Ключ      - Строка  - ключ;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается,
//                                   если в структуре нет такого ключа;
// 
// Возвращаемое значение:
//   Произвольный - значение свойства
//
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Возврат МодульОбщегоНазначения().СвойствоОбъекта(Структура, Ключ, ЗначениеПоУмолчанию);
	
КонецФункции

// Безопасно читает по ключу значение соответствия
// или значение по умолчанию, если в соответствии нет такого ключа
// 
// Параметры:
//  Соответствие        - Соответствие - соответствие источник;
//  Ключ                - Произвольный - ключ соответствия;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается в случае,
//                                       если в соответствии нет указанного ключа;
// 
// Возвращаемое значение:
//  Произвольный - значение из соответствия или ЗначениеПоУмолчанию
//
Функция ЗначениеСоответствия(Соответствие, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Попытка
		Результат = Соответствие[Ключ];
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает строку в двоичные данные
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - табличный документ, который нужно записать в двоичные данные
//  ТипФайла - ТипФайлаТабличногоДокумента - формат, в котором будет сохранен табличный документ;
// 
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция ДвоичныеДанныеИзТабличногоДокумента(ТабличныйДокумент, ТипФайла)
	
	Если ВерсияПлатформыНиже("8.3.10") Тогда
		ЧерезПоток = Ложь;
	ИначеЕсли ВерсияПлатформыНиже("8.3.16") И ТипФайла = ТипФайлаТабличногоДокумента.XLSX Тогда
		ЧерезПоток = Ложь;
	Иначе
		ЧерезПоток = Истина;
	КонецЕсли;
	
	Если ЧерезПоток Тогда
		
		Поток = Новый("ПотокВПамяти");
		ТабличныйДокумент.Записать(Поток, ТипФайла);
		Результат = Поток.ЗакрытьИПолучитьДвоичныеДанные();
		
	Иначе
		
		ПутьКФайлу = НовыйВременныйФайл();
		ТабличныйДокумент.Записать(ПутьКФайлу, ТипФайла);
		
		Результат = НовыйДвоичныеДанные(ПутьКФайлу);
		МодульОбщегоНазначения().УдалитьФайл(ПутьКФайлу);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает строку из двоичных данных
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - двоичные данные, в которых содержится строка;
//  Кодировка - КодировкаТекста, Строка - (необязательный) кодировка текста;
// 
// Возвращаемое значение:
//  Строка
//
Функция СтрокаИзДвоичныхДанных(ДвоичныеДанные, Кодировка = "UTF-8")
	
	Если Не ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВерсияПлатформыНиже("8.3.10") Тогда
		
		ПутьКФайлу = НовыйВременныйФайл();
		ДвоичныеДанные.Записать(ПутьКФайлу);
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(ПутьКФайлу, Кодировка);
		Результат = Текст.ПолучитьТекст();
		
		МодульОбщегоНазначения().УдалитьФайл(ПутьКФайлу);
		
	Иначе
		Результат = Вычислить("ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, Кодировка)");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Очищает список и заполняет новыми значениями
// Из структуры добавляет только значения
//
// Параметры:
//  СписокВыбора - СписокЗначений - список, который нужно заполнить;
//  ЗначенияСписка - СписокЗначений, Массив, Структура - новые значения;
//
Процедура ЗаполнитьСписокВыбора(СписокВыбора, ЗначенияСписка) Экспорт
	
	СписокВыбора.Очистить();
	
	Если Не ЗначениеЗаполнено(ЗначенияСписка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоМассив(ЗначенияСписка) Тогда
		Для Каждого Значение Из ЗначенияСписка Цикл
			СписокВыбора.Добавить(Значение);
		КонецЦикла;
	ИначеЕсли ЭтоСтруктура(ЗначенияСписка) Или ЭтоСоответствие(ЗначенияСписка) Тогда
		Для Каждого Элемент Из ЗначенияСписка Цикл
			СписокВыбора.Добавить(Элемент.Значение, Элемент.Значение);
		КонецЦикла;
	ИначеЕсли ЭтоСписокЗначений(ЗначенияСписка) Тогда
		Для Каждого Элемент Из ЗначенияСписка Цикл
			СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;
	Иначе
		СписокВыбора.Добавить(ЗначенияСписка);
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает подсказку видимого элемента формы и вариант её отображения
//
// Параметры:
//  ЭлементФормы - ПолеФормы - элемент формы;
//  ТекстПодсказки - Строка - текст подсказки;
//  ВариантОтображения - Строка - (необязательный) см. Перечисление_ВариантыОтображенияПодсказки();
//
Процедура УстановитьПодсказку(ЭлементФормы, ТекстПодсказки, ВариантОтображения = Неопределено) Экспорт
	
	Если Не ЭлементФормы.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементФормы.Подсказка = ТекстПодсказки;
	
	Если ЗначениеЗаполнено(ВариантОтображения) И Не ВерсияПлатформыНиже("8.3") Тогда
		Отображение = ПредопределенноеЗначение("ОтображениеПодсказки." + ВариантОтображения);
		УстановитьСвойствоОбъекта(ЭлементФормы, "ОтображениеПодсказки", Отображение);
	КонецЕсли;
	
КонецПроцедуры

Функция ЧислоИзСтроки(Строка) Экспорт
	
	Возврат МодульКонтроль().ЧислоИзСтроки(Строка);
	
КонецФункции

// Преобразует исходную строку в число без вызова исключений.
//
// Параметры:
//   Значение - Строка - строка, которую необходимо привести к числу.
//                       Например, "10", "+10", "010", вернет 10;
//                                 "(10)", "-10",вернет -10;
//                                 "10,2", "10.2",вернет 10.2;
//                                 "000", " ", "",вернет 0;
//                                 "10текст", вернет Неопределено.
//
// Возвращаемое значение:
//   Число, Неопределено - полученное число, либо Неопределено, если строка не является числом.
//
Функция СтрокаВЧисло(Знач Значение) Экспорт
	
