// Выполняет авторизацию в сервисе Контур.Маркировка и продлевает доступ в ГИС МТ если нужно
//
// Параметры:
//  Организация1С - СправочникСсылка - организация;
//  ВызыватьИсключение - Булево - (необязательный) Ложь, если вызывать исключение при ошибке не нужно;
// 
// Возвращаемое значение:
//  Булево - Истина, если авторизация выполнена успешно
//
Функция ВыполнитьАвторизацию(Организация1С, ВызыватьИсключение = Истина) Экспорт
	
	ПроверитьУстановленнуюВерсиюМодуля(Истина);
	
	Возврат МодульЯдро().ВыполнитьАвторизацию(Организация1С, ВызыватьИсключение);
	
КонецФункции

// Выполняет обмен с сервисом Контур.Маркировка по указанной организации
//
// Параметры:
//  Организация1С - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  Документ1С - ДокументСсылка - документ 1С;
//  Операции - Массив, КонтурМаркировка_Операции - операции;
//
Процедура ВыполнитьОбменПоОрганизации(Организация1С, Документ1С = Неопределено, Операции = Неопределено) Экспорт
	
	ВызыватьИсключение = Истина;
	ПроверитьУстановленнуюВерсиюМодуля(ВызыватьИсключение);
	
	Если ТипЗнч(Организация1С) = Тип("СправочникСсылка.КонтурМаркировка_Организации") Тогда
		Организация = Организация1С;
	Иначе
		Организация = Организация_НайтиПоОрганизации1С(Организация1С, Истина);
	КонецЕсли;
	
	ВызыватьИсключение = ЗначениеЗаполнено(Документ1С);
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С, ВызыватьИсключение);
	
	КонтекстОбмена = КонтекстОбменаССервисом(Организация);
	КонтекстОбмена.ДокументУчета = ДокументУчета;
	КонтекстОбмена.ВызыватьИсключение = Истина;
	
	Если ЗначениеЗаполнено(Операции) Тогда
		КонтекстОбмена.Операции = ЗначениеВМассиве(Операции);
	КонецЕсли;
	
	Если Не Авторизация_Выполнить(КонтекстОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	МодульЯдро().КонтекстОбмена_ПроверитьВозможностьОбмена(КонтекстОбмена);
	
	ВыполнитьОбменССервисом(КонтекстОбмена);
	
КонецПроцедуры

// Выполняет обмен с сервисом Контур.Маркировка по всем организациям
//
Процедура ВыполнитьОбменПоВсемОрганизациям() Экспорт
	
	ВызыватьИсключение = Истина;
	ПроверитьУстановленнуюВерсиюМодуля(ВызыватьИсключение);
	
	Для каждого Организация Из Организация_ВсеОрганизации() Цикл
		
		КонтекстОбмена = КонтекстОбменаССервисом(Организация);
		КонтекстОбмена.ВызыватьИсключение = Истина;
		
		Если Не КонтекстОбмена.ОбменВозможен Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Авторизация_Выполнить(КонтекстОбмена) Тогда
			Возврат;
		КонецЕсли;
		
		ВыполнитьОбменССервисом(КонтекстОбмена);
		
	КонецЦикла;
	
КонецПроцедуры

