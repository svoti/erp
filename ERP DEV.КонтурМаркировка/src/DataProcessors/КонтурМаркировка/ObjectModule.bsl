Процедура ОбновитьРегламентноеЗадание(ОписаниеЗадания, Использование, Расписание, ИмяПользователя = Неопределено)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	РегЗадание = РегламентноеЗадание(ОписаниеЗадания, Использование);
	
	Если РегЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
	ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	
	РегЗадание.Параметры = ПараметрыМетодаРегламентногоЗадания(ОписаниеЗадания, ПараметрыКоманды);
	РегЗадание.Использование = Использование;
	РегЗадание.Расписание = Расписание;
	Если ИмяПользователя <> Неопределено Тогда
		РегЗадание.ИмяПользователя = ИмяПользователя;
	КонецЕсли;
	РегЗадание.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция МодульРегламентныеДействия()
	
	СведенияОбОбработке = МодульРегламентныеДействия_СведенияОВнешнейОбработке();
	ТекущаяВерсия = СведенияОбОбработке.Версия;
	Ссылка = СсылкаНаДополнительнуюОбработку(СведенияОбОбработке.Наименование);
	ИмяПоляХранилища = Интеграция_ИмяХранилищаФайлаВнешнейОбработки(Ссылка);
	ИмяПоляВерсии = Интеграция_ИмяПоляВерсииВнешнейОбработки(Ссылка);
	
	НеобходимоОбновить = Истина;
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ВерсияВБазе = ЗначениеРеквизитаОбъектаЛок(Ссылка, ИмяПоляВерсии);
		НеобходимоОбновить = СравнитьВерсии(ТекущаяВерсия, ВерсияВБазе) > 0;
	КонецЕсли;
	
	Если НеобходимоОбновить Тогда
		
		ОписаниеОбработки = Новый_ОписаниеВнешнейОбработки();
		ОписаниеОбработки.Ссылка = Ссылка;
		ОписаниеОбработки.ИмяПоляВерсии = ИмяПоляВерсии;
		ОписаниеОбработки.ИмяПоляХранилища = ИмяПоляХранилища;
		ОписаниеОбработки.ИмяПоляИмяОбъекта = Интеграция_ИмяПоляИмяОбъектаВнешнейОбработки(Ссылка);
		ОписаниеОбработки.ИмяПоляВидОбработки = Интеграция_ИмяПоляВидВнешнейОбработки(Ссылка);
		ОписаниеОбработки.ИмяПоляПубликация = Интеграция_ИмяПоляПубликацияВнешнейОбработки(Ссылка);
		ОписаниеОбработки.ВидОбработки = Интеграция_ВидВнешнейОбработки();
		ОписаниеОбработки.Публикация = Интеграция_ПубликацияВнешнейОбработки();
		ОписаниеОбработки.ИмяОбъекта = МодульРегламентныеДействия_ИмяМодуля();
		
		ДвоичныеДанные = МодульРегламентныеДействия_ДвоичныеДанные();
		
		Ссылка = ЗаписатьФайлВСправочникВнешнихОбработок(ОписаниеОбработки, ДвоичныеДанные, ТекущаяВерсия);
		
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

Функция МодульРегламентныеДействия_СведенияОВнешнейОбработке()
	
	ДвоичныеДанные = МодульРегламентныеДействия_ДвоичныеДанные();
	Результат = СведенияОВнешнейОбработкеИзФайла(ДвоичныеДанные);
	
	Возврат Результат;
	
