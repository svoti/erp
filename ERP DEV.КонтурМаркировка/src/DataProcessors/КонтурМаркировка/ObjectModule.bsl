// Возвращает значения настроек модуля по умолчанию
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура
//
Функция ЗначенияПолейПоУмолчанию() Экспорт
	
	Настройки = НастройкиМодуля();
	
	Постфикс = "ПоУмолчанию";
	ДлинаПостфикса = СтрДлина(Постфикс);
	
	ЗначенияПолей = Новый Структура;
	
	Для Каждого КлючЗначение Из Настройки Цикл
		
		Если Прав(КлючЗначение.Ключ, ДлинаПостфикса) <> Постфикс Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначенияПолей.Вставить(СтрЗаменить(КлючЗначение.Ключ, Постфикс, ""), КлючЗначение.Значение);
		
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(ЗначенияПолей);
	
КонецФункции

