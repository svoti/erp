	ЭлементДопСправочника = ДопСправочник_Прочитать(Плагин);
	ЗаполнитьЗначенияСвойств(Результат, ЭлементДопСправочника.ДопРеквизиты);
	Результат.Ссылка = Плагин;
	
	Возврат Результат;
	
