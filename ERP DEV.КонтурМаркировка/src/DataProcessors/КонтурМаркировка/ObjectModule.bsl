Процедура ВыполнитьРегламентноеЗаданиеВТекущемСеансе(ОписаниеЗадания)
	
	ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
	ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	
	ИмяМетода = ИмяМетодаРегламентногоЗадания(ОписаниеЗадания);
	ПараметрыМетода = ПараметрыМетодаРегламентногоЗадания(ОписаниеЗадания, ПараметрыКоманды);
	
	МассивПараметров = Новый Массив;
	Если ЗначениеЗаполнено(ПараметрыМетода) Тогда
		Для Сч = 0 По ПараметрыМетода.ВГраница() Цикл
			МассивПараметров.Добавить(ПараметрыВСтроку("ПараметрыМетода[%1]", Сч));
		КонецЦикла;
	КонецЕсли;
	
	Метод = ПараметрыВСтроку("%1(%2)", ИмяМетода, СоединитьСтроку(МассивПараметров, ", "));
	
	Выполнить Метод;
	
КонецПроцедуры

Процедура ЗапуститьОбновлениеСтатусовКодовДокумента(ДокументУчета) Экспорт
	
	Если ВключенРежимТестирования()
		Или Не МенеджерФоновыхЗаданийДоступен() Тогда
		ДокументУчета_ОбновитьСтатусыКодов(ДокументУчета);
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадания = Задание_ОбновитьСтатусыКодовДокумента(ДокументУчета);
	
	ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
	ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	ПараметрыКоманды.Вставить("ДокументУчета", ДокументУчета);
	
	ЗапуститьФоновоеЗадание(ОписаниеЗадания, ПараметрыКоманды);
	
КонецПроцедуры

Процедура ЗапуститьПроверкуКодовДокумента(ДокументУчета) Экспорт
	
	Если ВключенРежимТестирования()
		Или Не МенеджерФоновыхЗаданийДоступен() Тогда
		ДокументУчета_ПроверитьКоды(ДокументУчета);
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадания = Задание_ПроверитьКодыДокумента(ДокументУчета);
	
	ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
	ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	ПараметрыКоманды.Вставить("ДокументУчета", ДокументУчета);
	
	ЗапуститьФоновоеЗадание(ОписаниеЗадания, ПараметрыКоманды);
	
КонецПроцедуры

Процедура ЗапуститьОбменССервисом(КонтекстОбмена) Экспорт
	
	Если ВключенРежимТестирования()
		Или Не МенеджерФоновыхЗаданийДоступен() Тогда
		МодульЯдро().ВыполнитьОбменССервисом(КонтекстОбмена);
		Возврат;
	КонецЕсли;
	
	ПереданМассивДокументов = ТипЗнч(КонтекстОбмена.ДокументУчета) = Тип("Массив");
	
	Если ЗначениеЗаполнено(КонтекстОбмена.ДокументУчета)
		И Не ПереданМассивДокументов Тогда
		КлючЗадания = КонтекстОбмена.ДокументУчета.УникальныйИдентификатор();
	ИначеЕсли ПереданМассивДокументов
		И ЗначениеЗаполнено(КонтекстОбмена.ИдентификаторФормы) Тогда
		КлючЗадания = КонтекстОбмена.ИдентификаторФормы;
	Иначе
		КлючЗадания = КонтекстОбмена.Организация.УникальныйИдентификатор();
	КонецЕсли;
	
	ОписаниеЗадания = Задание_ВыполнитьОбменССервисом(КлючЗадания);
	
	ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
	ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	ПараметрыКоманды.Вставить("КонтекстОбмена", КонтекстОбмена);
	
	ЗапуститьФоновоеЗадание(ОписаниеЗадания, ПараметрыКоманды);
	
КонецПроцедуры

Процедура ЗапуститьОбновлениеТарифов() Экспорт
	
	Если МенеджерФоновыхЗаданийДоступен() Тогда
		ЗапуститьФоновоеЗадание(Задание_ОбновлениеТарифов());
	Иначе
		МодульЯдро().ОбновитьИнформациюОТарифах();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьОшибкиОбменаССервисом(Организация = Неопределено, ДокументУчета = Неопределено, ИдентификаторФормы = Неопределено) Экспорт
	
	Если Не МенеджерФоновыхЗаданийДоступен() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		МассивОбъектов = ЗначениеВМассиве(ДокументУчета);
	Иначе
		Если ЗначениеЗаполнено(Организация) Тогда
			МассивОбъектов = ЗначениеВМассиве(Организация);
		Иначе
			МассивОбъектов = Организация_ВсеОрганизацииДляОбмена();
		КонецЕсли;
	КонецЕсли;
	
	НачалоБуфера = "{""БуферОшибок"":";
	ЗаполнитьДатуОшибки = Ложь; // Дата уже проставлена в фоновом задании
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	
	// BSLLS:NestedStatements-off
	Для каждого СсылкаНаОбъект Из МассивОбъектов Цикл
		
		Отбор = Новый Структура("Состояние, Ключ");
		Отбор.Ключ = СсылкаНаОбъект.УникальныйИдентификатор();
		Отбор.Состояние = СостояниеФоновогоЗадания.Завершено;
		МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
		Отбор.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно;
		ДополнитьМассив(МассивЗаданий, ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор));
		
		Для Каждого Задание Из МассивЗаданий Цикл
			
			МассивСообщений = Задание.ПолучитьСообщенияПользователю(Истина);
			Если Не ЗначениеЗаполнено(МассивСообщений) Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Сообщение Из МассивСообщений Цикл
				Если Найти(Сообщение.Текст, НачалоБуфера) = 1 Тогда
					ОписаниеБуфера = ЗначениеИзСтрокиJSON(Сообщение.Текст);
					Для Каждого ТекстОшибки Из ОписаниеБуфера.БуферОшибок Цикл
						МодульЯдро().БуферОшибок_Добавить(ТекстОшибки, ЗаполнитьДатуОшибки);
					КонецЦикла;
				Иначе
					СообщитьПользователюЛок(Сообщение.Текст, ИдентификаторФормы);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	// BSLLS:NestedStatements-on
	
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on
	
КонецПроцедуры

Процедура ЗапуститьФоновоеОбновлениеДанных() Экспорт
	
	ОписаниеЗадания = Задание_ОбновитьДанныеПодсистемы();
	
	ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
	ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	
	ЗапуститьФоновоеЗадание(ОписаниеЗадания, ПараметрыКоманды);
	
КонецПроцедуры

Процедура ЗапуститьРегламентноеЗадание(ОписаниеЗадания, ПараметрыКоманды = Неопределено)
	
	Если ФоновоеЗаданиеВыполняется(ОписаниеЗадания) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыКоманды) Тогда
		ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
		ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	КонецЕсли;
	
	ОписаниеОбработки = ОписаниеМодуляЯдро();
	
	КлючЗадания = ОписаниеЗадания.Ключ;
	НаименованиеЗадания = ОписаниеЗадания.Наименование;
	
	ИмяМетода = ИмяМетодаРегламентногоЗадания(ОписаниеЗадания);
	ПараметрыМетода = ПараметрыМетодаРегламентногоЗадания(ОписаниеЗадания, ПараметрыКоманды, ОписаниеОбработки);
	
	Задание = ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыМетода, КлючЗадания, НаименованиеЗадания);
	
КонецПроцедуры

Процедура ЗапуститьФоновоеЗадание(ОписаниеЗадания, ПараметрыКоманды = Неопределено)
	
	Если ФоновоеЗаданиеВыполняется(ОписаниеЗадания) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОбработки = ОписаниеМодуляЯдро();
	
	Если Не ЗначениеЗаполнено(ПараметрыКоманды) Тогда
		ПараметрыКоманды = Новый_ПараметрыКомандыОбработки();
		ПараметрыКоманды.ИдентификаторКоманды = ОписаниеЗадания.Команда;
	КонецЕсли;
	
	КлючЗадания = ОписаниеЗадания.Ключ;
	НаименованиеЗадания = ОписаниеЗадания.Наименование;
	
	ИмяМетода = ИмяМетодаФоновогоЗадания();
	ПараметрыМетода = ПараметрыМетодаФоновогоЗадания(ПараметрыКоманды, ОписаниеОбработки);
	
	Задание = ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыМетода, КлючЗадания, НаименованиеЗадания);
	
КонецПроцедуры

Процедура ОбновитьЗаданиеОбменаПоРасписанию(Расписание, ИмяПользователя) Экспорт
	
	Использование = Истина;
	ОписаниеЗадания = Задание_ОбменССервисомПоРасписанию();
	ОбновитьРегламентноеЗадание(ОписаниеЗадания, Использование, Расписание, ИмяПользователя);
	
