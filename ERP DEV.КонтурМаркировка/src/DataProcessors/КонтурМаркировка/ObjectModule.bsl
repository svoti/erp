Процедура ПроверитьНастройкиТекущегоУзлаРИБ()
	
	Настройки = НастройкиМодуля();
	Если Настройки.РежимРИБ Тогда
		
		НастройкиУзла = НастройкиТекущегоУзлаРИБ(Настройки.ПланОбмена);
		
		Если Не ЗначениеЗаполнено(НастройкиУзла.Ссылка) Тогда
			
			ПрефиксИБ = ТипыОбъектовИС().ПрефиксИБ;
			
			Если Не ЗначениеЗаполнено(ПрефиксИБ) Тогда
				
				Действие = НСтр("ru = 'Проверка настроек текущего узла РИБ'");
				ТекстОшибки = НСтр("ru = 'Не заполнен префикс информационной базы'");
				ТекстСообщения = НСтр("ru = 'Необходимо заполнить префикс информационной базы'");
				ОбработатьОшибку(Действие, ТекстОшибки,, ТекстСообщения);
				
				ВызватьИсключение ТекстОшибки;
				
			Иначе
				
				НастройкиУзла.Узел = ТекущийУзелПланаОбмена(Настройки.ПланОбмена);
				НастройкиУзла.ПрефиксИБ = ПрефиксИБ;
				НастройкиУзлаРИБ_Записать(НастройкиУзла);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
