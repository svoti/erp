Функция СозданиеОперацииОграниченоТарифом(ТипОперации, ОписаниеТарифа) Экспорт
	
	Результат = Истина;
	
	Если ТипОперации = Перечисление_ТипыОпераций().ЗаказКодов Тогда
		Результат = СозданиеЗаказаКодовОграниченоТарифом(ОписаниеТарифа);
	ИначеЕсли ТипОперации = Перечисление_ТипыОпераций().ОтчетОНанесении Тогда
		Результат = СозданиеОтчетаОНанесенииОграниченоТарифом(ОписаниеТарифа);
	Иначе
		Результат = Не ОперацияДоступнаПоТарифу(ТипОперации, ОписаниеТарифа);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СозданиеЗаказаКодовОграниченоТарифом(ОписаниеТарифа)
	
	Результат = Ложь;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СервисыПодписок = Перечисление_СервисыПодписок();
	
	Если Не ОперацияДоступнаПоТарифу(ТипыОпераций.ЗаказКодов, ОписаниеТарифа)
		И Не СервисДоступенПоТарифу(СервисыПодписок.ЗаказКодовПеремаркировка, ОписаниеТарифа) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СозданиеОтчетаОНанесенииОграниченоТарифом(ОписаниеТарифа)
	
	Результат = Ложь;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СервисыПодписок = Перечисление_СервисыПодписок();
	
	Если Не ОперацияДоступнаПоТарифу(ТипыОпераций.ОтчетОНанесении, ОписаниеТарифа)
		И Не СервисДоступенПоТарифу(СервисыПодписок.Перемаркировка, ОписаниеТарифа) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

