// #Область ГрупповаяОбработка

// Возвращает таблицу документов учета, подходящих для создания
// операций указанного типа по указанной организации, за период
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  Период - СтандартныйПериод - период, за который необходимо найти документы;
//  ТипОперации - Строка - тип операции, см. Перечисление_ТипыОпераций();
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит документы учета;
//  Неопределено - если нет подходящих документов учета;
//
Функция ГрупповаяОбработка_ТаблицаДокументов(Организация, Период, ТипОперации) Экспорт
	
	Результат = Неопределено;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипыДокументов = ТипыДокументовДляГрупповойОбработкиОпераций(ТипОперации);
	
	Если Не ЗначениеЗаполнено(ТипыДокументов) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ПодборКодовНаТСД Тогда
		Результат = ГрупповаяОбработка_ТаблицаДокументов_ПодборКодовНаТСД(Организация, Период, ТипыДокументов);
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		Результат = ГрупповаяОбработка_ТаблицаДокументов_ВыводИзОборота(Организация, Период, ТипыДокументов);
	КонецЕсли;
	
	ГрупповаяОбработка_ТаблицаДокументов_ДобавитьРеквизитыКонтрагента(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ГрупповаяОбработка_ТаблицаДокументов_ПодборКодовНаТСД(Организация, Период, ТипыДокументов)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ПодходящиеТребуемыеДействия = Новый Массив;
	ПодходящиеТребуемыеДействия.Добавить(ТребуемыеДействия.НачатьРаботу);
	ПодходящиеТребуемыеДействия.Добавить(ТребуемыеДействия.НаполнитьКодами);
	
	ИменаТаблицДокументов = ГрупповаяОбработка_ИменаТаблицДокументов(МенеджерВТ, Организация, Период, ТипыДокументов);
	
	ТекстУсловия = "
	|
	|ГДЕ
	|	ЕСТЬNULL(ТребуемыеДействия.Статус, &ДействиеНачатьРаботу) В (&ПодходящиеТребуемыеДействия)";
	
	ТекстЗапроса = ТекстЗапроса_ТаблицаДокументовДляГрупповойОбработки(ИменаТаблицДокументов, ТекстУсловия);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("СтатусНовый", СтатусыДокументовУчета.Новый);
	Запрос.УстановитьПараметр("ДействиеНачатьРаботу", ТребуемыеДействия.НачатьРаботу);
	Запрос.УстановитьПараметр("ПодходящиеТребуемыеДействия", ПодходящиеТребуемыеДействия);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МенеджерВТ.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция ГрупповаяОбработка_ТаблицаДокументов_ВыводИзОборота(Организация, Период, ТипыДокументов)
	
	Результат = Неопределено;
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Если Не КодыДокументов_ВТ_ПрочитатьПоТипамДокументовЗаПериод(МенеджерВТ, ТипыДокументов, Период, Организация) Тогда
		МенеджерВТ.Закрыть();
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, Перечисление_ТипыОпераций().ВыводИзОборота);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	
	ПодходящиеСтатусы = Операция_ВыводИзОборота_ПодходящиеСтатусыКодов();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ДокументУчета КАК ДокументУчета
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.Статус В(&ПодходящиеСтатусы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ДокументУчета");
	Запрос.УстановитьПараметр("ПодходящиеСтатусы", ПодходящиеСтатусы);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ПодходящиеДокументыУчета = МассивИзРезультатаЗапроса(Запрос, "ДокументУчета");
	
	ИменаТаблицДокументов = ГрупповаяОбработка_ИменаТаблицДокументов(МенеджерВТ, Организация, Период, ТипыДокументов);
	
	ТекстУсловия = "
	|
	|ГДЕ
	|	ТабДок.ДокументУчета В (&ПодходящиеДокументыУчета)";
	
	ТекстЗапроса = ТекстЗапроса_ТаблицаДокументовДляГрупповойОбработки(ИменаТаблицДокументов, ТекстУсловия);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("СтатусНовый", СтатусыДокументовУчета.Новый);
	Запрос.УстановитьПараметр("ДействиеНачатьРаботу", ТребуемыеДействия.НачатьРаботу);
	Запрос.УстановитьПараметр("ПодходящиеДокументыУчета", ПодходящиеДокументыУчета);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	МенеджерВТ.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция ГрупповаяОбработка_ИменаТаблицДокументов(МенеджерВТ, Организация, Период, ТипыДокументов)
	
	ПодходящиеНастройки = Новый Массив;
	
	НастройкиДокументов = ДействующиеНастройкиДокументовУчета();
	Для Каждого Элемент Из ДействующиеНастройкиДокументовУчета() Цикл
		Если МассивСодержитЗначение(ТипыДокументов, Элемент.ТипДокумента) Тогда
			ПодходящиеНастройки.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаДокументов_ВТ_ДобавитьОрганизации1С(МенеджерВТ, Организация);
	ТаблицаДокументов_ВТ_ДобавитьСклады1С(МенеджерВТ, Организация);
	
	Возврат ТаблицаДокументов_ВТ_Подготовить(МенеджерВТ, ПодходящиеНастройки, Период);
	
КонецФункции

Функция ТекстЗапроса_ТаблицаДокументовДляГрупповойОбработки(ИменаТаблицДокументов, ТекстУсловия = Неопределено)
	
	Результат = "";
	Разделитель = "";
	ТекстЗапроса = "";
	ПерваяНастройка = Истина;
	
	Для Каждого ИмяТаблицы Из ИменаТаблицДокументов Цикл
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ИСТИНА КАК Пометка,
		|	ТабДок.Организация КАК Организация,
		|	ТабДок.Документ1С КАК Документ1С,
		|	ТабДок.ДокументУчета КАК ДокументУчета,
		|	ТабДок.Номер КАК Номер,
		|	ТабДок.Дата КАК Дата,
		|	ТабДок.Контрагент КАК Контрагент,
		|	ТабДок.Склад КАК Склад,
		|	ТабДок.Сумма КАК Сумма,
		|	ТабДок.ТипДокумента КАК ТипДокумента,
		|	ТабДок.ОтражениеВЭДО КАК ОтражениеВЭДО,
		|	ТабДок.Комментарий КАК Комментарий,
		|	ЕСТЬNULL(ОсновныеСтатусы.Статус, &СтатусНовый) КАК Статус,
		|	ЕСТЬNULL(ТребуемыеДействия.Статус, &ДействиеНачатьРаботу) КАК ТребуемоеДействие
		|ИЗ
		|	ТекущаяТаблица КАК ТабДок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ОсновныеСтатусы
		|		ПО (ОсновныеСтатусы.ДокументУчета = ТабДок.ДокументУчета)
		|			И (ОсновныеСтатусы.ТипСтатуса = ""ОсновнойСтатус"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ТребуемыеДействия
		|		ПО (ТребуемыеДействия.ДокументУчета = ТабДок.ДокументУчета)
		|			И (ТребуемыеДействия.ТипСтатуса = ""ТребуемоеДействие"")";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекущаяТаблица", ИмяТаблицы);
		
		Если ПерваяНастройка Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
		КонецЕсли;
		
		ПерваяНастройка = Ложь;
		
		Результат = Результат + Разделитель + ТекстЗапроса + ТекстУсловия;
		
		Разделитель = "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
		
	КонецЦикла;
	
	Результат = Результат + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Номер УБЫВ";
	
	Возврат Результат;
	
КонецФункции

Процедура ГрупповаяОбработка_ТаблицаДокументов_ДобавитьРеквизитыКонтрагента(ТаблицаДокументов)
	
	Если Не ЗначениеЗаполнено(ТаблицаДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДокументов.Колонки.Добавить("КонтрагентИНН");
	ТаблицаДокументов.Колонки.Добавить("КонтрагентКПП");
	Для Каждого Стр Из ТаблицаДокументов Цикл
		РеквизитыКонтрагента = Интеграция_РеквизитыКонтрагента1С(Стр.Контрагент);
		Стр.КонтрагентИНН = РеквизитыКонтрагента.ИНН;
		Стр.КонтрагентКПП = РеквизитыКонтрагента.КПП;
	КонецЦикла;

КонецПроцедуры

Процедура ГрупповаяОбработка_СоздатьОперации(ТаблицаДокументов, ТаблицаОпераций, ТипОперации, ОбрабатыватьТолькоПозицииПУ = Ложь) Экспорт
	
	ОтраженияВЭДО = Перечисление_ОтраженияВЭДО();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Для Каждого Стр Из ТаблицаДокументов Цикл
			
			ОписаниеОперации = Новый_Операция();
			ОписаниеОперации.ТипОперации = ТипОперации;
			ОписаниеОперации.ДокументУчета = Стр.ДокументУчета;
			
			ТаблицаКодов = Новый_ТаблицаКодов();
			
			Если ОбрабатыватьТолькоПозицииПУ Тогда
				ОписаниеОперации.ДопРеквизиты.ОтражениеВЭДО = ОтраженияВЭДО.ПУ;
			КонецЕсли;
			
			Операция_Заполнить(ОписаниеОперации, ТаблицаКодов);
			
			Операция = Операция_Записать(ОписаниеОперации);
			КодыОпераций_Записать(ТаблицаКодов, Операция);
			
			НоваяСтрока = ТаблицаОпераций.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, , "ЕстьОшибки");
			НоваяСтрока.Операция = Операция;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Возвращает все типы документов учета, подходящие для создания операций указанного типа
//
// Параметры:
//  ТипОперации - Строка - тип операции, см. Перечисление_ТипыОпераций();
// 
// Возвращаемое значение:
//  Массив - содержит наименования типов документов;
//
Функция ТипыДокументовДляГрупповойОбработкиОпераций(ТипОперации)
	
	Результат = Новый Массив;
	
	ТипыДокументовНастроекЗаполнения = НастройкиЗаполненияОпераций_ТипыДокументов(ТипОперации);
	ТипыДокументовРабочегоСтола = НастройкиРабочегоСтола_ТипыДокументов();
	
	Если Не ЗначениеЗаполнено(ТипыДокументовРабочегоСтола) Тогда
		Результат = ТипыДокументовНастроекЗаполнения;
	Иначе
		Для Каждого ТипДокумента Из ТипыДокументовНастроекЗаполнения Цикл
			Если МассивСодержитЗначение(ТипыДокументовРабочегоСтола, ТипДокумента) Тогда
				Результат.Добавить(ТипДокумента);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

