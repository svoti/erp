Функция ДокументыУчета_ЕстьНезавершенныеОперации(ДокументыУчета, ТипыОпераций)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	""ЕстьНезавершенныеОперации"" КАК Вывод
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО Операции.Ссылка = СтатусыОпераций.Операция
	|			И (СтатусыОпераций.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	Операции.ДокументУчета В(&ДокументыУчета)
	|	И Операции.ТипОперации В(&ТребуемыеТипы)
	|	И НЕ СтатусыОпераций.Статус В (&ЗавершенныеСтатусы)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументыУчета", ЗначениеВМассиве(ДокументыУчета));
	Запрос.УстановитьПараметр("ТребуемыеТипы", ЗначениеВМассиве(ТипыОпераций));
	Запрос.УстановитьПараметр("ЗавершенныеСтатусы", ЗавершенныеСтатусыОпераций());
	Запрос.УстановитьПараметр("ОсновнойСтатус", Перечисление_ТипыСтатусов().ОсновнойСтатус);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

