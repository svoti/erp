	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	
	ТаблицаКодов_ВТ_УдалитьКодыБезВложенныхКодов(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусы);
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ОписаниеОперации.ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ОбщийТипУпаковки = &ТранспортнаяУпаковка
	|	И &ВидПродукции";
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПродукции", "Т.ВидПродукции = &ВидПродукции");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПродукции", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВидПродукции", ОписаниеОперации.ВидПродукции);
	Запрос.УстановитьПараметр("ТранспортнаяУпаковка", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ТаблицаКодов = Запрос.Выполнить().Выгрузить();
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	
КонецПроцедуры

