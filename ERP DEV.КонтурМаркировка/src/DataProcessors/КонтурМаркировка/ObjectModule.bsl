// #Область Инициализация

// Заполняет параметры модуля с проверкой перехода на новую версию и отправкой метрик
//
// Параметры:
//  ИдентификаторСеанса - УникальныйИдентификатор - (необязательный) текущий идентификатор сеанса;
//
Процедура Инициализировать(Знач ИдентификаторСеанса = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		ИдентификаторСеанса = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	ВызыватьИсключение = Истина;
	ПервыйЗапускМодуля = ЭтоПервыйЗапускМодуля();
	
	ПроверитьВерсиюПодсистемы();
	
	ПроверкаВерсии = ПроверитьУстановленнуюВерсиюМодуля(ВызыватьИсключение);
	
	ПроверитьВерсиюДанныхВПодсистеме();
	ПроверитьПереходНаНовуюВерсиюДанных();
	ПроверитьНастройкиТекущегоУзлаРИБ();
	
	ПараметрыСессии_Инициализировать(ИдентификаторСеанса);
	
	ОбновитьТекущегоПользователяМаркировки();
	ОбновитьБиблиотекуКонтроля(Не ПроверкаВерсии.ПереходНаНовуюВерсию);
	ОбновитьФичаФлаги();
	
	Если ПроверкаВерсии.ПереходНаНовуюВерсию Тогда
		ОбновитьПараметрыПриложенияАвторизации();
	КонецЕсли;
	
	Метрики_ПриИнициализации(Перечисление_ДействияМетрики().ЗагрузкаОбработки, ПервыйЗапускМодуля);
	
	ОтправитьМетрики();
	
КонецПроцедуры

// Заполняет параметры модуля без проверки перехода на новую версию
//
// Параметры:
//  ИдентификаторСеанса - УникальныйИдентификатор - (необязательный) текущий идентификатор сеанса;
//
Процедура ИнициализироватьИзОсновнойФормы(Знач ИдентификаторСеанса = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		ИдентификаторСеанса = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	ВызыватьИсключение = Истина;
	ПервыйЗапускМодуля = ЭтоПервыйЗапускМодуля();
	
	ПроверитьВерсиюПодсистемы();
	
	ПроверкаВерсии = ПроверитьУстановленнуюВерсиюМодуля(ВызыватьИсключение);
	
	ПроверитьВерсиюДанныхВПодсистеме();
	ПроверитьНастройкиТекущегоУзлаРИБ();
	
	ПараметрыСессии_Инициализировать(ИдентификаторСеанса);
	
	ОбновитьТекущегоПользователяМаркировки();
	ОбновитьБиблиотекуКонтроля(Не ПроверкаВерсии.ПереходНаНовуюВерсию);
	ОбновитьФичаФлаги();
	
	Если ПроверкаВерсии.ПереходНаНовуюВерсию Тогда
		ОбновитьПараметрыПриложенияАвторизации();
	КонецЕсли;
	
	Метрики_ПриИнициализации(Перечисление_ДействияМетрики().ОткрытиеОсновнойФормы, ПервыйЗапускМодуля);
	
КонецПроцедуры

// Проверяет, что параметры сеанса заполнены и соответствуют запущеному модулю
//
// Параметры:
//  ИдентификаторСеанса - УникальныйИдентификатор - (необязателный) текущий идентификатор сеанса;
// 
// Возвращаемое значение:
//  Истина - если параметры сеанса соотвествуют запущеному модулю;
//
Функция МодульИнициализирован(ИдентификаторСеанса = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ИдентификаторСеанса) Тогда
		Результат = (ИдентификаторСеанса = ПараметрыСессии_ИдентификаторСеанса());
	Иначе
		Результат = (ВерсияОбработки() = ПараметрыСессии_ВерсияМодуля());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Инициализация

// #Область ОбновлениеДанныхПодсистемы

// Версия данных в подсистеме,
// с которой может работать модуль
// 
// Возвращаемое значение:
//  Строка - версия последнего обработчика обновления, который есть в модуле
//
Функция ТребуемаяВерсияДанныхПодсистемы() Экспорт
	
	ОбработчикиОбновления = ОбработчикиОбновленияДанных();
	ПоследнийОбработчик = ОбработчикиОбновления[ОбработчикиОбновления.ВГраница()];
	
	Возврат ПоследнийОбработчик.ВерсияДанных;
	
КонецФункции

// Проверяет что подсистема КонтурМаркировка установлена
// и соответствует требуемой для текущего модуля версии
//
Процедура ПроверитьВерсиюПодсистемы()
	
	ТребуетсяВерсия = ТребуемаяВерсияПодсистемы();
	УстановленаВерсия = ВерсияУстановленнойБиблиотеки();
	ИмяПодсистемы = СведенияОВнешнейОбработке().Наименование;
	
	Если УстановленаВерсия = Неопределено Тогда
		
		ТекстОшибки = "ru = ""Необходимо добавить в конфигурацию подсистему "
		+ ИмяПодсистемы + " версии " + ТребуетсяВерсия + """";
		ВызватьИсключение НСтр(ТекстОшибки, "ru");
		
	ИначеЕсли УстановленаВерсия <> ТребуетсяВерсия Тогда
		
		ТекстОшибки = "ru = ""Необходимо обновить подсистему " + ИмяПодсистемы + "
		|Текущая версия подсистемы: " + УстановленаВерсия +"
		|Версия, с которой может работать модуль: " + ТребуетсяВерсия + """";
		ВызватьИсключение НСтр(ТекстОшибки, "ru");
		
	Иначе
		
		// Подсистема подходит текущему модулю
		
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, что версия данных в базе не выше той,
// с которой может работать текущий модуль
//
// Если это первый запуск модуля,
// то в базу будет записана текущая версия данных
//
Процедура ПроверитьВерсиюДанныхВПодсистеме()
	
	ТребуемаяВерсияДанных = ТребуемаяВерсияДанныхПодсистемы();
	ВерсияДанныхВБазе = ВерсияДанныхПодсистемы();
	ЭтоПервыйЗапуск = (ВерсияДанныхВБазе = ПустаяВерсия());
	
	Если ЭтоПервыйЗапуск Тогда
		
		ВерсияДанныхПодсистемы_Записать(ТребуемаяВерсияДанных);
		
	Иначе
		
		Если СравнитьВерсии(ВерсияДанныхВБазе, ТребуемаяВерсияДанных) > 0 Тогда
			
			ВызватьИсключение ПараметрыВСтроку(НСтр(
			"ru = 'Версия данных в базе %1
			|Модуль может работать с версией не выше чем %2'")
			, ВерсияДанныхВБазе, ТребуемаяВерсияДанных);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывает исключение, если переход на новую версию данных не был выполнен
//
Процедура ПроверитьПереходНаНовуюВерсиюДанных()
	
	Если НеобходимоПерейтиНаНовуюВерсиюДанных() Тогда
		
		ИмяМодуля = СведенияОВнешнейОбработке().Наименование;
		ТребуемаяВерсияДанных = ТребуемаяВерсияДанныхПодсистемы();
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Необходимо открыть модуль %1,
		|чтобы перейти на новую версию данных %2'")
		, ИмяМодуля, ТребуемаяВерсияДанных);
		
	КонецЕсли;
	
КонецПроцедуры

// Сверяет версию данных в базе и версию данных, которая требуется текущему модулю
// 
// Возвращаемое значение:
//  Булево - Истина, если версию данных в базе необходимо обновить до требуемой
//
Функция НеобходимоПерейтиНаНовуюВерсиюДанных() Экспорт
	
	Возврат СравнитьВерсии(ВерсияДанныхПодсистемы(), ТребуемаяВерсияДанныхПодсистемы()) < 0;
	
КонецФункции

// Выполняет обработчики обновления для перехода на новую версию данных
// в подсистеме КонтурМаркировка
//
Процедура ПерейтиНаНовуюВерсиюДанных() Экспорт
	
	Если Не ЗанятьОбновлениеДанныхПодсистемы() Тогда
		Возврат;
	КонецЕсли;
	
	Обработчики = ОбработчикиОбновленияДанных();
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	
	Для Сч = 0 По Обработчики.ВГраница() Цикл
		
		Обработчик = Обработчики[Сч];
		ТекущаяВерсия = ВерсияДанныхПодсистемы();
		
		Если СравнитьВерсии(Обработчик.ВерсияДанных, ТекущаяВерсия) <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяМетода = ПараметрыВСтроку("ПерейтиНаВерсиюДанных_%1", СтрЗаменить(Обработчик.ВерсияДанных, ".", "_"));
		
		Попытка
			
			Выполнить(ИмяМетода + "(Обработчик)");
			
			Если Обработчик.ФоновоеОбновление И Сч < Обработчики.ВГраница() Тогда
				// Если обработчик не последний, то фоновую часть придется выполнить синхронно,
				// чтобы гарантировать консистентность данных в следующих обработчиках
				ОбновитьДанныеПодсистемы();
			КонецЕсли;
			
			ВерсияДанныхПодсистемы_Записать(Обработчик.ВерсияДанных);
			
		Исключение
			Ошибка = ИнформацияОбОшибке();
			ОсвободитьОбновлениеДанныхПодсистемы();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	// BSLLS:SetPrivilegedMode-on
	
	ОсвободитьОбновлениеДанныхПодсистемы();
	
КонецПроцедуры

Функция ОбработчикиОбновленияДанных()
	
	ВерсииДанных = Перечисление_ВерсииДанныхПодсистемы();
	
	Результат = Новый Массив;
	
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_0_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_2_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_3_2));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_5_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_6_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_7_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_9_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_11_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_14_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_15_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_16_0, Истина));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_17_4));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_18_0, Истина));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_19_0));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_19_6));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_23_2));
	Результат.Добавить(Новый_ОбработчикОбновления(ВерсииДанных.Версия_3_24_0, Истина));
	
	Возврат Результат;
	
КонецФункции

