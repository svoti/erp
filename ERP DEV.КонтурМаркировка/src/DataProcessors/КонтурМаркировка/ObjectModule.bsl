Функция ПредставленияПравилОтраженияВЭДО() Экспорт
	
	КлючКэш = "ПредставленияПравилОтраженияВЭДО";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПравилаОтражения = Перечисление_ПравилаОтраженияВЭДО();
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(ПравилаОтражения.ПУ,             НСтр("ru = 'ПУ (Только поэкземплярный учет)'"));
	Результат.Вставить(ПравилаОтражения.ОСУ,            НСтр("ru = 'ОСУ (Допускается объемно-сортовой учет)'"));
	Результат.Вставить(ПравилаОтражения.ПартионныйУчет, НСтр("ru = 'Партионный учет'"));
	Результат.Вставить(ПравилаОтражения.НеОтражать,     НСтр("ru = 'Не отражать'"));
	
	Возврат Результат;
	
