	Операция_ЗаполнитьТипСрокаГодности(ОписаниеОперации);
	Операция_ЗаполнитьСостояниеКодов(ОписаниеОперации);
	
	Операция_ЗаполнитьПричинуВыводаИзОборота(ОписаниеОперации);
	Операция_ЗаполнитьСпособВыпускаТоваровНаОстатки(ОписаниеОперации);
	Операция_ЗаполнитьТипОтгрузки(ОписаниеОперации);
	Операция_ЗаполнитьГруппуТНВЭД(ОписаниеОперации);
	Операция_ЗаполнитьВидАгрегата(ОписаниеОперации);
	
	Операция_ЗаполнитьЗначенияПоУмолчанию(ОписаниеОперации);
	Операция_ЗаполнитьТЧЗначениямиПоУмолчанию(ОписаниеОперации);
	
	Операция_ЗаполнитьПроизводительИСобственникТовараИНН(ОписаниеОперации);
	Операция_ЗаполнитьДатуПроизводства(ОписаниеОперации);
	Операция_ЗаполнитьСрокГодности(ОписаниеОперации);
	Операция_ЗаполнитьАльтернативныеСрокиГодности(ОписаниеОперации);
	
	Операция_ЗаполнитьИзНастроекЗаполнения(ОписаниеОперации);
	
	ПМ_ОбработатьСобытие_ПриЗаполненииОперации(ОписаниеОперации, ТаблицаКодов);
	Операция_ЗаполнитьТоварыОперацииПослеВызоваПМ(ОписаниеОперации);
	
	Операция_СгруппироватьСтрокиТоваров(ОписаниеОперации, ТаблицаКодов);
	
