Процедура ПерейтиНаВерсиюДанных_3_14_0_ОбновитьКодСтраныВводВОборотТрансгран()
	
	ИмяДопРеквизита = "КодСтраныЭкспортера";
	ДлинаКодаСтраны = 3;
	
	СтарыеЗначения = Новый Массив;
	СтарыеЗначения.Добавить("398 - Казахстан");
	СтарыеЗначения.Добавить("112 - Белоруссия");
	СтарыеЗначения.Добавить("417 - Киргизия");
	СтарыеЗначения.Добавить("051 - Армения");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьЗаписи
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДопРеквизит
	|		ПО Операции.Ссылка = ДопРеквизит.Объект
	|			И (ДопРеквизит.ИмяРеквизита = &ИмяДопРеквизита)
	|			И (ДопРеквизит.Значение В (&СтарыеЗначения))
	|ГДЕ
	|	Операции.ТипОперации = &ВводВОборот");
	Запрос.УстановитьПараметр("ИмяДопРеквизита", ИмяДопРеквизита);
	Запрос.УстановитьПараметр("СтарыеЗначения", СтарыеЗначения);
	Запрос.УстановитьПараметр("ВводВОборот", Перечисление_ТипыОпераций().ВводВОборот);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.КонтурМаркировка_ДопРеквизиты.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИмяРеквизита.Установить(ИмяДопРеквизита);
	НаборЗаписей.Прочитать();
	Для Каждого Запись Из НаборЗаписей Цикл
		Если СтарыеЗначения.Найти(Запись.Значение) <> Неопределено Тогда
			Запись.Значение = Лев(Запись.Значение, ДлинаКодаСтраны);
		КонецЕсли;
	КонецЦикла;
	
	Если НаборЗаписей.Модифицированность() Тогда
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

