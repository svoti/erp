Процедура ПМ_ОбработатьСобытие_ПриЗаполненииОперации(ОписаниеОперации, ТаблицаКодов)
	
	ЗаполнитьОписаниеОперацииДляСовместимостиПМ(ОписаниеОперации);
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Документ1С = ДокументУчета_Документ1С(ДокументУчета);
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ1С", Документ1С);
	ПараметрыПМ.Вставить("ТаблицаКодов", ТаблицаКодов);
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("ОписаниеОперации", ОписаниеОперации);
	ПМ_ОбработатьСобытие("ПриЗаполненииОперации", ПараметрыПМ);
	
	ТаблицаКодов = ПараметрыПМ.ТаблицаКодов;
	
	ВосстановитьОписаниеОперацииПослеВызоваПМ(ОписаниеОперации);
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПриИзмененииОперации(ОписаниеОперации, ТаблицаКодов) Экспорт
	
	ВерсияПМ = ВерсияОбработкиПМ();
	
	Если ЗначениеЗаполнено(ВерсияПМ) И СравнитьВерсии(ВерсияПМ, "3.6.4") < 0 Тогда
		ОписаниеОперацииДляПМ = СкопироватьОбъект(ОписаниеОперации);
		ПМ_ОбработатьСобытие_ПриЗаполненииОперации(ОписаниеОперацииДляПМ, ТаблицаКодов);
		ОписаниеОперации.Товары = ОписаниеОперацииДляПМ.Товары;
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписаниеОперацииДляСовместимостиПМ(ОписаниеОперации);
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Документ1С = ДокументУчета_Документ1С(ДокументУчета);
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ОписаниеОперации", ОписаниеОперации);
	ПараметрыПМ.Вставить("ТаблицаКодов", ТаблицаКодов);
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("Документ1С", Документ1С);
	ПМ_ОбработатьСобытие("ПриИзмененииОперации", ПараметрыПМ);
	
	ТаблицаКодов = ПараметрыПМ.ТаблицаКодов;
	
	ВосстановитьОписаниеОперацииПослеВызоваПМ(ОписаниеОперации);
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПриВыгрузкеКодовВФайл(ПараметрыПМ, СтандартнаяОбработка)
	
	ЗаполнитьТаблицуКодовДляСовместимостиПМ(ПараметрыПМ.ТаблицаКодов);
	
	ПМ_ОбработатьСобытие("ПриВыгрузкеКодовВФайл", ПараметрыПМ, СтандартнаяОбработка);
	
	ВосстановитьТаблицуКодовДляСовместимостиМодуль(ПараметрыПМ.ТаблицаКодов);
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПередОткрытиемРабочегоСтола(ПараметрыПМ) Экспорт
	
	ПМ_ОбработатьСобытие("ПередОткрытиемРабочегоСтола", ПараметрыПМ);
	
КонецПроцедуры

Функция ПМ_ТаблицаКодовДляНовогоДокумента(ОписаниеДокумента) Экспорт
	
	ЗаполнитьОписаниеДокументаДляСовместимостиПМ(ОписаниеДокумента);
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ОписаниеДокумента", ОписаниеДокумента);
	ПараметрыПМ.Вставить("Документ1С", ОписаниеДокумента.Документ1С);
	ПараметрыПМ.Вставить("ТаблицаКодов", Новый_ТаблицаКодов());
	ПараметрыПМ.Вставить("ПараметрыЗагрузкиКодов", Новый_ПараметрыЗагрузкиНовыхКодовВДокумент());

	ПараметрыПМ.ПараметрыЗагрузкиКодов.УдалитьСтарыеКоды = Истина;
	
	ПМ_ОбработатьСобытие_ПриЗагрузкеКодовВНовыйДокументУчета(ПараметрыПМ);
	
	ВосстановитьОписаниеДокументаПослеВызоваПМ(ОписаниеДокумента);
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаКодов", ПараметрыПМ.ТаблицаКодов);
	Результат.Вставить("ПараметрыЗагрузкиКодов", ПараметрыПМ.ПараметрыЗагрузкиКодов);
	
	Возврат Результат;
	
КонецФункции

