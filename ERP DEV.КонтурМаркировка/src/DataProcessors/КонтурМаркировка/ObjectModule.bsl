Функция ПолноеНаименованиеОрганизации1С(Организация1С)
	
	Если Не ЗначениеЗаполнено(Организация1С) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяСправочника = Организация1С.Метаданные().ПолноеИмя();
	
	Если ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.НаименованиеПолное") Тогда
		НаименованиеПолное = ЗначениеРеквизитаОбъектаЛок(Организация1С, "НаименованиеПолное");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
		Результат = СокрЛП(НаименованиеПолное);
	Иначе
		Результат = СокрЛП(Организация1С);
	КонецЕсли;
	
