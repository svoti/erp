	Элемент.ОграничениеТипа = ОписаниеТипа;
	
КонецПроцедуры

// Добавляет условие по номенклатуре владельцу
// для выбора связанных с ней значений
//
Процедура УстановитьСвязьЭлементовПоНоменклатуре(Элемент) Экспорт
	
	ПараметрыВыбора = Новый Массив;
	
	ЕстьОбщиеХарактеристики = Интеграция_ЕстьОбщиеХарактеристики();
	Если Не ЕстьОбщиеХарактеристики Тогда
		
		ИмяПараметра = "Отбор.Владелец";
		ПутьКДанным	 = "Номенклатура";
		ПараметрВыбора = Новый СвязьПараметраВыбора(ИмяПараметра, ПутьКДанным);
		ПараметрыВыбора.Добавить(ПараметрВыбора);
		
	КонецЕсли;
	
	ИмяПараметра = "Номенклатура";
	ПутьКДанным	 = "Номенклатура";
	ПараметрВыбора = Новый СвязьПараметраВыбора(ИмяПараметра, ПутьКДанным);
	ПараметрыВыбора.Добавить(ПараметрВыбора);
	
	ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	
	Элемент.СвязиПараметровВыбора = ПараметрыВыбора;
	
КонецПроцедуры

