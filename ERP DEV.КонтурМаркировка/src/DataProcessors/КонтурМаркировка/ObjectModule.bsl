Процедура ДокументУчета_ЗаполнитьЭтапыМаркировки(ОписаниеДокумента)
	
	МаршрутМаркировки = ОписаниеДокумента.МаршрутМаркировки;
	Если Не ЗначениеЗаполнено(МаршрутМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеМаршрута = МаршрутМаркировки_Прочитать(МаршрутМаркировки);
	Для Каждого Стр Из ОписаниеМаршрута.ЭтапыМаркировки Цикл
		
		Если Стр.Пропущен Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ОписаниеДокумента.ЭтапыМаркировки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументыУчета_ПереданыСведенияОМаркировке_Записать(ДокументыУчета)
	
	ИмяСвойства = Перечисление_ДопСвойства().ПереданыСведенияОМаркировке;
	
	Для Каждого ДокументУчета Из ЗначениеВМассиве(ДокументыУчета) Цикл
		ДопСвойство_Записать(ДокументУчета, ИмяСвойства, Истина);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_РаспределитьКодыМаркировки(ДокументУчета) Экспорт
	
	ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
	ТоварыДокумента = ДокументУчета.ТоварыДокумента;
	ТоварыМаркировки = ДокументУчета.ТоварыМаркировки;
	
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
	ТаблицаКодов.ЗаполнитьЗначения(ПустойУникальныйИдентификатор(), "КлючСтрокиДокумента");
	ТаблицаКодов_РаспределитьКлючиСтрокДокумента(ТаблицаКодов, ТоварыДокумента, ТоварыМаркировки);
	
	КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
	
КонецПроцедуры

