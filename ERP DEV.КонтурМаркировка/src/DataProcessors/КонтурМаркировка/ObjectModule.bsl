Функция ДатаПоследнегоОбмена(Организация = Неопределено) Экспорт
	
	ДопСвойства = Перечисление_ДопСвойства();
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ОрганизацииДляОбмена = ЗначениеВМассиве(Организация);
	Иначе
		ОрганизацииДляОбмена = Организация_ВсеОрганизацииДляОбмена();
	КонецЕсли;
	
	Результат = '00010101';
	Для Каждого ОрганизацияДляОбмена Из ОрганизацииДляОбмена Цикл
		ДатаПоследнегоОбмена = ДопСвойство_Прочитать(ОрганизацияДляОбмена, ДопСвойства.ДатаПоследнегоОбмена);
		Если ЗначениеЗаполнено(ДатаПоследнегоОбмена) Тогда
