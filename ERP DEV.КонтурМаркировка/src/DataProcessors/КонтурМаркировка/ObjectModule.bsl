Функция МодульКонтроль() Экспорт
	
	ИмяФайла = ИмяФайлаМодуляКонтроль();
	
	Если НастройкиМодуля_РежимОтладкиВключен() Тогда
		Попытка
			Результат = ОбъектВложеннойОбработки(ИмяФайла);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	ВерсияПоУмолчанию = ВерсияБиблиотекиКонтроляПоУмолчанию();
	УстановленнаяВерсия = ВерсияУстановленнойБиблиотекиКонтроля();
	
	Если Результат = Неопределено
		И МодульМаркировкиОткрытИзКонфигурации()
		И СравнитьВерсии(УстановленнаяВерсия, ВерсияПоУмолчанию) <= 0 Тогда
		Результат = ОбъектВложеннойОбработкиИзКонфигурации(ИмяФайла);
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = ОбъектВложеннойОбработки(ИмяФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеМодуляКонтроль()
	
	Результат = Новый_ОписаниеОбработки();
	Результат.ПутьКФайлу = ПутьКФайлуМодуляКонтроль();
	Результат.ДвоичныеДанные = ДвоичныеДанныеБиблиотекиКонтроля();
	Результат.ИмяОбработки = ИмяОбработкиПоИмениФайла(ИмяФайлаМодуляКонтроль());
	
	Возврат Результат;
	
КонецФункции

