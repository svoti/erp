Функция ДоступенПереносИзРегистраПлагинаОСУ() Экспорт
	
	ИмяРегистра = "КонтурМаркировкаОСУ_СведенияОбУпаковках";
	
	Если Не ЕстьНеобходимыеМетаданные("РегистрыСведений." + ИмяРегистра) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// В регистре настроен тип номенклатуры (по умлочанию Булево)
	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если МетаданныеРегистра.Измерения.Номенклатура.Тип.СодержитТип(Тип("Булево")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА ИЗ РегистрСведений." + ИмяРегистра + " КАК Т");
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДанныеДиадок_МассивGTIN() Экспорт
	
	Если Не ДоступенПереносИзРегистраПлагинаОСУ() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.GTIN КАК GTIN
	|ИЗ
	|	РегистрСведений.КонтурМаркировкаОСУ_СведенияОбУпаковках КАК Т");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(GTINизШтрихкодаEAN(Выборка.GTIN));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеДиадок_ПереносРегистраКоэффициентыПересчета() Экспорт
	
	ТипЧисло = ОписаниеТипа_Число();
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КлючНоменклатуры1С", ОписаниеТипа_КлючНоменклатуры1С());
	Результат.Колонки.Добавить("Знаменатель", ТипЧисло);
	Результат.Колонки.Добавить("Числитель", ТипЧисло);
	
	Если Не ДоступенПереносИзРегистраПлагинаОСУ() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Упаковка КАК Упаковка,
	|	НЕОПРЕДЕЛЕНО КАК Серия,
	|	Т.Знаменатель КАК Знаменатель,
	|	Т.Числитель КАК Числитель
	|ИЗ
	|	РегистрСведений.КонтурМаркировкаОСУ_СведенияОбУпаковках КАК Т");
	ТабДиадока = Запрос.Выполнить().Выгрузить();
	ТабДиадока.Колонки.Добавить("КлючНоменклатуры1С", ОписаниеТипа_КлючНоменклатуры1С());
	
	Для Каждого Стр Из ТабДиадока Цикл
		Стр.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр);
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.Знаменатель КАК Знаменатель,
	|	Т.Числитель КАК Числитель
	|ПОМЕСТИТЬ ТабДиадока
	|ИЗ
	|	&ТабДиадока КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючНоменклатуры1С;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДиадока.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТабДиадока.Знаменатель КАК Знаменатель,
	|	ТабДиадока.Числитель КАК Числитель
	|ИЗ
	|	ТабДиадока КАК ТабДиадока
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КоэффициентыПересчета КАК КоэффициентыПересчета
	|		ПО ТабДиадока.КлючНоменклатуры1С = КоэффициентыПересчета.КлючНоменклатуры1С
	|ГДЕ
	|	КоэффициентыПересчета.КлючНоменклатуры1С ЕСТЬ NULL");
	Запрос.УстановитьПараметр("ТабДиадока", ТабДиадока);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.КлючНоменклатуры1С) Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

