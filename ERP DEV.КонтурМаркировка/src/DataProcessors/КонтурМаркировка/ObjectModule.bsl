Процедура ПерейтиНаВерсиюДанных_3_18_0_СоздатьРазрешительныеДокументыПоДаннымТоваров()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Товар,
	|	Товары.ВидДокументаСертификации КАК ВидДокумента,
	|	Товары.НомерДокументаСертификации КАК Номер,
	|	Товары.ДатаДокументаСертификации КАК ДатаОформления
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Товары.РазрешительнаяДокументация КАК РД
	|		ПО Товары.Ссылка = РД.Ссылка
	|			И (РД.НомерСтроки = 1)
	|ГДЕ
	|	Товары.ВидДокументаСертификации <> """"
	|	И Товары.НомерДокументаСертификации <> """"
	|	И Товары.ДатаДокументаСертификации <> ДАТАВРЕМЯ(1, 1, 1)
	|	И РД.Ссылка ЕСТЬ NULL");
	
	РазмерТранзакции = 1000;
	МодульЯдро = МодульЯдро();
	КэшРД = Новый Соответствие;
	
	ТаблицаТоваров = Запрос.Выполнить().Выгрузить();
	Для Каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаТоваров, , РазмерТранзакции) Цикл
		
		НачатьТранзакцию(РежимУправленияБлокировкой());
		
		Попытка
			
			Для Каждого Стр Из ЧастьТаблицы.МассивСтрок Цикл
				
				РазрешительныйДокумент = КэшРД[Стр.Номер];
				Если РазрешительныйДокумент = Неопределено Тогда
					ОписаниеРД = Новый_РазрешительныйДокумент();
					ЗаполнитьЗначенияСвойств(ОписаниеРД, Стр);
					РазрешительныйДокумент = МодульЯдро.РазрешительныйДокумент_Записать(ОписаниеРД);
					КэшРД.Вставить(Стр.Номер, РазрешительныйДокумент);
				КонецЕсли;
				
				ОбъектТовара = Стр.Товар.ПолучитьОбъект();
				Стр = ОбъектТовара.РазрешительнаяДокументация.Добавить();
				Стр.РазрешительныйДокумент = РазрешительныйДокумент;
				Стр.Основной = Истина;
				ОбъектТовара.ОбменДанными.Загрузка = Истина;
				ОбъектТовара.Записать();
				
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

