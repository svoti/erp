Функция ВыгрузитьВсеВложенныеОбработкиВКаталогОтладки() Экспорт
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(НастройкиМодуля().КаталогОтладки) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для каждого ОписаниеОбработки Из ВложенныеОбработки() Цикл
		Если ЗначениеЗаполнено(ОписаниеОбработки.ПутьКФайлу) Тогда
			ОписаниеОбработки.ДвоичныеДанные.Записать(ОписаниеОбработки.ПутьКФайлу);
			Если МодульОбщегоНазначения().ФайлСуществует(ОписаниеОбработки.ПутьКФайлу) Тогда
				Результат.Добавить(ОписаниеОбработки.ПутьКФайлу);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДополнитьМассив(Результат, ВыгрузитьВсеПлагиныВКаталогОтладки());
	
	Возврат Результат;
	
КонецФункции

Функция ВложенныеОбработки()
	
	Результат = Новый Массив;
	
	Результат.Добавить(ОписаниеМодуляЯдро());
	Результат.Добавить(ОписаниеМодуляКонтроль());
	Результат.Добавить(ОписаниеМодуляБиблиотекаПлагинов());
	
	Возврат Результат;
	
КонецФункции

