Функция Номенклатура1С_ЗначенияПоУмолчанию(Номенклатура, Результат = Неопределено)
	
	Если Результат = Неопределено Тогда
		Результат = Новый Структура;
		Результат.Вставить("КодТНВЭД");
		Результат.Вставить("ВидДокументаСертификации");
		Результат.Вставить("НомерДокументаСертификации");
		Результат.Вставить("ДатаДокументаСертификации");
		Результат.Вставить("НомерЛицензииНаНедра");
		Результат.Вставить("ДатаЛицензииНаНедра");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СвойстваОбъектов = Перечисление_СвойстваОбъектов1С();
	
	Если Не ЗначениеЗаполнено(Результат.КодТНВЭД) Тогда
		Результат.КодТНВЭД = ДопСвойство_Прочитать(Номенклатура, СвойстваОбъектов.КодТНВЭД);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.НомерДокументаСертификации) Тогда
		Результат.ВидДокументаСертификации = ДопСвойство_Прочитать(Номенклатура, СвойстваОбъектов.ВидДокументаСертификации);
		Результат.НомерДокументаСертификации = ДопСвойство_Прочитать(Номенклатура, СвойстваОбъектов.НомерДокументаСертификации);
		Результат.ДатаДокументаСертификации = ДопСвойство_Прочитать(Номенклатура, СвойстваОбъектов.ДатаДокументаСертификации);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.НомерЛицензииНаНедра) Тогда
		Результат.НомерЛицензииНаНедра = ДопСвойство_Прочитать(Номенклатура, СвойстваОбъектов.НомерЛицензииНаНедра);
		Результат.ДатаЛицензииНаНедра = ДопСвойство_Прочитать(Номенклатура, СвойстваОбъектов.ДатаЛицензииНаНедра);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.КодТНВЭД)
		Или Не ЗначениеЗаполнено(Результат.НомерДокументаСертификации)
		Или Не ЗначениеЗаполнено(Результат.НомерЛицензииНаНедра) Тогда
		
		Если СправочникНоменклатурыСодержитГруппы() Тогда
			Родитель = ЗначениеРеквизитаОбъектаЛок(Номенклатура, "Родитель");
			Номенклатура1С_ЗначенияПоУмолчанию(Родитель, Результат);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив GTIN, для всей маркируемой номенклатуры на основании штрихкодов
//
// Возвращаемое значение:
//  Массив - содержит строки GTIN;
//
Функция Номенклатура1С_МассивGTIN(МассивНоменклатуры = Неопределено, ВызыватьИсключение = Истина) Экспорт
	
	Результат = Новый Массив;
	
	ТипыОбъектов = ТипыОбъектовИС();
	Если Не ЗначениеЗаполнено(ТипыОбъектов.РегистрШтрихкодов.ПолноеИмя) Тогда
		Если ВызыватьИсключение Тогда
			ВызватьИсключение НСтр("ru = 'Не определен тип регистра штрихкодов'");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Номенклатура1С_ВТ_ДобавитьТаблицуНоменклатуры(МенеджерВТ, МассивНоменклатуры);
	Если Не ЗапросПоддерживаетЧтениеИдентификатора() Тогда
		Номенклатура1С_ВТ_ДобавитьКлючиНоменклатуры(МенеджерВТ);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрШтрихкодов КАК Штрихкоды
	|		ПО ТаблицаНоменклатуры.Номенклатура = Штрихкоды.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвойстваОбъектов1С КАК НеПодлежитМаркировке
	|		ПО ТаблицаНоменклатуры.КлючНоменклатуры = НеПодлежитМаркировке.КлючОбъекта
	|			И (ТаблицаНоменклатуры.ТипКлючаНоменклатуры = НеПодлежитМаркировке.ТипКлючаОбъекта)
	|			И (НеПодлежитМаркировке.ИмяСвойства = &НеПодлежитМаркировке)
	|ГДЕ
	|	ЕСТЬNULL(НеПодлежитМаркировке.Значение, ЛОЖЬ) = ЛОЖЬ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрШтрихкодов", ТипыОбъектов.РегистрШтрихкодов.ПолноеИмя);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Штрихкоды.Штрихкод", "Штрихкоды." + ТипыОбъектов.РегистрШтрихкодов.ПолеШтрихкод);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Штрихкоды.Номенклатура", "Штрихкоды." + ТипыОбъектов.РегистрШтрихкодов.ПолеНоменклатура);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НеПодлежитМаркировке", Перечисление_СвойстваОбъектов1С().НеПодлежитМаркировке);
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	Пока Выборка.Следующий() Цикл
		GTIN = GTINизШтрихкодаEAN(Выборка.Штрихкод);
		Если ПроверитьКорректностьGTIN(GTIN) Тогда
			Результат.Добавить(GTIN);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив номенклатуры, которая не подлежит маркировке
//
// Параметры:
//  ТолькоГруппы - Булево - (необязательный) Истина, если нужно проверить только группы;
// 
// Возвращаемое значение:
//  Массив - содержит номенклатуру 1С которая не подлежит маркировке
//
Функция Номенклатура1С_НеПодлежитМаркировке(ТолькоГруппы = Ложь) Экспорт
	
	ПолноеИмяНоменклатуры = ПолноеИмяСправочникаНоменклатуры();
	ЕстьГруппы = СправочникНоменклатурыСодержитГруппы();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Номенклатура1С_ВТ_НеПодлежитМаркировке_ДобавитьТаблицуНоменклатуры(МенеджерВТ);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Таб.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ Таб1
	|ИЗ
	|	ТаблицаНоменклатуры КАК Таб
	|ГДЕ
	|	&ТолькоГруппы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаНоменклатуры";
	
	Если ТолькоГруппы Тогда
		Если ЕстьГруппы Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТолькоГруппы", "Таб.Номенклатура.ЭтоГруппа");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТолькоГруппы", "ЛОЖЬ");
		КонецЕсли;
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТолькоГруппы", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Спр.Ссылка КАК Номенклатура
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Спр
	|		ПО Таб.Номенклатура = Спр.Родитель
	|ГДЕ
	|	&ТолькоГруппы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Итог.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	Итог1 КАК Итог
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Таб.Номенклатура
	|ИЗ
	|	Таб2 КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.Номенклатура", ПолноеИмяНоменклатуры);
	
	Если ТолькоГруппы Тогда
		Если ЕстьГруппы Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТолькоГруппы", "Спр.ЭтоГруппа");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТолькоГруппы", "ЛОЖЬ");
		КонецЕсли;
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТолькоГруппы", "ИСТИНА");
	КонецЕсли;
	
	Пока Истина Цикл
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	ЕстьИтог1 = Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура
	|ИЗ
	|	Итог2 КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог2";
	
	Если ЕстьИтог1 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Таб2", "Таб1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Итог2", "Итог1");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Результат = МассивИзРезультатаЗапроса(Запрос, "Номенклатура");
	
	МенеджерВТ.Закрыть();
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив номенклатуры, которая не подлежит маркировке
//
// Параметры:
//  МассивНоменклатуры - Массив - (необязательный) номенклатура 1С, которую нужно проверить;
// 
// Возвращаемое значение:
//  Массив - содержит номенклатуру 1С которая не подлежит маркировке
//
Функция Номенклатура1С_ПроверитьНеПодлежитМаркировке(МассивНоменклатуры)
	
	ТипыОбъектов = ТипыОбъектовИС();
	Если Не ЗначениеЗаполнено(ТипыОбъектов.Номенклатура) Тогда
		ВызватьИсключение НСтр("ru = 'Не определен тип справочника номенклатуры 1С'");
	КонецЕсли;
	
	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов(ТипыОбъектов.Номенклатура));
	ТаблицаЗначений_ЗагрузитьМассив(ТаблицаНоменклатуры, МассивНоменклатуры, "Номенклатура");
	ЗаполнитьВТаблицеКлючиПоОбъектам1С(ТаблицаНоменклатуры, "Номенклатура", "КлючНоменклатуры");
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаНоменклатуры, "ТаблицаНоменклатуры", "Номенклатура");
	
	ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура
	|ИЗ
	|	НоменклатураНеПодлежитМаркировке КАК Т");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Результат = МассивИзРезультатаЗапроса(Запрос, "Номенклатура");
	
	МенеджерВТ.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Процедура Номенклатура1С_ВТ_ДобавитьТаблицуНоменклатуры(МенеджерВТ, МассивНоменклатуры = Неопределено)
	
	ПолноеИмяНоменклатуры = ПолноеИмяСправочникаНоменклатуры();
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Спр.Ссылка КАК Номенклатура,
	|	&КлючНоменклатуры КАК КлючНоменклатуры,
	|	""&ТипКлючаНоменклатуры"" КАК ТипКлючаНоменклатуры
	|ПОМЕСТИТЬ ТаблицаНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК Спр
	|ГДЕ
	|	&МассивНоменклатуры
	|	И НЕ Спр.ПометкаУдаления";
	
	Если ЗапросПоддерживаетЧтениеИдентификатора() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючНоменклатуры", "УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Спр.Ссылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипКлючаНоменклатуры", ПолноеИмяНоменклатуры);
		ТекстЗапроса = ТекстЗапроса + " ИНДЕКСИРОВАТЬ ПО КлючНоменклатуры, ТипКлючаНоменклатуры";
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючНоменклатуры", "НЕОПРЕДЕЛЕНО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипКлючаНоменклатуры", "НЕОПРЕДЕЛЕНО");
		ТекстЗапроса = ТекстЗапроса + " ИНДЕКСИРОВАТЬ ПО Номенклатура";
	КонецЕсли;
	
	Если МассивНоменклатуры = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&МассивНоменклатуры", "ИСТИНА");
	Иначе
		Условие = "Спр.Ссылка В ИЕРАРХИИ (&МассивНоменклатуры)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&МассивНоменклатуры", Условие);
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.Номенклатура", ПолноеИмяНоменклатуры);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура Номенклатура1С_ВТ_ДобавитьКлючиНоменклатуры(МенеджерВТ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура
	|ИЗ
	|	ТаблицаНоменклатуры КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаНоменклатуры";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
	
	ЗаполнитьВТаблицеКлючиПоОбъектам1С(ТаблицаНоменклатуры, "Номенклатура", "КлючНоменклатуры", "ТипКлючаНоменклатуры");
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаНоменклатуры, "ТаблицаНоменклатуры", "КлючНоменклатуры");
	
КонецПроцедуры

Процедура Номенклатура1С_ВТ_НеПодлежитМаркировке_ДобавитьТаблицуНоменклатуры(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючОбъекта КАК КлючОбъекта,
	|	Т.ТипКлючаОбъекта КАК ТипКлючаОбъекта
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СвойстваОбъектов1С КАК Т
	|ГДЕ
	|	Т.ИмяСвойства = &НеПодлежитМаркировке
	|	И (ВЫРАЗИТЬ(Т.Значение КАК БУЛЕВО)) = ИСТИНА");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НеПодлежитМаркировке", Перечисление_СвойстваОбъектов1С().НеПодлежитМаркировке);
	
	ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
	ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов(ТипыОбъектовИС().Номенклатура));
	
	ЗаполнитьВТаблицеОбъекты1СПоКлючам(ТаблицаНоменклатуры, "Номенклатура", "КлючОбъекта", "ТипКлючаОбъекта");
	
	ТаблицаНоменклатуры.Колонки.Удалить("КлючОбъекта");
	ТаблицаНоменклатуры.Колонки.Удалить("ТипКлючаОбъекта");
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаНоменклатуры, "ТаблицаНоменклатуры", "Номенклатура");
	
КонецПроцедуры

Процедура ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке(МенеджерВТ) Экспорт
	
	СправочникНоменклатура = ПолноеИмяСправочникаНоменклатуры();
	СвойствоНеПодлежитМаркировке = Перечисление_СвойстваОбъектов1С().НеПодлежитМаркировке;
	
	ВидыПродукции1С = МаркируемыеТоварныеГруппы_ВидыПродукции1С();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке_ТекстЗапроса1(СправочникНоменклатура, ВидыПродукции1С);
	Запрос.УстановитьПараметр("СправочникНоменклатура", СправочникНоменклатура);
	Запрос.УстановитьПараметр("СвойствоНеПодлежитМаркировке", СвойствоНеПодлежитМаркировке);
	Запрос.УстановитьПараметр("ВидыПродукции1С", ВидыПродукции1С);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	Если Не ЗапросПоддерживаетЧтениеИдентификатора() Тогда
		ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке_ДобавитьКлючиРодителей(МенеджерВТ, "Таб1");
	КонецЕсли;
	
	ТекстЗапроса = ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке_ТекстЗапроса2(СправочникНоменклатура, ВидыПродукции1С);
	
	Пока Истина Цикл
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Запрос.УстановитьПараметр("СправочникНоменклатура", СправочникНоменклатура);
		Запрос.УстановитьПараметр("СвойствоНеПодлежитМаркировке", СвойствоНеПодлежитМаркировке);
		Запрос.УстановитьПараметр("ВидыПродукции1С", ВидыПродукции1С);
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если Не ЗапросПоддерживаетЧтениеИдентификатора() Тогда
			Если Найти(ТекстЗапроса, "ПОМЕСТИТЬ Таб1") > 0 Тогда
				ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке_ДобавитьКлючиРодителей(МенеджерВТ, "Таб1");
			Иначе
				ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке_ДобавитьКлючиРодителей(МенеджерВТ, "Таб2");
			КонецЕсли;
		КонецЕсли;
		
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
		
	КонецЦикла;
	
	ЕстьИтог2 = Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог2") > 0;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Итог.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ НоменклатураНеПодлежитМаркировке
	|ИЗ
	|	Итог2 КАК Итог
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог2";
	
	Если Не ЕстьИтог2 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Таб2", "Таб1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Итог2", "Итог1");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке_ДобавитьКлючиРодителей(МенеджерВТ, ИмяТаблицы)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Номенклатура,
	|	Т.Родитель,
	|	Т.НеПодлежитМаркировке
	|ИЗ
	|	Таб КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Таб", ИмяТаблицы);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Таб = Запрос.Выполнить().Выгрузить();
	
	ЗаполнитьВТаблицеКлючиПоОбъектам1С(Таб, "Родитель", "КлючРодителя");
	ПоместитьТаблицуВЗапрос(МенеджерВТ, Таб, ИмяТаблицы, "КлючРодителя");
	
КонецПроцедуры

Функция ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке_ТекстЗапроса1(СправочникНоменклатура, ВидыПродукции1С)
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таб.Номенклатура КАК Номенклатура,
	|	Спр.Родитель КАК Родитель,
	|	&КлючРодителя КАК КлючРодителя,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СвойстваОбъектов.Значение, ЛОЖЬ) = ИСТИНА
	|			ИЛИ &УсловиеПоВидуПродукции1С
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НеПодлежитМаркировке
	|ПОМЕСТИТЬ Таб1
	|ИЗ
	|	ТаблицаНоменклатуры КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Спр
	|		ПО Таб.Номенклатура = Спр.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвойстваОбъектов1С КАК СвойстваОбъектов
	|		ПО Таб.КлючНоменклатуры = СвойстваОбъектов.КлючОбъекта
	|			И (СвойстваОбъектов.ТипКлючаОбъекта = &СправочникНоменклатура)
	|			И (СвойстваОбъектов.ИмяСвойства = &СвойствоНеПодлежитМаркировке)";
	
	ДоступныГруппыНоменклатуры = СправочникНоменклатурыСодержитГруппы();
	
	Если ЗапросПоддерживаетЧтениеИдентификатора() Тогда
		Результат = СтрЗаменить(Результат, "&КлючРодителя", "УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Спр.Родитель)");
		Результат = Результат + " ИНДЕКСИРОВАТЬ ПО КлючРодителя";
	Иначе
		Результат = СтрЗаменить(Результат, "&КлючРодителя", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если Не ДоступныГруппыНоменклатуры Тогда
		Результат = СтрЗаменить(Результат, "Спр.Родитель", "ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)");
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "Справочник.Номенклатура", СправочникНоменклатура);
	
	ИмяПоляВидПродукцииНоменклатуры = ИмяПоляВидПродукцииСправочникаНоменклатура(Ложь);
	УсловиеПоВидуПродукции1С = "ЛОЖЬ";
	Если ЗначениеЗаполнено(ИмяПоляВидПродукцииНоменклатуры)
		И ВидыПродукции1С.Количество() > 0 Тогда
		УсловиеПоВидуПродукции1С = ("НЕ Спр." + СокрЛП(ИмяПоляВидПродукцииНоменклатуры) + " В (&ВидыПродукции1С)");
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&УсловиеПоВидуПродукции1С", УсловиеПоВидуПродукции1С);
	
	Результат = Результат + РазделительПакетаЗапроса() +
	"ВЫБРАТЬ
	|	Таб.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Таб
	|ГДЕ
	|	Таб.НеПодлежитМаркировке";
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке_ТекстЗапроса2(СправочникНоменклатура, ВидыПродукции1С)
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таб.Номенклатура КАК Номенклатура,
	|	Спр.Родитель КАК Родитель,
	|	&КлючРодителя КАК КлючРодителя,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СвойстваОбъектов.Значение, ЛОЖЬ) = ИСТИНА
	|			ИЛИ &УсловиеПоВидуПродукции1С
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НеПодлежитМаркировке
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Спр
	|		ПО Таб.Родитель = Спр.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СвойстваОбъектов1С КАК СвойстваОбъектов
	|		ПО Таб.КлючРодителя = СвойстваОбъектов.КлючОбъекта
	|			И (СвойстваОбъектов.ТипКлючаОбъекта = &СправочникНоменклатура)
	|			И (СвойстваОбъектов.ИмяСвойства = &СвойствоНеПодлежитМаркировке)
	|ГДЕ
	|	НЕ Таб.НеПодлежитМаркировке
	|	И Таб.Родитель <> Спр.Родитель"; // Чтобы модуль не зависал, если в базе произошло зацикливание уровней
	
	ДоступныГруппыНоменклатуры = СправочникНоменклатурыСодержитГруппы();
	
	Если ЗапросПоддерживаетЧтениеИдентификатора() Тогда
		Результат = СтрЗаменить(Результат, "&КлючРодителя", "УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Спр.Родитель)");
		Результат = Результат + " ИНДЕКСИРОВАТЬ ПО КлючРодителя";
	Иначе
		Результат = СтрЗаменить(Результат, "&КлючРодителя", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если Не ДоступныГруппыНоменклатуры Тогда
		Результат = СтрЗаменить(Результат, "Спр.Родитель", "ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)");
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "Справочник.Номенклатура", СправочникНоменклатура);
	
	ИмяПоляВидПродукцииНоменклатуры = ИмяПоляВидПродукцииСправочникаНоменклатура(Ложь);
	УсловиеПоВидуПродукции1С = "ЛОЖЬ";
	Если ЗначениеЗаполнено(ИмяПоляВидПродукцииНоменклатуры)
		И ВидыПродукции1С.Количество() > 0 Тогда
		УсловиеПоВидуПродукции1С = ("НЕ Спр." + СокрЛП(ИмяПоляВидПродукцииНоменклатуры) + " В (&ВидыПродукции1С)");
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&УсловиеПоВидуПродукции1С", УсловиеПоВидуПродукции1С);
	
	Результат = Результат + РазделительПакетаЗапроса() +
	"ВЫБРАТЬ
	|	Итог.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	Итог1 КАК Итог
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таб.Номенклатура
	|ИЗ
	|	Таб2 КАК Таб
	|ГДЕ
	|	Таб.НеПодлежитМаркировке
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	
	Возврат Результат;
	
КонецФункции

