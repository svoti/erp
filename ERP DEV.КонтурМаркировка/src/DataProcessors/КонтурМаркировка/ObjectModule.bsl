Процедура Форма_УстановитьОтборДинамическогоСписка(Форма, ИмяДинамическогоСписка
	, ПолеОтбора
	, ВидСравнения
	, Значение
	, ОчиститьОтбор = Истина) Экспорт
	
	Если ОчиститьОтбор Тогда
		Форма[ИмяДинамическогоСписка].Отбор.Элементы.Очистить();
	КонецЕсли;
	
	Если ВерсияПлатформыНиже("8.3.3") Тогда
		ЭлементОтбора = Форма[ИмяДинамическогоСписка].Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Иначе
		ЭлементОтбора = Форма[ИмяДинамическогоСписка].КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	КонецЕсли;
	
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеОтбора);
	ЭлементОтбора.ВидСравнения = ВидСравнения;
	ЭлементОтбора.ПравоеЗначение = Значение;
	
КонецПроцедуры

Функция Форма_СоздатьДинамическийСписокРегистра(Форма, ИмяРегистра, РодительскийЭлемент) Экспорт
	
	Если Форма.Элементы.Найти(ИмяРегистра) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПрефиксГруппаРегистра = "ГруппаРегистра_";
	ПрефиксРегистрСведений = "РегистрСведений.";
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРегистра, Новый ОписаниеТипов("ДинамическийСписок"),, "Поле таблицы"));
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	Форма[ИмяРегистра].ОсновнаяТаблица = ПрефиксРегистрСведений + ИмяРегистра;
	
	ЭлементГруппы = Форма.Элементы.Добавить(ПрефиксГруппаРегистра + ИмяРегистра, Тип("ГруппаФормы"), РодительскийЭлемент);
	ЭлементГруппы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ЭлементГруппы.Заголовок = ИмяРегистра;
	
	Если Не ВерсияПлатформыНиже("8.3.3")
		И Не ВерсияРежимаСовместимостиНиже("8.3.3") Тогда
		Выполнить("ЭлементГруппы.Поведение = ПоведениеОбычнойГруппы.Свертываемая");
	КонецЕсли;
	
	Если Не ВерсияПлатформыНиже("8.3.12")
		И Не ВерсияРежимаСовместимостиНиже("8.3.12") Тогда
		Выполнить("ЭлементГруппы.Скрыть();");
	КонецЕсли;
	
	Элемент = Форма.Элементы.Добавить(ИмяРегистра, Тип("ТаблицаФормы"), ЭлементГруппы);
	Элемент.ПутьКДанным = ИмяРегистра;
	Элемент.Заголовок = ИмяРегистра;
	
	Форма_СоздатьКолонкиТаблицыФормыПоРегистру(Форма, Элемент, ИмяРегистра);
	НастроитьЭлементДинамическогоСписка(Элемент);
	
	Возврат Элемент;
	
КонецФункции

Процедура Форма_СоздатьКолонкиТаблицыФормыПоРегистру(Форма, Элемент, ИмяРегистра)
	
	ИмяПоляТаблицыФормы = Элемент.Имя;
	ИмяПоляРеквизитаФормы = Элемент.ПутьКДанным;
	
	ПометкаУдаления = "Удалить";
	МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
	
	КоллекцииПолей = Новый Массив;
	КоллекцииПолей.Добавить(МетаданныеРегистра.Измерения);
	КоллекцииПолей.Добавить(МетаданныеРегистра.Ресурсы);
	КоллекцииПолей.Добавить(МетаданныеРегистра.Реквизиты);
	
	Для Каждого Поля Из КоллекцииПолей Цикл
		
		Для Каждого Поле Из Поля Цикл
			
			Если Найти(Поле.Имя, ПометкаУдаления) = 1 Тогда
				Продолжить;
			КонецЕсли;
			
			Если Поле.Тип = ОписаниеТипа_ХранилищеЗначений() Тогда
				Продолжить;
			КонецЕсли;
			
			ЭлементРеквизита = Форма.Элементы.Добавить(ИмяПоляТаблицыФормы + Поле.Имя, Тип("ПолеФормы"), Форма.Элементы[ИмяПоляТаблицыФормы]);
			ЭлементРеквизита.ПутьКДанным = ИмяПоляРеквизитаФормы + "." + Поле.Имя;
			ЭлементРеквизита.Вид = ВидПоляФормы.ПолеВвода;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура НастроитьЭлементДинамическогоСписка(Элемент)
	
	Элемент.УстановитьДействие("Выбор", "ДинамическийСписокВыбор");
	Элемент.УстановитьДействие("ПередУдалением", "ДинамическийСписокПередУдалением");
	Элемент.УстановитьДействие("ПередНачаломДобавления", "ДинамическийСписокПередНачаломДобавления");
	
	Элемент.КоманднаяПанель.Видимость = Ложь;
	Элемент.ИзменятьПорядокСтрок = Ложь;
	Элемент.АвтоОбновление = Ложь;
	Элемент.Видимость = Истина;
	
КонецПроцедуры

