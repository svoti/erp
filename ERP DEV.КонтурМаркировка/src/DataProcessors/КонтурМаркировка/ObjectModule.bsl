	Настройки = НастройкиМодуля();
	Результат = Адреса.СайтКонтурМаркировка;
	
	Если Настройки.ТестовоеОкружение Тогда
		
		Если Не ЗначениеЗаполнено(Настройки.АдресТестовогоСервиса) Тогда
			Результат = Адреса.СайтКонтурМаркировкаТестовый;
		Иначе
			
			// Получаем адрес сайта по номеру тестового стейджа
			Для каждого Эл Из Адреса Цикл
				Если Настройки.АдресТестовогоСервиса = Эл.Значение Тогда
					НомерСтейджа = СтрЗаменить(Эл.Ключ, "СервисКонтурМаркировкаТестовый", "");
					Результат = Адреса["СайтКонтурМаркировкаТестовый" + НомерСтейджа];
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
