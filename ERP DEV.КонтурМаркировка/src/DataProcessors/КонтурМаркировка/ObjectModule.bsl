Функция Интеграция_ВидКорректировки(Документ1С)
	
	ИмяДокумента1С = Документ1С.Метаданные().Имя;
	ВидыКорректировки = Перечисление_ВидыКорректировкиДокумента();
	
	ИменаДокументовВозврата = Интеграция_ИменаДокументовВозврата1С();
	ИменаДокументовКорректировки = Интеграция_ИменаДокументовКорректировки1С();
	
	Если МассивСодержитЗначение(ИменаДокументовВозврата, ИмяДокумента1С) Тогда
		Возврат ВидыКорректировки.Возврат;
	КонецЕсли;
	
	Если МассивСодержитЗначение(ИменаДокументовКорректировки, ИмяДокумента1С) Тогда
		ИмяРеквизитаВидКорректировки1С = Интеграция_ИмяРеквизитаВидКорректировки(ИмяДокумента1С);
		Если ЗначениеЗаполнено(ИмяРеквизитаВидКорректировки1С) Тогда
			ВидКорректировки1С = ЗначениеРеквизитаОбъектаЛок(Документ1С, ИмяРеквизитаВидКорректировки1С);
			Возврат ВидКорректировкиПоВидуКорректировки1С(ВидКорректировки1С);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ВидКорректировкиПоВидуКорректировки1С(ВидКорректировки1С)
	
	Представление = Строка(ВидКорректировки1С);
	
	КлючКэш = "ВидКорректировкиПоВидуКорректировки1С: " + Представление;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыКорректировки = Перечисление_ВидыКорректировкиДокумента();
	
	ВариантыЗначений = Новый Соответствие;
	
	// УТ/КА/ERP
	ВариантыЗначений.Вставить(НРег("Корректировка по согласованию сторон"), ВидыКорректировки.Корректировка);
	ВариантыЗначений.Вставить(НРег("Реализация перепоставленного товара"),  ВидыКорректировки.Корректировка);
	ВариантыЗначений.Вставить(НРег("Возврат недопоставленного товара"),     ВидыКорректировки.Возврат);
	ВариантыЗначений.Вставить(НРег("Исправление ошибок"),                   ВидыКорректировки.Исправление);
	ВариантыЗначений.Вставить(НРег("Исправление в первичных документах"),   ВидыКорректировки.Исправление);
	
	// БП/УНФ
	ВариантыЗначений.Вставить(НРег("Исправление собственной ошибки"),       ВидыКорректировки.Исправление);
	ВариантыЗначений.Вставить(НРег("Исправление ошибки"),                   ВидыКорректировки.Исправление);
	ВариантыЗначений.Вставить(НРег("Согласованное изменение"),              ВидыКорректировки.Корректировка);
	
	Результат = ВариантыЗначений[НРег(Представление)];
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Кэш_Поместить(КлючКэш, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Интеграция_ПересчитатьКоличествоВБазовыеЕдиницы(СтрокаДокумента)
	
	// Пересчет количества в базовые единицы измерения (УТ, КА, ERP)
	Действие = Новый Структура("ПересчитатьКоличествоЕдиниц");
	
	КэшЗначений = Новый Структура;
	КэшЗначений.Вставить("КоэффициентыУпаковок", Новый Соответствие);
	КэшЗначений.Вставить("ОбъемУпаковок", Новый Соответствие);
	КэшЗначений.Вставить("ВесУпаковок", Новый Соответствие);
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	Если ЗначениеЗаполнено(ВерсияУТ) И СравнитьВерсии(ВерсияУТ, "11.1.9.44") < 0 Тогда
		
		Если ЕстьНеобходимыеМетаданные("ОбщийМодуль.ОбработкаТабличнойЧастиСервер") Тогда
			ОбщийМодульОбработкиТЧ = ОбщийМодуль("ОбработкаТабличнойЧастиСервер");
		Иначе
			Возврат;
		КонецЕсли;
		
		ОбщийМодульОбработкиТЧ.ОбработатьСтрокуТЧ(СтрокаДокумента, Действие, КэшЗначений);
		
	Иначе
		
		Если ЕстьНеобходимыеМетаданные("ОбщийМодуль.ОбработкаТабличнойЧастиКлиентСервер") Тогда
			ОбщийМодульОбработкиТЧ = ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер");
		ИначеЕсли ЕстьНеобходимыеМетаданные("ОбщийМодуль.ПакетнаяОбработкаТабличнойЧастиКлиентСервер") Тогда
			ОбщийМодульОбработкиТЧ = ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиКлиентСервер");
		Иначе
			Возврат;
		КонецЕсли;
		
		ОбщийМодульОбработкиТЧ.ПересчитатьКоличествоЕдиницВСтрокеТЧ(СтрокаДокумента, Действие, КэшЗначений);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ИдентификаторТекущейКонфигурации() Экспорт
	
	ДанныеКонфигурации = ИмяИВерсияТекущейКонфигурации();
	
	ЧастиИдентификатора = Новый Массив;
	ЧастиИдентификатора.Добавить(ДанныеКонфигурации.Имя);
	ЧастиИдентификатора.Добавить(ДанныеКонфигурации.НомерРедакции);
	ЧастиИдентификатора.Добавить(ДанныеКонфигурации.НомерПодредакции);
	
	Результат = СоединитьСтроку(ЧастиИдентификатора);
	
	Возврат Результат;
	
КонецФункции

Функция ИмяИВерсияТекущейКонфигурации()
	
	РазделительВерсий = ".";
	ВключатьПустые = Истина;
	ЧастиНомераВерсии = РазделитьСтроку(
	Строка(Метаданные.Версия),
	РазделительВерсий,
	ВключатьПустые
	);
	
	НомерРедакции = "";
	Если ЧастиНомераВерсии.Количество() > 0 Тогда
		НомерРедакции = ЧастиНомераВерсии[0];
	КонецЕсли;
	
	НомерПодредакции = "";
	Если ЧастиНомераВерсии.Количество() > 1 Тогда
		НомерПодредакции = ЧастиНомераВерсии[1];
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", Метаданные.Имя);
	Результат.Вставить("НомерРедакции", НомерРедакции);
	Результат.Вставить("НомерПодредакции", НомерПодредакции);
	
	Возврат Результат;
	
КонецФункции

Функция Интеграция_МаркерКонфигурации()
	
	КлючКэш = "МаркерКонфигурации";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	МаркерыКонфигураций = Перечисление_МаркерыКонфигураций();
	ПодсистемыКонфигурации = ОписанияПодсистемКонфигурации();
	
	МаркерыПодсистем = Новый Соответствие;
	МаркерыПодсистем.Вставить("УправлениеТорговлей", МаркерыКонфигураций.УТ11);
	МаркерыПодсистем.Вставить("УправлениеТорговлейБазовая", МаркерыКонфигураций.УТ11);
	
	Результат = "";
	Для Каждого КлючИЗначение Из МаркерыПодсистем Цикл
		Если ПодсистемыКонфигурации.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
			Результат = КлючИЗначение.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

