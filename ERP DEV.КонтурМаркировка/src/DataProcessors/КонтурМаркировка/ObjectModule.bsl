// Находит контент входящего УПД в файлах по идентификатору документа
// и возвращает его в виде структуры
//
// Параметры:
//  ОписаниеОперации - Структура - см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  Структура - см. функцию Новый_Операция_ДанныеВходящегоУПД();
//
Функция Операция_ВходящийУПД_РезультатСверки(ОписаниеОперации, ЗаменитьGS = Истина) Экспорт
	
	Результат = Новый_Операция_ДанныеВходящегоУПД();
	
	Операция = ОписаниеОперации.Ссылка;
	ИдентификаторДокумента = ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента;
	ТипФайла = Перечисление_ТипыФайлов().КонтентВходящегоУПД;
	
	ФайлКонтента = Файл_НайтиПоИдентификатору(Операция, ИдентификаторДокумента, ТипФайла);
	Если Не ЗначениеЗаполнено(ФайлКонтента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеФайла = Файл_Прочитать(ФайлКонтента);
	Контент = ОписаниеФайла.ДанныеФайла;
	
	Для каждого position Из Контент.positions Цикл
		
		НоваяСтрока = Новый_Операция_СтрокаТовараВходящегоУПД();
		НоваяСтрока.НомерСтроки = position.number;
		position.Свойство("name", НоваяСтрока.НаименованиеТовара);
		
		Если position.Свойство("vva")
			И ЗначениеЗаполнено(position.vva) Тогда
			
			vva = position.vva;
			vva.Свойство("value", НоваяСтрока.КодОСУ);
			vva.Свойство("isValid", НоваяСтрока.КодОСУВалидный);
			vva.Свойство("gtin", НоваяСтрока.GTIN);
			vva.Свойство("gtinName", НоваяСтрока.НаименованиеТовараНК);
			vva.Свойство("quantity", НоваяСтрока.КоличествоПоОСУ);
			
			ТоварнаяГруппа = Неопределено;
			vva.Свойство("productGroup", ТоварнаяГруппа);
			Если ЗначениеЗаполнено(ТоварнаяГруппа) Тогда
				НоваяСтрока.ВидПродукции = ВидПродукцииПоТоварнойГруппеИзСервиса(ТоварнаяГруппа);
			КонецЕсли;
			
			gtinChecks = Неопределено;
			Если vva.Свойство("gtinChecks", gtinChecks) Тогда
				Операция_ВходящийУПД_РезультатСверки_ЗаполнитьПроверкиGTIN(НоваяСтрока, gtinChecks)
			КонецЕсли;
			
			Если vva.Свойство("codes") Тогда
				Операция_ВходящийУПД_РезультатСверки_ЗаполнитьКоды(НоваяСтрока.КодыМаркировкиПоОСУ, vva.codes, ЗаменитьGS);
			КонецЕсли;
			
			parties = Неопределено;
			Если vva.Свойство("parties", parties) Тогда
				Операция_ВходящийУПД_РезультатСверки_ЗаполнитьПартии(НоваяСтрока, parties);
			КонецЕсли;
			
		КонецЕсли;
		
		Если position.Свойство("codes") Тогда
			Операция_ВходящийУПД_РезультатСверки_ЗаполнитьКоды(НоваяСтрока.КодыМаркировки, position.codes, ЗаменитьGS);
		КонецЕсли;
		
		Результат.КодыДокумента.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Если Контент.Свойство("exceptCodes") Тогда
		Результат.ЛишниеКоды = Контент.exceptCodes;
	КонецЕсли;
	
	Операция_ВходящийУПД_ЗаполнитьИтоги(Результат);
	
	Возврат Результат;
	
КонецФункции

// Заполняет проверки по GTIN в строке товара входящего УПД
//
// Параметры:
//  СтрокаТовара - Структура - см. функцию Новый_Операция_СтрокаТовараВходящегоУПД();
//  gtinChecks - Массив - содержит структуры, см. ApiReconciliationGtinCheck;
//
Процедура Операция_ВходящийУПД_РезультатСверки_ЗаполнитьПроверкиGTIN(СтрокаТовара, gtinChecks)
	
	ИзвестныеПроверки = Новый Соответствие;
	ИзвестныеПроверки.Вставить(НРег("IsRegistered"), "ЗарегистрированВГИСМТ");
	ИзвестныеПроверки.Вставить(НРег("IsVvaAllowed"), "РазрешенаОтгрузкаПоОСУ");
	
	РезультатыПроверки = Новый Соответствие;
	РезультатыПроверки.Вставить(НРег("Error"), Ложь);
	РезультатыПроверки.Вставить(НРег("Success"), Истина);
	
	Для Каждого check Из gtinChecks Цикл
		
		Проверка = ИзвестныеПроверки[НРег(check.checkType)];
		РезультатПроверки = РезультатыПроверки[НРег(check.result)];
		
		Если Не ЗначениеЗаполнено(Проверка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если РезультатПроверки = Неопределено Тогда
			ВызватьИсключение ПараметрыВСтроку(НСтр(
			"ru = 'Неизвестный результат проверки GTIN ""%1"": %2'"), check.checkType, check.result);
		КонецЕсли;
		
		СтрокаТовара[Проверка] = РезультатПроверки;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет массив КодыМаркировки структурами Новый_Операция_СтрокаКодаВходящегоУПД() из контента
//
// Параметры:
//  КодыМаркировки - Массив - будет заполнен кодами из контента;
//  codes - Массив - коды входящего УПД
//
Процедура Операция_ВходящийУПД_РезультатСверки_ЗаполнитьКоды(КодыМаркировки, codes, ЗаменитьGS)
	
	ИзвестныеПроверки = Новый Соответствие;
	ИзвестныеПроверки.Вставить(НРег("SenderCheck"), "ПринадлежитОтправителю");
	ИзвестныеПроверки.Вставить(НРег("StatusCheck"), "ВведенВОборот");
	ИзвестныеПроверки.Вставить(НРег("ScannedCheck"), "Отсканирован");
	ИзвестныеПроверки.Вставить(НРег("tobaccoNormalizedCheck"), "КорректныйФорматКода");
	ИзвестныеПроверки.Вставить(НРег("CertificateStatusesCheck"), "ПройденаПроверкаРД");
	
	РезультатыПроверки = Новый Соответствие;
	РезультатыПроверки.Вставить(НРег("Error"), Ложь);
	РезультатыПроверки.Вставить(НРег("Success"), Истина);
	
	МодульЯдро = МодульЯдро();
	
	Для каждого code Из codes Цикл
		
		СтрКода = Новый_Операция_СтрокаКодаВходящегоУПД();
		
		Если ЗаменитьGS Тогда
			СтрКода.КодМаркировки = МодульЯдро.ЗаменитьРазделительGS1(code.code);
		Иначе
			СтрКода.КодМаркировки = code.code;
		КонецЕсли;
		
		Если code.Свойство("expirationDate") Тогда
			СтрКода.ДатаСрокаГодности = ДатаИзСтрокиXML(code.expirationDate);
		КонецЕсли;
		
		code.Свойство("productWeight", СтрКода.Вес);
		
		Для каждого check Из code.checks Цикл
			
			Проверка = ИзвестныеПроверки[НРег(check.checkType)];
			РезультатПроверки = РезультатыПроверки[НРег(check.result)];
			
			Если Не ЗначениеЗаполнено(Проверка) Тогда
				Продолжить;
			КонецЕсли;
			
			Если РезультатПроверки = Неопределено Тогда
				ВызватьИсключение ПараметрыВСтроку(НСтр(
				"ru = 'Неизвестный результат проверки кода ""%1"": %2'"), check.checkType, check.result);
			КонецЕсли;
			
			СтрКода[Проверка] = РезультатПроверки;
			
		КонецЦикла;
		
		childCodes = СвойствоСтруктуры(code, "childCodes");
		Если ЗначениеЗаполнено(childCodes) Тогда
			Операция_ВходящийУПД_РезультатСверки_ЗаполнитьКоды(СтрКода.ВложенныеКоды, childCodes, ЗаменитьGS);
		КонецЕсли;
		
		КодыМаркировки.Добавить(СтрКода);
		
	КонецЦикла;
	
	Операция_ВходящийУПД_КодыМаркировки_ЗаполнитьGTIN(КодыМаркировки);
	
КонецПроцедуры

Процедура Операция_ВходящийУПД_РезультатСверки_ЗаполнитьПартии(СтрокаТовара, parties)
	
	Для каждого party Из parties Цикл
		
		СтрПартии = Новый_Операция_СтрокаПартииВходящегоУПД();
		
		СтрПартии.НомерСтроки = СтрокаТовара.НомерСтроки;
		СтрПартии.GTIN = СвойствоСтруктуры(party, "gtin", "");
		СтрПартии.НомерПартии = СвойствоСтруктуры(party, "number", "");
		СтрПартии.КоличествоУпаковок = СвойствоСтруктуры(party, "quantity", 0);
		
		weightGram = СвойствоСтруктуры(party, "weightGram", 0);
		Если ЗначениеЗаполнено(weightGram) Тогда
			ВесВКилограммах = weightGram / ГраммВКилограмме();
			СтрПартии.Количество = ВесВКилограммах;
		КонецЕсли;
		
		СтрокаТовара.Партии.Добавить(СтрПартии);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ВходящийУПД_КодыМаркировки_ЗаполнитьGTIN(КодыМаркировки)
	
	ДлинаGTIN = 14;
	ГруппаGTIN = "01";
	ГруппаСерийныйНомер = "21";
	ДлинаГруппыВКоде = 2;
	НачалоGTIN = СтрДлина(ГруппаGTIN) + 1;
	ПозицияСерийныйНомер = НачалоGTIN + ДлинаGTIN;
	
	Для каждого СтрКода Из КодыМаркировки Цикл
		Если Лев(СтрКода.КодМаркировки, ДлинаГруппыВКоде) = ГруппаGTIN
			И Сред(СтрКода.КодМаркировки, ПозицияСерийныйНомер, ДлинаГруппыВКоде) = ГруппаСерийныйНомер Тогда
			СтрКода.GTIN = Сред(СтрКода.КодМаркировки, НачалоGTIN, ДлинаGTIN);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает таблицу кодов маркировки, содержащихся во входящем УПД
//
// Параметры:
//  ОписаниеОперации - Структура - см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  Таблица значений - см. функцию Новый_ТаблицаКодов();
//
Функция Операция_ВходящийУПД_ТаблицаКодов(ОписаниеОперации)
	
	ЗаменитьGS = Ложь;
	РезультатСверки = Операция_ВходящийУПД_РезультатСверки(ОписаниеОперации, ЗаменитьGS);
	
	Результат = Новый_ТаблицаКодов();
	Для каждого Стр Из РезультатСверки.КодыДокумента Цикл
		Операция_ВходящийУПД_ТаблицаКодов_ДобавитьСтроку(Результат, Стр.КодыМаркировки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ВходящийУПД_ПартииТоваров(Операция) Экспорт
	
	ОписаниеОперации = Операция_Прочитать(Операция);
	РезультатСверки = Операция_ВходящийУПД_РезультатСверки(ОписаниеОперации);
	
	// BSLLS:MagicNumber-off
	ТипСтрока50 = ОписаниеТипа_Строка(50);
	// BSLLS:MagicNumber-on
	
	ТипЧисло15Положит = ОписаниеТипа_Число_Положит_15_6();
	ТипЧисло10ЦелПоложит = ОписаниеТипа_Число_Положит_10();
	ТипЧисло = ОписаниеТипа_Число();
	ТипТовар = ОписаниеТипа_Товар();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Товар", ТипТовар);
	Результат.Колонки.Добавить("НомерСтроки", ТипЧисло);
	Результат.Колонки.Добавить("НомерПартии", ТипСтрока50);
	Результат.Колонки.Добавить("Количество", ТипЧисло15Положит);
	Результат.Колонки.Добавить("КоличествоУпаковок", ТипЧисло10ЦелПоложит);
	
	КэшТоваров = Новый Соответствие;
	
	Для Каждого Стр Из РезультатСверки.КодыДокумента Цикл
		
		Если Не ЗначениеЗаполнено(Стр.Партии) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрПартии Из Стр.Партии Цикл
			
			Если Не ЗначениеЗаполнено(СтрПартии.НомерПартии) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтр = Результат.Добавить();
			НоваяСтр.Товар = Товар_НайтиСоздатьПоИнформацииИзСервиса(СтрПартии.GTIN, КэшТоваров);
			ЗаполнитьЗначенияСвойств(НоваяСтр, СтрПартии);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет в таблицу кодов строку кода из результата сверки входящего УПД
//
// Параметры:
//  ТаблицаКодов - Таблица значений - см. функцию Новый_ТаблицаКодов();
//  КодыВходящегоУПД - Массив из Структура - Новый_Операция_СтрокаКодаВходящегоУПД();
//
Процедура Операция_ВходящийУПД_ТаблицаКодов_ДобавитьСтроку(ТаблицаКодов, КодыВходящегоУПД, КодАгрегата = Неопределено)
	
	Для каждого Эл Из КодыВходящегоУПД Цикл
		
		Если ЗначениеЗаполнено(Эл.ВложенныеКоды) Тогда
			Операция_ВходящийУПД_ТаблицаКодов_ДобавитьСтроку(ТаблицаКодов, Эл.ВложенныеКоды, Эл.КодМаркировки);
		КонецЕсли;
		
		СтрКода = ТаблицаКодов.Найти(Эл.КодМаркировки, "КодМаркировки");
		Если СтрКода = Неопределено Тогда
			СтрКода = ТаблицаКодов.Добавить();
			СтрКода.КодМаркировки = Эл.КодМаркировки;
			СтрКода.КодАгрегата = КодАгрегата;
		Иначе
			Если ЗначениеЗаполнено(КодАгрегата) И Не ЗначениеЗаполнено(СтрКода.КодАгрегата) Тогда
				СтрКода.КодАгрегата = КодАгрегата;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает таблицу кодов объемно-сортового учета, из входящего УПД
//
// Параметры:
//  ОписаниеОперации - Структура - см. функцию Новый_Операция();
// 
// Возвращаемое значение:
//  Таблица значений - см. функцию Новый_ТаблицаКодов();
//
Функция Операция_ВходящийУПД_ТаблицаКодовОСУ(ОписаниеОперации)
	
	РезультатСверки = Операция_ВходящийУПД_РезультатСверки(ОписаниеОперации);
	
	Результат = Новый_ТаблицаКодов();
	Для каждого Стр Из РезультатСверки.КодыДокумента Цикл
		
		Если Не ЗначениеЗаполнено(Стр.КодОСУ) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрКода = Результат.Добавить();
		СтрКода.КодМаркировки = Стр.КодОСУ;
		СтрКода.ВидПродукции = Стр.ВидПродукции;
		СтрКода.GTIN = Стр.GTIN;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_ВходящийУПД_ЗаполнитьИтоги(ДанныеВходящегоУПД)
	
	ВсегоКодов = 0;
	Отсканировано = 0;
	
	ОбщиеИтоги = ДанныеВходящегоУПД.ОбщиеИтоги;
	
	Для Каждого СтрокаТовара Из ДанныеВходящегоУПД.КодыДокумента Цикл
		
		Если ЗначениеЗаполнено(СтрокаТовара.КодыМаркировки) Тогда
			Итоги = Операция_ВходящийУПД_РассчитатьИтогиПоКодам(СтрокаТовара.КодыМаркировки);
			СтрокаТовара.КоличествоКодов = Итоги.КоличествоКодов;
		Иначе
			Итоги = Операция_ВходящийУПД_РассчитатьИтогиПоКодам(СтрокаТовара.КодыМаркировкиПоОСУ);
			СтрокаТовара.КоличествоКодов = СтрокаТовара.КоличествоПоОСУ;
		КонецЕсли;
		
		СтрокаТовара.Отсканировано = Итоги.Отсканировано;
		СтрокаТовара.КодовСОшибками = Итоги.КодовСОшибками;
		
		Если ЗначениеЗаполнено(Итоги.ВведенВОборот) Тогда
			СтрокаТовара.ВведенВОборот = Итоги.ВведенВОборот;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Итоги.ПринадлежитОтправителю) Тогда
			СтрокаТовара.ПринадлежитОтправителю = Итоги.ПринадлежитОтправителю;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Итоги.ПройденаПроверкаРД) Тогда
			СтрокаТовара.ПройденаПроверкаРД = Итоги.ПройденаПроверкаРД;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Итоги.КоличествоКодов)
			И Итоги.Отсканировано = Итоги.КоличествоКодов Тогда
			СтрокаТовара.Отсканирован = Истина;
		КонецЕсли;
		
		ВсегоКодов = ВсегоКодов + СтрокаТовара.КоличествоКодов;
		Отсканировано = Отсканировано + СтрокаТовара.Отсканировано;
		
		ОбщиеИтоги.КоличествоКодовСОшибками = ОбщиеИтоги.КоличествоКодовСОшибками + СтрокаТовара.КодовСОшибками;
		
		Если ЗначениеЗаполнено(СтрокаТовара.КодОСУ) Тогда
			
			Если СтрокаТовара.КодОСУВалидный = Ложь
				Или СтрокаТовара.ЗарегистрированВГИСМТ = Ложь
				Или СтрокаТовара.РазрешенаОтгрузкаПоОСУ = Ложь Тогда
				ОбщиеИтоги.КоличествоКодовПоОСУСОшибками = ОбщиеИтоги.КоличествоКодовПоОСУСОшибками + 1;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВсегоКодов > 0 Тогда
		ОбщиеИтоги.ПроцентОтсканированных = Цел(Отсканировано * 100 / ВсегоКодов);
	КонецЕсли;
	
КонецПроцедуры

Функция Операция_ВходящийУПД_РассчитатьИтогиПоКодам(КодыВходящегоУПД)
	
	Результат = Новый Структура;
	Результат.Вставить("КоличествоКодов", 0);
	Результат.Вставить("КодовСОшибками", 0);
	Результат.Вставить("КодовПоОСУСОшибками", 0);
	Результат.Вставить("Отсканировано", 0);
	
	Результат.Вставить("ПринадлежитОтправителю");
	Результат.Вставить("ВведенВОборот");
	Результат.Вставить("ПройденаПроверкаРД");
	
	Для Каждого СтрокаКода Из КодыВходящегоУПД Цикл
		
		Если ЗначениеЗаполнено(СтрокаКода.ВложенныеКоды) Тогда
			
			ИтогиПоВложеннымКодам = Операция_ВходящийУПД_РассчитатьИтогиПоКодам(СтрокаКода.ВложенныеКоды);
			
			Результат.КоличествоКодов = Результат.КоличествоКодов + ИтогиПоВложеннымКодам.КоличествоКодов;
			Результат.КодовСОшибками = Результат.КодовСОшибками + ИтогиПоВложеннымКодам.КодовСОшибками;
			Результат.Отсканировано = Результат.Отсканировано + ИтогиПоВложеннымКодам.Отсканировано;
			
			Если СтрокаКода.ВведенВОборот = Ложь
				Или ИтогиПоВложеннымКодам.ВведенВОборот = Ложь Тогда
				Результат.ВведенВОборот = Ложь;
			КонецЕсли;
			
			Если СтрокаКода.ПринадлежитОтправителю = Ложь
				Или ИтогиПоВложеннымКодам.ПринадлежитОтправителю = Ложь Тогда
				Результат.ПринадлежитОтправителю = Ложь;
			КонецЕсли;
			
			Если СтрокаКода.ПройденаПроверкаРД = Ложь
				Или ИтогиПоВложеннымКодам.ПройденаПроверкаРД = Ложь Тогда
				Результат.ПройденаПроверкаРД = Ложь;
			КонецЕсли;
			
		Иначе
			
			Результат.КоличествоКодов = Результат.КоличествоКодов + 1;
			
			Если ЗначениеЗаполнено(СтрокаКода.ВведенВОборот) Тогда
				Если ЗначениеЗаполнено(Результат.ВведенВОборот) Тогда
					Результат.ВведенВОборот = Мин(СтрокаКода.ВведенВОборот, Результат.ВведенВОборот);
				Иначе
					Результат.ВведенВОборот = СтрокаКода.ВведенВОборот;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаКода.ПринадлежитОтправителю) Тогда
				Если ЗначениеЗаполнено(Результат.ПринадлежитОтправителю) Тогда
					Результат.ПринадлежитОтправителю = Мин(СтрокаКода.ПринадлежитОтправителю, Результат.ПринадлежитОтправителю);
				Иначе
					Результат.ПринадлежитОтправителю = СтрокаКода.ПринадлежитОтправителю;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаКода.ПройденаПроверкаРД) Тогда
				Если ЗначениеЗаполнено(Результат.ПройденаПроверкаРД) Тогда
					Результат.ПройденаПроверкаРД = Мин(СтрокаКода.ПройденаПроверкаРД, Результат.ПройденаПроверкаРД);
				Иначе
					Результат.ПройденаПроверкаРД = СтрокаКода.ПройденаПроверкаРД;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаКода.ВведенВОборот = Ложь
				Или СтрокаКода.ПройденаПроверкаРД = Ложь
				Или СтрокаКода.КорректныйФорматКода = Ложь
				Или СтрокаКода.ПринадлежитОтправителю = Ложь Тогда
				Результат.КодовСОшибками = Результат.КодовСОшибками + 1;
			КонецЕсли;
			
			Если СтрокаКода.Отсканирован = Истина Тогда
				Результат.Отсканировано = Результат.Отсканировано + 1;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

