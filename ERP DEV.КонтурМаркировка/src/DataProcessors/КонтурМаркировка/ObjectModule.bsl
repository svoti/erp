// Возвращает общий модуль по его имени
//
// Параметры:
//  ИмяОбщегоМодуля - Строка - имя общего модуля
//
// Возвращаемое значение:
//  ОбщийМодуль - общий модуль
//
Функция ОбщийМодуль(ИмяОбщегоМодуля)
	
	КлючКэш = "ОбщийМодуль: " + ИмяОбщегоМодуля;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Метаданные.ОбщиеМодули.Найти(ИмяОбщегоМодуля) = Неопределено Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр("ru = 'Общий модуль ""%1"" не найден.'"), ИмяОбщегоМодуля);
	КонецЕсли;
	
	Результат = Вычислить(ИмяОбщегоМодуля);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

