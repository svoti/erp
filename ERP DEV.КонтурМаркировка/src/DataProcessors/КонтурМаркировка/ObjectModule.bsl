Процедура ПерейтиНаВерсиюДанных_3_11_0_ОбновитьГруппуПлатности()
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ИменаДопРеквизитов = Перечисление_ИменаДопРеквизитов();
	
	ПараметрыОбновления = ПараметрыОбновленияСправочниковПриОбмене();
	
	ДобавитьЗначениеВМассив(ПараметрыОбновления.ИменаПолейТоваровДляОбновления, ИменаДопРеквизитов.ГруппаПлатности);
	
	ДобавитьЗначениеВМассив(ПараметрыОбновления.ВидыПродукцииТоваровДляОбновления, ВидыПродукции.МедицинскиеИзделия);
