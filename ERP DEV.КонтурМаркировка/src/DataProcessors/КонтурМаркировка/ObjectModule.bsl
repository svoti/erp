Процедура КонтурПлагины_ПриСохраненииНастроекПлагина(ПараметрыСобытия)
	
	Плагин = КонтурПлагины_НайтиПлагин(ПараметрыСобытия.Идентификатор);
	ТипФайла = Перечисление_ТипыФайлов().ФайлНастроекПлагина;
	
	ОписаниеПлагина = КонтурПлагин_Прочитать(Плагин);
	
	ОписаниеФайла = Новый_ОписаниеФайла();
	ОписаниеФайла.ДанныеФайла = ПараметрыСобытия.Настройки;
	ОписаниеФайла.ТипФайла = ТипФайла;
	ОписаниеФайла.ВладелецФайла = Плагин;
	ОписаниеФайла.Идентификатор = ОписаниеПлагина.Идентификатор;
	
	Файл_Записать(ОписаниеФайла);
	
	ПараметрыСобытия.Результат.Успешно = Истина;
	
КонецПроцедуры

Процедура КонтурПлагин_Записать(ОписаниеПлагина)
	
	Если ЗначениеЗаполнено(ОписаниеПлагина.Ссылка) Тогда
		ДанныеИБ = ДопСправочник_Прочитать(ОписаниеПлагина.Ссылка);
	Иначе
		ИмяСправочника = Перечисление_ИменаДопСправочников().КонтурПлагины;
		ДанныеИБ = Новый_ЭлементДопСправочника(ИмяСправочника);
		ДанныеИБ.Наименование = ОписаниеПлагина.Представление;
	КонецЕсли;
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	ДанныеИБ.ДопРеквизиты.Вставить("Идентификатор", ОписаниеПлагина.Идентификатор);
	ДанныеИБ.ДопРеквизиты.Вставить("Версия",        ОписаниеПлагина.Версия);
	ДанныеИБ.ДопРеквизиты.Вставить("Включен",       ОписаниеПлагина.Включен);
	ДанныеИБ.ДопРеквизиты.Вставить("Представление", ОписаниеПлагина.Представление);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ДопСправочник_Записать(ДанныеИБ);
		
		Если ЗначениеЗаполнено(ОписаниеПлагина.ДвоичныеДанные) Тогда
			ОписаниеФайла = Новый_ОписаниеФайла();
			ОписаниеФайла.ДанныеФайла = ОписаниеПлагина.ДвоичныеДанные;
			ОписаниеФайла.ИмяФайла = ПараметрыВСтроку("%1.epf", ДанныеИБ.Наименование);
			ОписаниеФайла.ТипФайла = Перечисление_ТипыФайлов().ФайлПлагина;
			ОписаниеФайла.ВладелецФайла = ДанныеИБ.Ссылка;
			ОписаниеФайла.Идентификатор = ОписаниеПлагина.Идентификатор;
			Файл_Записать(ОписаниеФайла);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Запись плагина'");
		ТекстСообщения = НСтр("ru = 'Не удалось записать плагин с идентификатором: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ОписаниеПлагина.Идентификатор);
		ОбработатьОшибку(Действие, Ошибка,, ТекстСообщения);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция КонтурПлагины_ВключитьОтключитьПлагин(ИдентификаторПлагина, Включен)
	
	Плагин = КонтурПлагины_НайтиПлагин(ИдентификаторПлагина);
	
	ОписаниеПлагина = КонтурПлагин_Прочитать(Плагин);
	ОписаниеПлагина.Включен = Включен;
	
	КонтурПлагин_Записать(ОписаниеПлагина);
	
	Возврат Истина;
	
КонецФункции

Функция КонтурПлагины_КонтекстВызова()
	
	Результат = Новый Структура;
	Результат.Вставить("ВызывающийМодуль", ЭтотОбъект);
	Результат.Вставить("РежимОтладки",     НастройкиМодуля().РежимОтладки);
	Результат.Вставить("КаталогОтладки",   КонтурПлагины_КаталогОтладки());
	
	Возврат Результат;
	
КонецФункции

Функция КонтурПлагины_КаталогОтладки()
	
	Результат = "";
	
	Если НастройкиМодуля().РежимОтладки Тогда
		КаталогОтладки = НастройкиМодуля_КаталогОтладки();
		Результат = МодульОбщегоНазначения().ОбъединитьПути(КаталогОтладки, "plugins");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонтурПлагины_НайтиПлагин(ИдентификаторПлагина, ВызыватьИсключение = Истина)
	
	Результат = Неопределено;
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().КонтурПлагины;
	МассивСсылок = ДопСправочник_НайтиПоДопРеквизиту(ИмяСправочника, "Идентификатор", ИдентификаторПлагина);
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		Результат = МассивСсылок[0];
	Иначе
		
		Если ВызыватьИсключение Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось найти плагин по идентификатору %1'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ИдентификаторПлагина);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонтурПлагины_НастройкиПлагина(ИдентификаторПлагина)
	
	Результат = Неопределено;
	
	Плагин = КонтурПлагины_НайтиПлагин(ИдентификаторПлагина);
	ТипФайла = Перечисление_ТипыФайлов().ФайлНастроекПлагина;
	ФайлПлагина = Файл_Найти(Плагин, ТипФайла);
	Если ЗначениеЗаполнено(ФайлПлагина) Тогда
		Результат = Файл_Прочитать(ФайлПлагина).ДанныеФайла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

