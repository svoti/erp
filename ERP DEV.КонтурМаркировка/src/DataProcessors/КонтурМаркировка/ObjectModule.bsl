		Результат = Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок;
	Иначе
		Если ОписаниеЗадания.Команда = Перечисление_КомандыОбработки().ВыполнитьРегламентныеДействия Тогда
			Результат = Метаданные.РегламентныеЗадания.КонтурМаркировка_РегламентныеДействия;
		Иначе
			Результат = Метаданные.РегламентныеЗадания.КонтурМаркировка_ВыполнениеЗаданий;
