// #Область ТаблицаКодов

Процедура ТаблицаКодов_ЗаполнитьВложенныеКодыИзГИСМТ(ТаблицаКодов, Организация) Экспорт
	
	// BSLLS:CognitiveComplexity-off
	// BSLLS:NestedStatements-off
	
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	СтрокиАгрегатов = Новый Массив;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.ОбщийТипУпаковки <> ОбщиеТипыУпаковок.Комплект
			И Стр.ОбщийТипУпаковки <> ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
			СтрокиАгрегатов.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(СтрокиАгрегатов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаВложенныхКодов = Новый_ТаблицаКодов();
	
	Для каждого Элемент Из МассивСтруктур_Разбить(СтрокиАгрегатов, "ВидПродукции") Цикл
		
		ВидПродукции = Элемент.Ключ;
		СтрокиТаблицы = Элемент.Значение;
		
		КодыМаркировки = Новый Массив;
		Для каждого СтрАгрегата Из СтрокиТаблицы Цикл
			КодыМаркировки.Добавить(СтрАгрегата.КодМаркировки);
		КонецЦикла;
		
		Ответ = МодульЯдро().Маркировка_СтатусыКодов(КодыМаркировки, Организация, ВидПродукции);
		
		Для Сч = 0 По СтрокиТаблицы.ВГраница() Цикл
			
			СтрАгрегата = СтрокиТаблицы[Сч];
			
			Если Не ЗначениеЗаполнено(Ответ) Тогда
				Продолжить;
			КонецЕсли;
			
			CisInfo = Ответ[Сч];
			Если Не ЗначениеЗаполнено(CisInfo) Тогда
				Продолжить;
			КонецЕсли;
			
			value = CisInfo["value"];
			Если Не ЗначениеЗаполнено(value) Тогда
				Продолжить;
			КонецЕсли;
			
			childrenCodes = value["childrenCodes"];
			Если Не ЗначениеЗаполнено(childrenCodes) Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого КодМаркировки Из childrenCodes Цикл
				Стр = ТаблицаВложенныхКодов.Добавить();
				Стр.КодМаркировки = КодМаркировки;
				Стр.ВидПродукции = ВидПродукции;
				Стр.КодАгрегата = СтрАгрегата.КодМаркировки;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТаблицаВложенныхКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ВызыватьИсключение = Ложь;
	Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаВложенныхКодов, Организация, ВызыватьИсключение) Тогда
		Возврат;
	КонецЕсли;
	
	АгрегатыДляОбновления = ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаВложенныхКодов, "КодАгрегата", Истина);
	
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаВложенныхКодов);
	ТаблицаКодов_ПодобратьКлючиНоменклатуры1СПоТоварам(ТаблицаВложенныхКодов);
	ТаблицаЗначений_Дополнить(ТаблицаКодов, ТаблицаВложенныхКодов);
	КодыМаркировки_РасформироватьАгрегаты(АгрегатыДляОбновления);
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
	// BSLLS:CognitiveComplexity-on
	// BSLLS:NestedStatements-on
	
КонецПроцедуры

