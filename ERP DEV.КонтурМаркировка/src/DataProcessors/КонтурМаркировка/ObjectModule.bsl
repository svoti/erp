Функция ПолноеИмяСправочникаВидПродукции(ВызыватьИсключение = Ложь) Экспорт
	
	ТипыОбъектов = ТипыОбъектовИС();
	Если Не ЗначениеЗаполнено(ТипыОбъектов.ВидПродукции) Тогда
		Если ВызыватьИсключение Тогда
			ВызватьИсключение НСтр("ru = 'Не определен тип справочника организация 1С'");
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрЗаменить(ТипыОбъектов.ВидПродукции, "СправочникСсылка", "Справочник");
	
КонецФункции

Функция ИмяПоляВидПродукцииСправочникаНоменклатура(ВызыватьИсключение = Ложь) Экспорт
	
	ТипыОбъектов = ТипыОбъектовИС();
	
	Если Не ЗначениеЗаполнено(ТипыОбъектов.ВидПродукции) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяСправочника = ПолноеИмяСправочникаНоменклатуры();
	МетаданныеНоменклатуры = Метаданные.НайтиПоПолномуИмени(ИмяСправочника);
	
	Если ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.КатегорияНоменклатуры") Тогда
		Результат = "КатегорияНоменклатуры";
	ИначеЕсли ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.НоменклатурнаяГруппа") Тогда
		Результат = "НоменклатурнаяГруппа";
	ИначеЕсли ЕстьНеобходимыеМетаданные(ИмяСправочника + ".Реквизиты.ВидНоменклатуры") Тогда
		Результат = "ВидНоменклатуры";
	Иначе
		Результат = "";
		ТипВидаПродукции = Тип(ТипыОбъектов.ВидПродукции);
		Для каждого Реквизит Из МетаданныеНоменклатуры.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(ТипВидаПродукции) Тогда
				Результат = Реквизит.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СправочникНоменклатурыСодержитГруппы() Экспорт
	
	Возврат Метаданные.НайтиПоПолномуИмени(ПолноеИмяСправочникаНоменклатуры()).Иерархический;
	
