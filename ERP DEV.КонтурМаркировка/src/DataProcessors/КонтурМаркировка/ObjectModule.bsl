КонецФункции

// Записывает данные в справочник сервис-провайдеров
//
// Параметры:
//  ОписаниеСП - Структура - см. фунцию Новый_СервисПровайдер()
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_СервисПровайдеры
//
Функция СервисПровайдеры_Записать(ОписаниеСП)
	
	Ссылка = ОписаниеСП.Ссылка;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = СервисПровайдеры_НайтиПоИдентификатору(ОписаниеСП.Идентификатор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ПроверитьОбъектВПроцессеОбновления(Ссылка);
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.КонтурМаркировка_СервисПровайдеры.СоздатьЭлемент();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ОписаниеСП,, "Ссылка, ВидыПродукции");
	
	Объект.ВидыПродукции.Очистить();
	Для Каждого ВидПродукции Из ОписаниеСП.ВидыПродукции Цикл
		НоваяСтрока = Объект.ВидыПродукции.Добавить();
		НоваяСтрока.ВидПродукции = ВидПродукции;
	КонецЦикла;
	
	Объект.Записать();
	
	ОписаниеСП.Ссылка = Объект.Ссылка;
	
	Возврат Объект.Ссылка;
	
КонецФункции

// Находит сервис-провайдер в справочнике по его идентификатору.
//
// Параметры:
//  Идентификатор - Строка - идентификатор сервис-провайдера в сервисе;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_СервисПровайдеры - сервис-провайдер;
//  Неопределено - если идентификатор не задан;
//
Функция СервисПровайдеры_НайтиПоИдентификатору(Идентификатор)
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СервисПровайдеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_СервисПровайдеры КАК СервисПровайдеры
	|ГДЕ
	|	СервисПровайдеры.Идентификатор = &Идентификатор");
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Результат = ПолучитьРезультатЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

