// Добавляет в метрики описание окружения и настройки модуля и т.п.
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//  ПервыйЗапускМодуля - Строка - см. ЭтоПервыйЗапускМодуля();
//
Процедура Метрики_ПриИнициализации(Действие, ПервыйЗапускМодуля)
	
	Метрика_НастройкиМодуля(Действие);
	Метрики_НастройкиДокументов(Действие);
	Метрики_МаркируемыеТоварныеГруппы(Действие);
	Метрики_ОписаниеОрганизаций(Действие);
	Метрики_ВидыАгрегатов(Действие);
	Метрики_ДопПараметрыЭтикеток(Действие);
	Метрика_ОкружениеНаСервере(Действие);
	Метрики_ПараметрыПлагинов(Действие);
	
	МетрикаОП_ЗапускМодуля(ПервыйЗапускМодуля);
	
КонецПроцедуры

// Добавляет в метрики описание настроек документов учета
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрики_НастройкиДокументов(Действие)
	
	ВсеНастройки = НастройкиДокументовУчета_ВсеЭлементы();
	Для каждого Настройка Из ВсеНастройки Цикл
		Метрика_НастройкиДокумента(Действие, Настройка);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в метрики описание настроек товарных групп
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрики_МаркируемыеТоварныеГруппы(Действие)
	
	ВсеТоварныеГруппы = МаркируемыеТоварныеГруппы_ВсеЭлементы();
	Для каждого МаркируемаяТГ Из ВсеТоварныеГруппы Цикл
		Метрика_МаркируемаяТоварнаяГруппа(Действие, МаркируемаяТГ);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в метрики описание всех организаций
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрики_ОписаниеОрганизаций(Действие)
	
	ВсеОрганизации = Организация_ВсеОрганизации();
	Для каждого Организация Из ВсеОрганизации Цикл
		Метрика_ОписаниеОрганизации(Действие, Организация);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в метрики все используемые виды агрегатов
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрики_ВидыАгрегатов(Действие)
	
	ВсеВидыАгрегатов = ВидыАгрегатов_ВсеСсылки();
	Для каждого ВидАгрегата Из ВсеВидыАгрегатов Цикл
		Метрика_ВидАгрегата(Действие, ВидАгрегата)
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в метрики описание доп параметров для шаблонов этикеток
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрики_ДопПараметрыЭтикеток(Действие) Экспорт
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().ДопПараметрыЭтикеток;
	
	Для каждого ДопПараметр Из НастройкиМодуля().ДопПараметрыПечатиШаблонаЭтикеток Цикл
		ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопПараметр);
		СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики );
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в метрики параметры плагинов
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрики_ПараметрыПлагинов(Действие)
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().КонтурПлагины;
	ВсеПлагины = ДопСправочник_ВсеЭлементы(ИмяСправочника);
	
	Для Каждого Плагин Из ВсеПлагины Цикл
		Метрика_ПараметрыПлагина(Действие, Плагин);
	КонецЦикла;
	
КонецПроцедуры

Процедура Метрика_ПараметрыПлагина(Действие, Плагин)
	
	ОписаниеПлагина = КонтурПлагин_Прочитать(Плагин);
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().ПараметрыПлагина;
	
	ОписаниеМетрики = Новый_ОписаниеМетрики(
		Категория,
		Действие,
		ОписаниеПлагина,
		ОписаниеПлагина.Идентификатор,
		ОписаниеПлагина.Представление);
		
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики описание окружения
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрика_ОкружениеНаСервере(Действие)
	
	ДопСведения = ОписаниеКонтекстаНаСервере();
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().ОкружениеНаСервере;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики статистику по данным сеанса
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрика_СтатистикаСеансаНаСервере(Действие) Экспорт
	
	ДопСведения = ОписаниеСтатистикиСеансаНаСервере();
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().СтатистикаСеанса;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики описание настроек модуля
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрика_НастройкиМодуля(Действие) Экспорт
	
	ДопСведения = ОписаниеНастроекМодуляДляМетрики();
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().НастройкиМодуля;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики описание настроек рабочего стола
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//
Процедура Метрика_НастройкиРабочегоСтола(Действие) Экспорт
	
	ДопСведения = ОписаниеНастроекРабочегоСтолаДляМетрики();
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().НастройкиРабочегоСтола;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики описание настройки документа учета
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//  Настройка - СправочникСсылка.КонтурМаркировка_ДопСправочники - настройка документа;
//
Процедура Метрика_НастройкиДокумента(Действие, Настройка) Экспорт
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(Настройка);
	Наименование = ОписаниеНастройки.Наименование;
	ТипДокумента = ОписаниеНастройки.ТипДокумента;
	
	Категория = Перечисление_КатегорииМетрики().НастройкиДокументов;
	ДопСведения = ОписаниеНастройкиДокументаДляМетрики(ОписаниеНастройки);
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, ТипДокумента, Наименование);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
	Категория = Перечисление_КатегорииМетрики().КомандыДокументов;
	ДопСведения = ОписаниеИспользуемыхКомандДокументаДляМетрики(ОписаниеНастройки);
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, ТипДокумента, Наименование);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
	Категория = Перечисление_КатегорииМетрики().ДопКолонокиВСпискеДокументов;
	ДопСведения = ОписаниеФормулДопКолонокСпискаДокументовДляМетрики(ОписаниеНастройки);
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, ТипДокумента, Наименование);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики описание настроек заполнения операций
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//  ОписаниеНастройки - Структура - описание настроек заполнения операций;
//
Процедура Метрика_НастройкиЗаполненияОпераций(Действие, ОписаниеНастройки) Экспорт
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().НастройкиЗаполненияОпераций;
	ТипДокумента = ОписаниеНастройки.ТипДокумента;
	
	Для Каждого Стр Из ОписаниеНастройки.ТаблицаРеквизитов Цикл
		ДопСведения = ОписаниеНастроекЗаполненияОперацийДляМетрики(Стр, ОписаниеНастройки.ТипыОпераций);
		ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Стр.ТипОперации, ТипДокумента);
		СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в метрики описание маркируемой товарной группы
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//  МаркируемаяТГ - СправочникСсылка.КонтурМаркировка_ДопСправочники - настройка маркируемой товарной группы;
//
Процедура Метрика_МаркируемаяТоварнаяГруппа(Действие, МаркируемаяТГ)
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().НастройкиТоварныхГрупп;
	ОписаниеТоварнойГруппы = МаркируемаяТоварнаяГруппа_Прочитать(МаркируемаяТГ);
	ДопСведения = ОписаниеНастройкиТоварнойГруппы(ОписаниеТоварнойГруппы);
	ВидПродукции = СокрЛП(ОписаниеТоварнойГруппы.ВидПродукции);
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, ВидПродукции);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики описание организации
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//
Процедура Метрика_ОписаниеОрганизации(Действие, Организация) Экспорт
	
	ОписаниеОрганизации = Организация_Прочитать(Организация);
	ДопСведения = ОписаниеОрганизацииДляМетрики(ОписаниеОрганизации);
	Наименование = ОписаниеОрганизации.Наименование;
	Идентификатор = ОписаниеОрганизации.Идентификатор;
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().Организации;
	
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Идентификатор, Наименование);
	ОписаниеМетрики.Организация = Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики используемые виды агрегатов
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//  ВидАгрегата - СправочникСсылка.КонтурМаркировка_ВидыАгрегатов - вид агрегата;
//
Процедура Метрика_ВидАгрегата(Действие, ВидАгрегата) Экспорт
	
	ОписаниеВидаАгрегата = ВидАгрегата_Прочитать(ВидАгрегата);
	ДопСведения = ОписаниеВидаАгрегатаДляМетрики(ОписаниеВидаАгрегата);
	Наименование = ОписаниеВидаАгрегата.Наименование;
	Префикс = ОписаниеВидаАгрегата.Префикс;
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().ВидыАгрегатов;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Префикс, Наименование);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

Процедура Метрика_РазвернутаяТаблицаУпаковок(Документы1С, РазвернутаяТаблицаУпаковок, Ошибки, ВызывающийМодуль);
	
	ДокументыУчета = ДокументыУчета_НайтиПоДокументам1С(Документы1С);
	Если Не ЗначениеЗаполнено(ДокументыУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументУчета = ДокументыУчета[0];
	Организация = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "Организация");
	
	ДопСведения = ОписаниеСведенийОМаркировкеДляМетрики(
	ДокументыУчета, Ошибки, РазвернутаяТаблицаУпаковок.Количество(), ВызывающийМодуль, Новый Массив);
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Действие = Перечисление_ДействияМетрики().ВызовМетода;
	Категория = Перечисление_КатегорииМетрики().РазвернутаяТаблицаУпаковок;
	
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Организация.Идентификатор);
	ОписаниеМетрики.Организация = Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики описание настроек дополнительных колонок
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//  Настройки - Структура - настройки дополнительных колонок;
//
Процедура Метрика_НастройкиДопКолонокСпискаДокументов(Действие, Настройки)
	
	Если Не Настройки.ДопКолонка1.Видимость
		И Не Настройки.ДопКолонка2.Видимость
		И Не Настройки.ДопКолонка3.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	Функциональность = Перечисление_ФункциональностьМодуля().ДопКолонокиВСпискеДокументов;
	Если СтекМетрик_ФункциональностьУчтена(Функциональность) Тогда
		Возврат;
	КонецЕсли;
	
	СтекМетрик_ДобавитьФункциональность(Функциональность);
	
	НастройкаЧерезПМ = (Действие = Перечисление_ДействияМетрики().ОбработкаСобытияПМ);
	ДопСведения = ОписаниеНастроекДопКолонокСпискаДокументовДляМетрики(Настройки, НастройкаЧерезПМ);
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().ДопКолонокиВСпискеДокументов;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики описание параметров редактирования переменной характеристики кодов
//
// Параметры:
//  Действие - Строка - см. Перечисление_ДействияМетрики();
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  ДопСведения - Структура - содержит:
//            * ВидПродукции - Строка - вид продукции;
//            * ПеременнаяХарактеристика - Строка - тип переменной характеристики;
//            * КоличествоКодов - Число - количество кодов в редакторе;
//            * КоличествоРазличныхЗначений - Число - количество уникальных значений характеристики;
//
Процедура Метрика_РедактированиеПеременнойХарактеристики(Действие, Организация, ДопСведения) Экспорт
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().РедактированиеПеременнойХарактеристики;
	
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Организация.Идентификатор);
	ОписаниеМетрики.Организация = Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики результат опроса пользователя
//
// Параметры:
//  ОписаниеРезультата - Структура - см. Новый_РезультатОпросаПользователя();
//
Процедура Метрика_РезультатОпросаПользователя(ОписаниеРезультата) Экспорт
	
	Если ОписаниеРезультата.ОпросПройден Тогда
		Действие = Перечисление_ДействияМетрики().Пройден;
	Иначе
		Действие = Перечисление_ДействияМетрики().Отказ;
	КонецЕсли;
	
	Топик = Перечисление_ТопикиМетрики().ОбратнаяСвязь;
	Категория = ОписаниеРезультата.КлючСценария;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ОписаниеРезультата);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
	ОтправитьМетрики();
	
КонецПроцедуры

Процедура Метрика_ЗаполнениеСведенийОМаркировке(ТоварыДокументов, ОшибкиМаркировки, ВызывающийМодуль)
	
	Документы1С = ТаблицаЗначений_ВыгрузитьКолонку(ТоварыДокументов, "ПервичныйДокумент");
	ДокументыУчета = ТаблицаЗначений_ВыгрузитьКолонку(ТоварыДокументов, "ДокументУчета", Истина);
	
	Если Не ЗначениеЗаполнено(ДокументыУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ЗначениеРеквизитаОбъектаЛок(ДокументыУчета[0], "Организация");
	
	МассивКодов = Новый Массив;
	ТипыХарактеристик = Новый Массив;
	Для Каждого СведенияОМаркировке Из ТоварыДокументов.ВыгрузитьКолонку("СведенияОМаркировке") Цикл
		ДополнитьМассив(МассивКодов, СведенияОМаркировке.ВыгрузитьКолонку("ЗначениеШтрихкода"), Истина, Ложь);
		ДополнитьМассив(ТипыХарактеристик, СведенияОМаркировке.ВыгрузитьКолонку("ПеременнаяХарактеристика"), Истина, Ложь);
	КонецЦикла;
	
	ДопСведения = ОписаниеСведенийОМаркировкеДляМетрики(
	ДокументыУчета, ОшибкиМаркировки, МассивКодов.Количество(), ВызывающийМодуль, ТипыХарактеристик);
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Действие = Перечисление_ДействияМетрики().ВызовМетода;
	Категория = Перечисление_КатегорииМетрики().ЗаполнениеСведенийОМаркировке;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Организация.Идентификатор);
	ОписаниеМетрики.Организация = Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
	МетрикаОП_ЦелевоеДействие_ЗаполнениеСведенийОМаркировке(Организация);
	
КонецПроцедуры

Процедура Метрика_СостояниеМаркировки(Организация, ВызывающийМодуль)
	
	ДопСведения = Новый Структура("ВызывающийМодуль", ВызывающийМодуль);
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Действие = Перечисление_ДействияМетрики().ЗапросСостоянияМаркировки;
	Категория = Перечисление_КатегорииМетрики().СостояниеМаркировки;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Организация.Идентификатор);
	ОписаниеМетрики.Организация = Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

Процедура Метрика_ОткрытиеФормыСостоянияМаркировки(ИдентификаторТрассировки, Организация, ТипБаннера, ВызывающийМодуль) Экспорт
	
	ДопСведения = Новый Структура;
	ДопСведения.Вставить("ТипБаннера", ТипБаннера);
	ДопСведения.Вставить("ВызывающийМодуль", ВызывающийМодуль);
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().СостояниеМаркировки;
	Действие = Перечисление_ДействияМетрики().ОткрытиеФормы;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Организация.Идентификатор);
	ОписаниеМетрики.ИдентификаторТрассировки = ИдентификаторТрассировки;
	ОписаниеМетрики.Организация = Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
