// Возвращает основные и дополнительные команды для открываемого документа 1С.
//
// Параметры:
//  Документ1С - ДокументСсылка - ссылка на открываемый документ 1С.
// 
// Возвращаемое значение:
//  Структура - доступные документу команды.
//    * Основные - Массив - описание команды см. МодульКонтурИнтеграцияКлиентСервер.ОписаниеКоманды.
//    * Дополнительные - Массив - описание команды см. МодульКонтурИнтеграцияКлиентСервер.ОписаниеКоманды.
//
Функция КонтурИнтеграция_КомандыДокумента1С(Документ1С) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Основные", Новый Массив);
	Результат.Вставить("Дополнительные", Новый Массив);
	
	Если Не НастройкиДокументовУчета_ЕстьНастройка(Документ1С) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
	ТребуемоеДействие = ДокументУчета_ТребуемоеДействие(ДокументУчета);
	
	ИмяМодуля = "Маркировка";
	МодульКонтурИнтеграцияКлиентСервер = ОбщийМодуль("КонтурИнтеграцияКлиентСервер");
	
	// Основные команды.
	ВсеКоманды = КонтурИнтеграция_ВсеКомандыДокументов1С();
	
	Для Каждого Команда Из ВсеКоманды Цикл
		
		ОписаниеКоманды = МодульКонтурИнтеграцияКлиентСервер.ОписаниеКоманды(ИмяМодуля);
		ОписаниеКоманды.Заголовок = Команда.Представление;
		ОписаниеКоманды.Видимость = (Команда.Значение = ТребуемоеДействие);
		ОписаниеКоманды.Доступность = Истина;
		ОписаниеКоманды.НомерКоманды = ВсеКоманды.Индекс(Команда);
		
		Результат.Основные.Добавить(ОписаниеКоманды);
		
	КонецЦикла;
	
	// Дополнительные команды.
	ОписаниеКоманды = МодульКонтурИнтеграцияКлиентСервер.ОписаниеКоманды(ИмяМодуля);
	ОписаниеКоманды.Заголовок = НСтр("ru = 'Маркировка'");
	ОписаниеКоманды.Видимость = Истина;
	ОписаниеКоманды.Доступность = Истина;
	ОписаниеКоманды.НомерКоманды = 1;
	
	Результат.Дополнительные.Добавить(ОписаниеКоманды);
	
	Возврат Результат;
	
КонецФункции

