// Находит в базе операцию Входящий УПД по номеру и дате входящего документа (с точностью до дня)
// Если в базе есть несколько операций в указанной дате, то возвращается последняя
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  КонтрагентИНН - Строка - ИНН отправителя входящего электронного документа;
//  НомерДокумента - Строка - номер входящего электронного документа;
//  ДатаДокумента - Дата   - дата входящего электронного документа (с точностью до дня);
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции - последняя найденная операция;
//  Неопределено - если операция не найдена;
//
Функция Операция_НайтиОперацию_ВходящийУПД(Организация, КонтрагентИНН, НомерДокумента, ДатаДокумента)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СпрОперации.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА) КАК ДатаДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК НомераДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК СпрОперации
	|		ПО НомераДокументов.Объект = СпрОперации.Ссылка
	|			И (СпрОперации.ТипОперации = &ТипОперации)
	|			И (СпрОперации.Организация = &Организация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ИННКонтрагентов
	|		ПО (СпрОперации.Ссылка = ИННКонтрагентов.Объект)
	|			И (ИННКонтрагентов.ИмяРеквизита = &РеквизитКонтрагентИНН)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДатыДокументов
	|		ПО (СпрОперации.Ссылка = ДатыДокументов.Объект)
	|			И (ДатыДокументов.ИмяРеквизита = &РеквизитДатаДокумента)
	|ГДЕ
	|	НомераДокументов.Значение = &НомерДокумента
	|	И НомераДокументов.ИмяРеквизита = &РеквизитНомерДокумента
	|	И ИННКонтрагентов.Значение = &КонтрагентИНН
	|	И НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ДатыДокументов.Значение КАК ДАТА), ДЕНЬ) = &ДатаДокумента
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокумента УБЫВ");
	
	Запрос.УстановитьПараметр("РеквизитДатаДокумента"	, "ДатаДокумента");
	Запрос.УстановитьПараметр("РеквизитНомерДокумента"	, "НомерДокумента");
	Запрос.УстановитьПараметр("РеквизитКонтрагентИНН"	, "КонтрагентИНН");
	
	Запрос.УстановитьПараметр("ДатаДокумента"	, НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("НомерДокумента"	, НомерДокумента);
	Запрос.УстановитьПараметр("КонтрагентИНН"	, КонтрагентИНН);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТипОперации", Перечисление_ТипыОпераций().ВходящийУПД);
	
	Результат = ПолучитьРезультатЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

// Создает операцию нужного типа и заполняет ее данными и записывает в базу
//
// Параметры:
//  ТипОперации - Строка - тип операции, см. Перечисление_ТипыОпераций();
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - (необязательный)
//                                    документ учета, с которым связана новая операция;
//  ОперацияОснование - СправочникСсылка.КонтурМаркировка_Операции - (необязательный)
//                           операция, на основании которой создается новая операция;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  ТаблицаКодов - ТаблицаЗначений - см. Новый_ТаблицаКодов();
//  ИсточникСоздания - Строка - источник создания операции;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции
//
Функция Операция_Создать(ТипОперации
	, ДокументУчета = Неопределено
	, ОперацияОснование = Неопределено
	, Организация = Неопределено
	, ТаблицаКодов = Неопределено
	, ИсточникСоздания = Неопределено) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ОписаниеОперации = Новый_Операция();
		ОписаниеОперации.ТипОперации = ТипОперации;
		ОписаниеОперации.ДокументУчета = ДокументУчета;
		ОписаниеОперации.ОперацияОснование = ОперацияОснование;
		ОписаниеОперации.Организация = Организация;
		
		Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
			ТаблицаКодов = Новый_ТаблицаКодов();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИсточникСоздания) Тогда
			ОписаниеОперации.ДопРеквизиты.ИсточникСоздания = ИсточникСоздания;
		КонецЕсли;
		
		Операция_Заполнить(ОписаниеОперации, ТаблицаКодов);
		
		Операция = Операция_Записать(ОписаниеОперации);
		
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Операция;
	
КонецФункции

Функция Операция_СоздатьИЗаполнитьОперациюПечати(ДокументУчета = Неопределено, ОперацияОснование = Неопределено
	, ПараметрыПодбораКодов = Неопределено) Экспорт
	
	ОписаниеОперации = Новый_Операция();
	ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().ПечатьКодов;
	ОписаниеОперации.ДокументУчета = ДокументУчета;
	ОписаниеОперации.ОперацияОснование = ОперацияОснование;
	Операция_Заполнить(ОписаниеОперации);
	
	ОписаниеОперации.Товары.Очистить();
	СтрТовара = ОписаниеОперации.Товары.Добавить();
	Если ЗначениеЗаполнено(ПараметрыПодбораКодов) Тогда
		СтрТовара.Товар = ПараметрыПодбораКодов.Товар;
		СтрТовара.КлючНоменклатуры1С = ПараметрыПодбораКодов.КлючНоменклатуры1С;
		СтрТовара.КоличествоУпаковок = ПараметрыПодбораКодов.КоличествоКодовТребуется;
	КонецЕсли;
	
	Операция_Записать(ОписаниеОперации);
	Операция_ЗаполнитьКодами(ОписаниеОперации);
	
	Операция_ПечатьКодов_ЗаполнитьШаблоныЭтикеток(ОписаниеОперации);
	Операция_Записать(ОписаниеОперации);
	
	Возврат ОписаниеОперации.Ссылка;
	
КонецФункции

Процедура Операция_ЗаполнитьКодами(ОписаниеОперации) Экспорт
	
	Операция = ОписаниеОперации.Ссылка;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	ТипОперацииОснования = ЗначениеРеквизитаОбъектаЛок(ОперацияОснование, "ТипОперации");
	
	Если Не ЗанятьОбъект(Операция) Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось занять операцию для подбора кодов маркировки: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, Операция);
	КонецЕсли;
	
	Попытка
		
		КодыОпераций_Записать(Новый_ТаблицаКодов(), Операция);
		ТребуемыеКоды = Операция_ТребуемыеКоды(ОписаниеОперации);
		
		Если ТипОперацииОснования = Перечисление_ТипыОпераций().ЗаказКодов Тогда
			
			ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
			ДопРеквизитыОснования = ОписаниеОснования.ДопРеквизиты;
			СпособВыпуска = ДопРеквизитыОснования.СпособВыпускаТоваров;
			ЗаказКодовСТипомЗаказа = ЗначениеЗаполнено(ДопРеквизитыОснования.ТипЗаказаКодов)
				И ЗначениеЗаполнено(ДопРеквизитыОснования.КлючКода);
			
			Если СпособВыпуска = Перечисление_СпособыВыпускаТоваров().Перемаркировка Или ЗаказКодовСТипомЗаказа Тогда
				КодыПодобраны = КодыОпераций_Подобрать(Операция, ТребуемыеКоды, ОперацияОснование);
			Иначе
				КодыПодобраны = КодыЗаказов_Подобрать(Операция, ТребуемыеКоды, ОперацияОснование);
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ОперацияОснование) Тогда
			
			КодыПодобраны = КодыОпераций_Подобрать(Операция, ТребуемыеКоды, ОперацияОснование);
			
		ИначеЕсли ЗначениеЗаполнено(ДокументУчета) Тогда
			
			КодыПодобраны = КодыДокументов_Подобрать(Операция, ТребуемыеКоды, ДокументУчета);
			
		Иначе
			
			КодыПодобраны = КодыЗаказов_Подобрать(Операция, ТребуемыеКоды);
			
		КонецЕсли;
		
		ОсвободитьОбъект(Операция);
		
	Исключение
		ОсвободитьОбъект(Операция);
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Определяет по статусу что операция завершена
