// Заполняет операцию и таблицу кодов для нее
//
// Параметры:
//  ОписаниеОперации - Структура	 - см. Новый_Операция();
//  ТаблицаКодов	 - ТаблицаЗначений	 - таблица кодов операции, см. функцию Новый_ТаблицаКодов();
//  ИсточникСоздания - Строка			 - источник создания операции;
