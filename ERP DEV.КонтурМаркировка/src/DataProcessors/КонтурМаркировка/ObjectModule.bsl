КонецПроцедуры

// Формирует строку доп. информации для журнала регистрации
//
// Параметры:
//  ДопИнформация - Массив, Соответствие, Структура, Строка, Ссылка - доп. информация
// 
// Возвращаемое значение:
//  Строка - строка доп. информации
//
Функция СтрокаДопИнформацииДляЖурналаРегистрации(ДопИнформация)
	
	ТипДопИнформации = ТипЗнч(ДопИнформация);
	СтрокиДопИнформации = Новый Массив;
	ШаблонКлючЗначение = "%1: %2";
	
	Если ТипДопИнформации = Тип("Строка") Тогда
		
		СтрокиДопИнформации.Добавить(ДопИнформация);
		
	ИначеЕсли ЭтоМассив(ДопИнформация) Тогда
		
		Для каждого Элемент Из ДопИнформация Цикл
			СтрокиДопИнформации.Добавить(СокрЛП(Элемент));
		КонецЦикла;
		
	ИначеЕсли ТипДопИнформации = Тип("СписокЗначений") Тогда
		
		Для каждого Элемент Из ДопИнформация Цикл
			СтрокаКлючЗначение = ПараметрыВСтроку(ШаблонКлючЗначение, Элемент.Представление, Элемент.Значение);
			СтрокиДопИнформации.Добавить(СтрокаКлючЗначение);
		КонецЦикла;
		
	ИначеЕсли ЭтоСтруктура(ДопИнформация) Или ЭтоСоответствие(ДопИнформация) Тогда
		
		Для каждого Элемент Из ДопИнформация Цикл
			СтрокаКлючЗначение = ПараметрыВСтроку(ШаблонКлючЗначение, Элемент.Ключ, Элемент.Значение);
			СтрокиДопИнформации.Добавить(СтрокаКлючЗначение);
		КонецЦикла;
		
	ИначеЕсли ЭтоСсылка(ДопИнформация) Тогда
		
		СтрокиДопИнформации.Добавить(СокрЛП(ДопИнформация));
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Недопустимый тип доп. информации для записи в журнал регистрации: 1%'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТипДопИнформации);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Результат = СоединитьСтроку(СтрокиДопИнформации, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

