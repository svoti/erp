Процедура ЗаполнитьОписаниеОперацииДляСовместимостиПМ(ОписаниеОперации)
	
	ВерсияПМ = ВерсияОбработкиПМ();
	Если Не ЗначениеЗаполнено(ВерсияПМ) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		Если ЗначениеЗаполнено(Стр.РазрешительныйДокумент) Тогда
			Стр.ВидДокументаСертификации = Стр.РазрешительныйДокумент.ВидДокумента;
			Стр.ДатаДокументаСертификации = Стр.РазрешительныйДокумент.ДатаОформления;
			Стр.НомерДокументаСертификации = Стр.РазрешительныйДокумент.Код;
		КонецЕсли;
	КонецЦикла;
		
	Если СравнитьВерсии(ВерсияПМ, "3.0") < 0 Тогда
		
		ОписаниеОперации.Вставить("ИсходныеТовары", ОписаниеОперации.Товары);
		ОписаниеОперации.Вставить("Товары", Новый Массив);
		
		Для Каждого Стр Из ОписаниеОперации.ИсходныеТовары Цикл
			
			СтрПМ = Новый_Операция_СтрокаТовары_2_19();
			ЗаполнитьЗначенияСвойств(СтрПМ, Стр);
			ЗаполнитьЗначенияСвойств(СтрПМ.ДопРеквизиты, Стр);
			
			СтрПМ.КоличествоКодов = Стр.КоличествоУпаковок;
			СтрПМ.КлючСтроки = Строка(Стр.КлючСтрокиОперации);
			СтрПМ.КлючСтрокиТоваров = Строка(Стр.КлючСтрокиДокумента);
			СтрПМ.КлючНоменклатуры1С = АналитикаНоменклатуры1С(Стр.КлючНоменклатуры1С);
			СтрПМ.ДопРеквизиты.КоличествоКодовВложенногоТовара = Стр.КоличествоУпаковокВложенногоТовара;
			
			ОписаниеОперации.Товары.Добавить(СтрПМ);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВосстановитьОписаниеОперацииПослеВызоваПМ(ОписаниеОперации)
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	Если ОписаниеОперации.Свойство("ИсходныеТовары") Тогда
		
		ИсходныеТовары = ОписаниеОперации.ИсходныеТовары;
		ТоварыПМ = ОписаниеОперации.Товары;
		
		ОписаниеОперации.Удалить("ИсходныеТовары");
		ОписаниеОперации.Вставить("Товары", Новый_Операция_Товары());
		
		Для Каждого СтрПМ Из ТоварыПМ Цикл
			
			Стр = ОписаниеОперации.Товары.Добавить();
			Стр.КлючСтрокиОперации = Новый УникальныйИдентификатор(СтрПМ.КлючСтроки);
			
			Если ЗначениеЗаполнено(Стр.КлючСтрокиОперации) Тогда
				ИсходнаяСтрока = ИсходныеТовары.Найти(Стр.КлючСтрокиОперации, "КлючСтрокиОперации");
				Если ИсходнаяСтрока <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(Стр, ИсходнаяСтрока);
				КонецЕсли;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(Стр, СтрПМ);
			ЗаполнитьЗначенияСвойств(Стр, СтрПМ.ДопРеквизиты);
			
			Стр.КоличествоУпаковок = СтрПМ.КоличествоКодов;
			Стр.ДатаСрокаГодности = СтрПМ.ДопРеквизиты.СрокГодности;
			Стр.КоличествоУпаковокВложенногоТовара = СтрПМ.ДопРеквизиты.КоличествоКодовВложенногоТовара;
			Стр.КлючСтрокиДокумента = Новый УникальныйИдентификатор(СтрПМ.КлючСтрокиТоваров);
			Стр.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(СтрПМ.КлючНоменклатуры1С);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОчиститьСрокГодности = (ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации)
	И Не ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесении(ОписаниеОперации.ВидПродукции, ДопРеквизиты.ТипОтчетаОНанесении));
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если ЗначениеЗаполнено(Стр.НомерДокументаСертификации) Тогда
			
			ОписаниеРД = Новый_РазрешительныйДокумент();
			ОписаниеРД.Номер = Стр.НомерДокументаСертификации;
			ОписаниеРД.ВидДокумента = Стр.ВидДокументаСертификации;
			ОписаниеРД.ДатаОформления = Стр.ДатаДокументаСертификации;
			
			Стр.РазрешительныйДокумент = РазрешительныйДокумент_Записать(ОписаниеРД);
			
		КонецЕсли;
		
		Если ОчиститьСрокГодности Тогда
			Стр.ДатаСрокаГодности = ПустаяДата();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОписаниеДокументаДляСовместимостиПМ(ОписаниеДокумента)
	
	ВерсияПМ = ВерсияОбработкиПМ();
	Если Не ЗначениеЗаполнено(ВерсияПМ) Тогда
		Возврат;
	КонецЕсли;
	
	Если СравнитьВерсии(ВерсияПМ, "3.0") < 0 Тогда
		
		ОписаниеДокумента.Вставить("ДокументОснование", ОписаниеДокумента.ДопРеквизиты.ДокументОснование);
		ОписаниеДокумента.ДопРеквизиты.Удалить("ДокументОснование");
		
		ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
		ТоварыМаркировки = ОписаниеДокумента.ТоварыМаркировки;
		
		ОписаниеДокумента.Удалить("ТоварыМаркировки");
		ОписаниеДокумента.Вставить("Товары", Новый Массив);
		ОписаниеДокумента.Вставить("ТоварыДокумента", Новый Массив);
		
		Для Каждого Стр Из ТоварыДокумента Цикл
			НоваяСтрока = Новый_ДокументУчета_СтрокаТоварыДокумента_2_19();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.Количество1С = Стр.Количество;
			НоваяСтрока.Количество = Стр.КоличествоУпаковок;
			НоваяСтрока.КлючСтрокиТоваров = Строка(Стр.КлючСтрокиДокумента);
			НоваяСтрока.КлючНоменклатуры1С = АналитикаНоменклатуры1С(Стр.КлючНоменклатуры1С);
			ОписаниеДокумента.ТоварыДокумента.Добавить(НоваяСтрока);
		КонецЦикла;
		
		Для Каждого Стр Из ТоварыМаркировки Цикл
			НоваяСтрока = Новый_ДокументУчета_СтрокаТовары_2_19();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.Количество = Стр.КоличествоУпаковок;
			НоваяСтрока.КлючСтрокиТоваров = Строка(Стр.КлючСтрокиДокумента);
			ОписаниеДокумента.Товары.Добавить(НоваяСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
	Если СравнитьВерсии(ВерсияПМ, "2.18") < 0 Тогда
		ПравилаОтраженияВЭДО = Перечисления.КонтурМаркировка_ПравилаОтраженияВЭДО;
		Для каждого Стр Из ОписаниеДокумента.ТоварыДокумента Цикл
			Стр.Вставить("ОбъемноСортовойУчет", (Стр.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ОСУ));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВосстановитьОписаниеДокументаПослеВызоваПМ(ОписаниеДокумента)
	
	Если ТипЗнч(ОписаниеДокумента.ТоварыДокумента) = Тип("Массив") Тогда
		
		Товары = ОписаниеДокумента.Товары;
		ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
		
		ОписаниеДокумента.Вставить("ТоварыДокумента", Новый_ДокументУчета_ТоварыДокумента());
		ОписаниеДокумента.Вставить("ТоварыМаркировки", Новый_ДокументУчета_ТоварыМаркировки());
		ОписаниеДокумента.Удалить("Товары");
		
		Для Каждого Стр Из ТоварыДокумента Цикл
			НоваяСтрока = ОписаниеДокумента.ТоварыДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.Количество = Стр.Количество1С;
			НоваяСтрока.КоличествоУпаковок = Стр.Количество;
			НоваяСтрока.КлючСтрокиДокумента = Новый УникальныйИдентификатор(Стр.КлючСтрокиТоваров);
			НоваяСтрока.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр.КлючНоменклатуры1С);
		КонецЦикла;
		
		Для Каждого Стр Из Товары Цикл
			НоваяСтрока = ОписаниеДокумента.ТоварыМаркировки.Добавить();
			НоваяСтрока.Товар = Стр.Товар;
			НоваяСтрока.КоличествоУпаковок = Стр.Количество;
			НоваяСтрока.КлючСтрокиДокумента = Новый УникальныйИдентификатор(Стр.КлючСтрокиТоваров);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ОписаниеДокумента.Свойство("ДокументОснование") Тогда
		ОписаниеДокумента.ДопРеквизиты.Вставить("ДокументОснование", ОписаниеДокумента.ДокументОснование);
		ОписаниеДокумента.Удалить("ДокументОснование");
	КонецЕсли;
	
КонецПроцедуры

Процедура ВосстановитьПараметрыЗагрузкиКодовДляСовместимостиПМ(ПараметрыПМ)
	
	Если ПараметрыПМ.Свойство("ПараметрыЗагрузкиКодов") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПМ.Вставить("ПараметрыЗагрузкиКодов", Новый_ПараметрыЗагрузкиНовыхКодовВДокумент());
	ЗаполнитьЗначенияСвойств(ПараметрыПМ.ПараметрыЗагрузкиКодов, ПараметрыПМ);
	
	Для Каждого КлючЗначение Из ПараметрыПМ.ПараметрыЗагрузкиКодов Цикл
		
		Если ПараметрыПМ.Свойство(КлючЗначение.Ключ) Тогда
			ПараметрыПМ.Удалить(КлючЗначение.Ключ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВосстановитьТаблицуКодовДляСовместимостиМодуль(ТаблицаКодов)
	
	КолонкаОбъем = ТаблицаКодов.Колонки.Найти("Объем");
	Если КолонкаОбъем <> Неопределено Тогда
		КолонкаОбъем.Имя = "Количество";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуКодовДляСовместимостиПМ(ТаблицаКодов)
	
	ВерсияПМ = ВерсияОбработкиПМ();
	Если Не ЗначениеЗаполнено(ВерсияПМ) Тогда
		Возврат;
	КонецЕсли;
	
	Если СравнитьВерсии(ВерсияПМ, "3.0") < 0 Тогда
		ТаблицаКодов.Колонки.Количество.Имя = "Объем";
	КонецЕсли;
	
КонецПроцедуры

Функция ТаблицаКодовИзОписанийКодов(ОписанияКодов) Экспорт
	
	Результат = Новый_ТаблицаКодов();
	
	ЗаполнитьТаблицуКодовИзОписанийКодов(Результат, ЗначениеВМассиве(ОписанияКодов));
	
	Возврат Результат;
	
КонецФункции

Функция ОписанияКодовИзТаблицыКодов(ТаблицаКодов)
	
	Результат = Новый Массив;
	
	ТаблицаКодов.Колонки.Добавить("ОписаниеКода");
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		
		ОписаниеКода = Новый_ОписаниеНовогоКодаМаркировки();
		ЗаполнитьЗначенияСвойств(ОписаниеКода, СтрКода);
		ЗаполнитьЗначенияСвойств(ОписаниеКода.АналитикаНоменклатуры, СтрКода);
		ЗаполнитьЗначенияСвойств(ОписаниеКода.ДопСведения, СтрКода);
		ЗаполнитьЗначенияСвойств(ОписаниеКода.ДанныеСервиса, СтрКода);
		
		ОписаниеКода.ДопСведения.Объем = СтрКода.Количество;
		
		Если СтрКода.КодРазобран Тогда
			ОписаниеКода.НормализованныйКодМаркировки = СтрКода.КодМаркировки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрКода.ИсходныйКодМаркировки) Тогда
			ОписаниеКода.КодМаркировки = СтрКода.ИсходныйКодМаркировки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрКода.ДатаСрокаГодности) Тогда
			ОписаниеКода.ДопСведения.СрокГодности = СтрКода.ДатаСрокаГодности;
		КонецЕсли;
		
		СтрКода.ОписаниеКода = ОписаниеКода;
		
	КонецЦикла;
	
	Индекс = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		Если ЗначениеЗаполнено(СтрКода.КодАгрегата) Тогда
			СтрАгрегата = ТаблицаКодов.Найти(СтрКода.КодАгрегата, "КодМаркировки");
			СтрАгрегата.ОписаниеКода.ВложенныеКоды.Добавить(СтрКода.ОписаниеКода);
		Иначе
			Результат.Добавить(СтрКода.ОписаниеКода);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов.Колонки.Удалить("ОписаниеКода");
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТаблицуКодовИзОписанийКодов(ТаблицаКодов, ОписанияКодов, КодАгрегата = Неопределено)
	
	ТипИдентификатор = Тип("УникальныйИдентификатор");
	
	Для каждого ОписаниеКода Из ОписанияКодов Цикл
		
		СтрКода = ТаблицаКодов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрКода, ОписаниеКода);
		ЗаполнитьЗначенияСвойств(СтрКода, ОписаниеКода.АналитикаНоменклатуры);
		ЗаполнитьЗначенияСвойств(СтрКода, ОписаниеКода.ДопСведения);
		ЗаполнитьЗначенияСвойств(СтрКода, ОписаниеКода.ДанныеСервиса, , "GTIN");
		
		СтрКода.Количество = ОписаниеКода.ДопСведения.Объем;
		
		Если ЗначениеЗаполнено(ОписаниеКода.КлючСтроки) Тогда
			СтрКода.КлючСтрокиОперации = Новый УникальныйИдентификатор(ОписаниеКода.КлючСтроки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеКода.КлючСтрокиТоваров) Тогда
			СтрКода.КлючСтрокиДокумента = Новый УникальныйИдентификатор(ОписаниеКода.КлючСтрокиТоваров);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрКода.ОбщийТипУпаковки) Тогда
			Если ЗначениеЗаполнено(СтрКода.Товар) Тогда
				СтрКода.ОбщийТипУпаковки = ОбщийТипУпаковкиПоТипуКодаМаркировки(СтрКода.Товар.ТипКодаМаркировки);
			Иначе
				СтрКода.ОбщийТипУпаковки = ОбщийТипУпаковкиПоВидуУпаковки(ОписаниеКода.ВидУпаковки);
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрКода.GTIN) Тогда
			СтрКода.GTIN = ОписаниеКода.ДанныеСервиса.GTIN;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеКода.НормализованныйКодМаркировки) Тогда
			СтрКода.КодМаркировки = ОписаниеКода.НормализованныйКодМаркировки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеКода.ДопСведения.СрокГодности) Тогда
			СтрКода.ДатаСрокаГодности = ОписаниеКода.ДопСведения.СрокГодности;
		КонецЕсли;
		
		СтрКода.КодАгрегата = КодАгрегата;
		
		Если ЗначениеЗаполнено(ОписаниеКода.ВложенныеКоды) Тогда
			ЗаполнитьТаблицуКодовИзОписанийКодов(ТаблицаКодов, ОписаниеКода.ВложенныеКоды, СтрКода.КодМаркировки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Устарела. Следует использовать НормализоватьКоды()
//
// Для совместимости с ПМ до версии 2.16 (включительно)
// Нормализует коды маркировки
//
Процедура НовыеКоды_НормализоватьКоды(ОписанияКодов, Организация = Неопределено, ВызыватьИсключение = Истина) Экспорт
	
	ТаблицаКодов = ТаблицаКодовИзОписанийКодов(ОписанияКодов);
	
	ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, ВызыватьИсключение);
	
	ОписанияКодов = ОписанияКодовИзТаблицыКодов(ТаблицаКодов);
	
КонецПроцедуры

// Устарела. Следует использовать ТаблицаКодовДокумента()
//
// Для совместимости с ВСО 1.1.17 и ПМ до версии 2.16 (включительно)
// Контракт описания кода маркировки для добавления в документ
//
Функция ОписаниеКодаМаркировки(КодМаркировки = Неопределено, ВидПродукции = Неопределено) Экспорт
	
	Возврат Новый_ОписаниеНовогоКодаМаркировки(КодМаркировки, ВидПродукции);
	
КонецФункции

// Устарела. Следует использовать ТаблицаКодовДокумента()
//
// Для совместимости с ВСО 1.1.17 и ПМ до версии 2.16 (включительно)
// Получает описание всех кодов маркировки по документу 1С
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
//  ЗаменитьGS - Булево - Истина, если необходимо заменить разделитель GS1 на строку \u001d
// 
// Возвращаемое значение:
//  Массив - содержит структуры см. Новый_ОписаниеНовогоКодаМаркировки();
//
Функция ОписанияКодовДокумента(Документ1С, ЗаменитьGS = Ложь) Экспорт
	
	ТаблицаКодов = ТаблицаКодовДокумента(Документ1С, ЗаменитьGS);
	
	Возврат ОписанияКодовИзТаблицыКодов(ТаблицаКодов);
	
КонецФункции

// Устарела. Следует использовать Новый_ТаблицаКодов()
//
// Для совместимости с ПМ 2.16
Функция Новый_ДанныеИзСервисаДляНовогоКода()
	
	Результат = Новый Структура;
	Результат.Вставить("ЭтоКомплект", Ложь);
	Результат.Вставить("ЭтоНабор", Ложь);
	Результат.Вставить("ЭтоКИГУ", Ложь);
	Результат.Вставить("Наименование");
	Результат.Вставить("КодТНВЭД");
	Результат.Вставить("ПроизводительИНН");
	Результат.Вставить("GTIN");
	Результат.Вставить("ВариантыНормализации", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

// Устарела. Следует использовать Новый_ТаблицаКодов()
//
// Для совместимости с ВСО 1.1.17 и ПМ до версии 2.16 (включительно)
// Описание кода маркировки для добавления в документ
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * GTIN - Строка - (необязательный) код товара;
//   * СерийныйНомер - Строка - (необязательный) серийный номер товара;
//   * НормализованныйКодМаркировки - Строка - нормализованный код маркировки;
//   * КодМаркировки - Строка - код маркировки или агрегата;
//   * ТипУпаковки   - ПеречислениеСсылка.КонтурМаркировка_ТипыУпаковок - (необязательный) тип упаковки;
//   * ВидУпаковки   - ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок - вид упаковки товара;
//   * ТипШтрихкода  - ПеречислениеСсылка.КонтурМаркировка_ТипыШтрихкодов - (необязательный) тип штрихкода;
//   * ВидПродукции  - ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - вид продукции;
//   * КлючСтрокиТоваров - Строка - ключ строки товаров документа 1С;
//   * ВложенныеКоды - Массив - содержит структуры, см. Новый_ОписаниеНовогоКодаМаркировки();
//   * ДанныеСервиса - Структура - см. Новый_ДанныеИзСервисаДляНовогоКода();
//   * ОписаниеОшибки - Строка - описание ошибки при действиях с кодом;
//   * АналитикаНоменклатуры - Структура - содержит:
//      ** Номенклатура   - СправочникСсылка - номенклатура 1С;
//      ** Характеристика - СправочникСсылка - характеристика номенклатуры;
//      ** Упаковка       - СправочникСсылка - упаковка;
//      ** Серия          - СправочникСсылка - серия;
//   * ДопСведения - Структура - содержит:
//      ** ПолныйКод        - Строка - код маркировки с криптохвостом
//      ** ДатаСрокаГодности - Дата   - дата окончания срока годности;
//      ** ИдентификаторВСД - Строка - идентификатор ВСД;
//      ** Объем            - Число  - объем;
//
Функция Новый_ОписаниеНовогоКодаМаркировки(КодМаркировки = Неопределено, ВидПродукции = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("GTIN");
	Результат.Вставить("СерийныйНомер");
	Результат.Вставить("КодМаркировки", КодМаркировки);
	Результат.Вставить("НормализованныйКодМаркировки");
	Результат.Вставить("ТипУпаковки");
	Результат.Вставить("ОбщийТипУпаковки");
	Результат.Вставить("ВидУпаковки");
	Результат.Вставить("ТипШтрихкода");
	Результат.Вставить("ВидПродукции", ВидПродукции);
	Результат.Вставить("КлючНоменклатуры1С");
	Результат.Вставить("Товар");
	Результат.Вставить("КодРазобран", Ложь);
	Результат.Вставить("АналитикаНоменклатуры", Новый_АналитикаНоменклатуры1С());
	Результат.Вставить("ДопСведения", Новый_ДопСведенияКода_2_19());
	Результат.Вставить("ДанныеСервиса", Новый_ДанныеИзСервисаДляНовогоКода());
	Результат.Вставить("ВложенныеКоды", Новый Массив);
	Результат.Вставить("ОписаниеОшибки");
	Результат.Вставить("КлючСтрокиТоваров");
	Результат.Вставить("КлючСтроки");
	Результат.Вставить("ДляВнутреннегоУчета");
	
	Возврат Результат;
	
КонецФункции

// Устарела. Контракт для записи доп сведений кодов
// 
// Возвращаемое значение:
//  Структуа - см. тело метода
//
Функция Новый_ДопСведенияКода_2_19()
	
	Результат = Новый Структура;
	Результат.Вставить("ПолныйКод");
	Результат.Вставить("СрокГодности");
	Результат.Вставить("Объем");
	Результат.Вставить("ИдентификаторВСД");
	Результат.Вставить("ЗаводскойСерийныйНомер");
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПараметрыЭтикетки_2_5_0(ПараметрыПМ)
	
	СтрокаЭтикетки = ПараметрыПМ.СтрокаЭтикетки;
	
	Результат = Новый Структура;
	
	Результат.Вставить("GTIN", Новый Структура);
	Результат.GTIN.Вставить("Код",                СтрокаЭтикетки.GTIN_Код);
	Результат.GTIN.Вставить("Ссылка",             СтрокаЭтикетки.Товар);
	Результат.GTIN.Вставить("Штрихкод",           СтрокаЭтикетки.GTIN_Штрихкод);
	Результат.GTIN.Вставить("НаименованиеТовара", СтрокаЭтикетки.GTIN_НаименованиеТовара);
	Результат.GTIN.Вставить("Картинка",           СтрокаЭтикетки.GTIN_Картинка);
	
	Результат.Вставить("SSCC", Новый Структура);
	Результат.SSCC.Вставить("Код",         СтрокаЭтикетки.Агрегат_Код);
	Результат.SSCC.Вставить("Штрихкод",    СтрокаЭтикетки.Агрегат_Штрихкод);
	Результат.SSCC.Вставить("ВидАгрегата",    СтрокаЭтикетки.Агрегат_ВидАгрегата);
	Результат.SSCC.Вставить("Картинка", СтрокаЭтикетки.Агрегат_Картинка);
	
	Результат.Вставить("DataMatrix", Новый Структура);
	Результат.DataMatrix.Вставить("Код",           СтрокаЭтикетки.DataMatrix_Код);
	Результат.DataMatrix.Вставить("Штрихкод",      СтрокаЭтикетки.DataMatrix_Штрихкод);
	Результат.DataMatrix.Вставить("СерийныйНомер", СтрокаЭтикетки.DataMatrix_СерийныйНомер);
	Результат.DataMatrix.Вставить("Картинка",      СтрокаЭтикетки.DataMatrix_Картинка);
	
	Результат.Вставить("ПараметрыНоменклатуры1С", Новый Структура);
	Результат.ПараметрыНоменклатуры1С.Вставить("Артикул",                    СтрокаЭтикетки.Номенклатура1С_Артикул);
