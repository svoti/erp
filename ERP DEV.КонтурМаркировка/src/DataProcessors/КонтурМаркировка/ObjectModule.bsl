	Возврат "include";
	
КонецФункции

Функция ПутьКФайлуВложеннойОбработки(ИмяФайла)
	
	Результат = "";
	
	Если НастройкиМодуля_РежимОтладкиВключен() Тогда
		ОсновнойКаталог = НастройкиМодуля_КаталогОтладки();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОсновнойКаталог) Тогда
		Результат = МодульОбщегоНазначения().ОбъединитьПути(ОсновнойКаталог, ИмяПапкиВложенныхОбработок(), ИмяФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбъектВложеннойОбработкиИзКонфигурации(ИмяФайла) Экспорт
	
	КлючКэш = "ОбъектВложеннойОбработкиИзКонфигурации: " + ИмяФайла;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяОбработки = ИмяОбработкиПоИмениФайла(ИмяФайла);
	
	Если Не ЗначениеЗаполнено(ИмяОбработки)
		Или Метаданные.Обработки.Найти(ИмяОбработки) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = МодульОбщегоНазначения().СоздатьОбработкуИзКонфигурации(ИмяОбработки);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ДвоичныеДанныеОбработкиИзМакета(ИмяМакета)
	
	Если ИмяФайлаПоИмениМакета(ИмяМакета) = ИмяФайлаМодуляКонтроль() Тогда
		Результат = ДвоичныеДанныеБиблиотекиКонтроля();
	Иначе
		Результат = МакетОбработки(ИмяМакета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбъектВложеннойОбработки(ИмяФайла) Экспорт
	
	КлючКэш = "ОбъектВложеннойОбработки: " + ИмяФайла;
	КэшОбработки = Кэш_Прочитать(КлючКэш);
	Если КэшОбработки <> Неопределено И КэшОбработки.ОбъектОбработки <> Неопределено Тогда
		Если КэшОбработки.ПолученИзМакета
			Или КэшОбработки.ДатаИзменения = МодульОбщегоНазначения().ДатаИзмененияФайла(КэшОбработки.ПутьКФайлу) Тогда
			Возврат КэшОбработки.ОбъектОбработки;
		КонецЕсли;
	КонецЕсли;
	
	ИмяМакета = ИмяМакетаПоИмениФайла(ИмяФайла);
	ПутьКФайлу = ПутьКФайлуВложеннойОбработки(ИмяФайла);
	ДвоичныеДанные = ДвоичныеДанныеОбработкиИзМакета(ИмяМакета);
	ЕстьФайл = МодульОбщегоНазначения().ФайлСуществует(ПутьКФайлу);
	
	ЗаписатьДанныеОбработкиНаДиск = НастройкиМодуля_РежимОтладкиВключен()
	И МодульМаркировкиОткрытИзФайла()
	И Не ЕстьФайл;
	
	Если ЗаписатьДанныеОбработкиНаДиск Тогда
		
		Попытка
			ДвоичныеДанные.Записать(ПутьКФайлу);
			ЕстьФайл = МодульОбщегоНазначения().ФайлСуществует(ПутьКФайлу);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			ШаблонСтроки = НСтр("ru = 'Не удалось выгрузить макет %1 в файл %2
			|%3'");
			ТекстОшибки = ПараметрыВСтроку(ШаблонСтроки, ИмяМакета, ПутьКФайлу, КраткоеПредставлениеОшибки(Ошибка));
			СообщитьПользователюЛок(ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;
	
	Если ЕстьФайл Тогда
		ОбъектОбработки = МодульОбщегоНазначения().СоздатьВнешнююОбработкуБезПредупреждений(ПутьКФайлу);
	Иначе
		ОбъектОбработки = МодульОбщегоНазначения().СоздатьВнешнююОбработкуБезПредупреждений(ДвоичныеДанные);
	КонецЕсли;
	
	КэшОбработки = Новый Структура;
	КэшОбработки.Вставить("ПутьКФайлу", ПутьКФайлу);
	КэшОбработки.Вставить("ОбъектОбработки", ОбъектОбработки);
	КэшОбработки.Вставить("ПолученИзМакета", Не ЕстьФайл);
	КэшОбработки.Вставить("ДатаИзменения", МодульОбщегоНазначения().ДатаИзмененияФайла(ПутьКФайлу));
	
	Кэш_Поместить(КлючКэш, КэшОбработки);
	
	Если ИмяФайла = ИмяФайлаМодуляКонтроль() Тогда
		МодульЯдро().СброситьКэшМодуляКонтроль();
	КонецЕсли;
	
	Возврат ОбъектОбработки;
	
КонецФункции

Функция ДвоичныеДанныеВложеннойОбработки(ИмяФайла, ИмяМакета)
	
	КлючКэш = "ДвоичныеДанныеВложеннойОбработки_" + ИмяФайла;
	КэшФайла = Кэш_Прочитать(КлючКэш);
	Если КэшФайла <> Неопределено И КэшФайла.ДвоичныеДанные <> Неопределено Тогда
		Если КэшФайла.ПолученИзМакета
			Или КэшФайла.ДатаИзменения = МодульОбщегоНазначения().ДатаИзмененияФайла(КэшФайла.ПутьКФайлу) Тогда
			Возврат КэшФайла.ДвоичныеДанные;
		КонецЕсли;
	КонецЕсли;
	
	ПутьКФайлу = ПутьКФайлуВложеннойОбработки(ИмяФайла);
	
	Если МодульОбщегоНазначения().ФайлСуществует(ПутьКФайлу) Тогда
		ДвоичныеДанные = НовыйДвоичныеДанные(ПутьКФайлу);
		ДатаИзменения = МодульОбщегоНазначения().ДатаИзмененияФайла(ПутьКФайлу);
		ПолученИзМакета = Ложь;
	Иначе
		ДвоичныеДанные = МакетОбработки(ИмяМакета);
		ДатаИзменения = Неопределено;
		ПолученИзМакета = Истина;
	КонецЕсли;
	
	КэшФайла = Новый Структура;
	КэшФайла.Вставить("ПутьКФайлу", ПутьКФайлу);
	КэшФайла.Вставить("ДатаИзменения", ДатаИзменения);
	КэшФайла.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	КэшФайла.Вставить("ПолученИзМакета", ПолученИзМакета);
	
	Кэш_Поместить(КлючКэш, КэшФайла);
	
	Возврат ДвоичныеДанные;
	
КонецФункции

Функция ИмяОбработкиПоИмениФайла(ИмяФайла)
	
	Если ИмяФайла = Мок_ИмяФайла() Тогда
		Возврат "Тесты_Mock";
	КонецЕсли;
	
	ПрефиксПодсистемы = ИмяМодуля();
	ИмяФайлаБезРасширения = СтрЗаменить(ИмяФайла, ".epf", "");
	Результат = ПрефиксПодсистемы + "_" + ИмяФайлаБезРасширения;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяМакетаПоИмениФайла(ИмяФайла)
	
	Возврат СтрЗаменить(ИмяФайла, ".", "_")
	
КонецФункции

Функция ИмяФайлаПоИмениМакета(ИмяМакета)
	
	Возврат СтрЗаменить(ИмяМакета, "_", ".");
	
КонецФункции

