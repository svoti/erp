Функция КодыДокументов_ВТ_ПрочитатьПоТипамДокументовЗаПериод(МенеджерВТ, ТипыДокументов, Период, Организация)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	КодыДокументов.ДокументУчета КАК ДокументУчета,
	|	ДокументыУчета.КлючДокумента1С КАК КлючДокумента1С,
	|	ДокументыУчета.ТипКлючаДокумента1С КАК ТипКлючаДокумента1С
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ДокументыУчета.Ссылка = КодыДокументов.ДокументУчета
	|ГДЕ
	|	&Организация
	|	И ДокументыУчета.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ДокументыУчета.ТипДокумента В(&ТипыДокументов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "ДокументыУчета.Организация = &Организация");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТипыДокументов", ТипыДокументов);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат ЗначениеЗаполнено(Выборка.Количество);
	
КонецФункции

Функция КодыДокументов_ПодготовитьТаблицуКодовДляЗагрузки(КодыМаркировки, ЗагружатьПолныеКоды, РазделителиGS1) Экспорт
	
	ТаблицаКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(КодыМаркировки, ЗагружатьПолныеКоды);
	ТаблицаКодов_НормализоватьКоды(ТаблицаКодов);
	
	Если Не ЗагружатьПолныеКоды Тогда
		Возврат ПоместитьВоВременноеХранилище(ТаблицаКодов, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	ТранспортнаяУпаковка = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
	АТК = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК;
	
	Для Каждого СтрКода Из ТаблицаКодов Цикл
		
		Если СтрКода.ОбщийТипУпаковки = ТранспортнаяУпаковка
			Или СтрКода.ОбщийТипУпаковки = АТК Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьРазделитель = Ложь;
		Для Каждого Разделитель Из РазделителиGS1 Цикл
			Если Найти(СтрКода.ИсходныйКодМаркировки, Разделитель) > 0 Тогда
				ЕстьРазделитель = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЕстьРазделитель Тогда
			ТекстОшибки = НСтр(
			"ru = 'Не все строки содержат разделитель GS1 или его эквивалент,
			|поэтому полные коды не могут быть загружены'");
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаКодов, Новый УникальныйИдентификатор);
	
КонецФункции

