// #Область СведенияОМаркировке

// Заполняет в таблице товаров сведения о маркировке для УПД и УКД
//
// Параметры:
//  ТоварыДокументов - ТаблицаЗначений - содержит строки товаров документов, по которым нужно заполнить таблицу;
//   * Номенклатура        - СправочникСсылка - номенклатура;
//   * Характеристика      - СправочникСсылка - характеристика;
//   * Серия               - СправочникСсылка - серия;
//   * Количество          - Число - количество в строке (ограничивает привязанные строки маркировки).
//   * КодТоварнойГруппы   - Число - код товарной группы в УПД;
//   * ПервичныйДокумент   - ДокументСсылка - первичный документ (накладная);
//   * СведенияОМаркировке - ТаблицаЗначений - (необязательный) таблица для заполнения, содержит колонки:
//     * GTIN                     - Строка - GTIN товара в объемно-сортовом учете;
//     * ВидУпаковки              - ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок - вид упаковки товара;
//     * ЗначениеШтрихкода        - Строка - код маркировки товара или логистической упаковки;
//     * КоличествоУпаковок       - Число - количество упаковок товара в объемно-сортовом учете;
//     * НомерПартии              - Строка - номер партии товара в объемно-сортовом учете;
//     * Количество               - Число - количество товара в единицах маркировки;
//     * ПеременнаяХарактеристика - Строка - тип переменной характеристики товара, например вес;
//     * КодТоварнойГруппы        - Число - см. функцию КодТоварнойГруппыГИСМТ();
//  ОшибкиЗаполнения - Массив - исходящий параметр, ошибки выполнения функции, содержит структуры с полями:
//   * ТекстОшибки        - Строка           - описание ошибки;
//   * ВладелецКодов      - ДокументСсылка   - документ-владелец штрихкодов, в котором возникла ошибка;
//   * ДокументМаркировки - СправочникСсылка - документ Контур.Маркировки, с которым связан документ-владелец;
//  ПроверитьЗавершениеРаботы - Булево - Ложь, если нужно отключить проверку завершения работы с кодами маркировки;
//  ВызывающийМодуль - Строка - имя вызывающего модуля в терминах общепродуктовых метрик Контура, например diadoc_um;
//  ВерсияКонтракта - Строка - версия контракта таблиц ТоварыДокументов и СведенияОМаркировке, которую поддерживает вызывающий модуль.
//
Процедура ЗаполнитьСведенияОМаркировке(ТоварыДокументов
	, ОшибкиЗаполнения = Неопределено
	, Знач ПроверитьЗавершениеРаботы = Истина
	, ВызывающийМодуль = ""
	, ВерсияКонтракта = Неопределено) Экспорт
	
	СведенияОМаркировке_ТоварыДокументов_ДобавитьСлужебныеКолонкиИндексы(ТоварыДокументов);
	
	ОшибкиЗаполнения = Новый Массив;
	
	СтандартнаяОбработка = Истина;
	ПМ_ОбработатьСобытие_ПриЗаполненииСведенийОМаркировке(
	ТоварыДокументов, ОшибкиЗаполнения, ПроверитьЗавершениеРаботы, ВерсияКонтракта, СтандартнаяОбработка);
	
	ОшибкиМаркировки = Новый_ОшибкиСведенийОМаркировке(ТоварыДокументов);
	
	СведенияОМаркировке_ТоварыДокументов_ДобавитьДокументыУчета(ТоварыДокументов, ПроверитьЗавершениеРаботы, ОшибкиМаркировки);
	
	Если Не СтандартнаяОбработка Тогда
		Если Не СведенияОМаркировке_БылиПереданыРанее(ТоварыДокументов) Тогда
			Метрика_Функциональность_ЗаполнениеСведенийОМаркировкеЧерезПМ(ТоварыДокументов);
			СведенияОМаркировке_ЗафиксироватьЧтоСведенияПереданы(ТоварыДокументов);
		КонецЕсли;
		СведенияОМаркировке_ТоварыДокументов_УдалитьСлужебныеКолонкиИндексы(ТоварыДокументов);
		СведенияОМаркировке_ПривестиКВерсииКонтракта(ТоварыДокументов, ВерсияКонтракта);
		Возврат;
	КонецЕсли;
	
	СведенияОМаркировке_ПересчитатьКоличествоВБазовыеЕдиницы(ТоварыДокументов);
	СведенияОМаркировке_Заполнить(ТоварыДокументов, ОшибкиМаркировки);
	СведенияОМаркировке_ВосстановитьКоличествоВЕдиницахДокумента(ТоварыДокументов);
	СведенияОМаркировке_ДобавитьОшибкиЗаполнения(ОшибкиЗаполнения, ОшибкиМаркировки);
	
	Если Не СведенияОМаркировке_БылиПереданыРанее(ТоварыДокументов) Тогда
		Метрика_Функциональность_ЗаполнениеСведенийОМаркировке(ТоварыДокументов);
		Метрика_ЗаполнениеСведенийОМаркировке(ТоварыДокументов, ОшибкиМаркировки, ВызывающийМодуль);
		СведенияОМаркировке_ЗафиксироватьЧтоСведенияПереданы(ТоварыДокументов);
	КонецЕсли;
	
	СведенияОМаркировке_ТоварыДокументов_УдалитьСлужебныеКолонкиИндексы(ТоварыДокументов);
	СведенияОМаркировке_ПривестиКВерсииКонтракта(ТоварыДокументов, ВерсияКонтракта);
	
КонецПроцедуры

// Возвращает описание состояния маркировки по документам 1С для отображения кнопки
//
// Параметры:
//  Документы1С		 - Массив	 - документы 1С;
//  ВызывающийМодуль - Строка	 - имя вызывающего модуля в терминах общепродуктовых метрик Контура, например diadoc_um;
// 
// Возвращаемое значение:
//  Структура - содержит описание кнопки состояния маркировки:
//  * ВидимостьКоманды - Булево - видимость кнопки;
//  * Заголовок        - Строка - заголовк кнопки;
//  * Картинка         - Картинка - картинка кнопки;
//  * Подсказка        - Строка - подсказка для кнопки;
//
Функция СостояниеМаркировки(Документы1С, ВызывающийМодуль) Экспорт
	
	Результат = Новый_СведенияОМаркировкеДанныеКнопки();
	
	Если Не ЗначениеЗаполнено(Документы1С) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Организация = Неопределено;
	ДокументыСМаркировкой = Новый Массив;
	Для Каждого Документ1С Из Документы1С Цикл
		Если ДокументДопустимВМаркировке(Документ1С) Тогда
			ДокументыСМаркировкой.Добавить(Документ1С);
			Если Не ЗначениеЗаполнено(Организация) Тогда
				Организация = Организация_НайтиПоДокументу1С(Документ1С);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СвернутьМассивЛок(ДокументыСМаркировкой);
	
	Если Не ЗначениеЗаполнено(Организация)
		Или Не ЗначениеЗаполнено(ДокументыСМаркировкой)
		Или Не ДокументыУчета_СодержатТоварыДляОтраженияВЭДО(ДокументыСМаркировкой) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Метрика_Функциональность_СостояниеМаркировки(Организация);
	
	СоздатьПерезаполнить = НастройкиМодуля().СоздаватьДокументыУчетаАвтоматически;
	
	ДокументыУчета = ДокументыУчета_НайтиПоДокументам1С(ДокументыСМаркировкой, СоздатьПерезаполнить);
	ТаблицаСтатусов = СтатусыДокументовУчета_ПрочитатьВТаблицу(ДокументыУчета);
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаСтатусов, "ТребуемоеДействие");
	Подсказки = Перечисление_ПодсказкиСостоянийМаркировки();
	
	ВидимостьКоманды = Истина;
	Заголовок = НСтр("ru = 'Состояние маркировки'");
	
	Если СостояниеМаркировки_ДокументыУчетаСодержатОшибки(ДокументыУчета, Организация, ТаблицаСтатусов) Тогда
		
		Картинка = БиблиотекаКартинок.КонтурМаркировка_СостояниеСведенийОшибка;
		Подсказка = Подсказки.ИсправитьОшибки;
		
	ИначеЕсли СостояниеМаркировки_ДокументыУчетаТребуютУказатьСведения(ДокументыУчета, ДокументыСМаркировкой, ТаблицаСтатусов) Тогда
		
		Картинка = БиблиотекаКартинок.КонтурМаркировка_СостояниеСведенийНетСведений;
		Подсказка = Подсказки.УказатьСведения;
		
	ИначеЕсли СостояниеМаркировки_ДокументыУчетаТребуютЗавершитьНаполнение(ДокументыУчета, ТаблицаСтатусов) Тогда
		
		Картинка = БиблиотекаКартинок.КонтурМаркировка_СостояниеСведенийОжидаетСканирования;
		Подсказка = Подсказки.ЗавершитьНаполнение;
		
	ИначеЕсли СостояниеМаркировки_ДокументыУчетаСодержатОшибкиКодов(ДокументыУчета, Организация, ТаблицаСтатусов) Тогда
		
		Картинка = БиблиотекаКартинок.КонтурМаркировка_СостояниеСведенийОшибка;
		Подсказка = Подсказки.ИсправитьОшибки;
		
	ИначеЕсли СостояниеМаркировки_ДокументыУчетаЗавершены(ТаблицаСтатусов) Тогда
		
		Картинка = БиблиотекаКартинок.КонтурМаркировка_СостояниеСведенийРаботаЗавершена;
		Подсказка = Подсказки.РаботаЗавершена;
		
	Иначе
		
		Картинка = БиблиотекаКартинок.КонтурМаркировка_СостояниеСведенийВРаботе;
		Подсказка = Подсказки.ПродолжитьРаботу;
		
	КонецЕсли;
	
	Результат.ВидимостьКоманды = ВидимостьКоманды;
	Результат.Заголовок = Заголовок;
	Результат.Картинка = Картинка;
	Результат.Подсказка = Подсказка;
	
	Метрика_СостояниеМаркировки(Организация, ВызывающийМодуль);
	
	Возврат Результат;
	
КонецФункции

