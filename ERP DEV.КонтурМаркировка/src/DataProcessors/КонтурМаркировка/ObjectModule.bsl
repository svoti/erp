// Добавляет в менеджер временных таблиц таблицу операций 1С
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц, в который будет добавлена таблица "Организации"
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация маркировки для поиска организации 1С
//
Процедура ТаблицаДокументов_ВТ_ДобавитьОрганизации1С(МенеджерВТ, Организация = Неопределено) Экспорт
	
	ТипыОбъектов = ТипыОбъектовИС();
	
	Если ЗначениеЗаполнено(ТипыОбъектов.Организация) Тогда
		ТипОрганизации = Новый ОписаниеТипов(ТипыОбъектов.Организация);
	Иначе
		ТипОрганизации = ОписаниеТипа_Строка();
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Организация,
	|	Т.КлючОрганизации1С КАК КлючОрганизации1С,
	|	Т.ТипКлючаОрганизации1С КАК ТипКлючаОрганизации1С
	|ИЗ
	|	Справочник.КонтурМаркировка_Организации КАК Т
	|ГДЕ
	|	&Организация
	|	И НЕ Т.ПометкаУдаления";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Условие = "Т.Ссылка = &Организация";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Организации = Запрос.Выполнить().Выгрузить();
	Организации.Колонки.Добавить("Организация1С", ТипОрганизации);
	ЗаполнитьВТаблицеОбъекты1СПоКлючам(Организации, "Организация1С", "КлючОрганизации1С", "ТипКлючаОрганизации1С");
	
	Организации.Колонки.Удалить("КлючОрганизации1С");
	Организации.Колонки.Удалить("ТипКлючаОрганизации1С");
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, Организации, "Организации", "Организация1С");
	
КонецПроцедуры

Процедура ТаблицаДокументов_ВТ_ДобавитьСклады1С(МенеджерВТ, Организация = Неопределено) Экспорт
	
	ТипыОбъектов = ТипыОбъектовИС();
	
	Если ЗначениеЗаполнено(ТипыОбъектов.Склад) Тогда
		ТипСклад = Новый ОписаниеТипов(ТипыОбъектов.Склад);
	Иначе
		ТипСклад = ОписаниеТипа_Строка();
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Склад,
	|	Т.КлючСклада1С КАК КлючСклада1С,
	|	Т.ТипКлючаСклада1С КАК ТипКлючаСклада1С
	|ИЗ
	|	Справочник.КонтурМаркировка_Склады КАК Т
	|ГДЕ
	|	&Организация
	|	И НЕ Т.ПометкаУдаления";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Условие = "Т.Организация = &Организация";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Склады = Запрос.Выполнить().Выгрузить();
	Склады.Колонки.Добавить("Склад1С", ТипСклад);
	ЗаполнитьВТаблицеОбъекты1СПоКлючам(Склады, "Склад1С", "КлючСклада1С", "ТипКлючаСклада1С");
	
	Склады.Колонки.Удалить("КлючСклада1С");
	Склады.Колонки.Удалить("ТипКлючаСклада1С");
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, Склады, "Склады", "Склад");
	
КонецПроцедуры

Функция ТаблицаДокументов_ВТ_Подготовить(МенеджерВТ, НастройкиДокументов, Период
	, ДобавитьПоследниеОперации = Ложь
	, Документ = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	ТипДокумента = Неопределено;
	Если ЗначениеЗаполнено(Документ) Тогда
		Если ТипЗнч(Документ) = Тип("СправочникСсылка.КонтурМаркировка_ДокументыУчета") Тогда
			ТипДокумента = ДокументУчета_ТипДокумента(Документ);
		Иначе
			ТипДокумента = Документ.Метаданные().Имя;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Настройка Из НастройкиДокументов Цикл
		
		Если ЗначениеЗаполнено(ТипДокумента)
			И Настройка.ТипДокумента <> ТипДокумента Тогда
			Продолжить;
		КонецЕсли;
		
		// В процессе дополнения будем менять таблицы
		Если Настройка.ЭтоДополнительныйТипДокумента Тогда
			ИмяТаблицы = Настройка.ТипДокумента + "_ТаблицаДокументовУчета";
			ТаблицаДокументов_ВТ_ДобавитьДополнительныеДокументыУчета(Настройка, МенеджерВТ, ИмяТаблицы, Период, Документ);
		Иначе
			ИмяТаблицы = Настройка.ТипДокумента + "_ТаблицаДокументов1С";
			ТаблицаДокументов_ВТ_ДобавитьДокументы1С(Настройка, МенеджерВТ, ИмяТаблицы, Период, Документ);
		КонецЕсли;
		
		Если Не Настройка.ЭтоДополнительныйТипДокумента Тогда
			
			Если Не Настройка.ПоказатьВСпискеЕслиТоварыНеПодлежатМаркировке Тогда
				ТаблицаДокументов_ВТ_ДобавитьНоменклатуруНеПодлежитМаркировке(Настройка, МенеджерВТ, ИмяТаблицы);
				ТаблицаДокументов_ФильтроватьВТ_ТоварПодлежитМаркировке(Настройка, МенеджерВТ, ИмяТаблицы);
			ИначеЕсли Не Настройка.ПоказатьВСпискеЕслиТоварыНеЗаполнены Тогда
				ТаблицаДокументов_ФильтроватьВТ_ЕстьТовары(Настройка, МенеджерВТ, ИмяТаблицы);
			Иначе
				// Оставить как есть
			КонецЕсли;
			
			Если Не ЗапросПоддерживаетЧтениеИдентификатора() Тогда
				ТаблицаДокументов_ВТ_ДобавитьКлючиДокументов1С(Настройка, МенеджерВТ, ИмяТаблицы);
			КонецЕсли;
			
			ТаблицаДокументов_ВТ_ДобавитьДокументыУчета(Настройка, МенеджерВТ, ИмяТаблицы);
			
		КонецЕсли;
		
		Если ДобавитьПоследниеОперации Тогда
			ТаблицаДокументов_ВТ_ДобавитьПоследниеОперации(Настройка, МенеджерВТ, ИмяТаблицы);
		КонецЕсли;
		
		Результат.Добавить(ИмяТаблицы);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаДокументов_ВТ_ДобавитьДокументы1С(НастройкаДокумента, МенеджерВТ, ИмяТаблицы, Период, Документ = Неопределено)
	
	Если ТипЗнч(Документ) = Тип("СправочникСсылка.КонтурМаркировка_ДокументыУчета") Тогда
		Документ1С = ДокументУчета_Документ1С(Документ);
	Иначе
		Документ1С = Документ;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ТаблицаДокументов1С(НастройкаДокумента, ИмяТаблицы, Документ);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ПредставлениеТипаДокумента", НастройкаДокумента.Наименование);
	Запрос.УстановитьПараметр("Документ1С", Документ1С);
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ТекстЗапроса_ТаблицаДокументов1С(НастройкаДокумента, ИмяТаблицы, Документ = Неопределено)
	
	Настройки = НастройкиМодуля();
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Организация КАК Организация,
	|	Документ1С.Ссылка КАК Документ1С,
	|	Документ1С.Номер КАК Номер,
	|	Документ1С.Дата КАК Дата,
	|	&КлючДокумента1С КАК КлючДокумента1С,
	|	""&ТипКлючаДокумента1С"" КАК ТипКлючаДокумента1С,
	|	&Склад КАК Склад,
	|	&Контрагент КАК Контрагент,
	|	&Сумма КАК Сумма,
	|	&Комментарий КАК Комментарий,
	|	&ПредставлениеТипаДокумента КАК ТипДокумента,
	|	&ОтражениеВЭДО КАК ОтражениеВЭДО,
	|	&ДопКолонка1 КАК ДопКолонка1,
	|	&ДопКолонка2 КАК ДопКолонка2,
	|	&ДопКолонка3 КАК ДопКолонка3
	|ПОМЕСТИТЬ ТаблицаДокументов
	|ИЗ
	|	ТаблицаДокументов1С КАК Документ1С
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Организации КАК Организации
	|		ПО Документ1С.Организация = Организации.Организация1С
	|ГДЕ
	|	Документ1С.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Документ1С.ПометкаУдаления
	|	И &ТолькоПроведенные
	|	И &ОтборДокумент
	|	И &ДопУсловие";
	
	ПолноеИмяДокумента = "Документ." + НастройкаДокумента.ТипДокумента;
	
	Результат = СтрЗаменить(Результат, "Документ1С.Организация", "Документ1С." + НастройкаДокумента.ПолеОрганизация);
	Результат = СтрЗаменить(Результат, "ТаблицаДокументов1С", ПолноеИмяДокумента);
	Результат = СтрЗаменить(Результат, "ТаблицаДокументов", ИмяТаблицы);
	
	Если ЗапросПоддерживаетЧтениеИдентификатора() Тогда
		Результат = СтрЗаменить(Результат, "&КлючДокумента1С", "УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Документ1С.Ссылка)");
		Результат = СтрЗаменить(Результат, "&ТипКлючаДокумента1С", ПолноеИмяДокумента);
		Результат = Результат + " ИНДЕКСИРОВАТЬ ПО КлючДокумента1С, ТипКлючаДокумента1С";
	Иначе
		Результат = СтрЗаменить(Результат, "&КлючДокумента1С", "НЕОПРЕДЕЛЕНО");
		Результат = СтрЗаменить(Результат, "&ТипКлючаДокумента1С", "НЕОПРЕДЕЛЕНО");
		Результат = Результат + " ИНДЕКСИРОВАТЬ ПО Документ1С";
	КонецЕсли;
	
	Склад = "НЕОПРЕДЕЛЕНО";
	Если ЗначениеЗаполнено(НастройкаДокумента.ПолеСклад) Тогда
		Склад = "Документ1С." + НастройкаДокумента.ПолеСклад;
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&Склад", Склад);
	
	Контрагент = "НЕОПРЕДЕЛЕНО";
	Если ЗначениеЗаполнено(НастройкаДокумента.ПолеКонтрагент) Тогда
		Контрагент ="Документ1С." + НастройкаДокумента.ПолеКонтрагент;
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&Контрагент", Контрагент);
	
	Сумма = "0";
	Если ЗначениеЗаполнено(НастройкаДокумента.ПолеСумма) Тогда
		Сумма = "Документ1С." + НастройкаДокумента.ПолеСумма;
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&Сумма", Сумма);
	
	Комментарий = """""";
	Если ЗначениеЗаполнено(НастройкаДокумента.ПолеКомментарий) Тогда
		Комментарий = "Документ1С." + НастройкаДокумента.ПолеКомментарий;
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&Комментарий", Комментарий);
	
	ОтражениеВЭДО = """""";
	Результат = СтрЗаменить(Результат, "&ОтражениеВЭДО", ОтражениеВЭДО);
	
	ТолькоПроведенные = "ИСТИНА";
	Если Не НастройкаДокумента.ПоказатьВСпискеЕслиНеПроведен Тогда
		МетаданныеДокумента = Метаданные.Документы.Найти(НастройкаДокумента.ТипДокумента);
		Если МетаданныеДокумента.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			ТолькоПроведенные = "Документ1С.Проведен";
		КонецЕсли;
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ТолькоПроведенные", ТолькоПроведенные);
	
	ДопУсловие = "ИСТИНА";
	Если ЗначениеЗаполнено(НастройкаДокумента.ДополнительноеУсловиеОтбора) Тогда
		ДопУсловие = "("+НастройкаДокумента.ДополнительноеУсловиеОтбора+")";
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ДопУсловие", ДопУсловие);
	
	ОтборДокумент = "ИСТИНА";
	Если ЗначениеЗаполнено(Документ) Тогда
		ОтборДокумент = "Документ1С.Ссылка = &Документ1С";
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ОтборДокумент", ОтборДокумент);
	
	Формула = "НЕОПРЕДЕЛЕНО";
	Если Настройки.ДопКолонка1_Видимость И ЗначениеЗаполнено(НастройкаДокумента.ДопКолонка1_Формула) Тогда
		Формула = СокрЛП(НастройкаДокумента.ДопКолонка1_Формула);
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ДопКолонка1", Формула);
	
	Формула = "НЕОПРЕДЕЛЕНО";
	Если Настройки.ДопКолонка2_Видимость И ЗначениеЗаполнено(НастройкаДокумента.ДопКолонка2_Формула) Тогда
		Формула = СокрЛП(НастройкаДокумента.ДопКолонка2_Формула);
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ДопКолонка2", Формула);
	
	Формула = "НЕОПРЕДЕЛЕНО";
	Если Настройки.ДопКолонка3_Видимость И ЗначениеЗаполнено(НастройкаДокумента.ДопКолонка3_Формула) Тогда
		Формула = СокрЛП(НастройкаДокумента.ДопКолонка3_Формула);
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ДопКолонка3", Формула);
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаДокументов_ВТ_ДобавитьДополнительныеДокументыУчета(НастройкаДокумента, МенеджерВТ, ИмяТаблицы, Период, ДокументУчета = Неопределено)
	
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ТаблицаДополнительныхДокументов(НастройкаДокумента, ИмяТаблицы, ДокументУчета);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ПредставлениеТипаДокумента", НастройкаДокумента.Наименование);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ТекстЗапроса_ТаблицаДополнительныхДокументов(НастройкаДокумента, ИмяТаблицы, ДокументУчета = Неопределено)
	
	Настройки = НастройкиМодуля();
	
	Результат =
	"ВЫБРАТЬ
	|	ДокументыУчета.Ссылка КАК ДокументУчета,
	|	ДокументыУчета.Организация КАК Организация,
	|	ДокументыУчета.Код КАК Номер,
	|	ДокументыУчета.Дата КАК Дата,
	|	Склады.Склад1С КАК Склад,
	|	НЕОПРЕДЕЛЕНО КАК Контрагент,
	|	0 КАК Сумма,
	|	ДокументыУчета.ОтражениеВЭДО КАК ОтражениеВЭДО,
	|	ДокументыУчета.Комментарий КАК Комментарий
	|ПОМЕСТИТЬ ТабДок
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Склады КАК Склады
	|		ПО ДокументыУчета.Склад = Склады.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлюч
	|		ПО ДокументыУчета.КлючДокумента1С = ПустойКлюч.Ключ
	|ГДЕ
	|	ДокументыУчета.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ПустойКлюч.Ключ ЕСТЬ НЕ NULL 
	|	И НЕ ДокументыУчета.ПометкаУдаления
	|	И &ОтборДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Документ1С.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК Документ1С,
	|	ПустойКлюч.Ключ КАК КлючДокумента1С,
	|	"""" КАК ТипКлючаДокумента1С,
	|	Документ1С.Номер КАК Номер,
	|	Документ1С.Дата КАК Дата,
	|	Документ1С.Склад КАК Склад,
	|	Документ1С.Контрагент КАК Контрагент,
	|	Документ1С.Сумма КАК Сумма,
	|	Документ1С.ОтражениеВЭДО КАК ОтражениеВЭДО,
	|	Документ1С.Комментарий КАК Комментарий,
	|	&ПредставлениеТипаДокумента КАК ТипДокумента,
	|	Документ1С.ДокументУчета КАК ДокументУчета,
	|	&ДопКолонка1 КАК ДопКолонка1,
	|	&ДопКолонка2 КАК ДопКолонка2,
	|	&ДопКолонка3 КАК ДопКолонка3
	|ПОМЕСТИТЬ ТаблицаДокументов
	|ИЗ
	|	ТабДок КАК Документ1С
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлюч
	|		ПО (ИСТИНА)
	|ГДЕ
	|	&ДопУсловие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПустойКлюч
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабДок";
	
	Результат = СтрЗаменить(Результат, "ТаблицаДокументов", ИмяТаблицы);
	
	ДопУсловие = "ИСТИНА";
	Если ЗначениеЗаполнено(НастройкаДокумента.ДополнительноеУсловиеОтбора) Тогда
		ДопУсловие = "("+НастройкаДокумента.ДополнительноеУсловиеОтбора+")";
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ДопУсловие", ДопУсловие);
	
	ОтборДокумент = "ИСТИНА";
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		ОтборДокумент = "ДокументыУчета.Ссылка = &ДокументУчета";
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ОтборДокумент", ОтборДокумент);
	
	Формула = "НЕОПРЕДЕЛЕНО";
	Если Настройки.ДопКолонка1_Видимость И ЗначениеЗаполнено(НастройкаДокумента.ДопКолонка1_Формула) Тогда
		Формула = СокрЛП(НастройкаДокумента.ДопКолонка1_Формула);
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ДопКолонка1", Формула);
	
	Формула = "НЕОПРЕДЕЛЕНО";
	Если Настройки.ДопКолонка2_Видимость И ЗначениеЗаполнено(НастройкаДокумента.ДопКолонка2_Формула) Тогда
		Формула = СокрЛП(НастройкаДокумента.ДопКолонка2_Формула);
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ДопКолонка2", Формула);
	
	Формула = "НЕОПРЕДЕЛЕНО";
	Если Настройки.ДопКолонка3_Видимость И ЗначениеЗаполнено(НастройкаДокумента.ДопКолонка3_Формула) Тогда
		Формула = СокрЛП(НастройкаДокумента.ДопКолонка3_Формула);
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&ДопКолонка3", Формула);
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаДокументов_ВТ_ДобавитьНоменклатуруНеПодлежитМаркировке(НастройкаДокумента, МенеджерВТ, ИмяТаблицы)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ТаблицаНоменклатурыДокументов(НастройкаДокумента, ИмяТаблицы);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	Если Не ЗапросПоддерживаетЧтениеИдентификатора() Тогда
		ТаблицаДокументов_ВТ_ДобавитьКлючиНоменклатуры(МенеджерВТ);
	КонецЕсли;
	
	ТаблицаНоменклатуры_ВТ_НеПодлежитМаркировке(МенеджерВТ);
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ТаблицаНоменклатуры");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ТекстЗапроса_ТаблицаНоменклатурыДокументов(НастройкаДокумента, ИмяТаблицы)
	
	Если Не ЗначениеЗаполнено(НастройкаДокумента.ТабличнаяЧасть) Тогда
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Не указано имя табличной части товаров в настройке документа %1'")
		, НастройкаДокумента.ТипДокумента);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	СправочникНоменклатура = ПолноеИмяСправочникаНоменклатуры();
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	&Номенклатура КАК Номенклатура,
	|	&КлючНоменклатуры КАК КлючНоменклатуры
	|ПОМЕСТИТЬ ТаблицаНоменклатуры
	|ИЗ
	|	ТекущаяТаблица КАК ТабДок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабЧастьДокумента1С КАК ТабЧасть
	|		ПО ТабДок.Документ1С = ТабЧасть.Ссылка
	|ГДЕ
	|	&УсловиеНоменклатуры";
	
	Результат = СтрЗаменить(Результат, "ТекущаяТаблица", ИмяТаблицы);
	
	Если НастройкаДокумента.ТабличнаяЧасть = "<Реквизиты шапки>" Тогда
		Результат = СтрЗаменить(Результат, "ТабЧастьДокумента1С"
		, "Документ." + НастройкаДокумента.ТипДокумента);
	Иначе
		Результат = СтрЗаменить(Результат, "ТабЧастьДокумента1С"
		, "Документ." + НастройкаДокумента.ТипДокумента + "." + НастройкаДокумента.ТабличнаяЧасть);
	КонецЕсли;
	
	ТипыДокументовВСО = Перечисление_ТипыДокументовВСО();
	
	Если ТипыДокументовВСО.Свойство(НастройкаДокумента.ТипДокумента) Тогда
		Результат = СтрЗаменить(Результат, "&Номенклатура", "ТабЧасть.Номенклатура");
		Результат = СтрЗаменить(Результат, "&УсловиеНоменклатуры", "ИСТИНА");
	Иначе
		Результат = СтрЗаменить(Результат, "&Номенклатура"
		, "ВЫРАЗИТЬ(ТабЧасть.Номенклатура КАК Справочник.Номенклатура)");
		Результат = СтрЗаменить(Результат, "&УсловиеНоменклатуры"
		, "ТИПЗНАЧЕНИЯ(ТабЧасть.Номенклатура) = ТИП(Справочник.Номенклатура)");
	КонецЕсли;
	
	Если ЗапросПоддерживаетЧтениеИдентификатора() Тогда
		
		Если ТипыДокументовВСО.Свойство(НастройкаДокумента.ТипДокумента) Тогда
			Результат = СтрЗаменить(Результат, "&КлючНоменклатуры", "УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ТабЧасть.Номенклатура)");
		Иначе
			Результат = СтрЗаменить(Результат, "&КлючНоменклатуры"
		, "УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВЫРАЗИТЬ(ТабЧасть.Номенклатура КАК Справочник.Номенклатура))");
		КонецЕсли;
		
		Результат = Результат + " ИНДЕКСИРОВАТЬ ПО КлючНоменклатуры";
		
	Иначе
		Результат = СтрЗаменить(Результат, "&КлючНоменклатуры", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "Справочник.Номенклатура", СправочникНоменклатура);
	Результат = СтрЗаменить(Результат, "ТабЧасть.Номенклатура", "ТабЧасть." + НастройкаДокумента.ПолеНоменклатура);
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаДокументов_ВТ_ДобавитьКлючиНоменклатуры(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура
	|ИЗ
	|	ТаблицаНоменклатуры КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаНоменклатуры");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
	
	ЗаполнитьВТаблицеКлючиПоОбъектам1С(ТаблицаНоменклатуры, "Номенклатура", "КлючНоменклатуры");
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаНоменклатуры, "ТаблицаНоменклатуры", "КлючНоменклатуры");
	
КонецПроцедуры

Процедура ТаблицаДокументов_ФильтроватьВТ_ТоварПодлежитМаркировке(НастройкаДокумента, МенеджерВТ, ИмяТаблицы)
	
	НовоеИмяТаблицы = НастройкаДокумента.ТипДокумента + "_ДокументыПодлежатМаркировке";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_Фильтр_ТоварПодлежитМаркировке(НастройкаДокумента, ИмяТаблицы, НовоеИмяТаблицы);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ИмяТаблицы = НовоеИмяТаблицы;
	
КонецПроцедуры

Функция ТекстЗапроса_Фильтр_ТоварПодлежитМаркировке(НастройкаДокумента, ТекИмяТаблицы, НовоеИмяТаблицы)
	
	Если Не ЗначениеЗаполнено(НастройкаДокумента.ТабличнаяЧасть) Тогда
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Не указано имя табличной части товаров в настройке документа %1'")
		, НастройкаДокумента.ТипДокумента);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТабДок.Документ1С КАК Документ1С
	|ПОМЕСТИТЬ ПодходящиеДокументы
	|ИЗ
	|	ТекущаяТаблица КАК ТабДок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабЧастьДокумента1С КАК ТабЧасть
	|		ПО ТабДок.Документ1С = ТабЧасть.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ НоменклатураНеПодлежитМаркировке КАК ТабНоменклатуры
	|		ПО (ТабЧасть.Номенклатура = ТабНоменклатуры.Номенклатура)
	|ГДЕ
	|	ТабНоменклатуры.Номенклатура ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДок.*
	|ПОМЕСТИТЬ НоваяТаблица
	|ИЗ
	|	ПодходящиеДокументы КАК ПодходящиеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТекущаяТаблица КАК ТабДок
	|		ПО ПодходящиеДокументы.Документ1С = ТабДок.Документ1С
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТабДок.Документ1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТекущаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПодходящиеДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НоменклатураНеПодлежитМаркировке";
	
	Результат = СтрЗаменить(Результат, "НоваяТаблица", НовоеИмяТаблицы);
	Результат = СтрЗаменить(Результат, "ТекущаяТаблица", ТекИмяТаблицы);
	Результат = СтрЗаменить(Результат, "ТабЧасть.Номенклатура", "ТабЧасть." + НастройкаДокумента.ПолеНоменклатура);
	
	Если НастройкаДокумента.ТабличнаяЧасть = "<Реквизиты шапки>" Тогда
		Результат = СтрЗаменить(Результат, "ТабЧастьДокумента1С"
		, "Документ." +  НастройкаДокумента.ТипДокумента);
	Иначе
		Результат = СтрЗаменить(Результат, "ТабЧастьДокумента1С"
		, "Документ." + НастройкаДокумента.ТипДокумента + "." + НастройкаДокумента.ТабличнаяЧасть);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаДокументов_ФильтроватьВТ_ЕстьТовары(НастройкаДокумента, МенеджерВТ, ИмяТаблицы)
	
	Если Не ЗначениеЗаполнено(НастройкаДокумента.ТабличнаяЧасть)
		Или НастройкаДокумента.ТабличнаяЧасть = "<Реквизиты шапки>" Тогда
		Возврат;
	КонецЕсли;
	
	НовоеИмяТаблицы = НастройкаДокумента.ТипДокумента + "_ДокументыСТоварами";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_Фильтр_ЕстьТовары(НастройкаДокумента, ИмяТаблицы, НовоеИмяТаблицы);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ИмяТаблицы = НовоеИмяТаблицы;
	
КонецПроцедуры

Функция ТекстЗапроса_Фильтр_ЕстьТовары(НастройкаДокумента, ТекИмяТаблицы, НовоеИмяТаблицы)
	
	Результат =
	"ВЫБРАТЬ
	|	ТабДок.*
	|ПОМЕСТИТЬ НоваяТаблица
	|ИЗ
	|	ТекущаяТаблица КАК ТабДок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабЧастьДокумента1С КАК ТабЧасть
	|		ПО ТабДок.Документ1С = ТабЧасть.Ссылка
	|			И (ТабЧасть.НомерСтроки = 1)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТекущаяТаблица";
	
	Результат = СтрЗаменить(Результат, "НоваяТаблица", НовоеИмяТаблицы);
	Результат = СтрЗаменить(Результат, "ТекущаяТаблица", ТекИмяТаблицы);
	Результат = СтрЗаменить(Результат, "ТабЧастьДокумента1С"
	, "Документ." + НастройкаДокумента.ТипДокумента + "." + НастройкаДокумента.ТабличнаяЧасть);
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаДокументов_ВТ_ДобавитьКлючиДокументов1С(НастройкаДокумента, МенеджерВТ, ИмяТаблицы) Экспорт
	
	НовоеИмяТаблицы = НастройкаДокумента.ТипДокумента + "_СКлючами";
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Документ1С КАК Документ1С
	|ИЗ
	|	ТекущаяТаблица КАК Т";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекущаяТаблица", ИмяТаблицы);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ДокументыСКлючами = Запрос.Выполнить().Выгрузить();
	
	ЗаполнитьВТаблицеКлючиПоОбъектам1С(ДокументыСКлючами, "Документ1С", "КлючДокумента1С", "ТипКлючаДокумента1С");
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ДокументыСКлючами, "ДокументыСКлючами", "Документ1С");
	
	Запрос = Новый Запрос(ТекстЗапроса_ДобавитьКлючиДокументов1С(ИмяТаблицы, НовоеИмяТаблицы));
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ИмяТаблицы = НовоеИмяТаблицы;
	
КонецПроцедуры

Функция ТекстЗапроса_ДобавитьКлючиДокументов1С(ТекИмяТаблицы, НовоеИмяТаблицы)
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументыСКлючами.КлючДокумента1С КАК КлючДокумента1С,
	|	ДокументыСКлючами.ТипКлючаДокумента1С КАК ТипКлючаДокумента1С,
	|	ТабДок.*
	|ПОМЕСТИТЬ НоваяТаблица
	|ИЗ
	|	ТекущаяТаблица КАК ТабДок,
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыСКлючами КАК ДокументыСКлючами
	|		ПО ТабДок.Документ1С = ДокументыСКлючами.Документ1С
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючДокумента1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТекущаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДокументыСКлючами";
	
	Результат = СтрЗаменить(Результат, "НоваяТаблица", НовоеИмяТаблицы);
	Результат = СтрЗаменить(Результат, "ТекущаяТаблица", ТекИмяТаблицы);
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаДокументов_ВТ_ДобавитьДокументыУчета(НастройкаДокумента, МенеджерВТ, ИмяТаблицы)
	
	НовоеИмяТаблицы = НастройкаДокумента.ТипДокумента + "_СДокументамиУчета";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ДобавитьДокументыУчета(ИмяТаблицы, НовоеИмяТаблицы);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ИмяТаблицы = НовоеИмяТаблицы;
	
КонецПроцедуры

Функция ТекстЗапроса_ДобавитьДокументыУчета(ТекИмяТаблицы, НовоеИмяТаблицы)
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ДокументыУчета.Ссылка, НЕОПРЕДЕЛЕНО) КАК ДокументУчета,
	|	ЕСТЬNULL(ДокументыУчета.ОтражениеВЭДО, НЕОПРЕДЕЛЕНО) КАК ОтражениеВЭДО,
	|	ЕСТЬNULL(ДокументыУчета.Комментарий, ТабДок.Комментарий) КАК Комментарий,
	|	ТабДок.*
	|ПОМЕСТИТЬ НоваяТаблица
	|ИЗ
	|	ТекущаяТаблица КАК ТабДок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ПО ТабДок.КлючДокумента1С = ДокументыУчета.КлючДокумента1С
	|			И ТабДок.ТипКлючаДокумента1С = ДокументыУчета.ТипКлючаДокумента1С
	|			И (НЕ ДокументыУчета.ПометкаУдаления)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТекущаяТаблица";
	
	Результат = СтрЗаменить(Результат, "НоваяТаблица", НовоеИмяТаблицы);
	Результат = СтрЗаменить(Результат, "ТекущаяТаблица", ТекИмяТаблицы);
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаДокументов_ВТ_ДобавитьПоследниеОперации(НастройкаДокумента, МенеджерВТ, ИмяТаблицы)
	
	НовоеИмяТаблицы = НастройкаДокумента.ТипДокумента + "_СПоследнимиОперациями";
	
	ПодходящиеТипы = ТипыИнтерактивныхОпераций();
	УдалитьЗначениеИзМассива(ПодходящиеТипы, Перечисление_ТипыОпераций().РезервированиеПартий);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ДобавитьПоследниеОперации(ИмяТаблицы, НовоеИмяТаблицы);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ИнтерактивныеОперации", ПодходящиеТипы);
	Запрос.Выполнить();
	
	ИмяТаблицы = НовоеИмяТаблицы;
	
КонецПроцедуры

Функция ТекстЗапроса_ДобавитьПоследниеОперации(ТекИмяТаблицы, НовоеИмяТаблицы)
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабДок.ДокументУчета КАК ДокументУчета,
	|	МАКСИМУМ(Операции.Дата) КАК ДатаОперации
	|ПОМЕСТИТЬ втПоследниеДатыОпераций
	|ИЗ
	|	ТекущаяТаблица КАК ТабДок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ТабДок.ДокументУчета = Операции.ДокументУчета
	|			И (Операции.ТипОперации В (&ИнтерактивныеОперации))
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДок.ДокументУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Операции.ДокументУчета КАК ДокументУчета,
	|	МАКСИМУМ(Операции.Ссылка) КАК Операция
	|ПОМЕСТИТЬ втПоследниеОперации
	|ИЗ
	|	втПоследниеДатыОпераций КАК ПоследниеДаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ПоследниеДаты.ДокументУчета = Операции.ДокументУчета
	|			И ПоследниеДаты.ДатаОперации = Операции.Дата
	|			И (Операции.ТипОперации В (&ИнтерактивныеОперации))
	|
	|СГРУППИРОВАТЬ ПО
	|	Операции.ДокументУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ втПоследниеДатыОпераций
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТекущаяТаблица.*,
	|	ЕСТЬNULL(Операции.Ссылка, ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Операции.ПустаяССылка)) КАК ПоследняяОперация,
	|	ЕСТЬNULL(Операции.ТипОперации, """") КАК ТипПоследнейОперации,
	|	ЕСТЬNULL(СтатусыОпераций.Статус, """") КАК СтатусПоследнейОперации
	|ПОМЕСТИТЬ НоваяТаблица
	|ИЗ
	|	ТекущаяТаблица КАК ТекущаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПоследниеОперации КАК ПоследниеОперации
	|		ПО (ПоследниеОперации.ДокументУчета = ТекущаяТаблица.ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО (ПоследниеОперации.Операция = Операции.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО (ПоследниеОперации.Операция = СтатусыОпераций.Операция)
	|			И (СтатусыОпераций.ТипСтатуса = ""ОсновнойСтатус"")
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТекущаяТаблица.ДокументУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТекущаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ втПоследниеОперации";
	
	Результат = СтрЗаменить(Результат, "ТекущаяТаблица", ТекИмяТаблицы);
	Результат = СтрЗаменить(Результат, "НоваяТаблица", НовоеИмяТаблицы);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ТаблицаДокументов

// #Область ДопКолонкиСпискаДокументов

// Получает из ПМ настройки дополнительных колонок списка документов
// 
// Возвращаемое значение:
//  Неопределено, Структура - см. Новый_НастройкиСпискаДокументов()
//
Функция НастройкиДополнительныхКолонокСпискаДокументов() Экспорт
	
	СтандартнаяОбработка = Истина;
	ПараметрыПМ = Новый_НастройкиДопКолонокСпискаДокументов();
	ПМ_ОбработатьСобытие_ПриНастройкеСпискаДокументов(ПараметрыПМ, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		Настройки = НастройкиМодуля();
		Результат = Новый_НастройкиДопКолонокСпискаДокументов();
		
		Результат.ДопКолонка1.Видимость = Настройки.ДопКолонка1_Видимость;
		Результат.ДопКолонка1.Заголовок = Настройки.ДопКолонка1_Заголовок;
		Результат.ДопКолонка1.ТипКолонки = Настройки.ДопКолонка1_ТипКолонки;
		
		Результат.ДопКолонка2.Видимость = Настройки.ДопКолонка2_Видимость;
		Результат.ДопКолонка2.Заголовок = Настройки.ДопКолонка2_Заголовок;
		Результат.ДопКолонка2.ТипКолонки = Настройки.ДопКолонка2_ТипКолонки;
		
		Результат.ДопКолонка3.Видимость = Настройки.ДопКолонка3_Видимость;
		Результат.ДопКолонка3.Заголовок = Настройки.ДопКолонка3_Заголовок;
		Результат.ДопКолонка3.ТипКолонки = Настройки.ДопКолонка3_ТипКолонки;
		
		Действие = Перечисление_ДействияМетрики().ЧтениеНастроек;
		
	Иначе
		
		Результат = ПараметрыПМ;
		
		Действие = Перечисление_ДействияМетрики().ОбработкаСобытияПМ;
		
	КонецЕсли;
	
	Метрика_НастройкиДопКолонокСпискаДокументов(Действие, Результат);
	
	Возврат Результат;
	
КонецФункции

// Контракт описания дополнительных колонок списка документов на основной форме
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * ДопКолонка1 - Структура - см. Новый_НастройкаДопКолонкиСпискаДокументов();
//   * ДопКолонка2 - Структура - см. Новый_НастройкаДопКолонкиСпискаДокументов();
//   * ДопКолонка3 - Структура - см. Новый_НастройкаДопКолонкиСпискаДокументов();
//   * ТребуетсяОбработкаПриЗаполненияСписка - Булево - Истина, если готовую таблицу списка документов
//     необходимо передать в событие ПМ ПриЗаполненииСпискаДокументов для дозаполнения;
//
Функция Новый_НастройкиДопКолонокСпискаДокументов()
	
	Результат = Новый Структура;
	Результат.Вставить("ДопКолонка1", Новый_НастройкаДопКолонкиСпискаДокументов());
	Результат.Вставить("ДопКолонка2", Новый_НастройкаДопКолонкиСпискаДокументов());
	Результат.Вставить("ДопКолонка3", Новый_НастройкаДопКолонкиСпискаДокументов());
	
	Результат.Вставить("ТребуетсяОбработкаПриЗаполненияСписка", Ложь);
	
	Возврат Результат;
	
КонецФункции

// Контракт описания дополнительной колонки списка документов на основной форме
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * Заголовок - Строка - заголовок поля табличной части;
//   * Видимость - Булево - признак видимости поля;
//   * ОписаниеТипа - ОписаниеТипа - описание типа данных поля табличной части;
//
Функция Новый_НастройкаДопКолонкиСпискаДокументов()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Заголовок",  "");
	Результат.Вставить("Видимость",  Ложь);
	Результат.Вставить("ТипКолонки", "");
	
	Возврат Результат;

КонецФункции

// #КонецОбласти // ДопКолонкиСпискаДокументов

// #Область НастройкиДокументов

// Возвращает все типы документов с которыми умеет работать модуль
// 
// Возвращаемое значение:
//  Массив из Строка - имена документов;
//
Функция ТипыДокументовМодуля() Экспорт
	
	Результат = Новый Массив;
	
	НастройкиДокументовУчета = НастройкиДокументовУчета_ВсеЭлементы();
	Для каждого Настройка Из НастройкиДокументовУчета Цикл
		НастройкиДокументаУчета = НастройкиДокументаУчета_Прочитать(Настройка);
		ТипДокумента = НастройкиДокументаУчета.ТипДокумента;
		Результат.Добавить(ТипДокумента);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает из базы список всех настроек для всех документов учета
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_ДопСправочники
//
Функция НастройкиДокументовУчета_ВсеЭлементы() Экспорт
	
	Возврат МодульЯдро().НастройкиДокументовУчета_ВсеЭлементы();
	
КонецФункции

// Проверяет наличие в базе документов учета по типу документа 1С
//
// Параметры:
//  ТипДокумента - Строка - полное имя документа 1С
// 
// Возвращаемое значение:
//  Булево - Истина, если документы учета уже есть
//
Функция НастройкиДокументовУчета_ЕстьДокументыПоТипу(ТипДокумента) Экспорт
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК Т
	|ГДЕ
	|	Т.ТипДокумента = &ТипДокумента");
	
	Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие настройки документа учета
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С;
// 
// Возвращаемое значение:
//  Булево - Истина, если настройка есть
//
Функция НастройкиДокументовУчета_ЕстьНастройка(Документ1С)
	
	ТипДокумента = ТипЗнч(Документ1С);
	
	КлючКэш = "ЕстьНастройкаДокумента: " + ТипДокумента;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Настройка = НастройкиДокументовУчета_НайтиПоТипуДокумента(Документ1С.Метаданные().Имя, Ложь);
	Результат = ЗначениеЗаполнено(Настройка);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Находит настройку документа учета по типу документа 1С
//
// Параметры:
//  ТипДокумента - Строка - имя документа 1С;
//  ВызыватьИсключение - Булево - (необязательный) Ложь, если нужно отключить ошибку отсутсвия настройки;
//
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДопСправочники - настройка документа учета
//
Функция НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента, ВызыватьИсключение = Истина) Экспорт
	
	Возврат МодульЯдро().НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента, ВызыватьИсключение);
	
КонецФункции

Функция НастройкиДокументаУчета_ПолучитьТекстЗапросаПоля(ЗначениеПоля,ИмяПоля)
	
	Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
		Текст = "	Документ1С."+ЗначениеПоля+" КАК "+ИмяПоля;
	Иначе
		Текст = "	НЕОПРЕДЕЛЕНО КАК "+ИмяПоля;
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

