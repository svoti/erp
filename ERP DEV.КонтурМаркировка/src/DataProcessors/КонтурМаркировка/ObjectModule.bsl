Функция НастройкиВыполненияРегламентныхЗаданий()
	
	КлючКэш = "НастройкиВыполненияРегламентныхЗаданий";
	Результат = ПараметрыСессии_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый_НастройкиВыполненияРегламентныхЗаданий();
	
	Если Не ЕстьНеобходимыеМетаданные("РегламентныеЗадания.КонтурМаркировка_ВыполнениеЗаданий") Тогда
		Результат.ИспользоватьБСП = Истина;
		Результат.ВнешняяОбработка = МодульРегламентныеДействия();
	КонецЕсли;
	
	ПараметрыСессии_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ПоддерживаетсяАвтоОбработкаФоновыхЗаданий() Экспорт
	
	Если СерверныйРежимИБ() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ВерсияПлатформыНиже("8.3.5")
		И Не ВерсияРежимаСовместимостиНиже("8.3.5") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция МенеджерФоновыхЗаданийДоступен() Экспорт
	
	Если ПоддерживаетсяАвтоОбработкаФоновыхЗаданий() Тогда
		Возврат Истина; // Менеджер доступен всегда
	КонецЕсли;
	
	Попытка
		Отбор = Новый Структура;
		Отбор.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор);
		МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
		Результат = Истина;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

