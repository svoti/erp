Процедура Метрика_Функциональность_СобытиеПМ(ИмяСобытия, ПараметрыСобытия)
	
	ИменаСобытийПМ = Перечисление_ИменаСобытийПодключаемогоМодуля();
	
	// Метрики клиентского события записываются в МодулеКлиента
	Если ИмяСобытия = ИменаСобытийПМ.ПослеНажатияДопКнопкиНаКлиенте
		Или ИмяСобытия = ИменаСобытийПМ.ПриНажатииДопКнопкиНаКлиенте Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыСобытия.Свойство("ДокументУчета") Тогда
		Организация = ЗначениеРеквизитаОбъектаЛок(ПараметрыСобытия.ДокументУчета, "Организация");
	ИначеЕсли ПараметрыСобытия.Свойство("Организация1С") Тогда
		Организация = Организация_НайтиПоОрганизации1С(ПараметрыСобытия.Организация1С);
	ИначеЕсли ИмяСобытия = ИменаСобытийПМ.ПриЗаполненииДокументаУчета
		Или ИмяСобытия = ИменаСобытийПМ.ПриЗагрузкеКодовВНовыйДокументУчета Тогда
		Организация = ПараметрыСобытия.ОписаниеДокумента.Организация;
	ИначеЕсли ИмяСобытия = ИменаСобытийПМ.ПриВыполненииЗадачиВОчередиОбмена Тогда
		Организация = ПараметрыСобытия.ОписаниеЗадачи.Организация;
	Иначе
		Организация = Неопределено;
	КонецЕсли;
	
	Функциональность = "СобытиеПМ_" + ИмяСобытия;
	СтекМетрик_ДобавитьФункциональность(Функциональность, Организация);
	
КонецПроцедуры

