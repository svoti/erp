//  * ДатаЭмиссии - Дата - дата заказа;
//  * КоличествоКодов - Число - количество кодов;
//
Функция КоличествоКодовНаСвободныхОстатках(ПараметрыОтбора = Неопределено) Экспорт
	
	Возврат МодульЯдро().КоличествоКодовНаСвободныхОстатках(ПараметрыОтбора);
	
КонецФункции

// Записывает ошибку в журнал регистрации и сообщает пользователю
//
// Параметры:
//  Действие			 - Строка - действие, при котором возникла ошибка;
//  Ошибка				 - ИнформацияОбОшибке, Строка - описание ошибки;
//  ДопИнформация		 - Строка, Массив, СписокЗначений, Структура, Соответствие - доп информация;
//  ТекстСообщения		 - Строка - текст сообщения пользователю;
//  ИдентификаторФормы	 - УникальныйИдентификатор - см. СообщитьПользователюЛок();
//  ПолеФормы			 - Строка                  - см. СообщитьПользователюЛок();
//
Процедура ОбработатьОшибку(Действие, Ошибка
	, ДопИнформация		 = Неопределено
	, ТекстСообщения	 = Неопределено
	, ИдентификаторФормы = Неопределено
	, ПолеФормы			 = Неопределено
	, СсылкаНаОбъект	 = Неопределено) Экспорт
	
	МодульЯдро().ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения, ИдентификаторФормы, ПолеФормы, СсылкаНаОбъект);
	
КонецПроцедуры

// Показывает сообщение об ошибке привязанное к ячейке табличной части
//
// Параметры:
//  ТекстОшибки - Строка - текст ошибки;
//  ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы, к которой должно быть "привязано" сообщение;
//  ТаблицаФормы - ТаблицаФормы - таблица, к которой должно быть "привязано" сообщение;
//  ИмяКолонки   - Строка - имя колонки, к которой должно быть "привязано" сообщение;
//  ИндексСтроки - Число  - индекс строки, к которой должно быть "привязано" сообщение;
//
Процедура СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки
	, ИдентификаторФормы
	, ТаблицаФормы
	, ИмяКолонки
	, ИндексСтроки) Экспорт
	
	Если ВерсияПлатформыНиже("8.3") Тогда
		НомерСтроки = ИндексСтроки + 1;
		ТекстСообщения = ПараметрыВСтроку(НСтр(
		"ru = 'В таб. части ""%1"" в строке %2: %3'"), ТаблицаФормы.Заголовок, НомерСтроки, ТекстОшибки);
		СообщитьПользователюЛок(ТекстСообщения, ИдентификаторФормы);
	Иначе
		Индекс = Формат(ИндексСтроки, "ЧН=0; ЧГ=0");
		ПолеФормы = ПараметрыВСтроку("%1[%2].%3", ТаблицаФормы.Имя, Индекс, ИмяКолонки);
		СообщитьПользователюЛок(ТекстОшибки, ИдентификаторФормы, ПолеФормы);
	КонецЕсли;
	
КонецПроцедуры

// Показывает сообщение об ошибке привязанное к полю формы или ячейке таблицы
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой нужно показать ошибку;
//  ОшибкиЗаполнения - Массив, Структура - см. функцию Новый_ОшибкаЗаполнения();
//
Процедура СообщитьОбОшибкахЗаполнения(Форма, ОшибкиЗаполнения) Экспорт
	
	ИдентификаторФормы = Форма.УникальныйИдентификатор;
	
	Для Каждого Ошибка Из ЗначениеВМассиве(ОшибкиЗаполнения) Цикл
		
		Если ЗначениеЗаполнено(Ошибка.ИмяТаблицы) Тогда
			
			ИмяПоля = Ошибка.ИмяПоля;
			Таблица = Форма.Элементы[Ошибка.ИмяТаблицы];
			ИндексСтроки = Ошибка.НомерСтроки - 1;
			ЗаголовокРеквизита = ЗаголовокРеквизита(Форма, ИмяПоля, Ошибка.ИмяТаблицы);
			ТекстОшибки = СтрЗаменить(Ошибка.ТекстОшибки, ИмяПоля, ЗаголовокРеквизита);
			СообщитьОбОшибкеВСтрокеТабЧасти(ТекстОшибки, ИдентификаторФормы, Таблица, ИмяПоля, ИндексСтроки);
			
		Иначе
			
			ИмяПоля = Ошибка.ИмяПоля;
			ЗаголовокРеквизита = ЗаголовокРеквизита(Форма, ИмяПоля);
			ТекстОшибки = СтрЗаменить(Ошибка.ТекстОшибки, ИмяПоля, ЗаголовокРеквизита);
			СообщитьПользователюЛок(ТекстОшибки, ИдентификаторФормы, ИмяПоля);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует текст с первыми пятью кодами маркировки через запятую,
// если кодов больше, например 8, то добавляет текст "и еще 3"
//
// Параметры:
//  КодыМаркировки - Массив, ТаблицаЗначений - таблица содержит колонку КодМаркировки
// 
// Возвращаемое значение:
//  Строка - текст со списком кодов
//
Функция СписокКодовДляТекстаОшибки(КодыМаркировки) Экспорт
	
	Возврат МодульКонтроль().СписокКодовДляТекстаОшибки(КодыМаркировки);
	
КонецФункции

// Получает любой склад организации
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Склады - склад указанной организации;
//
Функция СкладОрганизации(Организация) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Склады КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Организация = &Организация");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Возврат ПолучитьРезультатЗапроса(Запрос);
	
КонецФункции

// Вызывает обработку события в подключаемом модуле
