Функция ОформлениеУведомлений() Экспорт
	
	КлючКэш = "ОформлениеУведомлений";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Соответствие;
	ТипыУведомлений = Перечисление_ТипыУведомлений();
	
	// Анкетирование
	Стр = Новый_ПредставлениеУведомления();
	Стр.ЦветТекста = Новый Цвет(255, 153, 0);
	Стр.Заголовок = НСтр("ru = 'Укажите роль и отрасль в настройках организации'");
	Стр.Подсказка = НСтр("ru = 'Это позволит в дальнейшем формировать внешний вид и функционал, которые необходимы вашей роли и отрасли'");
	Результат.Вставить(ТипыУведомлений.ЗаполнитеАнкету, Стр);
	
	// Обновление
	Стр = Новый_ПредставлениеУведомления();
	Стр.Заголовок = НСтр("ru = 'Обновитесь до новой версии'");
	Результат.Вставить(ТипыУведомлений.ОбновитесьДоНовойВерсии, Стр);
	
	// Срок действия сертификата
	Стр = Новый_ПредставлениеУведомления();
	Стр.ЦветТекста = Новый Цвет(242, 168, 110);
	Стр.Заголовок = НСтр("ru = 'Истекает срок действия сертификата'");
	Результат.Вставить(ТипыУведомлений.ИстекаетСрокДействияСертификата, Стр);
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

