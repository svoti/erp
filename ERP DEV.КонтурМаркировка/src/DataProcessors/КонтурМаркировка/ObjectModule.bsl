Процедура КодыМаркировки_РасформироватьАгрегаты(КодыАгрегатов)
	
	Если Не ЗначениеЗаполнено(КодыАгрегатов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(КодыАгрегатов);
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	
	ИндексКодМаркировки = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	Для Каждого Элемент Из КодыАгрегатов Цикл
		Если Не ЗначениеЗаполнено(Элемент) Тогда
			Продолжить;
		КонецЕсли;
		ТаблицаКодов.Удалить(ТаблицаКодов.Найти(Элемент, "КодМаркировки"));
	КонецЦикла;
	ТаблицаКодов.Индексы.Удалить(ИндексКодМаркировки);
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов.ЗаполнитьЗначения("", "КодАгрегата");
	ТаблицаКодов.ЗаполнитьЗначения(ПустойУникальныйИдентификатор(), "КлючАгрегата");
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

