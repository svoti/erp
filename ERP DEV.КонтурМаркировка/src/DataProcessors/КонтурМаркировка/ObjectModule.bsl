Функция ДокументУчета_ТребуемоеДействие(ДокументУчета)
	
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК Т
	|ГДЕ
	|	Т.ТипСтатуса = &ТипСтатуса
	|	И Т.ДокументУчета = &ДокументУчета");
	Запрос.УстановитьПараметр("ТипСтатуса", ТипыСтатусов.ТребуемоеДействие);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "Статус", ТребуемыеДействия.НачатьРаботу);
	
КонецФункции

