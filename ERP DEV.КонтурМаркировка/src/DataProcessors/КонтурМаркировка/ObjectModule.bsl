	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Файл
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.ТипФайла = &ТипФайла");
