Процедура ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ Таб1
	|ИЗ
	|	ТаблицаКодов КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.КлючКода КАК КлючКода,
	|	Таб.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Таб
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО Таб.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ИнформацияОКодах.ОбщийТипУпаковки <> ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВложенныеКоды.КлючКода КАК КлючКода,
	|	Таб.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК ВложенныеКоды
	|		ПО Таб.КлючКода = ВложенныеКоды.КлючАгрегата
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО Таб.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ИнформацияОКодах.ОбщийТипУпаковки = ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Итог.КлючКода КАК КлючКода,
	|	Итог.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	Итог1 КАК Итог
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таб.КлючКода,
	|	Таб.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	Таб2 КАК Таб
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО Таб.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ИнформацияОКодах.ОбщийТипУпаковки <> ЗНАЧЕНИЕ(Перечисление.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	
	Пока Истина Цикл
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	ЕстьИтог1 = Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0;
	
	ТекстЗапроса =
	"ВЫБРАТЬ * ПОМЕСТИТЬ ТаблицаКодов ИЗ Итог2 ИНДЕКСИРОВАТЬ ПО КлючКода;
	|УНИЧТОЖИТЬ Итог2; УНИЧТОЖИТЬ Таб2";
	Если ЕстьИтог1 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Итог2", "Итог1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Таб2", "Таб1");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

