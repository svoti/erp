Процедура ПМ_ОбработатьСобытие_ПриЗаполненииДополнительногоПараметраЭтикетки(ПараметрыПМ)
	
	ВерсияПМ = ВерсияОбработкиПМ();
	
	Если ЗначениеЗаполнено(ВерсияПМ) Тогда
		
		Если СравнитьВерсии(ВерсияПМ, "2.13.5") < 0 Тогда
			ПараметрыПМ.Вставить("КэшДопПараметраПМ", ПараметрыПМ.КэшЗначенийПараметра);
			ПараметрыПМ.Вставить("ПараметрыЭтикетки", Новый_ПараметрыЭтикетки_2_5_0(ПараметрыПМ));
		ИначеЕсли СравнитьВерсии(ВерсияПМ, "2.14") < 0 Тогда
			ПараметрыПМ.Вставить("КэшДопПараметраПМ", ПараметрыПМ.КэшЗначенийПараметра);
			ПараметрыПМ.Вставить("ПараметрыЭтикетки", ПараметрыПМ.СтрокаЭтикетки);
		Иначе
			// Совместимость не требуется
		КонецЕсли;
		
	КонецЕсли;
	
	ПМ_ОбработатьСобытие("ПриЗаполненииДополнительногоПараметраЭтикетки", ПараметрыПМ);
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПриФормированииСпискаЭтикетокДляПечати(ПараметрыПМ)
	
	ВерсияПМ = ВерсияОбработкиПМ();
	
	Если ЗначениеЗаполнено(ВерсияПМ) И СравнитьВерсии(ВерсияПМ, "3.0") < 0 Тогда
		ПараметрыПМ.ТаблицаЭтикеток.Колонки.ДопСведения_Количество.Имя = "ДопСведения_Объем";
		ПараметрыПМ.ТаблицаЭтикеток.Колонки.ДопСведения_ДатаСрокаГодности.Имя = "ДопСведения_СрокГодности";
	КонецЕсли;
	
	ПМ_ОбработатьСобытие("ПриФормированииСпискаЭтикетокДляПечати", ПараметрыПМ);
	
	Если ЗначениеЗаполнено(ВерсияПМ) И СравнитьВерсии(ВерсияПМ, "3.0") < 0 Тогда
		ПараметрыПМ.ТаблицаЭтикеток.Колонки.ДопСведения_Объем.Имя = "ДопСведения_Количество";
		ПараметрыПМ.ТаблицаЭтикеток.Колонки.ДопСведения_СрокГодности.Имя = "ДопСведения_ДатаСрокаГодности";
	КонецЕсли;
	
КонецПроцедуры

