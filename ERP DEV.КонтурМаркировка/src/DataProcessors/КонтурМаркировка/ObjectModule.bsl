Процедура МенеджерВТ_ДополнитьТаблицу(МенеджерВТ, ТаблицаПриемник, ТаблицаИсточник, ПоляИндекса, УдалитьИсточник = Ложь)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	ТаблицаИсточник КАК Т
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	ТаблицаПриемник КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаПриемник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ТаблицаПриемник
	|ИЗ
	|	ВременнаяТаблица КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПоляИндекса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВременнаяТаблица";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаПриемник", ТаблицаПриемник);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаИсточник", ТаблицаИсточник);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПоляИндекса", ПоляИндекса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	Если УдалитьИсточник Тогда
		Запрос = Новый Запрос("УНИЧТОЖИТЬ " + ТаблицаИсточник);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Запрос.Выполнить();
	КонецЕсли;
	
