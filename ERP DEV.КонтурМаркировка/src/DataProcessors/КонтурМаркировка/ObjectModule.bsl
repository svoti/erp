Процедура ТаблицаКодов_ВТ_ПодобратьКодыПоТипуОтчета(МенеджерВТ, ТипОтчетаОНанесении, КлючКода = Неопределено)
	
	ТипыОтчетаОНанесении = Перечисление_ТипыОтчетаОНанесении();
	
	Если ЭтоТипОтчетаОНанесенииПоУмолчанию(ТипОтчетаОНанесении) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Если ЗначениеЗаполнено(КлючКода) Тогда
		ТаблицаКодов.Добавить().КлючКода = КлючКода;
	КонецЕсли;
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТоварыКодаОперации", "КлючКода");
	
	ТаблицаКодов_ВТ_ЗаменитьНаборыНаВложенныеКоды(МенеджерВТ, "ТоварыКодаОперации");
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ, "ТоварыКодаОперации");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Товар КАК Товар,
	|	КОЛИЧЕСТВО(Т.КодМаркировки) КАК КоличествоКодов
	|ИЗ
	|	ТоварыКодаОперации КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.Товар");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ВыборкаТоваровКодаОперации = Запрос.Выполнить().Выбрать();
	
	ТекстЗапросаПорцияНовыхКодов = (
	"ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ПорцияНовыхКодов
	|ИЗ
	|	ВременнаяТаблицаКодов КАК Т
	|ГДЕ
	|	Т.Товар = &Товар");
	
	СкопироватьТаблицуВЗапросе(МенеджерВТ, "ТаблицаКодов", "ВременнаяТаблицаКодов", "Товар");
	ОчиститьТаблицуВЗапросе(МенеджерВТ, "ТаблицаКодов");
	
	ОтборПоКоличеству = (ТипОтчетаОНанесении = ТипыОтчетаОНанесении.РасформированиеНабора);
	
	// BSLLS:CreateQueryInCycle-off
	
	Пока ВыборкаТоваровКодаОперации.Следующий() Цикл
		
		ТекстЗапроса = ТекстЗапросаПорцияНовыхКодов;
		
		Если ОтборПоКоличеству Тогда
			КоличествоПервые = ВыборкаТоваровКодаОперации.КоличествоКодов;
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", ТекстЗапросаВыбратьПервые(КоличествоПервые));
		КонецЕсли;
		
		ЗапросПорцияНовыхКодов = Новый Запрос(ТекстЗапроса);
		ЗапросПорцияНовыхКодов.УстановитьПараметр("Товар", ВыборкаТоваровКодаОперации.Товар);
		ЗапросПорцияНовыхКодов.МенеджерВременныхТаблиц = МенеджерВТ;
		ЗапросПорцияНовыхКодов.Выполнить();
		
		ДополнитьТаблицуВЗапросе(МенеджерВТ, "ТаблицаКодов", "ПорцияНовыхКодов",, "КлючКода");
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
	УдалитьТаблицуИзЗапроса(МенеджерВТ, "ВременнаяТаблицаКодов");
	УдалитьТаблицуИзЗапроса(МенеджерВТ, "ТоварыКодаОперации");
	
КонецПроцедуры

Функция ТаблицаКодов_ВТ_СодержитКодыДляВнутреннегоУчета(МенеджерВТ, Организация = Неопределено)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТаблицаКодов.КлючКода КАК КлючКода
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТаблицаКодов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ИнформацияОКодах.ДляВнутреннегоУчета");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ЕстьКодыДляВнутреннегоУчета = Не Запрос.Выполнить().Пустой();
	
	Если ЕстьКодыДляВнутреннегоУчета Тогда
		Метрика_Функциональность_КодыДляВнутреннегоУчета(Организация);
	КонецЕсли;
	
	Возврат ЕстьКодыДляВнутреннегоУчета;
	
КонецФункции

Функция ТаблицаКодов_ВТ_ПервыйТипУпаковки(МенеджерВТ, ПодходящиеТовары, ВидПродукции)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ТипУпаковки КАК ТипУпаковки
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	&УсловиеТовары
	|	И &УсловиеВидПродукции";
	
	Если ЗначениеЗаполнено(ПодходящиеТовары) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеТовары", "Т.Товар В (&ПодходящиеТовары)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеТовары", "ИСТИНА");
	КонецЕсли;
	
	УсловиеВидПродукции = "ИСТИНА";
	Если ЗначениеЗаполнено(ВидПродукции) Тогда
		УсловиеВидПродукции = "Т.ВидПродукции = &ВидПродукции";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВидПродукции", УсловиеВидПродукции);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПодходящиеТовары", ПодходящиеТовары);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	
	Результат = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ТипУпаковки;
		Если Результат = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар Тогда
			Прервать; // МаркированныйТовар имеет более высокий приоритет
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ)
	
	ПустойВидПродукции = ПустойВидПродукции();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(Т.Товар.ВидПродукции, Т.ВидПродукции) КАК ВидПродукции
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	ЕСТЬNULL(Т.Товар.ВидПродукции, Т.ВидПродукции) <> &ПустойВидПродукции");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПустойВидПродукции", ПустойВидПродукции);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "ВидПродукции", ПустойВидПродукции);
	
КонецФункции

Функция ТаблицаКодов_ВТ_Перемаркировка_ПервыйВидПродукции(МенеджерВТ, ПодходящиеСпособыВыпуска)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(Т.Товар.ВидПродукции, Т.ВидПродукции) КАК ВидПродукции
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	ЕСТЬNULL(Т.Товар.ВидПродукции, Т.ВидПродукции) <> &ПустойВидПродукции
	|	И Т.СпособВыпускаТоваров В(&ПодходящиеСпособыВыпуска)");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПустойВидПродукции", Перечисления.КонтурМаркировка_ВидыПродукции.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПодходящиеСпособыВыпуска", ПодходящиеСпособыВыпуска);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "ВидПродукции");
	
КонецФункции

Функция ТаблицаКодов_ВТ_ПервыйТипСрокаГодности(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(Т.Товар.ТипСрокаГодности, """") КАК ТипСрокаГодности
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	ЕСТЬNULL(Т.Товар.ТипСрокаГодности, """") <> """"");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "ТипСрокаГодности");
	
КонецФункции

Функция ТаблицаКодов_ВТ_ПервыйКодГруппыТНВЭД(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КодГруппыТНВЭД.Значение КАК КодГруппыТНВЭД
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК КодГруппыТНВЭД
	|		ПО ТаблицаКодов.Товар = КодГруппыТНВЭД.Объект
	|			И (КодГруппыТНВЭД.ИмяРеквизита = ""ГруппаТНВЭД"")");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КодГруппыТНВЭД", "");
	
КонецФункции

Функция ТаблицаКодов_ВТ_ТоварыВыборка(МенеджерВТ, ПодходящиеСтатусы)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Товар КАК Товар
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.Товар <> &ПустойТовар
	|	И Т.Статус В(&ПодходящиеСтатусы)");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПустойТовар", Справочники.КонтурМаркировка_Товары.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПодходящиеСтатусы", ПодходящиеСтатусы);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция ТаблицаКодов_ВТ_ТоварыБезИсключений(МенеджерВТ, Исключения, ВидПродукции = Неопределено)
	
	ДополнитьМассив(Исключения, ЗначениеВМассиве(Справочники.КонтурМаркировка_Товары.ПустаяСсылка()));
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Товар КАК Товар
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.Товар НЕ В (&Исключения)
	|	И &ВидПродукции";
	
	Если ВидПродукции = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПродукции", "ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПродукции", "Т.ВидПродукции = &ВидПродукции");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Исключения", Исключения);
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "Товар");
	
КонецФункции

Функция ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности, ВидПродукции = Неопределено)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Товар КАК Товар
	|ПОМЕСТИТЬ ТоварыКодов
	|ИЗ
	|	ТаблицаКодов КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыКодов.Товар КАК Товар
	|ИЗ
	|	ТоварыКодов КАК ТоварыКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ГруппаПлатности
	|		ПО ТоварыКодов.Товар = ГруппаПлатности.Объект
	|			И (ГруппаПлатности.ИмяРеквизита = &РеквизитГруппаПлатности)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Товары КАК СпрТоваров
	|		ПО ТоварыКодов.Товар = СпрТоваров.Ссылка
	|ГДЕ
	|	ГруппаПлатности.Значение = &ГруппаПлатности
	|	И &ВидПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТоварыКодов";
	
	Если ВидПродукции = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПродукции", "ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПродукции", "СпрТоваров.ВидПродукции = &ВидПродукции");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.УстановитьПараметр("ГруппаПлатности", ГруппаПлатности);
	Запрос.УстановитьПараметр("РеквизитГруппаПлатности", Перечисление_ИменаДопРеквизитов().ГруппаПлатности);
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "Товар");
	
КонецФункции

Функция ТаблицаКодов_ВТ_ПервыйТипНабора(МенеджерВТ)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Товар КАК Набор
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ОбщийТипУпаковки = &Набор");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Набор", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор);
	
	Набор = ПолучитьРезультатЗапроса(Запрос, "Набор");
	ТипыНаборов = Перечисление_ТипыНаборов();
	
	Если МодульЯдро().ЭтоМультитоварныйНабор(Набор) Тогда
		Результат = ТипыНаборов.Мультитоварный;
	Иначе
		Результат = ТипыНаборов.Монотоварный;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаКодов_ВТ_РазрешительнаяДокументация(МенеджерВТ)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Т.Товар КАК Товар ИЗ ТаблицаКодов КАК Т");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Товар, Товар_ОсновнойРазрешительныйДокумент(Выборка.Товар));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаКодов_ВТ_НомераПартийВложенныхКодов(МенеджерВТ)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КлючКода", ОписаниеТипа_Идентификатор());
	Результат.Колонки.Добавить("НомерПартии", ОписаниеТипа_Строка());
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.КлючКода КАК КлючКода,
	|	ЕСТЬNULL(ИнформацияОКодах.НомерПартии, """") КАК НомерПартии
	|ИЗ
	|	ТаблицаКодов КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК ВложенныеКоды
	|		ПО Т.КлючКода = ВложенныеКоды.КлючАгрегата
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (ВложенныеКоды.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|
	|УПОРЯДОЧИТЬ ПО
	|	КлючКода,
	|	НомерПартии
	|ИТОГИ ПО
	|	КлючКода");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ВыборкаКлючКода = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКлючКода.Следующий() Цикл
		
		НомераПартийВложенныхКодов = Новый Массив();
		
		Выборка = ВыборкаКлючКода.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НомерПартии = Выборка.НомерПартии;
			
			Если Не ЗначениеЗаполнено(НомерПартии) Тогда
				НомерПартии = "<отсутствует>";
			КонецЕсли;
			
			НомераПартийВложенныхКодов.Добавить(НомерПартии);
			
		КонецЦикла;
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.КлючКода = ВыборкаКлючКода.КлючКода;
		НоваяСтрока.НомерПартии = СоединитьСтроку(НомераПартийВложенныхКодов, "; ");
		
	КонецЦикла;
	
	ТаблицаЗначений_ДобавитьИндекс(Результат, "КлючКода");
	
	Возврат Результат;
	
КонецФункции

Процедура ТаблицаКодов_РаспределитьКлючиСтрокДокумента(ТаблицаКодов, ТоварыДокумента, ТоварыМаркировки)
	
	ТаблицаКодов.Колонки.Добавить("ОтключитьПодборСтрокиДокумента", ОписаниеТипа_Булево());
	ИндексКодМаркировки = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	
	Для Каждого КодАгрегата Из ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КодАгрегата", Истина) Цикл
		СтрКода = ТаблицаКодов.Найти(КодАгрегата, "КодМаркировки");
		Если СтрКода <> Неопределено
			И СтрКода.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
			// Сопоставление транспортных упаковок будет выполнено по вложенным кодам
			СтрКода.ОтключитьПодборСтрокиДокумента = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(ИндексКодМаркировки);
	
	ТаблицаКодов_РаспределитьКлючиСтрокДокументаСУчетомТоваров(ТаблицаКодов, ТоварыДокумента, ТоварыМаркировки);
	ТаблицаКодов_РаспределитьКлючиСтрокДокументаБезУчетаТоваров(ТаблицаКодов, ТоварыДокумента);
	
	ТаблицаКодов.Колонки.Удалить("ОтключитьПодборСтрокиДокумента");
	
КонецПроцедуры

Процедура ТаблицаКодов_РаспределитьКлючиСтрокДокументаСУчетомТоваров(ТаблицаКодов, СтрокиДокумента, ТоварыМаркировки = Неопределено)
	
	ТоварыАгрегатов = ТоварыАгрегатов_Прочитать(ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КлючКода"));
	ТоварыАгрегатов.Колонки.Добавить("КоличествоСтрок", ОписаниеТипа_Число());
	ТоварыАгрегатов.ЗаполнитьЗначения(1, "КоличествоСтрок");
	ТоварыАгрегатов.Свернуть("КлючКода", "КоличествоСтрок");
	ТоварыАгрегатов.Индексы.Добавить("КлючКода");
	
	Для Каждого СтрКода Из ТаблицаКодов Цикл
		СтрТоваров = ТоварыАгрегатов.Найти(СтрКода.КлючКода, "КлючКода");
		Если СтрТоваров <> Неопределено
			И СтрТоваров.КоличествоСтрок > 1 Тогда
			СтрКода.ОтключитьПодборСтрокиДокумента = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ПопыткаСПустойУпаковкойДокумента = 2;
	ПопыткаСПустойСериейДокумента = 3;
	
	Для НомерПопытки = 1 По ПопыткаСПустойСериейДокумента Цикл
		
		Если Не ТаблицаКодов_ЕстьПустыеКлючиСтрокДокументов(ТаблицаКодов) Тогда
			Прервать;
		КонецЕсли;
		
		ПараметрыРаспределения = Новый_ПараметрыРаспределенияКодов();
		ПараметрыРаспределения.РазрешитьПустуюУпаковкуПриемника = (НомерПопытки = ПопыткаСПустойУпаковкойДокумента);
		ПараметрыРаспределения.РазрешитьПустуюСериюПриемника = (НомерПопытки = ПопыткаСПустойСериейДокумента);
		
		Для каждого СтрДок Из СтрокиДокумента Цикл
			
			// Если товары маркировки не переданы отдельно значит в строке документа есть товар
			Если ТоварыМаркировки = Неопределено Тогда
				СтрокиТоваров = ЗначениеВМассиве(СтрДок);
			Иначе
				Отбор = Новый Структура("КлючСтрокиДокумента", СтрДок.КлючСтрокиДокумента);
				СтрокиТоваров = ТоварыМаркировки.НайтиСтроки(Отбор);
			КонецЕсли;
			
			Для каждого СтрТовара Из СтрокиТоваров Цикл
				
				ПараметрыРаспределения.РазрешитьПустуюСериюИсточника = Ложь;
				ПараметрыРаспределения.РазрешитьПустуюУпаковкуИсточника = Ложь;
				ПараметрыРаспределения.РазрешитьПустуюХарактеристикуИсточника = Ложь;
				
				Распределено = РаспределитьКлючСтрокиДокументаСУчетомТовара(
				ТаблицаКодов, СтрДок, СтрТовара, ПараметрыРаспределения);
				Если Распределено >= СтрТовара.КоличествоУпаковок Тогда
					Продолжить;
				КонецЕсли;
				
				ПараметрыРаспределения.РазрешитьПустуюСериюИсточника = Истина;
				Распределено = РаспределитьКлючСтрокиДокументаСУчетомТовара(
				ТаблицаКодов, СтрДок, СтрТовара, ПараметрыРаспределения);
				Если Распределено >= СтрТовара.КоличествоУпаковок Тогда
					Продолжить;
				КонецЕсли;
				
				ПараметрыРаспределения.РазрешитьПустуюУпаковкуИсточника = Истина;
				Распределено = РаспределитьКлючСтрокиДокументаСУчетомТовара(
				ТаблицаКодов, СтрДок, СтрТовара, ПараметрыРаспределения);
				Если Распределено >= СтрТовара.КоличествоУпаковок Тогда
					Продолжить;
				КонецЕсли;
				
				ПараметрыРаспределения.РазрешитьПустуюХарактеристикуИсточника = Истина;
				Распределено = РаспределитьКлючСтрокиДокументаСУчетомТовара(
				ТаблицаКодов, СтрДок, СтрТовара, ПараметрыРаспределения);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_РаспределитьКлючиСтрокДокументаБезУчетаТоваров(ТаблицаКодов, СтрокиДокумента)
	
	ПопыткаСПустойУпаковкойДокумента = 2;
	ПопыткаСПустойСериейДокумента = 3;
	
	Для НомерПопытки = 1 По ПопыткаСПустойСериейДокумента Цикл
		
		Если Не ТаблицаКодов_ЕстьПустыеКлючиСтрокДокументов(ТаблицаКодов) Тогда
			Прервать;
		КонецЕсли;
		
		ПараметрыРаспределения = Новый_ПараметрыРаспределенияКодов();
		ПараметрыРаспределения.РазрешитьПустуюУпаковкуПриемника = (НомерПопытки = ПопыткаСПустойУпаковкойДокумента);
		ПараметрыРаспределения.РазрешитьПустуюСериюПриемника = (НомерПопытки = ПопыткаСПустойСериейДокумента);
		
		Для каждого СтрДок Из СтрокиДокумента Цикл
			
			ПараметрыРаспределения.РазрешитьПустуюСериюИсточника = Ложь;
			ПараметрыРаспределения.РазрешитьПустуюУпаковкуИсточника = Ложь;
			ПараметрыРаспределения.РазрешитьПустуюХарактеристикуИсточника = Ложь;
			
			Распределено = РаспределитьКлючСтрокиДокументаБезУчетаТовара(ТаблицаКодов, СтрДок, ПараметрыРаспределения);
			Если Распределено >= СтрДок.КоличествоУпаковок Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыРаспределения.РазрешитьПустуюСериюИсточника = Истина;
			Распределено = РаспределитьКлючСтрокиДокументаБезУчетаТовара(ТаблицаКодов, СтрДок, ПараметрыРаспределения);
			Если Распределено >= СтрДок.КоличествоУпаковок Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыРаспределения.РазрешитьПустуюУпаковкуИсточника = Истина;
			Распределено = РаспределитьКлючСтрокиДокументаБезУчетаТовара(ТаблицаКодов, СтрДок, ПараметрыРаспределения);
			Если Распределено >= СтрДок.КоличествоУпаковок Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыРаспределения.РазрешитьПустуюХарактеристикуИсточника = Истина;
			Распределено = РаспределитьКлючСтрокиДокументаБезУчетаТовара(ТаблицаКодов, СтрДок, ПараметрыРаспределения);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция РаспределитьКлючСтрокиДокументаСУчетомТовара(ТаблицаКодов, СтрДок, СтрТовара, ПараметрыРаспределения)
	
	Распределено = 0;
	КэшКлючейНоменклатуры1С = Новый Соответствие;
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		
		Если СтрКода.ОтключитьПодборСтрокиДокумента
			Или СтрКода.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МультитоварнаяУпаковка Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрКода.КлючСтрокиДокумента) Тогда
			Если СтрКода.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента Тогда
				Распределено = Распределено + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если Распределено >= СтрТовара.КоличествоУпаковок Тогда
			Прервать;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрТовара.Товар)
			И СтрКода.Товар <> СтрТовара.Товар Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрКода.КлючНоменклатуры1С) Тогда
			
			АналитикаКода = АналитикаНоменклатуры1С(СтрКода.КлючНоменклатуры1С, КэшКлючейНоменклатуры1С);
			АналитикаДокумента = АналитикаНоменклатуры1С(СтрДок.КлючНоменклатуры1С, КэшКлючейНоменклатуры1С);
			
			Если Не АналитикаКодаПодходитСтрокеДокумента(АналитикаКода, АналитикаДокумента, ПараметрыРаспределения) Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		СтрКода.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		СтрКода.КлючНоменклатуры1С = СтрДок.КлючНоменклатуры1С;
		
		Распределено = Распределено + 1;
		
	КонецЦикла;
	
	Возврат Распределено;
	
КонецФункции

Функция РаспределитьКлючСтрокиДокументаБезУчетаТовара(ТаблицаКодов, СтрДок, ПараметрыРаспределения)
	
	Распределено = 0;
	КэшКлючейНоменклатуры1С = Новый Соответствие;
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		
		Если ЗначениеЗаполнено(СтрКода.КлючСтрокиДокумента) Тогда
			Если СтрКода.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента Тогда
				Распределено = Распределено + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если Распределено >= СтрДок.КоличествоУпаковок Тогда
			Прервать;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрКода.КлючНоменклатуры1С) Тогда
			Продолжить;
		КонецЕсли;
		
		АналитикаКода = АналитикаНоменклатуры1С(СтрКода.КлючНоменклатуры1С, КэшКлючейНоменклатуры1С);
		АналитикаДокумента = АналитикаНоменклатуры1С(СтрДок.КлючНоменклатуры1С, КэшКлючейНоменклатуры1С);
		
		Если АналитикаКодаПодходитСтрокеДокумента(АналитикаКода, АналитикаДокумента, ПараметрыРаспределения) Тогда
			
			СтрКода.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
			СтрКода.КлючНоменклатуры1С = СтрДок.КлючНоменклатуры1С;
			
			Распределено = Распределено + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Распределено;
	
КонецФункции

Функция АналитикаКодаПодходитСтрокеДокумента(АналитикаКода, АналитикаДокумента, ПараметрыРаспределения)
	
	ПроверитьПустуюСериюКода = Не ПараметрыРаспределения.РазрешитьПустуюСериюИсточника;
	ПроверитьПустуюУпаковкуКода = Не ПараметрыРаспределения.РазрешитьПустуюУпаковкуИсточника;
	ПроверитьПустуюХарактеристикуКода = Не ПараметрыРаспределения.РазрешитьПустуюХарактеристикуИсточника;
	ПроверитьПустуюУпаковкуДокумента = Не ПараметрыРаспределения.РазрешитьПустуюУпаковкуПриемника;
	ПроверитьПустуюСериюДокумента = Не ПараметрыРаспределения.РазрешитьПустуюСериюПриемника;
	
	Если ЗначениеЗаполнено(АналитикаКода.Номенклатура)
		И АналитикаКода.Номенклатура <> АналитикаДокумента.Номенклатура Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если (ПроверитьПустуюХарактеристикуКода Или ЗначениеЗаполнено(АналитикаКода.Характеристика))
		И АналитикаКода.Характеристика <> АналитикаДокумента.Характеристика Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УчитыватьУпаковкуКода = (ПроверитьПустуюУпаковкуКода Или ЗначениеЗаполнено(АналитикаКода.Упаковка));
	УчитыватьУпаковкуДокумента = (ПроверитьПустуюУпаковкуДокумента Или ЗначениеЗаполнено(АналитикаДокумента.Упаковка));
	Если УчитыватьУпаковкуКода И УчитыватьУпаковкуДокумента Тогда
		Если АналитикаКода.Упаковка <> АналитикаДокумента.Упаковка Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	УчитыватьСериюКода = (ПроверитьПустуюСериюКода Или ЗначениеЗаполнено(АналитикаКода.Серия));
	УчитыватьСериюДокумента = (ПроверитьПустуюСериюДокумента Или ЗначениеЗаполнено(АналитикаДокумента.Серия));
	Если УчитыватьСериюКода И УчитыватьСериюДокумента Тогда
		Если АналитикаКода.Серия <> АналитикаДокумента.Серия Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ТаблицаКодов_ДобавитьКоличествоВПолныеКоды(ТаблицаКодов)
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыУпаковок = Перечисления.КонтурМаркировка_ТипыУпаковок;
	ВидыПродукции = Перечисления.КонтурМаркировка_ВидыПродукции;
	РазделительGS = РазделительGS1();
	
	Для Каждого СтрКода Из ТаблицаКодов Цикл
		
		Если Не ЗначениеЗаполнено(СтрКода.Количество)
			Или Не ЗначениеЗаполнено(СтрКода.ПолныйКод) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрКода.ТипУпаковки <> ТипыУпаковок.МаркированныйТовар Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрКода.ВидПродукции = ВидыПродукции.Молоко
			Или СтрКода.ВидПродукции = ВидыПродукции.Морепродукты Тогда
			ИдентификаторПрименения = ИдентификаторПрименения_ВесВКилограммах_3();
		ИначеЕсли СтрКода.ВидПродукции = ВидыПродукции.Пиво Тогда
			ИдентификаторПрименения = ИдентификаторПрименения_ОбъемВЛитрах_3();
		Иначе
			Продолжить; // В ТГ не предусмотрено количество в коде маркировки
		КонецЕсли;
		
		СтрКода.ПолныйКод = ДобавитьКоличествоВПолныйКод(СтрКода.ПолныйКод, СтрКода.Количество, ИдентификаторПрименения);
		
	КонецЦикла;
	
КонецПроцедуры

