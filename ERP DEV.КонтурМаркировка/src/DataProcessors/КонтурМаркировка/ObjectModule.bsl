Процедура Операция_ЗаполнитьТоварыОперацииПослеВызоваПМ(ОписаниеОперации)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипОперации = ОписаниеОперации.ТипОперации;
	
	Если ТипОперации = ТипыОпераций.ВыводИзОборота
		И Не ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет Тогда
		
		Операция_ДозаполнитьТЧ_ВыводИзОборота(ОписаниеОперации);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_СгруппироватьСтрокиТоваров(ОписаниеОперации, ТаблицаКодов) Экспорт
	
	Если Не НастройкиМодуля().ГруппироватьСтрокиТоваровОпераций
		Или Не Операция_ПоддерживаетГруппировкуСтрокТоваров(ОписаниеОперации.ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		Если ЗначениеЗаполнено(Стр.АльтернативныеСрокиГодности) Тогда
			Стр.АльтернативныеСрокиГодности = ЗначениеВСтрокуВнутр(Стр.АльтернативныеСрокиГодности);
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьКоличество = (ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().ОтчетОНанесении);
	
	Если ЗначениеЗаполнено(ОписаниеОперации.Ссылка) Тогда
		ИспользоватьНоминальноеКоличество = ОписаниеОперации.ДопРеквизиты.ИспользоватьНоминальноеКоличество;
	Иначе
		ИспользоватьНоминальноеКоличество =
		НастройкиМодуля().ИспользоватьНоминальноеКоличествоПоУмолчанию
		Или ОписаниеОперации.ДопРеквизиты.ИспользоватьНоминальноеКоличество;
	КонецЕсли;
	
	ТаблицаГруппировки = ОписаниеОперации.Товары.Скопировать();
	ТаблицаГруппировки.Колонки.Удалить("НомерСтроки");
	ТаблицаГруппировки.Колонки.Удалить("КлючСтрокиОперации");
	ТаблицаГруппировки.Колонки.Удалить("КлючСтрокиДокумента");
	ТаблицаГруппировки.Колонки.Удалить("КоличествоУпаковокВложенногоТовара");
	ТаблицаГруппировки.Колонки.Удалить("КоличествоУпаковок");
	ТаблицаГруппировки.Колонки.Удалить("Количество");
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаГруппировки);
	
	ОтборТовары = Новый Структура(СоединитьСтроку(ТаблицаЗначений_МассивКолонок(ТаблицаГруппировки), ", "));
	ОтборКоды = Новый Структура("КлючСтрокиОперации");
	
	ТаблицаГруппировки.Колонки.Добавить("СтрокиКодов", Новый ОписаниеТипов("Массив"));
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючСтрокиОперации");
	Для Каждого СтрГрупп Из ТаблицаГруппировки Цикл
		ЗаполнитьЗначенияСвойств(ОтборТовары, СтрГрупп);
		Для Каждого СтрТов Из ОписаниеОперации.Товары.НайтиСтроки(ОтборТовары) Цикл
			ОтборКоды.КлючСтрокиОперации = СтрТов.КлючСтрокиОперации;
			ДополнитьМассив(СтрГрупп.СтрокиКодов, ТаблицаКодов.НайтиСтроки(ОтборКоды));
		КонецЦикла;
	КонецЦикла;
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючСтрокиОперации");
	
	ОписаниеОперации.Товары.Очистить();
	
	КэшТоваров = Новый Соответствие;
	МаксКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ОписаниеОперации.ТипОперации);
	
	Для Каждого СтрГрупп Из ТаблицаГруппировки Цикл
		
		ОписаниеТовара = Товар_Прочитать(СтрГрупп.Товар, КэшТоваров);
		НоминальноеКоличество = ОписаниеТовара.ДопРеквизиты.НоминальноеКоличество;
		ТоварСПеременнойХарактеристикой = ВидПродукцииПоддерживаетКоличествоВСтруктуреКодаОтчетаОНанесении(ОписаниеТовара.ВидПродукции,
		ОписаниеОперации.ДопРеквизиты.ТипОтчетаОНанесении);
		
		Для Каждого ПорцияСтрокКодов Из РазбитьМассив(СтрГрупп.СтрокиКодов, МаксКодовВСтроке) Цикл
			
			СтрТов = ОписаниеОперации.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТов, СтрГрупп);
			СтрТов.КлючСтрокиОперации = Новый УникальныйИдентификатор;
			СтрТов.КоличествоУпаковок = ПорцияСтрокКодов.Количество();
			
			Если ЗначениеЗаполнено(СтрГрупп.АльтернативныеСрокиГодности) Тогда
				СтрТов.АльтернативныеСрокиГодности = ЗначениеИзСтрокиВнутр(СтрГрупп.АльтернативныеСрокиГодности);
			КонецЕсли;
			
			Для Каждого СтрКода Из ПорцияСтрокКодов Цикл
				
				СтрКода.КлючСтрокиОперации = СтрТов.КлючСтрокиОперации;
				
				Если ЗаполнитьКоличество Тогда
					Если ТоварСПеременнойХарактеристикой
						И ИспользоватьНоминальноеКоличество
						И Не ЗначениеЗаполнено(СтрКода.Количество) Тогда
						СтрТов.Количество = СтрТов.Количество + НоминальноеКоличество;
					Иначе
						СтрТов.Количество = СтрТов.Количество + СтрКода.Количество;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет шапку операции необходимыми данными
// в зависимости от её типа наличии документа учета
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция()
//
Процедура Операция_ЗаполнитьШапку(ОписаниеОперации)
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДокументУчета) Тогда
		Операция_ЗаполнитьШапку_ПоДокументуУчета(ОписаниеОперации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ОперацияОснование) Тогда
		Операция_ЗаполнитьШапку_ПоОснованию(ОписаниеОперации);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.Ответственный) Тогда
		ОписаниеОперации.Ответственный = ТекущийПользовательМаркировки();
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьШапку_ПоДокументуУчета(ОписаниеОперации)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипОперации = ОписаниеОперации.ТипОперации;
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ОписаниеОперации.ДокументУчета);
	
	ОписаниеОперации.Организация = ОписаниеДокумента.Организация;
	ОписаниеОперации.Склад = ОписаниеДокумента.Склад;
	
	Если ТипОперации = ТипыОпераций.СообщениеОбОтгрузке
		Или ТипОперации = ТипыОпераций.ОтчетОВыбытииНаТСД
		Или ТипОперации = ТипыОпераций.ПодборКодовНаТСД
		Или ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		
		ОписаниеОперации.ДопРеквизиты.НомерДокумента = ОписаниеДокумента.Номер;
		ОписаниеОперации.ДопРеквизиты.ДатаДокумента = ОписаниеДокумента.Дата;
		
		Если ЗначениеЗаполнено(ОписаниеДокумента.ДопРеквизиты.Контрагент1С) Тогда
			
			РеквизитыКонтрагента = Интеграция_РеквизитыКонтрагента1С(ОписаниеДокумента.ДопРеквизиты.Контрагент1С);
			
			Если ОписаниеОперации.ТипОперации = ТипыОпераций.СообщениеОбОтгрузке Тогда
				ОписаниеОперации.ДопРеквизиты.ИННПолучателя = РеквизитыКонтрагента.ИНН;
			Иначе
				ОписаниеОперации.ДопРеквизиты.КонтрагентНаименование = РеквизитыКонтрагента.Представление;
				ОписаниеОперации.ДопРеквизиты.КонтрагентИНН = РеквизитыКонтрагента.ИНН;
				ОписаниеОперации.ДопРеквизиты.КонтрагентКПП = РеквизитыКонтрагента.КПП;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.Ссылка) Тогда
		Операция_ЗаполнитьПризнакОСУ(ОписаниеОперации, ОписаниеДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьШапку_ПоОснованию(ОписаниеОперации)
	
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	РеквизитыОснования = ЗначенияРеквизитовОбъектаЛок(ОперацияОснование, "Организация, Склад, ВидПродукции, ТипОперации");
	ЗаполнитьЗначенияСвойств(ОписаниеОперации, РеквизитыОснования, "Организация, Склад, ВидПродукции");
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипОперации = ОписаниеОперации.ТипОперации;
	ТипОперацииОснования = РеквизитыОснования.ТипОперации;
	
	Если ТипОперацииОснования = ТипыОпераций.УведомлениеОСостоянииКодов Тогда
		
		Если ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
			Операция_ВыводИзОборота_ЗаполнитьШапку_ПоУведомлениюОбЭкспорте(ОписаниеОперации);
		КонецЕсли;
		
		Если ТипОперации = ТипыОпераций.УведомлениеОСостоянииКодов Тогда
			Операция_УведомлениеОСостоянииКодов_ЗаполнитьШапку_ПоУведомлениюОбЭкспорте(ОписаниеОперации);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипОперацииОснования = ТипыОпераций.ЗаказКодов Тогда
		
		Если ЭтоОтчетОНанесении(ТипОперации) Тогда
			Операция_ОтчетОНанесении_ЗаполнитьШапку_ПоЗаказуКодов(ОписаниеОперации);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПерезаполнитьТаблицыОперации(ОписаниеОперации, ТаблицаКодов) Экспорт
	
	Операция_ЗаполнитьТЧ(ОписаниеОперации, ТаблицаКодов);
	Операция_ЗаполнитьТЧЗначениямиПоУмолчанию(ОписаниеОперации);
	Операция_ЗаполнитьСрокГодности(ОписаниеОперации);
	Операция_ЗаполнитьАльтернативныеСрокиГодности(ОписаниеОперации);
	
	ПМ_ОбработатьСобытие_ПриИзмененииОперации(ОписаниеОперации, ТаблицаКодов);
	
	Операция_СгруппироватьСтрокиТоваров(ОписаниеОперации, ТаблицаКодов);
	
КонецПроцедуры

// Заполняет в операции товары и таблицу кодов
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция();
//  ТаблицаКодов - ТаблицаЗначений - см. Новый_ТаблицаКодов();
//
Процедура Операция_ЗаполнитьТЧ(ОписаниеОперации, ТаблицаКодов) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипОперации = ОписаниеОперации.ТипОперации;
	
	Если ТипОперации = ТипыОпераций.Перемаркировка Тогда
		
		Операция_ЗаполнитьТЧ_Перемаркировка(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
		
		Операция_ЗаполнитьТЧ_НаполнениеНаборовНаТСД(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.АгрегацияКодов
		Или ТипОперации = ТипыОпераций.ОтчетОВыбытииНаТСД
		Или ТипОперации = ТипыОпераций.ПодборКодовНаТСД
		Или ТипОперации = ТипыОпераций.ВозвратВОборотНаТСД Тогда
		
		Операция_ЗаполнитьТЧ_ПоДокументу(ОписаниеОперации);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ВводВОборот Тогда
		
		Операция_ЗаполнитьТЧ_ВводВОборот(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ОтчетОНанесении Тогда
		
		Операция_ЗаполнитьТЧ_ОтчетОНанесении(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД Тогда
		
		Операция_ЗаполнитьТЧ_ОтчетОНанесенииНаТСД(ОписаниеОперации)
		
	ИначеЕсли ТипОперации = ТипыОпераций.ЗаказКодов Тогда
		
		Операция_ЗаполнитьТЧ_ЗаказКодов(ОписаниеОперации);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		
		Операция_ЗаполнитьТЧ_ПодборТоваровИКодовНаТСД(ОписаниеОперации);
		
	ИначеЕсли ТипОперации = ТипыОпераций.РегистрацияАгрегатов Тогда
		
		Операция_ЗаполнитьТЧ_РегистрацияКИТУ(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.РасформированиеАгрегатов Тогда
		
		Операция_ЗаполнитьТЧ_РасформированиеКИТУ(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.СообщениеОбОтгрузке Тогда
		
		Если ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет Тогда
			Операция_ЗаполнитьТЧ_ОперацииПоОСУ(ОписаниеОперации);
		Иначе
			Операция_ЗаполнитьТЧ_СообщениеОбОтгрузке(ОписаниеОперации, ТаблицаКодов);
		КонецЕсли;
		
	ИначеЕсли ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		
		Если ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет Тогда
			Операция_ЗаполнитьТЧ_ОперацииПоОСУ(ОписаниеОперации);
		Иначе
			Операция_ЗаполнитьТЧ_ВыводИзОборота(ОписаниеОперации, ТаблицаКодов);
		КонецЕсли;
		
	ИначеЕсли ТипОперации = ТипыОпераций.ОтчетОВыбытии Тогда
		
		Операция_ЗаполнитьТЧ_ОтчетОВыбытии(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ФормированиеКИГУ Тогда
		
		Операция_ЗаполнитьТЧ_ФормированиеКИГУ(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.НаполнениеКИГУНаТСД Тогда
		
		Операция_ЗаполнитьТЧ_НаполнениеКИГУНаТСД(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.РегистрацияКИГУ Тогда
		
		Операция_ЗаполнитьТЧ_РегистрацияКИГу(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.ВозвратВОборот Тогда
		
		Операция_ЗаполнитьТЧ_ВозвратВОборот(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.ФормированиеАТК Тогда
		
		Операция_ЗаполнитьТЧ_ФормированиеАТК(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.РасформированиеАТК Тогда
		
		Операция_ЗаполнитьТЧ_РасформированиеАТК(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.РегистрацияНаборов Тогда
		
		Операция_ЗаполнитьТЧ_РегистрацияНаборов(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.КорректировкаСведенийОКодах Тогда
		
		Операция_ЗаполнитьТЧ_КорректировкаСведенийОКодах(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.РасформированиеНаборов Тогда
		
		Операция_ЗаполнитьТЧ_РасформированиеНаборов(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.УведомлениеОСостоянииКодов Тогда
		
		Операция_ЗаполнитьТЧ_УведомлениеОСостоянииКодов(ОписаниеОперации, ТаблицаКодов);
		
	ИначеЕсли ТипОперации = ТипыОпераций.РезервированиеПартий Тогда
		
		Операция_ЗаполнитьТЧ_РезервированиеПартий(ОписаниеОперации, ТаблицаКодов);
		
	Иначе
		// Операция без товаров и кодов
	КонецЕсли;
	
	Операция_ЗаполнитьТЧ_ЗаполнитьКлючиСтрок(ОписаниеОперации);
	Операция_ЗаполнитьТЧ_ЗаполнитьНомераСтрок(ОписаниеОперации);
	Операция_ЗаполнитьТЧ_ЗаполнитьАналитикуНоменклатуры(ОписаниеОперации);
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_УведомлениеОСостоянииКодов(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	Если Не ЗначениеЗаполнено(ДокументУчета)
		И Не ЗначениеЗаполнено(ОперацияОснование)
		И Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ПодходящиеСтатусыКодов = Операция_УведомлениеОСостоянииКодов_ПодходящиеСтатусыКодов();
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		КодыОпераций_ВТ_Прочитать(ОперацияОснование, МенеджерВТ);
	Иначе
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
			ТаблицаКодов = Новый_ТаблицаКодов();
		Иначе
			КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусыКодов);
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ВидПродукции = &ВидПродукции");
	Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	Пока Выборка.Следующий() Цикл
		
		СтрТовара = Неопределено;
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			Если Стр.Товар = Выборка.Товар
				И Стр.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С
				И Стр.КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента
				И Стр.КоличествоУпаковок < ДопустимоеКоличествоКодовВСтроке Тогда
				СтрТовара = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрТовара = Неопределено Тогда
			СтрТовара = ОписаниеОперации.Товары.Добавить();
			СтрТовара.КлючСтрокиОперации = Новый УникальныйИдентификатор;
			СтрТовара.КлючСтрокиДокумента = Выборка.КлючСтрокиДокумента;
			СтрТовара.КлючНоменклатуры1С = Выборка.КлючНоменклатуры1С;
			СтрТовара.Товар = Выборка.Товар;
		КонецЕсли;
		
		СтрТовара.КоличествоУпаковок = СтрТовара.КоличествоУпаковок + 1;
		
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ВыводИзОборота(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ПричинаВыводаИзОборота = ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота;
	ЕстьИННПолучателя = ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ИННПолучателя);
	ЗаполнитьЦену = ПричинаВыводаИзОборотаТребуетУказатьЦену(ПричинаВыводаИзОборота, ЕстьИННПолучателя);
	ПодходящиеСтатусы = Операция_ВыводИзОборота_ПодходящиеСтатусыКодов();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусы);
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ОписаниеОперации.ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.Товар КАК Товар,
	|	ТаблицаКодов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТоварыДокумента.Цена КАК Цена,
	|	ТоварыДокумента.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТаблицаКодов.КлючКода = КодыДокументов.КлючКода
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО (КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента)
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|ГДЕ
	|	ТаблицаКодов.ВидПродукции = &ВидПродукции
	|	И ТоварыДокумента.КлючСтрокиДокумента ЕСТЬ НЕ NULL 
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода,
	|	ТаблицаКодов.Товар,
	|	ТаблицаКодов.КлючНоменклатуры1С,
	|	0,
	|	&ПустойКлюч
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТаблицаКодов.КлючКода = КодыДокументов.КлючКода
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО (КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента)
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|ГДЕ
	|	ТаблицаКодов.ВидПродукции = &ВидПродукции
	|	И ТоварыДокумента.КлючСтрокиДокумента ЕСТЬ NULL");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ПустойКлюч", ПустойУникальныйИдентификатор());
	Запрос.УстановитьПараметр("ВидПродукции", ОписаниеОперации.ВидПродукции);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ПоляТоваров = "Товар, КлючНоменклатуры1С, КлючСтрокиДокумента";
	Если ЗаполнитьЦену Тогда
		ПоляТоваров = ПоляТоваров + ", Цена";
	КонецЕсли;
	Операция_ЗаполнитьТаблицуТоваров(ОписаниеОперации.Товары, ТаблицаЗапроса, ПоляТоваров);
	
	Отбор = Новый Структура(ПоляТоваров);
	ОписаниеОперации.Товары.Индексы.Добавить(ПоляТоваров);
	Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрЗапроса);
		СтрТовара = ОписаниеОперации.Товары.НайтиСтроки(Отбор)[0];
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = СтрЗапроса.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_РезервированиеПартий(ОписаниеОперации, ТаблицаКодов)
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ОперацияОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
	
	НомераПартий = ОписаниеОснования.Товары.Скопировать(, "НомерПартии, Товар, КлючНоменклатуры1С");
	ТаблицаЗначений_СвернутьПоВсемКолонкам(НомераПартий);
	
	Для Каждого СтрПарт Из НомераПартий Цикл
		
		СтрТов = ОписаниеОперации.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТов, СтрПарт);
		
		Если Не ЗначениеЗаполнено(СтрТов.НомерПартии) Тогда
			СтрТов.НомерПартии = ОписаниеОснования.ДопРеквизиты.НомерПартии;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ОперацииПоОСУ(ОписаниеОперации)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ВидыПродукции = ЗначениеВМассиве(ОписаниеОперации.ВидПродукции);
	ИначеЕсли ТипОперации = ТипыОпераций.ВыводИзОборота Тогда
		ВидыПродукции = ДопустимыеВидыПродукцииДляВыводаИзОборотаОСУ();
	ИначеЕсли ТипОперации = ТипыОпераций.СообщениеОбОтгрузке Тогда
		ВидыПродукции = ДопустимыеВидыПродукцииДляСообщенияОбОтгрузкеПоОСУ();
	Иначе
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыОпераций.Товар КАК Товар,
	|	ТоварыОпераций.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	СУММА(ТоварыОпераций.КоличествоУпаковок) КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ТоварыДругихОпераций
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции.Товары КАК ТоварыОпераций
	|		ПО Операции.Ссылка = ТоварыОпераций.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ОбъемноСортовойУчет
	|		ПО Операции.Ссылка = ОбъемноСортовойУчет.Объект
	|			И (ОбъемноСортовойУчет.ИмяРеквизита = &ОбъемноСортовойУчет)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК ОсновнойСтатус
	|		ПО Операции.Ссылка = ОсновнойСтатус.Операция
	|			И (ОсновнойСтатус.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	Операции.Ссылка <> &ТекущаяОперация
	|	И Операции.ТипОперации = &ТипОперации
	|	И Операции.ДокументУчета = &ДокументУчета
	|	И ОсновнойСтатус.Статус <> &ОперацияОтменена
	|	И ОбъемноСортовойУчет.Значение = ИСТИНА
	|	И ТоварыОпераций.Товар.ВидПродукции В(&ВидыПродукцииПоОСУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыОпераций.Товар,
	|	ТоварыОпераций.КлючНоменклатуры1С
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Товар,
	|	КлючНоменклатуры1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыМаркировки.Товар КАК Товар,
	|	ТоварыМаркировки.НомерПартии Как НомерПартии,
	|	ТоварыДокумента.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ТоварыДокумента.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	СУММА(ТоварыМаркировки.КоличествоУпаковок) - МАКСИМУМ(ЕСТЬNULL(ТоварыДругихОпераций.КоличествоУпаковок, 0)) КАК КоличествоУпаковок
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК ТоварыМаркировки
	|		ПО ТоварыДокумента.КлючСтрокиДокумента = ТоварыМаркировки.КлючСтрокиДокумента
	|			И (ТоварыМаркировки.Ссылка = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыДругихОпераций КАК ТоварыДругихОпераций
	|		ПО ТоварыДокумента.КлючНоменклатуры1С = ТоварыДругихОпераций.КлючНоменклатуры1С
	|			И (ТоварыМаркировки.Товар = ТоварыДругихОпераций.Товар)
	|ГДЕ
	|	ТоварыДокумента.Ссылка = &ДокументУчета
	|	И ТоварыДокумента.НеПодлежитМаркировке = ЛОЖЬ
	|	И ТоварыМаркировки.Товар.ВидПродукции В(&ВидыПродукцииПоОСУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыМаркировки.Товар,
	|	ТоварыДокумента.КлючНоменклатуры1С,
	|	ТоварыДокумента.КлючСтрокиДокумента,
	|	ТоварыМаркировки.НомерПартии
	|
	|ИМЕЮЩИЕ
	|	СУММА(ТоварыМаркировки.КоличествоУпаковок) - МАКСИМУМ(ЕСТЬNULL(ТоварыДругихОпераций.КоличествоУпаковок, 0)) > 0");
	Запрос.УстановитьПараметр("ТипОперации", ТипОперации);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ТекущаяОперация", Операция);
	Запрос.УстановитьПараметр("ОсновнойСтатус", "ОсновнойСтатус");
	Запрос.УстановитьПараметр("ОбъемноСортовойУчет", "ОбъемноСортовойУчет");
	Запрос.УстановитьПараметр("ОперацияОтменена", Перечисление_СтатусыОпераций().ОперацияОтменена);
	Запрос.УстановитьПараметр("ВидыПродукцииПоОСУ", ВидыПродукции);
	
	ОписаниеОперации.Товары.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрТовара = ОписаниеОперации.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТовара, Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ПоДокументу(ОписаниеОперации)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	ПравилаОтраженияВЭДО = Перечисление_ПравилаОтраженияВЭДО();
	ОтраженияВЭДО = Перечисление_ОтраженияВЭДО();
	
	ОтражениеВЭДО = ОписаниеОперации.ДопРеквизиты.ОтражениеВЭДО;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	ОписаниеОперации.Товары.Очистить();
	Для каждого СтрТов Из ОписаниеДокумента.ТоварыМаркировки Цикл
		
		Если СтрТов.КоличествоУпаковок = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидПродукции)
			И ВидПродукции <> СтрТов.Товар.ВидПродукции Тогда
			Продолжить;
		КонецЕсли;
		
		СтрДок = ОписаниеДокумента.ТоварыДокумента.Найти(СтрТов.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		Если СтрДок = Неопределено
			Или СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОтражениеВЭДО = ОтраженияВЭДО.ПУ
			И СтрДок.ОтражениеВЭДО <> ПравилаОтраженияВЭДО.ПУ Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОтражениеВЭДО = ОтраженияВЭДО.ОСУ
			И СтрДок.ОтражениеВЭДО <> ПравилаОтраженияВЭДО.ОСУ Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОтражениеВЭДО = ОтраженияВЭДО.ОСУПУ
			И СтрДок.ОтражениеВЭДО <> ПравилаОтраженияВЭДО.ПУ
			И СтрДок.ОтражениеВЭДО <> ПравилаОтраженияВЭДО.ОСУ Тогда
			Продолжить;
		КонецЕсли;
		
		Стр = ОписаниеОперации.Товары.Добавить();
		Стр.Товар = СтрТов.Товар;
		Стр.КлючНоменклатуры1С = СтрДок.КлючНоменклатуры1С;
		Стр.КоличествоУпаковок = СтрТов.КоличествоУпаковок;
		Стр.КлючСтрокиДокумента = СтрТов.КлючСтрокиДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ПодборТоваровИКодовНаТСД(ОписаниеОперации)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	
	ОписаниеОперации.Товары.Очистить();
	Для Каждого СтрДок Из ТоварыДокумента Цикл
		
		Если СтрДок.КоличествоУпаковок = 0
			Или СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		Стр = ОписаниеОперации.Товары.Добавить();
		Стр.КоличествоУпаковок = СтрДок.КоличествоУпаковок;
		Стр.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		Стр.КлючНоменклатуры1С = СтрДок.КлючНоменклатуры1С;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ЗаказКодов(ОписаниеОперации)
	
	// BSLLS:CognitiveComplexity-off
	// BSLLS:CyclomaticComplexity-off
	
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ТипЗаказаКодов = ДопРеквизиты.ТипЗаказаКодов;
	ТипКодаМаркировки = ДопРеквизиты.ТипКодаМаркировки;
	СпособВыпускаТоваров = ДопРеквизиты.СпособВыпускаТоваров;
	
	Если ЗначениеЗаполнено(ТипЗаказаКодов) Тогда
		ТребуемыеКоды = Операция_ТребуемыеКодыПоКодуМаркировки(ОписаниеОперации);
	ИначеЕсли ЗначениеЗаполнено(ДокументУчета) Тогда
		ТребуемыеКоды = Операция_ЗаказКодов_ТребуемыеКодыПоДокументуУчета(ОписаниеОперации);
	Иначе
		Возврат;
	КонецЕсли;
	
	ОписаниеОперации.Товары.Очистить();
	Для каждого СтрТреб Из ТребуемыеКоды Цикл
		
		МожноЗаказывать = Истина;
		
		Если ЗначениеЗаполнено(СтрТреб.Товар) Тогда
			
			Если СпособВыпускаТоваров = СпособыВыпуска.Остатки Тогда
				МожноЗаказывать = ТоварДопускаетЗаказКодовНаОстатки(СтрТреб.Товар);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВидПродукции)
				И СтрТреб.Товар.ВидПродукции <> ВидПродукции Тогда
				МожноЗаказывать = Ложь;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТипКодаМаркировки)
				И СтрТреб.Товар.ТипКодаМаркировки <> ТипКодаМаркировки Тогда
				МожноЗаказывать = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
		Если МожноЗаказывать Тогда
			
			СтрТов = ОписаниеОперации.Товары.Добавить();
			СтрТов.Товар = СтрТреб.Товар;
			СтрТов.КлючНоменклатуры1С = СтрТреб.КлючНоменклатуры1С;
			СтрТов.КоличествоУпаковок = СтрТреб.КоличествоКодовТребуется;
			СтрТов.КлючСтрокиДокумента = СтрТреб.НовыйКлючСтрокиДокумента;
			
			Если СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка Тогда
				СтрТов.КодТНВЭД = СтрТов.Товар.КодТНВЭД;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// BSLLS:CyclomaticComplexity-on
	// BSLLS:CognitiveComplexity-on
	
КонецПроцедуры

Функция Операция_ЗаказКодов_ТребуемыеКодыПоДокументуУчета(ОписаниеОперации)
	
	Результат = Новый_ТребуемыеКоды();
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ДокументУчета_ТребуемыеКоды(ДокументУчета);
	Результат.Свернуть("Товар, КлючНоменклатуры1С, НовыйКлючСтрокиДокумента", "КоличествоКодовТребуется");
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_ЗаполнитьТЧ_ВводВОборот(ОписаниеОперации, ТаблицаКодов)
	
	// BSLLS:CyclomaticComplexity-off
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	СпособВводаВОборот = ОписаниеОперации.ДопРеквизиты.СпособВводаВОборот;
	ПричинаВводаВОборот = ОписаниеОперации.ДопРеквизиты.ПричинаВводаВОборот;
	ПодходящиеСтатусы = Операция_ВводВОборот_ПодходящиеСтатусыКодов();
	ПодходящиеОсобыеСостояние = Операция_ВводВОборот_ПодходящиеОсобыеСостояниеКодов();
	
	Настройки = НастройкиМодуля();
	Если Не ЗначениеЗаполнено(СпособВводаВОборот) Тогда
		СпособВводаВОборот = Настройки.СпособВводаВОборотПоУмолчанию;
	КонецЕсли;
	
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		КодыОпераций_ВТ_Прочитать(ОперацияОснование, МенеджерВТ);
	Иначе
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
			ТаблицаКодов = Новый_ТаблицаКодов();
		Иначе
			КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
		КонецЕсли;
	КонецЕсли;
	
	Если Настройки.ВводитьВОборотВложенныеКодыАгрегатов Тогда
		ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ);
	КонецЕсли;
	
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_ДобавитьКоличествоВложенныхКодов(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусы);
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ОписаниеОперации.ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	РазрешительнаяДокументация = Неопределено;
	Если ВидПродукцииДопускаетУказаниеРазрешительнойДокументации(ОписаниеОперации.ВидПродукции) Тогда
		РазрешительнаяДокументация = ТаблицаКодов_ВТ_РазрешительнаяДокументация(МенеджерВТ);
	КонецЕсли;
	
	ПодходящиеТовары = Операция_ЗаполнитьТЧ_ВводВОборот_ПодходящиеТовары(МенеджерВТ, ОписаниеОперации.ВидПродукции, СпособВводаВОборот);
	
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.Товар КАК Товар,
	|	ТаблицаКодов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТаблицаКодов.ИдентификаторВСД КАК ИдентификаторВСД,
	|	ТаблицаКодов.ДатаПроизводства КАК ДатаПроизводства,
	|	ТаблицаКодов.ОбщийТипУпаковки КАК ОбщийТипУпаковки,
	|	ТаблицаКодов.КоличествоВложенныхКодов КАК КоличествоВложенныхКодов,
	|	ТаблицаКодов.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|ГДЕ
	|	ТаблицаКодов.ТипУпаковки = &ТипУпаковки
	|	И ТаблицаКодов.ВидПродукции = &ВидПродукции
	|	И &УсловиеСпособВыпускаТоваров
	|	И &УсловиеОсобоеСостояниеКода
	|	И &УсловиеТовары
	|	И &УсловиеАТК";
	
	Если ЗначениеЗаполнено(ПодходящиеТовары) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеТовары", "ТаблицаКодов.Товар В (&ПодходящиеТовары)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеТовары", "ИСТИНА");
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеАТК", "ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеАТК", "ТаблицаКодов.ОбщийТипУпаковки <> &АТК");
	КонецЕсли;
	
	СпособВыпускаТоваров = "";
	Если СпособВводаВОборот = СпособыВвода.СПричиной
		И ПричинаВводаВОборот = Перечисление_ПричиныВводаВОборот().Разукомплектация Тогда
		СпособВыпускаТоваров = Перечисление_СпособыВыпускаТоваров().МаркировкаВнеПроизводстваИлиИмпорта;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСпособВыпускаТоваров", "ТаблицаКодов.СпособВыпускаТоваров = &СпособВыпускаТоваров");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОсобоеСостояниеКода", "ТаблицаКодов.ОсобоеСостояниеКода В(&ПодходящиеОсобыеСостояние)");
		ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар;
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСпособВыпускаТоваров", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОсобоеСостояниеКода", "ИСТИНА");
		ТипУпаковки = ТаблицаКодов_ВТ_ПервыйТипУпаковки(МенеджерВТ, ПодходящиеТовары, ОписаниеОперации.ВидПродукции);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТипУпаковки", ТипУпаковки);
	Запрос.УстановитьПараметр("АТК", ОбщиеТипыУпаковок.АТК);
	Запрос.УстановитьПараметр("ПодходящиеТовары", ПодходящиеТовары);
	Запрос.УстановитьПараметр("СпособВыпускаТоваров", СпособВыпускаТоваров);
	Запрос.УстановитьПараметр("ВидПродукции", ОписаниеОперации.ВидПродукции);
	Запрос.УстановитьПараметр("ПодходящиеОсобыеСостояние", ПодходящиеОсобыеСостояние);
	
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	ОписаниеОперации.Товары.Очистить();
	ОписаниеОперации.Товары.Колонки.Добавить("КоличествоВложенныхКодов", ОписаниеТипа_Число());
	
	ОтборТовары = Новый Структура("Товар, КлючНоменклатуры1С, ИдентификаторВСД, ДатаПроизводства, КлючСтрокиДокумента");
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	
	Пока Выборка.Следующий() Цикл
		
		СтрТов = Неопределено;
		ЗаполнитьЗначенияСвойств(ОтборТовары, Выборка);
		Для Каждого Стр Из ОписаниеОперации.Товары.НайтиСтроки(ОтборТовары) Цикл
			КоличествоКодовВВыборке = 1;
			КоличествоКодовВСтроке = Стр.КоличествоУпаковок;
			Если Выборка.ОбщийТипУпаковки = ОбщиеТипыУпаковок.Набор
				Или Выборка.ОбщийТипУпаковки = ОбщиеТипыУпаковок.АТК
				Или Выборка.ОбщийТипУпаковки = ОбщиеТипыУпаковок.ГрупповаяУпаковка
				Или Выборка.ОбщийТипУпаковки = ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
				КоличествоКодовВВыборке = КоличествоКодовВВыборке + Выборка.КоличествоВложенныхКодов;
				КоличествоКодовВСтроке = КоличествоКодовВСтроке + Стр.КоличествоВложенныхКодов;
			КонецЕсли;
			Если (КоличествоКодовВСтроке + КоличествоКодовВВыборке) <= ДопустимоеКоличествоКодовВСтроке Тогда
				СтрТов = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрТов = Неопределено Тогда
			СтрТов = ОписаниеОперации.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТов, ОтборТовары);
			СтрТов.КлючСтрокиОперации = Новый УникальныйИдентификатор;
			Если ЗначениеЗаполнено(РазрешительнаяДокументация) Тогда
				СтрТов.РазрешительныйДокумент = РазрешительнаяДокументация[СтрТов.Товар];
			КонецЕсли;
		КонецЕсли;
		
		СтрТов.КоличествоУпаковок = СтрТов.КоличествоУпаковок + 1;
		СтрТов.КоличествоВложенныхКодов = СтрТов.КоличествоВложенныхКодов + Выборка.КоличествоВложенныхКодов;
		
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТов.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТов.КлючСтрокиДокумента;
		
	КонецЦикла;
	
	ОписаниеОперации.Товары.Колонки.Удалить("КоличествоВложенныхКодов");
	
	// BSLLS:CyclomaticComplexity-on
	
КонецПроцедуры

Функция Операция_ЗаполнитьТЧ_ВводВОборот_ПодходящиеТовары(МенеджерВТ, ВидПродукции, СпособВводаВОборот)
	
	Результат = Новый Массив;
	
	Операция_ВводВОборот_ДобавитьПодходящиеТовары_Легпром(Результат, МенеджерВТ, ВидПродукции, СпособВводаВОборот);
	Операция_ВводВОборот_ДобавитьПодходящиеТовары_Бакалея(Результат, МенеджерВТ, ВидПродукции, СпособВводаВОборот);
	Операция_ВводВОборот_ДобавитьПодходящиеТовары_Косметика(Результат, МенеджерВТ, ВидПродукции, СпособВводаВОборот);
	Операция_ВводВОборот_ДобавитьПодходящиеТовары_Бады(Результат, МенеджерВТ, ВидПродукции, СпособВводаВОборот);
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_ВводВОборот_ДобавитьПодходящиеТовары_Легпром(ПодходящиеТовары, МенеджерВТ, ВидПродукции, СпособВводаВОборот)
	
	Если ВидПродукции <> Перечисление_ВидыПродукции().Легпром Тогда
		Возврат;
	КонецЕсли;
	
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ФичаФлаги = Перечисление_ФичаФлаги();
	ГруппаПлатности4 = 4;
	
	Если СпособВводаВОборот = СпособыВвода.Остатки Тогда
		Если ФичаФлагВключен(ФичаФлаги.ОстаткиЛегпромВолна4) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности4, ВидПродукции));
		КонецЕсли;
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.Импорт Тогда
		Если ФичаФлагВключен(ФичаФлаги.ИмпортЛегпромВолна4) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности4, ВидПродукции));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ВводВОборот_ДобавитьПодходящиеТовары_Бакалея(ПодходящиеТовары, МенеджерВТ, ВидПродукции, СпособВводаВОборот)
	
	Если ВидПродукции <> Перечисление_ВидыПродукции().Бакалея Тогда
		Возврат;
	КонецЕсли;
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ГруппаПлатности = 2;
	
	Если СпособВводаВОборот = СпособыВвода.Импорт Тогда
		Если ФичаФлагВключен(ФичаФлаги.ИмпортБакалеяВолна2) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности, ВидПродукции));
		КонецЕсли;
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		Исключения = Новый Массив;
		Если Не ФичаФлагВключен(ФичаФлаги.ИмпортФТСБакалеяВолна2) Тогда
			ДополнитьМассив(Исключения, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности, ВидПродукции));
		КонецЕсли;
		ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыБезИсключений(МенеджерВТ, Исключения, ВидПродукции));
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ВводВОборот_ДобавитьПодходящиеТовары_Косметика(ПодходящиеТовары, МенеджерВТ, ВидПродукции, СпособВводаВОборот)
	
	Если ВидПродукции <> Перечисление_ВидыПродукции().Косметика Тогда
		Возврат;
	КонецЕсли;
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ГруппаПлатности_2 = 2;
	ГруппаПлатности_3 = 3;
	ГруппаПлатности_4 = 4;
	
	Результат = Новый Массив;
	
	Если СпособВводаВОборот = СпособыВвода.Импорт Тогда
		Если ФичаФлагВключен(ФичаФлаги.ИмпортКосметикаВолна2) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_2, ВидПродукции));
		КонецЕсли;
		Если ФичаФлагВключен(ФичаФлаги.ИмпортКосметикаВолна3) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_3, ВидПродукции));
		КонецЕсли;
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		Исключения = Новый Массив;
		Если Не ФичаФлагВключен(ФичаФлаги.ИмпортФТСКосметикаВолна2) Тогда
			ДополнитьМассив(Исключения, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_2, ВидПродукции));
		КонецЕсли;
		Если Не ФичаФлагВключен(ФичаФлаги.ИмпортФТСКосметикаВолна3) Тогда
			ДополнитьМассив(Исключения, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_3, ВидПродукции));
		КонецЕсли;
		ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыБезИсключений(МенеджерВТ, Исключения, ВидПродукции));
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.Остатки Тогда
		Если ФичаФлагВключен(ФичаФлаги.ОстаткиВводВОборотКосметикаВолна4) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_4, ВидПродукции));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ВводВОборот_ДобавитьПодходящиеТовары_Бады(ПодходящиеТовары, МенеджерВТ, ВидПродукции, СпособВводаВОборот)
	
	Если ВидПродукции <> Перечисление_ВидыПродукции().Бады Тогда
		Возврат;
	КонецЕсли;
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ГруппаПлатности_3 = 3;
	
	Результат = Новый Массив;
	
	Если СпособВводаВОборот = СпособыВвода.Остатки Тогда
		Если ФичаФлагВключен(ФичаФлаги.ОстаткиВводВОборотБадыВолна3) Тогда
			ДополнитьМассив(ПодходящиеТовары, ТаблицаКодов_ВТ_ТоварыГруппыПлатности(МенеджерВТ, ГруппаПлатности_3, ВидПродукции));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_НаполнениеНаборовНаТСД(ОписаниеОперации, ТаблицаКодов)
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	ПодходящиеСтатусы = Операция_НаполнениеНаборовНаТСД_ПодходящиеСтатусыКодов();
	ТипыНаборов = Перечисление_ТипыНаборов();
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
			ТаблицаКодов = Новый_ТаблицаКодов();
		Иначе
			КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
		КонецЕсли;
	Иначе
		КодыОпераций_ВТ_Прочитать(ОперацияОснование, МенеджерВТ);
	КонецЕсли;
	
	ТаблицаКодов_ВТ_УдалитьКодыСВложеннымиКодами(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета, ОперацияОснование);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусы);
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ОписаниеОперации.ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ТипНабора) Тогда
		ОписаниеОперации.ДопРеквизиты.ТипНабора = ТаблицаКодов_ВТ_ПервыйТипНабора(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ОбщийТипУпаковки = &Набор
	|	И Т.ВидПродукции = &ВидПродукции
	|	И &ТипУпаковки";
	
	ПодходящиеТипыУпаковок = Новый Массив;
	Если ОписаниеОперации.ДопРеквизиты.ТипНабора = ТипыНаборов.Мультитоварный Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипУпаковки", "Т.ТипУпаковки В (&ПодходящиеТипыУпаковок)");
		ПодходящиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ТипыУпаковок.МультитоварнаяУпаковка);
	ИначеЕсли ОписаниеОперации.ДопРеквизиты.ТипНабора = ТипыНаборов.Монотоварный Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипУпаковки", "Т.ТипУпаковки В (&ПодходящиеТипыУпаковок)");
		ПодходящиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка);
		ПодходящиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипУпаковки", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.УстановитьПараметр("ВидПродукции", ОписаниеОперации.ВидПродукции);
	Запрос.УстановитьПараметр("Набор", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор);
	Запрос.УстановитьПараметр("ПодходящиеТипыУпаковок", ПодходящиеТипыУпаковок);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ПоляТоваров = "Товар, КлючНоменклатуры1С, КлючСтрокиДокумента";
	Операция_ЗаполнитьТаблицуТоваров(ОписаниеОперации.Товары, ТаблицаЗапроса, ПоляТоваров);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Стр.КодТНВЭД = Стр.Товар.КодТНВЭД;
	КонецЦикла;
	
	Отбор = Новый Структура(ПоляТоваров);
	ОписаниеОперации.Товары.Индексы.Добавить(ПоляТоваров);
	Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрЗапроса);
		СтрТовара = ОписаниеОперации.Товары.НайтиСтроки(Отбор)[0];
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = СтрЗапроса.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
		СтрКода.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ОтчетОНанесении(ОписаниеОперации, ТаблицаКодов)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ВидыПродукции = Перечисление_ВидыПродукции();
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	СервисыПодписок = Перечисление_СервисыПодписок();
	ПодходящиеСтатусы = Операция_ОтчетОНанесении_ПодходящиеСтатусыКодов();
	
	Операция = ОписаниеОперации.Ссылка;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ОписаниеТарифа = Тариф(Организация);
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		КодыОпераций_ВТ_Прочитать(ОперацияОснование, МенеджерВТ);
	Иначе
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
			ТаблицаКодов = Новый_ТаблицаКодов();
		Иначе
			КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ);
	ТаблицаКодов_ВТ_ДобавитьВложенныеКодыГрупповыхУпаковок(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусы);
	ТаблицаКодов_ВТ_ПодобратьКодыПоТипуОтчета(МенеджерВТ, ДопРеквизиты.ТипОтчетаОНанесении, ДопРеквизиты.КлючКода);
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ОписаниеОперации.ВидПродукции = ТаблицаКодов_ВТ_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	ТипСрокаГодности = ДопРеквизиты.ТипСрокаГодности;
	Если Не ЗначениеЗаполнено(ТипСрокаГодности) И ВидПродукцииТребуетУказатьТипСрокаГодности(ОписаниеОперации.ВидПродукции) Тогда
		ТипСрокаГодности = ТаблицаКодов_ВТ_ПервыйТипСрокаГодности(МенеджерВТ);
	КонецЕсли;
	
	ИспользоватьНоминальноеКоличество = ДопРеквизиты.ИспользоватьНоминальноеКоличество;
	Если Не ИспользоватьНоминальноеКоличество И Не ЗначениеЗаполнено(Операция) Тогда
		ИспользоватьНоминальноеКоличество = НастройкиМодуля().ИспользоватьНоминальноеКоличествоПоУмолчанию;
	КонецЕсли;
	
	ПодходящиеСпособыВыпуска = Новый Массив;
	Если Не ОперацияДоступнаПоТарифу(ТипыОпераций.ОтчетОНанесении, ОписаниеТарифа)
		И СервисДоступенПоТарифу(СервисыПодписок.Перемаркировка, ОписаниеТарифа) Тогда
		ПодходящиеСпособыВыпуска.Добавить(СпособыВыпуска.Перемаркировка);
		ПодходящиеСпособыВыпуска.Добавить(СпособыВыпуска.МаркировкаВнеПроизводстваИлиИмпорта);
	КонецЕсли;
	
	ПодходящиеОбщиеТипыУпаковок = Новый Массив;
	ПодходящиеОбщиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ГрупповаяУпаковка);
	ПодходящиеОбщиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара);
	ПодходящиеОбщиеТипыУпаковок.Добавить(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	Т.Товар КАК Товар,
	|	ВЫБОР
	|		КОГДА Т.Товар.ТипКодаМаркировки = &ЕдиницаТовара
	|			ТОГДА МАКСИМУМ(Т.НомерПартии)
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерПартии
	|ПОМЕСТИТЬ НомераПартий
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК Т
	|ГДЕ
	|	Т.Ссылка = &ДокументУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючСтрокиДокумента,
	|	Т.Товар,
	|	Т.Товар.ТипКодаМаркировки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтрокиДокумента,
	|	Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.Товар КАК Товар,
	|	ТаблицаКодов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТаблицаКодов.ДатаСрокаГодности КАК ДатаСрокаГодности,
	|	ТаблицаКодов.ДатаПроизводства КАК ДатаПроизводства,
	|	ТаблицаКодов.Количество КАК Количество,
	|	ТаблицаКодов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ЕСТЬNULL(НомераПартий.НомерПартии, """") КАК НомерПартии,
	|	ВЫБОР
	|		КОГДА ТаблицаКодов.СпособВыпускаТоваров = &ПроизводствоРФ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоПроизводствоРФ
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ НомераПартий КАК НомераПартий
	|		ПО ТаблицаКодов.КлючСтрокиДокумента = НомераПартий.КлючСтрокиДокумента
	|			И ТаблицаКодов.Товар = НомераПартий.Товар
	|ГДЕ
	|	ТаблицаКодов.ОбщийТипУпаковки В(&ПодходящиеОбщиеТипыУпаковок)
	|	И ТаблицаКодов.ВидПродукции = &ВидПродукции
	|	И &ТипСрокаГодности
	|	И &СпособВыпускаТовара";
	
	Если ЗначениеЗаполнено(ТипСрокаГодности) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипСрокаГодности", "ТаблицаКодов.Товар.ТипСрокаГодности = &ТипСрокаГодности");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипСрокаГодности", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодходящиеСпособыВыпуска) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СпособВыпускаТовара", "ТаблицаКодов.СпособВыпускаТоваров В(&ПодходящиеСпособыВыпуска)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СпособВыпускаТовара", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ТипСрокаГодности", ТипСрокаГодности);
	Запрос.УстановитьПараметр("ВидПродукции", ОписаниеОперации.ВидПродукции);
	Запрос.УстановитьПараметр("ПроизводствоРФ", СпособыВыпуска.ПроизводствоРФ);
	Запрос.УстановитьПараметр("ПодходящиеСпособыВыпуска", ПодходящиеСпособыВыпуска);
	Запрос.УстановитьПараметр("ПодходящиеОбщиеТипыУпаковок", ПодходящиеОбщиеТипыУпаковок);
	Запрос.УстановитьПараметр("ЕдиницаТовара", Перечисления.КонтурМаркировка_ТипыКодовМаркировки.ЕдиницаТовара);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	КэшТоваров = Новый Соответствие;
	МодульОбщегоНазначения = МодульОбщегоНазначения();
	ДопустимоеКоличествоКодовВСтроке = Операция_ДопустимоеКоличествоКодов(ТипОперации);
	ПоляТоваров = "Товар, КлючНоменклатуры1С, ДатаСрокаГодности, ДатаПроизводства, КлючСтрокиДокумента, НомерПартии, ЭтоПроизводствоРФ";
	
	ОписаниеОперации.Товары.Очистить();
	Для каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаЗапроса, ПоляТоваров, ДопустимоеКоличествоКодовВСтроке) Цикл
		
		ОписаниеТовара = Товар_Прочитать(ЧастьТаблицы.Товар, КэшТоваров);
		НоминальноеКоличество = ОписаниеТовара.ДопРеквизиты.НоминальноеКоличество;
		ТоварСПеременнойХарактеристикой = ВидПродукцииПоддерживаетКоличествоВСтруктуреКодаОтчетаОНанесении(ОписаниеТовара.ВидПродукции
		, ДопРеквизиты.ТипОтчетаОНанесении);
		
		СтрТов = ОписаниеОперации.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрТов, ЧастьТаблицы);
		СтрТов.КлючСтрокиОперации = МодульОбщегоНазначения.НовыйУникальныйИдентификаторПервойВерсии();
		
		Количество = 0;
		Для каждого СтрЗапроса Из ЧастьТаблицы.МассивСтрок Цикл
			
			СтрКода = ТаблицаКодов.Добавить();
			СтрКода.КлючКода = СтрЗапроса.КлючКода;
			СтрКода.Количество = СтрЗапроса.Количество;
			СтрКода.КлючСтрокиОперации = СтрТов.КлючСтрокиОперации;
			СтрКода.КлючСтрокиДокумента = СтрТов.КлючСтрокиДокумента;
			
			Если ТоварСПеременнойХарактеристикой
				И ИспользоватьНоминальноеКоличество
				И Не ЗначениеЗаполнено(СтрЗапроса.Количество) Тогда
				Количество = Количество + НоминальноеКоличество;
			Иначе
				Количество = Количество + СтрЗапроса.Количество;
			КонецЕсли;
			
		КонецЦикла;
		
		СтрТов.Количество = Количество;
		СтрТов.КоличествоУпаковок = ЧастьТаблицы.МассивСтрок.Количество();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_ОтчетОНанесенииНаТСД(ОписаниеОперации)
	
	Если ЭтоТипОтчетаОНанесенииПоУмолчанию(ОписаниеОперации.ДопРеквизиты.ТипОтчетаОНанесении) Тогда
		ДокументУчета = ОписаниеОперации.ДокументУчета;
		ТребуемыеКоды = Операция_ОтчетОНанесенииНаТСД_ТребуемыеКодыПоДокументуУчета(ДокументУчета);
	Иначе
		ТребуемыеКоды = Операция_ТребуемыеКодыПоКодуМаркировки(ОписаниеОперации);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТребуемыеКоды) Тогда
		Возврат;
	КонецЕсли;
	
	КэшТоваров = Новый Соответствие;
	
	ОписаниеОперации.Товары.Очистить();
	Для каждого СтрТребуется Из ТребуемыеКоды Цикл
		
		ОписаниеТовара = Товар_Прочитать(СтрТребуется.Товар, КэшТоваров);
		
		Стр = ОписаниеОперации.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, СтрТребуется);
		Стр.КоличествоУпаковок = СтрТребуется.КоличествоКодовТребуется;
		
		Если ОписаниеТовара.ПеременныйВес И ВидПродукцииПоддерживаетНоминальноеКоличество(ОписаниеТовара.ВидПродукции) Тогда
			Стр.Количество = ОписаниеТовара.ДопРеквизиты.НоминальноеКоличество * СтрТребуется.КоличествоКодовТребуется;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Операция_ОтчетОНанесенииНаТСД_ТребуемыеКодыПоДокументуУчета(ДокументУчета)
	
	Результат = Новый_ТребуемыеКоды();
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеДокумента = ДокументУчета_Прочитать(ДокументУчета);
	
	Для Каждого СтрТов Из ОписаниеДокумента.ТоварыМаркировки Цикл
		
		Если СтрТов.КоличествоУпаковок = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрДок = ОписаниеДокумента.ТоварыДокумента.Найти(СтрТов.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		Если СтрДок = Неопределено
			Или СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		Стр = Результат.Добавить();
		Стр.Товар = СтрТов.Товар;
		Стр.КлючНоменклатуры1С = СтрДок.КлючНоменклатуры1С;
		Стр.КлючСтрокиДокумента = СтрТов.КлючСтрокиДокумента;
		Стр.КоличествоКодовТребуется = СтрТов.КоличествоУпаковок;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_ЗаполнитьТЧ_СообщениеОбОтгрузке(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ПодходящиеСтатусы = Операция_СообщениеОбОтгрузке_ПодходящиеСтатусыКодов();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
		ТаблицаКодов = Новый_ТаблицаКодов();
	Иначе
		КодыДокументов_ВТ_Прочитать(ДокументУчета, МенеджерВТ);
	КонецЕсли;
	
	ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперации, Операция, ДокументУчета);
	ТаблицаКодов_ВТ_ПрочитатьВсюИнформациюОКодах(МенеджерВТ);
	ТаблицаКодов_ВТ_УдалитьКодыДляВнутреннегоУчета(МенеджерВТ, Организация);
	ТаблицаКодов_ВТ_УдалитьКодыДругихСтатусов(МенеджерВТ, ПодходящиеСтатусы);
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ОписаниеОперации.ВидПродукции = Операция_СообщениеОбОтгрузке_ПервыйВидПродукции(МенеджерВТ);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ИЗ
	|	ТаблицаКодов КАК Т
	|ГДЕ
	|	Т.ВидПродукции = &ВидПродукции");
	Запрос.УстановитьПараметр("ВидПродукции", ОписаниеОперации.ВидПродукции);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	МенеджерВТ.Закрыть();
	
	ПоляТоваров = "Товар, КлючНоменклатуры1С";
	Операция_ЗаполнитьТаблицуТоваров(ОписаниеОперации.Товары, ТаблицаЗапроса, ПоляТоваров);
	
	Отбор = Новый Структура(ПоляТоваров);
	ОписаниеОперации.Товары.Индексы.Добавить(ПоляТоваров);
	Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрЗапроса);
		СтрТовара = ОписаниеОперации.Товары.НайтиСтроки(Отбор)[0];
		СтрКода = ТаблицаКодов.Добавить();
		СтрКода.КлючКода = СтрЗапроса.КлючКода;
		СтрКода.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ЗаполнитьТЧ_РегистрацияКИТУ(ОписаниеОперации, ТаблицаКодов)
	
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТипОперации = ОписаниеОперации.ТипОперации;
	Организация = ОписаниеОперации.Организация;
	ПодходящиеСтатусы = Операция_РегистрацияАгрегатов_ПодходящиеСтатусыКодов();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
