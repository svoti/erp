Функция Товар_ДатаСрокаГодности(Товар, ДатаПроизводства) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаПроизводства) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЕдиницыИзмеренияСрокаГодности = Перечисление_ЕдиницыИзмеренияСрокаГодности();
	
	ОписаниеТовара = Товар_Прочитать(Товар);
	ЕдиницаИзмеренияСрокаГодности = ОписаниеТовара.ДопРеквизиты.ЕдиницаИзмеренияСрокаГодности;
	ЗначениеСрокаГодности = ОписаниеТовара.ДопРеквизиты.ЗначениеСрокаГодности;
	Если Не ЗначениеЗаполнено(ЕдиницаИзмеренияСрокаГодности)
		Или Не ЗначениеЗаполнено(ЗначениеСрокаГодности) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЕдиницаИзмеренияСрокаГодности = ЕдиницыИзмеренияСрокаГодности.Час Тогда
		Результат = ДатаПроизводства + СекундВЧасе() * ЗначениеСрокаГодности;
	ИначеЕсли ЕдиницаИзмеренияСрокаГодности = ЕдиницыИзмеренияСрокаГодности.День Тогда
		Результат = ДатаПроизводства + СекундВСутках() * ЗначениеСрокаГодности;
	ИначеЕсли ЕдиницаИзмеренияСрокаГодности = ЕдиницыИзмеренияСрокаГодности.Месяц Тогда
		Результат = ДобавитьМесяц(ДатаПроизводства, ЗначениеСрокаГодности);
	Иначе
		Результат = ДобавитьМесяц(ДатаПроизводства, МесяцевВГоду() * ЗначениеСрокаГодности);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

