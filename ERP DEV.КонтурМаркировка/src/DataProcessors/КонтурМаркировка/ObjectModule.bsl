Функция ДатаПроверкиОбновленияБиблиотекиКонтроля()
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().БиблиотекаКонтроля;
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	Результат = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, "ДатаПроверки", ПустаяДата());
	
	Возврат Результат;
	
КонецФункции

Функция ДвоичныеДанныеБиблиотекиКонтроля()
	
	ТипФайла = Перечисление_ТипыФайлов().БиблиотекаКонтроля;
	ИмяСправочника = Перечисление_ИменаДопСправочников().БиблиотекаКонтроля;
	ВерсияПоУмолчанию = ВерсияБиблиотекиКонтроляПоУмолчанию();
	УстановленнаяВерсия = ВерсияУстановленнойБиблиотекиКонтроля();
	
	Результат = Неопределено;
	
	Если СравнитьВерсии(УстановленнаяВерсия, ВерсияПоУмолчанию) >= 0 Тогда
		ВладелецФайла = ДопСправочник_НайтиПервый(ИмяСправочника);
		Файл = Файл_Найти(ВладелецФайла, ТипФайла);
		ОписаниеФайла = Файл_Прочитать(Файл);
		Если ОписаниеФайла <> Неопределено Тогда
			Результат = ОписаниеФайла.ДанныеФайла;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ДвоичныеДанныеБиблиотекиКонтроляПоУмолчанию();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

