Функция ШаблонЭтикетки_Записать(ОписаниеШаблона) Экспорт
	
	Если ЗначениеЗаполнено(ОписаниеШаблона.Ссылка) Тогда
		ПроверитьОбъектВПроцессеОбновления(ОписаниеШаблона.Ссылка);
		Объект = ОписаниеШаблона.Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Объект = Справочники.КонтурМаркировка_ШаблоныЭтикеток.СоздатьЭлемент();
			Объект.УстановитьСсылкуНового(ОписаниеШаблона.Ссылка);
		КонецЕсли;
	Иначе
		Объект = Справочники.КонтурМаркировка_ШаблоныЭтикеток.СоздатьЭлемент();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ОписаниеШаблона,, "МакетЭтикетки, ПараметрыШтрихкодов");
	
	Объект.МакетЭтикетки = ЗначениеВХранилище(ОписаниеШаблона.МакетЭтикетки);
	Объект.ПараметрыШтрихкодов = ЗначениеВХранилище(ОписаниеШаблона.ПараметрыШтрихкодов);
	
	Объект.Записать();
	
	ОписаниеШаблона.Ссылка = Объект.Ссылка;
	
	Возврат Объект.Ссылка;
	
КонецФункции

Функция ШаблонЭтикетки_Прочитать(Ссылка) Экспорт
	
	Результат = Новый_ШаблонЭтикетки();
	ЗаполнитьЗначенияСвойств(Результат, Ссылка,, "МакетЭтикетки, ПараметрыШтрихкодов");
	
	Результат.МакетЭтикетки = Ссылка.МакетЭтикетки.Получить();
	Результат.ИспользуемыеПараметры = ШаблонЭтикетки_ПараметрыМакета(Результат.МакетЭтикетки);
	
	Если Результат.МакетЭтикетки <> Неопределено Тогда
		Результат.МакетЭтикетки.КлючПараметровПечати = Неопределено;
		Результат.МакетЭтикетки.ОбластьПечати = Неопределено;
	КонецЕсли;
	
	ПараметрыШтрихкодов = Ссылка.ПараметрыШтрихкодов.Получить();
	Если ЗначениеЗаполнено(ПараметрыШтрихкодов) Тогда
		Для Каждого Элемент Из ПараметрыШтрихкодов Цикл
			Если Результат.ПараметрыШтрихкодов.Свойство(Элемент.Ключ) Тогда
				ЗаполнитьПоляСтруктуры(Результат.ПараметрыШтрихкодов[Элемент.Ключ], Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ШаблонЭтикетки_ПрочитатьПример(ИмяШаблона) Экспорт
	
	Результат = Новый_ШаблонЭтикетки();
	
	Результат.ТипЭтикетки = ШаблонЭтикетки_ТипЭтикеткиПримера(ИмяШаблона);
	Результат.МакетЭтикетки = МакетСправочника("КонтурМаркировка_ШаблоныЭтикеток", ИмяШаблона);
	Результат.ИспользуемыеПараметры = ШаблонЭтикетки_ПараметрыМакета(Результат.МакетЭтикетки);
	Результат.МакетЭтикетки.КлючПараметровПечати = Неопределено;
	Результат.МакетЭтикетки.ОбластьПечати = Неопределено;
	
	РазмерыЭтикетки = ШаблонЭтикетки_РазмерыЭтикеткиПоУмолчанию();
	ЗаполнитьЗначенияСвойств(Результат.МакетЭтикетки, РазмерыЭтикетки);
	ЗаполнитьЗначенияСвойств(Результат, РазмерыЭтикетки);
	
	Если ИмяШаблона = "Этикетки_Товарная_58_40" Тогда
		Результат.Наименование = НСтр("ru = 'Товарная этикетка 58х40'");
	Иначе
		Результат.Наименование = НСтр("ru = 'Транспортная этикетка 58х40'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ШаблонЭтикетки_ТипЭтикеткиПримера(ИмяШаблона)
	
	ИмяЭтикетки = СтрЗаменить(ИмяШаблона, "Этикетки_", "");
	ИмяЭтикетки = Лев(ИмяЭтикетки, Найти(ИмяЭтикетки, "_") - 1);
	
	Результат = Перечисления.КонтурМаркировка_ТипыЭтикеток[ИмяЭтикетки];
	
	Возврат Результат;
	
КонецФункции

Функция ШаблонЭтикетки_ИмяМакетаПримера(ТипЭтикетки) Экспорт 
	
	Результат = Неопределено;
	
	Макеты = Метаданные.Справочники.КонтурМаркировка_ШаблоныЭтикеток.Макеты;
	Для Каждого Макет Из Макеты Цикл
		
		ТипЭтикеткиМакета = ШаблонЭтикетки_ТипЭтикеткиПримера(Макет.Имя);
		Если ТипЭтикеткиМакета = ТипЭтикетки Тогда
			Результат = Макет.Имя;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не найден макет этикетки с типом %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ТипЭтикетки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ШаблонЭтикетки_ДобавитьПараметр(МассивПараметров, ИмяПараметра
	, ИмяГруппы		 = Неопределено
	, Представление	 = Неопределено
	, ВидЗначения	 = "Текст"
	, Формула		 = Неопределено)
	
	Если Представление = Неопределено Тогда
		Представление = ИмяПараметра;
	КонецЕсли;
	
	НовыйПараметр = Новый Структура;
	НовыйПараметр.Вставить("Имя"			, ИмяПараметра);
	НовыйПараметр.Вставить("ИмяГруппы"		, ИмяГруппы);
	НовыйПараметр.Вставить("Представление"	, Представление);
	НовыйПараметр.Вставить("ВидЗначения"	, ВидЗначения);
	НовыйПараметр.Вставить("Формула"		, Формула);
	
	МассивПараметров.Добавить(НовыйПараметр);
	
КонецПроцедуры

// Определяет состав настроек параметров этикетки по типу этикетки
//
// Параметры:
//  ТипЭтикетки - Перечисления.КонтурМаркировка_ТипыЭтикеток - тип этикетки
// 
// Возвращаемое значение:
//  Массив - настройки параметров этикетки
//
Функция ШаблонЭтикетки_НастройкиПараметров(ТипЭтикетки) Экспорт
	
	ИменаКартинок = Перечисление_ИменаКартинокШтрихкодов();
	НастройкиМодуля = НастройкиМодуля();
	ДопПараметрыПечати = НастройкиМодуля.ДопПараметрыПечатиШаблонаЭтикеток;
	
	ТоварнаяЭтикетка = Перечисления.КонтурМаркировка_ТипыЭтикеток.Товарная;
	ТранспортнаяЭтикетка = Перечисления.КонтурМаркировка_ТипыЭтикеток.Транспортная;
	ГрупповаяЭтикетка = Перечисления.КонтурМаркировка_ТипыЭтикеток.Групповая;
	ЭтикеткаНабора = Перечисления.КонтурМаркировка_ТипыЭтикеток.Набор;
	
	Результат = Новый Массив;
	
	Для каждого Стр Из ДопПараметрыПечати Цикл
		ШаблонЭтикетки_ДобавитьПараметр(Результат, Стр.Имя, "Дополнительные параметры", Стр.Имя, , Стр.Формула);
	КонецЦикла;
	
	Если ТипЭтикетки = ТоварнаяЭтикетка
		Или ТипЭтикетки = ГрупповаяЭтикетка
		Или ТипЭтикетки = ЭтикеткаНабора Тогда
		
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "DataMatrix_Код"						, "Data matrix", "Код");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "DataMatrix_СерийныйНомер"			, "Data matrix", "Серийный номер");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "DataMatrix_ЗаводскойСерийныйНомер"	, "Data matrix", "Заводской серийный номер");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, ИменаКартинок.DataMatrix				, "Data matrix", "Картинка", "Картинка");
		
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "GTIN_Штрихкод"			, "GTIN", "Штрихкод");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "GTIN_Код"				, "GTIN", "Код товара");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "GTIN_НаименованиеТовара", "GTIN", "Наименование товара");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, ИменаКартинок.GTIN		, "GTIN", "Картинка", "Картинка");
		
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "Номенклатура1С_Артикул"				, "Номенклатура 1С", "Артикул");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "Номенклатура1С_ПолноеНаименование"	, "Номенклатура 1С", "Полное наименование");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "Номенклатура1С_РабочееНаименование"	, "Номенклатура 1С", "Рабочее наименование");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "Номенклатура1С_Представление"		, "Номенклатура 1С", "Представление (с характеристикой)");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "Номенклатура1С_НаименованиеХарактеристики", "Номенклатура 1С", "Наименование характеристики");
		
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "ДопСведения_Количество"			, "Дополнительные сведения", "Количество");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "ДопСведения_ИдентификаторВСД"	, "Дополнительные сведения", "Идентификатор ВСД");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "ДопСведения_ДатаСрокаГодности"	, "Дополнительные сведения", "Дата истечения срока годности");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "ДопСведения_ДатаПроизводства"	, "Дополнительные сведения", "Дата производства");
		
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "НомерСтрокиДокумента", "Документ 1С", "Номер строки документа");
		
	ИначеЕсли ТипЭтикетки = ТранспортнаяЭтикетка Тогда
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "Агрегат_Код"		, "Агрегат", "Код");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "Агрегат_ВидАгрегата", "Агрегат", "Вид агрегата");
		ШаблонЭтикетки_ДобавитьПараметр(Результат, ИменаКартинок.Агрегат, "Агрегат", "Картинка", "Картинка");
	КонецЕсли;
	
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "Организация1С_СокращенноеНаименование"	, "Организация 1С", "Сокращенное наименование");
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "Организация1С_ПолноеНаименование"		, "Организация 1С", "Полное наименование");
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "Организация1С_РабочееНаименование"		, "Организация 1С", "Рабочее наименование");
	
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "Документ1С_Представление"	, "Документ 1С", "Представление");
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "Документ1С_Номер"			, "Документ 1С", "Номер");
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "Документ1С_Дата"			, "Документ 1С", "Дата");
	
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "ОперацияПечати_Номер", "Операция печати", "Номер");
	
	Если ЗначениеЗаполнено(НастройкиМодуля.ДопПараметрПечатиИмя1) Тогда
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "ДопПараметрПечати1", "Доп параметры печати", НастройкиМодуля.ДопПараметрПечатиИмя1);
	КонецЕсли;
	Если ЗначениеЗаполнено(НастройкиМодуля.ДопПараметрПечатиИмя2) Тогда
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "ДопПараметрПечати2", "Доп параметры печати", НастройкиМодуля.ДопПараметрПечатиИмя2);
	КонецЕсли;
	Если ЗначениеЗаполнено(НастройкиМодуля.ДопПараметрПечатиИмя3) Тогда
		ШаблонЭтикетки_ДобавитьПараметр(Результат, "ДопПараметрПечати3", "Доп параметры печати", НастройкиМодуля.ДопПараметрПечатиИмя3);
	КонецЕсли;
	
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "НомерЭтикеткиПоПорядку"			, , "Номер этикетки по порядку");
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "НомерТоварнойЭтикеткиПоПорядку"	, , "Номер товарной этикетки по порядку");
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "НомерУпаковкиПоПорядку"			, , "Номер упаковки по порядку");
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "НомерУпаковки"					, , "Номер упаковки, в которую входит этикетка");
	
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "ТекущаяДата"		, ,"Текущая дата");
	ШаблонЭтикетки_ДобавитьПараметр(Результат, "ТекущаяДатаВремя"	, ,"Текущая дата и время");
	
	Возврат Результат;
	
КонецФункции

Функция ШаблонЭтикетки_ПараметрыМакета(Макет)
	
	Результат = Новый Массив;
	
	Если Макет = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
		
		Для НомерКолонки = 1 По Макет.ШиринаТаблицы Цикл
			
			Ячейка = Макет.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
			
			Если Ячейка.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Параметр Тогда
				
				Если Результат.Найти(Ячейка.Параметр) = Неопределено тогда
					Результат.Добавить(Ячейка.Параметр);
				КонецЕсли;
				
			ИначеЕсли Ячейка.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Шаблон Тогда
				
				// Выделим все параметры в шаблоне в отдельные строки
				
				ТекстШаблона = Ячейка.Текст;
				ТекстШаблона = СтрЗаменить(ТекстШаблона, "[", Символы.ПС + "[");
				ТекстШаблона = СтрЗаменить(ТекстШаблона, "]", Символы.ПС);
				
				Для Счетчик = 1 По СтрЧислоСтрок(ТекстШаблона) Цикл
					
					ТекСтрока = СтрПолучитьСтроку(ТекстШаблона, Счетчик);
					
					Если Лев(ТекСтрока, 1) = "[" тогда
						
						ИмяПараметра = Сред(ТекСтрока, 2);
						
						Если Результат.Найти(ИмяПараметра) = Неопределено тогда
							Результат.Добавить(ИмяПараметра);
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ШаблонЭтикетки_РазмерыЭтикеткиПоУмолчанию() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("РазмерСтраницы", "Custom");
	
	Результат.Вставить("РазмерЯчейки", 2);
	Результат.Вставить("ШиринаСтраницы", 58);
	Результат.Вставить("ВысотаСтраницы", 40);
	
	Результат.Вставить("ПолеСверху", 0);
	Результат.Вставить("ПолеСлева", 0);
	Результат.Вставить("ПолеСнизу", 0);
	Результат.Вставить("ПолеСправа", 0);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ШаблонЭтикетки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("МакетЭтикетки");
	Результат.Вставить("ИспользуемыеПараметры");
	Результат.Вставить("Наименование");
	Результат.Вставить("ТипЭтикетки");
	Результат.Вставить("ШиринаСтраницы", 0);
	Результат.Вставить("ВысотаСтраницы", 0);
	Результат.Вставить("РазмерЯчейки", 0);
	
	Результат.Вставить("ПараметрыШтрихкодов", Новый_ПараметрыШтрихкодовЭтикетки());
	
	Возврат Результат;
	
КонецФункции

