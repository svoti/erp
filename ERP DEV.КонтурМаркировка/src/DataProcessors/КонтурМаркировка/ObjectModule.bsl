Функция Новый_ТаблицаМаркировки(ТоварыДокументов)
	
	НужныеКолонки = "ПервичныйДокумент, Номенклатура, Характеристика, Серия, Упаковка";
	Результат = ТоварыДокументов.СкопироватьКолонки(НужныеКолонки);
	
	ТипЧисло = ОписаниеТипа_Число();
	ТипБулево = ОписаниеТипа_Булево();
	ТипСтрока = ОписаниеТипа_Строка();
	
	Результат.Колонки.Добавить("ДокументУчета", ОписаниеТипа_ДокументыУчета());
	
	Результат.Колонки.Добавить("ПереданоКоличество", ТипЧисло);
	Результат.Колонки.Добавить("ПереданоКИ", ТипЧисло);
	Результат.Колонки.Добавить("ВсеКодыПереданы", ТипБулево);
	
	Результат.Колонки.Добавить("GTIN", ТипСтрока);
	Результат.Колонки.Добавить("Количество", ТипЧисло);
	Результат.Колонки.Добавить("КоличествоКИ", ТипЧисло);
	Результат.Колонки.Добавить("КоличествоВУпаковке", ТипЧисло);
	Результат.Колонки.Добавить("ОбъемноСортовойУчет", ТипБулево);
	
	Результат.Колонки.Добавить("СведенияОМаркировке", ОписаниеТипа_ТаблицаЗначений());
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ТаблицаМаркировки_СведенияОМаркировке()
	
	КлючКэш = "Шаблон_ИсходныеСведенияОМаркировке";
	ШаблонРезультата = Кэш_Прочитать(КлючКэш);
	Если ШаблонРезультата <> Неопределено Тогда
		Возврат ШаблонРезультата.Скопировать();
	КонецЕсли;
	
	ТипЧисло = ОписаниеТипа_Число();
	ТипБулево = ОписаниеТипа_Булево();
	ТипИдентификатор = ОписаниеТипа_Идентификатор();
	
	Результат = Новый_СведенияОМаркировке();
	Результат.Колонки.КоличествоУпаковок.Имя = "КоличествоКИ";
	
	Результат.Колонки.Добавить("Передан", ТипБулево);
	Результат.Колонки.Добавить("ПереданоКИ", ТипЧисло);
	
	Кэш_Поместить(КлючКэш, Результат.Скопировать());
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ОшибкиСведенийОМаркировке(ТоварыДокументов)
	
	Результат = ТоварыДокументов.СкопироватьКолонки("ПервичныйДокумент");
	
	Результат.Колонки.Добавить("ДокументУчета", ОписаниеТипа_ДокументыУчета());
	Результат.Колонки.Добавить("ТипОшибки", ОписаниеТипа_Строка());
	Результат.Колонки.Добавить("МассивGTIN");
	Результат.Колонки.Добавить("КодыМаркировки");
	
	Возврат Результат;
	
КонецФункции

Функция Новый_СведенияОМаркировке()
	
	КлючКэш = "Шаблон_СведенияОМаркировке";
	ШаблонРезультата = Кэш_Прочитать(КлючКэш);
	Если ШаблонРезультата <> Неопределено Тогда
		Возврат ШаблонРезультата.Скопировать();
	КонецЕсли;
	
	ТипЧисло = ОписаниеТипа_Число();
	ТипСтрока = ОписаниеТипа_Строка();
	ТипВидУпаковки = Новый ОписаниеТипов("ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("GTIN", ТипСтрока);
	Результат.Колонки.Добавить("ВидУпаковки", ТипВидУпаковки);
	Результат.Колонки.Добавить("ЗначениеШтрихкода", ТипСтрока);
	Результат.Колонки.Добавить("КоличествоУпаковок", ТипЧисло);
	Результат.Колонки.Добавить("НомерПартии", ТипСтрока);
	Результат.Колонки.Добавить("Количество", ТипЧисло);
	Результат.Колонки.Добавить("ПеременнаяХарактеристика", ТипСтрока);
	Результат.Колонки.Добавить("КодТоварнойГруппы", ТипЧисло);
	
	Кэш_Поместить(КлючКэш, Результат.Скопировать());
	
	Возврат Результат;
	
КонецФункции

Функция Новый_СведенияОМаркировкеДанныеКнопки()
	
	Результат = Новый Структура;
	Результат.Вставить("ВидимостьКоманды", Ложь);
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("Картинка", Новый Картинка);
	Результат.Вставить("Подсказка", "");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ЗаполнениеСведенийОМаркировке

// #Область СостояниеМаркировки

Процедура СостояниеМаркировки_Заполнить(СостояниеМаркировки, Документы1С, Организация) Экспорт
	
	Статусы = Перечисление_СтатусыДокументовУчета();
	Состояния = Перечисление_СостоянияМаркировки();
	ТипыОпераций = Перечисление_ТипыОпераций();
	СервисыПодписок = Перечисление_СервисыПодписок();
	ТребуемыеДействияДокумента = Перечисление_ТребуемыеДействияДокументовУчета();
	ТребуемыеДействияСостояний = Перечисление_ТребуемыеДействияСостоянийМаркировки();
	
	СостояниеМаркировки.Строки.Очистить();
	
	Для Каждого Документ1С Из Документы1С Цикл
		
		ДокументУчета = ДокументУчета_НайтиПоДокументу1С(Документ1С);
		
		Если Не ДокументДопустимВМаркировке(Документ1С)
			Или Не ДокументыУчета_СодержатТоварыДляОтраженияВЭДО(ЗначениеВМассиве(Документ1С)) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ТипДокумента = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "ТипДокумента");
		Иначе
			ТипДокумента = Документ1С.Метаданные().Имя;
		КонецЕсли;
		
		СтатусыДокумента = СтатусыДокументаУчета_Прочитать(ДокументУчета);
		ТребуемоеДействиеДокумента = СтатусыДокумента.ТребуемоеДействие;
		
		СтрДок = СостояниеМаркировки.Строки.Добавить();
		СтрДок.ДокументУчета = ДокументУчета;
		СтрДок.Документ1С = Документ1С;
		СтрДок.Статус = СтатусыДокумента.ОсновнойСтатус;
		
		Если ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.РаботаЗавершена Тогда
			СтрДок.ТребуемоеДействиеДокумента = ТребуемоеДействиеДокумента;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			СтрДок.СвязанныеДокументы = Строка(ДокументУчета);
		Иначе
			СтрДок.СвязанныеДокументы = Строка(Документ1С);
		КонецЕсли;
		
		Если Не СостояниеМаркировки_ТипДокументаСодержитРолиДляЭДО(ТипДокумента) Тогда
			
			СтрСост = СтрДок.Строки.Добавить();
			СтрСост.Состояние = Состояния.ИсправитьОшибки;
			СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.УказатьРольДокумента;
			СтрСост.ЭтоГиперссылка = Истина;
			СтрСост.ЭтоПредупреждение = Истина;
			
		ИначеЕсли Не ЗначениеЗаполнено(ДокументУчета)
			Или ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.НачатьРаботу Тогда
			
			СтрСост = СтрДок.Строки.Добавить();
			СтрСост.Состояние = Состояния.НачатьРаботу;
			СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.НачатьРаботу;
			СтрСост.ЭтоГиперссылка = Истина;
			СтрСост.ЭтоПредупреждение = Истина;
			
		ИначеЕсли ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.ПодобратьТовары Тогда
			
			СтрСост = СтрДок.Строки.Добавить();
			СтрСост.Состояние = Состояния.ИсправитьОшибки;
			СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.СопоставитьТовары;
			СтрСост.ЭтоГиперссылка = Истина;
			СтрСост.ЭтоПредупреждение = Истина;
			
		ИначеЕсли ЗначениеЗаполнено(СведенияОМаркировке_Проверить_НеРазрешенОСУ(ДокументУчета)) Тогда
			
			СтрСост = СтрДок.Строки.Добавить();
			СтрСост.Состояние = Состояния.ИсправитьОшибки;
			СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.СменитьОтражениеВЭДО;
			СтрСост.Статус = НСтр("ru = 'Запрещена отгрузка по ОСУ'");
			СтрСост.ЭтоГиперссылка = Истина;
			СтрСост.ЭтоПредупреждение = Истина;
			
		ИначеЕсли Не СервисДоступенПоТарифу(СервисыПодписок.ЗаполнениеСведенийОМаркировке, Тариф(Организация)) Тогда
			
			СтрСост = СтрДок.Строки.Добавить();
			СтрСост.Состояние = Состояния.ИсправитьОшибки;
			СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.ПроверитьВозможностиТарифа;
			СтрСост.Статус = НСтр("ru = 'Наполнение УПД недоступно в текущем тарифе'");
			СтрСост.ЭтоГиперссылка = Истина;
			СтрСост.ЭтоПредупреждение = Истина;
			
		ИначеЕсли ДокументУчета_ЕстьРольКорректировкаОтгрузки(ДокументУчета)
			И Не ЗначениеЗаполнено(ДокументУчета_ИсходныйИсправляемыйДокументУчета(ДокументУчета)) Тогда
			
			СтрСост = СтрДок.Строки.Добавить();
			СтрСост.Состояние = Состояния.ИсправитьОшибки;
			СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.УказатьИсправляемыйДокумент;
			СтрСост.ЭтоГиперссылка = Истина;
			СтрСост.ЭтоПредупреждение = Истина;
			
		ИначеЕсли Не ДокументУчета_ПроверитьСопоставлениеКодов(ДокументУчета) Тогда
			
			СтрСост = СтрДок.Строки.Добавить();
			СтрСост.Состояние = Состояния.ИсправитьОшибки;
			СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.СопоставитьКоды;
			СтрСост.ЭтоГиперссылка = Истина;
			СтрСост.ЭтоПредупреждение = Истина;
			
		ИначеЕсли ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.НаполнитьКодами Тогда
			
			Если ДокументыУчета_ЕстьТоварыДляОтраженияВПУ(ДокументУчета)
				И Не ДокументыУчета_ЕстьНезавершенныеОперацииЗаказаКодов(ДокументУчета)
				И Не ДокументыУчета_ЕстьНезавершенныеОперацииПодбораКодовНаТСД(ДокументУчета) Тогда
				
				СтрСост = СтрДок.Строки.Добавить();
				СтрСост.Состояние = Состояния.НаполнитьКодами;
				СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.НаполнитьКодами;
				СтрСост.ЭтоГиперссылка = Истина;
				СтрСост.ЭтоПредупреждение = Истина;
				
			Иначе
				
				ТребуемыеТипы = Новый Массив;
				ТребуемыеТипы.Добавить(ТипыОпераций.ЗаказКодов);
				ТребуемыеТипы.Добавить(ТипыОпераций.ПодборКодовНаТСД);
				ТребуемыеТипы.Добавить(ТипыОпераций.ПодборТоваровИКодовНаТСД);
				
				СостояниеМаркировки_ДобавитьСтрокиОпераций(ДокументУчета, СтрДок, ТребуемыеТипы);
				
			КонецЕсли;
			
		ИначеЕсли ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.ЗаполнитьНаТСД
			И ДокументыУчета_ЕстьНезавершенныеОперацииПодбораКодовНаТСД(ДокументУчета) Тогда
			
			ТребуемыеТипы = Новый Массив;
			ТребуемыеТипы.Добавить(ТипыОпераций.ЗаказКодов);
			ТребуемыеТипы.Добавить(ТипыОпераций.ПодборКодовНаТСД);
			ТребуемыеТипы.Добавить(ТипыОпераций.ПодборТоваровИКодовНаТСД);
			
			СостояниеМаркировки_ДобавитьСтрокиОпераций(ДокументУчета, СтрДок, ТребуемыеТипы);
			
		ИначеЕсли ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.ОтчитатьсяОНанесении Тогда
			
			Если ДокументыУчета_ЕстьНезавершенныеОперацииОтчетыОНанесении(ДокументУчета) Тогда
				
				ТребуемыеТипы = Новый Массив;
				ТребуемыеТипы.Добавить(ТипыОпераций.ОтчетОНанесении);
				ТребуемыеТипы.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
				
				СостояниеМаркировки_ДобавитьСтрокиОпераций(ДокументУчета, СтрДок, ТребуемыеТипы);
				
			Иначе
				
				СтрСост = СтрДок.Строки.Добавить();
				СтрСост.Состояние = Состояния.ВыполнениеОперации;
				СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.ОтчитатьсяОНанесении;
				СтрСост.ЭтоГиперссылка = Истина;
				СтрСост.ЭтоПредупреждение = Истина;
				
			КонецЕсли;
			
		ИначеЕсли ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.ВвестиВОборот
			И Не ДокументыУчета_ЕстьНезавершенныеОперацииВводаВОборот(ДокументУчета) Тогда
			
			СтрСост = СтрДок.Строки.Добавить();
			СтрСост.Состояние = Состояния.ВыполнениеОперации;
			СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.ВвестиВОборот;
			СтрСост.ЭтоГиперссылка = Истина;
			СтрСост.ЭтоПредупреждение = Истина;
			
		ИначеЕсли ДокументыУчета_ЕстьНезавершенныеОперацииВводаВОборот(ДокументУчета) Тогда
			
			СостояниеМаркировки_ДобавитьСтрокиОпераций(ДокументУчета, СтрДок, ТипыОпераций.ВводВОборот);
			
		ИначеЕсли ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.НапечататьЭтикетки Тогда
			
			Если ДокументыУчета_ЕстьНезавершенныеОперацииПечати(ДокументУчета) Тогда
				
				СостояниеМаркировки_ДобавитьСтрокиОпераций(ДокументУчета, СтрДок, ТипыОпераций.ПечатьКодов);
				
			Иначе
				
				СтрСост = СтрДок.Строки.Добавить();
				СтрСост.Состояние = Состояния.ВыполнениеОперации;
				СтрСост.ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.НапечататьЭтикетки;
				СтрСост.ЭтоГиперссылка = Истина;
				СтрСост.ЭтоПредупреждение = Истина;
				
			КонецЕсли;
			
		ИначеЕсли ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.ИсправитьОшибку Тогда
			
			СостояниеМаркировки_ДобавитьСтрокиОпераций(ДокументУчета, СтрДок, ТипыИнтерактивныхОпераций(), Истина);
			
		КонецЕсли;
		
		СостояниеМаркировки_ДобавитьРезультатПроверкиКодов(СтрДок, ТребуемоеДействиеДокумента);
		СостояниеМаркировки_ДобавитьДействиеЗавершитьРаботу(СтрДок, ТребуемоеДействиеДокумента);
		
	КонецЦикла;
	
	СостояниеМаркировки_ЗаполнитьПредставленияТребуемыхДействий(СостояниеМаркировки);
	
КонецПроцедуры

Процедура СостояниеМаркировки_ДобавитьСтрокиОпераций(ДокументУчета, СтрокаДокумента, ТребуемыеТипыОпераций, ТолькоСОшибками = Ложь)
	
	Состояния = Перечисление_СостоянияМаркировки();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ЗавершенныеСтатусыОпераций = ЗавершенныеСтатусыОпераций();
	
	Если ТолькоСОшибками Тогда
		Состояние = Состояния.ИсправитьОшибки;
		ПодходящиеСтатусы = НовыйМассив(СтатусыОпераций.ОшибкаОбработки);
	Иначе
		Состояние = Состояния.ВыполнениеОперации;
		ПодходящиеСтатусы = Неопределено;
	КонецЕсли;
	
	Для Каждого СтрОпер Из ДокументУчета_СписокОпераций(ДокументУчета, ТребуемыеТипыОпераций, ПодходящиеСтатусы) Цикл
		
		Если Не ТолькоСОшибками И МассивСодержитЗначение(ЗавершенныеСтатусыОпераций, СтрОпер.Статус) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрСост = СтрокаДокумента.Строки.Добавить();
		СтрСост.Состояние = Состояние;
		СтрСост.ТребуемоеДействиеСостояния = Строка(СтрОпер.Операция);
		СтрСост.Операция = СтрОпер.Операция;
		СтрСост.Статус = СтрОпер.Статус;
		СтрСост.ЭтоГиперссылка = Истина;
		СтрСост.ЭтоПредупреждение = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СостояниеМаркировки_ДобавитьРезультатПроверкиКодов(СтрокаДокумента, ТребуемоеДействиеДокумента)
	
	Состояния = Перечисление_СостоянияМаркировки();
	ОтраженияВЭДО = Перечисление_ОтраженияВЭДО();
	СтатусыПроверкиКодов = Перечисление_СтатусыПроверкиКодовДокумента();
	ТребуемыеДействияДокумента = Перечисление_ТребуемыеДействияДокументовУчета();
	ТребуемыеДействияСостояний = Перечисление_ТребуемыеДействияСостоянийМаркировки();
	ДопИнформация = Перечисление_ДопИнформацияСтатусовПроверкиКодовДокумента();
	
	Состояние = Состояния.РезультатПроверки;
	ТребуемоеДействиеСостояния = ТребуемыеДействияСостояний.ВыполнитьПроверку;
	ВыполняетсяПроверка = Ложь;
	ЭтоПредупреждение = Ложь;
	ЭтоГиперссылка = Истина;
	
	ДокументУчета = СтрокаДокумента.ДокументУчета;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		
		Если Не ДокументыУчета_ЕстьТоварыДляОтраженияВПУ(ДокументУчета) Тогда
			Возврат;
		КонецЕсли;
		
		Если ДокументУчета_ВключеныПроверкиКодов(ДокументУчета) Тогда
			
			ПредставленияСтатусов = Новый Соответствие;
			ПредставленияСтатусов.Вставить(СтатусыПроверкиКодов.ЕстьОшибки, ДопИнформация.ЕстьОшибкиКодов);
			ПредставленияСтатусов.Вставить(СтатусыПроверкиКодов.Успешно, ДопИнформация.ВсеКодыВерны);
			ПредставленияСтатусов.Вставить(СтатусыПроверкиКодов.Неактуален, ДопИнформация.ПроверкаКодовНеактуальна);
			ПредставленияСтатусов.Вставить(СтатусыПроверкиКодов.Отключена, ДопИнформация.ПроверкаКодовОтключена);
			ПредставленияСтатусов.Вставить(СтатусыПроверкиКодов.Предупреждение, НСтр("ru = 'Есть ошибки кодов, не блокирующие отправку'"));
			
			РезультатПроверки = ДокументУчета_РезультатПроверкиКодов(ДокументУчета);
			Статус = СвойствоСтруктуры(ПредставленияСтатусов, РезультатПроверки);
			
			Если Не ЗначениеЗаполнено(РезультатПроверки)
				Или РезультатПроверки = СтатусыПроверкиКодов.Неактуален Тогда
				Состояние = Состояния.ОжидаетсяПроверка;
				ЭтоПредупреждение = Истина;
			КонецЕсли;
			
			Если РезультатПроверки = СтатусыПроверкиКодов.Успешно
				Или РезультатПроверки = СтатусыПроверкиКодов.Отключена
				Или ТребуемоеДействиеДокумента = ТребуемыеДействияДокумента.РаботаЗавершена Тогда
				ТребуемоеДействиеСостояния = "";
				ЭтоГиперссылка = Ложь;
			КонецЕсли;
			
		Иначе
			Статус = ДопИнформация.ПроверкаКодовОтключена;
			ТребуемоеДействиеСостояния = "";
			ЭтоГиперссылка = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	СтрСост = СтрокаДокумента.Строки.Добавить();
	СтрСост.Статус = Статус;
	СтрСост.Состояние = Состояние;
	СтрСост.ТребуемоеДействиеСостояния = ТребуемоеДействиеСостояния;
	СтрСост.ВыполняетсяПроверка = ВыполняетсяПроверка;
	СтрСост.ЭтоПредупреждение = ЭтоПредупреждение;
	СтрСост.ЭтоГиперссылка = ЭтоГиперссылка;
	
КонецПроцедуры

Процедура СостояниеМаркировки_ДобавитьДействиеЗавершитьРаботу(СтрокаДокумента, ТребуемоеДействиеДокумента)
	
	Если ТребуемоеДействиеДокумента = Перечисление_ТребуемыеДействияДокументовУчета().РаботаЗавершена Тогда
		Возврат;
	КонецЕсли;
	
	СтрСост = СтрокаДокумента.Строки.Добавить();
	СтрСост.Состояние = Перечисление_СостоянияМаркировки().ЗавершитьРаботу;
	СтрСост.ТребуемоеДействиеСостояния = Перечисление_ТребуемыеДействияСостоянийМаркировки().ЗавершитьРаботу;
	СтрСост.ЭтоГиперссылка = Истина;
	
КонецПроцедуры

Процедура СостояниеМаркировки_ЗаполнитьПредставленияТребуемыхДействий(СостояниеМаркировки)
	
	Для Каждого СтрДок Из СостояниеМаркировки.Строки Цикл
		Для Каждого СтрСост Из СтрДок.Строки Цикл
			Если ЗначениеЗаполнено(СтрСост.Операция) Тогда
				СтрСост.ТребуемоеДействиеПредставление = Строка(СтрСост.Операция);
			Иначе
				СтрСост.ТребуемоеДействиеПредставление = СтрСост.ТребуемоеДействиеСостояния;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция СостояниеМаркировки_ДокументыУчетаСодержатОшибки(ДокументыУчета, Организация, ТаблицаСтатусов)
	
	Действия = Перечисление_ТребуемыеДействияДокументовУчета();
	СервисыПодписок = Перечисление_СервисыПодписок();
	
	ПодходящиеДействия = Новый Массив;
	ПодходящиеДействия.Добавить(Действия.ИсправитьОшибку);
	ПодходящиеДействия.Добавить(Действия.ПодобратьТовары);
	
	Возврат
	
	ТаблицаЗначений_ЕстьЗначение(ТаблицаСтатусов, "ТребуемоеДействие", ПодходящиеДействия)
	Или СостояниеМаркировки_ДокументыСодержатОшибкиРолей(ДокументыУчета)
	Или ЗначениеЗаполнено(СведенияОМаркировке_Проверить_НеРазрешенОСУ(ДокументыУчета))
	Или Не СервисДоступенПоТарифу(СервисыПодписок.ЗаполнениеСведенийОМаркировке, Тариф(Организация));
	
КонецФункции

Функция СостояниеМаркировки_ДокументыУчетаСодержатОшибкиКодов(ДокументыУчета, Организация, ТаблицаСтатусов)
	
	Возврат
	
	Не ДокументыУчета_ПроверитьСопоставлениеКодов(ДокументыУчета)
	Или Не ДокументыУчета_ПроверитьРезультатПроверкиКодов(ДокументыУчета);
	
КонецФункции

Функция СостояниеМаркировки_ДокументыУчетаТребуютУказатьСведения(ДокументыУчета, Документы1С, ТаблицаСтатусов)
	
	Действия = Перечисление_ТребуемыеДействияДокументовУчета();
	Колонка = "ТребуемоеДействие";
	
	Возврат
	
	Документы1С.Количество() <> ДокументыУчета.Количество()
	Или ТаблицаЗначений_ЕстьЗначение(ТаблицаСтатусов, Колонка, Действия.НачатьРаботу)
	
	Или (ТаблицаЗначений_ЕстьЗначение(ТаблицаСтатусов, Колонка, Действия.НаполнитьКодами)
	И ДокументыУчета_ЕстьТоварыДляОтраженияВПУ(ДокументыУчета)
	И Не ДокументыУчета_ЕстьНезавершенныеОперацииЗаказаКодов(ДокументыУчета)
	И Не ДокументыУчета_ЕстьНезавершенныеОперацииПодбораКодовНаТСД(ДокументыУчета));
	
КонецФункции

Функция СостояниеМаркировки_ДокументыУчетаТребуютЗавершитьНаполнение(ДокументыУчета, ТаблицаСтатусов)
	
	Действия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	ПодходящиеДействия = Новый Массив;
	ПодходящиеДействия.Добавить(Действия.ЗаполнитьНаТСД);
	ПодходящиеДействия.Добавить(Действия.НаполнитьКодами);
	
	Возврат
	
	ТаблицаЗначений_ЕстьЗначение(ТаблицаСтатусов, "ТребуемоеДействие", ПодходящиеДействия)
	И (ДокументыУчета_ЕстьНезавершенныеОперацииЗаказаКодов(ДокументыУчета)
	Или ДокументыУчета_ЕстьНезавершенныеОперацииПодбораКодовНаТСД(ДокументыУчета));
	
КонецФункции

Функция СостояниеМаркировки_ДокументыУчетаЗавершены(ТаблицаСтатусов)
	
	Действия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	Отбор = Новый Структура("ТребуемоеДействие", Действия.РаботаЗавершена);
	
	Возврат ТаблицаСтатусов.Количество() = ТаблицаСтатусов.НайтиСтроки(Отбор).Количество();
	
КонецФункции

Функция СостояниеМаркировки_ДокументыСодержатОшибкиРолей(ДокументыУчета)
	
	РолиДокументовУчета = Перечисление_РолиДокументовУчета();
	КэшИсправляемыхДокументов = Новый Соответствие;
	
	Для каждого ДокументУчета Из ДокументыУчета Цикл
		
		ТипДокумента = ДокументУчета.ТипДокумента;
		
		Если Не СостояниеМаркировки_ТипДокументаСодержитРолиДляЭДО(ТипДокумента) Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РолиДокументовУчета.КорректировкаОтгрузки)
			И Не ЗначениеЗаполнено(ДокументУчета_ИсходныйИсправляемыйДокументУчета(ДокументУчета, КэшИсправляемыхДокументов)) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СостояниеМаркировки_ТипДокументаСодержитРолиДляЭДО(ТипДокумента)
	
	РолиДокументовУчета = Перечисление_РолиДокументовУчета();
	
	Возврат
	
	ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РолиДокументовУчета.Отгрузка)
	Или ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РолиДокументовУчета.КорректировкаОтгрузки)
	Или ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РолиДокументовУчета.ВнутреннееПеремещение);
	
КонецФункции

