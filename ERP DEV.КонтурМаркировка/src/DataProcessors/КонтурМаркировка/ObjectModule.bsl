Функция ПредставлениеПеременнойХарактеристики(ТипПеременнойХарактеристики) Экспорт
	
	ШаблонЗаголовка = "%1, %2";
	ЕдиницаМаркировки = МодульЯдро().ЕдиницаМаркировкиПоТипуПеременнойХарактеристики(ТипПеременнойХарактеристики);
	
	Результат = ПараметрыВСтроку(ШаблонЗаголовка, ТипПеременнойХарактеристики, ЕдиницаМаркировки);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеИтогаПеременнойХарактеристики(ТипПеременнойХарактеристики) Экспорт
	
	ТипыПеременныхХарактеристик = Перечисление_ТипыПеременныхХарактеристикТовара();
	
	СоответствиеТипаИШаблона = Новый Соответствие;
	СоответствиеТипаИШаблона.Вставить(ТипыПеременныхХарактеристик.Вес,        НСтр("ru='Общий вес, %1'"));
	СоответствиеТипаИШаблона.Вставить(ТипыПеременныхХарактеристик.Объем,      НСтр("ru='Общий объем, %1'"));
	СоответствиеТипаИШаблона.Вставить(ТипыПеременныхХарактеристик.Длина,      НСтр("ru='Общая длина, %1'"));
	СоответствиеТипаИШаблона.Вставить(ТипыПеременныхХарактеристик.Количество, НСтр("ru='Общее количество, %1'"));
	
	ШаблонПредставления = СоответствиеТипаИШаблона[ТипПеременнойХарактеристики];
	ЕдиницаМаркировки = МодульЯдро().ЕдиницаМаркировкиПоТипуПеременнойХарактеристики(ТипПеременнойХарактеристики);
	
	Если ЗначениеЗаполнено(ШаблонПредставления) И ЗначениеЗаполнено(ЕдиницаМаркировки) Тогда
		Результат = ПараметрыВСтроку(ШаблонПредставления, ЕдиницаМаркировки);
	Иначе
		Результат = НСтр("ru='Общее значение'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

