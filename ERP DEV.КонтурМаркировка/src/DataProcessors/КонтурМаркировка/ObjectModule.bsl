// Выгружает коды документа учета в файл или массив файлов
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//  ФорматФайла   - Строка - см. Перечисление_ФорматыФайловСКодами();
// 
// Возвращаемое значение:
//  Массив - содержит по умолчанию один элемент, структуру со свойствами:
//   * ИмяФайла - имя, с которым нужно сохранить файл;
//   * ДвоичныеДанные - данные файла;
//
Функция ВыгрузитьКодыДокументаУчетаВФайл(ДокументУчета, ФорматФайла, Знач ВыгружатьПолныеКоды = Неопределено) Экспорт
	
	ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
	ТаблицаКодов.Сортировать("НомерСтрокиДокумента");
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	МодульЯдро = МодульЯдро();
	КэшПредставлений = Новый Соответствие;
	ТаблицаКодов.Колонки.Добавить("ПредставлениеНоменклатуры", ОписаниеТипа_Строка());
	Для каждого Стр Из ТаблицаКодов Цикл
		Стр.ПредставлениеНоменклатуры = МодульЯдро.ПредставлениеНоменклатуры1СДляПечати(Стр, КэшПредставлений);
	КонецЦикла;
	
	Если ВыгружатьПолныеКоды = Неопределено Тогда
		ВыгружатьПолныеКоды = НастройкиМодуля().ВыгружатьВФайлКодыСКрипточастью;
	КонецЕсли;
	
	КодДата = ЗначенияРеквизитовОбъектаЛок(ДокументУчета, "Код, Дата");
	ИмяФайла = ПараметрыВСтроку("Mark_%1_%2", КодДата.Код, Формат(КодДата.Дата, "ДФ=dd-MM-yyyy"));
	Результат = ВыгрузитьКодыВФайл(ТаблицаКодов, ФорматФайла, ИмяФайла, ВыгружатьПолныеКоды, ДокументУчета);
	
	Если ВыгружатьПолныеКоды Тогда
		ТаблицаКодов_ПометитьКодыНапечатанными(Таблицакодов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выгружает коды операции в файл или массив файлов
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция;
//  ФорматФайла - Строка - см. Перечисление_ФорматыФайловСКодами();
// 
// Возвращаемое значение:
//  Массив - содержит по умолчанию один элемент, структуру со свойствами:
//   * ИмяФайла - имя, с которым нужно сохранить файл;
//   * ДвоичныеДанные - данные файла;
//
Функция ВыгрузитьКодыОперацииВФайл(Операция, ФорматФайла) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипОперации = ЗначениеРеквизитаОбъектаЛок(Операция, "ТипОперации");
	
	Если ТипыОперацийСВыгрузкойКодов().Найти(ТипОперации) = Неопределено Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не поддерживается выгрузка кодов в файл из операции с типом: %1'"), ТипОперации);
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ПечатьКодов Тогда
		Результат = ФайлСКодами_ПечатьКодов(Операция, ФорматФайла);
	ИначеЕсли ТипОперации = ТипыОпераций.СообщениеОбОтгрузке Тогда
		Результат = ФайлСКодами_СообщениеОбОтгрузке(Операция, ФорматФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выгружает коды редактора кодов в файл или массив файлов
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция;
//  ФорматФайла - Строка - см. Перечисление_ФорматыФайловСКодами();
// 
// Возвращаемое значение:
//  Строка - адрес временного хранилища с описаниями файлов, структура описания файла:
//   * ИмяФайла - имя, с которым нужно сохранить файл;
//   * ДвоичныеДанные - данные файла;
//
Функция ВыгрузитьКодыРедактораКодовВФайл(Операция, ФорматФайла) Экспорт
	
	ТаблицаКодов = Новый_ТаблицаКодовДляВыгрузкиВФайл();
	
	ДанныеРедактора = РедакторКодов_ПолучитьИзФайла(Операция);
	Если ДанныеРедактора = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТаблицаКодовИзРедактора = ДанныеРедактора.ТаблицаКодов;
	Если Не ЗначениеЗаполнено(ТаблицаКодовИзРедактора) Тогда
		Возврат "";
	КонецЕсли;
	
	ТаблицаКодов_ВосстановитьРазделителиGS1(ТаблицаКодовИзРедактора);
	
	МодульЯдро = МодульЯдро();
	КэшПредставлений = Новый Соответствие;
	Для каждого Стр Из ТаблицаКодовИзРедактора Цикл
		СтрКода = ТаблицаКодов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрКода, Стр);
		СтрКода.ПредставлениеНоменклатуры = МодульЯдро.ПредставлениеНоменклатуры1СДляПечати(СтрКода.КлючНоменклатуры1С, КэшПредставлений);
	КонецЦикла;
	
	ВыгружатьПолныеКоды = Ложь;
	КодДата = ЗначенияРеквизитовОбъектаЛок(Операция, "Код, Дата");
	ИмяФайла = ПараметрыВСтроку("WrongCodes_%1_%2", КодДата.Код, Формат(КодДата.Дата, "ДФ=dd-MM-yyyy"));
	Результат = ВыгрузитьКодыВФайл(ТаблицаКодов, ФорматФайла, ИмяФайла, ВыгружатьПолныеКоды, , Операция);
	
	Возврат Результат;
	
КонецФункции

// Выгружает коды из сообщения об отгрузке в файл или массив файлов
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - сообщение об отгрузке;
// 
// Возвращаемое значение:
//  Массив - содержит по умолчанию один элемент, структуру со свойствами:
//   * ИмяФайла - имя, с которым нужно сохранить файл;
//   * ДвоичныеДанные - данные файла;
//
Функция ФайлСКодами_СообщениеОбОтгрузке(Операция, ФорматФайла)
	
	ДокументУчета = ЗначениеРеквизитаОбъектаЛок(Операция, "ДокументУчета");
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов.Сортировать("НомерСтрокиДокумента");
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	МодульЯдро = МодульЯдро();
	КэшПредставлений = Новый Соответствие;
	ТаблицаКодов.Колонки.Добавить("ПредставлениеНоменклатуры", ОписаниеТипа_Строка());
	Для каждого Стр Из ТаблицаКодов Цикл
		Стр.ПредставлениеНоменклатуры = МодульЯдро.ПредставлениеНоменклатуры1СДляПечати(Стр, КэшПредставлений);
	КонецЦикла;
	
	ВыгружатьПолныеКоды = Ложь;
	КодДата = ЗначенияРеквизитовОбъектаЛок(Операция, "Код, Дата");
	ИмяФайла = ПараметрыВСтроку("Shipment_%1_%2", КодДата.Код, Формат(КодДата.Дата, "ДФ=dd-MM-yyyy"));
	Результат = ВыгрузитьКодыВФайл(ТаблицаКодов, ФорматФайла, ИмяФайла, ВыгружатьПолныеКоды, ДокументУчета, Операция);
	
	Возврат Результат;
	
КонецФункции

// Выгружает коды операции печать кодов в файл или массив файлов
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция печати;
// 
// Возвращаемое значение:
//  Массив - содержит по умолчанию один элемент, структуру со свойствами:
//   * ИмяФайла - имя, с которым нужно сохранить файл;
//   * ДвоичныеДанные - данные файла;
//
Функция ФайлСКодами_ПечатьКодов(Операция, ФорматФайла)
	
	ДокументУчета = ЗначениеРеквизитаОбъектаЛок(Операция, "ДокументУчета");
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов.Сортировать("НомерСтрокиДокумента");
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ПолныеКоды_Прочитать(ТаблицаКодов);
	
	МодульЯдро = МодульЯдро();
	КэшПредставлений = Новый Соответствие;
	ТаблицаКодов.Колонки.Добавить("ПредставлениеНоменклатуры", ОписаниеТипа_Строка());
	Для каждого Стр Из ТаблицаКодов Цикл
		Стр.ПредставлениеНоменклатуры = МодульЯдро.ПредставлениеНоменклатуры1СДляПечати(Стр, КэшПредставлений);
	КонецЦикла;
	
	ВыгружатьПолныеКоды = НастройкиМодуля().ВыгружатьВФайлКодыСКрипточастью;
	КодДата = ЗначенияРеквизитовОбъектаЛок(Операция, "Код, Дата");
	ИмяФайла = ПараметрыВСтроку("Production_%1_%2", КодДата.Код, Формат(КодДата.Дата, "ДФ=dd-MM-yyyy"));
	Результат = ВыгрузитьКодыВФайл(ТаблицаКодов, ФорматФайла, ИмяФайла, ВыгружатьПолныеКоды, ДокументУчета, Операция);
	
	Если ВыгружатьПолныеКоды Тогда
		ТаблицаКодов_ПометитьКодыНапечатанными(Таблицакодов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выгружает коды в файл или массив файлов из таблицы кодов
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - таблица с кодами;
//  ФорматФайла - Строка - см. Перечисление_ФорматыФайловСКодами();
//  ИмяФайлаПоУмолчанию - Строка - имя файла по умолчанию;
//  ВыгружатьПолныеКоды - Булево - Истина, если в файл нужно выгрузить коды с крипточастью;
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - (необязательный) документ учета;
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - (необязательный) операция;
// 
// Возвращаемое значение:
//  Массив - содержит по умолчанию один элемент, структуру со свойствами:
//   * ИмяФайла - имя, с которым нужно сохранить файл;
//   * ДвоичныеДанные - данные файла;
//
Функция ВыгрузитьКодыВФайл(ТаблицаКодов, ФорматФайла, ИмяФайлаПоУмолчанию, ВыгружатьПолныеКоды
	, ДокументУчета = Неопределено
	, Операция = Неопределено)
	
	ВыгрузитьВФайлCSV = (ФорматФайла = Перечисление_ФорматыФайловСКодами().csv);
	ВыгрузитьВФайлXLS = (ФорматФайла = Перечисление_ФорматыФайловСКодами().xlsx);
	
	Если ВыгрузитьВФайлCSV Тогда
		ТаблицаКодов_ЭкранироватьКавычкиCSV(ТаблицаКодов);
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ1С"	, ДокументУчета_Документ1С(ДокументУчета));
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("Операция"		, Операция);
	ПараметрыПМ.Вставить("ТаблицаКодов"	, ТаблицаКодов);
	ПараметрыПМ.Вставить("ФорматФайла"	, ФорматФайла);
	ПараметрыПМ.Вставить("ОписанияФайлов", Новый Массив);
	ПМ_ОбработатьСобытие_ПриВыгрузкеКодовВФайл(ПараметрыПМ, СтандартнаяОбработка);
	
	Если Не СтандартнаяОбработка Тогда
		
		ОписанияФайлов = ПараметрыПМ.ОписанияФайлов;
		
	Иначе
		
		ОписанияФайлов = Новый Массив;
		
		ОписаниеФайла = Новый_ОписаниеФайлаДляВыгрузкиКодов();
		ОписаниеФайла.ДобавитьЗаголовкиКолонок = ВыгрузитьВФайлXLS;
		ОписаниеФайла.ТаблицаСтрок.Колонки.Добавить("КодМаркировки", , "Код маркировки");
		ОписаниеФайла.ТаблицаСтрок.Колонки.Добавить("GTIN");
		ОписаниеФайла.ТаблицаСтрок.Колонки.Добавить("НаименованиеТовара", , "Наименование товара");
		ОписаниеФайла.ТаблицаСтрок.Колонки.Добавить("ОписаниеОшибки", , "Описание ошибки");
		
		Для каждого Стр Из ТаблицаКодов Цикл
			
			Если ВыгружатьПолныеКоды
				И ЗначениеЗаполнено(Стр.ПолныйКод) Тогда
				КодМаркировки = Стр.ПолныйКод;
			ИначеЕсли ЗначениеЗаполнено(Стр.КодМаркировки) Тогда
				КодМаркировки = Стр.КодМаркировки;
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.ПредставлениеНоменклатуры) Тогда
				НаименованиеТовара = Стр.ПредставлениеНоменклатуры;
			ИначеЕсли ЗначениеЗаполнено(Стр.НаименованиеТовара) Тогда
				НаименованиеТовара = Стр.НаименованиеТовара;
			КонецЕсли;
			
			НоваяСтрока = ОписаниеФайла.ТаблицаСтрок.Добавить();
			НоваяСтрока.GTIN = Стр.GTIN;
			НоваяСтрока.НаименованиеТовара = НаименованиеТовара;
			НоваяСтрока.КодМаркировки = КодМаркировки;
			НоваяСтрока.ОписаниеОшибки = Стр.ОписаниеОшибки;
			
		КонецЦикла;
		
		ОписанияФайлов.Добавить(ОписаниеФайла);
		
	КонецЕсли;
	
	Результат = Новый Массив;
	
	ЗанятыеИменаФайлов = Новый Соответствие;
	
	Для Сч = 1 По ОписанияФайлов.Количество() Цикл
		
		Элемент = ОписанияФайлов[Сч - 1];
		
		ИмяФайла = Элемент.ИмяФайлаБезРасширения;
		Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
			ИмяФайла = ИмяФайлаПоУмолчанию;
		КонецЕсли;
		
		ИмяФайла = ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайла);
		
		Если ЗанятыеИменаФайлов[ИмяФайла] = Истина Тогда
			ИмяФайла = ИмяФайла + "(" + Сч + ")";
		КонецЕсли;
		ЗанятыеИменаФайлов.Вставить(ИмяФайла, Истина);
		
		ИмяФайла = ИмяФайла + "." + ФорматФайла;
		
		Если ВыгрузитьВФайлXLS Тогда
			ДвоичныеДанные = ВыгрузитьКодыВФайлXLSX(Элемент);
		Иначе
			ДвоичныеДанные = ВыгрузитьКодыВФайлCSV(Элемент);
		КонецЕсли;
		
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("ИмяФайла", ИмяФайла);
		ОписаниеФайла.Вставить("ДвоичныеДанные", ДвоичныеДанные);
		
		Результат.Добавить(ОписаниеФайла);
		
	КонецЦикла;
	
	Если ВыгрузитьВФайлCSV Тогда
		ТаблицаКодов_УдалитьКавычкиЭкранированияCSV(ТаблицаКодов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВыгрузитьКодыВФайлCSV(ПараметрыФайла)
	
	ТаблицаСтрок = ПараметрыФайла.ТаблицаСтрок;
	РазделительКолонок = ПараметрыФайла.РазделительКолонок;
	ДобавитьЗаголовкиКолонок = ПараметрыФайла.ДобавитьЗаголовкиКолонок;
	
	МассивСтрок = Новый Массив;
	
	Если ДобавитьЗаголовкиКолонок Тогда
		
		СтрокаЗаголовка = "";
		Разделитель = "";
		
		Для каждого Колонка Из ТаблицаСтрок.Колонки Цикл
			
			Если ЗначениеЗаполнено(Колонка.Заголовок) Тогда
				ЗаголовокКолонки = Колонка.Заголовок;
			Иначе
				ЗаголовокКолонки = Колонка.Имя;
			КонецЕсли;
			
			СтрокаЗаголовка = СтрокаЗаголовка + Разделитель + ЗаголовокКолонки;
			Разделитель = РазделительКолонок;
			
		КонецЦикла;
		
		МассивСтрок.Добавить(СтрокаЗаголовка);
		
	КонецЕсли;
	
	Для каждого Стр Из ТаблицаСтрок Цикл
		
		СтрокаФайла = "";
		Разделитель = "";
		
		Для каждого Колонка Из ТаблицаСтрок.Колонки Цикл
			СтрокаФайла = СтрокаФайла + Разделитель + Стр[Колонка.Имя];
			Разделитель = РазделительКолонок;
		КонецЦикла;
		
		МассивСтрок.Добавить(СтрокаФайла);
		
	КонецЦикла;
	
	ТекстФайла = СоединитьСтроку(МассивСтрок, Символы.ПС);
	
	Результат = ДвоичныеДанныеИзСтроки(ТекстФайла);
	
	Возврат Результат;
	
КонецФункции

Функция ВыгрузитьКодыВФайлXLSX(ПараметрыФайла)
	
	ТаблицаСтрок = ПараметрыФайла.ТаблицаСтрок;
	ДобавитьЗаголовкиКолонок = ПараметрыФайла.ДобавитьЗаголовкиКолонок;
	
	// Заменить символ разделителя группы GS (ASCII 29) на его номер,
	// чтобы избежать ошибки сериализации в xml
	Для каждого Стр Из ТаблицаСтрок Цикл
		Для каждого Колонка Из ТаблицаСтрок.Колонки Цикл
			Значение = Стр[Колонка.Имя];
			Если ТипЗнч(Значение) = Тип("Строка") Тогда
				Стр[Колонка.Имя] = СтрЗаменить(Значение, РазделительGS1(), "_x001D_");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТабДок = Новый ТабличныйДокумент;
	
	Построитель = Новый ПостроительОтчета;
	Построитель.ВыводитьОбщиеИтоги		 = Ложь;
	Построитель.ВыводитьПодвалОтчета	 = Ложь;
	Построитель.ВыводитьПодвалТаблицы	 = Ложь;
	Построитель.ВыводитьЗаголовокОтчета	 = Ложь;
	Построитель.ВыводитьШапкуТаблицы = ДобавитьЗаголовкиКолонок;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаСтрок);
	
	Для каждого Поле Из Построитель.ДоступныеПоля Цикл
		Колонка = ТаблицаСтрок.Колонки[Поле.Имя];
		Если ЗначениеЗаполнено(Колонка.Заголовок) Тогда
			Поле.Представление = Колонка.Заголовок;
		КонецЕсли;
	КонецЦикла;
	
	Настройки = Построитель.ПолучитьНастройки();
	Построитель.УстановитьНастройки(Настройки);
	
	Построитель.Вывести(ТабДок);
	
	ВсегоСтрок	 = ТабДок.ВысотаТаблицы;
	ВсегоКолонок = ТабДок.ШиринаТаблицы;
	
	Для Сч = 1 По ВсегоКолонок Цикл
		Колонка = ТабДок.Область(, Сч, ВсегоСтрок);
		Колонка.Очистить(Ложь, Истина, Истина);
		Колонка.ШиринаКолонки = 50;
	КонецЦикла;
	
	КолонкаОтступа = ТабДок.Область(, 1, ВсегоСтрок);
	ТабДок.УдалитьОбласть(КолонкаОтступа, ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	
	Результат = ДвоичныеДанныеИзТабличногоДокумента(ТабДок, ТипФайлаТабличногоДокумента.XLSX);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ТаблицаКодовДляВыгрузкиВФайл()
	
	Результат = Новый ТаблицаЗначений;
	
	ТипСтрока = ОписаниеТипа_Строка();
	
	Результат.Колонки.Добавить("КодМаркировки", ТипСтрока);
	Результат.Колонки.Добавить("ПолныйКод", ТипСтрока);
	Результат.Колонки.Добавить("GTIN", ТипСтрока);
	Результат.Колонки.Добавить("НаименованиеТовара", ТипСтрока);
	Результат.Колонки.Добавить("ПредставлениеНоменклатуры", ТипСтрока);
	Результат.Колонки.Добавить("ОписаниеОшибки", ТипСтрока);
	
	Результат.Колонки.Добавить("Товар", ОписаниеТипа_Товар());
	Результат.Колонки.Добавить("ТипУпаковки", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурМаркировка_ТипыУпаковок"));
	Результат.Колонки.Добавить("ТипШтрихкода", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурМаркировка_ТипыШтрихкодов"));
	Результат.Колонки.Добавить("ОбщийТипУпаковки", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурМаркировка_ОбщиеТипыУпаковок"));
	
	ТипыОбъектов = ТипыОбъектовИС();
	
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов(ТипыОбъектов.Номенклатура));
	Результат.Колонки.Добавить("Характеристика", Новый ОписаниеТипов(ТипыОбъектов.Характеристика));
	Результат.Колонки.Добавить("Упаковка", Новый ОписаниеТипов(ТипыОбъектов.Упаковка));
	Результат.Колонки.Добавить("Серия", Новый ОписаниеТипов(ТипыОбъектов.Серия));
	
	Возврат Результат;
	
КонецФункции

// Описание файла для сохранения кодов
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * ТаблицаСтрок             - ТаблицаЗначений - таблица строк с кодами,
//                                         которые нужно сохранить в файл;
//   * РазделительКолонок       - Строка - символ для разделения колонок, если файл CSV;
//   * ИмяФайлаБезРасширения    - Строка - имя файла без расширения;
//   * ДобавитьЗаголовкиКолонок - Булево - Истина, если в первую строку файла
//                                         нужно добавить заголовки колонок;
//
Функция Новый_ОписаниеФайлаДляВыгрузкиКодов() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТаблицаСтрок", Новый ТаблицаЗначений);
	Результат.Вставить("РазделительКолонок", Символы.Таб);
	Результат.Вставить("ДобавитьЗаголовкиКолонок", Ложь);
	Результат.Вставить("ИмяФайлаБезРасширения");
	
	Возврат Результат;
	
КонецФункции

