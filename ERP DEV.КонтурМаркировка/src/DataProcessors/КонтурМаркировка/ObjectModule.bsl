	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОписаниеФайла = Файл_Прочитать(Выборка.Файл);
		Если ЗначениеЗаполнено(ОписаниеФайла)
			И ТипЗнч(ОписаниеФайла.ДанныеФайла) = ТипТаблица Тогда
			ДанныеРедактора = Новый_ДанныеРедактораКодов();
			ДанныеРедактора.ТаблицаКодов = ОписаниеФайла.ДанныеФайла;
			РедакторКодов_ЗаписатьФайл(ОписаниеФайла.ВладелецФайла, ДанныеРедактора);
		КонецЕсли;
	КонецЦикла;
	
