// Создает глубокую копию объекта через сериализацию в хранилище значений
//
// Параметры:
//  Объект - Структура, Соответствие, Массив, СписокЗначений, ТаблицаЗначений - объект, который необходимо скопировать
//
// Возвращаемое значение:
//  Структура, Соответствие, Массив, СписокЗначений, ТаблицаЗначений - копия объекта
//
Функция СкопироватьОбъект(Объект) Экспорт
	
	Хранилище = Новый ХранилищеЗначения(Объект);
	
