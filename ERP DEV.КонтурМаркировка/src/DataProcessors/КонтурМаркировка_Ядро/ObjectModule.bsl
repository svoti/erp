// #Область Сертификаты

Функция Сертификаты_Найти(ОтпечатокСертификата) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Сертификаты КАК Т
	|ГДЕ
	|	Т.ОтпечатокСертификата = &ОтпечатокСертификата");
	Запрос.УстановитьПараметр("ОтпечатокСертификата", ОтпечатокСертификата);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "Ссылка");
	
КонецФункции

Функция Сертификаты_Записать(ОписаниеСертификата) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеСертификата.Ссылка) Тогда
			ПроверитьОбъектВПроцессеОбновления(ОписаниеСертификата.Ссылка);
			Объект = ОписаниеСертификата.Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.КонтурМаркировка_Сертификаты.СоздатьЭлемент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Объект, ОписаниеСертификата);
		
		Объект.Наименование = НаименованиеСертификата(ОписаниеСертификата);
		
		Объект.Записать();
		
		ОписаниеСертификата.Ссылка = Объект.Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Объект.Ссылка;
	
КонецФункции

Функция Новый_Сертификат() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("ВидСертификата");
	Результат.Вставить("ОтпечатокСертификата");
	Результат.Вставить("НаименованиеОрганизации");
	Результат.Вставить("ДатаВыдачи");
	Результат.Вставить("ДатаОкончания");
	Результат.Вставить("ФИО");
	Результат.Вставить("ИНН");
	Результат.Вставить("КПП");
	Результат.Вставить("Издатель");
	Результат.Вставить("Должность");
	
	Возврат Результат;
	
КонецФункции

Функция СрокДействияСертификатаИстек(ДатаОкончания) Экспорт
	
	Результат = ДатаОкончания < НачалоДня(ТекущаяДатаСеанса());
	
	Возврат Результат;
	
КонецФункции

Функция СрокДействияСертификатаЗаканчивается(ДатаОкончания) Экспорт
	
	ДатаПредупреждения = ДатаОкончания - СрокПредупрежденияОбОкончанииСертификата();
	
	Результат = ДатаПредупреждения < ТекущаяДатаСеанса();
	
	Возврат Результат;
	
КонецФункции

Функция СрокПредупрежденияОбОкончанииСертификата() Экспорт
	
	КоличествоСуток = 30;
	
	Возврат КоличествоСуток * СекундВСутках();
	
КонецФункции

Функция НаименованиеСертификата(ОписаниеСертификата)
	
	СоставНаименования = Новый Массив;
	СоставНаименования.Добавить(ОписаниеСертификата.ФИО);
	
	Если ЗначениеЗаполнено(ОписаниеСертификата.НаименованиеОрганизации)
		И ОписаниеСертификата.ФИО <> ОписаниеСертификата.НаименованиеОрганизации Тогда
		СоставНаименования.Добавить(ОписаниеСертификата.НаименованиеОрганизации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеСертификата.Должность) Тогда
		СоставНаименования.Добавить(ОписаниеСертификата.Должность);
	КонецЕсли;
	
	ШаблонНаименования = НСтр("ru = '%1, до %2'");
	
	Результат = ПараметрыВСтроку(ШаблонНаименования
	, СоединитьСтроку(СоставНаименования, ", ")
	, Формат(ОписаниеСертификата.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Сертификаты

// #Область НастройкиПодписания

Процедура НастройкаПодписания_Записать(Сертификат, Организация, Пользователь) Экспорт
	
	НоваяЗапись = Не ЗначениеЗаполнено(НастройкаПодписания_Сертификат(Организация, Пользователь));
	Если НоваяЗапись И Сертификат.ВидСертификата = Перечисление_ВидыСертификатов().НаФизЛицо Тогда
		Метрика_Функциональность_ДобавлениеСертификатаПоДоверенности(Организация);
	КонецЕсли;
	
	Запись = РегистрыСведений.КонтурМаркировка_НастройкиПодписания.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователь;
	Запись.Организация = Организация;
	Запись.Сертификат = Сертификат;
	Запись.Записать();
	
КонецПроцедуры

Процедура НастройкаПодписания_Удалить(Организация, Пользователь = Неопределено) Экспорт
	
	Запись = РегистрыСведений.КонтурМаркировка_НастройкиПодписания.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	Запись.Пользователь = Пользователь;
	
	Запись.Удалить();
	
КонецПроцедуры

Функция НастройкаПодписания_Сертификат(Организация, Пользователь = Неопределено) Экспорт
	
	Если Пользователь = Неопределено Тогда
		Пользователь = Справочники.КонтурМаркировка_Пользователи.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Сертификат КАК Сертификат
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_НастройкиПодписания КАК Т
	|ГДЕ
	|	Т.Организация = &Организация
	|	И Т.Пользователь = &Пользователь");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "Сертификат");
	
КонецФункции

Функция НастройкиПодписания_Сертификаты() Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Сертификат КАК Сертификат
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_НастройкиПодписания КАК Т");
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "Сертификат");
	
КонецФункции

Функция НастройкаПодписания_ПодобратьСертификат(Организация) Экспорт
	
	Результат = НастройкаПодписания_Сертификат(Организация, ТекущийПользовательМаркировки());
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = НастройкаПодписания_Сертификат(Организация);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

