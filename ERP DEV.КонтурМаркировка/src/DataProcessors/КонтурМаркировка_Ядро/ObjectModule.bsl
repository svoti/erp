// Записывает в доп справочник настройки документа учета
//
// Параметры:
//  Настройки - Структура - см. Новый_НастройкиДокументаУчета()
//
Процедура НастройкиДокументаУчета_Записать(Настройки) Экспорт
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().НастройкиДокументаУчета;
	
	ДанныеИБ = Новый_ЭлементДопСправочника(ИмяСправочника);
	ДанныеИБ.Ссылка = Настройки.Ссылка;
	ДанныеИБ.Наименование = Настройки.Наименование;
	
	Для Каждого Элемент Из Настройки Цикл
		Если Элемент.Ключ <> "Ссылка" И Элемент.Ключ <> "Наименование" Тогда
			ДанныеИБ.ДопРеквизиты.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Настройки.Ссылка = ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

