// Устанавливает объектную блокировку и помещает объект в кэш
//
// Параметры:
//  Ссылка - СправочникСсылка, ДокументСсылка - ссылка на объект базы данных
// 
// Возвращаемое значение:
//  Булево - Истина, если объект удалось заблокировать
//
Функция ЗанятьОбъект(Ссылка) Экспорт
	
	КлючКэш = "ЗанятыеОбъекты";
	ЗанятыеОбъекты = Кэш_Прочитать(КлючКэш);
	Если ЗанятыеОбъекты = Неопределено Тогда
		ЗанятыеОбъекты = Новый Соответствие;
		Кэш_Поместить(КлючКэш, ЗанятыеОбъекты);
	КонецЕсли;
	
	Если ЗанятыеОбъекты[Ссылка] <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		ЗанятыйОбъект = Ссылка.ПолучитьОбъект();
		ЗанятыйОбъект.Заблокировать();
		ЗанятыеОбъекты.Вставить(Ссылка, ЗанятыйОбъект);
		Результат = Истина;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Снимает объектную блокировку и удаляет объект из кэша
//
// Параметры:
//  Ссылка - СправочникСсылка, ДокументСсылка - ссылка на объект базы данных
//
Процедура ОсвободитьОбъект(Ссылка) Экспорт
	
	КлючКэш = "ЗанятыеОбъекты";
	ЗанятыеОбъекты = Кэш_Прочитать(КлючКэш);
	Если Не ЗначениеЗаполнено(ЗанятыеОбъекты) Тогда
		Возврат;
	КонецЕсли;
	
	ЗанятыйОбъект = ЗанятыеОбъекты[Ссылка];
	Если ЗанятыйОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗанятыйОбъект.Разблокировать();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	ЗанятыеОбъекты.Удалить(Ссылка);
	
КонецПроцедуры

// Устанавливает блокировку на объект базы данных по указанным полям
//
// Параметры:
//  ИмяОбъекта - Строка - полное имя объекта, который нужно заблокировать;
//  Значения - Структура - содержит имена полей объекта и значения, по которым нужно заблокировать;
//
Процедура ЗаблокироватьПоЗначениям(ИмяОбъекта, Значения) Экспорт
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		ЗаблокироватьПоЗначениямДляИзменения(ИмяОбъекта, Значения);
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(ИмяОбъекта);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для Каждого Элемент Из Значения Цикл
		ЭлементБлокировки.УстановитьЗначение(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

// Устанавливает блокировку на объекты базы данных указанные в таблице
//
// Параметры:
//  ИменаОбъектов - Массив, Строка - полные имена объектов, которые нужно заблокировать;
//  Поле - Строка - поле объекта, по которому нужно заблокировать;
//  ИсточникДанных - ТаблицаЗначений, РезультатЗапроса - коллекция с данными для блокировки;
//  ИмяКолонки - Строка - (необязательный) имя колонки, в которой указаны значения для блокировки;
//
Процедура ЗаблокироватьПоТаблице(ИменаОбъектов, Поле, ИсточникДанных, Знач ИмяКолонки = Неопределено)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		ЗаблокироватьПоТаблицеДляИзменения(ИменаОбъектов, Поле, ИсточникДанных, ИмяКолонки);
		Возврат;
	КонецЕсли;
	
	Если ИмяКолонки = Неопределено Тогда
		ИмяКолонки = Поле;
	КонецЕсли;
	
	Если ТипЗнч(ИсточникДанных) = Тип("РезультатЗапроса") Тогда
		Таблица = ИсточникДанных.Выгрузить(ОбходРезультатаЗапроса.Прямой).Скопировать(, ИмяКолонки);
	Иначе
		Таблица = ИсточникДанных.Скопировать(, ИмяКолонки);
	КонецЕсли;
	Таблица.Свернуть(ИмяКолонки);
	ТаблицаЗначений_УдалитьПустыеСтроки(Таблица, ИмяКолонки);
	
	Блокировка = Новый БлокировкаДанных;
	
	Для каждого ИмяОбъекта Из ЗначениеВМассиве(ИменаОбъектов) Цикл
		ЭлементБлокировки = Блокировка.Добавить(ИмяОбъекта);
		ЭлементБлокировки.ИсточникДанных = Таблица;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных(Поле, ИмяКолонки);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

// Устанавливает в базе автоматическую блокировку "ДЛЯ ИЗМЕНЕНИЯ" на объекты базы данных указанные в таблице
//
// Параметры:
//  ИменаОбъектов - Массив, Строка - полные имена объектов, которые нужно заблокировать;
//  Поле - Строка - поле объекта, по которому нужно заблокировать;
//  ИсточникДанных - ТаблицаЗначений, РезультатЗапроса - коллекция с данными для блокировки;
//  ИмяКолонки - Строка - (необязательный) имя колонки, в которой указаны значения для блокировки;
//
Процедура ЗаблокироватьПоТаблицеДляИзменения(ИменаОбъектов, Поле, ИсточникДанных, Знач ИмяКолонки = Неопределено)
	
	Если Не ИспользуетсяАвтоматическийРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяКолонки = Неопределено Тогда
		ИмяКолонки = Поле;
	КонецЕсли;
	
	Если ТипЗнч(ИсточникДанных) = Тип("РезультатЗапроса") Тогда
		Таблица = ИсточникДанных.Выгрузить(ОбходРезультатаЗапроса.Прямой).Скопировать(, ИмяКолонки);
	Иначе
		Таблица = ИсточникДанных.Скопировать(, ИмяКолонки);
	КонецЕсли;
	
	Значения = ТаблицаЗначений_ВыгрузитьКолонку(Таблица, ИмяКолонки, Истина);
	Таблица.Очистить();
	
	ТекстыЗапросов = Новый Массив;
	Для каждого ИмяОбъекта Из ЗначениеВМассиве(ИменаОбъектов) Цикл
		ТекстЗапроса = "ВЫБРАТЬ ИСТИНА КАК Поле ИЗ Объект КАК Т ГДЕ Т.Поле В(&Значения) ДЛЯ ИЗМЕНЕНИЯ";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Объект", ИмяОбъекта);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Поле", "Т." + Поле);
		ТекстыЗапросов.Добавить(ТекстЗапроса);
	КонецЦикла;
	
	Запрос = Новый Запрос(СоединитьСтроку(ТекстыЗапросов, РазделительПакетаЗапроса()));
	Запрос.УстановитьПараметр("Значения", Значения);
	Запрос.Выполнить();
	
КонецПроцедуры

// Устанавливает автоматическую блокировку "ДЛЯ ИЗМЕНЕНИЯ" на объект базы данных по указанным полям
//
// Параметры:
//  ИмяОбъекта - Строка - полное имя объекта, который нужно заблокировать;
//  Значения - Структура - содержит имена полей объекта и значения, по которым нужно заблокировать;
//
Процедура ЗаблокироватьПоЗначениямДляИзменения(ИмяОбъекта, Значения)
	
	Если Не ИспользуетсяАвтоматическийРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ ИСТИНА КАК Поле ИЗ Объект КАК Т ГДЕ &Условия ДЛЯ ИЗМЕНЕНИЯ";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Объект", ИмяОбъекта);
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Условия = "";
	Разделитель = "";
	Для Каждого Элемент Из Значения Цикл
		Условия = Условия + Разделитель + "Т." + Элемент.Ключ + " = &" + Элемент.Ключ;
		Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение);
		Разделитель = " И ";
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условия", Условия);
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Проверяет, что версия программы поддерживает поля блокировки данных
