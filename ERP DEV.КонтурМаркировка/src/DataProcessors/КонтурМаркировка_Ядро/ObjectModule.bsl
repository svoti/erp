Процедура ЗаписатьТекстВФайл(Текст, ИмяФайла, Каталог = "")
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Каталог) Тогда
		ПутьКФайлу = МодульОбщегоНазначения().ОбъединитьПути(Каталог, ИмяФайла);
	Иначе
		ПутьКФайлу = ИмяФайла;
	КонецЕсли;
	
	Запись = НовыйЗаписьТекста(ПутьКФайлу);
	Запись.ЗаписатьСтроку(Текст);
	Запись.Закрыть();
	
КонецПроцедуры

Функция ИменаПолейРегистраСведений(ИмяРегистра, Исключения = "")
	
	КлючКэш = "ИменаПолейРегистраСведений: " + ИмяРегистра + ", Исключения: " + Исключения;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПометкаУдаления = "Удалить";
	ПоляИсключений = РазделитьСтроку(Исключения);
	МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
	
	КоллекцииПолей = Новый Массив;
	КоллекцииПолей.Добавить(МетаданныеРегистра.Измерения);
	КоллекцииПолей.Добавить(МетаданныеРегистра.Ресурсы);
	КоллекцииПолей.Добавить(МетаданныеРегистра.Реквизиты);
	
	ИменаПолей = Новый Массив;
	Для Каждого Поля Из КоллекцииПолей Цикл
		Для Каждого Поле Из Поля Цикл
			Если Найти(Поле.Имя, ПометкаУдаления) <> 1
				И Не МассивСодержитЗначение(ПоляИсключений, Поле.Имя) Тогда
				ИменаПолей.Добавить(Поле.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Результат = СоединитьСтроку(ИменаПолей, ", ");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

