// #Область ВозвратВОборот

Функция ОчередьОбмена_ВозвратВОборот_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеВозвратВОборот);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодовПослеВозвратаВОборот);
	
	Возврат Результат;
	
КонецФункции

Функция ОчередьОбмена_ВозвратВОборотНаТСД_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеВозвратВОборотНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодовПослеВозвратаВОборот);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ВозвратВОборот_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеВозвратВОборотНаТСД Тогда
		Задача_ВозвратВОборотНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеВозвратВОборот Тогда
		Задача_ВозвратВОборот_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиВозвратаВОборот Тогда
		Задача_ВозвратВОборот_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ВозвратВОборот_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусВозвратаВОборот Тогда
		Задача_ВозвратВОборот_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСтатусыКодовПослеВозвратаВОборот Тогда
		Задача_ОбновитьСтатусыКодовЗавершитьОперацию(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ВозвратВОборотНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ВозвратВОборотНаТСД(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ВозвратВОборот_СоздатьЧерновик(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусВозвратаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленНаТСД;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВозвратВОборот(ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ВозвратВОборот_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ВозвратВОборот(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ВозвратВОборот_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьКонтентДляПодписиВозвратаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВозвратВОборот(ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ВозвратВОборот_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ВозвратВОборот_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ВозвратВОборот_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ВозвратВОборот_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусВозвратаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ВозвратВОборот_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовоеДействие = Неопределено;
		НовыйСтатус = СтатусыОпераций.СозданВСервисе;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		НовыйСтатус = СтатусыОпераций.ОтправленВАрхив;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПолучитьКонтентДляПодписиВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ГотовКОтправкеВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Processing")
		Или НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ОбрабатываетсяВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодовПослеВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
		
	ИначеЕсли Задача_ВозвратВОборот_СтатусОшибка(СтатусДокумента) Тогда
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Sending")
		Или НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусВозвратаВОборот;
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус возврата в оборот: %1'"), СтатусДокумента);
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Функция Задача_ВозвратВОборот_СтатусОшибка(Статус)
	
	СтатусыОшибки = Новый Соответствие;
	СтатусыОшибки.Вставить(НРег("ProcessedError"), Истина);
	СтатусыОшибки.Вставить(НРег("CrptProcessedError"), Истина);
	СтатусыОшибки.Вставить(НРег("SendingError"), Истина);
	СтатусыОшибки.Вставить(НРег("CrptSendingError"), Истина);
	
	Возврат (СтатусыОшибки[НРег(Статус)] = Истина);
	
КонецФункции

// #КонецОбласти // ВозвратВОборот

// #Область ОтчетОВыбытии

Функция ОчередьОбмена_ОтчетОВыбытии_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеОтчетОВыбытииНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКодыОтчетаОВыбытииНаТСД);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеВыбытиеКодов);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписиВыбытияКодов);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодовПослеВыбытия);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ОтчетОВыбытии_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеОтчетОВыбытииНаТСД Тогда
		Задача_ОтчетОВыбытииНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКодыОтчетаОВыбытииНаТСД Тогда
		Задача_ОтчетОВыбытииНаТСД_ПолучитьКоды(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеВыбытиеКодов Тогда
		Задача_ОтчетОВыбытии_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписиВыбытияКодов Тогда
		Задача_ОтчетОВыбытии_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ОтчетОВыбытии_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьВыбытияКодов Тогда
		Задача_ОтчетОВыбытии_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСтатусыКодовПослеВыбытия Тогда
		Задача_ОбновитьСтатусыКодовЗавершитьОперацию(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытии_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ОтчетОВыбытии(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытии_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиВыбытияКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытии_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытии_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.documentId;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытии_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытии_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьВыбытияКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытии_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов;
		
		ТипОперации = ЗначениеРеквизитаОбъектаЛок(ОписаниеЗадачи.Операция, "ТипОперации");
		
		Если ТипОперации = ТипыОпераций.ОтчетОВыбытииНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		КонецЕсли;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьКодыОтчетаОВыбытииНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending")
		Или НРег(СтатусДокумента) = НРег("Sending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing")
		Или НРег(СтатусДокумента) = НРег("Processing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВыбытияКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("ProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
		НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодовПослеВыбытия;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("SendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус выбытия кодов: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ОтчетОВыбытии

// #Область ОтчетОВыбытииНаТСД

Процедура Задача_ОтчетОВыбытииНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ОтчетОВыбытииНаТСД(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытии_Создать(ОписаниеЗадачи, Контент, Истина);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьВыбытияКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ОтчетОВыбытииНаТСД(Организация);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытииНаТСД_ПолучитьКоды(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	
	Попытка
		Ответ = Маркировка_ОтчетОВыбытииНаТСД_Результат(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Контент = Ответ.Результат;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ТаблицаКодов = Задача_ОтчетОВыбытииНаТСД_ТаблицаКодов(Операция, Контент.positions);
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, Ложь) Тогда
		Задача_ОтчетОВыбытииНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов);
	Иначе
		Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ОтчетОВыбытииНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов)
	
	Операция = ОписаниеЗадачи.Операция;
	ДокументУчета = ЗначениеРеквизитаОбъектаЛок(Операция, "ДокументУчета");
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов_ЗаполнитьПоДокументуКлючиНоменклатуры1С(ТаблицаКодов, ДокументУчета);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		ПолныеКоды_Записать(ТаблицаКодов);
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиВыбытияКодов;
		Задача_Записать(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Задача_ОтчетОВыбытииНаТСД_ТаблицаКодов(Операция, positions)
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	НомерСтроки = 0;
	Для Каждого position Из positions Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрТовара = ОписаниеОперации.Товары.Найти(НомерСтроки, "НомерСтроки");
		Если СтрТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		codes = СвойствоСтруктуры(position, "codes");
		Если Не ЗначениеЗаполнено(codes) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого code Из codes Цикл
			Стр = ТаблицаКодов.Добавить();
			Стр.ПолныйКод = code;
			Стр.КодМаркировки = code;
			Стр.КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
			Стр.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
			Стр.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаКодов);
	
	Возврат ТаблицаКодов;
	
КонецФункции

// #КонецОбласти // ОтчетОВыбытииНаТСД

// #Область Перемаркировка

Функция ОчередьОбмена_Перемаркировка_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьСтрокиПеремаркировки);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеПеремаркировку);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписиПеремаркировки);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьПеремаркировки);
	Результат.Добавить(ТребуемыеДействия.ПроверитьРегистрациюСтрокПеремаркировки);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_Перемаркировка_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьСтрокиПеремаркировки Тогда
		Задача_Перемаркировка_СоздатьСтрокиПеремаркировки(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеПеремаркировку Тогда
		Задача_Перемаркировка_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписиПеремаркировки Тогда
		Задача_Перемаркировка_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_Перемаркировка_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьПеремаркировки Тогда
		Задача_Перемаркировка_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьРегистрациюСтрокПеремаркировки Тогда
		Задача_Перемаркировка_ПроверитьСтатусыСтрок(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Перемаркировка_СоздатьСтрокиПеремаркировки(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	Если Не КодыОпераций_ЕстьКоды(Операция) Тогда
		ТекстОшибки = НСтр("ru = 'Перемаркировка не содержит кодов'");
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиПеремаркировки;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипОпераций, Истина);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если КодыОпераций_ЕстьКоды(Операция, Стр.КлючСтрокиОперации) Тогда
			Операция_СоздатьРегистрациюСтрокиПеремаркировки(ОписаниеОперации, Стр);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьРегистрациюСтрокПеремаркировки;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_Перемаркировка(Организация);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	
КонецПроцедуры

Процедура Задача_Перемаркировка_ПроверитьСтатусыСтрок(ОписаниеЗадачи)
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиПеремаркировки;
	ВсеЗадачиЗавершены = Задача_ВсеПодчиненныеОперацииЗавершены(ОписаниеЗадачи.Операция, ТипОпераций);
	Если Не ВсеЗадачиЗавершены Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиВПодчиненных = Задача_ЕстьОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
	
	Если ЕстьОшибкиВПодчиненных Тогда
		
		ВсеОшибки = Задача_ОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = СоединитьСтроку(ВсеОшибки, Символы.ПС);
		Задача_Записать(ОписаниеЗадачи);
		
	Иначе
		Задача_Завершить(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Перемаркировка_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_Перемаркировка(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_Перемаркировка_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиПеремаркировки;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_Перемаркировка_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_Перемаркировка_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.documentId;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Перемаркировка_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_Перемаркировка_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьПеремаркировки;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_Перемаркировка_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = Неопределено;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("SentForApprove") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаПодтверждение;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьПеремаркировки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing")
		Или НРег(СтатусДокумента) = НРег("Processing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьПеремаркировки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Approved")
		Или НРег(СтатусДокумента) = НРег("Archived")
		Или НРег(СтатусДокумента) = НРег("crptProcessedSuccess")Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("crptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус перемаркировки: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // Перемаркировка

// #Область РегистрацияНаборов

Функция ОчередьОбмена_РегистрацияНаборов_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	
	Результат.Добавить(ТребуемыеДействия.ЗарезервироватьПартии);
	Результат.Добавить(ТребуемыеДействия.СоздатьПодчиненныеОперации);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_РегистрацияНаборов_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ЗарезервироватьПартии Тогда
		ОчередьОбмена_РезервированиеПартий_Создать(ОписаниеЗадачи);
	
	ИначеЕсли Действие = Действия.СоздатьПодчиненныеОперации Тогда
		Задача_РегистрацияНаборов_СоздатьСтрокиРегистрацииНаборов(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_РегистрацияНаборов_СоздатьСтрокиРегистрацииНаборов(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	Если Не КодыОпераций_ЕстьКоды(Операция) Тогда
		ТекстОшибки = НСтр("ru = 'Регистрация наборов не содержит кодов'");
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиНаборов;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(ОписаниеЗадачи.Операция, ТипОпераций, Истина);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если КодыОпераций_ЕстьКоды(Операция, Стр.КлючСтрокиОперации) Тогда
			Операция_СоздатьРегистрациюСтрокиНабора(ОписаниеОперации, Стр);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьПодчиненныеОперации;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	
КонецПроцедуры

// #КонецОбласти // РегистрацияНаборов

// #Область НаполнениеНаборовНаТСД

Функция ОчередьОбмена_НаполнениеНаборовНаТСД_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	
	Результат.Добавить(ТребуемыеДействия.ЗарезервироватьПартии);
	
	Результат.Добавить(ТребуемыеДействия.ОтправитьВСервис);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	
	Результат.Добавить(ТребуемыеДействия.ПолучитьКодыИзСервиса);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодов);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_НаполнениеНаборовНаТСД_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ЗарезервироватьПартии Тогда
		ОчередьОбмена_РезервированиеПартий_Создать(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьВСервис Тогда
		Задача_ФормированиеНаборов_ОтправитьВСервис(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписи Тогда
		Задача_ФормированиеНаборов_ПолучитьФайлДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ФормированиеНаборов_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКодыИзСервиса Тогда
		Задача_НаполнениеНаборовНаТСД_ПолучитьКодыИзСервиса(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСтатусыКодов Тогда
		Задача_ФормированиеНаборов_ОбновитьСтатусыКодов(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_НаполнениеНаборовНаТСД_ПолучитьКодыИзСервиса(ОписаниеЗадачи)
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ДокументУчета = Операция.ДокументУчета;
	ОбщийТипУпаковкиНабор = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.ОбщийТипУпаковки <> ОбщийТипУпаковкиНабор Тогда
			Стр.КодАгрегата = "";
			Стр.КлючАгрегата = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КодМаркировки");
	
	ТаблицаНовыхКодов = Новый_ТаблицаКодов();
	
	Для каждого СтрНабора Из ТаблицаКодов Цикл
		
		Если СтрНабора.ОбщийТипУпаковки <> ОбщийТипУпаковкиНабор Тогда
			Продолжить;
		КонецЕсли;
		
		КодНабора = СтрНабора.КодМаркировки;
		
		Попытка
			ВложенныеКоды = Маркировка_ВложенныеКодыАгрегата(КодНабора, Организация);
		Исключение
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
			Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
			Продолжить;
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ВложенныеКоды) Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаНовыхКодовНабора = ТаблицаКодов_ЗагрузитьКодыМаркировки(ВложенныеКоды);
		
		Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаНовыхКодовНабора, Организация) Тогда
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, НСтр("ru = 'Не удалось нормализовать коды набора'"));
			Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		КонецЕсли;
		
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаНовыхКодовНабора);
		
		Для каждого Стр Из ТаблицаНовыхКодовНабора Цикл
			СтрКода = ТаблицаКодов.Найти(Стр.КодМаркировки, "КодМаркировки");
			Если СтрКода = Неопределено Тогда
				СтрКода = ТаблицаНовыхКодов.Добавить();
				ЗаполнитьЗначенияСвойств(СтрКода, Стр);
			КонецЕсли;
			СтрКода.КодАгрегата = КодНабора;
			СтрКода.УдалитьИзДокумента = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КодМаркировки");
	
	ТаблицаЗначений_Дополнить(ТаблицаКодов, ТаблицаНовыхКодов);
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОбновлениеСтатусовКодов;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		Задача_Записать(ОписаниеЗадачи);
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
			ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Задача_НаполнениеНаборовНаТСД_ВернутьНаТСД(ОписаниеЗадачи, Комментарий)
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ИсправитьОшибку Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ВозвратНаполненияНаборовНаТСД(Комментарий);
	
	Попытка
		Ответ = Маркировка_ФормированиеНаборов_ВернутьНаТСД(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ВозвращенНаТСД;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВозвратНаполненияНаборовНаТСД(Организация);
	
КонецПроцедуры

// #КонецОбласти // НаполнениеНаборовНаТСД

// #Область РегистрацияСтрокиНаборов

Функция ОчередьОбмена_РегистрацияСтрокиНаборов_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	
	Результат.Добавить(ТребуемыеДействия.ОтправитьВСервис);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодов);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_РегистрацияСтрокиНаборов_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ОтправитьВСервис Тогда
		Задача_ФормированиеНаборов_ОтправитьВСервис(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписи Тогда
		Задача_ФормированиеНаборов_ПолучитьФайлДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ФормированиеНаборов_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСтатусыКодов Тогда
		Задача_ФормированиеНаборов_ОбновитьСтатусыКодов(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // РегистрацияСтрокиНаборов

// #Область ФормированиеНаборовВСервисе

Процедура Задача_ФормированиеНаборов_ПроверитьРезервированиеПартий(ОписаниеЗадачи)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ОперацииРезервирования = Операция_НайтиПодчиненныеОперации(ОписаниеЗадачи.Операция, ТипыОпераций.РезервированиеПартий);
	ПоследнееРезервирование = ОперацииРезервирования[ОперацииРезервирования.ВГраница()];
	ЗадачаРезервирования = Задача_Прочитать(ПоследнееРезервирование);
	
	Если ЗадачаРезервирования.ТребуемоеДействие = ТребуемыеДействия.ОперацияЗавершена
		Или ЗадачаРезервирования.ТребуемоеДействие = ТребуемыеДействия.ПринятЧастично Тогда
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОтправкаВСервис;
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОтправитьВСервис;
		Если ОписаниеЗадачи.ТипОперации = ТипыОпераций.РегистрацияНаборов Тогда
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.СоздатьПодчиненныеОперации;
		КонецЕсли;
		Задача_Записать(ОписаниеЗадачи);
	КонецЕсли;
	
	Если ЗадачаРезервирования.ТребуемоеДействие = ТребуемыеДействия.ИсправитьОшибку Тогда
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ЗадачаРезервирования.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ОтправитьВСервис(ОписаниеЗадачи)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	НаполнитьНаТСД = (ОписаниеЗадачи.ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД);
	
	Если НаполнитьНаТСД Тогда
		Контент = Контент_НаполнениеНаборовНаТСД(ОписаниеОперации);
		НовыйСтатусОперации = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
	Иначе
		Контент = Контент_РегистрацияНаборов(ОписаниеОперации);
		НовыйСтатусОперации = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписи;
	КонецЕсли;
	
	Попытка
		Ответ = Маркировка_ФормированиеНаборов_Создать(ОписаниеЗадачи, Контент, НаполнитьНаТСД);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатусОперации;
	Задача_Записать(ОписаниеЗадачи);
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
		Метрика_Функциональность_НаполнениеНаборовНаТСД(Организация);
	Иначе
		Метрика_Функциональность_РегистрацияНаборов(Организация);
	КонецЕсли;
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ПолучитьФайлДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ФормированиеНаборов_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ФормированиеНаборов_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОжиданиеСобытийИзСервиса;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ПроверитьСтатусВСервисе(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусДокумента = Ответ.Результат.Статус;
	ТекстОшибки = Ответ.Результат.Комментарий;
	
	ТипОперации = ОписаниеЗадачи.ТипОперации;
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	НовыйСтатус = "";
	НовоеДействие = "";
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		Если ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
			НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		КонецЕсли;
	
	ИначеЕсли НРег(СтатусДокумента) = НРег("tsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Completed") Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписи;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("readyForSend") Тогда
		
		Если ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		КонецЕсли;
		
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписи;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("crptProcessedSuccess") Тогда
		
		Если ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.ПолучениеКодовИзСервиса;
			НовоеДействие = ТребуемыеДействия.ПолучитьКодыИзСервиса;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
			НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодов;
		КонецЕсли;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedError")
		Или НРег(СтатусДокумента) = НРег("Failed") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ФормированиеНаборов_ОбновитьСтатусыКодов(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ТипОперации = ОписаниеЗадачи.ТипОперации;
	Организация = ОписаниеЗадачи.Организация;
	ОперацияОснование = ОписаниеЗадачи.ОперацияОснование;
	КлючСтрокиОперации = ОписаниеЗадачи.КлючСтрокиОперацииОснования;
	
	Если ТипОперации = Перечисление_ТипыОпераций().НаполнениеНаборовНаТСД Тогда
		ТаблицаКодов = КодыОпераций_ТаблицаКодов(Операция);
	Иначе
		ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, КлючСтрокиОперации);
	КонецЕсли;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация, Истина);
	
	Задача_Завершить(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ФормированиеНаборовВСервисе

// #Область РегистрацияКИГУ

Функция ОчередьОбмена_РегистрацияКИГу_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьПодчиненныеОперации);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_РегистрацияКИГу_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьПодчиненныеОперации Тогда
		Задача_РегистрацияКИГУ_СоздатьПодчиненныеОперации(ОписаниеЗадачи);
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_РегистрацияКИГУ_СоздатьПодчиненныеОперации(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиКИГУ;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипОпераций, Истина);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если КодыОпераций_ЕстьКоды(Операция, Стр.КлючСтрокиОперации) Тогда
			Операция_СоздатьРегистрациюСтрокиКИГУ(ОписаниеОперации, Стр);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьПодчиненныеОперации;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	Метрика_Функциональность_РегистрацияКИГУ(Организация);
	
КонецПроцедуры

// #КонецОбласти // РегистрацияКИГУ

// #Область РегистрацияСтрокиКИГУ

Функция ОчередьОбмена_РегистрацияСтрокиКИГУ_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ОтправитьВСервис);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодов);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_РегистрацияСтрокиКИГУ_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ОтправитьВСервис Тогда
		Задача_ФормированиеКИГУ_ОтправитьВСервис(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписи Тогда
		Задача_ФормированиеКИГУ_ПолучитьФайлДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ФормированиеКИГУ_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСтатусыКодов Тогда
		Задача_ФормированиеКИГУ_ОбновитьСтатусыКодов(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // РегистрацияСтрокиКИГУ

// #Область НаполнениеКИГУНаТСД

Функция ОчередьОбмена_НаполнениеКИГУНаТСД_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ОтправитьВСервис);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКодыИзСервиса);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодов);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_НаполнениеКИГУНаТСД_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ОтправитьВСервис Тогда
		Задача_ФормированиеКИГУ_ОтправитьВСервис(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписи Тогда
		Задача_ФормированиеКИГУ_ПолучитьФайлДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ФормированиеКИГУ_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКодыИзСервиса Тогда
		Задача_НаполнениеКИГУНаТСД_ПолучитьКодыИзСервиса(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСтатусыКодов Тогда
		Задача_ФормированиеКИГУ_ОбновитьСтатусыКодов(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_НаполнениеКИГУНаТСД_ПолучитьКодыИзСервиса(ОписаниеЗадачи)
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ДокументУчета = Операция.ДокументУчета;
	ГрупповаяУпаковка = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ГрупповаяУпаковка;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.ОбщийТипУпаковки <> ГрупповаяУпаковка Тогда
			Стр.КодАгрегата = "";
			Стр.КлючАгрегата = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КодМаркировки");
	
	ТаблицаНовыхКодов = Новый_ТаблицаКодов();
	
	Для каждого СтрКИГУ Из ТаблицаКодов Цикл
		
		Если СтрКИГУ.ОбщийТипУпаковки <> ГрупповаяУпаковка Тогда
			Продолжить;
		КонецЕсли;
		
		КодКИГУ = СтрКИГУ.КодМаркировки;
		
		Попытка
			ВложенныеКоды = Маркировка_ВложенныеКодыАгрегата(КодКИГУ, Организация);
		Исключение
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
			Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
			Продолжить;
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ВложенныеКоды) Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаНовыхКИГУ = ТаблицаКодов_ЗагрузитьКодыМаркировки(ВложенныеКоды);
		
		Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаНовыхКИГУ, Организация) Тогда
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, НСтр("ru = 'Не удалось нормализовать коды КИГУ'"));
			Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		КонецЕсли;
		
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаНовыхКИГУ);
		
		Для каждого Стр Из ТаблицаНовыхКИГУ Цикл
			СтрКода = ТаблицаКодов.Найти(Стр.КодМаркировки, "КодМаркировки");
			Если СтрКода = Неопределено Тогда
				СтрКода = ТаблицаНовыхКодов.Добавить();
				ЗаполнитьЗначенияСвойств(СтрКода, Стр);
			КонецЕсли;
			СтрКода.КодАгрегата = КодКИГУ;
			СтрКода.УдалитьИзДокумента = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КодМаркировки");
	
	ТаблицаЗначений_Дополнить(ТаблицаКодов, ТаблицаНовыхКодов);
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОбновлениеСтатусовКодов;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		Задача_Записать(ОписаниеЗадачи);
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
			ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Задача_НаполнениеКИГУНаТСД_ВернутьНаТСД(ОписаниеЗадачи, Комментарий)
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ИсправитьОшибку Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ВозвратНаполненияКИГУНаТСД(Комментарий);
	
	Попытка
		Ответ = Маркировка_ФормированиеКИГУ_ВернутьНаТСД(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ВозвращенНаТСД;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВозвратНаполненияКИГУНаТСД(Организация);
	
КонецПроцедуры

// #КонецОбласти // НаполнениеКИГУНаТСД

// #Область ФормированиеКИГУВСервисе

Процедура Задача_ФормированиеКИГУ_ОтправитьВСервис(ОписаниеЗадачи)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.НаполнениеКИГУНаТСД Тогда
		Контент = Контент_НаполнениеКИГУНаТСД(ОписаниеОперации);
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		НовыйСтатусОперации = СтатусыОпераций.ОтправленНаТСД;
	Иначе
		Контент = Контент_РегистрацияКИГУ(ОписаниеОперации);
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписи;
		НовыйСтатусОперации = СтатусыОпераций.ОтправленВСервис;
	КонецЕсли;
	
	Попытка
		Ответ = Маркировка_ФормированиеКИГУ_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатусОперации;
	Задача_Записать(ОписаниеЗадачи);
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.НаполнениеКИГУНаТСД Тогда
		Метрика_Функциональность_НаполнениеКИГУНаТСД(Организация);
	Иначе
		Метрика_Функциональность_РегистрацияКИГУ(Организация);
	КонецЕсли;
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ФормированиеКИГУ_ПолучитьФайлДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ФормированиеКИГУ_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ФормированиеКИГУ_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ФормированиеКИГУ_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОжиданиеСобытийИзСервиса;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ФормированиеКИГУ_ПроверитьСтатусВСервисе(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусДокумента = Ответ.Результат.Статус;
	ТекстОшибки = Ответ.Результат.Комментарий;
	
	ТипОперации = ОписаниеЗадачи.ТипОперации;
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	НовыйСтатус = "";
	НовоеДействие = "";
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		Если ТипОперации = ТипыОпераций.НаполнениеКИГУНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
			НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		КонецЕсли;
	
	ИначеЕсли НРег(СтатусДокумента) = НРег("tsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Completed") Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписи;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("readyForSend") Тогда
		
		Если ТипОперации = ТипыОпераций.НаполнениеКИГУНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		КонецЕсли;
		
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписи;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("crptProcessedSuccess") Тогда
		
		Если ТипОперации = ТипыОпераций.НаполнениеКИГУНаТСД Тогда
			НовыйСтатус = СтатусыОпераций.ПолучениеКодовИзСервиса;
			НовоеДействие = ТребуемыеДействия.ПолучитьКодыИзСервиса;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
			НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодов;
		КонецЕсли;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Failed")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ФормированиеКИГУ_ОбновитьСтатусыКодов(ОписаниеЗадачи)
	
	ТипыОперации = Перечисление_ТипыОпераций();
	
	Операция = ОписаниеЗадачи.Операция;
	ТипОперации = ОписаниеЗадачи.ТипОперации;
	Организация = ОписаниеЗадачи.Организация;
	ОперацияОснование = ОписаниеЗадачи.ОперацияОснование;
	КлючСтрокиОперации = ОписаниеЗадачи.КлючСтрокиОперацииОснования;
	
	Если ТипОперации = ТипыОперации.НаполнениеКИГУНаТСД Тогда
		ТаблицаКодов = КодыОпераций_ТаблицаКодов(Операция);
	Иначе
		ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, КлючСтрокиОперации);
	КонецЕсли;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация, Истина);
	
	Задача_Завершить(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ФормированиеКИГУВСервисе

// #Область ТрансформацияАгрегатов

Функция ОчередьОбмена_ТрансформацияАгрегатов_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеТрансформациюАгрегатов);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиТрансформацииАгрегатов);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусТрансформацииАгрегатов);
	Результат.Добавить(ТребуемыеДействия.ОбновитьСоставАгрегата);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ТрансформацияАгрегатов_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеТрансформациюАгрегатов Тогда
		Задача_ТрансформацияАгрегатов_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиТрансформацииАгрегатов Тогда
		Задача_ТрансформацияАгрегатов_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ТрансформацияАгрегатов_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусТрансформацииАгрегатов Тогда
		Задача_ТрансформацияАгрегатов_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСоставАгрегата Тогда
		Задача_ТрансформацияАгрегата_ОбновитьСоставАгрегата(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ТрансформацияАгрегатов_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ТрансформацияАгрегатов(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ТрансформацияАгрегатов_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьКонтентДляПодписиТрансформацииАгрегатов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ТрансформацияАгрегатов(ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ТрансформацияАгрегатов_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ТрансформацияАгрегатов_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.documentId;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ТрансформацияАгрегатов_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ТрансформацияАгрегатов_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусТрансформацииАгрегатов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ТрансформацияАгрегатов_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовоеДействие = Неопределено;
		НовыйСтатус = СтатусыОпераций.СозданВСервисе;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		НовыйСтатус = СтатусыОпераций.ОтправленВАрхив;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Processing")
		Или НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусТрансформацииАгрегатов;
		НовыйСтатус = СтатусыОпераций.ОбрабатываетсяВГИС;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
		
		НовоеДействие = ТребуемыеДействия.ОбновитьСоставАгрегата;
		НовыйСтатус = СтатусыОпераций.ОжиданиеГотовности;
		
	ИначеЕсли Задача_ТрансформацияАгрегатов_СтатусОшибка(СтатусДокумента) Тогда
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Sending")
		Или НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусТрансформацииАгрегатов;
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус трансформации агрегата: %1'"), СтатусДокумента);
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ТрансформацияАгрегата_ОбновитьСоставАгрегата(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	КлючАгрегата = Операция_КлючКода(Операция);
	КодАгрегата = КодМаркировки_НайтиПоКлючу(КлючАгрегата);
	
	Попытка
		ВложенныеКоды = Маркировка_ВложенныеКодыАгрегата(КодАгрегата, Организация);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = КлючАгрегата;
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.КодМаркировки <> КодАгрегата Тогда
			Стр.КодАгрегата = "";
			Стр.КлючАгрегата = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНовыхКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(ВложенныеКоды);
	
	Если Не ТаблицаКодов_НормализоватьКоды(ТаблицаНовыхКодов, Организация) Тогда
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, НСтр("ru = 'Не удалось нормализовать коды при обновлении состава агрегата'"));
	КонецЕсли;
	ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаНовыхКодов);
	
	ИндексКодМаркировки = ТаблицаКодов.Индексы.Добавить("КодМаркировки");
	Для каждого Стр Из ТаблицаНовыхКодов Цикл
		СтрКода = ТаблицаКодов.Найти(Стр.КодМаркировки, "КодМаркировки");
		Если СтрКода = Неопределено Тогда
			СтрКода = ТаблицаКодов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрКода, Стр);
		КонецЕсли;
		СтрКода.КодАгрегата = КодАгрегата;
	КонецЦикла;
	ТаблицаКодов.Индексы.Удалить(ИндексКодМаркировки);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		Задача_Завершить(ОписаниеЗадачи);
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Задача_ТрансформацияАгрегатов_СтатусОшибка(Статус)
	
	ПодходящиеСтатусы = Новый Соответствие;
	ПодходящиеСтатусы.Вставить(НРег("ProcessedError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptProcessedError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("SendingError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptSendingError"), Истина);
	
	Возврат (ПодходящиеСтатусы[НРег(Статус)] = Истина);
	
КонецФункции

// #КонецОбласти // ТрансформацияАгрегатов

// #Область ФормированиеАТК

Функция ОчередьОбмена_ФормированиеАТК_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеФормированиеАТК);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиФормированияАТК);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусФормированияАТК);
	Результат.Добавить(ТребуемыеДействия.ПолучитьАТКИзСервиса);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ФормированиеАТК_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеФормированиеАТК Тогда
		Задача_ФормированиеАТК_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиФормированияАТК Тогда
		Задача_ФормированиеАТК_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ФормированиеАТК_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусФормированияАТК Тогда
		Задача_ФормированиеАТК_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьАТКИзСервиса Тогда
		Задача_ФормированиеАТК_ПолучитьАТКИзСервиса(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ФормированиеАТК_СоздатьВСервисе(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_ФормированиеАТК(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ФормированиеАТК_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьКонтентДляПодписиФормированияАТК;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ФормированиеАТК(Организация);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

