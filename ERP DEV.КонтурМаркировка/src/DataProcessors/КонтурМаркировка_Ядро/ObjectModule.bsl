// Записывает предупреждение в журнал регистрации
//
// Параметры:
//  Действие - Строка - действие, при котором возникло предупреждение;
//  ТекстПредупреждения - Строка - подробное описание ошибки, с номером строки кода и т.д;
//  ДопИнформация - Массив, Строка, Соответствие - доп. информация для записи в журнал регистрации;
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на объект;
//
Процедура ЗафиксироватьПредупреждение(Действие, ТекстПредупреждения
	, ДопИнформация = Неопределено
	, СсылкаНаОбъект = Неопределено) Экспорт
	
	СтрокиСообщения = Новый Массив;
	СтрокиСообщения.Добавить(Действие);
	СтрокиСообщения.Добавить(ТекстПредупреждения);
	Если ЗначениеЗаполнено(ДопИнформация) Тогда
		СтрокиСообщения.Добавить(СтрокаДопИнформацииДляЖурналаРегистрации(ДопИнформация));
	КонецЕсли;
	
	ОбщийТекст = СоединитьСтроку(СтрокиСообщения, Символы.ПС);
	ДобавитьПредупреждениеВЖурналРегистрации(ОбщийТекст, СсылкаНаОбъект);
	
КонецПроцедуры

