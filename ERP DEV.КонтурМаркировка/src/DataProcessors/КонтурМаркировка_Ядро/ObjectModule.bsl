Функция ТипАвторизации() Экспорт
	
	Возврат "Bearer";
	
КонецФункции

Функция ИнформацияОКонфигурации() Экспорт
	
	ВерсияРежимаСовместимости = МодульОбщегоНазначения().ВерсияРежимаСовместимости();
	Если ВерсияРежимаСовместимости = МодульОбщегоНазначения().ВерсияПлатформы() Тогда
		ВерсияРежимаСовместимости = "";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Конфигурация",              СинонимКонфигурации());
	Результат.Вставить("ВерсияКонфигурации",        Метаданные.Версия);
	Результат.Вставить("ОсновнойРежимЗапуска",      Метаданные.ОсновнойРежимЗапуска);
	Результат.Вставить("ВерсияРежимаСовместимости", ВерсияРежимаСовместимости);
	Результат.Вставить("СтрокаСоединения",          СтрокаСоединенияИнформационнойБазы());
	
	Возврат Результат;
	
КонецФункции

Функция СинонимКонфигурации() Экспорт
	
	Возврат Метаданные.Синоним;
	
КонецФункции

Процедура ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ) Экспорт
	
	Если ТаблицаЕстьВЗапросе(МенеджерВТ, "ПустойКлюч") Тогда
		Возврат;
	КонецЕсли;
	
	// В 8.2 пустой ключ из параметра запроса иногда некорректно сравнивается с пустым ключом в таблицах запроса (они не равны)
	// Поэтому передаем его в таблице с одной строкой и соединяемся с ней, когда нужно установить условие по пустому ключу
	
	Если ВерсияПлатформыНиже("8.3.12.1412") И Не ТранзакцияАктивна() Тогда
		
		// Записываем один раз в фиксированную порцию
		ПорцияЗаписей = Новый УникальныйИдентификатор("5cdb8e89-2424-4612-8295-b82c85091b44");
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Ключ1 КАК Ключ
		|ПОМЕСТИТЬ ПустойКлюч
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_ТаблицаКлючей КАК Т
		|ГДЕ
		|	Т.ПорцияЗаписей = &ПорцияЗаписей
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ключ");
		Запрос.УстановитьПараметр("ПорцияЗаписей", ПорцияЗаписей);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		Если Выборка.Количество = 0 Тогда
			
			Набор = РегистрыСведений.КонтурМаркировка_ТаблицаКлючей.СоздатьНаборЗаписей();
			Набор.Отбор.ПорцияЗаписей.Установить(ПорцияЗаписей);
			Набор.Добавить().ПорцияЗаписей = ПорцияЗаписей;
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Записать();
			
			УдалитьТаблицуИзЗапроса(МенеджерВТ, "ПустойКлюч");
			Запрос.Выполнить();
			
		КонецЕсли;
		
	Иначе
		ПустойКлюч = Новый ТаблицаЗначений;
		ПустойКлюч.Колонки.Добавить("Ключ", ОписаниеТипа_Идентификатор());
		ПустойКлюч.Добавить();
		ПоместитьТаблицуВЗапрос(МенеджерВТ, ПустойКлюч, "ПустойКлюч", "Ключ");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоместитьТаблицуВЗапрос(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса = "") Экспорт
	
	Если ВерсияПлатформыНиже("8.3.12.1412") Тогда
		ПоместитьТаблицуВЗапросЧерезНабор(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса);
	Иначе
		ПоместитьТаблицуВЗапросЧерезМенеджер(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоместитьТаблицуВЗапросЧерезНабор(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса = "")
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ТаблицаЗначений
	|ИЗ
	|	&ТаблицаЗначений КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т.ИндексСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКлючей.Ключ1 КАК Ключ1,
	|	ТаблицаКлючей.Ключ2 КАК Ключ2,
	|	ТаблицаКлючей.Ключ3 КАК Ключ3,
	|	ТаблицаКлючей.Ключ4 КАК Ключ4,
	|	ТаблицаКлючей.Ключ5 КАК Ключ5,
	|	ТаблицаКлючей.Ключ6 КАК Ключ6,
	|	ТаблицаКлючей.Ключ7 КАК Ключ7,
	|	ТаблицаКлючей.Ключ8 КАК Ключ8,
	|	ТаблицаКлючей.Ключ9 КАК Ключ9,
	|	ТаблицаЗначений.*
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаЗначений КАК ТаблицаЗначений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТаблицаКлючей КАК ТаблицаКлючей
	|		ПО ТаблицаЗначений.ИндексСтроки = ТаблицаКлючей.ИндексСтроки
	|			И (ТаблицаКлючей.ПорцияЗаписей = &ПорцияЗаписей)
	|
	|КолонкиИндекса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаЗначений";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ Результат", "ПОМЕСТИТЬ " + ИмяТаблицы);
	
	ТипИдентификатор = Тип("УникальныйИдентификатор");
	МассивПолейИндекса = РазделитьСтроку(ПоляИндекса);
	МассивКолонокКлючей = Новый Массив;
	МассивКолонокИндекса = Новый Массив;
	МассивКолонокЗначений = Новый Массив;
	МаксКолонокСКлючами = 9;
	
	Сч = 1;
	Для каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(ТипИдентификатор) Тогда
			Если Сч = МаксКолонокСКлючами Тогда
				ВызватьИсключение НСтр("ru = 'В таблице достигнуто максимальное количество колонок с ключами'");
			КонецЕсли;
			Если МассивПолейИндекса.Найти(Колонка.Имя) <> Неопределено Тогда
				МассивКолонокИндекса.Добавить(Колонка.Имя);
			КонецЕсли;
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КАК Ключ" + Сч, "КАК " + Колонка.Имя);
			МассивКолонокКлючей.Добавить(Колонка.Имя);
			Сч = Сч + 1;
		Иначе
			Если МассивПолейИндекса.Найти(Колонка.Имя) <> Неопределено Тогда
				МассивКолонокИндекса.Добавить("ТаблицаЗначений." + Колонка.Имя);
			КонецЕсли;
			МассивКолонокЗначений.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	Шаблон = "	ТаблицаКлючей.Ключ%1 КАК Ключ%1," + Символы.ПС;
	Пока Сч <= МаксКолонокСКлючами Цикл
		СтрокаКлюча = ПараметрыВСтроку(Шаблон, Сч);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, СтрокаКлюча, "");
		Сч = Сч + 1;
	КонецЦикла;
	
	КолонкиКлючей = СоединитьСтроку(МассивКолонокКлючей, ", ");
	КолонкиИндекса = СоединитьСтроку(МассивКолонокИндекса, ", ");
	КолонкиЗначений = СоединитьСтроку(МассивКолонокЗначений, ", ");
	
	Если Не ЗначениеЗаполнено(КолонкиКлючей) Тогда
		ПоместитьТаблицуВЗапросЧерезМенеджер(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса);
		Возврат;
	КонецЕсли;
	
	ТаблицаЗначений_ДобавитьИндексСтроки(Таблица);
	
	ТаблицаКлючей = Таблица.Скопировать(, "ИндексСтроки," + КолонкиКлючей);
	Для Сч = 1 По МассивКолонокКлючей.Количество() Цикл
		ТаблицаКлючей.Колонки.Найти(МассивКолонокКлючей[Сч - 1]).Имя = "Ключ" + Сч;
	КонецЦикла;
	
	ПорцияЗаписей = МодульОбщегоНазначения().НовыйУникальныйИдентификаторПервойВерсии();
	ТаблицаКлючей.Колонки.Добавить("ПорцияЗаписей", ОписаниеТипа_Идентификатор());
	ТаблицаКлючей.ЗаполнитьЗначения(ПорцияЗаписей, "ПорцияЗаписей");
	
	Набор = РегистрыСведений.КонтурМаркировка_ТаблицаКлючей.СоздатьНаборЗаписей();
	Набор.Отбор.ПорцияЗаписей.Установить(ПорцияЗаписей);
	Набор.Загрузить(ТаблицаКлючей);
	Набор.ОбменДанными.Загрузка = Истина;
	
	Если ЗначениеЗаполнено(КолонкиИндекса) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КолонкиИндекса", "ИНДЕКСИРОВАТЬ ПО " + КолонкиИндекса);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КолонкиИндекса", "");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ПорцияЗаписей", ПорцияЗаписей);
	Запрос.УстановитьПараметр("ТаблицаЗначений", Таблица.Скопировать(, "ИндексСтроки," + КолонкиЗначений));
	
	Таблица.Колонки.Удалить("ИндексСтроки");
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		Набор.Записать();
		Запрос.Выполнить();
		Набор.Очистить();
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПоместитьТаблицуВЗапросЧерезМенеджер(МенеджерВТ, Таблица, ИмяТаблицы, ПоляИндекса = "")
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	&Таблица КАК Т
	|
	|КолонкиИндекса";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ Результат", "ПОМЕСТИТЬ " + ИмяТаблицы);
	
	МассивПолейИндекса = РазделитьСтроку(ПоляИндекса);
	МассивКолонокИндекса = Новый Массив;
	
	Для каждого Колонка Из Таблица.Колонки Цикл
		Если МассивПолейИндекса.Найти(Колонка.Имя) <> Неопределено Тогда
			МассивКолонокИндекса.Добавить("Т." + Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	КолонкиИндекса = СоединитьСтроку(МассивКолонокИндекса, ",");
	
	Если ЗначениеЗаполнено(КолонкиИндекса) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КолонкиИндекса", "ИНДЕКСИРОВАТЬ ПО " + КолонкиИндекса);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КолонкиИндекса", "");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ТаблицаЕстьВЗапросе(МенеджерВТ, ИмяТаблицы)
	
	Если ВерсияПлатформыНиже("8.3.8") Тогда
		
		ТекстЗапроса = СтрЗаменить("ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА КАК ЕстьТаблица ИЗ &ИмяТаблицы КАК Т", "&ИмяТаблицы", ИмяТаблицы);
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		
		Попытка
			Запрос.Выполнить();
			Результат = Истина;
		Исключение
			Результат = Ложь;
		КонецПопытки;
		
	Иначе
		Результат = МенеджерВТ.Таблицы.Найти(ИмяТаблицы) <> Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаИзЗапроса(МенеджерВТ, ИмяТаблицы, УдалитьТаблицу = Ложь) Экспорт
	
	ТекстЗапроса = СтрЗаменить("ВЫБРАТЬ Т.* ИЗ &ИмяТаблицы КАК Т", "&ИмяТаблицы", ИмяТаблицы);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если УдалитьТаблицу Тогда
		УдалитьТаблицуИзЗапроса(МенеджерВТ, ИмяТаблицы);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьСтрокиВТаблицеЗапроса(МенеджерВТ, ИмяТаблицы)
	
	ТекстЗапроса = СтрЗаменить("ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА КАК ЕстьСтроки ИЗ &ИмяТаблицы КАК Т", "&ИмяТаблицы", ИмяТаблицы);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура УдалитьТаблицуИзЗапроса(МенеджерВТ, ИмяТаблицы) Экспорт
	
	ТекстЗапроса = СтрЗаменить("УНИЧТОЖИТЬ &ИмяТаблицы", "&ИмяТаблицы", ИмяТаблицы);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПереместитьТаблицуЗапроса(МенеджерВТ, СтароеИмяТаблицы, НовоеИмяТаблицы, ПоляИндекса = "")
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ НовоеИмяТаблицы
	|ИЗ
	|	СтароеИмяТаблицы КАК Т
	|
	|ПоляИндекса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СтароеИмяТаблицы";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СтароеИмяТаблицы", СтароеИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НовоеИмяТаблицы", НовоеИмяТаблицы);
	
	Если ЗначениеЗаполнено(ПоляИндекса) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПоляИндекса", "ИНДЕКСИРОВАТЬ ПО " + ПоляИндекса);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПоляИндекса", "");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ОставитьПервыеСтрокиВТаблицеЗапроса(МенеджерВТ, ИмяТаблицы, КоличествоСтрок, ПоляИндекса = "") Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	Т.*
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	ИмяТаблицы КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ИмяТаблицы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ИмяТаблицы
	|ИЗ
	|	ВременнаяТаблица КАК Т
	|
	|ПоляИндекса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВременнаяТаблица";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ ПЕРВЫЕ 0", ТекстЗапросаВыбратьПервые(КоличествоСтрок));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяТаблицы", ИмяТаблицы);
	
	Если ЗначениеЗаполнено(ПоляИндекса) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПоляИндекса", "ИНДЕКСИРОВАТЬ ПО " + ПоляИндекса);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПоляИндекса", "");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ДополнитьТаблицуВЗапросе(МенеджерВТ, ИмяТаблицыПриемника, ИмяТаблицыИсточника, ИменаПолей = "", ПоляИндекса = "") Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&ИменаПолей КАК ИменаПолей
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	ИмяТаблицыПриемника КАК Т
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ИменаПолей КАК ИменаПолей
	|ИЗ
	|	ИмяТаблицыИсточника КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ИмяТаблицыПриемника
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ИмяТаблицыПриемника
	|ИЗ
	|	ВременнаяТаблица КАК Т
	|
	|ПоляИндекса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВременнаяТаблица";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяТаблицыИсточника", ИмяТаблицыИсточника);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяТаблицыПриемника", ИмяТаблицыПриемника);
	
	Если ЗначениеЗаполнено(ИменаПолей) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИменаПолей КАК ИменаПолей", ИменаПолей);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИменаПолей КАК ИменаПолей", "*");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПоляИндекса) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПоляИндекса", "ИНДЕКСИРОВАТЬ ПО " + ПоляИндекса);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПоляИндекса", "");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Выполнить();
	
КонецПроцедуры

