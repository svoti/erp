	Результат.Вставить("documentDate", ДопРеквизиты.ДатаДокумента);
	Результат.Вставить("documentNumber", ДопРеквизиты.НомерДокумента);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОснования.Комментарий);
	
	Если ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Пиво Тогда
		Результат.Вставить("tradeParticipantKpp", ДопРеквизиты.Площадка.КПП);
	КонецЕсли;
	
	position = Новый Структура;
	position.Вставить("name", НаименованиеПозицииДляКонтента(СтрТовара));
	position.Вставить("gtin", СтрТовара.Товар.GTIN);
	position.Вставить("tnvedCode", СтрТовара.КодТНВЭД);
	
	Если ВидПродукцииДопускаетУказаниеРазрешительнойДокументации(ВидПродукции) Тогда
		Контент_ВводВОборот_ЗаполнитьРД(position, РазрешительныйДокумент);
	КонецЕсли;
	
	Если ТаблицаКодов_ЕстьАгрегатыИВложенныеКоды(ТаблицаКодов) Тогда
		
		ТипЧисло = ОписаниеТипа_Число();
		ТаблицаКодов.Колонки.Добавить("Цена", ТипЧисло);
		ТаблицаКодов.Колонки.Добавить("Сумма", ТипЧисло);
		ТаблицаКодов.Колонки.Добавить("ЦенаНДС", ТипЧисло);
		ТаблицаКодов.Колонки.Добавить("СуммаНДС", ТипЧисло);
		ТаблицаКодов.Колонки.Добавить("ЦенаАкциза", ТипЧисло);
		ТаблицаКодов.Колонки.Добавить("СуммаАкциза", ТипЧисло);
		ТаблицаКодов.ЗаполнитьЗначения(Цена, "Цена");
		ТаблицаКодов.ЗаполнитьЗначения(ЦенаНДС, "ЦенаНДС");
		ТаблицаКодов.ЗаполнитьЗначения(ЦенаАкциза, "ЦенаАкциза");
		
		aggregateCodes = Новый Массив;
		Для каждого Стр Из МассивКодовОперации Цикл
			aggregateCodes.Добавить(Контент_ВводВОборот_crossBorderAggregateCode(Стр, ТаблицаКодов, ИдентификаторВСД, РазрешительныйДокумент, ВидПродукции));
		КонецЦикла;
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(position, "cost", ТаблицаКодов.Итог("Сумма"));
		ДобавитьЗаполненноеЗначениеВСтруктуру(position, "excise", ТаблицаКодов.Итог("СуммаАкциза"));
		
		СуммаНДС = ТаблицаКодов.Итог("СуммаНДС");
		Если ЗначениеЗаполнено(СуммаНДС) Или ВидПродукцииТребуетСуммуНДСПриВводеВОборот(ВидПродукции) Тогда
			position.Вставить("vat", СуммаНДС);
		КонецЕсли;
		
		position.Вставить("aggregateCodesInfo", aggregateCodes);
		
	Иначе
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(position, "cost", Цена);
		ДобавитьЗаполненноеЗначениеВСтруктуру(position, "excise", ЦенаАкциза);
		ДобавитьЗаполненноеЗначениеВСтруктуру(position, "accompanyingDocument", ИдентификаторВСД);
		
		Если ЗначениеЗаполнено(ЦенаНДС) Или ВидПродукцииТребуетСуммуНДСПриВводеВОборот(ВидПродукции) Тогда
			position.Вставить("vat", ЦенаНДС);
		КонецЕсли;
		
		position.Вставить("codes", ТаблицаКодов.ВыгрузитьКолонку("КодМаркировки"));
		
	КонецЕсли;
	
	Результат.Вставить("positions", ЗначениеВМассиве(position));
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВводВОборот_СПричиной(ОписаниеОперации, ОписаниеОснования)
	
	Организация = ОписаниеОперации.Организация;
