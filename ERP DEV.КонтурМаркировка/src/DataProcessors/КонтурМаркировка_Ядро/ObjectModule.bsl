Функция ТекстЗапросаУсловияСоединения(ИмяРегистра1, ИмяРегистра2, ИменаПолей)
	
	Шаблон = "%1.%2 = %3.%4";
	
	Результат = "";
	Разделитель = "";
	Для Каждого ИмяПоля Из РазделитьСтроку(ИменаПолей) Цикл
		Условие = ПараметрыВСтроку(Шаблон, ИмяРегистра1, ИмяПоля, ИмяРегистра2, ИмяПоля);
		Результат = Результат + Разделитель + Условие;
		Разделитель = " И ";
	КонецЦикла;
	
	Возврат Результат;
	
