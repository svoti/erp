КонецФункции

// Сравнивает объекты через сериализацию во внутреннее представление,
// такие как Структура, Массив, Соответствие
//
// Параметры:
//  Объект1 - Произвольный - объект №1;
//  Объект2 - Произвольный - объект №2;
// 
// Возвращаемое значение:
//  Истина - если объекты отличаются;
//
Функция ОбъектыОтличаются(Объект1, Объект2)
	
	Возврат (ЗначениеВСтрокуВнутр(Объект1) <> ЗначениеВСтрокуВнутр(Объект2));
	
КонецФункции

Функция Кавычки()
	
	Возврат """";
	
КонецФункции

Функция ДвеКавычки()
	
	Возврат """""";
	
КонецФункции

// Удаляет кавычки слева и справа
//
// Параметры:
//  Строка - Строка - строка
// 
// Возвращаемое значение:
//  Строка - строка без кавычек слева и справа
//
Функция СократитьКавычки(Строка)
	
	Кавычки = Кавычки();
	ЕстьКавычкиСлева = (Лев(Строка, 1) = Кавычки);
	ЕстьКавычкиСправа = (Прав(Строка, 1) = Кавычки);
	
	Если Не ЕстьКавычкиСлева Или Не ЕстьКавычкиСправа Тогда
		Возврат Строка;
	КонецЕсли;
	
	Возврат Сред(Строка, 2, СтрДлина(Строка) - 2);
	
КонецФункции

Функция УдалитьКавычкиЭкранированияCSV(Строка) Экспорт
	
	Результат = СократитьКавычки(Строка);
	
	Если Результат <> Строка Тогда
		Результат = СтрЗаменить(Результат, ДвеКавычки(), Кавычки());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выгружает ключи соответствия или структуры в массив
//
// Параметры:
//  Коллекция - Соответствие, Структура - коллекция
// 
// Возвращаемое значение:
//  Массив - ключи соответствия или структуры
//
Функция КлючиСоответствия(Коллекция) Экспорт
	
	Результат = Новый Массив;
	
	Для каждого Элемент Из Коллекция Цикл
		Результат.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Дополняет структуру или соответсвие приемник из данных источника
//
// Параметры:
//  Приемник - Структура, Соответствие
//  Источник - Структура, Соответствие
//
Процедура ДополнитьСтруктуру(Приемник, Источник)
	
	Для Каждого КлючИЗначение Из Источник Цикл
		Приемник.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Записывает текст в строку base64
//
// Параметры:
//  Строка - Строка - текст, который нужно записать;
//  Кодировка - КодировкаТекста, Строка - (необязательный) кодировка текста;
// 
// Возвращаемое значение:
//  Строка - строка закодированная по алгоритму base64
//
Функция Base64ИзСтроки(Строка, Кодировка = "UTF-8") Экспорт
	
	ДвоичныеДанные = ДвоичныеДанныеИзСтроки(Строка, Кодировка);
	Результат = Base64ИзДвоичныхДанных(ДвоичныеДанные);
	
	Возврат Результат;
	
КонецФункции

// Получает строку base64 из двоичных данных,
// удаляя при этом символы переноса строк
// 
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - Двоичные данные
// 
// Возвращаемое значение:
//  Строка - Строка в Base64
// 
Функция Base64ИзДвоичныхДанных(ДвоичныеДанные)
	
	Результат = Base64Строка(ДвоичныеДанные);
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	
	Возврат Результат;
	
КонецФункции

// Записывает строку в двоичные данные
//
// Параметры:
//  Строка - Строка - строка, которую нужно записать в двоичные данные
//  Кодировка - КодировкаТекста, Строка - (необязательный) кодировка текста;
// 
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция ДвоичныеДанныеИзСтроки(Строка, Кодировка = "UTF-8") Экспорт
	
	Если ВерсияПлатформыНиже("8.3.10") Тогда
		
		ПутьКФайлу = НовыйВременныйФайл();
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(Строка);
		Текст.Записать(ПутьКФайлу, Кодировка);
		
		Результат = НовыйДвоичныеДанные(ПутьКФайлу);
		МодульОбщегоНазначения().УдалитьФайл(ПутьКФайлу);
		
	Иначе
		Результат = Вычислить("ПолучитьДвоичныеДанныеИзСтроки(Строка, Кодировка)");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

