// #Область СтекМетрик

Функция СтекМетрик_Прочитать()
	
	Результат = Новый_СтекМетрик();
	АдресСтекаМетрик = СтекМетрик_АдресСтекаМетрик();
	
	Если ЗначениеЗаполнено(АдресСтекаМетрик) Тогда
		ДанныеИБ = ПолучитьИзВременногоХранилища(АдресСтекаМетрик);
		ЗаполнитьПоляСтруктуры(Результат, ДанныеИБ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтекМетрик_ФункциональностьУчтена(Функциональность, Знач Организация = Неопределено) Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = ИмяОбщейОрганизацииДляМетрик();
	КонецЕсли;
	
	НаборФункциональности = СтекМетрик_Прочитать().ФункциональностьПоОрганизациям[Организация];
	
	Возврат (ЗначениеСоответствия(НаборФункциональности, Функциональность) <> Неопределено);
	
КонецФункции

Процедура СтекМетрик_УдалитьФункциональность(Функциональность, Организация = Неопределено) Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = ИмяОбщейОрганизацииДляМетрик();
	КонецЕсли;
	
	СтекМетрик = СтекМетрик_Прочитать();
	
	НаборФункциональности = СтекМетрик.ФункциональностьПоОрганизациям[Организация];
	Если НаборФункциональности = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборФункциональности.Удалить(Функциональность);
	
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

Процедура СтекМетрик_ДобавитьФункциональность(Функциональность, Организация = Неопределено) Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = ИмяОбщейОрганизацииДляМетрик();
	КонецЕсли;
	
	СтекМетрик = СтекМетрик_Прочитать();
	
	НаборФункций = СтекМетрик.ФункциональностьПоОрганизациям[Организация];
	Если НаборФункций = Неопределено Тогда
		НаборФункций = Новый Соответствие;
		СтекМетрик.ФункциональностьПоОрганизациям.Вставить(Организация, НаборФункций);
	КонецЕсли;
	
	КоличествоИспользований = ЗначениеСоответствия(НаборФункций, Функциональность, 0) + 1;
	НаборФункций.Вставить(Функциональность, КоличествоИспользований);
	
	СтекМетрик_ЗаполнитьДатуПервогоСобытия(СтекМетрик);
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

Процедура СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики, МожноОтправлятьМетрики = Истина) Экспорт
	
	СтекМетрик = СтекМетрик_Прочитать();
	СтекМетрик.Топики[Топик].Добавить(ОписаниеМетрики);
	СтекМетрик.РазмерСтека = СтекМетрик.РазмерСтека + 1;
	
	СтекМетрик_ЗаполнитьДатуПервогоСобытия(СтекМетрик);
	СтекМетрик_Поместить(СтекМетрик);
	
	Если МожноОтправлятьМетрики И НужноОтправитьМетрики(СтекМетрик) Тогда
		ОтправитьМетрики();
	КонецЕсли;
	
КонецПроцедуры

Процедура СтекМетрик_ДобавитьМетрикиКлиента(СтекМетрикКлиента) Экспорт
	
	СтекМетрик = СтекМетрик_Прочитать();
	СтекМетрик.КонтекстПриложенияНаКлиенте = СтекМетрикКлиента.КонтекстПриложенияНаКлиенте;
	СтекМетрик.КонтекстПриложенияНаКлиенте.OS.Version = СтекМетрик.КонтекстПриложенияНаСервере.OS.Version;
	СтекМетрик.КонтекстПриложенияНаКлиенте.AppVersion = СтекМетрик.КонтекстПриложенияНаСервере.AppVersion;
	СтекМетрик.КонтекстПриложенияНаКлиенте.Platform = СтекМетрик.КонтекстПриложенияНаСервере.Platform;
	
	Для каждого Элемент Из СтекМетрикКлиента.Топики Цикл
		Топик = Элемент.Ключ;
		МетрикиКлиента = Элемент.Значение;
		МетрикиСервера = СтекМетрик.Топики[Топик];
		ДополнитьМассив(МетрикиСервера, МетрикиКлиента);
		СтекМетрик.РазмерСтека = СтекМетрик.РазмерСтека + МетрикиКлиента.Количество();
	КонецЦикла;
	
	Для каждого Элемент1 Из СтекМетрикКлиента.ФункциональностьПоОрганизациям Цикл
		
		Организация = Элемент1.Ключ;
		НаборФункцийНаКлиенте = Элемент1.Значение;
		
		НаборФункций = СтекМетрик.ФункциональностьПоОрганизациям[Организация];
		Если НаборФункций = Неопределено Тогда
			НаборФункций = Новый Соответствие;
			СтекМетрик.ФункциональностьПоОрганизациям.Вставить(Организация, НаборФункций);
		КонецЕсли;
		
		Для каждого Элемент2 Из НаборФункцийНаКлиенте Цикл
			Функциональность = Элемент2.Ключ;
			КоличествоНаКлиенте = Элемент2.Значение;
			КоличествоИспользований = ЗначениеСоответствия(НаборФункций, Функциональность, 0);
			НаборФункций[Функциональность] = КоличествоИспользований + КоличествоНаКлиенте;
		КонецЦикла;
		
	КонецЦикла;
	
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

Процедура СтекМетрик_Отправить(СтекМетрик)
	
	ВыполненаПопыткаОтправкиМетрик = Ложь;
	
	Для каждого Элемент Из СтекМетрик.Топики Цикл
		
		Топик = Элемент.Ключ;
		
		Попытка
			ПакетСобытий = ПакетСобытийМетрик(Топик, СтекМетрик);
			Если ЗначениеЗаполнено(ПакетСобытий) Тогда
				Портал_ОтправитьМетрики(Топик, ПакетСобытий);
			КонецЕсли;
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
		
		Элемент.Значение.Очистить();
		
		ВыполненаПопыткаОтправкиМетрик = Истина;
		
	КонецЦикла;
	
	Если ВыполненаПопыткаОтправкиМетрик Тогда
		СтекМетрик.РазмерСтека = 0;
		СтекМетрик.ДатаПервогоСобытия = '00010101';
		СтекМетрик.ДатаПоследнейОтправки = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

Процедура СтекМетрик_Поместить(СтекМетрик) Экспорт
	
	АдресСтекаМетрик = СтекМетрик_АдресСтекаМетрик();
	
	Если ЗначениеЗаполнено(АдресСтекаМетрик) Тогда
		Результат = ПоместитьВоВременноеХранилище(СтекМетрик, АдресСтекаМетрик);
	Иначе
		АдресСтекаМетрик = ПоместитьВоВременноеХранилище(СтекМетрик, Новый УникальныйИдентификатор);
		КлючКэш = КлючКэшСтекМетрик();
		Кэш_Поместить(КлючКэш, АдресСтекаМетрик);
		ПараметрыСессии_Поместить(КлючКэш, АдресСтекаМетрик);
	КонецЕсли;
	
КонецПроцедуры

Процедура СтекМетрик_ЗаполнитьДатуПервогоСобытия(СтекМетрик)
	
	Если Не ЗначениеЗаполнено(СтекМетрик.ДатаПервогоСобытия) Тогда
		СтекМетрик.ДатаПервогоСобытия = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

Функция СтекМетрик_АдресСтекаМетрик()
	
	КлючКэш = КлючКэшСтекМетрик();
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПараметрыСессии_Прочитать(КлючКэш);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СтекМетрик_МаксимальныйРазмер() Экспорт
	
	Возврат 50;
	
КонецФункции

Функция КлючКэшСтекМетрик()
	
	Возврат "СтекМетрик";
	
КонецФункции

// #КонецОбласти // СтекМетрик

// #Область ЗамерПроизводительности

Процедура НачатьЗамерПроизводительности(Действие) Экспорт
	
	Если Действие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗамера = Новый_ОписаниеЗамера();
	
	СтекМетрик = СтекМетрик_Прочитать();
	СтекМетрик.ЗамерыПроизводительности.Вставить(Действие, ОписаниеЗамера);
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

Процедура ОстановитьЗамерПроизводительности(Действие) Экспорт
	
	СтекМетрик = СтекМетрик_Прочитать();
	
	ОписаниеЗамера = СтекМетрик.ЗамерыПроизводительности[Действие];
	Если ОписаниеЗамера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗамера.ВремяНачалаПаузы = ТекущийTimestamp();
	
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

Процедура ПродолжитьЗамерПроизводительности(Действие) Экспорт
	
	СтекМетрик = СтекМетрик_Прочитать();
	
	ОписаниеЗамера = СтекМетрик.ЗамерыПроизводительности[Действие];
	Если ОписаниеЗамера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеЗамера.ВремяНачалаПаузы) Тогда
		ДлительностьПаузы = ТекущийTimestamp() - ОписаниеЗамера.ВремяНачалаПаузы;
		ОписаниеЗамера.ДлительностьПаузы = ОписаниеЗамера.ДлительностьПаузы + ДлительностьПаузы;
		ОписаниеЗамера.ВремяНачалаПаузы = Неопределено;
	КонецЕсли;
	
	СтекМетрик_Поместить(СтекМетрик);
	
КонецПроцедуры

Процедура ЗавершитьЗамерПроизводительности(Действие, ДопПараметры = Неопределено) Экспорт
	
	СтекМетрик = СтекМетрик_Прочитать();
	ОписаниеЗамера = СтекМетрик.ЗамерыПроизводительности[Действие];
	Если ОписаниеЗамера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтекМетрик.ЗамерыПроизводительности.Удалить(Действие);
	СтекМетрик_Поместить(СтекМетрик);
	
	Топик = Перечисление_ТопикиМетрики().Здоровье;
	Категория = Перечисление_КатегорииМетрики().ЗамерПроизводительности;
	ДопСведения = ОписаниеЗамераПроизводительности(ОписаниеЗамера, ДопПараметры);
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения);
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

Функция ОписаниеЗамераПроизводительности(ОписаниеЗамера, ДопПараметры = Неопределено)
	
	ВремяНачалаЗамера = ОписаниеЗамера.ВремяНачалаЗамера;
	ДлительностьПаузы = ОписаниеЗамера.ДлительностьПаузы;
	ВремяОкончанияЗамера = ТекущийTimestamp();
	
	Если ЗначениеЗаполнено(ОписаниеЗамера.ВремяНачалаПаузы) Тогда
		ДлительностьПаузы = ДлительностьПаузы + (ВремяОкончанияЗамера - ОписаниеЗамера.ВремяНачалаПаузы);
	КонецЕсли;
	
	Длительность = (ВремяОкончанияЗамера - ВремяНачалаЗамера) - ДлительностьПаузы;
	
	Результат = Новый Структура;
	Результат.Вставить("Длительность", Длительность);
	Результат.Вставить("ВремяНачалаЗамера", ВремяНачалаЗамера);
	Результат.Вставить("ВремяОкончанияЗамера", ВремяОкончанияЗамера);
	
	Если ЗначениеЗаполнено(ДопПараметры) Тогда
		ДополнитьСтруктуру(Результат, ДопПараметры);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ОписаниеЗамера()
	
	Результат = Новый Структура;
	Результат.Вставить("ВремяНачалаЗамера", ТекущийTimestamp());
	Результат.Вставить("ВремяНачалаПаузы", Неопределено);
	Результат.Вставить("ДлительностьПаузы", 0);
	
	Возврат Результат;
	
КонецФункции

Функция ИмяВетки() Экспорт
	
	КлючКэш = "ИмяВетки";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	КаталогМодуля = МодульОбщегоНазначения().КаталогОбработки(ЭтотОбъект);
	КаталогМодуля = МодульОбщегоНазначения().УдалитьЧастьПути(КаталогМодуля, "include");
	ИмяФайла = МодульОбщегоНазначения().ОбъединитьПути(КаталогМодуля, ИмяФайлаВетки());
	Если МодульОбщегоНазначения().ФайлСуществует(ИмяФайла) Тогда
		Результат = СтрокаИзДвоичныхДанных(НовыйДвоичныеДанные(ИмяФайла));
	Иначе
		Результат = "";
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ИмяФайлаВетки()
	
	Возврат "branch.txt";
	
КонецФункции

Функция ДействиеМетрикиПоОписаниюОперации(ОписаниеОперации)
	
	Если Не ВключенСинтетическийЗамерПроизводительности() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	ДействияМетрики = Перечисление_ДействияМетрики();
	
	Если ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().ЗаказКодов Тогда
		
		Если ЗначениеЗаполнено(ОписаниеОперации.ДокументУчета) Тогда
			Результат = ДействияМетрики.Замер_ЗаказКодовВДокументУчета;
		Иначе
			Результат = ДействияМетрики.Замер_ЗаказКодовНаСвободныйОстаток;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ЗамерПроизводительности

// #Область КонтрактыМетрик

Функция ВерсияМетрики() Экспорт
	
	Возврат "1.0.0";
	
КонецФункции

Функция Новый_СтекМетрик() Экспорт
	
	Топики = Новый Структура;
	
	Для Каждого Элемент Из Перечисление_ТопикиМетрики() Цикл
		Топики.Вставить(Элемент.Значение, Новый Массив);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Топики", Топики);
	Результат.Вставить("РазмерСтека", 0);
	Результат.Вставить("ДатаПервогоСобытия", '00010101');
	Результат.Вставить("ДатаПоследнейОтправки", '00010101');
	Результат.Вставить("ФункциональностьПоОрганизациям", Новый Соответствие);
	Результат.Вставить("ЗамерыПроизводительности", Новый Соответствие);
	Результат.Вставить("ПаузыЗамеровПроизводительности", Новый Соответствие);
	Результат.Вставить("КонтекстПриложенияНаСервере", КонтекстПриложения());
	Результат.Вставить("КонтекстПриложенияНаКлиенте");
	
	Возврат Результат;
	
КонецФункции

Функция Новый_СессияМетрики(Топик, Организация, Сертификат, КэшРезультатов = Неопределено)
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[Организация];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Если Топик <> Перечисление_ТопикиМетрики().ОбщепродуктоваяСтатистика Тогда
		Результат.Вставить("CustomSessionId", Строка(ПараметрыСессии_Прочитать("ИдентификаторСеанса")));
	КонецЕсли;
	
	Результат.Вставить("KeSession", Новый Структура);
	Результат.KeSession.Вставить("AbonId", Строка(ИдентификаторИнформационнойБазы()));
	Результат.KeSession.Вставить("UserId", Строка(ИдентификаторПользователяОС()));
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Если Не ЗначениеЗаполнено(Сертификат) Тогда
			Сертификат = НастройкаПодписания_ПодобратьСертификат(Организация);
		КонецЕсли;
		
		РеквизитыОрганизации = ЗначенияРеквизитовОбъектаЛок(Организация, "Идентификатор, ИНН, КПП");
		AccountId = РеквизитыОрганизации.Идентификатор;
		Marker = ПараметрыВСтроку("%1-%2", РеквизитыОрганизации.ИНН, РеквизитыОрганизации.КПП);
		
		Если ЗначениеЗаполнено(AccountId) Тогда
			Результат.Вставить("NormativeSession", Новый Структура);
			Результат.NormativeSession.Вставить("Marker", Marker);
			Результат.NormativeSession.Вставить("AccountId", AccountId);
		КонецЕсли;
		
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(Организация, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ОписаниеМетрики(Категория, Действие, ДопСведения = Неопределено
	, Метка = Неопределено
	, Представление = Неопределено) Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Метка", Метка);
	Результат.Вставить("Действие", Действие);
	Результат.Вставить("Категория", Категория);
	Результат.Вставить("ДопСведения", ДопСведения);
	Результат.Вставить("Представление", Представление);
	Результат.Вставить("ОтметкаВремени", ТекущаяУниверсальнаяДатаВМиллисекундах());
	
	Результат.Вставить("НаКлиенте", Ложь);
	Результат.Вставить("ПервыйЗапускМодуля", Ложь);
	Результат.Вставить("Организация", Справочники.КонтурМаркировка_Организации.ПустаяСсылка());
	
	Результат.Вставить("Сертификат");
	Результат.Вставить("ДокументУчета");
	Результат.Вставить("ИдентификаторТрассировки");
	
	Возврат Результат;
	
КонецФункции

Функция Новый_СобытиеМетрики(ОписаниеМетрики, ДатаОтправки, КонтекстПриложения)
	
	Результат = Новый Структура;
	Результат.Вставить("Session");
	Результат.Вставить("ClientInfo");
	Результат.Вставить("ClientInstanceId");
	
	Результат.Вставить("Id", Строка(Новый УникальныйИдентификатор));
	Результат.Вставить("Time", Новый_ДатаМетрики(ОписаниеМетрики.ОтметкаВремени, ДатаОтправки));
	Результат.Вставить("AppContext", КонтекстПриложения);
	
	Результат.Вставить("Path", Новый Структура);
	Результат.Path.Вставить("Action", ОписаниеМетрики.Действие);
	Результат.Path.Вставить("Category", ОписаниеМетрики.Категория);
	
	Если ЗначениеЗаполнено(ОписаниеМетрики.Метка) Тогда
		Результат.Path.Вставить("Label", ОписаниеМетрики.Метка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеМетрики.Представление) Тогда
		Результат.Path.Вставить("View", ОписаниеМетрики.Представление);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеМетрики.ИдентификаторТрассировки) Тогда
		Результат.Вставить("TraceId", Строка(ОписаниеМетрики.ИдентификаторТрассировки));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеМетрики.ДопСведения) Тогда
		Результат.Вставить("Variables", Новый_ПеременныеМетрики(ОписаниеМетрики.ДопСведения));
	КонецЕсли;
	
	Если ОписаниеМетрики.ПервыйЗапускМодуля Тогда
		// Контекст приложения общий для всех метрик, чтобы его изменить нужно скопировать
		Результат.AppContext = СкопироватьОбъект(Результат.AppContext);
		Результат.AppContext.Hardware.Вставить("CoresCount", 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ИнформацияОКлиентеМетрики()
	
	Результат = Новый Структура;
	Результат.Вставить("ClientName", "mark");
	Результат.Вставить("ClientVersion", ВерсияОбработки());
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПеременныеМетрики(ДопСведения)
	
	Если ТипЗнч(ДопСведения) = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
	Иначе
		Результат = Новый Структура;
	КонецЕсли;
	
	Для Каждого Элемент Из ДопСведения Цикл
		Если Элемент.Значение <> Ложь И ЗначениеЗаполнено(Элемент.Значение) Тогда
			Результат.Вставить(Элемент.Ключ, ОписаниеЗначенияПеременнойМетрики(Элемент.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ДатаМетрики(ОтметкаВремени, ДатаОтправки)
	
	ДатаСобытия = ДатаИзДатыВМиллиСекундах(ОтметкаВремени);
	
	Результат = Новый Структура;
	Результат.Вставить("ClientTime", СтрокаУниверсальнойДатыXML(ДатаСобытия));
	Результат.Вставить("SendFromClientTime", УниверсальнаяДатаXML(ДатаОтправки));
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // КонтрактыМетрик

// #Область СлужебныеМетодыМетрик

// Отправляет в сервис накопленные метрики
//
Процедура ОтправитьМетрики() Экспорт
	
	СтекМетрик = СтекМетрик_Прочитать();
	
	Попытка
		
		ДобавитьСобытияФункциональностиВСтекМетрик(СтекМетрик);
		ДополнитьЗамерыПроизводительностиВСтекеМетрик(СтекМетрик);
		
		СтекМетрик_Отправить(СтекМетрик);
		СтекМетрик_Поместить(СтекМетрик);
		
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
КонецПроцедуры

// Формирует описание событий в терминах сервиса
//
// Параметры:
//  Топик - Строка - см. Перечисление_ТопикиМетрики();
//  СтекМетрик - Структура - см. Новый_СтекМетрик();
// 
// Возвращаемое значение:
//  Массив - содержит структуры, см. Новый_СобытиеМетрики();
//
Функция ПакетСобытийМетрик(Топик, СтекМетрик)
	
	ОписанияМетрик = СтекМетрик.Топики[Топик];
	Если Не ЗначениеЗаполнено(ОписанияМетрик) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Топик = Перечисление_ТопикиМетрики().ОбщепродуктоваяСтатистика Тогда
		ИдентификаторУстановки = Строка(ИдентификаторПользователяИБ());
	Иначе
		ИдентификаторУстановки = НастройкиМодуля().ИдентификаторЭкземпляраМодуля;
	КонецЕсли;
	
	Результат = Новый Массив;
	КэшСессий = Новый Соответствие;
	ДатаОтправки = ТекущаяДата();
	ИнформацияОКлиенте = Новый_ИнформацияОКлиентеМетрики();
	
	Для каждого ОписаниеМетрики Из ОписанияМетрик Цикл
		
		Если ОписаниеМетрики.НаКлиенте Тогда
			КонтекстПриложения = СтекМетрик.КонтекстПриложенияНаКлиенте;
		Иначе
			КонтекстПриложения = СтекМетрик.КонтекстПриложенияНаСервере;
		КонецЕсли;
		
		Сертификат = ОписаниеМетрики.Сертификат;
		Организация = ОписаниеМетрики.Организация;
		
		Если ЗначениеЗаполнено(ОписаниеМетрики.ДокументУчета) Тогда
			Организация = ЗначениеРеквизитаОбъектаЛок(ОписаниеМетрики.ДокументУчета, "Организация");
		КонецЕсли;
		
		ОписаниеСобытия = Новый_СобытиеМетрики(ОписаниеМетрики, ДатаОтправки, КонтекстПриложения);
		ОписаниеСобытия.Session = Новый_СессияМетрики(Топик, Организация, Сертификат, КэшСессий);
		ОписаниеСобытия.ClientInfo = ИнформацияОКлиенте;
		ОписаниеСобытия.ClientInstanceId = ИдентификаторУстановки;
		
		Результат.Добавить(ОписаниеСобытия);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПериодОтправкиМетрик() Экспорт
	
	Возврат 2 * СекундВМинуте();
	
КонецФункции

Функция НужноОтправитьМетрики(СтекМетрик)
	
	ПрошлоВремени = 0;
	Если ЗначениеЗаполнено(СтекМетрик.ДатаПервогоСобытия) Тогда
		ПрошлоВремени = ТекущаяДатаСеанса() - СтекМетрик.ДатаПервогоСобытия;
	КонецЕсли;
	
	Если СтекМетрик.РазмерСтека >= СтекМетрик_МаксимальныйРазмер()
		Или ПрошлоВремени >= ПериодОтправкиМетрик() Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяОбщейОрганизацииДляМетрик() Экспорт
	
	Возврат "ОбщаяОрганизация";
	
КонецФункции

// Добавляет события функциональности в стек метрик и сбрасывает количество использований
//
// Параметры:
//  Стек - Структура - см. Новый_СтекМетрик();
//
Процедура ДобавитьСобытияФункциональностиВСтекМетрик(СтекМетрик)
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Действие = Перечисление_ДействияМетрики().ОтправкаМетрик;
	Категория = Перечисление_КатегорииМетрики().Функциональность;
	
	Для каждого Стр Из ВсяФункциональностьСтекаМетрик(СтекМетрик) Цикл
		
		Идентификатор = Стр.Организация.Идентификатор;
		
		Если Не ЗначениеЗаполнено(Идентификатор)
			Или Не ЗначениеЗаполнено(Стр.КоличествоИспользований) Тогда
			Продолжить;
		КонецЕсли;
		
		ДопСведения = Новый Структура("КоличествоИспользований", Стр.КоличествоИспользований);
		ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Идентификатор, Стр.Функциональность);
		ОписаниеМетрики.Организация = Стр.Организация;
		СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики, Ложь);
		
	КонецЦикла;
	
	Для каждого Элемент1 Из СтекМетрик.ФункциональностьПоОрганизациям Цикл
		НаборФункций = Элемент1.Значение;
		Для каждого Элемент2 Из НаборФункций Цикл
			НаборФункций[Элемент2.Ключ] = 0;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в описания метрик производительности ветку, версию обработки и тип замера
//
// Параметры:
//  СтекМетрик - Массив - см. Новый_СтекМетрик();
//
Процедура ДополнитьЗамерыПроизводительностиВСтекеМетрик(СтекМетрик)
	
	ОписанияМетрик = СтекМетрик.Топики[Перечисление_ТопикиМетрики().Здоровье];
	Если Не ЗначениеЗаполнено(ОписанияМетрик) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыЗамеров = Перечисление_ТипыЗамеровПроизводительности();
	
	ИмяВетки = ИмяВетки();
	ВерсияОбработки = ВерсияОбработки();
	НастройкиМодуля = НастройкиМодуля();
	
	Для Каждого ОписаниеМетрики Из ОписанияМетрик Цикл
		
		ОписаниеМетрики.ДопСведения.Вставить("Ветка", ИмяВетки);
		ОписаниеМетрики.ДопСведения.Вставить("ВерсияМодуля", ВерсияОбработки);
		
		Если НастройкиМодуля.СинтетическийЗамерПроизводительности Тогда
			ОписаниеМетрики.Метка = ТипыЗамеров.Синтетический;
		ИначеЕсли НастройкиМодуля.ТестовоеОкружение Тогда
			ОписаниеМетрики.Метка = ТипыЗамеров.Тестовый;
		Иначе
			ОписаниеМетрики.Метка = ТипыЗамеров.Продуктивный;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеЗначенияПеременнойМетрики(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Число") Тогда
		type = "number";
		value = ЧислоXML(Значение);
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		type = "string";
		value = СокрЛП(Значение);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		type = "uuid";
		value = СокрЛП(Значение);
	ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
		type = "base64";
		value = Base64Строка(Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		type = "string";
		value = БулевоXML(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		type = "string";
		value = ЛокальнаяДатаXML(Значение);
	ИначеЕсли ЭтоСсылка(Значение) Тогда
		type = "string";
		value = СокрЛП(Значение);
	Иначе
		ТекстОшибки = НСтр("ru = 'Неизвестное значение переменной для записи в метрики: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Значение);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Результат = Новый Структура("type, value", type, value);
	
	Возврат Результат;
	
КонецФункции

Функция ВсяФункциональностьСтекаМетрик(СтекМетрик)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.КонтурМаркировка_Организации"));
	Результат.Колонки.Добавить("Функциональность", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("КоличествоИспользований", Новый ОписаниеТипов("Число"));
	
	Для каждого Элемент1 Из СтекМетрик.ФункциональностьПоОрганизациям Цикл
		
		Если Элемент1.Ключ = ИмяОбщейОрганизацииДляМетрик() Тогда
			МассивОрганизаций = Организация_ВсеОрганизации();
		Иначе
			МассивОрганизаций = ЗначениеВМассиве(Элемент1.Ключ);
		КонецЕсли;
		
		НаборФункций = Элемент1.Значение;
		
		Для каждого Организация Из МассивОрганизаций Цикл
			Для каждого Элемент2 Из НаборФункций Цикл
				Стр = Результат.Добавить();
				Стр.Организация = Организация;
				Стр.Функциональность = Элемент2.Ключ;
				Стр.КоличествоИспользований = Элемент2.Значение;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.Сортировать("Организация");
	
	Возврат Результат;
	
КонецФункции

Функция КонтекстПриложения()
	
	КлючКэш = "КонтекстПриложения";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("AppVersion", ВерсияОбработки());
	Результат.Вставить("Platform", ОписаниеПрограммы());
	Результат.Вставить("Hardware", ОписаниеАппаратногоОбеспечения());
	Результат.Вставить("OS", ОписаниеОС());
	
	ОписаниеБраузера = ОписаниеБраузера();
	Если ЗначениеЗаполнено(ОписаниеБраузера) Тогда
		Результат.Вставить("Browser", ОписаниеБраузера);
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеОС()
	
	СисИнфо = ИнформацияОСистеме();
	ТипОС = НРег(СисИнфо.ТипПлатформы);
	
	Если Найти(ТипОС, НРег("Linux")) > 0 Тогда
		Name = "Linux";
	ИначеЕсли Найти(ТипОС, НРег("MacOS")) > 0 Тогда
		Name = "MacOS";
	ИначеЕсли Найти(ТипОС, НРег("Windows")) > 0 Тогда
		Name = "Windows";
	КонецЕсли;
	
	Если Найти(ТипОС, "64") > 0 Тогда
		BitSet = "x64";
	Иначе
		BitSet = "x86";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Name", Name);
	Результат.Вставить("BitSet", BitSet);
	Результат.Вставить("Version", ВерсияМетрики());
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеПрограммы()
	
	СисИнфо = ИнформацияОСистеме();
	
	Name = "1С:Предприятие 8";
	RunMode = Строка(ТекущийРежимЗапуска());
	Version = СемантическийФорматВерсии(СисИнфо.ВерсияПриложения);
	Configuration = Метаданные.Имя;
	ConfigurationVersion = СемантическийФорматВерсии(Метаданные.Версия);
	
	Если Не ЗначениеЗаполнено(RunMode) Тогда
		RunMode = "Регламентное задание";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Name"	, Name);
	Результат.Вставить("RunMode", RunMode);
	Результат.Вставить("Version", Version);
	Результат.Вставить("Configuration", Configuration);
	Результат.Вставить("ConfigurationVersion", ConfigurationVersion);
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеБраузера()
	
	Результат = Новый Структура;
	СисИнфо = ИнформацияОСистеме();
	
	UserAgent = СисИнфо.ИнформацияПрограммыПросмотра;
	Если ЗначениеЗаполнено(UserAgent) Тогда
		Результат.Вставить("UserAgent", UserAgent);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеАппаратногоОбеспечения()
	
	МегабайтВГигабайте = 1024;
	
	TotalMemoryGb = Окр(ИнформацияОСистеме().ОперативнаяПамять / МегабайтВГигабайте);
	
	Возврат Новый Структура("TotalMemoryGb", TotalMemoryGb);
	
КонецФункции

// Форматирует строку версии по правилам семантического версионирования
// https://semver.org/lang/ru/
//
// Параметры:
//  Версия - Строка - версия, которую необходимо форматировать
//
// Возвращаемое значение:
//  Строка
//
Функция СемантическийФорматВерсии(Знач Версия) Экспорт
	
	ПустаяВерсия = "0";
	Версия = СтрЗаменить(Версия, "/", ".");
	ЧастиВерсии = РазделитьСтроку(Версия, ".");
	МажорнаяВерсия = ЗначениеИзМассива(ЧастиВерсии, 0, ПустаяВерсия);
	МинорнаяВерсия = ЗначениеИзМассива(ЧастиВерсии, 1, ПустаяВерсия);
	Исправление = ЗначениеИзМассива(ЧастиВерсии, 2, ПустаяВерсия);
	
	Если Не ВСтрокеТолькоЦифры(МажорнаяВерсия) Тогда
		МажорнаяВерсия = ПустаяВерсия;
	КонецЕсли;
	Если Не ВСтрокеТолькоЦифры(МинорнаяВерсия) Тогда
		МинорнаяВерсия = ПустаяВерсия;
	КонецЕсли;
	Если Не ВСтрокеТолькоЦифры(Исправление) Тогда
		Исправление = ПустаяВерсия;
	КонецЕсли;
	
	Дополнение = "";
	Для Индекс = 3 По ЧастиВерсии.ВГраница() Цикл
		Дополнение = Дополнение + СтрЗаменить(ЧастиВерсии[Индекс], " ", "");
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Дополнение) Тогда
		Результат = ПараметрыВСтроку("%1.%2.%3-%4", МажорнаяВерсия, МинорнаяВерсия, Исправление, Дополнение);
	Иначе
		Результат = ПараметрыВСтроку("%1.%2.%3", МажорнаяВерсия, МинорнаяВерсия, Исправление);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВыводИзОборота_ЕстьНомерПартии(ОписаниеОперации)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.НомерПартии) Тогда
		Результат = Истина;
	Иначе
		Для Каждого Стр Из ОписаниеОперации.Товары Цикл
			Если ЗначениеЗаполнено(Стр.НомерПартии) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Замер_МаксКодовВОперации_Поместить(ОписаниеОперации)
	
	КоличествоКодов = КодыОпераций_ОбщееКоличествоКодов(ОписаниеОперации.Ссылка);
	
	КлючПараметров = "МаксКодовВОперации";
	ТекКоличество = ПараметрыСессии_Прочитать(КлючПараметров);
	
	Если Не ЗначениеЗаполнено(ТекКоличество)
		Или КоличествоКодов > ТекКоличество Тогда
		ПараметрыСессии_Поместить(КлючПараметров, КоличествоКодов);
	КонецЕсли;
	
КонецПроцедуры

