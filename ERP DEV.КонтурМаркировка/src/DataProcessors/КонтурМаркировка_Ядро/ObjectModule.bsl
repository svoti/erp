// Добавляет в функциональность использование сервис-провайдера в заказе кодов
//
// Параметры:
//  ОписаниеОперации - СправочникСсылка.КонтурМаркировка_СервисПровайдеры - сервис-провайдер;
//
Процедура Метрика_Функциональность_СервисПровайдеры(ОписаниеОперации)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().ЗаказКодов Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОписаниеОперации.Организация;
	СервисПровайдер= ОписаниеОперации.ДопРеквизиты.СервисПровайдер;
	
	Если Не ЗначениеЗаполнено(СервисПровайдер) Тогда
		Возврат;
	КонецЕсли;
	
	Функциональность = Перечисление_ФункциональностьМодуля().СервисПровайдеры;
	СтекМетрик_ДобавитьФункциональность(Функциональность, Организация);
	
