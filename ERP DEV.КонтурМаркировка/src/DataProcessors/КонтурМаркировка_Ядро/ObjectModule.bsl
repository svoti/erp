Функция УсловияИстеченияСроковГодности(АльтернативныеСрокиГодности)
	
	Результат = Новый Соответствие;
	
	Для Каждого АльтСрок Из АльтернативныеСрокиГодности Цикл
		Результат.Вставить(Строка(АльтСрок.Ключ), ЛокальнаяДатаСоСмещениемXML(АльтСрок.Значение));
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ВидВозвратаВОборотВСервисе(ПричинаВозвратаВОборот)
	
	Причины = Перечисление_ПричиныВозвратаВОборот();
	
	ПричиныВСервисе = Новый Соответствие;
	ПричиныВСервисе.Вставить(Причины.ДистанционныйСпособПродажи, "RemoteSale");
	ПричиныВСервисе.Вставить(Причины.РозничнаяРеализация, "Retail");
	ПричиныВСервисе.Вставить(Причины.БезПоследующейРеализации, "OwnUse");
	ПричиныВСервисе.Вставить(Причины.Гостайна, "StateContract");
	ПричиныВСервисе.Вставить(Причины.Вендинг, "VendingReturn");
	ПричиныВСервисе.Вставить(Причины.ОтКонечногоПокупателя, "NotForSale");
	
	Результат = ПричиныВСервисе[ПричинаВозвратаВОборот];
	
	Если Результат = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить вид возврата в оборот по причине возврата в оборот в сервисе: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстСообщения, ПричинаВозвратаВОборот);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СпособПриемкиВСервисе(СтатусПриемки)
	
	СтатусыПриемки = Перечисление_СтатусыПриемки();
	
	Если СтатусПриемки = СтатусыПриемки.Принято Тогда
		СпособПриемки = "AcceptAll";
	ИначеЕсли СтатусПриемки = СтатусыПриемки.Отклонено Тогда
		СпособПриемки = "RejectAll";
	ИначеЕсли СтатусПриемки = СтатусыПриемки.ПринятоЧастично Тогда
		СпособПриемки = "AcceptPartially";
	Иначе
		ВызватьИсключение НСтр(ПараметрыВСтроку("ru = 'Неизвестный статус приемки %1'", СтатусПриемки));
	КонецЕсли;
	
	Возврат СпособПриемки;
	
КонецФункции

Функция ТипСрокаГодностиВСервисе(ТипСрокаГодности, ВидПродукции)
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ТипыСроковГодности = Перечисление_ТипыСроковГодности();
	
	Если ВидПродукции = ВидыПродукции.Молоко Тогда
		Если ТипСрокаГодности = ТипыСроковГодности.СрокГодностиМеньше72 Тогда
			Результат = "MilkLessThan72";
		ИначеЕсли ТипСрокаГодности = ТипыСроковГодности.СрокГодностиБольше72 Тогда
			Результат = "MilkMoreThan72";
		ИначеЕсли ТипСрокаГодности = ТипыСроковГодности.СрокГодностиБольше72СУсловием Тогда
			Результат = "MilkAlternative";
		Иначе
			Результат = "None";
		КонецЕсли;
	Иначе
		Если ТипСрокаГодности = ТипыСроковГодности.СрокГодностиБольше72СУсловием Тогда
			Результат = "Alternative";
		Иначе
			Результат = "None";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипИспользованияВСервисе(ТипИспользования)
	
	ТипыИспользования = Перечисление_ТипыИспользованияКодов();
	
	Если ТипИспользования = ТипыИспользования.Напечатан Тогда
		Результат = "Printed";
	Иначе
		Результат = "Verified";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипОтчетаОНанесенииВСервисе(ТипОтчетаОНанесении)
	
	ТипыОтчетаОНанесении = Перечисление_ТипыОтчетаОНанесении();
	
	Если ТипОтчетаОНанесении = ТипыОтчетаОНанесении.РасформированиеНабора Тогда
		Результат = "SplitMark";
	ИначеЕсли ТипОтчетаОНанесении = ТипыОтчетаОНанесении.РазделениеТовара Тогда
		Результат = "DivisionMark";
	Иначе
		Результат = "Utilisation";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПричинаВводаВОборотВСервисе(ПричинаВводаВОборот)
	
	ПричиныВводаВОборот = Перечисление_ПричиныВводаВОборот();
	
	Результат = "";
	Если ПричинаВводаВОборот = ПричиныВводаВОборот.Разукомплектация Тогда
		Результат = "dismantling";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипТрансформацииАгрегатаВСервисе(ТипОперации)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	Если ТипОперации = ТипыОпераций.ДобавлениеВАгрегат
		ИЛИ ТипОперации = ТипыОпераций.ДобавлениеВАТК Тогда
		Результат = "adding";
	ИначеЕсли ТипОперации = ТипыОпераций.ИзъятиеИзАгрегата
		ИЛИ ТипОперации = ТипыОпераций.ИзъятиеИзАТК Тогда
		Результат = "removing";
	Иначе
		ШаблонОшибки = НСтр("ru = 'Не удалось определить тип трансформации агрегата в сервисе по типу операции: %1'");
		ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, ТипОперации);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодРешенияВСервисе(ПринятоеРешение)
	
	КлючКэш = "СоответствиеКодовРешений";
	КодыРешений = Кэш_Прочитать(КлючКэш);
	
	Если Не ЗначениеЗаполнено(КодыРешений) Тогда
		
		ПринятыеРешения = Перечисление_ПринятыеРешения();
		
		КодыРешений = Новый Соответствие;
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровРазрешен, "ReleaseAllowed");
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровПоСтатье121, "SpecificRelease121");
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровПоСтатье122, "SpecificRelease122");
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровПоСтатье123, "SpecificRelease123");
		КодыРешений.Вставить(ПринятыеРешения.УсловныйВыпускТоваров, "ConditionallyRelease");
		КодыРешений.Вставить(ПринятыеРешения.ВыпускТоваровПриУсловииИсполненияОбязательств
		, "ReleaseWithCustomsDuties");
		
		Кэш_Поместить(КлючКэш, Новый ФиксированноеСоответствие(КодыРешений));
		
	КонецЕсли;
	
	Результат = КодыРешений.Получить(ПринятоеРешение);
	
	Если Результат = Неопределено Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось определить код решения в сервисе по принятому решению ""%1""'")
		, ПринятоеРешение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипПроизводстваВСервисе(ТипПроизводственногоЗаказа)
	
	ТипыЗаказов = Перечисление_ТипыПроизводственныхЗаказов();
	
	Если ТипПроизводственногоЗаказа = ТипыЗаказов.СобственноеПроизводство Тогда
		Результат = "OwnProduction";
	ИначеЕсли ТипПроизводственногоЗаказа = ТипыЗаказов.КонтрактноеПроизводство Тогда
		Результат = "ContractProduction";
	Иначе
		Результат = "Undefined";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПричинаВыводаИзОборотаПриОтгрузкеВСервисе(ПричинаВыводаИзОборота)
	
	ПричиныВыводаИзОборота = Перечисление_ПричиныВыводаИзОборотаПриОтгрузке();
	
	Если ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.БезвозмезднаяПередача Тогда
		
		Результат = "donation";
		
	ИначеЕсли ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.ПриобретениеГосПредприятием Тогда
		
		Результат = "stateEnterprise";
		
	ИначеЕсли ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.ДляСобственныхНужд Тогда
		
		Результат = "noRetailUse";
		
	Иначе
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестная причина вывода из оборота: %1'"), ПричинаВыводаИзОборота);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

