// #Область УведомленияОПриемке

Функция ОчередьОбмена_УведомлениеОПриемке_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ОбновитьУведомлениеОПриемке);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиУведомленияОПриемке);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусУведомленияОПриемке);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_УведомлениеОПриемке_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ОбновитьУведомлениеОПриемке Тогда
		Задача_УведомлениеОПриемке_ОбновитьДокумент(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиУведомленияОПриемке Тогда
		Задача_УведомлениеОПриемке_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_УведомлениеОПриемке_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусУведомленияОПриемке Тогда
		Задача_УведомлениеОПриемке_ПроверитьСтатус(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

// Обновляет данные документа в сервисе
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. функцию Новый_ЗадачаОбмена();
//
Процедура Задача_УведомлениеОПриемке_ОбновитьДокумент(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ИдентификаторДокумента = ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента;
	Контент = Контент_УведомлениеОПриемке_ОбновлениеДокумента(Операция);
	
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	
	Попытка
		Ответ = Маркировка_УведомлениеОПриемке_ОбновитьДокумент(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьКонтентДляПодписиУведомленияОПриемке;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_УведомлениеОПриемке(Организация, ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

// Получает из сервиса контент уведомления о приемке для подписи
// и сохраняет его в файл
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. функцию Новый_ЗадачаОбмена();
//
Процедура Задача_УведомлениеОПриемке_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_УведомлениеОПриемке_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// Отправляет подписанный файл уведомления о приемке в ГИС.
// После успешной отправки, подписанный файл удаляется.
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. функцию Новый_ЗадачаОбмена();
//
Процедура Задача_УведомлениеОПриемке_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_УведомлениеОПриемке_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОперацияЗавершена;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусУведомленияОПриемке;
	Задача_Записать(ОписаниеЗадачи);
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

// Проверяет статус уведомления о приемке в ГИС.
// После успешной отправки, подписанный файл удаляется.
//
// Параметры:
//  ОписаниеЗадачи - Структура - см. функцию Новый_ЗадачаОбмена();
//
Процедура Задача_УведомлениеОПриемке_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_УведомлениеОПриемке_КонтентДокумента(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Контент = Ответ.Результат;
	СтатусДокумента = СтатусУведомленияОПриемкеПоСтатусуИзСервиса(Контент.documentStatus);
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	НовыйСтатус = СтатусДокумента;
	Если СтатусДокумента = СтатусыОпераций.ОтправленВАрхив
		Или СтатусДокумента = СтатусыОпераций.ПолученУспешныйОтветОтГИС
		Или СтатусДокумента = СтатусыОпераций.ОтГИСПолученоСообщениеОбОшибке
		Или СтатусДокумента = СтатусыОпераций.ВПриемкеОтказано Тогда
		
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли СтатусДокумента = СтатусыОпераций.ГотовКОтправкеВГИС Тогда
		
		НовоеДействие = ТребуемыеДействия.ПолучитьКонтентДляПодписиУведомленияОПриемке;
		
	ИначеЕсли СтатусДокумента = СтатусыОпераций.ОтправкаЗапросаСФайломВГИС
		Или СтатусДокумента = СтатусыОпераций.ОшибкаОтправкиЗапросаСФайломВГИС
		Или СтатусДокумента = СтатусыОпераций.ЗапросСФайломОтправленВГИС Тогда
		
		НовоеДействие = ТребуемыеДействия.ПроверитьСтатусУведомленияОПриемке;
		
	ИначеЕсли СтатусДокумента = СтатусыОпераций.ДокументОПриемкеОжидаетПодтверждения Тогда
		
		НовоеДействие = ТребуемыеДействия.ОбновитьУведомлениеОПриемке;
		
		
	Иначе
		
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

