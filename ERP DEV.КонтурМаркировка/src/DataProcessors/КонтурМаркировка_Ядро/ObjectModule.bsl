
// #Область ОписаниеПеременных

Перем КэшНаСервере;

// #КонецОбласти // ОписаниеПеременных

// #Область СведенияОВнешнейОбработке

// Версия обработки в стандартном формате
//
// Возвращаемое значение:
//  Строка - версия в формате РР.ВВ.ФФ.СС, где:
//   * РР - номер редакции    - в рамках одной редакции гарантируется обратная совместимость;
//   * ВВ - номер версии      - новая функциональность (или несколько);
//   * ФФ - номер исправления - исправление ошибки;
Функция ВерсияОбработки() Экспорт
	
	Возврат "3.24.1";
	
КонецФункции

// Возвращает первые два блока в номере версии
// Например, для версии обработки 3.20.1 функция вернет 3.20
// 
// Возвращаемое значение:
//  Строка
//
Функция ВерсияРелиза()
	
	Разделитель = ".";
	ЧастиВерсии = РазделитьСтроку(ВерсияОбработки(), Разделитель);
	
	Возврат ЧастиВерсии[0] + Разделитель + ЧастиВерсии[1];
	
КонецФункции

// Сведения о внешней обработке совместимые с БСП
//
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * Версия          - Строка - версия обработки;
//   * Наименование    - Строка - представление для администратора (наименование элемента справочника),
//                                берется синоним объекта метаданных внешней обработки;
//   * Информация      - Строка - краткая информация о внешней обработке,
//                                берется комментарий объекта метаданных внешней обработки;
//   * БезопасныйРежим - Булево - признак подключения внешней обработки в безопасном режиме:
//                                 Игнорируется привилегированный режим
//                                 Запрещены внешние по отношению к платформе «1С:Предприятия» действия:
//                                  COM;
//                                  загрузка внешних компонент;
//                                  запуск внешних приложений и команд операционной системы;
//                                  доступ к файловой системе, кроме временных файлов;
//                                  доступ к Интернету.
//   * Вид             - Строка - содержит значение "ДополнительнаяОбработка";
//   * Команды         - ТаблицаЗначений - настройки команд, поставляемых внешней обработкой:
//      ** Идентификатор        - Строка- внутреннее имя команды;
//      ** Представление        - Строка- пользовательское представление команды;
//      ** Использование        - Строка- тип команды:
//                                         "ВызовКлиентскогоМетода",
//                                         "ВызовСерверногоМетода";
//      ** Модификатор          - Строка- дополнительная классификация команды;
//      ** ПоказыватьОповещение - Булево- если Истина, то при запуске команды выводится оповещение "Команда выполняется...";
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	МетаданныеОбработки = Метаданные();
	
	Результат = Новый Структура;
	Результат.Вставить("БезопасныйРежим", Ложь);
	Результат.Вставить("Наименование", МетаданныеОбработки.Синоним);
	Результат.Вставить("Информация", МетаданныеОбработки.Комментарий);
	Результат.Вставить("Команды", КомандыВнешнейОбработки());
	Результат.Вставить("Версия", ВерсияОбработки());
	Результат.Вставить("Вид", "ДополнительнаяОбработка");
	Результат.Вставить("ВерсияБСП", "1.2.1.4");
	
	Возврат Результат;
	
КонецФункции

Функция КомандыВнешнейОбработки()
	
	МетаданныеОбработки = Метаданные();
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Представление", ТипСтрока);
	Результат.Колонки.Добавить("Идентификатор", ТипСтрока);
	Результат.Колонки.Добавить("Использование", ТипСтрока);
	Результат.Колонки.Добавить("Модификатор", ТипСтрока);
	Результат.Колонки.Добавить("ПоказыватьОповещение", ТипБулево);
	Результат.Колонки.Добавить("Скрыть", ТипБулево);
	
	Команды = Перечисление_КомандыОбработки();
	ПредставленияКоманд = Перечисление_ПредставленияКомандОбработки();
	ВариантыИспользования = Перечисление_ВариантыИспользованияКоманд();
	
	Если МетаданныеОбработки.Синоним = "Контур.Маркировка" Тогда
		Стр = Результат.Добавить();
		Стр.Идентификатор = Команды.ОткрытьФорму;
		Стр.Представление = МетаданныеОбработки.Синоним;
		Стр.Использование = ВариантыИспользования.ОткрытиеФормы;
	КонецЕсли;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ВыполнитьРегламентныеДействия;
	Стр.Представление = ПредставленияКоманд.ВыполнитьРегламентныеДействия;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбменССервисом;
	Стр.Представление = ПредставленияКоманд.ОбменССервисом;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновлениеМодуля;
	Стр.Представление = ПредставленияКоманд.ОбновлениеМодуля;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОчисткаУстаревшихДанных;
	Стр.Представление = ПредставленияКоманд.ОчисткаУстаревшихДанных;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновитьДанныеПодсистемы;
	Стр.Представление = ПредставленияКоманд.ОбновитьДанныеПодсистемы;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Ложь;
	Стр.Скрыть = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновитьСтатусыКодовДокумента;
	Стр.Представление = ПредставленияКоманд.ОбновитьСтатусыКодовДокумента;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Ложь;
	Стр.Скрыть = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ПроверитьКодыДокумента;
	Стр.Представление = ПредставленияКоманд.ПроверитьКодыДокумента;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Ложь;
	Стр.Скрыть = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновлениеПлагинов;
	Стр.Представление = ПредставленияКоманд.ОбновлениеПлагинов;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	
	Стр = Результат.Добавить();
	Стр.Идентификатор = Команды.ОбновлениеТарифов;
	Стр.Представление = ПредставленияКоманд.ОбновлениеТарифов;
	Стр.Использование = ВариантыИспользования.ВызовСерверногоМетода;
	Стр.ПоказыватьОповещение = Истина;
	Стр.Скрыть = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_КомандыОбработки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОткрытьФорму"					, "ОткрытьФорму");
	Результат.Вставить("ВыполнитьРегламентныеДействия"	, "ВыполнитьРегламентныеДействия");
	Результат.Вставить("ОбменССервисом"					, "ОбменССервисом");
	Результат.Вставить("ОбновлениеМодуля"				, "ОбновлениеМодуля");
	Результат.Вставить("ОчисткаУстаревшихДанных"		, "ОчисткаУстаревшихДанных");
	Результат.Вставить("ОбновлениеПлагинов"				, "ОбновлениеПлагинов");
	Результат.Вставить("ОбновлениеТарифов"				, "ОбновлениеТарифов");
	
	// Служебные команды
	Результат.Вставить("ОбновитьДанныеПодсистемы"		, "ОбновитьДанныеПодсистемы");
	Результат.Вставить("ОбновитьСтатусыКодовДокумента"	, "ОбновитьСтатусыКодовДокумента");
	Результат.Вставить("ПроверитьКодыДокумента"			, "ПроверитьКодыДокумента");
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Перечисление_ПредставленияКомандОбработки()
	
	Команды = Перечисление_КомандыОбработки();
	
	Результат = Новый Структура;
	Результат.Вставить(Команды.ВыполнитьРегламентныеДействия, НСтр("ru = 'Регламентные действия'"));
	Результат.Вставить(Команды.ОбменССервисом				, НСтр("ru = 'Обмен с сервисом'"));
	Результат.Вставить(Команды.ОбновлениеМодуля				, НСтр("ru = 'Обновление модуля'"));
	Результат.Вставить(Команды.ОчисткаУстаревшихДанных		, НСтр("ru = 'Очистка устаревших данных'"));
	Результат.Вставить(Команды.ОбновлениеПлагинов			, НСтр("ru = 'Обновление плагинов'"));
	Результат.Вставить(Команды.ОбновлениеТарифов			, НСтр("ru = 'Обновление тарифов'"));
	
	// Служебные команды
	Результат.Вставить(Команды.ОбновитьДанныеПодсистемы		, НСтр("ru = 'Обновить данные подсистемы (служебная)'"));
	Результат.Вставить(Команды.ОбновитьСтатусыКодовДокумента, НСтр("ru = 'Обновить статусы кодов документа (служебная)'"));
	Результат.Вставить(Команды.ПроверитьКодыДокумента		, НСтр("ru = 'Проверить коды документа (служебная)'"));
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция Перечисление_ВариантыИспользованияКоманд()
	
	Результат = Новый Структура;
	Результат.Вставить("ОткрытиеФормы", "ОткрытиеФормы");
	Результат.Вставить("ВызовСерверногоМетода", "ВызовСерверногоМетода");
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// #КонецОбласти // СведенияОВнешнейОбработке

// #Область КомандыВнешнейОбработки

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыКоманды = Неопределено) Экспорт
	
	Если Не МодульИнициализирован() Тогда
		Инициализировать();
	КонецЕсли;
	
	Если ВыполняетсяОбновлениеДанныхПодсистемы() Тогда
		Возврат;
	КонецЕсли;
	
	Команды = Перечисление_КомандыОбработки();
	
	Если ИдентификаторКоманды = Команды.ВыполнитьРегламентныеДействия Тогда
		
		ВыполнитьРегламентныеДействия(ПараметрыКоманды);
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОчисткаУстаревшихДанных Тогда
		
		ОчиститьУстаревшиеДанные();
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновитьДанныеПодсистемы Тогда
		
		ОбновитьДанныеПодсистемы();
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновитьСтатусыКодовДокумента Тогда
		
		ДокументУчета = СвойствоСтруктуры(ПараметрыКоманды, "ДокументУчета");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ДокументУчета_ОбновитьСтатусыКодов(ДокументУчета);
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = Команды.ПроверитьКодыДокумента Тогда
		
		ДокументУчета = СвойствоСтруктуры(ПараметрыКоманды, "ДокументУчета");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ДокументУчета_ПроверитьКоды(ДокументУчета);
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбменССервисом Тогда
		
		КонтекстОбмена = СвойствоСтруктуры(ПараметрыКоманды, "КонтекстОбмена");
		
		Если ЗначениеЗаполнено(КонтекстОбмена) Тогда
			ВыполнитьОбменССервисом(КонтекстОбмена);
		Иначе
			МодульМаркировки().ВыполнитьОбменПоВсемОрганизациям();
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = Команды.ОбновлениеТарифов Тогда
		
		ОбновитьИнформациюОТарифах();
		
	Иначе
		ТекстОшибки = НСтр("ru = 'Неизвестный идентификатор команды: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ИдентификаторКоманды);
	КонецЕсли;
	
	ОтправитьМетрики();
	
КонецПроцедуры

// Вызывает одноименное событие в ПМ
//
// Параметры:
//  ДопПараметры - Произвольный - дополнительные параметры, которые можно передать в ПМ
//
Процедура ВыполнитьРегламентныеДействия(ДопПараметры = Неопределено) Экспорт
	
	Метрика_Функциональность_РегламентныеДействия();
	
	ПМ_ОбработатьСобытие("ВыполнитьРегламентныеДействия", ДопПараметры);
	
КонецПроцедуры

// #КонецОбласти // КомандыВнешнейОбработки

// #Область Инициализация

// Заполняет параметры модуля с проверкой перехода на новую версию
//
Процедура Инициализировать()
	
	ПараметрыСессии_Инициализировать();
	
КонецПроцедуры

// Проверяет наличие параметров сеанса для запуска через общий модуль
//
// Параметры:
//  ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы модуля
//
Функция МодульИнициализирован()
	
	Попытка
		ВерсияМодуляСессии = ПараметрыСессии_Прочитать("ВерсияМодуля");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Результат = (ВерсияМодуляСессии = ВерсияОбработки());
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Инициализация

// #Область ОбработчикиФоновогоОбновленияДанныхПодсистемы

// Выполняет фоновое обновление данных подсистемы
//
Процедура ОбновитьДанныеПодсистемы() Экспорт
	
	// BSLLS:SetPrivilegedMode-off
	
	УстановитьПривилегированныйРежим(Истина);
	
	РазрешитьЧтениеЗаписьОбъектовВПроцессеОбновления();
	
	Попытка
		ВыполнитьОбновлениеДанныхПодсистемы();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗапретитьЧтениеЗаписьОбъектовВПроцессеОбновления();
		ВызватьИсключение;
	КонецПопытки;
	
	ОбновлениеДанных_УдалитьБитыеСсылки();
	
	ЗапретитьЧтениеЗаписьОбъектовВПроцессеОбновления();
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	// BSLLS:SetPrivilegedMode-on
	
КонецПроцедуры

Процедура ВыполнитьОбновлениеДанныхПодсистемы()
	
	ВерсииДанных = Перечисление_ВерсииДанныхПодсистемы();
	
	Запрос = ОбновлениеДанных_Запрос();
	ВыборкаНеделя = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ОсталосьОбработать = ВыборкаНеделя.Количество();
	
	КэшРД = Новый Соответствие;
	ЕстьВерсия_3_16 = Ложь;
	ЕстьВерсия_3_24 = Ложь;
	ТоварыДляОбновленияИзСервиса = Новый Массив;
	
	Пока ВыборкаНеделя.Следующий() Цикл
		
		Выборка = ВыборкаНеделя.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Объект = Выборка.Объект;
			Версия = Выборка.Версия;
			
			Если Версия = ВерсииДанных.Версия_3_16_0 Тогда
				ЕстьВерсия_3_16 = Истина;
			КонецЕсли;
			
			Если Версия = ВерсииДанных.Версия_3_24_0 Тогда
				ЕстьВерсия_3_24 = Истина;
			КонецЕсли;
			
			Если ОсталосьОбработать = 1 Тогда
				// Перед тем как закончить, выполним действия, которых нет в отложенном обновлении
				// Если что-то пойдет не так, сможем вернуться к ним при следующей попытке
				
				Если ЕстьВерсия_3_16 Тогда
					ОбновлениеДанных_3_16_0_УдалитьУстаревшиеПолныеКоды();
					ОбновлениеДанных_3_16_0_ПеренестиУстаревшиеКодыВФайлы();
					ОбновлениеДанных_3_16_0_ОчиститьРегистрСвязиКлючейКодов();
				КонецЕсли;
				
				Если ЕстьВерсия_3_24 Тогда
					ОбновлениеДанных_3_24_0_ОчиститьКоличествоУпаковокУНаборов(Версия);
				КонецЕсли;
				
			КонецЕсли;
			
			ОбновлениеДанных_ОбновитьФайл(Объект, Версия);
			ОбновлениеДанных_ОбновитьДокумент(Объект, Версия);
			ОбновлениеДанных_ОбновитьОперацию(Объект, Версия, КэшРД);
			ОбновлениеДанных_ДобавитьТоварДляОбновленияИзСервиса(Объект, Версия, ТоварыДляОбновленияИзСервиса);
			
		КонецЦикла;
		
		ОбновлениеДанных_ОбновитьТоварыИзСервиса(ТоварыДляОбновленияИзСервиса);
		
		ОсталосьОбработать = ОсталосьОбработать - 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновлениеДанных_ОбновитьДокумент(Объект, ВерсияДанных)
	
	Если ТипЗнч(Объект) <> Тип("СправочникСсылка.КонтурМаркировка_ДокументыУчета") Тогда
		Возврат;
	КонецЕсли;
	
	ВерсииДанных = Перечисление_ВерсииДанныхПодсистемы();
	
	Если ВерсияДанных = ВерсииДанных.Версия_3_16_0 Тогда
		ОбновлениеДанных_3_16_0_ОбновитьДанныеДокумента(Объект, ВерсияДанных);
	КонецЕсли;
	
	Если ВерсияДанных = ВерсииДанных.Версия_3_18_0 Тогда
		ОбновлениеДанных_3_18_0_ЗаполнитьВДокументеУчетаОтражениеВЭДО(Объект, ВерсияДанных);
	КонецЕсли;
	
	Если ВерсияДанных = ВерсииДанных.Версия_3_24_0 Тогда
		ОбновлениеДанных_3_24_ОбновитьВДокументеУчетаОтражениеВЭДО(Объект, ВерсияДанных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновлениеДанных_ОбновитьОперацию(Объект, ВерсияДанных, КэшРД)
	
	Если ТипЗнч(Объект) <> Тип("СправочникСсылка.КонтурМаркировка_Операции") Тогда
		Возврат;
	КонецЕсли;
	
	ВерсииДанных = Перечисление_ВерсииДанныхПодсистемы();
	
	Если ВерсияДанных = ВерсииДанных.Версия_3_16_0 Тогда
		ОбновлениеДанных_3_16_0_ОбновитьКоличествоКодовОперации(Объект, ВерсияДанных);
	КонецЕсли;
	
	Если ВерсияДанных = ВерсииДанных.Версия_3_18_0 Тогда
		ОбновлениеДанных_3_18_0_ОбновитьРазрешительнуюДокументациюВОперациях(Объект, ВерсияДанных, КэшРД);
	КонецЕсли;
	
	Если ВерсияДанных = ВерсииДанных.Версия_3_19_6 Тогда
		ОбновлениеДанных_3_19_6_РазделитьНаПорцииКодыЗаказов(Объект, ВерсияДанных);
	КонецЕсли;
	
	Если ВерсияДанных = ВерсииДанных.Версия_3_23_2 Тогда
		ОбновлениеДанных_3_23_2_ПереименоватьТипОперации(Объект, ВерсияДанных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновлениеДанных_ОбновитьФайл(Объект, ВерсияДанных)
	
	Если ТипЗнч(Объект) <> Тип("СправочникСсылка.КонтурМаркировка_Файлы") Тогда
		Возврат;
	КонецЕсли;
	
	ВерсииДанных = Перечисление_ВерсииДанныхПодсистемы();
	
	Если ВерсияДанных = ВерсииДанных.Версия_3_17_4 Тогда
		ОбновлениеДанных_3_17_4_УдалитьВПолныхКодахКавычкиЭкранированияCSV(Объект, ВерсияДанных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновлениеДанных_ДобавитьТоварДляОбновленияИзСервиса(Объект, Версия, ТоварыДляОбновленияИзСервиса)
	
	Если ТипЗнч(Объект) <> Тип("СправочникСсылка.КонтурМаркировка_Товары") Тогда
		Возврат;
	КонецЕсли;
	
	ВерсииДанных = Перечисление_ВерсииДанныхПодсистемы();
	
	Если Версия = ВерсииДанных.Версия_3_18_0
		Или Версия = ВерсииДанных.Версия_3_19_0
		Или Версия = ВерсииДанных.Версия_3_24_0 Тогда
		ТоварыДляОбновленияИзСервиса.Добавить(Объект);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновлениеДанных_ОбновитьТоварыИзСервиса(ТоварыДляОбновленияИзСервиса)
	
	Если Не ЗначениеЗаполнено(ТоварыДляОбновленияИзСервиса) Тогда
		Возврат;
	КонецЕсли;
	
	СвернутьМассивЛок(ТоварыДляОбновленияИзСервиса);
	
	ЗапросGTIN = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.GTIN КАК GTIN
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары КАК Т
	|ГДЕ
	|	Т.Ссылка В(&ПорцияТоваров)");
	
	РазмерПорции = 1000;
	
	// BSLLS:CreateQueryInCycle-off
	
	Для Каждого ПорцияТоваров Из РазбитьМассив(ТоварыДляОбновленияИзСервиса, РазмерПорции) Цикл
		
		ЗапросGTIN.УстановитьПараметр("ПорцияТоваров", ПорцияТоваров);
		МассивGTIN = МассивИзРезультатаЗапроса(ЗапросGTIN, "GTIN");
		
		Попытка
			Товары_СоздатьОбновитьПоИнформацииИзСервиса(МассивGTIN);
			ОбновлениеДанных_УдалитьОбъекты(ПорцияТоваров);
		Исключение
			Действие = НСтр("ru = 'Фоновое обновление данных товаров маркировки из сервиса'");
			ОбработатьОшибку(Действие, ИнформацияОбОшибке());
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
	ТоварыДляОбновленияИзСервиса.Очистить();
	
КонецПроцедуры

Процедура ОбновлениеДанных_3_16_0_ОбновитьДанныеДокумента(ДокументУчета, Версия)
	
	ИмяДопРеквизитаВерсияДанных = "ВерсияДанныхДокумента1С";
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ДокументУчета_Заблокировать(ДокументУчета);
		
		ОбъектДокумента = ДокументУчета.ПолучитьОбъект();
		ОбъектДокумента.ВерсияДанныхДокумента1С = ДопРеквизит_Прочитать(ДокументУчета, ИмяДопРеквизитаВерсияДанных);
		ОбъектДокумента.ОтражениеВЭДО = "";
		
		Для Каждого Стр Из ОбъектДокумента.ТоварыДокумента Цикл
			Стр.НомерСтрокиДокумента = Стр.НомерСтроки;
		КонецЦикла;
		
		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();
		
		КодыДокументов_ОбновитьКоличествоКодов(ДокументУчета);
		
		ОбновлениеДанных_УдалитьОбъекты(ДокументУчета, Версия);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Фоновое обновление данных документа'");
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(Версия, "Версия");
		ДопИнформация.Добавить(ДокументУчета, "Документ учета");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		ВызватьИсключение;
	КонецПопытки;
	
	ТекстСообщения = ПараметрыВСтроку(НСтр("ru = 'Документ обновлен до версии %1'"), Версия);
	ДобавитьПредупреждениеВЖурналРегистрации(ТекстСообщения, ДокументУчета);

КонецПроцедуры

Процедура ОбновлениеДанных_3_16_0_ОбновитьКоличествоКодовОперации(Операция, Версия)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыОпераций_ОбновитьКоличествоКодов(Операция);
		
		ОбновлениеДанных_УдалитьОбъекты(Операция, Версия);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Фоновое обновление количества кодов операции'");
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(Версия, "Версия");
		ДопИнформация.Добавить(Операция, "Операция");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		ВызватьИсключение;
	КонецПопытки;
	
	ТекстСообщения = ПараметрыВСтроку(НСтр("ru = 'Операция обновлена до версии %1'"), Версия);
	ДобавитьПредупреждениеВЖурналРегистрации(ТекстСообщения, Операция);

КонецПроцедуры

Процедура ОбновлениеДанных_3_16_0_УдалитьУстаревшиеПолныеКоды()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Файл
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.ТипФайла = &ПолныеКоды
	|	И Т.ВерсияФормата = """"");
	Запрос.УстановитьПараметр("ПолныеКоды", Перечисление_ТипыФайлов().ПолныеКоды);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Файлы_Удалить(Выборка.Файл);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновлениеДанных_3_16_0_ПеренестиУстаревшиеКодыВФайлы()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ПОМЕСТИТЬ ТаблицаДляЗаписиУстаревшиеКоды
	|ИЗ
	|	РегистрСведений.УдалитьКонтурМаркировка_УстаревшиеКоды КАК УстаревшиеКоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО УстаревшиеКоды.КлючКода = КодыМаркировки.КлючКода");
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
	УстаревшиеКоды_ВТ_Записать(Запрос.МенеджерВременныхТаблиц);
	Запрос.МенеджерВременныхТаблиц.Закрыть();
	
	Набор = РегистрыСведений.УдалитьКонтурМаркировка_УстаревшиеКоды.СоздатьНаборЗаписей();
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	
КонецПроцедуры

Процедура ОбновлениеДанных_3_16_0_ОчиститьРегистрСвязиКлючейКодов()
	
	Набор = РегистрыСведений.УдалитьКонтурМаркировка_СвязиКлючейКодов.СоздатьНаборЗаписей();
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	
КонецПроцедуры

Процедура ОбновлениеДанных_3_17_4_УдалитьВПолныхКодахКавычкиЭкранированияCSV(Файл, Версия)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ОписаниеФайла = Файл_Прочитать(Файл);
		
		Если ОписаниеФайла <> Неопределено Тогда
			ТаблицаКодов_УдалитьВПолныхКодахКавычкиЭкранированияCSV(ОписаниеФайла.ДанныеФайла);
			Файл_Записать(ОписаниеФайла);
		КонецЕсли;
		
		ОбновлениеДанных_УдалитьОбъекты(Файл, Версия);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Действие = НСтр("ru = 'Фоновое обновление файлов с полными кодами'");
		ОбработатьОшибку(Действие, ИнформацияОбОшибке(), Новый Структура("Версия, Файл", Версия, Файл));
		ВызватьИсключение;
	КонецПопытки;
	
	ТекстСообщения = ПараметрыВСтроку(НСтр("ru = 'Файл с полными кодами обновлен до версии %1'"), Версия);
	ДобавитьПредупреждениеВЖурналРегистрации(ТекстСообщения, Файл);
	
КонецПроцедуры

Процедура ОбновлениеДанных_3_18_0_ОбновитьРазрешительнуюДокументациюВОперациях(Операция, Версия, КэшРД)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		Операция_Заблокировать(Операция);
		
		ОбъектОперации = Операция.ПолучитьОбъект();
		
		Для Каждого Стр Из ОбъектОперации.Товары Цикл
			
			ДопРеквизитыИБ = Стр.ДопРеквизиты.Получить();
			Номер = СвойствоСтруктуры(ДопРеквизитыИБ, "НомерДокументаСертификации");
			ВидДокумента = СвойствоСтруктуры(ДопРеквизитыИБ, "ВидДокументаСертификации");
			ДатаОформления = СвойствоСтруктуры(ДопРеквизитыИБ, "ДатаДокументаСертификации");
			
			Если Не ЗначениеЗаполнено(Номер)
				Или Не ЗначениеЗаполнено(ВидДокумента)
				Или Не ЗначениеЗаполнено(ДатаОформления) Тогда
				Продолжить;
			КонецЕсли;
			
			РазрешительныйДокумент = КэшРД[Номер];
			Если РазрешительныйДокумент = Неопределено Тогда
				ОписаниеРД = Новый_РазрешительныйДокумент();
				ОписаниеРД.Номер = Номер;
				ОписаниеРД.ВидДокумента = ВидДокумента;
				ОписаниеРД.ДатаОформления = ДатаОформления;
				РазрешительныйДокумент = РазрешительныйДокумент_Записать(ОписаниеРД);
				КэшРД.Вставить(Номер, РазрешительныйДокумент);
			КонецЕсли;
			
			ДопРеквизитыИБ.Удалить("НомерДокументаСертификации");
			ДопРеквизитыИБ.Удалить("ВидДокументаСертификации");
			ДопРеквизитыИБ.Удалить("ДатаДокументаСертификации");
			ДопРеквизитыИБ.Вставить("РазрешительныйДокумент", РазрешительныйДокумент);
			
			Стр.ДопРеквизиты = ЗначениеВХранилище(ДопРеквизитыИБ);
			
		КонецЦикла;
		
		Если ОбъектОперации.Модифицированность() Тогда
			ОбъектОперации.ОбменДанными.Загрузка = Истина;
			ОбъектОперации.Записать();
		КонецЕсли;
		
		ОбновлениеДанных_УдалитьОбъекты(Операция, Версия);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Действие = НСтр("ru = 'Фоновое обновление разрешительной документации операции'");
		ОбработатьОшибку(Действие, ИнформацияОбОшибке(), Новый Структура("Версия, Операция", Версия, Операция));
		ВызватьИсключение;
	КонецПопытки;
	
	ДобавитьПредупреждениеВЖурналРегистрации(ПараметрыВСтроку(НСтр("ru = 'Операция обновлена до версии %1'"), Версия), Операция);
	
КонецПроцедуры

Процедура ОбновлениеДанных_3_18_0_ЗаполнитьВДокументеУчетаОтражениеВЭДО(ДокументУчета, Версия)
	
	ОтраженияВЭДО = Перечисление_ОтраженияВЭДО();
	ПравилаОтраженияВЭДО = Перечисление_ПравилаОтраженияВЭДО();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ДокументУчета_Заблокировать(ДокументУчета);
		
		ОбъектДокумента = ДокументУчета.ПолучитьОбъект();
		
		Если Не ДокументУчета_ЕстьРолиДляОтраженияВЭДО(ДокументУчета) Тогда
			
			ОбъектДокумента.ОтражениеВЭДО = "";
			
		Иначе
			
			Отбор = Новый Структура("НеПодлежитМаркировке, ОтражениеВЭДО", Ложь);
			
			Отбор.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ПУ;
			ЕстьСтрокиПУ = ЗначениеЗаполнено(ОбъектДокумента.ТоварыДокумента.НайтиСтроки(Отбор));
			
			Отбор.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ОСУ;
			ЕстьСтрокиОСУ = ЗначениеЗаполнено(ОбъектДокумента.ТоварыДокумента.НайтиСтроки(Отбор));
			
			Если ЕстьСтрокиПУ И ЕстьСтрокиОСУ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУПУ;
			ИначеЕсли ЕстьСтрокиПУ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ПУ;
			ИначеЕсли ЕстьСтрокиОСУ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУ;
			Иначе
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.НеОтражать;
			КонецЕсли;
			
		КонецЕсли;
		
		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();
		
		ОбновлениеДанных_УдалитьОбъекты(ДокументУчета, Версия);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Фоновое обновление данных документа'");
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(Версия, "Версия");
		ДопИнформация.Добавить(ДокументУчета, "Документ учета");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		ВызватьИсключение;
	КонецПопытки;
	
	ТекстСообщения = ПараметрыВСтроку(НСтр("ru = 'Документ обновлен до версии %1'"), Версия);
	ДобавитьПредупреждениеВЖурналРегистрации(ТекстСообщения, ДокументУчета);
	
КонецПроцедуры

Процедура ОбновлениеДанных_3_19_6_РазделитьНаПорцииКодыЗаказов(ЗаказКодов, Версия)
	
	ТипФайла = Перечисление_ТипыФайлов().КодыЗаказа;
	ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар;
	ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix;
	ОписаниеЗаказа = Операция_ПрочитатьОперацию(ЗаказКодов);
	СпособВыпускаТоваров = ОписаниеЗаказа.ДопРеквизиты.СпособВыпускаТоваров;
	ВидПродукции = ОписаниеЗаказа.ВидПродукции;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыЗаказов_Заблокировать(ЗаказКодов);
		
		Файл = Файл_Найти(ЗаказКодов, ТипФайла);
		ОписаниеФайла = Файл_Прочитать(Файл);
		Файлы_Удалить(Файл);
		
		Если ОписаниеФайла <> Неопределено И ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
			
			ТаблицаКодов = ОписаниеФайла.ДанныеФайла;
			ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
			ТаблицаКодов_ДополнитьИнформациейИБ(ТаблицаКодов);
			ТаблицаЗначений_УдалитьПустыеСтроки(ТаблицаКодов, "Товар");
			
			Для Каждого Стр Из ТаблицаКодов Цикл
				
				Стр.ЗаказКодов = ЗаказКодов;
				Стр.ТипУпаковки = ТипУпаковки;
				Стр.ТипШтрихкода = ТипШтрихкода;
				Стр.ВидПродукции = ВидПродукции;
				Стр.СпособВыпускаТоваров = СпособВыпускаТоваров;
				Стр.ДляНанесения = Истина;
				Стр.ЕстьПолныйКод = Истина;
				Стр.ОбщийТипУпаковки = ОбщийТипУпаковкиПоТипуКодаМаркировки(Стр.Товар.ТипКодаМаркировки);
				
			КонецЦикла;
			
			КодыЗаказов_Записать(ТаблицаКодов, ЗаказКодов);
			
		КонецЕсли;
		
		ОбновлениеДанных_УдалитьОбъекты(ЗаказКодов, Версия);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Действие = НСтр("ru = 'Фоновое разделение файлов кодов заказов на порции'");
		ДопИнформация = Новый Структура("Версия, Операция", Версия, ЗаказКодов);
		ОбработатьОшибку(Действие, ИнформацияОбОшибке(), ДопИнформация);
		ВызватьИсключение;
	КонецПопытки;
	
	ТекстСообщения = ПараметрыВСтроку(НСтр("ru = 'Операция обновлена до версии %1'"), Версия);
	ДобавитьПредупреждениеВЖурналРегистрации(ТекстСообщения, ЗаказКодов);
	
КонецПроцедуры

Процедура ОбновлениеДанных_3_23_2_ПереименоватьТипОперации(Операция, Версия)
	
	СтарыйТипОперации = "Наполнение КИГУ";
