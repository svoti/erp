// #Область СобытияПодключаемогоМодуля

Процедура ПМ_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка = Ложь) Экспорт
	
	Настройки = НастройкиМодуля();
	
	Если Не Настройки.ПМ_Использовать
		И Не Настройки.ИспользоватьПлагины
		И Не Настройки.РежимТестирования Тогда
		Возврат;
	КонецЕсли;
	
	МодульМаркировки().ПМ_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПриВыполненииЗадачиВОчередиОбмена(ПараметрыПМ, СтандартнаяОбработка)
	
	Если Мок_ПМ_ОбработатьСобытие("ПриВыполненииЗадачиВОчередиОбмена", ПараметрыПМ, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	ПМ_ОбработатьСобытие("ПриВыполненииЗадачиВОчередиОбмена", ПараметрыПМ, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура ПМ_ОбработатьСобытие_ПриПроверкиКодовДокументаУчета(ДокументУчета, ОписаниеДопПроверок, ТаблицаКодов)
	
	ТипыПроверкиКодов = Перечисление_ТипыПроверкиКодов();
	РезультатыПроверкиКодов = Перечисление_РезультатыПроверкиКодовДокументов();
	
	НастройкаДокумента = ДокументУчета_НастройкаДокумента(ДокументУчета);
	ДопПроверкаКодов1Включена = МассивСодержитЗначение(НастройкаДокумента.ПроверкиКодовДокумента, ТипыПроверкиКодов.ДопПроверкаКодов1);
	ДопПроверкаКодов2Включена = МассивСодержитЗначение(НастройкаДокумента.ПроверкиКодовДокумента, ТипыПроверкиКодов.ДопПроверкаКодов2);
	
	ОписаниеДопПроверок.ДопПроверкаКодов1.Включена = ДопПроверкаКодов1Включена;
	ОписаниеДопПроверок.ДопПроверкаКодов2.Включена = ДопПроверкаКодов2Включена;
	
	ОписаниеДопПроверок.ДопПроверкаКодов1.ИмяКолонки = НастройкаДокумента.ЗаголовокКолонкиДопПроверкаКодов1;
	ОписаниеДопПроверок.ДопПроверкаКодов2.ИмяКолонки = НастройкаДокумента.ЗаголовокКолонкиДопПроверкаКодов2;
	
	Если Не ДопПроверкаКодов1Включена Тогда
		ТаблицаКодов.ЗаполнитьЗначения(РезультатыПроверкиКодов.Отключена, "ДопПроверка1");
	КонецЕсли;
	
	Если Не ДопПроверкаКодов2Включена Тогда
		ТаблицаКодов.ЗаполнитьЗначения(РезультатыПроверкиКодов.Отключена, "ДопПроверка2");
	КонецЕсли;
	
	Если Не ДопПроверкаКодов1Включена И Не ДопПроверкаКодов2Включена Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ТаблицаКодов", ТаблицаКодов);
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("ОписаниеДопПроверок", ОписаниеДопПроверок);
	
	Если Мок_ПМ_ОбработатьСобытие("ПриПроверкиКодовДокументаУчета", ПараметрыПМ) Тогда
		Возврат;
	КонецЕсли;
	
	ПМ_ОбработатьСобытие("ПриПроверкиКодовДокументаУчета", ПараметрыПМ);
	
КонецПроцедуры

