Функция КодыДокументов_Прочитать(ДокументУчета
	, КлючСтрокиДокумента = Неопределено
	, КлючПроверкиКода = Неопределено) Экспорт
	
	ДокументУчета_ИзвлечьКодыИзАрхива(ДокументУчета);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	КодыДокументов.КлючПроверкиКода КАК КлючПроверкиКода,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ЕСТЬNULL(ТоварыДокумента.НомерСтроки, 0) КАК НомерСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КодыДокументов.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И &КлючСтрокиДокумента
	|	И &КлючПроверкиКода";
	
	Если КлючСтрокиДокумента = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", "ИСТИНА");
	Иначе
		Условие = "КодыДокументов.КлючСтрокиДокумента = &КлючСтрокиДокумента";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", Условие);
	КонецЕсли;
	
	Если КлючПроверкиКода = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючПроверкиКода", "ИСТИНА");
	Иначе
		Условие = "КодыДокументов.КлючПроверкиКода = &КлючПроверкиКода";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючПроверкиКода", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючСтрокиДокумента", КлючСтрокиДокумента);
	Запрос.УстановитьПараметр("КлючПроверкиКода", КлючПроверкиКода);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_ТаблицаКодов();
	
	ТаблицаЗначений_ДобавитьИзВыборки(Результат, Выборка);
	
	Возврат Результат;
	
КонецФункции

Функция КодыДокументов_ОбщееКоличествоКодов(ДокументУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Т.КоличествоКодов), 0) КАК КоличествоКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КоличествоКодов");
	
КонецФункции

Функция КодыДокументов_ЕстьКоды(ДокументУчета, КлючСтрокиДокумента = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета
	|	И &КлючСтрокиДокумента";
	
	Если КлючСтрокиДокумента = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", "ИСТИНА");
	Иначе
		Условие = "Т.КлючСтрокиДокумента = &КлючСтрокиДокумента";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючСтрокиДокумента", КлючСтрокиДокумента);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция КодыДокументов_ЕстьКодВСтруктуреУпаковок(ДокументУчета, КлючКода)
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Стр = ТаблицаКодов.Добавить();
	Стр.КлючКода = КлючКода;
	ТаблицаЗначений_УдалитьЛишниеКолонки(ТаблицаКодов, "КлючКода");
	
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов, "ТаблицаКодов", "КлючКода");
	ТаблицаКодов_ВТ_ДобавитьКлючиАгрегатовВерхнегоУровня(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТаблицаКодов.КлючКода КАК КлючКода
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТаблицаКодов.КлючКода = КодыДокументов.КлючКода
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	ТаблицаКодов.КлючКода <> &КлючКода");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючКода", КлючКода);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	РезультатЗапроса = Запрос.Выполнить();
	
	МенеджерВТ.Закрыть();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

Функция КодыДокументов_ЕстьРезультатыПроверкиКодов(ДокументУчета)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьРезультатыПроверки
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлюч
	|		ПО КодыДокументов.КлючПроверкиКода = ПустойКлюч.Ключ
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И ПустойКлюч.Ключ ЕСТЬ NULL");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура КодыДокументов_Записать(ТаблицаКодов
	, ДокументУчета
	, УдалитьСтарыеКоды = Истина
	, ОбновитьКлючиНоменклатуры1С = Ложь
	, СброситьСтатусыПроверкиКодов = Истина) Экспорт
	
	Если Не УдалитьСтарыеКоды И Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыДокументов_Заблокировать(ДокументУчета);
		
		МенеджерВТ = КодыДокументов_ВТ_ТаблицыДляЗаписи(ТаблицаКодов, ДокументУчета, УдалитьСтарыеКоды, ОбновитьКлючиНоменклатуры1С);
		
		КодыДокументов_ВТ_Записать(МенеджерВТ);
		КодыДокументов_ВТ_ОбновитьКоличествоКодов(МенеджерВТ);
		КодыЗаказов_ВТ_ВернутьКодыВЗаказы(МенеджерВТ);
		УстаревшиеКоды_ВТ_Записать(МенеджерВТ);
		КодыДокументов_ВТ_ОбновитьКлючиНоменклатуры1С(МенеджерВТ);
		
		Если СброситьСтатусыПроверкиКодов Тогда
			ДокументУчета_УстановитьСтатусРезультатаПроверкиКодовНеактуален(ДокументУчета);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыДокументов_ВТ_Записать(МенеджерВТ)
	
	Набор = Новый_ОписаниеНабораРегистраСведений("КонтурМаркировка_КодыДокументов", "ДокументУчета");
	Набор.ТаблицаНабора = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаНабораКодыДокументов", Истина);
	ЗаписатьНаборыРегистраСведенийСРазнымиРежимамиЗаписи(Набор);
	
КонецПроцедуры

Процедура КодыДокументов_ВТ_ОбновитьКлючиНоменклатуры1С(МенеджерВТ)
	
	ТаблицаКодов = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаДляЗаписиКлючиНоменклатуры1С", Истина);
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ТаблицаКодов.Колонки.Удалить("КлючНоменклатуры1С");
	ТаблицаКодов.Колонки.НовыйКлючНоменклатуры1С.Имя = "КлючНоменклатуры1С";
	
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	
КонецПроцедуры

Процедура КодыДокументов_ВТ_ОбновитьКоличествоКодов(МенеджерВТ)
	
	ТаблицаНабора = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаНабораКоличествоКодовДокументов", Истина);
	Если Не ЗначениеЗаполнено(ТаблицаНабора) Тогда
		Возврат;
	КонецЕсли;
	
	КодыДокументов_ЗаблокироватьПоТаблице(ТаблицаНабора);
	
	Набор = Новый_ОписаниеНабораРегистраСведений("КонтурМаркировка_КоличествоКодовДокументов", "ДокументУчета");
	Набор.ТаблицаНабора = ТаблицаНабора;
	ЗаписатьНаборыРегистраСведенийСРазнымиРежимамиЗаписи(Набор);
	
КонецПроцедуры

Функция КодыДокументов_ВТ_ТаблицыДляЗаписи(ТаблицаКодов, ДокументУчета, УдалитьСтарыеКоды, ОбновитьКлючиНоменклатуры1С)
	
	РежимыЗаписи = Перечисление_РежимыЗаписиНабора();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	
	ИменаПолей = "КлючКода, КлючСтрокиДокумента, КлючПроверкиКода, УдалитьИзДокумента";
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов.Скопировать(, ИменаПолей), "ТабКодов", "КлючКода, КлючСтрокиДокумента");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("Удаление", РежимыЗаписи.Удаление);
	Запрос.УстановитьПараметр("Добавление", РежимыЗаписи.Добавление);
	Запрос.УстановитьПараметр("Обновление", РежимыЗаписи.Обновление);
	Запрос.УстановитьПараметр("УдалитьСтарыеКоды", УдалитьСтарыеКоды);
	Запрос.УстановитьПараметр("ОбновитьКлючиНоменклатуры1С", ОбновитьКлючиНоменклатуры1С);
	
	КодыДокументов_ВТ_ДобавитьТаблицуНабора_КодыДокументов(Запрос);
	КодыДокументов_ВТ_ДобавитьТаблицуНабора_КоличествоКодовДокументов(Запрос);
	КодыДокументов_ВТ_ДобавитьТаблицуДляЗаписи_КлючиНоменклатуры1С(Запрос);
	
	УстаревшиеКоды_ВТ_ДобавитьТаблицуДляЗаписи(Запрос, "ТаблицаНабораКодыДокументов");
	КодыЗаказов_ВТ_ДобавитьТаблицуДляЗаписи_ВернутьКодыВЗаказы(Запрос);
	
	Возврат МенеджерВТ;
	
КонецФункции

Процедура КодыДокументов_ВТ_ДобавитьТаблицуНабора_КодыДокументов(Запрос)
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ДокументУчета КАК ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	КодыДокументов.КлючПроверкиКода КАК КлючПроверкиКода,
	|	КодыДокументов.КлючПроверкиКода КАК СтарыйКлючПроверкиКода,
	|	ИСТИНА КАК Устаревший,
	|	&Удаление КАК РежимЗаписи
	|ПОМЕСТИТЬ ТаблицаНабораКодыДокументов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабКодов КАК ТабКодов
	|		ПО КодыДокументов.КлючКода = ТабКодов.КлючКода
	|ГДЕ
	|	&УдалитьСтарыеКоды
	|	И ТабКодов.КлючКода ЕСТЬ NULL
	|	И КодыДокументов.ДокументУчета = &ДокументУчета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента,
	|	КодыДокументов.КлючКода,
	|	КодыДокументов.КлючПроверкиКода,
	|	КодыДокументов.КлючПроверкиКода,
	|	ИСТИНА,
	|	&Удаление
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТабКодов.КлючКода = КодыДокументов.КлючКода
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	ТабКодов.УдалитьИзДокумента
	|	И КодыДокументов.КлючКода ЕСТЬ НЕ NULL 
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента,
	|	КодыДокументов.КлючКода,
	|	КодыДокументов.КлючПроверкиКода,
	|	КодыДокументов.КлючПроверкиКода,
	|	ИСТИНА,
	|	&Удаление
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТабКодов.КлючКода = КодыДокументов.КлючКода
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	НЕ ТабКодов.УдалитьИзДокумента
	|	И ТабКодов.КлючСтрокиДокумента <> КодыДокументов.КлючСтрокиДокумента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДокументУчета,
	|	ТабКодов.КлючСтрокиДокумента,
	|	ТабКодов.КлючКода,
	|	ТабКодов.КлючПроверкиКода,
	|	КодыДокументов.КлючПроверкиКода,
	|	ЛОЖЬ,
	|	&Обновление
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТабКодов.КлючКода = КодыДокументов.КлючКода
	|			И ТабКодов.КлючСтрокиДокумента = КодыДокументов.КлючСтрокиДокумента
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	НЕ ТабКодов.УдалитьИзДокумента
	|	И КодыДокументов.КлючПроверкиКода <> ТабКодов.КлючПроверкиКода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДокументУчета,
	|	ТабКодов.КлючСтрокиДокумента,
	|	ТабКодов.КлючКода,
	|	ТабКодов.КлючПроверкиКода,
	|	ПустойКлюч.Ключ,
	|	ЛОЖЬ,
	|	&Добавление
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТабКодов.КлючКода = КодыДокументов.КлючКода
	|			И ТабКодов.КлючСтрокиДокумента = КодыДокументов.КлючСтрокиДокумента
	|			И (КодыДокументов.ДокументУчета = &ДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлюч
	|		ПО (ИСТИНА)
	|ГДЕ
	|	НЕ ТабКодов.УдалитьИзДокумента
	|	И КодыДокументов.КлючКода ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКодов";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура КодыДокументов_ВТ_ДобавитьТаблицуНабора_КоличествоКодовДокументов(Запрос)
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабКодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ТабКодыДокументов.КлючПроверкиКода КАК КлючПроверкиКода,
	|	ТабКодыДокументов.СтарыйКлючПроверкиКода КАК СтарыйКлючПроверкиКода,
	|	ТабКодыДокументов.РежимЗаписи КАК РежимЗаписи,
	|	КодыМаркировки.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода КАК КлючСтатусаКода,
	|	КОЛИЧЕСТВО(*) КАК КоличествоКодов
	|ПОМЕСТИТЬ ТабИзменений
	|ИЗ
	|	ТаблицаНабораКодыДокументов КАК ТабКодыДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабКодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабКодыДокументов.КлючСтрокиДокумента,
	|	ТабКодыДокументов.КлючПроверкиКода,
	|	ТабКодыДокументов.СтарыйКлючПроверкиКода,
	|	ТабКодыДокументов.РежимЗаписи,
	|	КодыМаркировки.КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	Т.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	Т.КлючСтатусаКода КАК КлючСтатусаКода,
	|	Т.КлючПроверкиКода КАК КлючПроверкиКода,
	|	СУММА(Т.КоличествоКодов) КАК КоличествоКодов
	|ПОМЕСТИТЬ ТабКолКодов
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|		Т.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|		Т.КлючСтатусаКода КАК КлючСтатусаКода,
	|		Т.КлючПроверкиКода КАК КлючПроверкиКода,
	|		Т.КоличествоКодов КАК КоличествоКодов
	|	ИЗ
	|		РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК Т
	|	ГДЕ
	|		Т.ДокументУчета = &ДокументУчета
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Т.КлючСтрокиДокумента,
	|		Т.КлючИнформацииОКоде,
	|		Т.КлючСтатусаКода,
	|		Т.КлючПроверкиКода,
	|		-Т.КоличествоКодов
	|	ИЗ
	|		ТабИзменений КАК Т
	|	ГДЕ
	|		Т.РежимЗаписи = &Удаление
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Т.КлючСтрокиДокумента,
	|		Т.КлючИнформацииОКоде,
	|		Т.КлючСтатусаКода,
	|		Т.КлючПроверкиКода,
	|		Т.КоличествоКодов
	|	ИЗ
	|		ТабИзменений КАК Т
	|	ГДЕ
	|		Т.РежимЗаписи = &Добавление
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТабИзменений.КлючСтрокиДокумента,
	|		ТабИзменений.КлючИнформацииОКоде,
	|		ТабИзменений.КлючСтатусаКода,
	|		ТабИзменений.СтарыйКлючПроверкиКода,
	|		-ТабИзменений.КоличествоКодов
	|	ИЗ
	|		ТабИзменений КАК ТабИзменений
	|	ГДЕ
	|		ТабИзменений.РежимЗаписи = &Обновление
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТабИзменений.КлючСтрокиДокумента,
	|		ТабИзменений.КлючИнформацииОКоде,
	|		ТабИзменений.КлючСтатусаКода,
	|		ТабИзменений.КлючПроверкиКода,
	|		ТабИзменений.КоличествоКодов
	|	ИЗ
	|		ТабИзменений КАК ТабИзменений
	|	ГДЕ
	|		ТабИзменений.РежимЗаписи = &Обновление) КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючСтрокиДокумента,
	|	Т.КлючИнформацииОКоде,
	|	Т.КлючСтатусаКода,
	|	Т.КлючПроверкиКода
	|
	|ИМЕЮЩИЕ
	|	СУММА(Т.КоличествоКодов) > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтрокиДокумента,
	|	КлючИнформацииОКоде,
	|	КлючСтатусаКода,
	|	КлючПроверкиКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабИзменений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ДокументУчета КАК ДокументУчета,
	|	ТекКолКодов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ТекКолКодов.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	ТекКолКодов.КлючСтатусаКода КАК КлючСтатусаКода,
	|	ТекКолКодов.КлючПроверкиКода КАК КлючПроверкиКода,
	|	ТекКолКодов.КоличествоКодов КАК КоличествоКодов,
	|	&Удаление КАК РежимЗаписи
	|ПОМЕСТИТЬ ТаблицаНабораКоличествоКодовДокументов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК ТекКолКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабКолКодов КАК ТабКолКодов
	|		ПО ТекКолКодов.КлючСтрокиДокумента = ТабКолКодов.КлючСтрокиДокумента
	|			И ТекКолКодов.КлючИнформацииОКоде = ТабКолКодов.КлючИнформацииОКоде
	|			И ТекКолКодов.КлючСтатусаКода = ТабКолКодов.КлючСтатусаКода
	|			И ТекКолКодов.КлючПроверкиКода = ТабКолКодов.КлючПроверкиКода
	|ГДЕ
	|	ТекКолКодов.ДокументУчета = &ДокументУчета
	|	И ТабКолКодов.КоличествоКодов ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДокументУчета,
	|	ТабКолКодов.КлючСтрокиДокумента,
	|	ТабКолКодов.КлючИнформацииОКоде,
	|	ТабКолКодов.КлючСтатусаКода,
	|	ТабКолКодов.КлючПроверкиКода,
	|	ТабКолКодов.КоличествоКодов,
	|	&Обновление
	|ИЗ
	|	ТабКолКодов КАК ТабКолКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК ТекКолКодов
	|		ПО ТабКолКодов.КлючСтрокиДокумента = ТекКолКодов.КлючСтрокиДокумента
	|			И ТабКолКодов.КлючИнформацииОКоде = ТекКолКодов.КлючИнформацииОКоде
	|			И ТабКолКодов.КлючСтатусаКода = ТекКолКодов.КлючСтатусаКода
	|			И ТабКолКодов.КлючПроверкиКода = ТекКолКодов.КлючПроверкиКода
	|			И (ТекКолКодов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	ТекКолКодов.КоличествоКодов <> ТабКолКодов.КоличествоКодов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДокументУчета,
	|	ТабКолКодов.КлючСтрокиДокумента,
	|	ТабКолКодов.КлючИнформацииОКоде,
	|	ТабКолКодов.КлючСтатусаКода,
	|	ТабКолКодов.КлючПроверкиКода,
	|	ТабКолКодов.КоличествоКодов,
	|	&Добавление
	|ИЗ
	|	ТабКолКодов КАК ТабКолКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК ТекКолКодов
	|		ПО ТабКолКодов.КлючСтрокиДокумента = ТекКолКодов.КлючСтрокиДокумента
	|			И ТабКолКодов.КлючИнформацииОКоде = ТекКолКодов.КлючИнформацииОКоде
	|			И ТабКолКодов.КлючСтатусаКода = ТекКолКодов.КлючСтатусаКода
	|			И ТабКолКодов.КлючПроверкиКода = ТекКолКодов.КлючПроверкиКода
	|			И (ТекКолКодов.ДокументУчета = &ДокументУчета)
	|ГДЕ
	|	ТекКолКодов.КоличествоКодов ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКолКодов";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура КодыДокументов_ВТ_ДобавитьТаблицуДляЗаписи_КлючиНоменклатуры1С(Запрос)
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабКодыДокументов.КлючКода КАК КлючКода,
	|	ТабКодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ ТабДобавления
	|ИЗ
	|	ТаблицаНабораКодыДокументов КАК ТабКодыДокументов
	|ГДЕ
	|	&ОбновитьКлючиНоменклатуры1С
	|	И ТабКодыДокументов.РежимЗаписи = &Добавление
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДобавления.КлючКода КАК КлючКода,
	|	ТоварыДокумента.КлючНоменклатуры1С КАК НовыйКлючНоменклатуры1С
	|ПОМЕСТИТЬ ТаблицаДляЗаписиКлючиНоменклатуры1С
	|ИЗ
	|	ТабДобавления КАК ТабДобавления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабДобавления.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО ТабДобавления.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|ГДЕ
	|	ТоварыДокумента.КлючНоменклатуры1С <> ИнформацияОКодах.КлючНоменклатуры1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабДобавления";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция КодыДокументов_Подобрать(ДокументИлиОперация, ТребуемыеКоды, ДокументИсточник) Экспорт
	
	Если Не ЗначениеЗаполнено(ТребуемыеКоды) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТребуемыеКоды.Сортировать("КлючНоменклатуры Убыв, КлючХарактеристики Убыв, КлючУпаковки Убыв, КлючСерии Убыв, Товар Убыв", Новый СравнениеЗначений);
	
	ЭтоОперация = ТипЗнч(ДокументИлиОперация) = Тип("СправочникСсылка.КонтурМаркировка_Операции");
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	КодыПодобраны = Ложь;
	УдалитьСтарыеКоды = Ложь;
	
	Если ЭтоОперация Тогда
		ТипОперацииПриемника = ЗначениеРеквизитаОбъектаЛок(ДокументИлиОперация, "ТипОперации");
	Иначе
		ТипДокументаПриемника = ЗначениеРеквизитаОбъектаЛок(ДокументИлиОперация, "ТипДокумента");
	КонецЕсли;
	
	// Инициализация таблицы подобранных кодов
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 0 КлючКода КАК КлючКода ПОМЕСТИТЬ ПодобранныеКоды ИЗ РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	// BSLLS:CreateQueryInCycle-off
	
	Для каждого СтрТреб Из ТребуемыеКоды Цикл
		
		ВариантыАналитики = ВариантыАналитикиДляПодбораКодов(СтрТреб);
		
		Для каждого ЗначенияАналитики Из ВариантыАналитики Цикл
			
			Если ЗначениеЗаполнено(СтрТреб.КоличествоКодовТребуется)
				И СтрТреб.КоличествоКодовТребуется = СтрТреб.КоличествоКодовПодобрано Тогда
				Прервать;
			КонецЕсли;
			
			НачатьТранзакцию(РежимУправленияБлокировкой());
			Попытка
				
				ДокументУчета_Заблокировать(ДокументИсточник);
				
				Запрос = КодыДокументов_Подобрать_Запрос(ЗначенияАналитики, ВариантыАналитики, ДокументИсточник, СтрТреб);
				Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
				Запрос.Выполнить();
				
				Если ЕстьСтрокиВТаблицеЗапроса(МенеджерВТ, "ТаблицаКодов") Тогда
					
					Если ЭтоОперация Тогда
						ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперацииПриемника);
					Иначе
						ТаблицаКодов_ВТ_УдалитьКодыДругихДокументов(МенеджерВТ, ТипДокументаПриемника, ДокументИсточник);
					КонецЕсли;
					
					// Оставляем нужное количество кодов
					Если ЗначениеЗаполнено(СтрТреб.КоличествоКодовТребуется) Тогда
						КоличествоКодовТребуется = СтрТреб.КоличествоКодовТребуется - СтрТреб.КоличествоКодовПодобрано;
						ОставитьПервыеСтрокиВТаблицеЗапроса(МенеджерВТ, "ТаблицаКодов", КоличествоКодовТребуется, "КлючКода");
					КонецЕсли;
					
					// Дополняем таблицу подобранных кодов, чтобы учесть их при поиске в следующих итерациях
					ДополнитьТаблицуВЗапросе(МенеджерВТ, "ПодобранныеКоды", "ТаблицаКодов", "КлючКода", "КлючКода");
					
					ТаблицаКодов = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаКодов", Истина);
					ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
					
					СтрТреб.КоличествоКодовПодобрано = СтрТреб.КоличествоКодовПодобрано + ТаблицаКодов.Количество();
					
					Если ЗначениеЗаполнено(СтрТреб.НовыйКлючСтрокиДокумента) Тогда
						ТаблицаКодов.ЗаполнитьЗначения(СтрТреб.НовыйКлючСтрокиДокумента, "КлючСтрокиДокумента");
					КонецЕсли;
					Если ЗначениеЗаполнено(СтрТреб.НовыйКлючСтрокиОперации) Тогда
						ТаблицаКодов.ЗаполнитьЗначения(СтрТреб.НовыйКлючСтрокиОперации, "КлючСтрокиОперации");
					КонецЕсли;
					
					Если ЭтоОперация Тогда
						КодыОпераций_Записать(ТаблицаКодов, ДокументИлиОперация, УдалитьСтарыеКоды);
					Иначе
						КодыДокументов_Записать(ТаблицаКодов, ДокументИлиОперация, УдалитьСтарыеКоды, Истина);
					КонецЕсли;
					
					КодыПодобраны = Истина;
					
				Иначе
					УдалитьТаблицуИзЗапроса(МенеджерВТ, "ТаблицаКодов");
				КонецЕсли;
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				ОтменитьТранзакцию();
				Ошибка = ИнформацияОбОшибке();
				ВызватьИсключение;
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
	Возврат КодыПодобраны;
	
КонецФункции

Функция КодыДокументов_Подобрать_Запрос(ЗначенияАналитики, ВариантыАналитики, ДокументИсточник, СтрТреб)
	
	ШаблонТекстаЗапросаСНоменклатурой =
	"ВЫБРАТЬ
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ПОМЕСТИТЬ ПодходящиеКлючиНоменклатуры1С
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С КАК Т
	|ГДЕ
	|	Т.КлючНоменклатуры = &КлючНоменклатуры
	|	И Т.КлючХарактеристики = &КлючХарактеристики
	|	И Т.КлючУпаковки = &КлючУпаковки
	|	И Т.КлючСерии = &КлючСерии
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючНоменклатуры1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодобранныеКоды КАК ПодобранныеКоды
	|		ПО КодыДокументов.КлючКода = ПодобранныеКоды.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодходящиеКлючиНоменклатуры1С КАК ПодходящиеКлючиНоменклатуры1С
	|		ПО (ИнформацияОКодах.КлючНоменклатуры1С = ПодходящиеКлючиНоменклатуры1С.КлючНоменклатуры1С)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И ПодобранныеКоды.КлючКода ЕСТЬ NULL
	|	И ПодходящиеКлючиНоменклатуры1С.КлючНоменклатуры1С ЕСТЬ НЕ NULL 
	|	И КодыМаркировки.КлючАгрегата = &ПустойИдентификатор
	|	И &КлючСтрокиДокумента
	|	И &Товар
	|	И &ОбщийТипУпаковки
	|	И &ДляНанесения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПодходящиеКлючиНоменклатуры1С";
	
	ШаблонТекстаЗапросаБезНоменклатуры =
	"ВЫБРАТЬ
	|	КодыДокументов.КлючКода КАК КлючКода,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодобранныеКоды КАК ПодобранныеКоды
	|		ПО КодыДокументов.КлючКода = ПодобранныеКоды.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|	И ПодобранныеКоды.КлючКода ЕСТЬ NULL
	|	И КодыМаркировки.КлючАгрегата = &ПустойИдентификатор
	|	И &ПустойКлючНоменклатуры1С
	|	И &КлючСтрокиДокумента
	|	И &Товар
	|	И &ОбщийТипУпаковки
	|	И &ДляНанесения";
	
	Если ЗначениеЗаполнено(ЗначенияАналитики.КлючНоменклатуры) Тогда
		ТекстЗапроса = ШаблонТекстаЗапросаСНоменклатурой;
	Иначе
		ТекстЗапроса = ШаблонТекстаЗапросаБезНоменклатуры;
	КонецЕсли;
	
	Если СтрТреб.ДляНанесения Тогда
		Условие = "ИнформацияОКодах.ЕстьПолныйКод
		|	И ИнформацияОКодах.ДляНанесения
		|	И ИнформацияОКодах.ДатаПечати = &ПустаяДата";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляНанесения", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляНанесения", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТреб.ОбщийТипУпаковки) Тогда
		Условие = "ИнформацияОКодах.ОбщийТипУпаковки = &ОбщийТипУпаковки";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОбщийТипУпаковки", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОбщийТипУпаковки", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТреб.Товар) Тогда
		Условие = "ИнформацияОКодах.Товар = &Товар";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТреб.КлючНоменклатуры1С) Тогда
		Условие = "ИнформацияОКодах.КлючНоменклатуры1С = &ПустойКлючНоменклатуры1С";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустойКлючНоменклатуры1С", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустойКлючНоменклатуры1С", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТреб.КлючСтрокиДокумента) Тогда
		Условие = "КодыДокументов.КлючСтрокиДокумента = &КлючСтрокиДокумента";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументИсточник);
	Запрос.УстановитьПараметр("ОбщийТипУпаковки", СтрТреб.ОбщийТипУпаковки);
	Запрос.УстановитьПараметр("КлючСтрокиДокумента", СтрТреб.КлючСтрокиДокумента);
	Запрос.УстановитьПараметр("ПустойКлючНоменклатуры1С", ПустойКлючНоменклатуры1С());
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата());
	Запрос.УстановитьПараметр("ПустойИдентификатор", ПустойУникальныйИдентификатор());
	
	Для каждого Колонка Из ВариантыАналитики.Колонки Цикл
		Запрос.УстановитьПараметр(Колонка.Имя, ЗначенияАналитики[Колонка.Имя]);
	КонецЦикла;
	
	Возврат Запрос;
	
КонецФункции

Процедура КодыДокументов_ПереместитьВАрхив(ДокументУчета)
	
	ТипыФайлов = Перечисление_ТипыФайлов();
	ДопСвойства = Перечисление_ДопСвойства();
	ВерсииФорматов = Перечисление_ВерсииФорматовФайлов();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыДокументов_Заблокировать(ДокументУчета);
		
		ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
		
		Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
			
			ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
			
			ПоляКодов = ИменаПолейРегистраСведений("КонтурМаркировка_КодыМаркировки");
			ПоляСтатусов = ИменаПолейРегистраСведений("КонтурМаркировка_СтатусыКодовГИСМТ");
			ПоляИнформации = ИменаПолейРегистраСведений("КонтурМаркировка_ИнформацияОКодах", "ЕстьПолныйКод");
			
			СтатусыКодов = ТаблицаКодов.Скопировать( , ПоляСтатусов);
			ИнформацияОКодах = ТаблицаКодов.Скопировать( , ПоляИнформации);
			
			СтатусыКодов.Свернуть(ПоляСтатусов);
			ИнформацияОКодах.Свернуть(ПоляИнформации);
			
			ТаблицаЗначений_УдалитьЛишниеКолонки(ТаблицаКодов, ПоляКодов + ", КлючСтрокиДокумента");
			
			ОписаниеАрхива = Новый_АрхивКодов();
			ОписаниеАрхива.ТаблицаКодов = ТаблицаКодов;
			ОписаниеАрхива.СтатусыКодов = СтатусыКодов;
			ОписаниеАрхива.ИнформацияОКодах = ИнформацияОКодах;
			
			ОписаниеФайла = Новый_ОписаниеФайла();
			ОписаниеФайла.ДанныеФайла = ОписаниеАрхива;
			ОписаниеФайла.ВладелецФайла = ДокументУчета;
			ОписаниеФайла.Идентификатор = ДокументУчета.УникальныйИдентификатор();
			ОписаниеФайла.ВерсияФормата = ВерсииФорматов.Версия_3_16;
			ОписаниеФайла.Размер = ТаблицаКодов.Количество();
			ОписаниеФайла.ТипФайла = ТипыФайлов.КодыДокумента;
			Файл_Записать(ОписаниеФайла);
			
			Набор = РегистрыСведений.КонтурМаркировка_КодыДокументов.СоздатьНаборЗаписей();
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
			Набор.Записать();
			
			Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовДокументов.СоздатьНаборЗаписей();
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
			Набор.Записать();
			
			УстаревшиеКоды_Записать(ТаблицаКодов.ВыгрузитьКолонку("КлючКода"));
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыДокументов_ИзвлечьИзАрхива(ДокументУчета)
	
	ТипыФайлов = Перечисление_ТипыФайлов();
	ДопСвойства = Перечисление_ДопСвойства();
	ВерсииФорматов = Перечисление_ВерсииФорматовФайлов();
	
	Файл = Файл_Найти(ДокументУчета, ТипыФайлов.КодыДокумента);
	Если Не ЗначениеЗаполнено(Файл) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыДокументов_Заблокировать(ДокументУчета);
		Файл_Заблокировать(ДокументУчета.УникальныйИдентификатор());
		
		ОписаниеФайла = Файл_Прочитать(Файл);
		
		Если ОписаниеФайла <> Неопределено Тогда
			
			Если ОписаниеФайла.ВерсияФормата = ВерсииФорматов.Версия_3_16 Тогда
				ТаблицаКодов = КодыДокументов_ИзвлечьИзАрхива_3_16(ДокументУчета, ОписаниеФайла);
			Иначе
				ТаблицаКодов = КодыДокументов_ИзвлечьИзАрхива_3_0(ДокументУчета, ОписаниеФайла);
			КонецЕсли;
			
			ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета);
			Файлы_Удалить(Файл);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция КодыДокументов_ИзвлечьИзАрхива_3_0(ДокументУчета, ОписаниеФайла)
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Для Каждого Стр Из ОписаниеФайла.ДанныеФайла Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаКодов.Добавить(), Стр);
	КонецЦикла;
	ТаблицаКодов.ЗаполнитьЗначения(Истина, "КодРазобран");
	
	ОписаниеФайла.ДанныеФайла.Очистить();
	
	ТаблицаКодов.Колонки.КлючКода.Имя = "СтарыйКлючКода";
	ТаблицаКодов.Колонки.Добавить("КлючКода", ОписаниеТипа_Идентификатор());
	
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	Для Каждого Стр Из ТаблицаКодов.НайтиСтроки(Новый Структура("КлючКода", ПустойУникальныйИдентификатор())) Цикл
		Стр.КлючКода = Стр.СтарыйКлючКода;
	КонецЦикла;
	ТаблицаКодов.Колонки.Удалить("СтарыйКлючКода");
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Возврат ТаблицаКодов;
	
КонецФункции

Функция КодыДокументов_ИзвлечьИзАрхива_3_16(ДокументУчета, ОписаниеФайла)
	
	Если Не ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
		Возврат Новый_ТаблицаКодов();
	КонецЕсли;
	
	ОписаниеАрхива = Новый_АрхивКодов();
	ЗаполнитьЗначенияСвойств(ОписаниеАрхива, ОписаниеФайла.ДанныеФайла);
	
	ТаблицаКодов = ОписаниеАрхива.ТаблицаКодов;
	СтатусыКодов = ОписаниеАрхива.СтатусыКодов;
	ИнформацияОКодах = ОписаниеАрхива.ИнформацияОКодах;
	
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	
	ТаблицаЗначений_ДобавитьИндекс(СтатусыКодов, "КлючСтатусаКода");
	ТаблицаЗначений_ДобавитьИндекс(ИнформацияОКодах, "КлючИнформацииОКоде");
	
	ТаблицаКодов.Колонки.КлючКода.Имя = "СтарыйКлючКода";
	ТаблицаКодов.Колонки.Добавить("КлючКода", ОписаниеТипа_Идентификатор());
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Для Каждого Стр Из ТаблицаКодов.НайтиСтроки(Новый Структура("КлючКода", ПустойУникальныйИдентификатор())) Цикл
		
		Стр.КлючКода = Стр.СтарыйКлючКода;
		Стр.КодРазобран = Истина;
		
		СтрСтатуса = СтатусыКодов.Найти(Стр.КлючСтатусаКода, "КлючСтатусаКода");
		Если СтрСтатуса <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Стр, СтрСтатуса);
		КонецЕсли;
		
		СтрИнформации = ИнформацияОКодах.Найти(Стр.КлючИнформацииОКоде, "КлючИнформацииОКоде");
		Если СтрИнформации <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Стр, СтрИнформации);
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаКодов.Колонки.Удалить("СтарыйКлючКода");
	
	ТаблицаЗначений_УдалитьИндекс(СтатусыКодов, "КлючСтатусаКода");
	ТаблицаЗначений_УдалитьИндекс(ИнформацияОКодах, "КлючИнформацииОКоде");
	
	Возврат ТаблицаКодов;
	
КонецФункции

Процедура КодыДокументов_ОбновитьКоличествоКодов(ДокументУчета)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыДокументов.ДокументУчета КАК ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	КодыДокументов.КлючПроверкиКода КАК КлючПроверкиКода,
	|	КодыМаркировки.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода КАК КлючСтатусаКода,
	|	КОЛИЧЕСТВО(*) КАК КоличествоКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыДокументов.КлючКода = КодыМаркировки.КлючКода
	|ГДЕ
	|	КодыДокументов.ДокументУчета = &ДокументУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыДокументов.ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента,
	|	КодыДокументов.КлючПроверкиКода,
	|	КодыМаркировки.КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовДокументов.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
	
	ТаблицаНабора = Набор.Выгрузить();
	ТаблицаЗначений_Дополнить(ТаблицаНабора, Запрос.Выполнить().Выгрузить());
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаНабора, "КоличествоКодов");
	
	Набор.Загрузить(ТаблицаНабора);
	Набор.Записать();
	
КонецПроцедуры

Процедура КодыДокументов_ОбновитьКоличествоКодовПоКлючамКодов(КлючиКодов)
	
	Если Не ЗначениеЗаполнено(КлючиКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ДокументУчета КАК ДокументУчета
	|ПОМЕСТИТЬ ДокументыУчета
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.КлючКода В(&КлючиКодов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыУчета.ДокументУчета КАК ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	КодыМаркировки.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода КАК КлючСтатусаКода,
	|	СУММА(1) КАК КоличествоКодов
	|ИЗ
	|	ДокументыУчета КАК ДокументыУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ДокументыУчета.ДокументУчета = КодыДокументов.ДокументУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО (КодыДокументов.КлючКода = КодыМаркировки.КлючКода)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыУчета.ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента,
	|	КодыМаркировки.КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументУчета
	|ИТОГИ ПО
	|	ДокументУчета");
	
	Запрос.УстановитьПараметр("КлючиКодов", КлючиКодов);
	
	ВыборкаДокумент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовДокументов.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументУчета.Установить(ВыборкаДокумент.ДокументУчета);
		
		ТаблицаНабора = Набор.Выгрузить();
		
		Выборка = ВыборкаДокумент.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаНабора.Добавить(), Выборка);
		КонецЦикла;
		
		ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаНабора, "КоличествоКодов");
		
		Набор.Загрузить(ТаблицаНабора);
		Набор.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура КодыДокументов_Заблокировать(ДокументУчета) Экспорт
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_КодыДокументов");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("ДокументУчета", ДокументУчета);
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("ДокументУчета", ДокументУчета);
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Процедура КодыДокументов_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "ДокументУчета")
	
	Поле = "ДокументУчета";
	
	ИменаОбъектов = Новый Массив;
	ИменаОбъектов.Добавить("РегистрСведений.КонтурМаркировка_КодыДокументов");
	ИменаОбъектов.Добавить("РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов");
	
	ЗаблокироватьПоТаблице(ИменаОбъектов, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

Процедура КодыДокументов_РасформироватьАгрегат(КлючАгрегата, ТаблицаКодов)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ДокументУчета КАК ДокументУчета,
	|	МАКСИМУМ(Т.КлючСтрокиДокумента) КАК КлючСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.КлючКода = &КлючАгрегата
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ДокументУчета");
	Запрос.УстановитьПараметр("КлючАгрегата", КлючАгрегата);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		КодыДокументов_ЗаблокироватьПоТаблице(РезультатЗапроса);
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТаблицаКодов.ЗаполнитьЗначения(Выборка.КлючСтрокиДокумента, "КлючСтрокиДокумента");
			КодыДокументов_Записать(ТаблицаКодов, Выборка.ДокументУчета, Ложь, Истина);
			ДокументУчета_ОбновитьТребуемоеДействие(Выборка.ДокументУчета);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция КодыДокументов_КлючСтрокиДокумента(КлючКода, ДокументУчета)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыДокументов КАК Т
	|ГДЕ
	|	Т.КлючКода = &КлючКода
	|	И Т.ДокументУчета = &ДокументУчета");
	Запрос.УстановитьПараметр("КлючКода", КлючКода);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КлючСтрокиДокумента");
	
КонецФункции

Функция КодыДокументов_ДляПроверки(ДокументУчета)
	
	РезультатыПроверкиКодов = Перечисление_РезультатыПроверкиКодовДокументов();
	РолиДокументов = Перечисление_РолиДокументовУчета();
	ВидыКорректировки = Перечисление_ВидыКорректировкиДокумента();
	ПустойУникальныйИдентификатор = ПустойУникальныйИдентификатор();
	
	ЕстьРольОтгрузка = ДокументУчета_ДоступнаРоль(ДокументУчета, РолиДокументов.Отгрузка);
	ЕстьРольКорректировка = ДокументУчета_ДоступнаРоль(ДокументУчета, РолиДокументов.КорректировкаОтгрузки);
	
	Если Не ЕстьРольОтгрузка И Не ЕстьРольКорректировка Тогда
		Возврат Новый_ТаблицаКодов();
	КонецЕсли;
	
	ВидКорректировки = ДокументУчета_ВидКорректировки(ДокументУчета);
	
	ЭтоКорректировка = (ЕстьРольКорректировка И ВидКорректировки = ВидыКорректировки.Корректировка);
	ЭтоИсправление = (ЕстьРольКорректировка И ВидКорректировки = ВидыКорректировки.Исправление);
	
	ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ТаблицаКодов_ДобавитьКолонкиДляПроверкиКодов(ТаблицаКодов);
	ТаблицаКодов.ЗаполнитьЗначения(Истина, "ПроверятьКод");
	ТаблицаКодов.ЗаполнитьЗначения(ПустойУникальныйИдентификатор, "КлючПроверкиКода");
	ТаблицаКодов.ЗаполнитьЗначения(РезультатыПроверкиКодов.НеТребуется, РезультатыПроверкиКодов_ИменаПолей());
	
	ТаблицаКодовОснования = Новый_ТаблицаКодов();
	Если ЭтоКорректировка Или ЭтоИсправление Тогда
		
		ИсправляемыйДокументУчета = ДокументУчета_ИсходныйИсправляемыйДокументУчета(ДокументУчета);
		
		Если ЗначениеЗаполнено(ИсправляемыйДокументУчета) Тогда
			
			ТаблицаКодовОснования = КодыДокументов_Прочитать(ИсправляемыйДокументУчета);
			ТаблицаКодов_ДобавитьКлючиВсехВложенныхКодов(ТаблицаКодовОснования);
			
			ТаблицаКодовОснования.Индексы.Добавить("КлючКода");
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЕстьКодыОснования = ЗначениеЗаполнено(ТаблицаКодовОснования);
	КлючиСтрокОСУ = ДокументУчета_КлючиСтрокДокументаОСУ(ДокументУчета);
	КлючиСтрокПартУчет = ДокументУчета_КлючиСтрокДокументаПартионныйУчет(ДокументУчета);
	
	Для Каждого Стр Из ТаблицаКодов Цикл
		
		ЭтоКодСтрокиОСУ = КлючиСтрокОСУ.Найти(Стр.КлючСтрокиДокумента) <> Неопределено;
		ЭтоКодСтрокиПартУчет = КлючиСтрокПартУчет.Найти(Стр.КлючСтрокиДокумента) <> Неопределено;
		КодЕстьВОсновании = ЕстьКодыОснования И ТаблицаКодовОснования.Найти(Стр.КлючКода, "КлючКода") <> Неопределено;
		
		Стр.ПроверятьКод = Не КодЕстьВОсновании И Не ЭтоКодСтрокиОСУ И Не ЭтоКодСтрокиПартУчет;
		
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Добавить("ПроверятьКод");
	
	Возврат ТаблицаКодов;
	
КонецФункции

Функция КодыДокументов_КоличествоКодовПоСтатусам(ДокументУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СтатусыКодов.Статус, """") КАК СтатусКодов,
	|	СУММА(Т.КоличествоКодов) КАК Количество
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО Т.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(СтатусыКодов.Статус, """")");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция Новый_АрхивКодов()
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаКодов");
	Результат.Вставить("СтатусыКодов");
	Результат.Вставить("ИнформацияОКодах");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // КодыДокументов

// #Область КлючиНоменклатуры1С

// Находит или создает ключ номенклатуры 1С по ключевым реквизитам
//
// Параметры:
//  АналитикаНоменклатуры - Структура, СтрокаТаблицыЗначений - содержит поля:
//   * Номенклатура - СправочникСсылка - номенклатура;
//   * Характеристика - СправочникСсылка - характеристика;
//   * Упаковка - СправочникСсылка - упаковка;
//   * Серия - СправочникСсылка - серия;
//  КэшРезультатов - Соответствие - локальный кэш результатов;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С
//
Функция КлючНоменклатуры1С_Подобрать(АналитикаНоменклатуры, КэшРезультатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(АналитикаНоменклатуры.Номенклатура) Тогда
		Возврат ПустойКлючНоменклатуры1С();
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КлючКэш = СтрокаАналитикиНоменклатуры1С(АналитикаНоменклатуры);
		Результат = КэшРезультатов[КлючКэш];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	АналитикаКлюча = Новый_АналитикаКлючаНоменклатуры1С(АналитикаНоменклатуры);
	
	Результат = КлючНоменклатуры1С_Найти(АналитикаКлюча);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		КлючиАналитикиНоменклатуры1С_Записать(АналитикаКлюча);
		Результат = КлючНоменклатуры1С_Найти(АналитикаКлюча);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит или создает ключ номенклатуры 1С по аналитике ключа
//
// Параметры:
//  АналитикаКлюча - Структура, СтрокаТабличнойЧасти - содержит поля:
//   * КлючНоменклатуры - УникальныйИдентификатор - ключ номенклатуры;
//   * КлючХарактеристики - УникальныйИдентификатор - ключ характеристики;
//   * КлючУпаковки - УникальныйИдентификатор - ключ упаковки;
//   * КлючСерии - УникальныйИдентификатор - ключ серии;
//   * ТипКлючаНоменклатуры - Строка - полное имя справочника номенклатуры;
//   * ТипКлючаХарактеристики - Строка - полное имя справочника характеристики;
//   * ТипКлючаУпаковки - Строка - полное имя справочника упаковки;
//   * ТипКлючаСерии - Строка - полное имя справочника серии;
//  КэшРезультатов - Соответствие - локальный кэш результатов;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С
//
Функция КлючНоменклатуры1С_ПодобратьПоАналитикеКлюча(АналитикаКлюча, КэшРезультатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(АналитикаКлюча.КлючНоменклатуры) Тогда
		Возврат ПустойКлючНоменклатуры1С();
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КлючКэш = СтрокаАналитикиКлючаНоменклатуры1С(АналитикаКлюча);
		Результат = КэшРезультатов[КлючКэш];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = КлючНоменклатуры1С_Найти(АналитикаКлюча);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		КлючиАналитикиНоменклатуры1С_Записать(АналитикаКлюча);
		Результат = КлючНоменклатуры1С_Найти(АналитикаКлюча);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлючНоменклатуры1С_Найти(АналитикаКлюча)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С КАК Т
	|ГДЕ
	|	Т.КлючНоменклатуры = &КлючНоменклатуры
	|	И Т.КлючХарактеристики = &КлючХарактеристики
	|	И Т.КлючУпаковки = &КлючУпаковки
	|	И Т.КлючСерии = &КлючСерии");
	
	Запрос.УстановитьПараметр("КлючНоменклатуры", АналитикаКлюча.КлючНоменклатуры);
	Запрос.УстановитьПараметр("КлючХарактеристики", АналитикаКлюча.КлючХарактеристики);
	Запрос.УстановитьПараметр("КлючУпаковки", АналитикаКлюча.КлючУпаковки);
	Запрос.УстановитьПараметр("КлючСерии", АналитикаКлюча.КлючСерии);
	
	Запрос.УстановитьПараметр("ТипКлючаНоменклатуры", АналитикаКлюча.ТипКлючаНоменклатуры);
	Запрос.УстановитьПараметр("ТипКлючаХарактеристики", АналитикаКлюча.ТипКлючаХарактеристики);
	Запрос.УстановитьПараметр("ТипКлючаУпаковки", АналитикаКлюча.ТипКлючаУпаковки);
	Запрос.УстановитьПараметр("ТипКлючаСерии", АналитикаКлюча.ТипКлючаСерии);
	
	Результат = ПолучитьРезультатЗапроса(Запрос, "КлючНоменклатуры1С");
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление ключа номенклатуры 1С, учитывая ограничения платформы 8.2
//
// Параметры:
//  КлючСсылка - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С - ключ номенклатуры 1С;
// 
// Возвращаемое значение:
//  Строка - представление аналитики номенклатуры;
//
Функция КлючНоменклатуры1С_Представление(КлючНоменклатуры1С)
	
	Результат = СокрЛП(КлючНоменклатуры1С);
	МаксДлинаНаименованияВСправочнике = 150;
	
	Если СтрДлина(Результат) = МаксДлинаНаименованияВСправочнике И ВерсияРежимаСовместимостиНиже("8.3") Тогда
		// В 8.2 вместо обработки представления используется поле Наименование,
		// в это поле может не поместиться вся строка представления номенклатуры
		Результат = Справочники.КонтурМаркировка_КлючиНоменклатуры1С.ПредставлениеНоменклатуры1С(КлючНоменклатуры1С);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура КлючНоменклатуры1С_ОбновитьПредставление(КлючНоменклатуры1С)
	
	МаксДлинаНаименованияВСправочнике = 150;
	НовоеПредставление = Справочники.КонтурМаркировка_КлючиНоменклатуры1С.ПредставлениеНоменклатуры1С(КлючНоменклатуры1С);
	НовоеПредставление = Лев(НовоеПредставление, МаксДлинаНаименованияВСправочнике);
	
	Если КлючНоменклатуры1С.Наименование <> НовоеПредставление Тогда
		ОбъектКлюча = КлючНоменклатуры1С.ПолучитьОбъект();
		ОбъектКлюча.ДополнительныеСвойства.Вставить("ОтключитьЗаписьАналитики");
		ОбъектКлюча.Записать();
	КонецЕсли;
	
	Если Интеграция_Номенклатура1С_ЕстьАртикул() Тогда
		
		АналитикаНоменклатуры = АналитикаНоменклатуры1С(КлючНоменклатуры1С);
		ПараметрыНоменклатуры = Интеграция_ПараметрыНоменклатуры1С(АналитикаНоменклатуры);
		
		ДопРеквизиты = Новый Структура(Перечисление_ИменаДопРеквизитов().Артикул, ПараметрыНоменклатуры.Артикул);
		ДопРеквизиты_Записать(КлючНоменклатуры1С, ДопРеквизиты);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КлючиАналитикиНоменклатуры1С_Записать(АналитикаКлюча)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КлючиАналитикиНоменклатуры1С_Заблокировать(АналитикаКлюча);
		
		Запись = РегистрыСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, АналитикаКлюча);
		Запись.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КлючиАналитикиНоменклатуры1С_Заблокировать(АналитикаКлюча)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для каждого ИмяКлюча Из РазделитьСтроку(ИменаКлючейАналитикиНоменклатуры1С()) Цикл
		ЭлементБлокировки.УстановитьЗначение(ИмяКлюча, АналитикаКлюча[ИмяКлюча]);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция ИменаПолейАналитикиНоменклатуры1С()
	
	Возврат Справочники.КонтурМаркировка_КлючиНоменклатуры1С.ИменаПолейАналитикиНоменклатуры1С();
	
КонецФункции

Функция ИменаКлючейАналитикиНоменклатуры1С()
	
	Возврат Справочники.КонтурМаркировка_КлючиНоменклатуры1С.ИменаКлючейАналитикиНоменклатуры1С();
	
КонецФункции

Функция АналитикаНоменклатуры1С(КлючНоменклатуры1С, КэшРезультатов = Неопределено) Экспорт
	
	Возврат Справочники.КонтурМаркировка_КлючиНоменклатуры1С.АналитикаНоменклатуры1С(КлючНоменклатуры1С, КэшРезультатов);
	
КонецФункции

Функция Новый_АналитикаНоменклатуры1С(АналитикаНоменклатуры = Неопределено) Экспорт
	
	Результат = Новый Структура(ИменаПолейАналитикиНоменклатуры1С());
	
	Если АналитикаНоменклатуры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, АналитикаНоменклатуры);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_АналитикаКлючаНоменклатуры1С(АналитикаНоменклатуры = Неопределено) Экспорт
	
	ПустойИдентификатор = ПустойУникальныйИдентификатор();
	
	Результат = Новый Структура(ИменаКлючейАналитикиНоменклатуры1С());
	Для каждого Эл Из Результат Цикл
		Результат[Эл.Ключ] = ПустойИдентификатор;
		Результат.Вставить(СтрЗаменить(Эл.Ключ, "Ключ", "ТипКлюча"), "");
	КонецЦикла;
	
	Если АналитикаНоменклатуры <> Неопределено Тогда
		
		Результат.КлючНоменклатуры = КлючОбъекта1С(АналитикаНоменклатуры.Номенклатура);
		Результат.КлючХарактеристики = КлючОбъекта1С(АналитикаНоменклатуры.Характеристика);
		Результат.КлючУпаковки = КлючОбъекта1С(АналитикаНоменклатуры.Упаковка);
		Результат.КлючСерии = КлючОбъекта1С(АналитикаНоменклатуры.Серия);
		
		Результат.ТипКлючаНоменклатуры = ТипКлючаОбъекта1С(АналитикаНоменклатуры.Номенклатура);
		Результат.ТипКлючаХарактеристики = ТипКлючаОбъекта1С(АналитикаНоменклатуры.Характеристика);
		Результат.ТипКлючаУпаковки = ТипКлючаОбъекта1С(АналитикаНоменклатуры.Упаковка);
		Результат.ТипКлючаСерии = ТипКлючаОбъекта1С(АналитикаНоменклатуры.Серия);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область ДокументыУчета

// Читает документ учета из базы и возвращает его структуру
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ, который нужно прочитать
// 
// Возвращаемое значение:
//  Структура - см. Новый_ДокументУчета()
//
Функция ДокументУчета_ПрочитатьДокумент(ДокументУчета) Экспорт
	
	Результат = Новый_ДокументУчета();
	Результат.Ссылка = ДокументУчета;
	
	ДокументУчета_ПрочитатьШапку(Результат);
	ДокументУчета_ПрочитатьТоварыДокумента(Результат);
	ДокументУчета_ПрочитатьТоварыМаркировки(Результат);
	ДокументУчета_ПрочитатьЭтапыМаркировки(Результат);
	ДокументУчета_ПрочитатьСтатусы(Результат);
	ДокументУчета_ПрочитатьДопРеквизиты(Результат);
	
	Возврат Результат;
	
КонецФункции

// Читает из базы реквизиты из справочника и заполняет ими документ учета
//
// Параметры:
//  ДокументУчета - Структура - см. Новый_ДокументУчета()
//
Процедура ДокументУчета_ПрочитатьШапку(ОписаниеДокумента)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Код КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.ТипДокумента КАК ТипДокумента,
	|	Т.Организация КАК Организация,
	|	Т.Склад КАК Склад,
	|	Т.Комментарий КАК Комментарий,
	|	Т.Наименование КАК Наименование,
	|	Т.КлючДокумента1С КАК КлючДокумента1С,
	|	Т.ТипКлючаДокумента1С КАК ТипКлючаДокумента1С,
	|	Т.ОтражениеВЭДО КАК ОтражениеВЭДО,
	|	Т.МаршрутМаркировки КАК МаршрутМаркировки,
	|	Т.ВерсияДанных КАК ВерсияДанных,
	|	Т.ВерсияДанныхДокумента1С КАК ВерсияДанныхДокумента1С
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", ОписаниеДокумента.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ОписаниеДокумента, Выборка);
		ОписаниеДокумента.Документ1С = МодульОбщегоНазначения().СсылкаПоИдентификатору(
		Выборка.КлючДокумента1С, Выборка.ТипКлючаДокумента1С);
	КонецЕсли;
	
КонецПроцедуры

// Читает из базы доп реквизиты документа учета
//
// Параметры:
//  ОписаниеДокумента - Структура - см. Новый_ДокументУчета()
// 
Процедура ДокументУчета_ПрочитатьДопРеквизиты(ОписаниеДокумента)
	
	ДопРеквизитыИБ = ДопРеквизиты_Прочитать(ОписаниеДокумента.Ссылка);
	
	Если ЗначениеЗаполнено(ДопРеквизитыИБ) Тогда
		ЗаполнитьЗначенияСвойств(ОписаниеДокумента.ДопРеквизиты, ДопРеквизитыИБ);
	КонецЕсли;
	
КонецПроцедуры

// Читает из базы все статусы и заполняет ими документ учета
//
// Параметры:
//  ОписаниеДокумента - Структура - см. Новый_ДокументУчета()
//
Процедура ДокументУчета_ПрочитатьСтатусы(ОписаниеДокумента)
	
	ВсеСтатусы = СтатусыДокументаУчета_Прочитать(ОписаниеДокумента.Ссылка);
	
	ЗаполнитьЗначенияСвойств(ОписаниеДокумента.Статусы, ВсеСтатусы);
	
КонецПроцедуры

Процедура ДокументУчета_ПрочитатьТоварыДокумента(ОписаниеДокумента)
	
	ОписаниеДокумента.ТоварыДокумента.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ *
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки");
	Запрос.УстановитьПараметр("Ссылка", ОписаниеДокумента.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	КэшАналитики = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Стр = ОписаниеДокумента.ТоварыДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Выборка);
		
		АналитикаНоменклатуры = АналитикаНоменклатуры1С(Выборка.КлючНоменклатуры1С, КэшАналитики);
		ЗаполнитьЗначенияСвойств(Стр, АналитикаНоменклатуры);
		
		Если ЗначениеЗаполнено(Стр.Количество)
			И ЗначениеЗаполнено(Стр.КоличествоУпаковок) Тогда
			Стр.Коэффициент = Стр.КоличествоУпаковок / Стр.Количество;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ПрочитатьТоварыМаркировки(ОписаниеДокумента)
	
	ОписаниеДокумента.ТоварыМаркировки.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Товар КАК Товар,
	|	Т.Количество КАК Количество,
	|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Т.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	Т.НомерПартии КАК НомерПартии
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка",ОписаниеДокумента.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОписаниеДокумента.ТоварыМаркировки.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ПрочитатьЭтапыМаркировки(ОписаниеДокумента)
	
	ОписаниеДокумента.ЭтапыМаркировки.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Этап КАК Этап,
	|	Т.ТребуемоеДействие КАК ТребуемоеДействие,
	|	Т.СпособОтражения КАК СпособОтражения,
	|	Т.СпособыВыполнения КАК СпособыВыполнения,
	|	Т.Пропущен КАК Пропущен
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета.ЭтапыМаркировки КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", ОписаниеДокумента.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ОписаниеДокумента.ЭтапыМаркировки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка,, "СпособыВыполнения");
		НоваяСтрока.СпособыВыполнения = РазделитьСтроку(Выборка.СпособыВыполнения, ";");
	КонецЦикла;
	
КонецПроцедуры

// Записывает документ учета в базу данных
//
// Параметры:
//  ОписаниеДокумента - Структура - см. Новый_ДокументУчета()
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДокументыУчета - записанный документ учета
//
Функция ДокументУчета_Записать(ОписаниеДокумента) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеДокумента.Ссылка) Тогда
			
			ПроверитьОбъектВПроцессеОбновления(ОписаниеДокумента.Ссылка);
			ДокументУчета_Заблокировать(ОписаниеДокумента.Ссылка);
			СтатусыДокументаУчета_Заблокировать(ОписаниеДокумента.Ссылка);
			Объект = ОписаниеДокумента.Ссылка.ПолучитьОбъект();
			
			Если СокрЛП(ОписаниеДокумента.ВерсияДанных) <> СокрЛП(Объект.ВерсияДанных) Тогда
				ВызватьИсключение НСтр("ru = 'Версия документа в базе изменилась, текущую версию записать невозможно!'");
			КонецЕсли;
			
			Если Объект.ПометкаУдаления Тогда
				Объект.ПометкаУдаления = Ложь;
			КонецЕсли;
			
		Иначе
			
			Объект = Справочники.КонтурМаркировка_ДокументыУчета.СоздатьЭлемент();
			Если ЗначениеЗаполнено(ОписаниеДокумента.Документ1С) Тогда
				УникальныйИдентификатор = ОписаниеДокумента.Документ1С.УникальныйИдентификатор();
				Ссылка = Справочники.КонтурМаркировка_ДокументыУчета.ПолучитьСсылку(УникальныйИдентификатор);
				Объект.УстановитьСсылкуНового(Ссылка);
			КонецЕсли;
			
		КонецЕсли;
		
		ДокументУчета_ДополнитьШапкуДокумента(ОписаниеДокумента);
		ДокументУчета_ДополнитьЭтапыМаркировки(ОписаниеДокумента);
		ДокументУчета_ДополнитьТоварыДокумента(ОписаниеДокумента);
		ДокументУчета_ЗаполнитьОтражениеВЭДО(ОписаниеДокумента);
		
		ЗаполнитьЗначенияСвойств(Объект, ОписаниеДокумента, , "Ссылка");
		
		Объект.Код = ОписаниеДокумента.Номер;
		
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Код) Тогда
			ДокументУчета_УстановитьНовыйКод(Объект);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
			ДокументУчета_УстановитьНовоеНаименование(Объект);
		КонецЕсли;
		
		Объект.ЭтапыМаркировки.Очистить();
		Для Каждого Стр Из ОписаниеДокумента.ЭтапыМаркировки Цикл
			НоваяСтрока = Объект.ЭтапыМаркировки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр,, "СпособыВыполнения");
			НоваяСтрока.СпособыВыполнения = СоединитьСтроку(Стр.СпособыВыполнения, ";");
		КонецЦикла;
		
		Объект.ТоварыДокумента.Загрузить(ОписаниеДокумента.ТоварыДокумента);
		Объект.ТоварыМаркировки.Загрузить(ОписаниеДокумента.ТоварыМаркировки);
		
		Объект.Записать();
		
		ОписаниеДокумента.Дата = Объект.Дата;
		ОписаниеДокумента.Номер = Объект.Код;
		ОписаниеДокумента.Ссылка = Объект.Ссылка;
		ОписаниеДокумента.ВерсияДанных = Объект.ВерсияДанных;
		ОписаниеДокумента.Наименование = Объект.Наименование;
		
		ДокументУчета_ЗаписатьСтатусы(ОписаниеДокумента);
		
		ДопРеквизиты_Записать(ОписаниеДокумента.Ссылка, ОписаниеДокумента.ДопРеквизиты);
		
		Метрики_ПриЗаписиДокументаУчета(ОписаниеДокумента);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Объект.Ссылка;
	
КонецФункции

Процедура ДокументУчета_Заблокировать(Ссылка) Экспорт
	
	Значения = Новый Структура("Ссылка", Ссылка);
	ИмяОбъекта = "Справочник.КонтурМаркировка_ДокументыУчета";
	ЗаблокироватьПоЗначениям(ИмяОбъекта, Значения);
	
КонецПроцедуры

Процедура ДокументУчета_УстановитьНовыйКод(ОбъектДокумента)
	
	ОбъектДокумента.УстановитьНовыйКод(ПрефиксНомера(ОбъектДокумента.Дата));
	
КонецПроцедуры

Процедура ДокументУчета_УстановитьНовоеНаименование(ОбъектДокумента)
	
	Настройка = НастройкиДокументовУчета_НайтиПоТипуДокумента(ОбъектДокумента.ТипДокумента);
	ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(Настройка);
	
	ОбъектДокумента.Наименование = ПараметрыВСтроку("%1 %2 от %3"
	, ОписаниеНастройки.Наименование
	, ОбъектДокумента.Код
	, Формат(ОбъектДокумента.Дата, "ДФ=dd.MM.yyyy"));
	
КонецПроцедуры

Процедура ДокументУчета_ДополнитьШапкуДокумента(ОписаниеДокумента)
	
	ОписаниеДокумента.КлючДокумента1С = КлючОбъекта1С(ОписаниеДокумента.Документ1С);
	ОписаниеДокумента.ТипКлючаДокумента1С = ТипКлючаОбъекта1С(ОписаниеДокумента.Документ1С);
	
КонецПроцедуры

Процедура ДокументУчета_ДополнитьТоварыДокумента(ОписаниеДокумента)
	
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	
	Если Не ЗначениеЗаполнено(ТоварыДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоСтрок = ТоварыДокумента.Количество();
	ЕстьНомераСтрок = ЗначениеЗаполнено(ТоварыДокумента[0].НомерСтроки);
	ЕстьОтражениеВЭДО = ЗначениеЗаполнено(ТоварыДокумента[0].ОтражениеВЭДО);
	КэшКлючаНоменклатуры = Новый Соответствие;
	
	Для Сч = 1 По КоличествоСтрок Цикл
		
		Стр = ТоварыДокумента[Сч - 1];
		
		Если Не ЕстьНомераСтрок Тогда
			Стр.НомерСтроки = Сч;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
			Стр.КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр, КэшКлючаНоменклатуры);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.ПредставлениеСтроки) Тогда
			ДокументУчета_ЗаполнитьПредставлениеСтроки(Стр, КоличествоСтрок);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.ОтражениеВЭДО) Тогда
			ДокументУчета_ЗаполнитьПредставлениеСтроки(Стр, КоличествоСтрок);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЕстьОтражениеВЭДО Тогда
		ДокументУчета_ЗаполнитьПравилаОтраженияЭДО(ОписаниеДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДокументУчета_ДополнитьЭтапыМаркировки(ОписаниеДокумента)
	
	МаршрутМаркировки = ОписаниеДокумента.МаршрутМаркировки;
	Если ЗначениеЗаполнено(МаршрутМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаДокумента = НастройкиДокументовУчета_НайтиПоТипуДокумента(ОписаниеДокумента.ТипДокумента);
	ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(НастройкаДокумента);
	МаршрутМаркировки = ОписаниеНастройки.МаршрутМаркировки;
	
	Если Не ЗначениеЗаполнено(МаршрутМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДокумента.МаршрутМаркировки = МаршрутМаркировки;
	
	ОписаниеМаршрута = МаршрутМаркировки_Прочитать(МаршрутМаркировки);
	Для Каждого Стр Из ОписаниеМаршрута.ЭтапыМаркировки Цикл
		
		Если Стр.Пропущен Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ОписаниеДокумента.ЭтапыМаркировки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьТоварыДокументаИзТаблицыКодов(ТоварыДокумента, ТаблицаКодов) Экспорт
	
	ТоварыДокумента.Очистить();
	
	Для Каждого Стр Из ТаблицаЗначений_Разбить(ТаблицаКодов, "КлючНоменклатуры1С") Цикл
		
		МассивСтрок = Стр.МассивСтрок;
		КлючНоменклатуры1С = Стр.КлючНоменклатуры1С;
		АналитикаНоменклатуры = АналитикаНоменклатуры1С(КлючНоменклатуры1С);
		
		СтрДок = ТоварыДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрДок, МассивСтрок[0]);
		ЗаполнитьЗначенияСвойств(СтрДок, АналитикаНоменклатуры);
		СтрДок.КлючСтрокиДокумента = Новый УникальныйИдентификатор;
		
		Для каждого СтрКода Из МассивСтрок Цикл
			
			Количество = 1;
			Если ЗначениеЗаполнено(СтрКода.Количество) Тогда
				Количество = СтрКода.Количество;
			КонецЕсли;
			
			СтрДок.Количество = СтрДок.Количество + Количество;
			СтрДок.КоличествоУпаковок = СтрДок.КоличествоУпаковок + 1;
			СтрКода.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьТоварыМаркировкиИзТаблицыКодов(ОписаниеДокумента, ТаблицаКодов) Экспорт
	
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	ТоварыМаркировки = ОписаниеДокумента.ТоварыМаркировки;
	
	Для Каждого СтрДок Из ТоварыДокумента Цикл
		
		Отбор = Новый Структура("КлючСтрокиДокумента", СтрДок.КлючСтрокиДокумента);
		СтрокиКодов = ТаблицаКодов.НайтиСтроки(Отбор);
		Если Не ЗначениеЗаполнено(СтрокиКодов) Тогда
			Продолжить;
		КонецЕсли;
		
		// Удаляем старый набор товаров
		Для Сч = -(ТоварыМаркировки.Количество() - 1) По 0 Цикл
			СтрТов = ТоварыМаркировки.Получить(-Сч);
			Если СтрТов.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента Тогда
				ТоварыМаркировки.Удалить(-Сч);
			КонецЕсли;
		КонецЦикла;
		
		СтрокиТоваров = Новый Соответствие;
		
		Для Каждого СтрКода Из СтрокиКодов Цикл
			
			Если Не ЗначениеЗаполнено(СтрКода.Товар) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрТов = СтрокиТоваров[СтрКода.Товар];
			Если СтрТов = Неопределено Тогда
				СтрТов = ТоварыМаркировки.Добавить();
				СтрТов.Товар = СтрКода.Товар;
				СтрТов.КлючСтрокиДокумента = СтрКода.КлючСтрокиДокумента;
				СтрокиТоваров.Вставить(СтрКода.Товар, СтрТов);
			КонецЕсли;
			
			СтрТов.КоличествоУпаковок = СтрТов.КоличествоУпаковок + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Сч = -(ТоварыМаркировки.Количество() - 1) По 0 Цикл
		СтрТов = ТоварыМаркировки.Получить(-Сч);
		МассивСтрок = ТоварыДокумента.НайтиСтроки(Новый Структура("КлючСтрокиДокумента", СтрТов.КлючСтрокиДокумента));
		Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
			ТоварыМаркировки.Удалить(-Сч);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьПредставлениеСтроки(СтрокаДокумента, КоличествоСтрок) Экспорт
	
	НомерСтроки = СтрокаДокумента.НомерСтроки;
	ПредставлениеНоменклатуры = ПредставлениеНоменклатуры1С(СтрокаДокумента);
	ПредставлениеСтроки = ПредставлениеСтрокиСНомером(НомерСтроки, ПредставлениеНоменклатуры, КоличествоСтрок);
	
	СтрокаДокумента.ПредставлениеСтроки = ПредставлениеСтроки;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьПравилаОтраженияЭДО(ОписаниеДокумента) Экспорт
	
	ПравилаОтражения = Перечисление_ПравилаОтраженияВЭДО();
	ТипДокумента = ОписаниеДокумента.ТипДокумента;
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	
	ЭтоВнутреннееПеремещение = ДокументУчета_ТипуДокументаДоступнаРоль(
	ТипДокумента, Перечисление_РолиДокументовУчета().ВнутреннееПеремещение);
	
	ПараметрыПроверки = Новый_ПараметрыПроверкиТоваровДокумента();
	ПараметрыПроверки.ЭтоВнутреннееПеремещение = ЭтоВнутреннееПеремещение;
	
	Для Каждого СтрДок Из ТоварыДокумента Цикл
		
		СтрДок.ОтражениеВЭДО = ПравилаОтражения.ПУ;
		
		СтрТов = ОписаниеДокумента.ТоварыМаркировки.Найти(СтрДок.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		Если СтрТов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеТовара = Товар_Прочитать(СтрТов.Товар);
		Если Не Товар_ПоддерживаетОСУВДокументе(ОписаниеТовара, ПараметрыПроверки) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтражениеВЭДО = МаркируемыеТоварныеГруппы_ОтражениеВЭДО(ОписаниеТовара.ВидПродукции);
		Если ЗначениеЗаполнено(ОтражениеВЭДО) Тогда
			СтрДок.ОтражениеВЭДО = ОтражениеВЭДО;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьОтражениеВЭДО(ОписаниеДокумента)
	
	Если Не ДокументУчета_ТипуДокументаДоступнаРольОтраженияВЭДО(ОписаниеДокумента.ТипДокумента) Тогда
		ОписаниеДокумента.ОтражениеВЭДО = "";
		Возврат;
	КонецЕсли;
	
	ПравилаОтраженияВЭДО = Перечисление_ПравилаОтраженияВЭДО();
	ОтраженияВЭДО = Перечисление_ОтраженияВЭДО();
	Отбор = Новый Структура("НеПодлежитМаркировке, ОтражениеВЭДО", Ложь);
	
	Отбор.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ПУ;
	ЕстьСтрокиПУ = ЗначениеЗаполнено(ОписаниеДокумента.ТоварыДокумента.НайтиСтроки(Отбор));
	
	Отбор.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ОСУ;
	ЕстьСтрокиОСУ = ЗначениеЗаполнено(ОписаниеДокумента.ТоварыДокумента.НайтиСтроки(Отбор));
	
	Отбор.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ПартионныйУчет;
	ЕстьСтрокиПАРТ = ЗначениеЗаполнено(ОписаниеДокумента.ТоварыДокумента.НайтиСтроки(Отбор));
	
	Если ЕстьСтрокиПУ И ЕстьСтрокиОСУ И ЕстьСтрокиПАРТ Тогда
		ОписаниеДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУПАРТПУ;
	ИначеЕсли ЕстьСтрокиОСУ И ЕстьСтрокиПАРТ Тогда
		ОписаниеДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУПАРТ;
	ИначеЕсли ЕстьСтрокиПУ И ЕстьСтрокиПАРТ Тогда
		ОписаниеДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ПУПАРТ;
	ИначеЕсли ЕстьСтрокиПУ И ЕстьСтрокиОСУ Тогда
		ОписаниеДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУПУ;
	ИначеЕсли ЕстьСтрокиПУ Тогда
		ОписаниеДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ПУ;
	ИначеЕсли ЕстьСтрокиОСУ Тогда
		ОписаниеДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУ;
	ИначеЕсли ЕстьСтрокиПАРТ Тогда
		ОписаниеДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ПАРТ;
	Иначе
		ОписаниеДокумента.ОтражениеВЭДО = ОтраженияВЭДО.НеОтражать;
	КонецЕсли;
	
КонецПроцедуры

Функция ДокументУчета_ЕстьРолиДляОтраженияВЭДО(ДокументУчета) Экспорт
	
	РолиДокументов = Перечисление_РолиДокументовУчета();
	
	ПодходящиеРоли = Новый Массив;
	ПодходящиеРоли.Добавить(РолиДокументов.Отгрузка);
	ПодходящиеРоли.Добавить(РолиДокументов.КорректировкаОтгрузки);
	ПодходящиеРоли.Добавить(РолиДокументов.ВнутреннееПеремещение);
	
	Результат = Ложь;
	Для Каждого Роль Из ПодходящиеРоли Цикл
		Если ДокументУчета_ДоступнаРоль(ДокументУчета, Роль) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ЕстьРолиДляПартионногоУчета(ДокументУчета) Экспорт
	
	РолиДокументов = Перечисление_РолиДокументовУчета();
	
	ПодходящиеРоли = Новый Массив;
	ПодходящиеРоли.Добавить(РолиДокументов.Отгрузка);
	ПодходящиеРоли.Добавить(РолиДокументов.КорректировкаОтгрузки);
	
	Результат = Ложь;
	Для Каждого Роль Из ПодходящиеРоли Цикл
		Если ДокументУчета_ДоступнаРоль(ДокументУчета, Роль) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументУчета_ОбновитьПредставлениеКлючейНоменклатуры1С(ОписаниеДокумента) Экспорт
	
	ТоварыДокумента = ОписаниеДокумента.ТоварыДокумента;
	
	Для Каждого КлючНоменклатуры1С Из ТаблицаЗначений_ВыгрузитьКолонку(ТоварыДокумента, "КлючНоменклатуры1С", Истина) Цикл
		КлючНоменклатуры1С_ОбновитьПредставление(КлючНоменклатуры1С);
	КонецЦикла;
	
КонецПроцедуры

Функция Новый_ПараметрыПроверкиТоваровДокумента()
	
	Возврат МодульКонтроль().Новый_ПараметрыПроверкиТоваровДокумента();
	
КонецФункции

// Записывает все статусы документа учета
// Для операций, у которых нет специфических статусов
//
// Параметры:
//  ОписаниеДокумента - Структура - описание документа, см. Новый_ДокументУчета()
//
Процедура ДокументУчета_ЗаписатьСтатусы(ОписаниеДокумента) Экспорт
	
	ДокументУчета = ОписаниеДокумента.Ссылка;
	Документ1С = ДокументУчета_Документ1С(ДокументУчета);
	СтатусыДокумента = ОписаниеДокумента.Статусы;
	
	СтатусыДокумента.ТребуемоеДействие = ДокументУчета_НовоеТребуемоеДействие(ОписаниеДокумента);
	СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента);
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Документ1С", Документ1С);
	ПараметрыПМ.Вставить("ДокументУчета", ДокументУчета);
	ПараметрыПМ.Вставить("СтатусыДокумента", СтатусыДокумента);
	ПМ_ОбработатьСобытие("ПриЗаписиСтатусовДокументаУчета", ПараметрыПМ);
	
КонецПроцедуры

// Определяет наличие коэффициентов пересчета в документе учета
//
// Параметры:
//  ОписаниеДокумента - Структура - см. функцию Новый_ДокументУчета();
// 
// Возвращаемое значение:
//  Булево - Истина, если есть хотя бы один коэффициент пересчета отличный от 1;
//
Функция ДокументУчета_ЕстьКоэффициентыПересчета(ОписаниеДокумента)
	
	Для Каждого Стр Из ОписаниеДокумента.ТоварыДокумента Цикл
		Если ЗначениеЗаполнено(Стр.Коэффициент)
			И Стр.Коэффициент <> 1 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ДокументУчета_Документ1С(ДокументУчета, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ДокументУчета];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Реквизиты = ЗначенияРеквизитовОбъектаЛок(ДокументУчета, "КлючДокумента1С, ТипКлючаДокумента1С");
	Результат = МодульОбщегоНазначения().СсылкаПоИдентификатору(Реквизиты.КлючДокумента1С, Реквизиты.ТипКлючаДокумента1С);
	
	Если КэшРезультатов <> Неопределено И ЗначениеЗаполнено(Результат) Тогда
		КэшРезультатов.Вставить(ДокументУчета, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументУчета_ИзвлечьКодыИзАрхива(ДокументУчета) Экспорт
	
	Если Не КодыДокументов_ЕстьКоды(ДокументУчета) Тогда
		КодыДокументов_ИзвлечьИзАрхива(ДокументУчета);
	КонецЕсли;
	
КонецПроцедуры

Функция ДокументУчета_ОбновитьСтатусыКодов(ДокументУчета, ОбновитьСтатусыВложенныхКодов = Истина) Экспорт
	
	ДокументУчета_УдалитьРезультатыПроверкиКодов(ДокументУчета);
	
	Организация = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "Организация");
	
	ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
	
	Если ОбновитьСтатусыВложенныхКодов Тогда
		ТаблицаКодов_ДобавитьКлючиВсехВложенныхКодов(ТаблицаКодов);
	КонецЕсли;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	УдалосьОбновить = ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация, Истина);
	
	Если УдалосьОбновить Тогда
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
	КонецЕсли;
	
	Возврат УдалосьОбновить;
	
КонецФункции

Функция ДокументУчета_НайтиПоДокументу1С(Документ1С, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[Документ1С];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Документ1С) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Документ1С) = Тип("СправочникСсылка.КонтурМаркировка_ДокументыУчета") Тогда
		Возврат Документ1С;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК Т
	|ГДЕ
	|	Т.КлючДокумента1С = &КлючДокумента1С
	|	И Т.ТипКлючаДокумента1С = &ТипКлючаДокумента1С");
	Запрос.УстановитьПараметр("КлючДокумента1С", КлючОбъекта1С(Документ1С));
	Запрос.УстановитьПараметр("ТипКлючаДокумента1С", ТипКлючаОбъекта1С(Документ1С));
	Результат = ПолучитьРезультатЗапроса(Запрос,, ПустойДокументУчета());
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументУчета_ПроверитьКоды(ДокументУчета) Экспорт
	
	ТаблицаКодов = КодыДокументов_ДляПроверки(ДокументУчета);
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументУчета_ПроверитьСтатусКодов(ДокументУчета, ТаблицаКодов);
	ДокументУчета_ПроверитьВладельцаКодов(ДокументУчета, ТаблицаКодов);
	ДокументУчета_ПроверитьРДКодов(ДокументУчета, ТаблицаКодов);
	
	РезультатыДопПроверок = Новый Структура;
	РезультатыДопПроверок.Вставить("ДопПроверкаКодов1", Новый_ОписаниеДопПроверкиКодовДокумента());
	РезультатыДопПроверок.Вставить("ДопПроверкаКодов2", Новый_ОписаниеДопПроверкиКодовДокумента());
	
	ПМ_ОбработатьСобытие_ПриПроверкиКодовДокументаУчета(ДокументУчета, РезультатыДопПроверок, ТаблицаКодов);
	
	ТаблицаКодов_ПодобратьКлючиПроверкиКодов(ТаблицаКодов);
	КодыДокументов_Записать(ТаблицаКодов, ДокументУчета,,, Ложь);
	
	РезультатыПроверкиКодов = ДокументУчета_СтатусыРезультатаПроверкиКодов(ДокументУчета);
	
	ДокументУчета_ЗаполнитьРезультатПроверкиСтатусаКодов(РезультатыПроверкиКодов, ДокументУчета, ТаблицаКодов);
	ДокументУчета_ЗаполнитьРезультатПроверкиВладельцаКодов(РезультатыПроверкиКодов, ДокументУчета, ТаблицаКодов);
	ДокументУчета_ЗаполнитьРезультатПроверкиРДКодов(РезультатыПроверкиКодов, ДокументУчета, ТаблицаКодов);
	ДокументУчета_ЗаполнитьРезультатДопПроверокКодов(РезультатыПроверкиКодов, РезультатыДопПроверок);
	
	ДокументУчета_ЗаписатьРезультатыПроверкиКодов(ДокументУчета, РезультатыПроверкиКодов);
	
КонецПроцедуры

Процедура ДокументУчета_ЗаписатьРезультатыПроверкиКодов(ДокументУчета, СтатусыПроверок) Экспорт
	
	ПредставленияДопИнформации = Перечисление_ДопИнформацияСтатусовПроверкиКодовДокумента();
	СтатусыПроверкиКодов = Перечисление_СтатусыПроверкиКодовДокумента();
	ТипыПроверкиКодов = Перечисление_ТипыПроверкиКодов();
	
	// BSLLS:MagicNumber-off
	ПриоритетыСтатусов = Новый Массив;
	ПриоритетыСтатусов.Вставить(4, СтатусыПроверкиКодов.Неактуален);
	ПриоритетыСтатусов.Вставить(3, СтатусыПроверкиКодов.ЕстьОшибки);
	ПриоритетыСтатусов.Вставить(2, СтатусыПроверкиКодов.Предупреждение);
	ПриоритетыСтатусов.Вставить(1, СтатусыПроверкиКодов.Успешно);
	ПриоритетыСтатусов.Вставить(0, СтатусыПроверкиКодов.Отключена);
	// BSLLS:MagicNumber-on
	
	ПриоритетСтатуса = 0;
	Для Каждого Элемент Из ТипыПроверкиКодов Цикл
		
		СтатусПроверки = СтатусыПроверок[Элемент.Ключ];
		
		Если Не ЗначениеЗаполнено(СтатусПроверки) Тогда
			Продолжить;
		КонецЕсли;
		
		ПриоритетСтатусаПроверки = ПриоритетыСтатусов.Найти(СтатусПроверки);
		
		Если ПриоритетСтатуса < ПриоритетСтатусаПроверки Тогда
			ПриоритетСтатуса = ПриоритетСтатусаПроверки;
		КонецЕсли;
		
	КонецЦикла;
	
	ИтоговыйСтатус = ПриоритетыСтатусов[ПриоритетСтатуса];
	
	Если ИтоговыйСтатус = СтатусыПроверкиКодов.ЕстьОшибки
		Или ИтоговыйСтатус = СтатусыПроверкиКодов.Предупреждение Тогда
		ДопИнформация = ПредставленияДопИнформации.ЕстьОшибкиКодов;
	ИначеЕсли ИтоговыйСтатус = СтатусыПроверкиКодов.Успешно Тогда
		ДопИнформация = ПредставленияДопИнформации.ВсеКодыВерны;
	ИначеЕсли ИтоговыйСтатус = СтатусыПроверкиКодов.Неактуален Тогда
		ДопИнформация = ПредставленияДопИнформации.ПроверкаКодовНеактуальна;
	Иначе
		ДопИнформация = ПредставленияДопИнформации.ПроверкаКодовОтключена;
	КонецЕсли;
	
	СтатусыПроверок.РезультатПроверкиКодовДокумента = ИтоговыйСтатус;
	СтатусыПроверок.ДопИнформация_РезультатПроверкиКодовДокумента = ДопИнформация;
	СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыПроверок);
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьРезультатПроверкиСтатусаКодов(РезультатыПроверкиКодов, ДокументУчета, ТаблицаКодов)
	
	СтатусыПроверкиКодов = Перечисление_СтатусыПроверкиКодовДокумента();
	ДопИнформацияСтатусов = Перечисление_ДопИнформацияСтатусовПроверкиКодовДокумента();
	
	Если Не ДокументУчета_ВключенТипПроверкиКодов(ДокументУчета, Перечисление_ТипыПроверкиКодов().ПроверкаСтатусаКодов) Тогда
		РезультатыПроверкиКодов.ПроверкаСтатусаКодов = СтатусыПроверкиКодов.Отключена;
		РезультатыПроверкиКодов.ДопИнформация_ПроверкаСтатусаКодов = ДопИнформацияСтатусов.ПроверкаКодовОтключенаВНастройках;
		Возврат;
	КонецЕсли;
	
	// Отключена в документе
	Если РезультатыПроверкиКодов.ПроверкаСтатусаКодов = СтатусыПроверкиКодов.Отключена
		И РезультатыПроверкиКодов.ДопИнформация_ПроверкаСтатусаКодов = ДопИнформацияСтатусов.ПроверкаКодовОтключенаВДокументе Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоКодовБезОшибок = 0;
	КоличествоКодовВсего = ТаблицаКодов.Количество();
	ЭтоКорректировка = ДокументУчета_ДоступнаРоль(ДокументУчета, Перечисление_РолиДокументовУчета().КорректировкаОтгрузки);
	
	Индекс = ТаблицаКодов.Индексы.Добавить("ПроверкаСтатуса");
	
	Отбор = Новый Структура("ПроверкаСтатуса");
	Для Каждого ВалидныйСтатус Из Перечисление_ВалидныеСтатусыПроверкиКодаДокумента() Цикл
		Отбор.ПроверкаСтатуса = ВалидныйСтатус;
		КоличествоКодовБезОшибок = КоличествоКодовБезОшибок + ТаблицаКодов.НайтиСтроки(Отбор).Количество();
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
	Если КоличествоКодовБезОшибок = 0 Тогда
		
		Если ЭтоКорректировка Тогда
			ДопИнформация = ДопИнформацияСтатусов.СтатусыВсехКодовНедоступныДляКорректировки;
		Иначе
			ДопИнформация = ДопИнформацияСтатусов.СтатусыВсехКодовНедоступныДляОтгрузки;
		КонецЕсли;
		
	ИначеЕсли КоличествоКодовБезОшибок = КоличествоКодовВсего Тогда
		
		Если ЭтоКорректировка Тогда
			ДопИнформация = ДопИнформацияСтатусов.СтатусыВсехКодовДоступныДляКорректировки;
		Иначе
			ДопИнформация = ДопИнформацияСтатусов.СтатусыВсехКодовДоступныДляОтгрузки;
		КонецЕсли;
		
	Иначе
		
		Если ЭтоКорректировка Тогда
			ДопИнформация = ДопИнформацияСтатусов.СтатусыЧастиКодовНедоступныДляКорректировки;
		Иначе
			ДопИнформация = ДопИнформацияСтатусов.СтатусыЧастиКодовНедоступныДляОтгрузки;
		КонецЕсли;
		
	КонецЕсли;
	
	СтатусыОшибок = Новый Массив;
	СтатусыОшибок.Добавить(ДопИнформацияСтатусов.СтатусыВсехКодовНедоступныДляКорректировки);
	СтатусыОшибок.Добавить(ДопИнформацияСтатусов.СтатусыВсехКодовНедоступныДляОтгрузки);
	СтатусыОшибок.Добавить(ДопИнформацияСтатусов.СтатусыЧастиКодовНедоступныДляКорректировки);
	СтатусыОшибок.Добавить(ДопИнформацияСтатусов.СтатусыЧастиКодовНедоступныДляОтгрузки);
	
	Если МассивСодержитЗначение(СтатусыОшибок, ДопИнформация) Тогда
		ИтоговыйСтатус = СтатусыПроверкиКодов.ЕстьОшибки;
	Иначе
		ИтоговыйСтатус = СтатусыПроверкиКодов.Успешно;
	КонецЕсли;
	
	РезультатыПроверкиКодов.ПроверкаСтатусаКодов = ИтоговыйСтатус;
	РезультатыПроверкиКодов.ДопИнформация_ПроверкаСтатусаКодов = ДопИнформация;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьРезультатПроверкиВладельцаКодов(РезультатыПроверкиКодов, ДокументУчета, ТаблицаКодов)
	
