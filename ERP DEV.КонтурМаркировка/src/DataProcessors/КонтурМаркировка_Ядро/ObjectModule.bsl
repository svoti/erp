	Результат.Вставить("Ответственный");
	Результат.Вставить("Комментарий");
	Результат.Вставить("ВерсияДанных");
	
	Результат.Вставить("Товары", Новый_Операция_Товары());
	
	Статусы = Новый_Операция_Статусы();
	ДопРеквизиты = Новый_Операция_ДопРеквизиты();
	
	Результат.Вставить("Статусы", Статусы);
	Результат.Вставить("ДопРеквизиты", ДопРеквизиты);
	
	Возврат Результат;
	
