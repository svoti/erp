	НачДействия.Вставить(ТипыОпер.ОтчетОНанесенииНаТСД,              ОчередьОбмена_ОтчетОНанесенииНаТСД_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпер.РегистрацияСтрокиОтчетаОНанесении, ОчередьОбмена_СтрокаОтчетаОНанесении_БизнесПроцесс()[0]);
