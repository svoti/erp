Функция КлючПроверкиКода_Подобрать(ОписаниеПроверки)
	
	РезультатПроверкиКода = Новый_РезультатПроверкиКодов();
	ЗаполнитьЗначенияСвойств(РезультатПроверкиКода, ОписаниеПроверки);
	
	Результат = КлючПроверкиКода_Найти(РезультатПроверкиКода);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		РезультатыПроверкиКодов_Записать(РезультатПроверкиКода);
		Результат = КлючПроверкиКода_Найти(РезультатПроверкиКода);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлючПроверкиКода_Найти(РезультатПроверкиКода)
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючПроверкиКода КАК КлючПроверкиКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_РезультатыПроверкиКодов КАК Т
	|ГДЕ
	|	&УсловияАналитики";
	
	Разделитель = "";
	УсловияАналитики = "";
	Для каждого ИмяПоля Из РазделитьСтроку(РезультатыПроверкиКодов_ИменаПолей()) Цикл
		
		Условие = СтрЗаменить("Т.%1 = &%1", "%1", ИмяПоля);
		УсловияАналитики = УсловияАналитики + Разделитель + Условие;
		Разделитель = " И ";
		
		Запрос.УстановитьПараметр(ИмяПоля, РезультатПроверкиКода[ИмяПоля]);
		
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловияАналитики", УсловияАналитики);
	Запрос.Текст = ТекстЗапроса;
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КлючПроверкиКода");
	
КонецФункции

Функция СоответствиеСтатусаКодаИРезультатаПроверкиКода()
	
	КлючКэш = "СоответствиеСтатусаКодаИОшибкиСтатуса";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	РезультатыПроверкиКодов = Перечисление_РезультатыПроверкиКодовДокументов();
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(СтатусыКодов.ВведенВОборот, 		РезультатыПроверкиКодов.Проверен);
	Результат.Вставить(СтатусыКодов.ВозвращенВОборот, 	РезультатыПроверкиКодов.Проверен);
	
	Результат.Вставить(СтатусыКодов.Продан, 			РезультатыПроверкиКодов.Выбыл);
	Результат.Вставить(СтатусыКодов.Списан, 			РезультатыПроверкиКодов.Выбыл);
	Результат.Вставить(СтатусыКодов.ВыбылИзОборота, 	РезультатыПроверкиКодов.Выбыл);
	
	Результат.Вставить(СтатусыКодов.Выпущен, 			РезультатыПроверкиКодов.НеВОбороте);
	Результат.Вставить(СтатусыКодов.Разагрегирован, 	РезультатыПроверкиКодов.НеВОбороте);
	Результат.Вставить(СтатусыКодов.Нанесен, 			РезультатыПроверкиКодов.НеВОбороте);
	Результат.Вставить(СтатусыКодов.НанесенНеОплачен, 	РезультатыПроверкиКодов.НеВОбороте);
	
	Результат.Вставить(СтатусыКодов.НеНайден, РезультатыПроверкиКодов.НеНайден);
	
	Результат.Вставить(СтатусыКодов.НеОпределен, 	РезультатыПроверкиКодов.Неизвестный);
	Результат.Вставить(СтатусыКодов.НетДоступа, 	РезультатыПроверкиКодов.Неизвестный);
	Результат.Вставить("", 							РезультатыПроверкиКодов.Неизвестный);
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СоответствиеСтатусаПроверкиРДИРезультатаПроверкиКода()
	
	КлючКэш = "СоответствиеРезультатовПроверкиРДИОшибокРД";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	РезультатыПроверкиРД = Перечисление_РезультатыПроверкиРДКода();
	РезультатыПроверкиКодов = Перечисление_РезультатыПроверкиКодовДокументов();
	
	Результат = Новый Соответствие;
	Результат.Вставить(РезультатыПроверкиРД.ДоступенДляОтгрузкиИВводаВОборот, 	РезультатыПроверкиКодов.Проверен);
	Результат.Вставить(РезультатыПроверкиРД.ДоступенТолькоДляОтгрузки, 			РезультатыПроверкиКодов.Проверен);
	Результат.Вставить(РезультатыПроверкиРД.Неопределен, 						РезультатыПроверкиКодов.Проверен);
	Результат.Вставить(РезультатыПроверкиРД.Неизвестен, 						РезультатыПроверкиКодов.Проверен);
	
	Результат.Вставить(РезультатыПроверкиРД.Недоступен, 	РезультатыПроверкиКодов.Недоступен);
	Результат.Вставить("", 									РезультатыПроверкиКодов.НедоступенДляОтгрузки);
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаПроверкиКодаДокумента(ОписаниеОшибки) Экспорт
	
	Результат = "";
	Разделитель = ", ";
	
	Для Каждого КлючЗначение Из ОписаниеОшибки Цикл
		
		Если Не ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + Разделитель + КлючЗначение.Значение;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОбщиеТипыУпаковокДляПроверкиРД() Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара);
	Результат.Добавить(Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Комплект);
	
	Возврат Результат;
	
КонецФункции

