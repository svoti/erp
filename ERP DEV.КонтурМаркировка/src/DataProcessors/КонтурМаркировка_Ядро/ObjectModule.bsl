Процедура ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОпераций
	, ТекущаяОперация = Неопределено
	, ДокументУчета = Неопределено
	, ОперацияОснование = Неопределено) Экспорт
	
	УчитыватьЗавершенныеОперации = Истина;
	Если ТипОпераций = Перечисление_ТипыОпераций().ФормированиеАТК Тогда
		УчитыватьЗавершенныеОперации = Ложь;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ КодыДругихОпераций
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыДругихОпераций
	|		ПО ТаблицаКодов.КлючКода = КодыДругихОпераций.КлючКода
	|			И (КодыДругихОпераций.Операция <> &ТекущаяОперация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО (КодыДругихОпераций.Операция = СтатусыОпераций.Операция)
	|			И (СтатусыОпераций.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	КодыДругихОпераций.Операция.ТипОперации = &ТипОпераций
	|	И &ДокументУчета
	|	И &ОперацияОснование
	|	И &УчитыватьЗавершенныеОперации
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКодов.*
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ КодыДругихОпераций КАК КодыДругихОпераций
	|		ПО ТаблицаКодов.КлючКода = КодыДругихОпераций.КлючКода
	|ГДЕ
	|	КодыДругихОпераций.КлючКода ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КодыДругихОпераций
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Результат КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат";
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Условие = "КодыДругихОпераций.Операция.ДокументУчета = &ДокументУчета";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		Условие = "КодыДругихОпераций.Операция.ОперацияОснование = &ОперацияОснование";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацияОснование", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацияОснование", "ИСТИНА");
	КонецЕсли;
	
	Если УчитыватьЗавершенныеОперации Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УчитыватьЗавершенныеОперации", "ИСТИНА");
	Иначе
		Условие = "НЕ СтатусыОпераций.Статус В (&ЗавершенныеСтатусыОпераций)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УчитыватьЗавершенныеОперации", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТипОпераций", ТипОпераций);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ОперацияОснование", ОперацияОснование);
	Запрос.УстановитьПараметр("ТекущаяОперация", ТекущаяОперация);
	Запрос.УстановитьПараметр("ОсновнойСтатус", "ОсновнойСтатус");
	Запрос.УстановитьПараметр("ЗавершенныеСтатусыОпераций", ЗавершенныеСтатусыОпераций());
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ТаблицаКодов_ВТ_УдалитьКодыДругихДокументов(МенеджерВТ, ТипДокументов, ТекущийДокумент)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ КодыДругихДокументов
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДругихДокументов
	|		ПО ТаблицаКодов.КлючКода = КодыДругихДокументов.КлючКода
	|			И (КодыДругихДокументов.ДокументУчета <> &ТекущийДокумент)
	|ГДЕ
	|	КодыДругихДокументов.ДокументУчета.ТипДокумента = &ТипДокументов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКодов.*
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ КодыДругихДокументов КАК КодыДругихДокументов
	|		ПО ТаблицаКодов.КлючКода = КодыДругихДокументов.КлючКода
	|ГДЕ
	|	КодыДругихДокументов.КлючКода ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КодыДругихДокументов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Результат.*
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Результат КАК Результат
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Результат.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	Запрос.УстановитьПараметр("ТипДокументов", ТипДокументов);
	Запрос.УстановитьПараметр("ТекущийДокумент", ТекущийДокумент);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ТаблицаКодов_ТоварныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата)
	
	СтрокиКодов = Новый Массив;
	Если ЗначениеЗаполнено(СтрАгрегата.КлючКода) Тогда
		СтрокиКодов = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата", СтрАгрегата.КлючКода));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокиКодов)
		И ЗначениеЗаполнено(СтрАгрегата.КодМаркировки) Тогда
		СтрокиКодов = ТаблицаКодов.НайтиСтроки(Новый Структура("КодАгрегата", СтрАгрегата.КодМаркировки));
	КонецЕсли;
	
	Результат = Новый Массив;
	Для каждого СтрКода Из СтрокиКодов Цикл
		Если СтрКода.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
			ДополнитьМассив(Результат, ТаблицаКодов_ТоварныеСтрокиАгрегата(ТаблицаКодов, СтрКода));
		Иначе
			Результат.Добавить(СтрКода);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаКодов_ВложенныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(СтрАгрегата.КлючКода) Тогда
		Результат = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата", СтрАгрегата.КлючКода));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрАгрегата.КодМаркировки) И Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ТаблицаКодов.НайтиСтроки(Новый Структура("КодАгрегата", СтрАгрегата.КодМаркировки));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация, ЗаписатьВБазу = Ложь) Экспорт
	
	УдалосьОбновить = Истина;
	
	ТаблицаКодов_ВосстановитьРазделителиGS1(ТаблицаКодов);
	
	Для каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаКодов, "ВидПродукции") Цикл
		
		ВидПродукции = ЧастьТаблицы.ВидПродукции;
		СтрокиТаблицы = ЧастьТаблицы.МассивСтрок;
		
		КодыМаркировки = Новый Массив;
		Для каждого Стр Из СтрокиТаблицы Цикл
			КодыМаркировки.Добавить(Стр.КодМаркировки);
		КонецЦикла;
		
		Ответ = Маркировка_СтатусыКодов(КодыМаркировки, Организация, ВидПродукции);
		Если Не ЗначениеЗаполнено(Ответ) Тогда
			УдалосьОбновить = Ложь;
			Прервать;
		КонецЕсли;
		
		Для Сч = 0 По Ответ.ВГраница() Цикл
			СтатусыКодовГИСМТ_ЗаполнитьСтроку(СтрокиТаблицы[Сч], Ответ[Сч]);
		КонецЦикла;
		
	КонецЦикла;
	
	Если УдалосьОбновить И ЗаписатьВБазу Тогда
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	КонецЕсли;
	
	Возврат УдалосьОбновить;
	
КонецФункции

Функция ТаблицаКодов_ОбновитьСтатусПоПервомуКоду(ТаблицаКодов, Организация, СтатусКодов = Неопределено, ЗаписатьВБазу = Ложь)
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтатусКодов <> Неопределено Тогда
		СтрКода = ТаблицаКодов.Найти(СтатусКодов, "Статус");
		Если СтрКода = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		СтрКода = ТаблицаКодов[0];
	КонецЕсли;
	
	КодМаркировки = СтрКода.КодМаркировки;
	ВидПродукции = СтрКода.ВидПродукции;
	СтарыйСтатус = СтрКода.Статус;
	
	Попытка
		Ответ = Маркировка_СтатусыКодов(КодМаркировки, Организация, ВидПродукции);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НовыйСтатус = СтатусКодаПоСтатусуИзСервиса(Ответ[0]);
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	ЛишниеСтатусы = Новый Массив;
	ЛишниеСтатусы.Добавить("");
	ЛишниеСтатусы.Добавить(СтарыйСтатус);
	ЛишниеСтатусы.Добавить(СтатусыКодов.НеНайден);
	ЛишниеСтатусы.Добавить(СтатусыКодов.НетДоступа);
	
	УдалосьОбновить = Ложь;
	Если Не МассивСодержитЗначение(ЛишниеСтатусы, НовыйСтатус) Тогда
		УдалосьОбновить = Истина;
		ИмяКолонки = "Статус";
		Отбор = Новый Структура(ИмяКолонки, СтарыйСтатус);
		ТаблицаЗначений_ЗаполнитьЗначения(ТаблицаКодов, Отбор, НовыйСтатус, ИмяКолонки);
	КонецЕсли;
	
	Если УдалосьОбновить И ЗаписатьВБазу Тогда
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	КонецЕсли;
	
	Возврат УдалосьОбновить;
	
КонецФункции

Функция ТаблицаКодов_ЕстьНеРазобранные(ТаблицаКодов)
	
