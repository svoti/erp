// Возвращает параметры приложения авторизации,
// полученные из безопасного хранилища.
// 
// Возвращаемое значение:
//  Структура - см. Новый_ПараметрыПриложенияАвторизации()
//
Функция ПараметрыПриложенияАвторизации() Экспорт
	
	Результат = Новый_ПараметрыПриложенияАвторизации();
	Результат.ИмяПриложения = БезопасноеХранилище_Прочитать(Неопределено, "ИмяПриложенияАвторизации");
	Результат.КлючПриложения = БезопасноеХранилище_Прочитать(Неопределено, "КлючПриложенияАвторизации");
	Результат.КлючПриложенияБезСекрета = ТокенБезСекрета(Результат.КлючПриложения);
	
	Возврат Результат;
	
КонецФункции

// Записывает параметры приложения авторизации в безопасное хранилище.
//
// Параметры:
//  ОписаниеПриложения - Структура - см. Новый_ПараметрыПриложенияАвторизации()
//
Процедура ПараметрыПриложенияАвторизации_Записать(ОписаниеПриложения) Экспорт
	
	БезопасноеХранилище_Записать(Неопределено, ОписаниеПриложения.ИмяПриложения, "ИмяПриложенияАвторизации");
	БезопасноеХранилище_Записать(Неопределено, ОписаниеПриложения.КлючПриложения, "КлючПриложенияАвторизации");
	
КонецПроцедуры

// Получает (используя сохраненные настройки модуля) актуальные имя и ключ приложения авторизации
// и записывает их в безопасное хранилище.
Процедура ОбновитьПараметрыПриложенияАвторизации() Экспорт
	
	Если НастройкиМодуля().ИспользоватьПриложениеАвторизацииПользователя Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеПриложения = Новый_ПараметрыПриложенияАвторизации();
	ОписаниеПриложения.ИмяПриложения = ИмяПриложенияАвторизацииПоУмолчанию();
	ОписаниеПриложения.КлючПриложения = КлючПриложенияАвторизацииПоУмолчанию();
	ПараметрыПриложенияАвторизации_Записать(ОписаниеПриложения);
	
КонецПроцедуры

// Возвращает актуальные имя и ключ приложения авторизации, для их определения
// используются настройки выполненные пользователем.
//
// Параметры:
//  ИспользоватьПриложениеАвторизацииПользователя - Булево - значение соответствующего флага формы настроек.
//  ТестовоеОкружение - Булево - значение соответствующего флага формы настроек.
//
// Возвращаемое значение:
//  Структура - см. Новый_ПараметрыПриложенияАвторизации()
//
Функция ПараметрыПриложенияАвторизацииДляНастроек(ИспользоватьПриложениеАвторизацииПользователя, ТестовоеОкружение) Экспорт
	
	Результат = Новый_ПараметрыПриложенияАвторизации();
	
	Если Не ИспользоватьПриложениеАвторизацииПользователя Тогда
		Результат.ИмяПриложения = ИмяПриложенияАвторизацииПоУмолчанию();
		Результат.КлючПриложения = КлючПриложенияАвторизацииПоУмолчанию(ТестовоеОкружение);
		Результат.КлючПриложенияБезСекрета = ТокенБезСекрета(Результат.КлючПриложения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяПриложенияАвторизацииПоУмолчанию() 
	
	Результат = "marking.1c";
	
	Возврат Результат;
	
КонецФункции

Функция КлючПриложенияАвторизацииПоУмолчанию(ТестовоеОкружение = Неопределено)
	
	Продукт = Перечисление_ПродуктыВСервисеОбновлений().АпиКлюч;
	
	Попытка
		Ответ = СервисОбновлений_ОписаниеВерсии(Продукт, ВерсияРелиза(), ТестовоеОкружение);
	Исключение
		Действие = НСтр("ru = 'Получение ключа API по умолчанию'");
		ОбработатьОшибку(Действие, ИнформацияОбОшибке());
	КонецПопытки;
	
	description = СвойствоСтруктуры(Ответ, "description", "");
	
	Возврат СтрокаИзBase64(description);
	
КонецФункции

// Возвращает описание приложения для авторизации
// 
// Возвращаемое значение:
//  Структура - базовые параметры для авторизации, где:
//   * ИмяПриложения - Строка - имя приложения;
//   * КлючПриложения - Строка - ключ приложения;
//   * КлючПриложенияБезСекрета - Строка - представление ключа приложения, большая часть которого скрыта;
//
Функция Новый_ПараметрыПриложенияАвторизации() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяПриложения", "");
	Результат.Вставить("КлючПриложения", "");
	Результат.Вставить("КлючПриложенияБезСекрета", "");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Авторизация

// #Область Анкетирование

Функция НужноЗаполнитьАнкету(Организация) Экспорт
	
	Анкета = АнкетаОрганизации(Организация);
	
	Результат = Ложь;
	Если ЗначениеЗаполнено(Анкета) Тогда
		Результат = Не ЗначениеЗаполнено(Анкета.roles);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АнкетаОрганизации(Организация)
	
	Анкеты = ПараметрыСессии_Прочитать(КлючКэшАнкеты());
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(Анкеты) Тогда
		Результат = Анкеты[Организация];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьАнкету(Организация)
	
	Попытка
		Ответ = Маркировка_АнкетаОрганизации(Организация);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Обновление анкеты'");
		ОбработатьОшибку(Действие, Ошибка, Организация);
		Возврат;
	КонецПопытки;
	
	КлючКэш = КлючКэшАнкеты();
	Анкеты = ПараметрыСессии_Прочитать(КлючКэш);
	Если Анкеты = Неопределено Тогда
		Анкеты = Новый Соответствие;
	КонецЕсли;
	
	Анкеты.Вставить(Организация, Ответ);
	ПараметрыСессии_Поместить(КлючКэш, Анкеты);
	
КонецПроцедуры

Функция КлючКэшАнкеты()
	
	Возврат "АнкетыОрганизаций";
	
КонецФункции

Процедура ОбновитьПоляТоваров()
	
	ПараметрыОбновления = ПараметрыОбновленияСправочниковПриОбмене();
	ИменаПолей = ПараметрыОбновления.ИменаПолейТоваровДляОбновления;
	ВидыПродукции = ПараметрыОбновления.ВидыПродукцииТоваровДляОбновления;
	ПоследнийТовар = ПараметрыОбновления.ПоследнийОбновленныйТовар;
	
	Если Не ЗначениеЗаполнено(ИменаПолей) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПоследнийТовар = Товары_ОбновитьПоляТоваровПоИнформацииИзСервиса(ИменаПолей, ПоследнийТовар, ВидыПродукции);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Обновление полей товаров'");
		ОбработатьОшибку(Действие, Ошибка);
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ПоследнийТовар) Тогда
		ПараметрыОбновления.ИменаПолейТоваровДляОбновления.Очистить();
		ПараметрыОбновления.ВидыПродукцииТоваровДляОбновления.Очистить();
		ПараметрыОбновления.ПоследнийОбновленныйТовар = Справочники.КонтурМаркировка_Товары.ПустаяСсылка();
	Иначе
		ПараметрыОбновления.ПоследнийОбновленныйТовар = ПоследнийТовар;
	КонецЕсли;
	
	ПараметрыОбновленияСправочниковПриОбмене_Записать(ПараметрыОбновления);
	
КонецПроцедуры

Процедура ОбновитьПоляОрганизаций(Организация)
	
	ПараметрыОбновления = ПараметрыОбновленияСправочниковПриОбмене();
	Организации = ПараметрыОбновления.ОрганизацииДляОбновленияПолей;
	ИменаПолей = ПараметрыОбновления.ИменаПолейОрганизацийДляОбновления;
	
	Если Не ЗначениеЗаполнено(Организации)
		И Не ЗначениеЗаполнено(ИменаПолей) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИменаПолей) Тогда
		Организации.Очистить();
	КонецЕсли;
	
	Для Сч = -Организации.ВГраница() По 0 Цикл
		Если ОбновитьПоляОрганизацииИзАнкеты(ИменаПолей, Организации[-Сч]) Тогда
			Организации.Удалить(-Сч);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Организации) Тогда
		ИменаПолей.Очистить();
	КонецЕсли;
	
	ПараметрыОбновления.ОрганизацииДляОбновленияПолей = Организации;
	ПараметрыОбновления.ИменаПолейОрганизацийДляОбновления = ИменаПолей;
	ПараметрыОбновленияСправочниковПриОбмене_Записать(ПараметрыОбновления);
	
КонецПроцедуры

Функция ОбновитьПоляОрганизацииИзАнкеты(ИменаПолей, Организация)
	
	Если НужноЗаполнитьАнкету(Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Анкета = АнкетаОрганизации(Организация);
	Если Не ЗначениеЗаполнено(Анкета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеОрганизации = Организация_Прочитать(Организация);
	
	Если МассивСодержитЗначение(ИменаПолей, "ИдентификаторGS1") Тогда
		
		gs1CompanyPrefix = СвойствоСтруктуры(Анкета, "gs1CompanyPrefix");
		
		Если ЗначениеЗаполнено(gs1CompanyPrefix) Тогда
			ОписаниеОрганизации.ДопРеквизиты.ИдентификаторGS1 = gs1CompanyPrefix;
			Организация_Записать(ОписаниеОрганизации);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// #КонецОбласти // Анкетирование

// #Область Тарификация

Процедура ОбновитьИнформациюОТарифах(Организация = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ОрганизацииДляОбмена = ЗначениеВМассиве(Организация);
	Иначе
		ОрганизацииДляОбмена = Организация_ВсеОрганизацииДляОбмена();
	КонецЕсли;
	
	Для Каждого ОрганизацияДляОбмена Из ОрганизацииДляОбмена Цикл
		Тариф_ОбновитьИзСервиса(ОрганизацияДляОбмена);
	КонецЦикла;
	
КонецПроцедуры

Функция Тариф(Организация) Экспорт
	
	КлючКэш = КлючКэшТариф(Организация);
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	Результат = Новый_Тариф(Организация);
	
	Если ЗначениеЗаполнено(Организация) И ФичаФлагВключен(ФичаФлаги.Тарификация) Тогда
		ИмяСправочника = Перечисление_ИменаДопСправочников().Тариф;
		ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника, "Организация", Организация);
		Если ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
			ЗаполнитьЗначенияСвойств(Результат, ДанныеИБ.ДопРеквизиты);
		КонецЕсли;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура Тариф_Записать(ОписаниеТарифа) Экспорт
	
	Организация = ОписаниеТарифа.Организация;
	ИмяСправочника = Перечисление_ИменаДопСправочников().Тариф;
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника, "Организация", Организация);
	ДанныеИБ.Наименование = СокрЛП(Организация);
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	Для каждого Элемент Из ОписаниеТарифа Цикл
		ДанныеИБ.ДопРеквизиты.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ДопСправочник_Записать(ДанныеИБ);
	
	Кэш_Поместить(КлючКэшТариф(Организация), Неопределено);
	
КонецПроцедуры

Процедура Тариф_ОбновитьИзСервиса(Организация)
	
	Попытка
		Ответ = Маркировка_ПодпискиОрганизацииПоИНН(Организация);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Проверка действующих подписок'");
		ОбработатьОшибку(Действие, Ошибка, Организация);
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или Не ЗначениеЗаполнено(Ответ.subscriptions) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеТарифа = Новый_Тариф(Организация);
	
	МассивПодписок = МассивСтруктур_Сортировать(Ответ.subscriptions, "dateEnd", Ложь);
	ОписаниеТарифа.ДатаНачала = НачалоДня(ДатаИзСтрокиXML(МассивПодписок[0].dateStart));
	ОписаниеТарифа.ДатаОкончания = НачалоДня(ДатаИзСтрокиXML(МассивПодписок[0].dateEnd));
	
	ТекДата = ТекущаяДатаСеанса();
	ОписаниеТарифа.Сервисы.Очистить();
	Для Каждого Подписка Из МассивПодписок Цикл
		
		ДатаОкончания = ДатаИзСтрокиXML(Подписка.dateEnd);
		Если НРег(Подписка.state) <> НРег("Active")
			И ДатаОкончания < ТекДата Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого Сервис Из Подписка.services Цикл 
			ОписаниеТарифа.Сервисы.Добавить(Сервис.namedId);
		КонецЦикла;
		
	КонецЦикла;
	
	СвернутьМассивЛок(ОписаниеТарифа.Сервисы, Истина);
	
	НовоеОписаниеТарифа = ЗначениеВСтрокуВнутр(ОписаниеТарифа);
	СтароеОписаниеТарифа = ЗначениеВСтрокуВнутр(Тариф(Организация));
	Если НовоеОписаниеТарифа = СтароеОписаниеТарифа Тогда
		Возврат; // Тариф не изменился
	КонецЕсли;
	
	Тариф_Записать(ОписаниеТарифа);
	
	Если Не МодульВключенВТариф(Организация, ОписаниеТарифа) Тогда
		Метрика_НетПодписки(Перечисление_ДействияМетрики().ОбменССервисом, Организация);
	КонецЕсли;
	
КонецПроцедуры

Функция ОперацияДоступнаПоТарифу(ТипОперации, ОписаниеТарифа) Экспорт
	
	Сервис = СервисПодпискиПоТипуОперации(ТипОперации);
	Если Не ЗначениеЗаполнено(Сервис) Тогда
		Возврат Истина; // Операция не тарифицируется
	КонецЕсли;
	
	Возврат СервисДоступенПоТарифу(Сервис, ОписаниеТарифа);
	
КонецФункции

Функция СервисДоступенПоТарифу(Сервис, ОписаниеТарифа) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписаниеТарифа.Сервисы) Тогда
		Возврат Истина; // Тарифу доступны любые сервисы
	КонецЕсли;
	
	НачалоНовойТарификации = '20241118';
	Если НачалоДня(ОписаниеТарифа.ДатаНачала) < НачалоНовойТарификации Тогда
		Возврат Истина; // Это старый тариф со всеми сервисами
	КонецЕсли;
	
	// считаем старым тарифом
	ИнвентаризацияУстаревший = Перечисление_СервисыПодписок().ИнвентаризацияУстаревший;
	
	Возврат МассивСодержитЗначение(ОписаниеТарифа.Сервисы, Сервис)
			Или МассивСодержитЗначение(ОписаниеТарифа.Сервисы, ИнвентаризацияУстаревший);
	
КонецФункции

Функция МодульВключенВТариф(Организация, ОписаниеТарифа) Экспорт
	
	Возврат СервисДоступенПоТарифу(Перечисление_СервисыПодписок().ЛицензияНаМодуль, ОписаниеТарифа);
	
КонецФункции

Функция ЕстьЛицензияНаМодуль() Экспорт
	
	Результат = Ложь;
	
	Для Каждого Организация Из Организация_ВсеОрганизацииДляОбмена() Цикл
		Если МодульВключенВТариф(Организация, Тариф(Организация)) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СервисПодпискиПоТипуОперации(ТипОперации) Экспорт
	
	Возврат СервисыПодписокПоТипамОпераций().Получить(ТипОперации);
	
КонецФункции

Функция СервисыПодписокПоТипамОпераций() Экспорт
	
	КлючКэш = "СервисыПодписокПоТипамОпераций";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СервисыПодписок = Перечисление_СервисыПодписок();
	
	Результат = Новый Соответствие;
	Результат.Вставить(ТипыОпераций.ВходящийУПД             , СервисыПодписок.Приемка);
	Результат.Вставить(ТипыОпераций.УведомлениеОПриемке     , СервисыПодписок.Приемка);
	Результат.Вставить(ТипыОпераций.ЗаказКодов              , СервисыПодписок.ЗаказКодов);
	Результат.Вставить(ТипыОпераций.Перемаркировка          , СервисыПодписок.Перемаркировка);
	Результат.Вставить(ТипыОпераций.ВводВОборот             , СервисыПодписок.ВводВОборот);
	Результат.Вставить(ТипыОпераций.ОтчетОНанесении         , СервисыПодписок.ОтчетОНанесении);
	Результат.Вставить(ТипыОпераций.ОтчетОНанесенииНаТСД    , СервисыПодписок.ОтчетОНанесении);
	Результат.Вставить(ТипыОпераций.ВыводИзОборота          , СервисыПодписок.ВыводИзОборота);
	Результат.Вставить(ТипыОпераций.АгрегацияКодов          , СервисыПодписок.Агрегаты);
	Результат.Вставить(ТипыОпераций.РегистрацияАгрегатов    , СервисыПодписок.Агрегаты);
	Результат.Вставить(ТипыОпераций.РасформированиеАгрегатов, СервисыПодписок.Агрегаты);
	Результат.Вставить(ТипыОпераций.ДобавлениеВАгрегат      , СервисыПодписок.Агрегаты);
	Результат.Вставить(ТипыОпераций.ИзъятиеИзАгрегата       , СервисыПодписок.Агрегаты);
	Результат.Вставить(ТипыОпераций.НаполнениеАгрегатовНаТСД, СервисыПодписок.Агрегаты);
	Результат.Вставить(ТипыОпераций.РегистрацияНаборов      , СервисыПодписок.Наборы);
	Результат.Вставить(ТипыОпераций.НаполнениеНаборовНаТСД  , СервисыПодписок.Наборы);
	Результат.Вставить(ТипыОпераций.РасформированиеНаборов  , СервисыПодписок.Наборы);
	Результат.Вставить(ТипыОпераций.ФормированиеКИГУ        , СервисыПодписок.ГрупповыеУпаковки);
	Результат.Вставить(ТипыОпераций.НаполнениеКИГУНаТСД     , СервисыПодписок.ГрупповыеУпаковки);
	Результат.Вставить(ТипыОпераций.РегистрацияКИГУ         , СервисыПодписок.ГрупповыеУпаковки);
	Результат.Вставить(ТипыОпераций.ФормированиеАТК         , СервисыПодписок.АТК);
	Результат.Вставить(ТипыОпераций.РасформированиеАТК      , СервисыПодписок.АТК);
	Результат.Вставить(ТипыОпераций.ДобавлениеВАТК          , СервисыПодписок.АТК);
	Результат.Вставить(ТипыОпераций.ИзъятиеИзАТК            , СервисыПодписок.АТК);
	Результат.Вставить(ТипыОпераций.ОтчетОВыбытии           , СервисыПодписок.ОтчетОВыбытии);
	Результат.Вставить(ТипыОпераций.ОтчетОВыбытииНаТСД      , СервисыПодписок.ОтчетОВыбытии);
	Результат.Вставить(ТипыОпераций.ВозвратВОборот          , СервисыПодписок.ВозвратВОборот);
	Результат.Вставить(ТипыОпераций.ВозвратВОборотНаТСД     , СервисыПодписок.ВозвратВОборот);
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_Тариф(Организация)
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", Организация);
	Результат.Вставить("ДатаНачала", '00010101');
	Результат.Вставить("ДатаОкончания", '00010101');
	Результат.Вставить("Сервисы", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

Функция КлючКэшТариф(Организация)
	
	Возврат Перечисление_ИменаДопСправочников().Тариф + ": " + Организация;
	
КонецФункции

