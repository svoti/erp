	ТипыПеременныхХарактеристикТовара = Перечисление_ТипыПеременныхХарактеристикТовара();
	
	СоответствиеХарактеристик = Новый Соответствие;
	СоответствиеХарактеристик.Вставить(ТипыПеременныхХарактеристикТовара.Вес,         ЕдиницыИзмеренияМаркировки.Килограмм);
	СоответствиеХарактеристик.Вставить(ТипыПеременныхХарактеристикТовара.Объем,       ЕдиницыИзмеренияМаркировки.Литр);
	СоответствиеХарактеристик.Вставить(ТипыПеременныхХарактеристикТовара.Длина,       ЕдиницыИзмеренияМаркировки.Метр);
	СоответствиеХарактеристик.Вставить(ТипыПеременныхХарактеристикТовара.Количество,  ЕдиницыИзмеренияМаркировки.Штука);
	
	Возврат СоответствиеХарактеристик[ТипПеременнойХарактеристики];
	
КонецФункции

Функция ТипКорректировкиСведенийОКодахВСервисе(ТипКоррректировки)
	
	ТипыКорректировок = Перечисление_ТипыКорректировокСведенийОКодах();
	
	Если ТипКоррректировки = ТипыКорректировок.ДобавлениеСведений Тогда
		Результат = "Add";
	ИначеЕсли ТипКоррректировки = ТипыКорректировок.ЗаменаВсехСведений Тогда
		Результат = "Replace";
	Иначе
		ТекстОшибки = НСтр("ru = 'Неизвестный тип корректировки сведений о кодах: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ТипКоррректировки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипШтрихкодаПоТипуКодаМаркировкиИзСервиса(ТипКодаМаркировкиВСервисе)
	
	КлючКэш = "ТипШтрихкодаПоТипуКодаМаркировкиИзСервиса: " + ТипКодаМаркировкиВСервисе;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить(НРег("TtisAggregate"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.Code128);
	СоответствиеТипов.Вставить(НРег("Transport"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_128);
	СоответствиеТипов.Вставить(НРег("Sscc"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.SSCC);
	СоответствиеТипов.Вставить(НРег("Uit"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix);
	СоответствиеТипов.Вставить(НРег("Group"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix);
	СоответствиеТипов.Вставить(НРег("Consumer"), Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix);
	
	Результат = СоответствиеТипов[НРег(ТипКодаМаркировкиВСервисе)];
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТипУпаковкиПоВидуУпаковки(ВидУпаковки)
	
	ВидыУпаковок = Перечисления.КонтурМаркировка_ВидыУпаковок;
	
	Если ВидУпаковки = ВидыУпаковок.Логистическая
		Или ВидУпаковки = ВидыУпаковок.Групповая Тогда
		
		Результат = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка;
		
	ИначеЕсли ВидУпаковки = ВидыУпаковок.Потребительская Тогда
		
		Результат = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар;
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеПозицииДляКонтента(СтрокаТовара, ВзятьИзТовара = Ложь)
	
	НаименованиеТовара = "";
	Если ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
		НаименованиеТовара = СтрокаТовара.Товар.НаименованиеТовара;
	КонецЕсли;
	
	НаименованиеНоменклатуры = "";
	Если ЗначениеЗаполнено(СтрокаТовара.КлючНоменклатуры1С) Тогда
		НаименованиеНоменклатуры = КлючНоменклатуры1С_Представление(СтрокаТовара.КлючНоменклатуры1С);
	КонецЕсли;
	
	Если ВзятьИзТовара И ЗначениеЗаполнено(НаименованиеТовара) Тогда
		Результат = НаименованиеТовара;
	ИначеЕсли ЗначениеЗаполнено(НаименованиеНоменклатуры) Тогда
		Результат = НаименованиеНоменклатуры;
	Иначе
		Результат = НаименованиеТовара;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтатусКодаПоСтатусуИзСервиса(CisInfo)
	
	// BSLLS:TooManyReturns-off
	
	Если Не ЗначениеЗаполнено(CisInfo) Тогда
		Возврат "";
	КонецЕсли;
	
	error = CisInfo["error"];
	Если СтатусКодаСодержитОшибкуНеНайден(error) Тогда
		Возврат Перечисление_СтатусыКодов().НеНайден;
	КонецЕсли;
	Если СтатусКодаСодержитОшибкуНетДоступа(error) Тогда
		Возврат Перечисление_СтатусыКодов().НетДоступа;
	КонецЕсли;
	
	value = CisInfo["value"];
	Если Не ЗначениеЗаполнено(value) Тогда
		Возврат "";
	КонецЕсли;
	status = value["status"];
	Если Не ЗначениеЗаполнено(status) Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = СоответствиеСтатусовКодов().Получить(НРег(status));
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный статус кода в сервисе: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, status);
	КонецЕсли;
	
	Возврат Результат;
	
	// BSLLS:TooManyReturns-on
	
КонецФункции

Функция СтатусКодаСодержитОшибкуНеНайден(error)
	
	Возврат Найти(НРег(error), НРег("Не найден")) > 0;
	
КонецФункции

Функция СтатусКодаСодержитОшибкуНетДоступа(error)
	
	Возврат Найти(НРег(error), НРег("Нет доступа")) > 0;
	
КонецФункции

Функция ВидПродукцииПоТоварнойГруппеИзСервиса(ТоварнаяГруппа, ВызыватьИсключение = Истина) Экспорт
	
	Если Не ЗначениеЗаполнено(ТоварнаяГруппа) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючКэш = "ВидПродукцииПоТоварнойГруппеИзСервиса: " + ТоварнаяГруппа;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТГ = ТоварнаяГруппа;
	Если НРег(ТГ) = НРег("Bicycle") Тогда
		ТГ = "Bikes";
	КонецЕсли;
	
	Результат = СоответствиеТоварныхГруппИВидовПродукции().Получить(НРег(ТГ));
	
	Если Результат = Неопределено И ВызыватьИсключение Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось определить вид продукции по товарной группе из сервиса: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТоварнаяГруппа);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТипУпаковкиГИСМТПоТипуУпаковкиИзСервиса(ТипУпаковкиВСервисе)
	
	КлючКэш = "ТипУпаковкиПоТипуКодаМаркировкиИзСервиса: " + ТипУпаковкиВСервисе;
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыУпаковок = Перечисление_ТипыУпаковокГИСМТ();
	
	СоответствиеТипов = Новый Структура;
	СоответствиеТипов.Вставить(НРег("BUNDLE"), ТипыУпаковок.Комплект);
	СоответствиеТипов.Вставить(НРег("UNIT")	 , ТипыУпаковок.ЕдиницаТовара);
	СоответствиеТипов.Вставить(НРег("ATK")	 , ТипыУпаковок.АТК);
	СоответствиеТипов.Вставить(НРег("SET")	 , ТипыУпаковок.Набор);
	СоответствиеТипов.Вставить(НРег("GROUP") , ТипыУпаковок.ГрупповаяУпаковка);
	
	СоответствиеТипов.Вставить(НРег("LEVEL1"), ТипыУпаковок.Упаковка1Уровня);
	СоответствиеТипов.Вставить(НРег("LEVEL2"), ТипыУпаковок.Упаковка2Уровня);
	СоответствиеТипов.Вставить(НРег("LEVEL3"), ТипыУпаковок.Упаковка3Уровня);
	СоответствиеТипов.Вставить(НРег("LEVEL4"), ТипыУпаковок.Упаковка4Уровня);
	СоответствиеТипов.Вставить(НРег("LEVEL5"), ТипыУпаковок.Упаковка5Уровня);
	
	СоответствиеТипов.Вставить("Unknown", ТипыУпаковок.НеОпределен);
	
	Результат = СоответствиеТипов[НРег(ТипУпаковкиВСервисе)];
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Неизвестный тип упаковки в сервисе: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ТипУпаковкиВСервисе);
