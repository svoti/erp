	Если ЗначениеЗаполнено(АналитикаНоменклатуры.Номенклатура) Тогда
		СтрокаНоменклатура = Строка(АналитикаНоменклатуры.Номенклатура.УникальныйИдентификатор());
	КонецЕсли;
	
	СтрокаХарактеристика = "";
	Если ЗначениеЗаполнено(АналитикаНоменклатуры.Характеристика) Тогда
		СтрокаХарактеристика = Строка(АналитикаНоменклатуры.Характеристика.УникальныйИдентификатор());
	КонецЕсли;
	
	СтрокаУпаковка = "";
	Если ЗначениеЗаполнено(АналитикаНоменклатуры.Упаковка) Тогда
		СтрокаУпаковка = Строка(АналитикаНоменклатуры.Упаковка.УникальныйИдентификатор());
	КонецЕсли;
	
	СтрокаСерия = "";
	Если ЗначениеЗаполнено(АналитикаНоменклатуры.Серия) Тогда
		СтрокаСерия = Строка(АналитикаНоменклатуры.Серия.УникальныйИдентификатор());
	КонецЕсли;
	
	Возврат СтрокаНоменклатура + ", " + СтрокаХарактеристика + ", " + СтрокаУпаковка + ", " + СтрокаСерия;
	
