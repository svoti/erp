// Считает хеш-сумму SHA-256 для каждой строки
//
// Параметры:
//  Строки - Массив, Строка - строки, по которым нужно посчитать хеш
// 
// Возвращаемое значение:
//  Массив - содержит хеш-суммы в виде строк base64
//
Функция ХешСуммыСтрок(Строки) Экспорт
	
	МассивСтрок = ЗначениеВМассиве(Строки);
	ЧерезПлагин = ВерсияПлатформыНиже("8.3.3");
	
	Если ЧерезПлагин Тогда
		
		ТипыХешФункций = Модуль_Плагин().Перечисление_ТипыХешФункций();
		Результат = Модуль_Плагин().ХешСуммыСтрок(МассивСтрок, ТипыХешФункций.SHA256);
		
	Иначе
		
		ПараметрыКонструктора = Новый Массив;
		ПараметрыКонструктора.Добавить(Вычислить("ХешФункция.SHA256"));
		
		Результат = Новый Массив;
		Для каждого Строка Из МассивСтрок Цикл
			Хеширование = Новый("ХешированиеДанных", ПараметрыКонструктора);
			Хеширование.Добавить(Строка);
			ХешСумма = Base64Строка(Хеширование.ХешСумма);
			Результат.Добавить(ХешСумма);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

