Функция Маркировка_ТехИнформацияОСтатусеКода(КодМаркировки, Организация, ВидПродукции = Неопределено) Экспорт
	
	Результат = Мок_Маркировка_ТехИнформацияОСтатусеКода(КодМаркировки, Организация, ВидПродукции);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/api/v2/cises/info";
	
	Контент = Новый Структура;
	Контент.Вставить("inn", ЗначениеРеквизитаОбъектаЛок(Организация, "ИНН"));
	Контент.Вставить("cises", ЗначениеВМассиве(КодМаркировки));
	Если ЗначениеЗаполнено(ВидПродукции) Тогда
		Контент.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	КонецЕсли;
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(Контент);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	Результат = Маркировка_ТехОписаниеОтветаHTTP(Ответ, Запрос);
	
	Если Ответ.КодОтвета = КодОтвета_Успешно() Тогда
		Результат.РезультатЗапроса = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета, Истина);
	Иначе
		Результат.РезультатЗапроса = Ответ.ТелоОтвета;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Маркировка_ВложенныеКодыАгрегата(КодАгрегата, Организация, ВидПродукции = Неопределено)
	
	Попытка
		ТехИнформация = Маркировка_ТехИнформацияОСтатусеКода(КодАгрегата, Организация, ВидПродукции);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Получение из сервиса вложенных кодов агрегата'");
		ТекстСообщения = НСтр("ru = 'Не удалось получить из сервиса вложенные коды агрегата: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, УдалитьНедопустимыеСимволыXML(КодАгрегата));
		ОбработатьОшибку(Действие, Ошибка, УдалитьНедопустимыеСимволыXML(КодАгрегата), ТекстСообщения);
		ВызватьИсключение;
	КонецПопытки;
	
	СтатусКода = ЗначениеСоответствия(ТехИнформация.РезультатЗапроса, КодАгрегата);
	value = ЗначениеСоответствия(СтатусКода, "value");
	Результат = ЗначениеСоответствия(value, "childrenCodes");
	Результат = ЗначениеВМассиве(Результат);
	
