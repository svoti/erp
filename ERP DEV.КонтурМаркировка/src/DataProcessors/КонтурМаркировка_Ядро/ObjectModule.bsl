	Результат.Вставить("Запрос", Новый Структура);
	Результат.Запрос.Вставить("Параметры", Новый Соответствие);
	Результат.Запрос.Вставить("Заголовки", Новый Соответствие);
	Результат.Запрос.Вставить("ТелоЗапроса");
	
	Результат.Вставить("Ответ", Новый Структура);
	Результат.Ответ.Вставить("Заголовки", Новый Соответствие);
	Результат.Ответ.Вставить("ТелоОтвета");
	
	Возврат Результат;
	
