КонецПроцедуры

Процедура ТаблицаКодов_ВТ_ЗаполнитьКолонкуМожноУдалитьСнизуВверх(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаКодов.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Агрегаты
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлючАгрегата
	|		ПО ТаблицаКодов.КлючАгрегата = ПустойКлючАгрегата.Ключ
	|ГДЕ
	|	ПустойКлючАгрегата.Ключ ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.КлючАгрегата КАК КлючАгрегата,
	|	ТаблицаКодов.МожноУдалить КАК МожноУдалить
	|ПОМЕСТИТЬ Таб1
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Агрегаты КАК Агрегаты
	|		ПО ТаблицаКодов.КлючКода = Агрегаты.КлючАгрегата
	|ГДЕ
	|	Агрегаты.КлючАгрегата ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Агрегаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.КлючКода КАК КлючКода,
	|	Таб.КлючАгрегата КАК КлючАгрегата,
	|	Таб.МожноУдалить КАК МожноУдалить
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Таб");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.КлючАгрегата КАК КлючАгрегата,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ТаблицаКодов.МожноУдалить = ЛОЖЬ
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ Таб.МожноУдалить
	|		КОНЕЦ) КАК МожноУдалить
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКодов КАК ТаблицаКодов
	|		ПО Таб.КлючАгрегата = ТаблицаКодов.КлючКода
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаКодов.КлючКода,
	|	ТаблицаКодов.КлючАгрегата
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата,
	|	МИНИМУМ(Т.МожноУдалить) КАК МожноУдалить
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.КлючКода КАК КлючКода,
	|		Т.КлючАгрегата КАК КлючАгрегата,
	|		Т.МожноУдалить КАК МожноУдалить
	|	ИЗ
	|		Итог1 КАК Т
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Т.КлючКода,
	|		Т.КлючАгрегата,
	|		Т.МожноУдалить
	|	ИЗ
	|		Таб2 КАК Т) КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючКода,
	|	Т.КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	
	Пока Истина Цикл
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	УдалитьТаблицуИзЗапроса(МенеджерВТ, "ТаблицаКодов");
	
	ЕстьИтог1 = СтрокаСодержитЗначение(ТекстЗапроса, "ПОМЕСТИТЬ Итог1");
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ТаблицаКодов ИЗ Итог2 ИНДЕКСИРОВАТЬ ПО КлючКода; УНИЧТОЖИТЬ Таб2; УНИЧТОЖИТЬ Итог2";
	
	Если ЕстьИтог1 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Итог2", "Итог1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Таб2", "Таб1");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

