// Преобразует исходную строку в число без вызова исключений.
//
// Параметры:
//   Значение - Строка - строка, которую необходимо привести к числу.
//                       Например, "10", "+10", "010", вернет 10;
//                                 "(10)", "-10",вернет -10;
//                                 "10,2", "10.2",вернет 10.2;
//                                 "000", " ", "",вернет 0;
//                                 "10текст", вернет Неопределено.
//
// Возвращаемое значение:
//   Число, Неопределено - полученное число, либо Неопределено, если строка не является числом.
//
Функция СтрокаВЧисло(Знач Значение) Экспорт
	
	Значение  = СтрЗаменить(Значение, " ", "");
	Если СтрокаНачинаетсяС(Значение, "(") Тогда
		Значение = СтрЗаменить(Значение, "(", "-");
		Значение = СтрЗаменить(Значение, ")", "");
	КонецЕсли;
	
	СтрокаБезНулей = СтрЗаменить(Значение, "0", "");
	Если ПустаяСтрока(СтрокаБезНулей) Или СтрокаБезНулей = "-" Тогда
		Возврат 0;
	КонецЕсли;
	
	Результат = ОписаниеТипа_Число().ПривестиЗначение(Значение);
	
	Если Результат = 0 Или ПустаяСтрока(СтрокаБезНулей) Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьРеквизитИлиСвойствоОбъектаЛок(Объект, ИмяРеквизита) Экспорт
	
	КлючУникальности = Новый УникальныйИдентификатор;
	СтруктураРеквизита = Новый Структура(ИмяРеквизита, КлючУникальности);
	ЗаполнитьЗначенияСвойств(СтруктураРеквизита, Объект);
	
	Возврат СтруктураРеквизита[ИмяРеквизита] <> КлючУникальности;
	
КонецФункции

Функция НайтиСтроку(Строка, ПодстрокаПоиска, НачальнаяПозиция = 1, НомерВхождения = 1)
	
	Если НачальнаяПозиция = 1 И НомерВхождения = 1 Тогда
		Возврат Найти(Строка, ПодстрокаПоиска);
	КонецЕсли;
	
	Если НачальнаяПозиция > 1 Тогда
		СтрокаПоиска = Сред(Строка, НачальнаяПозиция);
	Иначе
		СтрокаПоиска = Строка;
	КонецЕсли;
	
	ТекущийНомерВхождения = 0;
	НачальнаяПозицияРезультата = НачальнаяПозиция - 1;
	
	Пока Истина Цикл
		
		Результат = Найти(СтрокаПоиска, ПодстрокаПоиска);
		
		Если Результат = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ТекущийНомерВхождения = ТекущийНомерВхождения + 1;
		Если ТекущийНомерВхождения = НомерВхождения Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаПоиска = Сред(СтрокаПоиска, Результат + 1);
		НачальнаяПозицияРезультата = НачальнаяПозицияРезультата + Результат;
		
	КонецЦикла;
	
	Если Результат > 0 Тогда
		Результат = НачальнаяПозицияРезультата + Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаНачинаетсяС(Строка, СтрокаПоиска) Экспорт
	
	Результат = Найти(Строка, СтрокаПоиска) = 1;
	
	Возврат Результат;
	
КонецФункции

// Находит в массиве структур первую строку с нужным значением
//
// Параметры:
//  МассивСтруктур - Массив - содержит структуры с одинаковым набором полей;
//  Значение - Произвольный - значение, которое нужно найти;
//  ИмяПоля - Строка - имя поля в котором нужно искать;
// 
// Возвращаемое значение:
//  Структура - структура из массива;
//  Неопределено - если не удалось найти подходящую строку;
//
Функция МассивСтруктур_Найти(МассивСтруктур, Значение, ИмяПоля) Экспорт
	
	Если Не ЗначениеЗаполнено(МассивСтруктур) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отбор = Новый Структура(ИмяПоля, Значение);
	
	НайденныеСтроки = МассивСтруктур_НайтиСтроки(МассивСтруктур, Отбор);
	
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Результат = НайденныеСтроки[0];
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

