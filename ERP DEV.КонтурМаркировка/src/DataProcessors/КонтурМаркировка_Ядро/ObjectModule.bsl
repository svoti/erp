// Читает из базы параметры обновления справочников при обмене с сервисом
//
// Возвращаемое значение:
//  Структура - см. Новый_ПараметрыОбновленияСправочниковПриОбмене();
//
Функция ПараметрыОбновленияСправочниковПриОбмене() Экспорт
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().ПараметрыОбновленияСправочниковПриОбмене;
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	
	Результат = Новый_ПараметрыОбновленияСправочниковПриОбмене();
	ЗаполнитьПоляСтруктуры(Результат, ДанныеИБ.ДопРеквизиты);
	
	Возврат Результат;
	
КонецФункции

// Записывает параметры обновления справочников в доп справочник
//
// Параметры:
//  Настройки - Структура - см. Новый_ПараметрыОбновленияСправочниковПриОбмене()
//
Процедура ПараметрыОбновленияСправочниковПриОбмене_Записать(Настройки) Экспорт
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().ПараметрыОбновленияСправочниковПриОбмене;
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	Для каждого Элемент Из Настройки Цикл
		ДанныеИБ.ДопРеквизиты.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

// Контракт всех настроек тихого обновления
// 
// Возвращаемое значение:
//  Структура - см. тело метода
//
Функция Новый_ПараметрыОбновленияСправочниковПриОбмене()
	
	Результат = Новый Структура;
	
	// Обновление данных из сервиса
	Результат.Вставить("ИменаПолейТоваровДляОбновления", Новый Массив);
	Результат.Вставить("ВидыПродукцииТоваровДляОбновления", Новый Массив);
	Результат.Вставить("ПоследнийОбновленныйТовар");
	
	Результат.Вставить("ИменаПолейОрганизацийДляОбновления", Новый Массив);
	Результат.Вставить("ОрганизацииДляОбновленияПолей", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

