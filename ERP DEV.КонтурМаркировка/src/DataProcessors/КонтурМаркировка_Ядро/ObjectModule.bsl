// #Область СтатусыДокументаУчета

Функция СтатусыДокументаУчета_Прочитать(ДокументУчета) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Статус КАК Статус,
	|	Т.ТипСтатуса КАК ТипСтатуса,
	|	Т.ДатаСтатуса КАК ДатаСтатуса,
	|	Т.ДопИнформация КАК ДопИнформация
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК Т
	|ГДЕ
	|	Т.ДокументУчета = &ДокументУчета");
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ТипСтатуса, Выборка.Статус);
		Результат.Вставить(ИмяПоляДатаСтатуса(Выборка.ТипСтатуса), Выборка.ДатаСтатуса);
		Результат.Вставить(ИмяПоляДопИнформация(Выборка.ТипСтатуса), Выборка.ДопИнформация);
	КонецЦикла;
	
	Если Не Результат.Свойство("ОсновнойСтатус") Тогда
		Результат.Вставить("ОсновнойСтатус", Перечисление_СтатусыДокументовУчета().Новый);
	КонецЕсли;
	
	Если Не Результат.Свойство("ТребуемоеДействие") Тогда
		Результат.Вставить("ТребуемоеДействие", Перечисление_ТребуемыеДействияДокументовУчета().НачатьРаботу);
	КонецЕсли;
	
	Если Не Результат.Свойство("ТребуемоеДействиеПоМаршруту") Тогда
		Результат.Вставить("ТребуемоеДействиеПоМаршруту", Перечисление_ТребуемыеДействияДокументовУчета().НачатьРаботу);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтатусыДокументовУчета_ПрочитатьВТаблицу(ДокументыУчета) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДокументыУчета.Ссылка КАК ДокументУчета,
	|	ЕСТЬNULL(ОсновныеСтатусы.Статус, &Новый) КАК ОсновнойСтатус,
	|	ЕСТЬNULL(ТребуемыеДействия.Статус, &НачатьРаботу) КАК ТребуемоеДействие
	|ИЗ
	|	Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ОсновныеСтатусы
	|		ПО ДокументыУчета.Ссылка = ОсновныеСтатусы.ДокументУчета
	|			И (ОсновныеСтатусы.ТипСтатуса = &ОсновнойСтатус)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК ТребуемыеДействия
	|		ПО ДокументыУчета.Ссылка = ТребуемыеДействия.ДокументУчета
	|			И (ТребуемыеДействия.ТипСтатуса = &ТребуемоеДействие)
	|ГДЕ
	|	ДокументыУчета.Ссылка В(&ДокументыУчета)";
	
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументыУчета", ДокументыУчета);
	Запрос.УстановитьПараметр("Новый", Перечисление_СтатусыДокументовУчета().Новый);
	Запрос.УстановитьПараметр("НачатьРаботу", Перечисление_ТребуемыеДействияДокументовУчета().НачатьРаботу);
	Запрос.УстановитьПараметр("ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	Запрос.УстановитьПараметр("ТребуемоеДействие", ТипыСтатусов.ТребуемоеДействие);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента) Экспорт
	
	СтатусыДокументаУчета_ОбновитьТребуемоеДействиеПоМаршруту(ДокументУчета, СтатусыДокумента);
	
	ДатаНовыхСтатусов = ТекущаяДатаСеанса();
	
	Для каждого КлючЗначение Из Перечисление_ТипыСтатусов() Цикл
		
		ТипСтатуса = КлючЗначение.Ключ;
		
		Если Не СтатусыДокумента.Свойство(ТипСтатуса) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйСтатус = СвойствоСтруктуры(СтатусыДокумента, ТипСтатуса, "");
		ДопИнформация = СвойствоСтруктуры(СтатусыДокумента, ИмяПоляДопИнформация(ТипСтатуса), "");
		
		Запись = РегистрыСведений.КонтурМаркировка_СтатусыДокументовУчета.СоздатьМенеджерЗаписи();
		Запись.ДокументУчета = ДокументУчета;
		Запись.ТипСтатуса	 = ТипСтатуса;
		Запись.Прочитать();
		
		Если Не ЗначениеЗаполнено(НовыйСтатус) Тогда
			Запись.Удалить();
			Продолжить;
		КонецЕсли;
		
		Если Запись.Статус = НовыйСтатус И Запись.ДопИнформация = ДопИнформация Тогда
			Продолжить;
		КонецЕсли;
		
		Запись.ДокументУчета = ДокументУчета;
		Запись.ТипСтатуса	 = ТипСтатуса;
		Запись.Статус		 = НовыйСтатус;
		Запись.ДатаСтатуса	 = ДатаНовыхСтатусов;
		Запись.ДопИнформация = ДопИнформация;
		
		Запись.Записать();
		
		СтатусыДокумента.Вставить(ИмяПоляДатаСтатуса(ТипСтатуса), ДатаНовыхСтатусов);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СтатусыДокументаУчета_Удалить(ДокументУчета) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СтатусыДокументаУчета_Заблокировать(ДокументУчета);
		
		Набор = РегистрыСведений.КонтурМаркировка_СтатусыДокументовУчета.СоздатьНаборЗаписей();
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СтатусыДокументаУчета_Заблокировать(ДокументУчета) Экспорт
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета");
	ЭлементБлокировки.УстановитьЗначение("ДокументУчета", ДокументУчета);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Процедура СтатусыДокументаУчета_ОбновитьТребуемоеДействиеПоМаршруту(ДокументУчета, СтатусыДокумента)
	
	ТребуемоеДействие = СвойствоСтруктуры(СтатусыДокумента, "ТребуемоеДействие");
	Если Не ЗначениеЗаполнено(ТребуемоеДействие) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТребуемоеДействие = Перечисление_ТребуемыеДействияДокументовУчета().РаботаЗавершена Тогда
		СтатусыДокумента.Вставить(Перечисление_ТипыСтатусов().ТребуемоеДействиеПоМаршруту, ТребуемоеДействие);
		Возврат;
	КонецЕсли;
	
	ОписаниеДокумента = Новый_ДокументУчета();
	ОписаниеДокумента.Ссылка = ДокументУчета;
	ДокументУчета_ПрочитатьЭтапыМаркировки(ОписаниеДокумента);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТребуемоеДействие", ТребуемоеДействие);
	
	Строки = ОписаниеДокумента.ЭтапыМаркировки.НайтиСтроки(ПараметрыОтбора);
	Если Строки.Количество() Тогда
		СтатусыДокумента.Вставить(Перечисление_ТипыСтатусов().ТребуемоеДействиеПоМаршруту, ТребуемоеДействие);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // СтатусыДокументаУчета

// #Область Операции

// Удаляет операции из справочника и все связаные с ними данные
//
// Параметры:
//  УдаляемыеОперации - Массив, СправочникСсылка.КонтурМаркировка_Операции - операции, которые надо удалить
//
Процедура Операции_Удалить(УдаляемыеОперации) Экспорт
	
	Если Не ЗначениеЗаполнено(УдаляемыеОперации) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		МассивОпераций = ЗначениеВМассиве(УдаляемыеОперации);
		
		СвернутьМассивЛок(МассивОпераций);
		МассивСлужебныхОпераций = Новый Массив;
		МассивДокументов = Новый Массив;
		Для Каждого Операция Из МассивОпераций Цикл
			
			ДополнитьМассив(МассивСлужебныхОпераций, Операция_НайтиПодчиненныеОперации(Операция, ТипыСлужебныхОпераций()));
			
			ДокументУчета = Операция.ДокументУчета;
			Если Операция_ВлияетНаТребуемоеДействиеДокумента(Операция)
				И Не МассивСодержитЗначение(МассивДокументов, ДокументУчета) Тогда
				МассивДокументов.Добавить(ДокументУчета);
			КонецЕсли;
			
		КонецЦикла;
		
		ДополнитьМассив(МассивОпераций, МассивСлужебныхОпераций);
		
		Операции_ЗаблокироватьПоТаблице(ТаблицаИзМассива(МассивОпераций));
		
		Для каждого Операция Из МассивОпераций Цикл
			
			Файлы_Удалить(Файлы_Найти(Операция));
			Задача_Удалить(Операция);
			Лента_Удалить(Операция);
			ДопРеквизиты_Удалить(Операция);
			ДопСвойства_Удалить(Операция);
			СтатусыОперации_Удалить(Операция);
			КодыЗаказов_Удалить(Операция);
			КодыОпераций_Записать(Новый_ТаблицаКодов(), Операция);
			
			ОбъектОперации = Операция.ПолучитьОбъект();
			Если ОбъектОперации <> Неопределено Тогда
				ОбъектОперации.ОбменДанными.Загрузка = Истина;
				ОбъектОперации.Удалить();
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ДокументУчета Из МассивДокументов Цикл
			ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Операции_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "Ссылка")
	
	Поле = "Ссылка";
	ИмяОбъекта = "Справочник.КонтурМаркировка_Операции";
	ЗаблокироватьПоТаблице(ИмяОбъекта, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

Функция Операции_НайтиПодчиненныеОперации(ОперацииОснования, Рекурсивно = Ложь)

	Результат = Новый Массив;
	Для Каждого Операция Из ОперацииОснования Цикл
		ПодчиненныеОперации = Операция_НайтиПодчиненныеОперации(Операция,, Рекурсивно);
		ДополнитьМассив(Результат, ПодчиненныеОперации);
	КонецЦикла;
	СвернутьМассивЛок(Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_Заблокировать(Операция)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("Справочник.КонтурМаркировка_Операции");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Операция);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция Операция_Записать(ОписаниеОперации) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеОперации.Ссылка) Тогда
			
			ПроверитьОбъектВПроцессеОбновления(ОписаниеОперации.Ссылка);
			Операция_Заблокировать(ОписаниеОперации.Ссылка);
			СтатусыОперации_Заблокировать(ОписаниеОперации.Ссылка);
			Объект = ОписаниеОперации.Ссылка.ПолучитьОбъект();
			
			Если СокрЛП(ОписаниеОперации.ВерсияДанных) <> СокрЛП(Объект.ВерсияДанных) Тогда
				ВызватьИсключение НСтр("ru = 'Версия операции в базе изменилась, текущую версию записать невозможно!'");
			КонецЕсли;
			
		Иначе
			
			Объект = Справочники.КонтурМаркировка_Операции.СоздатьЭлемент();
			
			ТипыОпераций = Перечисление_ТипыОпераций();
			Если ОписаниеОперации.ТипОперации = ТипыОпераций.ВходящийУПД
				Или ОписаниеОперации.ТипОперации = ТипыОпераций.УведомлениеОПриемке Тогда
				УникальныйИдентификатор = Новый УникальныйИдентификатор(ОписаниеОперации.ДопРеквизиты.ИдентификаторДокумента);
				Ссылка = Справочники.КонтурМаркировка_Операции.ПолучитьСсылку(УникальныйИдентификатор);
				Объект.УстановитьСсылкуНового(Ссылка);
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Объект, ОписаниеОперации, , "Ссылка, Товары");
		
		Объект.Код = ОписаниеОперации.Номер;
		
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Код) Тогда
			Операция_УстановитьНовыйКод(Объект);
		КонецЕсли;
		
		Операция_ЗаполнитьТовары(Объект, ОписаниеОперации);
		
		Объект.Записать();
		
		ОписаниеОперации.Дата = Объект.Дата;
		ОписаниеОперации.Номер = Объект.Код;
		ОписаниеОперации.Ссылка = Объект.Ссылка;
		ОписаниеОперации.ВерсияДанных = Объект.ВерсияДанных;
		
		ДопРеквизиты_Записать(ОписаниеОперации.Ссылка, ОписаниеОперации.ДопРеквизиты);
		СтатусыОперации_Записать(ОписаниеОперации.Ссылка, ОписаниеОперации.Статусы);
		
		Если Операция_ВлияетНаТребуемоеДействиеДокумента(ОписаниеОперации.Ссылка) Тогда
			ДокументУчета_ОбновитьТребуемоеДействие(ОписаниеОперации.ДокументУчета);
		КонецЕсли;
		
		Метрики_ПриЗаписиОперации(ОписаниеОперации);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Объект.Ссылка;
	
КонецФункции

// Находит все операции подходящие по параметрам
//
// Параметры:
//  ТипыОпераций - Строка, Массив - (необязательный) см. Перечисление_ТипыОпераций();
//  ДокументУчетаСсылка - СправочникСсылка.КонтурМаркировка_ДокументыУчета - (необязательный);
//  ОперацияОснованиеСсылка - СправочникСсылка.КонтурМаркировка_Операции - (необязательный);
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Операции
//
Функция Операция_НайтиОперации(ТипыОпераций = Неопределено, ДокументУчета = Неопределено, ОперацияОснование = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ТипыОпераций)
		И Не ЗначениеЗаполнено(ДокументУчета)
		И Не ЗначениеЗаполнено(ОперацияОснование) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнены параметры поиска операций'");
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Т
	|ГДЕ
	|	&ТипОперации
	|	И &ДокументУчета
	|	И &ОперацияОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата";
	
	Если ЗначениеЗаполнено(ТипыОпераций) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипОперации", "Т.ТипОперации В (&ТипыОпераций)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипОперации", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "Т.ДокументУчета = &ДокументУчета");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацияОснование) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацияОснование", "Т.ОперацияОснование = &ОперацияОснование");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацияОснование", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТипыОпераций", ТипыОпераций);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ОперацияОснование", ОперацияОснование);
	
	Возврат МассивИзРезультатаЗапроса(Запрос);
	
КонецФункции

Функция Операция_НайтиПодчиненныеОперации(ОперацияОснование, ТипыОпераций = Неопределено, Рекурсивно = Ложь) Экспорт
	
	Результат = Операция_НайтиОперации(ТипыОпераций, , ОперацияОснование);
	
	Если Рекурсивно Тогда
		Для каждого ПодчиненнаяОперация Из Результат Цикл
			ПодчиненныеОперации = Операция_НайтиПодчиненныеОперации(ПодчиненнаяОперация, ТипыОпераций, Рекурсивно);
			ДополнитьМассив(Результат, ПодчиненныеОперации);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ЕстьПодчиненныеОперации(ОперацияОснование, ТипыОпераций = Неопределено)
	
	Если Не ЗначениеЗаполнено(ТипыОпераций)
		И Не ЗначениеЗаполнено(ОперацияОснование) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнены параметры поиска подчиненных операций'");
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьПодчиненныеОперации
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Т
	|ГДЕ
	|	Т.ОперацияОснование = &ОперацияОснование И &ТипОперации";
	
	Если ЗначениеЗаполнено(ТипыОпераций) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипОперации", "Т.ТипОперации В (&ТипыОпераций)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипОперации", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТипыОпераций", ЗначениеВМассиве(ТипыОпераций));
	Запрос.УстановитьПараметр("ОперацияОснование", ОперацияОснование);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция Операция_ЕстьМультитоварныеНаборы(Операция, КлючСтрокиОперации = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции.Товары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Товары.СоставНабора КАК СоставНабора
	|		ПО Т.Товар = СоставНабора.Ссылка
	|ГДЕ
	|	Т.Ссылка = &Операция
	|	И Т.Товар.ТипКодаМаркировки = &ТипКодаНабор
	|	И &КлючСтрокиОперации
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.НомерСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СоставНабора.ВложенныйТовар.ВидПродукции) > 1";
	
	Если КлючСтрокиОперации = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", "ИСТИНА");
	Иначе
		ТекстУсловия = "Т.КлючСтрокиОперации = &КлючСтрокиОперации";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", ТекстУсловия);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("КлючСтрокиОперации", КлючСтрокиОперации);
	Запрос.УстановитьПараметр("ТипКодаНабор", Перечисление_ТипыКодовМаркировки().Набор);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Находит первую операцию по значению доп реквизита
//
// Параметры:
//  ТипОперации       - Строка       - см. Перечисление_ТипыОпераций();
//  ИмяРеквизита      - Строка       - имя реквизита;
//  ЗначениеРеквизита - Произвольный - значение реквизита;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Операции;
//  Неопределено - если подходящая операция не найдена;
//
Функция Операция_НайтиПоДопРеквизиту(ТипОперации, ИмяРеквизита, ЗначениеРеквизита)
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операция.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ДопРеквизиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операция
	|		ПО ДопРеквизиты.Объект = Операция.Ссылка
	|ГДЕ
	|	&ОтборПоЗначению
	|	И ДопРеквизиты.ИмяРеквизита = &ИмяРеквизита
	|	И Операция.ТипОперации = &ТипОперации";
	
	ЗначениеКлюч = Неопределено;
	ТипКлючаЗначения = Неопределено;
	
	Если ЭтоПростойТип(ЗначениеРеквизита) Тогда
		ОтборПоЗначению = "ДопРеквизиты.Значение = &Значение";
	ИначеЕсли ТипЗнч(ЗначениеРеквизита) = Тип("УникальныйИдентификатор") Тогда
		ОтборПоЗначению = "ДопРеквизиты.ЗначениеКлюч = &ЗначениеКлюч";
		ЗначениеКлюч = ЗначениеРеквизита;
	ИначеЕсли ЭтоОбъектКонтурМаркировки(ЗначениеРеквизита) Тогда
		ОтборПоЗначению = "ДопРеквизиты.ЗначениеКлюч = &ЗначениеКлюч И ДопРеквизиты.ТипКлючаЗначения = &ТипКлючаЗначения";
		ЗначениеКлюч = КлючОбъекта1С(ЗначениеРеквизита);
		ТипКлючаЗначения = ТипКлючаОбъекта1С(ЗначениеРеквизита);
	Иначе
		ОтборПоЗначению = "ДопРеквизиты.ЗначениеСсылка = &Значение";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоЗначению", ОтборПоЗначению);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТипОперации", ТипОперации);
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	Запрос.УстановитьПараметр("Значение", ЗначениеРеквизита);
	Запрос.УстановитьПараметр("ЗначениеКлюч", ЗначениеКлюч);
	Запрос.УстановитьПараметр("ТипКлючаЗначения", ТипКлючаЗначения);
	
	Возврат ПолучитьРезультатЗапроса(Запрос);
	
КонецФункции

// Возвращает статусы операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, по которой нужно прочитать статусы
// 
// Возвращаемое значение:
//  Структура - см. Новый_Операция_Статусы()
//
Функция Операция_СтатусыОперации(Операция) Экспорт
	
	Результат = Новый_Операция_Статусы();
	
	СтатусыИБ = СтатусыОперации_Прочитать(Операция);
	
	ЗаполнитьЗначенияСвойств(Результат, СтатусыИБ);
	
	Возврат Результат;
	
КонецФункции

// Возвращает основной статус операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, по которой нужно прочитать статусы
// 
// Возвращаемое значение:
//  Строка - статус, см. Перечисление_СтатусыОпераций()
//
Функция Операция_ОсновнойСтатус(Операция) Экспорт
	
	Возврат Операция_СтатусыОперации(Операция).ОсновнойСтатус;
	
КонецФункции

// Возвращает предыдущий статус операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, по которой нужно прочитать статусы
// 
// Возвращаемое значение:
//  Строка - статус, см. Перечисление_СтатусыОпераций()
//
Функция Операция_ПредыдущийОсновнойСтатус(Операция) Экспорт
	
	Возврат Операция_СтатусыОперации(Операция).ПредыдущийСтатус_ОсновнойСтатус;
	
КонецФункции

Функция Операция_ВводВОборот_ПодходящиеСтатусыКодов() Экспорт
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Результат = Новый Массив;
	Результат.Добавить(""); // Не запрашивали статус в ГИС МТ
	Результат.Добавить(СтатусыКодов.Выпущен);
	Результат.Добавить(СтатусыКодов.Нанесен);
	Результат.Добавить(СтатусыКодов.НеНайден); // Возможно СУЗ не успел передать коды в ГИС МТ
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ВлияетНаТребуемоеДействиеДокумента(Операция)
	
	Если Не ЗначениеЗаполнено(Операция.ДокументУчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	ПодходящиеТипыОпераций = Новый Массив;
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ПечатьКодов);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ВводВОборот);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ОтчетОНанесении);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ПодборКодовНаТСД);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ПодборТоваровИКодовНаТСД);
	
	Возврат МассивСодержитЗначение(ПодходящиеТипыОпераций, Операция.ТипОперации);
	
КонецФункции

Процедура Операция_СоздатьНаКаждыйАгрегатНаполнениеНаТСД(ОперацияОснование)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
	ПолучатьПолныеКоды = ОписаниеОснования.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
	РегистрироватьПослеНаполнения = ОписаниеОснования.ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения;
	ЗаписатьТаблицуКодов = Ложь;
	
	ТаблицаКодов = КодыОпераций_Прочитать(ОперацияОснование);
	КодыМаркировки_Прочитать(ТаблицаКодов);
	ТаблицаКодов.Сортировать("КодМаркировки Убыв");
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Для каждого Стр Из ТаблицаКодов Цикл
			
			Если Не ЗначениеЗаполнено(Стр.КлючСтрокиОперации) Тогда
				Стр.КлючСтрокиОперации = Новый УникальныйИдентификатор;
				ЗаписатьТаблицуКодов = Истина;
			КонецЕсли;
			
			ОписаниеОперации = Новый_Операция();
			ОписаниеОперации.ТипОперации = ТипыОпераций.НаполнениеОдногоАгрегатаНаТСД;
			ОписаниеОперации.КлючСтрокиОперацииОснования = Стр.КлючСтрокиОперации;
			ОписаниеОперации.ОперацияОснование = ОписаниеОснования.Ссылка;
			ОписаниеОперации.ДопРеквизиты.КлючКода = Стр.КлючКода;
			ЗаполнитьЗначенияСвойств(ОписаниеОперации, ОписаниеОснования, "ДокументУчета, Организация, Склад, ВидПродукции");
			
			ОписаниеОперации.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД = ПолучатьПолныеКоды;
			ОписаниеОперации.ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения = РегистрироватьПослеНаполнения;
			
			Операция = Операция_Записать(ОписаниеОперации);
			
			Задача_Создать(Операция);
			
		КонецЦикла;
		
		Если ЗаписатьТаблицуКодов Тогда
			КодыОпераций_Записать(ТаблицаКодов, ОперацияОснование);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Операция_СоздатьРегистрациюНаКаждыйАгрегат(ОписаниеОснования, КлючСтрокиОперацииОснования, КлючАгрегата)
	
	ТранспортнаяУпаковка = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ОписаниеОперации = Новый_Операция();
		ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().РегистрацияОдногоАгрегатаВГИС;
		ОписаниеОперации.КлючСтрокиОперацииОснования = КлючСтрокиОперацииОснования;
		ОписаниеОперации.ОперацияОснование = ОписаниеОснования.Ссылка;
		ОписаниеОперации.ДопРеквизиты.КлючКода = КлючАгрегата;
		ЗаполнитьЗначенияСвойств(ОписаниеОперации, ОписаниеОснования, "ДокументУчета, Организация, Склад, ВидПродукции");
		
		ТаблицаКодов = КодыМаркировки_ТаблицаВложенныхКодов(КлючАгрегата, ТранспортнаяУпаковка, Ложь);
		Для каждого Стр Из ТаблицаКодов Цикл
			Стр.КлючСтрокиОперации = Новый УникальныйИдентификатор;
		КонецЦикла;
		
		Операция = Операция_Записать(ОписаниеОперации);
		
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		
		Задача_Создать(Операция);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Операция_СоздатьПакетАгрегатов(ОписаниеОснования, КлючСтрокиОперацииОснования)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	ТипОснования = ОписаниеОснования.ТипОперации;
	ПолучатьПолныеКоды = ОписаниеОснования.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
	РегистрироватьПослеНаполнения = ОписаниеОснования.ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения;
	
	Если ТипОснования = ТипыОпераций.НаполнениеАгрегатовНаТСД Тогда
		ТипОперации = ТипыОпераций.НаполнениеПакетаАгрегатовНаТСД;
	Иначе
		ТипОперации = ТипыОпераций.РегистрацияПакетаАгрегатов;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ОписаниеОперации = Новый_Операция();
		ОписаниеОперации.ТипОперации = ТипОперации;
		ОписаниеОперации.КлючСтрокиОперацииОснования = КлючСтрокиОперацииОснования;
		ОписаниеОперации.ОперацияОснование = ОписаниеОснования.Ссылка;
		ЗаполнитьЗначенияСвойств(ОписаниеОперации, ОписаниеОснования, "ДокументУчета, Организация, Склад, ВидПродукции, Комментарий");
		
		Если ТипОснования = ТипыОпераций.НаполнениеАгрегатовНаТСД Тогда
			ОписаниеОперации.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД = ПолучатьПолныеКоды;
			ОписаниеОперации.ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения = РегистрироватьПослеНаполнения;
		КонецЕсли;
		
		Операция = Операция_Записать(ОписаниеОперации);
		
		Задача_Создать(Операция);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Операция_Агрегация_РазбитьНаПакеты(ТаблицаКодов, ОписаниеОснования)
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТранспортнаяУпаковка = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
	
	ТипОснования = ОписаниеОснования.ТипОперации;
	
	КлючиКодов = ТаблицаКодов.ВыгрузитьКолонку("КлючКода");
	ТоварыАгрегатов = ТоварыАгрегатов_Прочитать(КлючиКодов);
	ТоварыАгрегатов.Свернуть("КлючКода", "КоличествоУпаковок");
	ТаблицаЗначений_ДобавитьИндекс(ТоварыАгрегатов, "КлючКода");
	
	ТаблицаКолВложАгрегатов = КодыМаркировки_КоличествоВложенныхКодов(КлючиКодов, ТранспортнаяУпаковка, Ложь);
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКолВложАгрегатов, "КлючКода");
	КлючиКодов.Очистить();
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов.Сортировать("КодАгрегата Убыв, КодМаркировки Убыв");
	ТаблицаКодов.ЗаполнитьЗначения(ПустойУникальныйИдентификатор(), "КлючСтрокиОперации");
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючСтрокиОперации, КлючАгрегата");
	
	СамАгрегат = 1;
	КолКодовВПакете = 0;
	КолАгрегатовВПакете = 0;
	МаксКолКодовВПакете = 30000;
	МаксКолАгрегатовВПакете = 15000;
	
	ОтборПакет = Новый Структура("КлючСтрокиОперации");
	ОтборПакетАгрегат = Новый Структура("КлючСтрокиОперации, КлючАгрегата");
	
	КлючПакета = Новый УникальныйИдентификатор;
	ТекКлючПакета = КлючПакета;
	ТекКлючАгрегата = ТаблицаКодов[0].КлючАгрегата;
	
	Индекс = 0;
	Пока Индекс < ТаблицаКодов.Количество() Цикл
		
		Стр = ТаблицаКодов[Индекс];
		
		Если Стр.Статус <> СтатусыКодов.НеНайден Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		СтрТоваров = ТоварыАгрегатов.Найти(Стр.КлючКода, "КлючКода");
		СтрКолВложАгрегатов = ТаблицаКолВложАгрегатов.Найти(Стр.КлючКода, "КлючКода");
		
		Если СтрКолВложАгрегатов <> Неопределено Тогда
			КолВложКодов = СтрКолВложАгрегатов.КоличествоВложенныхКодов;
		ИначеЕсли СтрТоваров <> Неопределено Тогда
			КолВложКодов = СтрТоваров.КоличествоУпаковок;
		Иначе
			КолВложКодов = 0;
		КонецЕсли;
		
		Если КолВложКодов = 0 И ТипОснования <> ТипыОпераций.НаполнениеАгрегатовНаТСД Тогда
			Индекс = Индекс + 1;
			Продолжить; // Пустой агрегат зарегистрировать не получится
		КонецЕсли;
		
		Если КолАгрегатовВПакете + СамАгрегат > МаксКолАгрегатовВПакете
			Или КолКодовВПакете + СамАгрегат + КолВложКодов > МаксКолКодовВПакете Тогда
			
			КлючПакета = Новый УникальныйИдентификатор;
			
			КолКодовВПакете = 0;
			КолАгрегатовВПакете = 0;
			
			Если ЗначениеЗаполнено(ТекКлючАгрегата) И ТекКлючАгрегата = Стр.КлючАгрегата Тогда
				
				ОтборПакет.КлючСтрокиОперации = ТекКлючПакета;
				ОтборПакетАгрегат.КлючСтрокиОперации = ТекКлючПакета;
				ОтборПакетАгрегат.КлючАгрегата = ТекКлючАгрегата;
				
				ВсегоСтрокВПакете = ТаблицаКодов.НайтиСтроки(ОтборПакет).Количество();
				СтрокиАгрегатаВПакете = ТаблицаКодов.НайтиСтроки(ОтборПакетАгрегат);
				
				Если СтрокиАгрегатаВПакете.Количество() < ВсегоСтрокВПакете Тогда
					// В текущем пакете есть коды других агрегатов верхнего уровня, вынесем из пакета коды этого агрегата,
					// чтобы снизить зависимость между агрегатами верхнего уровня через пакеты агрегатов нижнего уровня.
					// Для этого, вернемся к первой строке текущего агрегата верхнего уровня.
					Индекс = ТаблицаКодов.Индекс(СтрокиАгрегатаВПакете[0]);
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ТекКлючПакета = КлючПакета;
		ТекКлючАгрегата = Стр.КлючАгрегата;
		
		КолКодовВПакете = КолКодовВПакете + СамАгрегат + КолВложКодов;
		КолАгрегатовВПакете = КолАгрегатовВПакете + СамАгрегат;
		
		Стр.КлючСтрокиОперации = КлючПакета;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючСтрокиОперации, КлючАгрегата");
	КодыОпераций_Записать(ТаблицаКодов, ОписаниеОснования.Ссылка);
	
	Для Каждого КлючСтрокиОперации Из ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КлючСтрокиОперации", Истина) Цикл
		Операция_СоздатьПакетАгрегатов(ОписаниеОснования, КлючСтрокиОперации);
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_СоздатьРасформированиеАгрегатаВГИС(ОперацияОснование, КлючСтрокиОперацииОснования, КлючАгрегата)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		РеквизитыОснования = ЗначенияРеквизитовОбъектаЛок(ОперацияОснование, "ДокументУчета, Организация, Склад");
		
		ОписаниеОперации = Новый_Операция();
		ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().РасформированиеАгрегатаВГИС;
		ОписаниеОперации.КлючСтрокиОперацииОснования = КлючСтрокиОперацииОснования;
		ОписаниеОперации.ОперацияОснование = ОперацияОснование;
		ОписаниеОперации.ДопРеквизиты.КлючКода = КлючАгрегата;
		ЗаполнитьЗначенияСвойств(ОписаниеОперации, РеквизитыОснования);
		
