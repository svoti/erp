// Проверяет наличие объектов, реквизитов шапки или реквизитов табличной части в метаданных
//
// Параметры:
//  НеобходимыеМетаданные - Массив, Строка - строка или массив строк метаданных
// 
// Возвращаемое значение:
//  Булево - Истина, если такие метаданные есть в конфигуарции
//
Функция ЕстьМетаданные(НеобходимыеМетаданные)
	
	Для Каждого СтрокаМетаданных Из ЗначениеВМассиве(НеобходимыеМетаданные) Цикл
		Если Не МодульОбщегоНазначения().ЕстьНеобходимыеМетаданные(СтрокаМетаданных) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция КаноническийИдентификаторИзСтроки(Строка) Экспорт
	
	Если Не ЗначениеЗаполнено(Строка)  Тогда
		Возврат СтрокаПустогоИдентификатора();
	КонецЕсли;
	
	ЗначимаяЧастьСтроки = СтрЗаменить(Строка, "-", "");
	ДлинаИдентификатора = 36;
	
	Блок1 = Сред(ЗначимаяЧастьСтроки, 1, 8);
	Блок2 = Сред(ЗначимаяЧастьСтроки, 9, 4);
	Блок3 = Сред(ЗначимаяЧастьСтроки, 13, 4);
	Блок4 = Сред(ЗначимаяЧастьСтроки, 17, 4);
	Блок5 = Сред(ЗначимаяЧастьСтроки, 21, 12);
	
	Результат = ПараметрыВСтроку("%1-%2-%3-%4-%5", Блок1, Блок2, Блок3, Блок4, Блок5);
	
	ЗначимаяЧастьРезультата = СтрЗаменить(Результат, "-", "");
	
	Если СтрДлина(Результат) < ДлинаИдентификатора Или ЗначимаяЧастьРезультата <> ЗначимаяЧастьСтроки Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось сформировать канонический идентификатор из строки: %1'"), Строка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Сравнивает версии между собой, значения после дефиса или слэша не учитываются
//
// Параметры:
//  Версия1	 - Строка - номер версии в формате РР.{П|ПП}.ЗЗ.СС
//  Версия2	 - Строка - второй сравниваемый номер версии
// 
// Возвращаемое значение:
//  Число - результат сравнения:
//   * больше 0 - если Версия1 > Версия2;
//   * меньше 0 - если Версия1 < Версия2;
//   * 0 - если версии равны;
//
Функция СравнитьВерсии(Версия1, Версия2) Экспорт
	
	Возврат МодульОбщегоНазначения().СравнитьВерсии(Версия1, Версия2);
	
КонецФункции

Функция ЭтоСтрокаПустогоИдентификатора(Знач Идентификатор) Экспорт
	
