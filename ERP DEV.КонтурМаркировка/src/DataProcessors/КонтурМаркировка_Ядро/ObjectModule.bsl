Процедура ИдентификаторСобытияОшибкиЛенты_Записать(Организация, ИдентификаторСобытияОшибкиЛенты) Экспорт
	
	Объект = ВладелецДопСвойствЧтенияЛенты(Организация);
	ИмяСвойства = Перечисление_ДопСвойства().ИдентификаторСобытияОшибкиЛенты;
	
	ДопСвойство_Записать(Объект, ИмяСвойства, ИдентификаторСобытияОшибкиЛенты);
	
КонецПроцедуры

Функция ВладелецДопСвойствЧтенияЛенты(Объект)
	
	Результат = Объект;
	
	Настройки = НастройкиМодуля();
	Если Настройки.РежимРИБ Тогда
		Результат = НастройкиТекущегоУзлаРИБ(Настройки.ПланОбмена).Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

