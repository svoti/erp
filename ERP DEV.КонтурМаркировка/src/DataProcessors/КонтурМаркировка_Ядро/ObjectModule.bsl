Функция Контент_ЗапроситьАвторизацию(ФайлСертификата)
	
	ОписаниеПриложения = ПараметрыПриложенияАвторизации();
	
	Параметры = Новый Массив;
	Параметры.Добавить("client_id=" + ОписаниеПриложения.ИмяПриложения);
	Параметры.Добавить("client_secret=" + ОписаниеПриложения.КлючПриложения);
	Параметры.Добавить("public_key=" + КодироватьСтрокуURL(Base64ИзДвоичныхДанных(ФайлСертификата)));
	
	Возврат СоединитьСтроку(Параметры, "&");
	
КонецФункции

Функция Контент_ПолучитьТокен(Сертификат, РасшифрованныйКлюч)
	
	ОписаниеПриложения = ПараметрыПриложенияАвторизации();
	
	Параметры = Новый Массив;
	Параметры.Добавить("grant_type=certificate");
	Параметры.Добавить("client_id=" + ОписаниеПриложения.ИмяПриложения);
	Параметры.Добавить("client_secret=" + ОписаниеПриложения.КлючПриложения);
	Параметры.Добавить("thumbprint=" + Сертификат.ОтпечатокСертификата);
	Параметры.Добавить("decrypted_key=" + КодироватьСтрокуURL(Base64ИзДвоичныхДанных(РасшифрованныйКлюч)));
	
	Возврат СоединитьСтроку(Параметры, "&");
	
КонецФункции

Функция Контент_ПродлитьТокен(ТокенПродления)
	
	ОписаниеПриложения = ПараметрыПриложенияАвторизации();
	
	Параметры = Новый Массив;
	Параметры.Добавить("grant_type=refresh_token");
	Параметры.Добавить("client_id=" + ОписаниеПриложения.ИмяПриложения);
	Параметры.Добавить("client_secret=" + ОписаниеПриложения.КлючПриложения);
	Параметры.Добавить("refresh_token=" + ТокенПродления);
	
	Возврат СоединитьСтроку(Параметры, "&");
	
КонецФункции

Функция Контент_ЗаказКодов(ОписаниеОперации)
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипОплатыКодов = ДопРеквизиты.ТипОплатыКодов;
	СервисПровайдер = ДопРеквизиты.СервисПровайдер;
	СпособВыпускаТоваров = ДопРеквизиты.СпособВыпускаТоваров;
	ТипКодаМаркировки = ДопРеквизиты.ТипКодаМаркировки;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ФорматКодов = ДопРеквизиты.ФорматКодов;
	СобственникТовараИНН = ДопРеквизиты.СобственникТовараИНН;
	КарточкиТоваровПринадлежатДругойОрганизации = ДопРеквизиты.КарточкиТоваровПринадлежатДругойОрганизации;
	
	Результат = Новый Структура;
	Результат.Вставить("number", ОписаниеОперации.Номер);
	Результат.Вставить("comment", ОписаниеОперации.Комментарий);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	Результат.Вставить("releaseMethodType", СпособВыпускаТоваровВСервисе(СпособВыпускаТоваров));
	
	Если ЗначениеЗаполнено(СервисПровайдер) Тогда
		Результат.Вставить("serviceProviderId", СервисПровайдер.Идентификатор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипОплатыКодов)
		И ВидПродукцииТребуетТипОплатыКодов(ВидПродукции) Тогда
		Результат.Вставить("paymentType", ТипОплатыКодовВСервисе(ТипОплатыКодов));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФорматКодов)
		И ВидПродукцииПоддерживаетУкороченныйФорматКодов(ВидПродукции) Тогда
		Результат.Вставить("codeTemplate", ФорматКодовВСервисе(ФорматКодов));
	КонецЕсли;
	
	Если КарточкиТоваровПринадлежатДругойОрганизации
		И ЗначениеЗаполнено(СобственникТовараИНН) Тогда
		Результат.Вставить("producerInn", СобственникТовараИНН);
	КонецЕсли;
	
	positions = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		position = Новый Структура;
		position.Вставить("name"	, НаименованиеПозицииДляКонтента(Стр));
		position.Вставить("gtin"	, Стр.Товар.GTIN);
		position.Вставить("quantity", Стр.КоличествоУпаковок);
		position.Вставить("cisType"	, ТипПотребительскойУпаковкиВСервисе(ТипКодаМаркировки));
		Если СпособВыпускаТоваров = Перечисление_СпособыВыпускаТоваров().Перемаркировка Тогда
			position.Вставить("tnvedCode", Стр.КодТНВЭД);
		КонецЕсли;
		positions.Добавить(position);
	КонецЦикла;
	МассивСтруктур_Свернуть(positions, "gtin", "quantity");
	
	Результат.Вставить("positions", positions);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВводВОборот(ОписаниеОперации)
	
	СпособыВводаВОборот = Перечисление_СпособыВводаВОборот();
	
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
	СпособВводаВОборот = ОписаниеОснования.ДопРеквизиты.СпособВводаВОборот;
	
	Если СпособВводаВОборот = СпособыВводаВОборот.ПроизводствоРФ Тогда
		
		Результат = Контент_ВводВОборот_ПроизводствоРФ(ОписаниеОперации, ОписаниеОснования);
		
	ИначеЕсли СпособВводаВОборот = СпособыВводаВОборот.Импорт Тогда
		
		Результат = Контент_ВводВОборот_Импорт(ОписаниеОперации, ОписаниеОснования);
		
	ИначеЕсли СпособВводаВОборот = СпособыВводаВОборот.ИмпортФТС Тогда
		
		Результат = Контент_ВводВОборот_ИмпортФТС(ОписаниеОперации, ОписаниеОснования);
		
	ИначеЕсли СпособВводаВОборот = СпособыВводаВОборот.Остатки Тогда
		
		Результат = Контент_ВводВОборот_Остатки(ОписаниеОперации, ОписаниеОснования);
		
	ИначеЕсли СпособВводаВОборот = СпособыВводаВОборот.Трансгран Тогда
		
		Результат = Контент_ВводВОборот_Трансгран(ОписаниеОперации, ОписаниеОснования);
		
	ИначеЕсли СпособВводаВОборот = СпособыВводаВОборот.СПричиной Тогда
		
		Результат = Контент_ВводВОборот_СПричиной(ОписаниеОперации, ОписаниеОснования);
		
	Иначе
		
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Ввод в оборот ""%1"" не поддерживается'"), СпособВводаВОборот);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВводВОборот_ПроизводствоРФ(ОписаниеОперации, ОписаниеОснования)
	
	Операция = ОписаниеОперации.Ссылка;
	ОперацияОснование = ОписаниеОснования.Ссылка;
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	ДопРеквизиты = ОписаниеОснования.ДопРеквизиты;
	СтрТовара = ОписаниеОснования.Товары.Найти(КлючСтрокиОперации, "КлючСтрокиОперации");
	
	ТипПроизводственногоЗаказа = ДопРеквизиты.ТипПроизводственногоЗаказа;
	РазрешительныйДокумент = СтрТовара.РазрешительныйДокумент;
	НомерЛицензииНаНедра = СтрТовара.НомерЛицензииНаНедра;
	ДатаЛицензииНаНедра = СтрТовара.ДатаЛицензииНаНедра;
	НомераСкважин = СтрТовара.НомераСкважин;
	ИдентификаторВСД = Контент_ВводВОборот_ИдентификаторВСД(СтрТовара, ДопРеквизиты);
	
	ДатаПроизводства = ДопРеквизиты.ДатаПроизводства;
	Если ЗначениеЗаполнено(СтрТовара.ДатаПроизводства) Тогда
		ДатаПроизводства = НачалоДня(СтрТовара.ДатаПроизводства);
	КонецЕсли;
	
	ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, КлючСтрокиОперации, Ложь);
	МассивКодовОперации = Новый Массив;
	Для Каждого Стр Из ТаблицаКодов Цикл
		МассивКодовОперации.Добавить(Стр);
	КонецЦикла;
	ТаблицаКодов_ДобавитьКлючиВсехВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов.Индексы.Добавить("КодАгрегата");
	
	Результат = Новый Структура;
	Результат.Вставить("productionType"	, ТипПроизводстваВСервисе(ТипПроизводственногоЗаказа));
	Результат.Вставить("productGroup"	, ТоварнаяГруппаВСервисе(ОписаниеОснования.ВидПродукции));
	Результат.Вставить("documentNumber"	, ОписаниеОснования.Номер);
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "productionDate", ЛокальнаяДатаСоСмещениемXML(НачалоДня(ДатаПроизводства)));
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОснования.Комментарий);
	
	Если ТипПроизводственногоЗаказа = Перечисление_ТипыПроизводственныхЗаказов().КонтрактноеПроизводство Тогда
		Результат.Вставить("producerInn", ДопРеквизиты.ПроизводительИНН);
		Результат.Вставить("ownerInn", ДопРеквизиты.СобственникТовараИНН);
	КонецЕсли;
	
	position = Новый Структура;
	position.Вставить("name", НаименованиеПозицииДляКонтента(СтрТовара));
	position.Вставить("gtin", СтрТовара.Товар.GTIN);
	position.Вставить("tnvedCode", СтрТовара.КодТНВЭД);
	
	Если ВидПродукцииДопускаетУказаниеРазрешительнойДокументации(ОписаниеОснования.ВидПродукции) Тогда
		Контент_ВводВОборот_ЗаполнитьРД(position, РазрешительныйДокумент);
	КонецЕсли;
	
	Контент_ВводВОборот_ЗаполнитьЛицензиюНаНедра(position, НомерЛицензииНаНедра, ДатаЛицензииНаНедра);
	
	Если ТаблицаКодов_ЕстьАгрегатыИВложенныеКоды(ТаблицаКодов) Тогда
		
		aggregateCodes = Новый Массив;
		Для каждого Стр Из МассивКодовОперации Цикл
			aggregateCodes.Добавить(Контент_ВводВОборот_aggregateCode(Стр, ТаблицаКодов, ИдентификаторВСД, РазрешительныйДокумент, НомераСкважин));
		КонецЦикла;
		position.Вставить("aggregateCodes", aggregateCodes);
		
	Иначе
		
		Контент_ВводВОборот_ЗаполнитьНомераСкважин(position, НомераСкважин);
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(position, "accompanyingDocument", ИдентификаторВСД);
		
		position.Вставить("codes", ТаблицаКодов.ВыгрузитьКолонку("КодМаркировки"));
		
	КонецЕсли;
	
	Результат.Вставить("positions", ЗначениеВМассиве(position));
	
	Возврат Результат;
	
КонецФункции

