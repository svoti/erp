	КонецЕсли;
	
	// Отключена в документе
	Если РезультатыПроверкиКодов.ПроверкаВладельцаКодов = СтатусыПроверкиКодов.Отключена
		И РезультатыПроверкиКодов.ДопИнформация_ПроверкаВладельцаКодов = ДопИнформацияСтатусов.ПроверкаКодовОтключенаВДокументе Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоКодовВсего = ТаблицаКодов.Количество();
	КоличествоКодовБезОшибок = 0;
	
	Индекс = ТаблицаКодов.Индексы.Добавить("ПроверкаВладельца");
	
	Отбор = Новый Структура("ПроверкаВладельца");
	Для Каждого ВалидныйСтатус Из Перечисление_ВалидныеСтатусыПроверкиКодаДокумента() Цикл
		Отбор.ПроверкаВладельца = ВалидныйСтатус;
		КоличествоКодовБезОшибок = КоличествоКодовБезОшибок + ТаблицаКодов.НайтиСтроки(Отбор).Количество();
	КонецЦикла;
	
	ТаблицаКодов.Индексы.Удалить(Индекс);
	
	Если КоличествоКодовБезОшибок = 0 Тогда
		ДопИнформация = ДопИнформацияСтатусов.ВсеКодыНеПринадлежатОрганизации;
	ИначеЕсли КоличествоКодовБезОшибок = КоличествоКодовВсего Тогда
		ДопИнформация = ДопИнформацияСтатусов.ВсеКодыПринадлежатОрганизации;
	Иначе
		ДопИнформация = ДопИнформацияСтатусов.ЧастьКодовНеПринадлежатОрганизации;
	КонецЕсли;
	
	СтатусыОшибок = Новый Массив;
	СтатусыОшибок.Добавить(ДопИнформацияСтатусов.ВсеКодыНеПринадлежатОрганизации);
	СтатусыОшибок.Добавить(ДопИнформацияСтатусов.ЧастьКодовНеПринадлежатОрганизации);
	
	Если МассивСодержитЗначение(СтатусыОшибок, ДопИнформация) Тогда
		ИтоговыйСтатус = СтатусыПроверкиКодов.ЕстьОшибки;
	Иначе
		ИтоговыйСтатус = СтатусыПроверкиКодов.Успешно;
	КонецЕсли;
	
	РезультатыПроверкиКодов.ПроверкаВладельцаКодов = ИтоговыйСтатус;
	РезультатыПроверкиКодов.ДопИнформация_ПроверкаВладельцаКодов = ДопИнформация;
	
КонецПроцедуры

Процедура ДокументУчета_ЗаполнитьРезультатПроверкиРДКодов(РезультатыПроверкиКодов, ДокументУчета, ТаблицаКодов)
	
