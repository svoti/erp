КонецПроцедуры

Процедура ДокументУчета_УдалитьРезультатыПроверкиКодов(ДокументУчета) Экспорт
	
	ДокументУчета_УстановитьСтатусРезультатаПроверкиКодовНеактуален(ДокументУчета);
	
	Если КодыДокументов_ЕстьРезультатыПроверкиКодов(ДокументУчета) Тогда
		ТаблицаКодов = КодыДокументов_Прочитать(ДокументУчета);
		ТаблицаКодов.ЗаполнитьЗначения(Неопределено, "КлючПроверкиКода");
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, , , Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДокументУчета_ПроверитьСтатусКодов(ДокументУчета, ТаблицаКодов)
	
	ТипПроверкаСтатусаКодов = Перечисление_ТипыПроверкиКодов().ПроверкаСтатусаКодов;
	Если Не ДокументУчета_ВключенТипПроверкиКодов(ДокументУчета, ТипПроверкаСтатусаКодов) Тогда
		ТаблицаКодов.ЗаполнитьЗначения(Перечисление_РезультатыПроверкиКодовДокументов().Отключена, "ПроверкаСтатуса");
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПроверятьКод", Истина);
	
	СтрокиДляПроверкиСтатусов = ТаблицаКодов.НайтиСтроки(Отбор);
	
	Если Не ЗначениеЗаполнено(СтрокиДляПроверкиСтатусов) Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеСтатусаКодаИРезультатаПроверки = СоответствиеСтатусаКодаИРезультатаПроверкиКода();
	Для Каждого Стр Из СтрокиДляПроверкиСтатусов Цикл
		Стр.ПроверкаСтатуса = СоответствиеСтатусаКодаИРезультатаПроверки.Получить(Стр.Статус);
	КонецЦикла;
	
	Функциональность = Перечисление_ФункциональностьМодуля().ПроверитьСтатусКодовДокументаУчета;
	Метрика_Функциональность_ПроверитьКодыДокументаУчета(Функциональность, ДокументУчета.Организация);
	
КонецПроцедуры

Процедура ДокументУчета_ПроверитьВладельцаКодов(ДокументУчета, ТаблицаКодов)
	
	ТипПроверкаВладельцаКодов = Перечисление_ТипыПроверкиКодов().ПроверкаВладельцаКодов;
	Если Не ДокументУчета_ВключенТипПроверкиКодов(ДокументУчета, ТипПроверкаВладельцаКодов) Тогда
		ТаблицаКодов.ЗаполнитьЗначения(Перечисление_РезультатыПроверкиКодовДокументов().Отключена, "ПроверкаВладельца");
		Возврат;
	КонецЕсли;
	
	Если ДокументУчета_ВидКорректировки(ДокументУчета) = Перечисление_ВидыКорректировкиДокумента().Возврат Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПроверятьКод", Истина);
	
	СтрокиДляПроверкиВладельца = ТаблицаКодов.НайтиСтроки(Отбор);
	
	Если Не ЗначениеЗаполнено(СтрокиДляПроверкиВладельца) Тогда
		Возврат;
	КонецЕсли;
	
	РезультатыПроверкиКодов = Перечисление_РезультатыПроверкиКодовДокументов();
	
	ИННОрганизации = ЗначениеРеквизитаОбъектаЛок(ДокументУчета.Организация, "ИНН");
	
	Для Каждого Стр Из СтрокиДляПроверкиВладельца Цикл
		
		Если Стр.ВладелецИНН <> ИННОрганизации Тогда
			Стр.ПроверкаВладельца = РезультатыПроверкиКодов.НеПринадлежитОрганизации;
		Иначе
			Стр.ПроверкаВладельца = РезультатыПроверкиКодов.Проверен;
		КонецЕсли;
		
	КонецЦикла;
	
	Функциональность = Перечисление_ФункциональностьМодуля().ПроверитьВладельцаКодовДокументаУчета;
	Метрика_Функциональность_ПроверитьКодыДокументаУчета(Функциональность, ДокументУчета.Организация);
	
КонецПроцедуры

Процедура ДокументУчета_ПроверитьРДКодов(ДокументУчета, ТаблицаКодов)
	
	ТипПроверкаРДКодов = Перечисление_ТипыПроверкиКодов().ПроверкаРДКодов;
	Если Не ДокументУчета_ВключенТипПроверкиКодов(ДокументУчета, ТипПроверкаРДКодов) Тогда
		ТаблицаКодов.ЗаполнитьЗначения(Перечисление_РезультатыПроверкиКодовДокументов().Отключена, "ПроверкаРД");
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПроверятьКод", Истина);
	Отбор.Вставить("ОбщийТипУпаковки");
	
	СтрокиДляПроверкиРД = Новый Массив;
	Для Каждого Элемент Из ОбщиеТипыУпаковокДляПроверкиРД() Цикл
		Отбор.ОбщийТипУпаковки = Элемент;
		ДополнитьМассив(СтрокиДляПроверкиРД, ТаблицаКодов.НайтиСтроки(Отбор));
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(СтрокиДляПроверкиРД) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусаПроверкиРДИРезультата = СоответствиеСтатусаПроверкиРДИРезультатаПроверкиКода();
	Для Каждого Стр Из СтрокиДляПроверкиРД Цикл
		Стр.ПроверкаРД = СтатусаПроверкиРДИРезультата.Получить(Стр.СтатусПроверкиРД);
	КонецЦикла;
	
	Функциональность = Перечисление_ФункциональностьМодуля().ПроверитьРДКодовДокументаУчета;
	Метрика_Функциональность_ПроверитьКодыДокументаУчета(Функциональность, ДокументУчета.Организация);
	
КонецПроцедуры

Процедура ДокументУчета_УстановитьСтатусРезультатаПроверкиКодовНеактуален(ДокументУчета) Экспорт
	
	СтатусыПроверкиКодов = Перечисление_СтатусыПроверкиКодовДокумента();
	ДопИнформацияСтатусов = Перечисление_ДопИнформацияСтатусовПроверкиКодовДокумента();
	
	СтатусыРезультатаПроверки = ДокументУчета_СтатусыРезультатаПроверкиКодов(ДокументУчета);
	
	Если Не ЗначениеЗаполнено(СтатусыРезультатаПроверки.РезультатПроверкиКодовДокумента)
		Или СтатусыРезультатаПроверки.РезультатПроверкиКодовДокумента = СтатусыПроверкиКодов.Неактуален Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыРезультатаПроверки.РезультатПроверкиКодовДокумента = СтатусыПроверкиКодов.Неактуален;
	СтатусыРезультатаПроверки.ДопИнформация_РезультатПроверкиКодовДокумента = 
	ДопИнформацияСтатусов.ПроверкаКодовНеактуальна;
	
	Для Каждого Элемент Из Перечисление_ТипыПроверкиКодов() Цикл
		
		Если ЗначениеЗаполнено(СтатусыРезультатаПроверки[Элемент.Ключ])
			И СтатусыРезультатаПроверки[Элемент.Ключ] <> СтатусыПроверкиКодов.Отключена Тогда
			СтатусыРезультатаПроверки[Элемент.Ключ] = СтатусыПроверкиКодов.Неактуален;
			СтатусыРезультатаПроверки[ИмяПоляДопИнформация(Элемент.Ключ)] = ДопИнформацияСтатусов.ПроверкаКодовНеактуальнаПерезапустить;
		КонецЕсли;
		
	КонецЦикла;
	
	СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыРезультатаПроверки);
	
КонецПроцедуры

Функция ДокументУчета_СтатусыРезультатаПроверкиКодов(ДокументУчета) Экспорт
	
	Результат = Новый_ДокументУчета_СтатусыПроверокКодов();
	СтатусыИБ = СтатусыДокументаУчета_Прочитать(ДокументУчета);
	ЗаполнитьЗначенияСвойств(Результат, СтатусыИБ);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_КлючиСтрокДокументаОСУ(ДокументУчета)

	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	
	Отбор = Новый Структура;
	Отбор.Вставить("НеПодлежитМаркировке", Ложь);
	Отбор.Вставить("ОтражениеВЭДО", Перечисления.КонтурМаркировка_ПравилаОтраженияВЭДО.ОСУ);
	
	Возврат ОписаниеДокумента.ТоварыДокумента.Скопировать(Отбор).ВыгрузитьКолонку("КлючСтрокиДокумента");
	
КонецФункции

Функция ДокументУчета_КлючиСтрокДокументаПартионныйУчет(ДокументУчета)

	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	
	Отбор = Новый Структура;
	Отбор.Вставить("НеПодлежитМаркировке", Ложь);
	Отбор.Вставить("ОтражениеВЭДО", Перечисления.КонтурМаркировка_ПравилаОтраженияВЭДО.ПартионныйУчет);
	
	Возврат ОписаниеДокумента.ТоварыДокумента.Скопировать(Отбор).ВыгрузитьКолонку("КлючСтрокиДокумента");
	
КонецФункции

Функция ДокументУчета_ЕстьОперации(ДокументУчета
	, ТипыОпераций = Неопределено
	, СтатусыОпераций = Неопределено
	, ОперацииОснования = Неопределено
	, БезОперацииОснования = Ложь) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА КАК ЕстьОперации
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Статусы
	|		ПО Операции.Ссылка = Статусы.Операция
	|			И (Статусы.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	НЕ Операции.ПометкаУдаления
	|	И Операции.ДокументУчета = &ДокументУчета
	|	И &ТипыОпераций
	|	И &СтатусыОпераций
	|	И &ОперацииОснования
	|	И &БезОперацииОснования";
	
	Если ЗначениеЗаполнено(ТипыОпераций) Тогда
		ТекстУсловия = "Операции.ТипОперации В(&ТипыОпераций)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипыОпераций", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипыОпераций", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтатусыОпераций) Тогда
		ТекстУсловия = "ЕСТЬNULL(Статусы.Статус, &НовыйСтатус) В(&СтатусыОпераций)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтатусыОпераций", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтатусыОпераций", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацииОснования) Тогда
		ТекстУсловия = "Операции.ОперацияОснование В(&ОперацииОснования)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОснования", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОснования", "ИСТИНА");
	КонецЕсли;
	
	Если БезОперацииОснования Тогда
		ТекстУсловия = "Операции.ОперацияОснование = ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Операции.ПустаяСсылка)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&БезОперацииОснования", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&БезОперацииОснования", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОсновнойСтатус", "ОсновнойСтатус");
	Запрос.УстановитьПараметр("НовыйСтатус", Перечисление_СтатусыОпераций().Новый);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ТипыОпераций", ТипыОпераций);
	Запрос.УстановитьПараметр("СтатусыОпераций", СтатусыОпераций);
	Запрос.УстановитьПараметр("ОперацииОснования", ОперацииОснования);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДокументУчета_СписокОпераций(ДокументУчета
	, ТипыОпераций = Неопределено
	, СтатусыОпераций = Неопределено
	, ОперацииОснования = Неопределено
	, БезОперацииОснования = Ложь) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Операции.Ссылка КАК Операция,
	|	Операции.ТипОперации КАК ТипОперации,
	|	ЕСТЬNULL(Статусы.Статус, &НовыйСтатус) КАК Статус
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Статусы
	|		ПО Операции.Ссылка = Статусы.Операция
	|			И (Статусы.ТипСтатуса = &ОсновнойСтатус)
	|ГДЕ
	|	НЕ Операции.ПометкаУдаления
	|	И Операции.ДокументУчета = &ДокументУчета
	|	И &ТипыОпераций
	|	И &СтатусыОпераций
	|	И &ОперацииОснования
	|	И &БезОперацииОснования
	|
	|УПОРЯДОЧИТЬ ПО
	|	Операции.Дата";
	
	Если ЗначениеЗаполнено(ТипыОпераций) Тогда
		ТекстУсловия = "Операции.ТипОперации В(&ТипыОпераций)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипыОпераций", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипыОпераций", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтатусыОпераций) Тогда
		ТекстУсловия = "ЕСТЬNULL(Статусы.Статус, &НовыйСтатус) В(&СтатусыОпераций)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтатусыОпераций", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтатусыОпераций", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОперацииОснования) Тогда
		ТекстУсловия = "Операции.ОперацияОснование В(&ОперацииОснования)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОснования", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОснования", "ИСТИНА");
	КонецЕсли;
	
	Если БезОперацииОснования Тогда
		ТекстУсловия = "Операции.ОперацияОснование = ЗНАЧЕНИЕ(Справочник.КонтурМаркировка_Операции.ПустаяСсылка)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&БезОперацииОснования", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&БезОперацииОснования", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОсновнойСтатус", "ОсновнойСтатус");
	Запрос.УстановитьПараметр("НовыйСтатус", Перечисление_СтатусыОпераций().Новый);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("ТипыОпераций", ТипыОпераций);
	Запрос.УстановитьПараметр("СтатусыОпераций", СтатусыОпераций);
	Запрос.УстановитьПараметр("ОперацииОснования", ОперацииОснования);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусыДокумента = СтатусыДокументаУчета_Прочитать(ДокументУчета);
	НовоеТребуемоеДействие = ДокументУчета_НовоеТребуемоеДействие(ДокументУчета);
	
	Если СтатусыДокумента.ТребуемоеДействие <> НовоеТребуемоеДействие Тогда
		СтатусыДокумента.ТребуемоеДействие = НовоеТребуемоеДействие;
		СтатусыДокументаУчета_Записать(ДокументУчета, СтатусыДокумента);
	КонецЕсли;
	
КонецПроцедуры

Функция ДокументУчета_НовоеТребуемоеДействие(ДокументИлиОписание, ОсновнойСтатус = Неопределено) Экспорт
	
	СтатусыДокументаУчета = Перечисление_СтатусыДокументовУчета();
	
	Если ТипЗнч(ДокументИлиОписание) = Тип("СправочникСсылка.КонтурМаркировка_ДокументыУчета") Тогда
		ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументИлиОписание);
	Иначе
		ОписаниеДокумента = ДокументИлиОписание;
	КонецЕсли;
	
	Если ОсновнойСтатус = Неопределено Тогда
		ОсновнойСтатус = ОписаниеДокумента.Статусы.ОсновнойСтатус;
	КонецЕсли;
	
	Если ОсновнойСтатус = СтатусыДокументаУчета.Новый Тогда
		Результат = ДокументУчета_НовоеТребуемоеДействие_ДляСтатусаНовый(ОписаниеДокумента);
	ИначеЕсли ОсновнойСтатус = СтатусыДокументаУчета.ВРаботе Тогда
		Результат = ДокументУчета_НовоеТребуемоеДействие_ДляСтатусаВРаботе(ОписаниеДокумента);
	Иначе
		Результат = Перечисление_ТребуемыеДействияДокументовУчета().РаботаЗавершена;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_НовоеТребуемоеДействие_ДляСтатусаНовый(ОписаниеДокумента)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	ДокументУчета = ОписаниеДокумента.Ссылка;
	
	Результат = ТребуемыеДействия.НачатьРаботу;
	
	Если Не ДокументУчета_ТоварыМаркировкиПодобраны(ДокументУчета) Тогда
		Результат = ТребуемыеДействия.ПодобратьТовары;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_НовоеТребуемоеДействие_ДляСтатусаВРаботе(ОписаниеДокумента)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействияДокументовУчета();
	
	ДокументУчета = ОписаниеДокумента.Ссылка;
	
	Если ДокументУчета_ЕстьОперацииСОшибками(ДокументУчета)
		Или ДокументУчета_ЕстьОшибкиТоваровМаркировки(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ИсправитьОшибку;
		
	ИначеЕсли ДокументУчета_ОжидаетНаполненияНаТСД(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ЗаполнитьНаТСД;
		
	ИначеЕсли Не ДокументУчета_ТоварыМаркировкиПодобраны(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ПодобратьТовары;
		
	ИначеЕсли ДокументУчета_ЭтапДопускаетДействие(ОписаниеДокумента, ТребуемыеДействия.НаполнитьКодами)
		И Не ДокументУчета_ЕстьКоды(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.НаполнитьКодами;
		
	ИначеЕсли ДокументУчета_ЭтапДопускаетДействие(ОписаниеДокумента, ТребуемыеДействия.НапечататьЭтикетки)
		И ДокументУчета_ЕстьКодыДляПечати(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.НапечататьЭтикетки;
		
	ИначеЕсли ДокументУчета_ЭтапДопускаетДействие(ОписаниеДокумента, ТребуемыеДействия.ОтчитатьсяОНанесении)
		И ДокументУчета_ЕстьКодыДляОтчетаОНанесении(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ОтчитатьсяОНанесении;
		
	ИначеЕсли ДокументУчета_ЭтапДопускаетДействие(ОписаниеДокумента, ТребуемыеДействия.ВвестиВОборот)
		И ДокументУчета_ЕстьКодыДляВводаВОборот(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ВвестиВОборот;
		
	ИначеЕсли ДокументУчета_ЭтапДопускаетДействие(ОписаниеДокумента, ТребуемыеДействия.ЗавершитьРаботу)
		И ДокументУчета_ВсеКодыВВеденыВОборот(ДокументУчета) Тогда
		
		Результат = ТребуемыеДействия.ЗавершитьРаботу;
		
	Иначе
		
		Результат = ТребуемыеДействия.ПродолжитьРаботу;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ЕстьКоды(ДокументУчета)
	
	ТипыФайлов = Перечисление_ТипыФайлов();
	
	Результат = Ложь;
	Если КодыДокументов_ЕстьКоды(ДокументУчета)
		Или ЗначениеЗаполнено(Файл_Найти(ДокументУчета, ТипыФайлов.КодыДокумента)) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ЕстьКодыДляПечати(ДокументУчета)
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьКодыДляПечати
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК КоличествоКодовДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КоличествоКодовДокументов.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КоличествоКодовДокументов.ДокументУчета = &ДокументУчета
	|	И ИнформацияОКодах.ЕстьПолныйКод
	|	И ИнформацияОКодах.ДляНанесения
	|	И ИнформацияОКодах.ДатаПечати = ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДокументУчета_ЕстьКодыДляВводаВОборот(ДокументУчета)
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СУММА(Т.КоличествоКодов) КАК КоличествоКодов
	|ИЗ
	|	(ВЫБРАТЬ
	|		КоличествоКодовДокументов.КоличествоКодов КАК КоличествоКодов
	|	ИЗ
	|		РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК КоличествоКодовДокументов
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|			ПО КоличествоКодовДокументов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода
	|	ГДЕ
	|		КоличествоКодовДокументов.ДокументУчета = &ДокументУчета
	|		И СтатусыКодов.Статус = &СтатусКодаНанесен
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		-КоличествоКодовОпераций.КоличествоКодов
	|	ИЗ
	|		Справочник.КонтурМаркировка_Операции КАК Операции
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК ОсновнойСтатусОпераций
	|			ПО Операции.Ссылка = ОсновнойСтатусОпераций.Операция
	|				И (ОсновнойСтатусОпераций.ТипСтатуса = &ОсновнойСтатус)
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций КАК КоличествоКодовОпераций
	|			ПО Операции.Ссылка = КоличествоКодовОпераций.Операция
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|			ПО (КоличествоКодовОпераций.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|	ГДЕ
	|		Операции.ТипОперации = &ТипОперацииВводВОборот
	|		И Операции.ДокументУчета = &ДокументУчета
	|		И ОсновнойСтатусОпераций.Статус <> &СтатусОперацииНовый
	|		И СтатусыКодов.Статус = &СтатусКодаНанесен) КАК Т
	|
	|ИМЕЮЩИЕ
	|	СУММА(Т.КоличествоКодов) > 0";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("СтатусКодаНанесен", СтатусыКодов.Нанесен);
	Запрос.УстановитьПараметр("СтатусОперацииНовый", СтатусыОпераций.Новый);
	Запрос.УстановитьПараметр("ТипОперацииВводВОборот", ТипыОпераций.ВводВОборот);
	Запрос.УстановитьПараметр("ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДокументУчета_ЕстьКодыДляОтчетаОНанесении(ДокументУчета)
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	ПодходящиеТипыОпераций = Новый Массив;
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ОтчетОНанесении);
	ПодходящиеТипыОпераций.Добавить(ТипыОпераций.ОтчетОНанесенииНаТСД);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СУММА(Т.КоличествоКодов) КАК КоличествоКодов
	|ИЗ
	|	(ВЫБРАТЬ
	|		КоличествоКодовДокументов.КоличествоКодов КАК КоличествоКодов
	|	ИЗ
	|		РегистрСведений.КонтурМаркировка_КоличествоКодовДокументов КАК КоличествоКодовДокументов
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|			ПО КоличествоКодовДокументов.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода
	|	ГДЕ
	|		КоличествоКодовДокументов.ДокументУчета = &ДокументУчета
	|		И СтатусыКодов.Статус = &СтатусКодаВыпущен
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		-КоличествоКодовОпераций.КоличествоКодов
	|	ИЗ
	|		Справочник.КонтурМаркировка_Операции КАК Операции
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК ОсновнойСтатусОпераций
	|			ПО Операции.Ссылка = ОсновнойСтатусОпераций.Операция
	|				И (ОсновнойСтатусОпераций.ТипСтатуса = &ОсновнойСтатус)
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций КАК КоличествоКодовОпераций
	|			ПО Операции.Ссылка = КоличествоКодовОпераций.Операция
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|			ПО (КоличествоКодовОпераций.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|	ГДЕ
	|		Операции.ТипОперации В(&ПодходящиеТипыОпераций)
	|		И Операции.ДокументУчета = &ДокументУчета
	|		И ОсновнойСтатусОпераций.Статус <> &СтатусОперацииНовый
	|		И СтатусыКодов.Статус = &СтатусКодаВыпущен) КАК Т
	|
	|ИМЕЮЩИЕ
	|	СУММА(Т.КоличествоКодов) > 0");
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("СтатусКодаВыпущен", СтатусыКодов.Выпущен);
	Запрос.УстановитьПараметр("СтатусОперацииНовый", СтатусыОпераций.Новый);
	Запрос.УстановитьПараметр("ПодходящиеТипыОпераций", ПодходящиеТипыОпераций);
	Запрос.УстановитьПараметр("ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ДокументУчета_ВсеКодыВВеденыВОборот(ДокументУчета)
	
	СтатусыКодовДокумента = КодыДокументов_КоличествоКодовПоСтатусам(ДокументУчета);
	Если СтатусыКодовДокумента.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Результат = СтатусыКодовДокумента.Найти("", "СтатусКодов") = Неопределено
	И СтатусыКодовДокумента.Найти(СтатусыКодов.НеНайден, "СтатусКодов") = Неопределено
	И СтатусыКодовДокумента.Найти(СтатусыКодов.Выпущен, "СтатусКодов") = Неопределено
	И СтатусыКодовДокумента.Найти(СтатусыКодов.Нанесен, "СтатусКодов") = Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ЕстьОперацииСОшибками(ДокументУчета)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	ПодходящиеТипы = ТипыИнтерактивныхОпераций();
	
	ПодходящиеСтатусы = Новый Массив;
	ПодходящиеСтатусы.Добавить(СтатусыОпераций.ОшибкаОбработки);
	
	Возврат ДокументУчета_ЕстьОперации(ДокументУчета, ПодходящиеТипы, ПодходящиеСтатусы);
	
КонецФункции

Функция ДокументУчета_ТоварыМаркировкиПодобраны(ДокументУчета)
	
	Результат = Истина;
	
	Отбор = Новый Структура("КлючСтрокиДокумента");
	Для Каждого СтрДок Из ДокументУчета.ТоварыДокумента Цикл
		
		Если СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоПодобрано = 0;
		Отбор.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		Для Каждого СтрТов Из ДокументУчета.ТоварыМаркировки.НайтиСтроки(Отбор) Цикл
			КоличествоПодобрано = КоличествоПодобрано + СтрТов.КоличествоУпаковок;
		КонецЦикла;
		
		Если СтрДок.КоличествоУпаковок <> КоличествоПодобрано Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ПроверитьТоварыМаркировки(ОписаниеДокумента)
	
	Возврат МодульКонтроль().ДокументУчета_ПроверитьТоварыМаркировки(ОписаниеДокумента);
	
КонецФункции

Функция ДокументУчета_ЕстьОшибкиТоваровМаркировки(ДокументУчета)
	
	ОписаниеДокумента = ДокументУчета_ПрочитатьДокумент(ДокументУчета);
	Ошибки = ДокументУчета_ПроверитьТоварыМаркировки(ОписаниеДокумента);
	
	Возврат ЗначениеЗаполнено(Ошибки);
	
КонецФункции

Функция ДокументУчета_ОжидаетНаполненияНаТСД(ДокументУчета)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	ПодходящиеТипы = Новый Массив;
	ПодходящиеТипы.Добавить(ТипыОпераций.ПодборКодовНаТСД);
	ПодходящиеТипы.Добавить(ТипыОпераций.ПодборТоваровИКодовНаТСД);
	
	ПодходящиеСтатусы = Новый Массив;
	ПодходящиеСтатусы.Добавить(СтатусыОпераций.ОтправленВСервис);
	
	Возврат ДокументУчета_ЕстьОперации(ДокументУчета, ПодходящиеТипы, ПодходящиеСтатусы);
	
КонецФункции

Функция ДокументУчета_ОсновнойСтатус(ДокументУчета) Экспорт
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		Результат = ДокументУчета_Статусы(ДокументУчета).ОсновнойСтатус;
	Иначе
		Результат = Перечисление_СтатусыДокументовУчета().Новый;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_Статусы(ДокументУчета) Экспорт
	
	Результат = Новый_ДокументУчета_Статусы();
	СтатусыИБ = СтатусыДокументаУчета_Прочитать(ДокументУчета);
	ЗаполнитьЗначенияСвойств(Результат, СтатусыИБ);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_НастройкаДокумента(ДокументУчета)
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ТипДокумента = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "ТипДокумента");
	НастройкаДокумента = НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента);
	ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(НастройкаДокумента);
	
	Возврат ОписаниеНастройки;
	
КонецФункции

Функция ДокументУчета_ВключенТипПроверкиКодов(ДокументУчета, ТипПроверкиКодов) Экспорт

	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипДокумента = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "ТипДокумента");
	Результат = ДокументУчета_ТипуДокументаВключенТипПроверкиКодов(ТипДокумента, ТипПроверкиКодов);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ТипуДокументаВключенТипПроверкиКодов(ТипДокумента, ТипПроверкиКодов)
	
	НастройкаДокумента = НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента);
	ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(НастройкаДокумента);
	
	Возврат МассивСодержитЗначение(ОписаниеНастройки.ПроверкиКодовДокумента, ТипПроверкиКодов);
	
КонецФункции

// Проверяет доступна ли указанная роль документу учета 
//
// Параметры:
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//  Роль - Строка - см. Перечисление_РолиДокументовУчета();
// 
// Возвращаемое значение:
//  Булево - Истина, если роль доступна
//
Функция ДокументУчета_ДоступнаРоль(ДокументУчета, Роль) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипДокумента = ЗначениеРеквизитаОбъектаЛок(ДокументУчета, "ТипДокумента");
	Результат = ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, Роль);
	
	Возврат Результат;
	
КонецФункции

// Проверяет доступна ли указанная роль типу документа 
//
// Параметры:
//  ТипДокумента - Строка - имя документа 1С;
//  Роль - Строка - см. функцию Перечисление_РолиДокументовУчета();
// 
// Возвращаемое значение:
//  Булево - Истина, если роль доступна
//
Функция ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, Роль) Экспорт
	
	КлючКэш = "ТипуДокументаДоступнаРоль: " + ТипДокумента + ", " + Роль;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	НастройкаДокумента = НастройкиДокументовУчета_НайтиПоТипуДокумента(ТипДокумента);
	ОписаниеНастройки = НастройкиДокументаУчета_Прочитать(НастройкаДокумента);
	Результат = МассивСодержитЗначение(ОписаниеНастройки.РолиДокумента, Роль);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ТипуДокументаДоступнаРольОтраженияВЭДО(ТипДокумента)
	
	КлючКэш = "ТипуДокументаДоступнаРольОтраженияВЭДО: " + ТипДокумента;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	РолиДокументов = Перечисление_РолиДокументовУчета();
	
	ПодходящиеРоли = Новый Массив;
	ПодходящиеРоли.Добавить(РолиДокументов.Отгрузка);
	ПодходящиеРоли.Добавить(РолиДокументов.КорректировкаОтгрузки);
	ПодходящиеРоли.Добавить(РолиДокументов.ВнутреннееПеремещение);
	
	Результат = Ложь;
	Для Каждого Роль Из ПодходящиеРоли Цикл
		Если ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, Роль) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ИсходныйИсправляемыйДокументУчета(ДокументУчета, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ДокументУчета];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	ВидыКорректировки = Перечисление_ВидыКорректировкиДокумента();
	
	ВидКорректировки = ДокументУчета_ВидКорректировки(ДокументУчета);
	ИсправляемыйДокумент = ДокументУчета_ИсправляемыйДокумент(ДокументУчета);
	ИсправляемыйДокументУчета = ДокументУчета_НайтиПоДокументу1С(ИсправляемыйДокумент);
	ВидКорректировкиИсправляемогоДокумента = ДокументУчета_ВидКорректировки(ИсправляемыйДокументУчета);
	
	Если ВидКорректировки = ВидыКорректировки.Исправление
		И ЗначениеЗаполнено(ВидКорректировкиИсправляемогоДокумента) Тогда
		ИсправляемыйДокумент = ДокументУчета_ИсправляемыйДокумент(ИсправляемыйДокументУчета);
		ИсправляемыйДокументУчета = ДокументУчета_НайтиПоДокументу1С(ИсправляемыйДокумент);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(ДокументУчета, ИсправляемыйДокументУчета);
	КонецЕсли;
	
	Возврат ИсправляемыйДокументУчета;
	
КонецФункции

Функция ДокументУчета_ВидКорректировки(ДокументУчета) Экспорт
	
	Возврат ДопРеквизит_Прочитать(ДокументУчета, Перечисление_ИменаДопРеквизитов().ВидКорректировки);
	
КонецФункции

Функция ДокументУчета_ИсправляемыйДокумент(ДокументУчета) Экспорт
	
	Возврат ДопРеквизит_Прочитать(ДокументУчета, Перечисление_ИменаДопРеквизитов().ИсправляемыйДокумент);
	
КонецФункции

Функция ДокументУчета_ЭтапДопускаетДействие(ОписаниеДокумента, ТребуемоеДействие)
	
	Если Не ЗначениеЗаполнено(ОписаниеДокумента.МаршрутМаркировки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТребуемоеДействие", ТребуемоеДействие);
	ПараметрыОтбора.Вставить("Пропущен", Ложь);
	
