Функция Контент_ПодборКодовНаТСД(ОписаниеОперации)
	
	Операция = ОписаниеОперации.Ссылка;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ИспользоватьМобУстройство = ДопРеквизиты.ПодборСПомощьюМобильногоУстройства;
	МобильноеУстройство = ДопРеквизиты.МобильноеУстройство;
	
	Результат = Новый Структура;
	Результат.Вставить("section", "Enrichment");
	Результат.Вставить("counteragentName", ДопРеквизиты.КонтрагентНаименование);
	Результат.Вставить("counteragentInn", ДопРеквизиты.КонтрагентИНН);
	Результат.Вставить("counteragentKpp", ДопРеквизиты.КонтрагентКПП);
	Результат.Вставить("documentNumber", ДопРеквизиты.НомерДокумента);
	Результат.Вставить("documentDate", ДопРеквизиты.ДатаДокумента);
	
	Результат.Вставить("checkCodesTtis", ОписаниеОперации.ДопРеквизиты.ПроверятьКодыПриСканировании);
	
	Если ИспользоватьМобУстройство И ЗначениеЗаполнено(МобильноеУстройство) Тогда
		Результат.Вставить("mobileTsd", МобильныеУстройства_МассивId(МобильноеУстройство));
		counteragentInfo = Новый Структура;
		ДобавитьЗаполненноеЗначениеВСтруктуру(counteragentInfo, "address", ДопРеквизиты.АдресДоставки);
		ДобавитьЗаполненноеЗначениеВСтруктуру(counteragentInfo, "phone", ДопРеквизиты.КонтактныйТелефон);
		Результат.Вставить("counteragentAdditionalInfo", counteragentInfo);
	КонецЕсли;
	
	ВзятьНаименованиеИзТовара = ОднаСтрокаДокументаСодержитНесколькоТоваровМаркировки(ОписаниеОперации.Товары);
	
	positions = Новый Массив;
	Для Каждого Стр ИЗ ОписаниеОперации.Товары Цикл
		
		position = Новый Структура;
		position.Вставить("number", Стр.НомерСтроки);
		position.Вставить("quantity", Стр.КоличествоУпаковок);
		position.Вставить("name", НаименованиеПозицииДляКонтента(Стр, ВзятьНаименованиеИзТовара));
		
		Если ЗначениеЗаполнено(Стр.Товар) Тогда
			position.Вставить("gtin", Стр.Товар.GTIN);
		КонецЕсли;
		
		positions.Добавить(position);
		
	КонецЦикла;
	
	Результат.Вставить("positions", positions);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ОтчетОНанесенииНаТСД(ОписаниеОперации)
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	Результат = Новый Структура;
	Результат.Вставить("section", "UtilisationReport");
	Результат.Вставить("documentNumber", ОписаниеОперации.Номер);
	Результат.Вставить("documentDate", ОписаниеОперации.Дата);
	
	positions = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		ДатаСрокаГодности = Стр.ДатаСрокаГодности;
		Наименование = НаименованиеПозицииДляКонтента(Стр);
		
		Если ЗначениеЗаполнено(Стр.Количество) Тогда
			СтрокаОбъем = ПараметрыВСтроку(НСтр("ru = 'объем %1'"), Стр.Количество);
			Наименование = Наименование + ", " + СтрокаОбъем;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаСрокаГодности) Тогда
			СтрокаГоденДо = ПараметрыВСтроку(НСтр("ru = 'годен до %1'"), Формат(ДатаСрокаГодности, "ДФ=dd.MM.yyyy"));
			Наименование = Наименование + ", " + СтрокаГоденДо;
		КонецЕсли;
		
		position = Новый Структура;
		position.Вставить("name"	, Наименование);
		position.Вставить("number"	, Стр.НомерСтроки);
		position.Вставить("quantity", Стр.КоличествоУпаковок);
		position.Вставить("gtin"	, Стр.Товар.GTIN);
		positions.Добавить(position);
		
	КонецЦикла;
	
	Результат.Вставить("positions", positions);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ОтчетОНанесении(ОписаниеОперации)
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	ТипыСроковГодности = Перечисление_ТипыСроковГодности();
	ТипыОтчетаОНанесении = Перечисление_ТипыОтчетаОНанесении();
	
	Операция = ОписаниеОперации.Ссылка;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	ДопРеквизиты = ОписаниеОснования.ДопРеквизиты;
	
	КлючКода = ДопРеквизиты.КлючКода;
	Площадка = ДопРеквизиты.Площадка;
	Организация = ОписаниеОснования.Организация;
	ВидПродукции = ОписаниеОснования.ВидПродукции;
	ТипИспользования = ДопРеквизиты.ТипИспользования;
	ТипСрокаГодности = ДопРеквизиты.ТипСрокаГодности;
	ТипОтчетаОНанесении = ДопРеквизиты.ТипОтчетаОНанесении;
	ИспользоватьНоминальноеКоличество = ДопРеквизиты.ИспользоватьНоминальноеКоличество;
	НомерДокумента = ЗначениеРеквизитаОбъектаЛок(ОписаниеОперации.ОперацияОснование, "Код");
	
	Стр = ОписаниеОснования.Товары.Найти(КлючСтрокиОперации, "КлючСтрокиОперации");
	ОписаниеТовара = Товар_Прочитать(Стр.Товар);
	ТипКодаМаркировки = ОписаниеТовара.ТипКодаМаркировки;
	НоминальноеКоличество = ОписаниеТовара.ДопРеквизиты.НоминальноеКоличество;
	ТребуетсяЗСН = ОписаниеТовара.ДопРеквизиты.ИспользоватьЗаводскойСН;
	ПеременноеКоличество = ОписаниеТовара.ПеременныйВес;
	ПеременнаяХарактеристика = ОписаниеТовара.ДопРеквизиты.ПеременнаяХарактеристика;
	ДатаСрокаГодности = Стр.ДатаСрокаГодности;
	
	НомерПервичногоДокумента = ДопРеквизиты.НомерДокумента;
	Если ЗначениеЗаполнено(Стр.НомерДокумента) Тогда
		НомерПервичногоДокумента = Стр.НомерДокумента;
	КонецЕсли;
	
	ДатаПервичногоДокумента = ДопРеквизиты.ДатаДокумента;
	Если ЗначениеЗаполнено(Стр.ДатаДокумента) Тогда
		ДатаПервичногоДокумента = Стр.ДатаДокумента;
	КонецЕсли;
	
	ДатаПроизводства = ДопРеквизиты.ДатаПроизводства;
	Если ЗначениеЗаполнено(Стр.ДатаПроизводства) Тогда
		ДатаПроизводства = Стр.ДатаПроизводства;
	КонецЕсли;
	
	НомерПартии = ДопРеквизиты.НомерПартии;
	Если ЗначениеЗаполнено(Стр.НомерПартии) Тогда
		НомерПартии = Стр.НомерПартии;
	КонецЕсли;
	
	НомерСерии = ДопРеквизиты.НомерСерии;
	Если ЗначениеЗаполнено(Стр.НомерСерии) Тогда
		НомерСерии = Стр.НомерСерии;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("usageType", ТипИспользованияВСервисе(ТипИспользования));
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	Результат.Вставить("positionName", НаименованиеПозицииДляКонтента(Стр));
	Результат.Вставить("utilisationType", ТипОтчетаОНанесенииВСервисе(ТипОтчетаОНанесении));
	
	Если ТипСрокаГодности = ТипыСроковГодности.СрокГодностиБольше72СУсловием Тогда
		Если ЗначениеЗаполнено(Стр.АльтернативныеСрокиГодности) Тогда
			Результат.Вставить("expirationDateConditions", УсловияИстеченияСроковГодности(Стр.АльтернативныеСрокиГодности));
			Результат.Вставить("expirationType", ТипСрокаГодностиВСервисе(ТипСрокаГодности, ВидПродукции));
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ДатаСрокаГодности) Тогда
			Результат.Вставить("expirationDate", ЛокальнаяДатаСоСмещениемXML(ДатаСрокаГодности));
			Результат.Вставить("expirationType", ТипСрокаГодностиВСервисе(ТипСрокаГодности, ВидПродукции));
		КонецЕсли;
	КонецЕсли;
	
	УказыватьДатуПроизводства = ВидПродукцииДопускаетДатуПроизводстваВОтчетеОНанесении(ВидПродукции, ТипОтчетаОНанесении);
	Если ТипКодаМаркировки = ТипыКодовМаркировки.Набор
		Или ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка Тогда
		УказыватьДатуПроизводства = ВидПродукцииДопускаетДатуПроизводстваВОтчетеОНанесенииДляКИНКИГУ(ВидПродукции, ТипОтчетаОНанесении);
	КонецЕсли;
	
	Если УказыватьДатуПроизводства Тогда
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "productionDate", ЛокальнаяДатаСоСмещениемXML(НачалоДня(ДатаПроизводства)));
	КонецЕсли;
	
	УказыватьНомерПартии = (ВидПродукцииДопускаетНомерПартииВОтчетеОНанесении(ВидПродукции) 
		И ТипКодаМаркировкиДопускаетУказаниеНомераПартииВОтчетеОНанесении(ТипКодаМаркировки));
	Если УказыватьНомерПартии Тогда
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "batchNumber", НомерПартии);
	КонецЕсли;
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "seriesNumber", НомерСерии);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentNumber", НомерДокумента);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОснования.Комментарий);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentNumber", НомерДокумента);
	
	Если ВидПродукции = ВидыПродукции.Молоко
		Или ВидПродукции = ВидыПродукции.Морепродукты Тогда
		Результат.Вставить("cisType", ТипПотребительскойУпаковкиВСервисе(ТипКодаМаркировки));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Площадка) И ВидПродукцииДопускаетПлощадкуВОтчетеОНанесении(ВидПродукции, ТипОтчетаОНанесении) Тогда
		Если ВидПродукции = ВидыПродукции.Бады Тогда
			ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "vetisGuid", Площадка.ИдентификаторВЕТИС);
		Иначе
			ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "fiasId", Площадка.ИдентификаторФИАС);
			Если Не ЭтоИП(Организация.ИНН) Тогда
				Результат.Вставить("kpp", Площадка.КПП);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ВидПродукцииДопускаетУказаниеФактическогоСодержанияСпирта(ВидПродукции, ТипОтчетаОНанесении) Тогда
		Результат.Вставить("alcoholVolume", Стр.СодержаниеСпирта);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерПервичногоДокумента) И ЗначениеЗаполнено(ДатаПервичногоДокумента) Тогда
		
		primaryDocument = Новый Структура;
		primaryDocument.Вставить("number", НомерПервичногоДокумента);
		primaryDocument.Вставить("date", Формат(ДатаПервичногоДокумента, "ДФ='yyyy-MM-dd'"));
		
		Результат.Вставить("primaryDocument", primaryDocument);
		
	КонецЕсли;
	
	ИспользованоФактическоеКоличество = Ложь;
	ИспользованоНоминальноеКоличество = Ложь;
	
	ТаблицаКодов = КодыОпераций_ПолныеКоды(ОперацияОснование, Стр.КлючСтрокиОперации);
	
	Если ПеременноеКоличество И ВидПродукцииПоддерживаетКоличествоВСтруктуреКодаОтчетаОНанесении(ВидПродукции, ТипОтчетаОНанесении) Тогда
		Для Каждого Стр Из ТаблицаКодов Цикл
			Если ЗначениеЗаполнено(Стр.Количество) Тогда
				Количество = Стр.Количество;
				ИспользованоФактическоеКоличество = Истина;
			ИначеЕсли ИспользоватьНоминальноеКоличество Тогда
				Количество = НоминальноеКоличество;
				ИспользованоНоминальноеКоличество = Истина;
			Иначе
				Количество = 0;
			КонецЕсли;
			Если ЗначениеЗаполнено(Количество)
				И Не ПолныйКодСодержитПеременнуюХарактеристику(Стр.ПолныйКод, ПеременнаяХарактеристика) Тогда
				Стр.ПолныйКод = ДобавитьПеременнуюХарактеристикуВПолныйКод(Стр.ПолныйКод, Количество, ПеременнаяХарактеристика);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ВидПродукцииДопускаетУказаниеТипаОтчетаОНанесении(ВидПродукции) Тогда
		Если ТипОтчетаОНанесении = ТипыОтчетаОНанесении.РасформированиеНабора Тогда
			ДобавитьСтарыеКодыМаркировкиВНовыеПолныеКодыРасформированияНабора(ТаблицаКодов, КлючКода);
		КонецЕсли;
		Если ТипОтчетаОНанесении = ТипыОтчетаОНанесении.РазделениеТовара Тогда
			ДобавитьОсновнойПолныйКодВПолныеКодыРазделенияТовара(ТаблицаКодов, КлючКода);
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуетсяЗСН Тогда
		Для Каждого Стр Из ТаблицаКодов Цикл
			Если ЗначениеЗаполнено(Стр.ЗаводскойСерийныйНомер) Тогда
				Стр.ПолныйКод = ДобавитьЗаводскойСерийныйНомерВПолныйКод(Стр.ПолныйКод, Стр.ЗаводскойСерийныйНомер);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат.Вставить("codes", ТаблицаКодов.ВыгрузитьКолонку("ПолныйКод"));
	
	Функциональность = Перечисление_ФункциональностьМодуля();
	Если ИспользованоФактическоеКоличество Тогда
		СтекМетрик_ДобавитьФункциональность(Функциональность.ОтчетОНанесенииСФактическимКоличеством, Организация);
	КонецЕсли;
	Если ИспользованоНоминальноеКоличество Тогда
		СтекМетрик_ДобавитьФункциональность(Функциональность.ОтчетОНанесенииСНоминальнымКоличеством, Организация);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_Отгрузка(ОписаниеОперации)
	
	ОбъемноСортовойУчет = ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет;
	
	Если ОбъемноСортовойУчет Тогда
		Результат = Контент_Отгрузка_ОбъемноСортовойУчет(ОписаниеОперации);
	Иначе
		Результат = Контент_Отгрузка_ПоэкземплярныйУчет(ОписаниеОперации);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_Отгрузка_ПоэкземплярныйУчет(ОписаниеОперации)
	
	ТипыОтгрузок = Перечисление_ТипыОтгрузок();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборотаПриОтгрузке();
	
	Операция = ОписаниеОперации.Ссылка;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипОтгрузки = ДопРеквизиты.ТипОтгрузки;
	ПричинаВыводаИзОборота = ДопРеквизиты.ПричинаВыводаИзОборота;
	
	Результат = Новый Структура;
	Результат.Вставить("receiverInn", ДопРеквизиты.ИННПолучателя);
	Результат.Вставить("transferDate", ДопРеквизиты.ДатаОтгрузки);
	Результат.Вставить("primaryDocumentNumber", ДопРеквизиты.НомерДокумента);
	Результат.Вставить("primaryDocumentDate", ДопРеквизиты.ДатаДокумента);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОперации.Комментарий);
	
	Если ТипОтгрузки = ТипыОтгрузок.ТрансграничнаяТорговля Тогда
		
		Результат.Вставить("receiverGln", ДопРеквизиты.GLNПолучателя);
		Результат.Вставить("receiverCountryCode" , ДопРеквизиты.КодСтраныПолучателя);
		
	ИначеЕсли ТипОтгрузки = ТипыОтгрузок.ОтгрузкаСВыводомИзОборота Тогда
		
		Результат.Вставить("withdrawnReason", ПричинаВыводаИзОборотаПриОтгрузкеВСервисе(ПричинаВыводаИзОборота));
		Результат.Вставить("withdrawnDate" , ДопРеквизиты.ДатаВыводаИзОборота);
		
		Если ПричинаВыводаИзОборота = ПричиныВывода.ПриобретениеГосПредприятием Тогда
			Результат.Вставить("governmentContractNumber", ДопРеквизиты.ИдентификаторГосКонтракта);
		КонецЕсли;
		
	Иначе
		ШаблонОшибки = НСтр("ru = 'Неизвестный тип отгрузки: %1'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, ТипОтгрузки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	positions = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		position = Новый Структура;
		position.Вставить("name", НаименованиеПозицииДляКонтента(Стр));
		position.Вставить("codes", КодыОпераций_КодыМаркировки(Операция, Стр.КлючСтрокиОперации, Ложь));
		positions.Добавить(position);
	КонецЦикла;
	Результат.Вставить("positions", positions);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_Отгрузка_ОбъемноСортовойУчет(ОписаниеОперации)
	
	ТипыОтгрузок = Перечисление_ТипыОтгрузок();
	
	Организация = ОписаниеОперации.Организация;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипОтгрузки = ДопРеквизиты.ТипОтгрузки;
	
	Результат = Новый Структура;
	Результат.Вставить("exporterInn", Организация.ИНН);
	Результат.Вставить("receiverInn", ДопРеквизиты.ИННПолучателя);
	Результат.Вставить("transferDate", ДопРеквизиты.ДатаОтгрузки);
	Результат.Вставить("primaryDocumentNumber", ДопРеквизиты.НомерДокумента);
	Результат.Вставить("primaryDocumentDate", ДопРеквизиты.ДатаДокумента);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОперации.Комментарий);
	
	Если ТипОтгрузки = ТипыОтгрузок.ТрансграничнаяТорговля Тогда
		Результат.Вставить("receiverGln", ДопРеквизиты.GLNПолучателя);
		Результат.Вставить("receiverName", ДопРеквизиты.НаименованиеПолучателя);
		Результат.Вставить("receiverCountryCode", ДопРеквизиты.КодСтраныПолучателя);
	Иначе
		ШаблонОшибки = НСтр("ru = 'Некорректный тип отгрузки по ОСУ: %1'");
		ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, ТипОтгрузки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	positions = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		position = Новый Структура;
		position.Вставить("gtin", Стр.Товар.GTIN);
		position.Вставить("codesQuantity", Стр.КоличествоУпаковок);
		positions.Добавить(position);
	КонецЦикла;
	Результат.Вставить("positions", positions);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВыводИзОборота(ОписаниеОперации)
	
	ОбъемноСортовойУчет = ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет;
	
	Если ОбъемноСортовойУчет Тогда
		Результат = Контент_ВыводИзОборота_ОбъемноСортовойУчет(ОписаниеОперации);
	Иначе
		Результат = Контент_ВыводИзОборота_ПоэкземплярныйУчет(ОписаниеОперации);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВыводИзОборота_ПоэкземплярныйУчет(ОписаниеОперации)
	
	ВидыДокументов = Перечисление_ВидыПервичныхДокументов();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	Операция = ОписаниеОперации.Ссылка;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ПричинаВыводаИзОборота = ДопРеквизиты.ПричинаВыводаИзОборота;
	ВидПервичногоДокумента = ДопРеквизиты.ВидПервичногоДокумента;
	Площадка = ДопРеквизиты.Площадка;
	
	Результат = Новый Структура;
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ОписаниеОперации.ВидПродукции));
	Результат.Вставить("actionType", ПричинаВыводаИзОборотаВСервисе(ПричинаВыводаИзОборота));
	
	Если ПричинаВыводаИзОборота <> ПричиныВывода.ЭкспортЕАЭС
		И ПричинаВыводаИзОборота <> ПричиныВывода.ПродажаПоГосКонтракту Тогда
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentDate", ДопРеквизиты.ДатаДокумента);
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentNumber", ДопРеквизиты.НомерДокумента);
		Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
			Результат.Вставить("documentType", ТипПервичногоДокументаВСервисе(ВидПервичногоДокумента));
		КонецЕсли;
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.БезвозмезднаяПередача Тогда
		Результат.Вставить("buyerInn", ДопРеквизиты.ИННПолучателя);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ДляСобственныхНужд
		Или ПричинаВыводаИзОборота = ПричиныВывода.ДляПроизводственныхЦелей Тогда
		Если ЗначениеЗаполнено(ДопРеквизиты.ИННПолучателя) Тогда
			Результат.Вставить("buyerInn", ДопРеквизиты.ИННПолучателя);
		КонецЕсли;
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЕАЭС Тогда
		Результат.Вставить("ImporterId", ДопРеквизиты.ИННПолучателя);
		Результат.Вставить("DestinationCountryCode", ДопРеквизиты.КодСтраныПолучателя);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоГосКонтракту
			Или ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоСделкеСГосударственнойТайной Тогда
		Результат.Вставить("stateContractId", ДопРеквизиты.ИдентификаторГосКонтракта);
	КонецЕсли;
	
	Если ВидПервичногоДокумента = ВидыДокументов.Прочее Тогда
		Результат.Вставить("customDocumentName", ДопРеквизиты.НаименованиеПервичногоДокумента);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.Прочее Тогда
		Результат.Вставить("customActionName", ДопРеквизиты.НаименованиеПричиныВыводаИзОборота);
	КонецЕсли;
	
	МожноУказатьЦену = Операция_ВыводИзОборота_МожноУказатьЦену(ПричинаВыводаИзОборота);
	
	Если ЗначениеЗаполнено(Площадка) Тогда
		
		modInfo = Новый Структура;
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(modInfo, "fiasId", Площадка.ИдентификаторФИАС);
		ДобавитьЗаполненноеЗначениеВСтруктуру(modInfo, "kpp", Площадка.КПП);
		
		Результат.Вставить("modInfo", modInfo);
		
	КонецЕсли;
	
	products = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		product = Новый Структура;
		product.Вставить("name", НаименованиеПозицииДляКонтента(Стр));
		product.Вставить("kiCodes", КодыОпераций_КодыМаркировки(Операция, Стр.КлючСтрокиОперации, Ложь));
		
		Если МожноУказатьЦену И ЗначениеЗаполнено(Стр.Цена) Тогда
			ЦенаВКопейках = РублиВКопейки(Стр.Цена);
			product.Вставить("cost", ЦенаВКопейках);
		КонецЕсли;
		
		products.Добавить(product);
		
	КонецЦикла;
	
	Результат.Вставить("products", products);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВыводИзОборота_ОбъемноСортовойУчет(ОписаниеОперации)
	
	ВидыДокументов = Перечисление_ВидыПервичныхДокументов();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ПричинаВыводаИзОборота = ДопРеквизиты.ПричинаВыводаИзОборота;
	ВидПервичногоДокумента = ДопРеквизиты.ВидПервичногоДокумента;
	
	Результат = Новый Структура;
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ОписаниеОперации.ВидПродукции));
	Результат.Вставить("actionType", ПричинаВыводаИзОборотаВСервисе(ПричинаВыводаИзОборота));
	
	Если ПричинаВыводаИзОборота <> ПричиныВывода.ЭкспортЕАЭС
		И ПричинаВыводаИзОборота <> ПричиныВывода.ПродажаПоГосКонтракту Тогда
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentDate", ДопРеквизиты.ДатаДокумента);
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "documentNumber", ДопРеквизиты.НомерДокумента);
		
		Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
			Результат.Вставить("documentType", ТипПервичногоДокументаВСервисе(ВидПервичногоДокумента));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.БезвозмезднаяПередача Тогда
		Результат.Вставить("buyerInn", ДопРеквизиты.ИННПолучателя);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ДляСобственныхНужд
		Или ПричинаВыводаИзОборота = ПричиныВывода.ДляПроизводственныхЦелей Тогда
		Если ЗначениеЗаполнено(ДопРеквизиты.ИННПолучателя) Тогда
			Результат.Вставить("buyerInn", ДопРеквизиты.ИННПолучателя);
		КонецЕсли;
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЕАЭС Тогда
		Результат.Вставить("ImporterId", ДопРеквизиты.ИННПолучателя);
		Результат.Вставить("DestinationCountryCode", ДопРеквизиты.КодСтраныПолучателя);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоГосКонтракту Тогда
		Результат.Вставить("stateContractId", ДопРеквизиты.ИдентификаторГосКонтракта);
	КонецЕсли;
	
	Если ВидПервичногоДокумента = ВидыДокументов.Прочее Тогда
		Результат.Вставить("customDocumentName", ДопРеквизиты.НаименованиеПервичногоДокумента);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.Прочее Тогда
		Результат.Вставить("customActionName", ДопРеквизиты.НаименованиеПричиныВыводаИзОборота);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоСделкеСГосударственнойТайной Тогда
		Результат.Вставить("stateContractId", ДопРеквизиты.ИдентификаторГосКонтракта);
	КонецЕсли;
	
	МожноУказатьЦену = Операция_ВыводИзОборота_МожноУказатьЦену(ПричинаВыводаИзОборота);
	УказыватьНулевуюСтоимость = (ПричинаВыводаИзОборота = ПричиныВывода.БезвозмезднаяПередача
	И ЗначениеЗаполнено(ДопРеквизиты.ИННПолучателя));
	
	products = Новый Массив;
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		product = Новый Структура;
		product.Вставить("name", Стр.Товар.Наименование);
		product.Вставить("gtin", Стр.Товар.GTIN);
		product.Вставить("quantity", Стр.КоличествоУпаковок);
		
		Если УказыватьНулевуюСтоимость Тогда
			СтоимостьСНДСВКопейках = 0;
			product.Вставить("cost", СтоимостьСНДСВКопейках);
		ИначеЕсли МожноУказатьЦену И ЗначениеЗаполнено(Стр.Цена) Тогда
			СтоимостьСНДСВКопейках = РублиВКопейки(Стр.Цена);
			product.Вставить("cost", СтоимостьСНДСВКопейках);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.НомерПартии) Тогда
			НомерПартии = Стр.НомерПартии;
		ИначеЕсли ЗначениеЗаполнено(ДопРеквизиты.НомерПартии) Тогда
			НомерПартии = ДопРеквизиты.НомерПартии;
		Иначе
			НомерПартии = Неопределено;
		КонецЕсли;
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(product, "partNumber", НомерПартии);
		
		ДобавитьЗаполненноеЗначениеВСтруктуру(product, "gtinWeightGram", (Стр.Количество * ГраммВКилограмме()));
		
		products.Добавить(product);
		
	КонецЦикла;
	
	МассивСтруктур_Свернуть(products, "gtin, cost", "quantity");
	
	Результат.Вставить("products", products);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_НаполнениеАгрегатаНаТСД(ОписаниеОперации)
	
	КлючАгрегата = Операция_КлючКода(ОписаниеОперации.Ссылка);
	
	Результат = Новый Структура;
	Результат.Вставить("sscc", КодМаркировки_НайтиПоКлючу(КлючАгрегата));
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ОписаниеОперации.ВидПродукции));
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "comment", ОписаниеОперации.Комментарий);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ОтчетОВыбытии(ОписаниеОперации)
	
	Операция = ОписаниеОперации.Ссылка;
	Организация = ОписаниеОперации.Организация;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ПричинаВыбытия = ОписаниеОперации.ДопРеквизиты.ПричинаВыбытияКодов;
	
	Результат = Новый Структура;
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	Результат.Вставить("dropoutReason", ПричинаВыбытияВСервисе(ПричинаВыбытия));
	
	ТаблицаКодов = КодыОпераций_ПолныеКоды(Операция);
	ТаблицаКодов_УдалитьВесОбъемИзПолныхКодов(ТаблицаКодов);
	ТаблицаКодов_УдалитьЗаводскойСерийныйНомерИзПолныхКодов(ТаблицаКодов, Организация, ВидПродукции);
	Результат.Вставить("codes", ТаблицаКодов.ВыгрузитьКолонку("ПолныйКод"));
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ОтчетОВыбытииНаТСД(Операция)
	
	ПричинаВыбытия = Операция.ДопРеквизиты.ПричинаВыбытияКодов;
	
	Результат = Новый Структура;
	Результат.Вставить("documentNumber", Операция.ДопРеквизиты.НомерДокумента);
	Результат.Вставить("documentDate", Операция.ДопРеквизиты.ДатаДокумента);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(Операция.ВидПродукции));
	Результат.Вставить("dropoutReason", ПричинаВыбытияВСервисе(ПричинаВыбытия));
	
	positions = Новый Массив;
	Для Каждого Стр Из Операция.Товары Цикл
		position = Новый Структура;
		position.Вставить("name", НаименованиеПозицииДляКонтента(Стр));
		position.Вставить("quantity", Стр.КоличествоУпаковок);
		positions.Добавить(position);
	КонецЦикла;
	Результат.Вставить("positions", positions);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_Перемаркировка(ОписаниеОперации)
	
	Операция = ОписаниеОперации.Ссылка;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	ОписаниеОснования = Операция_ПрочитатьОперацию(ОперацияОснование);
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ДопРеквизиты = ОписаниеОснования.ДопРеквизиты;
	ПричинаПеремаркировки = ОписаниеОснования.ДопРеквизиты.ПричинаПеремаркировки;
	ДатаПеремаркировки = ОписаниеОснования.ДопРеквизиты.ДатаПеремаркировки;
	Номер = ОписаниеОперации.Номер;
	
	СтрокаОснования = ОписаниеОснования.Товары.Найти(КлючСтрокиОперации, "КлючСтрокиОперации");
	КодТНВЭД = СтрокаОснования.Товар.КодТНВЭД;
	РазрешительныйДокумент = СтрокаОснования.РазрешительныйДокумент;
	
	Результат = Новый Структура;
	Результат.Вставить("documentNumber", Номер);
	Результат.Вставить("remarkingDate", ДатаПеремаркировки);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	Результат.Вставить("remarkingCause", ПричинаПеремаркировкиВСервисе(ПричинаПеремаркировки));
	
	ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, СтрокаОснования.КлючСтрокиОперации, Ложь);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	certificate = Неопределено;
	Если ЗначениеЗаполнено(РазрешительныйДокумент) Тогда
		certificate = Новый_certificate(РазрешительныйДокумент);
	КонецЕсли;
	
	products = Новый Массив;
	Для каждого Стр Из ТаблицаКодов Цикл
		
		product = Новый Структура;
		product.Вставить("name", НаименованиеПозицииДляКонтента(Стр));
		product.Вставить("gtin", Стр.GTIN);
		product.Вставить("newCode", Стр.КодМаркировки);
		product.Вставить("tnvedCode", КодТНВЭД);
		
		Если ЗначениеЗаполнено(certificate) Тогда
			product.Вставить("certificate", certificate);
		КонецЕсли;
		
		products.Добавить(product);
		
	КонецЦикла;
	
	Результат.Вставить("products", products);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_УведомлениеОПриемке_ОбновлениеДокумента(Операция)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипИсходнойОтгрузки = ДопРеквизиты.ТипИсходнойОтгрузки;
	
	Результат = Новый Структура;
	Результат.Вставить("acceptanceDate", ДопРеквизиты.ДатаПриемки);
	Результат.Вставить("acceptanceDecision", СпособПриемкиВСервисе(ДопРеквизиты.СтатусПриемки));
	
	Если ДопРеквизиты.СтатусПриемки <> Перечисление_СтатусыПриемки().Отклонено Тогда
		
		ДеревоСведенийОТоварах = Операция_УведомлениеОПриемке_СведенияОТоварах(ОписаниеОперации);
		
		positions = Новый Массив;
		Результат.Вставить("positions", positions);
		Контент_УведомлениеОПриемке_ОбновлениеДокумента_ДобавитьПозиции(positions, ДеревоСведенийОТоварах.Строки, ТипИсходнойОтгрузки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Контент_УведомлениеОПриемке_ОбновлениеДокумента_ДобавитьПозиции(positions, СтрокиДерева, ТипИсходнойОтгрузки)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.Строки) Тогда
			
			Если ЗначениеЗаполнено(СтрокаДерева.Товар) Тогда
				
				Контент_УведомлениеОПриемке_ОбновлениеДокумента_ДобавитьПозиции(positions, СтрокаДерева.Строки, ТипИсходнойОтгрузки);
				
			Иначе
				
				position = МассивСтруктур_Найти(positions, СтрокаДерева.КодАгрегата, "code");
				Если position = Неопределено Тогда
					position = Новый Структура;
					position.Вставить("children", Новый Массив);
					positions.Добавить(position);
					Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозицию(position, СтрокаДерева, ТипИсходнойОтгрузки);
				КонецЕсли;
				
				Контент_УведомлениеОПриемке_ОбновлениеДокумента_ДобавитьПозиции(position.children, СтрокаДерева.Строки, ТипИсходнойОтгрузки);
				
			КонецЕсли;
			
		Иначе
			position = Новый Структура;
			positions.Добавить(position);
			Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозицию(position, СтрокаДерева, ТипИсходнойОтгрузки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозицию(position, СтрокаДерева, ТипИсходнойОтгрузки)
	
	Если ТипИсходнойОтгрузки = Перечисление_ТипыИсходныхОтгрузок().ТрансграничнаяОтгрузкаОСУ Тогда
		Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозициюОСУ(position, СтрокаДерева);
	Иначе
		Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозициюПУ(position, СтрокаДерева);
	КонецЕсли;
	
	Если СтрокаДерева.Принято <> Неопределено Тогда
		position.Вставить("accepted", СтрокаДерева.Принято);
	КонецЕсли;
	
	Если СтрокаДерева.РазрешительныеДокументыИзменены Тогда
		certificateDocuments = Новый_certificateDocuments(СтрокаДерева.РазрешительныеДокументы);
		ДобавитьЗаполненноеЗначениеВСтруктуру(position, "certificateDocuments", certificateDocuments);
	КонецЕсли;
	
КонецПроцедуры

Процедура Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозициюОСУ(position, СтрТовара)
	
	position.Вставить("gtin", СтрТовара.GTIN);
	position.Вставить("cisQuantity", СтрТовара.КоличествоКИ);
	
	ЦенаВКопейках = РублиВКопейки(СтрТовара.Цена);
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "productCost", ЦенаВКопейках);
	
	СуммаНДСВКопейках = РублиВКопейки(СтрТовара.СуммаНДС);
	position.Вставить("productTax", СуммаНДСВКопейках);
	
	ВесВГраммах = СтрТовара.Количество * ГраммВКилограмме();
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "weightGrams", ВесВГраммах);
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "tnvedCode", СтрТовара.КодТНВЭД);
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "accompanyingDocument", СтрТовара.ИдентификаторВСД);
	
	Если СтрТовара.РазрешительныеДокументыИзменены Тогда
		certificateDocuments = Новый_certificateDocuments(СтрТовара.РазрешительныеДокументы);
		ДобавитьЗаполненноеЗначениеВСтруктуру(position, "certificateDocuments", certificateDocuments);
	КонецЕсли;
	
КонецПроцедуры

Процедура Контент_УведомлениеОПриемке_ОбновлениеДокумента_ЗаполнитьПозициюПУ(position, СтрДерева)
	
	Если Не ЗначениеЗаполнено(СтрДерева.КодМаркировки) Тогда
		position.Вставить("code", СтрДерева.КодАгрегата);
		Возврат;
	КонецЕсли;
	
	СтрТовара = СтрДерева;
	Пока СтрТовара.Родитель <> Неопределено Цикл
		СтрТовара = СтрТовара.Родитель;
	КонецЦикла;
	
	position.Вставить("code", ЗаменитьРазделительGS1(СтрДерева.КодМаркировки));
	
	Если ЗначениеЗаполнено(СтрДерева.Цена) Тогда
		ЦенаВКопейках = РублиВКопейки(СтрДерева.Цена);
	Иначе
		ЦенаВКопейках = РублиВКопейки(СтрТовара.Цена);
	КонецЕсли;
	position.Вставить("productCost", ЦенаВКопейках);
	
	Если ЗначениеЗаполнено(СтрДерева.СуммаНДС) Тогда
		СуммаНДСВКопейках = РублиВКопейки(СтрДерева.СуммаНДС);
	Иначе
		СуммаНДСВКопейках = РублиВКопейки(СтрТовара.СуммаНДС);
	КонецЕсли;
	position.Вставить("productTax", СуммаНДСВКопейках);
	
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "tnvedCode", СтрТовара.КодТНВЭД);
	ДобавитьЗаполненноеЗначениеВСтруктуру(position, "accompanyingDocument", СтрТовара.ИдентификаторВСД);
	
	Если СтрТовара.РазрешительныеДокументыИзменены Тогда
		certificateDocuments = Новый_certificateDocuments(СтрТовара.РазрешительныеДокументы);
		ДобавитьЗаполненноеЗначениеВСтруктуру(position, "certificateDocuments", certificateDocuments);
	КонецЕсли;
	
КонецПроцедуры

Функция Контент_НаполнениеНаборовНаТСД(ОписаниеОперации)
	
	Операция = ОписаниеОперации.Ссылка;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	Результат = Новый Структура;
	Результат.Вставить("documentNumber", ОписаниеОперации.Номер);
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ОписаниеОперации.ВидПродукции));
	
	Если ДопРеквизиты.ТипНабора = Перечисление_ТипыНаборов().Мультитоварный Тогда
		Результат.Вставить("isMultipleSet", Истина);
	КонецЕсли;
	
	КэшТоваров = Новый Соответствие;
	aggregationUnits = Новый Массив;
	
