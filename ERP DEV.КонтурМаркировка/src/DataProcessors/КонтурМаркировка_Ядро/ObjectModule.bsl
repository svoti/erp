// #Область УведомлениеОСостоянииКодов

Функция ОчередьОбмена_УведомлениеОСостоянииКодов_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьРегистрациюСтрокУведомленияОСостоянииКодов);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеУведомлениеОСостоянииКодов);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентУведомленияОСостоянииКодов);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтрокиУведомленияОСостоянииКодов);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_УведомлениеОСостоянииКодов_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьРегистрациюСтрокУведомленияОСостоянииКодов Тогда
		Задача_УведомлениеОСостоянииКодов_СоздатьУведомлениеНаКаждуюСтроку(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеУведомлениеОСостоянииКодов Тогда
		Задача_УведомлениеОСостоянииКодов_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентУведомленияОСостоянииКодов Тогда
		Задача_УведомлениеОСостоянииКодов_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_УведомлениеОСостоянииКодов_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтрокиУведомленияОСостоянииКодов Тогда
		Задача_УведомлениеОСостоянииКодов_ПроверитьСтатусыСтрок(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_УведомлениеОСостоянииКодов_СоздатьУведомлениеНаКаждуюСтроку(ОписаниеЗадачи)
	
	Если Не КодыОпераций_ЕстьКоды(ОписаниеЗадачи.Операция) Тогда
		ТекстОшибки = НСтр("ru = 'Уведомление о состоянии кодов не содержит коды'");
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиУведомленияОСостоянииКодов;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(ОписаниеЗадачи.Операция, ТипОпераций, Истина);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если КодыОпераций_ЕстьКоды(ОписаниеЗадачи.Операция, Стр.КлючСтрокиОперации) Тогда
			Операция_СоздатьРегистрациюСтрокиУведомленияОСостоянииКодов(ОписаниеОперации, Стр);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтрокиУведомленияОСостоянииКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	
КонецПроцедуры

Процедура Задача_УведомлениеОСостоянииКодов_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_УведомлениеОСостоянииКодов(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_УведомлениеОСостоянииКодов_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьКонтентУведомленияОСостоянииКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_УведомлениеОСостоянииКодов_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_УведомлениеОСостоянииКодов_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_УведомлениеОСостоянииКодов_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	ДанныеФайла = ОписаниеФайла.ДанныеФайла;
	
	Попытка
		Ответ = Маркировка_УведомлениеОСостоянииКодов_ОтправитьВГИС(ОписаниеЗадачи, ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьУведомленияОСостоянииКодов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_УведомлениеОСостоянииКодов_ПроверитьСтатус(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = Неопределено;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьУведомленияОСостоянииКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьУведомленияОСостоянииКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус уведомления о состоянии кодов: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_УведомлениеОСостоянииКодов_ПроверитьСтатусыСтрок(ОписаниеЗадачи)
	
	ТипОперации = Перечисление_ТипыОпераций().РегистрацияСтрокиУведомленияОСостоянииКодов;
	ВсеЗадачиЗавершены = Задача_ВсеПодчиненныеОперацииЗавершены(ОписаниеЗадачи.Операция, ТипОперации);
	Если Не ВсеЗадачиЗавершены Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиВПодчиненных = Задача_ЕстьОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОперации);
	
	Если ЕстьОшибкиВПодчиненных Тогда
		
		ВсеОшибки = Задача_ОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОперации);
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = СоединитьСтроку(ВсеОшибки, Символы.ПС);
		Задача_Записать(ОписаниеЗадачи);
		
	Иначе
		Задача_Завершить(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // УведомлениеОСостоянииКодов

// #Область РезервированиеПартий

Функция ОчередьОбмена_РезервированиеПартий_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьПодчиненныеОперации);
	Результат.Добавить(ТребуемыеДействия.ЗавершитьРезервированиеПартий);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_РезервированиеПартий_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьПодчиненныеОперации Тогда
		Задача_РезервированиеПартий_СоздатьПодчиненныеОперации(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ЗавершитьРезервированиеПартий Тогда
		Задача_РезервированиеПартии_ЗавершитьРезервированиеПартий(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчередьОбмена_РезервированиеПартий_Создать(ОписаниеЗадачи)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	ТипОперации = ОписаниеЗадачи.ТипОперации;
	Организация = ОписаниеЗадачи.Организация;
	ДокументУчета = ОписаниеЗадачи.ДокументУчета;
	
	Если Не Операция_РезервироватьПартии(Операция)
		Или ЭтоОтчетОНанесенииБезЕдиницТовара(Операция) Тогда
		
		Если ТипОперации = ТипыОпераций.ОтчетОНанесении
			Или ТипОперации = ТипыОпераций.РегистрацияНаборов Тогда
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.СоздатьПодчиненныеОперации;
			ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОтправкаВСервис;
		КонецЕсли;
			
		Если ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД
			Или ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОтправитьВСервис;
			ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОтправкаВСервис;
		КонецЕсли;
		
		Задача_Записать(ОписаниеЗадачи);
		
		Возврат;
		
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		РезервированиеПартий = МодульМаркировки().Операция_Создать(ТипыОпераций.РезервированиеПартий, ДокументУчета, Операция, Организация);
		
		Задача_Создать(РезервированиеПартий);
		
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.РезервированиеПартий;
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОжиданиеГотовностиПартий;
		Задача_Записать(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Задача_РезервированиеПартий_СоздатьПодчиненныеОперации(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Если Операция_СоздатьРезервированиеНаКаждуюПартию(Операция) Тогда
		
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьПодчиненныеОперации;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
		Задача_Записать(ОписаниеЗадачи);
		
		Метрика_Операции_ОтправкаВСервис(ОписаниеЗадачи.Операция);
		
	Иначе
		Задача_РезервированиеПартии_ЗавершитьРезервированиеПартий(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_РезервированиеПартии_ЗавершитьРезервированиеПартий(ОписаниеЗадачи)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	ОперацияОснование = ОписаниеЗадачи.ОперацияОснование;
	ЕстьОснование = ЗначениеЗаполнено(ОперацияОснование);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		Если ЕстьОснование Тогда
			ОчередьОбмена_Заблокировать(ОперацияОснование);
			ЗадачаОснования = Задача_Прочитать(ОперацияОснование);
		КонецЕсли;
		
		СостояниеОбмена = Операция_СостояниеОбменаПодчиненныхОпераций(Операция);
		
		Если СостояниеОбмена.ЕстьОшибки Тогда
			
			ТекстОшибки = СоединитьСтроку(Задача_ОшибкиВПодчиненныхОперациях(Операция), Символы.ПС);
			
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
			
			Если ЕстьОснование Тогда
				Задача_ЗаписатьОшибку(ЗадачаОснования, ТекстОшибки);
			КонецЕсли;
			
		Иначе
			
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
			ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОперацияЗавершена;
			
			Если ЕстьОснование Тогда
				
				Если ЗадачаОснования.ТипОперации = ТипыОпераций.ОтчетОНанесении
					Или ЗадачаОснования.ТипОперации = ТипыОпераций.РегистрацияНаборов Тогда
					ЗадачаОснования.НовоеДействие = ТребуемыеДействия.СоздатьПодчиненныеОперации;
					ЗадачаОснования.НовыйСтатусОперации = СтатусыОпераций.ОтправкаВСервис;
				КонецЕсли;
					
				Если ЗадачаОснования.ТипОперации = ТипыОпераций.ОтчетОНанесенииНаТСД
					Или ЗадачаОснования.ТипОперации = ТипыОпераций.НаполнениеНаборовНаТСД Тогда
					ЗадачаОснования.НовоеДействие = ТребуемыеДействия.ОтправитьВСервис;
					ЗадачаОснования.НовыйСтатусОперации = СтатусыОпераций.ОтправкаВСервис;
				КонецЕсли;
				
			КонецЕсли;
			
			Задача_Записать(ОписаниеЗадачи);
			
			Если ЕстьОснование Тогда
				Задача_Записать(ЗадачаОснования);
			КонецЕсли;
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти // РезервированиеПартий

// #Область РезервированиеОднойПартии

Функция ОчередьОбмена_РезервированиеОднойПартии_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ОтправитьВСервис);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_РезервированиеОднойПартии_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ОтправитьВСервис Тогда
		Задача_РезервированиеОднойПартии_ОтправитьВСервис(ОписаниеЗадачи);
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_РезервированиеОднойПартии_ОтправитьВСервис(ОписаниеЗадачи)
	
	Контент = Контент_РезервированиеОдногоНомераПартии(ОписаниеЗадачи.Операция);
	
	Попытка
		Ответ = Маркировка_РезервированиеПартий_ОтправитьВГИС(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Задача_Завершить(ОписаниеЗадачи);
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // РезервированиеОднойПартии

// #Область ОчередьОбменаСлужебные

// Выполняет все необходимые задачи в очереди обмена с сервисом
//
// Параметры:
//  КонтекстОбмена - Структура - см. Новый_КонтекстОбмена();
//
Процедура ОчередьОбмена_ВыполнитьОбмен(КонтекстОбмена)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ОчередьОбмена_ВТ_ДобавитьСлужебныеТаблицы(МенеджерВТ);
	
	ВыполнитьОбмен = Истина;
	
	Пока ВыполнитьОбмен Цикл
		
		ОчередьОбмена_ЗаписатьФайлыПодписей(КонтекстОбмена);
		ОчередьОбмена_УстановитьДействиеОтправитьПодпись(КонтекстОбмена);
		
		ОчередьОбмена_ВТ_ПрочитатьОперацииВОчереди(КонтекстОбмена, МенеджерВТ);
		
		Для Каждого ТипБизнесПроцесса Из ОчередьОбмена_ТипыБизнесПроцессовВОчереди(КонтекстОбмена, МенеджерВТ) Цикл
			ОчередьОбмена_ОбработатьЗадачи(ТипБизнесПроцесса, КонтекстОбмена);
		КонецЦикла;
		
		Если ОчередьОбмена_ЕстьНовыеОперации(КонтекстОбмена, МенеджерВТ) Тогда
			Продолжить;
		КонецЕсли;
		
		Если КонтекстОбмена.ОтключитьПодписьФайлов
			Или Не ОчередьОбмена_ПрочитатьНовуюПорциюФайловДляПодписи(КонтекстОбмена)
			Или Не ОчередьОбмена_ПодписатьФайлы(КонтекстОбмена) Тогда
			ВыполнитьОбмен = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьДатуПоследнегоОбмена(КонтекстОбмена.Организация);
	
КонецПроцедуры

Процедура ОчередьОбмена_ВТ_ПрочитатьОперацииВОчереди(КонтекстОбмена, МенеджерВТ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОчередьОбмена.Операция КАК Операция,
	|	ОчередьОбмена.ТребуемоеДействие КАК ТребуемоеДействие,
	|	ДействияБизнесПроцессов.ТипБизнесПроцесса КАК ТипБизнесПроцесса
	|ПОМЕСТИТЬ ОперацииВОчереди
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДействияБизнесПроцессов КАК ДействияБизнесПроцессов
	|		ПО ОчередьОбмена.ТребуемоеДействие = ДействияБизнесПроцессов.ТребуемоеДействие
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ОчередьОбмена.Операция = Операции.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТипыОперацийБизнесПроцессов КАК ТипыОперацийБизнесПроцессов
	|		ПО (Операции.ТипОперации = ТипыОперацийБизнесПроцессов.ТипОперации)
	|ГДЕ
	|	ДействияБизнесПроцессов.ТипБизнесПроцесса = ТипыОперацийБизнесПроцессов.ТипБизнесПроцесса
	|	И &ДокументУчета
	|	И &ОперацииОбмена
	|	И &Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Операция,
	|	ТребуемоеДействие";
	
	Если ЗначениеЗаполнено(КонтекстОбмена.ДокументУчета) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "Операции.ДокументУчета В (&ДокументУчета)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументУчета", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтекстОбмена.Операции) Тогда
		ОперацииОбмена = Операции_НайтиПодчиненныеОперации(КонтекстОбмена.Операции, Истина);
		ДополнитьМассив(ОперацииОбмена, КонтекстОбмена.Операции, Истина, Ложь);
		Условие = "ОчередьОбмена.Операция В (&ОперацииОбмена)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОбмена", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОбмена", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтекстОбмена.Организация) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "Операции.Организация = &Организация");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ДокументУчета", ЗначениеВМассиве(КонтекстОбмена.ДокументУчета));
	Запрос.УстановитьПараметр("Организация", КонтекстОбмена.Организация);
	Запрос.УстановитьПараметр("ОперацииОбмена", ОперацииОбмена);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ОчередьОбмена_ВТ_ДобавитьСлужебныеТаблицы(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ТипБизнесПроцесса КАК ТипБизнесПроцесса,
	|	Т.ТребуемоеДействие КАК ТребуемоеДействие
	|ПОМЕСТИТЬ ДействияБизнесПроцессов
	|ИЗ
	|	&ДействияБизнесПроцессов КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТребуемоеДействие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ТипБизнесПроцесса КАК ТипБизнесПроцесса,
	|	Т.ТипОперации КАК ТипОперации
	|ПОМЕСТИТЬ ТипыОперацийБизнесПроцессов
	|ИЗ
	|	&ТипыОперацийБизнесПроцессов КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТипОперации");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТипыОперацийБизнесПроцессов", ОчередьОбмена_ТипыОперацийБизнесПроцессов());
	Запрос.УстановитьПараметр("ДействияБизнесПроцессов", ОчередьОбмена_ДействияБизнесПроцессов());
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ОчередьОбмена_ЕстьНовыеОперации(КонтекстОбмена, МенеджерВТ)
	
	ПереместитьТаблицуЗапроса(МенеджерВТ, "ОперацииВОчереди", "СтарыеОперацииВОчереди", "Операция, ТребуемоеДействие");
	
	ОчередьОбмена_ВТ_ПрочитатьОперацииВОчереди(КонтекстОбмена, МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьНовыеОперации
	|ИЗ
	|	ОперацииВОчереди КАК ОперацииВОчереди
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтарыеОперацииВОчереди КАК СтарыеОперацииВОчереди
	|		ПО ОперацииВОчереди.Операция = СтарыеОперацииВОчереди.Операция
	|			И ОперацииВОчереди.ТребуемоеДействие = СтарыеОперацииВОчереди.ТребуемоеДействие
	|ГДЕ
	|	СтарыеОперацииВОчереди.Операция ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОперацииВОчереди
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СтарыеОперацииВОчереди");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ОчередьОбмена_ТипыБизнесПроцессовВОчереди(КонтекстОбмена, МенеджерВТ)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Т.ТипБизнесПроцесса КАК ТипБизнесПроцесса ИЗ ОперацииВОчереди КАК Т");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "ТипБизнесПроцесса");
	
КонецФункции

Функция ОчередьОбмена_ДействияБизнесПроцессов()
	
	КлючКэш = "ДействияБизнесПроцессов";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипСтрока = ОписаниеТипа_Строка();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТипБизнесПроцесса", ТипСтрока);
	Результат.Колонки.Добавить("ТребуемоеДействие", ТипСтрока);
	
	Для Каждого Элемент Из Перечисление_ТипыБизнесПроцессовОчередиОбмена() Цикл
		ТипБизнесПроцесса = Элемент.Значение;
		Для Каждого ТребуемоеДействие Из ОчередьОбмена_БизнесПроцесс(ТипБизнесПроцесса) Цикл
			Стр = Результат.Добавить();
			Стр.ТипБизнесПроцесса = ТипБизнесПроцесса;
			Стр.ТребуемоеДействие = ТребуемоеДействие;
		КонецЦикла;
	КонецЦикла;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ОчередьОбмена_БизнесПроцесс(ТипБизнесПроцесса)
	
	Результат = ОчередьОбмена_БизнесПроцессыОпераций().Получить(ТипБизнесПроцесса);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось получить требуемые действия по типу бизнес-процесса: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ТипБизнесПроцесса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОчередьОбмена_БизнесПроцессыОпераций()
	
	КлючКэш = "ОчередьОбмена_БизнесПроцессыОпераций";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыБП = Перечисление_ТипыБизнесПроцессовОчередиОбмена();
	
	Результат = Новый Соответствие;
	Результат.Вставить(ТипыБП.НаполнениеАгрегатовНаТСД,    ОчередьОбмена_НаполнениеАгрегатовНаТСД_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ЗаказКодов,                  ОчередьОбмена_ЗаказКодов_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ВводВОборот,                 ОчередьОбмена_ВводВОборот_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ПакетнаяАгрегация,           ОчередьОбмена_ПакетнаяАгрегация_БизнесПроцесс());
	Результат.Вставить(ТипыБП.Агрегация,                   ОчередьОбмена_Агрегация_БизнесПроцесс());
	Результат.Вставить(ТипыБП.Отгрузка,                    ОчередьОбмена_Отгрузка_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ВыводИзОборота,              ОчередьОбмена_ВыводИзОборота_БизнесПроцесс());
	Результат.Вставить(ТипыБП.Разагрегация,                ОчередьОбмена_Разагрегация_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ОтчетОНанесении,             ОчередьОбмена_ОтчетОНанесении_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ОтчетОНанесенииНаТСД,        ОчередьОбмена_ОтчетОНанесенииНаТСД_БизнесПроцесс());
	Результат.Вставить(ТипыБП.СтрокаОтчетаОНанесении,      ОчередьОбмена_СтрокаОтчетаОНанесении_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ОтчетОВыбытии,               ОчередьОбмена_ОтчетОВыбытии_БизнесПроцесс());
	Результат.Вставить(ТипыБП.Перемаркировка,              ОчередьОбмена_Перемаркировка_БизнесПроцесс());
	Результат.Вставить(ТипыБП.РегистрацияНаборов,          ОчередьОбмена_РегистрацияНаборов_БизнесПроцесс());
	Результат.Вставить(ТипыБП.НаполнениеНаборовНаТСД,      ОчередьОбмена_НаполнениеНаборовНаТСД_БизнесПроцесс());
	Результат.Вставить(ТипыБП.РегистрацияСтрокиНаборов,    ОчередьОбмена_РегистрацияСтрокиНаборов_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ПодборКодовНаТСД,            ОчередьОбмена_ПодборКодовНаТСД_БизнесПроцесс());
	Результат.Вставить(ТипыБП.УведомлениеОПриемке,         ОчередьОбмена_УведомлениеОПриемке_БизнесПроцесс());
	Результат.Вставить(ТипыБП.РегистрацияКИГУ,             ОчередьОбмена_РегистрацияКИГу_БизнесПроцесс());
	Результат.Вставить(ТипыБП.НаполнениеКИГУНаТСД,         ОчередьОбмена_НаполнениеКИГУНаТСД_БизнесПроцесс());
	Результат.Вставить(ТипыБП.РегистрацияСтрокиКИГУ,       ОчередьОбмена_РегистрацияСтрокиКИГУ_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ВозвратВОборот,              ОчередьОбмена_ВозвратВОборот_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ВозвратВОборотНаТСД,         ОчередьОбмена_ВозвратВОборотНаТСД_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ОтменаВыводаИзОборота,       ОчередьОбмена_ОтменаВыводаИзОборота_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ТрансформацияАгрегатов,      ОчередьОбмена_ТрансформацияАгрегатов_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ФормированиеАТК,             ОчередьОбмена_ФормированиеАТК_БизнесПроцесс());
	Результат.Вставить(ТипыБП.РасформированиеАТК,          ОчередьОбмена_РасформированиеАТК_БизнесПроцесс());
	Результат.Вставить(ТипыБП.ТрансформацияАТК,            ОчередьОбмена_ТрансформацияАТК_БизнесПроцесс());
	Результат.Вставить(ТипыБП.КорректировкаСведенийОКодах, ОчередьОбмена_КорректировкаСведенийОКодах_БизнесПроцесс());
	Результат.Вставить(ТипыБП.УведомлениеОСостоянииКодов,  ОчередьОбмена_УведомлениеОСостоянииКодов_БизнесПроцесс());
	Результат.Вставить(ТипыБП.РезервированиеПартий,        ОчередьОбмена_РезервированиеПартий_БизнесПроцесс());
	Результат.Вставить(ТипыБП.РезервированиеОднойПартии,   ОчередьОбмена_РезервированиеОднойПартии_БизнесПроцесс());
	
	Результат = Новый ФиксированноеСоответствие(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ОчередьОбмена_ТипыОперацийБизнесПроцессов()
	
	КлючКэш = "ОчередьОбмена_ТипыБизнесПроцессовОпераций";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипСтрока = ОписаниеТипа_Строка();
	ТипыОпер = Перечисление_ТипыОпераций();
	ТипыБП = Перечисление_ТипыБизнесПроцессовОчередиОбмена();
	
	Результат = Новый ТаблицаЗначений;
