Функция КлючОбъекта1С(Объект1С) Экспорт
	
	Если ЗначениеЗаполнено(Объект1С) Тогда
		Результат = Объект1С.УникальныйИдентификатор();
	Иначе
		Результат = ПустойУникальныйИдентификатор();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипКлючаОбъекта1С(Объект1С) Экспорт
	
	Если Не ЗначениеЗаполнено(Объект1С) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПолноеИмяОбъекта(Объект1С);
	
КонецФункции

Процедура ЗаполнитьВТаблицеОбъекты1СПоКлючам(Таблица, КолонкаОбъектов, КолонкаКлючей, КолонкаТиповКлючей) Экспорт
	
	Для каждого Стр Из Таблица Цикл
		Стр[КолонкаОбъектов] = МодульОбщегоНазначения().СсылкаПоИдентификатору(Стр[КолонкаКлючей], Стр[КолонкаТиповКлючей]);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьВТаблицеКлючиПоОбъектам1С(Таблица, КолонкаОбъектов, КолонкаКлючей, КолонкаТиповКлючей = "") Экспорт
	
	ЗаполнятьТипКлюча = ЗначениеЗаполнено(КолонкаТиповКлючей);
	
	Если Таблица.Колонки.Найти(КолонкаКлючей) = Неопределено Тогда
		Таблица.Колонки.Добавить(КолонкаКлючей, Новый ОписаниеТипов("УникальныйИдентификатор"));
	КонецЕсли;
	
	Если ЗаполнятьТипКлюча И Таблица.Колонки.Найти(КолонкаТиповКлючей) = Неопределено Тогда
		Таблица.Колонки.Добавить(КолонкаТиповКлючей, Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(255)));
	КонецЕсли;
	
	Для каждого Стр Из Таблица Цикл
		Объект1С = Стр[КолонкаОбъектов];
		Стр[КолонкаКлючей] = КлючОбъекта1С(Объект1С);
		Если ЗаполнятьТипКлюча Тогда
			Стр[КолонкаТиповКлючей] = ТипКлючаОбъекта1С(Объект1С);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

