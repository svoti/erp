КонецПроцедуры

Процедура ОбновлениеДанных_3_24_ОбновитьВДокументеУчетаОтражениеВЭДО(ДокументУчета, Версия)
	
	// BSLLS:CognitiveComplexity-off
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ОтраженияВЭДО = Перечисление_ОтраженияВЭДО();
	ПравилаОтраженияВЭДО = Перечисление_ПравилаОтраженияВЭДО();
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ДокументУчета_Заблокировать(ДокументУчета);
		
		ОбъектДокумента = ДокументУчета.ПолучитьОбъект();
		
		ОтборТоварыДокумента = Новый Структура("НеПодлежитМаркировке, ОтражениеВЭДО", Ложь, ПравилаОтраженияВЭДО.ОСУ);
		ОтборТоварыМаркировки = Новый Структура("КлючСтрокиДокумента");
		
		ЕстьИзменения = Ложь;
		
		Для Каждого СтрДок Из ОбъектДокумента.ТоварыДокумента.НайтиСтроки(ОтборТоварыДокумента) Цикл
			
			ОтборТоварыМаркировки.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
			
			Для Каждого СтрТовара Из ОбъектДокумента.ТоварыМаркировки.НайтиСтроки(ОтборТоварыМаркировки) Цикл
				Если СтрТовара.Товар.ВидПродукции = ВидыПродукции.Молоко И ЗначениеЗаполнено(СтрТовара.НомерПартии) Тогда
					СтрДок.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ПартионныйУчет;
					ЕстьИзменения = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		Если ЕстьИзменения Тогда
			
			ОтборТоварыДокумента.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ПУ;
			ЕстьСтрокиПУ = ЗначениеЗаполнено(ОбъектДокумента.ТоварыДокумента.НайтиСтроки(ОтборТоварыДокумента));
			
			ОтборТоварыДокумента.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ОСУ;
			ЕстьСтрокиОСУ = ЗначениеЗаполнено(ОбъектДокумента.ТоварыДокумента.НайтиСтроки(ОтборТоварыДокумента));
			
			ОтборТоварыДокумента.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ПартионныйУчет;
			ЕстьСтрокиПАРТ = ЗначениеЗаполнено(ОбъектДокумента.ТоварыДокумента.НайтиСтроки(ОтборТоварыДокумента));
			
			Если ЕстьСтрокиПУ И ЕстьСтрокиОСУ И ЕстьСтрокиПАРТ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУПАРТПУ;
			ИначеЕсли ЕстьСтрокиОСУ И ЕстьСтрокиПАРТ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУПАРТ;
			ИначеЕсли ЕстьСтрокиПУ И ЕстьСтрокиПАРТ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ПУПАРТ;
			ИначеЕсли ЕстьСтрокиПУ И ЕстьСтрокиОСУ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУПУ;
			ИначеЕсли ЕстьСтрокиПУ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ПУ;
			ИначеЕсли ЕстьСтрокиОСУ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ОСУ;
			ИначеЕсли ЕстьСтрокиПАРТ Тогда
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.ПАРТ;
			Иначе
				ОбъектДокумента.ОтражениеВЭДО = ОтраженияВЭДО.НеОтражать;
			КонецЕсли;
			
			ОбъектДокумента.ОбменДанными.Загрузка = Истина;
			ОбъектДокумента.Записать();
			
		КонецЕсли;
		
		ОбновлениеДанных_УдалитьОбъекты(ДокументУчета, Версия);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Отложенное обновление данных документа'");
		ДопИнформация = Новый СписокЗначений;
		ДопИнформация.Добавить(Версия, "Версия");
		ДопИнформация.Добавить(ДокументУчета, "Документ учета");
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		ВызватьИсключение;
	КонецПопытки;
	
	ТекстСообщения = ПараметрыВСтроку(НСтр("ru = 'Документ обновлен до версии %1'"), Версия);
	ДобавитьПредупреждениеВЖурналРегистрации(ТекстСообщения, ДокументУчета);
	
	// BSLLS:CognitiveComplexity-on
	
КонецПроцедуры

