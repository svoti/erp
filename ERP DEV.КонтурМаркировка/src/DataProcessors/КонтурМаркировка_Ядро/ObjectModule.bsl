	Результат.Вставить("ДокументОснованиеНомер");
	Результат.Вставить("ДокументОснованиеДата", '00010101');
	Результат.Вставить("ТипИсходнойОтгрузки");
	
	// Корректировка сведений о кодах
	Результат.Вставить("ВидКорректируемыхСведений");
	Результат.Вставить("ТипКорректировки");
	
	// Возврат в оборот
	Результат.Вставить("ТоварОплачен", Ложь);
	Результат.Вставить("ПричинаВозвратаВОборот");
	
	// Формирование АТК
	Результат.Вставить("ГруппаТНВЭД", "");
	
	// Уведомление о состоянии кодов
	Результат.Вставить("ГосномерТранспортногоСредства", "");
	Результат.Вставить("ВидТранспортногоДокумента", "");
	Результат.Вставить("ИдентификаторЭПД", "");
	Результат.Вставить("СостояниеКодов");
	
	// Регистрация наборов
	Результат.Вставить("ТипНабора", "");
	
	// Источник создания
	Результат.Вставить("ИсточникСоздания", "");
	
	Возврат Результат;
	
КонецФункции

Функция Новый_Операция_Статусы()
	
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	
	Результат = Новый Структура;
	Результат.Вставить(ТипыСтатусов.ОсновнойСтатус, СтатусыОпераций.Новый);
	Результат.Вставить(ИмяПоляДатаСтатуса(ТипыСтатусов.ОсновнойСтатус), '00010101');
	Результат.Вставить(ИмяПоляПредыдущийСтатус(ТипыСтатусов.ОсновнойСтатус), "");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Контракты

// #КонецОбласти // Операции

// #Область СтатусыОпераций

// Читает из базы все статусы операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция, по которой нужно прочитать статусы
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * Ключ - Строка - тип статуса
//   * Значение - Строка - статус, см. Перечисление_СтатусыОпераций()
//
Функция СтатусыОперации_Прочитать(Операция)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ТипСтатуса КАК ТипСтатуса,
	|	Т.Статус КАК Статус,
	|	Т.ДатаСтатуса КАК ДатаСтатуса,
	|	Т.ПредыдущийСтатус КАК ПредыдущийСтатус
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Т
	|ГДЕ
	|	Т.Операция = &Операция");
	
	Запрос.УстановитьПараметр("Операция", Операция);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		
		ТипСтатуса		 = Выборка.ТипСтатуса;
		Статус			 = Выборка.Статус;
		ДатаСтатуса		 = Выборка.ДатаСтатуса;
		ПредыдущийСтатус = Выборка.ПредыдущийСтатус;
		
		Результат.Вставить(ТипСтатуса, Статус);
		Результат.Вставить(ИмяПоляДатаСтатуса(ТипСтатуса), ДатаСтатуса);
		Результат.Вставить(ИмяПоляПредыдущийСтатус(ТипСтатуса), ПредыдущийСтатус);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Записывает в базу все статусы операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - владелец статусов;
//  СтатусыОперации - Структура - все статусы операции;
//
Процедура СтатусыОперации_Записать(Операция, СтатусыОперации) Экспорт
	
	ДатаНовыхСтатусов = ТекущаяДатаСеанса();
	
	Для каждого Элемент Из СтатусыОперации Цикл
		
		ТипСтатуса = Элемент.Ключ;
		НовыйСтатус = Элемент.Значение;
		
		Если Лев(ТипСтатуса, 11) = "ДатаСтатуса"
			Или Лев(ТипСтатуса, 16) = "ПредыдущийСтатус" Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Т
		|ГДЕ
		|	Т.ТипСтатуса = &ТипСтатуса
		|	И Т.Операция = &Операция");
		Запрос.УстановитьПараметр("ТипСтатуса", ТипСтатуса);
		Запрос.УстановитьПараметр("Операция", Операция);
		
		СтарыйСтатус = ПолучитьРезультатЗапроса(Запрос, "Статус");
		
		Если СтарыйСтатус = НовыйСтатус
			Или (Не ЗначениеЗаполнено(СтарыйСтатус)
				И Не ЗначениеЗаполнено(НовыйСтатус)) Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = РегистрыСведений.КонтурМаркировка_СтатусыОпераций.СоздатьМенеджерЗаписи();
		Запись.Операция			 = Операция;
		Запись.ТипСтатуса		 = ТипСтатуса;
		Запись.Статус			 = НовыйСтатус;
		Запись.ДатаСтатуса		 = ДатаНовыхСтатусов;
		Запись.ПредыдущийСтатус	 = СтарыйСтатус;
		
		Если ЗначениеЗаполнено(НовыйСтатус) Тогда
			Запись.Записать();
		Иначе
			Запись.Удалить();
		КонецЕсли;
		
		СтатусыОперации[ИмяПоляДатаСтатуса(ТипСтатуса)] = ДатаНовыхСтатусов;
		
	КонецЦикла;
	
КонецПроцедуры

// Записывает в базу основной статус операции
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - владелец статуса;
//  Статус - Строка - значение статуса;
//  ДатаСтатуса - Дата - дата статуса операции;
//
Процедура СтатусыОперации_ЗаписатьОсновнойСтатус(Операция, Статус, ДатаСтатуса = Неопределено) Экспорт
	
	ТипСтатуса = "ОсновнойСтатус";
	Если СтатусыОперации_СтатусУжеУстановлен(Операция, ТипСтатуса, Статус) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДатаСтатуса = Неопределено Тогда
		ДатаСтатуса = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Набор = РегистрыСведений.КонтурМаркировка_СтатусыОпераций.СоздатьНаборЗаписей();
	Набор.Отбор.ТипСтатуса.Установить(ТипСтатуса);
	Набор.Отбор.Операция.Установить(Операция);
	
	Если ЗначениеЗаполнено(Статус) Тогда
		Запись = Набор.Добавить();
		Запись.ТипСтатуса = ТипСтатуса;
		Запись.Операция = Операция;
		Запись.Статус = Статус;
		Запись.ДатаСтатуса = ДатаСтатуса;
		Запись.ПредыдущийСтатус = Операция_ОсновнойСтатус(Операция);
	КонецЕсли;
	
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	
	Если Операция_ВлияетНаТребуемоеДействиеДокумента(Операция) Тогда
		ДокументУчета_ОбновитьТребуемоеДействие(Операция.ДокументУчета);
	КонецЕсли;
	
КонецПроцедуры

Функция СтатусыОперации_СтатусУжеУстановлен(Операция, ТипСтатуса, Статус)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК Т
	|ГДЕ
	|	Т.Операция = &Операция
	|	И Т.ТипСтатуса = &ТипСтатуса
	|	И Т.Статус = &Статус");
	
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("ТипСтатуса", ТипСтатуса);
	Запрос.УстановитьПараметр("Статус", Статус);
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	Возврат Результат;
	
КонецФункции

Процедура СтатусыОперации_Удалить(Операция)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СтатусыОперации_Заблокировать(Операция);
		
		Набор = РегистрыСведений.КонтурМаркировка_СтатусыОпераций.СоздатьНаборЗаписей();
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Отбор.Операция.Установить(Операция);
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Устанавливает исключительную блокировку регистра статусов операций
//
// Параметры:
//  Операция - СправочникСсылка.КонтурМаркировка_Операции - операция , по которой нужно заблокировать статусы
//
Процедура СтатусыОперации_Заблокировать(Операция)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_СтатусыОпераций");
	ЭлементБлокировки.УстановитьЗначение("Операция", Операция);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

// #КонецОбласти // СтатусыОпераций

// #Область ТоварыАгрегатов

Функция ТоварыАгрегатов_Прочитать(КлючиКодов) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей,
	|	ЕСТЬNULL(ТоварыАгрегатов.Товар, ИнформацияОКодах.Товар) КАК Товар,
	|	ЕСТЬNULL(ТоварыАгрегатов.КлючНоменклатуры1С, ИнформацияОКодах.КлючНоменклатуры1С) КАК КлючНоменклатуры1С,
	|	ЕСТЬNULL(ТоварыАгрегатов.КоличествоУпаковок, КодыМаркировки.КоличествоУпаковок) КАК КоличествоУпаковок,
	|	ЕСТЬNULL(ТоварыАгрегатов.Количество, КодыМаркировки.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО КодыМаркировки.КлючКода = ТоварыАгрегатов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КодыМаркировки.КлючКода В(&КлючиКодов)
	|	И ЕСТЬNULL(ТоварыАгрегатов.КоличествоУпаковок, КодыМаркировки.КоличествоУпаковок) > 0");
	Запрос.УстановитьПараметр("КлючиКодов", ЗначениеВМассиве(КлючиКодов));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ТоварыАгрегатов_ЗаполнитьИзГИСМТ(ТаблицаКодов, Организация) Экспорт
	
	// BSLLS:CognitiveComplexity-off
	// BSLLS:NestedStatements-off
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов.Колонки.Добавить("ТоварыИзСервиса");
	
	ТаблицаКИТУ = Новый_ТаблицаКодов();
	ТаблицаКИТУ.Колонки.Добавить("СтрАгрегата");
	
	КлючиАгрегатов = Новый Массив;
	
	ОтборКИТУ = Новый Структура("ОбщийТипУпаковки", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Для каждого СтрАгрегата Из ТаблицаКодов.НайтиСтроки(ОтборКИТУ) Цикл
		СтрАгрегата.ТоварыИзСервиса = Новый Соответствие;
		СтрКИТУ = ТаблицаКИТУ.Добавить();
		СтрКИТУ.КодМаркировки = СтрАгрегата.КодМаркировки;
		СтрКИТУ.ВидПродукции = СтрАгрегата.ВидПродукции;
		СтрКИТУ.СтрАгрегата = СтрАгрегата;
		КлючиАгрегатов.Добавить(СтрАгрегата.КлючКода);
	КонецЦикла;
	
	КэшТоваров = Новый Соответствие;
	
	Пока ЗначениеЗаполнено(ТаблицаКИТУ) Цикл
		
		Для каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаКИТУ, "ВидПродукции") Цикл
			
			ВидПродукции = ЧастьТаблицы.ВидПродукции;
			СтрокиТаблицы = ЧастьТаблицы.МассивСтрок;
			
			КодыМаркировки = Новый Массив;
			Для каждого СтрАгрегата Из СтрокиТаблицы Цикл
				КодыМаркировки.Добавить(СтрАгрегата.КодМаркировки);
			КонецЦикла;
			
			Ответ = Маркировка_СтатусыКодов(КодыМаркировки, Организация, ВидПродукции);
			
			ЭтоНикотиносодержащаяПродукция = ЭтоНикотиносодержащаяПродукция(ВидПродукции);
			
			Для Сч = 0 По СтрокиТаблицы.ВГраница() Цикл
				
				СтрКИТУ = СтрокиТаблицы[Сч];
				СтрАгрегата = СтрКИТУ.СтрАгрегата;
				КодМаркировки = СтрКИТУ.КодМаркировки;
				ТаблицаКИТУ.Удалить(СтрКИТУ);
				
				Если Не ЗначениеЗаполнено(Ответ) Тогда
					Продолжить;
				КонецЕсли;
				
				CisInfo = Ответ[Сч];
				Если Не ЗначениеЗаполнено(CisInfo) Тогда
					Продолжить;
				КонецЕсли;
				
				value = CisInfo["value"];
				Если Не ЗначениеЗаполнено(value) Тогда
					Продолжить;
				КонецЕсли;
				
				childrenCodes = value["childrenCodes"];
				Если Не ЗначениеЗаполнено(childrenCodes) Тогда
					
					Если ЭтоНикотиносодержащаяПродукция Тогда
						GTIN = GTINИзКодаМаркировки(КодМаркировки, ВидПродукции);
						
						Если ЗначениеЗаполнено(GTIN) Тогда
							Товар = Товар_НайтиСоздатьПоИнформацииИзСервиса(GTIN, КэшТоваров);
							СтрАгрегата.ТоварыИзСервиса[Товар] = ЗначениеСоответствия(СтрАгрегата.ТоварыИзСервиса, Товар, 0) + 1;
						КонецЕсли;
						
					КонецЕсли;
					
					Продолжить;
					
				КонецЕсли;
				
				Для каждого ВложенныйКод Из childrenCodes Цикл
					
					GTIN = GTINИзКодаМаркировки(ВложенныйКод);
					
					Если ЗначениеЗаполнено(GTIN) Тогда
						Товар = Товар_НайтиСоздатьПоИнформацииИзСервиса(GTIN, КэшТоваров);
						СтрАгрегата.ТоварыИзСервиса[Товар] = ЗначениеСоответствия(СтрАгрегата.ТоварыИзСервиса, Товар, 0) + 1;
					Иначе
						СтрКИТУ = ТаблицаКИТУ.Добавить();
						СтрКИТУ.КодМаркировки = ВложенныйКод;
						СтрКИТУ.ВидПродукции = ВидПродукции;
						СтрКИТУ.СтрАгрегата = СтрАгрегата;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ТоварыАгрегатов = Новый_ТоварыАгрегатов();
	
	ОтборКлючТовар = Новый Структура("КлючКода, Товар");
	ТоварыАгрегатовИБ = ТоварыАгрегатов_Прочитать(КлючиАгрегатов);
	ТоварыАгрегатовИБ.Индексы.Добавить("КлючКода, Товар");
	
	Для каждого СтрАгрегата Из ТаблицаКодов.НайтиСтроки(ОтборКИТУ) Цикл
		
		Если Не ЗначениеЗаполнено(СтрАгрегата.ТоварыИзСервиса) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборКлючТовар.КлючКода = СтрАгрегата.КлючКода;
		
		Для каждого Элемент Из СтрАгрегата.ТоварыИзСервиса Цикл
			
			Товар = Элемент.Ключ;
			КоличествоУпаковок = Элемент.Значение;
			
			КоличествоУпаковокИБ = 0;
			ОтборКлючТовар.Товар = Товар;
			СтрокиТоваровИБ = ТоварыАгрегатовИБ.НайтиСтроки(ОтборКлючТовар);
			Для Каждого СтрИБ Из СтрокиТоваровИБ Цикл
				КоличествоУпаковокИБ = КоличествоУпаковокИБ + СтрИБ.КоличествоУпаковок;
			КонецЦикла;
			
			Если КоличествоУпаковок >= КоличествоУпаковокИБ Тогда
				Для Каждого СтрИБ Из СтрокиТоваровИБ Цикл
					Стр = ТоварыАгрегатов.Добавить();
					ЗаполнитьЗначенияСвойств(Стр, СтрИБ);
				КонецЦикла;
				КоличествоУпаковок = КоличествоУпаковок - КоличествоУпаковокИБ;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КоличествоУпаковок) Тогда
				Стр = ТоварыАгрегатов.Добавить();
				Стр.Товар = Товар;
				Стр.КлючКода = СтрАгрегата.КлючКода;
				Стр.ПорцияЗаписей = СтрАгрегата.ПорцияЗаписей;
				Стр.КоличествоУпаковок = КоличествоУпаковок;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	КэшНоменклатуры1С = Новый Соответствие;
	Для Каждого Стр Из ТоварыАгрегатов Цикл
		
		Если ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаНоменклатуры = Товар_НайтиНоменклатуру1С(Стр.Товар, КэшНоменклатуры1С);
		Если ТаблицаНоменклатуры.Количество() = 1 Тогда
			Стр.КлючНоменклатуры1С = ТаблицаНоменклатуры[0].КлючНоменклатуры1С;
		КонецЕсли;
		
	КонецЦикла;
	
	ТоварыАгрегатов.Свернуть("ПорцияЗаписей, КлючКода, Товар, КлючНоменклатуры1С", "КоличествоУпаковок, Количество");
	
	ТаблицаКодов.Колонки.Удалить("ТоварыИзСервиса");
	
	ТаблицаКодов_УточнитьДанныеАгрегатовПоТоварам(ТаблицаКодов, ТоварыАгрегатов);
	ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
	ТоварыАгрегатов_Записать(ТоварыАгрегатов);
	
	// BSLLS:CognitiveComplexity-on
	// BSLLS:NestedStatements-on
	
КонецПроцедуры

// Записывает информацию о товарах агрегатов и количестве упаковок в регистры сведений:
// КонтурМаркировка_КодыМаркировки - для монотоварных агрегатов;
// КонтурМаркировка_ТоварыАгрегатов - для мультитоварных агрегатов;
//
// Параметры:
//  ТоварыАгрегатов - ТаблицаЗначений - см. Новый_ТоварыАгрегатов();
//
Процедура ТоварыАгрегатов_Записать(ТоварыАгрегатов) Экспорт
	
	Если Не ЗначениеЗаполнено(ТоварыАгрегатов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ЗаполнитьПорцииЗаписей(ТоварыАгрегатов);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТоварыАгрегатов_ЗаблокироватьПоТаблице(ТоварыАгрегатов);
		
		МенеджерВТ = ТоварыАгрегатов_ТаблицыДляЗаписи(ТоварыАгрегатов);
		
		ТоварыАгрегатов_ВТ_Записать(МенеджерВТ);
		КодыМаркировки_ВТ_Записать(МенеджерВТ);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ТоварыАгрегатов_ВТ_Записать(МенеджерВТ)
	
	Набор = ТоварыАгрегатов_ОписаниеНабораЗаписей();
	Набор.ТаблицаНабора = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаНабораТоварыАгрегатов", Истина);
	ЗаписатьНаборыРегистраСведенийСРазнымиРежимамиЗаписи(Набор);
	
КонецПроцедуры

Процедура ТоварыАгрегатов_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "ПорцияЗаписей")
	
	Поле = "ПорцияЗаписей";
	ИмяОбъекта = "РегистрСведений.КонтурМаркировка_ТоварыАгрегатов";
	ЗаблокироватьПоТаблице(ИмяОбъекта, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

Процедура ТоварыАгрегатов_ВТ_Удалить(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыАгрегатов.*
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО ТаблицаКодов.КлючКода = ТоварыАгрегатов.КлючКода");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ТоварыАгрегатов_ЗаблокироватьПоТаблице(РезультатЗапроса);
		
		Набор = ТоварыАгрегатов_ОписаниеНабораЗаписей();
		Набор.РежимЗаписи = Перечисление_РежимыЗаписиНабора().Удаление;
		Набор.ТаблицаНабора = Запрос.Выполнить().Выгрузить(); // Ответственное чтение
		ЗаписатьНаборРегистраСведений(Набор);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ТоварыАгрегатов_ТаблицыДляЗаписи(ТоварыАгрегатов)
	
	ПоляИндекса = "КлючКода, Товар, КлючНоменклатуры1С, ПорцияЗаписей";
	РежимыЗаписи = Перечисление_РежимыЗаписиНабора();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТоварыАгрегатов, "ТоварыАгрегатов", ПоляИндекса);
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыАгрегатов.КлючКода КАК КлючКода,
	|	КОЛИЧЕСТВО(*) КАК КоличествоЗаписей
	|ПОМЕСТИТЬ ТабКоличествоЗаписей
	|ИЗ
	|	ТоварыАгрегатов КАК ТоварыАгрегатов
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыАгрегатов.КлючКода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыАгрегатов.*
	|ПОМЕСТИТЬ ТабТоварыАгрегатов
	|ИЗ
	|	ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабКоличествоЗаписей КАК ТабКоличествоЗаписей
	|		ПО ТоварыАгрегатов.КлючКода = ТабКоличествоЗаписей.КлючКода
	|ГДЕ
	|	ТабКоличествоЗаписей.КоличествоЗаписей > 1
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТоварыАгрегатов.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыАгрегатов.КлючКода КАК КлючКода,
	|	ТоварыАгрегатов.ПорцияЗаписей КАК ПорцияЗаписей,
	|	СУММА(ТоварыАгрегатов.КоличествоУпаковок) КАК КоличествоУпаковок,
	|	СУММА(ТоварыАгрегатов.Количество) КАК Количество
	|ПОМЕСТИТЬ ТабКодыМаркировки
	|ИЗ
	|	ТоварыАгрегатов КАК ТоварыАгрегатов
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|	ПО ТоварыАгрегатов.КлючКода = КодыМаркировки.КлючКода
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|	ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ИнформацияОКодах.ОбщийТипУпаковки = &Транспортная
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыАгрегатов.КлючКода,
	|	ТоварыАгрегатов.ПорцияЗаписей
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТоварыАгрегатов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Обновление КАК РежимЗаписи,
	|	ТабКодыМаркировки.Количество КАК Количество,
	|	ТабКодыМаркировки.КоличествоУпаковок КАК КоличествоУпаковок,
	|	КодыМаркировки.*
	|ПОМЕСТИТЬ ТаблицаНабораКодыМаркировки
	|ИЗ
	|	ТабКодыМаркировки КАК ТабКодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабКодыМаркировки.КлючКода = КодыМаркировки.КлючКода
	|ГДЕ
	|	(ТабКодыМаркировки.Количество <> КодыМаркировки.Количество
	|			ИЛИ ТабКодыМаркировки.КоличествоУпаковок <> КодыМаркировки.КоличествоУпаковок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКодыМаркировки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Удаление КАК РежимЗаписи,
	|	ТоварыАгрегатов.ПорцияЗаписей КАК ПорцияЗаписей,
	|	ТоварыАгрегатов.КлючКода КАК КлючКода,
	|	ТоварыАгрегатов.Товар КАК Товар,
	|	ТоварыАгрегатов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	ТоварыАгрегатов.Количество КАК Количество,
	|	ТоварыАгрегатов.КоличествоУпаковок КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ТаблицаНабораТоварыАгрегатов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабТоварыАгрегатов КАК ТабТоварыАгрегатов
	|		ПО ТоварыАгрегатов.КлючКода = ТабТоварыАгрегатов.КлючКода
	|			И ТоварыАгрегатов.ПорцияЗаписей = ТабТоварыАгрегатов.ПорцияЗаписей
	|			И ТоварыАгрегатов.Товар = ТабТоварыАгрегатов.Товар
	|			И ТоварыАгрегатов.КлючНоменклатуры1С = ТабТоварыАгрегатов.КлючНоменклатуры1С
	|ГДЕ
	|	ТабТоварыАгрегатов.КлючКода ЕСТЬ NULL
	|	И ТоварыАгрегатов.КлючКода В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Т.КлючКода КАК КлючКода
	|			ИЗ
	|				ТабТоварыАгрегатов КАК Т)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Удаление,
	|	ТоварыАгрегатов.ПорцияЗаписей,
	|	ТоварыАгрегатов.КлючКода,
	|	ТоварыАгрегатов.Товар,
	|	ТоварыАгрегатов.КлючНоменклатуры1С,
	|	ТоварыАгрегатов.Количество,
	|	ТоварыАгрегатов.КоличествоУпаковок
	|ИЗ
	|	ТабКоличествоЗаписей КАК ТабКоличествоЗаписей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО ТабКоличествоЗаписей.КлючКода = ТоварыАгрегатов.КлючКода
	|ГДЕ
	|	ТабКоличествоЗаписей.КоличествоЗаписей = 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Обновление,
	|	ТабТоварыАгрегатов.ПорцияЗаписей,
	|	ТабТоварыАгрегатов.КлючКода,
	|	ТабТоварыАгрегатов.Товар,
	|	ТабТоварыАгрегатов.КлючНоменклатуры1С,
	|	ТабТоварыАгрегатов.Количество,
	|	ТабТоварыАгрегатов.КоличествоУпаковок
	|ИЗ
	|	ТабТоварыАгрегатов КАК ТабТоварыАгрегатов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО ТабТоварыАгрегатов.КлючКода = ТоварыАгрегатов.КлючКода
	|			И ТабТоварыАгрегатов.ПорцияЗаписей = ТоварыАгрегатов.ПорцияЗаписей
	|			И ТабТоварыАгрегатов.Товар = ТоварыАгрегатов.Товар
	|			И ТабТоварыАгрегатов.КлючНоменклатуры1С = ТоварыАгрегатов.КлючНоменклатуры1С
	|ГДЕ
	|	(ТабТоварыАгрегатов.Количество <> ТоварыАгрегатов.Количество
	|			ИЛИ ТабТоварыАгрегатов.КоличествоУпаковок <> ТоварыАгрегатов.КоличествоУпаковок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Добавление,
	|	ТабТоварыАгрегатов.ПорцияЗаписей,
	|	ТабТоварыАгрегатов.КлючКода,
	|	ТабТоварыАгрегатов.Товар,
	|	ТабТоварыАгрегатов.КлючНоменклатуры1С,
	|	ТабТоварыАгрегатов.Количество,
	|	ТабТоварыАгрегатов.КоличествоУпаковок
	|ИЗ
	|	ТабТоварыАгрегатов КАК ТабТоварыАгрегатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ТоварыАгрегатов КАК ТоварыАгрегатов
	|		ПО ТабТоварыАгрегатов.КлючКода = ТоварыАгрегатов.КлючКода
	|			И ТабТоварыАгрегатов.ПорцияЗаписей = ТоварыАгрегатов.ПорцияЗаписей
	|			И ТабТоварыАгрегатов.Товар = ТоварыАгрегатов.Товар
	|			И ТабТоварыАгрегатов.КлючНоменклатуры1С = ТоварыАгрегатов.КлючНоменклатуры1С
	|ГДЕ
	|	ТоварыАгрегатов.КлючКода ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКоличествоЗаписей");
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Удаление", РежимыЗаписи.Удаление);
	Запрос.УстановитьПараметр("Обновление", РежимыЗаписи.Обновление);
	Запрос.УстановитьПараметр("Добавление", РежимыЗаписи.Добавление);
	Запрос.УстановитьПараметр("Транспортная", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Запрос.Выполнить();
	
	Возврат МенеджерВТ;
	
КонецФункции

Функция ТоварыАгрегатов_ОписаниеНабораЗаписей()
	
	Возврат Новый_ОписаниеНабораРегистраСведений("КонтурМаркировка_ТоварыАгрегатов", "ПорцияЗаписей");
	
КонецФункции

Функция Новый_ТоварыАгрегатов() Экспорт
	
	КлючКэш = "ШаблонТоварыАгрегатов";
	Шаблон = Кэш_Прочитать(КлючКэш);
	Если Шаблон <> Неопределено Тогда
		Возврат Шаблон.СкопироватьКолонки();
	КонецЕсли;
	
	Шаблон = Новый ТаблицаЗначений;
	Шаблон.Колонки.Добавить("Товар", ОписаниеТипа_Товар());
	Шаблон.Колонки.Добавить("КлючНоменклатуры1С", ОписаниеТипа_КлючНоменклатуры1С());
	Шаблон.Колонки.Добавить("КоличествоУпаковок", ОписаниеТипа_Число());
	Шаблон.Колонки.Добавить("Количество", ОписаниеТипа_Число());
	Шаблон.Колонки.Добавить("КлючКода", ОписаниеТипа_Идентификатор());
	Шаблон.Колонки.Добавить("ПорцияЗаписей", ОписаниеТипа_Идентификатор());
	
	Кэш_Поместить(Шаблон, КлючКэш);
	
	Возврат Шаблон.СкопироватьКолонки();
	
КонецФункции

// #КонецОбласти // ТоварыАгрегатов

// #Область ТаблицаКодов

Процедура ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ПодобратьКонтрагентов(ТаблицаКодов);
	ТаблицаКодов_ПодобратьКлючиСтатусов(ТаблицаКодов);
	ТаблицаКодов_ПодобратьКлючиНоменклатуры1С(ТаблицаКодов);
	ТаблицаКодов_УточнитьДанныеАгрегатов(ТаблицаКодов);
	ТаблицаКодов_УточнитьДанныеНаборов(ТаблицаКодов);
	ТаблицаКодов_ЗаполнитьКолонкуЕстьПолныйКод(ТаблицаКодов);
	ТаблицаКодов_ПодобратьКлючиИнформацииОКодах(ТаблицаКодов);
	
	КодыМаркировки_Записать(ТаблицаКодов);
	
	ТаблицаКодов_ОбновитьТоварыАгрегатов(ТаблицаКодов);
	
КонецПроцедуры

Процедура ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	
	Если ТаблицаКодов_ЕстьКлючиКодов(ТаблицаКодов) Тогда
		КодыМаркировки_Прочитать(ТаблицаКодов);
		ИнформацияОКодах_Прочитать(ТаблицаКодов);
		СтатусыКодовГИСМТ_Прочитать(ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ТаблицаКодов_ДобавитьКлючиВсехВложенныхКодов(ТаблицаКодов) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов.Скопировать(, "КлючКода"), "ТаблицаКодов", "КлючКода");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ Таб1
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлюч
	|		ПО ТаблицаКодов.КлючКода = ПустойКлюч.Ключ
	|ГДЕ
	|	ПустойКлюч.Ключ ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПустойКлюч
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 0
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючКода КАК КлючАгрегата
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Т");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО Таб.КлючКода = КодыМаркировки.КлючАгрегата
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКодов КАК ТаблицаКодов
	|		ПО (КодыМаркировки.КлючКода = ТаблицаКодов.КлючКода)
	|ГДЕ
	|	ТаблицаКодов.КлючКода ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	Итог1 КАК Т
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Т.КлючКода,
	|	Т.КлючАгрегата
	|ИЗ
	|	Таб2 КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	
	Пока Истина Цикл
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	Если Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0 Тогда
		ТекстЗапроса = "ВЫБРАТЬ * ИЗ Итог1";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ * ИЗ Итог2";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерВТ.Закрыть();
	
	ТаблицаЗначений_ДобавитьИзВыборки(ТаблицаКодов, Выборка);
	
КонецПроцедуры

Процедура ТаблицаКодов_ПодобратьКонтрагентов(ТаблицаКодов)
	
	ТаблицаКодов.ЗаполнитьЗначения(ПустойКонтрагент(), "Владелец, Производитель");
	ТаблицаКодов.Колонки.Добавить("Обработан", ОписаниеТипа_Булево());
	
	КэшКонтрагентов = Новый Соответствие;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "ВладелецИНН");
	
	Отбор = Новый Структура("ВладелецИНН");
	Пока Истина Цикл
		
		Стр = ТаблицаКодов.Найти(Ложь, "Обработан");
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Контрагент = Контрагент_Подобрать(Стр.ВладелецИНН, , Стр.ВладелецНаименование, КэшКонтрагентов);
		Отбор.ВладелецИНН = Стр.ВладелецИНН;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			СтрКода.Владелец = Контрагент;
			СтрКода.Обработан = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "ВладелецИНН");
	
	ТаблицаКодов.ЗаполнитьЗначения(Ложь, "Обработан");
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "ПроизводительИНН");
	
	Отбор = Новый Структура("ПроизводительИНН");
	Пока Истина Цикл
		
		Стр = ТаблицаКодов.Найти(Ложь, "Обработан");
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Контрагент = Контрагент_Подобрать(Стр.ПроизводительИНН, , Стр.ПроизводительНаименование, КэшКонтрагентов);
		Отбор.ПроизводительИНН = Стр.ПроизводительИНН;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			СтрКода.Производитель = Контрагент;
			СтрКода.Обработан = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "ПроизводительИНН");
	
	ТаблицаКодов.Колонки.Удалить("Обработан");
	
КонецПроцедуры

Процедура ТаблицаКодов_ПодобратьКлючиНоменклатуры1С(ТаблицаКодов) Экспорт
	
	Если Не ТаблицаКодов_ЕстьПустыеКлючиНоменклатуры1С(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ИменаПолей = ИменаПолейАналитикиНоменклатуры1С();
	
	ОтборИменаПолей = Новый Структура(ИменаПолей);
	ОтборИменаПолей.Вставить("Обработан", Ложь);
	
	ОтборКлючНоменклатуры1С = Новый Структура("КлючНоменклатуры1С");
	
	ТаблицаКодов.Колонки.Добавить("Обработан", ОписаниеТипа_Булево());
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, ИменаПолей);
	
	Пока Истина Цикл
		
		Стр = ТаблицаКодов.Найти(Ложь, "Обработан");
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
			ОтборКлючНоменклатуры1С.КлючНоменклатуры1С = Стр.КлючНоменклатуры1С;
			Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(ОтборКлючНоменклатуры1С) Цикл
				СтрКода.Обработан = Истина;
			КонецЦикла;
		Иначе
			КлючНоменклатуры1С = КлючНоменклатуры1С_Подобрать(Стр);
			ЗаполнитьЗначенияСвойств(ОтборИменаПолей, Стр);
			Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(ОтборИменаПолей) Цикл
				СтрКода.КлючНоменклатуры1С = КлючНоменклатуры1С;
				СтрКода.Обработан = Истина;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, ИменаПолей);
	
	ТаблицаКодов.Колонки.Удалить("Обработан");
	
КонецПроцедуры

Процедура ТаблицаКодов_ПодобратьКлючиНоменклатуры1СПоТоварам(ТаблицаКодов) Экспорт
	
	ТаблицаКодов.Колонки.Добавить("Обработан", ОписаниеТипа_Булево());
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючНоменклатуры1С, Товар");
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "Обработан");
	
	КэшНоменклатуры1С = Новый Соответствие;
	ОтборКлючНоменклатуры1С = Новый Структура("КлючНоменклатуры1С");
	ОтборКлючТовар = Новый Структура("КлючНоменклатуры1С, Товар");
	ОтборКлючТовар.КлючНоменклатуры1С = ПустойКлючНоменклатуры1С();
	
	Пока Истина Цикл
		
		Стр = ТаблицаКодов.Найти(Ложь, "Обработан");
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КлючНоменклатуры1С) Тогда
			
			ОтборКлючНоменклатуры1С.КлючНоменклатуры1С = Стр.КлючНоменклатуры1С;
			Для Каждого СтрКода Из ТаблицаКодов.НайтиСтроки(ОтборКлючНоменклатуры1С) Цикл
				СтрКода.Обработан = Истина;
			КонецЦикла;
			
		Иначе
			
			ТаблицаНоменклатуры = Товар_НайтиНоменклатуру1С(Стр.Товар, КэшНоменклатуры1С);
			Если ТаблицаНоменклатуры.Количество() = 1 Тогда
				Стр.КлючНоменклатуры1С = ТаблицаНоменклатуры[0].КлючНоменклатуры1С;
			КонецЕсли;
			
			ОтборКлючТовар.Товар = Стр.Товар;
			Для Каждого СтрКода Из ТаблицаКодов.НайтиСтроки(ОтборКлючТовар) Цикл
				СтрКода.КлючНоменклатуры1С = Стр.КлючНоменклатуры1С;
				СтрКода.Обработан = Истина;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючНоменклатуры1С, Товар");
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "Обработан");
	ТаблицаКодов.Колонки.Удалить("Обработан");
	
КонецПроцедуры

