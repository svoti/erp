Процедура ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов) Экспорт
	
	ТаблицаКодов_ЗаполнитьХешСуммы(ТаблицаКодов);
	
	Если Не ТаблицаКодов_ЕстьПустыеКлючиКодов(ТаблицаКодов) Тогда
		ТаблицаКодов_ЗаполнитьПорцииЗаписей(ТаблицаКодов);
		Возврат;
	КонецЕсли;
	
	ИменаКолонок = "КодМаркировки, ХешСуммаКодаМаркировки";
	ПустойКлюч = ПустойУникальныйИдентификатор();
	
	ТабКодов = ТаблицаКодов.Скопировать(Новый Структура("КлючКода", ПустойКлюч), ИменаКолонок);
	ТаблицаЗначений_УдалитьПустыеСтроки(ТабКодов, "КодМаркировки");
	Если Не ЗначениеЗаполнено(ТабКодов) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТабКодов, "ТабКодов", ИменаКолонок);
	ТабКодов.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТабКодов.КодМаркировки КАК КодМаркировки,
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабКодов.КодМаркировки = КодыМаркировки.КодМаркировки
	|			И ТабКодов.ХешСуммаКодаМаркировки = КодыМаркировки.ХешСуммаКодаМаркировки");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ТаблицаКодов_ЗаполнитьПорцииЗаписей(ТаблицаКодов);
		Возврат;
	КонецЕсли;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КодМаркировки");
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрКода = ТаблицаКодов.Найти(Выборка.КодМаркировки, "КодМаркировки");
		СтрКода.КлючКода = Выборка.КлючКода;
		СтрКода.ПорцияЗаписей = Выборка.ПорцияЗаписей;
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КодМаркировки");
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьПорцииЗаписей(ТаблицаКодов)
	
	Если Не ТаблицаКодов_ЕстьПустыеПорцииЗаписей(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТабКодов = ТаблицаКодов.Скопировать(Новый Структура("ПорцияЗаписей", ПустойУникальныйИдентификатор()), "КлючКода");
	ТаблицаЗначений_УдалитьПустыеСтроки(ТабКодов, "КлючКода");
	КлючиКодов = ТабКодов.ВыгрузитьКолонку("КлючКода");
	ТабКодов.Очистить();
	Если Не ЗначениеЗаполнено(КлючиКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК Т
	|ГДЕ
	|	Т.КлючКода В(&КлючиКодов)");
	Запрос.УстановитьПараметр("КлючиКодов", КлючиКодов);
	РезультатЗапроса = Запрос.Выполнить();
	КлючиКодов.Очистить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючКода");
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТаблицаКодов.Найти(Выборка.КлючКода, "КлючКода").ПорцияЗаписей = Выборка.ПорцияЗаписей;
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючКода");
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьКлючиНовыхКодов(ТаблицаКодов)
	
	СтрокиНовыхКодов = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючКода", ПустойУникальныйИдентификатор()));
	Если Не ЗначениеЗаполнено(СтрокиНовыхКодов) Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначения = МодульОбщегоНазначения();
	
	Для Каждого Стр Из СтрокиНовыхКодов Цикл
		Стр.КлючКода = МодульОбщегоНазначения.НовыйУникальныйИдентификаторПервойВерсии();
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьКлючиНовыхПорций(ТаблицаКодов)
	
	СтрокиНовыхПорций = ТаблицаКодов.НайтиСтроки(Новый Структура("ПорцияЗаписей", ПустойУникальныйИдентификатор()));
	Если Не ЗначениеЗаполнено(СтрокиНовыхПорций) Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначения = МодульОбщегоНазначения();
	РазмерПорции = НастройкиМодуля().МаксимальноеКоличествоКодовВОднойПорции;
	
	Для Индекс = 0 По СтрокиНовыхПорций.Количество() - 1 Цикл
		Если Индекс % РазмерПорции = 0 Или Индекс = 0 Тогда
			НоваяПорция = МодульОбщегоНазначения.НовыйУникальныйИдентификаторПервойВерсии();
		КонецЕсли;
		СтрокиНовыхПорций[Индекс].ПорцияЗаписей = НоваяПорция;
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьКлючиАгрегатов(ТаблицаКодов)
	
	Если Не ТаблицаКодов_ЕстьКодыАгрегатов(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов.Колонки.Добавить("Обработан", ОписаниеТипа_Булево());
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "Обработан");
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КодАгрегата");
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КодМаркировки");
	
	КодыАгрегатов = ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КодАгрегата", Истина);
	ТаблицаАгрегатов = ТаблицаКодов_ЗагрузитьКодыМаркировки(КодыАгрегатов);
	КодыАгрегатов.Очистить();
	
	Для Каждого СтрАгрегата Из ТаблицаАгрегатов Цикл
		СтрКода = ТаблицаКодов.Найти(СтрАгрегата.КодМаркировки, "КодМаркировки");
		Если СтрКода <> Неопределено Тогда
			СтрАгрегата.КлючКода = СтрКода.КлючКода;
		КонецЕсли;
	КонецЦикла;
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаАгрегатов);
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаАгрегатов, "КодМаркировки");
	
	ПустойКлюч = ПустойУникальныйИдентификатор();
	Отбор = Новый Структура("КодАгрегата");
	
	Пока Истина Цикл
		
		Стр = ТаблицаКодов.Найти(Ложь, "Обработан");
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КодАгрегата) Тогда
			СтрАгрегата = ТаблицаАгрегатов.Найти(Стр.КодАгрегата, "КодМаркировки");
			Если СтрАгрегата = Неопределено Тогда
				ТекстОшибки = НСтр("ru = 'Не удалось найти в базе агрегат ""%1"", в который упакован код ""%2""'");
				ТекстОшибки = ПараметрыВСтроку(ТекстОшибки
				, УдалитьНедопустимыеСимволыXML(Стр.КодАгрегата)
				, УдалитьНедопустимыеСимволыXML(Стр.КодМаркировки));
				ВызватьИсключение ТекстОшибки;
			Иначе
				КлючАгрегата = СтрАгрегата.КлючКода;
			КонецЕсли;
		Иначе
			КлючАгрегата = ПустойКлюч;
		КонецЕсли;
		
		Отбор.КодАгрегата = Стр.КодАгрегата;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			СтрКода.КлючАгрегата = КлючАгрегата;
			СтрКода.Обработан = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "Обработан");
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КодАгрегата");
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КодМаркировки");
	
	ТаблицаКодов.Колонки.Удалить("Обработан");
	
КонецПроцедуры

Процедура ТаблицаКодов_ОбновитьТоварыАгрегатов(ТаблицаКодов)
	
	Если Не ТаблицаКодов_ЕстьАгрегатыИВложенныеКоды(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КодАгрегата");
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючАгрегата");
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "ОбщийТипУпаковки");
	
	Отбор = Новый Структура("ОбщийТипУпаковки", ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	СтрокиАгрегатов = ТаблицаКодов.НайтиСтроки(Отбор);
	
	Отбор = Новый Структура("ОбщийТипУпаковки", ОбщиеТипыУпаковок.Набор);
	ДополнитьМассив(СтрокиАгрегатов, ТаблицаКодов.НайтиСтроки(Отбор), Истина);
	
	ТоварыАгрегатов = Новый_ТоварыАгрегатов();
	Для каждого СтрАгрегата Из СтрокиАгрегатов Цикл
		Для каждого СтрКода Из ТаблицаКодов_ТоварныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата) Цикл
			Стр = ТоварыАгрегатов.Добавить();
			Стр.Товар = СтрКода.Товар;
			Стр.КлючНоменклатуры1С = СтрКода.КлючНоменклатуры1С;
			Стр.КлючКода = СтрАгрегата.КлючКода;
			Стр.ПорцияЗаписей = СтрАгрегата.ПорцияЗаписей;
			Стр.Количество = СтрКода.Количество;
			Стр.КоличествоУпаковок = 1;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КодАгрегата");
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючАгрегата");
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "ОбщийТипУпаковки");
	
	ТоварыАгрегатов.Свернуть("ПорцияЗаписей, КлючКода, Товар, КлючНоменклатуры1С", "Количество, КоличествоУпаковок");
	
	ТоварыАгрегатов_Записать(ТоварыАгрегатов);
	
КонецПроцедуры

Процедура ТаблицаКодов_УточнитьДанныеАгрегатов(ТаблицаКодов) Экспорт
	
	Если Не ТаблицаКодов_ЕстьАгрегатыИВложенныеКоды(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючАгрегата");
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КодАгрегата");
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "ТипУпаковки");
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "ОбщийТипУпаковки");
	
	ТипыУпаковок = Перечисления.КонтурМаркировка_ТипыУпаковок;
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	Отбор = Новый Структура("ТипУпаковки", ТипыУпаковок.МонотоварнаяУпаковка);
	СтрокиАгрегатов = ТаблицаКодов.НайтиСтроки(Отбор);
	
	Отбор = Новый Структура("ТипУпаковки", ТипыУпаковок.МультитоварнаяУпаковка);
	ДополнитьМассив(СтрокиАгрегатов, ТаблицаКодов.НайтиСтроки(Отбор));
	
	Отбор = Новый Структура("ОбщийТипУпаковки", ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	ДополнитьМассив(СтрокиАгрегатов, ТаблицаКодов.НайтиСтроки(Отбор), Истина);
	
	Для Каждого СтрАгрегата Из СтрокиАгрегатов Цикл
		
		Если СтрАгрегата.ОбщийТипУпаковки = ОбщиеТипыУпаковок.Набор Тогда
			Продолжить;
		КонецЕсли;
		
		ВложенныеСтроки = ТаблицаКодов_ТоварныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата);
		Если Не ЗначениеЗаполнено(ВложенныеСтроки) Тогда
			ВложенныеСтроки = ТаблицаКодов_ВложенныеСтрокиАгрегата(ТаблицаКодов, СтрАгрегата);
			Если Не ЗначениеЗаполнено(ВложенныеСтроки) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Товар = Неопределено;
		ВидПродукции = Неопределено;
		КлючНоменклатуры1С = Неопределено;
		КлючСтрокиДокумента = Неопределено;
		
		ЭтоПерваяСтрока = Истина;
		
		Для каждого СтрКода Из ВложенныеСтроки Цикл
			
			Если ЭтоПерваяСтрока Тогда
				Товар = СтрКода.Товар;
				ВидПродукции = СтрКода.ВидПродукции;
				КлючНоменклатуры1С = СтрКода.КлючНоменклатуры1С;
				КлючСтрокиДокумента = СтрКода.КлючСтрокиДокумента;
				ЭтоПерваяСтрока = Ложь;
			КонецЕсли;
			
			Если КлючСтрокиДокумента <> СтрКода.КлючСтрокиДокумента Тогда
				КлючСтрокиДокумента = Неопределено;
			КонецЕсли;
			
			Если Товар <> СтрКода.Товар Тогда
				Товар = Неопределено;
			КонецЕсли;
			
			Если ВидПродукции <> СтрКода.ВидПродукции Тогда
				ВидПродукции = Неопределено;
			КонецЕсли;
			
			Если КлючНоменклатуры1С <> СтрКода.КлючНоменклатуры1С Тогда
				КлючНоменклатуры1С = Неопределено;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Товар)
				И Не ЗначениеЗаполнено(ВидПродукции)
				И Не ЗначениеЗаполнено(КлючНоменклатуры1С)
				И ЗначениеЗаполнено(КлючСтрокиДокумента) Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Товар) Тогда
			СтрАгрегата.Товар = Товар;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидПродукции) Тогда
			СтрАгрегата.ВидПродукции = ВидПродукции;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
			СтрАгрегата.КлючНоменклатуры1С = КлючНоменклатуры1С;
			ЗаполнитьЗначенияСвойств(СтрАгрегата, КлючНоменклатуры1С);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрАгрегата.ОбщийТипУпаковки) Тогда
			// АТК всегда указывается, значит это транспортная упаковка
			СтрАгрегата.ОбщийТипУпаковки = ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрАгрегата.КлючСтрокиДокумента) Тогда
			СтрАгрегата.КлючСтрокиДокумента = КлючСтрокиДокумента;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрАгрегата.Товар) Тогда
			СтрАгрегата.ВидПродукции = СтрАгрегата.Товар.ВидПродукции;
			СтрАгрегата.ТипУпаковки = ТипыУпаковок.МонотоварнаяУпаковка;
		Иначе
			СтрАгрегата.ТипУпаковки = ТипыУпаковок.МультитоварнаяУпаковка;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КодАгрегата");
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючАгрегата");
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "ТипУпаковки");
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "ОбщийТипУпаковки");
	
КонецПроцедуры

Процедура ТаблицаКодов_УточнитьДанныеАгрегатовПоТоварам(ТаблицаКодов, ТоварыАгрегатов) Экспорт
	
	ТипыУпаковок = Перечисления.КонтурМаркировка_ТипыУпаковок;
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	ИндексТоварыАгрегатов = ТоварыАгрегатов.Индексы.Добавить("КлючКода");
	
	Отбор = Новый Структура("ОбщийТипУпаковки", ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Для каждого СтрАгрегата Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
		
		СтрокиТоваров = ТоварыАгрегатов.НайтиСтроки(Новый Структура("КлючКода", СтрАгрегата.КлючКода));
		Если не ЗначениеЗаполнено(СтрокиТоваров) Тогда
			Продолжить;
		КонецЕсли;
		
		Товар = Неопределено;
		ВидПродукции = Неопределено;
		КлючНоменклатуры1С = Неопределено;
		
		ЭтоПерваяСтрока = Истина;
		
		Для каждого СтрТовара Из СтрокиТоваров Цикл
			
			Если ЭтоПерваяСтрока Тогда
				Товар = СтрТовара.Товар;
				ВидПродукции = СтрТовара.Товар.ВидПродукции;
				КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
				ЭтоПерваяСтрока = Ложь;
			КонецЕсли;
			
			Если Товар <> СтрТовара.Товар Тогда
				Товар = Неопределено;
			КонецЕсли;
			
			Если ВидПродукции <> СтрТовара.Товар.ВидПродукции Тогда
				ВидПродукции = Неопределено;
			КонецЕсли;
			
			Если КлючНоменклатуры1С <> СтрТовара.КлючНоменклатуры1С Тогда
				КлючНоменклатуры1С = Неопределено;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Товар)
				И Не ЗначениеЗаполнено(ВидПродукции)
				И Не ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		СтрАгрегата.Товар = Товар;
		СтрАгрегата.ВидПродукции = ВидПродукции;
		
		Если ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
			СтрАгрегата.КлючНоменклатуры1С = КлючНоменклатуры1С;
			ЗаполнитьЗначенияСвойств(СтрАгрегата, КлючНоменклатуры1С);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрАгрегата.Товар) Тогда
			СтрАгрегата.GTIN = СтрАгрегата.Товар.GTIN;
			СтрАгрегата.ВидПродукции = СтрАгрегата.Товар.ВидПродукции;
			СтрАгрегата.ТипУпаковки = ТипыУпаковок.МонотоварнаяУпаковка;
		Иначе
			СтрАгрегата.ТипУпаковки = ТипыУпаковок.МультитоварнаяУпаковка;
		КонецЕсли;
		
	КонецЦикла;
	
	ТоварыАгрегатов.Индексы.Удалить(ИндексТоварыАгрегатов);
	
КонецПроцедуры

Процедура ТаблицаКодов_УточнитьДанныеНаборов(ТаблицаКодов) Экспорт
	
	ТипыУпаковок = Перечисления.КонтурМаркировка_ТипыУпаковок;
	ОбщиеТипыУпаковок = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок;
	
	Отбор = Новый Структура("ОбщийТипУпаковки", ОбщиеТипыУпаковок.Набор);
	СтрокиНаборов = ТаблицаКодов.НайтиСтроки(Отбор);
	
	КэшТоваров = Новый Соответствие;
	
	Для Каждого СтрНабора Из СтрокиНаборов Цикл
		
		Если ЗначениеЗаполнено(СтрНабора.Товар) Тогда
			
			Если ЭтоМультитоварныйНабор(СтрНабора.Товар, КэшТоваров) Тогда
				СтрНабора.ТипУпаковки = ТипыУпаковок.МультитоварнаяУпаковка;
			Иначе
				СтрНабора.ТипУпаковки = ТипыУпаковок.МонотоварнаяУпаковка;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьКолонкуЕстьПолныйКод(ТаблицаКодов)
	
	ТранспортнаяУпаковка = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
	
	Для Каждого Стр Из ТаблицаКодов.НайтиСтроки(Новый Структура("ЕстьПолныйКод", Ложь)) Цикл
		
		Если Стр.ПолныйКод <> "" Тогда
			
			Если Стр.ПолныйКод = Стр.КодМаркировки
				И Стр.ОбщийТипУпаковки <> ТранспортнаяУпаковка Тогда
				Продолжить; // Передали нормализованный код вместо полного кода
			КонецЕсли;
			
			Стр.ЕстьПолныйКод = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ЗаполнитьХешСуммы(ТаблицаКодов)
	
	СтрокиКодов = ТаблицаКодов.НайтиСтроки(Новый Структура("ХешСуммаКодаМаркировки", ""));
	Для Сч = -СтрокиКодов.ВГраница() По 0 Цикл
		Если Не ЗначениеЗаполнено(СтрокиКодов[-Сч].КодМаркировки) Тогда
			СтрокиКодов.Удалить(-Сч);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(СтрокиКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ХешСуммы = ХешСуммыСтрок(МассивСтруктур_Выгрузить(СтрокиКодов, "КодМаркировки"));
	
	Для Сч = 0 По СтрокиКодов.ВГраница() Цикл
		СтрокиКодов[Сч].ХешСуммаКодаМаркировки = ХешСуммы[Сч];
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ВосстановитьВПолныхКодахРазделителиGS1(ТаблицаКодов)
	
	Пробел = " ";
	Эквивалент = ЭквивалентРазделителяGS1();
	ЭквивалентВРег = ВРег(Эквивалент);
	РазделительGS1 = РазделительGS1();
	
	Для каждого Стр Из ТаблицаКодов Цикл
		Если ЗначениеЗаполнено(Стр.ПолныйКод) Тогда
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, Пробел, РазделительGS1);
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, Эквивалент, РазделительGS1);
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, ЭквивалентВРег, РазделительGS1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ВосстановитьРазделителиGS1(ТаблицаКодов) Экспорт
	
	Пробел = " ";
	Эквивалент = ЭквивалентРазделителяGS1();
	ЭквивалентВРег = ВРег(Эквивалент);
	РазделительGS1 = РазделительGS1();
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, Пробел, РазделительGS1);
		Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, Эквивалент, РазделительGS1);
		Стр.КодМаркировки = СтрЗаменить(Стр.КодМаркировки, ЭквивалентВРег, РазделительGS1);
		
		Стр.КодАгрегата = СтрЗаменить(Стр.КодАгрегата, Пробел, РазделительGS1);
		Стр.КодАгрегата = СтрЗаменить(Стр.КодАгрегата, Эквивалент, РазделительGS1);
		Стр.КодАгрегата = СтрЗаменить(Стр.КодАгрегата, ЭквивалентВРег, РазделительGS1);
		
		Если ЗначениеЗаполнено(Стр.ПолныйКод) Тогда
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, Пробел, РазделительGS1);
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, Эквивалент, РазделительGS1);
			Стр.ПолныйКод = СтрЗаменить(Стр.ПолныйКод, ЭквивалентВРег, РазделительGS1);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов) Экспорт
	
	ТаблицаЗначений_ДополнитьКолонки(ТаблицаКодов, Новый_ТаблицаКодов());
	
КонецПроцедуры

Процедура ТаблицаКодов_ДобавитьКолонкиДляПроверкиКодов(ТаблицаКодов)
	
	ТипСтрока100 = ОписаниеТипа_Строка100();
	
	ТаблицаКодов.Колонки.Добавить("ПроверятьКод", ОписаниеТипа_Булево());
	ТаблицаКодов.Колонки.Добавить("ПроверкаСтатуса", ТипСтрока100);
	ТаблицаКодов.Колонки.Добавить("ПроверкаВладельца", ТипСтрока100);
	ТаблицаКодов.Колонки.Добавить("ПроверкаРД", ТипСтрока100);
	ТаблицаКодов.Колонки.Добавить("ДопПроверка1", ТипСтрока100);
	ТаблицаКодов.Колонки.Добавить("ДопПроверка2", ТипСтрока100);
	
КонецПроцедуры

Процедура ТаблицаКодов_ДобавитьКлючиТранспортныхУпаковокПоДеревуАгрегатов(ТаблицаКодов, СтрокиДерева, КлючАгрегата = Неопределено) Экспорт
	
	Отбор = Новый Структура("КлючАгрегата, Товар, КлючНоменклатуры1С");
	Отбор.КлючАгрегата = ПустойУникальныйИдентификатор();
	
	Для Каждого Стр Из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(Стр.ВидАгрегата) Тогда
			// Строка агрегата
			Для Сч = 1 По Стр.КоличествоАгрегатов Цикл
				СтрАгрегата = ТаблицаКодов.Добавить();
				СтрАгрегата.КлючКода = МодульОбщегоНазначения().НовыйУникальныйИдентификаторПервойВерсии();
				СтрАгрегата.ВидАгрегата = Стр.ВидАгрегата;
				СтрАгрегата.ТипШтрихкода = Стр.ВидАгрегата.ТипШтрихкода;
				СтрАгрегата.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка;
				СтрАгрегата.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
				СтрАгрегата.КлючАгрегата = КлючАгрегата;
				ТаблицаКодов_ДобавитьКлючиТранспортныхУпаковокПоДеревуАгрегатов(ТаблицаКодов, Стр.Строки, СтрАгрегата.КлючКода);
			КонецЦикла;
		Иначе
			// Строка товара
			КоличествоКодовПодобрано = 0;
			ЗаполнитьЗначенияСвойств(Отбор, Стр);
			Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
				Если КоличествоКодовПодобрано = Стр.КоличествоКодов Тогда
					Прервать;
				КонецЕсли;
				СтрКода.КлючАгрегата = КлючАгрегата;
				КоличествоКодовПодобрано = КоличествоКодовПодобрано + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаКодов_ВТ_ДобавитьКлючиАгрегатовВерхнегоУровня(МенеджерВТ) Экспорт
	
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	КодыМаркировки.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Таб1
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТаблицаКодов.КлючКода = КодыМаркировки.КлючКода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода,
	|	ПустойКлючАгрегата.Ключ
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТаблицаКодов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлючАгрегата
	|		ПО (ИСТИНА)
	|ГДЕ
	|	КодыМаркировки.КлючКода ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Итог1
	|ИЗ
	|	Таб1 КАК Т");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Таб2
	|ИЗ
	|	Таб1 КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО Таб.КлючАгрегата = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКодов КАК ТаблицаКодов
	|		ПО Таб.КлючАгрегата = ТаблицаКодов.КлючКода
	|ГДЕ
	|	ТаблицаКодов.КлючКода ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата
	|ПОМЕСТИТЬ Итог2
	|ИЗ
	|	Итог1 КАК Т
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.КлючКода,
	|	Т.КлючАгрегата
	|ИЗ
	|	Таб2 КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Таб1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Итог1";
	
	Пока Истина Цикл
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Выборка = Запрос.ВыполнитьПакет().Получить(0).Выбрать();
		Выборка.Следующий();
		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	УдалитьТаблицуИзЗапроса(МенеджерВТ, "ТаблицаКодов");
	
	ЕстьИтог1 = Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0;
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ТаблицаКодов ИЗ Итог2 ИНДЕКСИРОВАТЬ ПО КлючКода; УНИЧТОЖИТЬ Таб2; УНИЧТОЖИТЬ Итог2";
	
	Если ЕстьИтог1 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Итог2", "Итог1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Таб2", "Таб1");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ТаблицаКодов_ВТ_ДобавитьКлючиВсехВложенныхКодов(МенеджерВТ) Экспорт
	
