Функция ИдентификаторПользователяОС()
	
	КлючКэш = "ИдентификаторПользователяОС";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	СистемнаяИнформация1 = ИнформацияОСистеме();
	СистемнаяИнформация2 = ИнформацияОСистеме();
	
	Если СистемнаяИнформация1.ИдентификаторКлиента = СистемнаяИнформация2.ИдентификаторКлиента Тогда
		Результат = СистемнаяИнформация1.ИдентификаторКлиента;
	Иначе
		// https://devtrainingforum.v8.1c.ru/forum/thread.jsp?id=588350&threadtype=0
		// Константа - Ошибка идентификации клиента, переменный идентификатор
		Результат = Новый УникальныйИдентификатор("d808d128-2d0e-498e-a728-20bdbe6aae56");
	КонецЕсли;
	
	Если Строка(Результат) = СтрокаПустогоИдентификатора() Тогда
		// Константа - Ошибка идентификации клиента, пустой идентификатор
		Результат = Новый УникальныйИдентификатор("d808d128-7a45-43c4-88f2-7d666470b842");
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторПользователяИБ()
	
	КлючКэш = "ИдентификаторПользователяИБ";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
	ЭтоАнонимныйПользователь = (Строка(Результат) = "071523a4-516f-4fce-ba4b-0d11ab7a1893");
	
	Если ЭтоАнонимныйПользователь Тогда
		Результат = ИдентификаторПользователяОС();
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИнформационнойБазы() Экспорт
	
	КлючКэш = "ИдентификаторИнформационнойБазы";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ИдентификаторИнформационнойБазыБСП();
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ИдентификаторИнформационнойБазыКонтур();
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ВариантХраненияИдентификатораИБ()
	
	ВариантыХранения = Перечисление_ВариантыХраненияИдентификатораИБ();
	
	Если ДоступенВариант_КонстантаКонтур() Тогда
		Результат = ВариантыХранения.КонстантаКонтура;
	ИначеЕсли ДоступенВариант_РегистрДополнительныеСведения() Тогда
		Результат = ВариантыХранения.ДополнительныеСведения;
	ИначеЕсли ДоступенВариант_РегистрЗначенияСвойствОбъектов() Тогда
		Результат = ВариантыХранения.ЗначенияСвойствОбъектов;
	ИначеЕсли ДоступенВариант_Файл() Тогда
		Результат = ВариантыХранения.Файл;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификатор информационной базы
// вычисленный методом БСП
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазыБСП()
	
	Если Не ЕстьМетаданные("ОбщиеМодули.СтандартныеПодсистемыСервер") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Результат = МодульСтандартныеПодсистемыСервер().ИдентификаторИнформационнойБазы();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификатор информационной базы
// вычисленный бизнес-логикой библиотеки
//
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазыКонтур()
	
	ВариантыХранения = Перечисление_ВариантыХраненияИдентификатораИБ();
	ВариантХранения = ВариантХраненияИдентификатораИБ();
	
	Если ВариантХранения = ВариантыХранения.КонстантаКонтура Тогда
		
		Результат = ИдентификаторИнформационнойБазыИзКонстанты();
		
	ИначеЕсли ВариантХранения = ВариантыХранения.ДополнительныеСведения Тогда
		
		Результат = ИдентификаторИнформационнойБазыИзРегистраДополнительныеСведения();
		
	ИначеЕсли ВариантХранения = ВариантыХранения.ЗначенияСвойствОбъектов Тогда
		
		Результат = ИдентификаторИнформационнойБазыИзРегистраЗначенияСвойствОбъектов();
		
	ИначеЕсли ВариантХранения = ВариантыХранения.Файл Тогда
		
		Результат = ИдентификаторИнформационнойБазыИзФайла();
		
	Иначе
		
		Результат = ИдентификаторИнформационнойБазыНеОпределен();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИнформационнойБазыИзКонстанты()
	
	Результат = ПрочитатьКонстантуИдентификаторИнформационнойБазы();
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
