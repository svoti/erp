Процедура Товар_Записать_СоставНабора(ОбъектТовара, ОписаниеТовара)
	
	ОбъектТовара.СоставНабора.Очистить();
	
	Для каждого Стр Из ОписаниеТовара.СоставНабора Цикл
		Если Не ЗначениеЗаполнено(Стр.ВложенныйТовар) Тогда
			ОбъектТовара.СоставНабора.Очистить();
			Прервать;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ОбъектТовара.СоставНабора.Добавить(), Стр);
	КонецЦикла;
	
