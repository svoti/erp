// #Область РасформированиеАТК

Функция ОчередьОбмена_РасформированиеАТК_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеРасформированиеАТК);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКонтентДляПодписиРасформированияАТК);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусРасформированияАТК);
	Результат.Добавить(ТребуемыеДействия.РасформироватьАТКПослеРегистрации);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_РасформированиеАТК_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьВСервисеРасформированиеАТК Тогда
		Задача_РасформированиеАТК_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКонтентДляПодписиРасформированияАТК Тогда
		Задача_РасформированиеАТК_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_РасформированиеАТК_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусРасформированияАТК Тогда
		Задача_РасформированиеАТК_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.РасформироватьАТКПослеРегистрации Тогда
		Задача_РасформированиеАТК_РасформироватьАТКПослеРегистрации(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_РасформированиеАТК_СоздатьВСервисе(ОписаниеЗадачи)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ВидПродукции = ЗначениеРеквизитаОбъектаЛок(Операция, "ВидПродукции");
	
	УдалосьОбновить = Операция_ОбновитьСтатусыКодов(Операция);
	Если Не УдалосьОбновить Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	МассивКодов = Новый Массив;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.Статус <> СтатусыКодов.Разагрегирован
			И Стр.Статус <> СтатусыКодов.НеНайден Тогда
			МассивКодов.Добавить(Стр.КодМаркировки);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(МассивКодов) Тогда
		НовоеДействие = ТребуемыеДействия.РасформироватьАТКПослеРегистрации;
		НовыйСтатус = СтатусыОпераций.ОжиданиеГотовности;
		Задача_Записать(ОписаниеЗадачи);
		Возврат;
	КонецЕсли;
	
	Контент = Контент_РасформированиеАТК(ВидПродукции, МассивКодов);
	
	Попытка
		Ответ = Маркировка_РасформированиеАТК_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПолучитьКонтентДляПодписиРасформированияАТК;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Метрика_Функциональность_РасформированиеАТК(Организация);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_РасформированиеАТК_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
