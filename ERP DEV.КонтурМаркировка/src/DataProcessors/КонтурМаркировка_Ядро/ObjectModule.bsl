	НачДействия.Вставить(ТипыОпер.ФормированиеАТК,                   ОчередьОбмена_ФормированиеАТК_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпер.РасформированиеАТК,                ОчередьОбмена_РасформированиеАТК_БизнесПроцесс()[0]);
	НачДействия.Вставить(ТипыОпер.ДобавлениеВАТК,                    ОчередьОбмена_ТрансформацияАТК_БизнесПроцесс()[0]);
