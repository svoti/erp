// #Область СтатусыКодовГИСМТ

Процедура СтатусыКодовГИСМТ_Прочитать(ТаблицаКодов) Экспорт
	
	Если Не ТаблицаКодов_ЕстьКлючиСтатусовКодов(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	КлючиСтатусов = ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КлючСтатусаКода", Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Производитель.Наименование КАК ПроизводительНаименование,
	|	Т.Производитель.ИНН КАК ПроизводительИНН,
	|	Т.Владелец.Наименование КАК ВладелецНаименование,
	|	Т.Владелец.ИНН КАК ВладелецИНН,
	|	Т.*
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК Т
	|ГДЕ
	|	Т.КлючСтатусаКода В(&КлючиСтатусов)");
	Запрос.УстановитьПараметр("КлючиСтатусов", КлючиСтатусов);
	РезультатЗапроса = Запрос.Выполнить();
	КлючиСтатусов.Очистить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючСтатусаКода");
	
	Отбор = Новый Структура("КлючСтатусаКода");
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Отбор.КлючСтатусаКода = Выборка.КлючСтатусаКода;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			ЗаполнитьЗначенияСвойств(СтрКода, Выборка);
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючСтатусаКода");
	
КонецПроцедуры

Процедура СтатусыКодовГИСМТ_УдалитьУстаревшие()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючСтатусаКода КАК КлючСтатусаКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	
	// BSLLS:CreateQueryInCycle-off
	
	Пока Выборка.Следующий() Цикл
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.КлючСтатусаКода КАК КлючСтатусаКода
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК Т
		|ГДЕ
		|	Т.КлючСтатусаКода = &КлючСтатусаКода");
		Запрос.УстановитьПараметр("КлючСтатусаКода", Выборка.КлючСтатусаКода);
		
		Если Запрос.Выполнить().Пустой() Тогда
			НаборЗаписей = РегистрыСведений.КонтурМаркировка_СтатусыКодовГИСМТ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.КлючСтатусаКода.Установить(Выборка.КлючСтатусаКода);
			НаборЗаписей.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
КонецПроцедуры

Функция СтатусыКодовГИСМТ_ЗаполнитьСтроку(СтрокаТаблицы, CisInfo) Экспорт
	
	Статус = СтатусКодаПоСтатусуИзСервиса(CisInfo);
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаТаблицы.Статус = Статус;
	
	value = CisInfo["value"];
	Если ЗначениеЗаполнено(value) Тогда
		
		СтрокаТаблицы.ПроизводительНаименование = value["producerName"];
		СтрокаТаблицы.ПроизводительИНН = value["producerInn"];
		
		СтрокаТаблицы.ВладелецНаименование = value["ownerName"];
		СтрокаТаблицы.ВладелецИНН = value["ownerInn"];
		СтрокаТаблицы.Владелец = Неопределено;
		
		СтрокаТаблицы.ДатаНанесения = ДатаИзСтрокиXML(value["receiptDate"]);
		СтрокаТаблицы.ДатаВводаВОборот = ДатаИзСтрокиXML(value["introducedDate"]);
		
		vetDocumentId = value["vetDocumentId"];
		Если ЗначениеЗаполнено(vetDocumentId) Тогда
			СтрокаТаблицы.ИдентификаторВСД = vetDocumentId;
		КонецЕсли;
		
		producedDate = ДатаИзСтрокиXMLБезUTC(value["producedDate"]);
		Если ЗначениеЗаполнено(producedDate) Тогда
			СтрокаТаблицы.ДатаПроизводства = producedDate;
		КонецЕсли;
		
		expirationDate = ДатаИзСтрокиXMLБезUTC(value["expirationDate"]);
		Если ЗначениеЗаполнено(expirationDate) Тогда
			СтрокаТаблицы.ДатаСрокаГодности = expirationDate;
		КонецЕсли;
		
		productGroup = value["productGroup"];
		Если ЗначениеЗаполнено(productGroup) Тогда
			СтрокаТаблицы.ВидПродукции = ВидПродукцииПоТоварнойГруппеИзСервиса(productGroup);
		КонецЕсли;
		
		packageType = value["packageType"];
		Если ЗначениеЗаполнено(packageType) Тогда
			СтрокаТаблицы.ТипУпаковкиГИСМТ = ТипУпаковкиГИСМТПоТипуУпаковкиИзСервиса(packageType);
		КонецЕсли;
		
		generalPackageType = value["generalPackageType"];
		Если ЗначениеЗаполнено(generalPackageType) Тогда
			СтрокаТаблицы.ОбщийТипУпаковки = ОбщийТипУпаковкиПоОбщемуТипуУпаковкиИзСервиса(generalPackageType);
		КонецЕсли;
		
		partNumber = value["partNumber"];
		Если ЗначениеЗаполнено(partNumber) Тогда
			СтрокаТаблицы.НомерПартии = partNumber;
		КонецЕсли;
		
		emissionType = value["emissionType"];
		Если ЗначениеЗаполнено(emissionType) Тогда
			СтрокаТаблицы.СпособВыпускаТоваров = СпособВыпускаТоваровПоСпособуВыпускаИзСервиса(emissionType);
		КонецЕсли;
			
		specialState = value["specialState"];
		Если ЗначениеЗаполнено(specialState) Тогда
			СтрокаТаблицы.ОсобоеСостояниеКода = ОсобоеСостояниеКодаПоСостояниюИзСервиса(specialState);
		КонецЕсли;
		
		productWeight = value["productWeight"];
		Если ЗначениеЗаполнено(productWeight) Тогда
			СтрокаТаблицы.Количество = productWeight;
		КонецЕсли;
		
		certificateDocuments = value["certificateDocuments"];
		СтрокаТаблицы.СтатусПроверкиРД = РезультатПроверкиРДПоГруппамСтатусаИзСервиса(certificateDocuments);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция РезультатПроверкиРДПоГруппамСтатусаИзСервиса(certificateDocuments)
	
	РезультатыПроверкиРД = Перечисление_РезультатыПроверкиРДКода();
	
	Если Не ЗначениеЗаполнено(certificateDocuments) Тогда
		Возврат РезультатыПроверкиРД.Неопределен;
	КонецЕсли;
	
	ЗеленыеСтатусы = ",1,26,27,28,29,30,";
	ЖелтыеСтатусы = ",2,5,6,7,9,11,12,13,14,15,21,22,23,24,25,";
	КрасныеСтатусы = ",3,16,17,18,19,20,";
	
	ЕстьЗеленыеСтатусы = Ложь;
	ЕстьЖелтыеСтатусы = Ложь;
	ЕстьКрасныеСтатусы = Ложь;
	ЕстьНеизвестныеСтатусы = Ложь;
	Для Каждого Элемент Из certificateDocuments Цикл
		statusGroup = Элемент["statusGroup"];
		Если Не ЗначениеЗаполнено(statusGroup) Тогда
			Продолжить;
		ИначеЕсли Найти(ЗеленыеСтатусы, "," + statusGroup + ",") > 0 Тогда
			ЕстьЗеленыеСтатусы = Истина;
			Прервать;
		ИначеЕсли Найти(ЖелтыеСтатусы, "," + statusGroup + ",") > 0 Тогда
			ЕстьЖелтыеСтатусы = Истина;
		ИначеЕсли Найти(КрасныеСтатусы, "," + statusGroup + ",") > 0 Тогда
			ЕстьКрасныеСтатусы = Истина;
		Иначе
			ЕстьНеизвестныеСтатусы = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьЗеленыеСтатусы Тогда
		Результат = РезультатыПроверкиРД.ДоступенДляОтгрузкиИВводаВОборот;
	ИначеЕсли ЕстьЖелтыеСтатусы Тогда
		Результат = РезультатыПроверкиРД.ДоступенТолькоДляОтгрузки;
	ИначеЕсли ЕстьКрасныеСтатусы Тогда
		Результат = РезультатыПроверкиРД.Недоступен;
	ИначеЕсли ЕстьНеизвестныеСтатусы Тогда
		Результат = РезультатыПроверкиРД.Неизвестен;
	Иначе
		Результат = РезультатыПроверкиРД.Неопределен;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_РезультатыПроверкиРДКода() Экспорт
	
	КлючКэш = "РезультатыПроверкиРДКода";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ДоступенДляОтгрузкиИВводаВОборот"	, "Доступен для отгрузки и ввода в оборот");
	Результат.Вставить("ДоступенТолькоДляОтгрузки"			, "Доступен только для отгрузки");
	Результат.Вставить("Недоступен"							, "Недоступен");
	Результат.Вставить("Неизвестен"							, "Неизвестен");
	Результат.Вставить("Неопределен"						, "Неопределен");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция КлючСтатусаКода_Подобрать(КлючевыеРеквизиты, КэшРезультатов = Неопределено)
	
	Если КэшРезультатов <> Неопределено Тогда
		ИменаПолей = СтатусыКодовГИСМТ_ИменаПолей();
		Если ЗначениеЗаполнено(КэшРезультатов) Тогда
			Отбор = Новый Структура(ИменаПолей);
			ЗаполнитьЗначенияСвойств(Отбор, КлючевыеРеквизиты);
			НайденныеСтроки = КэшРезультатов.НайтиСтроки(Отбор);
			Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
				Возврат НайденныеСтроки[0].КлючСтатусаКода;
			КонецЕсли;
		Иначе
			КэшРезультатов = Новый_ТаблицаКодов();
			КэшРезультатов.Индексы.Добавить(ИменаПолей);
		КонецЕсли;
	КонецЕсли;
	
	Результат = КлючСтатусаКода_НайтиСуществующий(КлючевыеРеквизиты);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		КлючСтатусаКода_Записать(КлючевыеРеквизиты);
		Результат = КлючСтатусаКода_НайтиСуществующий(КлючевыеРеквизиты);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		СтрКэша = КэшРезультатов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрКэша, КлючевыеРеквизиты);
		СтрКэша.КлючСтатусаКода = Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлючСтатусаКода_НайтиСуществующий(КлючевыеРеквизиты)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючСтатусаКода КАК КлючСтатусаКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК Т
	|ГДЕ
	|	&Условия");
	
	Условия = "";
	Разделитель = "";
	Для каждого ИмяПоля Из РазделитьСтроку(СтатусыКодовГИСМТ_ИменаПолей()) Цикл
		Запрос.УстановитьПараметр(ИмяПоля, КлючевыеРеквизиты[ИмяПоля]);
		Условия = Условия + Разделитель + ПараметрыВСтроку("Т.%1 = &%1", ИмяПоля);
		Разделитель = " И ";
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условия", Условия);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КлючСтатусаКода");
	
КонецФункции

Процедура КлючСтатусаКода_Записать(КлючевыеРеквизиты)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		СтатусыКодовГИСМТ_Заблокировать(КлючевыеРеквизиты);
		
		НаборЗаписей = РегистрыСведений.КонтурМаркировка_СтатусыКодовГИСМТ.СоздатьНаборЗаписей();
		Для каждого ИмяПоля Из РазделитьСтроку(СтатусыКодовГИСМТ_ИменаПолей()) Цикл
			НаборЗаписей.Отбор[ИмяПоля].Установить(КлючевыеРеквизиты[ИмяПоля]);
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), КлючевыеРеквизиты);
		
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СтатусыКодовГИСМТ_Заблокировать(КлючевыеРеквизиты)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для каждого ИмяПоля Из РазделитьСтроку(СтатусыКодовГИСМТ_ИменаПолей()) Цикл
		ЭлементБлокировки.УстановитьЗначение(ИмяПоля, КлючевыеРеквизиты[ИмяПоля]);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция СтатусыКодовГИСМТ_ИменаПолей() Экспорт
	
	Возврат ИменаПолейРегистраСведений("КонтурМаркировка_СтатусыКодовГИСМТ", "КлючСтатусаКода");
	
КонецФункции

// #КонецОбласти

// #Область УстаревшиеКоды

Процедура УстаревшиеКоды_ВТ_ДобавитьТаблицуДляЗаписи(Запрос, ИмяТаблицыНабора)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаНабора.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ ТабИзменений
	|ИЗ
	|	ТаблицаНабора КАК ТаблицаНабора
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаНабора.КлючКода
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(ТаблицаНабора.Устаревший) = ИСТИНА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ПОМЕСТИТЬ ТаблицаДляЗаписиУстаревшиеКоды
	|ИЗ
	|	ТабИзменений КАК ТабИзменений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабИзменений.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойАгрегат
	|		ПО (КодыМаркировки.КлючАгрегата = ПустойАгрегат.Ключ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТабИзменений.КлючКода = КодыДокументов.КлючКода
	|			И (&УсловиеДокументУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО ТабИзменений.КлючКода = КодыОпераций.КлючКода
	|			И (&УсловиеОперация)
	|ГДЕ
	|	ПустойАгрегат.Ключ ЕСТЬ НЕ NULL 
	|	И КодыОпераций.КлючКода ЕСТЬ NULL
	|	И КодыДокументов.КлючКода ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабИзменений";
	
	Если ИмяТаблицыНабора = "ТаблицаНабораКодыДокументов" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДокументУчета", "КодыДокументов.ДокументУчета <> &ДокументУчета");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДокументУчета", "ИСТИНА");
	КонецЕсли;
	Если ИмяТаблицыНабора = "ТаблицаНабораКодыОпераций" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОперация", "КодыОпераций.Операция <> &Операция");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОперация", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "ТаблицаНабора", ИмяТаблицыНабора);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура УстаревшиеКоды_Записать(КлючиКодов)
	
	Если Не ЗначениеЗаполнено(КлючиКодов) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ПОМЕСТИТЬ ТаблицаДляЗаписиУстаревшиеКоды
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО КодыМаркировки.КлючКода = КодыДокументов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО КодыМаркировки.КлючКода = КодыОпераций.КлючКода
	|ГДЕ
	|	КодыМаркировки.КлючКода В(&КлючиКодов)
	|	И КодыОпераций.КлючКода ЕСТЬ NULL
	|	И КодыДокументов.КлючКода ЕСТЬ NULL");
	Запрос.УстановитьПараметр("КлючиКодов", КлючиКодов);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	УстаревшиеКоды_ВТ_Записать(МенеджерВТ);
	
КонецПроцедуры

Процедура УстаревшиеКоды_ВТ_Записать(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	ТаблицаДляЗаписиУстаревшиеКоды КАК Т
	|ИТОГИ ПО
	|	ПорцияЗаписей
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаДляЗаписиУстаревшиеКоды");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ДатаЗаписи = ТекущаяДатаСеанса();
	ТипФайлаУстаревшиеКоды = Перечисление_ТипыФайлов().УстаревшиеКоды;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Файлы_ЗаблокироватьПоТаблице(РезультатЗапроса, "ПорцияЗаписей");
		
		ВыборкаПорция = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПорция.Следующий() Цикл
			
			Файл = Файл_НайтиПоИдентификатору(Неопределено, ВыборкаПорция.ПорцияЗаписей, ТипФайлаУстаревшиеКоды);
			ОписаниеФайла = Файл_Прочитать(Файл);
			
			Если ОписаниеФайла = Неопределено Тогда
				ЭтоНовыйФайл = Истина;
				ОписаниеФайла = Новый_ОписаниеФайла();
				ОписаниеФайла.ТипФайла = ТипФайлаУстаревшиеКоды;
				ОписаниеФайла.Идентификатор = ВыборкаПорция.ПорцияЗаписей;
				ОписаниеФайла.ДанныеФайла = Новый_ТаблицаУстаревшихКодов();
			Иначе
				ЭтоНовыйФайл = Ложь;
				ТаблицаЗначений_ДобавитьИндекс(ОписаниеФайла.ДанныеФайла, "КлючКода");
			КонецЕсли;
			
			ЕстьИзменения = Ложь;
			
			Выборка = ВыборкаПорция.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ЭтоНовыйФайл Или ОписаниеФайла.ДанныеФайла.Найти(Выборка.КлючКода, "КлючКода") = Неопределено Тогда
					Стр = ОписаниеФайла.ДанныеФайла.Добавить();
					Стр.КлючКода = Выборка.КлючКода;
					Стр.ДатаЗаписи = ДатаЗаписи;
					ЕстьИзменения = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьИзменения Тогда
				ОписаниеФайла.ДанныеФайла.Индексы.Очистить();
				ОписаниеФайла.ДатаСоздания = ОписаниеФайла.ДанныеФайла[0].ДатаЗаписи;
				Файл_Записать(ОписаниеФайла);
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #Область КодыОпераций

Функция КодыОпераций_Прочитать(Операция, КлючСтрокиОперации = Неопределено) Экспорт
	
	ДокументУчета = ЗначениеРеквизитаОбъектаЛок(Операция, "ДокументУчета");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыОпераций.КлючКода КАК КлючКода,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	КодыОпераций.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ЕСТЬNULL(ТоварыДокумента.НомерСтроки, 0) КАК НомерСтрокиДокумента
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета.ТоварыДокумента КАК ТоварыДокумента
	|		ПО КодыОпераций.КлючСтрокиДокумента = ТоварыДокумента.КлючСтрокиДокумента
	|			И (ТоварыДокумента.Ссылка = &ДокументУчета)
	|ГДЕ
	|	КодыОпераций.Операция = &Операция
	|	И &КлючСтрокиОперации";
	
	Если КлючСтрокиОперации = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", "ИСТИНА");
	Иначе
		Условие = "КодыОпераций.КлючСтрокиОперации = &КлючСтрокиОперации";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("КлючСтрокиОперации", КлючСтрокиОперации);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_ТаблицаКодов();
	
	ТаблицаЗначений_ДобавитьИзВыборки(Результат, Выборка);
	
	Возврат Результат;
	
КонецФункции

Процедура КодыОпераций_Записать(ТаблицаКодов, Операция, УдалитьСтарыеКоды = Истина) Экспорт
	
	Если Не УдалитьСтарыеКоды И Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТипОперации = ЗначениеРеквизитаОбъектаЛок(Операция, "ТипОперации");
	Если Не МассивСодержитЗначение(ТипыОперацийМожноХранитьУпакованнеКоды(), ТипОперации) Тогда
		Для Каждого Стр Из ТаблицаКодов.НайтиСтроки(Новый Структура("УдалитьИзОперации", Ложь)) Цикл
			Если ЗначениеЗаполнено(Стр.КлючАгрегата) Или ЗначениеЗаполнено(Стр.КодАгрегата) Тогда
				Стр.УдалитьИзОперации = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыОпераций_Заблокировать(Операция);
		
		МенеджерВТ = КодыОпераций_ВТ_ТаблицыДляЗаписи(ТаблицаКодов, Операция, УдалитьСтарыеКоды);
		
		КодыОпераций_ВТ_Записать(МенеджерВТ);
		КодыОпераций_ВТ_ОбновитьКоличествоКодов(МенеджерВТ);
		КодыЗаказов_ВТ_ВернутьКодыВЗаказы(МенеджерВТ);
		УстаревшиеКоды_ВТ_Записать(МенеджерВТ);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция КодыОпераций_Подобрать(ОперацияПриемник, ТребуемыеКоды, ОперацияИсточник) Экспорт
	
	Если Не ЗначениеЗаполнено(ТребуемыеКоды) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТребуемыеКоды.Сортировать("КлючНоменклатуры Убыв, КлючХарактеристики Убыв, КлючУпаковки Убыв, КлючСерии Убыв, Товар Убыв", Новый СравнениеЗначений);
	
	ТипОперацииПриемника = ЗначениеРеквизитаОбъектаЛок(ОперацияПриемник, "ТипОперации");
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	КодыПодобраны = Ложь;
	УдалитьСтарыеКоды = Ложь;
	
	// Инициализация таблицы подобранных кодов
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 0 КлючКода КАК КлючКода ПОМЕСТИТЬ ПодобранныеКоды ИЗ РегистрСведений.КонтурМаркировка_КодыОпераций КАК Т");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	// BSLLS:CreateQueryInCycle-off
	
	Для каждого СтрТреб Из ТребуемыеКоды Цикл
		
		ВариантыАналитики = ВариантыАналитикиДляПодбораКодов(СтрТреб);
		
		Для каждого ЗначенияАналитики Из ВариантыАналитики Цикл
			
			Если ЗначениеЗаполнено(СтрТреб.КоличествоКодовТребуется)
				И СтрТреб.КоличествоКодовТребуется = СтрТреб.КоличествоКодовПодобрано Тогда
				Прервать;
			КонецЕсли;
			
			НачатьТранзакцию(РежимУправленияБлокировкой());
			Попытка
				
				Операция_Заблокировать(ОперацияИсточник);
				
				// Формируем таблицу подходящих кодов
				Запрос = КодыОпераций_Подобрать_Запрос(ЗначенияАналитики, ВариантыАналитики, ОперацияИсточник, СтрТреб);
				Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
				Запрос.Выполнить();
				
				ТаблицаКодов_ВТ_УдалитьКодыДругихОпераций(МенеджерВТ, ТипОперацииПриемника, ОперацияИсточник);
				
				Если ЕстьСтрокиВТаблицеЗапроса(МенеджерВТ, "ТаблицаКодов") Тогда
					
					// Оставляем нужное количество кодов
					Если ЗначениеЗаполнено(СтрТреб.КоличествоКодовТребуется) Тогда
						КоличествоКодовТребуется = СтрТреб.КоличествоКодовТребуется - СтрТреб.КоличествоКодовПодобрано;
						ОставитьПервыеСтрокиВТаблицеЗапроса(МенеджерВТ, "ТаблицаКодов", КоличествоКодовТребуется, "КлючКода");
					КонецЕсли;
					
					// Дополняем таблицу подобранных кодов, чтобы учесть их при поиске в следующих итерациях
					ДополнитьТаблицуВЗапросе(МенеджерВТ, "ПодобранныеКоды", "ТаблицаКодов", "КлючКода", "КлючКода");
					
					ТаблицаКодов = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаКодов", Истина);
					ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
					
					СтрТреб.КоличествоКодовПодобрано = СтрТреб.КоличествоКодовПодобрано + ТаблицаКодов.Количество();
					
					Если ЗначениеЗаполнено(СтрТреб.НовыйКлючСтрокиДокумента) Тогда
						ТаблицаКодов.ЗаполнитьЗначения(СтрТреб.НовыйКлючСтрокиДокумента, "КлючСтрокиДокумента");
					КонецЕсли;
					Если ЗначениеЗаполнено(СтрТреб.НовыйКлючСтрокиОперации) Тогда
						ТаблицаКодов.ЗаполнитьЗначения(СтрТреб.НовыйКлючСтрокиОперации, "КлючСтрокиОперации");
					КонецЕсли;
					
					КодыОпераций_Записать(ТаблицаКодов, ОперацияПриемник, УдалитьСтарыеКоды);
					
					КодыПодобраны = Истина;
					
				Иначе
					УдалитьТаблицуИзЗапроса(МенеджерВТ, "ТаблицаКодов");
				КонецЕсли;
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				ОтменитьТранзакцию();
				Ошибка = ИнформацияОбОшибке();
				ВызватьИсключение;
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
	Возврат КодыПодобраны;
	
КонецФункции

Функция КодыОпераций_Подобрать_Запрос(ЗначенияАналитики, ВариантыАналитики, ОперацияИсточник, СтрТреб)
	
	ШаблонТекстаЗапросаСНоменклатурой =
	"ВЫБРАТЬ
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ПОМЕСТИТЬ ПодходящиеКлючиНоменклатуры1С
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С КАК Т
	|ГДЕ
	|	Т.КлючНоменклатуры = &КлючНоменклатуры
	|	И Т.КлючХарактеристики = &КлючХарактеристики
	|	И Т.КлючУпаковки = &КлючУпаковки
	|	И Т.КлючСерии = &КлючСерии
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючНоменклатуры1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыОпераций.КлючКода КАК КлючКода,
	|	КодыОпераций.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодобранныеКоды КАК ПодобранныеКоды
	|		ПО КодыОпераций.КлючКода = ПодобранныеКоды.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыОпераций.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодходящиеКлючиНоменклатуры1С КАК ПодходящиеКлючиНоменклатуры1С
	|		ПО (ИнформацияОКодах.КлючНоменклатуры1С = ПодходящиеКлючиНоменклатуры1С.КлючНоменклатуры1С)
	|ГДЕ
	|	КодыОпераций.Операция = &Операция
	|	И ПодобранныеКоды.КлючКода ЕСТЬ NULL
	|	И ПодходящиеКлючиНоменклатуры1С.КлючНоменклатуры1С ЕСТЬ НЕ NULL 
	|	И &КлючСтрокиОперации
	|	И &КлючСтрокиДокумента
	|	И &ОбщийТипУпаковки
	|	И &ДляНанесения
	|	И &Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПодходящиеКлючиНоменклатуры1С";
	
	ШаблонТекстаЗапросаБезНоменклатуры =
	"ВЫБРАТЬ
	|	КодыОпераций.КлючКода КАК КлючКода,
	|	КодыОпераций.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодобранныеКоды КАК ПодобранныеКоды
	|		ПО КодыОпераций.КлючКода = ПодобранныеКоды.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыОпераций.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КодыОпераций.Операция = &Операция
	|	И ПодобранныеКоды.КлючКода ЕСТЬ NULL
	|	И &ПустойКлючНоменклатуры1С
	|	И &КлючСтрокиОперации
	|	И &КлючСтрокиДокумента
	|	И &ОбщийТипУпаковки
	|	И &ДляНанесения
	|	И &Товар";
	
	Если ЗначениеЗаполнено(ЗначенияАналитики.КлючНоменклатуры) Тогда
		ТекстЗапроса = ШаблонТекстаЗапросаСНоменклатурой;
	Иначе
		ТекстЗапроса = ШаблонТекстаЗапросаБезНоменклатуры;
	КонецЕсли;
	
	Если СтрТреб.ДляНанесения Тогда
		Условие = "ИнформацияОКодах.ЕстьПолныйКод
		|	И ИнформацияОКодах.ДляНанесения
		|	И ИнформацияОКодах.ДатаПечати = &ПустаяДата";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляНанесения", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляНанесения", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТреб.ОбщийТипУпаковки) Тогда
		Условие = "ИнформацияОКодах.ОбщийТипУпаковки = &ОбщийТипУпаковки";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОбщийТипУпаковки", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОбщийТипУпаковки", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТреб.Товар) Тогда
		Условие = "ИнформацияОКодах.Товар = &Товар";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТреб.КлючНоменклатуры1С) Тогда
		Условие = "ИнформацияОКодах.КлючНоменклатуры1С = &ПустойКлючНоменклатуры1С";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустойКлючНоменклатуры1С", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустойКлючНоменклатуры1С", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТреб.КлючСтрокиОперации) Тогда
		Условие = "КодыОпераций.КлючСтрокиОперации = &КлючСтрокиОперации";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрТреб.КлючСтрокиДокумента) Тогда
		Условие = "КодыОпераций.КлючСтрокиДокумента = &КлючСтрокиДокумента";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиДокумента", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Операция", ОперацияИсточник);
	Запрос.УстановитьПараметр("ОбщийТипУпаковки", СтрТреб.ОбщийТипУпаковки);
	Запрос.УстановитьПараметр("КлючСтрокиОперации", СтрТреб.КлючСтрокиОперации);
	Запрос.УстановитьПараметр("КлючСтрокиДокумента", СтрТреб.КлючСтрокиДокумента);
	Запрос.УстановитьПараметр("ПустойКлючНоменклатуры1С", ПустойКлючНоменклатуры1С());
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата());
	
	Для каждого Колонка Из ВариантыАналитики.Колонки Цикл
		Запрос.УстановитьПараметр(Колонка.Имя, ЗначенияАналитики[Колонка.Имя]);
	КонецЦикла;
	
	Возврат Запрос;
	
КонецФункции

Процедура КодыОпераций_ВТ_Записать(МенеджерВТ)
	
	Набор = Новый_ОписаниеНабораРегистраСведений("КонтурМаркировка_КодыОпераций", "Операция");
	Набор.ТаблицаНабора = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаНабораКодыОпераций", Истина);
	ЗаписатьНаборыРегистраСведенийСРазнымиРежимамиЗаписи(Набор);
	
КонецПроцедуры

Процедура КодыОпераций_ВТ_ОбновитьКоличествоКодов(МенеджерВТ)
	
	ТаблицаНабора = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаНабораКоличествоКодовОпераций", Истина);
	Если Не ЗначениеЗаполнено(ТаблицаНабора) Тогда
		Возврат;
	КонецЕсли;
	
	КодыОпераций_ЗаблокироватьПоТаблице(ТаблицаНабора);
	
	Набор = Новый_ОписаниеНабораРегистраСведений("КонтурМаркировка_КоличествоКодовОпераций", "Операция");
	Набор.ТаблицаНабора = ТаблицаНабора;
	ЗаписатьНаборыРегистраСведенийСРазнымиРежимамиЗаписи(Набор);
	
КонецПроцедуры

Процедура КодыОпераций_ОбновитьКоличествоКодов(Операция)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыОпераций.Операция КАК Операция,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	КодыМаркировки.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода КАК КлючСтатусаКода,
	|	КОЛИЧЕСТВО(*) КАК КоличествоКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО КодыОпераций.КлючКода = КодыМаркировки.КлючКода
	|ГДЕ
	|	КодыОпераций.Операция = &Операция
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыОпераций.Операция,
	|	КодыОпераций.КлючСтрокиОперации,
	|	КодыМаркировки.КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода");
	
	Запрос.УстановитьПараметр("Операция", Операция);
	
	Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовОпераций.СоздатьНаборЗаписей();
	Набор.Отбор.Операция.Установить(Операция);
	
	ТаблицаНабора = Набор.Выгрузить();
	ТаблицаЗначений_Дополнить(ТаблицаНабора, Запрос.Выполнить().Выгрузить());
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаНабора, "КоличествоКодов");
	
	Набор.Загрузить(ТаблицаНабора);
	Набор.Записать();
	
КонецПроцедуры

Процедура КодыОпераций_Заблокировать(Операция) Экспорт
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_КодыОпераций");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Операция", Операция);
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Операция", Операция);
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Процедура КодыОпераций_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "Операция")
	
	Поле = "Операция";
	
	ИменаОбъектов = Новый Массив;
	ИменаОбъектов.Добавить("РегистрСведений.КонтурМаркировка_КодыОпераций");
	ИменаОбъектов.Добавить("РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций");
	
	ЗаблокироватьПоТаблице(ИменаОбъектов, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

Функция КодыОпераций_ВТ_ТаблицыДляЗаписи(ТаблицаКодов, Операция, УдалитьСтарыеКоды)
	
	РежимыЗаписи = Перечисление_РежимыЗаписиНабора();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	
	ИменаПолей = "КлючКода, КлючСтрокиОперации, КлючСтрокиДокумента, УдалитьИзОперации";
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов.Скопировать(, ИменаПолей), "ТабКодов", "КлючКода, КлючСтрокиОперации");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("Удаление", РежимыЗаписи.Удаление);
	Запрос.УстановитьПараметр("Добавление", РежимыЗаписи.Добавление);
	Запрос.УстановитьПараметр("Обновление", РежимыЗаписи.Обновление);
	Запрос.УстановитьПараметр("УдалитьСтарыеКоды", УдалитьСтарыеКоды);
	
	КодыОпераций_ВТ_ДобавитьТаблицуНабора_КодыОпераций(Запрос);
	КодыОпераций_ВТ_ДобавитьТаблицуНабора_КоличествоКодовОпераций(Запрос);
	
	УстаревшиеКоды_ВТ_ДобавитьТаблицуДляЗаписи(Запрос, "ТаблицаНабораКодыОпераций");
	КодыЗаказов_ВТ_ДобавитьТаблицуДляЗаписи_ВернутьКодыВЗаказы(Запрос);
	
	Возврат МенеджерВТ;
	
КонецФункции

Процедура КодыОпераций_ВТ_ДобавитьТаблицуНабора_КодыОпераций(Запрос)
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Операция КАК Операция,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	КодыОпераций.КлючКода КАК КлючКода,
	|	КодыОпераций.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	ИСТИНА КАК Устаревший,
	|	&Удаление КАК РежимЗаписи
	|ПОМЕСТИТЬ ТаблицаНабораКодыОпераций
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабКодов КАК ТабКодов
	|		ПО КодыОпераций.КлючКода = ТабКодов.КлючКода
	|ГДЕ
	|	&УдалитьСтарыеКоды
	|	И ТабКодов.КлючКода ЕСТЬ NULL
	|	И КодыОпераций.Операция = &Операция
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Операция,
	|	КодыОпераций.КлючСтрокиОперации,
	|	КодыОпераций.КлючКода,
	|	КодыОпераций.КлючСтрокиДокумента,
	|	ИСТИНА,
	|	&Удаление
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО ТабКодов.КлючКода = КодыОпераций.КлючКода
	|			И (КодыОпераций.Операция = &Операция)
	|ГДЕ
	|	ТабКодов.УдалитьИзОперации
	|	И КодыОпераций.КлючКода ЕСТЬ НЕ NULL 
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Операция,
	|	КодыОпераций.КлючСтрокиОперации,
	|	КодыОпераций.КлючКода,
	|	КодыОпераций.КлючСтрокиДокумента,
	|	ИСТИНА,
	|	&Удаление
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО ТабКодов.КлючКода = КодыОпераций.КлючКода
	|			И (КодыОпераций.Операция = &Операция)
	|ГДЕ
	|	НЕ ТабКодов.УдалитьИзОперации
	|	И ТабКодов.КлючСтрокиОперации <> КодыОпераций.КлючСтрокиОперации
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Операция,
	|	ТабКодов.КлючСтрокиОперации,
	|	ТабКодов.КлючКода,
	|	ТабКодов.КлючСтрокиДокумента,
	|	ЛОЖЬ,
	|	&Обновление
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО ТабКодов.КлючКода = КодыОпераций.КлючКода
	|			И ТабКодов.КлючСтрокиОперации = КодыОпераций.КлючСтрокиОперации
	|			И (КодыОпераций.Операция = &Операция)
	|ГДЕ
	|	НЕ ТабКодов.УдалитьИзОперации
	|	И КодыОпераций.КлючСтрокиДокумента <> ТабКодов.КлючСтрокиДокумента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Операция,
	|	ТабКодов.КлючСтрокиОперации,
	|	ТабКодов.КлючКода,
	|	ТабКодов.КлючСтрокиДокумента,
	|	ЛОЖЬ,
	|	&Добавление
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО ТабКодов.КлючКода = КодыОпераций.КлючКода
	|			И ТабКодов.КлючСтрокиОперации = КодыОпераций.КлючСтрокиОперации
	|			И (КодыОпераций.Операция = &Операция)
	|ГДЕ
	|	НЕ ТабКодов.УдалитьИзОперации
	|	И КодыОпераций.КлючКода ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКодов";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура КодыОпераций_ВТ_ДобавитьТаблицуНабора_КоличествоКодовОпераций(Запрос)
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабКодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	ТабКодыОпераций.РежимЗаписи КАК РежимЗаписи,
	|	КодыМаркировки.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода КАК КлючСтатусаКода,
	|	КОЛИЧЕСТВО(*) КАК КоличествоКодов
	|ПОМЕСТИТЬ ТабИзменений
	|ИЗ
	|	ТаблицаНабораКодыОпераций КАК ТабКодыОпераций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабКодыОпераций.КлючКода = КодыМаркировки.КлючКода
	|ГДЕ
	|	ТабКодыОпераций.РежимЗаписи В (&Удаление, &Добавление)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабКодыОпераций.КлючСтрокиОперации,
	|	ТабКодыОпераций.РежимЗаписи,
	|	КодыМаркировки.КлючИнформацииОКоде,
	|	КодыМаркировки.КлючСтатусаКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	Т.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	Т.КлючСтатусаКода КАК КлючСтатусаКода,
	|	СУММА(Т.КоличествоКодов) КАК КоличествоКодов
	|ПОМЕСТИТЬ ТабКолКодов
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|		Т.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|		Т.КлючСтатусаКода КАК КлючСтатусаКода,
	|		Т.КоличествоКодов КАК КоличествоКодов
	|	ИЗ
	|		РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций КАК Т
	|	ГДЕ
	|		Т.Операция = &Операция
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Т.КлючСтрокиОперации,
	|		Т.КлючИнформацииОКоде,
	|		Т.КлючСтатусаКода,
	|		-Т.КоличествоКодов
	|	ИЗ
	|		ТабИзменений КАК Т
	|	ГДЕ
	|		Т.РежимЗаписи = &Удаление
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Т.КлючСтрокиОперации,
	|		Т.КлючИнформацииОКоде,
	|		Т.КлючСтатусаКода,
	|		Т.КоличествоКодов
	|	ИЗ
	|		ТабИзменений КАК Т
	|	ГДЕ
	|		Т.РежимЗаписи = &Добавление) КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючСтрокиОперации,
	|	Т.КлючИнформацииОКоде,
	|	Т.КлючСтатусаКода
	|
	|ИМЕЮЩИЕ
	|	СУММА(Т.КоличествоКодов) > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтрокиОперации,
	|	КлючИнформацииОКоде,
	|	КлючСтатусаКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабИзменений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Операция КАК Операция,
	|	ТекКолКодов.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	ТекКолКодов.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	ТекКолКодов.КлючСтатусаКода КАК КлючСтатусаКода,
	|	ТекКолКодов.КоличествоКодов КАК КоличествоКодов,
	|	&Удаление КАК РежимЗаписи
	|ПОМЕСТИТЬ ТаблицаНабораКоличествоКодовОпераций
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций КАК ТекКолКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабКолКодов КАК ТабКолКодов
	|		ПО ТекКолКодов.КлючСтрокиОперации = ТабКолКодов.КлючСтрокиОперации
	|			И ТекКолКодов.КлючИнформацииОКоде = ТабКолКодов.КлючИнформацииОКоде
	|			И ТекКолКодов.КлючСтатусаКода = ТабКолКодов.КлючСтатусаКода
	|ГДЕ
	|	ТекКолКодов.Операция = &Операция
	|	И ТабКолКодов.КоличествоКодов ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Операция,
	|	ТабКолКодов.КлючСтрокиОперации,
	|	ТабКолКодов.КлючИнформацииОКоде,
	|	ТабКолКодов.КлючСтатусаКода,
	|	ТабКолКодов.КоличествоКодов,
	|	&Обновление
	|ИЗ
	|	ТабКолКодов КАК ТабКолКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций КАК ТекКолКодов
	|		ПО ТабКолКодов.КлючСтрокиОперации = ТекКолКодов.КлючСтрокиОперации
	|			И ТабКолКодов.КлючИнформацииОКоде = ТекКолКодов.КлючИнформацииОКоде
	|			И ТабКолКодов.КлючСтатусаКода = ТекКолКодов.КлючСтатусаКода
	|			И (ТекКолКодов.Операция = &Операция)
	|ГДЕ
	|	ТекКолКодов.КоличествоКодов <> ТабКолКодов.КоличествоКодов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Операция,
	|	ТабКолКодов.КлючСтрокиОперации,
	|	ТабКолКодов.КлючИнформацииОКоде,
