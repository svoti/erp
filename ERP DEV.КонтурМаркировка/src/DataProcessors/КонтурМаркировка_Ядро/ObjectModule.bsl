// #Область ТранспортHTTP

// Выполняет HTTP запрос
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP()
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * ТелоОтвета - Строка, ДвоичныеДанные - тело ответа;
//   * КодОтвета - Число - код ответа;
//   * Заголовки - Соответствие - заголовки ответа;
//
Функция ВыполнитьHTTPЗапрос(ОписаниеЗапроса) Экспорт
	
	Ответ_Мок = Мок_ВыполнитьHTTPЗапрос(ОписаниеЗапроса);
	Если Ответ_Мок <> Неопределено Тогда
		Возврат Ответ_Мок;
	КонецЕсли;
	
	Метод = ОписаниеЗапроса.Метод;
	ТелоЗапроса = ОписаниеЗапроса.ТелоЗапроса;
	ТелоОтветаКакДвоичныеДанные = ОписаниеЗапроса.ТелоОтветаКакДвоичныеДанные;
	
	ОписаниеЗапроса.ДатаЗапроса = ТекущаяУниверсальнаяДата();
	ОписаниеЗапроса.АдресРесурса = АдресРесурсаHTTP(ОписаниеЗапроса.ПутьНаСервере, ОписаниеЗапроса.Параметры);
	
	ЭтоМетодPATCH 	= (НРег(Метод) = НРег("PATCH"));
	ЭтоМетодPOST 	= (НРег(Метод) = НРег("POST"));
	ЭтоМетодGET 	= (НРег(Метод) = НРег("GET"));
	ЭтоМетодPUT 	= (НРег(Метод) = НРег("PUT"));
	
	Если ВерсияПлатформыНиже("8.3.6") И ЭтоМетодPATCH Тогда
		Возврат Плагин_ВыполнитьHTTPЗапрос(ОписаниеЗапроса);
	КонецЕсли;
	
	// BSLLS:InternetAccess-off
	ЗапросHTTP = Новый HTTPЗапрос(ОписаниеЗапроса.АдресРесурса, ОписаниеЗапроса.Заголовки);
	// BSLLS:InternetAccess-on
	
	Соединение = СоединениеHTTP(ОписаниеЗапроса);
	
	Если ЭтоМетодGET Тогда
		
		Ответ = Соединение.Получить(ЗапросHTTP);
		
	ИначеЕсли ЭтоМетодPOST Или ЭтоМетодPUT Тогда
		
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			
			ТипТелаЗапроса = ТипЗнч(ТелоЗапроса);
			
			Если ТипТелаЗапроса = Тип("Строка") Тогда
				
				Если ВерсияПлатформыНиже("8.3.6") Тогда
					ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "CESU-8");
				Иначе
					ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8"
					, ПредопределенноеЗначение("ИспользованиеByteOrderMark.НеИспользовать"));
				КонецЕсли;
				
			ИначеЕсли ТипТелаЗапроса = Тип("ДвоичныеДанные") Тогда
				
				ЗапросHTTP.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
				
			Иначе
				
				ТекстОшибки = НСтр("ru = 'Неизвестный тип тела запроса HTTP: %1'");
				ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТипТелаЗапроса);
				ВызватьИсключение ТекстОшибки;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтоМетодPOST Тогда
			
			Ответ = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
			
		Иначе
			
			Ответ = Соединение.Записать(ЗапросHTTP);
			
		КонецЕсли;
		
	ИначеЕсли ЭтоМетодPATCH Тогда
		
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			
			ТипТелаЗапроса = ТипЗнч(ТелоЗапроса);
			
			Если ТипТелаЗапроса = Тип("Строка") Тогда
				
				ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8"
					, ПредопределенноеЗначение("ИспользованиеByteOrderMark.НеИспользовать"));
				
			ИначеЕсли ТипТелаЗапроса = Тип("ДвоичныеДанные") Тогда
				
				ЗапросHTTP.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
				
			Иначе
				
				ТекстОшибки = НСтр("ru = 'Неизвестный тип тела запроса HTTP: %1'");
				ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТипТелаЗапроса);
				ВызватьИсключение ТекстОшибки;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Ответ = Соединение.Изменить(ЗапросHTTP);
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Неизвестный метод HTTP: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Метод);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Если ТелоОтветаКакДвоичныеДанные Тогда
		ТелоОтвета = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Иначе
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ТелоОтвета", ТелоОтвета);
	Результат.Вставить("КодОтвета", Ответ.КодСостояния);
	
	ЗаголовкиОтвета = Новый Соответствие;
	Для Каждого Элемент Из Ответ.Заголовки Цикл
		ЗаголовкиОтвета.Вставить(НРег(Элемент.Ключ), Элемент.Значение);
	КонецЦикла;
	Результат.Вставить("Заголовки", ЗаголовкиОтвета);
	
	Возврат Результат;
	
КонецФункции

// Вызывает запись ошибки в журнал регистрации и затем исключение,
// если код ответа не является допустимым
//
// Параметры:
//  ОписаниеОтвета - Структура - см. ВыполнитьHTTPЗапрос();
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP();
//  РезультатОтвета - Структура - см. Новый_РезультатЗапросаHTTP();
//
Процедура ОбработатьОшибкуHTTP(ОписаниеОтвета, ОписаниеЗапроса, РезультатОтвета = Неопределено) Экспорт
	
	ТелоОтвета = ОписаниеОтвета.ТелоОтвета;
	КодОтвета = ОписаниеОтвета.КодОтвета;
	
	Метод = ОписаниеЗапроса.Метод;
	Сервер = ОписаниеЗапроса.Хост;
	ПутьНаСервере = ОписаниеЗапроса.ПутьНаСервере;
	ПараметрыЗапроса = ОписаниеЗапроса.Параметры;
	ЗаголовкиЗапроса = ОписаниеЗапроса.Заголовки;
	ДопустимыеКоды = ОписаниеЗапроса.ДопустимыеКодыОтвета;
	ЭтоОшибкаСоединения = ЭтоОшибкаСоединенияССервисом(КодОтвета);
	
	Если Не ЭтоОшибкаСоединения
		И (Не ЗначениеЗаполнено(ДопустимыеКоды)
		Или МассивСодержитЗначение(ДопустимыеКоды, КодОтвета)) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТелоОтвета) = Тип("ДвоичныеДанные") Тогда
		ТекстОшибки = СтрокаИзДвоичныхДанных(ТелоОтвета);
	Иначе
		ТекстОшибки = ТелоОтвета;
	КонецЕсли;
	
	ДопИнформация = Новый СписокЗначений;
	
	TraceID = ОписаниеОтвета.Заголовки["x-kontur-trace-id"];
	Если ЗначениеЗаполнено(TraceID) Тогда
		ДопИнформация.Добавить(TraceID, "Trace-Id");
	КонецЕсли;
	
	ДопИнформация.Добавить(Метод, "Метод");
	ДопИнформация.Добавить(Сервер, "Сервер");
	ДопИнформация.Добавить(ПутьНаСервере, "Путь на сервере");
	
	Для Каждого Эл Из ПараметрыЗапроса Цикл
		Если Эл.Ключ = "auth.sid" Или Эл.Ключ = "refresh-token" Тогда
			ДопИнформация.Добавить(ТокенБезСекрета(Эл.Значение), Эл.Ключ);
		Иначе
			ДопИнформация.Добавить(Эл.Значение, Эл.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Авторизация = ЗаголовкиЗапроса["Authorization"];
	Если ЗначениеЗаполнено(Авторизация) Тогда
		ДопИнформация.Добавить(ТокенБезСекрета(Авторизация), "Authorization");
	КонецЕсли;
	
	Действие = ПараметрыВСтроку(НСтр("ru = 'Ошибка HTTP %1'"), КодОтвета);
	
	ОбработатьОшибку(Действие, ТекстОшибки, ДопИнформация);
	Часовой_ОтправитьОшибкуHTTP(ОписаниеЗапроса, ОписаниеОтвета);
	
	Если ЭтоОшибкаСоединения И РезультатОтвета <> Неопределено Тогда
		РезультатОтвета.Успешно = Ложь;
		РезультатОтвета.КодОтвета = КодОтвета;
		РезультатОтвета.ВременнаяОшибка = Истина;
	Иначе
		ВызватьИсключение СокрЛП(Действие + Символы.ПС + ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоОшибкаСоединенияССервисом(КодОтвета)
	
	Результат = Ложь;
	
	Если КодОтвета >= 500 И КодОтвета <= 599 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если КодОтвета = 429 Тогда
		Результат = Истина; // Сервис перегружен
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает объект HTTP cоединение
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP();
//
// Возвращаемое значение:
//  HTTPСоединение;
//
Функция СоединениеHTTP(ОписаниеЗапроса)
	
	Хост = ОписаниеЗапроса.Хост;
	Порт = ОписаниеЗапроса.Порт;
	
	КлючКэш = Хост + ":" + Порт;
	Результат = КэшСоединенийHTTP_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Прокси = ПроксиHTTP(ОписаниеЗапроса.НастройкиПрокси);
	
	ПараметрыСоединения = Новый Массив;
	ПараметрыСоединения.Добавить(Хост);
	ПараметрыСоединения.Добавить(Порт);
	ПараметрыСоединения.Добавить(ОписаниеЗапроса.Логин);
	ПараметрыСоединения.Добавить(ОписаниеЗапроса.Пароль);
	ПараметрыСоединения.Добавить(Прокси);
	ПараметрыСоединения.Добавить(ОписаниеЗапроса.Таймаут);
	
	Если НРег(ОписаниеЗапроса.Схема) = НРег("https") Тогда
		ПараметрыСоединения.Добавить(Новый ЗащищенноеСоединениеOpenSSL);
	КонецЕсли;
	
	// BSLLS:InternetAccess-off
	Результат = Новый("HTTPСоединение", ПараметрыСоединения);
	// BSLLS:InternetAccess-on
	
	КэшСоединенийHTTP_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Создает новый объект ИнтернетПрокси
//
// Параметры:
//  НастройкиПрокси - Структура - см. НастройкиПроксиСервера()
// 
// Возвращаемое значение:
//  ИнтернетПрокси
//
Функция ПроксиHTTP(НастройкиПрокси)
	
	// BSLLS:InternetAccess-off
	
	ВариантыНастроек = Перечисление_ВариантыНастроекПроксиСервера();
	ВариантНастроек	 = НастройкиПрокси.ВариантНастроек;
	
	Если ВариантНастроек = ВариантыНастроек.СвоиНастройки Тогда
		
		Адрес = НастройкиПрокси.Адрес;
		Логин = НастройкиПрокси.Логин;
		Пароль = НастройкиПрокси.Пароль;
		Порт = Неопределено;
		
		Если ЗначениеЗаполнено(НастройкиПрокси.Порт) Тогда
			ОписаниеЧисла = Новый ОписаниеТипов("Число");
			Порт = ОписаниеЧисла.ПривестиЗначение(НастройкиПрокси.Порт);
		КонецЕсли;
		
		Результат = Новый ИнтернетПрокси;
		
		Если ЗначениеЗаполнено(Адрес) Тогда
			
			Если ЗначениеЗаполнено(Логин) Тогда
				
				Если ВерсияПлатформыНиже("8.3") Тогда
					Результат.Пароль = Пароль;
					Результат.Пользователь = Логин;
					Результат.Установить("http", Адрес, Порт);
					Результат.Установить("https", Адрес, Порт);
				Иначе
					Результат.Установить("http", Адрес, Порт, Логин, Пароль, Ложь);
					Результат.Установить("https", Адрес, Порт, Логин, Пароль, Ложь);
				КонецЕсли;
				
			Иначе
				Результат.Установить("http", Адрес, Порт);
				Результат.Установить("https", Адрес, Порт);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ВариантНастроек = ВариантыНастроек.СистемныеНастройки Тогда
		
		Результат = Новый ИнтернетПрокси(Истина);
		// Будет использован прокси по умолчанию:
		// либо из файла inetcfg.xml, если он расположен на данной машине, либо из настроек Internet Explorer.
		// Пример файла inetcfg.xml можно найти в официальной документации:
		// https://its.1c.ru/db/v8doc#content:26:1:issogl1_3.13.inetcfg.xml
		
	Иначе
		Результат = Новый ИнтернетПрокси(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
	// BSLLS:InternetAccess-off
	
КонецФункции

// Формирует адрес ресурса для HTTP запроса
//
Функция АдресРесурсаHTTP(Знач ИмяМетода, ПараметрыЗапроса = Неопределено)
	
	ПараметрыСтрокой = "";
	
	Если ЗначениеЗаполнено(ПараметрыЗапроса) Тогда
		
		Если Найти(ИмяМетода, "?") = 0 Тогда
			Разделитель = "?";
		Иначе
			Разделитель = "&";
		КонецЕсли;
		
		Для Каждого Элемент Из ПараметрыЗапроса Цикл
			
			Значение = Элемент.Значение;
			ИмяПараметра = Элемент.Ключ;
			
			ЧастьАдреса = ПараметрыВСтроку("{{%1}}", ИмяПараметра);
			Если СтрокаСодержитЗначение(ИмяМетода, ЧастьАдреса) Тогда
				ИмяМетода = СтрЗаменить(ИмяМетода, ЧастьАдреса, СтрокаПараметраURL(Значение));
				Продолжить;
			КонецЕсли;
			
			ЧастьАдреса = ПараметрыВСтроку("{%1}", ИмяПараметра);
			Если СтрокаСодержитЗначение(ИмяМетода, ЧастьАдреса) Тогда
				ИмяМетода = СтрЗаменить(ИмяМетода, ЧастьАдреса, СтрокаПараметраURL(Значение));
				Продолжить;
			КонецЕсли;
			
			Для каждого ТекЗначение Из ЗначениеВМассиве(Значение) Цикл
				СтрокаПараметра = ПараметрыВСтроку("%1=%2", ИмяПараметра, СтрокаПараметраURL(ТекЗначение));
				ПараметрыСтрокой = ПараметрыСтрокой + Разделитель + СтрокаПараметра;
				Разделитель = "&";
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Результат = ИмяМетода + ПараметрыСтрокой;
	
	Если Лев(Результат, 1) = "/" Тогда
		Результат = Сред(Результат, 2);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТокенБезСекрета(Токен)
	
	Если Не ЗначениеЗаполнено(Токен) Тогда
		Возврат "";
	КонецЕсли;
	
	ТипАвторизации = ТипАвторизации();
	ЕстьТипАвторизации = Найти(Токен, ТипАвторизации) = 1;
	Секрет = СокрЛП(СтрЗаменить(Токен, ТипАвторизации, ""));
	
	ДлинаСекрета = СтрДлина(Секрет);
	ДлинаТокена = 64;
	ДлинаНачала = 8;
	ДлинаКонца = 4;
	Четверть = 4;
	ДлинаКлючаАпи = 36;
	ДлинаНачалаКлючаАпи = 6;
	
	Если ДлинаСекрета = ДлинаТокена Тогда
		Результат = ПараметрыВСтроку("%1...%2", Лев(Секрет, ДлинаНачала), Прав(Секрет, ДлинаКонца));
	ИначеЕсли ДлинаСекрета = ДлинаКлючаАпи Тогда
		Результат = ПараметрыВСтроку("%1●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●", Лев(Секрет, ДлинаНачалаКлючаАпи));
	Иначе
		Результат = ПараметрыВСтроку("%1...", Лев(Секрет, ДлинаСекрета / Четверть));
	КонецЕсли;
	
	Если ЕстьТипАвторизации Тогда
		Результат = ТипАвторизации + " " + Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КэшСоединенийHTTP_Прочитать(Сокет)
	
	КлючКэш = "СоединенияHTTP";
	КэшСоединений = Кэш_Прочитать(КлючКэш);
	Если Не ЗначениеЗаполнено(КэшСоединений) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = КэшСоединений.Получить(Сокет);
	
	Возврат Результат;
	
КонецФункции

Процедура КэшСоединенийHTTP_Поместить(Сокет, Соединение)
	
	КлючКэш = "СоединенияHTTP";
	КэшСоединений = Кэш_Прочитать(КлючКэш);
	Если КэшСоединений = Неопределено Тогда
		КэшСоединений = Новый Соответствие;
		Кэш_Поместить(КлючКэш, КэшСоединений);
	КонецЕсли;
	
	КэшСоединений.Вставить(Сокет, Соединение);
	
КонецПроцедуры

Процедура КэшСоединенийHTTP_Очистить()
	
	КлючКэш = "СоединенияHTTP";
	КэшСоединений = Кэш_Прочитать(КлючКэш);
	Если Не ЗначениеЗаполнено(КэшСоединений) Тогда
		Возврат;
	КонецЕсли;
	
	КэшСоединений.Очистить();
	
КонецПроцедуры

// Заполняет в описании запроса HTTP настройки прокси
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP()
//
Процедура ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса) Экспорт
	
	НастройкиПрокси = НастройкиПроксиСервера();
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса.НастройкиПрокси, НастройкиПрокси);
	
КонецПроцедуры

// Формирует строку параметра в формате URL
//
Функция СтрокаПараметраURL(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка") Тогда
		Результат = КодироватьСтрокуURL(Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Результат = ЧислоXML(Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Результат = БулевоXML(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Результат = ЛокальнаяДатаXML(Значение);
	Иначе
		ТекстОшибки = НСтр("ru = 'Неизвестный тип значения для параметра строки URI %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТипЗначения);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разбирает строку URI на составные части на основе RFC 3986
//
// Параметры:
//  СтрокаURI - Строка - ссылка на ресурс в формате:
//              <схема>://<логин>:<пароль>@<хост>:<порт>/<путь>?<параметры>#<якорь>
//
// Возвращаемое значение:
//  Структура - содержит:
//   * Схема         - Строка - схема;
//   * Логин         - Строка - логин;
//   * Пароль        - Строка - пароль;
//   * Хост          - Строка - хост;
//   * Порт          - Число  - порт;
//   * ИмяСервера    - Строка - <хост>:<порт>;
//   * ПутьНаСервере - Строка - <путь>?<параметры>#<якорь>;
//
Функция СтруктураURI(Знач СтрокаURI) Экспорт
	
	Результат = Новый_СтруктураURI();
	СтрокаURI = СокрЛП(СтрокаURI);
	
	// Схема
	Поз = Найти(СтрокаURI, "://");
	Если Поз > 0 Тогда
		Результат.Схема = НРег(Лев(СтрокаURI, Поз - 1));
		СтрокаURI = Сред(СтрокаURI, Поз + 3);
	КонецЕсли;
	
	// Строка соединения и путь на сервере
	Поз = Найти(СтрокаURI, "/");
	Если Поз > 0 Тогда
		СтрокаСоединения = Лев(СтрокаURI, Поз - 1);
		Результат.ПутьНаСервере = Сред(СтрокаURI, Поз + 1);
	Иначе
		СтрокаСоединения = СтрокаURI;
	КонецЕсли;
	
	// Имя сервера, логин и пароль
	Поз = Найти(СтрокаСоединения, "@");
	Если Поз > 0 Тогда
		
		СтрокаАвторизации = Лев(СтрокаСоединения, Поз - 1);
		Результат.ИмяСервера = Сред(СтрокаСоединения, Поз + 1);
		
		// Логин и пароль
		Поз = Найти(СтрокаАвторизации, ":");
		Если Поз > 0 Тогда
			Результат.Логин = Лев(СтрокаАвторизации, Поз - 1);
			Результат.Пароль = Сред(СтрокаАвторизации, Поз + 1);
		Иначе
			Результат.Логин = СтрокаАвторизации;
		КонецЕсли;
		
	Иначе
		Результат.ИмяСервера = СтрокаСоединения;
	КонецЕсли;
	
	// Хост и порт
	Поз = Найти(Результат.ИмяСервера, ":");
	Если Поз > 0 Тогда
		Результат.Хост = Лев(Результат.ИмяСервера, Поз - 1);
		СтрокаПорта = Сред(Результат.ИмяСервера, Поз + 1);
		Если ВСтрокеТолькоЦифры(СтрокаПорта) Тогда
			Результат.Порт = Число(СтрокаПорта);
		КонецЕсли;
	Иначе
		Результат.Хост = Результат.ИмяСервера;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиПроксиСервера()
	
	Результат = Новый_НастройкиПрокси();
	Настройки = НастройкиМодуля();
	
	Если Настройки.Прокси_Использовать Тогда
		
		ВариантыНастроекПрокси = Перечисление_ВариантыНастроекПроксиСервера();
		Результат.ВариантНастроек = ВариантыНастроекПрокси.СвоиНастройки;
		
		Результат.Адрес	 = Настройки.Прокси_Адрес;
		Результат.Порт	 = Настройки.Прокси_Порт;
		Результат.Логин	 = Настройки.Прокси_Логин;
		Результат.Пароль = Настройки.Прокси_Пароль;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодОтвета_Успешно() Экспорт
	
	Возврат 200;
	
КонецФункции

Функция КодОтвета_ОшибкаАвторизации()
	
	Возврат 401;
	
