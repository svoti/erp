КонецФункции

Процедура Плагин_ОбработатьОшибку(Метод, Ошибка) Экспорт

	Действие = ПараметрыВСтроку(НСтр("ru = 'Контур.Плагин %1'"), Метод);
	
	ДопИнформация = Новый Структура;
	ДопИнформация.Вставить("ВерсияПлагина", Плагин_ВерсияПлагина());
	ДопИнформация.Вставить("МетодПлагина", Метод);

	Если ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке") Тогда
		ДопИнформация.Вставить("МодульОшибки", Ошибка.ИмяМодуля);
		ДопИнформация.Вставить("КраткийТекстОшибки", КраткоеПредставлениеОшибки(Ошибка));
		ПодробныйТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
	Иначе
		ПодробныйТекстОшибки = Ошибка;
	КонецЕсли;
	
	ОбработатьОшибку(Действие, ПодробныйТекстОшибки, ДопИнформация);
	Часовой_ОтправитьОписаниеОшибкиПлагин(Действие, ПодробныйТекстОшибки, ДопИнформация);
	
КонецПроцедуры

