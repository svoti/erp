	Возврат Результат;
	
КонецФункции

Функция Новый_ЗадачаОбмена_ДопРеквизиты()
	
	Результат = Новый Структура;
	Результат.Вставить("КраткоеОписаниеОшибки", "");
	Результат.Вставить("ДатаОбновленияСтатусовКодов", '00010101');
	Результат.Вставить("ПроизвольныеДопРеквизиты", Новый Структура); // Для ПМ
	
	Возврат Результат;
	
КонецФункции

