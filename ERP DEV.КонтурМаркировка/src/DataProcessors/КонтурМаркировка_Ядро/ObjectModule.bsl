Функция УстаревшиеОперации(ТипОперации, АктуальнаяДатаХранения)
	
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Операции.Ссылка КАК Операция
	|ИЗ
	|	Справочник.КонтурМаркировка_Операции КАК Операции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК СтатусыОпераций
	|		ПО Операции.Ссылка = СтатусыОпераций.Операция
	|			И (СтатусыОпераций.ТипСтатуса = &ТипСтатусаОсновнойСтатус)
	|ГДЕ
	|	Операции.ТипОперации = &ТипОперации
	|	И СтатусыОпераций.ДатаСтатуса < &АктуальнаяДатаХранения");
	
	Запрос.УстановитьПараметр("ТипСтатусаОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	Запрос.УстановитьПараметр("АктуальнаяДатаХранения", АктуальнаяДатаХранения);
	Запрос.УстановитьПараметр("ТипОперации", ТипОперации);
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "Операция");
	
КонецФункции

Процедура ЗафиксироватьДатуЗапускаОчисткиУстаревшихДанных()
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().ПоследняяОчисткаУстаревшихДанных;
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	ДанныеИБ.ДопРеквизиты.Вставить("ДатаЗапуска", ТекущаяУниверсальнаяДата());
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

Функция ОчисткаУстаревшихДанныхСегодняУжеВыполнялась() Экспорт
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().ПоследняяОчисткаУстаревшихДанных;
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(ИмяСправочника);
	ДатаЗапуска = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, "ДатаЗапуска", ПустаяДата());
	
	Возврат НачалоДня(ДатаЗапуска) = НачалоДня(ТекущаяУниверсальнаяДата());
	
КонецФункции

