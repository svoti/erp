		Наименование = НаименованиеПозицииДляКонтента(Стр);
		
		КоличествоВложений = 0;
		setItems = Новый Массив;
		Если ЗначениеЗаполнено(Стр.Товар) Тогда
			СоставНабора = Товар_Прочитать(Стр.Товар, КэшТоваров).СоставНабора;
			Для Каждого Элемент Из СоставНабора Цикл
				setItem = Новый Структура;
