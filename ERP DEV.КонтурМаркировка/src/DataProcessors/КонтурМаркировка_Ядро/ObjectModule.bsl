// #Область Интеграция

Функция ТипыОбъектовИС() Экспорт
	
	КлючКэш = "ТипыОбъектовИС";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Интеграция_СтандартноеОписаниеОбъектовИС();
	
	ПараметрыПМ = Новый Структура("Результат", Результат);
	ПМ_ОбработатьСобытие("ПриЗаполненииТиповОбъектовИС", ПараметрыПМ);
	
	Результат = Новый ФиксированнаяСтруктура(ПараметрыПМ.Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Интеграция_ПараметрыНоменклатуры1С(АналитикаНоменклатуры, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		КлючКэш = СтрокаАналитикиНоменклатуры1С(АналитикаНоменклатуры);
		ПараметрыНоменклатуры = КэшРезультатов[КлючКэш];
		Если ПараметрыНоменклатуры <> Неопределено Тогда
			Возврат ПараметрыНоменклатуры;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыНоменклатуры = Новый Структура;
	ПараметрыНоменклатуры.Вставить("Артикул");
	ПараметрыНоменклатуры.Вставить("Штрихкоды", Новый Массив);
	
	АналитикаНоменклатурыПМ = Новый_АналитикаНоменклатуры1С(АналитикаНоменклатуры);
	
	СтандартнаяОбработка = Истина;
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("АналитикаНоменклатуры", АналитикаНоменклатурыПМ);
	ПараметрыПМ.Вставить("ПараметрыНоменклатуры", ПараметрыНоменклатуры);
	ПМ_ОбработатьСобытие("ПриПолученииПараметровНоменклатуры", ПараметрыПМ, СтандартнаяОбработка);
	
	Если Не СтандартнаяОбработка Тогда
		ПараметрыНоменклатуры = ПараметрыПМ.ПараметрыНоменклатуры;
	Иначе
		Номенклатура = АналитикаНоменклатуры.Номенклатура;
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			ИмяСправочника = Номенклатура.Метаданные().ПолноеИмя();
			Если ЕстьМетаданные(ИмяСправочника + ".Реквизиты.Артикул") Тогда
				ПараметрыНоменклатуры.Артикул = ЗначениеРеквизитаОбъектаЛок(Номенклатура, "Артикул");
			КонецЕсли;
		КонецЕсли;
		ПараметрыНоменклатуры.Штрихкоды = Интеграция_ШтрихкодыНоменклатуры(АналитикаНоменклатуры);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, ПараметрыНоменклатуры);
	КонецЕсли;
	
	Возврат ПараметрыНоменклатуры;
	
КонецФункции

Функция Интеграция_Номенклатура1С_ЕстьАртикул() Экспорт
	
	КлючКэш = "Интеграция_Номенклатура1С_ЕстьАртикул";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыОбъектов = ТипыОбъектовИС();
	Если ЗначениеЗаполнено(ТипыОбъектов.Номенклатура) Тогда
		ИмяСправочника = СтрЗаменить(ТипыОбъектов.Номенклатура, "СправочникСсылка", "Справочник");
		Результат = ЕстьМетаданные(ИмяСправочника + ".Реквизиты.Артикул");
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Интеграция_ШтрихкодыНоменклатуры(АналитикаНоменклатуры)
	
	Результат = Новый Массив;
	
	ОписаниеРегистра = ТипыОбъектовИС().РегистрШтрихкодов;
	
	Если ЗначениеЗаполнено(ОписаниеРегистра.ПолноеИмя) Тогда
		
		УсловиеНоменклатуры = ПараметрыВСтроку("Т.%1 = &Номенклатура", ОписаниеРегистра.ПолеНоменклатура);
		
		Если ЗначениеЗаполнено(АналитикаНоменклатуры.Характеристика) Тогда
			УсловиеХарактеристики = ПараметрыВСтроку("Т.%1 = &Характеристика", ОписаниеРегистра.ПолеХарактеристика);
		Иначе
			УсловиеХарактеристики = "ИСТИНА";
		КонецЕсли;
		
		ТекстЗапроса = "ВЫБРАТЬ Т.Штрихкод КАК Штрихкод ИЗ РегистрШтрихкодов КАК Т ГДЕ &Номенклатура И &Характеристика";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрШтрихкодов", ОписаниеРегистра.ПолноеИмя);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Штрихкод", "Т." + ОписаниеРегистра.ПолеШтрихкод);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Номенклатура", УсловиеНоменклатуры);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Характеристика", УсловиеХарактеристики);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Номенклатура", АналитикаНоменклатуры.Номенклатура);
		Запрос.УстановитьПараметр("Характеристика", АналитикаНоменклатуры.Характеристика);
		
		ДополнитьМассив(Результат, МассивИзРезультатаЗапроса(Запрос, "Штрихкод"));
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Номенклатура = АналитикаНоменклатуры.Номенклатура;
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			ИмяСправочника = Номенклатура.Метаданные().ПолноеИмя();
			Если ЕстьМетаданные(ИмяСправочника + ".Реквизиты.Штрихкод") Тогда
				Штрихкод = ЗначениеРеквизитаОбъектаЛок(Номенклатура, "Штрихкод");
				Если ЗначениеЗаполнено(Штрихкод) Тогда
					Результат.Добавить(Штрихкод);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Интеграция_СтандартноеОписаниеОбъектовИС()
	
	Результат = Новый_ОписаниеТиповОбъектовИС();
	
	Интеграция_ЗаполнитьСтандартноеОписаниеБазовыхСправочников(Результат);
	Интеграция_ЗаполнитьСтандартноеОписаниеРегистраШтрихкодов(Результат);
	Интеграция_ЗаполнитьСтандартноеОписаниеПрефиксаИБ(Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура Интеграция_ЗаполнитьСтандартноеОписаниеБазовыхСправочников(ТипыОбъектов)
	
	ТипыОбъектов.Организация = Интеграция_ПодходящийОбъектМетаданных("СправочникСсылка.Организации");
	ТипыОбъектов.Контрагент = Интеграция_ПодходящийОбъектМетаданных("СправочникСсылка.Контрагенты");
	ТипыОбъектов.Пользователь = Интеграция_ПодходящийОбъектМетаданных("СправочникСсылка.Пользователи");
	
	ТипыОбъектов.Серия = Интеграция_ПодходящийОбъектМетаданных("СправочникСсылка.СерииНоменклатуры");
	ТипыОбъектов.Номенклатура = Интеграция_ПодходящийОбъектМетаданных("СправочникСсылка.Номенклатура");
	ТипыОбъектов.Характеристика = Интеграция_ПодходящийОбъектМетаданных("СправочникСсылка.ХарактеристикиНоменклатуры");
	
	Варианты = Новый Массив;
	Варианты.Добавить("СправочникСсылка.Склады");
	Варианты.Добавить("СправочникСсылка.СтруктурныеЕдиницы");
	Варианты.Добавить("СправочникСсылка.СкладыКомпании");
	ТипыОбъектов.Склад = Интеграция_ПодходящийОбъектМетаданных(Варианты);
	
	Варианты = Новый Массив;
	Варианты.Добавить("СправочникСсылка.КатегорииНоменклатуры");
	Варианты.Добавить("СправочникСсылка.НоменклатурныеГруппы");
	Варианты.Добавить("СправочникСсылка.ВидыНоменклатуры");
	ТипыОбъектов.ВидПродукции = Интеграция_ПодходящийОбъектМетаданных(Варианты);
	
	Варианты = Новый Массив;
	Варианты.Добавить("СправочникСсылка.УпаковкиЕдиницыИзмерения");
	Варианты.Добавить("СправочникСсылка.ЕдиницыИзмерения");
	ТипыОбъектов.Упаковка = Интеграция_ПодходящийОбъектМетаданных(Варианты);
	
	Варианты = Новый Массив;
