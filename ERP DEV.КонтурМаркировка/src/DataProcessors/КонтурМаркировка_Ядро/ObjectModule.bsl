	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ТаблицаКодов_ВТ_ЗаполнитьКолонкуМожноУдалить(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаКодов.КлючКода КАК КлючКода,
	|	ТаблицаКодов.КлючАгрегата КАК КлючАгрегата,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА КодыДокументов.КлючКода ЕСТЬ NULL
	|					И КодыОпераций.КлючКода ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК МожноУдалить
	|ПОМЕСТИТЬ Результат
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО ТаблицаКодов.КлючКода = КодыДокументов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО ТаблицаКодов.КлючКода = КодыОпераций.КлючКода
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаКодов.КлючКода,
	|	ТаблицаКодов.КлючАгрегата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.КлючАгрегата КАК КлючАгрегата,
	|	Т.МожноУдалить КАК МожноУдалить
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	Результат КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Результат");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
