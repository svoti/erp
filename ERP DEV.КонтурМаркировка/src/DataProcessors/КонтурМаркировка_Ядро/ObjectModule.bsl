Функция ТекущийTimestamp()
	
	НачалоВремениUNIX = 62135596800000;
	
	МоментВремени = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВремениUNIX) / МиллисекундВСекунде();
	
	Возврат МоментВремени;
	
КонецФункции

// Получает текст из строки base64
//
// Параметры:
//  СтрокаBase64 - Строка - строка закодированная по алгоритму base64;
//  Кодировка - КодировкаТекста, Строка - (необязательный) кодировка текста;
// 
// Возвращаемое значение:
//  Строка
//
Функция СтрокаИзBase64(СтрокаBase64, Кодировка = "UTF-8") Экспорт
	
	ДвоичныеДанные = Base64Значение(СтрокаBase64);
	
	Если ДвоичныеДанные = Неопределено Тогда
		Результат = СтрокаBase64;
	Иначе
		Результат = СтрокаИзДвоичныхДанных(ДвоичныеДанные, Кодировка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает строку из двоичных данных
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - двоичные данные, в которых содержится строка;
//  Кодировка - КодировкаТекста, Строка - (необязательный) кодировка текста;
// 
// Возвращаемое значение:
//  Строка
//
Функция СтрокаИзДвоичныхДанных(ДвоичныеДанные, Кодировка = "UTF-8")
	
	Если Не ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВерсияПлатформыНиже("8.3.10") Тогда
		
		ИмяФайла = НовыйВременныйФайл();
		ДвоичныеДанные.Записать(ИмяФайла);
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(ИмяФайла, Кодировка);
		Результат = Текст.ПолучитьТекст();
		
		МодульОбщегоНазначения().УдалитьФайл(ИмяФайла);
		
	Иначе
		Результат = Вычислить("ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, Кодировка)");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет что значение есть в строке
//
// Параметры:
//  Строка - Строка - строка, в которой нужно найти значение;
//  Значение - Строка - значение, которое нужно найти в строке;
// 
// Возвращаемое значение:
//  Булево - Истина, если значение есть в строке
//
Функция СтрокаСодержитЗначение(Строка, Значение)
	
	Результат = Найти(Строка, Значение) > 0;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, содержит ли строка только цифры.
//
// Параметры:
//  СтрокаПроверки - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если строка содержит только цифры или пустая
//
Функция ВСтрокеТолькоЦифры(Строка) Экспорт
	
	ДлинаСтроки = СтрДлина(Строка);
	
	Если ДлинаСтроки = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Результат = Истина;
	
	КодСимвола0 = КодСимвола("0");
	КодСимвола9 = КодСимвола("9");
	
	Для Сч = 1 По ДлинаСтроки Цикл
		
		КодСимвола = КодСимвола(Строка, Сч);
		
		Если КодСимвола < КодСимвола0
			Или КодСимвола > КодСимвола9 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат
	
КонецФункции

Функция КодироватьЧислоHEX(Знач Число)
	
	Результат = "";
	
	Если Число <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Словарь = "0123456789ABCDEF";
	
	Пока Истина Цикл
		
		Результат = Сред(Словарь, Число % 16 + 1, 1) + Результат;
		
		Если Число < 16 Тогда
			Прервать;
		КонецЕсли;
		
		Число = Число / 16;
		
	КонецЦикла;
	
	НечетнаяДлина = СтрДлина(Результат) % 2 > 0;
	
	Если НечетнаяДлина тогда
		Результат = "0" + Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодироватьСтрокуURL(Строка)
	
	Результат = "";
	
	Если ВерсияПлатформыНиже("8.3") Тогда
		
		Код_А = КодСимвола("А");
		Код_п = КодСимвола("п");
		Код_р = КодСимвола("р");
		Код_я = КодСимвола("я");
		
		ДлинаСтроки = СтрДлина(Строка);
		
		Для Сч = 1 По ДлинаСтроки Цикл
			
			Символ	 = Сред(Строка, Сч, 1);
			Код		 = КодСимвола(Символ);
			
			ДопустимыйСимвол = Ложь
			Или (Символ >= "a" И Символ <= "z")
			Или (Символ >= "A" И Символ <= "Z")
			Или (Символ >= "0" И Символ <= "9");
			
			Если ДопустимыйСимвол Тогда
				
				Результат = Результат + Символ;
				
			ИначеЕсли Код >= Код_А И Код <= Код_п Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(208) + "%" + КодироватьЧислоHEX(144 + Код - Код_А);
				
			ИначеЕсли Код >= Код_р И Код <= Код_я Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(209) + "%" + КодироватьЧислоHEX(128 + Код - Код_р);
				
			ИначеЕсли Символ = "ё" Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(209) + "%" + КодироватьЧислоHEX(145);
				
			ИначеЕсли Символ= "Ё" Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(208) + "%" + КодироватьЧислоHEX(129);
				
			Иначе
				
				Результат = Результат + "%" + КодироватьЧислоHEX(Код);
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		Результат = Вычислить("КодироватьСтроку(Строка, СпособКодированияСтроки.КодировкаURL)");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

