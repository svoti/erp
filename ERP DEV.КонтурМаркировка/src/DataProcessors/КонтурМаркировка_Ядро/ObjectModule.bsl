КонецФункции

// Возвращает структуру, содержащую значения реквизитов прочитанные из информационной базы
// по ссылке на объект.
// 
//  Если доступа к одному из реквизитов нет, возникнет исключение прав доступа.
//  Если необходимо зачитать реквизит независимо от прав текущего пользователя,
//  то следует использовать предварительный переход в привилегированный режим.
// 
// Параметры:
//  Ссылка    - СправочникСсылка, ДокументСсылка - ссылка на объект;
//
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую, в формате
//              требований к свойствам структуры.
//              Например, "Код, Наименование, Родитель".
//            - Структура, ФиксированнаяСтруктура - в качестве ключа передается
//              псевдоним поля для возвращаемой структуры с результатом, а в качестве
//              значения (опционально) фактическое имя поля в таблице.
//              Если значение не определено, то имя поля берется из ключа.
//            - Массив, ФиксированныйМассив - имена реквизитов в формате требований
//              к свойствам структуры.
//
// Возвращаемое значение:
//  Структура - содержит имена (ключи) и значения затребованных реквизитов.
//              Если строка затребованных реквизитов пуста, то возвращается пустая структура
//
Функция ЗначенияРеквизитовОбъектаЛок(Ссылка, Реквизиты) Экспорт
	
	Результат = Новый Структура;
	
	Если Не ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		СтруктураРеквизитов = Новый Структура(Реквизиты);
	ИначеЕсли ЭтоСтруктура(Реквизиты) Тогда
		СтруктураРеквизитов = Реквизиты;
	ИначеЕсли ЭтоМассив(Реквизиты) Тогда
		СтруктураРеквизитов = Новый Структура;
		Для каждого Реквизит Из Реквизиты Цикл
			СтруктураРеквизитов.Вставить(Реквизит);
		КонецЦикла;
	Иначе
		ВызватьИсключение ПараметрыВСтроку(
		НСтр("ru = 'Неверный тип второго параметра Реквизиты: %1'"),
		ТипЗнч(Реквизиты));
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		Результат.Вставить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстПолей = "";
	Разделитель = "";
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			ИмяПоля = СокрЛП(КлючИЗначение.Значение);
		Иначе
			ИмяПоля = СокрЛП(КлючИЗначение.Ключ);
		КонецЕсли;
		Псевдоним = СокрЛП(КлючИЗначение.Ключ);
		ТекстПолей = ТекстПолей + Разделитель + "
		|	" + ИмяПоля + " КАК " + Псевдоним;
		Разделитель = ",";
	КонецЦикла;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&ТекстПолей КАК ТекстПолей
	|ИЗ
	|	&ИмяТаблицы
	|ГДЕ
	|	Ссылка = &Ссылка";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПолей КАК ТекстПолей", ТекстПолей);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", Ссылка.Метаданные().ПолноеИмя());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение реквизита объекта прочитанного из базы через запрос
// 
// Параметры:
//  Ссылка - ЛюбаяСсылка - ссылка на объект;
//  ИмяРеквизита - Строка - имя реквизита;
// 
// Возвращаемое значение:
//  Произвольный - значение реквизита;
//  Неопределено - если ссылка пустая;
//
Функция ЗначениеРеквизитаОбъектаЛок(Ссылка, ИмяРеквизита) Экспорт
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		СтруктураРеквизита = ЗначенияРеквизитовОбъектаЛок(Ссылка, ИмяРеквизита);
		Если ЗначениеЗаполнено(СтруктураРеквизита) Тогда
			Результат = СтруктураРеквизита[ИмяРеквизита];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Безопасно читает свойство структуры
// 
// Параметры:
//  Структура - Структура - структура;
//  Ключ      - Строка  - ключ;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается,
//                                   если в структуре нет такого ключа;
// 
// Возвращаемое значение:
//   Произвольный - значение свойства
//
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено)
	
	Возврат МодульОбщегоНазначения().СвойствоОбъекта(Структура, Ключ, ЗначениеПоУмолчанию);
	
КонецФункции

// Возвращает значение по ключу соответствия или значение по умолчанию,
// если в соответствии нет такого ключа
// 
// Параметры:
//  Соответствие        - Соответствие - соответствие источник;
//  Ключ                - Произвольный - ключ соответствия;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается в случае,
//                                       если в соответствии нет указанного ключа;
// 
// Возвращаемое значение:
//  Произвольный - значение из соответствия или ЗначениеПоУмолчанию
//
Функция ЗначениеСоответствия(Соответствие, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Попытка
		Результат = Соответствие[Ключ];
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает расширение из имени файла
//
// Параметры:
//  ПутьКФайлу - Строка
// 
// Возвращаемое значение:
//  Строка
//
Функция РасширениеФайла(ПутьКФайлу)
	
	Возврат НовыйФайл(ПутьКФайлу).Расширение;
	
КонецФункции

Процедура ПоменятьМестамиСтрокиВТексте(Текст, Строка1, Строка2) Экспорт
	
	Префикс = Строка(Новый УникальныйИдентификатор);
	ВременнаяСтрока1 = Префикс + "_" + Строка1;
	ВременнаяСтрока2 = Префикс + "_" + Строка2;
	
	Текст = СтрЗаменить(Текст, Строка1, ВременнаяСтрока1);
	Текст = СтрЗаменить(Текст, Строка2, ВременнаяСтрока2);
	Текст = СтрЗаменить(Текст, ВременнаяСтрока1, Строка2);
	Текст = СтрЗаменить(Текст, ВременнаяСтрока2, Строка1);
	
КонецПроцедуры

Функция УдалитьНедопустимыеСимволыXML(Строка) Экспорт
	
	Результат = Строка(Строка);
	
	Пока Истина Цикл
		Поз = НайтиНедопустимыеСимволыXML(Результат);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат = Лев(Результат, Поз - 1) + Сред(Результат, Поз + 1);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

