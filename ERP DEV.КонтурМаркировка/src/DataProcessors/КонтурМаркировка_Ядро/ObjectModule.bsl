Функция Заголовок_UserAgent()
	
	КлючКэш = "UserAgent";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВариантыРасположения = Перечисление_ВариантыРасположенияОбработки();
	
	Расположения = Новый Соответствие;
	Расположения.Вставить(ВариантыРасположения.НаДиске, "disk");
	Расположения.Вставить(ВариантыРасположения.ВСправочнике, "directory");
	Расположения.Вставить(ВариантыРасположения.ВКонфигурации, "configuration");
	Расположения.Вставить(ВариантыРасположения.ВРасширении, "extention");
	
	Расположение = СвойствоСтруктуры(Расположения, РасположениеМодуля(), "");
	
	Результат = ПараметрыВСтроку("Kontur.Mark 1C %1 (%2)", ВерсияОбработки(), Расположение);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

