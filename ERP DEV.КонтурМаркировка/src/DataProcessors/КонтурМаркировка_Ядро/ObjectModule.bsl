Функция ПолныйКодСодержитПеременнуюХарактеристику(ПолныйКод, ПеременнаяХарактеристика)
	
	ПеременныеХарактеристики = Перечисление_ТипыПеременныхХарактеристикТовара();
	Если ПеременнаяХарактеристика = ПеременныеХарактеристики.Вес Тогда
		Результат = ПолныйКодСодержитВес(ПолныйКод);
	ИначеЕсли ПеременнаяХарактеристика = ПеременныеХарактеристики.Длина Тогда
		Результат = ПолныйКодСодержитДлину(ПолныйКод);
	ИначеЕсли ПеременнаяХарактеристика = ПеременныеХарактеристики.Объем Тогда
		Результат = ПолныйКодСодержитОбъем(ПолныйКод);
	ИначеЕсли ПеременнаяХарактеристика = ПеременныеХарактеристики.Количество Тогда
		Результат = ПолныйКодСодержитПеременноеКоличество(ПолныйКод);
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестная переменная характеристика товара: %1'"), ПеременнаяХарактеристика);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьПеременнуюХарактеристикуВПолныйКод(ПолныйКод, Количество, ПеременнаяХарактеристика)
	
	ПеременныеХарактеристики = Перечисление_ТипыПеременныхХарактеристикТовара();
	Если ПеременнаяХарактеристика = ПеременныеХарактеристики.Вес Тогда
		Результат = ДобавитьВесВПолныйКод(ПолныйКод, Количество);
	ИначеЕсли ПеременнаяХарактеристика = ПеременныеХарактеристики.Длина Тогда
		Результат = ДобавитьДлинуВПолныйКод(ПолныйКод, Количество);
	ИначеЕсли ПеременнаяХарактеристика = ПеременныеХарактеристики.Объем Тогда
		Результат = ДобавитьОбъемВПолныйКод(ПолныйКод, Количество);
	ИначеЕсли ПеременнаяХарактеристика = ПеременныеХарактеристики.Количество Тогда
		Результат = ДобавитьПеременноеКоличествоВПолныйКод(ПолныйКод, Количество);
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестная переменная характеристика товара: %1'"), ПеременнаяХарактеристика);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти ПеременнаяХарактеристика

// #Область ТипыОтчетаОНанесении

Процедура ДобавитьСтарыеКодыМаркировкиВНовыеПолныеКодыРасформированияНабора(ТаблицаКодов, КлючНабора)
	
	ТаблицаСтарыхКодов = Новый_ТаблицаКодов();
	ТаблицаСтарыхКодов.Добавить().КлючКода = КлючНабора;
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаСтарыхКодов);
	КодыМаркировки_Прочитать(ТаблицаСтарыхКодов);
	
	ТаблицаЗначений_УдалитьЗначение(ТаблицаСтарыхКодов, "КлючКода", КлючНабора);
	
	Если ТаблицаКодов.Количество() <> ТаблицаСтарыхКодов.Количество() Тогда
		ТекстОшибки = НСтр("ru='Количество кодов не соответствует составу расформированного набора'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	ТаблицаКодов.Сортировать("Товар");
	ТаблицаСтарыхКодов.Сортировать("Товар");
	
	Для Индекс = 0 По ТаблицаСтарыхКодов.Количество() - 1 Цикл
		
		СтрНовая = ТаблицаКодов[Индекс];
		СтрСтарая = ТаблицаСтарыхКодов[Индекс];
		
		Если СтрНовая.Товар <> СтрСтарая.Товар Тогда
			ШаблонОшибки = НСтр("ru='Не удалось подобрать новый код маркировки для вложенного кода %1'");
			ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, СтрСтарая.КодМаркировки);
		КонецЕсли;
		
		СтрНовая.ПолныйКод = ДобавитьКодМаркировкиВПолныйКод(СтрНовая.ПолныйКод, СтрСтарая.КодМаркировки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОсновнойПолныйКодВПолныеКодыРазделенияТовара(ТаблицаКодов, КлючОсновногоКода)
	
	ПолныйКодШапки = КодМаркировки_ПолныйКод(КлючОсновногоКода);
	
	Если Не ЗначениеЗаполнено(ПолныйКодШапки) Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось найти полный код для разделения товара: %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, КодМаркировки_НайтиПоКлючу(КлючОсновногоКода));
	КонецЕсли;
	
	Для Каждого Стр Из ТаблицаКодов Цикл
		Стр.ПолныйКод = ДобавитьКодМаркировкиВПолныйКод(Стр.ПолныйКод, ПолныйКодШапки);
	КонецЦикла;
	
КонецПроцедуры

Функция ДобавитьКодМаркировкиВПолныйКод(ПолныйКод, КодМаркировки)
	
	Возврат ПолныйКод + РазделительRS() + КодМаркировки;
	
КонецФункции

// #КонецОбласти ТипыОтчетаОНанесении

// #Область РазделениеСклеенныхКодов

Функция РазделениеКодов_ФорматыКодовМаркировкиПоВидамПродукции()
	
	КлючКэш = "ФорматыКодовМаркировкиПоВидамПродукции";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидПродукции");
	Результат.Колонки.Добавить("ТипКодаВСервисе");
	Результат.Колонки.Добавить("РегулярноеВыражение");
	
	КолонкаВидПродукции = 1;
	КолонкаТипКода = 2;
	КолонкаРегулярноеВыражение = 3;
	
	ТабДок = ПолучитьМакет("ФорматыКодовМаркировки");
	
	Для Строка = 2 По ТабДок.ВысотаТаблицы Цикл
		
		ВидПродукцииСтр = СокрЛП(ТабДок.ПолучитьОбласть(Строка, КолонкаВидПродукции).Область().Текст);
		ТипКодаВСервисе = СокрЛП(ТабДок.ПолучитьОбласть(Строка, КолонкаТипКода).Область().Текст);
		РегулярноеВыражениеШаблон = СокрЛП(ТабДок.ПолучитьОбласть(Строка, КолонкаРегулярноеВыражение).Область().Текст);
		
		
		Стр = Результат.Добавить();
		Стр.ВидПродукции = ВидыПродукции[ВидПродукцииСтр];
		Стр.ТипКодаВСервисе = ТипКодаВСервисе;
		Стр.РегулярноеВыражение = РазделениеКодов_РегулярноеВыражениеИзШаблона(РегулярноеВыражениеШаблон);
		
	КонецЦикла;
	
	Результат.Индексы.Добавить("ВидПродукции, ТипКодаВСервисе");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция РазделениеКодов_РегулярноеВыражениеИзШаблона(ШаблонРегулярногоВыражения)
	
	Результат = СтрЗаменить(ШаблонРегулярногоВыражения, "{GS}", РазделительGS1());
	Результат = СтрЗаменить(Результат, "{СимволКМ}", РазделениеКодов_КлассСимволаКМ());
	
	Возврат Результат;
	
КонецФункции

Функция РазделениеКодов_КлассСимволаКМ()
	
	// Любой символ, кроме GS-разделителя.
	// Не сужаем до латиницы/цифр, потому что криптохвост может содержать спецсимволы.
	Возврат "[^" + РазделительGS1() + "]";
	
КонецФункции

Функция РазделениеКодов_ЭтоКИТУ(СтрокаКода)
	
	ТипУпаковки = ТипУпаковкиПоТипуКодаМаркировкиИзСервиса(СтрокаКода.markingCodeType);
	
	Если ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция РазделениеКодов_СоединитьСовпадения(Совпадения)
	
	Результат = "";
	
	Для Каждого Совпадение Из Совпадения Цикл
		Результат = Результат + Совпадение;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // РазделениеСклеенныхКодов

Функция ДобавитьЗаводскойСерийныйНомерВПолныйКод(Знач ПолныйКод, ЗСН)
	
	СтрокаЗСН = Base64ИзСтроки(ЗСН);
	РазделительGS = РазделительGS1();
	
	Разделитель = "";
	Если Найти(ПолныйКод, РазделительGS) > 0 Тогда
		Разделитель = РазделительGS;
	КонецЕсли;
	
	Идентификатор = Разделитель + ИдентификаторПрименения_ЗСН();
	ДлинаПоказателя = СтрДлина(СтрокаЗСН);
	ДлинаИдентификатора = СтрДлина(Идентификатор);
	ИдентификаторСПоказателем = Прав(ПолныйКод, ДлинаИдентификатора + ДлинаПоказателя);
	
	Если Лев(ИдентификаторСПоказателем, ДлинаИдентификатора) = Идентификатор Тогда
		Возврат ПолныйКод; // Код уже содержит ЗСН
	КонецЕсли;
	
	Возврат ПолныйКод + Идентификатор + СтрокаЗСН;
	
КонецФункции

// Возвращает представление строки табличной части с лидирующими нулями в зависимости от количества строк
//
// Параметры:
//  НомерСтроки     - Число - номер строки табличной части;
//  Представление   - Строка - строковое представление строки табличной части;
//  КоличествоСтрок - Число - упаковка номенклатуры 1С;
// 
// Возвращаемое значение:
//  Строка - представление строки табличной части с лидирующими нулями
//
Функция ПредставлениеСтрокиСНомером(НомерСтроки, Представление, КоличествоСтрок) Экспорт
	
	КоличествоСимволов = СтрДлина(КоличествоСтрок);
	НомерСтрокиСНулями = Формат(НомерСтроки, "ЧЦ=" + КоличествоСимволов + "; ЧВН=; ЧГ=0");
	
	Возврат ПараметрыВСтроку("(%1) %2", НомерСтрокиСНулями, Представление);
	
КонецФункции

Функция ПолноеНаименованиеНоменклатуры1С(Номенклатура) Экспорт
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяСправочника = Номенклатура.Метаданные().ПолноеИмя();
	
	Если ЕстьМетаданные(ИмяСправочника + ".Реквизиты.НаименованиеПолное") Тогда
		НаименованиеПолное = ЗначениеРеквизитаОбъектаЛок(Номенклатура, "НаименованиеПолное");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
		Результат = СокрЛП(НаименованиеПолное);
	Иначе
		Результат = СокрЛП(Номенклатура);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеХарактеристики(Характеристика) Экспорт
	
	Если Не ЗначениеЗаполнено(Характеристика) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяСправочника = Характеристика.Метаданные().ПолноеИмя();
	
	Если ЕстьМетаданные(ИмяСправочника + ".Реквизиты.НаименованиеПолное") Тогда
		НаименованиеПолное = ЗначениеРеквизитаОбъектаЛок(Характеристика, "НаименованиеПолное");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
		Результат = СокрЛП(НаименованиеПолное);
	Иначе
		Результат = СокрЛП(Характеристика);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает рабочее представление номенклатуры 1С
//
// Параметры:
//  АналитикаНоменклатуры - Структура - см. Новый_АналитикаНоменклатуры1С();
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  Строка - рабочее представление номенклатуры
//
Функция ПредставлениеНоменклатуры1С(АналитикаНоменклатуры, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		КлючКэш = СтрокаАналитикиНоменклатуры1С(АналитикаНоменклатуры);
		Результат = КэшРезультатов[КлючКэш];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	НаименованиеНоменклатуры = СокрЛП(АналитикаНоменклатуры.Номенклатура);
	
	ТекстВСкобках = ПредставлениеНоменклатуры_ТекстВСкобках(АналитикаНоменклатуры);
	
	Если ЗначениеЗаполнено(ТекстВСкобках) Тогда
		Результат = ПараметрыВСтроку("%1 (%2)", НаименованиеНоменклатуры, ТекстВСкобках);
	Иначе
		Результат = НаименованиеНоменклатуры;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление номенклатуры 1С для печати
//
// Параметры:
//  АналитикаИлиКлючНоменклатуры - СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С, Структура, СтрокаТаблицыЗначений - содержит поля:
//   * Номенклатура   - СправочникСсылка - номенклатура 1С;
//   * Характеристика - СправочникСсылка - характеристика номенклатуры 1С;
//   * Упаковка       - СправочникСсылка - упаковка номенклатуры 1С;
//   * Серия          - СправочникСсылка - серия номенклатуры 1С;
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  Строка - представление номенклатуры для печати
//
Функция ПредставлениеНоменклатуры1СДляПечати(АналитикаИлиКлючНоменклатуры, КэшРезультатов = Неопределено) Экспорт
	
	ЭтоКлючНоменклатуры = ТипЗнч(АналитикаИлиКлючНоменклатуры) = Тип("СправочникСсылка.КонтурМаркировка_КлючиНоменклатуры1С");
	
	Если КэшРезультатов <> Неопределено Тогда
		
		Если ЭтоКлючНоменклатуры Тогда
			КлючКэш = АналитикаИлиКлючНоменклатуры;
		Иначе
			КлючКэш = СтрокаАналитикиНоменклатуры1С(АналитикаИлиКлючНоменклатуры);
		КонецЕсли;
		
		Результат = КэшРезультатов[КлючКэш];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоКлючНоменклатуры Тогда
		АналитикаНоменклатуры = АналитикаНоменклатуры1С(АналитикаИлиКлючНоменклатуры);
	Иначе
		АналитикаНоменклатуры = АналитикаИлиКлючНоменклатуры;
	КонецЕсли;
	
	Результат = ПолноеНаименованиеНоменклатуры1С(АналитикаНоменклатуры.Номенклатура);
	
	ТекстВСкобках = ПредставлениеНоменклатуры_ТекстВСкобках(АналитикаНоменклатуры, Истина);
	Если ЗначениеЗаполнено(ТекстВСкобках) Тогда
		Результат = ПараметрыВСтроку("%1 (%2)", Результат, ТекстВСкобках);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(КлючКэш, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНоменклатуры_ТекстВСкобках(АналитикаНоменклатуры, ДляПечати = Ложь)
	
	Результат = "";
	Разделитель = "";
	
	Если ДляПечати Тогда
		НаименованиеХарактеристики = НаименованиеХарактеристики(АналитикаНоменклатуры.Характеристика);
	Иначе
		НаименованиеХарактеристики = СокрЛП(АналитикаНоменклатуры.Характеристика);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеХарактеристики) Тогда
		Результат = Результат + Разделитель + СокрЛП(НаименованиеХарактеристики);
		Разделитель = ", ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АналитикаНоменклатуры.Упаковка) Тогда
		Результат = Результат + Разделитель + СокрЛП(АналитикаНоменклатуры.Упаковка);
		Разделитель = ", ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АналитикаНоменклатуры.Серия) Тогда
		Результат = Результат + Разделитель + СокрЛП(АналитикаНоменклатуры.Серия);
		Разделитель = ", ";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует текст с первыми пятью кодами маркировки через запятую,
// если кодов больше, например 8, то добавляет текст "и еще 3"
//
// Параметры:
//  КодыМаркировки - Массив, ТаблицаЗначений - таблица содержит колонку КодМаркировки
// 
// Возвращаемое значение:
//  Строка - текст со списком кодов
//
Функция СписокКодовДляТекстаОшибки(КодыМаркировки)
	
	Возврат МодульКонтроль().СписокКодовДляТекстаОшибки(КодыМаркировки);
	
КонецФункции

Функция ПустоеЗначениеТипаЛок(ТипЗначения) Экспорт
	
	Если ТипЗнч(ТипЗначения) = Тип("ОписаниеТипов") Тогда
		ОписаниеТипа = ТипЗначения;
	Иначе
		ОписаниеТипа = Новый ОписаниеТипов(ЗначениеВМассиве(ТипЗначения));
	КонецЕсли;
	
	Возврат ОписаниеТипа.ПривестиЗначение();
	
КонецФункции

Функция КаталогИнформационнойБазыЛок()
	
	Параметры = ПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
	
	Возврат СвойствоСтруктуры(Параметры, "File", "");
	
КонецФункции

Функция ПараметрыИзСтроки(Знач СтрокаПараметров, Знач Разделитель = ";")
	
	Результат = Новый Структура;
	
	ОписаниеПараметра = "";
	НайденоНачалоСтроки = Ложь;
	НомерПоследнегоСимвола = СтрДлина(СтрокаПараметров);
	Для НомерСимвола = 1 По НомерПоследнегоСимвола Цикл
		Символ = Сред(СтрокаПараметров, НомерСимвола, 1);
		Если Символ = """" Тогда
			НайденоНачалоСтроки = Не НайденоНачалоСтроки;
		КонецЕсли;
		Если Символ <> Разделитель Или НайденоНачалоСтроки Тогда
			ОписаниеПараметра = ОписаниеПараметра + Символ;
		КонецЕсли;
		Если Символ = Разделитель И Не НайденоНачалоСтроки Или НомерСимвола = НомерПоследнегоСимвола Тогда
			// BSLLS:DeprecatedFind-off
			Позиция = Найти(ОписаниеПараметра, "=");
			// BSLLS:DeprecatedFind-on
			Если Позиция > 0 Тогда
				ИмяПараметра = СокрЛП(Лев(ОписаниеПараметра, Позиция - 1));
				ЗначениеПараметра = СокрЛП(Сред(ОписаниеПараметра, Позиция + 1));
				ЗначениеПараметра = СократитьКавычки(ЗначениеПараметра);
				Результат.Вставить(ИмяПараметра, ЗначениеПараметра);
			КонецЕсли;
			ОписаниеПараметра = "";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоГлавныйУзелРИБ()
	
	КлючКэш = "ЭтоГлавныйУзелРИБ";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = (ПланыОбмена.ГлавныйУзел() = Неопределено);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция МакетОбработки(ИмяМакета)
	
	Макеты = ЭтотОбъект.Метаданные().Макеты;
	
	Если Макеты.Найти(ИмяМакета) = Неопределено Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'В составе обработки не найден макет ""%1""'"), ИмяМакета);
	КонецЕсли;
	
	Результат = ЭтотОбъект.ПолучитьМакет(ИмяМакета);
	
	Возврат Результат;
	
КонецФункции

// Контракт для записи набора в регистр сведений
//
// Параметры:
//  ИмяРегистра - Строка - имя регистра;
//  ПоляОтбора  - Строка - поля, которые нужно использовать в отборе набора записей;
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ИмяРегистра - Строка - имя регистра из параметра;
//   * ПоляОтбора  - Строка - поля для установки отбора в наборе записей,
//                            при записи значения берутся из ТаблицаНабора;
//   * РежимЗаписи - Строка - см. Перечисление_РежимыЗаписиНабора(), варианты:
//      * Добавление - добавляет новые записи;
//      * Обновление - обновляет существующие записи совпадающие по ключевым полям;
//      * Удаление   - удаляет существующие записи из регистра сведений;
//   * ТаблицаНабора - ТаблицаЗначений - содержит записи для загрузки в набор;
//
Функция Новый_ОписаниеНабораРегистраСведений(ИмяРегистра, ПоляОтбора = "") Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяРегистра", ИмяРегистра);
	Результат.Вставить("ПоляОтбора", ПоляОтбора);
	Результат.Вставить("РежимЗаписи", "");
	
	Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Результат.Вставить("ТаблицаНабора", Набор.ВыгрузитьКолонки());
	
	Возврат Результат;
	
КонецФункции

// Выполняет удаление, обновление и добавление записей в регистре сведений
// Необходимо, чтобы ТаблицаНабора содержала колонку РежимЗаписи
//
// Параметры:
//  ОписаниеНабора - Структура - см. Новый_ОписаниеНабораРегистраСведений()
//
Процедура ЗаписатьНаборыРегистраСведенийСРазнымиРежимамиЗаписи(ОписаниеНабора)
	
	Если Не ЗначениеЗаполнено(ОписаниеНабора.ТаблицаНабора) Тогда
		Возврат;
	КонецЕсли;
	
	РежимыЗаписи = Перечисление_РежимыЗаписиНабора();
	ТаблицаНабора = ОписаниеНабора.ТаблицаНабора;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаНабора, "РежимЗаписи");
	
	ТаблицаУдаления = ТаблицаНабора.Скопировать(Новый Структура("РежимЗаписи", РежимыЗаписи.Удаление));
	ТаблицаОбновления = ТаблицаНабора.Скопировать(Новый Структура("РежимЗаписи", РежимыЗаписи.Обновление));
	ТаблицаДобавления = ТаблицаНабора.Скопировать(Новый Структура("РежимЗаписи", РежимыЗаписи.Добавление));
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаНабора, "РежимЗаписи");
	ТаблицаНабора.Очистить();
	
	ОписаниеНабора.РежимЗаписи = РежимыЗаписи.Удаление;
	ОписаниеНабора.ТаблицаНабора = ТаблицаУдаления;
	ЗаписатьНаборРегистраСведений(ОписаниеНабора);
	
	ОписаниеНабора.РежимЗаписи = РежимыЗаписи.Обновление;
	ОписаниеНабора.ТаблицаНабора = ТаблицаОбновления;
	ЗаписатьНаборРегистраСведений(ОписаниеНабора);
	
	ОписаниеНабора.РежимЗаписи = РежимыЗаписи.Добавление;
	ОписаниеНабора.ТаблицаНабора = ТаблицаДобавления;
	ЗаписатьНаборРегистраСведений(ОписаниеНабора);
	
КонецПроцедуры

// Записывает набор записей в регистр сведений с необходимым режимом записи
// Поддерживает запись сразу нескольких наборов по указанным полям отбора
//
// Параметры:
//  ОписаниеНабора - Структура - см. Новый_ОписаниеНабораРегистраСведений()
//
Процедура ЗаписатьНаборРегистраСведений(ОписаниеНабора) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписаниеНабора.ТаблицаНабора) Тогда
		Возврат;
	КонецЕсли;
	
	РежимыЗаписи = Перечисление_РежимыЗаписиНабора();
	
	Если Не ЗначениеЗаполнено(ОписаниеНабора.ИмяРегистра) Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось записать набор регистра сведений, не указано имя регистра'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеНабора.РежимЗаписи) Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось записать набор регистра сведений ""%1"", не указан режим записи'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ОписаниеНабора.ИмяРегистра);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Если ОписаниеНабора.РежимЗаписи = РежимыЗаписи.Замещение Тогда
		ЗаписатьНаборРегистраСведенийЗамещение(ОписаниеНабора);
	ИначеЕсли ОписаниеНабора.РежимЗаписи = РежимыЗаписи.Добавление Тогда
		ЗаписатьНаборРегистраСведенийДобавление(ОписаниеНабора);
	ИначеЕсли ВерсияПлатформыНиже("8.3.26.1318") Тогда
		ЗаписатьНаборРегистраСведенийОбновлениеУдалениеБезСлияния(ОписаниеНабора);
	Иначе
		ЗаписатьНаборРегистраСведенийОбновлениеУдаление(ОписаниеНабора);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьНаборРегистраСведенийЗамещение(ОписаниеНабора)
	
	ТаблицаНабора = ОписаниеНабора.ТаблицаНабора;
	ИмяРегистра = ОписаниеНабора.ИмяРегистра;
	ПоляОтбора = ОписаниеНабора.ПоляОтбора;
	КолонкиОтбора = РазделитьСтроку(ПоляОтбора);
	
	ЭтоОдинНабор = Истина;
	Если ЗначениеЗаполнено(ПоляОтбора) Тогда
		Отбор = Новый Структура(ПоляОтбора);
		ЗаполнитьЗначенияСвойств(Отбор, ТаблицаНабора[0]);
		ЭтоОдинНабор = (ТаблицаНабора.НайтиСтроки(Отбор).Количество() = ТаблицаНабора.Количество());
	КонецЕсли;
	
	Если ЭтоОдинНабор Тогда
		Порции = ЗначениеВМассиве(Новый Структура("ЧастьТаблицы", ТаблицаНабора));
	Иначе
		Порции = ТаблицаЗначений_РазбитьНаТаблицы(ТаблицаНабора, ПоляОтбора);
		ТаблицаНабора.Очистить();
	КонецЕсли;
	
	Для Каждого Порция Из Порции Цикл
		
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Для Каждого ИмяКолонки Из КолонкиОтбора Цикл
			Набор.Отбор[ИмяКолонки].Установить(Порция.ЧастьТаблицы[0][ИмяКолонки]);
		КонецЦикла;
		
		Набор.Загрузить(Порция.ЧастьТаблицы);
		Порция.ЧастьТаблицы.Очистить();
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНаборРегистраСведенийДобавление(ОписаниеНабора)
	
	ИмяРегистра = ОписаниеНабора.ИмяРегистра;
	ТаблицаНабора = ОписаниеНабора.ТаблицаНабора;
	
	Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Набор.Загрузить(ТаблицаНабора);
	ТаблицаНабора.Очистить();
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать(Ложь);
	
КонецПроцедуры

Процедура ЗаписатьНаборРегистраСведенийОбновлениеУдаление(ОписаниеНабора)
	
	ИмяРегистра = ОписаниеНабора.ИмяРегистра;
	ТаблицаНабора = ОписаниеНабора.ТаблицаНабора;
	РежимЗаписиНабора = ПредопределенноеЗначение("РежимЗамещения." + ОписаниеНабора.РежимЗаписи);
	
	Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Набор.Загрузить(ТаблицаНабора);
	ТаблицаНабора.Очистить();
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать(РежимЗаписиНабора);
	
КонецПроцедуры

Процедура ЗаписатьНаборРегистраСведенийОбновлениеУдалениеБезСлияния(ОписаниеНабора)
	
	Если Не ЗначениеЗаполнено(ОписаниеНабора.ПоляОтбора) Тогда
		ЗаписатьНаборРегистраСведенийЧерезМенеджерЗаписей(ОписаниеНабора);
		Возврат;
	КонецЕсли;
	
	НебольшоеКоличествоЗаписей = НебольшоеКоличествоЗаписейРегистра();
	РежимыЗаписи = Перечисление_РежимыЗаписиНабора();
	ТаблицаНабора = ОписаниеНабора.ТаблицаНабора;
	ИмяРегистра = ОписаниеНабора.ИмяРегистра;
	РежимЗаписи = ОписаниеНабора.РежимЗаписи;
	ПоляОтбора = ОписаниеНабора.ПоляОтбора;
	КолонкиОтбора = РазделитьСтроку(ПоляОтбора);
	ТипБулево = ОписаниеТипа_Булево();
	РежимЗаписиНабора = Истина;
	
	Отбор = Новый Структура(ПоляОтбора);
	ЗаполнитьЗначенияСвойств(Отбор, ТаблицаНабора[0]);
	ЭтоОдинНабор = (ТаблицаНабора.НайтиСтроки(Отбор).Количество() = ТаблицаНабора.Количество());
	
	ПоляИзмерений = ИменаИзмеренийРегистраСведений(ИмяРегистра);
	ЗначенияИзмерений = Новый Структура(ПоляИзмерений);
	
	Если ЭтоОдинНабор Тогда
		Порции = ЗначениеВМассиве(Новый Структура("ЧастьТаблицы", ТаблицаНабора));
	Иначе
		Порции = ТаблицаЗначений_РазбитьНаТаблицы(ТаблицаНабора, ПоляОтбора);
		ТаблицаНабора.Очистить();
	КонецЕсли;
	
	Для Каждого Порция Из Порции Цикл
		
		Если Порция.ЧастьТаблицы.Количество() <= НебольшоеКоличествоЗаписей Тогда
			ОписаниеНабора.ТаблицаНабора = Порция.ЧастьТаблицы;
			ЗаписатьНаборРегистраСведенийЧерезМенеджерЗаписей(ОписаниеНабора);
			Продолжить;
		КонецЕсли;
		
		ТаблицаЗначений_ДобавитьИндекс(Порция.ЧастьТаблицы, ПоляИзмерений);
		
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Для Каждого ИмяКолонки Из КолонкиОтбора Цикл
			Набор.Отбор[ИмяКолонки].Установить(Порция.ЧастьТаблицы[0][ИмяКолонки]);
		КонецЦикла;
		
		Набор.Прочитать();
		
		Если РежимЗаписи = РежимыЗаписи.Удаление Тогда
			
			Для Сч = -(Набор.Количество() - 1) По 0 Цикл
				Индекс = -Сч;
				ЗаполнитьЗначенияСвойств(ЗначенияИзмерений, Набор[Индекс]);
				Если ЗначениеЗаполнено(Порция.ЧастьТаблицы.НайтиСтроки(ЗначенияИзмерений)) Тогда
					Набор.Удалить(Индекс);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			ТабНабора = Набор.Выгрузить();
			ЕстьИзменения = Ложь;
			
			Для Каждого Стр Из ТабНабора Цикл
				ЗаполнитьЗначенияСвойств(ЗначенияИзмерений, Стр);
				СтрокиТаблицы = Порция.ЧастьТаблицы.НайтиСтроки(ЗначенияИзмерений);
				Если ЗначениеЗаполнено(СтрокиТаблицы) Тогда
					ЗаполнитьЗначенияСвойств(Стр, СтрокиТаблицы[0], , ПоляИзмерений);
					ЕстьИзменения = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьИзменения Тогда
				Набор.Загрузить(ТабНабора);
			КонецЕсли;
			
			ТабНабора.Очистить();
			
		КонецЕсли;
		
		Порция.ЧастьТаблицы.Индексы.Очистить();
		Порция.ЧастьТаблицы.Очистить();
		
		Если Набор.Модифицированность() Тогда
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Записать(РежимЗаписиНабора);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНаборРегистраСведенийЧерезМенеджерЗаписей(ОписаниеНабора)
	
	РежимыЗаписи = Перечисление_РежимыЗаписиНабора();
	ТаблицаНабора = ОписаниеНабора.ТаблицаНабора;
	ИмяРегистра = ОписаниеНабора.ИмяРегистра;
	РежимЗаписи = ОписаниеНабора.РежимЗаписи;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		Для Каждого Стр Из ТаблицаНабора Цикл
			
			Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Стр);
			
			Если РежимЗаписи = РежимыЗаписи.Удаление Тогда
				Запись.Удалить();
			Иначе
				Запись.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	ТаблицаНабора.Очистить();
	
КонецПроцедуры

// #КонецОбласти СлужебныеПроцедурыИФункции

// #Область МетодыОбщегоНазначения

// Возвращает значение в хранилище с максимальным сжатием
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  ХранилищеЗначения
Функция ЗначениеВХранилище(Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		Результат = Значение;
	Иначе
		Результат = Новый ХранилищеЗначения(Значение, Новый СжатиеДанных(9));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение в массиве
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Массив
Функция ЗначениеВМассиве(Значение)
	
	Если ЭтоМассив(Значение)Тогда
		Результат = Значение;
	Иначе
		Результат = Новый Массив;
		Результат.Добавить(Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Безопасно получает значение из массива по его индексу
//
// Параметры:
//  Массив              - Массив       - массив, из которого нужно получить значение
//  ИндексЗначения      - Число        - индекс значения
//  ЗначениеПоУмолчанию - Произвольный - значение, которое нужно вернуть
//                                       если указанный индекс выходит за границу массива
// 
// Возвращаемое значение:
//  Произвольный - значение из массива. ЗначениеПоУмолчанию если индекс выходит за границы массива
//
Функция ЗначениеИзМассива(Массив, ИндексЗначения, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ИндексЗначения <= Массив.ВГраница() Тогда
		Результат = Массив[ИндексЗначения];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Дополняет массив значениями из другого массива
//
// Параметры:
//  МассивПриемник - Массив - массив, в который необходимо добавить значения;
//  МассивИсточник - Массив - массив, из которого нужно взять значения;
//  ТолькоНовыеЗначения - Булево - (необязательный) Истина, если в приемник нужно добавить только новые значения;
//  ДобавлятьПустыеЗначения - Булево - (необязательный) Ложь, если пустые значения в приемник добавлять не нужно;
//
Процедура ДополнитьМассив(МассивПриемник, МассивИсточник, ТолькоНовыеЗначения = Ложь, ДобавлятьПустыеЗначения = Истина) Экспорт
	
	Если ТолькоНовыеЗначения Тогда
		
		ЗначенияПриемника = Новый Соответствие;
		Для Каждого Значение Из МассивПриемник Цикл
			ЗначенияПриемника.Вставить(Значение, Истина);
		КонецЦикла;
		
		Для Каждого Значение Из МассивИсточник Цикл
			Если Не ДобавлятьПустыеЗначения
				И Не ЗначениеЗаполнено(Значение) Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначенияПриемника[Значение] = Неопределено Тогда
				МассивПриемник.Добавить(Значение);
				ЗначенияПриемника.Вставить(Значение, Истина);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Удаляет значение из массива, если оно в нем есть
//
// Параметры:
//  Массив - Массив - массив, из которого нужно удалить значение;
//  Значение - Значение - значение, которое нужно удалить;
//
Процедура УдалитьЗначениеИзМассива(Массив, Значение) Экспорт
	
	ИндексЗначения = Массив.Найти(Значение);
	Пока ИндексЗначения <> Неопределено Цикл
		Массив.Удалить(ИндексЗначения);
		ИндексЗначения = Массив.Найти(Значение);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет значение в массив, если его там еще нет
//
// Параметры:
//  Массив - Массив - массив, в который нужно добавить значение;
//  Значение - Значение - значение, которое нужно добавить;
//
Процедура ДобавитьЗначениеВМассив(Массив, Значение) Экспорт
	
	Если Не МассивСодержитЗначение(Массив, Значение) Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

// Выгружает значения поля из массива структур в новый массив
//
// Параметры:
//  МассивСтруктур - Массив - массив содержит структуры;
//  ИмяПоля - Строка - поле, значения которого нужно выгрузить;
// 
// Возвращаемое значение:
//  Массив - массив значений из структур
//
Функция МассивСтруктур_Выгрузить(МассивСтруктур, ИмяПоля) Экспорт
	
	Результат = Новый Массив;
	
	Для каждого Элемент Из МассивСтруктур Цикл
		Результат.Добавить(Элемент[ИмяПоля]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ищет первую подходящую структуру в массиве структур с одинаковым набором свойств
//
// Параметры:
//  МассивСтруктур  - Массив    - содержит структуры;
//  ПараметрыОтбора - Структура - параметры отбора, где:
//   * Ключ     - имя свойства в структурах массива;
//   * Значение - подходящее значение;
//
// Возвращаемое значение:
//  Структура    - первая найденная структура;
//  Неопределено - если строку найти не удалось;
//
Функция МассивСтруктур_НайтиСтроку(МассивСтруктур, ПараметрыОтбора) Экспорт
	
	МассивСтрок = МассивСтруктур_НайтиСтроки(МассивСтруктур, ПараметрыОтбора);
	
	Если ЗначениеЗаполнено(МассивСтрок) Тогда
		Результат = МассивСтрок[0];
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ищет подходящие структуры в массиве структур с одинаковым набором свойств
//
// Параметры:
//  МассивСтруктур  - Массив    - содержит структуры с одинаковым набором свойств;
//  ПараметрыОтбора - Структура - параметры отбора, где:
//   * Ключ     - имя свойства в структурах массива;
//   * Значение - подходящее значение;
//
// Возвращаемое значение:
//  Массив - содержит подходящие структуры
//
Функция МассивСтруктур_НайтиСтроки(МассивСтруктур, ПараметрыОтбора) Экспорт
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(МассивСтруктур) Тогда
		
		Для Каждого Структура Из МассивСтруктур Цикл
			
			СтруктураСоответствуетОтбору = Истина;
			
			Для Каждого ЭлементОтбора Из ПараметрыОтбора Цикл
				
				Если Структура[ЭлементОтбора.Ключ] <> ЭлементОтбора.Значение Тогда
					СтруктураСоответствуетОтбору = Ложь;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если СтруктураСоответствуетОтбору Тогда
				Результат.Добавить(Структура);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выполняет запрос и получает значение поля из первой строки результата
//
// Параметры:
//  Запрос - Запрос - запрос который нужно выполнить;
//  ИмяПоля - Строка - (необязательный) имя поля, значение которого нужно получить;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) значение, которое нужно вернуть
//                                        если результат запроса пустой;
// 
// Возвращаемое значение:
//  Произвольный - значение из результата запроса или значение по умолчанию
//
Функция ПолучитьРезультатЗапроса(Запрос, ИмяПоля = "Ссылка", ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка[ИмяПоля];
	Иначе
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выполняет запрос и получает массив значений из поля результата
//
// Параметры:
//  Запрос - Запрос - запрос который нужно выполнить;
//  ИмяПоля - Строка - (необязательный) имя поля, значения которого нужно получить;
// 
// Возвращаемое значение:
//  Массив - значения из результата запроса
//
Функция МассивИзРезультатаЗапроса(Запрос, ИмяПоля = "Ссылка")
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(ИмяПоля);
	
	Возврат Результат;
	
КонецФункции

// Проверяет что значение есть в массиве
//
// Параметры:
//  Массив - Массив - массив, в котором нужно найти значение;
//  Значение - Произвольный - значение, которое нужно найти в массиве;
// 
// Возвращаемое значение:
//  Булево - Истина, если значение есть в массиве
//
Функция МассивСодержитЗначение(Массив, Значение)
	
	Возврат Массив.Найти(Значение) <> Неопределено;
	
КонецФункции

// Выгружает массив в таблицу значений
//
// Параметры:
//  Массив - Массив - массив;
//  ИмяКолонки - Строка - (необязательный) имя колонки;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит одну колонку и значения из массива
//
Функция ТаблицаИзМассива(Массив, ИмяКолонки = "Ссылка")
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить(ИмяКолонки);
	
	Для каждого Значение Из Массив Цикл
		Стр = Результат.Добавить();
		Стр[ИмяКолонки] = Значение;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет в таблицу приемник строки из таблицы источника
//
// Параметры:
//  Приемник - ТаблицаЗначений - таблица, в которую нужно добавить строки;
//  Источник - ТаблицаЗначений - таблица, из которой нужно взять строки;
//
Процедура ТаблицаЗначений_Дополнить(Приемник, Источник) Экспорт
	
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Если Приемник = Источник Тогда
		ВызватьИсключение НСтр("ru = 'Ошибка дополнения таблицы значений: приемник равен источнику'");
	КонецЕсли;
	
	Для каждого СтрИсточник Из Источник Цикл
		ЗаполнитьЗначенияСвойств(Приемник.Добавить(), СтрИсточник);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в таблицу приемник колонки из таблицы источника
//
// Параметры:
//  Приемник - ТаблицаЗначений - таблица, в которую нужно добавить колонки;
//  Источник - ТаблицаЗначений - таблица, из которой нужно взять колонки;
//
Процедура ТаблицаЗначений_ДополнитьКолонки(Приемник, Источник) Экспорт
	
	Для каждого Колонка Из Источник.Колонки Цикл
		Если Приемник.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			Приемник.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Выгружает уникальные значения колонки в массив и удаляет из него пустые значения
//
// Параметры:
//  ТаблицаЗначений       - ТаблицаЗначений - таблица значений;
//  ИмяКолонки            - Строка - имя колонки;
//  УдалитьПустыеЗначения - Булево - (необязательный), Истина если нужно удалить из результата пустые значения;
// 
// Возвращаемое значение:
//  Массив - уникальные значения колонки
//
Функция ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаЗначений, ИмяКолонки, УдалитьПустыеЗначения = Ложь) Экспорт
	
	Таб = ТаблицаЗначений.Скопировать(, ИмяКолонки);
	Таб.Свернуть(ИмяКолонки);
	
	Если УдалитьПустыеЗначения Тогда
		ТаблицаЗначений_УдалитьПустыеСтроки(Таб, ИмяКолонки);
	КонецЕсли;
	
	Возврат Таб.ВыгрузитьКолонку(ИмяКолонки);
	
КонецФункции

// Удаляет из таблицы значений строки с пустым значением колонки
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  ИмяКолонки - Строка - имя колонки, которую нужно проверить;
//
Процедура ТаблицаЗначений_УдалитьПустыеСтроки(ТаблицаЗначений, ИмяКолонки) Экспорт
	
	ТипыКолонки = ТаблицаЗначений.Колонки[ИмяКолонки].ТипЗначения.Типы();
	Если ТипыКолонки.Количество() = 1 Тогда
		ТаблицаЗначений_УдалитьЗначение(ТаблицаЗначений, ИмяКолонки, ПустоеЗначениеТипаЛок(ТипыКолонки[0]));
		Возврат;
	КонецЕсли;
	
	Для Сч = -(ТаблицаЗначений.Количество() - 1) По 0 Цикл
		Значение = ТаблицаЗначений[-Сч][ИмяКолонки];
		Если Значение = Ложь Или Не ЗначениеЗаполнено(Значение) Тогда
			ТаблицаЗначений.Удалить(-Сч);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Удаляет из таблицы значений строки с другими значениями колонки
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  ИмяКолонки      - Строка - имя колонки, которую нужно проверить;
//  НужныеЗначения  - Массив - значения, которые нужно оставить;
//
Процедура ТаблицаЗначений_УдалитьДругиеЗначения(ТаблицаЗначений, ИмяКолонки, НужныеЗначения) Экспорт
	
	Для Каждого Значение Из ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаЗначений, ИмяКолонки) Цикл
		Если НужныеЗначения.Найти(Значение) = Неопределено Тогда
			ТаблицаЗначений_УдалитьЗначение(ТаблицаЗначений, ИмяКолонки, Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Удаляет из таблицы значений строки с указанным значением колонки
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  ИмяКолонки - Строка - имя колонки, которую нужно проверить;
//  Значение - Произвольный - значение, которое нужно удалить;
//
Процедура ТаблицаЗначений_УдалитьЗначение(ТаблицаЗначений, ИмяКолонки, Значение) Экспорт
	
	Для Каждого Стр Из ТаблицаЗначений.НайтиСтроки(Новый Структура(ИмяКолонки, Значение)) Цикл
		ТаблицаЗначений.Удалить(Стр);
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаЗначений_ЗагрузитьМассив(ТаблицаЗначений, Массив, ИмяКолонки) Экспорт
	
	Для каждого Значение Из ЗначениеВМассиве(Массив) Цикл
		ТаблицаЗначений.Добавить()[ИмяКолонки] = Значение;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет значения в строках таблицы по указанному отбору
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  Отбор           - Структура       - параметры отбора строк;
//  Значение        - Произвольный    - значение, который нужно заполнить строки;
//  ИменаКолонок    - Строка          - имена колонок через запятую, в которых нужно заполнить значение;
//
Процедура ТаблицаЗначений_ЗаполнитьЗначения(ТаблицаЗначений, Отбор, Значение, ИменаКолонок) Экспорт
	
	Строки = ТаблицаЗначений.НайтиСтроки(Отбор);
	Колонки = РазделитьСтроку(ИменаКолонок, ",");
	
	Если Не ЗначениеЗаполнено(Строки) Тогда
		Возврат;
	КонецЕсли;
	
	Если Колонки.Количество() > 1 Тогда
		ЗначенияКолонок = Новый Структура;
		Для Каждого ИмяКолонки Из Колонки Цикл
			ЗначенияКолонок.Вставить(ИмяКолонки, Значение);
		КонецЦикла;
		Для Каждого Стр Из Строки Цикл
			ЗаполнитьЗначенияСвойств(Стр, ЗначенияКолонок);
		КонецЦикла;
	Иначе
		Для Каждого Стр Из Строки Цикл
			Стр[ИменаКолонок] = Значение;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Добавляет в таблицу значений данные из выборки
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица, в которую нужно добавить данные;
//  Выборка - ВыборкаИзРезультатаЗапроса - выборка, из которой нужно добавить данные;
//
Процедура ТаблицаЗначений_ДобавитьИзВыборки(ТаблицаЗначений, Выборка) Экспорт
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаЗначений.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

// Разбивает таблицу значений на части по значению поля и размеру порции
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  ИменаКолонок - Строка - (необязательный) имена колонок, по которым нужно разбить таблицу;
//  РазмерПорции - Число - (необязательный) максимальное количество строк в одной части;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит МассивСтрок и колонки, по которым была разбита таблица (если указаны);
//
Функция ТаблицаЗначений_Разбить(ТаблицаЗначений, ИменаКолонок = "", РазмерПорции = 0) Экспорт
	
	Если ЗначениеЗаполнено(ИменаКолонок) Тогда
		
		Результат = ТаблицаЗначений.СкопироватьКолонки(ИменаКолонок);
		Результат.Колонки.Добавить("МассивСтрок");
		Результат.Колонки.Добавить("ЗначениеКолонки"); // Для обратной совместимости
		
		ТаблицаРазбиения = ТаблицаЗначений.Скопировать(, ИменаКолонок);
		ТаблицаРазбиения.Свернуть(ИменаКолонок);
		
		ЗначенияКолонок = Новый Структура(ИменаКолонок);
		
		Для Каждого Стр Из ТаблицаРазбиения Цикл
			
			ЗаполнитьЗначенияСвойств(ЗначенияКолонок, Стр);
			ПодходящиеСтроки = ТаблицаЗначений.НайтиСтроки(ЗначенияКолонок);
			
			Если ЗначениеЗаполнено(РазмерПорции) Тогда
				Для Каждого ПорцияСтрок Из РазбитьМассив(ПодходящиеСтроки, РазмерПорции) Цикл
					НоваяСтрока = Результат.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияКолонок);
					НоваяСтрока.МассивСтрок = ПорцияСтрок;
					НоваяСтрока.ЗначениеКолонки = Стр[0];
				КонецЦикла;
			Иначе
				НоваяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияКолонок);
				НоваяСтрока.МассивСтрок = ПодходящиеСтроки;
				НоваяСтрока.ЗначениеКолонки = Стр[0];
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Результат = Новый ТаблицаЗначений;
		Результат.Колонки.Добавить("МассивСтрок");
		
		ВсегоСтрок = ТаблицаЗначений.Количество();
		ПорцияСтрок = Новый Массив;
		
		Для Сч = 1 По ВсегоСтрок Цикл
			ПорцияСтрок.Добавить(ТаблицаЗначений[Сч - 1]);
			Если Сч % РазмерПорции = 0 Или Сч = ВсегоСтрок Тогда
				Результат.Добавить().МассивСтрок = ПорцияСтрок;
				ПорцияСтрок = Новый Массив;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разбивает таблицу значений на новые таблицы по значению колонок
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//  ИменаКолонок - Строка - (необязательный) имена колонок, по которым нужно разбить таблицу;
//  РазмерПорции - Число - (необязательный) максимальное количество строк в одной части;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонку ЧастьТаблицы и колонки, по которым была разбита таблица;
//
Функция ТаблицаЗначений_РазбитьНаТаблицы(ТаблицаЗначений, ИменаКолонок = "", РазмерПорции = 0) Экспорт
	
	Если ЗначениеЗаполнено(ИменаКолонок) Тогда
		
		Результат = ТаблицаЗначений.СкопироватьКолонки(ИменаКолонок);
		Результат.Колонки.Добавить("ЧастьТаблицы");
		
		ТаблицаРазбиения = ТаблицаЗначений.Скопировать(, ИменаКолонок);
		ТаблицаРазбиения.Свернуть(ИменаКолонок);
		
		ТаблицаЗначений_ДобавитьИндекс(ТаблицаЗначений, ИменаКолонок);
		
		ЗначенияКолонок = Новый Структура(ИменаКолонок);
		
		Для Каждого Стр Из ТаблицаРазбиения Цикл
			ЗаполнитьЗначенияСвойств(ЗначенияКолонок, Стр);
			Если ЗначениеЗаполнено(РазмерПорции) Тогда
				ПодходящиеСтроки = ТаблицаЗначений.НайтиСтроки(ЗначенияКолонок);
				Для Каждого ПорцияСтрок Из РазбитьМассив(ПодходящиеСтроки, РазмерПорции) Цикл
					НоваяСтрока = Результат.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияКолонок);
					НоваяСтрока.ЧастьТаблицы = ТаблицаЗначений.Скопировать(ПорцияСтрок);
				КонецЦикла;
			Иначе
				НоваяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, ИменаКолонок);
				НоваяСтрока.ЧастьТаблицы = ТаблицаЗначений.Скопировать(ЗначенияКолонок);
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаЗначений_УдалитьИндекс(ТаблицаЗначений, ИменаКолонок);
		
	Иначе
		
		Результат = Новый ТаблицаЗначений;
		Результат.Колонки.Добавить("ЧастьТаблицы");
		
		ВсегоСтрок = ТаблицаЗначений.Количество();
		ПорцияСтрок = Новый Массив;
		
		Для Сч = 1 По ВсегоСтрок Цикл
			ПорцияСтрок.Добавить(ТаблицаЗначений[Сч - 1]);
			Если Сч % РазмерПорции = 0 Или Сч = ВсегоСтрок Тогда
				Результат.Добавить().ЧастьТаблицы = ТаблицаЗначений.Скопировать(ПорцияСтрок);
				ПорцияСтрок.Очистить();
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет в таблицу колонку ИндексСтроки и заполняет ее
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица значений;
//
Процедура ТаблицаЗначений_ДобавитьИндексСтроки(ТаблицаЗначений) Экспорт
	
	Если ТаблицаЗначений.Колонки.Найти("ИндексСтроки") = Неопределено Тогда
		ТаблицаЗначений.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Для Сч = 0 По ТаблицаЗначений.Количество() - 1 Цикл
		ТаблицаЗначений[Сч].ИндексСтроки = Сч;
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаЗначений_МассивКолонок(ТаблицаЗначений, Исключения = Неопределено) Экспорт
	
	МассивИсключений = Новый Массив;
	Если ЗначениеЗаполнено(Исключения) Тогда
		Если ТипЗнч(Исключения) = Тип("Строка") Тогда
			МассивИсключений = РазделитьСтроку(Исключения);
		Иначе
			МассивИсключений = ЗначениеВМассиве(Исключения);
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Массив;
	Для каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		Если МассивИсключений.Найти(Колонка.Имя) = Неопределено Тогда
			Результат.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаЗначений_ЕстьДругиеЗначения(ТаблицаЗначений, ИмяКолонки, Значение)
	
	Отбор = Новый Структура(ИмяКолонки, Значение);
	
	Возврат ТаблицаЗначений.Количество() > ТаблицаЗначений.НайтиСтроки(Отбор).Количество();
	
КонецФункции

Процедура ТаблицаЗначений_УдалитьЛишниеКолонки(ТаблицаЗначений, НужныеКолонки) Экспорт
	
	Для каждого ИмяКолонки Из ТаблицаЗначений_МассивКолонок(ТаблицаЗначений, НужныеКолонки) Цикл
		ТаблицаЗначений.Колонки.Удалить(ИмяКолонки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаЗначений_ДобавитьИндекс(ТаблицаЗначений, ИменаКолонок) Экспорт
	
	Для Каждого Индекс Из ТаблицаЗначений.Индексы Цикл
		Если Строка(Индекс) = ИменаКолонок Тогда
			Возврат; // Индекс уже есть
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаЗначений.Индексы.Добавить(ИменаКолонок);
	
КонецПроцедуры

Процедура ТаблицаЗначений_УдалитьИндекс(ТаблицаЗначений, ИменаКолонок) Экспорт
	
	// BSLLS:DeletingCollectionItem-off
	
	Для Каждого Индекс Из ТаблицаЗначений.Индексы Цикл
		Если Строка(Индекс) = ИменаКолонок Тогда
			ТаблицаЗначений.Индексы.Удалить(Индекс);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// BSLLS:DeletingCollectionItem-on
	
КонецПроцедуры

// Определяет, является ли переданное значение соответствием
// или фиксированным соответствием
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является соответствием или фиксированным соответствием
//
Функция ЭтоСоответствие(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение массивом
// или фиксированным массивом
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является структрой или фиксированной структурой
//
Функция ЭтоМассив(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоТаблицаЗначений(Значение)
	
	Возврат ТипЗнч(Значение) = Тип("ТаблицаЗначений");
	
КонецФункции

// Определяет является ли переданное значение ссылкой
//
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является ссылкой
//
Функция ЭтоСсылка(Значение) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	КлючКэш = "КэшЗначений_ЭтоСсылка";
	КэшЗначений = Кэш_Прочитать(КлючКэш);
	Если КэшЗначений = Неопределено Тогда
		КэшЗначений = Новый Соответствие;
		Кэш_Поместить(КлючКэш, КэшЗначений);
	КонецЕсли;
	
	Результат = КэшЗначений[ТипЗначения];
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат =
	МассивСодержитЗначение(ВсеТипыСсылокСправочников(), ТипЗначения)
	Или МассивСодержитЗначение(ВсеТипыСсылокДокументов(), ТипЗначения)
	Или МассивСодержитЗначение(ВсеТипыСсылокПеречислений(), ТипЗначения)
	Или МассивСодержитЗначение(ВсеТипыСсылокПлановОбменаРИБ(), ТипЗначения)
	Или МассивСодержитЗначение(ВсеТипыСсылокПлановВидовХарактеристик(), ТипЗначения);
	
	КэшЗначений.Вставить(ТипЗначения, Результат);
	
	Возврат Результат;
	
КонецФункции

// Определяет является ли переданное значение примитивным типом данных,
// строкой, датой, булевым или числом
//
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является простым типом данных
//
Функция ЭтоПростойТип(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Число") Тогда
		
		Результат = Истина
		
	Иначе
		
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Безопасно заполняет поля структуры значениями из другой структуры
// Пустые значения источника при этом игнорируются
//
// Параметры:
//  Приемник - Структура - структура, которую надо заполнить;
//  Источник - Структура, ФиксированнаяСтруктура - структура, из которой надо взять значения;
//  СписокСвойств    - Строка - (необязательный) список имен свойств, разделенный запятыми,
//                     которые необходимо заполнить, ошибки не будет если таких свойств нет;
//  ИсключаяСвойства - Строка - (необязательный) список имен свойств, разделенный запятыми,
//                     которые заполнять не нужно, ошибки не будет если таких свойств нет;
//  Рекурсивно - Булево - (необязательный) Истина, если необходимо заполнить вложенные структуры;
//
Процедура ЗаполнитьПоляСтруктуры(Приемник, Источник, СписокСвойств = "", ИсключаяСвойства = "", Рекурсивно = Ложь) Экспорт
	
	Если Не ЭтоСтруктура(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполняемыеСвойства = РазделитьСтроку(НРег(СписокСвойств));
	ИсключаемыеСвойства = РазделитьСтроку(НРег(ИсключаяСвойства));
	
	ЕстьЗаполняемыеСвойства = ЗначениеЗаполнено(ЗаполняемыеСвойства);
	ЕстьИсключаемыеСвойства = ЗначениеЗаполнено(ИсключаемыеСвойства);
	
	Для каждого Элемент Из Источник Цикл
		
		Ключ = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если Не Приемник.Свойство(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЕстьЗначение(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЕстьЗаполняемыеСвойства
			И ЗаполняемыеСвойства.Найти(НРег(Ключ)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЕстьИсключаемыеСвойства
			И ИсключаемыеСвойства.Найти(НРег(Ключ)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Рекурсивно И ЭтоСтруктура(Значение) И ЭтоСтруктура(Приемник[Ключ]) Тогда
			ЗаполнитьПоляСтруктуры(Приемник[Ключ], Значение, СписокСвойств, ИсключаяСвойства, Рекурсивно);
		Иначе
			Приемник[Ключ] = Значение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Создает новую структуру и копирует в нее поля источника
//
// Параметры:
//  Источник - Структура, ФиксированнаяСтруктура - структура, из которой надо взять значения;
//  ИсключаяСвойства - Строка - (необязательный) список имен свойств, разделенный запятыми,
//                     которые копировать не нужно, ошибки не будет если таких свойств нет;
// 
// Возвращаемое значение:
//  Структура - новая структура
//
Функция СкопироватьПоляСтруктуры(Источник, ИсключаяСвойства = "")
	
	Результат = Новый Структура;
	
	Для Каждого Элемент Из Источник Цикл
		Если Найти(НРег(ИсключаяСвойства), НРег(Элемент.Ключ)) = 0 Тогда
			Результат.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПустаяВерсия()
	
	Возврат "0.0.0";
	
КонецФункции

// Разделяет текст на части по указанному разделителю
//
// Параметры:
//  Строка - Строка - разделяемый текст;
//  Разделитель - Строка - (необязательный) значение разделителя;
//  ВключатьПустые - Булево - Истина, если пустые части нужно включить в результат;
// 
// Возвращаемое значение:
//  Массив - содержит части текста
//
Функция РазделитьСтроку(Строка, Разделитель = ",", ВключатьПустые = Ложь)
	
	Возврат МодульОбщегоНазначения().РазделитьСтроку(Строка, Разделитель, ВключатьПустые);
	
КонецФункции

// Определяет, является ли переданное значение структурой
// или фиксированной структурой
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является структрой или фиксированной структурой
//
Функция ЭтоСтруктура(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет что значение заполнено
// Мутабельное значение считается заполненным
//
// Параметры:
//  Значение - Произвольное - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если значение есть
//
Функция ЕстьЗначение(Значение)
	
	Попытка
		Результат = ЗначениеЗаполнено(Значение);
	Исключение
		Результат = Истина; // Мутабельное значение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьЗначениеВСтруктуре(Структура, Значение)
	
	Для Каждого КлючИЗначение Из Структура Цикл
		Если КлючИЗначение.Значение = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПараметрыВСтроку(ШаблонСтроки, Параметр1
	, Параметр2 = Неопределено
	, Параметр3 = Неопределено
	, Параметр4 = Неопределено
	, Параметр5 = Неопределено)
	
	Возврат МодульОбщегоНазначения().ПараметрыВСтроку(ШаблонСтроки
	, Параметр1, Параметр2, Параметр3, Параметр4, Параметр5);
	
КонецФункции

// Возвращает массив переданных параметров в порядке их расположения
// 
// Возвращаемое значение:
//  Массив
//
Функция НовыйМассив(Знач1, Знач2 = Null, Знач3 = Null, Знач4 = Null)
	
	Результат = Новый Массив;
	
	Результат.Добавить(Знач1);
	
	Если Знач2 <> Null Тогда
		Результат.Добавить(Знач2);
	КонецЕсли;
	Если Знач3 <> Null Тогда
		Результат.Добавить(Знач3);
	КонецЕсли;
	Если Знач4 <> Null Тогда
		Результат.Добавить(Знач4);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Соединяет части в одну строку с указанным разделителем
