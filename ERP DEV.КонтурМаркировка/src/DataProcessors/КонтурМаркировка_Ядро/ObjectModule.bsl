Функция ВерсияФичаФлаговИзСервиса()
	
	Контент = КонтентДляПроверкиОбновления();
	Продукт = Перечисление_ПродуктыВСервисеОбновлений().ФичаФлаги;
	ТипКонтента = Перечисление_ТипыКонтентовВСервисеОбновлений().ФичаФлаги;
	
	Попытка
		Ответ = СервисОбновлений_ПроверитьОбновления(Контент, Продукт);
	Исключение
		Действие = НСтр("ru = 'Обновление фича-флагов'");
		ОбработатьОшибку(Действие, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Ответ) И Ответ.contain_update = Истина Тогда
		Результат = Ответ.name;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ХешСуммаФичаФлаговИзСервиса(Версия)
	
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Возврат "";
	КонецЕсли;
	
	Продукт = Перечисление_ПродуктыВСервисеОбновлений().ФичаФлаги;
	ТипКонтента = Перечисление_ТипыКонтентовВСервисеОбновлений().ФичаФлаги;
	
	Попытка
		Ответ = СервисОбновлений_ОписаниеВерсии(Продукт, Версия);
	Исключение
		Действие = НСтр("ru = 'Получение из сервиса хеш-суммы фича-флагов'");
		ОбработатьОшибку(Действие, ИнформацияОбОшибке());
	КонецПопытки;
	
	content = СвойствоСтруктуры(Ответ, "content");
	item = СвойствоСтруктуры(content, ТипКонтента);
	
	Возврат СвойствоСтруктуры(item, "md5hash", "");
	
КонецФункции

Функция ФичаФлагиИзСервиса(Версия)
	
	Продукт = Перечисление_ПродуктыВСервисеОбновлений().ФичаФлаги;
	ТипКонтента = Перечисление_ТипыКонтентовВСервисеОбновлений().ФичаФлаги;
	
	Попытка
		ФайлСписка = СервисОбновлений_ФайлВерсии(Продукт, Версия, ТипКонтента);
		СписокСтрокой = СтрокаИзДвоичныхДанных(ФайлСписка);
		СписокИзСервиса = ЗначениеИзСтрокиJSON(СписокСтрокой);
	Исключение
		Действие = НСтр("ru = 'Получение файла фича-флагов'");
		ОбработатьОшибку(Действие, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если ЗначениеЗаполнено(СписокИзСервиса) Тогда
		Результат = Новый Структура;
		Результат.Вставить("ДатыВключения", СвойствоСтруктуры(СписокИзСервиса, "enableFeatures", Новый Массив));
		Результат.Вставить("ДатыОтключения", СвойствоСтруктуры(СписокИзСервиса, "disableFeatures", Новый Массив));
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьФичаФлаги(ОдинРазВДень = Истина, СкачатьФичаФлаги = Ложь) Экспорт
	
	ОписаниеВременныхФункций = СписокВременныхФункций();
	ОписаниеОтложенныхФункций = СписокОтложенныхФункций();
	УстановленнаяВерсия = ОписаниеОтложенныхФункций.ВерсияСписка;
	УстановленнаяХешСумма = ОписаниеОтложенныхФункций.ХешСумма;
	ДатаПроверки = ОписаниеОтложенныхФункций.ДатаПроверки;
	ТекущаяДатаПроверки = ТекущаяУниверсальнаяДата();
	
	Если ОдинРазВДень И НачалоДня(ДатаПроверки) = НачалоДня(ТекущаяДатаПроверки) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеВременныхФункций.ДатаПроверки = ТекущаяДатаПроверки;
	ОписаниеОтложенныхФункций.ДатаПроверки = ТекущаяДатаПроверки;
	
	ВерсияИзСервиса = ВерсияФичаФлаговИзСервиса();
	ХешСуммаИзСервиса = ХешСуммаФичаФлаговИзСервиса(ВерсияИзСервиса);
	
	Если СкачатьФичаФлаги Тогда
		ФичаФлаги = ФичаФлагиИзСервиса(ВерсияИзСервиса);
		Если Не ЗначениеЗаполнено(ФичаФлаги) Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось скачать из сервиса фича-флаги № %1'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ВерсияИзСервиса);
		КонецЕсли;
	ИначеЕсли (ВерсияИзСервиса = УстановленнаяВерсия Или Не ЗначениеЗаполнено(ВерсияИзСервиса))
		И (ХешСуммаИзСервиса = УстановленнаяХешСумма Или Не ЗначениеЗаполнено(ХешСуммаИзСервиса)) Тогда
		СписокВременныхФункций_Записать(ОписаниеВременныхФункций);
		СписокОтложенныхФункций_Записать(ОписаниеОтложенныхФункций);
		Возврат; // Ничего не изменилось, скачивать не нужно
	Иначе
		ФичаФлаги = ФичаФлагиИзСервиса(ВерсияИзСервиса);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФичаФлаги) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеВременныхФункций.ВерсияСписка = ВерсияИзСервиса;
	ОписаниеВременныхФункций.ХешСумма = ХешСуммаИзСервиса;
	ОписаниеВременныхФункций.ДатыОтключения.Очистить();
	Для каждого Элемент Из ФичаФлаги.ДатыОтключения Цикл
		ОписаниеВременныхФункций.ДатыОтключения.Вставить(Элемент.Ключ, ДатаИзСтрокиXML(Элемент.Значение));
	КонецЦикла;
	
	ОписаниеОтложенныхФункций.ВерсияСписка = ВерсияИзСервиса;
	ОписаниеОтложенныхФункций.ХешСумма = ХешСуммаИзСервиса;
	ОписаниеОтложенныхФункций.ДатыВключения.Очистить();
	Для каждого Элемент Из ФичаФлаги.ДатыВключения Цикл
		ОписаниеОтложенныхФункций.ДатыВключения.Вставить(Элемент.Ключ, ДатаИзСтрокиXML(Элемент.Значение));
	КонецЦикла;
	
	СписокВременныхФункций_Записать(ОписаниеВременныхФункций);
	СписокОтложенныхФункций_Записать(ОписаниеОтложенныхФункций);
	
	МодульКонтроль().Кэш_Очистить();
	
КонецПроцедуры

Функция СписокВременныхФункций() Экспорт
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(Перечисление_ИменаДопСправочников().СписокВременныхФункций);
	
	Результат = Новый_СписокВременныхФункций();
	Результат.ВерсияСписка = ДанныеИБ.Комментарий;
	ДополнитьСтруктуру(Результат.ДатыОтключения, ДанныеИБ.ДопРеквизиты);
	
	Результат.ДатаПроверки = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, "ДатаПроверки", '00010101');
	Результат.ДатыОтключения.Удалить("ДатаПроверки");
	
	Результат.ХешСумма = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, "ХешСумма", "");
	Результат.ДатыОтключения.Удалить("ХешСумма");
	
	Возврат Результат;
	
КонецФункции

Функция СписокОтложенныхФункций() Экспорт
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(Перечисление_ИменаДопСправочников().СписокОтложенныхФункций);
	
	Результат = Новый_СписокОтложенныхФункций();
	Результат.ВерсияСписка = ДанныеИБ.Комментарий;
	ДополнитьСтруктуру(Результат.ДатыВключения, ДанныеИБ.ДопРеквизиты);
	
	Результат.ДатаПроверки = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, "ДатаПроверки", '00010101');
	Результат.ДатыВключения.Удалить("ДатаПроверки");
	
	Результат.ХешСумма = СвойствоСтруктуры(ДанныеИБ.ДопРеквизиты, "ХешСумма", "");
	Результат.ДатыВключения.Удалить("ХешСумма");
	
	Возврат Результат;
	
КонецФункции

Процедура СписокОтложенныхФункций_Записать(СписокФункций) Экспорт
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(Перечисление_ИменаДопСправочников().СписокОтложенныхФункций);
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	ДополнитьСтруктуру(ДанныеИБ.ДопРеквизиты, СписокФункций.ДатыВключения);
	ДанныеИБ.ДопРеквизиты.Вставить("ДатаПроверки", СписокФункций.ДатаПроверки);
	ДанныеИБ.ДопРеквизиты.Вставить("ХешСумма", СписокФункций.ХешСумма);
	ДанныеИБ.Комментарий = СписокФункций.ВерсияСписка;
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

Процедура СписокВременныхФункций_Записать(СписокФункций) Экспорт
	
	ДанныеИБ = ДопСправочник_ПрочитатьПервый(Перечисление_ИменаДопСправочников().СписокВременныхФункций);
	
	ДанныеИБ.ДопРеквизиты.Очистить();
	ДополнитьСтруктуру(ДанныеИБ.ДопРеквизиты, СписокФункций.ДатыОтключения);
	ДанныеИБ.ДопРеквизиты.Вставить("ДатаПроверки", СписокФункций.ДатаПроверки);
	ДанныеИБ.ДопРеквизиты.Вставить("ХешСумма", СписокФункций.ХешСумма);
	ДанныеИБ.Комментарий = СписокФункций.ВерсияСписка;
	
	ДопСправочник_Записать(ДанныеИБ);
	
КонецПроцедуры

Функция Новый_СписокОтложенныхФункций()
	
	Результат = Новый Структура;
	Результат.Вставить("ХешСумма", "");
	Результат.Вставить("ВерсияСписка", "");
	Результат.Вставить("ДатаПроверки", '00010101');
	Результат.Вставить("ДатыВключения", Новый Структура);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_СписокВременныхФункций()
	
	Результат = Новый Структура;
	Результат.Вставить("ХешСумма", "");
	Результат.Вставить("ВерсияСписка", "");
	Результат.Вставить("ДатаПроверки", '00010101');
	Результат.Вставить("ДатыОтключения", Новый Структура);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ВременныеИОтложенныеФункции

// #Область ДополнительныеСправочники

Функция ДопСправочник_Записать(ОписаниеЭлемента) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеЭлемента.Ссылка) Тогда
			
			ПроверитьОбъектВПроцессеОбновления(ОписаниеЭлемента.Ссылка);
			ДопСправочник_Заблокировать(ОписаниеЭлемента.Ссылка);
			Объект = ОписаниеЭлемента.Ссылка.ПолучитьОбъект();
			
			Если Объект.ПометкаУдаления Тогда
				Объект.ПометкаУдаления = Ложь;
			КонецЕсли;
			
		Иначе
			Объект = Справочники.КонтурМаркировка_ДопСправочники.СоздатьЭлемент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Объект, ОписаниеЭлемента, , "ДопРеквизиты");
		
		Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
			Объект.Наименование = ОписаниеЭлемента.ИмяСправочника;
		КонецЕсли;
		
		Объект.ДопРеквизиты.Очистить();
		
		Для каждого Элемент Из ОписаниеЭлемента.ДопРеквизиты Цикл
			
			Значение = Элемент.Значение;
			ИмяРеквизита = Элемент.Ключ;
			
			Если Значение = Ложь Или Не ЕстьЗначение(Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.ДопРеквизиты.Добавить();
			НоваяСтрока.ИмяРеквизита = ИмяРеквизита;
			
			Если ЭтоПростойТип(Значение) Тогда
				НоваяСтрока.Значение = Элемент.Значение;
			ИначеЕсли ЭтоСсылка(Значение) И ЭтоОбъектКонтурМаркировки(Значение) Тогда
				НоваяСтрока.ЗначениеСсылка = Элемент.Значение;
			Иначе
				НоваяСтрока.ЗначениеХранилище = ЗначениеВХранилище(Значение);
			КонецЕсли;
			
		КонецЦикла;
		
		Объект.Записать();
		
		ОписаниеЭлемента.Ссылка = Объект.Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Объект.Ссылка;
	
КонецФункции

Функция ДопСправочник_Прочитать(Ссылка) Экспорт
	
	Результат = Новый_ЭлементДопСправочника();
	ЗаполнитьЗначенияСвойств(Результат, Ссылка, , "ДопРеквизиты");
	
	Для каждого Стр Из Ссылка.ДопРеквизиты Цикл
	
		ИмяРеквизита = Стр.ИмяРеквизита;
		
		Если ЗначениеЗаполнено(Стр.Значение) Тогда
			Значение = Стр.Значение;
		ИначеЕсли ЗначениеЗаполнено(Стр.ЗначениеСсылка) Тогда
			Значение = Стр.ЗначениеСсылка;
		Иначе
			Значение = Стр.ЗначениеХранилище.Получить();
		КонецЕсли;
		
		Результат.ДопРеквизиты.Вставить(ИмяРеквизита, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДопСправочник_ВсеЭлементы(ИмяСправочника) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДопСправочники КАК Т
	|ГДЕ
	|	Т.ИмяСправочника = &ИмяСправочника");
	
	Запрос.УстановитьПараметр("ИмяСправочника", ИмяСправочника);
	
	Возврат МассивИзРезультатаЗапроса(Запрос);
	
КонецФункции

Функция ДопСправочник_НайтиПоДопРеквизиту(ИмяСправочника, ИмяРеквизита, Значение) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДопСправочники.ДопРеквизиты КАК ТЧ
	|ГДЕ
	|	ТЧ.ИмяРеквизита = &ИмяРеквизита
	|	И ТЧ.Ссылка.ИмяСправочника = &ИмяСправочника
	|	И &Значение";
	
	Если ЭтоПростойТип(Значение) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Значение", "ТЧ.Значение = &Значение");
	ИначеЕсли ЭтоСсылка(Значение) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Значение", "ТЧ.ЗначениеСсылка = &Значение");
	Иначе
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный тип значения ""%1"" для поиска в доп справочнике по доп реквизиту '"), Значение);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ИмяСправочника", ИмяСправочника);
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	Запрос.УстановитьПараметр("Значение", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат МассивИзРезультатаЗапроса(Запрос);
	
КонецФункции

Функция ДопСправочник_НайтиПервый(ИмяСправочника, ИмяРеквизита = "", ЗначениеРеквизита = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_ДопСправочники КАК Спр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДопСправочники.ДопРеквизиты КАК ТЧ
	|		ПО ТЧ.Ссылка = Спр.Ссылка
	|ГДЕ
	|	Спр.ИмяСправочника = &ИмяСправочника
	|	И НЕ Спр.ПометкаУдаления
	|	И &УсловиеПоРеквизиту";
	
	Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Если ЭтоПростойТип(ЗначениеРеквизита) Тогда
			ТекстУсловия = "ТЧ.ИмяРеквизита = &ИмяРеквизита И ТЧ.Значение = &ЗначениеРеквизита";
		ИначеЕсли ЭтоСсылка(ЗначениеРеквизита) Тогда
			ТекстУсловия = "ТЧ.ИмяРеквизита = &ИмяРеквизита И ТЧ.ЗначениеСсылка = &ЗначениеРеквизита";
		Иначе
			ВызватьИсключение ПараметрыВСтроку(НСтр(
			"ru = 'Неизвестный тип значения ""%1"" для поиска в доп справочнике по доп реквизиту '"), ЗначениеРеквизита);
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоРеквизиту", ТекстУсловия);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоРеквизиту", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ИмяСправочника", ИмяСправочника);
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	Запрос.УстановитьПараметр("ЗначениеРеквизита", ЗначениеРеквизита);
	
	Возврат ПолучитьРезультатЗапроса(Запрос);
	
КонецФункции

Функция ДопСправочник_ПрочитатьПервый(ИмяСправочника, ИмяРеквизита = "", ЗначениеРеквизита = Неопределено) Экспорт
	
	Ссылка = ДопСправочник_НайтиПервый(ИмяСправочника, ИмяРеквизита, ЗначениеРеквизита);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Результат = ДопСправочник_Прочитать(Ссылка);
	Иначе
		Результат = Новый_ЭлементДопСправочника(ИмяСправочника);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ЭлементДопСправочника(ИмяСправочника = "") Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Ссылка");
	Результат.Вставить("ИмяСправочника", ИмяСправочника);
	Результат.Вставить("Наименование");
	Результат.Вставить("Ответственный");
	Результат.Вставить("Комментарий");
	
	Результат.Вставить("ДопРеквизиты", Новый Структура);
	
	Возврат Результат;
	
КонецФункции

Процедура ДопСправочник_Удалить(Ссылка) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Ссылка.ПолучитьОбъект();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Удалить();
	
КонецПроцедуры

Процедура ДопСправочник_Заблокировать(Ссылка)
	
	Значения = Новый Структура("Ссылка", Ссылка);
	ИмяОбъекта = "Справочник.КонтурМаркировка_ДопСправочники";
	ЗаблокироватьПоЗначениям(ИмяОбъекта, Значения);
	
КонецПроцедуры

// #КонецОбласти // ДополнительныеСправочники

// #Область КодыЗаказов

Процедура КодыЗаказов_Записать(ТаблицаКодов, ЗаказКодов, УдалитьСтарыеКоды = Истина)
	
	ТипФайла = Перечисление_ТипыФайлов().КодыЗаказа;
	РазмерПорции = НастройкиМодуля().МаксимальноеКоличествоКодовВОднойПорции;
	
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	
	ЧастиТаблицы = ТаблицаЗначений_РазбитьНаТаблицы(ТаблицаКодов, "Товар, КлючНоменклатуры1С, ПорцияЗаписей", РазмерПорции);
	Для Каждого Стр Из ЧастиТаблицы Цикл
		ТаблицаКодов_ЗаполнитьКлючиНовыхПорций(Стр.ЧастьТаблицы);
		Стр.ПорцияЗаписей = Стр.ЧастьТаблицы[0].ПорцияЗаписей;
	КонецЦикла;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыЗаказов_Заблокировать(ЗаказКодов);
		
		Если УдалитьСтарыеКоды Тогда
			Файлы_Удалить(Файлы_Найти(ЗаказКодов, ТипФайла));
			ОбщаяТаблицаЗаказа = Новый_ТаблицаЗаказа();
		Иначе
			ОбщаяТаблицаЗаказа = КодыЗаказов_ТаблицаЗаказа(ЗаказКодов);
		КонецЕсли;
		
		Для Каждого Стр Из ЧастиТаблицы Цикл
			
			ИмяФайла = КодыЗаказов_ИмяФайла(Стр.Товар, Стр.КлючНоменклатуры1С);
			Файл = Файл_НайтиПоИдентификатору(ЗаказКодов, Стр.ПорцияЗаписей, ТипФайла, ИмяФайла);
			ТаблицаКодовДляФайла = КодыЗаказов_ИзвлечьИзФайла(Файл);
			
			Если ЗначениеЗаполнено(ТаблицаКодовДляФайла) Тогда
				
				СтрокиНовыхКодов = Новый Массив;
				ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодовДляФайла, "КодМаркировки");
				Для Каждого Стр Из Стр.ЧастьТаблицы Цикл
					Если ТаблицаКодовДляФайла.Найти(Стр.КодМаркировки, "КодМаркировки") = Неопределено Тогда
						СтрокиНовыхКодов.Добавить(Стр);
					КонецЕсли;
				КонецЦикла;
				ТаблицаЗначений_УдалитьИндекс(ТаблицаКодовДляФайла, "КодМаркировки");
				
				ТаблицаЗаказа = Новый_ТаблицаЗаказа();
				Для Каждого Стр Из СтрокиНовыхКодов Цикл
					ЗаполнитьЗначенияСвойств(ТаблицаЗаказа.Добавить(), Стр);
					ЗаполнитьЗначенияСвойств(ТаблицаКодовДляФайла.Добавить(), Стр);
				КонецЦикла;
				СтрокиНовыхКодов.Очистить();
				
				ТаблицаЗаказа.ЗаполнитьЗначения(1, "КоличествоКодов");
				ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаЗаказа, "КоличествоКодов");
				
			Иначе
				ТаблицаКодовДляФайла = Стр.ЧастьТаблицы;
				ТаблицаЗаказа = КодыЗаказов_ТаблицаЗаказаПоТаблицеКодов(ТаблицаКодовДляФайла);
			КонецЕсли;
			
			ТаблицаЗначений_Дополнить(ОбщаяТаблицаЗаказа, ТаблицаЗаказа);
			
			КодыЗаказов_ПоместитьВФайл(ТаблицаКодовДляФайла, ЗаказКодов);
			
		КонецЦикла;
		
		ТаблицаЗначений_СвернутьПоВсемКолонкам(ОбщаяТаблицаЗаказа, "КоличествоКодов");
		Набор = РегистрыСведений.КонтурМаркировка_КодыЗаказов.СоздатьНаборЗаписей();
		Набор.Отбор.ЗаказКодов.Установить(ЗаказКодов);
		Набор.Загрузить(ОбщаяТаблицаЗаказа);
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыЗаказов_ПоместитьВФайл(ТаблицаКодов, ЗаказКодов)
	
	ПерваяСтрока = ТаблицаКодов[0];
	ПорцияЗаписей = ПерваяСтрока.ПорцияЗаписей;
	ИмяФайла = КодыЗаказов_ИмяФайла(ПерваяСтрока.Товар, ПерваяСтрока.КлючНоменклатуры1С);
	
	ПоляКодов = ИменаПолейРегистраСведений("КонтурМаркировка_КодыМаркировки");
	ПоляСтатусов = ИменаПолейРегистраСведений("КонтурМаркировка_СтатусыКодовГИСМТ");
	ПоляИнформации = ИменаПолейРегистраСведений("КонтурМаркировка_ИнформацияОКодах");
	
	СтатусыКодов = ТаблицаКодов.Скопировать( , ПоляСтатусов);
	ИнформацияОКодах = ТаблицаКодов.Скопировать( , ПоляИнформации);
	
	СтатусыКодов.Свернуть(ПоляСтатусов);
	ИнформацияОКодах.Свернуть(ПоляИнформации);
	
	ТаблицаЗначений_УдалитьЛишниеКолонки(ТаблицаКодов, ПоляКодов + ", ПолныйКод");
	
	ОписаниеАрхива = Новый_АрхивКодов();
	ОписаниеАрхива.ТаблицаКодов = ТаблицаКодов;
	ОписаниеАрхива.СтатусыКодов = СтатусыКодов;
	ОписаниеАрхива.ИнформацияОКодах = ИнформацияОКодах;
	
	ОписаниеФайла = Новый_ОписаниеФайла();
	ОписаниеФайла.ВладелецФайла = ЗаказКодов;
	ОписаниеФайла.Идентификатор = ПорцияЗаписей;
	ОписаниеФайла.ИмяФайла = ИмяФайла;
	ОписаниеФайла.ДанныеФайла = ОписаниеАрхива;
	ОписаниеФайла.ТипФайла = Перечисление_ТипыФайлов().КодыЗаказа;
	ОписаниеФайла.ВерсияФормата = Перечисление_ВерсииФорматовФайлов().Версия_3_19_6;
	ОписаниеФайла.Размер = ТаблицаКодов.Количество();
	
	Файл_Записать(ОписаниеФайла);
	
КонецПроцедуры

Процедура КодыЗаказов_Удалить(ЗаказКодов)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыЗаказов_Заблокировать(ЗаказКодов);
		
		Набор = РегистрыСведений.КонтурМаркировка_КодыЗаказов.СоздатьНаборЗаписей();
		Набор.Отбор.ЗаказКодов.Установить(ЗаказКодов);
		Набор.Записать();
		
		Файлы_Удалить(Файлы_Найти(ЗаказКодов, Перечисление_ТипыФайлов().КодыЗаказа));
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыЗаказов_ВТ_ДобавитьТаблицуДляЗаписи_ВернутьКодыВЗаказы(Запрос)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТабУстаревшиеКоды.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ ТаблицаДляЗаписиКодыЗаказов
	|ИЗ
	|	ТаблицаДляЗаписиУстаревшиеКоды КАК ТабУстаревшиеКоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТабУстаревшиеКоды.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
	|		ПО (КодыМаркировки.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
	|ГДЕ
	|	ИнформацияОКодах.ЕстьПолныйКод
	|	И ИнформацияОКодах.ДляНанесения
	|	И ИнформацияОКодах.ДатаПечати = &ПустаяДата
	|	И ИнформацияОКодах.ЗаказКодов <> &ПустойЗаказ
	|	И ВЫБОР
	|			КОГДА ИнформацияОКодах.ВидПродукции В (&ВидыПродукцииСНанесением)
	|				ТОГДА ЕСТЬNULL(СтатусыКодов.Статус, &ПустойСтатусКода) В (&ПустойСтатусКода, &СтатусКодаВыпущен)
	|			ИНАЧЕ ЕСТЬNULL(СтатусыКодов.Статус, &ПустойСтатусКода) В (&ПустойСтатусКода, &СтатусКодаВыпущен, &СтатусКодаНанесен)
	|		КОНЕЦ";
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПустойФайл", ПустойФайл());
	Запрос.УстановитьПараметр("ПустойЗаказ", ПустаяОперация());
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("ПустойСтатусКода", "");
	Запрос.УстановитьПараметр("СтатусКодаВыпущен", СтатусыКодов.Выпущен);
	Запрос.УстановитьПараметр("СтатусКодаНанесен", СтатусыКодов.Нанесен);
	Запрос.УстановитьПараметр("ВидыПродукцииСНанесением", ДопустимыеВидыПродукцииДляОтчетаОНанесении());
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура КодыЗаказов_ВТ_ВернутьКодыВЗаказы(МенеджерВТ)
	
	ТаблицаКодов = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаДляЗаписиКодыЗаказов", Истина);
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаЗначений_УдалитьПустыеСтроки(ТаблицаКодов, "ЗаказКодов");
	
	ПолныеКоды_Прочитать(ТаблицаКодов);
	ТаблицаЗначений_УдалитьПустыеСтроки(ТаблицаКодов, "ПолныйКод");
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыЗаказов_ЗаблокироватьПоТаблице(ТаблицаКодов);
		
		Для Каждого Стр Из ТаблицаЗначений_РазбитьНаТаблицы(ТаблицаКодов, "ЗаказКодов") Цикл
			КодыЗаказов_Записать(Стр.ЧастьТаблицы, Стр.ЗаказКодов, Ложь);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыЗаказов_Заблокировать(ЗаказКодов, Товар = Неопределено, КлючНоменклатуры1С = Неопределено)
	
	Значения = Новый Структура;
	Значения.Вставить("ЗаказКодов", ЗаказКодов);
	
	Если Товар <> Неопределено Тогда
		Значения.Вставить("Товар", Товар);
	КонецЕсли;
	
	Если КлючНоменклатуры1С <> Неопределено Тогда
		Значения.Вставить("КлючНоменклатуры1С", КлючНоменклатуры1С);
	КонецЕсли;
	
	ИмяОбъекта = "РегистрСведений.КонтурМаркировка_КодыЗаказов";
	ЗаблокироватьПоЗначениям(ИмяОбъекта, Значения);
	
КонецПроцедуры

Процедура КодыЗаказов_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "ЗаказКодов")
	
	Поле = "ЗаказКодов";
	ИмяОбъекта = "РегистрСведений.КонтурМаркировка_КодыЗаказов";
	ЗаблокироватьПоТаблице(ИмяОбъекта, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

Процедура КодыЗаказов_УдалитьИспользованныеКоды(ТаблицаКодов, СтрокаЗаказа)
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	КлючиКодов = ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КлючКода", Истина);
	Если Не ЗначениеЗаполнено(КлючиКодов) Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КодыМаркировки.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО КодыМаркировки.КлючКода = КодыОпераций.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО КодыМаркировки.КлючКода = КодыДокументов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыАгрегатов
	|		ПО КодыМаркировки.КлючАгрегата = КодыАгрегатов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК ВложенныеКоды
	|		ПО КодыМаркировки.КлючКода = ВложенныеКоды.КлючАгрегата
	|ГДЕ
	|	КодыМаркировки.КлючКода В(&КлючиКодов)
	|	И (КодыОпераций.КлючКода ЕСТЬ НЕ NULL 
	|			ИЛИ КодыДокументов.КлючКода ЕСТЬ НЕ NULL 
	|			ИЛИ КодыАгрегатов.КлючКода ЕСТЬ НЕ NULL 
	|			ИЛИ ВложенныеКоды.КлючКода ЕСТЬ НЕ NULL )");
	Запрос.УстановитьПараметр("КлючиКодов", КлючиКодов);
	РезультатЗапроса = Запрос.Выполнить();
	КлючиКодов.Очистить();
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	УдаляемыеСтроки = Новый Массив;
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючКода");
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		УдаляемыеСтроки.Добавить(ТаблицаКодов.Найти(Выборка.КлючКода, "КлючКода"));
	КонецЦикла;
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючКода");
	
	Для Каждого Стр Из УдаляемыеСтроки Цикл
		ТаблицаКодов.Удалить(Стр);
		СтрокаЗаказа.КоличествоКодов = СтрокаЗаказа.КоличествоКодов - 1;
	КонецЦикла;
	
КонецПроцедуры

Функция КодыЗаказов_Подобрать(ДокументИлиОперация, ТребуемыеКоды, ЗаказИсточник = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ТребуемыеКоды) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТребуемыеКоды.Сортировать("КлючНоменклатуры Убыв, КлючХарактеристики Убыв, КлючУпаковки Убыв, КлючСерии Убыв, Товар Убыв", Новый СравнениеЗначений);
	
	СтарыеЗаказы = ЗаказыСИстекшимСрокомЖизниКодов();
	КодыПодобраны = Ложь;
	
	Для каждого СтрТреб Из ТребуемыеКоды Цикл
		
		СтрокаНаполнена = Ложь;
		
		ВариантыАналитики = ВариантыАналитикиДляПодбораКодов(СтрТреб);
		Для каждого ЗначенияАналитики Из ВариантыАналитики Цикл
			
			Запрос = КодыЗаказов_Подобрать_Запрос(ЗначенияАналитики, ВариантыАналитики, СтарыеЗаказы, ЗаказИсточник);
			ВыборкаЗаказ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗаказ.Следующий() Цикл
				
				Если Не ПроверитьОбъектВПроцессеОбновления(ВыборкаЗаказ.ЗаказКодов, Ложь) Тогда
					Продолжить;
				КонецЕсли;
				
				Выборка = ВыборкаЗаказ.Выбрать();
				Пока Выборка.Следующий() Цикл
					
					Если КодыЗаказов_ПодобратьИзЗаказа(ДокументИлиОперация, СтрТреб, Выборка.ЗаказКодов, Выборка.Товар, Выборка.КлючНоменклатуры1С) Тогда
						КодыПодобраны = Истина;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрТреб.КоличествоКодовТребуется)
						И СтрТреб.КоличествоКодовТребуется = СтрТреб.КоличествоКодовПодобрано Тогда
						СтрокаНаполнена = Истина;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				Если СтрокаНаполнена Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если СтрокаНаполнена Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат КодыПодобраны;
	
КонецФункции

Функция КодыЗаказов_Подобрать_Запрос(ЗначенияАналитики, ВариантыАналитики, СтарыеЗаказы, ЗаказИсточник = Неопределено)
	
	ШаблонТекстаЗапросаСНоменклатурой =
	"ВЫБРАТЬ
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С
	|ПОМЕСТИТЬ ПодходящиеКлючи
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КлючиАналитикиНоменклатуры1С КАК Т
	|ГДЕ
	|	Т.КлючНоменклатуры = &КлючНоменклатуры
	|	И Т.КлючХарактеристики = &КлючХарактеристики
	|	И Т.КлючУпаковки = &КлючУпаковки
	|	И Т.КлючСерии = &КлючСерии
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючНоменклатуры1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыЗаказов.ЗаказКодов КАК ЗаказКодов,
	|	КодыЗаказов.Товар КАК Товар,
	|	КодыЗаказов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	КодыЗаказов.КоличествоКодов КАК КоличествоКодов,
	|	КодыЗаказов.ЗаказКодов.Дата КАК ДатаЗаказа,
	|	КодыЗаказов.ЗаказКодов.Код КАК НомерЗаказа
	|ИЗ
	|	ПодходящиеКлючи КАК ПодходящиеКлючи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыЗаказов КАК КодыЗаказов
	|		ПО ПодходящиеКлючи.КлючНоменклатуры1С = КодыЗаказов.КлючНоменклатуры1С
	|			И (&Товар)
	|ГДЕ
	|	НЕ КодыЗаказов.ЗаказКодов В (&СтарыеЗаказы)
	|	И &ЗаказИсточник
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаказа,
	|	НомерЗаказа,
	|	Товар,
	|	КлючНоменклатуры1С
	|ИТОГИ ПО
	|	ЗаказКодов";
	
	ШаблонТекстаЗапросаБезНоменклатуры =
	"ВЫБРАТЬ
	|	КодыЗаказов.ЗаказКодов КАК ЗаказКодов,
	|	КодыЗаказов.Товар КАК Товар,
	|	КодыЗаказов.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	КодыЗаказов.КоличествоКодов КАК КоличествоКодов,
	|	КодыЗаказов.ЗаказКодов.Дата КАК ДатаЗаказа,
	|	КодыЗаказов.ЗаказКодов.Код КАК НомерЗаказа
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыЗаказов КАК КодыЗаказов
	|ГДЕ
	|	&Товар
	|	И &ЗаказИсточник
	|	И НЕ КодыЗаказов.ЗаказКодов В (&СтарыеЗаказы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаказа,
	|	НомерЗаказа,
	|	Товар,
	|	КлючНоменклатуры1С
	|ИТОГИ ПО
	|	ЗаказКодов";
	
	Если ЗначениеЗаполнено(ЗначенияАналитики.КлючНоменклатуры) Тогда
		ТекстЗапроса = ШаблонТекстаЗапросаСНоменклатурой;
	Иначе
		ТекстЗапроса = ШаблонТекстаЗапросаБезНоменклатуры;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойствоСтруктуры(ЗначенияАналитики, "Товар")) Тогда
		Условие = "КодыЗаказов.Товар = &Товар";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Товар", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаказИсточник) Тогда
		Условие = "КодыЗаказов.ЗаказКодов = &ЗаказИсточник";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЗаказИсточник", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЗаказИсточник", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СтарыеЗаказы", СтарыеЗаказы);
	Запрос.УстановитьПараметр("ЗаказИсточник", ЗаказИсточник);
	Для каждого Колонка Из ВариантыАналитики.Колонки Цикл
		Запрос.УстановитьПараметр(Колонка.Имя, ЗначенияАналитики[Колонка.Имя]);
	КонецЦикла;
	
	Возврат Запрос;
	
КонецФункции

Функция КодыЗаказов_ПодобратьИзЗаказа(ДокументИлиОперация, ПараметрыПодбора, ЗаказКодов, Товар, КлючНоменклатуры1С)
	
	КодыПодобраны = Ложь;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыЗаказов_Заблокировать(ЗаказКодов, Товар, КлючНоменклатуры1С);
		
		СтрЗаказа = РегистрыСведений.КонтурМаркировка_КодыЗаказов.СоздатьМенеджерЗаписи();
		СтрЗаказа.ЗаказКодов = ЗаказКодов;
		СтрЗаказа.Товар = Товар;
		СтрЗаказа.КлючНоменклатуры1С = КлючНоменклатуры1С;
		СтрЗаказа.Прочитать();
		
		Если СтрЗаказа.Выбран() И ЗначениеЗаполнено(СтрЗаказа.КоличествоКодов) Тогда
			
			ТаблицаКодов = Новый_ТаблицаКодов();
			
			ИмяФайла = КодыЗаказов_ИмяФайла(СтрЗаказа.Товар, СтрЗаказа.КлючНоменклатуры1С);
			Для Каждого Файл Из Файлы_Найти(ЗаказКодов, Перечисление_ТипыФайлов().КодыЗаказа, , ИмяФайла) Цикл
				
				КоличествоКодовТребуется = ПараметрыПодбора.КоличествоКодовТребуется - ПараметрыПодбора.КоличествоКодовПодобрано;
				ИзвлеченоКодов = КодыЗаказов_ПодобратьИзФайла(Файл, СтрЗаказа, ТаблицаКодов, КоличествоКодовТребуется);
				ПараметрыПодбора.КоличествоКодовПодобрано = ПараметрыПодбора.КоличествоКодовПодобрано + ИзвлеченоКодов;
				
				Если ЗначениеЗаполнено(ПараметрыПодбора.КоличествоКодовТребуется)
					И ПараметрыПодбора.КоличествоКодовТребуется = ПараметрыПодбора.КоличествоКодовПодобрано Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ТаблицаКодов) Тогда
				
				ТаблицаКодов.ЗаполнитьЗначения(ЗаказКодов, "ЗаказКодов");
				
				Если ЗначениеЗаполнено(ПараметрыПодбора.НовыйКлючСтрокиДокумента) Тогда
					ТаблицаКодов.ЗаполнитьЗначения(ПараметрыПодбора.НовыйКлючСтрокиДокумента, "КлючСтрокиДокумента");
				КонецЕсли;
				Если ЗначениеЗаполнено(ПараметрыПодбора.НовыйКлючСтрокиОперации) Тогда
					ТаблицаКодов.ЗаполнитьЗначения(ПараметрыПодбора.НовыйКлючСтрокиОперации, "КлючСтрокиОперации");
				КонецЕсли;
				Если ЗначениеЗаполнено(ПараметрыПодбора.КлючНоменклатуры1С) Тогда
					ТаблицаКодов.ЗаполнитьЗначения(ПараметрыПодбора.КлючНоменклатуры1С, "КлючНоменклатуры1С");
				КонецЕсли;
				
				ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
				ПолныеКоды_Записать(ТаблицаКодов);
				
				Если ТипЗнч(ДокументИлиОперация) = Тип("СправочникСсылка.КонтурМаркировка_Операции") Тогда
					КодыОпераций_Записать(ТаблицаКодов, ДокументИлиОперация, Ложь);
				Иначе
					КодыДокументов_Записать(ТаблицаКодов, ДокументИлиОперация, Ложь);
				КонецЕсли;
				
				КодыПодобраны = Истина;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрЗаказа.КоличествоКодов) Тогда
				СтрЗаказа.Записать();
			Иначе
				СтрЗаказа.Удалить();
			КонецЕсли;
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат КодыПодобраны;
	
КонецФункции

Функция КодыЗаказов_ПодобратьИзФайла(Файл, СтрокаЗаказа, ТаблицаКодов, КоличествоКодовТребуется)
	
	ТаблицаКодовИзФайла = КодыЗаказов_ИзвлечьИзФайла(Файл);
	
	КодыЗаказов_УдалитьИспользованныеКоды(ТаблицаКодовИзФайла, СтрокаЗаказа);
	Если Не ЗначениеЗаполнено(ТаблицаКодовИзФайла) Тогда
		Файлы_Удалить(Файл);
		Возврат 0;
	КонецЕсли;
	
	Товар = СтрокаЗаказа.Товар;
	ЗаказКодов = СтрокаЗаказа.ЗаказКодов;
	КлючНоменклатуры1С = СтрокаЗаказа.КлючНоменклатуры1С;
	Отбор = Новый Структура("Товар, КлючНоменклатуры1С", Товар, КлючНоменклатуры1С);
	
	ИзвлеченоКодов = 0;
	Для Каждого СтрФайла Из ТаблицаКодовИзФайла.НайтиСтроки(Отбор) Цикл
		
		СтрКода = ТаблицаКодов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрКода, СтрФайла);
		
		ТаблицаКодовИзФайла.Удалить(СтрФайла);
		
		СтрокаЗаказа.КоличествоКодов = СтрокаЗаказа.КоличествоКодов - 1;
		
		ИзвлеченоКодов = ИзвлеченоКодов + 1;
		Если ИзвлеченоКодов = КоличествоКодовТребуется Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИзвлеченоКодов > 0 Тогда
		Если ЗначениеЗаполнено(ТаблицаКодовИзФайла) Тогда
			КодыЗаказов_ПоместитьВФайл(ТаблицаКодовИзФайла, ЗаказКодов);
		Иначе
			Файлы_Удалить(Файл);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИзвлеченоКодов;
	
КонецФункции

Функция КодыЗаказов_ИзвлечьИзФайла(Файл)
	
	ОписаниеФайла = Файл_Прочитать(Файл);
	Если ОписаниеФайла = Неопределено
		Или Не ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
		Возврат Новый_ТаблицаКодов();
	КонецЕсли;
	
	ОписаниеАрхива = Новый_АрхивКодов();
	ЗаполнитьЗначенияСвойств(ОписаниеАрхива, ОписаниеФайла.ДанныеФайла);
	
	ТаблицаКодов = ОписаниеАрхива.ТаблицаКодов;
	СтатусыКодов = ОписаниеАрхива.СтатусыКодов;
	ИнформацияОКодах = ОписаниеАрхива.ИнформацияОКодах;
	
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	
	ТаблицаКодов.Колонки.КлючКода.Имя = "СтарыйКлючКода";
	ТаблицаКодов.Колонки.Добавить("КлючКода", ОписаниеТипа_Идентификатор());
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Для Каждого Стр Из ТаблицаКодов.НайтиСтроки(Новый Структура("КлючКода", ПустойУникальныйИдентификатор())) Цикл
		
		Стр.КлючКода = Стр.СтарыйКлючКода;
		Стр.КодРазобран = Истина;
		
		СтрСтатуса = СтатусыКодов.Найти(Стр.КлючСтатусаКода, "КлючСтатусаКода");
		Если СтрСтатуса <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Стр, СтрСтатуса);
		КонецЕсли;
		
		СтрИнформации = ИнформацияОКодах.Найти(Стр.КлючИнформацииОКоде, "КлючИнформацииОКоде");
		Если СтрИнформации <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Стр, СтрИнформации);
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаКодов.Колонки.Удалить("СтарыйКлючКода");
	
	Возврат ТаблицаКодов;
	
КонецФункции

Функция КодыЗаказов_ТаблицаЗаказаПоТаблицеКодов(ТаблицаКодов)
	
	КолонкиАналитики = "Товар, КлючНоменклатуры1С, ЗаказКодов";
	КолонкаКоличества = "КоличествоКодов";
	
	Результат = ТаблицаКодов.Скопировать(, КолонкиАналитики);
	Результат.Колонки.Добавить(КолонкаКоличества, ОписаниеТипа_Число());
	Результат.ЗаполнитьЗначения(1, КолонкаКоличества);
	Результат.Свернуть(КолонкиАналитики, КолонкаКоличества);
	
	Возврат Результат;
	
КонецФункции

Функция КодыЗаказов_ТаблицаЗаказа(ЗаказКодов)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Товар КАК Товар,
	|	Т.КлючНоменклатуры1С КАК КлючНоменклатуры1С,
	|	Т.ЗаказКодов КАК ЗаказКодов,
	|	СУММА(Т.КоличествоКодов) КАК КоличествоКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыЗаказов КАК Т
	|ГДЕ
	|	Т.ЗаказКодов = &ЗаказКодов
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ЗаказКодов,
	|	Т.КлючНоменклатуры1С,
	|	Т.Товар");
	
	Запрос.УстановитьПараметр("ЗаказКодов", ЗаказКодов);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КодыЗаказов_ИмяФайла(Товар, КлючНоменклатуры1С)
	
	Результат = Перечисление_ТипыФайлов().КодыЗаказа + " GTIN: " + Товар.GTIN;
	
	Если ЗначениеЗаполнено(КлючНоменклатуры1С) Тогда
		Результат = Результат + ", КлючНоменклатуры1С: " + КлючНоменклатуры1С.УникальныйИдентификатор();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ТаблицаЗаказа()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Товар", ОписаниеТипа_Товар());
	Результат.Колонки.Добавить("КлючНоменклатуры1С", ОписаниеТипа_КлючНоменклатуры1С());
	Результат.Колонки.Добавить("ЗаказКодов", ОписаниеТипа_Операция());
	Результат.Колонки.Добавить("КоличествоКодов", ОписаниеТипа_Число());
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // КодыЗаказов

// #Область ПолныеКоды

Процедура ПолныеКоды_Записать(ТаблицаКодов) Экспорт
	
	Если Не ТаблицаКодов_ЕстьПолныеКоды(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаПолныхКодов = ТаблицаКодов.Скопировать(, "КлючКода, ПорцияЗаписей, ПолныйКод, КодМаркировки, ОбщийТипУпаковки");
	ТаблицаЗначений_УдалитьПустыеСтроки(ТаблицаПолныхКодов, "ПолныйКод");
	ТаблицаКодов_ВосстановитьВПолныхКодахРазделителиGS1(ТаблицаПолныхКодов);
	ТаблицаКодов_УдалитьВПолныхКодахКавычкиЭкранированияCSV(ТаблицаПолныхКодов);
	
	ТипФайлаПолныеКоды = Перечисление_ТипыФайлов().ПолныеКоды;
	ВерсияФормата_3_16 = Перечисление_ВерсииФорматовФайлов().Версия_3_16;
	ТранспортнаяУпаковка = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Файлы_ЗаблокироватьПоТаблице(ТаблицаПолныхКодов, "ПорцияЗаписей");
		
		Для Каждого ЧастьТаблицы Из ТаблицаЗначений_Разбить(ТаблицаПолныхКодов, "ПорцияЗаписей") Цикл
			
			СтрокиКодов = ЧастьТаблицы.МассивСтрок;
			ПорцияЗаписей = ЧастьТаблицы.ПорцияЗаписей;
			
			Файл = Файл_НайтиПоИдентификатору(Неопределено, ПорцияЗаписей, ТипФайлаПолныеКоды);
			ЭтоНовыйФайл = Не ЗначениеЗаполнено(Файл);
			
			Если ЭтоНовыйФайл Тогда
				ОписаниеФайла = Новый_ОписаниеФайла();
				ОписаниеФайла.ДанныеФайла = Новый_ТаблицаПолныхКодов();
				ОписаниеФайла.Идентификатор = ПорцияЗаписей;
				ОписаниеФайла.ВерсияФормата = ВерсияФормата_3_16;
				ОписаниеФайла.ТипФайла = ТипФайлаПолныеКоды;
			Иначе
				ОписаниеФайла = Файл_Прочитать(Файл);
				ТаблицаЗначений_ДобавитьИндекс(ОписаниеФайла.ДанныеФайла, "КлючКода");
			КонецЕсли;
			
			ЕстьИзменения = Ложь;
			
			Для Каждого СтрКода Из СтрокиКодов Цикл
				
				Если СтрКода.ПолныйКод = СтрКода.КодМаркировки
					И СтрКода.ОбщийТипУпаковки <> ТранспортнаяУпаковка Тогда
					Продолжить; // Передали нормализованный код вместо полного кода
				КонецЕсли;
				
				СтрФайла = Неопределено;
				Если Не ЭтоНовыйФайл Тогда
					СтрФайла = ОписаниеФайла.ДанныеФайла.Найти(СтрКода.КлючКода, "КлючКода");
				КонецЕсли;
				Если СтрФайла = Неопределено Тогда
					СтрФайла = ОписаниеФайла.ДанныеФайла.Добавить();
					СтрФайла.КлючКода = СтрКода.КлючКода;
				КонецЕсли;
				
				Если СтрФайла.ПолныйКод <> СтрКода.ПолныйКод Тогда
					СтрФайла.ПолныйКод = СтрКода.ПолныйКод;
					ЕстьИзменения = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЕстьИзменения Тогда
				ОписаниеФайла.ДанныеФайла.Индексы.Очистить();
				Файл_Записать(ОписаниеФайла);
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПолныеКоды_Прочитать(ТаблицаКодов) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КодыМаркировки.КлючКода В(&КлючиКодов)
	|	И ИнформацияОКодах.ЕстьПолныйКод
	|ИТОГИ ПО
	|	ПорцияЗаписей");
	Запрос.УстановитьПараметр("КлючиКодов", ТаблицаКодов.ВыгрузитьКолонку("КлючКода"));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТипФайлаПолныеКоды = Перечисление_ТипыФайлов().ПолныеКоды;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючКода");
	
	ВыборкаПорция = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПорция.Следующий() Цикл
		
		Файл = Файл_НайтиПоИдентификатору(Неопределено, ВыборкаПорция.ПорцияЗаписей, ТипФайлаПолныеКоды);
		ОписаниеФайла = Файл_Прочитать(Файл);
		Если ОписаниеФайла = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаЗначений_ДобавитьИндекс(ОписаниеФайла.ДанныеФайла, "КлючКода");
		
		Выборка = ВыборкаПорция.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрКода = ТаблицаКодов.Найти(Выборка.КлючКода, "КлючКода");
			СтрФайла = ОписаниеФайла.ДанныеФайла.Найти(Выборка.КлючКода, "КлючКода");
			Если СтрКода <> Неопределено И СтрФайла <> Неопределено Тогда
				СтрКода.ПолныйКод = СтрФайла.ПолныйКод;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючКода");
	
КонецПроцедуры

Процедура ПолныеКоды_ВТ_Удалить(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТаблицаКодов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ТаблицаКодов.МожноУдалить
	|	И ИнформацияОКодах.ЕстьПолныйКод
	|ИТОГИ ПО
	|	ПорцияЗаписей");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТипФайлаПолныеКоды = Перечисление_ТипыФайлов().ПолныеКоды;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Файлы_ЗаблокироватьПоТаблице(РезультатЗапроса, "ПорцияЗаписей");
		
		ВыборкаПорция = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПорция.Следующий() Цикл
			
			Файл = Файл_НайтиПоИдентификатору(Неопределено, ВыборкаПорция.ПорцияЗаписей, ТипФайлаПолныеКоды);
			ОписаниеФайла = Файл_Прочитать(Файл);
			Если ОписаниеФайла = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТаблицаЗначений_ДобавитьИндекс(ОписаниеФайла.ДанныеФайла, "КлючКода");
			
			Выборка = ВыборкаПорция.Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрФайла = ОписаниеФайла.ДанныеФайла.Найти(Выборка.КлючКода, "КлючКода");
				Если СтрФайла <> Неопределено Тогда
					ОписаниеФайла.ДанныеФайла.Удалить(СтрФайла);
				КонецЕсли;
			КонецЦикла;
			
			ТаблицаЗначений_УдалитьИндекс(ОписаниеФайла.ДанныеФайла, "КлючКода");
			
			Если ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
				Файл_Записать(ОписаниеФайла);
			Иначе
				Файлы_Удалить(Файл);
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #Область КодыМаркировки

Процедура КодыМаркировки_Записать(ТаблицаКодов)
	
	Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыМаркировки_ЗаблокироватьПоТаблице(ТаблицаКодов);
		
		// Ответственное чтение
		ТаблицаКодов_ЗаполнитьКлючиКодов(ТаблицаКодов);
		ТаблицаКодов_ЗаполнитьКлючиНовыхКодов(ТаблицаКодов);
		ТаблицаКодов_ЗаполнитьКлючиНовыхПорций(ТаблицаКодов);
		ТаблицаКодов_ЗаполнитьКлючиАгрегатов(ТаблицаКодов);
		
		МенеджерВТ = КодыМаркировки_ТаблицыДляЗаписи(ТаблицаКодов);
		
		КодыМаркировки_ВТ_Записать(МенеджерВТ);
		КодыОпераций_ВТ_ОбновитьКоличествоКодов(МенеджерВТ);
		КодыДокументов_ВТ_ОбновитьКоличествоКодов(МенеджерВТ);
		УстаревшиеКоды_ВТ_Записать(МенеджерВТ);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыМаркировки_Прочитать(ТаблицаКодов) Экспорт
	
	Если Не ТаблицаКодов_ЕстьКлючиКодов(ТаблицаКодов) Тогда
		КодыМаркировкиАгрегатов_Прочитать(ТаблицаКодов);
		Возврат;
	КонецЕсли;
	
	КлючиКодов = ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "КлючКода", Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК Т
	|ГДЕ
	|	Т.КлючКода В(&КлючиКодов)");
	Запрос.УстановитьПараметр("КлючиКодов", КлючиКодов);
	РезультатЗапроса = Запрос.Выполнить();
	КлючиКодов.Очистить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючКода");
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрКода = ТаблицаКодов.Найти(Выборка.КлючКода, "КлючКода");
		ЗаполнитьЗначенияСвойств(СтрКода, Выборка);
		СтрКода.КодРазобран = Истина;
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючКода");
	
	КодыМаркировкиАгрегатов_Прочитать(ТаблицаКодов);
	
КонецПроцедуры

Процедура КодыМаркировки_ВТ_Удалить(МенеджерВТ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТаблицаКодов.КлючКода = КодыМаркировки.КлючКода
	|ГДЕ
	|	ТаблицаКодов.МожноУдалить");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		КодыМаркировки_ЗаблокироватьПоТаблице(РезультатЗапроса);
		
		Набор = КодыМаркировки_ОписаниеНабораЗаписей();
		Набор.РежимЗаписи = Перечисление_РежимыЗаписиНабора().Удаление;
		Набор.ТаблицаНабора = Запрос.Выполнить().Выгрузить();
		ЗаписатьНаборРегистраСведений(Набор);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура КодыМаркировки_ВТ_Записать(МенеджерВТ)
	
	Набор = КодыМаркировки_ОписаниеНабораЗаписей();
	Набор.ТаблицаНабора = ТаблицаИзЗапроса(МенеджерВТ, "ТаблицаНабораКодыМаркировки", Истина);
	ЗаписатьНаборыРегистраСведенийСРазнымиРежимамиЗаписи(Набор);
	
КонецПроцедуры

Процедура КодыМаркировкиАгрегатов_Прочитать(ТаблицаКодов)
	
	Если Не ТаблицаКодов_ЕстьКлючиАгрегатов(ТаблицаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТабКодов = ТаблицаКодов.Скопировать(Новый Структура("КодАгрегата", ""), "КлючАгрегата");
	КлючиАгрегатов = ТаблицаЗначений_ВыгрузитьКолонку(ТабКодов, "КлючАгрегата", Истина);
	ТабКодов.Очистить();
	
	Если Не ЗначениеЗаполнено(КлючиАгрегатов) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючАгрегата,
	|	Т.КодМаркировки КАК КодАгрегата
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК Т
	|ГДЕ
	|	Т.КлючКода В(&КлючиАгрегатов)");
	Запрос.УстановитьПараметр("КлючиАгрегатов", КлючиАгрегатов);
	РезультатЗапроса = Запрос.Выполнить();
	КлючиАгрегатов.Очистить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗначений_ДобавитьИндекс(ТаблицаКодов, "КлючАгрегата");
	
	Отбор = Новый Структура("КлючАгрегата");
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Отбор.КлючАгрегата = Выборка.КлючАгрегата;
		Для Каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			СтрКода.КодАгрегата = Выборка.КодАгрегата;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаЗначений_УдалитьИндекс(ТаблицаКодов, "КлючАгрегата");
	
КонецПроцедуры

Процедура КодыМаркировки_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "ПорцияЗаписей")
	
	Поле = "ПорцияЗаписей";
	ИмяОбъекта = "РегистрСведений.КонтурМаркировка_КодыМаркировки";
	ЗаблокироватьПоТаблице(ИмяОбъекта, Поле, Таблица, ИмяКолонки);
	
КонецПроцедуры

Процедура КодыМаркировки_Заблокировать(ПорцияЗаписей)
	
	Значения = Новый Структура("ПорцияЗаписей", ПорцияЗаписей);
	ИмяОбъекта = "РегистрСведений.КонтурМаркировка_КодыМаркировки";
	ЗаблокироватьПоЗначениям(ИмяОбъекта, Значения);
	
КонецПроцедуры

Процедура КодыМаркировки_РасформироватьАгрегат(КлючАгрегата) Экспорт
	
	ОбщийТипУпаковки = КодМаркировки_ОбщийТипУпаковки(КлючАгрегата);
	ТипУпаковкиНабор = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор;
	ЭтоНабор = (ОбщийТипУпаковки = ТипУпаковкиНабор);
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Стр = ТаблицаКодов.Добавить();
	Стр.КлючКода = КлючАгрегата;
	Стр.УдалитьИзДокумента = Не ЭтоНабор;
	
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.КлючКода <> КлючАгрегата Тогда
			Стр.КодАгрегата = "";
			Стр.КлючАгрегата = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		Если Не ЭтоНабор Тогда
			КодыДокументов_РасформироватьАгрегат(КлючАгрегата, ТаблицаКодов);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция КодыМаркировки_ВложенныеКодыМаркировки(КлючАгрегата, ДляВнутреннегоУчета = Неопределено)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыМаркировки.КодМаркировки КАК КодМаркировки
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КодыМаркировки.КлючАгрегата = &КлючАгрегата
	|	И &ДляВнутреннегоУчета";
	
	Если ДляВнутреннегоУчета = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", "ИСТИНА");
	Иначе
		Условие = "ИнформацияОКодах.ДляВнутреннегоУчета = &ДляВнутреннегоУчета";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КлючАгрегата", КлючАгрегата);
	Запрос.УстановитьПараметр("ДляВнутреннегоУчета", ДляВнутреннегоУчета);
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "КодМаркировки");
	
КонецФункции

Функция КодыМаркировки_ТаблицаВложенныхКодов(КлючиАгрегатов, ОбщийТипУпаковки = Неопределено, ДляВнутреннегоУчета = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КодыМаркировки.КлючАгрегата В(&КлючиАгрегатов)
	|	И &ДляВнутреннегоУчета
	|	И &ОбщийТипУпаковки";
	
	Если ДляВнутреннегоУчета = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", "ИСТИНА");
	Иначе
		Условие = "ИнформацияОКодах.ДляВнутреннегоУчета = &ДляВнутреннегоУчета";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", Условие);
	КонецЕсли;
	
	Если ОбщийТипУпаковки = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОбщийТипУпаковки", "ИСТИНА");
	Иначе
		Условие = "ИнформацияОКодах.ОбщийТипУпаковки = &ОбщийТипУпаковки";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОбщийТипУпаковки", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КлючиАгрегатов", ЗначениеВМассиве(КлючиАгрегатов));
	Запрос.УстановитьПараметр("ОбщийТипУпаковки", ОбщийТипУпаковки);
	Запрос.УстановитьПараметр("ДляВнутреннегоУчета", ДляВнутреннегоУчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_ТаблицаКодов();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить().КлючКода = Выборка.КлючКода;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КодыМаркировки_КоличествоВложенныхКодов(КлючиАгрегатов, ОбщийТипУпаковки = Неопределено, ДляВнутреннегоУчета = Неопределено)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючАгрегата КАК КлючКода,
	|	КОЛИЧЕСТВО(*) КАК КоличествоВложенныхКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КодыМаркировки.КлючАгрегата В(&КлючиАгрегатов)
	|	И &ДляВнутреннегоУчета
	|	И &ОбщийТипУпаковки
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыМаркировки.КлючАгрегата";
	
	Если ДляВнутреннегоУчета = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", "ИСТИНА");
	Иначе
		Условие = "ИнформацияОКодах.ДляВнутреннегоУчета = &ДляВнутреннегоУчета";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДляВнутреннегоУчета", Условие);
	КонецЕсли;
	
	Если ОбщийТипУпаковки = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОбщийТипУпаковки", "ИСТИНА");
	Иначе
		Условие = "ИнформацияОКодах.ОбщийТипУпаковки = &ОбщийТипУпаковки";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОбщийТипУпаковки", Условие);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КлючиАгрегатов", ЗначениеВМассиве(КлючиАгрегатов));
	Запрос.УстановитьПараметр("ОбщийТипУпаковки", ОбщийТипУпаковки);
	Запрос.УстановитьПараметр("ДляВнутреннегоУчета", ДляВнутреннегоУчета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КодыМаркировки_ТаблицыДляЗаписи(ТаблицаКодов)
	
	РежимыЗаписи = Перечисление_РежимыЗаписиНабора();
	ИменаПолей = КодыМаркировки_ИменаПолей();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаКодов.Скопировать(, ИменаПолей), "ТабКодов", ИменаПолей);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Обновление", РежимыЗаписи.Обновление);
	Запрос.УстановитьПараметр("Добавление", РежимыЗаписи.Добавление);
	Запрос.УстановитьПараметр("Удаление", РежимыЗаписи.Удаление);
	
	КодыМаркировки_ВТ_ДобавитьТаблицуНабора_КодыМаркировки(Запрос);
	КодыМаркировки_ВТ_ДобавитьТаблицуНабора_КоличествоКодовОпераций(Запрос);
	КодыМаркировки_ВТ_ДобавитьТаблицуНабора_КоличествоКодовДокументов(Запрос);
	
	УстаревшиеКоды_ВТ_ДобавитьТаблицуДляЗаписи(Запрос, "ТаблицаНабораКодыМаркировки");
	
	Возврат МенеджерВТ;
	
КонецФункции

Функция КодМаркировки_ВидПродукции(КодМаркировкиИлиКлючКода) Экспорт
	
	Если ТипЗнч(КодМаркировкиИлиКлючКода) = Тип("УникальныйИдентификатор") Тогда
		КлючКода = КодМаркировкиИлиКлючКода;
	Иначе
		КлючКода = КодМаркировки_КлючКода(КодМаркировкиИлиКлючКода);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючКода) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ИнформацияОКодах.Товар.ВидПродукции, ИнформацияОКодах.ВидПродукции) КАК ВидПродукции
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КодыМаркировки.КлючКода = &КлючКода");
	Запрос.УстановитьПараметр("КлючКода", КлючКода);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "ВидПродукции");
	
КонецФункции

Функция КодМаркировки_ОбщийТипУпаковки(КодМаркировкиИлиКлючКода) Экспорт
	
	Если ТипЗнч(КодМаркировкиИлиКлючКода) = Тип("УникальныйИдентификатор") Тогда
		КлючКода = КодМаркировкиИлиКлючКода;
	Иначе
		КлючКода = КодМаркировки_КлючКода(КодМаркировкиИлиКлючКода);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючКода) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ИнформацияОКодах.ОбщийТипУпаковки, НЕОПРЕДЕЛЕНО) КАК ОбщийТипУпаковки
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	КодыМаркировки.КлючКода = &КлючКода");
	Запрос.УстановитьПараметр("КлючКода", КлючКода);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "ОбщийТипУпаковки");
	
КонецФункции

Функция КодМаркировки_КлючКода(КодМаркировки) Экспорт
	
	Если Не ЗначениеЗаполнено(КодМаркировки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КлючКода КАК КлючКода
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК Т
	|ГДЕ
	|	Т.КодМаркировки = &КодМаркировки
	|	И Т.ХешСуммаКодаМаркировки = &ХешСуммаКода");
	Запрос.УстановитьПараметр("КодМаркировки", КодМаркировки);
	Запрос.УстановитьПараметр("ХешСуммаКода", ХешСуммыСтрок(КодМаркировки)[0]);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КлючКода");
	
КонецФункции

Функция КодМаркировки_НайтиПоКлючу(КлючКода) Экспорт
	
	Если Не ЗначениеЗаполнено(КлючКода) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.КодМаркировки КАК КодМаркировки
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК Т
	|ГДЕ
	|	Т.КлючКода = &КлючКода");
	Запрос.УстановитьПараметр("КлючКода", КлючКода);
	
	Возврат ПолучитьРезультатЗапроса(Запрос, "КодМаркировки");
	
КонецФункции

Функция КодМаркировки_ПолныйКод(КлючКода)
	
	Если Не ЗначениеЗаполнено(КлючКода) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НоваяТаблицаКодов = Новый_ТаблицаКодов();
	НоваяТаблицаКодов.Добавить().КлючКода = КлючКода;
	ПолныеКоды_Прочитать(НоваяТаблицаКодов);
	
	Возврат НоваяТаблицаКодов[0].ПолныйКод;
	
КонецФункции

Процедура КодыМаркировки_ВТ_ДобавитьТаблицуНабора_КодыМаркировки(Запрос)
	
	СоединениеПоВсемПолям = ТекстЗапросаУсловияСоединения("ТабКодов", "СовпадающиеЗаписи", КодыМаркировки_ИменаПолей());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТабКодов.*,
	|	СуществующиеЗаписи.КлючИнформацииОКоде КАК СтарыйКлючИнформацииОКоде,
	|	СуществующиеЗаписи.КлючСтатусаКода КАК СтарыйКлючСтатусаКода,
	|	ВЫБОР
	|		КОГДА ТабКодов.КлючАгрегата = ПустойКлюч.Ключ
	|				И СуществующиеЗаписи.КлючКода ЕСТЬ НЕ NULL 
	|				И СуществующиеЗаписи.КлючАгрегата <> ПустойКлюч.Ключ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Устаревший,
	|	ВЫБОР
	|		КОГДА СуществующиеЗаписи.КлючКода ЕСТЬ NULL
	|			ТОГДА &Добавление
	|		ИНАЧЕ &Обновление
	|	КОНЕЦ КАК РежимЗаписи
	|ПОМЕСТИТЬ ТаблицаНабораКодыМаркировки
	|ИЗ
	|	ТабКодов КАК ТабКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК СуществующиеЗаписи
	|		ПО ТабКодов.ПорцияЗаписей = СуществующиеЗаписи.ПорцияЗаписей
	|			И ТабКодов.КлючКода = СуществующиеЗаписи.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК СовпадающиеЗаписи
	|		ПО (&СоединениеПоВсемПолям)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПустойКлюч КАК ПустойКлюч
	|		ПО (ИСТИНА)
	|ГДЕ
	|	СовпадающиеЗаписи.КлючКода ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТабКодов.КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКодов";
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&СоединениеПоВсемПолям", СоединениеПоВсемПолям);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура КодыМаркировки_ВТ_ДобавитьТаблицуНабора_КоличествоКодовОпераций(Запрос)
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабКодыМаркировки.КлючКода КАК КлючКода,
	|	ТабКодыМаркировки.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	ТабКодыМаркировки.КлючСтатусаКода КАК КлючСтатусаКода,
	|	ТабКодыМаркировки.СтарыйКлючИнформацииОКоде КАК СтарыйКлючИнформацииОКоде,
	|	ТабКодыМаркировки.СтарыйКлючСтатусаКода КАК СтарыйКлючСтатусаКода
	|ПОМЕСТИТЬ ТабИзменений
	|ИЗ
	|	ТаблицаНабораКодыМаркировки КАК ТабКодыМаркировки
	|ГДЕ
	|	ТабКодыМаркировки.РежимЗаписи = &Обновление
	|	И (ТабКодыМаркировки.КлючИнформацииОКоде <> ТабКодыМаркировки.СтарыйКлючИнформацииОКоде
	|			ИЛИ ТабКодыМаркировки.КлючСтатусаКода <> ТабКодыМаркировки.СтарыйКлючСтатусаКода)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыОпераций.Операция КАК Операция,
	|	КодыОпераций.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	ТабИзменений.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	ТабИзменений.КлючСтатусаКода КАК КлючСтатусаКода,
	|	ТабИзменений.СтарыйКлючИнформацииОКоде КАК СтарыйКлючИнформацииОКоде,
	|	ТабИзменений.СтарыйКлючСтатусаКода КАК СтарыйКлючСтатусаКода,
	|	КОЛИЧЕСТВО(*) КАК КоличествоКодов
	|ПОМЕСТИТЬ ТабКолКодов
	|ИЗ
	|	ТабИзменений КАК ТабИзменений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО ТабИзменений.КлючКода = КодыОпераций.КлючКода
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыОпераций.Операция,
	|	КодыОпераций.КлючСтрокиОперации,
	|	ТабИзменений.КлючИнформацииОКоде,
	|	ТабИзменений.КлючСтатусаКода,
	|	ТабИзменений.СтарыйКлючИнформацииОКоде,
	|	ТабИзменений.СтарыйКлючСтатусаКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабИзменений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабКолКодов.Операция КАК Операция,
	|	ТабКолКодов.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	ТабКолКодов.СтарыйКлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	ТабКолКодов.СтарыйКлючСтатусаКода КАК КлючСтатусаКода,
	|	СУММА(ТабКолКодов.КоличествоКодов) КАК КоличествоКодов
	|ПОМЕСТИТЬ ТабКолКодовСтарые
	|ИЗ
	|	ТабКолКодов КАК ТабКолКодов
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабКолКодов.Операция,
	|	ТабКолКодов.КлючСтрокиОперации,
	|	ТабКолКодов.СтарыйКлючИнформацииОКоде,
	|	ТабКолКодов.СтарыйКлючСтатусаКода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Операция,
	|	КлючСтрокиОперации,
	|	КлючИнформацииОКоде,
	|	КлючСтатусаКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабКолКодов.Операция КАК Операция,
	|	ТабКолКодов.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	ТабКолКодов.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	ТабКолКодов.КлючСтатусаКода КАК КлючСтатусаКода,
	|	СУММА(ТабКолКодов.КоличествоКодов) КАК КоличествоКодов
	|ПОМЕСТИТЬ ТабКолКодовНовые
	|ИЗ
	|	ТабКолКодов КАК ТабКолКодов
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабКолКодов.Операция,
	|	ТабКолКодов.КлючСтрокиОперации,
	|	ТабКолКодов.КлючИнформацииОКоде,
	|	ТабКолКодов.КлючСтатусаКода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Операция,
	|	КлючСтрокиОперации,
	|	КлючИнформацииОКоде,
	|	КлючСтатусаКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКолКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабКолКодов.Операция КАК Операция,
	|	ТабКолКодов.КлючСтрокиОперации КАК КлючСтрокиОперации,
	|	ТабКолКодов.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	ТабКолКодов.КлючСтатусаКода КАК КлючСтатусаКода,
	|	ТекКолКодов.КоличествоКодов - ТабКолКодов.КоличествоКодов КАК КоличествоКодов,
	|	ВЫБОР
	|		КОГДА ТекКолКодов.КоличествоКодов > ТабКолКодов.КоличествоКодов
	|			ТОГДА &Обновление
	|		ИНАЧЕ &Удаление
	|	КОНЕЦ КАК РежимЗаписи
	|ПОМЕСТИТЬ ТаблицаНабораКоличествоКодовОпераций
	|ИЗ
	|	ТабКолКодовСтарые КАК ТабКолКодов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций КАК ТекКолКодов
	|		ПО ТабКолКодов.Операция = ТекКолКодов.Операция
	|			И ТабКолКодов.КлючСтрокиОперации = ТекКолКодов.КлючСтрокиОперации
	|			И ТабКолКодов.КлючИнформацииОКоде = ТекКолКодов.КлючИнформацииОКоде
	|			И ТабКолКодов.КлючСтатусаКода = ТекКолКодов.КлючСтатусаКода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТабКолКодов.Операция,
	|	ТабКолКодов.КлючСтрокиОперации,
	|	ТабКолКодов.КлючИнформацииОКоде,
	|	ТабКолКодов.КлючСтатусаКода,
	|	ТабКолКодов.КоличествоКодов + ЕСТЬNULL(ТекКолКодов.КоличествоКодов, 0),
	|	ВЫБОР
	|		КОГДА ТекКолКодов.КоличествоКодов ЕСТЬ НЕ NULL 
	|			ТОГДА &Обновление
	|		ИНАЧЕ &Добавление
	|	КОНЕЦ
	|ИЗ
	|	ТабКолКодовНовые КАК ТабКолКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций КАК ТекКолКодов
	|		ПО ТабКолКодов.Операция = ТекКолКодов.Операция
	|			И ТабКолКодов.КлючСтрокиОперации = ТекКолКодов.КлючСтрокиОперации
	|			И ТабКолКодов.КлючИнформацииОКоде = ТекКолКодов.КлючИнформацииОКоде
	|			И ТабКолКодов.КлючСтатусаКода = ТекКолКодов.КлючСтатусаКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКолКодовСтарые
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабКолКодовНовые";
	
	Запрос.Выполнить();
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	
КонецПроцедуры

Процедура КодыМаркировки_ВТ_ДобавитьТаблицуНабора_КоличествоКодовДокументов(Запрос)
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабКодыМаркировки.КлючКода КАК КлючКода,
	|	ТабКодыМаркировки.КлючИнформацииОКоде КАК КлючИнформацииОКоде,
	|	ТабКодыМаркировки.КлючСтатусаКода КАК КлючСтатусаКода,
	|	ТабКодыМаркировки.СтарыйКлючИнформацииОКоде КАК СтарыйКлючИнформацииОКоде,
	|	ТабКодыМаркировки.СтарыйКлючСтатусаКода КАК СтарыйКлючСтатусаКода
	|ПОМЕСТИТЬ ТабИзменений
	|ИЗ
	|	ТаблицаНабораКодыМаркировки КАК ТабКодыМаркировки
	|ГДЕ
	|	ТабКодыМаркировки.РежимЗаписи = &Обновление
	|	И (ТабКодыМаркировки.КлючИнформацииОКоде <> ТабКодыМаркировки.СтарыйКлючИнформацииОКоде
	|			ИЛИ ТабКодыМаркировки.КлючСтатусаКода <> ТабКодыМаркировки.СтарыйКлючСтатусаКода)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыДокументов.ДокументУчета КАК ДокументУчета,
	|	КодыДокументов.КлючСтрокиДокумента КАК КлючСтрокиДокумента,
	|	КодыДокументов.КлючПроверкиКода КАК КлючПроверкиКода,
