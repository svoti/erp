КонецФункции

// #КонецОбласти // НастройкиПользователя

// #Область Авторизация

Функция Авторизация_Выполнить(КонтекстОбмена) Экспорт
	
	Результат = Мок_Авторизация_Выполнить(КонтекстОбмена);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	НужнаАвторизацияПортала = КонтекстОбмена.ТребуетсяАвторизацияПортала И Не КонтекстОбмена.ВыполненаАвторизацияПортала;
	НужнаАвторизацияГИС = КонтекстОбмена.ТребуетсяАвторизацияГИС И Не КонтекстОбмена.ВыполненаАвторизацияГИС;
	
	Если Не НужнаАвторизацияПортала И Не НужнаАвторизацияГИС Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПроверитьДоступностьПодписиНаСервере(КонтекстОбмена);
	Если Не КонтекстОбмена.ДоступнаПодписьНаСервере Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НужнаАвторизацияПортала Тогда
		Если АвторизацияПортал_Выполнить(КонтекстОбмена) Тогда
			// После авторизации на портале дополнительно проверяется доступ в ГИС МТ
			НужнаАвторизацияГИС = КонтекстОбмена.ТребуетсяАвторизацияГИС И Не КонтекстОбмена.ВыполненаАвторизацияГИС;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НужнаАвторизацияГИС
		И Не АвторизацияГИС_Продлить(КонтекстОбмена) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция АвторизацияПортал_Выполнить(КонтекстОбмена)
	
	Организация = КонтекстОбмена.Организация;
	Сертификат = КонтекстОбмена.Сертификат;
	
	Попытка
		
		ФайлСертификата = Плагин_ФайлСертификата(Сертификат.ОтпечатокСертификата);
		ЗашифрованныйКлюч = СервисАвторизации_ЗапроситьАвторизацию(ФайлСертификата);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = "Авторизация в сервисе Контур.Маркировка";
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("Сертификат", Сертификат);
		ТекстСообщения = ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось выполнить авторизацию в сервисе Контур.Маркировка по организации: %1'"), Организация);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
		Если КонтекстОбмена.ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецПопытки;
	
	Попытка
		
		РасшифрованныйКлюч = Плагин_РасшифроватьКонтент(ЗашифрованныйКлюч);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = "Расшифровка ключа авторизации в сервисе Контур.Маркировка";
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("Сертификат", Сертификат);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		
		КонтекстОбмена.ТекстОшибки = КраткоеПредставлениеОшибки(Ошибка);
		КонтекстОбмена.НеУдалосьРасшифроватьКонтент = Истина;
		
		Если КонтекстОбмена.ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецПопытки;
	
	АвторизацияПортал_ВыполнитьПослеРасшифровки(РасшифрованныйКлюч, КонтекстОбмена);
	
	Возврат КонтекстОбмена.ВыполненаАвторизацияПортала;
	
КонецФункции

Процедура АвторизацияПортал_Продлить(КонтекстОбмена) Экспорт
	
	СрокЖизниТокенаПродления = 29;
	
	Сертификат = КонтекстОбмена.Сертификат;
	Токен = ПортальныйТокен_Прочитать(Сертификат);
	ТокенПродления = ПортальныйТокенПродления_Прочитать(Сертификат);
	СрокДействияТокена = СрокДействияПортальногоТокена_Прочитать(Сертификат);
	
	Если Не ЗначениеЗаполнено(Токен)
		Или Не ЗначениеЗаполнено(ТокенПродления)
		Или Не ЗначениеЗаполнено(СрокДействияТокена) Тогда
		Возврат;
	КонецЕсли;
	
	Если СрокДействияТокена - СекундВЧасе() > ТекущаяУниверсальнаяДата() Тогда
		Возврат; // Минимум час токен еще действует, продлевать не нужно
	КонецЕсли;
	
	Если СрокДействияТокена + СрокЖизниТокенаПродления * СекундВСутках() < ТекущаяУниверсальнаяДата() Тогда
		// Токен продления уже не действует, продлить не получится
		ПортальныйТокен_Удалить(Сертификат);
		Возврат;
	КонецЕсли;
	
	Попытка
		Контент = Контент_ПродлитьТокен(ТокенПродления);
		Ответ = СервисАвторизации_ПолучитьТокен(Контент);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ) Тогда
		Возврат;
	КонецЕсли;
	
	Токен = СвойствоСтруктуры(Ответ.Результат, "access_token");
	ТокенПродления = СвойствоСтруктуры(Ответ.Результат, "refresh_token");
	СрокДействияТокена = ТекущаяУниверсальнаяДата() + СвойствоСтруктуры(Ответ.Результат, "expires_in", 0);
	
	Если ЗначениеЗаполнено(Токен) Тогда
		ПортальныйТокен_Записать(Сертификат, Токен, ТокенПродления, СрокДействияТокена);
	Иначе
		ПортальныйТокен_Удалить(Сертификат); // Не получилось продлить
	КонецЕсли;
	
КонецПроцедуры

Процедура АвторизацияПортал_ВыполнитьПослеРасшифровки(РасшифрованныйКлюч, КонтекстОбмена) Экспорт
	
	Сертификат = КонтекстОбмена.Сертификат;
	Организация = КонтекстОбмена.Организация;
	
	Попытка
		Контент = Контент_ПолучитьТокен(Сертификат, РасшифрованныйКлюч);
		Ответ = СервисАвторизации_ПолучитьТокен(Контент);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ) Тогда
		Возврат;
	КонецЕсли;
	
	Токен = СвойствоСтруктуры(Ответ.Результат, "access_token");
	ТокенПродления = СвойствоСтруктуры(Ответ.Результат, "refresh_token");
	СрокДействияТокена = ТекущаяУниверсальнаяДата() + СвойствоСтруктуры(Ответ.Результат, "expires_in", 0);
	
	ПортальныйТокен_Записать(Сертификат, Токен, ТокенПродления, СрокДействияТокена);
	
	АвторизацияМаркировка_Проверить(КонтекстОбмена);
	Если Не КонтекстОбмена.ТребуетсяАвторизацияПортала Тогда
		КонтекстОбмена.ВыполненаАвторизацияПортала = Истина;
	КонецЕсли;
	
	Если КонтекстОбмена.ВыполненаАвторизацияПортала Тогда
		КонтекстОбмена_ПроверитьПодписку(КонтекстОбмена);
		АвторизацияГИС_Проверить(КонтекстОбмена);
	КонецЕсли;
	
	МетрикаОП_Авторизация(Сертификат, Организация);
	
КонецПроцедуры

Функция АвторизацияГИС_Продлить(КонтекстОбмена)
	
	Организация = КонтекстОбмена.Организация;
	Сертификат = КонтекстОбмена.Сертификат;
	ОтпечатокСертификата = КонтекстОбмена.ОтпечатокСертификата;
	
	Попытка
		
		ФайлыДляПодписи = Маркировка_ФайлыАвторизацииГИС(Организация, Сертификат);
		АвторизацияГИС_ПодписатьФайлы(ФайлыДляПодписи, КонтекстОбмена);
		АвторизацияГИС_ПродлитьПослеПодписания(Организация, Сертификат, ФайлыДляПодписи);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = "Продление авторизации в ГИС МТ";
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("Сертификат", Сертификат);
		ТекстСообщения = ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось продлить авторизацию в ГИС МТ по организации: %1'"), Организация);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
		КонтекстОбмена.ТекстОшибки = КраткоеПредставлениеОшибки(Ошибка);
		
		Если КонтекстОбмена.ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецПопытки;
	
	КонтекстОбмена.ВыполненаАвторизацияГИС = Истина;
	
	Возврат Истина;
	
КонецФункции

Процедура АвторизацияГИС_ПодписатьФайлы(ФайлыДляПодписи, КонтекстОбмена)
	
	Организация = КонтекстОбмена.ОтпечатокСертификата;
	Сертификат = КонтекстОбмена.Сертификат;
	ОтпечатокСертификата = КонтекстОбмена.ОтпечатокСертификата;
	
	МассивФайлов = Новый Массив;
	Для каждого ОписаниеФайла Из ФайлыДляПодписи Цикл
		ДополнитьМассив(МассивФайлов, МассивСтруктур_Выгрузить(ОписаниеФайла.contents, "content"));
	КонецЦикла;
	
	Попытка
		
		Подписи = Плагин_ПодписатьДанные(МассивФайлов, ОтпечатокСертификата, Истина);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Подписание файлов для продления в ГИС МТ'");
		ДопИнформация = Новый Структура;
		ДопИнформация.Вставить("Организация", Организация);
		ДопИнформация.Вставить("Сертификат", Сертификат);
		ДопИнформация.Вставить("ОтпечатокСертификата", ОтпечатокСертификата);
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
		
		КонтекстОбмена.ТекстОшибки = КраткоеПредставлениеОшибки(Ошибка);
		КонтекстОбмена.НеУдалосьПодписатьФайлы = Истина;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Для каждого ОписаниеФайла Из ФайлыДляПодписи Цикл
		Для каждого Элемент Из ОписаниеФайла.contents Цикл
			ИндексПодписи = МассивФайлов.Найти(Элемент.content);
			Элемент.content = Подписи[ИндексПодписи];
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура АвторизацияГИС_ПродлитьПослеПодписания(Организация, Сертификат, ПодписанныеФайлы) Экспорт
	
	ПериодДействия = Маркировка_ПродлитьАвторизациюГИС(Организация, Сертификат, ПодписанныеФайлы);
	
КонецПроцедуры

Процедура АвторизацияМаркировка_Проверить(КонтекстОбмена) Экспорт
	
	Организация = КонтекстОбмена.Организация;
	Сертификат = КонтекстОбмена.Сертификат;
	Токен = ПортальныйТокен_Прочитать(Сертификат);
	
	Если Не ЗначениеЗаполнено(Токен) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ДоступЕсть = Маркировка_ПроверитьДоступ(Организация, Токен);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ДоступЕсть = Ложь;
	КонецПопытки;
	
	КонтекстОбмена.ТребуетсяАвторизацияПортала = Не ДоступЕсть;
	
КонецПроцедуры

Процедура АвторизацияГИС_Проверить(КонтекстОбмена) Экспорт
	
	Если КонтекстОбмена.ОтключитьПроверкуАвторизацииГИС Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстОбмена.ТребуетсяАвторизацияГИС = Ложь;
	
	Если Не КонтекстОбмена.ПродлеватьДоступГИС Тогда
		Возврат;
	КонецЕсли;
	
	Если КонтекстОбмена.ТребуетсяАвторизацияПортала
		И Не КонтекстОбмена.ВыполненаАвторизацияПортала Тогда
		Возврат;
	КонецЕсли;
	
	Организация = КонтекстОбмена.Организация;
	БлижайшийЧас = ТекущаяУниверсальнаяДата() + СекундВЧасе();
	
	Попытка
		ПериодДействия = Маркировка_ПериодДействияАвторизацииГИС(Организация);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ПериодДействия)
		Или ПериодДействия < БлижайшийЧас Тогда
		КонтекстОбмена.ТребуетсяАвторизацияГИС = Истина;
	Иначе
		КонтекстОбмена.ТребуетсяАвторизацияГИС = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПортальныйТокен_Удалить(Сертификат) Экспорт
	
	ПортальныйТокен_Записать(Сертификат, Неопределено, Неопределено, Неопределено);
	
КонецПроцедуры

Процедура ПортальныеТокены_Удалить() Экспорт
	
	Сертификаты = НастройкиПодписания_Сертификаты();
	Для Каждого Сертификат Из Сертификаты Цикл
		ПортальныйТокен_Записать(Сертификат, Неопределено, Неопределено, Неопределено);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПортальныйТокен_Записать(Сертификат, Токен, ТокенПродления, СрокДействияПортальногоТокена = Неопределено)
	
	БезопасноеХранилище_Записать(Сертификат, Токен, "ПортальныйТокен");
	БезопасноеХранилище_Записать(Сертификат, ТокенПродления, "ПортальныйТокенПродления");
	БезопасноеХранилище_Записать(Сертификат, СрокДействияПортальногоТокена, "СрокДействияПортальногоТокена");
	
КонецПроцедуры

Функция ПортальныйТокен_Прочитать(Сертификат)
	
	Возврат БезопасноеХранилище_Прочитать(Сертификат, "ПортальныйТокен");
	
КонецФункции

Функция ПортальныйТокенПродления_Прочитать(Сертификат)
	
	Возврат БезопасноеХранилище_Прочитать(Сертификат, "ПортальныйТокенПродления");
	
КонецФункции

Функция СрокДействияПортальногоТокена_Прочитать(Сертификат)
	
