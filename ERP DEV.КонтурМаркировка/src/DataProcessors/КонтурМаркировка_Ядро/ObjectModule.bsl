// Скачивает файл из интернета по ссылке
//
// Параметры:
//  СсылкаНаФаил - Строка - URL адрес файла в интернете
// 
// Возвращаемое значение:
//  ДвоичныеДанные - скаченный файл
//
Функция СкачатьФайлИзИнтернета(СсылкаНаФаил) Экспорт
	
	Результат = Мок_СкачатьФайлИзИнтернета(СсылкаНаФаил);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеЗапроса = Новый_ОписаниеЗапросаHTTP();
	СтруктураURI = СтруктураURI(СсылкаНаФаил);
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, СтруктураURI);
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
	ОписаниеЗапроса.ТелоОтветаКакДвоичныеДанные = Истина;
	
	ОшибкиФайлПеремещен = Новый Массив;
	ОшибкиФайлПеремещен.Добавить(301);
	ОшибкиФайлПеремещен.Добавить(302);
	ОшибкиФайлПеремещен.Добавить(303);
	ОшибкиФайлПеремещен.Добавить(307);
	ОшибкиФайлПеремещен.Добавить(308);
	ДополнитьМассив(ОписаниеЗапроса.ДопустимыеКодыОтвета, ОшибкиФайлПеремещен);
	
	Пока Истина Цикл
		
		Ответ = ВыполнитьHTTPЗапрос(ОписаниеЗапроса);
		ОбработатьОшибкуHTTP(Ответ, ОписаниеЗапроса);
		
		Если Не МассивСодержитЗначение(ОшибкиФайлПеремещен, Ответ.КодОтвета) Тогда
			Прервать;
		КонецЕсли;
		
		НовыйАдрес = Ответ.Заголовки["location"];
		
		Если Найти(НовыйАдрес, "://") Тогда
			СтруктураURI = СтруктураURI(НовыйАдрес);
			ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, СтруктураURI);
		Иначе
			ОписаниеЗапроса.ПутьНаСервере = НовыйАдрес;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Ответ.ТелоОтвета;
	
	Возврат Результат;
	
КонецФункции

// #Область API_Портала

// Получает ключ зашифрованный открытой частью сертификата
//
// Параметры:
//  ФайлСертификата - ДвоичныеДанные - файл сертификата в формате DER
// 
// Возвращаемое значение:
//  ДвоичныеДанные - зашифрованный ключ
//
Функция СервисАвторизации_ЗапроситьАвторизацию(ФайлСертификата) Экспорт
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисАвторизации_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/authentication/certificate";
	Запрос.ТелоЗапроса = Контент_ЗапроситьАвторизацию(ФайлСертификата);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Контент = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	Результат = Base64Значение(Контент.encrypted_key);
	
	Возврат Результат;
	
КонецФункции

// Получает новый токен авторизации отдавая расшифрованную часть ключа
//
// Параметры:
//  Контент - Строка - тело запроса;
// 
// Возвращаемое значение:
//  Структура - см. Новый_РезультатЗапросаHTTP(), в поле Результат:
//   * expires_in - срок действия токена;
//   * access_token - токен доступа;
//   * refresh_token - токен продления;
//
Функция СервисАвторизации_ПолучитьТокен(Контент)
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисАвторизации_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/connect/token";
	Запрос.ТелоЗапроса = Контент;
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	Результат = Новый_РезультатЗапросаHTTP();
	ОбработатьОшибкуHTTP(Ответ, Запрос, Результат);
	
	Если Результат.Успешно Тогда
		Результат.Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Отправляет метрики в сервис без проверки результата
//
// Параметры:
//  Топик - Строка - см. Перечисление_ТопикиМетрики();
//  ПакетСобытий - Массив - содержит Новый_СобытиеМетрики();
//
Процедура Портал_ОтправитьМетрики(Топик, ПакетСобытий)
	
	Если Топик = Перечисление_ТопикиМетрики().Здоровье Тогда
		ТестовоеОкружение = Ложь;
	Иначе
		ТестовоеОкружение = НастройкиМодуля().ТестовоеОкружение;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Портал_ЗаполнитьОбщиеНастройкиHTTPДляМетрик(Запрос, ТестовоеОкружение);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/metrika-pipe/v1/sources/1CModule/topics/{topic}/events";
	Запрос.Параметры.Вставить("topic", Топик);
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(ПакетСобытий);
	
	ВыполнитьHTTPЗапрос(Запрос);
	
КонецПроцедуры

// Заполняет в описании запроса HTTP параметры сервиса и настройки прокси
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP();
//  ТестовоеОкружение - Булево - Истина, если необходимо использовать тестовое окружение;
//
Процедура Портал_ЗаполнитьОбщиеНастройкиHTTPДляМетрик(ОписаниеЗапроса, ТестовоеОкружение)
	
	Если ТестовоеОкружение Тогда
		ОписаниеСервиса = СтруктураURI(ИнтернетАдреса().СервисПорталТестовый);
	Иначе
		ОписаниеСервиса = СтруктураURI(ИнтернетАдреса().СервисПортал);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, ОписаниеСервиса);
	ОписаниеЗапроса.ОтправитьОшибкуЧасовому = Ложь;
	
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
КонецПроцедуры

// Заполняет в описании запроса HTTP параметры сервиса и настройки прокси
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP();
//
Процедура СервисАвторизации_ЗаполнитьОбщиеНастройкиHTTP(ОписаниеЗапроса)
	
	Если НастройкиМодуля().ТестовоеОкружение Тогда
		ОписаниеСервиса = СтруктураURI(ИнтернетАдреса().СервисАвторизацииТестовый);
	Иначе
		ОписаниеСервиса = СтруктураURI(ИнтернетАдреса().СервисАвторизации);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, ОписаниеСервиса);
	ОписаниеЗапроса.ОтправитьОшибкуЧасовому = Ложь;
	
	ОписаниеЗапроса.Заголовки.Вставить("Accept", "application/json");
	ОписаниеЗапроса.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
КонецПроцедуры

// #КонецОбласти // API_Портала

// #Область API_Маркировки

// Проверяет связь с сервисом Контур.Маркировка,
// с помощью запроса о списке доступных организаций.
// Ожидает 401 код ответа
//
// Параметры:
//  НастройкиПрокси - Структура - см. НастройкиПроксиСервера()
// 
// Возвращаемое значение:
//  Булево - Истина, если связь с сервисом есть
//
Функция Маркировка_ПроверитьПодключение(НастройкиПрокси) Экспорт
	
	КэшСоединенийHTTP_Очистить();
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	ЗаполнитьЗначенияСвойств(Запрос.НастройкиПрокси, НастройкиПрокси);
	
	Запрос.ПутьНаСервере = "/api/v1/organizations";
	Запрос.ДопустимыеКодыОтвета.Добавить(КодОтвета_ОшибкаАвторизации());
	Запрос.ОтправитьОшибкуЧасовому = Ложь;
	
	Попытка
		Ответ = ВыполнитьHTTPЗапрос(Запрос);
		КэшСоединенийHTTP_Очистить();
		ОбработатьОшибкуHTTP(Ответ, Запрос);
		Результат = Истина;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция Маркировка_ПроверитьДоступ(Организация, Токен)
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.ПутьНаСервере = "/api/v1/organizations";
	Запрос.Заголовки.Вставить("Authorization", ТипАвторизации() + " " + Токен);
	Запрос.ОтправитьОшибкуЧасовому = Ложь;
	
	Запрос.ДопустимыеКодыОтвета.Добавить(КодОтвета_ОшибкаАвторизации());
	Запрос.ДопустимыеКодыОтвета.Добавить(КодОтвета_ОшибкаДоступЗапрещен());
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Если Ответ.КодОтвета <> КодОтвета_Успешно() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДоступныеОрганизации = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	
	Отбор = Новый Структура("inn", Организация.ИНН);
	ОрганизацияВСервисе = МассивСтруктур_НайтиСтроку(ДоступныеОрганизации, Отбор);
	
	Возврат ЗначениеЗаполнено(ОрганизацияВСервисе);
	
КонецФункции

Функция Маркировка_ПериодДействияАвторизацииГИС(Организация)
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	Запрос.ПутьНаСервере = "/api/v1/authorization/state";
	Запрос.Параметры.Вставить("inn", Организация.ИНН);
	Запрос.ОтправитьОшибкуЧасовому = Ложь;
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Контент = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	Результат = Маркировка_ПериодДействияПоСтатусуАвторизации(Контент);
	
	Возврат Результат;
	
КонецФункции

Функция Маркировка_ПродлитьАвторизациюГИС(Организация, Сертификат, ПодписанныеФайлы)
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация, Сертификат);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/api/v1/authorization";
	Запрос.Параметры.Вставить("inn", Организация.ИНН);
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(Новый Структура("signedContents", ПодписанныеФайлы));
	Запрос.ОтправитьОшибкуЧасовому = Ложь;
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Контент = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	Результат = Маркировка_ПериодДействияПоСтатусуАвторизации(Контент.actualStates);
	
	Возврат Результат;
	
КонецФункции

Функция Маркировка_ПериодДействияПоСтатусуАвторизации(Контент)
	
	Результат = '00010101';
	
	profiles = СвойствоСтруктуры(Контент, "profiles");
	Если Не ЗначениеЗаполнено(profiles) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Индекс = 0 По profiles.ВГраница() Цикл
		
		profile = profiles[Индекс];
		tokenTtl = СвойствоСтруктуры(profile, "tokenTtl");
		ПериодДействия = '00010101';
		
		Если ЗначениеЗаполнено(tokenTtl) Тогда
			ПериодДействия = УниверсальноеВремя(ДатаИзСтрокиXML(tokenTtl));
		КонецЕсли;
		
		Если Индекс = 0 Тогда
			Результат = ПериодДействия;
		Иначе
			Результат = Мин(Результат, ПериодДействия);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Информация о кодах маркировки
//
Функция Маркировка_СтатусыКодов(КодыМаркировки, Организация, ВидПродукции = Неопределено) Экспорт
	
	Результат = Мок_Маркировка_СтатусыКодов(КодыМаркировки, Организация, ВидПродукции);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/api/v2/cises/info";
	
	ОшибкаНетДоговора = 424;
	Запрос.ДопустимыеКодыОтвета.Добавить(ОшибкаНетДоговора);
	
	МассивКодов = ЗначениеВМассиве(КодыМаркировки);
	ВсегоКодов = МассивКодов.Количество();
	Результат = Новый Массив;
	
	РезультатОтвета = Новый_РезультатЗапросаHTTP();
	
	НачалоПорции = 1;
	РазмерПорции = 5000;
	КоличествоПопыток = 5;
	ДельтаНаПопытку = РазмерПорции / КоличествоПопыток;
	
	Для НомерПопытки = 1 По КоличествоПопыток Цикл
		
		ПорцияКодов = Новый Массив;
		ОбработаныВсеКоды = Ложь;
		ОшибкаСвязиССервисом = Ложь;
		
		Для Сч = НачалоПорции По ВсегоКодов Цикл
			
			ПорцияКодов.Добавить(МассивКодов[Сч - 1]);
			
			ПорцияЗаполнена = (Сч % РазмерПорции = 0);
			ОбработаныВсеКоды = (Сч = ВсегоКодов);
			
			Если ПорцияЗаполнена Или ОбработаныВсеКоды Тогда
				
				СтруктураЗапроса = Новый Структура;
				СтруктураЗапроса.Вставить("inn", Организация.ИНН);
				СтруктураЗапроса.Вставить("cises", ПорцияКодов);
				СтруктураЗапроса.Вставить("normalizeAggregates", Ложь);
				Если ЗначениеЗаполнено(ВидПродукции) Тогда
					СтруктураЗапроса.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
				КонецЕсли;
				
				Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(СтруктураЗапроса);
				
				Ответ = ВыполнитьHTTPЗапрос(Запрос);
				ОбработатьОшибкуHTTP(Ответ, Запрос, РезультатОтвета);
				
				Если Не РезультатОтвета.Успешно Тогда
					
					ОшибкаСвязиССервисом = Истина;
					Прервать;
					
				ИначеЕсли Ответ.КодОтвета = ОшибкаНетДоговора Тогда
					
					Прервать;
					
				Иначе
					
					ОтветИзСервиса = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета, Истина);
					Для каждого текКод из ПорцияКодов Цикл
						Результат.Добавить(ОтветИзСервиса[текКод]);
					КонецЦикла;
					
					НачалоПорции = Сч + 1;
					ПорцияКодов.Очистить();
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		Если ОшибкаСвязиССервисом И Не ОбработаныВсеКоды Тогда
			// Попробуем уменьшить размер порции
			РазмерПорции = РазмерПорции - ДельтаНаПопытку;
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		РазницаИсходныхИПолученныхКодов = МассивКодов.Количество() - Результат.Количество();
		Для Сч = 1 По РазницаИсходныхИПолученныхКодов Цикл
			Результат.Добавить(Неопределено);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет в описании запроса HTTP параметры сервиса и настройки прокси
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP()
//
Процедура Маркировка_ЗаполнитьОбщиеНастройкиHTTP(ОписаниеЗапроса) Экспорт
	
	ОписаниеСервиса = Маркировка_ОписаниеСервиса();
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, ОписаниеСервиса);
	
	ОписаниеЗапроса.Заголовки.Вставить("Accept", "application/json");
	ОписаниеЗапроса.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
КонецПроцедуры

// Добавляет идентификатор сессии в заголовки http запроса
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP();
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//  Сертификат - СправочникСсылка.КонтурМаркировка_Сертификаты - сертификат;
//  ВызыватьИсключение - Булево - Ложь, если нужно отключить ошибку получения токена;
// 
// Возвращаемое значение:
//  Булево - Истина, если токен удалось добавить
//
Функция Маркировка_ДобавитьТокен(ОписаниеЗапроса, Организация, Знач Сертификат = Неопределено, ВызыватьИсключение = Истина) Экспорт
	
	Если Сертификат = Неопределено Тогда
		Сертификат = НастройкаПодписания_ПодобратьСертификат(Организация);
	КонецЕсли;
	
	Токен = ПортальныйТокен_Прочитать(Сертификат);
	
	Если Не ЗначениеЗаполнено(Токен) И Не НастройкиМодуля().РежимТестирования И ВызыватьИсключение Тогда
		ТекстОшибки = НСтр("ru = 'Отсутствует портальный идентификатор безопасности: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Организация);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Токен) Тогда
		ОписаниеЗапроса.Заголовки.Вставить("Authorization", ТипАвторизации() + " " + Токен);
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Токен);
	
КонецФункции

Функция Маркировка_ОписаниеСервиса()
	
	Адреса = ИнтернетАдреса();
	Настройки = НастройкиМодуля();
	Если Настройки.ТестовоеОкружение Тогда
		Если ЗначениеЗаполнено(Настройки.АдресТестовогоСервиса) Тогда
			АдресСервиса = Настройки.АдресТестовогоСервиса;
		Иначе
			АдресСервиса = Адреса.СервисКонтурМаркировкаТестовый;
		КонецЕсли;
	Иначе
		АдресСервиса = Адреса.СервисКонтурМаркировка
	КонецЕсли;
	
	Результат = СтруктураURI(АдресСервиса);
	
	Возврат Результат;
	
КонецФункции

Функция Маркировка_ПодпискиОрганизацииПоИНН(Организация)
	
	Результат = Мок_ПодпискиОрганизации(Организация);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Если Не Маркировка_ДобавитьТокен(Запрос, Организация, , Ложь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.ПутьНаСервере = "/api/v1/organizations/subscriptions-by-inn/{inn}";
	Запрос.Параметры.Вставить("inn", Организация.ИНН);
	Запрос.ОтправитьОшибкуЧасовому = Ложь;
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

Функция Маркировка_ФайлыАвторизацииГИС(Организация, Сертификат) Экспорт
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация, Сертификат);
	
	Запрос.ПутьНаСервере = "/api/v1/authorization/requirements";
	Запрос.Параметры.Вставить("inn", Организация.ИНН);
	Запрос.ОтправитьОшибкуЧасовому = Ложь;
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ОбработатьОшибкуHTTP(Ответ, Запрос);
	
	СтруктураОтвета = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	
	Если ЗначениеЗаполнено(СтруктураОтвета) Тогда
		Результат = СтруктураОтвета.contentsToSign;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Маркировка_ЗаказКодов_Создать(ОписаниеЗадачи, СтруктураКонтента)
	
	Организация = ОписаниеЗадачи.Организация;
	ИдентификаторСклада = ОписаниеЗадачи.Склад.Идентификатор;
	
	Результат = Новый_РезультатЗапросаHTTP();
	Запрос = Новый_ОписаниеЗапросаHTTP();
	
	Ответ_Мок = Мок_ЗаказКодов_Создать(Организация, ИдентификаторСклада, СтруктураКонтента);
	Если Не Ответ_Мок = Неопределено Тогда
		Результат.Результат = Ответ_Мок;
		Возврат Результат;
	КонецЕсли;
	
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/api/v1/codes/orders";
	Запрос.Параметры.Вставить("warehouseId", ИдентификаторСклада);
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(СтруктураКонтента);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ДобавитьВИсториюЗапросовВСервис(ОписаниеЗадачи, Запрос, Ответ);
	ОбработатьОшибкуHTTP(Ответ, Запрос, Результат);
	
	Если Результат.Успешно Тогда
		Результат.Результат = СократитьКавычки(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Маркировка_ЗаказКодов_ФайлыДляПодписи(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ИдентификаторЗаказа = ОписаниеЗадачи.ИдентификаторДокумента;
	
	Результат = Новый_РезультатЗапросаHTTP();
	
	Ответ_Мок = Мок_ЗаказКодов_ФайлыДляПодписи(Организация, ИдентификаторЗаказа);
	Если Не Ответ_Мок = Неопределено Тогда
		Результат.Результат = Ответ_Мок;
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	Маркировка_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	Маркировка_ДобавитьТокен(Запрос, Организация);
	
	Запрос.ПутьНаСервере = "/api/v1/codes/orders/{id}/contents";
	Запрос.Параметры.Вставить("id", ИдентификаторЗаказа);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	ДобавитьВИсториюЗапросовВСервис(ОписаниеЗадачи, Запрос, Ответ);
	ОбработатьОшибкуHTTP(Ответ, Запрос, Результат);
	
	Если Результат.Успешно Тогда
		Результат.Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Маркировка_ЗаказКодов_СтатусЗакрытия(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
