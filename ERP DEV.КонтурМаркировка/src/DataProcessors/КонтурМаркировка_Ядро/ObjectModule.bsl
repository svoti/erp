Функция ОднаСтрокаДокументаСодержитНесколькоТоваровМаркировки(ТоварыМаркировки)
	
	Результат = Ложь;
	ТоварыПоКлючам = Новый Соответствие;
	
	Для Каждого Стр Из ТоварыМаркировки Цикл
		
		Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Товар = ЗначениеСоответствия(ТоварыПоКлючам, Стр.КлючСтрокиДокумента, Стр.Товар);
		
		Если Стр.Товар <> Товар Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
		ТоварыПоКлючам.Вставить(Стр.КлючСтрокиДокумента, Товар);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьКоличествоВПолныйКод(Знач ПолныйКод, Количество, ИдентификаторПрименения) Экспорт
	
	РазделительGS = РазделительGS1();
	ОбщаяДлинаПоказателя = 10;
	
	Разделитель = "";
	Если Найти(ПолныйКод, РазделительGS) > 0 Тогда
		Разделитель = РазделительGS;
	КонецЕсли;
	
	ДлинаПоказателя = 6;
	ДлинаИдентификатора = СтрДлина(ИдентификаторПрименения);
	ИдентификаторСПоказателем = Прав(ПолныйКод, ДлинаИдентификатора + ДлинаПоказателя);
	
	Если Лев(ИдентификаторСПоказателем, ДлинаИдентификатора) = ИдентификаторПрименения Тогда
		// Код уже содержит количество, отрезаем его чтобы добавить новое
		ПолныйКод = Лев(ПолныйКод, СтрДлина(ПолныйКод) - ДлинаИдентификатора - ДлинаПоказателя);
		Если Прав(ПолныйКод, 1) = РазделительGS Тогда
			ПолныйКод = Лев(ПолныйКод, СтрДлина(ПолныйКод) - 1);
		КонецЕсли;
	КонецЕсли;
	
	СтрокаКоличество = Формат(Количество, "ЧЦ=6; ЧС=-3; ЧВН=; ЧГ=0");
	
	Возврат ПолныйКод + Разделитель + ИдентификаторПрименения + СтрокаКоличество;
	
КонецФункции

Функция КоличествоИзПолногоКода(ПолныйКод, ИдентификаторПрименения)
	
	Результат = 0;
	
	Если Не ЗначениеЗаполнено(ПолныйКод) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДлинаИдентификатора = 3;
	ДлинаПолногоИдентификатора = 4;
	ДлинаПоказателя = 6;
	ПозицииДесятичнойТочки = "012345";
	
	ИдентификаторСПоказателем = Прав(ПолныйКод, ДлинаПолногоИдентификатора + ДлинаПоказателя);
	
	Идентификатор = Лев(ИдентификаторСПоказателем, ДлинаИдентификатора);
	ПозицияТочки = Сред(ИдентификаторСПоказателем, ДлинаПолногоИдентификатора, 1);
	
	Если Идентификатор = ИдентификаторПрименения
		И Найти(ПозицииДесятичнойТочки, ПозицияТочки) > 0 Тогда
		Показатель = Прав(ИдентификаторСПоказателем, ДлинаПоказателя);
		ПолныйИдентификатор = Лев(ИдентификаторСПоказателем, ДлинаПолногоИдентификатора);
		Результат = ЗначениеЧисловогоПоказателяGS1(Показатель, ПолныйИдентификатор);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоМультитоварныйНабор(Товар, КэшРезультатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Товар) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[Товар];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИСТИНА КАК ЭтоМультитоварныйНабор
	|ИЗ
	|	Справочник.КонтурМаркировка_Товары.СоставНабора КАК Т
	|ГДЕ
	|	Т.Ссылка = &Товар
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.ВложенныйТовар.ВидПродукции) > 1");
	Запрос.УстановитьПараметр("Товар", Товар);
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(Товар, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #Область ПеременноеКоличествоВШтуках

Функция ПолныйКодСодержитПеременноеКоличество(ПолныйКод)
	
	Возврат ЗначениеЗаполнено(ПеременноеКоличествоИзПолногоКода(ПолныйКод));
	
КонецФункции

Функция ПеременноеКоличествоИзПолногоКода(Знач ПолныйКод)
	
	Результат = 0;
	
	РазделительGS = РазделительGS1();
	ИдентификаторПрименения = ИдентификаторПрименения_ПеременноеКоличество();
	ДлинаИдентификатора = СтрДлина(ИдентификаторПрименения);
	
	РазделительСИдентификатором = РазделительGS + ИдентификаторПрименения;
	
	МаксимальнаяДлинаПоказателя = 8;
	
	Поз = Найти(ПолныйКод, РазделительСИдентификатором);
	Если Поз > 0 Тогда
		
		ДлинаПолногоКода = СтрДлина(ПолныйКод);
		Показатель = Прав(ПолныйКод, ДлинаПолногоКода - Поз - ДлинаИдентификатора);
		ДлинаПоказателя = СтрДлина(Показатель);
		
		Если ДлинаПоказателя <= МаксимальнаяДлинаПоказателя
			И ВСтрокеТолькоЦифры(Показатель) Тогда
			
			Результат = Число(Показатель);
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьПеременноеКоличествоВПолныйКод(Знач ПолныйКод, Количество)
	
	РазделительGS = РазделительGS1();
	ИдентификаторПрименения = ИдентификаторПрименения_ПеременноеКоличество();
	ДлинаИдентификатора = СтрДлина(ИдентификаторПрименения);
	
	РазделительСИдентификатором = РазделительGS + ИдентификаторПрименения;
	
	МаксимальнаяДлинаПоказателя = 8;
	
	Поз = Найти(ПолныйКод, РазделительСИдентификатором);
	Если Поз > 0 Тогда
		
		ДлинаПолногоКода = СтрДлина(ПолныйКод);
		Показатель = Прав(ПолныйКод, ДлинаПолногоКода - Поз - ДлинаИдентификатора);
		ДлинаПоказателя = СтрДлина(Показатель);
		
		Если ДлинаПоказателя <= МаксимальнаяДлинаПоказателя
			И ВСтрокеТолькоЦифры(Показатель) Тогда
			
			// Код уже содержит количество, отрезаем его чтобы добавить новое
			ПолныйКод = Лев(ПолныйКод, ДлинаПолногоКода - ДлинаИдентификатора - ДлинаПоказателя);
			Если Прав(ПолныйКод, 1) = РазделительGS Тогда
				ПолныйКод = Лев(ПолныйКод, СтрДлина(ПолныйКод) - 1);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	СтрокаКоличество = Формат(Количество, "ЧГ=");
	
	Возврат ПолныйКод + РазделительGS + ИдентификаторПрименения + СтрокаКоличество;
	
КонецФункции

// #КонецОбласти ПеременноеКоличествоВШтуках

