// Возвращает массив с текстом ошибок
// 
// Возвращаемое значение:
//  Массив - массив с текстом ошибок
//
Функция БуферОшибок_Прочитать() Экспорт
	
	АдресБуфераОшибок = ПараметрыСессии_Прочитать(КлючПараметраБуферОшибок());
	
	Если ЗначениеЗаполнено(АдресБуфераОшибок) Тогда
		Результат = ПолучитьИзВременногоХранилища(АдресБуфераОшибок);
	Иначе
		Результат = Новый Массив;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет ошибку в буфер, содержит последние 20 ошибок
//
// Параметры:
//  ТекстОшибки - Строка - текст ошибки
//  ЗаполнитьДатуОшибки - Булево - признак необходимости заполнения даты ошибки.
//
Процедура БуферОшибок_Добавить(ТекстОшибки, ЗаполнитьДатуОшибки = Истина) Экспорт
	
	Если ЗаполнитьДатуОшибки Тогда
		СтрокиОшибки = Новый Массив;
		СтрокиОшибки.Добавить(ТекущаяДатаСеанса());
		СтрокиОшибки.Добавить(СокрЛП(ТекстОшибки));
		ТекстСДатой = СоединитьСтроку(СтрокиОшибки, Символы.ПС);
	Иначе
		ТекстСДатой = ТекстОшибки;
	КонецЕсли;
	
	БуферОшибок = БуферОшибок_Прочитать();
	БуферОшибок.Вставить(0, ТекстСДатой);
	
	МаксимальныйРазмерБуфера = 20;
	Если БуферОшибок.Количество() > МаксимальныйРазмерБуфера Тогда
		БуферОшибок.Удалить(БуферОшибок.ВГраница());
	КонецЕсли;
	
	КлючПараметра = КлючПараметраБуферОшибок();
	АдресБуфераОшибок = ПараметрыСессии_Прочитать(КлючПараметра);
	Если ЗначениеЗаполнено(АдресБуфераОшибок) Тогда
		Результат = ПоместитьВоВременноеХранилище(БуферОшибок, АдресБуфераОшибок);
	Иначе
		АдресБуфераОшибок = ПоместитьВоВременноеХранилище(БуферОшибок, Новый УникальныйИдентификатор);
		ПараметрыСессии_Поместить(КлючПараметра, АдресБуфераОшибок);
	КонецЕсли;
	
КонецПроцедуры

// Записывает буфер ошибок в сообщение пользователю
// Используется в фоновом задании
//
Процедура БуферОшибок_ЗаписатьВСообщение()
	
	БуферОшибок = БуферОшибок_Прочитать();
	Если Не ЗначениеЗаполнено(БуферОшибок) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеБуфера = Новый Структура;
	ОписаниеБуфера.Вставить("БуферОшибок", БуферОшибок);
	СообщитьПользователюЛок(ЗначениеВСтрокуJSON(ОписаниеБуфера));
	
КонецПроцедуры

Функция КлючПараметраБуферОшибок()
	
	Возврат "БуферОшибок";
	
КонецФункции

