// Считает в очереди обмена количество операций, которые нужно подписать
//  по доступным для пользователя организациям
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - (необязательный) организация;
//  ДокументыУчета - Массив, СправочникСсылка.КонтурМаркировка_ДокументыУчета - (необязательный) документы учета;
// 
// Возвращаемое значение:
//  Булево - Истина, если файлы есть
//
Функция ОчередьОбмена_ЕстьФайлыДляПодписи(Организация = Неопределено, ДокументыУчета = Неопределено) Экспорт
	
	ОрганизацииДляОбмена = Организация_ВсеОрганизацииДляОбмена(Организация);
	Если Не ЗначениеЗаполнено(ОрганизацииДляОбмена) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипыФайлов = Перечисление_ТипыФайлов();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ПодходящиеДействия = Новый Массив;
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ПодписатьФайл);
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ПодписатьФайлЗакрытияЗаказа);
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьФайлыДляПодписи
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Файлы КАК Файлы
	|		ПО ОчередьОбмена.Операция = Файлы.ВладелецФайла
	|			И (Файлы.ТипФайла = &КонтентДляПодписи)
	|			И (НЕ Файлы.ПодписанЭП)
	|ГДЕ
	|	ОчередьОбмена.Организация В(&ОрганизацииДляОбмена)
	|	И ОчередьОбмена.ТребуемоеДействие В(&ПодходящиеДействия)
	|	И &ДокументыУчета";
	
	Если ЗначениеЗаполнено(ДокументыУчета) Тогда
		Условие = "ОчередьОбмена.Операция.ДокументУчета В (&ДокументыУчета)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументыУчета", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументыУчета", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОрганизацииДляОбмена", ОрганизацииДляОбмена);
	Запрос.УстановитьПараметр("ПодходящиеДействия", ПодходящиеДействия);
	Запрос.УстановитьПараметр("КонтентДляПодписи", ТипыФайлов.КонтентДляПодписи);
	Запрос.УстановитьПараметр("ДокументыУчета", ЗначениеВМассиве(ДокументыУчета));
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Считает в очереди обмена количество операций, которые нужно подписать
//  по доступным для пользователя организациям
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - (необязательный) организация;
//  ДокументыУчета - Массив, СправочникСсылка.КонтурМаркировка_ДокументыУчета - (необязательный) документы учета;
// 
