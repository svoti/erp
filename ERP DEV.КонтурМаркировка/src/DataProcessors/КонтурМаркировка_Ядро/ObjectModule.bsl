// Записывает в доп справочник маркируемые товарные группы из массива и удаляет неиспользуемые
//
// Параметры:
//  ОписанияМаркируемыхТГ - Структура - см. Новый_МаркируемаяТоварнаяГруппа()
// 
Процедура МаркируемыеТоварныеГруппы_ПерезаписатьНастройки(ОписанияМаркируемыхТГ) Экспорт
	
	Для Каждого МаркируемаяТГ Из ОписанияМаркируемыхТГ Цикл
		МаркируемаяТоварнаяГруппа_Записать(МаркируемаяТГ);
	КонецЦикла;
	
	ВсеЭлементы = МаркируемыеТоварныеГруппы_ВсеЭлементы();
	
	Для Каждого Ссылка Из ВсеЭлементы Цикл
		Если Не ЗначениеЗаполнено(МассивСтруктур_Найти(ОписанияМаркируемыхТГ, Ссылка, "Ссылка")) Тогда
			ДопСправочник_Удалить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Читает из доп справочника маркируемую товарную группу
//
// Параметры:
//  МаркируемаяТГ - СправочникСсылка.КонтурМаркировка_ДопСправочники - Ссылка на доп. справочник 
// 
// Возвращаемое значение:
//  Структура - см. Новый_МаркируемаяТоварнаяГруппа()
//
Функция МаркируемаяТоварнаяГруппа_Прочитать(МаркируемаяТГ) Экспорт
	
	Результат = Новый_МаркируемаяТоварнаяГруппа();
	ДопСправочник = ДопСправочник_Прочитать(МаркируемаяТГ);
	
	ЗаполнитьПоляСтруктуры(Результат, ДопСправочник);
	ЗаполнитьПоляСтруктуры(Результат, ДопСправочник.ДопРеквизиты);
	
	Возврат Результат;
	
КонецФункции

// Записывает в доп справочник маркируемые товарные группы
//
// Параметры:
//  ОписаниеМаркируемойТГ - Структура - см. Новый_МаркируемаяТоварнаяГруппа()
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДопСправочники
//
Функция МаркируемаяТоварнаяГруппа_Записать(ОписаниеМаркируемойТГ)
	
	ИмяСправочника = Перечисление_ИменаДопСправочников().МаркируемыеТоварныеГруппы;
	
	ДанныеИБ = Новый_ЭлементДопСправочника(ИмяСправочника);
	ДанныеИБ.Ссылка = ОписаниеМаркируемойТГ.Ссылка;
	ДанныеИБ.Наименование = Строка(ОписаниеМаркируемойТГ.ВидПродукции);
	
	Для каждого Элемент Из ОписаниеМаркируемойТГ Цикл
		Если Элемент.Ключ <> "Ссылка" И Элемент.Ключ <> "Наименование" Тогда
			ДанныеИБ.ДопРеквизиты.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеМаркируемойТГ.Ссылка = ДопСправочник_Записать(ДанныеИБ);
	
	Кэш_Поместить("МаркируемаяТоварнаяГруппа_ПоВидуПродукции", Неопределено);
	
	Возврат ОписаниеМаркируемойТГ.Ссылка;
	
КонецФункции

