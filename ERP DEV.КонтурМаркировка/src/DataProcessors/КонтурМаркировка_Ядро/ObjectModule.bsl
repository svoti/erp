// Ищет в строке совпадения по шаблону с регулярными выражениями
//
// Параметры:
//  Строка - Строка - строка, в которой нужно найти совпадения;
//  Шаблон - Строка - шаблон с регулярными выражениями;
// 
// Возвращаемое значение:
//  Массив - содержит строки найденных совпадений
//
Функция Плагин_НайтиСовпаденияПоШаблону(Строка, Шаблон) Экспорт
	
	Попытка
		Результат = Модуль_Плагин().НайтиСовпаденияПоШаблону(Строка, Шаблон);
	Исключение
		Плагин_ОбработатьОшибку("НайтиСовпаденияПоШаблону", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Формирует картинки штрихкодов через Конутр.Плагин для 1С
//
// Параметры:
//  Штрихкоды - Массив - содержит значения штрихкодов;
//  ПараметрыКартинки - Структура - см. Плагин_ПараметрыКартинкиШтрихкода()
// 
// Возвращаемое значение:
//  Массив - содержит двоичные данные картинок штрихкодов, в том же порядке что и входящий массив штрихкодов
//
Функция Плагин_КартинкиШтрихкодов(Штрихкоды, ПараметрыКартинки) Экспорт
	
	Попытка
		Результат = Модуль_Плагин().КартинкиШтрихкодов(Штрихкоды, ПараметрыКартинки);
	Исключение
		Плагин_ОбработатьОшибку("КартинкиШтрихкодов", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Параметры для печати штрихкодов
//
// Параметры:
//  ТипШтрихкода - Перечисления.КонтурМаркировка_ТипыШтрихкодов - тип штрихкодов
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * ТипШтрихкода      - Перечисления.КонтурМаркировка_ТипыШтрихкодов - тип штрихкодов;
//   * ФорматИзображения - Строка - см. Перечисление_ФорматыИзображений();
//   * Ширина            - Число  - ширина картинки в пикселях;
//   * Высота            - Число  - высота картинки в пикселях;
//   * УголПоворота      - Число  - угол поворота картинки в градусах,
//                         допустимые значения: 0, 90, 180, 270;
//   * ДобавитьОтступ    - Булево - Истина, если нужно добавить отступ вокруг штрихкода;
//   * ОтображатьТекст   - Булево - Истина, если нужно добавить строку с кодом;
//
Функция Плагин_ПараметрыКартинкиШтрихкода(ТипШтрихкода) Экспорт
	
	Попытка
		Результат = Модуль_Плагин().ПараметрыКартинкиШтрихкода(ТипШтрихкода);
	Исключение
		Плагин_ОбработатьОшибку("ПараметрыКартинкиШтрихкода", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Получает список сертификатов установленных на компьютере
//
// Параметры:
// 
// Возвращаемое значение:
//  Массив - содержит структуры, см. Модуль_Плагин().Новый_ОписаниеСертификата()
//
Функция Плагин_СписокСертификатов() Экспорт
	
	Результат = Мок_Плагин_СписокСертификатов();
	Если Не Результат = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыПоиска = Плагин_ПараметрыПоискаСертификатов();
	ПараметрыПоиска.ЕстьЗакрытыйКлюч = Истина;
	
	Попытка
		Результат = Модуль_Плагин().СписокСертификатов(ПараметрыПоиска);
	Исключение
		Плагин_ОбработатьОшибку("СписокСертификатов", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Находит сертификат установленный на компьютере
//
// Параметры:
//  ОтпечатокСертификата - Строка - отпечаток сертификата;
// 
// Возвращаемое значение:
//  Структура - см. Модуль_Плагин().Новый_ОписаниеСертификата()
//
Функция Плагин_НайтиСертификат(ОтпечатокСертификата) Экспорт
	
	ПараметрыПоиска = Плагин_ПараметрыПоискаСертификатов();
	ПараметрыПоиска.Отпечаток = ОтпечатокСертификата;
	ПараметрыПоиска.ТолькоПервый = Истина;
	
	Попытка
		МассивСертификатов = Модуль_Плагин().СписокСертификатов(ПараметрыПоиска);
	Исключение
		Плагин_ОбработатьОшибку("СписокСертификатов", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивСертификатов) Тогда
		Результат = МассивСертификатов[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Подписывает данные указанным сертификатом
//
// Параметры:
//  Файлы - Массив - ДвоичныеДанные файлов или строки в формате base64, которые нужно подписать;
//  ОтпечатокСертификата - Строка - отпечаток сертификата, которым нужно подписать;
//  ПрисоединитьПодпись - Булево - Истина, если контент и подпись должны быть в одном файле;
//
// Возвращаемое значение:
//  Массив из ДвоичныеДанные - подписи, в том же порядке что и массив файлов
//  Массив из Строка - подписи, в том же порядке что и массив файлов (base64)
//
Функция Плагин_ПодписатьДанные(Файлы, ОтпечатокСертификата, ПрисоединитьПодпись = Ложь) Экспорт
	
	Результат = Мок_Плагин_ПодписатьДанные(Файлы, ОтпечатокСертификата, ПрисоединитьПодпись);
	Если Не Результат = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Результат = Модуль_Плагин().ПодписатьДанные(Файлы, ОтпечатокСертификата, ПрисоединитьПодпись);
	Исключение
		Плагин_ОбработатьОшибку("ПодписатьДанные", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Получает файл установленного на компьютере сертификата
//
// Параметры:
//  ОтпечатокСертификата - Строка - отпечаток сертификата
// 
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция Плагин_ФайлСертификата(ОтпечатокСертификата)
	
	Попытка
		Результат = Модуль_Плагин().ФайлСертификата(ОтпечатокСертификата);
	Исключение
		Плагин_ОбработатьОшибку("ФайлСертификата", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Выполняет расшифровку контента
//
// Параметры:
//  Контент - ДвоичныеДанные, Строка - файл или строка base64
// 
// Возвращаемое значение:
//  ДвоичныеДанные - расшифрованные данные
//
Функция Плагин_РасшифроватьКонтент(Контент)
	
	Попытка
		Результат = Модуль_Плагин().РасшифроватьКонтент(Контент);
	Исключение
		Плагин_ОбработатьОшибку("РасшифроватьКонтент", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Выполняет http запрос
//
// Параметры:
//  ОписаниеЗапроса - Структура - содержит поля:
//   * Метод        - Строка - метод запроса, например: "GET", "POST", "PATCH";
//   * Таймаут      - Число - время ожидания ответа в секундах;
//   * АдресРесурса - Строка - адрес ресурса, например: "https://marking-api.kontur.ru/api/v1/codes/orders";
//   * Заголовки    - Соответствие - (необязательный) заголовки запроса;
//   * ТелоЗапроса  - Строка - (необязательный) тело запроса;
//   * ТелоОтветаКакДвоичныеДанные - Булево - вернуть двоичные данные в теле ответа;
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * КодОтвета - Число - код ответа;
//   * Заголовки - Соответствие - заголовки ответа;
//   * ТелоОтвета - Строка - тело ответа;
//
// &НаКлиенте
Функция Плагин_ВыполнитьHTTPЗапрос(ОписаниеЗапроса) Экспорт
	
	Возврат Модуль_Плагин().ВыполнитьHTTPЗапрос(ОписаниеЗапроса);
	
КонецФункции

// Содержит описание параметров для поиска сертификатов на компьютере
