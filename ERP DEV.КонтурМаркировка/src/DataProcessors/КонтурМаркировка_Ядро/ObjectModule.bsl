Функция GTINИзКодаМаркировки(КодМаркировки, ВидПродукции = Неопределено) Экспорт
	
	ГруппыПримененияВСкобках = (Лев(КодМаркировки, 1) = "(");
	
	Если ГруппыПримененияВСкобках Тогда
		ГруппаGTIN = "(01)";
		ГруппаСерийныйНомер = "(21)";
	Иначе
		ГруппаGTIN = "01";
		ГруппаСерийныйНомер = "21";
	КонецЕсли;
	
	ДлинаGTIN = 14;
	ДлинаГруппыGTIN = СтрДлина(ГруппаGTIN);
	
	ДлинаГруппыСерийныйНомер = СтрДлина(ГруппаСерийныйНомер);
	НачалоГруппыСерийныйНомер = ДлинаГруппыGTIN + ДлинаGTIN + 1;
	НачалоСерийногоНомера = Сред(КодМаркировки, НачалоГруппыСерийныйНомер);
	
	ЕстьГруппаGTIN = (Лев(КодМаркировки, ДлинаГруппыGTIN) = ГруппаGTIN);
	ЕстьГруппаСерийныйНомер = (Лев(НачалоСерийногоНомера, ДлинаГруппыСерийныйНомер) = ГруппаСерийныйНомер);
	
	Результат = "";
	Если ЕстьГруппаGTIN И ЕстьГруппаСерийныйНомер Тогда
		НачалоGTIN = ДлинаГруппыGTIN + 1;
		Результат = Сред(КодМаркировки, НачалоGTIN, ДлинаGTIN);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат)
		И ЭтоНикотиносодержащаяПродукция(ВидПродукции) Тогда
		НачалоGTIN = 0;
		Результат = Сред(КодМаркировки, НачалоGTIN, ДлинаGTIN);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция проверяет корректность GTIN.
// GTIN допускает в формате GTIN-8, GTIN-12, GTIN-13, GTIN-14 c контрольным символом.
//
// Параметры:
//  GTIN - Строка- Текстовая строка с GTIN(c контрольным символом). Может содержать числа от 0 до 9.
// 
// Возвращаемое значение:
//   - Булево - Истина, если GTIN корректный
//
Функция ПроверитьКорректностьGTIN(GTIN) Экспорт
	
	Результат = Ложь;
	
	ДлинаGTIN = СтрДлина(GTIN);
	
	Если ВСтрокеТолькоЦифры(GTIN)
		И (ДлинаGTIN = 14
		Или ДлинаGTIN = 13
		Или ДлинаGTIN = 12
		Или ДлинаGTIN = 8) Тогда
		Результат = (РассчитатьКонтрольныйСимволGTIN(GTIN) = Прав(GTIN, 1));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Универсальная функция расчета контрольной цифры GTIN.
// GTIN допускает в формате GTIN-8, GTIN-12, GTIN-13, GTIN-14 c контрольным символом.
//
// Параметры:
//  GTIN - Текстовая строка с GTIN(c контрольным символом). Может содержать числа от 0 до 9.
// 
// Возвращаемое значение:
//   - Контрольный символ (число) рассчитанный по алгоритму для GTIN.
//
Функция РассчитатьКонтрольныйСимволGTIN(GTIN)
	
	Сумма = 0;
	ДлинаGTIN = СтрДлина(GTIN);
	Коэффициент = ?(ДлинаGTIN % 2 = 0, 3, 1);
	
	Для Сч = 1 По (ДлинаGTIN - 1) Цикл
		Сумма = Сумма + Коэффициент * (КодСимвола(GTIN, Сч) - 48);
		Коэффициент = 4 - Коэффициент;
	КонецЦикла;
	
	Сумма = (10 - Сумма % 10) % 10;
	Результат = Символ(Сумма + 48);
	
	Возврат Результат;
	
КонецФункции

// Заменяет разделитель группы GS (ASCII 29) на строку \u001d
//
