	Если ЗначениеЗаполнено(ВложенныеКоды) Тогда
		
		Результат = Новый_importFtsAggregateCode(СтрАгрегата, , РазрешительныйДокумент, КодТНВЭД, КодСтраныПроизводителя);
		
		children = Новый Массив;
		Для Каждого Стр Из ВложенныеКоды Цикл
			Если Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Комплект
				Или Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
				children.Добавить(Новый_importFtsAggregateCode(Стр, ИдентификаторВСД));
			Иначе
				children.Добавить(Контент_ВводВОборот_importFtsAggregateCode(Стр, ТаблицаКодов, ИдентификаторВСД, РазрешительныйДокумент, КодТНВЭД, КодСтраныПроизводителя));
			КонецЕсли;
		КонецЦикла;
		
		Результат.Вставить("children", children);
		
	Иначе
		
		Результат = Новый_importFtsAggregateCode(СтрАгрегата, ИдентификаторВСД);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контент_ВводВОборот_crossBorderAggregateCode(СтрАгрегата, ТаблицаКодов, ИдентификаторВСД, РазрешительныйДокумент, ВидПродукции)
	
	ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КодАгрегата", СтрАгрегата.КодМаркировки));
	
	Если ЗначениеЗаполнено(ВложенныеКоды) Тогда
		
		children = Новый Массив;
		Для Каждого Стр Из ВложенныеКоды Цикл
			Если Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Комплект
				Или Стр.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
				СтрАгрегата.Сумма = СтрАгрегата.Сумма + Стр.Цена;
				СтрАгрегата.СуммаНДС = СтрАгрегата.СуммаНДС + Стр.ЦенаНДС;
				СтрАгрегата.СуммаАкциза = СтрАгрегата.СуммаАкциза + Стр.ЦенаАкциза;
				children.Добавить(Новый_crossBorderAggregateCode(Стр, ВидПродукции, ИдентификаторВСД, РазрешительныйДокумент));
			Иначе
				children.Добавить(Контент_ВводВОборот_crossBorderAggregateCode(Стр, ТаблицаКодов, ИдентификаторВСД, РазрешительныйДокумент, ВидПродукции));
			КонецЕсли;
		КонецЦикла;
		
		Результат = Новый_crossBorderAggregateCode(СтрАгрегата, ВидПродукции);
		Результат.Вставить("children", children);
		
	Иначе
		
		Результат = Новый_crossBorderAggregateCode(СтрАгрегата, ВидПродукции, ИдентификаторВСД, РазрешительныйДокумент);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Контент_ВводВОборот_ЗаполнитьРД(Контент, РазрешительныйДокумент)
	
	Контент.Вставить("certificateDocument", ВидДокументаСертификацииВСервисе(РазрешительныйДокумент.ВидДокумента));
	ДобавитьЗаполненноеЗначениеВСтруктуру(Контент, "certificateDocumentDate", РазрешительныйДокумент.ДатаОформления);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Контент, "certificateDocumentNumber", РазрешительныйДокумент.Код);
	
КонецПроцедуры

Процедура Контент_ВводВОборот_ЗаполнитьЛицензиюНаНедра(Контент, НомерЛицензииНаНедра, ДатаЛицензииНаНедра)
	
	Если ЗначениеЗаполнено(НомерЛицензииНаНедра) И ЗначениеЗаполнено(ДатаЛицензииНаНедра) Тогда
		LicenseInfo = Новый Структура("number, Date", НомерЛицензииНаНедра, ДатаЛицензииНаНедра);
		Контент.Вставить("licenses", ЗначениеВМассиве(LicenseInfo));
	КонецЕсли;
	
КонецПроцедуры

Процедура Контент_ВводВОборот_ЗаполнитьНомераСкважин(Контент, НомераСкважин)
	
	Если ЗначениеЗаполнено(НомераСкважин) Тогда
		Контент.Вставить("wellNumbers", РазделитьСтроку(НомераСкважин));
	КонецЕсли;
	
КонецПроцедуры

Функция Новый_certificate(РазрешительныйДокумент)
	
	Результат = Новый Структура;
	Результат.Вставить("type", ВидДокументаСертификацииВСервисе(РазрешительныйДокумент.ВидДокумента));
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "number", РазрешительныйДокумент.Код);
	ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "date", РазрешительныйДокумент.ДатаОформления);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_certificateDocuments(СписокРазрешительныхДокументов)
	
	Результат = Новый Массив;
	Для Каждого Элемент Из СписокРазрешительныхДокументов Цикл
		certificate = Новый_certificate(Элемент.Значение);
		Если ВсеЗначенияСтруктурыЗаполнены(certificate) Тогда
			Результат.Добавить(certificate);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_aggregateCode(СтрКода, ИдентификаторВСД = Неопределено, РазрешительныйДокумент = Неопределено, НомераСкважин = "")
	
	Результат = Новый Структура;
	
	Если СтрКода.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
		Результат.Вставить("uitucode", СтрКода.КодМаркировки);
	Иначе
		Результат.Вставить("uitcode", СтрКода.КодМаркировки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторВСД)
		И ЗначениеЗаполнено(СтрКода.Товар)
		И СтрКода.Товар.ПодлежитВетеринарномуКонтролю Тогда
		Результат.Вставить("accompanyingDocument", ИдентификаторВСД);
	КонецЕсли;
	
	Если РазрешительныйДокумент <> Неопределено Тогда
		Контент_ВводВОборот_ЗаполнитьРД(Результат, РазрешительныйДокумент);
	КонецЕсли;
	
	Контент_ВводВОборот_ЗаполнитьНомераСкважин(Результат, НомераСкважин);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_importFtsAggregateCode(СтрКода
	, ИдентификаторВСД = Неопределено
	, РазрешительныйДокумент = Неопределено
	, КодТНВЭД = Неопределено
	, КодСтраныПроизводителя = Неопределено)
	
	Результат = Новый Структура;
	
	Результат.Вставить("code", СтрКода.КодМаркировки);
	
	Если ЗначениеЗаполнено(РазрешительныйДокумент) Тогда
		Контент_ВводВОборот_ЗаполнитьРД(Результат, РазрешительныйДокумент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодТНВЭД) Тогда
		Результат.Вставить("tnVed", КодТНВЭД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодСтраныПроизводителя) Тогда
		Результат.Вставить("productionCountryCode", СтрКода.КодСтраныПроизводителя);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторВСД)
		И ЗначениеЗаполнено(СтрКода.Товар)
		И СтрКода.Товар.ПодлежитВетеринарномуКонтролю Тогда
		Результат.Вставить("accompanyingDocument", ИдентификаторВСД);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_crossBorderAggregateCode(СтрКода, ВидПродукции
	, ИдентификаторВСД = Неопределено
	, РазрешительныйДокумент = Неопределено
	, ОписаниеЦены = Неопределено)
	
	Результат = Новый Структура;
	
	Если СтрКода.ОбщийТипУпаковки = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка Тогда
		Результат.Вставить("uitucode", СтрКода.КодМаркировки);
	Иначе
		Результат.Вставить("uitcode", СтрКода.КодМаркировки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РазрешительныйДокумент) Тогда
		Контент_ВводВОборот_ЗаполнитьРД(Результат, РазрешительныйДокумент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторВСД)
		И ЗначениеЗаполнено(СтрКода.Товар)
		И СтрКода.Товар.ПодлежитВетеринарномуКонтролю Тогда
		Результат.Вставить("accompanyingDocument", ИдентификаторВСД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрКода.Сумма) Тогда
		Результат.Вставить("cost", СтрКода.Сумма);
	Иначе
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "cost", СтрКода.Цена);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрКода.СуммаНДС) Тогда
		Результат.Вставить("vat", СтрКода.СуммаНДС);
	Иначе
		Если ЗначениеЗаполнено(СтрКода.ЦенаНДС) Или ВидПродукцииТребуетСуммуНДСПриВводеВОборот(ВидПродукции) Тогда
			Результат.Вставить("vat", СтрКода.ЦенаНДС);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрКода.СуммаАкциза) Тогда
		Результат.Вставить("excise", СтрКода.СуммаАкциза);
	Иначе
		ДобавитьЗаполненноеЗначениеВСтруктуру(Результат, "excise", СтрКода.ЦенаАкциза);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АртикулПоЗначениюИзСервиса(ЗначениеВСервисе)
	
	ТипыАртикулов = Перечисление_ТипыАртикуловВСервисе();
	
	Если СтрокаНачинаетсяС(ЗначениеВСервисе, ТипыАртикулов.МодельАртикул) Тогда
		ДлинаТипаАртикула = СтрДлина(ТипыАртикулов.МодельАртикул);
	ИначеЕсли СтрокаНачинаетсяС(ЗначениеВСервисе, ТипыАртикулов.Артикул) Тогда
		ДлинаТипаАртикула = СтрДлина(ТипыАртикулов.Артикул);
	ИначеЕсли СтрокаНачинаетсяС(ЗначениеВСервисе, ТипыАртикулов.Модель) Тогда
		ДлинаТипаАртикула = СтрДлина(ТипыАртикулов.Модель);
	Иначе
		ДлинаТипаАртикула = 0;
	КонецЕсли;
	
	Результат = Сред(ЗначениеВСервисе, ДлинаТипаАртикула + 1);
	
	Возврат СокрЛП(Результат);
	
КонецФункции

