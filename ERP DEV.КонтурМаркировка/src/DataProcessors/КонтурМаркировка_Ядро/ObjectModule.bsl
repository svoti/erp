// Оставляет в массиве только уникальные значения
//
// Параметры:
//  Массив - Массив - массив;
//  УдалитьПустыеЗначения - Булево - (необязательный) Истина, если нужно удалить пустые значения;
//
Процедура СвернутьМассивЛок(Массив, УдалитьПустыеЗначения = Ложь) Экспорт
	
	Результат = Новый Массив;
	
	ДополнитьМассив(Результат, Массив, Истина, Не УдалитьПустыеЗначения);
	
	Массив = Результат;
	
КонецПроцедуры

// Разбивает массив на части указанного размера,
// последняя часть может содержать меньше элементов
//
// Параметры:
//  Массив      - Массив - массив, который нужно разбить;
//  РазмерЧасти - Число  - максимальный размер одной части массива;
// 
// Возвращаемое значение:
//  Массив - содержит массивы с элементами исходного массива
//
Функция РазбитьМассив(Массив, РазмерЧасти) Экспорт
	
	Результат = Новый Массив;
	
	ТекущаяПорция = Новый Массив;
	ВсегоЭлементов = Массив.Количество();
	
	Для Сч = 1 По ВсегоЭлементов Цикл
		
		ТекущаяПорция.Добавить(Массив[Сч-1]);
		
		Если Сч % РазмерЧасти = 0 Или Сч = ВсегоЭлементов Тогда
			Результат.Добавить(ТекущаяПорция);
			ТекущаяПорция = Новый Массив;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет что все значения структуры заполнены
//
// Параметры:
//  Структура - Структура - структура, заполненность значений которой нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если все значения структуры заполнены
//
Функция ВсеЗначенияСтруктурыЗаполнены(Структура)
	
	Для Каждого Элемент Из Структура Цикл
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Добавляет в структуру значение, если оно заполнено
//
// Параметры:
//  Структура - Структура - структура, в которую необходимо вставить значение;
//  Ключ - Строка - ключ структуры для нового значения;
//  Значение - Произвольный - добавляемое значение;
//
Процедура ДобавитьЗаполненноеЗначениеВСтруктуру(Структура, Ключ, Значение)
	
	Если ЗначениеЗаполнено(Значение) И Значение <> Ложь Тогда
		Структура.Вставить(Ключ, Значение);
	КонецЕсли;
	
КонецПроцедуры

// Удаляет повторяющиеся элементы из массива структур
//
// Параметры:
//  МассивСтруктур   - Массив - массив содержит структуры;
//  УникальныеПоля   - Строка - поля, разделенные запятыми, набор которых должен быть уникальным в массиве;
//  ПоляСуммирования - Строка - (необязательный) поля, разделенные запятыми, которые нужно просуммировать;
//
Процедура МассивСтруктур_Свернуть(МассивСтруктур, УникальныеПоля, ПоляСуммирования = "")
	
	УникальныеЗначения = Новый Соответствие;
	МассивУникальныхПолей = РазделитьСтроку(УникальныеПоля);
	МассивПолейСуммирования = РазделитьСтроку(ПоляСуммирования);
	ВсегоУникальныхПолей = МассивУникальныхПолей.Количество();
	
	Для СчСтруктур = -МассивСтруктур.ВГраница() По 0 Цикл
		
		ТекСтруктура = МассивСтруктур[-СчСтруктур];
		УникальныйЭлемент = Неопределено;
		
		Для СчПолей = 1 По ВсегоУникальныхПолей Цикл
			
			ИмяПоля = МассивУникальныхПолей[СчПолей - 1];
			
			Значение = Неопределено;
			ТекСтруктура.Свойство(ИмяПоля, Значение);
			Если Значение = Неопределено Тогда
				Значение = Null; // Чтобы можно было записать в соответствие
			КонецЕсли;
			
			Если СчПолей = 1 Тогда
				ТекУникальныеЗначения = УникальныеЗначения;
			Иначе
				ТекУникальныеЗначения = УникальныйЭлемент;
			КонецЕсли;
			
			УникальныйЭлемент = ТекУникальныеЗначения[Значение];
			
			Если УникальныйЭлемент = Неопределено Тогда
				Если СчПолей = ВсегоУникальныхПолей Тогда
					УникальныйЭлемент = ТекСтруктура;
				Иначе
					УникальныйЭлемент = Новый Соответствие;
				КонецЕсли;
				ТекУникальныеЗначения.Вставить(Значение, УникальныйЭлемент);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТекСтруктура = УникальныйЭлемент Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ИмяПоля Из МассивПолейСуммирования Цикл
			УникальныйЭлемент[ИмяПоля] = УникальныйЭлемент[ИмяПоля] + ТекСтруктура[ИмяПоля];
		КонецЦикла;
		
		МассивСтруктур.Удалить(-СчСтруктур);
		
	КонецЦикла;
	
КонецПроцедуры

// Сортирует элементы массива структур по значению поля
//
// Параметры:
//  МассивСтруктур - Массив - массив содержит структуры;
//  ИмяПоля - Строка - поле, по значению которого нужно сортировать массив;
//  ПоВозрастанию - Булево - (необязательный) Ложь, если сортировать нужно по убыванию значения;
// 
// Возвращаемое значение:
//  Массив - сортированный массив структур
//
Функция МассивСтруктур_Сортировать(МассивСтруктур, ИмяПоля, ПоВозрастанию = Истина) Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение");
	Таблица.Колонки.Добавить("Элемент");
	
	Для каждого Элемент Из МассивСтруктур Цикл
		Стр = Таблица.Добавить();
		Стр.Значение = Элемент[ИмяПоля];
		Стр.Элемент = Элемент;
	КонецЦикла;
	
	Если ПоВозрастанию Тогда
		Направление = "Возр";
	Иначе
		Направление = "Убыв";
	КонецЕсли;
	
	Таблица.Индексы.Добавить("Значение");
	Таблица.Сортировать("Значение " + Направление, Новый СравнениеЗначений);
	
	Результат = Таблица.ВыгрузитьКолонку("Элемент");
	
	Возврат Результат;
	
КонецФункции

// Разбивает массив структур на части по значению поля
// и помещяет эти части в соответствие
//
// Параметры:
//  МассивСтруктур - Массив - массив содержит структуры;
//  ИмяПоля        - Строка - имя поля, по которому нужно разбить массив;
// 
// Возвращаемое значение:
//  Соответствие - содержит:
//   Ключ     - Произвольное - значение поля;
//   Значение - Массив       - часть массива, с указанным значением;
//
Функция МассивСтруктур_Разбить(МассивСтруктур, ИмяПоля)
	
	Результат = Новый Соответствие;
	
	Для каждого Элемент Из МассивСтруктур Цикл
		
		ЗначениеПоля = Элемент[ИмяПоля];
		ЧастьМассива = Результат[ЗначениеПоля];
		
		Если ЧастьМассива = Неопределено Тогда
			ЧастьМассива = Новый Массив;
			Результат.Вставить(ЗначениеПоля, ЧастьМассива);
		КонецЕсли;
		
		ЧастьМассива.Добавить(Элемент);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаВыбратьПервые(Количество) Экспорт
	
	Возврат ПараметрыВСтроку("ВЫБРАТЬ ПЕРВЫЕ %1", Формат(Количество, "ЧН=0; ЧГ=0"));
	
