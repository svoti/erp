Функция ЭтоФоновоеЗадание() Экспорт
	
	КлючКэш = "ЭтоФоновоеЗадание";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Ложь;
	ИмяПриложенияФоновоеЗадание = "BackgroundJob";
	Если ВерсияПлатформыНиже("8.3.7") Тогда
		
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		
		НомерСеанса = НомерСеансаИнформационнойБазы();
		Сеансы = ПолучитьСеансыИнформационнойБазы();
		Для Каждого Сеанс Из Сеансы Цикл
			Если Сеанс.НомерСеанса = НомерСеанса Тогда
				Результат = НРег(Сеанс.ИмяПриложения) = НРег(ИмяПриложенияФоновоеЗадание);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
	Иначе
		Выполнить("Результат = НРег(ПолучитьТекущийСеансИнформационнойБазы().ИмяПриложения) = НРег(ИмяПриложенияФоновоеЗадание)");
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции // ЭтоФоновоеЗадание()

// Записывает ошибку в журнал регистрации и сообщает пользователю
//
// Параметры:
//  Действие			 - Строка - действие, при котором возникла ошибка;
//  Ошибка				 - ИнформацияОбОшибке, Строка - описание ошибки;
//  ДопИнформация		 - Строка, Массив, СписокЗначений, Структура, Соответствие - доп информация;
//  ТекстСообщения		 - Строка - текст сообщения пользователю;
//  ИдентификаторФормы	 - УникальныйИдентификатор - см. СообщитьПользователюЛок();
//  ПолеФормы			 - Строка                  - см. СообщитьПользователюЛок();
//
Процедура ОбработатьОшибку(Действие, Ошибка
	, ДопИнформация		 = Неопределено
	, ТекстСообщения	 = Неопределено
	, ИдентификаторФормы = Неопределено
	, ПолеФормы			 = Неопределено
	, СсылкаНаОбъект	 = Неопределено) Экспорт
	
	Если ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке") Тогда
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
	Иначе
		ТекстОшибки = Ошибка;
	КонецЕсли;
	
	// Сообщение пользователю
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		СтрокиСообщения = Новый Массив;
		СтрокиСообщения.Добавить(ТекстСообщения);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			СтрокиСообщения.Добавить(НСтр("ru ='Подробности см. в журнале регистрации.'"));
		КонецЕсли;
		ОбщийТекстСообщения = СоединитьСтроку(СтрокиСообщения, Символы.ПС);
		СообщитьПользователюЛок(ОбщийТекстСообщения, ИдентификаторФормы, ПолеФормы);
	КонецЕсли;
	
	// Запись в журнал регистрации
	СтрокиОшибки = Новый Массив;
	СтрокиОшибки.Добавить(Действие);
	Если ЗначениеЗаполнено(ДопИнформация) Тогда
		СтрокиОшибки.Добавить(СтрокаДопИнформацииДляЖурналаРегистрации(ДопИнформация));
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		СтрокиОшибки.Добавить(ТекстОшибки);
	Иначе
		СтрокиОшибки.Добавить(ТекстСообщения);
	КонецЕсли;
	
	ОбщийТекстОшибки = СоединитьСтроку(СтрокиОшибки, Символы.ПС);
	
	БуферОшибок_Добавить(ОбщийТекстОшибки);
	
	ДобавитьОшибкуВЖурналРегистрации(ОбщийТекстОшибки, СсылкаНаОбъект);
	
КонецПроцедуры

// Формирует строку доп. информации для журнала регистрации
//
// Параметры:
//  ДопИнформация - Массив, Соответствие, Структура, Строка, Ссылка - доп. информация
// 
// Возвращаемое значение:
//  Строка - строка доп. информации
//
Функция СтрокаДопИнформацииДляЖурналаРегистрации(ДопИнформация)
	
	ТипДопИнформации = ТипЗнч(ДопИнформация);
	СтрокиДопИнформации = Новый Массив;
	ШаблонКлючЗначение = "%1: %2";
	
	Если ТипДопИнформации = Тип("Строка") Тогда
		
		СтрокиДопИнформации.Добавить(ДопИнформация);
		
	ИначеЕсли ЭтоМассив(ДопИнформация) Тогда
		
		Для каждого Элемент Из ДопИнформация Цикл
			СтрокиДопИнформации.Добавить(СокрЛП(Элемент));
		КонецЦикла;
		
	ИначеЕсли ТипДопИнформации = Тип("СписокЗначений") Тогда
		
		Для каждого Элемент Из ДопИнформация Цикл
			СтрокаКлючЗначение = ПараметрыВСтроку(ШаблонКлючЗначение, Элемент.Представление, Элемент.Значение);
			СтрокиДопИнформации.Добавить(СтрокаКлючЗначение);
		КонецЦикла;
		
	ИначеЕсли ЭтоСтруктура(ДопИнформация) Или ЭтоСоответствие(ДопИнформация) Тогда
		
		Для каждого Элемент Из ДопИнформация Цикл
			СтрокаКлючЗначение = ПараметрыВСтроку(ШаблонКлючЗначение, Элемент.Ключ, Элемент.Значение);
			СтрокиДопИнформации.Добавить(СтрокаКлючЗначение);
		КонецЦикла;
		
	ИначеЕсли ЭтоСсылка(ДопИнформация) Тогда
		
		СтрокиДопИнформации.Добавить(СокрЛП(ДопИнформация));
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Недопустимый тип доп. информации для записи в журнал регистрации: 1%'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТипДопИнформации);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Результат = СоединитьСтроку(СтрокиДопИнформации, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

// Добавляет запись с ошибкой в журнал регистрации
//
// Параметры:
//  ТекстОшибки - Строка - подробное описание ошибки, с номером строки кода и т.д.
//
Процедура ДобавитьОшибкуВЖурналРегистрации(Комментарий, СсылкаНаОбъект = Неопределено) Экспорт
	
	ЗаписьЖурналаРегистрации(СобытиеМаркировки(), УровеньЖурналаРегистрации.Ошибка, , СсылкаНаОбъект, Комментарий);
	
КонецПроцедуры

