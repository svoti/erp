Функция ОписаниеОперацииДляМетрики(ОписаниеОперации, ИдентификаторВСервисе = "")
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторВСервисе", ИдентификаторВСервисе);
	Результат.Вставить("ИдентификаторОперации", Строка(ОписаниеОперации.Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("ТипОперации", ОписаниеОперации.ТипОперации);
	Результат.Вставить("ВидПродукции", СокрЛП(ОписаниеОперации.ВидПродукции));
	Результат.Вставить("НомерОперации", ОписаниеОперации.Номер);
	Результат.Вставить("ДатаОперации", ОписаниеОперации.Дата);
	Результат.Вставить("ОсновнойСтатус", ОписаниеОперации.Статусы.ОсновнойСтатус);
	Результат.Вставить("ЕстьДокументУчета", ЗначениеЗаполнено(ОписаниеОперации.ДокументУчета));
	
	Результат.Вставить("ОбъемноСортовойУчет", ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет);
	Результат.Вставить("РезервироватьПартии", ОписаниеОперации.ДопРеквизиты.РезервироватьПартии);
	Результат.Вставить("ЕстьНомерПартии", ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.НомерПартии));
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДокументУчета) Тогда
		Результат.Вставить("ТипДокумента", ЗначениеРеквизитаОбъектаЛок(ОписаниеОперации.ДокументУчета, "ТипДокумента"));
		Результат.Вставить("ИдентификаторДокумента", Строка(ОписаниеОперации.ДокументУчета.УникальныйИдентификатор()));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.Склад) Тогда
		Результат.Вставить("НаименованиеСклада", СокрЛП(ОписаниеОперации.Склад));
		Результат.Вставить("ИдентификаторСклада", ОписаниеОперации.Склад.Идентификатор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ОперацияОснование)
		И ЗначениеЗаполнено(ОписаниеОперации.КлючСтрокиОперацииОснования) Тогда
		Операция = ОписаниеОперации.ОперацияОснование;
		КлючСтроки = ОписаниеОперации.КлючСтрокиОперацииОснования;
		Результат.Вставить("КоличествоТоваров", 1);
		Результат.Вставить("КоличествоКодов", КодыОпераций_ОбщееКоличествоКодов(Операция, КлючСтроки));
		Результат.Вставить("ЕстьМультитоварныеНаборы", Операция_ЕстьМультитоварныеНаборы(Операция, КлючСтроки));
		Результат.Вставить("ЕстьМультитоварныеАгрегаты", КодыОпераций_ЕстьМультитоварныеАгрегаты(Операция, КлючСтроки));
		Результат.Вставить("ИдентификаторОперацииОснования", Строка(ОписаниеОперации.ОперацияОснование.УникальныйИдентификатор()));
	Иначе
		Операция = ОписаниеОперации.Ссылка;
		Результат.Вставить("КоличествоТоваров", ОписаниеОперации.Товары.Количество());
		Результат.Вставить("КоличествоКодов", КодыОпераций_ОбщееКоличествоКодов(Операция));
		Результат.Вставить("ЕстьМультитоварныеНаборы", Операция_ЕстьМультитоварныеНаборы(Операция));
		Результат.Вставить("ЕстьМультитоварныеАгрегаты", КодыОпераций_ЕстьМультитоварныеАгрегаты(Операция));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ИсточникСоздания) Тогда
		Результат.Вставить("ИсточникСоздания", ОписаниеОперации.ДопРеквизиты.ИсточникСоздания);
	КонецЕсли;
	
	ДополнитьОписаниеДляМетрики_ЗаказКодов(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_ОтчетОНанесении(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_ОтчетОВыбытии(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_ВводВОборот(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_ВыводИзОборота(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_ВозвратВОборот(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_ОтменаВыводаИзОборота(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_ПодборКодовНаТСД(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_НаполнениеАгрегатовНаТСД(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_Перемаркировка(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_УведомлениеОПриемке(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_ПечатьКодов(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_КорректировкаСведенийОКодах(Результат, ОписаниеОперации, ТипыОпераций);
	ДополнитьОписаниеДляМетрики_УведомлениеОСостоянииКодов(Результат, ОписаниеОперации, ТипыОпераций);
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьОписаниеДляМетрики_ЗаказКодов(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ЗаказКодов Тогда
		Возврат;
	КонецЕсли;
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	ОписаниеДляМетрики.Вставить("ТипЗаказа", ДопРеквизиты.ТипЗаказаКодов);
	ОписаниеДляМетрики.Вставить("ТипОплатыКодов", ДопРеквизиты.ТипОплатыКодов);
	ОписаниеДляМетрики.Вставить("СервисПровайдер", ДопРеквизиты.СервисПровайдер);
	ОписаниеДляМетрики.Вставить("ТипКодаМаркировки", ДопРеквизиты.ТипКодаМаркировки);
	ОписаниеДляМетрики.Вставить("СпособВыпускаТоваров", ДопРеквизиты.СпособВыпускаТоваров);
	ОписаниеДляМетрики.Вставить("КоличествоКодов", ОписаниеОперации.Товары.Итог("КоличествоУпаковок"));
	
	Если ДопРеквизиты.ФорматКодов = Перечисление_ФорматыКодов().Укороченный Тогда
		ОписаниеДляМетрики.Вставить("КороткийФорматКодов", Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_ОтчетОНанесении(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	Если ТипОперации <> ТипыОпераций.ОтчетОНанесении
		И ТипОперации <> ТипыОпераций.ОтчетОНанесенииНаТСД
		И ТипОперации <> ТипыОпераций.РегистрацияСтрокиОтчетаОНанесении Тогда
		Возврат;
	КонецЕсли;
	
	ТекОписание = ОписаниеОперации;
	КлючСтрокиОперации = Неопределено;
	Если ТипОперации = ТипыОпераций.РегистрацияСтрокиОтчетаОНанесении Тогда
		ТекОписание = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
		КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	КонецЕсли;
	
	Операция = ТекОписание.Ссылка;
	ДопРеквизиты = ТекОписание.ДопРеквизиты;
	
	ОписаниеДляМетрики.Вставить("ТипОтчета", ДопРеквизиты.ТипОтчетаОНанесении);
	ОписаниеДляМетрики.Вставить("ТипИспользования", ДопРеквизиты.ТипИспользования);
	ОписаниеДляМетрики.Вставить("ТипСрокаГодности", ДопРеквизиты.ТипСрокаГодности);
	ОписаниеДляМетрики.Вставить("ДатаПроизводства", ДопРеквизиты.ДатаПроизводства);
	ОписаниеДляМетрики.Вставить("ЕстьНомерСерии", ЗначениеЗаполнено(ДопРеквизиты.НомерСерии));
	ОписаниеДляМетрики.Вставить("ИспользоватьНоминальноеКоличество", ДопРеквизиты.ИспользоватьНоминальноеКоличество);
	
	Если ЗначениеЗаполнено(ДопРеквизиты.Площадка) Тогда
		Если ДопРеквизиты.Площадка.ТипПлощадки = Перечисления.КонтурМаркировка_ТипыПлощадок.МОД Тогда
			ОписаниеДляМетрики.Вставить("ЕстьМОД", Истина);
		КонецЕсли;
		Если ДопРеквизиты.Площадка.ТипПлощадки = Перечисления.КонтурМаркировка_ТипыПлощадок.ПроизводственнаяПлощадка Тогда
			ОписаниеДляМетрики.Вставить("ЕстьПроизводственнаяПлощадка", Истина);
		КонецЕсли;
	КонецЕсли;
	
	КоличествоЗСН = КодыОпераций_КоличествоЗаводскихСерийныхНомеров(Операция, КлючСтрокиОперации).Итог("КоличествоЗСН");
	ОписаниеДляМетрики.Вставить("КоличествоЗаводскихСН", КоличествоЗСН);
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_ОтчетОВыбытии(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ОтчетОВыбытии
		И ОписаниеОперации.ТипОперации <> ТипыОпераций.ОтчетОВыбытииНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДляМетрики.Вставить("ПричинаВыбытияКодов", ОписаниеОперации.ДопРеквизиты.ПричинаВыбытияКодов);
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_ВводВОборот(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	Если ТипОперации <> ТипыОпераций.ВводВОборот
		И ТипОперации <> ТипыОпераций.РегистрацияСтрокиВводаВОборот Тогда
		Возврат;
	КонецЕсли;
	
	КлючСтрокиОперации = Неопределено;
	ТекОписание = ОписаниеОперации;
	Товары = ОписаниеОперации.Товары;
	
	Если ТипОперации = ТипыОпераций.РегистрацияСтрокиВводаВОборот Тогда
		ТекОписание = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
		КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
		Товары = ТекОписание.Товары.НайтиСтроки(Новый Структура("КлючСтрокиОперации", КлючСтрокиОперации));
	КонецЕсли;
	
	Операция = ТекОписание.Ссылка;
	ДопРеквизиты = ТекОписание.ДопРеквизиты;
	
	ОписаниеДляМетрики.Вставить("СпособВводаВОборот", ДопРеквизиты.СпособВводаВОборот);
	ОписаниеДляМетрики.Вставить("ДатаПроизводства", ДопРеквизиты.ДатаПроизводства);
	ОписаниеДляМетрики.Вставить("КодСтраныЭкспортера", ДопРеквизиты.КодСтраныЭкспортера);
	ОписаниеДляМетрики.Вставить("ТипПроизводственногоЗаказа", ДопРеквизиты.ТипПроизводственногоЗаказа);
	ОписаниеДляМетрики.Вставить("КоличествоКодовАТК", КодыОпераций_ОбщееКоличествоКодовАТК(Операция, КлючСтрокиОперации));
	
	Если ДопРеквизиты.СпособВводаВОборот = Перечисление_СпособыВводаВОборот().ИмпортФТС
		И ВидПродукцииТребуетРазрешительныйДокумент(ТекОписание.ВидПродукции) Тогда
		Для Каждого Стр Из Товары Цикл
			Если Не ЗначениеЗаполнено(Стр.РазрешительныйДокумент)
				И Товар_ОтсутствуютТребованияРД(Стр.Товар) Тогда
				ОписаниеДляМетрики.Вставить("ТребованияРДОтсутствуют", Истина);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ДопРеквизиты.СпособВводаВОборот = Перечисление_СпособыВводаВОборот().ИмпортФТС Тогда
		ОписаниеДляМетрики.Вставить("ЕстьТоварыЗакрытогоСегмента", ДопРеквизиты.ТоварыЗакрытогоСегмента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_ВыводИзОборота(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ВыводИзОборота Тогда
		Возврат;
	КонецЕсли;
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	ОписаниеДляМетрики.Вставить("КодСтраныПолучателя", ДопРеквизиты.КодСтраныПолучателя);
	ОписаниеДляМетрики.Вставить("ПричинаВыводаИзОборота", ДопРеквизиты.ПричинаВыводаИзОборота);
	ОписаниеДляМетрики.Вставить("НаименованиеПричиныВыводаИзОборота", ДопРеквизиты.НаименованиеПричиныВыводаИзОборота);
	
	ЕстьНомерПартии = ВыводИзОборота_ЕстьНомерПартии(ОписаниеОперации);
	Если ЕстьНомерПартии Тогда
		ОписаниеДляМетрики.Вставить("ЕстьНомерПартии", ЕстьНомерПартии);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_ОтменаВыводаИзОборота(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ОтменаВыводаИзОборота Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДляМетрики.Вставить("ПричинаВыводаИзОборота", ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота);
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_ВозвратВОборот(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ВозвратВОборот
		И ОписаниеОперации.ТипОперации <> ТипыОпераций.ВозвратВОборотНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДляМетрики.Вставить("ПричинаВозвратаВОборот", ОписаниеОперации.ДопРеквизиты.ПричинаВозвратаВОборот);
	
	Если ВидПродукцииТребуетРазрешительныйДокумент(ОписаниеОперации.ВидПродукции) Тогда
		Для Каждого Стр Из ОписаниеОперации.Товары Цикл
			Если Не ЗначениеЗаполнено(Стр.РазрешительныйДокумент)
				И Товар_ОтсутствуютТребованияРД(Стр.Товар) Тогда
				ОписаниеДляМетрики.Вставить("ТребованияРДОтсутствуют", Истина);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_ПодборКодовНаТСД(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	Если ТипОперации <> ТипыОпераций.ПодборКодовНаТСД
		И ТипОперации <> ТипыОпераций.ПодборТоваровИКодовНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	ОписаниеДляМетрики.Вставить("ЗаполненАдрес", ЗначениеЗаполнено(ДопРеквизиты.АдресДоставки));
	ОписаниеДляМетрики.Вставить("ЗаполненТелефон", ЗначениеЗаполнено(ДопРеквизиты.КонтактныйТелефон));
	ОписаниеДляМетрики.Вставить("ЕстьМобильноеУстройство", ЗначениеЗаполнено(ДопРеквизиты.МобильноеУстройство));
	ОписаниеДляМетрики.Вставить("ОтражениеВЭДО", ДопРеквизиты.ОтражениеВЭДО);
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_НаполнениеАгрегатовНаТСД(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.НаполнениеАгрегатовНаТСД
		И ОписаниеОперации.ТипОперации <> ТипыОпераций.НаполнениеОдногоАгрегатаНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	ПолучатьПолные = ОписаниеОперации.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
	ОписаниеДляМетрики.Вставить("ПолучатьПолныеКодыДляОтчетаОНанесении", ПолучатьПолные);
	
	НаполнитьАгрегатыВОдномЗадании = ОписаниеОперации.ДопРеквизиты.НаполнитьАгрегатыВОдномЗадании;
	ОписаниеДляМетрики.Вставить("НаполнитьАгрегатыВОдномЗадании", НаполнитьАгрегатыВОдномЗадании);
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_Перемаркировка(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	Если ТипОперации <> ТипыОпераций.Перемаркировка
		И ТипОперации <> ТипыОпераций.РегистрацияСтрокиПеремаркировки Тогда
		Возврат;
	КонецЕсли;
	
	ТекОписание = ОписаниеОперации;
	Если ТипОперации = ТипыОпераций.РегистрацияСтрокиПеремаркировки Тогда
		ТекОписание = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
	КонецЕсли;
	
	ОписаниеДляМетрики.Вставить("ДатаПеремаркировки", ТекОписание.ДопРеквизиты.ДатаПеремаркировки);
	ОписаниеДляМетрики.Вставить("ПричинаПеремаркировки", ТекОписание.ДопРеквизиты.ПричинаПеремаркировки);
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_УведомлениеОПриемке(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.УведомлениеОПриемке Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДляМетрики.Вставить("СтатусПриемки", ОписаниеОперации.ДопРеквизиты.СтатусПриемки);
	ОписаниеДляМетрики.Вставить("СтатусСверкиНаТСД", ОписаниеОперации.ДопРеквизиты.СтатусСверкиНаТСД);
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_ПечатьКодов(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ПечатьКодов Тогда
		Возврат;
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.Товары) Тогда
		СтрТовара = ОписаниеОперации.Товары[0];
		ОписаниеДляМетрики.Вставить("ЗаполненТовар", ЗначениеЗаполнено(СтрТовара.Товар));
		ОписаниеДляМетрики.Вставить("ЗаполненаНоменклатура1С", ЗначениеЗаполнено(СтрТовара.КлючНоменклатуры1С));
		ОписаниеДляМетрики.Вставить("КоличествоКодовТребуется", СтрТовара.КоличествоУпаковок);
		ОписаниеДляМетрики.Вставить("КоличествоКодовПодобрано", КодыОпераций_ОбщееКоличествоКодов(Операция));
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_КорректировкаСведенийОКодах(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	Если ТипОперации <> ТипыОпераций.КорректировкаСведенийОКодах
		И ТипОперации <> ТипыОпераций.РегистрацияСтрокиКорректировкиСведенийОКодах Тогда
		Возврат;
	КонецЕсли;
	
	ТекОписание = ОписаниеОперации;
	Если ТипОперации = ТипыОпераций.РегистрацияСтрокиКорректировкиСведенийОКодах Тогда
		ТекОписание = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
	КонецЕсли;
	
	ОписаниеДляМетрики.Вставить("ВидСведений", ТекОписание.ДопРеквизиты.ВидКорректируемыхСведений);
	
	Если ЗначениеЗаполнено(ТекОписание.ОперацияОснование) Тогда
		ОписаниеДляМетрики.Вставить("ТипОперацииОснования", ТекОписание.ОперацияОснование.ТипОперации);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьОписаниеДляМетрики_УведомлениеОСостоянииКодов(ОписаниеДляМетрики, ОписаниеОперации, ТипыОпераций)
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	Если ТипОперации <> ТипыОпераций.УведомлениеОСостоянииКодов
		И ТипОперации <> ТипыОпераций.РегистрацияСтрокиУведомленияОСостоянииКодов Тогда
		Возврат;
	КонецЕсли;
	
	ТекОписание = ОписаниеОперации;
	Если ТипОперации = ТипыОпераций.РегистрацияСтрокиУведомленияОСостоянииКодов Тогда
		ТекОписание = Операция_ПрочитатьОперацию(ОписаниеОперации.ОперацияОснование);
	КонецЕсли;
	
	ОписаниеДляМетрики.Вставить("СостояниеКодов", ТекОписание.ДопРеквизиты.СостояниеКодов);
	
КонецПроцедуры

// #КонецОбласти // ОписаниеПеременныхМетрик

// #Область ОписанияСобытий

// Добавляет в метрики собятия связанные с записью документа учета
//
// Параметры:
//  ОписаниеДокумента - Структура - см. функцию Новый_ДокументУчета();
//
Процедура Метрики_ПриЗаписиДокументаУчета(ОписаниеДокумента)
	
	Метрика_Функциональность_ПересчетКоличества(ОписаниеДокумента);
	
КонецПроцедуры

// Добавляет в метрики события сявзанные с записью операции
//
// Параметры:
//  ОписаниеОперации - Структура - см. функцию Новый_Операция();
//
Процедура Метрики_ПриЗаписиОперации(ОписаниеОперации)
	
	Если ТипыСлужебныхОперацийБезОтображения().Найти(ОписаниеОперации.ТипОперации) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОписаниеОперации.Организация;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	Метрика_Функциональность_СервисПровайдеры(ОписаниеОперации);
	Метрика_Функциональность_Площадки(ОписаниеОперации);
	
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().Операции;
	Действие = Перечисление_ДействияМетрики().ЗаписьВБазу;
	ДопСведения = ОписаниеОперацииДляМетрики(ОписаниеОперации);
	
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Организация.Идентификатор);
	ОписаниеМетрики.Организация = Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в метрики событие после отправки операций в сервис
//
// Параметры:
//  ОперацияИлиОписание - СправочникСсылка.КонтурМаркировка_Операции, Структура - операция или описание операции, см. Операция_ПрочитатьОперацию();
//  ИдентификаторВСервисе - Строка - идентификатор операции в сервисе;
//
Процедура Метрика_Операции_ОтправкаВСервис(ОперацияИлиОписание, ИдентификаторВСервисе = "")
	
	Если ТипЗнч(ОперацияИлиОписание) = Тип("Структура") Тогда
		ОписаниеОперации = ОперацияИлиОписание;
	Иначе
		ОписаниеОперации = Операция_ПрочитатьОперацию(ОперацияИлиОписание);
	КонецЕсли;
	
	Организация = ОписаниеОперации.Организация;
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().Операции;
	Действие = Перечисление_ДействияМетрики().ОтправкаВСервис;
	ДопСведения = ОписаниеОперацииДляМетрики(ОписаниеОперации, ИдентификаторВСервисе);
	
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие, ДопСведения, Организация.Идентификатор);
	ОписаниеМетрики.Организация = Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
	МетрикаОП_ЦелевоеДействие_Операции(ОписаниеОперации);
	
КонецПроцедуры

Процедура Метрика_НетПодписки(Действие, Организация)
	
	ИНН = ЗначениеРеквизитаОбъектаЛок(Организация, "ИНН");
	Топик = Перечисление_ТопикиМетрики().Статистика;
	Категория = Перечисление_КатегорииМетрики().Подписки;
	
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие);
	ОписаниеМетрики.ДопСведения = Новый Структура("СтатусПодписки, ИНН", "Неактивна", ИНН);
	ОписаниеМетрики.Организация = Организация;
	
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в общепродуктовые метрики событие авторизации
//
// Параметры:
//  Сертификат - СправочникСсылка.КонтурМаркировка_Сертификаты - сертификат;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
//
Процедура МетрикаОП_Авторизация(Сертификат, Организация)
	
	Топик = Перечисление_ТопикиМетрики().ОбщепродуктоваяСтатистика;
	Действие = Перечисление_ДействияМетрики().Сертификат;
	Категория = Перечисление_КатегорииМетрики().Авторизация;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие);
	ОписаниеМетрики.Организация = Организация;
	ОписаниеМетрики.Сертификат = Сертификат;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// Добавляет в общепродуктовые метрики событие о целевом действии при отправке операций
//
// Параметры:
//  ОписаниеОперации - Структура - см. Новый_Операция();
//
Процедура МетрикаОП_ЦелевоеДействие_Операции(ОписаниеОперации)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ДействияМетрики = Перечисление_ДействияМетрики();
	
	ДействияПоТипамОпераций = Новый Соответствие;
	ДействияПоТипамОпераций.Вставить(ТипыОпераций.ЗаказКодов, ДействияМетрики.ЗаказКодов);
	ДействияПоТипамОпераций.Вставить(ТипыОпераций.ОтчетОНанесении, ДействияМетрики.ОтчетОНанесении);
	ДействияПоТипамОпераций.Вставить(ТипыОпераций.ВводВОборот, ДействияМетрики.ВводВОборот);
	ДействияПоТипамОпераций.Вставить(ТипыОпераций.ВыводИзОборота, ДействияМетрики.ВыводИзОборота);
	
	Действие = ДействияПоТипамОпераций[ОписаниеОперации.ТипОперации];
	Если Не ЗначениеЗаполнено(Действие) Тогда
		Возврат;
	КонецЕсли;
	
	Топик = Перечисление_ТопикиМетрики().ОбщепродуктоваяСтатистика;
	Категория = Перечисление_КатегорииМетрики().ЦелевоеДействие;
	ОписаниеМетрики = Новый_ОписаниеМетрики(Категория, Действие);
	ОписаниеМетрики.Организация = ОписаниеОперации.Организация;
	СтекМетрик_ДобавитьСобытие(Топик, ОписаниеМетрики);
	
КонецПроцедуры

// #КонецОбласти // ОписанияСобытий

