//
// Параметры:
//  ВидПродукции - ПеречислениеСсылка.КонтурМаркировка_ВидыПродукции - вид продукции
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.КонтурМаркировка_ПравилаОтраженияВЭДО, Неопределено - правило отражения в ЭДО для ТГ
//
Функция МаркируемыеТоварныеГруппы_ОтражениеВЭДО(ВидПродукции) Экспорт
	
	Результат = Неопределено;
	
	МаркируемаяТГ = МаркируемаяТоварнаяГруппа_ПоВидуПродукции(ВидПродукции);
	
	Если ЗначениеЗаполнено(МаркируемаяТГ) Тогда
		Результат = МаркируемаяТоварнаяГруппа_Прочитать(МаркируемаяТГ).ОтражениеВЭДО;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит параметры маркируемой товарной группы по виду продукции
//
// Параметры:
//  ВидПродукции - Перечисление.КонтурМаркировка_ВидыПродукции - вид продукции
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДопСправочники - маркируемая товарная группа
//
Функция МаркируемаяТоварнаяГруппа_ПоВидуПродукции(ВидПродукции)
	
	КлючКэш = "МаркируемаяТоварнаяГруппа_ПоВидуПродукции";
	КэшПараметров = Кэш_Прочитать(КлючКэш);
	Если КэшПараметров = Неопределено Тогда
		КэшПараметров = Новый Соответствие;
		Кэш_Поместить(КлючКэш, КэшПараметров);
	КонецЕсли;
	
	Результат = КэшПараметров[ВидПродукции];
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяРеквизита = "ВидПродукции";
	ИмяСправочника = Перечисление_ИменаДопСправочников().МаркируемыеТоварныеГруппы;
	МассивСсылок = ДопСправочник_НайтиПоДопРеквизиту(ИмяСправочника, ИмяРеквизита, ВидПродукции);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		Результат = МассивСсылок[0];
	КонецЕсли;
	
	КэшПараметров.Вставить(ВидПродукции, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_МаркируемаяТоварнаяГруппа() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("ВидПродукции");
	Результат.Вставить("ОтражениеВЭДО");
	Результат.Вставить("ВидПродукции1С");
	
	Возврат Результат;
	
КонецФункции

