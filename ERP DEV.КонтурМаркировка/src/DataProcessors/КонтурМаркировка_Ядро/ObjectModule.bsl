Функция ДопРеквизит_Прочитать(Объект, ИмяРеквизита, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Возврат МодульКонтроль().ДопРеквизит_Прочитать(Объект, ИмяРеквизита, ЗначениеПоУмолчанию);
	
КонецФункции

Процедура ДопРеквизиты_Записать(Объект, ДопРеквизиты) Экспорт
	
	Набор = РегистрыСведений.КонтурМаркировка_ДопРеквизиты.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	
	Для каждого Элемент Из ДопРеквизиты Цикл
		
		ИмяРеквизита = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если Значение = Ложь
			Или Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = Набор.Добавить();
		Запись.ИмяРеквизита = ИмяРеквизита;
		Запись.Объект = Объект;
		
		Если ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
			Запись.ЗначениеКлюч = Значение;
		ИначеЕсли ЭтоПростойТип(Значение) Тогда
			Запись.Значение = Значение;
		ИначеЕсли ЭтоОбъектКонтурМаркировки(Значение) Тогда
			Запись.ЗначениеСсылка = Значение;
		Иначе
			Запись.ЗначениеКлюч = КлючОбъекта1С(Значение);
			Запись.ТипКлючаЗначения = ТипКлючаОбъекта1С(Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Набор.Записать();
	
КонецПроцедуры

Процедура ДопРеквизиты_Удалить(Объект) Экспорт
	
	Набор = РегистрыСведений.КонтурМаркировка_ДопРеквизиты.СоздатьНаборЗаписей();
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Записать();
	
КонецПроцедуры

