// #Область Площадки

Процедура СинхронизироватьПлощадки(Организация) Экспорт
	
	ОбработанныеПлощадки = Новый Массив;
	
	Для каждого ВидПродукции Из ДопустимыеВидыПродукцииДляЗагрузкиПлощадок() Цикл
		
		Попытка
			ManufactureInfos = Маркировка_СписокПлощадок(Организация, ВидПродукции);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Действие = НСтр("ru = 'Синхронизация списка площадок'");
			ДопИнформация = Новый Структура;
			ДопИнформация.Вставить("Организация", Организация);
			ДопИнформация.Вставить("ВидПродукции", ВидПродукции);
			ОбработатьОшибку(Действие, Ошибка, ДопИнформация);
			Продолжить;
		КонецПопытки;
		
		Для Каждого ManufactureInfo Из ManufactureInfos Цикл
			
			name = СвойствоСтруктуры(ManufactureInfo, "name");
			address = СвойствоСтруктуры(ManufactureInfo, "address");
			countryCode = СвойствоСтруктуры(ManufactureInfo, "countryCode");
			productGroups = СвойствоСтруктуры(ManufactureInfo, "productGroups");
			id = СвойствоСтруктуры(ManufactureInfo, "id");
			vetisGuid = СвойствоСтруктуры(ManufactureInfo, "vetisGuid", "");
			fiasId = СвойствоСтруктуры(ManufactureInfo, "fiasId", "");
			kpp = СвойствоСтруктуры(ManufactureInfo, "kpp", "");
			isMod = СвойствоСтруктуры(ManufactureInfo, "isMod", Ложь);
			
			Если ЭтоСтрокаПустогоИдентификатора(fiasId) Тогда
				fiasId = "";
			КонецЕсли;
			Если ЭтоСтрокаПустогоИдентификатора(vetisGuid) Тогда
				vetisGuid = "";
			КонецЕсли;
			
			Если isMod Тогда
				ТипПлощадки = Перечисления.КонтурМаркировка_ТипыПлощадок.МОД;
			Иначе
				ТипПлощадки = Перечисления.КонтурМаркировка_ТипыПлощадок.ПроизводственнаяПлощадка;
			КонецЕсли;
			
			Ссылка = Площадка_Найти(ТипПлощадки, id, vetisGuid, fiasId, kpp);
			
			Если ЗначениеЗаполнено(Ссылка) Тогда
				ОписаниеМОД = Площадка_Прочитать(Ссылка);
				Если ОбработанныеПлощадки.Найти(Ссылка) = Неопределено Тогда
					ОписаниеМОД.ВидыПродукции.Очистить();
				КонецЕсли;
			Иначе
				ОписаниеМОД = Новый_Площадка();
			КонецЕсли;
			
			ОписаниеМОД.Организация = Организация;
			ОписаниеМОД.ТипПлощадки = ТипПлощадки;
			ОписаниеМОД.КодСтраны = countryCode;
			ОписаниеМОД.Адрес = address;
			ОписаниеМОД.КПП = kpp;
			ОписаниеМОД.ИдентификаторФИАС = fiasId;
			ОписаниеМОД.ИдентификаторВЕТИС = vetisGuid;
			ОписаниеМОД.КодГИСМТ = id;
			
			Если Не ЗначениеЗаполнено(ОписаниеМОД.Наименование) Тогда
				Если ЗначениеЗаполнено(name) Тогда
					ОписаниеМОД.Наименование = name;
				Иначе
					ОписаниеМОД.Наименование = address;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(productGroups) Тогда
				Для Каждого productGroup Из productGroups Цикл
					ВидПродукции = ВидПродукцииПоТоварнойГруппеИзСервиса(productGroup);
					Если ОписаниеМОД.ВидыПродукции.Найти(ВидПродукции) = Неопределено Тогда
						ОписаниеМОД.ВидыПродукции.Добавить(ВидПродукции);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Площадка_Записать(ОписаниеМОД);
			
			Если ОбработанныеПлощадки.Найти(Ссылка) = Неопределено Тогда
				ОбработанныеПлощадки.Добавить(ОписаниеМОД.Ссылка);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Метрика_Функциональность_СинхронизацияМОД(Организация);
	
КонецПроцедуры

// Находит в базе площадку по идентификаторам
// Идентификатор ГИС МТ является приоритетным
//
// Параметры:
//  ТипПлощадки - ПеречислениеСсылка.КонтурМаркировка_ТипыПлощадок - тип площадки;
//  КодГИСМТ - Строка - код ГИС МТ;
//  ИдентификаторВЕТИС - Строка - идентификатор ВетИС;
//  ИдентификаторФИАС - Строка - идентификатор ФИАС;
//  КПП - Строка - КПП;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Площадки
//
Функция Площадка_Найти(ТипПлощадки, КодГИСМТ, ИдентификаторВЕТИС, ИдентификаторФИАС, КПП)
	
	ДопустимыеТипыПлощадки = Новый Массив;
	ДопустимыеТипыПлощадки.Добавить(ТипПлощадки);
	ДопустимыеТипыПлощадки.Добавить(Перечисления.КонтурМаркировка_ТипыПлощадок.ПустаяСсылка());

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Площадки КАК Т
	|ГДЕ
	|	Т.КодГИСМТ = &КодГИСМТ
	|	И Т.ТипПлощадки В(&ДопустимыеТипыПлощадки)");
	Запрос.УстановитьПараметр("ДопустимыеТипыПлощадки", ДопустимыеТипыПлощадки);
	Запрос.УстановитьПараметр("КодГИСМТ", КодГИСМТ);
	Результат = ПолучитьРезультатЗапроса(Запрос);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Площадки КАК Т
	|ГДЕ
	|	Т.КодГИСМТ = &ПустойКодГИСМТ
	|	И &ИдентификаторФИАС И &КПП
	|	И &ИдентификаторВЕТИС
	|	И Т.ТипПлощадки В(&ДопустимыеТипыПлощадки)";
	
	Если ЗначениеЗаполнено(КПП) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КПП", "Т.КПП = &КПП");
	Иначе
		Если ЗначениеЗаполнено(ИдентификаторФИАС) Тогда
			// Идентификатор ФИАС используется в паре с КПП
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КПП", "Т.КПП = """"");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КПП", "ИСТИНА");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторФИАС) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторФИАС", "Т.ИдентификаторФИАС = &ИдентификаторФИАС");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторФИАС", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторВЕТИС) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторВЕТИС", "Т.ИдентификаторВЕТИС = &ИдентификаторВЕТИС");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторВЕТИС", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПустойКодГИСМТ", 0);
	Запрос.УстановитьПараметр("ДопустимыеТипыПлощадки", ДопустимыеТипыПлощадки);
	Запрос.УстановитьПараметр("ИдентификаторВЕТИС", ИдентификаторВЕТИС);
	Запрос.УстановитьПараметр("ИдентификаторФИАС", ИдентификаторФИАС);
	Запрос.УстановитьПараметр("КПП", КПП);
	
	Результат = ПолучитьРезультатЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

Функция Площадка_Записать(ОписаниеМОД) Экспорт
	
	Если ЗначениеЗаполнено(ОписаниеМОД.Ссылка) Тогда
		ПроверитьОбъектВПроцессеОбновления(ОписаниеМОД.Ссылка);
		Объект = ОписаниеМОД.Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.КонтурМаркировка_Площадки.СоздатьЭлемент();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеМОД.Ссылка)
		И ОписаниеМОД.ВерсияДанных <> Объект.ВерсияДанных Тогда
		ВызватьИсключение НСтр(
		"ru = 'В базе изменилась версия места осуществления деятельности, текущую версию записать невозможно!'");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ОписаниеМОД,, "Ссылка, ВидыПродукции");
	Объект.Владелец = ОписаниеМОД.Организация;
	
	Объект.ВидыПродукции.Очистить();
	Для Каждого ВидПродукции Из ОписаниеМОД.ВидыПродукции Цикл
		Стр = Объект.ВидыПродукции.Добавить();
		Стр.ВидПродукции = ВидПродукции;
	КонецЦикла;
	
	Объект.Записать();
	
	ОписаниеМОД.Ссылка = Объект.Ссылка;
	ОписаниеМОД.ВерсияДанных = Объект.ВерсияДанных;
	
	Возврат Объект.Ссылка;
	
КонецФункции

Функция Площадка_Прочитать(Ссылка) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.*
	|ИЗ
	|	Справочник.КонтурМаркировка_Площадки КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый_Площадка();
	ЗаполнитьЗначенияСвойств(Результат, Выборка, , "ВидыПродукции");
	Результат.Организация = Выборка.Владелец;
	
	ВыборкаВидыПродукции = Выборка.ВидыПродукции.Выбрать();
	Пока ВыборкаВидыПродукции.Следующий() Цикл
		Результат.ВидыПродукции.Добавить(ВыборкаВидыПродукции.ВидПродукции);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_Площадка() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Организация");
	Результат.Вставить("ТипПлощадки");
	Результат.Вставить("Наименование");
	Результат.Вставить("КодСтраны");
	Результат.Вставить("Адрес");
	Результат.Вставить("КПП");
	Результат.Вставить("ИдентификаторФИАС");
	Результат.Вставить("ИдентификаторВЕТИС");
	Результат.Вставить("КодГИСМТ", 0);
	Результат.Вставить("ВидыПродукции", Новый Массив);
	Результат.Вставить("ВерсияДанных");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Площадки

// #Область Организации

Функция Организация_ВсеОрганизации() Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Организации КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления");
	
	Результат = МассивИзРезультатаЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

Функция Организация_Прочитать(Организация) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка,
	|	Т.Наименование КАК Наименование,
	|	Т.ИНН КАК ИНН,
	|	Т.КПП КАК КПП,
	|	Т.КлючОрганизации1С КАК КлючОрганизации1С,
	|	Т.ТипКлючаОрганизации1С КАК ТипКлючаОрганизации1С,
	|	Т.ОтпечатокСертификата КАК ОтпечатокСертификата,
	|	Т.Идентификатор КАК Идентификатор,
	|	Т.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.КонтурМаркировка_Организации КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый_Организация();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		Результат.Организация1С = МодульОбщегоНазначения().СсылкаПоИдентификатору(
		Выборка.КлючОрганизации1С, Выборка.ТипКлючаОрганизации1С);
	КонецЕсли;
	
	ЗаполнитьПоляСтруктуры(Результат.ДопРеквизиты, ДопРеквизиты_Прочитать(Результат.Ссылка));
	
	Возврат Результат;
	
КонецФункции

Функция Организация_Записать(ОписаниеОрганизации) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЗначениеЗаполнено(ОписаниеОрганизации.Ссылка) Тогда
			ПроверитьОбъектВПроцессеОбновления(ОписаниеОрганизации.Ссылка);
			Объект = ОписаниеОрганизации.Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.КонтурМаркировка_Организации.СоздатьЭлемент();
		КонецЕсли;
		
		ОписаниеОрганизации.КлючОрганизации1С = КлючОбъекта1С(ОписаниеОрганизации.Организация1С);
		ОписаниеОрганизации.ТипКлючаОрганизации1С = ТипКлючаОбъекта1С(ОписаниеОрганизации.Организация1С);
		
		ЗаполнитьЗначенияСвойств(Объект, ОписаниеОрганизации, , "Ссылка");
		
		Объект.Записать();
		
		ОписаниеОрганизации.Ссылка = Объект.Ссылка;
		
		ДопРеквизиты_Записать(ОписаниеОрганизации.Ссылка, ОписаниеОрганизации.ДопРеквизиты);
		
		// Отражение организации в справочнике контрагентов
		Контрагент_Подобрать(ОписаниеОрганизации.ИНН, ОписаниеОрганизации.КПП, ОписаниеОрганизации.Наименование);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Объект.Ссылка;
	
КонецФункции

// Возвращает организацию маркировки по организации учета
//
// Параметры:
//  Организация1С - СправочникСсылка - организация 1С;
//  ВызыватьИсключение - Булево - Истина, если нужно вызвать исключение когда организацию найти не удалось;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Организации - организация маркировки
//
Функция Организация_НайтиПоОрганизации1С(Организация1С, ВызыватьИсключение = Ложь) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Организации КАК Т
	|ГДЕ
	|	Т.КлючОрганизации1С = &КлючОрганизации1С
	|	И Т.ТипКлючаОрганизации1С = &ТипКлючаОрганизации1С
	|	И НЕ Т.ПометкаУдаления");
	Запрос.УстановитьПараметр("КлючОрганизации1С", КлючОбъекта1С(Организация1С));
	Запрос.УстановитьПараметр("ТипКлючаОрганизации1С", ТипКлючаОбъекта1С(Организация1С));
	
	Результат = ПолучитьРезультатЗапроса(Запрос,, ПустаяОрганизация());
	
	Если Не ЗначениеЗаполнено(Результат) И ВызыватьИсключение Тогда
		ШаблонОшибки = НСтр("ru = 'Не удалось найти организацию маркировки по организации 1С: %1'");
		ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Организация1С);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ищет организацию по ИНН
//
// Параметры:
//  ИНН - Стока - ИНН организации, которую нужно найти
//  КэшРезультатов - Соответствие - (необязательный) кэш результатов функции;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Организации - найденная организация;
//  Неопределено - если организацию найти не удалось;
//
Функция Организация_НайтиПоИНН(ИНН, КэшРезультатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ИНН];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Ссылка = Справочники.КонтурМаркировка_Организации.НайтиПоРеквизиту("ИНН", ИНН);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Результат = Ссылка;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(ИНН, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив организаций, по которым можно выполнять обмен
//
// Параметры:
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация для отбора;
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Организации
//
Функция Организация_ВсеОрганизацииДляОбмена(Организация = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Результат = ЗначениеВМассиве(Организация);
	Иначе
		Результат = Организация_ВсеОрганизации();
	КонецЕсли;
	
	Для Сч = -Результат.ВГраница() По 0 Цикл
		
		КонтекстОбмена = Новый_КонтекстОбмена(Результат[-Сч]);
		КонтекстОбмена_ЗаполнитьСертификат(КонтекстОбмена);
		КонтекстОбмена_ПроверитьОрганизацию(КонтекстОбмена);
		
		Если Не КонтекстОбмена.ОбменВозможен Тогда
			Результат.Удалить(-Сч);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает первую организацию, по которой выполнена авторизация в сервисе
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Организации - организация;
//  Неопределено - если не нашли организаций с авторизацией;
//
Функция Организация_ЛюбаяСДоступомВСервис()
	
	Для каждого Организация Из Организация_ВсеОрганизации() Цикл
		
		КонтекстОбмена = Новый_КонтекстОбмена(Организация);
		КонтекстОбмена_ЗаполнитьСертификат(КонтекстОбмена);
		КонтекстОбмена_ПроверитьОрганизацию(КонтекстОбмена);
		АвторизацияМаркировка_Проверить(КонтекстОбмена);
		
		Если КонтекстОбмена.ОбменВозможен
			И Не КонтекстОбмена.ТребуетсяАвторизацияПортала Тогда
			Возврат Организация;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция Организация_ВсеОрганизацииСАвторизацией()
	
	Результат = Новый Массив;
	
	Для каждого Организация Из Организация_ВсеОрганизации() Цикл
		
		КонтекстОбмена = КонтекстОбменаССервисом(Организация);
		Если Не КонтекстОбмена.ОбменВозможен Тогда
			Продолжить;
		КонецЕсли;
		
		Если Авторизация_Выполнить(КонтекстОбмена) Тогда
			Результат.Добавить(Организация);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция Организация_ПрефиксВидаАгрегатаИзИдентификатораGS1(Организация) Экспорт
	
	МаксДлинаПрефикса = 12;
	
	ИдентификаторGS1 = ДопРеквизит_Прочитать(Организация, "ИдентификаторGS1");
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(ИдентификаторGS1) Тогда
		Результат = Лев(ИдентификаторGS1, МаксДлинаПрефикса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Организация_ИдентификаторИзСервиса(Организация) Экспорт
	
	Результат = Неопределено;
	
	РеквизитыОрганизации = ЗначенияРеквизитовОбъектаЛок(Организация, Новый Структура("ИНН, КПП"));
	ИНН = РеквизитыОрганизации.ИНН;
	КПП = РеквизитыОрганизации.КПП;
	ДлинаИдентификатора = 36;
	
	ОрганизацииСервиса = Маркировка_СписокОрганизаций(Организация);
	
	Отбор = Новый Структура("inn", ИНН);
	Если ЗначениеЗаполнено(КПП) Тогда
		Отбор.Вставить("kpp", КПП);
	КонецЕсли;
	
	НайденныеСтроки = МассивСтруктур_НайтиСтроки(ОрганизацииСервиса, Отбор);
	
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		
		Для Каждого Стр Из НайденныеСтроки Цикл
			Если СтрДлина(Стр.id) = ДлинаИдентификатора Тогда
				Результат = Стр.id;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Результат = Неопределено Тогда
			ТекстОшибки = ПараметрыВСтроку(НСтр(
			"ru = 'Не удалось найти идентификатор Организации в сервисе'")
			, Организация, ИНН, КПП);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(КПП) Тогда
			ТекстОшибки = ПараметрыВСтроку(НСтр(
			"ru = 'Не удалось найти в сервисе организацию ""%1"" по ИНН/КПП: %2/%3'")
			, Организация, ИНН, КПП);
		Иначе
			ТекстОшибки = ПараметрыВСтроку(НСтр(
			"ru = 'Не удалось найти в сервисе организацию ""%1"" по ИНН: %2'")
			, Организация, ИНН);
		КонецЕсли;
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Организация_ИдентификаторGS1ИзСервиса(Организация) Экспорт
	
	Результат = Неопределено;
	
	АнкетаОрганизации = Маркировка_АнкетаОрганизации(Организация);
	
	АнкетаОрганизации.Свойство("gs1CompanyPrefix", Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_Организация() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Наименование");
	Результат.Вставить("ИНН");
	Результат.Вставить("КПП");
	Результат.Вставить("Организация1С");
	Результат.Вставить("КлючОрганизации1С");
	Результат.Вставить("ТипКлючаОрганизации1С");
	Результат.Вставить("ОтпечатокСертификата");
	Результат.Вставить("Идентификатор");
	Результат.Вставить("Комментарий");
	
	Результат.Вставить("ДопРеквизиты", Новый_Организация_ДопРеквизиты());
	
	Возврат Результат;
	
КонецФункции

Функция Новый_Организация_ДопРеквизиты()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ОтключитьОбмен", Ложь);
	Результат.Вставить("ОтключитьЧтениеВходящихУПД", Ложь);
	Результат.Вставить("ОтключитьЧтениеУведомленийОПриемке", Ложь);
	Результат.Вставить("ИдентификаторGS1");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьДатуПоследнегоОбмена(Организация)
	
	Реквизит = Перечисление_ДопСвойства().ДатаПоследнегоОбмена;
	ДопСвойство_Записать(Организация, Реквизит, ТекущаяУниверсальнаяДата());
	
КонецПроцедуры

// #КонецОбласти // Организации

// #Область Контрагенты

Функция Контрагент_Подобрать(ИНН, КПП = "", Наименование = "", КэшРезультатов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат ПустойКонтрагент();
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[ИНН+КПП];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Наименование КАК Наименование,
	|	Т.Ссылка КАК Ссылка,
	|	Т.КПП КАК КПП
	|ИЗ
	|	Справочник.КонтурМаркировка_Контрагенты КАК Т
	|ГДЕ
	|	Т.ИНН = &ИНН
	|	И Т.КПП = &КПП
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Наименование,
	|	Т.Ссылка,
	|	Т.КПП
	|ИЗ
	|	Справочник.КонтурМаркировка_Контрагенты КАК Т
	|ГДЕ
	|	Т.ИНН = &ИНН
	|	И Т.КПП = """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Наименование,
	|	Т.Ссылка,
	|	Т.КПП
	|ИЗ
	|	Справочник.КонтурМаркировка_Контрагенты КАК Т
	|ГДЕ
	|	Т.ИНН = &ИНН
	|	И &КПП = """"");
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Выборка.Ссылка;
		
		Если ЗначениеЗаполнено(Наименование)
			И Не ЗначениеЗаполнено(Выборка.Наименование) Тогда
			КонтрагентОбъект = Результат.ПолучитьОбъект();
			КонтрагентОбъект.Наименование = Наименование;
			КонтрагентОбъект.Записать();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КПП)
			И Не ЗначениеЗаполнено(Выборка.КПП) Тогда
			КонтрагентОбъект = Результат.ПолучитьОбъект();
			КонтрагентОбъект.КПП = КПП;
			КонтрагентОбъект.Записать();
		КонецЕсли;
		
	Иначе
		Результат = Контрагент_Записать(Наименование, ИНН, КПП);
	КонецЕсли;
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(ИНН+КПП, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контрагент_Записать(Наименование, ИНН, КПП)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Контрагенты_Заблокировать(ИНН, КПП);
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурМаркировка_Контрагенты КАК Т
		|ГДЕ
		|	Т.ИНН = &ИНН
		|	И Т.КПП = &КПП");
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		
		Ссылка = ПолучитьРезультатЗапроса(Запрос);
		
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Объект = Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.КонтурМаркировка_Контрагенты.СоздатьЭлемент();
		КонецЕсли;
		
		Объект.Наименование = Наименование;
		Объект.ИНН = ИНН;
		Объект.КПП = КПП;
		Объект.Записать();
		
		Результат = Объект.Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура Контрагенты_Заблокировать(ИНН, Знач КПП)
	
	Если Не ЗначениеЗаполнено(КПП) Тогда
		КПП = "";
	КонецЕсли;
	
	Значения = Новый Структура;
	Значения.Вставить("ИНН", ИНН);
	Значения.Вставить("КПП", КПП);
	ИмяОбъекта = "Справочник.КонтурМаркировка_Контрагенты";
	
	Если ПоддерживаютсяПоляБлокировкиДанных() Тогда
		ЗаблокироватьПоЗначениям(ИмяОбъекта, Значения);
	Иначе
		ЗаблокироватьПоЗначениямДляИзменения(ИмяОбъекта, Значения);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // Контрагенты

// #Область ОчисткаУстаревшихДанных

// Выполняет отчистку устаревших кодов в пуле, операциях и т.п.
//
Процедура ОчиститьУстаревшиеДанные() Экспорт
	
	Если НастройкиМодуля().РежимТестирования Тогда
		Возврат;
	КонецЕсли;
	
	ЗафиксироватьДатуЗапускаОчисткиУстаревшихДанных();
	
	Попытка
		УдалитьКодыУстаревшихЗаказов();
		УдалитьКодыУстаревшихОпераций();
		АрхивироватьКодыУстаревшихДокументов();
		УдалитьУстаревшиеПолныеКоды();
		УдалитьУстаревшиеКоды();
		УдалитьУстаревшиеПриемкиИВходящиеУПД();
		УдалитьУстаревшиеАрхивыСКодамиДокументов();
		УдалитьУстаревшуюИсториюЗапросовВСервис();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Действие = Перечисление_ПредставленияКомандОбработки().ОчисткаУстаревшихДанных;
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		ОбработатьОшибку(Действие, ТекстОшибки);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьКодыУстаревшихЗаказов()
	
	Для каждого ЗаказКодов Из ЗаказыСИстекшимСрокомЖизниКодов() Цикл
		КодыЗаказов_Удалить(ЗаказКодов)
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьКодыУстаревшихОпераций()
	
	ПериодХранения = НастройкиМодуля().ПериодХраненияКодовВЗавершенныхОперациях;
	Если Не ЗначениеЗаполнено(ПериодХранения) Тогда
		Возврат;
	КонецЕсли;
	
	АктуальнаяДатаХранения = НачалоДня(ТекущаяДатаСеанса()) - ПериодХранения * СекундВСутках();
	
	Для Каждого Операция Из УстаревшиеОперацииСКодами(АктуальнаяДатаХранения) Цикл
		
		НачатьТранзакцию(РежимУправленияБлокировкой());
		
		Попытка
			
			КодыОпераций_Заблокировать(Операция);
			
			Набор = РегистрыСведений.КонтурМаркировка_КодыОпераций.СоздатьНаборЗаписей();
			Набор.Отбор.Операция.Установить(Операция);
			Набор.Прочитать();
			
			КлючиКодов = Набор.ВыгрузитьКолонку("КлючКода");
			
			Набор.Очистить();
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Записать();
			
			Набор = РегистрыСведений.КонтурМаркировка_КоличествоКодовОпераций.СоздатьНаборЗаписей();
			Набор.Отбор.Операция.Установить(Операция);
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Записать();
			
			УстаревшиеКоды_Записать(КлючиКодов);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			Ошибка = ИнформацияОбОшибке();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура АрхивироватьКодыУстаревшихДокументов()
	
	ПериодХраненияКодов = НастройкиМодуля().ПериодХраненияКодовВЗавершенныхДокументах;
	Если Не ЗначениеЗаполнено(ПериодХраненияКодов) Тогда
		Возврат;
	КонецЕсли;
	
	АктуальнаяДатаХранения = НачалоДня(ТекущаяДатаСеанса()) - ПериодХраненияКодов * СекундВСутках();
	
	Для Каждого ДокументУчета Из УстаревшиеДокументыСКодами(АктуальнаяДатаХранения) Цикл
		КодыДокументов_ПереместитьВАрхив(ДокументУчета);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьУстаревшиеПолныеКоды()
	
	Настройки = НастройкиМодуля();
	ТипыФайлов = Перечисление_ТипыФайлов();
	ТипыСтатусов = Перечисление_ТипыСтатусов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	СобытияДляОчистки = Перечисление_СобытияДляУдаленияПолныхКодов();
	СтатусыДокументовУчета = Перечисление_СтатусыДокументовУчета();
	
	Если Не ЗначениеЗаполнено(Настройки.ПериодХраненияПолныхКодов)
		Или Не ЗначениеЗаполнено(Настройки.СобытиеДляУдаленияПолныхКодов) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Файлы.Идентификатор КАК Идентификатор
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Файлы
	|ГДЕ
	|	Файлы.ТипФайла = &ПолныеКоды");
	Запрос.УстановитьПараметр("ПолныеКоды", ТипыФайлов.ПолныеКоды);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ПорцииЗаписей = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Идентификатор) Тогда
			ПорцииЗаписей.Добавить(Новый УникальныйИдентификатор(Выборка.Идентификатор));
		КонецЕсли;
	КонецЦикла;
	
	АктуальнаяДатаПечати = НачалоДня(ТекущаяДатаСеанса()) - Настройки.ПериодХраненияПолныхКодов * СекундВСутках();
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Если Настройки.СобытиеДляУдаленияПолныхКодов = СобытияДляОчистки.ПослеЗавершенияПечати Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	КодыМаркировки.КлючКода КАК КлючКода,
		|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
		|ПОМЕСТИТЬ ТаблицаКодов
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
		|		ПО ИнформацияОКодах.КлючИнформацииОКоде = КодыМаркировки.КлючИнформацииОКоде
		|ГДЕ
		|	ИнформацияОКодах.ЕстьПолныйКод
		|	И ИнформацияОКодах.ДатаПечати МЕЖДУ &НачДата И &КонДата
		|	И КодыМаркировки.КлючКода ЕСТЬ НЕ NULL 
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючКода";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	КодыМаркировки.КлючКода КАК КлючКода,
		|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
		|ПОМЕСТИТЬ ТаблицаКодов
		|ИЗ
		|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
		|		ПО ИнформацияОКодах.КлючИнформацииОКоде = КодыМаркировки.КлючИнформацииОКоде
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыКодовГИСМТ КАК СтатусыКодов
		|		ПО (КодыМаркировки.КлючСтатусаКода = СтатусыКодов.КлючСтатусаКода)
		|ГДЕ
		|	ИнформацияОКодах.ЕстьПолныйКод
		|	И СтатусыКодов.ДатаВводаВОборот МЕЖДУ &НачДата И &КонДата
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючКода";
		
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НачДата", '00010101' + 1);
	Запрос.УстановитьПараметр("КонДата", АктуальнаяДатаПечати - 1);
	Запрос.УстановитьПараметр("ПорцииЗаписей", ПорцииЗаписей);
	Запрос.Выполнить();
	ПорцииЗаписей.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.КлючКода КАК КлючКода,
	|	Т.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.КлючКода КАК КлючКода,
	|		Т.ПорцияЗаписей КАК ПорцияЗаписей
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ТаблицаКодов.КлючКода КАК КлючКода,
	|			ТаблицаКодов.ПорцияЗаписей КАК ПорцияЗаписей,
	|			МИНИМУМ(ВЫБОР
	|					КОГДА ЕСТЬNULL(СтатусыДокументов.Статус, &СтатусДокументаЗавершен) = &СтатусДокументаЗавершен
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ) КАК МожноУдалить
	|		ИЗ
	|			ТаблицаКодов КАК ТаблицаКодов
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|				ПО ТаблицаКодов.КлючКода = КодыДокументов.КлючКода
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыДокументовУчета КАК СтатусыДокументов
	|				ПО (КодыДокументов.ДокументУчета = СтатусыДокументов.ДокументУчета)
	|					И (СтатусыДокументов.ТипСтатуса = &ОсновнойСтатус)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ТаблицаКодов.КлючКода,
	|			ТаблицаКодов.ПорцияЗаписей
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			ТаблицаКодов.КлючКода,
	|			ТаблицаКодов.ПорцияЗаписей,
	|			МИНИМУМ(ВЫБОР
	|					КОГДА ЕСТЬNULL(Операции.ТипОперации, """") <> &ТипОперацииПечатьКодов
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ)
	|		ИЗ
	|			ТаблицаКодов КАК ТаблицаКодов
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|				ПО ТаблицаКодов.КлючКода = КодыОпераций.КлючКода
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|				ПО (КодыОпераций.Операция = Операции.Ссылка)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ТаблицаКодов.КлючКода,
	|			ТаблицаКодов.ПорцияЗаписей) КАК Т
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Т.КлючКода,
	|		Т.ПорцияЗаписей
	|	
	|	ИМЕЮЩИЕ
	|		МИНИМУМ(Т.МожноУдалить) = ИСТИНА) КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорцияЗаписей
	|ИТОГИ ПО
	|	ПорцияЗаписей");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ОсновнойСтатус", ТипыСтатусов.ОсновнойСтатус);
	Запрос.УстановитьПараметр("ТипОперацииПечатьКодов", ТипыОпераций.ПечатьКодов);
	Запрос.УстановитьПараметр("СтатусДокументаЗавершен", СтатусыДокументовУчета.Завершен);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаПорция = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПорция.Следующий() Цикл
		
		ТаблицаКодов = Новый_ТаблицаКодов();
		Выборка = ВыборкаПорция.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТаблицаКодов.Добавить().КлючКода = Выборка.КлючКода;
		КонецЦикла;
		
		Файл = Файл_НайтиПоИдентификатору(Неопределено, ВыборкаПорция.ПорцияЗаписей, ТипыФайлов.ПолныеКоды);
		
		НачатьТранзакцию(РежимУправленияБлокировкой());
		
		Попытка
			
			Файл_Заблокировать(ВыборкаПорция.ПорцияЗаписей);
			КодыМаркировки_Заблокировать(ВыборкаПорция.ПорцияЗаписей);
			
			ОписаниеФайла = Файл_Прочитать(Файл);
			
			Если ЗначениеЗаполнено(ОписаниеФайла)
				И ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
				
				ТаблицаЗначений_ДобавитьИндекс(ОписаниеФайла.ДанныеФайла, "КлючКода");
				
				Для Каждого СтрКода Из ТаблицаКодов Цикл
					СтрФайла = ОписаниеФайла.ДанныеФайла.Найти(СтрКода.КлючКода, "КлючКода");
					Если СтрФайла <> Неопределено Тогда
						ОписаниеФайла.ДанныеФайла.Удалить(СтрФайла);
					КонецЕсли;
				КонецЦикла;
				
				ТаблицаЗначений_УдалитьИндекс(ОписаниеФайла.ДанныеФайла, "КлючКода");
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
				Файл_Записать(ОписаниеФайла);
			Иначе
				Файлы_Удалить(Файл);
			КонецЕсли;
			
			ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
			ТаблицаКодов.ЗаполнитьЗначения(Ложь, "ЕстьПолныйКод");
			ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			Ошибка = ИнформацияОбОшибке();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьУстаревшиеКоды()
	
	// Чтобы избежать ошибок когда коды удаляются и сразу добавляются в документ или операцию
	ПериодХраненияУстаревшихКодов = НастройкиМодуля().ПериодХраненияУстаревшихКодов;
	АктуальнаяДатаЗаписей = НачалоДня(ТекущаяДатаСеанса()) - ПериодХраненияУстаревшихКодов * СекундВСутках();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуПустойКлючВЗапрос(МенеджерВТ);
	
	ЗапросФайлы = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Файл,
	|	Т.ДатаСоздания КАК ДатаСоздания
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.ТипФайла = &ТипФайла
	|	И Т.ДатаСоздания < &АктуальнаяДатаЗаписей
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоздания");
	ЗапросФайлы.УстановитьПараметр("ТипФайла", Перечисление_ТипыФайлов().УстаревшиеКоды);
	ЗапросФайлы.УстановитьПараметр("АктуальнаяДатаЗаписей", АктуальнаяДатаЗаписей);
	
	РезультатЗапросаФайлы = ЗапросФайлы.Выполнить();
	Если РезультатЗапросаФайлы.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросТаблицаКодов = Новый Запрос(
	"ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода
	|ПОМЕСТИТЬ ТаблицаКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыДокументов КАК КодыДокументов
	|		ПО КодыМаркировки.КлючКода = КодыДокументов.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыОпераций КАК КодыОпераций
	|		ПО КодыМаркировки.КлючКода = КодыОпераций.КлючКода
	|ГДЕ
	|	КодыМаркировки.КлючКода В(&КлючиКодов)
	|	И КодыДокументов.КлючКода ЕСТЬ NULL
	|	И КодыОпераций.КлючКода ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючКода");
	ЗапросТаблицаКодов.МенеджерВременныхТаблиц = МенеджерВТ;
	
	// BSLLS:CreateQueryInCycle-off
	
	Выборка = РезультатЗапросаФайлы.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ОписаниеФайла = Файл_Прочитать(Выборка.Файл);
		Если ОписаниеФайла = Неопределено Тогда
			Файлы_Удалить(Выборка.Файл);
			Продолжить;
		КонецЕсли;
		
		ВсегоСтрок = ОписаниеФайла.ДанныеФайла.Количество();
		Если ОписаниеФайла.ДанныеФайла[ВсегоСтрок - 1].ДатаЗаписи < АктуальнаяДатаЗаписей Тогда
			КлючиКодов = ОписаниеФайла.ДанныеФайла.ВыгрузитьКолонку("КлючКода");
			ОписаниеФайла.ДанныеФайла.Очистить();
		Иначе
			КлючиКодов = Новый Массив;
			Для Сч = 1 По ВсегоСтрок Цикл
				ПерваяСтрока = ОписаниеФайла.ДанныеФайла[0];
				Если ПерваяСтрока.ДатаЗаписи >= АктуальнаяДатаЗаписей Тогда
					Прервать;
				КонецЕсли;
				КлючиКодов.Добавить(ПерваяСтрока.КлючКода);
				ОписаниеФайла.ДанныеФайла.Удалить(0);
			КонецЦикла;
		КонецЕсли;
		
		ЗапросТаблицаКодов.УстановитьПараметр("КлючиКодов", КлючиКодов);
		ЕстьУстаревшиеКоды = ПолучитьРезультатЗапроса(ЗапросТаблицаКодов, "Количество") > 0;
		КлючиКодов.Очистить();
		
		Если ЕстьУстаревшиеКоды Тогда
			УдалитьПорциюУстаревшихКодов(МенеджерВТ);
		КонецЕсли;
		
		УдалитьТаблицуИзЗапроса(МенеджерВТ, "ТаблицаКодов");
		
		Если ОписаниеФайла.ВерсияДанных = ОписаниеФайла.Ссылка.ВерсияДанных Тогда
			Если ЗначениеЗаполнено(ОписаниеФайла.ДанныеФайла) Тогда
				ОписаниеФайла.ДатаСоздания = ОписаниеФайла.ДанныеФайла[0].ДатаЗаписи;
				Файл_Записать(ОписаниеФайла);
			Иначе
				Файлы_Удалить(Выборка.Файл);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// BSLLS:CreateQueryInCycle-on
	
	ИнформацияОКодах_УдалитьУстаревшие();
	СтатусыКодовГИСМТ_УдалитьУстаревшие();
	
КонецПроцедуры

Процедура УдалитьПорциюУстаревшихКодов(МенеджерВТ)
	
	ТаблицаКодов_ВТ_ДобавитьКлючиАгрегатовВерхнегоУровня(МенеджерВТ);
	ТаблицаКодов_ВТ_ДобавитьКлючиВсехВложенныхКодов(МенеджерВТ);
	
	ТаблицаКодов_ВТ_ЗаполнитьКолонкуМожноУдалить(МенеджерВТ);
	ТаблицаКодов_ВТ_ЗаполнитьКолонкуМожноУдалитьСнизуВверх(МенеджерВТ);
	ТаблицаКодов_ВТ_ЗаполнитьКолонкуМожноУдалитьСверхуВниз(МенеджерВТ);
	
	Если ТаблицаКодов_ВТ_ЕстьКодыКоторыеМожноУдалить(МенеджерВТ) Тогда
		
		НачатьТранзакцию(РежимУправленияБлокировкой());
		Попытка
			ПолныеКоды_ВТ_Удалить(МенеджерВТ);
			КодыМаркировки_ВТ_Удалить(МенеджерВТ);
			ТоварыАгрегатов_ВТ_Удалить(МенеджерВТ);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Ошибка = ИнформацияОбОшибке();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьУстаревшиеПриемкиИВходящиеУПД()
	
	ПериодХранения = НастройкиМодуля().ПериодХраненияПриемокИВходящихУПД;
	Если Не ЗначениеЗаполнено(ПериодХранения) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	АктуальнаяДатаХранения = НачалоДня(ТекущаяДатаСеанса()) - ПериодХранения * СекундВСутках();
	
	Для Каждого Операция Из УстаревшиеОперации(ТипыОпераций.ВходящийУПД, АктуальнаяДатаХранения) Цикл
		Операции_Удалить(Операция);
	КонецЦикла;
	
	Для Каждого Операция Из УстаревшиеОперации(ТипыОпераций.УведомлениеОПриемке, АктуальнаяДатаХранения) Цикл
		Операции_Удалить(Операция);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьУстаревшиеАрхивыСКодамиДокументов()
	
	ПериодХранения = НастройкиМодуля().ПериодХраненияКодовДокументовВАрхиве;
	Если Не ЗначениеЗаполнено(ПериодХранения) Тогда
		Возврат;
	КонецЕсли;
	
	АктуальнаяДатаСоздания = НачалоДня(ТекущаяДатаСеанса()) - ПериодХранения * СекундВСутках();
	ТипФайла = Перечисление_ТипыФайлов().КодыДокумента;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.ТипФайла = &ТипФайла
	|	И Т.ДатаСоздания < &АктуальнаяДатаСоздания");
	Запрос.УстановитьПараметр("ТипФайла", ТипФайла);
	Запрос.УстановитьПараметр("АктуальнаяДатаСоздания", АктуальнаяДатаСоздания);
	
	Файлы_Удалить(МассивИзРезультатаЗапроса(Запрос));
	
КонецПроцедуры

Процедура УдалитьУстаревшуюИсториюЗапросовВСервис()
	
	СрокХраненияЛогов = 7;
	
	ТипФайла = Перечисление_ТипыФайлов().ДеталиЗапросаВСервис;
	ГраницаХраненияЛогов = НачалоДня(ТекущаяДатаСеанса()) - (СрокХраненияЛогов * СекундВСутках());
	УдалитьЛогиУспешныхОпераций = НастройкиМодуля().НеХранитьЛогиУспешныхОпераций;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	СтатусыУспешнойОперации = Новый Массив;
	СтатусыУспешнойОперации.Добавить(СтатусыОпераций.ОперацияЗавершена);
	СтатусыУспешнойОперации.Добавить(СтатусыОпераций.ОперацияОтменена);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Файлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла ССЫЛКА Справочник.КонтурМаркировка_Операции
	|	И Файлы.ДатаСоздания < &ГраницаХраненияЛогов
	|	И Файлы.ТипФайла = &ТипФайла
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Файлы.Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Файлы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_СтатусыОпераций КАК УспешныеОперации
	|		ПО Файлы.ВладелецФайла = УспешныеОперации.Операция
	|			И (УспешныеОперации.Статус В (&СтатусыУспешнойОперации))
	|ГДЕ
	|	&УдалитьЛогиУспешныхОпераций
	|	И Файлы.ВладелецФайла ССЫЛКА Справочник.КонтурМаркировка_Операции
	|	И Файлы.ДатаСоздания >= &ГраницаХраненияЛогов
	|	И Файлы.ТипФайла = &ТипФайла");
	Запрос.УстановитьПараметр("УдалитьЛогиУспешныхОпераций", УдалитьЛогиУспешныхОпераций);
	Запрос.УстановитьПараметр("СтатусыУспешнойОперации", СтатусыУспешнойОперации);
	Запрос.УстановитьПараметр("ГраницаХраненияЛогов", ГраницаХраненияЛогов);
	Запрос.УстановитьПараметр("ТипФайла", ТипФайла);
	
	Файлы_Удалить(МассивИзРезультатаЗапроса(Запрос));
	
КонецПроцедуры

Функция ЗаказыСИстекшимСрокомЖизниКодов()
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПоместитьТаблицуВЗапрос(МенеджерВТ, СрокиЖизниКодовПоВидамПродукции(), "СрокиЖизниКодов", "ВидПродукции");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КодыЗаказов.ЗаказКодов КАК ЗаказКодов,
	|	КодыЗаказов.ЗаказКодов.ВидПродукции КАК ВидПродукции
	|ПОМЕСТИТЬ ПодходящиеЗаказы
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыЗаказов КАК КодыЗаказов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК ТипОплатыКодов
	|		ПО КодыЗаказов.ЗаказКодов = ТипОплатыКодов.Объект
	|			И (ТипОплатыКодов.ИмяРеквизита = &ТипОплатыКодов)
	|ГДЕ
	|	ТипОплатыКодов.Значение = &ПоНанесению
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПодходящиеЗаказы.ЗаказКодов КАК ЗаказКодов
	|ИЗ
	|	ПодходящиеЗаказы КАК ПодходящиеЗаказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СрокиЖизниКодов КАК СрокиЖизниКодов
	|		ПО ПодходящиеЗаказы.ВидПродукции = СрокиЖизниКодов.ВидПродукции
	|ГДЕ
	|	СрокиЖизниКодов.СрокЖизни - РАЗНОСТЬДАТ(ПодходящиеЗаказы.ЗаказКодов.Дата, &ТекущаяДата, ДЕНЬ) < 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	БитыеЗаказы.ЗаказКодов
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КодыЗаказов КАК БитыеЗаказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО БитыеЗаказы.ЗаказКодов = Операции.Ссылка
	|ГДЕ
	|	Операции.Ссылка ЕСТЬ NULL");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТипОплатыКодов", Перечисление_ИменаДопРеквизитов().ТипОплатыКодов);
	Запрос.УстановитьПараметр("ПоНанесению", Перечисление_ТипыОплатыКодов().ПоНанесению);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "ЗаказКодов");
	
КонецФункции

Функция СрокиЖизниКодовПоВидамПродукции()
	
	КлючКэш = "СрокиЖизниКодовПоВидамПродукции";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("СрокЖизни", ОписаниеТипа_Число());
	Результат.Колонки.Добавить("ВидПродукции", ОписаниеТипа_ВидПродукции());
	
	УдалятьДоАннулирования = НастройкиМодуля().ПериодУдаленияКодовДляПечатиДоАннулирования;
	
	СрокЖизни = 60;
	Для каждого ВидПродукции Из ВидыПродукцииСоСрокомЖизниКода60Дней() Цикл
		Стр = Результат.Добавить();
		Стр.СрокЖизни = СрокЖизни - УдалятьДоАннулирования;
		Стр.ВидПродукции = ВидПродукции;
	КонецЦикла;
	
	СрокЖизни = 30;
	Для каждого ВидПродукции Из ВидыПродукцииСоСрокомЖизниКода30Дней() Цикл
		Стр = Результат.Добавить();
		Стр.СрокЖизни = СрокЖизни - УдалятьДоАннулирования;
		Стр.ВидПродукции = ВидПродукции;
	КонецЦикла;
	
	СрокЖизни = 999; // Без срока жизни
	Для каждого ВидПродукции Из ВсеВидыПродукции() Цикл
		Если Результат.Найти(ВидПродукции, "ВидПродукции") = Неопределено Тогда
			Стр = Результат.Добавить();
			Стр.СрокЖизни = СрокЖизни;
			Стр.ВидПродукции = ВидПродукции;
		КонецЕсли;
	КонецЦикла;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ВидыПродукцииСоСрокомЖизниКода60Дней()
	
