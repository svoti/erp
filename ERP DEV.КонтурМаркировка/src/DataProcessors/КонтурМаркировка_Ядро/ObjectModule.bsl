		Для каждого КодМаркировки Из КодыОпераций_КодыМаркировки(Операция, Стр.КлючСтрокиОперации, Ложь, Истина) Цикл
			unit = Новый Структура;
			unit.Вставить("aggregationUnitCapacity", КоличествоВложений);
			unit.Вставить("unitSerialNumber", КодМаркировки);
			aggregationUnits.Добавить(unit);
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.Вставить("aggregationUnits", aggregationUnits);
	
	Возврат Результат;
	
КонецФункции

Функция Контент_РегистрацияКИГУ(ОписаниеОперации)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	КлючСтрокиОперации = ОписаниеОперации.КлючСтрокиОперацииОснования;
	
	ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, КлючСтрокиОперации);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Результат = Новый Структура;
	Результат.Вставить("productGroup", ТоварнаяГруппаВСервисе(ВидПродукции));
	Результат.Вставить("fillingType", "InnerList");
	
	aggregationUnits = Новый Массив;
	Для Каждого Стр Из ТаблицаКодов Цикл
		КодыМаркировки = КодыМаркировки_ВложенныеКодыМаркировки(Стр.КлючКода, Ложь);
		unit = Новый Структура;
		unit.Вставить("aggregationUnitCapacity", КодыМаркировки.Количество());
		unit.Вставить("unitSerialNumber", Стр.КодМаркировки);
		unit.Вставить("sntins", КодыМаркировки);
		aggregationUnits.Добавить(unit);
	КонецЦикла;
	
	Результат.Вставить("aggregationUnits", aggregationUnits);
	
	Возврат Результат;
	
КонецФункции

