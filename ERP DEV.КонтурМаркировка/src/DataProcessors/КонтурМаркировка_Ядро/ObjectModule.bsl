Функция Новый_РазрешительныйДокумент() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Наименование", "");
	Результат.Вставить("ВидДокумента", "");
	Результат.Вставить("Номер", "");
	Результат.Вставить("Серия", "");
	Результат.Вставить("ГлобальныйИдентификаторПродукции", "");
	Результат.Вставить("ДатаОформления", ПустаяДата());
	Результат.Вставить("ДатаОкончанияДействия", ПустаяДата());
	Результат.Вставить("Активен", Истина);
	
	Возврат Результат;
	
КонецФункции

Функция РазрешительныйДокумент_Прочитать(РазрешительныйДокумент) Экспорт
	
	Результат = Новый_РазрешительныйДокумент();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Наименование КАК Наименование,
	|	Т.ВидДокумента КАК ВидДокумента,
	|	Т.Код КАК Номер,
	|	Т.ДатаОформления КАК ДатаОформления,
	|	Т.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	Т.Серия КАК Серия,
	|	Т.ГлобальныйИдентификаторПродукции КАК ГлобальныйИдентификаторПродукции,
	|	Т.Активен КАК Активен
	|ИЗ
	|	Справочник.КонтурМаркировка_РазрешительныеДокументы КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", РазрешительныйДокумент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Иначе
		Результат.Ссылка = РазрешительныйДокумент;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазрешительныйДокумент_Записать(ОписаниеРД) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписаниеРД.Ссылка) Тогда
		ОписаниеРД.Ссылка = РазрешительныйДокумент_НайтиПоНомеру(ОписаниеРД.Номер);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеРД.Ссылка) Тогда
		ПроверитьОбъектВПроцессеОбновления(ОписаниеРД.Ссылка);
		Объект = ОписаниеРД.Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.КонтурМаркировка_РазрешительныеДокументы.СоздатьЭлемент();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеРД.ДатаОкончанияДействия)
		И ОписаниеРД.ДатаОкончанияДействия < ТекущаяДатаСеанса() Тогда
		ОписаниеРД.Активен = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеРД.Наименование) Тогда
		ОписаниеРД.Наименование = РазрешительныйДокумент_СформироватьНаименование(
		ОписаниеРД.ВидДокумента, ОписаниеРД.Номер, ОписаниеРД.ДатаОформления);
	КонецЕсли;
	
	Если Объект.Код <> ОписаниеРД.Номер Тогда
		Объект.Код = ОписаниеРД.Номер;
	КонецЕсли;
	Если Объект.Наименование <> ОписаниеРД.Наименование Тогда
		Объект.Наименование = ОписаниеРД.Наименование;
	КонецЕсли;
	Если Объект.ВидДокумента <> ОписаниеРД.ВидДокумента Тогда
		Объект.ВидДокумента = ОписаниеРД.ВидДокумента;
	КонецЕсли;
	Если Объект.ДатаОформления <> ОписаниеРД.ДатаОформления Тогда
		Объект.ДатаОформления = ОписаниеРД.ДатаОформления;
	КонецЕсли;
	Если Объект.ДатаОкончанияДействия <> ОписаниеРД.ДатаОкончанияДействия Тогда
		Объект.ДатаОкончанияДействия = ОписаниеРД.ДатаОкончанияДействия;
	КонецЕсли;
	Если Объект.ГлобальныйИдентификаторПродукции <> ОписаниеРД.ГлобальныйИдентификаторПродукции Тогда
		Объект.ГлобальныйИдентификаторПродукции = ОписаниеРД.ГлобальныйИдентификаторПродукции;
	КонецЕсли;
	Если Объект.Активен <> ОписаниеРД.Активен Тогда
		Объект.Активен = ОписаниеРД.Активен;
	КонецЕсли;
	
	Если Объект.Модифицированность() Тогда
		Объект.Записать();
	КонецЕсли;
	
	ОписаниеРД.Ссылка = Объект.Ссылка;
	
	Возврат Объект.Ссылка;
	
КонецФункции

Функция РазрешительныйДокумент_НайтиПоНомеру(Номер)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_РазрешительныеДокументы КАК Т
	|ГДЕ
	|	Т.Код = &Код");
	Запрос.УстановитьПараметр("Код", Номер);
	
	Возврат ПолучитьРезультатЗапроса(Запрос);
	
КонецФункции

Функция РазрешительныйДокумент_СформироватьНаименование(ВидДокумента, Номер, ДатаОформления) Экспорт
	
	Шаблон = "%1 %2 от %3";
	ВидРД = СокращенныеПредставленияВидовРазрешительныхДокументов().Получить(ВидДокумента);
	Результат = ПараметрыВСтроку(Шаблон, ВидРД, Номер, Формат(ДатаОформления, "ДФ=dd.MM.yyyy"));
	
	Возврат Результат;
	
КонецФункции

