//  Организация - СправочникСсылка.КонтурМаркировка_Организации - Организация
//
Процедура Метрика_Функциональность_НормализаторВСервисе(Организация)
	
	Функциональность = Перечисление_ФункциональностьМодуля().НормализаторВСервисе;
