Функция ДеталиЗапросаВСервис(ФайлЗапроса) Экспорт
	
	ОписаниеФайла = Файл_Прочитать(ФайлЗапроса);
	Если Не ЗначениеЗаполнено(ОписаниеФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый_ДеталиЗапросаВСервис();
	
	ЗаполнитьПоляСтруктуры(Результат, ОписаниеФайла.ДанныеФайла, , , Истина);
	
	Возврат Результат;
	
КонецФункции

Функция АрхивЗапросаВСервис(ФайлЗапроса) Экспорт
	
	// BSLLS:FileSystemAccess-off
	// BSLLS:UsingSynchronousCalls-off
	
	ВременныйКаталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ВременныйКаталог);
	
	ЗаписатьНаДискДеталиЗапросаВСервис(ФайлЗапроса, ВременныйКаталог);
	
	ИмяФайла = ФайлЗапроса.ИмяФайла;
	Если ЗначениеЗаполнено(ФайлЗапроса.Идентификатор) Тогда
		ИмяФайла = ИмяФайла + " - " + ФайлЗапроса.Идентификатор;
	КонецЕсли;
	ИмяФайла = ИмяФайла + ".zip";
	
	ПутьКФайлу = МодульОбщегоНазначения().ОбъединитьПути(ВременныйКаталог, ИмяФайла);
	
	ЗаписьZip = Новый ЗаписьZipФайла(ПутьКФайлу);
	Для Каждого Файл Из НайтиФайлы(ВременныйКаталог, "*.json") Цикл
		ЗаписьZip.Добавить(Файл.ПолноеИмя);
	КонецЦикла;
	ЗаписьZip.Записать();
	
	АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу));
	
	УдалитьФайлы(ВременныйКаталог);
	
	// BSLLS:UsingSynchronousCalls-on
	// BSLLS:FileSystemAccess-on
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", ИмяФайла);
	Результат.Вставить("АдресФайла", АдресФайла);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьВИсториюЗапросовВСервис(ОписаниеЗадачи, ОписаниеЗапроса, ОписаниеОтвета)
	
	ТребуемоеДействие = ОписаниеЗадачи.ТребуемоеДействие;
	Если Не ЗначениеЗаполнено(ТребуемоеДействие) 
		Или Найти(НРег(ТребуемоеДействие), НРег("Проверить")) > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДеталиЗапроса = Новый_ДеталиЗапросаВСервис();
	
	ЗаполнитьЗначенияСвойств(ДеталиЗапроса, ОписаниеЗапроса);
	ЗаполнитьЗначенияСвойств(ДеталиЗапроса, ОписаниеОтвета);
	ЗаполнитьЗначенияСвойств(ДеталиЗапроса.Запрос, ОписаниеЗапроса);
	ЗаполнитьЗначенияСвойств(ДеталиЗапроса.Ответ, ОписаниеОтвета);
	
	ДеталиЗапроса.Метод = ОписаниеЗапроса.Метод + " " + ОписаниеЗапроса.ПутьНаСервере;
	ДеталиЗапроса.TraceId = ОписаниеОтвета.Заголовки["x-kontur-trace-id"];
	ДеталиЗапроса.ДатаЗапроса = ОписаниеЗапроса.ДатаЗапроса;
	
	Успех = МассивСодержитЗначение(ОписаниеЗапроса.ДопустимыеКодыОтвета, ОписаниеОтвета.КодОтвета);
	
	ДеталиЗапроса.КодОтвета = Строка(ОписаниеОтвета.КодОтвета);
	Если Успех Тогда
		ДеталиЗапроса.КодОтвета = ДеталиЗапроса.КодОтвета + " OK";
	КонецЕсли;
	
	Authorization = ОписаниеЗапроса.Заголовки["Authorization"];
	Если ЗначениеЗаполнено(Authorization) Тогда
		ДеталиЗапроса.Запрос.Заголовки = СкопироватьОбъект(ОписаниеЗапроса.Заголовки);
		ДеталиЗапроса.Запрос.Заголовки["Authorization"] = ТокенБезСекрета(Authorization);
	КонецЕсли;
	
	ОписаниеФайла = Новый_ОписаниеФайла();
	ОписаниеФайла.ВладелецФайла = ОписаниеЗадачи.Операция;
	ОписаниеФайла.ПодписанЭП = Успех;
	ОписаниеФайла.ИмяФайла = ТребуемоеДействие;
	ОписаниеФайла.ДанныеФайла = ДеталиЗапроса;
	ОписаниеФайла.Идентификатор = ДеталиЗапроса.TraceId;
	ОписаниеФайла.ТипФайла = Перечисление_ТипыФайлов().ДеталиЗапросаВСервис;
	
	Файл_Записать(ОписаниеФайла);
	
КонецПроцедуры

Процедура ЗаписатьНаДискДеталиЗапросаВСервис(ФайлЗапроса, Каталог)
	
	ДеталиЗапроса = ДеталиЗапросаВСервис(ФайлЗапроса);
	
	ДеталиЗапроса.ДатаЗапроса = СтрокаУниверсальнойДатыXML(ДеталиЗапроса.ДатаЗапроса);
	
	ПоляФайла = СкопироватьПоляСтруктуры(ДеталиЗапроса, "Запрос, Ответ");
	ЗаписатьТекстВФайл(ЗначениеВСтрокуJSON(ПоляФайла), "common-data.json", Каталог);
	
	ПоляФайла = Новый Соответствие;
	ДополнитьСтруктуру(ПоляФайла, ДеталиЗапроса.Запрос.Параметры);
	ДополнитьСтруктуру(ПоляФайла, ДеталиЗапроса.Запрос.Заголовки);
	ЗаписатьТекстВФайл(ЗначениеВСтрокуJSON(ПоляФайла), "request-meta.json", Каталог);
	ЗаписатьТекстВФайл(ДеталиЗапроса.Запрос.ТелоЗапроса, "request-body.json", Каталог);
	
	ПоляФайла = Новый Соответствие;
	ДополнитьСтруктуру(ПоляФайла, ДеталиЗапроса.Ответ.Заголовки);
	ЗаписатьТекстВФайл(ЗначениеВСтрокуJSON(ПоляФайла), "response-meta.json", Каталог);
	ЗаписатьТекстВФайл(ДеталиЗапроса.Ответ.ТелоОтвета, "response-body.json", Каталог);
	
КонецПроцедуры

Функция Новый_ДеталиЗапросаВСервис()
	
	Результат = Новый Структура;
	Результат.Вставить("TraceId");
	Результат.Вставить("КодОтвета");
	Результат.Вставить("ДатаЗапроса");
	
	Результат.Вставить("Хост");
