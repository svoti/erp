Функция ОбновлениеДанных_ЕстьТовары()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьТовары
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК Т
	|ГДЕ
	|	Т.Версия В(&ДопустимыеВерсии)
	|	И Т.Объект ССЫЛКА Справочник.КонтурМаркировка_Товары");
	Запрос.УстановитьПараметр("ДопустимыеВерсии", МассивЗначенийИзСтруктуры(Перечисление_ВерсииДанныхПодсистемы()));
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ОбновлениеДанных_Запрос()
	
	// BSLLS:RefOveruse-off
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Товар КАК Товар,
	|	МАКСИМУМ(Т.Дата) КАК Дата
	|ПОМЕСТИТЬ ДатыИспользованияТоваров
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.Товар КАК Товар,
	|		МАКСИМУМ(Т.Ссылка.Дата) КАК Дата
	|	ИЗ
	|		Справочник.КонтурМаркировка_ДокументыУчета.ТоварыМаркировки КАК Т
	|	ГДЕ
	|		&ЕстьТовары
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Т.Товар
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Т.Товар,
	|		МАКСИМУМ(Т.Ссылка.Дата)
	|	ИЗ
	|		Справочник.КонтурМаркировка_Операции.Товары КАК Т
	|	ГДЕ
	|		&ЕстьТовары
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Т.Товар) КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Товар
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбновлениеДанных.Объект КАК Объект,
	|	ОбновлениеДанных.Версия КАК Версия,
	|	НАЧАЛОПЕРИОДА(ДокументыУчета.Дата, НЕДЕЛЯ) КАК Неделя
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК ОбновлениеДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_ДокументыУчета КАК ДокументыУчета
	|		ПО ОбновлениеДанных.Объект = ДокументыУчета.Ссылка
	|ГДЕ
	|	ОбновлениеДанных.Версия В(&ДопустимыеВерсии)
	|	И ОбновлениеДанных.Объект ССЫЛКА Справочник.КонтурМаркировка_ДокументыУчета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОбновлениеДанных.Объект,
	|	ОбновлениеДанных.Версия,
	|	НАЧАЛОПЕРИОДА(Операции.Дата, НЕДЕЛЯ)
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК ОбновлениеДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ОбновлениеДанных.Объект = Операции.Ссылка
	|ГДЕ
	|	ОбновлениеДанных.Версия В(&ДопустимыеВерсии)
	|	И ОбновлениеДанных.Объект ССЫЛКА Справочник.КонтурМаркировка_Операции
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОбновлениеДанных.Объект,
	|	ОбновлениеДанных.Версия,
	|	НАЧАЛОПЕРИОДА(Файлы.ДатаСоздания, НЕДЕЛЯ)
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК ОбновлениеДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Файлы КАК Файлы
	|		ПО ОбновлениеДанных.Объект = Файлы.Ссылка
	|ГДЕ
	|	ОбновлениеДанных.Версия В(&ДопустимыеВерсии)
	|	И ОбновлениеДанных.Объект ССЫЛКА Справочник.КонтурМаркировка_Файлы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбновлениеДанных.Объект,
	|	ОбновлениеДанных.Версия,
	|	НАЧАЛОПЕРИОДА(ЕСТЬNULL(ДатыИспользованияТоваров.Дата, &ПустаяДата), НЕДЕЛЯ)
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК ОбновлениеДанных
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДатыИспользованияТоваров КАК ДатыИспользованияТоваров
	|		ПО ОбновлениеДанных.Объект = ДатыИспользованияТоваров.Товар
	|ГДЕ
	|	ОбновлениеДанных.Версия В(&ДопустимыеВерсии)
	|	И ОбновлениеДанных.Объект ССЫЛКА Справочник.КонтурМаркировка_Товары
	|
	|УПОРЯДОЧИТЬ ПО
	|	Неделя УБЫВ,
	|	Версия
	|ИТОГИ ПО
	|	Неделя");
	// BSLLS:RefOveruse-on
	
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата());
	Запрос.УстановитьПараметр("ЕстьТовары", ОбновлениеДанных_ЕстьТовары());
	Запрос.УстановитьПараметр("ДопустимыеВерсии", МассивЗначенийИзСтруктуры(Перечисление_ВерсииДанныхПодсистемы()));
	
	Возврат Запрос;
	
КонецФункции

Процедура ОбновлениеДанных_КодыМаркировки_ОчиститьКоличествоУпаковокУНаборов()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИнформацияОКодах.КлючИнформацииОКоде КАК КлючИнформацииОКоде
	|ПОМЕСТИТЬ втИнформацияОКодах
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|ГДЕ
	|	ИнформацияОКодах.ОбщийТипУпаковки = &Набор
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючИнформацииОКоде
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыМаркировки.КлючКода КАК КлючКода,
	|	КодыМаркировки.ПорцияЗаписей КАК ПорцияЗаписей
	|ИЗ
	|	втИнформацияОКодах КАК ИнформацияОКодах
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	КодыМаркировки.КоличествоУпаковок > 1");
	
	Запрос.УстановитьПараметр("Набор", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.КонтурМаркировка_КодыМаркировки.СоздатьМенеджерЗаписи();
		Запись.КлючКода = Выборка.КлючКода;
		Запись.ПорцияЗаписей = Выборка.ПорцияЗаписей;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда 
			Запись.КоличествоУпаковок = 0;
			Запись.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти // ОбработчикиФоновогоОбновленияДанныхПодсистемы

// #Область ОбновлениеДанных

// Добавляет объекты в регистр фонового обновления
//
// Параметры:
//  Объекты - Массив, СправочникСсылка - объекты для обновления;
//  Версия - Строка - версия, на которую нужно обновить объекты;
//
Процедура ОбновлениеДанных_ДобавитьОбъекты(Объекты, Версия) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Колонка = "Объект";
	ТипКолонки = Метаданные.РегистрыСведений.КонтурМаркировка_ОбновлениеДанных.Измерения.Объект.Тип;
	ТаблицаОбъектов = Новый ТаблицаЗначений;
	ТаблицаОбъектов.Колонки.Добавить(Колонка, ТипКолонки);
	ТаблицаЗначений_ЗагрузитьМассив(ТаблицаОбъектов, Объекты, Колонка);
	ПоместитьТаблицуВЗапрос(МенеджерВТ, ТаблицаОбъектов, "ТаблицаОбъектов", Колонка);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаОбъектов.Объект КАК Объект,
	|	&Версия КАК Версия
	|ИЗ
	|	ТаблицаОбъектов КАК ТаблицаОбъектов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК ОбновлениеДанных
	|		ПО ТаблицаОбъектов.Объект = ОбновлениеДанных.Объект
	|			И (ОбновлениеДанных.Версия = &Версия)
	|ГДЕ
	|	ОбновлениеДанных.Версия ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаОбъектов");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Версия", Версия);
	
	Набор = ОбновлениеДанных_ОписаниеНабораЗаписей();
	Набор.РежимЗаписи = Перечисление_РежимыЗаписиНабора().Добавление;
	Набор.ТаблицаНабора = Запрос.Выполнить().Выгрузить();
	ЗаписатьНаборРегистраСведений(Набор);
	
КонецПроцедуры

// Удаляет объекты из регистра фонового обновления, если они были удалены в режиме загрузки
//
Процедура ОбновлениеДанных_УдалитьБитыеСсылки()
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	// BSLLS:RefOveruse-off
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Версия КАК Версия,
	|	Т.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК Т
	|ГДЕ
	|	Т.Объект.Ссылка ЕСТЬ NULL");
	// BSLLS:RefOveruse-on
	
	Набор = ОбновлениеДанных_ОписаниеНабораЗаписей();
	Набор.РежимЗаписи = Перечисление_РежимыЗаписиНабора().Удаление;
	Набор.ТаблицаНабора = Запрос.Выполнить().Выгрузить();
	Набор.ПоляОтбора = "";
	
	ЗаписатьНаборРегистраСведений(Набор);
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Удаляет объекты из регистра фонового обновления
//
// Параметры:
//  Объекты - Массив, СправочникСсылка - объект для удаления;
//  Версия - Строка - версия, на которую были обновлены объекты;
//
Процедура ОбновлениеДанных_УдалитьОбъекты(Объекты, Версия = Неопределено)
	
	Набор = ОбновлениеДанных_ОписаниеНабораЗаписей();
	Набор.РежимЗаписи = Перечисление_РежимыЗаписиНабора().Удаление;
	Набор.ПоляОтбора = "";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Т.Версия КАК Версия,
	|	Т.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК Т
	|ГДЕ
	|	Т.Объект В(&Объекты)
	|	И &УсловиеВерсии";
	
	Если ЗначениеЗаполнено(Версия) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВерсии", "Т.Версия = &Версия");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВерсии", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Объекты", ЗначениеВМассиве(Объекты));
	Запрос.УстановитьПараметр("Версия", Версия);
	
	Набор.ТаблицаНабора = Запрос.Выполнить().Выгрузить();
	
	ЗаписатьНаборРегистраСведений(Набор);
	
КонецПроцедуры

Функция ОбновлениеДанных_ОписаниеНабораЗаписей()
	
	Возврат Новый_ОписаниеНабораРегистраСведений("КонтурМаркировка_ОбновлениеДанных", "Версия");
	
КонецФункции

// Проверяет наличие объектов, которые нужно обновить в фоновом режиме
//
// Возвращаемое значение:
//  Булево - Истина, если есть хоть один объект;
//
Функция ЕстьОбъектыДляФоновогоОбновленияДанных() Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьОбъекты
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК Т
	|ГДЕ
	|	Т.Версия В (&ДопустимыеВерсии)");
	
	Запрос.УстановитьПараметр("ДопустимыеВерсии", МассивЗначенийИзСтруктуры(Перечисление_ВерсииДанныхПодсистемы()));
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Проверяет, находится ли объект в процессе обновления и вызывает ошибку
//
// Параметры:
//  Объект   - СправочникСсылка - объект, который нужно проверить;
//  ВызыватьИсключение - Булево - (необязательный) Ложь, если нужно отключить ошибку, чтобы только проверить;
// 
// Возвращаемое значение:
//  Булево - Истина, если объект не находится в процессе обновления;
//
Функция ПроверитьОбъектВПроцессеОбновления(Объект, ВызыватьИсключение = Истина) Экспорт
	
	Если РазрешеноЧтениеЗаписьОбъектовВПроцессеОбновления() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛОЖЬ КАК Результат
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОбновлениеДанных КАК Т
	|ГДЕ
	|	Т.Объект = &Объект");
	Запрос.УстановитьПараметр("Объект", Объект);
	
	Результат = Запрос.Выполнить().Пустой();
	
	Если Не Результат И ВызыватьИсключение Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр("ru = 'Объект находится в процессе обновления, чтение/запись запрещены: %1'"), Объект);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура РазрешитьЧтениеЗаписьОбъектовВПроцессеОбновления()
	
	Кэш_Поместить("РазрешеноЧтениеЗаписьОбъектовВПроцессеОбновления", Истина);
	
КонецПроцедуры

Процедура ЗапретитьЧтениеЗаписьОбъектовВПроцессеОбновления()
	
	Кэш_Поместить("РазрешеноЧтениеЗаписьОбъектовВПроцессеОбновления", Ложь);
	
КонецПроцедуры

Функция РазрешеноЧтениеЗаписьОбъектовВПроцессеОбновления()
	
	Возврат Кэш_Прочитать("РазрешеноЧтениеЗаписьОбъектовВПроцессеОбновления") = Истина;
	
КонецФункции

