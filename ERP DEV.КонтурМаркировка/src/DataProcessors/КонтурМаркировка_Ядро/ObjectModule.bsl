		Если Выборка.Количество = 0 Тогда
			Прервать;
		КонецЕсли;
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Таб1", "Таб2");
		ПоменятьМестамиСтрокиВТексте(ТекстЗапроса, "Итог1", "Итог2");
	КонецЦикла;
	
	УдалитьТаблицуИзЗапроса(МенеджерВТ, "ТаблицаКодов");
	
	ЕстьИтог1 = Найти(ТекстЗапроса, "ПОМЕСТИТЬ Итог1") > 0;
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ТаблицаКодов ИЗ Итог2 ИНДЕКСИРОВАТЬ ПО КлючКода; УНИЧТОЖИТЬ Таб2; УНИЧТОЖИТЬ Итог2";
	
