Функция Новый_РезультатПроверкиКодов()
	
	Результат = Новый Структура;
	
	Для каждого ИмяПоля Из Перечисление_ИменаПолейРезультатовПроверкиКодов() Цикл
		Результат.Вставить(ИмяПоля, "");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура РезультатыПроверкиКодов_Записать(РезультатПроверкиКода)
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		РезультатыПроверкиКодов_Заблокировать(РезультатПроверкиКода);
		
		Запись = РегистрыСведений.КонтурМаркировка_РезультатыПроверкиКодов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, РезультатПроверкиКода);
		Запись.ЕстьОшибка = РезультатыПроверкиКодов_ЕстьОшибки(РезультатПроверкиКода);
		Запись.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура РезультатыПроверкиКодов_Заблокировать(ОписаниеОшибки)
	
	Если Не ИспользуетсяУправляемыйРежимБлокировок() Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КонтурМаркировка_РезультатыПроверкиКодов");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для каждого КлючЗначение Из ОписаниеОшибки Цикл
		ЭлементБлокировки.УстановитьЗначение(КлючЗначение.Ключ, ОписаниеОшибки[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция РезультатыПроверкиКодов_ЕстьОшибки(РезультатПроверкиКода)
	
	Результат = Ложь;
	ВалидныеСтатусыПроверкиКода = Перечисление_ВалидныеСтатусыПроверкиКодаДокумента();
	
	Для Каждого Элемент Из РезультатПроверкиКода Цикл
		
		Если Не МассивСодержитЗначение(ВалидныеСтатусыПроверкиКода, Элемент.Значение) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РезультатыПроверкиКодов_ИменаПолей() Экспорт
	
	КлючКэш = "РезультатыПроверкиКодов_ИменаПолей";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВсеПоля = Новый Массив;
	Для каждого Измерение Из Метаданные.РегистрыСведений.КонтурМаркировка_РезультатыПроверкиКодов.Измерения Цикл
		Если Измерение.Имя <> "КлючПроверкиКода" Тогда
			ВсеПоля.Добавить(Измерение.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Результат = СоединитьСтроку(ВсеПоля, ",");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

