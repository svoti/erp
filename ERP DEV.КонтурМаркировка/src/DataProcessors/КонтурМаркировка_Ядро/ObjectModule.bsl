// Вычисляет значение числового показателя (веса, объема, и т.д.) по идентификатору применения (AI)
// Y в AI обозначает число знаков после запятой в следующем значении. Представленное значение является
// следующим целым числом, которое делится на 10Y. Например, чистый вес 22,7 кг может быть закодирован
// в качестве 3101 000227, 3102 002270, 3103 022700, или 3104 227000.
//
// Параметры:
//  Значение - Строка - Значение без запятой, которое нужно вычислить;
//  ИдентификаторПрименения - Строка - Идентификатор применения (AI);
// 
// Возвращаемое значение:
//  Число - значение с проставленной запятой по информации из идентифиатора применения (AI);
//
Функция ЗначениеЧисловогоПоказателяGS1(Показатель, ИдентификаторПрименения)
	
	Результат = 0;
	
	Если Не ЗначениеЗаполнено(Показатель) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Основание = 10;
	Степень = Число(Прав(ИдентификаторПрименения, 1));
	КодПрименения = Число(Лев(ИдентификаторПрименения, 3));
	
	Если КодПрименения < 310 Или КодПрименения > 393 Тогда
		ВызватьИсключение ПараметрыВСтроку(
		НСтр("ru = 'Неизвестный идентификатор применения(AI) %1.';
		|en = 'Unknown usage ID (AI) %1.'"), ИдентификаторПрименения);
	КонецЕсли;
	
	Результат = Число(Показатель) / Pow(Основание, Степень);
	
	Возврат Результат
	
КонецФункции

