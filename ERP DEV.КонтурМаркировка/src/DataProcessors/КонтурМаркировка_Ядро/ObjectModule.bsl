// Получает описание новой версии из сервиса обновлений
//
// Параметры:
//  Контент - Структура - см. КонтентДляПроверкиОбновления()
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * status- Строка - статус ответа;
//   * links- Массив - содержит ссылки на новую версию модуля и другой контент;
//   * description- Строка- описание новой версии;
//
Функция СервисОбновлений_ПроверитьОбновления(Контент, Продукт) Экспорт
	
	Результат = Мок_СервисОбновлений_ПроверитьОбновления(Контент, Продукт);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисОбновлений_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.Метод = "POST";
	Запрос.ПутьНаСервере = "/1c/v3/{product_name}/check";
	Запрос.Параметры.Вставить("product_name", Продукт);
	Запрос.ТелоЗапроса = ЗначениеВСтрокуJSON(Контент);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	
	Результат = Неопределено;
	Если Ответ.КодОтвета = КодОтвета_Успешно() Тогда
		Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает список версий, начиная с указанной в параметрах
//
// Параметры:
//  ТекущаяВерсия - Строка - старшая версия продукта
//  Продукт - Строка - старшая версия продукта
// 
// Возвращаемое значение:
//  Структура - содержит:
//   * status- Строка - статус ответа;
//   * links- Массив - содержит ссылки на новую версию модуля и другой контент;
//   * description- Строка- описание новой версии;
//
Функция СервисОбновлений_СписокВерсий(ТекущаяВерсия, Продукт) Экспорт
	
	Результат = Мок_СервисОбновлений_СписокВерсий(ТекущаяВерсия, Продукт);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисОбновлений_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.ПутьНаСервере = "/1c/v4/products/{product_name}/versions";
	Запрос.Параметры.Вставить("product_name", Продукт);
	Запрос.Параметры.Вставить("from_version", ТекущаяВерсия);
	Запрос.Параметры.Вставить("order", "desc");
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	
	Результат = Неопределено;
	Если Ответ.КодОтвета = 200 Тогда
		Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает описание версии продукта
//
// Параметры:
//  Продукт - Строка - имя продукта в сервисе обновлений;
//  Версия - Строка - версия продукта, которую необходимо получить;
//  ТестовоеОкружение - Булево - (необязательный) Истина, если необходимо использовать тестовое окружение;
// 
// Возвращаемое значение:
//  Структура - содержит:
//  * version - Строка - версия;
//  * description- Строка - описание;
//  * release_date- Строка- дата публикации;
//  * content - Соответствие - содержит:
//  ** name - Строка - тип контента;
//  ** filename - Строка - имя файла;
//  ** md5hash - Строка - MD5 хэш;
//  ** src_checksum - Строка - контрольная сумма исходников;
//  ** drive_public_link - Строка - публичная ссылка для скачивания;
//
Функция СервисОбновлений_ОписаниеВерсии(Продукт, Версия, ТестовоеОкружение = Неопределено) Экспорт
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисОбновлений_ЗаполнитьОбщиеНастройкиHTTP(Запрос, ТестовоеОкружение);
	
	Запрос.ПутьНаСервере = "/1c/v4/products/{product_name}/versions/{version_name}";
	Запрос.Параметры.Вставить("product_name", Продукт);
	Запрос.Параметры.Вставить("version_name", Версия);
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	
	Результат = Неопределено;
	Если Ответ.КодОтвета = КодОтвета_Успешно() Тогда
		Результат = ЗначениеИзСтрокиJSON(Ответ.ТелоОтвета, Истина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Скачивает файл нужной версии продукта из сервиса обновлений
//
// Параметры:
//  Продукт - Строка - имя продукта в сервисе обновлений;
//  Версия - Строка - версия продукта;
//  ТипКонтента - Строка - тип контента, который необходимо скачать;
// 
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция СервисОбновлений_ФайлВерсии(Продукт, Версия, ТипКонтента) Экспорт
	
	Запрос = Новый_ОписаниеЗапросаHTTP();
	СервисОбновлений_ЗаполнитьОбщиеНастройкиHTTP(Запрос);
	
	Запрос.ПутьНаСервере = "/1c/v1/{product_name}/{content_type}";
	Запрос.Параметры.Вставить("product_name", Продукт);
	Запрос.Параметры.Вставить("content_type", ТипКонтента);
	Запрос.Параметры.Вставить("version", Версия);
	Запрос.ТелоОтветаКакДвоичныеДанные = Истина;
	
	Ответ = ВыполнитьHTTPЗапрос(Запрос);
	
	Результат = Неопределено;
	Если Ответ.КодОтвета = КодОтвета_Успешно() Тогда
		Результат = Ответ.ТелоОтвета;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет в описании запроса HTTP параметры сервиса и настройки прокси
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеЗапросаHTTP()
//  ТестовоеОкружение - Булево - (необязательный) Истина, если необходимо использовать тестовое окружение;
//
Процедура СервисОбновлений_ЗаполнитьОбщиеНастройкиHTTP(ОписаниеЗапроса, ТестовоеОкружение = Неопределено)
	
	ОписаниеСервиса = СервисОбновлений_ОписаниеСервиса(ТестовоеОкружение);
	ЗаполнитьЗначенияСвойств(ОписаниеЗапроса, ОписаниеСервиса);
	
	ОписаниеЗапроса.Заголовки.Вставить("Accept", "application/json");
	ОписаниеЗапроса.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	ОписаниеЗапроса.ОтправитьОшибкуЧасовому = Ложь;
	
	ЗаполнитьНастройкиПроксиСервера(ОписаниеЗапроса);
	
КонецПроцедуры

Функция СервисОбновлений_ОписаниеСервиса(Знач ТестовоеОкружение = Неопределено)
	
	Если ТестовоеОкружение = Неопределено Тогда
		ТестовоеОкружение = НастройкиМодуля().ТестовоеОкружение;
	КонецЕсли;
	
	Если ТестовоеОкружение Тогда
		АдресСервиса = ИнтернетАдреса().СервисОбновленийТестовый;
	Иначе
		АдресСервиса = ИнтернетАдреса().СервисОбновлений;
	КонецЕсли;
	
	Результат = СтруктураURI(АдресСервиса);
	
	Возврат Результат;
	
КонецФункции

