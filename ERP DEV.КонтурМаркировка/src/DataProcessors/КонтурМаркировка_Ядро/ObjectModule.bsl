// #Область Товары
Функция Товар_Записать(ОписаниеТовара) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписаниеТовара.GTIN) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен код товара (GTIN)'");
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Товар_Заблокировать(ОписаниеТовара.GTIN);
		Товар_ПроверитьФорматGTIN(ОписаниеТовара.GTIN);
		Товар_ПроверитьУникальностьGTIN(ОписаниеТовара.GTIN, ОписаниеТовара.Ссылка);
		
		Если ЗначениеЗаполнено(ОписаниеТовара.Ссылка) Тогда
			ПроверитьОбъектВПроцессеОбновления(ОписаниеТовара.Ссылка);
			Объект = ОписаниеТовара.Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.КонтурМаркировка_Товары.СоздатьЭлемент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Объект, ОписаниеТовара, , "Ссылка");
		
		Товар_Записать_СоставНабора(Объект, ОписаниеТовара);
		Товар_Записать_УсловияХранения(Объект, ОписаниеТовара);
		Товар_Записать_РазрешительнаяДокументация(Объект, ОписаниеТовара);
		
		Объект.Код = ОписаниеТовара.GTIN;
		Объект.НаименованиеТовара = ОписаниеТовара.Наименование;
		
		Объект.Записать();
		
		ОписаниеТовара.Ссылка = Объект.Ссылка;
		
		ДопРеквизиты_Записать(ОписаниеТовара.Ссылка, ОписаниеТовара.ДопРеквизиты);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Объект.Ссылка;
	
КонецФункции

Функция Товар_Прочитать(Ссылка, КэшРезультатов = Неопределено) Экспорт
	
	Если КэшРезультатов <> Неопределено Тогда
		Результат = КэшРезультатов[Ссылка];
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый_Товар();
	ЗаполнитьЗначенияСвойств(Результат, Ссылка, , "Наименование, СоставНабора, УсловияХранения, РазрешительнаяДокументация");
	Результат.Наименование = Ссылка.НаименованиеТовара;
	
	Если Ссылка.ТипКодаМаркировки = Перечисления.КонтурМаркировка_ТипыКодовМаркировки.Набор Тогда
		Товар_Прочитать_СоставНабора(Результат);
	КонецЕсли;
	
	Товар_Прочитать_УсловияХранения(Результат);
	Товар_Прочитать_РазрешительнаяДокументация(Результат);
	Товар_Прочитать_ДопРеквизиты(Результат);
	
	Если КэшРезультатов <> Неопределено Тогда
		КэшРезультатов.Вставить(Ссылка, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Товар_ПоддерживаетОСУВДокументе(ОписаниеТовара, ПараметрыПроверки)
	
	Возврат МодульКонтроль().Товар_ПоддерживаетОСУВДокументе(ОписаниеТовара, ПараметрыПроверки);
	
