Функция ОчередьОбмена_ВводВОборот_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусыКодовВводаВОборот);
	Результат.Добавить(ТребуемыеДействия.СоздатьРегистрациюСтрокВводаВОборот);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеВводВОборот);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписиВводаВОборот);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	Результат.Добавить(ТребуемыеДействия.ПроверитьГотовностьВводаВОборот);
	Результат.Добавить(ТребуемыеДействия.РасформироватьАТКПослеРегистрации);
	Результат.Добавить(ТребуемыеДействия.ПроверитьРегистрациюСтрокВводаВОборот);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ВводВОборот_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ПроверитьСтатусыКодовВводаВОборот Тогда
		Задача_ВводВОборот_ПроверитьСтатусыКодов(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьРегистрациюСтрокВводаВОборот Тогда
		Задача_ВводВОборот_СоздатьВводНаКаждуюСтроку(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеВводВОборот Тогда
		Задача_ВводВОборот_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписиВводаВОборот Тогда
		Задача_ВводВОборот_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ВводВОборот_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьГотовностьВводаВОборот Тогда
		Задача_ВводВОборот_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.РасформироватьАТКПослеРегистрации Тогда
		Задача_ВводВОборот_РасформироватьАТКПослеРегистрации(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьРегистрациюСтрокВводаВОборот Тогда
		Задача_ВводВОборот_ПроверитьСтатусыСтрок(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

// #Область ОбработкаВсехСтрокВводаВОборот

Процедура Задача_ВводВОборот_ПроверитьСтатусыКодов(ОписаниеЗадачи)
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ПодходящиеСтатусы = Операция_ВводВОборот_ПодходящиеСтатусыКодов();
	СтатусНанесен = Перечисление_СтатусыКодов().Нанесен;
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	
	ДатаПоследнегоОбновленияСтатусов = ОписаниеЗадачи.ДопРеквизиты.ДатаОбновленияСтатусовКодов;
	ПрошлоВремени = ТекущаяДатаСеанса() - ДатаПоследнегоОбновленияСтатусов;
	
	Если ПрошлоВремени > СекундВМинуте() Тогда
		Операция_ОбновитьСтатусыКодов(Операция, СтатусНанесен);
		ОписаниеЗадачи.ДопРеквизиты.ДатаОбновленияСтатусовКодов = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ТаблицаКодов.Колонки.Добавить("КоличествоКодов", ОписаниеТипа_Число());
	ТаблицаКодов.ЗаполнитьЗначения(1, "КоличествоКодов");
	ТаблицаКодов.Свернуть("Статус", "КоличествоКодов");
	
	ВсеКодыНанесены = Истина;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.Статус <> СтатусНанесен Тогда
			ВсеКодыНанесены = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ВсеКодыНанесены Тогда
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.СоздатьРегистрациюСтрокВводаВОборот;
		Задача_Записать(ОписаниеЗадачи);
		Возврат;
	КонецЕсли;
	
	СписокСтатусов = Новый Массив;
	ЕстьНедопустимыйСтатус = Ложь;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если ПодходящиеСтатусы.Найти(Стр.Статус) = Неопределено Тогда
			ЕстьНедопустимыйСтатус = Истина;
			СтрокаСтатуса = НСтр("ru = '%1 - %2 кодов (недопустимый статус)'");
		Иначе
			СтрокаСтатуса = НСтр("ru = '%1 - %2 кодов'");
		КонецЕсли;
		СписокСтатусов.Добавить(ПараметрыВСтроку(СтрокаСтатуса, Стр.Статус, Стр.КоличествоКодов));
	КонецЦикла;
	
	Если ЕстьНедопустимыйСтатус Тогда
		
		ТекстОшибки = ПараметрыВСтроку(
		НСтр("ru = 'Обнаружен недопустимый для ввода в оборот статус!
		|%1'"), СоединитьСтроку(СписокСтатусов, Символы.ПС));
		
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
		
	Иначе
		
		Действие = НСтр("ru = 'Ввод в оборот'");
		ТекстПредупреждения = НСтр(
		"ru = 'Отложена регистрация ввода в оборот в ГИС МТ,
		|еще не все коды находятся в статусе %1'");
		ТекстПредупреждения = ПараметрыВСтроку(ТекстПредупреждения, СтатусНанесен);
		ЗафиксироватьПредупреждение(Действие, ТекстПредупреждения, СписокСтатусов, Операция);
		
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПроверитьСтатусыКодовВводаВОборот;
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОжиданиеСтатусаКодовНанесен;
		
	КонецЕсли;
	
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_СоздатьВводНаКаждуюСтроку(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	Если Не КодыОпераций_ЕстьКоды(Операция) Тогда
		ТекстОшибки = НСтр("ru = 'Ввод в оборот не содержит кодов'");
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиВводаВОборот;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(ОписаниеЗадачи.Операция, ТипОпераций, Истина);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если КодыОпераций_ЕстьКоды(Операция, Стр.КлючСтрокиОперации) Тогда
			Операция_СоздатьРегистрациюСтрокиВводаВОборот(ОписаниеОперации, Стр);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьРегистрациюСтрокВводаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_ПроверитьСтатусыСтрок(ОписаниеЗадачи)
	
	ТипОпераций = Перечисление_ТипыОпераций().РегистрацияСтрокиВводаВОборот;
	ВсеЗадачиЗавершены = Задача_ВсеПодчиненныеОперацииЗавершены(ОписаниеЗадачи.Операция, ТипОпераций);
	Если Не ВсеЗадачиЗавершены Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиВПодчиненных = Задача_ЕстьОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
	
	Если ЕстьОшибкиВПодчиненных Тогда
		
		ВсеОшибки = Задача_ОшибкиВПодчиненныхОперациях(ОписаниеЗадачи.Операция, ТипОпераций);
		ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ИсправитьОшибку;
		ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОшибкаОбработки;
		ОписаниеЗадачи.ОписаниеОшибки = СоединитьСтроку(ВсеОшибки, Символы.ПС);
		Задача_Записать(ОписаниеЗадачи);
		
	Иначе
		Задача_Завершить(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти // ОбработкаВсехСтрокВводаВОборот

// #Область ОбработкаКаждойСтрокиВводаВОборот

Процедура Задача_ВводВОборот_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	СпособВводаВОборот = ДопРеквизит_Прочитать(ОперацияОснование, "СпособВводаВОборот");
	Контент = Контент_ВводВОборот(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_ВводВОборот_Создать(ОписаниеЗадачи, Контент, СпособВводаВОборот);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписиВводаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ВводВОборот(ОписаниеОперации);
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ВводВОборот_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ВводВОборот_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьВводаВОборот;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_ПроверитьСтатус(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = Неопределено;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВводаВОборот;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьВводаВОборот;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		Реквизиты = ЗначенияРеквизитовОбъектаЛок(Операция, "ОперацияОснование, КлючСтрокиОперацииОснования");
		Если КодыОпераций_ЕстьАТК(Реквизиты.ОперацияОснование, Реквизиты.КлючСтрокиОперацииОснования) Тогда
			НовыйСтатус = СтатусыОпераций.ЗарегистрированВГИС;
			НовоеДействие = ТребуемыеДействия.РасформироватьАТКПослеРегистрации;
		Иначе
			НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
			НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		КонецЕсли;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус ввода в оборот: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ВводВОборот_РасформироватьАТКПослеРегистрации(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Организация = ОписаниеОперации.Организация;
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	КлючСтрокиОперацииОснования = ОписаниеОперации.КлючСтрокиОперацииОснования;
	ОбщийТипУпаковкиАТК = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.АТК;
	
	ТаблицаКодовОперации = КодыОпераций_Прочитать(ОперацияОснование, КлючСтрокиОперацииОснования);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодовОперации);
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Для каждого Стр Из ТаблицаКодовОперации Цикл
		Если Стр.ОбщийТипУпаковки = ОбщийТипУпаковкиАТК Тогда
			СтрКода = ТаблицаКодов.Добавить();
			СтрКода.КлючКода = Стр.КлючКода;
			СтрКода.КлючСтрокиДокумента = Стр.КлючСтрокиДокумента;
			СтрКода.УдалитьИзДокумента = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация);
	
	Отбор = Новый Структура("КлючАгрегата");
	ОтборАТК = Новый Структура("ОбщийТипУпаковки", ОбщийТипУпаковкиАТК);
	Для каждого СтрАТК Из ТаблицаКодов.НайтиСтроки(ОтборАТК) Цикл
		Отбор.КлючАгрегата = СтрАТК.КлючКода;
		Для каждого СтрКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
			СтрКода.КлючСтрокиДокумента = СтрАТК.КлючСтрокиДокумента;
			СтрКода.КлючАгрегата = Неопределено;
			СтрКода.КодАгрегата = "";
		КонецЦикла;
	КонецЦикла;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		ТаблицаКодов_ЗаполнитьПоДокументуКлючиНоменклатуры1С(ТаблицаКодов, ДокументУчета);
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		Задача_Завершить(ОписаниеЗадачи);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти // ОбработкаКаждойСтрокиВводаВОборот

// #КонецОбласти // ВводВОборот

// #Область ОтчетОНанесении

Функция ОчередьОбмена_ОтчетОНанесении_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	
	Результат.Добавить(ТребуемыеДействия.ЗарезервироватьПартии);
	Результат.Добавить(ТребуемыеДействия.СоздатьПодчиненныеОперации);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ОтчетОНанесении_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ЗарезервироватьПартии Тогда
		ОчередьОбмена_РезервированиеПартий_Создать(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьПодчиненныеОперации Тогда
		Задача_ОтчетОНанесении_СоздатьПодчиненныеОперации(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесении_СоздатьПодчиненныеОперации(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Если Не КодыОпераций_ЕстьКоды(Операция) Тогда
		ТекстОшибки = НСтр("ru = 'Отчет о нанесении не содержит кодов'");
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Операция_СоздатьРегистрацииСтрокОтчетаОНанесении(Операция);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьПодчиненныеОперации;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(Операция);
	
КонецПроцедуры

// #КонецОбласти // ОтчетОНанесении

// #Область РегистрацияСтрокиОтчетаОНанесении

Функция ОчередьОбмена_СтрокаОтчетаОНанесении_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	
	Результат.Добавить(ТребуемыеДействия.ОтправитьВСервис);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	
	Результат.Добавить(ТребуемыеДействия.ОбновитьСтатусыКодов);
	Результат.Добавить(ТребуемыеДействия.ОбновитьОтчетПослеЧастичнойПриемки);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_СтрокаОтчетаОНанесении_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ОтправитьВСервис Тогда
		Задача_СтрокаОтчетаОНанесении_ОтправитьВСервис(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлДляПодписи Тогда
		Задача_СтрокаОтчетаОНанесении_ПолучитьФайлДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_СтрокаОтчетаОНанесении_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьСтатусыКодов Тогда
		Задача_СтрокаОтчетаОНанесении_ОбновитьСтатусыКодов(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьОтчетПослеЧастичнойПриемки Тогда
		Задача_СтрокаОтчетаОНанесении_ОбновитьОтчетПослеЧастичнойПриемки(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_СтрокаОтчетаОНанесении_ОтправитьВСервис(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	
	Попытка
		Контент = Контент_ОтчетОНанесении(ОписаниеОперации);
		Ответ = Маркировка_ОтчетОНанесении_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлДляПодписи;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_СтрокаОтчетаОНанесении_ПолучитьФайлДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_ОтчетОНанесении_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	id = Ответ.Результат.id;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_СтрокаОтчетаОНанесении_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_ОтчетОНанесении_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОжиданиеСобытийИзСервиса;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_СтрокаОтчетаОНанесении_ПроверитьСтатусВСервисе(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлДляПодписи;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
		НовоеДействие = ТребуемыеДействия.ОбновитьСтатусыКодов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedPartially") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОбновлениеСтатусовКодов;
		НовоеДействие = ТребуемыеДействия.ОбновитьОтчетПослеЧастичнойПриемки;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус отчета о нанесении: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_СтрокаОтчетаОНанесении_ОбновитьСтатусыКодов(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ТипОперации = ОписаниеЗадачи.ТипОперации;
	Организация = ОписаниеЗадачи.Организация;
	ОперацияОснование = ОписаниеЗадачи.ОперацияОснование;
	КлючСтрокиОперации = ОписаниеЗадачи.КлючСтрокиОперацииОснования;
	
	ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, КлючСтрокиОперации);
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация, Истина);
	
	Задача_Завершить(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_СтрокаОтчетаОНанесении_ОбновитьОтчетПослеЧастичнойПриемки(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Организация = ОписаниеОперации.Организация;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ОперацияОснование = ОписаниеОперации.ОперацияОснование;
	КлючСтрокиОперацииОснования = ОписаниеОперации.КлючСтрокиОперацииОснования;
	
	Попытка
		Ответ = Маркировка_ОтчетОНанесении_ИнформацияОЧастичнойПриемке(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	errors = Ответ.Результат.errors;
	appliedCodes = Ответ.Результат.appliedCodes;
	
	ТаблицаКодов = КодыОпераций_ТаблицаКодов(ОперацияОснование, КлючСтрокиОперацииОснования);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	Для Сч = -(ТаблицаКодов.Количество() - 1) По 0 Цикл
		СтрКода = ТаблицаКодов[-Сч];
		Если appliedCodes.Найти(СтрКода.КодМаркировки) = Неопределено Тогда
			ТаблицаКодов.Удалить(СтрКода);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодов_ОбновитьСтатусПоПервомуКоду(ТаблицаКодов, Организация, , Истина);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПринятЧастично;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ПринятЧастично;
	ОписаниеЗадачи.ОписаниеОшибки = ОтчетОНанесении_ОшибкиЧастичноПринятыхКодов(errors);
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Функция ОтчетОНанесении_ОшибкиЧастичноПринятыхКодов(errors)
	
	ОшибкиСКодами = Новый Массив;
	Для каждого Элемент Из МассивСтруктур_Разбить(errors, "errorCode") Цикл
		
		ОписанияОшибок = Элемент.Значение;
		ТекстОшибки = СокрЛП(ОписанияОшибок[0].errorMessage);
		ВсеКоды = МассивСтруктур_Выгрузить(ОписанияОшибок, "code");
		СписокКодов = СписокКодовДляТекстаОшибки(ВсеКоды);
		
		ОшибкиСКодами.Добавить(ТекстОшибки + ": " + СписокКодов);
		
	КонецЦикла;
	
	Возврат СоединитьСтроку(ОшибкиСКодами, Символы.ПС);
	
КонецФункции

// #КонецОбласти // РегистрацияСтрокиОтчетаОНанесении

// #Область ОтчетОНанесенииНаТСД

Функция ОчередьОбмена_ОтчетОНанесенииНаТСД_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	
	Результат.Добавить(ТребуемыеДействия.ЗарезервироватьПартии);
	
	Результат.Добавить(ТребуемыеДействия.ОтправитьВСервис);
	Результат.Добавить(ТребуемыеДействия.ПолучитьКодыИзСервиса);
	
	Результат.Добавить(ТребуемыеДействия.СоздатьПодчиненныеОперации);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ОтчетОНанесенииНаТСД_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ЗарезервироватьПартии Тогда
		ОчередьОбмена_РезервированиеПартий_Создать(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьВСервис Тогда
		Задача_ОтчетОНанесенииНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьКодыИзСервиса Тогда
		Задача_ОтчетОНанесенииНаТСД_ПолучитьКодыИзСервиса(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьПодчиненныеОперации Тогда
		Задача_ОтчетОНанесении_СоздатьПодчиненныеОперации(ОписаниеЗадачи);
		
	Иначе
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесенииНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		
		ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
		Контент = Контент_ОтчетОНанесенииНаТСД(ОписаниеОперации);
		
		Попытка
			Ответ = Маркировка_НаполнениеДокумента_Создать(ОписаниеЗадачи, Контент);
		Исключение
			Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(Ответ)
			Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
			Возврат;
		КонецЕсли;
		
		ОписаниеЗадачи.ИдентификаторДокумента = Ответ.Результат;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОжиданиеСобытийИзСервиса;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленНаТСД;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесенииНаТСД_ПроверитьСтатусВСервисе(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created")
		Или НРег(СтатусДокумента) = НРег("Processed")Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Enriched")
		Или НРег(СтатусДокумента) = НРег("Completed")Тогда
		
		НовыйСтатус = СтатусыОпераций.ПолучениеКодовИзСервиса;
		НовоеДействие = ТребуемыеДействия.ПолучитьКодыИзСервиса;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("Failed") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесенииНаТСД_ПолучитьКодыИзСервиса(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	Попытка
		Ответ = Маркировка_ОтчетОНанесенииНаТСД_Результат(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Контент = Ответ.Результат;
	
	ОтчетОНанесенииНаТСД_НормализоватьРазделителиGS1(Контент);
	ОтчетОНанесенииНаТСД_РазделитьСклеенныеКоды(Контент, ВидПродукции);
	ОтчетОНанесенииНаТСД_УдалитьКодыТранспортнойУпаковки(Контент);
	ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1(Контент, ВидПродукции);
	
	ТаблицаКодов = Задача_ОтчетОНанесенииНаТСД_ТаблицаКодов(Операция, Контент.positions);
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, Ложь) Тогда
		Задача_ОтчетОНанесенииНаТСД_ЗавершитьПолучениеКодовИзСервиса(ОписаниеЗадачи, ТаблицаКодов);
	Иначе
		Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаКодов);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ОтчетОНанесенииНаТСД_ЗавершитьПолучениеКодовИзСервиса(ОписаниеЗадачи, ТаблицаКодов)
	
	Операция = ОписаниеЗадачи.Операция;
	ДокументУчета = ОписаниеЗадачи.ДокументУчета;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьПодчиненныеОперации;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов_ЗаполнитьПоДокументуКлючиНоменклатуры1С(ТаблицаКодов, ДокументУчета);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		ПолныеКоды_Записать(ТаблицаКодов);
		КодыОпераций_Записать(ТаблицаКодов, Операция);
		КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
		ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		Задача_Записать(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_НормализоватьРазделителиGS1(Контент) Экспорт
	
	Для Каждого position Из Контент.positions Цикл
		Для Каждого Элемент Из position.codes Цикл
			Элемент.code = ВосстановитьРазделительGS1(Элемент.code);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_РазделитьСклеенныеКоды(Контент, ВидПродукции) Экспорт
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидПродукции", ВидПродукции);
	ФорматыКодов = РазделениеКодов_ФорматыКодовМаркировкиПоВидамПродукции().НайтиСтроки(Отбор);
	
	Для Каждого position Из Контент.positions Цикл
		Для Сч = -position.codes.ВГраница() По 0 Цикл
			
			Стр = position.codes[-Сч];
			Код = Стр.code;
			
			Если РазделениеКодов_ЭтоКИТУ(Стр) Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого СтрокаФормата Из ФорматыКодов Цикл
				
				Совпадения = Плагин_НайтиСовпаденияПоШаблону(Код, СтрокаФормата.РегулярноеВыражение);
				
				Если Совпадения = Неопределено Или Совпадения.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Если Совпадения.Количество() = 1 И Совпадения[0] = Код Тогда
					Прервать; // Код соответствует формату, разделять не надо.
				КонецЕсли;
				
				Если РазделениеКодов_СоединитьСовпадения(Совпадения) <> Код Тогда
					Продолжить; // Часть строки не попала в совпадения, разделять нельзя.
				КонецЕсли;
				
				position.codes.Удалить(-Сч);
				
				Для Сч3 = -Совпадения.ВГраница() По 0 Цикл
					НоваяСтрока = СкопироватьОбъект(Стр);
					НоваяСтрока.code = Совпадения[-Сч3];
					НоваяСтрока.markingCodeType = СтрокаФормата.ТипКодаВСервисе;
					position.codes.Вставить(-Сч, НоваяСтрока);
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_УдалитьКодыТранспортнойУпаковки(Контент)
	
	Для Каждого position Из Контент.positions Цикл
		Для Сч = -position.codes.ВГраница() По 0 Цикл
			ТипУпаковки = ТипУпаковкиПоТипуКодаМаркировкиИзСервиса(position.codes[-Сч].markingCodeType);
			Если ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МонотоварнаяУпаковка
				Или ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МультитоварнаяУпаковка Тогда
				position.codes.Удалить(-Сч);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1(Контент, ВидПродукции) Экспорт
	
	Если ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Молоко Тогда
		
		ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1_МолочнаяПродукция(Контент);
		
	ИначеЕсли ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Вода
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Пиво
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Бады
		Или ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Антисептики Тогда
		
		ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1_ВодаПивоБадыАнтисептики(Контент);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1_МолочнаяПродукция(Контент)
	
	ДлинаБезРазделителяБезВеса = 30;
	ДлинаДоРазделителяБезВеса = 24;
	
	ДлинаБезРазделителяСВесом = 40;
	ДлинаДоРазделителяСВесом = 30;
	
	Разделитель = РазделительGS1();
	
	Для Каждого position Из Контент.positions Цикл
		Для Каждого Эл Из position.codes Цикл
			
			Если Найти(Эл.code, Разделитель) = 0 Тогда // Разделителя нет
				
				Если СтрДлина(Эл.code) = ДлинаБезРазделителяБезВеса Тогда // Длина кода соответствует шаблону без веса
					Эл.code = Лев(Эл.code, ДлинаДоРазделителяБезВеса) + Разделитель + Сред(Эл.code, ДлинаДоРазделителяБезВеса + 1);
					Продолжить;
				КонецЕсли;
				
				Если СтрДлина(Эл.code) = ДлинаБезРазделителяСВесом Тогда // Длина кода соответствует шаблону с весом
					// восстановим разделитель перед весом
					Эл.code = Лев(Эл.code, ДлинаДоРазделителяСВесом) + Разделитель + Сред(Эл.code, ДлинаДоРазделителяСВесом + 1);
					// восстановим разделитель перед кодом проверки
					Эл.code = Лев(Эл.code, ДлинаДоРазделителяБезВеса) + Разделитель + Сред(Эл.code, ДлинаДоРазделителяБезВеса + 1);
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтчетОНанесенииНаТСД_ВосстановитьРазделительGS1_ВодаПивоБадыАнтисептики(Контент)
	
	ДлинаБезРазделителя = 37;
	ДлинаДоРазделителя = 31;
	
	Разделитель = РазделительGS1();
	
	Для Каждого position Из Контент.positions Цикл
		Для Каждого Эл Из position.codes Цикл
			
			Если Найти(Эл.code, Разделитель) = 0 // Разделителя нет
				И СтрДлина(Эл.code) = ДлинаБезРазделителя Тогда // Длина кода соответствует шаблону
				Эл.code = Лев(Эл.code, ДлинаДоРазделителя) + Разделитель + Сред(Эл.code, ДлинаДоРазделителя + 1);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчередьОбмена_ОтчетОНанесенииНаТСД_НачатьРедактирование(Операция) Экспорт
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	
	Если ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ОжиданиеСобытийИзСервиса Тогда
		ТекстОшибки = НСтр("ru = 'Невозможно начать редактирование отчета о нанесении на ТСД в статусе %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ОписаниеЗадачи.ТребуемоеДействие);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ЗавершитьРедактирование;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОжиданиеЗавершенияИзменений;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура ОчередьОбмена_ОтчетОНанесенииНаТСД_ЗавершитьРедактирование(Операция) Экспорт
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	
	Если ОписаниеЗадачи.ТребуемоеДействие <> ТребуемыеДействия.ЗавершитьРедактирование Тогда
		ТекстОшибки = НСтр("ru = 'Невозможно завершить редактирование отчета о нанесении на ТСД в статусе %1'");
		ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, ОписаниеЗадачи.ТребуемоеДействие);
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОжиданиеСобытийИзСервиса;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОтправленНаТСД;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Функция Задача_ОтчетОНанесенииНаТСД_ТаблицаКодов(Операция, positions)
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	Для Каждого position Из positions Цикл
		
		СтрТовара = ОписаниеОперации.Товары.Найти(position.number, "НомерСтроки");
		Если СтрТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		codes = СвойствоСтруктуры(position, "codes");
		Если Не ЗначениеЗаполнено(codes) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого code Из codes Цикл
			Стр = ТаблицаКодов.Добавить();
			Стр.КодМаркировки = code.code;
			Стр.ПолныйКод = code.originalCode;
			Стр.ТипУпаковки = ТипУпаковкиПоТипуКодаМаркировкиИзСервиса(code.markingCodeType);
			Стр.КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
			Стр.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
			Стр.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаКодов);
	
	Возврат ТаблицаКодов;
	
КонецФункции

// #КонецОбласти // ОтчетОНанесенииНаТСД

// #Область НаполнениеАгрегатовНаТСД

Функция ОчередьОбмена_НаполнениеАгрегатовНаТСД_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	// Общие действия
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ПроверитьВозможностьРегистрацииВсехАгрегатов);
	Результат.Добавить(ТребуемыеДействия.СоздатьНаКаждыйАгрегатНаполнениеНаТСД);
	Результат.Добавить(ТребуемыеДействия.СоздатьНаполненияПакетовАгрегатовНаТСД);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	
	// Один агрегат
	Результат.Добавить(ТребуемыеДействия.ПроверитьВозможностьРегистрацииАгрегата);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеНаполнениеАгрегатаНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПолучитьРезультатНаполненияАгрегатаНаТСД);
	Результат.Добавить(ТребуемыеДействия.ОбновитьДокументАгрегацииВСервисе);
	Результат.Добавить(ТребуемыеДействия.ПроверитьСтатусНаполненияАгрегатаНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлАгрегатаДляПодписи);
	
	// Пакет агрегатов
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеНаполнениеПакетаАгрегатовНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПолучитьРезультатНаполненияПакетаАгрегатовНаТСД);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлПакетаАгрегатовДляПодписи);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_НаполнениеАгрегатовНаТСД_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	// Общие действия
	Если Действие = Действия.ПроверитьВозможностьРегистрацииВсехАгрегатов Тогда
		Задача_ПакетнаяАгрегация_ПроверитьВозможностьРегистрации(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьНаКаждыйАгрегатНаполнениеНаТСД Тогда
		Задача_НаполнениеАгрегатовНаТСД_СоздатьНаполнениеНаКаждыйАгрегат(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьНаполненияПакетовАгрегатовНаТСД Тогда
		Задача_НаполнениеАгрегатовНаТСД_РазбитьНаПакеты(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_Агрегация_ОтправитьПодпись(ОписаниеЗадачи);
		
	// Один агрегат
	ИначеЕсли Действие = Действия.ПроверитьВозможностьРегистрацииАгрегата Тогда
		Задача_Агрегация_ПроверитьВозможностьРегистрацииОдногоАгрегата(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеНаполнениеАгрегатаНаТСД Тогда
		Задача_НаполнениеАгрегатаНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьРезультатНаполненияАгрегатаНаТСД Тогда
		Задача_НаполнениеАгрегатаНаТСД_ПолучитьРезультат(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОбновитьДокументАгрегацииВСервисе Тогда
		Задача_НаполнениеАгрегатаНаТСД_ОбновитьДокумент(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьСтатусНаполненияАгрегатаНаТСД Тогда
		Задача_НаполнениеАгрегатаНаТСД_ПроверитьСтатус(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлАгрегатаДляПодписи Тогда
		Задача_Агрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	// Пакет агрегатов
	ИначеЕсли Действие = Действия.СоздатьВСервисеНаполнениеПакетаАгрегатовНаТСД Тогда
		Задача_НаполнениеПакетаАгрегатовНаТСД_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьРезультатНаполненияПакетаАгрегатовНаТСД Тогда
		Задача_НаполнениеПакетаАгрегатовНаТСД_ПолучитьРезультат(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлПакетаАгрегатовДляПодписи Тогда
		Задача_ПакетнаяАгрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

// #Область ОбработкаВсехАгрегатовНаТСД

Процедура Задача_НаполнениеАгрегатовНаТСД_СоздатьНаполнениеНаКаждыйАгрегат(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	ТипОпераций = Перечисление_ТипыОпераций().НаполнениеОдногоАгрегатаНаТСД;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипОпераций);
	Операции_Удалить(СтарыеОперации);
	
	Операция_СоздатьНаКаждыйАгрегатНаполнениеНаТСД(Операция);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьПодчиненныеОперации;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатовНаТСД_РазбитьНаПакеты(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	ТипОпераций = Перечисление_ТипыОпераций().НаполнениеПакетаАгрегатовНаТСД;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипОпераций);
	Операции_Удалить(СтарыеОперации);
	
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	Операция_Агрегация_РазбитьНаПакеты(ТаблицаКодов, ОписаниеОперации);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьПодчиненныеОперации;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ОбработкаВсехАгрегатовНаТСД

// #Область ОбработкаКаждогоАгрегатаНаТСД

Процедура Задача_НаполнениеАгрегатаНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	НаполнитьНаТСД = Истина;
	Контент = Контент_НаполнениеАгрегатаНаТСД(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_Агрегация_Создать(ОписаниеЗадачи, Контент, НаполнитьНаТСД);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьНаполненияАгрегатаНаТСД;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатаНаТСД_ПроверитьГотовность(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReturnedToTsd") Тогда
		
		НовыйСтатус = СтатусыОпераций.ВозвращенНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли Задача_НаполнениеАгрегатаНаТСД_МожноПолучитьРезультат(СтатусДокумента) Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьРезультатНаполненияАгрегатаНаТСД;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус наполнения агрегата на ТСД: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатаНаТСД_ПолучитьРезультат(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ЗаполнитьПолныеКоды = ОписаниеОперации.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
	
	Попытка
		Ответ = Маркировка_Агрегация_ДокументАгрегации(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	codes = СвойствоСтруктуры(Ответ.Результат, "codes", Новый Массив);
	originalCodes = СвойствоСтруктуры(Ответ.Результат, "originalCodes", Новый Массив);
	ТаблицаНовыхКодов = ТаблицаКодов_ЗагрузитьКодыМаркировки(originalCodes, ЗаполнитьПолныеКоды);
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаНовыхКодов, Организация, Ложь) Тогда
		
		ОбновитьДокументВСервисе = Ложь;
		Отбор = Новый Структура("ТипШтрихкода", Перечисления.КонтурМаркировка_ТипыШтрихкодов.SSCC);
		
		Для Каждого Стр Из ТаблицаНовыхКодов.НайтиСтроки(Отбор) Цикл
			
			Если Не МассивСодержитЗначение(codes, Стр.КодМаркировки) Тогда
				ОбновитьДокументВСервисе = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Задача_НаполнениеАгрегатаНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаНовыхКодов, ОбновитьДокументВСервисе);
		
	Иначе
		Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаНовыхКодов);
	КонецЕсли;
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатаНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов, ОбновитьДокументВСервисе = Ложь)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	КлючАгрегата = ОписаниеОперации.ДопРеквизиты.КлючКода;
	КодАгрегата = КодМаркировки_НайтиПоКлючу(КлючАгрегата);
	РегистрироватьАгрегаты = ОписаниеОперации.ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения;
	ЗаполнитьПолныеКоды = ОписаниеОперации.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
	
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	ОшибкаДублирования = Ложь;
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		Если Стр.КодМаркировки = КодАгрегата Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КодАгрегата) И Стр.КодАгрегата <> КодАгрегата Тогда
			Стр.ОписаниеОшибки = ОписаниеОшибки_КодПринадлежитДругомуАгрегату(Стр.КодАгрегата);
			ОшибкаДублирования = Истина;
			Продолжить;
		КонецЕсли;
		
		Стр.КодАгрегата = КодАгрегата;
		Стр.КлючАгрегата = КлючАгрегата;
		Стр.УдалитьИзДокумента = Истина;
		
	КонецЦикла;
	
	Если ОшибкаДублирования Тогда
		Задача_ЗаписатьКодыВРедакторДляИсправленияДублей(ОписаниеЗадачи, ТаблицаКодов);
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ПодобратьКлючиНоменклатуры1СПоТоварам(ТаблицаКодов);
	Задача_НаполнениеАгрегатаНаТСД_ДобавитьСтарыеКоды(ТаблицаКодов, КлючАгрегата, ДокументУчета);
	
	СтрАгрегата = ТаблицаКодов.Найти(КлючАгрегата, "КлючКода");
	СтрАгрегата.УдалитьИзДокумента = КодыДокументов_ЕстьКодВСтруктуреУпаковок(ДокументУчета, КлючАгрегата);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		
		Если ЗаполнитьПолныеКоды Тогда
			ПолныеКоды_Записать(ТаблицаКодов);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
			ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		КонецЕсли;
		
		Если РегистрироватьАгрегаты Тогда
			Если ОбновитьДокументВСервисе Тогда
				ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОбновитьДокументАгрегацииВСервисе;
			Иначе
				ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусНаполненияАгрегатаНаТСД;
			КонецЕсли;
			Задача_Записать(ОписаниеЗадачи);
		Иначе
			Задача_Завершить(ОписаниеЗадачи);
		КонецЕсли;
		
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатаНаТСД_ОбновитьДокумент(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ИдентификаторДокумента = ОписаниеЗадачи.ИдентификаторДокумента;
	Контент = Контент_Агрегация_ОбновлениеДокумента(ОписаниеОперации);
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	
	Попытка
		Ответ = Маркировка_Агрегация_ОбновитьДокумент(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьСтатусНаполненияАгрегатаНаТСД;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ГотовКОтправкеВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Функциональность_ОбновитьДокументНаполнениеАгрегатовНаТСД(Организация);
	
КонецПроцедуры

Процедура Задача_НаполнениеАгрегатаНаТСД_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусДокумента = Ответ.Результат.Статус;
	ТекстОшибки = Ответ.Результат.Комментарий;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReturnedToTsd") Тогда
		
		НовыйСтатус = СтатусыОпераций.ВозвращенНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияАгрегатаНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.ГотовКОтправкеВГИС;
		НовоеДействие = ТребуемыеДействия.ПолучитьФайлАгрегатаДляПодписи;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус наполнения агрегата на ТСД: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

// Добавляет из базы вложенные в агрегат коды и сбрасывает у них КодАгрегата и КлючАгрегата.
//
// Параметры:
//  ТаблицаКодов - ТаблицаЗначений - см. функцию Новый_ТаблицаКодов();
//  КлючАгрегата - УникальныйИдентификатор - ключ кода агрегата;
//  ДокументУчета - СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета;
//
Процедура Задача_НаполнениеАгрегатаНаТСД_ДобавитьСтарыеКоды(ТаблицаКодов, КлючАгрегата, ДокументУчета)
	
	Если Не ЗначениеЗаполнено(КлючАгрегата) Тогда
		Возврат;
	КонецЕсли;
	
	КлючСтрокиДокумента = Неопределено;
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		КлючСтрокиДокумента = КодыДокументов_КлючСтрокиДокумента(КлючАгрегата, ДокументУчета);
	КонецЕсли;
	
	ТаблицаСтарыхКодов = Новый_ТаблицаКодов();
	Стр = ТаблицаСтарыхКодов.Добавить();
	Стр.КлючКода = КлючАгрегата;
	Стр.КлючСтрокиДокумента = КлючСтрокиДокумента;
	
	ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаСтарыхКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаСтарыхКодов);
	
	Для каждого Стр Из ТаблицаСтарыхКодов Цикл
		СтрКода = ТаблицаКодов.Найти(Стр.КодМаркировки, "КодМаркировки");
		Если СтрКода = Неопределено Тогда
			СтрКода = ТаблицаКодов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрКода, Стр);
			Если СтрКода.КлючКода <> КлючАгрегата Тогда
				СтрКода.КодАгрегата = Неопределено;
				СтрКода.КлючАгрегата = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция Задача_НаполнениеАгрегатаНаТСД_МожноПолучитьРезультат(СтатусДокумента)
	
	ПодходящиеСтатусы = Новый Соответствие;
	ПодходящиеСтатусы.Вставить(НРег("ReadyForSend"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptSending"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptSendingError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptProcessing"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptProcessedSuccess"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("CrptProcessedError"), Истина);
	ПодходящиеСтатусы.Вставить(НРег("Archived"), Истина);
	
	Возврат (ПодходящиеСтатусы[НРег(СтатусДокумента)] = Истина);
	
КонецФункции

Функция ОписаниеОшибки_КодПринадлежитДругомуАгрегату(КодАгрегата) Экспорт
	
	ОписаниеОшибки = НСтр("ru = 'Код принадлежит другому агрегату %1'");
	
	Возврат ПараметрыВСтроку(ОписаниеОшибки, КодАгрегата);
	
КонецФункции

// #КонецОбласти // ОбработкаКаждогоАгрегатаНаТСД

// #Область ОбработкаПакетаАгрегатовНаТСД

Процедура Задача_НаполнениеПакетаАгрегатовНаТСД_СоздатьВСервисе(ОписаниеЗадачи)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	Контент = Контент_МассоваяАгрегация_НаполнениеНаТСД(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_МассоваяАгрегация_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьНаполненияПакетаАгрегатовНаТСД;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_НаполнениеПакетаАгрегатовНаТСД_ПроверитьГотовность(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСтатуса = Ответ.Результат;
	СтатусДокумента = ОписаниеСтатуса.Статус;
	ТекстОшибки = ОписаниеСтатуса.Комментарий;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияПакетаАгрегатовНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияПакетаАгрегатовНаТСД;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReturnedToTsd") Тогда
		
		НовыйСтатус = СтатусыОпераций.ВозвращенНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьНаполненияПакетаАгрегатовНаТСД;
		
	ИначеЕсли Задача_НаполнениеАгрегатаНаТСД_МожноПолучитьРезультат(СтатусДокумента) Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПолучитьРезультатНаполненияПакетаАгрегатовНаТСД;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус наполнения агрегата на ТСД: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_НаполнениеПакетаАгрегатовНаТСД_ПолучитьРезультат(ОписаниеЗадачи)
	
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ЗаполнитьПолныеКоды = ОписаниеОперации.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
	
	Попытка
		Ответ = Маркировка_МассоваяАгрегация_ДокументАгрегации(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	РазделительGS = РазделительGS1();
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	Для Каждого position Из Ответ.Результат.positions Цикл
		СтрАгрегата = ТаблицаКодов.Добавить();
		СтрАгрегата.КодМаркировки = position.aggregateCode;
		Для Каждого code Из position.codes Цикл
			Если Лев(code, 1) = РазделительGS Тогда
				code = Сред(code, 2);
			КонецЕсли;
			СтрКода = ТаблицаКодов.Добавить();
			СтрКода.КодАгрегата = position.aggregateCode;
			СтрКода.КодМаркировки = code;
			Если ЗаполнитьПолныеКоды Тогда
				СтрКода.ПолныйКод = code;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ТаблицаКодов_НормализоватьКоды(ТаблицаКодов, Организация, Ложь) Тогда
		Задача_НаполнениеПакетаАгрегатовНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов);
	Иначе
		Задача_ЗаписатьКодыВРедакторДляРаспознавания(ОписаниеЗадачи, ТаблицаКодов);
	КонецЕсли;
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_НаполнениеПакетаАгрегатовНаТСД_ЗавершитьПолучениеКодов(ОписаниеЗадачи, ТаблицаКодов)
	
	ОписаниеОперации = Операция_ПрочитатьОперацию(ОписаниеЗадачи.Операция);
	ДокументУчета = ОписаниеОперации.ДокументУчета;
	РегистрироватьАгрегаты = ОписаниеОперации.ДопРеквизиты.РегистрироватьАгрегатыПослеНаполнения;
	ЗаполнитьПолныеКоды = ОписаниеОперации.ДопРеквизиты.ПолучатьПолныеКодыПриНаполненииАгрегатаНаТСД;
	
	ТаблицаКодов.Колонки.КодАгрегата.Имя = "НовыйКодАгрегата";
	ТаблицаКодов_ДополнитьКолонки(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов.Колонки.КодАгрегата.Имя = "КодАгрегатаИБ";
	ТаблицаКодов.Колонки.НовыйКодАгрегата.Имя = "КодАгрегата";
	
	ОшибкаДублирования = Ложь;
	
	Для каждого СтрКода Из ТаблицаКодов Цикл
		
		Если Не ЗначениеЗаполнено(СтрКода.КодАгрегата) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрКода.КодАгрегатаИБ) И СтрКода.КодАгрегата <> СтрКода.КодАгрегатаИБ Тогда
			СтрКода.ОписаниеОшибки = ОписаниеОшибки_КодПринадлежитДругомуАгрегату(СтрКода.КодАгрегатаИБ);
			ОшибкаДублирования = Истина;
			Продолжить;
		КонецЕсли;
		
		СтрАгрегата = ТаблицаКодов.Найти(СтрКода.КодАгрегата, "КодМаркировки");
		СтрКода.КлючАгрегата = СтрАгрегата.КлючКода;
		СтрКода.УдалитьИзДокумента = Истина;
		
	КонецЦикла;
	
	Если ОшибкаДублирования Тогда
		Задача_ЗаписатьКодыВРедакторДляИсправленияДублей(ОписаниеЗадачи, ТаблицаКодов);
		Возврат;
	КонецЕсли;
	
	ТаблицаКодов_ПодобратьКлючиНоменклатуры1СПоТоварам(ТаблицаКодов);
	
	Для каждого СтрАгрегата Из ТаблицаКодов.НайтиСтроки(Новый Структура("КодАгрегата", "")) Цикл
		СтрАгрегата.КодАгрегата = СтрАгрегата.КодАгрегатаИБ;
		Задача_НаполнениеАгрегатаНаТСД_ДобавитьСтарыеКоды(ТаблицаКодов, СтрАгрегата.КлючКода, ДокументУчета);
		СтрАгрегата.УдалитьИзДокумента = КодыДокументов_ЕстьКодВСтруктуреУпаковок(ДокументУчета, СтрАгрегата.КлючКода);
	КонецЦикла;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		
		ТаблицаКодов_ЗаписатьВсюИнформацию(ТаблицаКодов);
		
		Если ЗаполнитьПолныеКоды Тогда
			ПолныеКоды_Записать(ТаблицаКодов);
		КонецЕсли;
		
		Если РегистрироватьАгрегаты Тогда
			ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьВозможностьРегистрацииВсехАгрегатов;
			Задача_Записать(ОписаниеЗадачи);
		Иначе
			Задача_Завершить(ОписаниеЗадачи);
		КонецЕсли;
		
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			КодыДокументов_Записать(ТаблицаКодов, ДокументУчета, Ложь);
			ДокументУчета_ОбновитьТребуемоеДействие(ДокументУчета);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти // ОбработкаПакетаАгрегатовНаТСД

// #КонецОбласти // НаполнениеАгрегатовНаТСД

// #Область РегистрацияАгрегатов

Функция ОчередьОбмена_ПакетнаяАгрегация_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.ПроверитьВозможностьРегистрацииВсехАгрегатов);
	Результат.Добавить(ТребуемыеДействия.СоздатьРегистрацииПакетовАгрегатов);
	Результат.Добавить(ТребуемыеДействия.СоздатьВСервисеПакетАгрегатов);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлПакетаАгрегатовДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_ПакетнаяАгрегация_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.ПроверитьВозможностьРегистрацииВсехАгрегатов Тогда
		Задача_ПакетнаяАгрегация_ПроверитьВозможностьРегистрации(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьРегистрацииПакетовАгрегатов Тогда
		Задача_ПакетнаяАгрегация_РазбитьНаПакеты(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьВСервисеПакетАгрегатов Тогда
		Задача_ПакетнаяАгрегация_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлПакетаАгрегатовДляПодписи Тогда
		Задача_ПакетнаяАгрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_ПакетнаяАгрегация_ОтправитьПодпись(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ПакетнаяАгрегация_ПроверитьВозможностьРегистрации(ОписаниеЗадачи)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Организация = ОписаниеЗадачи.Организация;
	ТипОперации = ОписаниеЗадачи.ТипОперации;
	
	Если ЗначениеЗаполнено(ОписаниеЗадачи.ОперацияОснование) Тогда
		ТаблицаКодов = КодыОпераций_Прочитать(ОписаниеЗадачи.ОперацияОснование, ОписаниеЗадачи.КлючСтрокиОперацииОснования);
	Иначе
		ТаблицаКодов = КодыОпераций_Прочитать(ОписаниеЗадачи.Операция);
	КонецЕсли;
	
	ТаблицаКодов_ДобавитьВложенныеТранспортныеУпаковки(ТаблицаКодов);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Если Не ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация, Истина) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = ТаблицаКодов_ПроверитьВозможностьРегистрацииАгрегатов(ТаблицаКодов, Организация);
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	Иначе
		Если ТипОперации = ТипыОпераций.НаполнениеАгрегатовНаТСД Тогда
			НаполнитьАгрегатыВОдномЗадании = Операция_НаполнятьАгрегатыВОдномЗадании(ОписаниеЗадачи.Операция);
			Если НаполнитьАгрегатыВОдномЗадании Тогда
				ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.СоздатьНаполненияПакетовАгрегатовНаТСД;
			Иначе
				ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.СоздатьНаКаждыйАгрегатНаполнениеНаТСД;
			КонецЕсли;
		ИначеЕсли ТипОперации = ТипыОпераций.НаполнениеПакетаАгрегатовНаТСД Тогда
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПолучитьФайлПакетаАгрегатовДляПодписи;
		Иначе
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.СоздатьРегистрацииПакетовАгрегатов;
		КонецЕсли;
		Задача_Записать(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_ПакетнаяАгрегация_РазбитьНаПакеты(ОписаниеЗадачи)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОперацияОснование = ОписаниеЗадачи.ОперацияОснование;
	КлючСтрокиОперацииОснования = ОписаниеЗадачи.КлючСтрокиОперацииОснования;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	ПодчиненныеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипыОпераций.РегистрацияПакетаАгрегатов, Истина);
	Операции_Удалить(ПодчиненныеОперации);
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.РегистрацияАгрегатов Тогда
		ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	Иначе
		ТранспортнаяУпаковка = Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка;
		ТаблицаКодов = КодыОпераций_Прочитать(ОперацияОснование, КлючСтрокиОперацииОснования);
		ТаблицаКодов = КодыМаркировки_ТаблицаВложенныхКодов(ТаблицаКодов.ВыгрузитьКолонку("КлючКода"), ТранспортнаяУпаковка, Ложь);
	КонецЕсли;
	
	Операция_Агрегация_РазбитьНаПакеты(ТаблицаКодов, ОписаниеОперации);
	
	Если Операция_ЕстьПодчиненныеОперации(Операция, ТипыОпераций.РегистрацияПакетаАгрегатов) Тогда
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПроверитьПодчиненныеОперации;
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОжиданиеГотовности;
	ИначеЕсли ОписаниеОперации.ТипОперации = ТипыОпераций.РегистрацияАгрегатов Тогда
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОперацияЗавершена;
	Иначе
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.СоздатьВСервисеПакетАгрегатов;
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОтправкаВСервис;
	КонецЕсли;
	
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ПакетнаяАгрегация_СоздатьВСервисе(ОписаниеЗадачи)
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Контент = Контент_МассоваяАгрегация(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_МассоваяАгрегация_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПолучитьФайлПакетаАгрегатовДляПодписи;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, Ответ.Результат);
	
КонецПроцедуры

Процедура Задача_ПакетнаяАгрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_МассоваяАгрегация_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Файл_УдалитьКонтентДляПодписи(ОписаниеЗадачи.Операция);
	Файл_СохранитьКонтентДляПодписи(ОписаниеЗадачи.Операция, Ответ.Результат.content, Ответ.Результат.id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_ПакетнаяАгрегация_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ДанныеФайла = Файл_Прочитать(ФайлПодписи).ДанныеФайла;
	
	Попытка
		Ответ = Маркировка_МассоваяАгрегация_ОтправитьВГИС(ОписаниеЗадачи, ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьПакетаАгрегатов;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправляетсяВГИС;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_ПакетнаяАгрегация_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусДокумента = Ответ.Результат.Статус;
	ТекстОшибки = Ответ.Результат.Комментарий;
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created")
		Или НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьПакетаАгрегатов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьПакетаАгрегатов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьПакетаАгрегатов;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр("ru = 'Неизвестный статус регистрации пакета агрегатов: %1'"), СтатусДокумента);
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	Если НовоеДействие = ТребуемыеДействия.ОперацияЗавершена
		И ЗначениеЗаполнено(ОписаниеЗадачи.ОперацияОснование) Тогда
		ТаблицаКодов = КодыОпераций_Прочитать(ОписаниеЗадачи.ОперацияОснование, ОписаниеЗадачи.КлючСтрокиОперацииОснования);
		ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		ТаблицаКодов_ОбновитьСтатусПоПервомуКоду(ТаблицаКодов, ОписаниеЗадачи.Организация, СтатусыКодов.НеНайден, Истина);
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		Задача_Записать(ОписаниеЗадачи);
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти // РегистрацияАгрегатов

// #Область РегистрацияОдногоАгрегата

Функция ОчередьОбмена_Агрегация_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьРегистрациюНаКаждыйАгрегат);
	Результат.Добавить(ТребуемыеДействия.ПроверитьВозможностьРегистрацииАгрегата);
	Результат.Добавить(ТребуемыеДействия.СоздатьАгрегатВСервисе);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлАгрегатаДляПодписи);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_Агрегация_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьРегистрациюНаКаждыйАгрегат Тогда
		Задача_Агрегация_СоздатьРегистрациюНаКаждыйАгрегат(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьВозможностьРегистрацииАгрегата Тогда
		Задача_Агрегация_ПроверитьВозможностьРегистрацииОдногоАгрегата(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьАгрегатВСервисе Тогда
		Задача_Агрегация_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлАгрегатаДляПодписи Тогда
		Задача_Агрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_Агрегация_ОтправитьПодпись(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Агрегация_СоздатьРегистрациюНаКаждыйАгрегат(ОписаниеЗадачи)
	
	СтатусыКодов = Перечисление_СтатусыКодов();
	ТипыОпераций = Перечисление_ТипыОпераций();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов.Сортировать("КодМаркировки Убыв");
	
	Операции_Удалить(Операция_НайтиПодчиненныеОперации(Операция, ТипыОпераций.РегистрацияОдногоАгрегатаВГИС, Истина));
	
	ЕстьПодчиненныеОперации = Ложь;
	Для каждого Стр Из ТаблицаКодов Цикл
		Если Стр.Статус = СтатусыКодов.НеНайден Тогда
			Операция_СоздатьРегистрациюНаКаждыйАгрегат(ОписаниеОперации, Стр.КлючСтрокиОперации, Стр.КлючКода);
			ЕстьПодчиненныеОперации = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.РегистрацияОдногоАгрегатаВГИС Тогда
		Если ЕстьПодчиненныеОперации Тогда
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПроверитьПодчиненныеОперации;
			ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОжиданиеГотовности;
		Иначе
			ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПроверитьВозможностьРегистрацииАгрегата;
			ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ПроверкаВозможностиРегистрацииАгрегата;
		КонецЕсли;
	Иначе
		ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПроверитьПодчиненныеОперации;
		ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОжиданиеГотовности;
	КонецЕсли;
	
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Агрегация_ПроверитьВозможностьРегистрацииОдногоАгрегата(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = Операция_КлючКода(Операция);
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Если Не ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, Организация, Истина) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = ТаблицаКодов_ПроверитьВозможностьРегистрацииАгрегатов(ТаблицаКодов, Организация);
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ТекстОшибки);
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	Иначе
		Если ОписаниеЗадачи.ТипОперации = Перечисление_ТипыОпераций().НаполнениеОдногоАгрегатаНаТСД Тогда
			ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьВСервисеНаполнениеАгрегатаНаТСД;
		Иначе
			ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().СоздатьАгрегатВСервисе;
		КонецЕсли;
		Задача_Записать(ОписаниеЗадачи);
	КонецЕсли;
	
КонецПроцедуры

Процедура Задача_Агрегация_СоздатьВСервисе(ОписаниеЗадачи)
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	Контент = Контент_Агрегация(ОписаниеОперации);
	
	Попытка
		Ответ = Маркировка_Агрегация_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = ТребуемыеДействия.ПолучитьФайлАгрегатаДляПодписи;
	ОписаниеЗадачи.НовыйСтатусОперации = СтатусыОпераций.ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеОперации, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_Агрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_Агрегация_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, Ответ.Результат.content, Ответ.Результат.id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Агрегация_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ДанныеФайла = Файл_Прочитать(ФайлПодписи).ДанныеФайла;
	
	Попытка
		Ответ = Маркировка_Агрегация_ОтправитьВГИС(ОписаниеЗадачи, ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьАгрегата;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_Агрегация_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	СтатусДокумента = Ответ.Результат.Статус;
	ТекстОшибки = Ответ.Результат.Комментарий;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("TsdProcessStart") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReturnedToTsd") Тогда
		
		НовыйСтатус = СтатусыОпераций.ВозвращенНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("ReadyForSend") Тогда
		
		НовыйСтатус = СтатусыОпераций.НаполненНаТСД;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess")
		Или НРег(СтатусДокумента) = НРег("Archived") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОперацияЗавершена;
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр(
		"ru = 'Неизвестный статус агрегации: %1'"), СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // РегистрацияОдногоАгрегата

// #Область РасформированиеАгрегатов

Функция ОчередьОбмена_Разагрегация_БизнесПроцесс()
	
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Результат = Новый Массив;
	Результат.Добавить(ТребуемыеДействия.СоздатьРасформированияАгрегатовВГИС);
	Результат.Добавить(ТребуемыеДействия.ПроверитьАгрегатДляРасформированияВГИС);
	Результат.Добавить(ТребуемыеДействия.СоздатьРасформированиеАгрегатаВСервисе);
	Результат.Добавить(ТребуемыеДействия.ПолучитьФайлРасформированияАгрегатаДляПодписи);
	Результат.Добавить(ТребуемыеДействия.РасформироватьАгрегатПослеРегистрации);
	Результат.Добавить(ТребуемыеДействия.ОтправитьПодпись);
	
	Возврат Результат;
	
КонецФункции

Процедура ОчередьОбмена_Разагрегация_ОбработатьЗадачу(ОписаниеЗадачи)
	
	Действия = Перечисление_ТребуемыеДействия();
	Действие = ОписаниеЗадачи.ТребуемоеДействие;
	
	Если Действие = Действия.СоздатьРасформированияАгрегатовВГИС Тогда
		Задача_Разагрегация_СоздатьРасформированияАгрегатовВГИС(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПроверитьАгрегатДляРасформированияВГИС Тогда
		Задача_Разагрегация_ПроверитьВозможностьРасформированияВГИС(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.СоздатьРасформированиеАгрегатаВСервисе Тогда
		Задача_Разагрегация_СоздатьВСервисе(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ПолучитьФайлРасформированияАгрегатаДляПодписи Тогда
		Задача_Разагрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.ОтправитьПодпись Тогда
		Задача_Разагрегация_ОтправитьПодпись(ОписаниеЗадачи);
		
	ИначеЕсли Действие = Действия.РасформироватьАгрегатПослеРегистрации Тогда
		Задача_Разагрегация_РасформироватьАгрегатПослеРегистрации(ОписаниеЗадачи);
		
	Иначе
		
		ОчередьОбмена_ВызватьИсключение_НеизвестноеДействие(Действие, ОписаниеЗадачи);
		
	КонецЕсли;
	
КонецПроцедуры

// #Область ОбработкаВсехАгрегатов

Процедура Задача_Разагрегация_СоздатьРасформированияАгрегатовВГИС(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	ТаблицаКодов = КодыОпераций_Прочитать(Операция);
	
	ТипОпераций = Перечисление_ТипыОпераций().РасформированиеАгрегатаВГИС;
	СтарыеОперации = Операция_НайтиПодчиненныеОперации(Операция, ТипОпераций);
	Операции_Удалить(СтарыеОперации);
	
	Для каждого Стр Из ТаблицаКодов Цикл
		Операция_СоздатьРасформированиеАгрегатаВГИС(Операция, Стр.КлючСтрокиОперации, Стр.КлючКода);
	КонецЦикла;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьПодчиненныеОперации;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

// #КонецОбласти // ОбработкаВсехАгрегатов

// #Область ОбработкаКаждогоАгрегата

Процедура Задача_Разагрегация_ПроверитьВозможностьРасформированияВГИС(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	Организация = ОписаниеЗадачи.Организация;
	КлючАгрегата = Операция_КлючКода(Операция);
	КодАгрегата = КодМаркировки_НайтиПоКлючу(КлючАгрегата);
	
	Попытка
		Ответ = Маркировка_СтатусыКодов(КодАгрегата, Организация);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Возврат;
	КонецЕсли;
	
	Статус = СтатусКодаПоСтатусуИзСервиса(Ответ[0]);
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	СтатусыКодов = Перечисление_СтатусыКодов();
	
	Если Не ЗначениеЗаполнено(Статус)
		Или Статус = СтатусыКодов.НеНайден
		Или Статус = СтатусыКодов.Разагрегирован
		Или Статус = СтатусыКодов.ВыбылИзОборота
		Или Статус = СтатусыКодов.НетДоступа Тогда
		КодыМаркировки_РасформироватьАгрегат(КлючАгрегата);
		НовоеДействие = ТребуемыеДействия.ОперацияЗавершена;
		НовыйСтатусОперации = СтатусыОпераций.ОперацияЗавершена;
	Иначе
		НовоеДействие = ТребуемыеДействия.СоздатьРасформированиеАгрегатаВСервисе;
		НовыйСтатусОперации = "";
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатусОперации;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Разагрегация_СоздатьВСервисе(ОписаниеЗадачи)
	
	Контент = Контент_Разагрегация(ОписаниеЗадачи.Операция);
	
	Попытка
		Ответ = Маркировка_Разагрегация_Создать(ОписаниеЗадачи, Контент);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторДокумента = Ответ.Результат;
	ОписаниеЗадачи.ИдентификаторДокумента = ИдентификаторДокумента;
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПолучитьФайлРасформированияАгрегатаДляПодписи;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОтправленВСервис;
	Задача_Записать(ОписаниеЗадачи);
	
	Метрика_Операции_ОтправкаВСервис(ОписаниеЗадачи.Операция, ИдентификаторДокумента);
	
КонецПроцедуры

Процедура Задача_Разагрегация_ПолучитьКонтентДляПодписи(ОписаниеЗадачи)
	
	Операция = ОписаниеЗадачи.Операция;
	
	Попытка
		Ответ = Маркировка_Разагрегация_КонтентДляПодписи(ОписаниеЗадачи);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	Id = Ответ.Результат.documentId;
	content = Ответ.Результат.content;
	Файл_УдалитьКонтентДляПодписи(Операция);
	Файл_СохранитьКонтентДляПодписи(Операция, content, Id);
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПодписатьФайл;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ТребуетсяПодписать;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Разагрегация_ОтправитьПодпись(ОписаниеЗадачи)
	
	ФайлПодписи = Файл_НайтиФайлПодписи(ОписаниеЗадачи.Операция);
	ОписаниеФайла = Файл_Прочитать(ФайлПодписи);
	
	Попытка
		Ответ = Маркировка_Разагрегация_ОтправитьВГИС(ОписаниеЗадачи, ОписаниеФайла.ДанныеФайла);
	Исключение
		Задача_ЗаписатьОшибку(ОписаниеЗадачи, ИнформацияОбОшибке());
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ПроверитьГотовностьРасформированияАгрегата;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОжиданиеГотовности;
	Задача_Записать(ОписаниеЗадачи);
	
	Файлы_Удалить(ФайлПодписи);
	
КонецПроцедуры

Процедура Задача_Разагрегация_ПроверитьСтатус(ОписаниеЗадачи)
	
	Попытка
		Ответ = Маркировка_СтатусДокумента(ОписаниеЗадачи);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ)
		Или ВременнаяОшибкаСервиса(Ответ, ОписаниеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = Ответ.Результат.Комментарий;
	СтатусДокумента = Ответ.Результат.Статус;
	
	СтатусыОпераций = Перечисление_СтатусыОпераций();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	Если НРег(СтатусДокумента) = НРег("Created") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВСервис;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьРасформированияАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSending") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправляетсяВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьРасформированияАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessing") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОтправленВГИС;
		НовоеДействие = ТребуемыеДействия.ПроверитьГотовностьРасформированияАгрегата;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptProcessedSuccess") Тогда
		
		НовыйСтатус = СтатусыОпераций.ЗарегистрированВГИС;
		НовоеДействие = ТребуемыеДействия.РасформироватьАгрегатПослеРегистрации;
		
	ИначеЕсли НРег(СтатусДокумента) = НРег("CrptSendingError")
		Или НРег(СтатусДокумента) = НРег("CrptProcessedError") Тогда
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Неизвестный статус расформирования агрегата: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СтатусДокумента);
		
		НовыйСтатус = СтатусыОпераций.ОшибкаОбработки;
		НовоеДействие = ТребуемыеДействия.ИсправитьОшибку;
		
	КонецЕсли;
	
	ОписаниеЗадачи.НовоеДействие = НовоеДействие;
	ОписаниеЗадачи.НовыйСтатусОперации = НовыйСтатус;
	ОписаниеЗадачи.СтатусДокументаВСервисе = СтатусДокумента;
	ОписаниеЗадачи.ОписаниеОшибки = ТекстОшибки;
	Задача_Записать(ОписаниеЗадачи);
	
	Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Разагрегация_РасформироватьАгрегатПослеРегистрации(ОписаниеЗадачи)
	
	КлючАгрегата = Операция_КлючКода(ОписаниеЗадачи.Операция);
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = КлючАгрегата;
	ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	ТаблицаКодов_ОбновитьСтатусы(ТаблицаКодов, ОписаниеЗадачи.Организация, Истина);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	Попытка
		КодыМаркировки_РасформироватьАгрегат(КлючАгрегата);
		Задача_Завершить(ОписаниеЗадачи);
		Задача_ОбновитьСтатусОбменаОперацииОснования(ОписаниеЗадачи);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

