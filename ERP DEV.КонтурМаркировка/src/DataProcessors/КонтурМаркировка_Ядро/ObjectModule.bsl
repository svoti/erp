Функция Задача_ПодборКодовНаТСД_ТаблицаКодов(Операция, positions)
	
	ТаблицаКодов = Новый_ТаблицаКодов();
	ОписаниеОперации = Операция_ПрочитатьОперацию(Операция);
	
	Для Каждого position Из positions Цикл
		
		СтрТовара = ОписаниеОперации.Товары.Найти(position.number, "НомерСтроки");
		Если СтрТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		codes = СвойствоСтруктуры(position, "codes");
		Если Не ЗначениеЗаполнено(codes) Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрТовара.Товар) Тогда
			ВидПродукции = СтрТовара.Товар.ВидПродукции;
		Иначе
			ВидПродукции = ОписаниеОперации.ВидПродукции;
		КонецЕсли;
		
		Для Каждого code Из codes Цикл
			Стр = ТаблицаКодов.Добавить();
			Стр.КодМаркировки = code.originalCode;
			Стр.ПолныйКод = code.originalCode;
			Стр.ТипУпаковки = ТипУпаковкиПоТипуКодаМаркировкиИзСервиса(code.markingCodeType);
			Стр.КлючНоменклатуры1С = СтрТовара.КлючНоменклатуры1С;
			Стр.КлючСтрокиОперации = СтрТовара.КлючСтрокиОперации;
			Стр.КлючСтрокиДокумента = СтрТовара.КлючСтрокиДокумента;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаЗначений_СвернутьПоВсемКолонкам(ТаблицаКодов);
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции) Тогда
		ТаблицаКодов.ЗаполнитьЗначения(ОписаниеОперации.ВидПродукции, "ВидПродукции");
	КонецЕсли;
	
	Возврат ТаблицаКодов;
	
КонецФункции

