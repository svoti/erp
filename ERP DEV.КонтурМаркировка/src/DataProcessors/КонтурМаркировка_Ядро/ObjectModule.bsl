Функция ДопСвойства_НайтиОбъекты(ИмяСвойства, Значение) Экспорт
	
	Если Значение = Ложь Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.Объект КАК Объект,
	|	НЕОПРЕДЕЛЕНО КАК КлючОбъекта,
	|	НЕОПРЕДЕЛЕНО КАК ТипКлючаОбъекта
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопСвойства КАК Т
	|ГДЕ
	|	Т.ИмяСвойства = &ИмяСвойства
	|	И &УсловиеЗначения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО,
	|	Т.КлючОбъекта,
	|	Т.ТипКлючаОбъекта
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_СвойстваОбъектов1С КАК Т
	|ГДЕ
	|	Т.ИмяСвойства = &ИмяСвойства
	|	И &УсловиеЗначения";
	
	ЗначениеКлюч = Неопределено;
	ТипКлючаЗначения = Неопределено;
	Если ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		УсловиеЗначения = "Т.ЗначениеКлюч = &Значение";
	ИначеЕсли ЭтоПростойТип(Значение) Тогда
		УсловиеЗначения = "Т.Значение = &Значение";
	ИначеЕсли ЭтоОбъектКонтурМаркировки(Значение) Тогда
		УсловиеЗначения = "Т.ЗначениеСсылка = &Значение";
	Иначе
		ЗначениеКлюч = КлючОбъекта1С(Значение);
		ТипКлючаЗначения = ТипКлючаОбъекта1С(Значение);
		УсловиеЗначения = "Т.ЗначениеКлюч = &ЗначениеКлюч И Т.ТипКлючаЗначения = &ТипКлючаЗначения";
	КонецЕсли;
	
	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "&УсловиеЗначения", УсловиеЗначения));
	Запрос.УстановитьПараметр("Значение", Значение);
	Запрос.УстановитьПараметр("ИмяСвойства", ИмяСвойства);
	Запрос.УстановитьПараметр("ЗначениеКлюч", ЗначениеКлюч);
	Запрос.УстановитьПараметр("ТипКлючаЗначения", ТипКлючаЗначения);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Объект) Тогда
			Результат.Добавить(Выборка.Объект);
		Иначе
			Результат.Добавить(МодульОбщегоНазначения().СсылкаПоИдентификатору(Выборка.КлючОбъекта, Выборка.ТипКлючаОбъекта));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДопСвойство_Прочитать(Объект, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Значение КАК Значение,
	|	Т.ЗначениеКлюч КАК ЗначениеКлюч,
	|	Т.ЗначениеСсылка КАК ЗначениеСсылка,
	|	Т.ТипКлючаЗначения КАК ТипКлючаЗначения
	|ИЗ
	|	ИмяРегистра КАК Т
	|ГДЕ
	|	&УсловиеОбъект
	|	И Т.ИмяСвойства = &ИмяСвойства";
	
	КлючОбъекта = Неопределено;
	ТипКлючаОбъекта = Неопределено;
	Если ЭтоОбъектКонтурМаркировки(Объект) Тогда
		УсловиеОбъект = "Т.Объект = &Объект";
		ИмяРегистра = "РегистрСведений.КонтурМаркировка_ДопСвойства";
	Иначе
		КлючОбъекта = КлючОбъекта1С(Объект);
		ТипКлючаОбъекта = ТипКлючаОбъекта1С(Объект);
		УсловиеОбъект = "Т.КлючОбъекта = &КлючОбъекта И Т.ТипКлючаОбъекта = &ТипКлючаОбъекта";
		ИмяРегистра = "РегистрСведений.КонтурМаркировка_СвойстваОбъектов1С";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяРегистра", ИмяРегистра);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОбъект", УсловиеОбъект);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("ИмяСвойства", ИмяСвойства);
	Запрос.УстановитьПараметр("КлючОбъекта", КлючОбъекта);
	Запрос.УстановитьПараметр("ТипКлючаОбъекта", ТипКлючаОбъекта);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = ЗначениеПоУмолчанию;
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.ЗначениеСсылка) Тогда
			Результат = Выборка.ЗначениеСсылка;
		ИначеЕсли ЗначениеЗаполнено(Выборка.ЗначениеКлюч) Тогда
			Если ЗначениеЗаполнено(Выборка.ТипКлючаЗначения) Тогда
				Результат = МодульОбщегоНазначения().СсылкаПоИдентификатору(Выборка.ЗначениеКлюч, Выборка.ТипКлючаЗначения);
			Иначе
				Результат = Выборка.ЗначениеКлюч;
			КонецЕсли;
		Иначе
			Результат = Выборка.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДопСвойство_Записать(Объект, ИмяСвойства, Значение) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Для Каждого ТекОбъект Из ЗначениеВМассиве(Объект) Цикл
			
			Если ЭтоОбъектКонтурМаркировки(ТекОбъект) Тогда
				Запись = РегистрыСведений.КонтурМаркировка_ДопСвойства.СоздатьМенеджерЗаписи();
				Запись.Объект = Объект;
			Иначе
				Запись = РегистрыСведений.КонтурМаркировка_СвойстваОбъектов1С.СоздатьМенеджерЗаписи();
				Запись.КлючОбъекта = КлючОбъекта1С(ТекОбъект);
				Запись.ТипКлючаОбъекта = ТипКлючаОбъекта1С(ТекОбъект);
			КонецЕсли;
			
			Запись.ИмяСвойства = ИмяСвойства;
			
			Если ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
				Запись.ЗначениеКлюч = Значение;
			ИначеЕсли ЭтоПростойТип(Значение) Тогда
				Запись.Значение = Значение;
			ИначеЕсли ЭтоОбъектКонтурМаркировки(Значение) Тогда
				Запись.ЗначениеСсылка = Значение;
			Иначе
				Запись.ЗначениеКлюч = КлючОбъекта1С(Значение);
				Запись.ТипКлючаЗначения = ТипКлючаОбъекта1С(Значение);
			КонецЕсли;
			
			Если Значение = Ложь Или Не ЗначениеЗаполнено(Значение) Тогда
				Запись.Удалить();
			Иначе
				Запись.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ДопСвойства_Удалить(Объект) Экспорт
	
	Набор = РегистрыСведений.КонтурМаркировка_ДопСвойства.СоздатьНаборЗаписей();
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Записать();
	
КонецПроцедуры

// #КонецОбласти // ДопСвойства

// #Область Файлы

// Находит в базе нужные файлы
//
// Параметры:
//  ВладельцыФайлов - Массив, СправочникСсылка.КонтурМаркировка_Файлы - владельцы файлов;
//  ТипыФайлов - Массив, Строка - (необязательный) типы файлов, см. Перечисление_ТипыФайлов();
//  ПодписанЭП - Булево - (необязательный) Истина, если нужно получить подписанные файлы;
//  ИменаФайлов - Массив, Строка - (необязательный) имена файлов;
// 
// Возвращаемое значение:
//  Массив - содержит СправочникСсылка.КонтурМаркировка_Файлы
//
Функция Файлы_Найти(ВладельцыФайлов, ТипыФайлов = Неопределено, ПодписанЭП = Неопределено, ИменаФайлов = Неопределено) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.ВладелецФайла В(&ВладельцыФайлов)
	|	И &ТипыФайлов
	|	И &ПодписанЭП
	|	И &ИменаФайлов";
	
	Если ЗначениеЗаполнено(ТипыФайлов) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипыФайлов", "Т.ТипФайла В(&ТипыФайлов)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипыФайлов", "ИСТИНА");
	КонецЕсли;
	
	Если ПодписанЭП <> Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодписанЭП", "Т.ПодписанЭП = &ПодписанЭП");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодписанЭП", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИменаФайлов) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИменаФайлов", "Т.ИмяФайла В(&ИменаФайлов)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИменаФайлов", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВладельцыФайлов", ЗначениеВМассиве(ВладельцыФайлов));
	Запрос.УстановитьПараметр("ПодписанЭП", ПодписанЭП);
	Запрос.УстановитьПараметр("ТипыФайлов", ТипыФайлов);
	Запрос.УстановитьПараметр("ИменаФайлов", ИменаФайлов);
	
	Результат = МассивИзРезультатаЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

// Находит в базе нужный файл
//
// Параметры:
//  ВладелецФайла - СправочникСсылка.КонтурМаркировка_Файлы - владелец файлов;
//  ТипФайла - Строка - (необязательный) тип файла, см. Перечисление_ТипыФайлов();
//  ПодписанЭП - Булево - (необязательный) Истина, если нужно получить подписанные файлы;
//  ИмяФайла - Строка - (необязательный) имя файла;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Файлы
//
Функция Файл_Найти(ВладелецФайла, ТипФайла = Неопределено, ПодписанЭП = Неопределено, ИмяФайла = Неопределено) Экспорт
	
	МассивФайлов = Файлы_Найти(ВладелецФайла, ТипФайла, ПодписанЭП, ИмяФайла);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивФайлов) Тогда
		Результат = МассивФайлов[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует описание файлов по ссылкам
//
// Параметры:
//  МассивФайлов - Массив - ссылки на файл;
// 
// Возвращаемое значение:
//  Массив - содержит структуры, см. Новый_ОписаниеФайла();
//
Функция Файлы_Прочитать(МассивФайлов) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Файлы.Ссылка КАК Ссылка,
	|	Файлы.ТипФайла КАК ТипФайла,
	|	Файлы.ИмяФайла КАК ИмяФайла,
	|	Файлы.ВладелецФайла КАК ВладелецФайла,
	|	Файлы.Размер КАК Размер,
	|	Файлы.Расширение КАК Расширение,
	|	Файлы.ДатаСоздания КАК ДатаСоздания,
	|	Файлы.ПодписанЭП КАК ПодписанЭП,
	|	Файлы.Зашифрован КАК Зашифрован,
	|	Файлы.Идентификатор КАК Идентификатор,
	|	Файлы.Ответственный КАК Ответственный,
	|	Файлы.ВерсияДанных КАК ВерсияДанных,
	|	Файлы.ВерсияФормата КАК ВерсияФормата,
	|	ДанныеФайлов.ДанныеФайла КАК ДанныеФайла
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Файлы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ДанныеФайлов КАК ДанныеФайлов
	|		ПО Файлы.Ссылка = ДанныеФайлов.Файл
	|ГДЕ
	|	Файлы.Ссылка В(&МассивФайлов)");
	
	Запрос.УстановитьПараметр("МассивФайлов", МассивФайлов);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		ПроверитьОбъектВПроцессеОбновления(Выборка.Ссылка);
		
		Если ЗначениеЗаполнено(Выборка.ДанныеФайла) Тогда
			ОписаниеФайла = Новый_ОписаниеФайла();
			ЗаполнитьЗначенияСвойств(ОписаниеФайла, Выборка, , "ДанныеФайла");
			ОписаниеФайла.ДанныеФайла = Выборка.ДанныеФайла.Получить();
			Результат.Добавить(ОписаниеФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует описание файла по ссылке
//
// Параметры:
//  Файл - СправочникСсылка.КонтурМаркировка_Файлы - ссылка на файл;
// 
// Возвращаемое значение:
//  Структура - см. Новый_ОписаниеФайла()
//
Функция Файл_Прочитать(Файл) Экспорт
	
	ОписанияФайлов = Файлы_Прочитать(Файл);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(ОписанияФайлов) Тогда
		Результат = ОписанияФайлов[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает файл в базу
//
// Параметры:
//  Файл - Произвольный - данные, которые нужно сохранить;
//  ТипФайла - Строка - см. Перечисление_ТипыФайлов();
//  ВладелецФайла - СправочникСсылка - владелец файла;
//  ИдентификаторФайла - Строка - (необязательный) уникальный идентификатор файла в сервисе;
//  Зашифрован - Булево - (необязательный) уникальный идентификатор файла в сервисе;
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_Файлы
//
Функция Файл_Добавить(ДанныеФайла, ТипФайла, ВладелецФайла = Неопределено, ИдентификаторФайла = Неопределено, Зашифрован = Ложь) Экспорт
	
	ОписаниеФайла = Новый_ОписаниеФайла();
	ОписаниеФайла.ДанныеФайла = ДанныеФайла;
	ОписаниеФайла.ТипФайла = ТипФайла;
	ОписаниеФайла.Зашифрован = Зашифрован;
	ОписаниеФайла.ВладелецФайла = ВладелецФайла;
	ОписаниеФайла.Идентификатор = ИдентификаторФайла;
	
	Файл_Записать(ОписаниеФайла);
	
	Возврат ОписаниеФайла.Ссылка;
	
КонецФункции

// Записывает в базу файл, который нужно будет подписать
//
// Параметры:
//  ВладелецФайла - СправочникСсылка - владелец файла;
//  ФайлДляПодписи - Произвольный - файл для подписи;
//  ИдентификаторКонтента - Строка - идентификатор контента;
//
Функция Файл_СохранитьФайлДляПодписи(ВладелецФайла, Контент, ИдентификаторКонтента) Экспорт
	
	ТипФайла = Перечисление_ТипыФайлов().КонтентДляПодписи;
	
	Возврат Файл_Добавить(Контент, ТипФайла, ВладелецФайла, ИдентификаторКонтента);
	
КонецФункции

// Находит один файл подписи
//
// Параметры:
//  ВладелецФайла - СправочникСсылка - владелец файла;
// 
// Возвращаемое значение:
//  Структура - см. Новый_ОписаниеФайла()
//
Функция Файл_НайтиФайлПодписи(ВладелецФайла) Экспорт
	
	МассивФайлов = Файл_НайтиФайлыПодписей(ВладелецФайла);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивФайлов) Тогда
		Результат = МассивФайлов[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит файлы подписей по владельцу
//
// Параметры:
//  ВладелецФайла - СправочникСсылка - владелец файлов;
// 
// Возвращаемое значение:
//  Массив - содержит структуры, см. Новый_ОписаниеФайла()
//
Функция Файл_НайтиФайлыПодписей(ВладелецФайла) Экспорт
	
	ТипФайла = Перечисление_ТипыФайлов().КонтентДляПодписи;
	Результат = Файлы_Найти(ВладелецФайла, ТипФайла);
	
	Возврат Результат;
	
КонецФункции

// Находит файл по идентификатору
//
// Параметры:
//  ВладелецФайла - СправочникСсылка - владелец файла;
//  Идентификатор - Строка - идентификатор файла;
//  ТипФайла - Строка - см. Перечисление_ТипыФайлов();
//  ИмяФайла - Строка - (необязательный) имя файла;
// 
// Возвращаемое значение:
//  Структура - см. Новый_ОписаниеФайла()
//
Функция Файл_НайтиПоИдентификатору(ВладелецФайла, Идентификатор, ТипФайла, ИмяФайла = "") Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.ВладелецФайла = &ВладелецФайла
	|	И Т.Идентификатор = &Идентификатор
	|	И Т.ТипФайла = &ТипФайла
	|	И &ИмяФайла";
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Условие = "Т.ИмяФайла = &ИмяФайла";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяФайла", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяФайла", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВладелецФайла", ВладелецФайла);
	Запрос.УстановитьПараметр("Идентификатор", Строка(Идентификатор));
	Запрос.УстановитьПараметр("ТипФайла", ТипФайла);
	Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
	
	Результат = ПолучитьРезультатЗапроса(Запрос, "Ссылка", ПустойФайл());
	
	Возврат Результат;
	
КонецФункции

// Проверяет что файл еще есть в базе
//
// Параметры:
//  Файл - СправочникСсылка.КонтурМаркировка_Файлы - ссылка на файл, который нужно проверить;
// 
// Возвращаемое значение:
//  Булево - Истина, если файл существует
//
Функция Файл_Существует(Файл) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.Ссылка = &Файл");
	
	Запрос.УстановитьПараметр("Файл", Файл);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Проверяет что файл подписан
//
// Параметры:
//  Файл - СправочникСсылка.КонтурМаркировка_Файлы - ссылка на файл, который нужно проверить;
// 
// Возвращаемое значение:
//  Булево - Истина, если файл подписан
//
Функция Файл_Подписан(Файл) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.ПодписанЭП КАК ПодписанЭП
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.Ссылка = &Файл");
	
	Запрос.УстановитьПараметр("Файл", Файл);
	
	Результат = ПолучитьРезультатЗапроса(Запрос, "ПодписанЭП", Ложь);
	
	Возврат Результат;
	
КонецФункции

// Удаляет один или несколько файлов
//
// Параметры:
//  Файлы - Массив, СправочникСсылка.КонтурМаркировка_Файлы - файлы, которые нужно удалить
//
Процедура Файлы_Удалить(Файлы) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Идентификатор КАК Идентификатор
	|ИЗ
	|	Справочник.КонтурМаркировка_Файлы КАК Т
	|ГДЕ
	|	Т.Ссылка В(&Файлы)");
	Запрос.УстановитьПараметр("Файлы", Файлы);
	
	ТаблицаФайлов = Запрос.Выполнить().Выгрузить();
	Если Не ЗначениеЗаполнено(ТаблицаФайлов) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Файлы_ЗаблокироватьПоТаблице(ТаблицаФайлов);
		
		Для Каждого Стр Из ТаблицаФайлов Цикл
			
			Набор = РегистрыСведений.КонтурМаркировка_ДанныеФайлов.СоздатьНаборЗаписей();
			Набор.ОбменДанными.Загрузка = Истина;
			Набор.Отбор.Файл.Установить(Стр.Ссылка);
			Набор.Записать();
			
			Объект = Стр.Ссылка.ПолучитьОбъект();
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Удалить();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Записывает файл в базу
//
// Параметры:
//  ОписаниеФайла - Структура - см. Новый_ОписаниеФайла()
//
Функция Файл_Записать(ОписаниеФайла) Экспорт
	
	Ссылка = ОписаниеФайла.Ссылка;
	
	Если Не ЗначениеЗаполнено(Ссылка) И ЗначениеЗаполнено(ОписаниеФайла.Идентификатор) Тогда
		Ссылка = Файл_НайтиПоИдентификатору(ОписаниеФайла.ВладелецФайла, ОписаниеФайла.Идентификатор, ОписаниеФайла.ТипФайла, ОписаниеФайла.ИмяФайла);
	КонецЕсли;
	
	ЭтоНовыйФайл = Ложь;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = Справочники.КонтурМаркировка_Файлы.ПолучитьСсылку();
		ЭтоНовыйФайл = Истина;
	КонецЕсли;
	
	Если Не ЭтоНовыйФайл Тогда
		ПроверитьОбъектВПроцессеОбновления(Ссылка);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеФайла.ДатаСоздания) Тогда
		Если ЭтоНовыйФайл Тогда
			ОписаниеФайла.ДатаСоздания = ТекущаяДатаСеанса();
		Иначе
			ОписаниеФайла.ДатаСоздания = Ссылка.ДатаСоздания;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеФайла.Идентификатор) Тогда
		ОписаниеФайла.Идентификатор = Ссылка.УникальныйИдентификатор();
	КонецЕсли;
	ОписаниеФайла.Идентификатор = Строка(ОписаниеФайла.Идентификатор);
	
	Если ТипЗнч(ОписаниеФайла.ДанныеФайла) = Тип("ДвоичныеДанные") Тогда
		ОписаниеФайла.Размер = ОписаниеФайла.ДанныеФайла.Размер();
	Иначе
		Если ЭтоТаблицаЗначений(ОписаниеФайла.ДанныеФайла)
			Или ЭтоМассив(ОписаниеФайла.ДанныеФайла)
			Или ЭтоСоответствие(ОписаниеФайла.ДанныеФайла) Тогда
			ОписаниеФайла.Размер = ОписаниеФайла.ДанныеФайла.Количество();
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеФайла.ИмяФайла) Тогда
		ОписаниеФайла.Расширение = РасширениеФайла(ОписаниеФайла.ИмяФайла);
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		Если ЭтоНовыйФайл Тогда
			Объект = Справочники.КонтурМаркировка_Файлы.СоздатьЭлемент();
			Объект.УстановитьСсылкуНового(Ссылка);
		Иначе
			Файл_Заблокировать(ОписаниеФайла.Идентификатор);
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Объект, ОписаниеФайла, , "ВерсияДанных, Ответственный");
		Объект.Ответственный = ТекущийПользовательМаркировки();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		
		Набор = РегистрыСведений.КонтурМаркировка_ДанныеФайлов.СоздатьНаборЗаписей();
		Набор.Отбор.Файл.Установить(Ссылка);
		
		Запись = Набор.Добавить();
		Запись.ДанныеФайла = ЗначениеВХранилище(ОписаниеФайла.ДанныеФайла);
		Запись.Файл = Ссылка;
		
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать(Не ЭтоНовыйФайл);
		
		ОписаниеФайла.Ссылка = Ссылка;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Ссылка;
	
КонецФункции

// Устанавливает исключительную блокировку файла в справочнике
//
// Параметры:
//  Идентификатор - Строка, УникальныйИдентификатор - идентификатор файла
//
Процедура Файл_Заблокировать(Идентификатор)
	
	Значения = Новый Структура("Идентификатор", Строка(Идентификатор));
	ИмяОбъекта = "Справочник.КонтурМаркировка_Файлы";
	
	Если ПоддерживаютсяПоляБлокировкиДанных() Тогда
		ЗаблокироватьПоЗначениям(ИмяОбъекта, Значения);
	Иначе
		ЗаблокироватьПоЗначениямДляИзменения(ИмяОбъекта, Значения);
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает исключительную блокировку файлов в справочнике по идентификатору
//
// Параметры:
//  Таблица - ТаблицаЗначений, РезультатЗапроса - таблица с идентификаторами;
//  ИмяКолонки - Строка - (необязательный) колонка с идентификатором;
//
Процедура Файлы_ЗаблокироватьПоТаблице(Таблица, ИмяКолонки = "Идентификатор")
	
	Если ТипЗнч(Таблица) = Тип("РезультатЗапроса") Тогда
		ИсточникДанных = Таблица.Выгрузить(ОбходРезультатаЗапроса.Прямой).Скопировать(, ИмяКолонки);
	Иначе
		ИсточникДанных = Таблица.Скопировать(, ИмяКолонки);
	КонецЕсли;
	ИсточникДанных.Свернуть(ИмяКолонки);
	ТаблицаЗначений_УдалитьПустыеСтроки(ИсточникДанных, ИмяКолонки);
	
	Если Не ЗначениеЗаполнено(ИсточникДанных) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИсточникДанных[0][ИмяКолонки]) = Тип("УникальныйИдентификатор") Тогда
		ДлинаИдентификатора = 36;
		ТаблицаИдентификаторов = Новый ТаблицаЗначений;
		ТаблицаИдентификаторов.Колонки.Добавить(ИмяКолонки, ОписаниеТипа_Строка(ДлинаИдентификатора));
		ТаблицаЗначений_Дополнить(ТаблицаИдентификаторов, ИсточникДанных);
		ИсточникДанных.Очистить();
	Иначе
		ТаблицаИдентификаторов = ИсточникДанных;
	КонецЕсли;
	
	Поле = "Идентификатор";
	ИмяОбъекта = "Справочник.КонтурМаркировка_Файлы";
	
	Если ПоддерживаютсяПоляБлокировкиДанных() Тогда
		ЗаблокироватьПоТаблице(ИмяОбъекта, Поле, ТаблицаИдентификаторов, ИмяКолонки);
	Иначе
		ЗаблокироватьПоТаблицеДляИзменения(ИмяОбъекта, Поле, ТаблицаИдентификаторов, ИмяКолонки);
	КонецЕсли;
	
КонецПроцедуры

// Записывает в базу файл, который нужно будет подписать
//
// Параметры:
//  ВладелецФайла - СправочникСсылка - владелец файла;
//  Контент - Произвольный - файл для подписи;
//  ИдентификаторКонтента - Строка - идентификатор контента;
//
Процедура Файл_СохранитьКонтентДляПодписи(ВладелецФайла, Контент, ИдентификаторКонтента)
	
	ТипФайла = Перечисление_ТипыФайлов().КонтентДляПодписи;
	Файл_Добавить(Контент, ТипФайла, ВладелецФайла, ИдентификаторКонтента);
	
КонецПроцедуры

// Удаляет контент для подписи
//
// Параметры:
//  ВладелецФайла - СправочникСсылка - владелец файла;
//
Процедура Файл_УдалитьКонтентДляПодписи(ВладелецФайла)
	
	ТипФайла = Перечисление_ТипыФайлов().КонтентДляПодписи;
	Файлы_Удалить(Файлы_Найти(ВладелецФайла, ТипФайла));
	
КонецПроцедуры

// Контракт для чтения и записи файла
//
// Параметры:
//  ТипФайла - Строка - (необязательный) см. функцию Перечисление_ТипыФайлов();
// 
// Возвращаемое значение:
//  Структура
//
Функция Новый_ОписаниеФайла(ТипФайла = "") Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеФайла");
	Результат.Вставить("Ссылка");
	Результат.Вставить("ТипФайла", ТипФайла);
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("ВладелецФайла");
	Результат.Вставить("ДатаСоздания", '00010101');
	Результат.Вставить("Размер", 0);
	Результат.Вставить("Расширение", "");
	Результат.Вставить("ПодписанЭП", Ложь);
	Результат.Вставить("Зашифрован", Ложь);
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("ВерсияДанных", "");
	Результат.Вставить("ВерсияФормата", "");
	Результат.Вставить("Ответственный");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // Файлы

// #Область ОтчетПоВиртуальномуСкладу

// Создает и обновляет товары по данным сервиса на основании переданного массива GTIN
//
// Параметры:
//  МассивGTIN - Массив - содержит строки GTIN;
//  Организация - СправочникСсылка.КонтурМаркировка_Организации - организация;
// 
// Возвращаемое значение:
//  Структура - содержит количество созданных и обновленных товаров;
//
Функция ОтчетПоВиртуальномуСкладу_ПолучитьИнформациюИзСервиса(МассивGTIN, Организация) Экспорт
	
	РазмерПорции = 1000;
	МассивПорцийGTIN = РазбитьМассив(МассивGTIN, РазмерПорции);
	
	Результат = Новый_ТаблицаДанныхСервисаПоВиртуальномуОстатку();
	
	Для Каждого ПорцияGTIN Из МассивПорцийGTIN Цикл
		
		Ответ = Маркировка_ОтчетОбОстаткахПоВиртуальномуСкладу(ПорцияGTIN, Организация);
		
		Для Каждого ДанныеОGTIN Из Ответ Цикл
			
			НоваяСтрока = Результат.Добавить();
			
			НоваяСтрока.gtin                  = ЗначениеСоответствия(ДанныеОGTIN, "gtin", "");
			НоваяСтрока.saldo                 = ЗначениеСоответствия(ДанныеОGTIN, "saldo", 0);
			НоваяСтрока.actualInput           = ЗначениеСоответствия(ДанныеОGTIN, "actualInput", 0);
			НоваяСтрока.actualOutput          = ЗначениеСоответствия(ДанныеОGTIN, "actualOutput", 0);
			НоваяСтрока.quantity              = ЗначениеСоответствия(ДанныеОGTIN, "quantity", 0);
			НоваяСтрока.netWeightGram         = ЗначениеСоответствия(ДанныеОGTIN, "netWeightGram", 0) / ГраммВКилограмме();
			НоваяСтрока.volumeMl              = ЗначениеСоответствия(ДанныеОGTIN, "volumeMl", 0) / МиллилитровВЛитре();
			НоваяСтрока.actualOperationsCount = ЗначениеСоответствия(ДанныеОGTIN, "actualOperationsCount", 0);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ТаблицаДанныхСервисаПоВиртуальномуОстатку() Экспорт
	
	ТипЧисло = ОписаниеТипа_Число();
	ТипСтрока = ОписаниеТипа_Строка();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("gtin", ТипСтрока);
	Результат.Колонки.Добавить("saldo", ТипЧисло);
	Результат.Колонки.Добавить("actualInput", ТипЧисло);
	Результат.Колонки.Добавить("actualOutput", ТипЧисло);
	Результат.Колонки.Добавить("quantity", ТипЧисло);
	Результат.Колонки.Добавить("netWeightGram", ТипЧисло);
	Результат.Колонки.Добавить("volumeMl", ТипЧисло);
	Результат.Колонки.Добавить("actualOperationsCount", ТипЧисло);
	
	Результат.Индексы.Добавить("gtin");
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ОтчетПоВиртуальномуСкладу

// #Область ОбменССервисом

// #Область Интерфейс

// Выполняет авторизацию в сервисе Контур.Маркировка и продлевает доступ в ГИС МТ если нужно
//
// Параметры:
//  Организация1С - СправочникСсылка - организация;
//  ВызыватьИсключение - Булево - (необязательный) Ложь, если вызывать исключение при ошибке не нужно;
// 
// Возвращаемое значение:
//  Булево - Истина, если авторизация выполнена успешно
//
Функция ВыполнитьАвторизацию(Организация1С, ВызыватьИсключение = Истина) Экспорт
	
	Если ТипЗнч(Организация1С) = Тип("СправочникСсылка.КонтурМаркировка_Организации") Тогда
		Организация = Организация1С;
	Иначе
		Организация = Организация_НайтиПоОрганизации1С(Организация1С, Истина);
	КонецЕсли;
	
	КонтекстОбмена = КонтекстОбменаССервисом(Организация);
	КонтекстОбмена.ВызыватьИсключение = ВызыватьИсключение;
	
	Результат = Авторизация_Выполнить(КонтекстОбмена);
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьОбменССервисом(КонтекстОбмена) Экспорт
	
	Если Не КонтекстОбмена.ОбменВозможен Тогда
		Возврат;
	КонецЕсли;
	
	Организация = КонтекстОбмена.Организация;
	ДокументУчета = КонтекстОбмена.ДокументУчета;
	ЭтоФоновоеЗадание = ЭтоФоновоеЗадание();
	ОбработатьЛентуСобытий = Не ЗначениеЗаполнено(КонтекстОбмена.Операции);
	
	ОбновитьПоляТоваров();
	ОбновитьАнкету(Организация);
	ОбновитьПоляОрганизаций(Организация);
	
	Попытка
		
		ВыполнитьОбмен = Истина;
		Пока ВыполнитьОбмен Цикл
			ОчередьОбмена_ВыполнитьОбмен(КонтекстОбмена);
			ВыполнитьОбмен = ОбработатьЛентуСобытий И Лента_ОбработатьНовыеСобытия(Организация);
		КонецЦикла;
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		Действие = НСтр("ru = 'Обмен с сервисом'");
		ДопИнформация = Новый Структура;
		
		ТекстСообщения = НСтр("ru = 'Не удалось выполнить обмен с сервисом ""%1""'");
		
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ДопИнформация.Вставить("ДокументУчета", ДокументУчета);
			ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, ДокументУчета);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Организация) Тогда
			ДопИнформация.Вставить("Организация", Организация);
			ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, Организация);
		КонецЕсли;
		
		ОбработатьОшибку(Действие, Ошибка, ДопИнформация, ТекстСообщения);
		
		Если ЭтоФоновоеЗадание Тогда
			БуферОшибок_ЗаписатьВСообщение();
		КонецЕсли;
		
		Если КонтекстОбмена.ВызыватьИсключение Или ЭтоФоновоеЗадание Тогда
			ВызватьИсключение;
		КонецЕсли;
		
	КонецПопытки;
	
	Если ЭтоФоновоеЗадание Тогда
		БуферОшибок_ЗаписатьВСообщение();
	КонецЕсли;
	
	ОтправитьМетрики();
	
КонецПроцедуры

Функция КонтекстОбменаССервисом(Организация, Сертификат = Неопределено, ПродлеватьДоступГИС = Истина) Экспорт
	
	Результат = Новый_КонтекстОбмена(Организация);
	Результат.ПродлеватьДоступГИС = ПродлеватьДоступГИС;
	
	Если ЗначениеЗаполнено(Сертификат) Тогда
		Результат.Сертификат = Сертификат;
		Результат.ОтпечатокСертификата = Сертификат.ОтпечатокСертификата;
	Иначе
		КонтекстОбмена_ЗаполнитьСертификат(Результат);
	КонецЕсли;
	
	КонтекстОбмена_ПроверитьОрганизацию(Результат);
	КонтекстОбмена_ПроверитьАвторизацию(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция Задача_Создать(Операция, ПервоеДействие = Неопределено) Экспорт
	
	Реквизиты = ЗначенияРеквизитовОбъектаЛок(Операция, "Организация, ТипОперации");
	Организация = Реквизиты.Организация;
	ТипОперации = Реквизиты.ТипОперации;
	
	Если ПервоеДействие = Неопределено Тогда
		ПервоеДействие = Операция_ПервоеДействие(ТипОперации);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПервоеДействие) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеЗадачи = Задача_Прочитать(Операция);
	Если ОписаниеЗадачи = Неопределено Тогда
		ОписаниеЗадачи = Новый_ЗадачаОбмена();
	КонецЕсли;
	
	ОписаниеЗадачи.Операция = Операция;
	ОписаниеЗадачи.Организация = Организация;
	ОписаниеЗадачи.НовоеДействие = ПервоеДействие;
	ОписаниеЗадачи.ОписаниеОшибки = "";
	Задача_Записать(ОписаниеЗадачи);
	
	Если Операция_ВлияетНаТребуемоеДействиеДокумента(Операция) Тогда
		ДокументУчета_ОбновитьТребуемоеДействие(Операция.ДокументУчета);
	КонецЕсли;
	
	Возврат ОписаниеЗадачи;
	
КонецФункции

Процедура Задача_Завершить(ОписаниеЗадачи)
	
	ОписаниеЗадачи.НовоеДействие = Перечисление_ТребуемыеДействия().ОперацияЗавершена;
	ОписаниеЗадачи.НовыйСтатусОперации = Перечисление_СтатусыОпераций().ОперацияЗавершена;
	Задача_Записать(ОписаниеЗадачи);
	
КонецПроцедуры

Процедура Задача_Записать(ОписаниеЗадачи) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписаниеЗадачи.ДатаПостановки) Тогда
		ОписаниеЗадачи.ДатаПостановки = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеЗадачи.НовоеДействие) Тогда
		Если ОписаниеЗадачи.НовоеДействие <> ОписаниеЗадачи.ТребуемоеДействие Тогда
			ОписаниеЗадачи.ПредыдущееДействие = ОписаниеЗадачи.ТребуемоеДействие;
			ОписаниеЗадачи.ТребуемоеДействие = ОписаниеЗадачи.НовоеДействие;
		КонецЕсли;
		ОписаниеЗадачи.НовоеДействие = "";
	КонецЕсли;
	
	Если ТипЗнч(ОписаниеЗадачи.ОписаниеОшибки) = Тип("ИнформацияОбОшибке") Тогда
		ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки = КраткоеПредставлениеОшибки(ОписаниеЗадачи.ОписаниеОшибки);
		ОписаниеЗадачи.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ОписаниеЗадачи.ОписаниеОшибки);
	Иначе
		ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки = ОписаниеЗадачи.ОписаниеОшибки;
	КонецЕсли;
	ОписаниеЗадачи.ОписаниеОшибки = УдалитьНедопустимыеСимволыXML(ОписаниеЗадачи.ОписаниеОшибки);
	ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки = УдалитьНедопустимыеСимволыXML(ОписаниеЗадачи.ДопРеквизиты.КраткоеОписаниеОшибки);
	
	НачатьТранзакцию(РежимУправленияБлокировкой());
	
	Попытка
		
		ОчередьОбмена_Заблокировать(ОписаниеЗадачи.Операция);
		
		Если ЗначениеЗаполнено(ОписаниеЗадачи.НовыйСтатусОперации) Тогда
			СтатусыОперации_ЗаписатьОсновнойСтатус(ОписаниеЗадачи.Операция, ОписаниеЗадачи.НовыйСтатусОперации);
		КонецЕсли;
		
		Запись = РегистрыСведений.КонтурМаркировка_ОчередьОбмена.СоздатьМенеджерЗаписи();
		Запись.Операция = ОписаниеЗадачи.Операция;
		Запись.Прочитать();
		
		ОбновленаЗапись = Задача_Записать_ОбновитьЗапись(Запись, ОписаниеЗадачи);
		ОбновленыДопРеквизиты = Задача_Записать_ОбновитьДопРеквизиты(Запись, ОписаниеЗадачи);
		
		Если ОбновленаЗапись Или ОбновленыДопРеквизиты Тогда
			Запись.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция Задача_Записать_ОбновитьЗапись(Запись, ОписаниеЗадачи)
	
	ОбновленаЗапись = Ложь;
	МодульОбщегоНазначения = МодульОбщегоНазначения();
	
	Для каждого Элемент Из ОписаниеЗадачи Цикл
		
		ИмяРеквизита = Элемент.Ключ;
		НовоеЗначение = Элемент.Значение;
		
		Если ИмяРеквизита = "ДопРеквизиты" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущееЗначение = МодульОбщегоНазначения.СвойствоОбъекта(Запись, ИмяРеквизита, Null);
		Если ТекущееЗначение = Null Тогда
			Продолжить; // Такого реквизита нет
		КонецЕсли;
		
		Если НовоеЗначение <> ТекущееЗначение Тогда
			Запись[ИмяРеквизита] = НовоеЗначение;
			ОбновленаЗапись = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбновленаЗапись;
	
КонецФункции

Функция Задача_Записать_ОбновитьДопРеквизиты(Запись, ОписаниеЗадачи)
	
	ОбновленыДопРеквизиты = Ложь;
	
	ДопРеквизитыИБ = Запись.ДопРеквизиты.Получить();
	Если ДопРеквизитыИБ = Неопределено Тогда
		ДопРеквизитыИБ = Новый Структура;
	КонецЕсли;
	
	Для каждого Элемент Из ОписаниеЗадачи.ДопРеквизиты Цикл
		
		ИмяРеквизита = Элемент.Ключ;
		НовоеЗначение = Элемент.Значение;
		ЕстьНовоеЗначение = (НовоеЗначение <> Ложь И ЕстьЗначение(НовоеЗначение));
		
		ТекущееЗначение = Неопределено;
		ЕстьТекущееЗначение = ДопРеквизитыИБ.Свойство(ИмяРеквизита, ТекущееЗначение);
		
		Если ЕстьНовоеЗначение Тогда
			
			Если ИмяРеквизита = "ПроизвольныеДопРеквизиты" Тогда
				ЗначениеИзменено = ОбъектыОтличаются(НовоеЗначение, ТекущееЗначение);
			Иначе
				ЗначениеИзменено = НовоеЗначение <> ТекущееЗначение;
			КонецЕсли;
			
			Если ЗначениеИзменено Тогда
				ДопРеквизитыИБ.Вставить(ИмяРеквизита, НовоеЗначение);
				ОбновленыДопРеквизиты = Истина;
			КонецЕсли;
			
		Иначе
			Если ЕстьТекущееЗначение Тогда
				ДопРеквизитыИБ.Удалить(ИмяРеквизита);
				ОбновленыДопРеквизиты = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОбновленыДопРеквизиты Тогда
		Если ЗначениеЗаполнено(ДопРеквизитыИБ) Тогда
			Запись.ДопРеквизиты = ЗначениеВХранилище(ДопРеквизитыИБ);
		Иначе
			Запись.ДопРеквизиты = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОбновленыДопРеквизиты;
	
КонецФункции

Функция Задача_Прочитать(Операция) Экспорт
	
	МассивЗадач = Задачи_Прочитать(Операция);
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(МассивЗадач) Тогда
		Результат = МассивЗадач[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Задачи_Прочитать(Операции) Экспорт
	
	ТипыБизнесПроцессов = ОчередьОбмена_ТипыОперацийБизнесПроцессов();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ОчередьОбмена.*,
	|	Операции.Склад КАК Склад,
	|	Операции.ТипОперации КАК ТипОперации,
	|	Операции.ДокументУчета КАК ДокументУчета,
	|	Операции.ОперацияОснование КАК ОперацияОснование,
	|	Операции.КлючСтрокиОперацииОснования КАК КлючСтрокиОперацииОснования
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ОчередьОбмена.Операция = Операции.Ссылка
	|ГДЕ
	|	ОчередьОбмена.Операция В(&Операции)");
	Запрос.УстановитьПараметр("Операции", Операции);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		СтрБП = ТипыБизнесПроцессов.Найти(Выборка.ТипОперации, "ТипОперации");
		Если СтрБП = Неопределено Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось определить тип бизнес процесса для типа операции: %1'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, Выборка.ТипОперации);
		КонецЕсли;
		
		ОписаниеЗадачи = Новый_ЗадачаОбмена();
		ЗаполнитьЗначенияСвойств(ОписаниеЗадачи, Выборка, , "ДопРеквизиты");
		ОписаниеЗадачи.ТипБизнесПроцесса = СтрБП.ТипБизнесПроцесса;
		
		ДопРеквизитыИБ = Выборка.ДопРеквизиты.Получить();
		Если ЗначениеЗаполнено(ДопРеквизитыИБ) Тогда
			ЗаполнитьПоляСтруктуры(ОписаниеЗадачи.ДопРеквизиты, ДопРеквизитыИБ);
		КонецЕсли;
		
		Результат.Добавить(ОписаниеЗадачи);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОчередьОбмена_НайтиОперации(КонтекстОбмена, ТребуемыеДействия, ТипБизнесПроцесса = Неопределено, Количество = Неопределено)
	
	Операции = КонтекстОбмена.Операции;
	Организация = КонтекстОбмена.Организация;
	ДокументыУчета = КонтекстОбмена.ДокументУчета;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.ТипБизнесПроцесса КАК ТипБизнесПроцесса,
	|	Т.ТипОперации КАК ТипОперации
	|ПОМЕСТИТЬ ТипыОперацийБизнесПроцессов
	|ИЗ
	|	&ТипыОперацийБизнесПроцессов КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТипОперации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Операции.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Операции КАК Операции
	|		ПО ОчередьОбмена.Операция = Операции.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТипыОперацийБизнесПроцессов КАК ТипыОперацийБизнесПроцессов
	|		ПО (Операции.ТипОперации = ТипыОперацийБизнесПроцессов.ТипОперации)
	|ГДЕ
	|	ОчередьОбмена.Организация = &Организация
	|	И ОчередьОбмена.ТребуемоеДействие В(&ТребуемыеДействия)
	|	И &ОперацииОбмена
	|	И &ДокументыУчета
	|	И &ТипБизнесПроцесса";
	
	Если Количество <> Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", ТекстЗапросаВыбратьПервые(Количество));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументыУчета) Тогда
		Условие = "Операции.ДокументУчета В (&ДокументыУчета)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументыУчета", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументыУчета", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Операции) Тогда
		ОперацииОбмена = Операции_НайтиПодчиненныеОперации(Операции, Истина);
		ДополнитьМассив(ОперацииОбмена, Операции, Истина, Ложь);
		Условие = "ОчередьОбмена.Операция В (&ОперацииОбмена)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОбмена", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОперацииОбмена", "ИСТИНА");
	КонецЕсли;
	
	Если ТипБизнесПроцесса <> Неопределено Тогда
		Условие = "ТипыОперацийБизнесПроцессов.ТипБизнесПроцесса = &ТипБизнесПроцесса";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипБизнесПроцесса", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипБизнесПроцесса", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОперацииОбмена", ОперацииОбмена);
	Запрос.УстановитьПараметр("ДокументыУчета", ЗначениеВМассиве(ДокументыУчета));
	Запрос.УстановитьПараметр("ТребуемыеДействия", ТребуемыеДействия);
	Запрос.УстановитьПараметр("ТипБизнесПроцесса", ТипБизнесПроцесса);
	Запрос.УстановитьПараметр("ТипыОперацийБизнесПроцессов", ОчередьОбмена_ТипыОперацийБизнесПроцессов());
	
	Результат = МассивИзРезультатаЗапроса(Запрос);
	
	Возврат Результат;
	
КонецФункции

Функция ОчередьОбмена_ОперацииГотовыеКОтправкеПодписи(Организация, ДокументыУчета = Неопределено)
	
	ТипыФайлов = Перечисление_ТипыФайлов();
	ТребуемыеДействия = Перечисление_ТребуемыеДействия();
	
	ПодходящиеДействия = Новый Массив;
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ПодписатьФайл);
	ПодходящиеДействия.Добавить(ТребуемыеДействия.ПодписатьФайлЗакрытияЗаказа);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОчередьОбмена.Операция КАК Операция
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ОчередьОбмена КАК ОчередьОбмена
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Файлы КАК Файлы
	|		ПО ОчередьОбмена.Операция = Файлы.ВладелецФайла
	|ГДЕ
	|	ОчередьОбмена.Организация = &Организация
	|	И ОчередьОбмена.ТребуемоеДействие В(&ПодходящиеДействия)
	|	И Файлы.ТипФайла = &ТипФайла
	|	И &ДокументыУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	ОчередьОбмена.Операция
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(Файлы.ПодписанЭП) = ИСТИНА";
	
	ТипФайла = ТипыФайлов.КонтентДляПодписи;
	
	Если ЗначениеЗаполнено(ДокументыУчета) Тогда
		Условие = "ОчередьОбмена.Операция.ДокументУчета В (&ДокументыУчета)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументыУчета", Условие);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументыУчета", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДокументыУчета", ЗначениеВМассиве(ДокументыУчета));
	Запрос.УстановитьПараметр("ПодходящиеДействия", ПодходящиеДействия);
	Запрос.УстановитьПараметр("ТипФайла", ТипыФайлов.КонтентДляПодписи);
	
	Возврат МассивИзРезультатаЗапроса(Запрос, "Операция");
	
КонецФункции

// #КонецОбласти // Интерфейс

// #Область СлужебныеМетоды

Процедура КонтекстОбмена_ЗаполнитьСертификат(КонтекстОбмена)
	
	Организация = КонтекстОбмена.Организация;
	
	Сертификат = НастройкаПодписания_ПодобратьСертификат(Организация);
	
	Если ЗначениеЗаполнено(Сертификат) Тогда
		КонтекстОбмена.Сертификат = Сертификат;
		КонтекстОбмена.ОтпечатокСертификата = Сертификат.ОтпечатокСертификата;
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтекстОбмена_ПроверитьОрганизацию(КонтекстОбмена)
	
	ОписаниеОрганизации = Организация_Прочитать(КонтекстОбмена.Организация);
	КонтекстОбмена.ОбменВозможен = Истина;
	
	Если Не ЗначениеЗаполнено(КонтекстОбмена.Сертификат) Тогда
		КонтекстОбмена.ОбменВозможен = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ОписаниеОрганизации.ДопРеквизиты.ОтключитьОбмен Тогда
		КонтекстОбмена.ОбменВозможен = Ложь;
		КонтекстОбмена.ОбменОтключен = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОрганизации.Идентификатор) Тогда
		КонтекстОбмена.ОбменВозможен = Ложь;
		КонтекстОбмена.НеУказанИдентификаторОрганизации = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтекстОбмена_ПроверитьАвторизацию(КонтекстОбмена)
	
	АвторизацияПортал_Продлить(КонтекстОбмена);
	АвторизацияМаркировка_Проверить(КонтекстОбмена);
	
	КонтекстОбмена_ПроверитьПодписку(КонтекстОбмена);
	
	АвторизацияГИС_Проверить(КонтекстОбмена);
	
КонецПроцедуры

Процедура КонтекстОбмена_ПроверитьПодписку(КонтекстОбмена)
	
	Если КонтекстОбмена.ТребуетсяАвторизацияПортала Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьИнформациюОТарифах(КонтекстОбмена.Организация);
	
	ОписаниеТарифа = Тариф(КонтекстОбмена.Организация);
	
	СервисыПодписок = Перечисление_СервисыПодписок();
	
	ДоступенАПИ =
	СервисДоступенПоТарифу(СервисыПодписок.ЛицензияНаМодуль, ОписаниеТарифа)
	Или СервисДоступенПоТарифу(СервисыПодписок.ЛицензияНаАПИ, ОписаниеТарифа);
	
	Если Не ДоступенАПИ
		Или (ЗначениеЗаполнено(ОписаниеТарифа.ДатаОкончания)
		И ОписаниеТарифа.ДатаОкончания < ТекущаяДатаСеанса()) Тогда
		КонтекстОбмена.ОбменВозможен = Ложь;
		КонтекстОбмена.ОтключитьПроверкуАвторизацииГИС = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтекстОбмена_ПроверитьВозможностьОбмена(КонтекстОбмена) Экспорт
	
	Организация = КонтекстОбмена.Организация;
	ШаблонОшибки = НСтр("ru = 'Невозможно выполнить обмен с сервисом ""%1""
	|%2'");
	
	Если КонтекстОбмена.ОбменОтключен Тогда
		ТекстОшибки = НСтр("ru = 'Обмен отключен'");
		ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Организация, ТекстОшибки);
	КонецЕсли;
	
	Если КонтекстОбмена.НеУказанИдентификаторОрганизации Тогда
		ТекстОшибки = НСтр("ru = 'В карточке не указан идентификатор организации'");
		ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Организация, ТекстОшибки);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КонтекстОбмена.Сертификат) Тогда
		ТекстОшибки = НСтр("ru = 'Не указана настройка подписания для пользователя ""%1""'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТекущийПользовательМаркировки());
		ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Организация, ТекстОшибки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтекстОбмена.Сертификат) Тогда
		
		//Если Не КонтекстОбмена.СертификатУстановленНаКлиенте
		//	И Не КонтекстОбмена.СертификатУстановленНаСервере Тогда
		//	ТекстОшибки = НСтр("ru = 'Не установлен сертификат ""%1""'");
		//	ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, КонтекстОбмена.Сертификат);
		//	ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Организация, ТекстОшибки);
		//КонецЕсли;
		
		Если КонтекстОбмена.СертификатУстановленНаКлиенте
			Или КонтекстОбмена.СертификатУстановленНаСервере Тогда
			
			Если Не КонтекстОбмена.ЕстьЗакрытыйКлюч Тогда
				ТекстОшибки = НСтр("ru = 'Не найден закрытый ключ сертификата ""%1""'");
				ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, КонтекстОбмена.Сертификат);
				ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Организация, ТекстОшибки);
			КонецЕсли;
			
			Если Не КонтекстОбмена.СертификатДействует Тогда
				ТекстОшибки = НСтр("ru = 'Истек срок действия сертификата ""%1""'");
				ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, КонтекстОбмена.Сертификат);
				ВызватьИсключение ПараметрыВСтроку(ШаблонОшибки, Организация, ТекстОшибки);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция Новый_КонтекстОбмена(Организация)
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", Организация);
	Результат.Вставить("ФайловыйРежим", ФайловыйРежимИБ());
	
	Результат.Вставить("ОбменВозможен", Ложь);
	Результат.Вставить("ОбменОтключен", Ложь);
	Результат.Вставить("НеУказанИдентификаторОрганизации", Ложь);
	Результат.Вставить("ИдентификаторФормы");
	
	Результат.Вставить("ДокументУчета");
	Результат.Вставить("Операции", Новый Массив);
	Результат.Вставить("ФайлыДляПодписи", Новый Массив);
	Результат.Вставить("ОтключитьПодписьФайлов", Ложь);
	
	Результат.Вставить("Сертификат");
	Результат.Вставить("ОтпечатокСертификата");
	Результат.Вставить("СрокДействияСертификатаИстекает", Ложь);
	Результат.Вставить("СертификатДействует", Ложь);
	Результат.Вставить("ЕстьЗакрытыйКлюч", Ложь);
	
	Результат.Вставить("ПроверитьСертификатНаКлиенте", Истина);
	Результат.Вставить("СертификатУстановленНаКлиенте", Ложь);
	
	Результат.Вставить("ПроверитьСертификатНаСервере", Истина);
	Результат.Вставить("СертификатУстановленНаСервере", Ложь);
	
	Результат.Вставить("ДоступнаПодписьНаКлиенте", Ложь);
	Результат.Вставить("ДоступнаПодписьНаСервере", Ложь);
	
	Результат.Вставить("НеУдалосьПодписатьФайлы", Ложь);
	Результат.Вставить("НеУдалосьРасшифроватьКонтент", Ложь);
	
	Результат.Вставить("ТребуетсяАвторизацияПортала", Истина);
	Результат.Вставить("ВыполненаАвторизацияПортала", Ложь);
	
	Результат.Вставить("ПродлеватьДоступГИС", Истина);
	Результат.Вставить("ТребуетсяАвторизацияГИС", Ложь);
	Результат.Вставить("ВыполненаАвторизацияГИС", Ложь);
	Результат.Вставить("ОтключитьПроверкуАвторизацииГИС", Ложь);
	
	Результат.Вставить("ВызыватьИсключение", Ложь);
	Результат.Вставить("ТекстОшибки");
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ЗадачаОбмена()
	
	Результат = Новый Структура;
	Результат.Вставить("Операция");
	Результат.Вставить("Организация");
	Результат.Вставить("Склад");
	Результат.Вставить("ТипОперации");
	Результат.Вставить("ДокументУчета");
	Результат.Вставить("ОперацияОснование");
	Результат.Вставить("КлючСтрокиОперацииОснования");
	Результат.Вставить("ТипБизнесПроцесса");
	Результат.Вставить("ТребуемоеДействие");
	Результат.Вставить("НовоеДействие");
	Результат.Вставить("НовыйСтатусОперации");
	Результат.Вставить("ИдентификаторДокумента");
	Результат.Вставить("СтатусДокументаВСервисе");
