Процедура СинхронизироватьМобильныеУстройства(Организация) Экспорт
	
	Действие = НСтр("ru = 'Синхронизация мобильных устройств'");
	
	Попытка
		Ответ = Маркировка_СписокМобильныхУстройств(Организация);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось синхронизировать мобильные устройства по организации: %1'");
		ТекстСообщения = ПараметрыВСтроку(ТекстСообщения, Организация);
		ОбработатьОшибку(Действие, Ошибка, Организация, ТекстСообщения);
		Возврат;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Ответ["tsds"]) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого tsd Из Ответ["tsds"] Цикл
		
		id = СвойствоСтруктуры(tsd, "id");
		МобильноеУстройство = МобильноеУстройство_НайтиПоИдентификатору(id);
		
		Если ЗначениеЗаполнено(МобильноеУстройство) Тогда
			ОписаниеУстройства = МобильноеУстройство_Прочитать(МобильноеУстройство);
		Иначе
			ОписаниеУстройства = Новый_МобильноеУстройство();
			ОписаниеУстройства.Идентификатор = id;
		КонецЕсли;
		
		ОписаниеУстройства.Наименование = СвойствоСтруктуры(tsd, "name", "");
		ОписаниеУстройства.Организация = Организация;
		СкладID = СвойствоСтруктуры(tsd, "warehouseId");
		Если ЗначениеЗаполнено(СкладID) Тогда
			ОписаниеУстройства.Склад = Склад_НайтиПоИдентификатору(СкладID);
		КонецЕсли;
		
		Попытка
			СтатусУстройства = СтатусМобильногоУстройстваПоСтатусуИзСервиса(tsd);
			ТипИспользованияУстройства = ТипИспользованияУстройстваПоТипуИспользованияИзСервиса(tsd);
			СпособПолученияДокументов  = СпособПолученияДокументовНаТСДПоТипуИспользованияИзСервиса(ТипИспользованияУстройства);
		Исключение
			Ошибка = ИнформацияОбОшибке();
			ОбработатьОшибку(Действие, Ошибка, Организация);
			Продолжить;
		КонецПопытки;
		
		ОписаниеУстройства.Статус = СтатусУстройства;
		ОписаниеУстройства.СпособПолученияДокументов = СпособПолученияДокументов;
		ОписаниеУстройства.ТипИспользованияУстройства = ТипИспользованияУстройства;
		
		МобильноеУстройство_Записать(ОписаниеУстройства);
		
	КонецЦикла;
	
КонецПроцедуры

Функция Новый_МобильноеУстройство() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Организация");
	Результат.Вставить("Склад");
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("Статус", "");
	Результат.Вставить("ТипИспользованияУстройства", "");
	Результат.Вставить("СпособПолученияДокументов", "");
	Результат.Вставить("ВерсияДанных", "");
	
	Возврат Результат;
	
КонецФункции

Функция МобильноеУстройство_Прочитать(Ссылка) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.*
	|ИЗ
	|	Справочник.КонтурМаркировка_МобильныеУстройства КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый_МобильноеУстройство();
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Результат.Организация = Выборка.Владелец;
	
	Возврат Результат;
	
КонецФункции

Функция МобильноеУстройство_Записать(ОписаниеУстройства) Экспорт
	
	Ссылка = ОписаниеУстройства.Ссылка;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = МобильноеУстройство_НайтиПоИдентификатору(ОписаниеУстройства.Идентификатор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ПроверитьОбъектВПроцессеОбновления(Ссылка);
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.КонтурМаркировка_МобильныеУстройства.СоздатьЭлемент();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеУстройства.Ссылка)
		И ОписаниеУстройства.ВерсияДанных <> Объект.ВерсияДанных Тогда
		ВызватьИсключение НСтр("ru = 'В базе изменилась версия мобильного устройства, текущую версию записать невозможно!'");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ОписаниеУстройства,, "Ссылка");
	Объект.Владелец = ОписаниеУстройства.Организация;
	
	Объект.Записать();
	
	ОписаниеУстройства.Ссылка = Объект.Ссылка;
	ОписаниеУстройства.ВерсияДанных = Объект.ВерсияДанных;
	
	Возврат Объект.Ссылка;
	
КонецФункции

Функция СтатусМобильногоУстройстваПоСтатусуИзСервиса(tsd)
	
	Результат = "";
	
	Статусы = Перечисление_СтатусыМобильногоУстройства();
	
	statusInfo = СвойствоСтруктуры(tsd, "statusInfo");
	Если ЗначениеЗаполнено(statusInfo) Тогда
		
		status = СвойствоСтруктуры(statusInfo, "status");
		Если НРег(status) = НРег("active") Тогда
			Результат = Статусы.Привязано;
		ИначеЕсли НРег(status) = НРег("inactive") Тогда
			Результат = Статусы.НеПривязано;
		Иначе
			ТекстОшибки = НСтр("ru = 'Не удалось определить статус мобильного устройства по статусу из сервиса: %1'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, status);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	Иначе
		ТекстОшибки = НСтр("ru = 'В сервисе не указан статус мобильного устройства'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипИспользованияУстройстваПоТипуИспользованияИзСервиса(tsd)
	
	Результат = "";
	
	ТипыИспользования = Перечисление_ТипыИспользованияМобильногоУстройства();
	
	settings = СвойствоСтруктуры(tsd, "settings");
	Если ЗначениеЗаполнено(settings) Тогда
		
		usageType = СвойствоСтруктуры(settings, "usageType");
		Если НРег(usageType) = НРег("vanselling") Тогда
			Результат = ТипыИспользования.Отгрузка;
		ИначеЕсли НРег(usageType) = НРег("warehouse") Тогда
			Результат = ТипыИспользования.Склад;
		Иначе
			ТекстОшибки = НСтр("ru = 'Не удалось определить тип использования устройства по типу использования из сервиса: %1'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, usageType);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
	Иначе
		ТекстОшибки = НСтр("ru = 'В сервисе не указан тип использования мобильного устройства'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СпособПолученияДокументовНаТСДПоТипуИспользованияИзСервиса(ТипИспользованияУстройства)
	
	Результат = "";
	
	ТипыИспользования = Перечисление_ТипыИспользованияМобильногоУстройства();
	СпособыПолученияДокументов = Перечисление_СпособыПолученияДокументовМобильнымУстройством();
	
	Если ТипИспользованияУстройства = ТипыИспользования.Отгрузка Тогда
		Результат = СпособыПолученияДокументов.ТолькоНазначенныеЗадания;
	ИначеЕсли ТипИспользованияУстройства = ТипыИспользования.Склад Тогда
		Результат = СпособыПолученияДокументов.ВсеЗадания;
	Иначе
		ТекстОшибки = НСтр("ru = 'Не удалось определеить способ получения документов на ТСД'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МобильноеУстройство_НайтиПоИдентификатору(Идентификатор)
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
