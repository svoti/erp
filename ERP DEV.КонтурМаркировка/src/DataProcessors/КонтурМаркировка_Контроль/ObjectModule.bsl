Функция ДопустимыеПричиныВыводаИзОборота(ВидПродукции, ОбъемноСортовойУчет) Экспорт
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	ФичаФлаги = Перечисление_ФичаФлаги();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидПродукции", ВидПродукции);
	
	Если ОбъемноСортовойУчет Тогда
		Отбор.Вставить("ОСУ", Истина);
	Иначе
		Отбор.Вставить("ПУ", Истина);
	КонецЕсли;
	
	Результат = Новый Массив;
	Для Каждого Стр Из ДопустимыеПричиныВыводаИзОборотаПоВидамПродукции().НайтиСтроки(Отбор) Цикл
		Результат.Добавить(Стр.ПричинаВыводаИзОборота);
	КонецЦикла;
	
	Если ВидПродукции = ВидыПродукции.КормаДляЖивотных И ОбъемноСортовойУчет Тогда
		ИзменитьМассивПоФичаФлагу(Результат
		, ПричиныВывода.КорректировкаСкладскихОстатков, ФичаФлаги.КорректировкаСкладскихОстатковОСУКормаДляЖивотных);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеПричиныВыводаИзОборотаПоВидамПродукции()
	
	КлючКэш = "ДопустимыеПричиныВыводаИзОборотаПоВидамПродукции";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидПродукции", ОписаниеТипа_ВидПродукции());
	Результат.Колонки.Добавить("ПричинаВыводаИзОборота", ОписаниеТипа_Строка());
	Результат.Колонки.Добавить("ОСУ", ОписаниеТипа_Булево());
	Результат.Колонки.Добавить("ПУ", ОписаниеТипа_Булево());
	
	СтрокаПричиныВывода = 1;
	КолонкаВидаПродукции = 1;
	
	ТабДок = МакетОбработки("ПричиныВыводаИзОборота");
	
	Для Строка = 2 По ТабДок.ВысотаТаблицы Цикл
		
		ВидПродукцииСтр = СокрЛП(ТабДок.ПолучитьОбласть(Строка, КолонкаВидаПродукции).Область().Текст);
		
		Для Колонка = 2 По ТабДок.ШиринаТаблицы Цикл
			
			ПричинаВыводаСтр = СокрЛП(ТабДок.ПолучитьОбласть(СтрокаПричиныВывода, Колонка).Область().Текст);
			
			Стр = Результат.Добавить();
			Стр.ВидПродукции = ВидыПродукции[ВидПродукцииСтр];
			Стр.ПричинаВыводаИзОборота = ПричиныВывода[ПричинаВыводаСтр];
			
			Значение = СокрЛП(ТабДок.ПолучитьОбласть(Строка, Колонка).Область().Текст);
			
			Если Значение = "ОСУ" Тогда
				Стр.ОСУ = Истина;
			КонецЕсли;
			
			Если Значение = "ПУ" Тогда
				Стр.ПУ = Истина;
			КонецЕсли;
			
			Если Значение = "ОСУ/ПУ" Тогда
				Стр.ОСУ = Истина;
				Стр.ПУ = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.Индексы.Добавить("ВидПродукции, ОСУ");
	Результат.Индексы.Добавить("ВидПродукции, ПУ");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

