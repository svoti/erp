Функция ВидПродукцииТребуетТипОплатыКодов(ВидПродукции) Экспорт
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ФичаФлаги = Перечисление_ФичаФлаги();
	
	ПодходящиеТГ = Новый Массив;
	ПодходящиеТГ.Добавить(ВидыПродукции.Вода);
	ПодходящиеТГ.Добавить(ВидыПродукции.Пиво);
	ПодходящиеТГ.Добавить(ВидыПродукции.Бады);
	ПодходящиеТГ.Добавить(ВидыПродукции.Молоко);
	ПодходящиеТГ.Добавить(ВидыПродукции.Антисептики);
	ПодходящиеТГ.Добавить(ВидыПродукции.МедицинскиеИзделия);
	ПодходящиеТГ.Добавить(ВидыПродукции.Морепродукты);
	ПодходящиеТГ.Добавить(ВидыПродукции.Велосипеды);
	ПодходящиеТГ.Добавить(ВидыПродукции.БезалкогольныеНапитки);
	ПодходящиеТГ.Добавить(ВидыПродукции.Консервы);
	ПодходящиеТГ.Добавить(ВидыПродукции.РастительныеМасла);
	ПодходящиеТГ.Добавить(ВидыПродукции.Ветпрепараты);
	ПодходящиеТГ.Добавить(ВидыПродукции.БезалкогольноеПиво);
	ПодходящиеТГ.Добавить(ВидыПродукции.Бакалея);
	ПодходящиеТГ.Добавить(ВидыПродукции.СтроительныеМатериалы);
	ПодходящиеТГ.Добавить(ВидыПродукции.КондитерскиеИзделия);
	
	ИзменитьМассивПоФичаФлагу(ПодходящиеТГ, ВидыПродукции.КормаДляЖивотных, ФичаФлаги.ТипОплатыКормаДляЖивотных);
	ИзменитьМассивПоФичаФлагу(ПодходящиеТГ, ВидыПродукции.Косметика, ФичаФлаги.ТипОплатыКосметика);
	ИзменитьМассивПоФичаФлагу(ПодходящиеТГ, ВидыПродукции.Электроника, ФичаФлаги.ТипОплатыЭлектроника);
	ИзменитьМассивПоФичаФлагу(ПодходящиеТГ, ВидыПродукции.МаслаИАвтомобильныеЖидкости, ФичаФлаги.ТипОплатыАвтоЖидкости);
	ИзменитьМассивПоФичаФлагу(ПодходящиеТГ, ВидыПродукции.Игрушки, ФичаФлаги.ТипОплатыИгрушки);
	ИзменитьМассивПоФичаФлагу(ПодходящиеТГ, ВидыПродукции.МясныеИзделия, ФичаФлаги.ТипОплатыМясныеИзделия);
	ИзменитьМассивПоФичаФлагу(ПодходящиеТГ, ВидыПродукции.Полуфабрикаты, ФичаФлаги.ТипОплатыПолуфабрикаты);
	ИзменитьМассивПоФичаФлагу(ПодходящиеТГ, ВидыПродукции.НоутбукиИСмартфоны, ФичаФлаги.ТипОплатыНоутбукиИСмартфоны);
	
	Возврат МассивСодержитЗначение(ПодходящиеТГ, ВидПродукции);
	
КонецФункции

Функция ВидПродукцииТребуетРазрешительныйДокумент(ВидПродукции) Экспорт
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ФичаФлаги = Перечисление_ФичаФлаги();
	
	КонтрольПарфюмерия = ФичаФлагВключен(ФичаФлаги.КонтрольРДПарфюмерия);
	КонтрольБА = ФичаФлагВключен(ФичаФлаги.КонтрольРДБезалкогольныеНапитки);
	КонтрольФототовары = ФичаФлагВключен(ФичаФлаги.КонтрольРДФототовары);
	КонтрольШины = ФичаФлагВключен(ФичаФлаги.КонтрольРДШины);
	
	Контроли = Новый Соответствие;
	Контроли.Вставить(ВидыПродукции.Вода, Истина);
	Контроли.Вставить(ВидыПродукции.Парфюмерия, КонтрольПарфюмерия);
	Контроли.Вставить(ВидыПродукции.Молоко, Истина);
	Контроли.Вставить(ВидыПродукции.Обувь, Истина);
	Контроли.Вставить(ВидыПродукции.Легпром, Истина);
	Контроли.Вставить(ВидыПродукции.БезалкогольныеНапитки, КонтрольБА);
	Контроли.Вставить(ВидыПродукции.Фототовары, КонтрольФототовары);
	Контроли.Вставить(ВидыПродукции.Шины, КонтрольШины);
	Контроли.Вставить(ВидыПродукции.Игрушки, Истина);
	Контроли.Вставить(ВидыПродукции.Пиво, Истина);
	
	Возврат (Контроли[ВидПродукции] = Истина);
	
КонецФункции

