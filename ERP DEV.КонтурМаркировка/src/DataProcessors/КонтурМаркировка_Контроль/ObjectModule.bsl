Процедура Операция_ПроверитьВидПродукцииДляОтчетаОНанесении(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru = 'Отчет о нанесении недоступен для вида продукции ""%1""'");
	
	Если ДопустимыеВидыПродукцииДляОтчетаОНанесении().Найти(ВидПродукции) = Неопределено Тогда
		Ошибка = Новый_ОшибкаЗаполнения("ВидПродукции");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьТипОтчетаОНанесении(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОтчетаОНанесении = Перечисление_ТипыОтчетаОНанесении();
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипОтчетаОНанесении = ДопРеквизиты.ТипОтчетаОНанесении;
	КлючКода = ДопРеквизиты.КлючКода;
	
	Если ЭтоТипОтчетаОНанесенииПоУмолчанию(ТипОтчетаОНанесении) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru='Вид продукции %1 не допускает указание типа отчета о нанесении %2'");
	Если Не ВидПродукцииДопускаетТипОтчетаОНанесении(ТипОтчетаОНанесении, ТипОперации, ВидПродукции) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("ВидПродукции");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ВидПродукции, ТипОтчетаОНанесении);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	ТекстОшибки = ПараметрыВСтроку(НСтр("ru='Не указан код маркировки для типа отчета %1'"), ТипОтчетаОНанесении);
	Если Не ЗначениеЗаполнено(КлючКода) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("КодМаркировки");
		Ошибка.ТекстОшибки = ТекстОшибки;
		ОшибкиЗаполнения.Добавить(Ошибка);
		Возврат;
	КонецЕсли;
	
	МодульМаркировки = МодульМаркировки();
	
	ТаблицаКодов = МодульМаркировки.Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = КлючКода;
	
	МодульМаркировки.ПолныеКоды_Прочитать(ТаблицаКодов);
	
	МодульМаркировки.ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Операция_ПроверитьКодМаркировки(ОписаниеОперации, ТаблицаКодов, ОшибкиЗаполнения);
	
	Если ТипОтчетаОНанесении = ТипыОтчетаОНанесении.РасформированиеНабора Тогда
		Операция_ПроверитьТовары_МаркировкаТоваровРасформированногоНабора(ОписаниеОперации, ТаблицаКодов, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ТипОтчетаОНанесении = ТипыОтчетаОНанесении.РазделениеТовара Тогда
		Операция_ПроверитьТовары_РазделениеТовара(ОписаниеОперации, ТаблицаКодов, ОшибкиЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьНоминальноеКоличествоВТоварах(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	ТекстОшибки = НСтр("ru = 'Не заполнено номинальное значение в карточке товара'");
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		
		ОписаниеТовара = Товар_Прочитать(Стр.Товар);
		ДопРеквизиты = ОписаниеТовара.ДопРеквизиты;
		
		ПроверитьНоминальноеКоличество = ОписаниеТовара.ПеременныйВес
									И ВидПродукцииПоддерживаетНоминальноеКоличество(ОписаниеТовара.ВидПродукции)
									И Стр.Количество = 0;
		
		Если ПроверитьНоминальноеКоличество И Не ЗначениеЗаполнено(ДопРеквизиты.НоминальноеКоличество) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьКоличествоВТоварахОперации(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	МодульМаркировки = МодульМаркировки();
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ТипОтчетаОНанесении = ОписаниеОперации.ДопРеквизиты.ТипОтчетаОНанесении;
	
	ИспользоватьНоминальноеКоличество = ОписаниеОперации.ДопРеквизиты.ИспользоватьНоминальноеКоличество;
	ВидПродукцииСПеременнойХарактеристикой = ВидПродукцииПоддерживаетКоличествоВСтруктуреКодаОтчетаОНанесении(ВидПродукции, ТипОтчетаОНанесении);
	
	ТекстОшибки = НСтр("ru = 'Необходимо заполнить значение переменной характеристики во всех кодах маркировки'");
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		ОписаниеТовара = Товар_Прочитать(Стр.Товар);
		
		Если Не ВидПродукцииСПеременнойХарактеристикой
			Или Не ОписаниеТовара.ПеременныйВес Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.Количество) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Количество", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
			Продолжить;
		КонецЕсли;
		
		ТаблицаКодов = МодульМаркировки.КодыОпераций_Прочитать(ОписаниеОперации.Ссылка, Стр.КлючСтрокиОперации);
		МодульМаркировки.КодыМаркировки_Прочитать(ТаблицаКодов);
		
		Операция_ПроверитьПеременнуюХарактеристикуВКодахМаркировки(ТаблицаКодов, Стр, ИспользоватьНоминальноеКоличество, ОшибкиЗаполнения);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьПеременнуюХарактеристикуВКодахМаркировки(ТаблицаКодов, СтрОперации, ИспользоватьНоминальноеКоличество, ОшибкиЗаполнения)
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	ОписаниеТовара = Товар_Прочитать(СтрОперации.Товар);
	ДопРеквизиты = ОписаниеТовара.ДопРеквизиты;
	
	ОшибкаПустоеКоличество = НСтр("ru = 'Необходимо заполнить значение переменной характеристики в кодах маркировки: %1'");
	ОшибкаНекорректныйДиапазон = НСтр("ru = 'В кодах маркировки значение переменной характеристики находится за пределами допустимого интервала: %1'");
	
	ЭтоРЭПСХарактеристикой = (ОписаниеТовара.ВидПродукции = ВидыПродукции.Электроника И ОписаниеТовара.ПеременныйВес);
	РазрешеноПустоеКоличество = (ИспользоватьНоминальноеКоличество И ЗначениеЗаполнено(ДопРеквизиты.НоминальноеКоличество));
	
	КоличествоМин = ДопРеквизиты.КоличествоМин;
	КоличествоМакс = ДопРеквизиты.КоличествоМакс;
	Если Не ЗначениеЗаполнено(КоличествоМакс) Тогда
		КоличествоМакс = ДопРеквизиты.НоминальноеКоличество;
	КонецЕсли;
	
	КодыCПустымКоличеством = Новый Массив;
	КодыСНевернымКоличеством = Новый Массив;
	Для каждого СтрКода Из ТаблицаКодов Цикл
		
		Количество = СтрКода.Количество;
		Если Не ЗначениеЗаполнено(Количество) И РазрешеноПустоеКоличество Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Количество) Тогда
			КодыCПустымКоличеством.Добавить(СтрКода.КодМаркировки);
		ИначеЕсли ЭтоРЭПСХарактеристикой И ЗначениеЗаполнено(КоличествоМакс) Тогда
			Если Количество > КоличествоМакс Или Количество < КоличествоМин Тогда
				КодыСНевернымКоличеством.Добавить(СтрКода.КодМаркировки);
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КодыCПустымКоличеством) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("Количество", "Товары", СтрОперации.НомерСтроки);
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ОшибкаПустоеКоличество, СписокКодовДляТекстаОшибки(КодыCПустымКоличеством));
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодыСНевернымКоличеством) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("Количество", "Товары", СтрОперации.НомерСтроки);
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ОшибкаНекорректныйДиапазон, СписокКодовДляТекстаОшибки(КодыСНевернымКоличеством));
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьДатуСрокаГодности(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ТипСрокаГодности = ОписаниеОперации.ДопРеквизиты.ТипСрокаГодности;
	ТипОтчетаОНанесении = ОписаниеОперации.ДопРеквизиты.ТипОтчетаОНанесении;
	
	Если Не ВидПродукцииТребуетСрокГодностиВОтчетеОНанесении(ВидПродукции, ТипОтчетаОНанесении)
		Или ТипСрокаГодности = Перечисление_ТипыСроковГодности().СрокГодностиБольше72СУсловием Тогда
		Возврат;
	КонецЕсли;
	
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	ТребуетсяДляКИНКИГУ = ВидПродукцииТребуетСрокГодностиВОтчетеОНанесенииДляКИНКИГУ(ВидПродукции);
	ДопускаетсяДляКИГУ = ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесенииДляКИГУ(ОписаниеОперации.ВидПродукции, ТипОтчетаОНанесении);
	ДопускаетсяДляКИН = ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесенииДляКИН(ОписаниеОперации.ВидПродукции, ТипОтчетаОНанесении);
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		Если ЗначениеЗаполнено(Стр.ДатаСрокаГодности)
			И НачалоДня(Стр.ДатаСрокаГодности) < НачалоДня(ТекущаяДата()) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("ДатаСрокаГодности", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Срок годности не должен заканчиваться раньше текущей даты'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	
	// Проверка, что дата срока годности заполнена, где требуется
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если ЗначениеЗаполнено(Стр.ДатаСрокаГодности) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВидПродукцииТребуетСрокГодностиПоХарактеристикеСрокаИспользования(ВидПродукции)
			И Не ХарактеристикаСрокаИспользованияТребуетСрокГодности(Стр.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.Комплект
			Или Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.ЕдиницаТовара
			Или ТребуетсяДляКИНКИГУ Тогда
			Ошибка = Новый_ОшибкаЗаполнения("ДатаСрокаГодности", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить срок годности'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверка, что дата срока годности не заполнена, где не требуется
	Если Не ДопускаетсяДляКИГУ Или Не ДопускаетсяДляКИН Тогда
		Для Каждого Стр Из ОписаниеОперации.Товары Цикл
			
			Если Не ЗначениеЗаполнено(Стр.ДатаСрокаГодности) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ДопускаетсяДляКИГУ И Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка Тогда
				ТекстОшибки = НСтр("ru = 'Для групповых упаковок параметр ""Годен до"" не должен заполняться'");
			ИначеЕсли Не ДопускаетсяДляКИН И Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.Набор Тогда
				ТекстОшибки = НСтр("ru = 'Для наборов параметр ""Годен до"" не должен заполняться'");
			Иначе
				Продолжить;
			КонецЕсли;
			
			Ошибка = Новый_ОшибкаЗаполнения("ДатаСрокаГодности", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьДатуПроизводства(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	// Проверка, что дата производства не больше текущей даты
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	Если НачалоДня(ОписаниеОперации.ДопРеквизиты.ДатаПроизводства) > ТекущаяДата Тогда
		Ошибка = Новый_ОшибкаЗаполнения("ДатаПроизводства");
		Ошибка.ТекстОшибки = НСтр("ru = 'Дата производства не может быть позже текущей даты'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если НачалоДня(Стр.ДатаПроизводства) > ТекущаяДата Тогда
			Ошибка = Новый_ОшибкаЗаполнения("ДатаПроизводства", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Дата производства не может быть позже текущей даты'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	
	ТипОперации = ОписаниеОперации.ТипОперации;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	СпособВводаВОборот = ОписаниеОперации.ДопРеквизиты.СпособВводаВОборот;
	ТипОтчетаОНанесении = ОписаниеОперации.ДопРеквизиты.ТипОтчетаОНанесении;
	
	Если ЭтоОтчетОНанесении(ТипОперации)
		И Не ВидПродукцииТребуетДатуПроизводстваВОтчетеОНанесении(ВидПродукции, ТипОтчетаОНанесении) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипОперации = ТипыОпераций.ВводВОборот
		И Не ВидПродукцииТребуетУказатьДатуПроизводстваВоВводеВОборот(ВидПродукции, СпособВводаВОборот) Тогда
		Возврат;
	КонецЕсли;
	
	ТребуетсяДляКИНКИГУ = Ложь;
	ДопускаетсяДляКИНКИГУ = Истина;
	Если ЭтоОтчетОНанесении(ТипОперации) Тогда
		ТребуетсяДляКИНКИГУ = ВидПродукцииТребуетДатуПроизводстваВОтчетеОНанесенииДляКИНКИГУ(ВидПродукции, ТипОтчетаОНанесении);
		ДопускаетсяДляКИНКИГУ = ВидПродукцииДопускаетДатуПроизводстваВОтчетеОНанесенииДляКИНКИГУ(ВидПродукции, ТипОтчетаОНанесении);
	КонецЕсли;
	
	// Проверка, что дата производства заполнена, где требуется
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ДатаПроизводства) Тогда
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			Если ЗначениеЗаполнено(Стр.ДатаПроизводства) Тогда
				Продолжить;
			КонецЕсли;
			Если Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.ЕдиницаТовара
				Или Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.Комплект
				Или ТребуетсяДляКИНКИГУ Тогда
				Ошибка = Новый_ОшибкаЗаполнения("ДатаПроизводства", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить дату производства'");
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Проверка, что дата производства не заполнена, где не требуется
	Если Не ДопускаетсяДляКИНКИГУ Тогда
		Для Каждого Стр Из ОписаниеОперации.Товары Цикл
			
			Если Не ЗначениеЗаполнено(Стр.ДатаПроизводства) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка Тогда
				ТекстОшибки = НСтр("ru = 'Для групповых упаковок дату производства нельзя указывать'");
			ИначеЕсли Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.Набор Тогда
				ТекстОшибки = НСтр("ru = 'Для наборов дату производства нельзя указывать'");
			Иначе
				Продолжить;
			КонецЕсли;
			
			Ошибка = Новый_ОшибкаЗаполнения("ДатаСрокаГодности", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьАльтернативныеСрокиГодности(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыСрокаГодности = Перечисление_ТипыСроковГодности();
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	ТипОтчетаОНанесении = Перечисление_ТипыОтчетаОНанесении();
	
	Если (ОписаниеОперации.ДопРеквизиты.ТипСрокаГодности <> ТипыСрокаГодности.СрокГодностиБольше72СУсловием
		И ОписаниеОперации.ДопРеквизиты.ВидКорректируемыхСведений <> ВидыСведений.ВариативныйСрокГодности)
		Или Не ВидПродукцииДопускаетАльтернативныйСрокГодности(ОписаниеОперации.ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	ДопускаетсяДляКИГУ = ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесенииДляКИГУ(ОписаниеОперации.ВидПродукции, ТипОтчетаОНанесении);
	ДопускаетсяДляКИН = ВидПродукцииДопускаетСрокГодностиВОтчетеОНанесенииДляКИН(ОписаниеОперации.ВидПродукции, ТипОтчетаОНанесении);
	
	// Проверка, что дата альтернативного срока годности больше текущей даты
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Для каждого Элемент Из Стр.АльтернативныеСрокиГодности Цикл
			Если ЗначениеЗаполнено(Элемент.Значение)
				И НачалоДня(Элемент.Значение) < НачалоДня(ТекущаяДата()) Тогда
				Ошибка = Новый_ОшибкаЗаполнения("АльтернативныйСрокГодности", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = НСтр("ru = 'Срок годности не должен заканчиваться раньше текущей даты'");
				ОшибкиЗаполнения.Добавить(Ошибка);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Проверка, что альтернативный срок годности заполнен где требуется
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.Комплект
			Или Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.ЕдиницаТовара Тогда
			Для Каждого Элемент Из Стр.АльтернативныеСрокиГодности Цикл
				Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
					Ошибка = Новый_ОшибкаЗаполнения("АльтернативныйСрокГодности", "Товары", Стр.НомерСтроки);
					Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить все варианты срока годности'");
					ОшибкиЗаполнения.Добавить(Ошибка);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// Проверка, что альтернативный срок годности не заполнен где не требуется
	Если Не ДопускаетсяДляКИГУ Или Не ДопускаетсяДляКИН Тогда
		Для Каждого Стр Из ОписаниеОперации.Товары Цикл
			
			Если Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка И Не ДопускаетсяДляКИГУ Тогда
				ТекстОшибки = НСтр("ru = 'Для групповых упаковок не допускается заполнение вариантов срока годности'");
			ИначеЕсли Стр.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.Набор И Не ДопускаетсяДляКИН Тогда
				ТекстОшибки = НСтр("ru = 'Для наборов не допускается заполнение вариантов срока годности'");
			Иначе
				Продолжить;
			КонецЕсли;
			
			Для каждого Элемент Из Стр.АльтернативныеСрокиГодности Цикл
				Если ЗначениеЗаполнено(Элемент.Значение) Тогда
					Ошибка = Новый_ОшибкаЗаполнения("АльтернативныйСрокГодности", "Товары", Стр.НомерСтроки);
					Ошибка.ТекстОшибки = ТекстОшибки;
					ОшибкиЗаполнения.Добавить(Ошибка);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьСодержаниеСпирта(ОписаниеОперации, ОшибкиЗаполнения)
	
	Товары = ОписаниеОперации.Товары;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ТипОтчетаОНанесении = ОписаниеОперации.ДопРеквизиты.ТипОтчетаОНанесении;
	
	Требуется = ВидПродукцииТребуетСодержаниеСпиртаВОтчетеОНанесении(ВидПродукции, ТипОтчетаОНанесении);
	Допускается = ВидПродукцииДопускаетУказаниеФактическогоСодержанияСпирта(ВидПродукции, ТипОтчетаОНанесении);
	ТолькоДляКег = ВидПродукцииТребуетУказатьСодержаниеСпиртаТолькоДляКег(ВидПродукции);
	
	Если Не Требуется И Не Допускается Тогда
		Возврат;
	КонецЕсли;
	
	КэшТоваров = Новый Соответствие;
	
	Для Каждого Стр Из Товары Цикл
		
		ОписаниеТовара = Товар_Прочитать(Стр.Товар, КэшТоваров);
		
		Если ДлинаДробнойЧасти(Стр.СодержаниеСпирта) > 1 Тогда
			ТекстОшибки = НСтр("ru = 'Фактическое содержание спирта не должно содержать больше одного знака после запятой'");
			Ошибка = Новый_ОшибкаЗаполнения("СодержаниеСпирта", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если ТолькоДляКег И Не ОписаниеТовара.ДопРеквизиты.ЭтоКег Тогда
			Продолжить;
		КонецЕсли;
		
		Если Требуется И Не ЗначениеЗаполнено(Стр.СодержаниеСпирта) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("СодержаниеСпирта", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить фактическое содержание спирта'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьДатуИНомерПервичногоДокумента(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если Не ВидПродукцииДопускаетУказаниеНомераИДатыДокументаВОтчетеОНанесении(ОписаниеОперации.ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибкиНомер = НСтр("ru = 'Необходимо заполнить Номер первичного документа со способом выпуска Производство РФ'");
	ТекстОшибкиДата = НСтр("ru = 'Необходимо заполнить Дату первичного документа со способом выпуска Производство РФ'");
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если Стр.ЭтоПроизводствоРФ Тогда
			Если Не ЗначениеЗаполнено(Стр.НомерДокумента)
				И Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.НомерДокумента) Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерДокумента", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиНомер;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Стр.ДатаДокумента)
				И Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ДатаДокумента) Тогда
				Ошибка = Новый_ОшибкаЗаполнения("ДатаДокумента", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиДата;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьНомерСерии(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если Не ВидПродукцииТребуетНомерСерииВОтчетеОНанесении(ОписаниеОперации.ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.НомерСерии) Тогда
		Для Каждого Стр Из ОписаниеОперации.Товары Цикл
			Если Не ЗначениеЗаполнено(Стр.НомерСерии) Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерСерии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить Номер серии'");
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Операция_ПроверитьФорматНомераПартии(ОписаниеОперации, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_ПроверитьНомерПартииИНомерСерииИЗаводскиеСерийныеНомера(ОписаниеОперации, ОшибкиЗаполнения)
	
	НомерСерии = ОписаниеОперации.ДопРеквизиты.НомерСерии;
	НомерПартии = ОписаниеОперации.ДопРеквизиты.НомерПартии;
	КоличествоЗСН = МодульМаркировки().КодыОпераций_КоличествоЗаводскихСерийныхНомеров(ОписаниеОперации.Ссылка);
	
	ТекстОшибки = НСтр("ru = 'Необходимо заполнить заводской серийный номер товара'");
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Товар = Товар_Прочитать(Стр.Товар);
		Если Не Товар.ДопРеквизиты.ИспользоватьЗаводскойСН Тогда
			Продолжить;
		КонецЕсли;
		
		СтрЗСН = КоличествоЗСН.Найти(Стр.КлючСтрокиОперации, "КлючСтрокиОперации");
		Если СтрЗСН = Неопределено Или СтрЗСН.КоличествоЗСН < Стр.КоличествоУпаковок Тогда
			Ошибка = Новый_ОшибкаЗаполнения("КоличествоЗСН", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(НомерПартии) И Не ЗначениеЗаполнено(НомерСерии) Тогда
		
		ТекстОшибки = НСтр(
		"ru = 'Необходимо заполнить хотя бы одно поле: Номер партии, Номер серии или Заводской серийный номер в структуре кода маркировки'");
		
		Для Каждого Стр Из ОписаниеОперации.Товары Цикл
			
			Если ЗначениеЗаполнено(Стр.НомерПартии)
				Или ЗначениеЗаполнено(Стр.НомерСерии) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрЗСН = КоличествоЗСН.Найти(Стр.КлючСтрокиОперации, "КлючСтрокиОперации");
			Если СтрЗСН = Неопределено Или СтрЗСН.КоличествоЗСН < Стр.КоличествоУпаковок Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибки;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Операция_ПроверитьФорматНомераПартии(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьФорматНомераСерии(ОписаниеОперации, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_ПроверитьНомерПартии(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	ПроверяемыйТипКода = ТипыКодовМаркировки.Набор;
	Если ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации) Тогда
		ПроверяемыйТипКода = ТипыКодовМаркировки.ЕдиницаТовара;
	КонецЕсли;
	
	Если ОписаниеОперации.ДопРеквизиты.РезервироватьПартии
		И Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.НомерПартии) Тогда
		Для каждого Стр Из ОписаниеОперации.Товары.НайтиСтроки(Новый Структура("НомерПартии", "")) Цикл
			Если Стр.Товар.ТипКодаМаркировки = ПроверяемыйТипКода Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить номер партии'");
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ОписаниеОперации.ТипОперации = ТипыОпераций.КорректировкаСведенийОКодах Тогда
		Для каждого Стр Из ОписаниеОперации.Товары Цикл
			Если Стр.Товар.ТипКодаМаркировки <> ТипыКодовМаркировки.ЕдиницаТовара Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = НСтр("ru = 'Изменение номера партии доступно только для единиц товара'");
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьФорматНомераПартии(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ВидПродукцииПоддерживаетПартионныйУчет(ОписаниеОперации.ВидПродукции) Тогда
		Операция_ПроверитьФорматНомераПартии_ПартионныйУчет(ОписаниеОперации, ОшибкиЗаполнения);
	Иначе
		Операция_ПроверитьФорматНомераПартии_ВнеПартионногоУчета(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьФорматНомераПартии_ВнеПартионногоУчета(ОписаниеОперации, ОшибкиЗаполнения)
	
	// Допустимые символы
	СпецСимволы = " .,-/";
	ДопустимыеСимволы = ВсеБуквыКириллицы() + ВсеБуквыЛатиницы() + ВсеЦифры() + СпецСимволы;
	ДопустимаяДлинаНомера = 30;
	
	НомерПартии = ОписаниеОперации.ДопРеквизиты.НомерПартии;
	ТекстОшибкиПревышениеДлины = НСтр("ru = 'Длина номера партии не должна превышать %1 символов'");
	ТекстОшибкиПревышениеДлины = ПараметрыВСтроку(ТекстОшибкиПревышениеДлины, ДопустимаяДлинаНомера);
	ТекстОшибкиНедопустимыеСимволы = НСтр("ru = 'Номер партии содержит недопустимые символы'");
	
	Если СтрДлина(НомерПартии) > ДопустимаяДлинаНомера Тогда
		Ошибка = Новый_ОшибкаЗаполнения("НомерПартии");
		Ошибка.ТекстОшибки = ТекстОшибкиПревышениеДлины;
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Если Не СтрокаСодержитТолькоДопустимыеСимволы(НомерПартии, ДопустимыеСимволы) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("НомерПартии");
		Ошибка.ТекстОшибки = ТекстОшибкиНедопустимыеСимволы;
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если СтрДлина(Стр.НомерПартии) > ДопустимаяДлинаНомера Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиПревышениеДлины;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		Если Не СтрокаСодержитТолькоДопустимыеСимволы(Стр.НомерПартии, ДопустимыеСимволы) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиНедопустимыеСимволы;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура Операция_ПроверитьФорматНомераПартии_ПартионныйУчет(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	ПроверяемыйТипКода = ТипыКодовМаркировки.Набор;
	Если ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации) Тогда
		ПроверяемыйТипКода = ТипыКодовМаркировки.ЕдиницаТовара;
	КонецЕсли;
	
	ФорматПартии = ФорматНомераПартии();
	НомерПартииШапка = ОписаниеОперации.ДопРеквизиты.НомерПартии;
	СтруктураПартииШапка = СтруктураНомераПартии(НомерПартииШапка);
	ДатаПроизводстваШапка = ОписаниеОперации.ДопРеквизиты.ДатаПроизводства;
	
	ТекстОшибкиДлинаБольшеДопустимой = НСтр("ru = 'Длина номера партии не должна превышать %1 символов'");
	ТекстОшибкиДлинаБольшеДопустимой = ПараметрыВСтроку(ТекстОшибкиДлинаБольшеДопустимой, ФорматПартии.МаксимальнаяДлина);
	
	ТекстОшибкиДлинаМеньшеДопустимой = НСтр("ru = 'Длина номера партии не должна быть меньше %1 символов'");
	ТекстОшибкиДлинаМеньшеДопустимой = ПараметрыВСтроку(ТекстОшибкиДлинаМеньшеДопустимой, ФорматПартии.МинимальнаяДлина);
	
	ТекстОшибкиЕстьНедопустимыеСимволы = НСтр("ru = 'Номер партии содержит недопустимые символы'");
	
	ТекстОшибкиНекорректныйGTIN = НСтр("ru = 'В номере партии указан некорректный GTIN'");
	ТекстОшибкиНеСоответствуетGTIN = НСтр("ru = 'GTIN в номере партии не соответствует товару'");
	ТекстОшибкиНеСоответствуетGTINВПартииШапки = НСтр("ru = 'GTIN в номере партии в шапке не соответствует товару'");
	
	ТекстОшибкиНекорректнаяДатаПроизвод = НСтр("ru = 'В номере партии указана некорректная дата производства'");
	ТекстОшибкиДатаПроизводНеСоответствуетПартииШапки = НСтр("ru = 'Дата производства не соответствует дате производства в номере партии в шапке'");
	ТекстОшибкиДатаПроизводНеСоответствуетОтчету = НСтр("ru = 'Дата производства в номере партии на соответствует дате производства в отчете'");
	ТекстОшибкиДатаПроизводНеСоответствуетСтроке = НСтр("ru = 'Дата производства в номере партии на соответствует дате производства в строке отчета'");
	
	Если ЗначениеЗаполнено(НомерПартииШапка) Тогда
		
		Если СтруктураПартииШапка.ДлинаБольшеДопустимой Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии");
			Ошибка.ТекстОшибки = ТекстОшибкиДлинаБольшеДопустимой;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если СтруктураПартииШапка.ДлинаМеньшеДопустимой Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии");
			Ошибка.ТекстОшибки = ТекстОшибкиДлинаМеньшеДопустимой;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если СтруктураПартииШапка.ЕстьНедопустимыеСимволы Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии");
			Ошибка.ТекстОшибки = ТекстОшибкиЕстьНедопустимыеСимволы;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если СтруктураПартииШапка.НекорректнаяДатаПроизводства Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии");
			Ошибка.ТекстОшибки = ТекстОшибкиНекорректнаяДатаПроизвод;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаПроизводстваШапка)
			И ЗначениеЗаполнено(СтруктураПартииШапка.ДатаПроизводства)
			И СтруктураПартииШапка.ДатаПроизводства <> ДатаПроизводстваШапка Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии");
			Ошибка.ТекстОшибки = ТекстОшибкиДатаПроизводНеСоответствуетОтчету;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если Стр.Товар.ТипКодаМаркировки <> ПроверяемыйТипКода Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.НомерПартии) Тогда
			
			СтруктураПартии = СтруктураНомераПартии(Стр.НомерПартии);
			
			Если СтруктураПартии.ДлинаБольшеДопустимой Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиДлинаБольшеДопустимой;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если СтруктураПартии.ДлинаМеньшеДопустимой Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиДлинаМеньшеДопустимой;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если СтруктураПартии.ЕстьНедопустимыеСимволы Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиЕстьНедопустимыеСимволы;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если СтруктураПартии.НекорректнаяДатаПроизводства Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиНекорректнаяДатаПроизвод;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.ДатаПроизводства)
				И ЗначениеЗаполнено(СтруктураПартии.ДатаПроизводства)
				И СтруктураПартии.ДатаПроизводства <> Стр.ДатаПроизводства Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиДатаПроизводНеСоответствуетСтроке;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.ДатаПроизводства)
				И ЗначениеЗаполнено(ДатаПроизводстваШапка)
				И ЗначениеЗаполнено(СтруктураПартии.ДатаПроизводства)
				И СтруктураПартии.ДатаПроизводства <> ДатаПроизводстваШапка Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиДатаПроизводНеСоответствуетОтчету;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если СтруктураПартии.НекорректныйGTIN Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиНекорректныйGTIN;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.Товар)
				И ЗначениеЗаполнено(СтруктураПартии.GTIN)
				И Стр.Товар.GTIN <> СтруктураПартии.GTIN Тогда
				Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиНеСоответствуетGTIN;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(Стр.ДатаПроизводства)
				И ЗначениеЗаполнено(СтруктураПартииШапка.ДатаПроизводства)
				И Стр.ДатаПроизводства <> СтруктураПартииШапка.ДатаПроизводства Тогда
				Ошибка = Новый_ОшибкаЗаполнения("ДатаПроизводства", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиДатаПроизводНеСоответствуетПартииШапки;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.Товар)
				И ЗначениеЗаполнено(СтруктураПартииШапка.GTIN)
				И Стр.Товар.GTIN <> СтруктураПартииШапка.GTIN Тогда
				Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиНеСоответствуетGTINВПартииШапки;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьФорматНомераСерии(ОписаниеОперации, ОшибкиЗаполнения)
	
	// Допустимые символы
	СпецСимволы = " .,-/";
	ДопустимыеСимволы = ВсеБуквыКириллицы() + ВсеБуквыЛатиницы() + ВсеЦифры() + СпецСимволы;
	ДопустимаяДлинаНомера = 30;
	
	НомерСерии = ОписаниеОперации.ДопРеквизиты.НомерСерии;
	ТекстОшибкиПревышениеДлины = НСтр("ru = 'Длина номера серии не должна превышать %1 символов'");
	ТекстОшибкиПревышениеДлины = ПараметрыВСтроку(ТекстОшибкиПревышениеДлины, ДопустимаяДлинаНомера);
	ТекстОшибкиНедопустимыеСимволы = НСтр("ru = 'Номер серии содержит недопустимые символы'");
	
	Если СтрДлина(НомерСерии) > ДопустимаяДлинаНомера Тогда
		Ошибка = Новый_ОшибкаЗаполнения("НомерСерии");
		Ошибка.ТекстОшибки = ТекстОшибкиПревышениеДлины;
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Если Не СтрокаСодержитТолькоДопустимыеСимволы(НомерСерии, ДопустимыеСимволы) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("НомерСерии");
		Ошибка.ТекстОшибки = ТекстОшибкиНедопустимыеСимволы;
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если СтрДлина(Стр.НомерСерии) > ДопустимаяДлинаНомера Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерСерии", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиПревышениеДлины;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		Если Не СтрокаСодержитТолькоДопустимыеСимволы(Стр.НомерСерии, ДопустимыеСимволы) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерСерии", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиНедопустимыеСимволы;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьПричинуВозвратаВОборот(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ПричинаВозвратаВОборот = ОписаниеОперации.ДопРеквизиты.ПричинаВозвратаВОборот;
	
	Если Не ЗначениеЗаполнено(ПричинаВозвратаВОборот) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопустимыеПричиныВозвратаВОборот(ВидПродукции).Найти(ПричинаВозвратаВОборот) = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Недопустимая причина возврата в оборота ""%1"" для вида продукции ""%2""'");
		Ошибка = Новый_ОшибкаЗаполнения("ПричинаВозвратаВОборот");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ПричинаВозвратаВОборот, ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьПричинуВозвратаВОборотДляВложенныхТоваровНаборов(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	ПричинаВозвратаВОборот = ОписаниеОперации.ДопРеквизиты.ПричинаВозвратаВОборот;
	
	Если Не ЗначениеЗаполнено(ПричинаВозвратаВОборот) Тогда
		Возврат;
	КонецЕсли;
	
	МодульМаркировки = МодульМаркировки();
	ТекстОшибки = НСтр("ru = 'Для набора или его вложений недоступна выбранная причина возврата в оборот.
							|Расформируйте набор и верните вложения в оборот по отдельности'");
	
	КэшТоваров = Новый Соответствие;
	Для Каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		Если Не МодульМаркировки.ЭтоМультитоварныйНабор(СтрТовара.Товар, КэшТоваров) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ВидПродукции Из МодульМаркировки.Товар_ВидыПродукцииСоставаНабора(СтрТовара.Товар) Цикл
			
			Если ДопустимыеПричиныВозвратаВОборот(ВидПродукции).Найти(ПричинаВозвратаВОборот) = Неопределено Тогда
				Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибки;
				ОшибкиЗаполнения.Добавить(Ошибка);
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьРазрешительныйДокумент(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	Товары = ОписаниеОперации.Товары;
	ТипОперации = ОписаниеОперации.ТипОперации;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	СпособВводаВОборот = ДопРеквизиты.СпособВводаВОборот;
	ВидКорректируемыхСведений = ДопРеквизиты.ВидКорректируемыхСведений;
	
	СпособВводаТребуетРД = СпособВводаВОборотТребуетРД(СпособВводаВОборот, ВидПродукции);
	ВидПродукцииТребуетРД = ВидПродукцииТребуетРазрешительныйДокумент(ВидПродукции);
	
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	
	Для Каждого Стр Из Товары Цикл
		
		Если ТипОперации = ТипыОпераций.ВводВОборот
			И СпособВводаВОборот <> Перечисление_СпособыВводаВОборот().ИмпортФТС Тогда
			
			ТребуетсяЗаполнитьРД = ВидПродукцииТребуетРД И СпособВводаТребуетРД
			И Не Товар_ОтсутствуютТребованияРД(Стр.Товар)
			И Не Товар_АвтоприкреплениеСведений(Стр.Товар)
			И Стр.Товар.ТипКодаМаркировки <> ТипыКодовМаркировки.ГрупповаяУпаковка;
			
		ИначеЕсли ТипОперации = ТипыОпераций.КорректировкаСведенийОКодах Тогда
			ТребуетсяЗаполнитьРД = (ВидКорректируемыхСведений = ВидыСведений.РазрешительныйДокумент);
		Иначе
			ТребуетсяЗаполнитьРД = Ложь;
		КонецЕсли;
		
		РазрешительныйДокумент = Стр.РазрешительныйДокумент;
		Если Не ЗначениеЗаполнено(РазрешительныйДокумент) Тогда
			Если ТребуетсяЗаполнитьРД Тогда
				Ошибка = Новый_ОшибкаЗаполнения();
				Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить разрешительный документ'");
				Ошибка.ИмяПоля = "РазрешительныйДокумент";
				Ошибка.ИмяТаблицы = "Товары";
				Ошибка.НомерСтроки = Стр.НомерСтроки;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
		Иначе
			
			Если Не ВидПродукцииДопускаетВидРазрешительногоДокумента(РазрешительныйДокумент.ВидДокумента, ВидПродукции) Тогда
				Ошибка = Новый_ОшибкаЗаполнения();
				Ошибка.ТекстОшибки = НСтр("ru = 'Указан некорректный вид разрешительного документа'");
				Ошибка.ИмяПоля = "РазрешительныйДокумент";
				Ошибка.ИмяТаблицы = "Товары";
				Ошибка.НомерСтроки = Стр.НомерСтроки;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если НачалоДня(РазрешительныйДокумент.ДатаОформления) > ТекущаяДата Тогда
				Ошибка = Новый_ОшибкаЗаполнения();
				Ошибка.ТекстОшибки = НСтр("ru = 'Дата оформления разрешительного документа не может быть позже текущей даты'");
				Ошибка.ИмяПоля = "РазрешительныйДокумент";
				Ошибка.ИмяТаблицы = "Товары";
				Ошибка.НомерСтроки = Стр.НомерСтроки;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьВидПервичногоДокументаДляВозвратаВОборот(ОписаниеОперации, ОшибкиЗаполнения)
	
	ПричинаВозвратаВОборот = ОписаниеОперации.ДопРеквизиты.ПричинаВозвратаВОборот;
	ВидПервичногоДокумента = ОписаниеОперации.ДопРеквизиты.ВидПервичногоДокумента;
	
	Если Не ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопустимыеВидыПервичныхДокументовДляВозвратаВОборот(ПричинаВозвратаВОборот).Найти(ВидПервичногоДокумента) = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Недопустимый вид первичного документа ""%1""'");
		Ошибка = Новый_ОшибкаЗаполнения("ВидПервичногоДокумента");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения, ВидПервичногоДокумента);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьВидПродукцииВШапкеИВТоварах(ОписаниеОперации, ОшибкиЗаполнения)
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		Если Стр.Товар.ВидПродукции <> ОписаниеОперации.ВидПродукции Тогда
