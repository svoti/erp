	ПодходящиеВидыПродукции = ДопустимыеВидыПродукцииДляУказанияТипаОтчетаОНанесении();
	Возврат МассивСодержитЗначение(ПодходящиеВидыПродукции, ВидПродукции);
	
КонецФункции

Функция ВидПродукцииДопускаетВидРазрешительногоДокумента(ВидДокумента, ВидПродукции)
	
	ВидыРД = Перечисление_ВидыРазрешительныхДокументов();
	
	ДопустимыеВиды = Новый Массив;
	ДопустимыеВиды.Добавить(ВидыРД.ДекларацияСоответствия);
	
	Если ВидПродукцииДопускаетСертификатСоответствия(ВидПродукции) Тогда
		ДопустимыеВиды.Добавить(ВидыРД.СертификатСоответствия);
	КонецЕсли;
	
	Если ВидПродукцииДопускаетСвидетельствоГосРегистрации(ВидПродукции) Тогда
		ДопустимыеВиды.Добавить(ВидыРД.СвидетельствоГосРегистрации);
	КонецЕсли;
	
	Возврат МассивСодержитЗначение(ДопустимыеВиды, ВидДокумента);
	
КонецФункции

Функция ВидПродукцииДопускаетСертификатСоответствия(ВидПродукции)
	
