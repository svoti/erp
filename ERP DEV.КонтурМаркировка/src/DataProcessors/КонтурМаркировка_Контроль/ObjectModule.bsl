Процедура Операция_ПроверитьКодыДляНаполненияКИГУ(ОписаниеОперации, ОшибкиЗаполнения)
	
	МодульМаркировки = МодульМаркировки();
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		ТаблицаКодов = МодульМаркировки.КодыОпераций_Прочитать(ОписаниеОперации.Ссылка, Стр.КлючСтрокиОперации);
		МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		Отбор = Новый Структура("ОбщийТипУпаковки", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара);
		СтрокиВложенныхТоваров = ТаблицаКодов.НайтиСтроки(Отбор);
		
		КоличествоКодовВложенногоТовара = СтрокиВложенныхТоваров.Количество();
		
		Если КоличествоКодовВложенногоТовара = 0 Тогда
			Ошибка = Новый_ОшибкаЗаполнения("КоличествоКодовВложенногоТовара", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо подобрать коды вложенного товара для наполнения КИГУ'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		Иначе
			
			КоличествоВложений = Стр.КоличествоУпаковок * Стр.Товар.КоличествоВложений;
			Если КоличествоКодовВложенногоТовара < КоличествоВложений Тогда
				Ошибка = Новый_ОшибкаЗаполнения("КоличествоКодовВложенногоТовара", "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = НСтр("ru = 'Недостаточно кодов вложенного товара для наполнения КИГУ'");
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

