Функция ДопустимыеПричиныВозвратаВОборот(ВидПродукции) Экспорт
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидПродукции", ВидПродукции);
	Отбор.Вставить("ПУ", Истина);
	
	Результат = Новый Массив;
	Для Каждого Стр Из ДопустимыеПричиныВозвратаВОборотПоВидамПродукции().НайтиСтроки(Отбор) Цикл
		Результат.Добавить(Стр.ПричинаВозвратаВОборот);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеПричиныВозвратаВОборотПоВидамПродукции()
	
	КлючКэш = "ДопустимыеПричиныВозвратаВОборотПоВидамПродукции";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ПричиныВозвратаВОборот = Перечисление_ПричиныВозвратаВОборот();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидПродукции", ОписаниеТипа_ВидПродукции());
	Результат.Колонки.Добавить("ПричинаВозвратаВОборот", ОписаниеТипа_Строка());
	Результат.Колонки.Добавить("ПУ", ОписаниеТипа_Булево());
	
	СтрокаПричиныВозвратаВОборот = 1;
	КолонкаВидаПродукции = 1;
	
	ТабДок = МакетОбработки("ПричиныВозвратаВОборот");
	
	Для Строка = 2 По ТабДок.ВысотаТаблицы Цикл
		
		ВидПродукцииСтр = СокрЛП(ТабДок.ПолучитьОбласть(Строка, КолонкаВидаПродукции).Область().Текст);
		
		Для Колонка = 2 По ТабДок.ШиринаТаблицы Цикл
			
			ПричинаВозвратаВОборотСтр = СокрЛП(ТабДок.ПолучитьОбласть(СтрокаПричиныВозвратаВОборот, Колонка).Область().Текст);
			
			Стр = Результат.Добавить();
			Стр.ВидПродукции = ВидыПродукции[ВидПродукцииСтр];
			Стр.ПричинаВозвратаВОборот = ПричиныВозвратаВОборот[ПричинаВозвратаВОборотСтр];
			
			Значение = СокрЛП(ТабДок.ПолучитьОбласть(Строка, Колонка).Область().Текст);
			
			Если Значение = "ПУ" Тогда
				Стр.ПУ = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.Индексы.Добавить("ВидПродукции, ПУ");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

