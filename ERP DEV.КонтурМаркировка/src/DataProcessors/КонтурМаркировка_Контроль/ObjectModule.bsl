КонецФункции

Функция Операция_ТоварыВАгрегатахТребуютВСД(Операция, КлючСтрокиОперации) Экспорт
	
	МодульМаркировки = МодульМаркировки();
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	МодульМаркировки.КодыОпераций_ВТ_Прочитать(Операция, МенеджерВТ, КлючСтрокиОперации);
	МодульМаркировки.ТаблицаКодов_ВТ_ЗаменитьТранспортныеУпаковкиНаВложенныеКоды(МенеджерВТ);
	МодульМаркировки.ТаблицаКодов_ВТ_ЗаменитьАТКНаВложенныеКоды(МенеджерВТ);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнформацияОКодах.Товар КАК Товар
	|ИЗ
	|	ТаблицаКодов КАК ТаблицаКодов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_КодыМаркировки КАК КодыМаркировки
	|		ПО ТаблицаКодов.КлючКода = КодыМаркировки.КлючКода
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО (КодыМаркировки.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде)
	|ГДЕ
	|	ИнформацияОКодах.Товар.ПодлежитВетеринарномуКонтролю
	|	И ИнформацияОКодах.Товар.ВидПродукции В(&ДопустимыеВидыПродукции)");
	Запрос.УстановитьПараметр("ДопустимыеВидыПродукции", ДопустимыеВидыПродукцииДляКонтроляВСД());
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция КодыОпераций_ЕстьМультитоварныеАгрегаты(Операция, КлючСтрокиОперации = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьМультитоварныеАгрегаты
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_КоличествоКодовОпераций КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурМаркировка_ИнформацияОКодах КАК ИнформацияОКодах
	|		ПО Т.КлючИнформацииОКоде = ИнформацияОКодах.КлючИнформацииОКоде
	|ГДЕ
	|	&КлючСтрокиОперации
	|	И Т.Операция = &Операция
	|	И ИнформацияОКодах.ТипУпаковки = &Мультитоварная
	|	И ИнформацияОКодах.ОбщийТипУпаковки = &ТранспортнаяУпаковка";
	
	Если КлючСтрокиОперации = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", "ИСТИНА");
	Иначе
		ТекстУсловия = "Т.КлючСтрокиОперации = &КлючСтрокиОперации";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КлючСтрокиОперации", ТекстУсловия);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("КлючСтрокиОперации", КлючСтрокиОперации);
	Запрос.УстановитьПараметр("Мультитоварная", Перечисления.КонтурМаркировка_ТипыУпаковок.МультитоварнаяУпаковка);
	Запрос.УстановитьПараметр("ТранспортнаяУпаковка", Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ТранспортнаяУпаковка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура Операция_ПроверитьВидПродукцииДляРегистрацииНаборов(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	ТипНабора = ОписаниеОперации.ДопРеквизиты.ТипНабора;
	ДопустимыеВидыПродукции = ДопустимыеВидыПродукцииДляРегистрацииНаборов(ТипНабора);
	
	Если ТипНабора = Перечисление_ТипыНаборов().Мультитоварный Тогда
		ТекстСообщения = НСтр("ru = 'Регистрация мультитоварных наборов недоступна для вида продукции ""%1""'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Регистрация наборов недоступна для вида продукции ""%1""'");
	КонецЕсли;
	
	Если Не МассивСодержитЗначение(ДопустимыеВидыПродукции, ВидПродукции) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("ВидПродукции");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения, ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьКоличествоВложенийДляРегистрацииНаборов(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТекстОшибки = НСтр("ru = 'Количество кодов не соответствует составу набора:
	|%1'");
	
	КэшТоваров = Новый Соответствие;
	МодульМаркировки = МодульМаркировки();
	
	Для Каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		ТаблицаКодов = МодульМаркировки.КодыОпераций_Прочитать(ОписаниеОперации.Ссылка, СтрТовара.КлючСтрокиОперации);
		МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		ТаблицаНаборов = ТаблицаКодов.Скопировать(, "КлючКода, КодМаркировки");
		
		МодульМаркировки.ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
		МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		Товар = Товар_Прочитать(СтрТовара.Товар, КэшТоваров);
		КоличествоВложений = 0;
		Для Каждого СоставНабора Из Товар.СоставНабора Цикл
			КоличествоВложений = КоличествоВложений + СоставНабора.КоличествоВложений;
		КонецЦикла;
		
		ТаблицаКодов.Индексы.Добавить("КлючАгрегата");
		
		КодыСОшибками = Новый Массив;
		Для Каждого СтрНабора Из ТаблицаНаборов Цикл
			ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата", СтрНабора.КлючКода));
			Если ВложенныеКоды.Количество() <> КоличествоВложений Тогда
				КодыСОшибками.Добавить(СтрНабора.КодМаркировки);
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(КодыСОшибками) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыСОшибками));
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура Операция_ПроверитьКоличествоВложенийДляРегистрацииВариативныхНаборов(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТекстОшибки = НСтр("ru = 'Недостаточные вложения набора:
	|%1'");
	
	КэшТоваров = Новый Соответствие;
	МодульМаркировки = МодульМаркировки();
	
	Для Каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		ТаблицаКодов = МодульМаркировки.КодыОпераций_Прочитать(ОписаниеОперации.Ссылка, СтрТовара.КлючСтрокиОперации);
		МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		ТаблицаНаборов = ТаблицаКодов.Скопировать(, "КлючКода, КодМаркировки");
		
		МодульМаркировки.ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
		МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		Товар = Товар_Прочитать(СтрТовара.Товар, КэшТоваров);
		ВложенныеТовары = Новый Массив;
		Для Каждого СоставНабора Из Товар.СоставНабора Цикл
			ВложенныеТовары.Добавить(СоставНабора.ВложенныйТовар);
		КонецЦикла;
		
		ТаблицаКодов.Индексы.Добавить("КлючАгрегата, Товар");
		
		КодыСОшибками = Новый Массив;
		Для Каждого СтрНабора Из ТаблицаНаборов Цикл
			Для каждого ВложенныйТовар Из ВложенныеТовары Цикл
				ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата, Товар", СтрНабора.КлючКода, ВложенныйТовар));
				Если ВложенныеКоды.Количество() = 0 Тогда
					КодыСОшибками.Добавить(СтрНабора.КодМаркировки);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(КодыСОшибками) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыСОшибками));
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьВложенияРегистрацииМультитоварныхНаборов(ОписаниеОперации, ОшибкиЗаполнения)
	
	МодульМаркировки = МодульМаркировки();
	ДопустимыеСтатусыВложенныхКодов = ДопустимыеСтатусыВложенныхКодовМультитоварныхНаборов();
	
	Для Каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		ТаблицаНаборов = МодульМаркировки.КодыОпераций_Прочитать(ОписаниеОперации.Ссылка, СтрТовара.КлючСтрокиОперации);
		МодульМаркировки.КодыМаркировки_Прочитать(ТаблицаНаборов);
		
		КодыСОшибкамиВидаПродукции = Новый Массив;
		КодыСОшибкамиСтатусовВложений = Новый Массив;
		
		Для Каждого СтрНабора Из ТаблицаНаборов Цикл
			
			ТаблицаКодов = МодульМаркировки.КодыМаркировки_ТаблицаВложенныхКодов(СтрНабора.КлючКода);
			Если Не ЗначениеЗаполнено(ТаблицаКодов) Тогда
				Продолжить;
			КонецЕсли;
			
			МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
			
			Если ТаблицаКодов.Найти(СтрТовара.Товар.ВидПродукции, "ВидПродукции") = Неопределено Тогда
				КодыСОшибкамиВидаПродукции.Добавить(СтрНабора.КодМаркировки);
			КонецЕсли;
			
			Для Каждого Статус Из МодульМаркировки.ТаблицаЗначений_ВыгрузитьКолонку(ТаблицаКодов, "Статус", Истина) Цикл
				Если Не МассивСодержитЗначение(ДопустимыеСтатусыВложенныхКодов, Статус) Тогда
					КодыСОшибкамиСтатусовВложений.Добавить(СтрНабора.КодМаркировки);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(КодыСОшибкамиВидаПродукции) Тогда
			ТекстОшибки = НСтр("ru = 'Вид продукции вложений не соответствует виду продукции набора:
			|%1'");
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыСОшибкамиВидаПродукции));
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодыСОшибкамиСтатусовВложений) Тогда
			ТекстОшибки = НСтр("ru = 'Коды вложений находятся в недопустимых статусах:
			|%1'");
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СписокКодовДляТекстаОшибки(КодыСОшибкамиСтатусовВложений));
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Операция_ДопустимоеКоличествоКодов(ТипОперации) Экспорт
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	// BSLLS:MagicNumber-off
	
	Варианты = Новый Соответствие;
	Варианты.Вставить(ТипыОпераций.ЗаказКодов					, 2000000);
	Варианты.Вставить(ТипыОпераций.ВводВОборот					, 40000);
	Варианты.Вставить(ТипыОпераций.ОтчетОНанесении				, 30000);
	Варианты.Вставить(ТипыОпераций.КорректировкаСведенийОКодах	, 30000);
	Варианты.Вставить(ТипыОпераций.Перемаркировка				, 30000);
	Варианты.Вставить(ТипыОпераций.ФормированиеКИГУ				, 30000);
	Варианты.Вставить(ТипыОпераций.РегистрацияКИГУ				, 30000);
	Варианты.Вставить(ТипыОпераций.РегистрацияНаборов			, 30000);
	Варианты.Вставить(ТипыОпераций.УведомлениеОСостоянииКодов	, 30000);
	Варианты.Вставить(ТипыОпераций.ФормированиеАТК				, 100000);
	
	// BSLLS:MagicNumber-on
	
	Возврат ЗначениеСоответствия(Варианты, ТипОперации, 0);
	
КонецФункции

Функция ДопустимоеКоличествоКодовВКИТУ() Экспорт
	
	Возврат 29999;
	
КонецФункции

Функция ВидПродукцииДоступенСервисПровайдеру(СервисПровайдер, ВидПродукции)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.ВидПродукции КАК ВидПродукции
	|ИЗ
	|	Справочник.КонтурМаркировка_СервисПровайдеры.ВидыПродукции КАК Т
