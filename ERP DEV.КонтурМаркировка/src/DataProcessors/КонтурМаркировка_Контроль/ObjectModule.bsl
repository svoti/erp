Функция ДопустимыеСпособыВводаВОборот(ВидПродукции) Экспорт
	
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ВидыПродукции = Перечисление_ВидыПродукции();
	ФичаФлаги = Перечисление_ФичаФлаги();
	
	Результат = Новый Массив;
	
	Если ВидПродукции <> ВидыПродукции.Пиво Тогда
		Результат.Добавить(СпособыВвода.ПроизводствоРФ);
	КонецЕсли;
	
	Результат.Добавить(СпособыВвода.Трансгран);
	
	Если ВидПродукцииДопускаетСпособВводаИмпорт(ВидПродукции)  Тогда
		Результат.Добавить(СпособыВвода.Импорт);
	КонецЕсли;
	
	Если ВидПродукцииДопускаетСпособВводаИмпортФТС(ВидПродукции) Тогда
		Результат.Добавить(СпособыВвода.ИмпортФТС);
	КонецЕсли;
	
	Если ВидПродукцииДопускаетСпособВводаОстатки(ВидПродукции) Тогда
		Результат.Добавить(СпособыВвода.Остатки);
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Электроника
		И ФичаФлагВключен(ФичаФлаги.ВводВОборотСПричинойЭлектроника) Тогда
		Результат.Добавить(СпособыВвода.СПричиной);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеСпособыВыпускаТоваров(ВидПродукции, ТипКодаМаркировки) Экспорт
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	ВидыПродукции = Перечисление_ВидыПродукции();
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	Результат = Новый Массив;
	Результат.Добавить(СпособыВыпуска.ПроизводствоРФ);
	Результат.Добавить(СпособыВыпуска.Импорт);
	
	Если ТипКодаМаркировкиДопускаетПеремаркировку(ТипКодаМаркировки)
		И МассивСодержитЗначение(ДопустимыеВидыПродукцииДляЗаказаКодовПодПеремаркировку(), ВидПродукции) Тогда
		Результат.Добавить(СпособыВыпуска.Перемаркировка);
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Игрушки Тогда
		ИзменитьМассивПоФичаФлагу(Результат, СпособыВыпуска.Остатки, ФичаФлаги.ОстаткиЗаказКодовИгрушки);
	КонецЕсли;
	
	Если ТипКодаМаркировкиДопускаетМаркировкуВнеПроизводстваИлиИмпорта(ТипКодаМаркировки)
		И ВидПродукцииДопускаетСпособВыпускаМаркировкаВнеПроизводстваИлиИмпорта(ВидПродукции) Тогда
		Результат.Добавить(СпособыВыпуска.МаркировкаВнеПроизводстваИлиИмпорта);
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Антисептики Тогда
		ИзменитьМассивПоФичаФлагу(Результат, СпособыВыпуска.Остатки, ФичаФлаги.ОстаткиЗаказКодовАнтисептики);
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Легпром Тогда
		ИзменитьМассивПоФичаФлагу(Результат, СпособыВыпуска.Остатки, ФичаФлаги.ОстаткиЛегпромВолна4);
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Велосипеды Тогда
		ИзменитьМассивПоФичаФлагу(Результат, СпособыВыпуска.Остатки, ФичаФлаги.ОстаткиЗаказКодовВелосипеды);
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.МаслаИАвтомобильныеЖидкости Тогда
		ИзменитьМассивПоФичаФлагу(Результат, СпособыВыпуска.Остатки, ФичаФлаги.ОстаткиАвтоЖидкости);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

