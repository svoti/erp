		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения, ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьЗаполнениеИдентификатораВСД(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.ИдентификаторВСД) Тогда
		
		Если МодульМаркировки().КодыОпераций_ЕстьАгрегаты(ОписаниеОперации.Ссылка) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("ИдентификаторВСД");
			Ошибка.ТекстОшибки = НСтр("ru = 'Идентификатор ВСД для агрегатов можно заполнить только в товарах'");
			ОшибкиЗаполнения.Добавить(Ошибка);
			Возврат;
		КонецЕсли;
		
		Если Операция_ТоварыСодержатИдентификаторВСД(ОписаниеОперации) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("ИдентификаторВСД");
			Ошибка.ТекстОшибки = НСтр("ru = 'Идентификатор ВСД нужно заполнить либо в шапке, либо в товарах'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Операция = ОписаниеОперации.Ссылка;
	ТребуетсяВСД = ВидПродукцииТребуетВСД(ОписаниеОперации.ВидПродукции);
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если ЗначениеЗаполнено(Стр.ИдентификаторВСД) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.Товар) И Стр.Товар.ПодлежитВетеринарномуКонтролю И ТребуетсяВСД Тогда
			ОшибкаПустойВСД = Истина;
		ИначеЕсли КодыОпераций_ЕстьМультитоварныеАгрегаты(Операция, Стр.КлючСтрокиОперации) Тогда
			ОшибкаПустойВСД = Операция_ТоварыВАгрегатахТребуютВСД(Операция, Стр.КлючСтрокиОперации);
		Иначе
			ОшибкаПустойВСД = Ложь;
		КонецЕсли;
		
		Если ОшибкаПустойВСД Тогда
			Ошибка = Новый_ОшибкаЗаполнения("ИдентификаторВСД", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить Идентификатор ВСД'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьНомерТаможеннойДекларации(ОписаниеОперации, ОшибкиЗаполнения)
	
	НомерДекларации = ОписаниеОперации.ДопРеквизиты.НомерДекларации;
	Если Не ЗначениеЗаполнено(НомерДекларации) Тогда
		Возврат;
	КонецЕсли;
	
	ДекларацияСоответствуетФормату = Истина;
	
	СтруктураДекларации = СтруктураТаможеннойДекларации(НомерДекларации);
	Если СтрДлина(СтруктураДекларации.КодТаможни) <> 8 Тогда
		ДекларацияСоответствуетФормату = Ложь;
	КонецЕсли;
	Если СтрДлина(СтруктураДекларации.ПорядковыйНомер) <> 7 Тогда
		ДекларацияСоответствуетФормату = Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтруктураДекларации.ДатаДекларации)
		Или СтруктураДекларации.ДатаДекларации > ТекущаяДата() Тогда
		ДекларацияСоответствуетФормату = Ложь;
	КонецЕсли;
	
	Если Не ДекларацияСоответствуетФормату Тогда
		Ошибка = Новый_ОшибкаЗаполнения("НомерДекларации");
		Ошибка.ТекстОшибки = НСтр("ru = 'Номер декларации имеет некорректный формат'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьПлощадкаКПП(ОписаниеОперации, ОшибкиЗаполнения)
	
	Площадка = ОписаниеОперации.ДопРеквизиты.Площадка;
	
