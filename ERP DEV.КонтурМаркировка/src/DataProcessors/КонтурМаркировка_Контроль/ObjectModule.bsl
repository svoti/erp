Процедура Операция_ПроверитьТоварыБакалеи_ИмпортФТС(ОписаниеОперации, ОшибкиЗаполнения)
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	РазрешенИмпортФТСВолна2 = ФичаФлагВключен(ФичаФлаги.ИмпортФТСБакалеяВолна2);
	
	ГруппаПлатности_2 = 2;
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если Стр.Товар.ВидПродукции <> ВидыПродукции.Бакалея Тогда
			Продолжить;
		КонецЕсли;
		
		ГруппаПлатности = Товар_ГруппаПлатности(Стр.Товар);
		
		Если ГруппаПлатности = ГруппаПлатности_2 И Не РазрешенИмпортФТСВолна2 Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Для бакалейной продукции (Соусы и специи) необходимо использовать способ ввода в оборот Импорт РФ'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

