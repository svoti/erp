		КэшНаСервере = Новый Соответствие;
	КонецЕсли;
	
	Результат = КэшНаСервере[Ключ];
	
	Возврат Результат;
	
КонецФункции

Процедура Кэш_Очистить() Экспорт
	
	Если ЗначениеЗаполнено(КэшНаСервере) Тогда
		КэшНаСервере.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура Кэш_Поместить(Ключ, Значение)
	
