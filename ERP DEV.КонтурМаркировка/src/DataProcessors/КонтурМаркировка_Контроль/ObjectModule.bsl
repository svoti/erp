Функция ДопустимыеВидыПродукцииДляЗаказаКодов(СпособВыпускаТоваров, ТипКодаМаркировки) Экспорт
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	ВидыПродукции = Перечисление_ВидыПродукции();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	СпособыВыпускаТоваров = Перечисление_СпособыВыпускаТоваров();
	
	Если СпособВыпускаТоваров = СпособыВыпускаТоваров.Перемаркировка Тогда
		Результат = ДопустимыеВидыПродукцииДляЗаказаКодовПодПеремаркировку();
	ИначеЕсли СпособВыпускаТоваров = СпособыВыпускаТоваров.МаркировкаВнеПроизводстваИлиИмпорта Тогда
		Результат = ДопустимыеВидыПродукцииДляМаркировкиВнеПроизводстваИлиИмпорта();
	ИначеЕсли ТипКодаМаркировки = ТипыКодовМаркировки.Набор Тогда
		Результат = ДопустимыеВидыПродукцииДляЗаказаНаборов();
	ИначеЕсли ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка Тогда
		Результат = ДопустимыеВидыПродукцииДляЗаказаКИГУ();
	Иначе
		
		Исключения = Новый Массив;
		
		Исключения.Добавить(ВидыПродукции.Табак);
		Исключения.Добавить(ВидыПродукции.НикотиносодержащаяПродукция);
		Исключения.Добавить(ВидыПродукции.АльтернативныйТабак);
		
		Если Не ФичаФлагВключен(ФичаФлаги.ЗаказКодовПечатнаяПродукция) Тогда
			Исключения.Добавить(ВидыПродукции.ПечатнаяПродукция);
		КонецЕсли;
		
		Если Не ФичаФлагВключен(ФичаФлаги.ЗаказКодовЭлектроника) Тогда
			Исключения.Добавить(ВидыПродукции.Электроника);
		КонецЕсли;
		
		Результат = ВсеВидыПродукции(Исключения);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

