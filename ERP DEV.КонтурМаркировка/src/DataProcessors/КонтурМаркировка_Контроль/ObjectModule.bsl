Процедура Операция_Проверить_РегистрацияАгрегатов(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().РегистрацияАгрегатов Тогда
		Возврат;
	КонецЕсли;
	
	Операция_ПроверитьНаличиеКодовМаркировки(ОписаниеОперации, ОшибкиЗаполнения);
	
	ДопустимоеКоличествоКодов = ДопустимоеКоличествоКодовВКИТУ();
	ТекущееКоличествоКодов = МодульМаркировки().КодыОпераций_МаксимальноеКоличествоКодовВКИТУ(ОписаниеОперации.Ссылка);
	ТекстОшибки = НСтр("ru = 'В одном агрегате не может быть больше %1 кодов'");
	
	Если ТекущееКоличествоКодов > ДопустимоеКоличествоКодов Тогда
		Ошибка = Новый_ОшибкаЗаполнения();
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ДопустимоеКоличествоКодов);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_Проверить_КорректировкаСведенийОКодах(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.КорректировкаСведенийОКодах Тогда
		Возврат;
	КонецЕсли;
	
	Операция_ПроверитьНаличиеКодовМаркировки(ОписаниеОперации, ОшибкиЗаполнения);
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ВидКорректируемыхСведений = ДопРеквизиты.ВидКорректируемыхСведений;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ИдентификаторВСД Тогда
		Операция_ПроверитьТоварыПодлежатВетеринарномуКонтролю(ОписаниеОперации, ОшибкиЗаполнения);
		Операция_ПроверитьФорматИдентификатораВСД(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ФактическийВес Тогда
		Операция_ПроверитьТоварыИмеютПеременныйВес(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ВариативныйСрокГодности Тогда
		Операция_ПроверитьТоварыИмеютУсловияХранения(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.КодТНВЭД Тогда
		Операция_ПроверитьДлинуКодаТНВЭД(ОписаниеОперации, ОшибкиЗаполнения);
		Операция_ПроверитьТипЭмиссииКодовМаркировкиТНВЭД(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ДатаПроизводства Тогда
		Операция_ПроверитьДатуПроизводства(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.СрокГодности Тогда
		Операция_ПроверитьТоварыТипСрокаГодности(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ВариативныйСрокГодности Тогда
		Операция_ПроверитьАльтернативныеСрокиГодности(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.РазрешительныйДокумент Тогда
		Операция_ПроверитьРазрешительныйДокумент(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.ЛицензияНаНедра Тогда
		Операция_ПроверитьЛицензиюНаНедра(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидКорректируемыхСведений = ВидыСведений.НомерПартии Тогда
		Операция_ПроверитьНомерПартии(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Операция_ПроверитьВидПродукцииВШапкеИВТоварах(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьТипыУпаковокКодовДляВидаКорректируемыхСведений(ОписаниеОперации, ОшибкиЗаполнения);
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизиты_КорректировкаСведенийОКодах(ОписаниеОперации);
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	Операция_ПроверитьОбязательныеРеквизитыТоваров(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_ВводВОборот(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ВидыПродукции = Перечисление_ВидыПродукции();
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ТипыЗаказов = Перечисление_ТипыПроизводственныхЗаказов();
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ВводВОборот Тогда
		Возврат;
	КонецЕсли;
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	СпособВводаВОборот = ДопРеквизиты.СпособВводаВОборот;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	Операция_ПроверитьСпособВводаВОборот(СпособВводаВОборот, ВидПродукции, ОшибкиЗаполнения);
	Операция_ПроверитьВидПродукцииДляВводаВОборот(ВидПродукции, ОшибкиЗаполнения);
	
	Если СпособВводаВОборот <> СпособыВвода.Остатки Тогда
		Операция_ПроверитьДлинуКодаТНВЭД(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Операция_ПроверитьФорматИдентификатораВСД(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьЗаполнениеИдентификатораВСД(ОписаниеОперации, ОшибкиЗаполнения);
	
	Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		Операция_ПроверитьНомерТаможеннойДекларации(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Пиво
		И СпособВводаВОборотТребуетКПППлощадки(СпособВводаВОборот) Тогда
		Операция_ПроверитьПлощадкаКПП(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.Трансгран Тогда
		Операция_ПроверитьСуммуНДС(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Вода
		И СпособВводаВОборот = СпособыВвода.ПроизводствоРФ Тогда
		Операция_ПроверитьЛицензиюНаНедра(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ПроизводствоРФ
		И ДопРеквизиты.ТипПроизводственногоЗаказа = ТипыЗаказов.КонтрактноеПроизводство Тогда
		Операция_ПроверитьИННСобственникаТоваров(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ИмпортФТС
		Или СпособВводаВОборот = СпособыВвода.ПроизводствоРФ Тогда
		Операция_ПроверитьДатуПроизводства(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Легпром Тогда
		Если СпособВводаВОборот = СпособыВвода.Остатки Тогда
			Операция_ПроверитьТоварыЛегпрома_Остатки(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Бакалея Тогда
		Если СпособВводаВОборот = СпособыВвода.Импорт Тогда
			Операция_ПроверитьТоварыБакалеи_Импорт(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
		Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
			Операция_ПроверитьТоварыБакалеи_ИмпортФТС(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Косметика Тогда
		Если СпособВводаВОборот = СпособыВвода.Импорт Тогда
			Операция_ПроверитьТоварыКосметики_Импорт(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
		Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
			Операция_ПроверитьТоварыКосметики_ИмпортФТС(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
		Если СпособВводаВОборот = СпособыВвода.Остатки Тогда
			Операция_ПроверитьТоварыКосметики_Остатки(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Бады
		И СпособВводаВОборот = СпособыВвода.Остатки Тогда
		Операция_ПроверитьТоварыБады_Остатки(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если СпособВводаВОборот <> СпособыВвода.Остатки Тогда
		Операция_ПроверитьРазрешительныйДокумент(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.Трансгран Тогда
		Операция_ПроверитьДатуИмпорта(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизиты_ВводВОборот(ОписаниеОперации);
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	Операция_ПроверитьОбязательныеРеквизитыТоваров(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_ВыводИзОборота(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.ВыводИзОборота Тогда
		Возврат;
	КонецЕсли;
	
	Операция_ПроверитьВидПервичногоДокументаДляВыводаИзОборота(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьВидПродукцииДляВыводаИзОборота(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьПричинуВыводаИзОборота(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьСтрануПолучателяДляВыводаИзОборота(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьВесДляВыводаИзОборота(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьФорматНомераПартии(ОписаниеОперации, ОшибкиЗаполнения);
	
	ПричиныВыводаИзОборота = Перечисление_ПричиныВыводаИзОборота();
	ПричинаВыводаИзОборота = ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота;
	
	Если ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.ПродажаПоГосКонтракту Тогда
		Операция_ПроверитьИдентификаторГосКонтракта(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	Если ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.ПродажаПоСделкеСГосударственнойТайной Тогда
		Операция_ПроверитьИдентификаторГосКонтрактаГосТайна(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	ИННОрганизации = ЗначениеРеквизитаОбъектаЛок(ОписаниеОперации.Организация, "ИНН");
	
	Если ПричинаВыводаИзОборотаТребуетКПППлощадки(ПричинаВыводаИзОборота, ОписаниеОперации.ВидПродукции, ИННОрганизации) Тогда
		Операция_ПроверитьПлощадкаКПП(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборотаТребуетФИАСПлощадки(ПричинаВыводаИзОборота, ОписаниеОперации.ВидПродукции, ИННОрганизации) Тогда
		Операция_ПроверитьПлощадкаФИАС(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Операция_ПроверитьПричинуВыводаИзОборотаВложенныхТоваровНаборов(ОписаниеОперации, ОшибкиЗаполнения);
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизиты_ВыводИзОборота(ОписаниеОперации);
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	Операция_ПроверитьОбязательныеРеквизитыТоваров(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_УведомлениеОСостоянииКодов(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().УведомлениеОСостоянииКодов Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции)
		И Не ВидПродукцииДопускаетУведомлениеОСостоянииКодов(ОписаниеОперации.ВидПродукции) Тогда
		ТекстОшибки = НСтр("ru = 'Уведомление о состоянии кодов недоступно для вида продукции ""%1""'");
		Ошибка = Новый_ОшибкаЗаполнения("ВидПродукции");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ОписаниеОперации.ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Операция_ПроверитьПлощадкаКПП(ОписаниеОперации, ОшибкиЗаполнения);
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизиты_УведомлениеОСостоянииКодов(ОписаниеОперации);
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	Операция_ПроверитьОбязательныеРеквизитыТоваров(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_РезервированиеПартий(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().РезервированиеПартий Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции)
		И Не ВидПродукцииПоддерживаетПартионныйУчет(ОписаниеОперации.ВидПродукции) Тогда
		ТекстОшибки = НСтр("ru = 'Резервирование партий недоступно для вида продукции ""%1""'");
		Ошибка = Новый_ОшибкаЗаполнения("ВидПродукции");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ОписаниеОперации.ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Операция_ПроверитьФорматНомераПартии_ПартионныйУчет(ОписаниеОперации, ОшибкиЗаполнения);
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизиты_РезервированиеПартий(ОписаниеОперации);
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	Операция_ПроверитьОбязательныеРеквизитыТоваров(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения)
	
	ПоляШапки = ОбязательныеРеквизиты.ПоляШапки;
	Если Не ЗначениеЗаполнено(ПоляШапки) Тогда
		Возврат;
	КонецЕсли;
	
	СвернутьМассивЛок(ПоляШапки);
	
	ТекстОшибки = НСтр("ru = 'Необходимо заполнить %1'");
	
	Для Каждого ИмяПоля Из ПоляШапки Цикл
		
		Если ОписаниеОперации.Свойство(ИмяПоля)
			И ЗначениеЗаполнено(ОписаниеОперации[ИмяПоля]) Тогда
			Продолжить;
		КонецЕсли;
		Если ОписаниеОперации.ДопРеквизиты.Свойство(ИмяПоля)
			И ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты[ИмяПоля]) Тогда
			Продолжить;
		КонецЕсли;
		
		Ошибка = Новый_ОшибкаЗаполнения(ИмяПоля);
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ИмяПоля);
		ОшибкиЗаполнения.Добавить(Ошибка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьОбязательныеРеквизитыТоваров(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения)
	
	ПоляТоваров = ОбязательныеРеквизиты.ПоляТоваров;
	Если Не ЗначениеЗаполнено(ПоляТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.Товары) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("Товары");
		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить товары'");
		ОшибкиЗаполнения.Добавить(Ошибка);
		Возврат;
	КонецЕсли;
	
	СвернутьМассивЛок(ПоляТоваров);
	УдалитьЗначениеИзМассива(ПоляТоваров, "Товары");
	
	ТекстОшибки = НСтр("ru = 'Необходимо заполнить %1'");
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Для каждого ИмяПоля Из ПоляТоваров Цикл
			Если Не ЗначениеЗаполнено(Стр[ИмяПоля]) Тогда
				Ошибка = Новый_ОшибкаЗаполнения(ИмяПоля, "Товары", Стр.НомерСтроки);
				Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ИмяПоля);
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьВидПродукцииСервисПровайдера(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	СервисПровайдер = ОписаниеОперации.ДопРеквизиты.СервисПровайдер;
	
	Если Не ЗначениеЗаполнено(СервисПровайдер) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ВидПродукцииДоступенСервисПровайдеру(СервисПровайдер, ВидПродукции) Тогда
		ТекстОшибки = ПараметрыВСтроку(НСтр("ru = 'Вид продукции ""%1"" недоступен для cервис-провайдера'"), ВидПродукции);
		Ошибка = Новый_ОшибкаЗаполнения("СервисПровайдер");
		Ошибка.ТекстОшибки = ТекстОшибки;
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьВидПродукцииДляЗаказаКодов(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	ТипКодаМаркировки = ОписаниеОперации.ДопРеквизиты.ТипКодаМаркировки;
	СпособВыпускаТоваров = ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров;
	ДопустимыеВиды = ДопустимыеВидыПродукцииДляЗаказаКодов(СпособВыпускаТоваров, ТипКодаМаркировки);
	
	Если ДопустимыеВиды.Найти(ВидПродукции) = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Заказ кодов недоступен для вида продукции ""%1""'");
		Ошибка = Новый_ОшибкаЗаполнения("ВидПродукции");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения, ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьТипКодаМаркировкиВШапкеИВТоварах(ОписаниеОперации, ОшибкиЗаполнения)
	
	ШаблонОшибки = НСтр("ru = 'В карточке товара ""%1"" указан другой тип кода маркировки'");
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		Если Стр.Товар.ТипКодаМаркировки <> ОписаниеОперации.ДопРеквизиты.ТипКодаМаркировки Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ШаблонОшибки, Стр.Товар);
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьСпособВыпускаТоваров(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если Не ЗначениеЗаполнено(ОписаниеОперации.ВидПродукции)
		Или Не ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ТипКодаМаркировки = ОписаниеОперации.ДопРеквизиты.ТипКодаМаркировки;
	СпособВыпускаТоваров = ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров;
	ЕстьДокументУчета = ЗначениеЗаполнено(ОписаниеОперации.ДокументУчета);
	
	ДоступныеСпособы = ДопустимыеСпособыВыпускаТоваров(ВидПродукции, ТипКодаМаркировки);
	
	Если ВидПродукции = ВидыПродукции.Бады
		И СпособВыпускаТоваров = СпособыВыпуска.МаркировкаВнеПроизводстваИлиИмпорта Тогда
		
		Операция_ПроверитьТоварыБады_ВнеПроизводстваИмпорта(ОписаниеОперации, ОшибкиЗаполнения);
		
	Иначе
		
		Если Не МассивСодержитЗначение(ДоступныеСпособы, СпособВыпускаТоваров) Тогда
			ТекстСообщения = НСтр("ru = 'Способ выпуска товаров ""%1"" недоступен для вида продукции ""%2""'");
			Ошибка = Новый_ОшибкаЗаполнения("СпособВыпускаТоваров");
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения, СпособВыпускаТоваров, ВидПродукции);
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьТипКодаМаркировки(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ТипКодаМаркировки = ОписаниеОперации.ДопРеквизиты.ТипКодаМаркировки;
	
	Если Не ЗначениеЗаполнено(ВидПродукции)
		Или Не ЗначениеЗаполнено(ТипКодаМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	СпособВыпускаТоваров = ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров;
	СпособыВыпускаТоваров = Перечисление_СпособыВыпускаТоваров();
	
	Если СпособВыпускаТоваров = СпособыВыпускаТоваров.МаркировкаВнеПроизводстваИлиИмпорта
		И ВидПродукцииДопускаетСпособВыпускаМаркировкаВнеПроизводстваИлиИмпорта(ВидПродукции) Тогда
		
		Если ТипКодаМаркировки <> ТипыКодовМаркировки.ЕдиницаТовара Тогда
			ТекстСообщения = НСтр("ru = 'Тип кода маркировки ""%1"" недоступен для способа выпуска товаров ""%2""'");
			Ошибка = Новый_ОшибкаЗаполнения("ТипКодаМаркировки");
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения, ТипКодаМаркировки, СпособВыпускаТоваров);
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЕсли;
	
	ДоступныеТипы = ДопустимыеТипыКодовМаркировки(СпособВыпускаТоваров, ВидПродукции);
	
	Если ДоступныеТипы.Найти(ТипКодаМаркировки) = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Тип кода маркировки ""%1"" недоступен для вида продукции ""%2""'");
		Ошибка = Новый_ОшибкаЗаполнения("ТипКодаМаркировки");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения, ТипКодаМаркировки, ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьТипОплатыКодов(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ВидыПродукции = Перечисление_ВидыПродукции();
	ТипОплатыКодов = ОписаниеОперации.ДопРеквизиты.ТипОплатыКодов;
	ТипыОплатыКодов = Перечисление_ТипыОплатыКодов();
	СпособВыпускаТоваров = ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров;
	СпособыВыпускаТоваров = Перечисление_СпособыВыпускаТоваров();
	
	Если СпособВыпускаТоваров = СпособыВыпускаТоваров.МаркировкаВнеПроизводстваИлиИмпорта
		И ВидПродукцииДопускаетСпособВыпускаМаркировкаВнеПроизводстваИлиИмпорта(ВидПродукции) Тогда
		
		Если ТипОплатыКодов <> ТипыОплатыКодов.ПоЭмиссии Тогда
			ТекстСообщения = НСтр("ru = 'Тип оплаты кодов ""%1"" недоступен для способа выпуска товаров ""%2""'");
			Ошибка = Новый_ОшибкаЗаполнения("ТипОплатыКодов");
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения, ТипОплатыКодов, СпособВыпускаТоваров);
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьТипЗаказаКодов(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	
	СпособВыпускаТоваров = ДопРеквизиты.СпособВыпускаТоваров;
	ТипЗаказаКодов = ДопРеквизиты.ТипЗаказаКодов;
	КлючКода = ДопРеквизиты.КлючКода;
	
	Если Не ЗначениеЗаполнено(ТипЗаказаКодов) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru='Вид продукции %1 не допускает указание типа заказа кодов %2'");
	Если Не ВидПродукцииДопускаетТипЗаказаКодов(ТипЗаказаКодов, ВидПродукции) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("ВидПродукции");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ВидПродукции, ТипЗаказаКодов);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru='Не указан код маркировки для типа заказа %1'");
	Если Не ЗначениеЗаполнено(КлючКода) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("КодМаркировки");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ТипЗаказаКодов);
		ОшибкиЗаполнения.Добавить(Ошибка);
		Возврат;
	КонецЕсли;
	
	МодульМаркировки = МодульМаркировки();
	ТипыЗаказаКодов = Перечисление_ТипыЗаказаКодов();
	
	ТаблицаКодов = МодульМаркировки.Новый_ТаблицаКодов();
	ТаблицаКодов.Добавить().КлючКода = КлючКода;
	
	МодульМаркировки.ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
	МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
	
	Операция_ПроверитьКодМаркировки(ОписаниеОперации, ТаблицаКодов, ОшибкиЗаполнения);
	
	Если ТипЗаказаКодов = ТипыЗаказаКодов.РасформированиеНабора Тогда
		Операция_ПроверитьТовары_МаркировкаТоваровРасформированногоНабора(ОписаниеОперации, ТаблицаКодов, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ТипЗаказаКодов = ТипыЗаказаКодов.РазделениеТовара Тогда
		Операция_ПроверитьТовары_РазделениеТовара(ОписаниеОперации, ТаблицаКодов, ОшибкиЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьКодМаркировки(ОписаниеОперации, ТаблицаКодов, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	ЭтоОтчетОНанесении = ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации);
	
	Если Не ЭтоОтчетОНанесении И Не ОписаниеОперации.ТипОперации = ТипыОпераций.ЗаказКодов Тогда
		Возврат;
	КонецЕсли;
	
	ТипыОтчетаОНанесении = Перечисление_ТипыОтчетаОНанесении();
	ТипыЗаказаКодов = Перечисление_ТипыЗаказаКодов();
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ТипЗаказаКодов = ДопРеквизиты.ТипЗаказаКодов;
	ТипОтчетаОНанесении = ДопРеквизиты.ТипОтчетаОНанесении;
	
	ЭтоМаркировкаРасформированногоНабора = (ТипЗаказаКодов = ТипыЗаказаКодов.РасформированиеНабора
		Или ТипОтчетаОНанесении = ТипыЗаказаКодов.РасформированиеНабора);
	ЭтоРазделениеТовара = (ТипЗаказаКодов = ТипыЗаказаКодов.РазделениеТовара
		Или ТипОтчетаОНанесении = ТипыЗаказаКодов.РазделениеТовара);
	
	СтрКода = ТаблицаКодов.Найти(ДопРеквизиты.КлючКода, "КлючКода");
	
	ТекстОшибки = НСтр("ru='Вид продукции кода маркировки %1 не соответствует виду продукции операции'");
	Если СтрКода.ВидПродукции <> ОписаниеОперации.ВидПродукции Тогда
		Ошибка = Новый_ОшибкаЗаполнения("КодМаркировки");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СтрКода.ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
		Возврат;
	КонецЕсли;
	
	Если ЭтоМаркировкаРасформированногоНабора Тогда
		
		ТекстОшибки = НСтр("ru='Маркировка товаров расформированного набора доступна только для кодов набора'");
		Если СтрКода.ОбщийТипУпаковки <> Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.Набор Тогда
			Ошибка = Новый_ОшибкаЗаполнения("КодМаркировки");
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
			Возврат;
		КонецЕсли;
		
		ТекстОшибки = НСтр("ru='Не найдены вложенные коды набора'");
		Если ЭтоОтчетОНанесении И ТаблицаКодов.Количество() = 1 Тогда
			Ошибка = Новый_ОшибкаЗаполнения("КодМаркировки");
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоРазделениеТовара Тогда
		
		ТекстОшибки = НСтр("ru='Разделение товара доступно только для кодов единиц товара'");
		Если СтрКода.ОбщийТипУпаковки <> Перечисления.КонтурМаркировка_ОбщиеТипыУпаковок.ЕдиницаТовара Тогда
			Ошибка = Новый_ОшибкаЗаполнения("КодМаркировки");
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		ТекстОшибки = НСтр("ru='Разделение товара доступно только для товаров с переменным количеством'");
		Если Не СтрКода.Товар.ПеременныйВес Тогда
			Ошибка = Новый_ОшибкаЗаполнения("КодМаркировки");
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		ТекстОшибки = НСтр("ru='Для разделения товара требуется полный код маркировки'");
		Если Не СтрКода.ЕстьПолныйКод Тогда
			Ошибка = Новый_ОшибкаЗаполнения("КодМаркировки");
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьТовары_МаркировкаТоваровРасформированногоНабора(ОписаниеОперации, ТаблицаКодов, ОшибкиЗаполнения)
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	КлючКода = ДопРеквизиты.КлючКода;
	
	ОтборАгрегата = Новый Структура("КлючАгрегата", КлючКода);
	
	ТаблицаВложенныхКодов = ТаблицаКодов.Скопировать(ОтборАгрегата, "Товар");
	ТаблицаВложенныхКодов.Колонки.Добавить("КоличествоКодов", ОписаниеТипа_Число());
	ТаблицаВложенныхКодов.ЗаполнитьЗначения(1, "КоличествоКодов");
	ТаблицаВложенныхКодов.Свернуть("Товар", "КоличествоКодов");
	
	ТекстОшибки = НСтр("ru='Количество кодов не соответствует составу расформированного набора: %1'");
	Для Каждого Стр Из ТаблицаВложенныхКодов Цикл
		
		СтрОперации = ОписаниеОперации.Товары.Найти(Стр.Товар, "Товар");
		
		Если Не ЗначениеЗаполнено(СтрОперации) 
			Или (СтрОперации.КоличествоУпаковок <> Стр.КоличествоКодов) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товары");
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Стр.Товар);
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьТовары_РазделениеТовара(ОписаниеОперации, ТаблицаКодов, ОшибкиЗаполнения)
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ОписаниеКода = ТаблицаКодов.Найти(ДопРеквизиты.КлючКода, "КлючКода");
	
	ТекстОшибки = НСтр("ru='Товар должен совпадать с товаром разделяемого кода %1'");
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		Если Стр.Товар <> ОписаниеКода.Товар Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Стр.Товар);
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьДопустимоеКоличествоУпаковокВЗаказе(ОписаниеОперации, ОшибкиЗаполнения)
	
	ДопустимоеКоличествоКодов = Операция_ДопустимоеКоличествоКодов(ОписаниеОперации.ТипОперации);
	ТекстОшибки = ПараметрыВСтроку(НСтр("ru = 'Количество упаковок не должно превышать %1'"), ДопустимоеКоличествоКодов);
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если Стр.КоличествоУпаковок > ДопустимоеКоличествоКодов Тогда
			Ошибка = Новый_ОшибкаЗаполнения("КоличествоУпаковок", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьТоварыЛегпрома_Остатки(ОписаниеОперации, ОшибкиЗаполнения)
	
	РазрешеныОстаткиЛегпром = ФичаФлагВключен(Перечисление_ФичаФлаги().ОстаткиЛегпромВолна4);
	
