Функция Операция_ОбязательныеРеквизиты_ВводВОборот(ОписаниеОперации)
	
	Результат = Новый_ОбязательныеРеквизитыОперации();
	ПоляШапки = Результат.ПоляШапки;
	ПоляТоваров = Результат.ПоляТоваров;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	СпособыВвода = Перечисление_СпособыВводаВОборот();
	ТипыЗаказов = Перечисление_ТипыПроизводственныхЗаказов();
	
	Организация = ОписаниеОперации.Организация;
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ПроизводительИНН = ДопРеквизиты.ПроизводительИНН;
	СпособВводаВОборот = ДопРеквизиты.СпособВводаВОборот;
	ТоварыЗакрытогоСегмента = ДопРеквизиты.ТоварыЗакрытогоСегмента;
	ТипПроизводственногоЗаказа = ДопРеквизиты.ТипПроизводственногоЗаказа;
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ВидПродукции");
	ПоляШапки.Добавить("СпособВводаВОборот");
	
	ПоляТоваров.Добавить("КоличествоУпаковок");
	
	Если СпособВводаВОборот <> СпособыВвода.ИмпортФТС
		И Не КодыОпераций_ЕстьМультитоварныеАгрегаты(ОписаниеОперации.Ссылка) Тогда
		ПоляТоваров.Добавить("Товар");
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ПроизводствоРФ Тогда
		ПоляШапки.Добавить("ТипПроизводственногоЗаказа");
		Если ТипПроизводственногоЗаказа = ТипыЗаказов.КонтрактноеПроизводство Тогда
			ПоляШапки.Добавить("ПроизводительИНН");
			Если ЗначениеЗаполнено(ПроизводительИНН)
				И ПроизводительИНН = Организация.ИНН Тогда
				ПоляШапки.Добавить("СобственникТовараИНН");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.ИмпортФТС Тогда
		ПоляШапки.Добавить("НомерДекларации");
		Если ВидПродукции = ВидыПродукции.Пиво Тогда
			ПоляШапки.Добавить("Площадка");
		КонецЕсли;
		Если ТоварыЗакрытогоСегмента Тогда
			ПоляТоваров.Добавить("КодТНВЭД");
			ПоляТоваров.Добавить("КодСтраныПроизводителя");
		КонецЕсли;
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.Импорт Тогда
		ПоляШапки.Добавить("ДатаДекларации");
		ПоляШапки.Добавить("НомерДекларации");
		ПоляШапки.Добавить("КодТаможни");
		ПоляШапки.Добавить("ПринятоеРешение");
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.Трансгран Тогда
		
		ПоляШапки.Добавить("КодСтраныЭкспортера");
		ПоляШапки.Добавить("НаименованиеЭкспортера");
		ПоляШапки.Добавить("НомерНалогоплательщикаОтправителя");
		ПоляШапки.Добавить("ДатаИмпорта");
		ПоляШапки.Добавить("НомерДокумента");
		ПоляШапки.Добавить("ДатаДокумента");
		
		Если ВидПродукции = ВидыПродукции.Пиво Тогда
			ПоляШапки.Добавить("Площадка");
			ПоляТоваров.Добавить("Цена");
			ПоляТоваров.Добавить("СуммаАкциза");
		КонецЕсли;
		
	КонецЕсли;
	
	Если СпособВводаВОборотТребуетТНВЭД(СпособВводаВОборот) Тогда
		ПоляТоваров.Добавить("КодТНВЭД");
	КонецЕсли;
	
	Если СпособВводаВОборот = СпособыВвода.СПричиной Тогда
		ПоляШапки.Добавить("ПричинаВводаВОборот");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ОбязательныеРеквизиты_ВыводИзОборота(ОписаниеОперации)
	
	Результат = Новый_ОбязательныеРеквизитыОперации();
	ПоляШапки = Результат.ПоляШапки;
	ПоляТоваров = Результат.ПоляТоваров;
	
	ВидыДокументов = Перечисление_ВидыПервичныхДокументов();
	ПричиныВыводаИзОборота = Перечисление_ПричиныВыводаИзОборота();
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	ПричинаВыводаИзОборота = ДопРеквизиты.ПричинаВыводаИзОборота;
	ВидПервичногоДокумента = ДопРеквизиты.ВидПервичногоДокумента;
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ВидПродукции");
	ПоляШапки.Добавить("ПричинаВыводаИзОборота");
	
	Если ДопРеквизиты.ОбъемноСортовойУчет Тогда
		ПоляТоваров.Добавить("Товар");
	КонецЕсли;
	
	Если ПричинаВыводаИзОборотаТребуетПервичныйДокумент(ПричинаВыводаИзОборота) Тогда
		ПоляШапки.Добавить("ВидПервичногоДокумента");
		ПоляШапки.Добавить("НомерДокумента");
		ПоляШапки.Добавить("ДатаДокумента");
	КонецЕсли;
	
	Если ПричинаВыводаИзОборотаДопускаетПервичныйДокумент(ПричинаВыводаИзОборота)
		И ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
		ПоляШапки.Добавить("НомерДокумента");
		ПоляШапки.Добавить("ДатаДокумента");
	КонецЕсли;
	
	Если ПричинаВыводаИзОборотаТребуетИННПолучателя(ПричинаВыводаИзОборота) Тогда
		ПоляШапки.Добавить("ИННПолучателя");
	КонецЕсли;
	
	ЕстьИННПолучателя = ЗначениеЗаполнено(ДопРеквизиты.ИННПолучателя);
	Если ПричинаВыводаИзОборотаТребуетУказатьЦену(ПричинаВыводаИзОборота, ЕстьИННПолучателя)
		И ПричинаВыводаИзОборота <> ПричиныВыводаИзОборота.БезвозмезднаяПередача Тогда
		ПоляТоваров.Добавить("Цена");
	КонецЕсли;
	
	Если ВидПервичногоДокумента = ВидыДокументов.Прочее Тогда
		ПоляШапки.Добавить("НаименованиеПервичногоДокумента");
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.Прочее Тогда
		ПоляШапки.Добавить("НаименованиеПричиныВыводаИзОборота");
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.ПродажаПоГосКонтракту
		Или ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.ПродажаПоСделкеСГосударственнойТайной Тогда
		ПоляШапки.Добавить("ИдентификаторГосКонтракта");
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.ЭкспортЕАЭС Тогда
		ПоляШапки.Добавить("КодСтраныПолучателя");
	КонецЕсли;
	
	ИННОрганизации = ЗначениеРеквизитаОбъектаЛок(ОписаниеОперации.Организация, "ИНН");
	Если ПричинаВыводаИзОборотаТребуетКПППлощадки(ПричинаВыводаИзОборота, ОписаниеОперации.ВидПродукции, ИННОрганизации)
		Или ПричинаВыводаИзОборотаТребуетФИАСПлощадки(ПричинаВыводаИзОборота, ОписаниеОперации.ВидПродукции, ИННОрганизации) Тогда
		ПоляШапки.Добавить("Площадка");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ОбязательныеРеквизиты_ВозвратВОборот(ОписаниеОперации)
	
	ПричиныВозврата = Перечисление_ПричиныВозвратаВОборот();
	ВидыПервичныхДокументов = Перечисление_ВидыПервичныхДокументов();
	
	Результат = Новый_ОбязательныеРеквизитыОперации();
	ПоляШапки = Результат.ПоляШапки;
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ПричинаВозвратаВОборот");
	
	ТоварОплачен = ОписаниеОперации.ДопРеквизиты.ТоварОплачен;
	ПричинаВозвратаВОборот = ОписаниеОперации.ДопРеквизиты.ПричинаВозвратаВОборот;
	ВидПервичногоДокумента = ОписаниеОперации.ДопРеквизиты.ВидПервичногоДокумента;
	
	Если ПричинаВозвратаВОборотТребуетПервичныйДокумент(ПричинаВозвратаВОборот, ТоварОплачен) Тогда
		ПоляШапки.Добавить("ВидПервичногоДокумента");
		ПоляШапки.Добавить("НомерДокумента");
		ПоляШапки.Добавить("ДатаДокумента");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
		ПоляШапки.Добавить("НомерДокумента");
		ПоляШапки.Добавить("ДатаДокумента");
	КонецЕсли;
	
	Если ВидПервичногоДокумента = ВидыПервичныхДокументов.Прочее Тогда
		ПоляШапки.Добавить("НаименованиеПервичногоДокумента");
	КонецЕсли;
	
	Если ПричинаВозвратаВОборот = ПричиныВозврата.Гостайна Тогда
		ПоляШапки.Добавить("ИдентификаторГосКонтракта");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

