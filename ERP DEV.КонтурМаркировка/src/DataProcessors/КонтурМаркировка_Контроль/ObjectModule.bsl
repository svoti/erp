// Классификатор из макета
// 
// Возвращаемое значение:
//  ТаблицаЗначений - классификатор стран мира:
//   * Наименование - Строка - Наименование (пример: РОССИЯ);
//   * КодАльфа2 - Строка - КодАльфа2 (пример: RU);
//   * КодАльфа3 - Строка - КодАльфа3 (пример: RUS);
//   * Код - Строка - Код (пример: 643);
//   * НаименованиеПолное - Строка - НаименованиеПолное (пример: Российская Федерация);
//   * УчастникЕАЭС - Булево - УчастникЕАЭС (пример: Истина);
//   * Неактуальный - Булево - Неактуальный (пример: Ложь);
//   * МеждународноеНаименование - Строка - Международное наименование (пример: The Russian Federation);
//
Функция КлассификаторСтран() Экспорт
	
	КлючКэш = "КлассификаторСтран";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	КлассификаторXML = МакетОбработки("КлассификаторСтран").ПолучитьТекст();
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(КлассификаторXML);
	Результат = СериализаторXDTO.ПрочитатьXML(Чтение);
	
	Для каждого Стр Из Результат Цикл
		Если Не ЗначениеЗаполнено(Стр.НаименованиеПолное) Тогда
			Стр.НаименованиеПолное = Стр.Наименование;
		КонецЕсли;
	КонецЦикла;
	
	Результат.Сортировать("Наименование");
	Результат.Индексы.Добавить("Код");
	Результат.Индексы.Добавить("КодАльфа2");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция НаименованияСтранМира() Экспорт
	
	КлючКэш = "НаименованияСтранМира";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = КлассификаторСтран().ВыгрузитьКолонку("Наименование");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СписокСтранМира(КодыСтран = Неопределено) Экспорт
	
	Результат = Новый СписокЗначений;
	
	Для Каждого Стр Из КлассификаторСтран() Цикл
		Если КодыСтран = Неопределено Или МассивСодержитЗначение(КодыСтран, Стр.Код) Тогда
			Результат.Добавить(Стр.Код, Стр.Наименование);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СписокСтранЕАЭС() Экспорт
	
