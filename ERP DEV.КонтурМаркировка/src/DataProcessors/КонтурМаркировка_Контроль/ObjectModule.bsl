Функция ДопРеквизиты_Прочитать(Объект) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ИмяРеквизита КАК ИмяРеквизита,
	|	Т.Значение КАК Значение,
	|	Т.ЗначениеКлюч КАК ЗначениеКлюч,
	|	Т.ЗначениеСсылка КАК ЗначениеСсылка,
	|	Т.ТипКлючаЗначения КАК ТипКлючаЗначения
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК Т
	|ГДЕ
	|	Т.Объект = &Объект");
	Запрос.УстановитьПараметр("Объект", Объект);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ЗначениеСсылка) Тогда
			Значение = Выборка.ЗначениеСсылка;
		ИначеЕсли ЗначениеЗаполнено(Выборка.ЗначениеКлюч) Тогда
			Если ЗначениеЗаполнено(Выборка.ТипКлючаЗначения) Тогда
				Значение = МодульОбщегоНазначения().СсылкаПоИдентификатору(Выборка.ЗначениеКлюч, Выборка.ТипКлючаЗначения);
			Иначе
				Значение = Выборка.ЗначениеКлюч;
			КонецЕсли;
		Иначе
			Значение = Выборка.Значение;
		КонецЕсли;
		
		Результат.Вставить(Выборка.ИмяРеквизита, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДопРеквизит_Прочитать(Объект, ИмяРеквизита, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Значение КАК Значение,
	|	Т.ЗначениеКлюч КАК ЗначениеКлюч,
	|	Т.ЗначениеСсылка КАК ЗначениеСсылка,
	|	Т.ТипКлючаЗначения КАК ТипКлючаЗначения
	|ИЗ
	|	РегистрСведений.КонтурМаркировка_ДопРеквизиты КАК Т
	|ГДЕ
	|	Т.Объект = &Объект
	|	И Т.ИмяРеквизита = &ИмяРеквизита");
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	Запрос.УстановитьПараметр("Объект", Объект);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = ЗначениеПоУмолчанию;
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.ЗначениеСсылка) Тогда
			Результат = Выборка.ЗначениеСсылка;
		ИначеЕсли ЗначениеЗаполнено(Выборка.ЗначениеКлюч) Тогда
			Если ЗначениеЗаполнено(Выборка.ТипКлючаЗначения) Тогда
				Результат = МодульОбщегоНазначения().СсылкаПоИдентификатору(Выборка.ЗначениеКлюч, Выборка.ТипКлючаЗначения);
			Иначе
				Результат = Выборка.ЗначениеКлюч;
			КонецЕсли;
		Иначе
			Результат = Выборка.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

