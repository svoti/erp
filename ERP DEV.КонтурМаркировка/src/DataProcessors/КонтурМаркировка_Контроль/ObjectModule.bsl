Функция ЧислоИзСтроки(Строка) Экспорт
	
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат 0;
	КонецЕсли;
	
	КодСимвола0 = КодСимвола("0");
	КодСимвола9 = КодСимвола("9");
	ДлинаСтроки = СтрДлина(Строка);
	ЧислоСтрокой = "";
	ЕстьРазделитель = Ложь;
	
	Для Сч = 1 По ДлинаСтроки Цикл
		Символ = Сред(Строка, Сч, 1);
		Если Не ЕстьРазделитель И (Символ = "," Или Символ = ".") Тогда
			ЧислоСтрокой = ЧислоСтрокой + Символ;
			ЕстьРазделитель = Истина;
			Продолжить;
		КонецЕсли;
		КодСимвола = КодСимвола(Символ);
		Если КодСимвола >= КодСимвола0
			И КодСимвола <= КодСимвола9 Тогда
			ЧислоСтрокой = ЧислоСтрокой + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Результат = ОписаниеТипа_Число().ПривестиЗначение(ЧислоСтрокой);
	
	Возврат Результат;
	
КонецФункции

