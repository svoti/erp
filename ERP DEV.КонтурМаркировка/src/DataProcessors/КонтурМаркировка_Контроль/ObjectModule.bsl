Функция Перечисление_ФичаФлаги() Экспорт
	
	КлючКэш = "ФичаФлаги";
	Результат = Кэш_Прочитать(КлючКэш);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Структура;
	ДополнитьСтруктуру(Результат, Перечисление_ФичаФлагиВключения());
	ДополнитьСтруктуру(Результат, Перечисление_ФичаФлагиОтключения());
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

