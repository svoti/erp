Функция ТоварТребуетЛицензиюНаНедра(Товар)
	
	ОписаниеТовара = Товар_Прочитать(Товар);
	
	Если ОписаниеТовара.ВидПродукции <> Перечисление_ВидыПродукции().Вода Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат (Не ОписаниеТовара.ДопРеквизиты.НеДобываетсяИзПодземныхВод);
	
КонецФункции

Функция ТоварДопускаетЗаказКодовНаОстатки(Товар) Экспорт
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	РазрешеныОстаткиЛегпром = ФичаФлагВключен(ФичаФлаги.ОстаткиЛегпромВолна4);
	РазрешеныОстаткиАнтисептики = ФичаФлагВключен(ФичаФлаги.ОстаткиЗаказКодовАнтисептики);
	РазрешеныОстаткиАвтоЖидкости = ФичаФлагВключен(ФичаФлаги.ОстаткиАвтоЖидкости);
	
	Результат =
	РазрешеныОстаткиЛегпром И ЭтоТоварЛегпромаВолна4(Товар)
	Или РазрешеныОстаткиАнтисептики И ЭтоТоварАнтисептиков(Товар)
	Или РазрешеныОстаткиАвтоЖидкости И ЭтоТоварАвтоЖидкостей(Товар);
	
	Возврат Результат;
	
КонецФункции

Функция ТоварПодлежитПартионномуУчету(Товар) Экспорт
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ФичаФлаги = Перечисление_ФичаФлаги();
	
	Результат = Ложь;
	
	Если Товар.ВидПродукции = ВидыПродукции.Молоко Тогда
		СрокХраненияДо40Суток = ДопРеквизит_Прочитать(Товар, "СрокХраненияДо40Суток", Ложь);
		Результат = ФичаФлагВключен(ФичаФлаги.ПартионныйУчетМолокоСрокХраненияДо40Суток)
		ИЛИ (ФичаФлагВключен(ФичаФлаги.ПартионныйУчетМолокоСрокХраненияСвыше40Суток) И Не СрокХраненияДо40Суток);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ХарактеристикаСрокаИспользованияТребуетСрокГодности(Товар) Экспорт
	
	Результат = Ложь;
	
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	ХарактеристикиСрока = Перечисление_ХарактеристикиСрокаИспользованияТовара();
	ОписаниеТовара = Товар_Прочитать(Товар);
	
	Если ОписаниеТовара.ТипКодаМаркировки = ТипыКодовМаркировки.ЕдиницаТовара
		И ОписаниеТовара.ДопРеквизиты.ХарактеристикаСрокаИспользования = ХарактеристикиСрока.СрокГодности Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

