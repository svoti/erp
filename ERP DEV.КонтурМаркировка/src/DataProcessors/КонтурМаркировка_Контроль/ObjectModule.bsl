Функция ДопустимыеСтраныДляВыводаИзОборота(ВидПродукции, ПричинаВыводаИзОборота) Экспорт
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	ВидыПродукции = Перечисление_ВидыПродукции();
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	
	КодыДопустимыхСтран = КодыСтранЕАЭС();
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЕАЭС Тогда
		
		Исключения = Новый Массив;
		Исключения.Добавить(ВидыПродукции.Шины);
		Исключения.Добавить(ВидыПродукции.Обувь);
		Если Не ФичаФлагВключен(ФичаФлаги.ВыводИзОборотаТрансгранЛегпромБеларусь) Тогда
			Исключения.Добавить(ВидыПродукции.Легпром);
		КонецЕсли;
		
		Если МассивСодержитЗначение(Исключения, ВидПродукции) Тогда
			КодБеларуси = "112";
			УдалитьЗначениеИзМассива(КодыДопустимыхСтран, КодБеларуси);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СписокСтранМира(КодыДопустимыхСтран);
	
КонецФункции

