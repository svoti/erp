// Проверяет что значение заполнено,
// мутабельное значение считается заполненным
//
// Параметры:
//  Значение - Произвольное - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если значение есть
//
Функция ЕстьЗначение(Значение)
	
	Попытка
		Результат = ЗначениеЗаполнено(Значение);
	Исключение
		Результат = Истина; // Мутабельное значение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначенияРеквизитовОбъектаЛок(Ссылка, Реквизиты) Экспорт
	
	Результат = Новый Структура;
	
	Если Не ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		СтруктураРеквизитов = Новый Структура(Реквизиты);
	ИначеЕсли ЭтоСтруктура(Реквизиты) Тогда
		СтруктураРеквизитов = Реквизиты;
	ИначеЕсли ЭтоМассив(Реквизиты) Тогда
		СтруктураРеквизитов = Новый Структура;
		Для каждого Реквизит Из Реквизиты Цикл
			СтруктураРеквизитов.Вставить(Реквизит);
		КонецЦикла;
	Иначе
		ВызватьИсключение ПараметрыВСтроку(
		НСтр("ru = 'Неверный тип второго параметра Реквизиты: %1'"),
		ТипЗнч(Реквизиты));
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		Результат.Вставить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстПолей = "";
	Разделитель = "";
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			ИмяПоля = СокрЛП(КлючИЗначение.Значение);
		Иначе
			ИмяПоля = СокрЛП(КлючИЗначение.Ключ);
		КонецЕсли;
		Псевдоним = СокрЛП(КлючИЗначение.Ключ);
		ТекстПолей = ТекстПолей + Разделитель + "
		|	" + ИмяПоля + " КАК " + Псевдоним;
		Разделитель = ",";
	КонецЦикла;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&ТекстПолей КАК ТекстПолей
	|ИЗ
	|	&ИмяТаблицы
	|ГДЕ
	|	Ссылка = &Ссылка";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПолей КАК ТекстПолей", ТекстПолей);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", Ссылка.Метаданные().ПолноеИмя());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеРеквизитаОбъектаЛок(Ссылка, ИмяРеквизита)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		СтруктураРеквизита = ЗначенияРеквизитовОбъектаЛок(Ссылка, ИмяРеквизита);
		Если ЗначениеЗаполнено(СтруктураРеквизита) Тогда
			Результат = СтруктураРеквизита[ИмяРеквизита];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет что значение есть в структуре
//
// Параметры:
//  Структура - Структура - структура, в котором нужно найти значение;
//  Значение - Произвольный - значение, которое нужно найти в массиве;
// 
// Возвращаемое значение:
//  Булево - Истина, если значение есть в массиве
//
Функция ЕстьЗначениеВСтруктуре(Структура, Значение)
	
	Для Каждого КлючИЗначение Из Структура Цикл
		Если КлючИЗначение.Значение = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Безопасно читает свойство структуры
// 
// Параметры:
//  Структура - Структура - структура;
//  Ключ      - Строка  - ключ;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается,
//                                   если в структуре нет такого ключа;
// 
// Возвращаемое значение:
//   Произвольный - значение свойства
//
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено)
	
	Возврат МодульОбщегоНазначения().СвойствоОбъекта(Структура, Ключ, ЗначениеПоУмолчанию);
	
КонецФункции

// Безопасно читает по ключу значение соответствия
// или значение по умолчанию, если в соответствии нет такого ключа
// 
// Параметры:
//  Соответствие        - Соответствие - соответствие источник;
//  Ключ                - Произвольный - ключ соответствия;
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается в случае,
//                                       если в соответствии нет указанного ключа;
// 
// Возвращаемое значение:
//  Произвольный - значение из соответствия или ЗначениеПоУмолчанию
//
Функция ЗначениеСоответствия(Соответствие, Ключ, ЗначениеПоУмолчанию = Неопределено)
	
	Попытка
		Результат = Соответствие[Ключ];
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Дополняет структуру или соответсвие приемник из данных источника
//
// Параметры:
//  Приемник - Структура, Соответствие
//  Источник - Структура, Соответствие
//
Процедура ДополнитьСтруктуру(Приемник, Источник)
	
	Для Каждого КлючИЗначение Из Источник Цикл
		Приемник.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Безопасно заполняет поля структуры значениями из другой структуры
// Пустые значения источника при этом игнорируются
//
// Параметры:
//  Приемник - Структура - структура, которую надо заполнить;
//  Источник - Структура, ФиксированнаяСтруктура - структура, из которой надо взять значения;
//  СписокСвойств    - Строка - (необязательный) список имен свойств, разделенный запятыми,
//                     которые необходимо заполнить, ошибки не будет если таких свойств нет;
//  ИсключаяСвойства - Строка - (необязательный) список имен свойств, разделенный запятыми,
//                     которые заполнять не нужно, ошибки не будет если таких свойств нет;
//  Рекурсивно - Булево - (необязательный) Истина, если необходимо заполнить вложенные структуры;
//
Процедура ЗаполнитьПоляСтруктуры(Приемник, Источник, СписокСвойств = "", ИсключаяСвойства = "", Рекурсивно = Ложь)
	
	Если Не ЭтоСтруктура(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполняемыеСвойства = РазделитьСтроку(НРег(СписокСвойств));
	ИсключаемыеСвойства = РазделитьСтроку(НРег(ИсключаяСвойства));
	
	ЕстьЗаполняемыеСвойства = ЗначениеЗаполнено(ЗаполняемыеСвойства);
	ЕстьИсключаемыеСвойства = ЗначениеЗаполнено(ИсключаемыеСвойства);
	
	Для каждого Элемент Из Источник Цикл
		
		Ключ = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если Не Приемник.Свойство(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЕстьЗначение(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЕстьЗаполняемыеСвойства
			И ЗаполняемыеСвойства.Найти(НРег(Ключ)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЕстьИсключаемыеСвойства
			И ИсключаемыеСвойства.Найти(НРег(Ключ)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Рекурсивно И ЭтоСтруктура(Значение) И ЭтоСтруктура(Приемник[Ключ]) Тогда
			ЗаполнитьПоляСтруктуры(Приемник[Ключ], Значение, СписокСвойств, ИсключаяСвойства, Рекурсивно);
		Иначе
			Приемник[Ключ] = Значение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрыВСтроку(ШаблонСтроки, Параметр1
