Функция Операция_ОбязательныеРеквизиты_СообщениеОбОтгрузке(ОписаниеОперации)
	
	ТипыОтгрузок = Перечисление_ТипыОтгрузок();
	ПричиныВыводаИзОборота = Перечисление_ПричиныВыводаИзОборотаПриОтгрузке();
	
	Результат = Новый_ОбязательныеРеквизитыОперации();
	ПоляШапки = Результат.ПоляШапки;
	ПоляТоваров = Результат.ПоляТоваров;
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ТипОтгрузки");
	ПоляШапки.Добавить("ДатаОтгрузки");
	ПоляШапки.Добавить("НомерДокумента");
	ПоляШапки.Добавить("ДатаДокумента");
	ПоляШапки.Добавить("ИННПолучателя");
	ПоляШапки.Добавить("ВидПродукции");
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	Если ДопРеквизиты.ТипОтгрузки = ТипыОтгрузок.ТрансграничнаяТорговля Тогда
		ПоляШапки.Добавить("КодСтраныПолучателя");
		ПоляШапки.Добавить("GLNПолучателя");
		Если ДопРеквизиты.ОбъемноСортовойУчет Тогда
			ПоляШапки.Добавить("НаименованиеПолучателя");
		КонецЕсли;
	КонецЕсли;
	
	Если ДопРеквизиты.ТипОтгрузки = ТипыОтгрузок.ОтгрузкаСВыводомИзОборота Тогда
		ПоляШапки.Добавить("ДатаВыводаИзОборота");
		ПоляШапки.Добавить("ПричинаВыводаИзОборота");
	КонецЕсли;
	
	Если ДопРеквизиты.ПричинаВыводаИзОборота = ПричиныВыводаИзОборота.ПриобретениеГосПредприятием Тогда
		ПоляШапки.Добавить("ИдентификаторГосКонтракта");
	КонецЕсли;
	
	ПоляТоваров.Добавить("КоличествоУпаковок");
	
	Возврат Результат;
	
КонецФункции

