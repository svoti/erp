	МинимальнаяДлинаКодаТНВЭД = 10;
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если ЗначениеЗаполнено(Стр.КодТНВЭД) И СтрДлина(Стр.КодТНВЭД) < МинимальнаяДлинаКодаТНВЭД Тогда
			Ошибка = Новый_ОшибкаЗаполнения("КодТНВЭД", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Код ТНВЭД имеет некорректный формат'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьТипЭмиссииКодовМаркировкиТНВЭД(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТекстОшибки = НСтр("ru = 'Некорректный способ выпуска товаров."
	+ " ""ТН ВЭД"" невозможно изменить у КИ со способом выпуска ""Импорт в РФ""'");
	ИмпортВРФ = Перечисление_СпособыВыпускаТоваров().Импорт;
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если МодульМаркировки().КодыОпераций_ЕстьКодыСоСпособамиВыпуска(ОписаниеОперации.Ссылка, ИмпортВРФ, Стр.КлючСтрокиОперации) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибки;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьЛицензиюНаНедра(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ДопРеквизиты.СпособВводаВОборот <> Перечисление_СпособыВводаВОборот().ПроизводствоРФ
		И ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().КорректировкаСведенийОКодах Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если Не ТоварТребуетЛицензиюНаНедра(Стр.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.НомерЛицензииНаНедра) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерЛицензииНаНедра", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Номер лицензии на пользование недрами должен быть заполнен'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.ДатаЛицензииНаНедра) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("ДатаЛицензииНаНедра", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Дата лицензии на пользование недрами должна быть заполнена'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.НомераСкважин)
			И ФичаФлагВключен(Перечисление_ФичаФлаги().КонтрольНомераСкважин) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомераСкважин", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Номера скважин должны быть заполнены'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьТипыУпаковокКодовДляВидаКорректируемыхСведений(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидКорректируемыхСведений = ОписаниеОперации.ДопРеквизиты.ВидКорректируемыхСведений;
	Если Не ЗначениеЗаполнено(ВидКорректируемыхСведений) Тогда
		Возврат;
	КонецЕсли;
	
	МодульМаркировки = МодульМаркировки();
	ПодходящиеТипыУпаковок = МодульМаркировки.Операция_КорректировкаСведенийОКодах_ПодходящиеТипыУпаковок(ВидКорректируемыхСведений);
	
	Если МодульМаркировки.КодыОпераций_ЕстьДругиеОбщиеТипыУпаковок(ОписаниеОперации.Ссылка, ПодходящиеТипыУпаковок) Тогда
		ТекстОшибки = НСтр("ru = 'Корректировка вида сведений ""%1"" допустима только для кодов с типом упаковки %2'");
		ТипыУпаковокСтрокой = СоединитьСтроку(ПодходящиеТипыУпаковок, ", ");
		Ошибка = Новый_ОшибкаЗаполнения("КодыМаркировки");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ВидКорректируемыхСведений, ТипыУпаковокСтрокой);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьСпособВводаВОборот(СпособВводаВОборот, ВидПродукции, ОшибкиЗаполнения)
	
	Если Не ЗначениеЗаполнено(ВидПродукции)
		Или Не ЗначениеЗаполнено(СпособВводаВОборот) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопустимыеСпособыВводаВОборот(ВидПродукции).Найти(СпособВводаВОборот) = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Способ ввода в оборот ""%1"" недоступен для вида продукции ""%2""'");
		Ошибка = Новый_ОшибкаЗаполнения("СпособВводаВОборот");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СпособВводаВОборот, ВидПродукции);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьВидПродукцииДляВводаВОборот(ВидПродукции, ОшибкиЗаполнения)
	
	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
