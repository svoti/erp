	ПоляШапки.Добавить("ВидПродукции");
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ОбязательныеРеквизиты_КорректировкаСведенийОКодах(ОписаниеОперации)
	
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Результат = Новый_ОбязательныеРеквизитыОперации();
	ПоляШапки = Результат.ПоляШапки;
	ПоляТоваров = Результат.ПоляТоваров;
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ВидПродукции");
	ПоляШапки.Добавить("ВидКорректируемыхСведений");
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	Если ДопРеквизиты.ВидКорректируемыхСведений = ВидыСведений.ДатаПроизводства Тогда
		ПоляТоваров.Добавить("ДатаПроизводства");
	КонецЕсли;
	
	Если ДопРеквизиты.ВидКорректируемыхСведений = ВидыСведений.СрокГодности Тогда
		ПоляТоваров.Добавить("ДатаСрокаГодности");
	КонецЕсли;
	
	Если ДопРеквизиты.ВидКорректируемыхСведений = ВидыСведений.ИдентификаторВСД Тогда
		ПоляТоваров.Добавить("ИдентификаторВСД");
	КонецЕсли;
	
	Если ДопРеквизиты.ВидКорректируемыхСведений = ВидыСведений.КодТНВЭД Тогда
		ПоляТоваров.Добавить("КодТНВЭД");
	КонецЕсли;
	
	Если ДопРеквизиты.ВидКорректируемыхСведений = ВидыСведений.ФактическийВес Тогда
		ПоляТоваров.Добавить("Количество");
	КонецЕсли;
	
	Если ДопРеквизиты.ВидКорректируемыхСведений = ВидыСведений.СпособВыпускаТоваров Тогда
		ПоляТоваров.Добавить("СпособВыпускаТоваров");
	КонецЕсли;
	
	Если ДопРеквизиты.ВидКорректируемыхСведений = ВидыСведений.РазрешительныйДокумент
		Или ДопРеквизиты.ВидКорректируемыхСведений = ВидыСведений.ЛицензияНаНедра Тогда
		ПоляТоваров.Добавить("ТипКорректировкиСведенийОКодах");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ОбязательныеРеквизиты_УведомлениеОСостоянииКодов(ОписаниеОперации)
	
	Результат = Новый_ОбязательныеРеквизитыОперации();
	ПоляШапки = Результат.ПоляШапки;
	ПоляТоваров = Результат.ПоляТоваров;
	
	СостоянияКодов = Перечисление_СостоянияКодов();
	ВидыДокументов = Перечисление_ВидыПервичныхДокументов();
	ВидыТранспортныхДокументов = Перечисление_ВидыТранспортныхДокументов();
	
	ДопРеквизиты = ОписаниеОперации.ДопРеквизиты;
	СостояниеКодов = ДопРеквизиты.СостояниеКодов;
	ВидТранспортногоДокумента = ДопРеквизиты.ВидТранспортногоДокумента;
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ВидПродукции");
	
	Если СостояниеКодов = СостоянияКодов.ОтгрузкаНаЭкспорт Тогда
		
		ПоляШапки.Добавить("Площадка");
		ПоляШапки.Добавить("ДатаОтгрузки");
		ПоляШапки.Добавить("ИННПолучателя");
		ПоляШапки.Добавить("НаименованиеПолучателя");
		ПоляШапки.Добавить("КодСтраныПолучателя");
		ПоляШапки.Добавить("ВидТранспортногоДокумента");
		
		Если ВидТранспортногоДокумента = ВидыТранспортныхДокументов.ТТН Тогда
			ПоляШапки.Добавить("ГосномерТранспортногоСредства");
			ПоляШапки.Добавить("НомерДокумента");
			ПоляШапки.Добавить("ДатаДокумента");
		КонецЕсли;
		
		Если ВидТранспортногоДокумента = ВидыТранспортныхДокументов.ЭПД Тогда
			ПоляШапки.Добавить("ИдентификаторЭПД");
		КонецЕсли;
		
	КонецЕсли;
	
	ПоляТоваров.Добавить("Товар");
	
	Возврат Результат;
	
КонецФункции

