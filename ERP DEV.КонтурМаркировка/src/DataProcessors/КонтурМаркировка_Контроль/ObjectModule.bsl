// Соединяет части в одну строку с указанным разделителем
// По аналогии с методом платформы СтрСоединить
// 
// Параметры:
//  ЧастиСтроки - Массив - части строки;
//  Разделитель - Строка - (необязательный) разделитель строк;
//
// Возвращаемое значение:
//  Строка - строка состоящая из всех частей
//
Функция СоединитьСтроку(ЧастиСтроки, Разделитель = "")
	
	Возврат МодульОбщегоНазначения().СоединитьСтроку(ЧастиСтроки, Разделитель);
	
КонецФункции

// Разделяет текст на части по указанному разделителю
//
// Параметры:
//  Строка - Строка - разделяемый текст;
//  Разделитель - Строка - (необязательный) значение разделителя;
//  ВключатьПустые - Булево - Истина, если пустые части нужно включить в результат;
// 
// Возвращаемое значение:
//  Массив - содержит части текста
//
Функция РазделитьСтроку(Строка, Разделитель = ",", ВключатьПустые = Ложь)
	
	Возврат МодульОбщегоНазначения().РазделитьСтроку(Строка, Разделитель, ВключатьПустые);
	
КонецФункции

// Определяет, является ли значение массивом
// или фиксированным массивом
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является структрой или фиксированной структурой
//
Функция ЭтоМассив(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение структурой
// или фиксированной структурой
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить
// 
// Возвращаемое значение:
//  Булево - Истина, если переданое значение является структрой или фиксированной структурой
//
Функция ЭтоСтруктура(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение в массиве
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Массив
Функция ЗначениеВМассиве(Значение)
	
	Если ЭтоМассив(Значение) Тогда
		Результат = Значение;
	Иначе
		Результат = Новый Массив;
		Результат.Добавить(Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет что значение есть в массиве
//
// Параметры:
//  Массив - Массив - массив, в котором нужно найти значение;
//  Значение - Произвольный - значение, которое нужно найти в массиве;
// 
// Возвращаемое значение:
//  Булево - Истина, если значение есть в массиве
//
Функция МассивСодержитЗначение(Массив, Значение)
	
	Возврат Массив.Найти(Значение) <> Неопределено;
	
КонецФункции

// Выгружает значения структуры в массив
//
// Параметры:
//  Структура - Структура - структура
// 
// Возвращаемое значение:
//  Массив
//
Функция МассивЗначенийИзСтруктуры(Структура)
	
	Результат = Новый Массив;
	
	Для каждого Элемент Из Структура Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Дополняет массив значениями из другого массива
//
// Параметры:
//  МассивПриемник - Массив - массив, в который необходимо добавить значения;
//  МассивИсточник - Массив - массив, из которого нужно взять значения;
//  ТолькоНовыеЗначения - Булево - (необязательный) Истина, если в приемник нужно добавить только новые значения;
//  ДобавлятьПустыеЗначения - Булево - (необязательный) Ложь, если пустые значения в приемник добавлять не нужно;
//
Процедура ДополнитьМассив(МассивПриемник, МассивИсточник
	, ТолькоНовыеЗначения = Ложь
	, ДобавлятьПустыеЗначения = Истина)
	
	Если ТолькоНовыеЗначения Тогда
		
		ЗначенияПриемника = Новый Соответствие;
		Для Каждого Значение Из МассивПриемник Цикл
			ЗначенияПриемника.Вставить(Значение, Истина);
		КонецЦикла;
		
		Для Каждого Значение Из МассивИсточник Цикл
			Если Не ДобавлятьПустыеЗначения
				И Не ЗначениеЗаполнено(Значение) Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначенияПриемника[Значение] = Неопределено Тогда
				МассивПриемник.Добавить(Значение);
				ЗначенияПриемника.Вставить(Значение, Истина);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Добавляет значение в массив, если его там еще нет
//
// Параметры:
//  Массив - Массив - массив, в который нужно добавить значение;
//  Значение - Значение - значение, которое нужно добавить;
//
Процедура ДобавитьЗначениеВМассив(Массив, Значение)
	
	Если Не МассивСодержитЗначение(Массив, Значение) Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

// Удаляет значение из массива, если оно в нем есть
//
// Параметры:
//  Массив - Массив - массив, из которого нужно удалить значение;
//  Значение - Значение - значение, которое нужно удалить;
//
Процедура УдалитьЗначениеИзМассива(Массив, Значение)
	
	ИндексЗначения = Массив.Найти(Значение);
	Пока ИндексЗначения <> Неопределено Цикл
		Массив.Удалить(ИндексЗначения);
		ИндексЗначения = Массив.Найти(Значение);
	КонецЦикла;
	
КонецПроцедуры

// Оставляет в массиве только уникальные значения
//
// Параметры:
//  Массив - Массив - массив;
//  УдалитьПустыеЗначения - Булево - (необязательный) Истина, если нужно удалить пустые значения;
//
Процедура СвернутьМассивЛок(Массив, УдалитьПустыеЗначения = Ложь)
	
	Результат = Новый Массив;
	
	ДополнитьМассив(Результат, Массив, Истина, Не УдалитьПустыеЗначения);
	
	Массив = Результат;
	
КонецПроцедуры

