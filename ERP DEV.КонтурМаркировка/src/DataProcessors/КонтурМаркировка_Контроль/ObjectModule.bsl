	ПоляШапки = Результат.ПоляШапки;
	ПоляТоваров = Результат.ПоляТоваров;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ТипИспользования");
	
	Если ВидПродукцииТребуетПлощадкуВОтчетеОНанесении(ОписаниеОперации.ВидПродукции, ДопРеквизиты.ТипОтчетаОНанесении) Тогда
		ПоляШапки.Добавить("Площадка");
	КонецЕсли;
	
	Если ВидПродукцииТребуетУказатьТипСрокаГодности(ОписаниеОперации.ВидПродукции)
		И Операция_ЕстьЕдиницыТоваров(ОписаниеОперации.Товары) Тогда
		ПоляШапки.Добавить("ТипСрокаГодности");
	КонецЕсли;
	
	Если ОписаниеОперации.ТипОперации = Перечисление_ТипыОпераций().ОтчетОНанесенииНаТСД Тогда
		ПоляТоваров.Добавить("Товары");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

