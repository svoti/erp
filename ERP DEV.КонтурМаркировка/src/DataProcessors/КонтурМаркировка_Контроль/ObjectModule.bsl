КонецФункции

Функция ВсеВидыПродукции(Знач Исключения = Неопределено) Экспорт
	
	КлючКэш = "ВсеВидыПродукции";
	Если ЗначениеЗаполнено(Исключения) Тогда
		КлючКэш = КлючКэш + " за исключением: " + СоединитьСтроку(Исключения, ", ");
	КонецЕсли;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Исключения = Неопределено Тогда
		Исключения = Новый Массив;
	КонецЕсли;
	
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.Алкоголь);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.КабельнаяПродукция);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.ЭлектронныеСистемыДоставкиНикотина);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.ПромышленноеОборудование);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.ДетскоеПитание);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.КормовыеДобавки);
	Исключения.Добавить(Перечисления.КонтурМаркировка_ВидыПродукции.НатуральныйМех);
	
	Результат = Новый Массив;
	Для каждого Значение Из Метаданные.Перечисления.КонтурМаркировка_ВидыПродукции.ЗначенияПеречисления Цикл
		ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции[Значение.Имя];
		Если ЗначениеЗаполнено(Исключения) И МассивСодержитЗначение(Исключения, ВидПродукции) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(ВидПродукции);
	КонецЦикла;
	
	Результат = Новый ФиксированныйМассив(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция МакетОбработки(ИмяМакета)
	
	Макеты = ЭтотОбъект.Метаданные().Макеты;
	
	Если Макеты.Найти(ИмяМакета) = Неопределено Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'В составе обработки не найден макет ""%1""'"), ИмяМакета);
	КонецЕсли;
	
	Результат = ЭтотОбъект.ПолучитьМакет(ИмяМакета);
	
	Возврат Результат;
	
КонецФункции

Функция ДатаТаможеннойДекларацииИзСтроки(ДатаДекларацииСтрокой)
	
	Результат = '00010101';
	ДопустимаяДлинаСтроки = 6;
	
	Если СтрДлина(ДатаДекларацииСтрокой) <> ДопустимаяДлинаСтроки
		Или Не ВСтрокеТолькоЦифры(ДатаДекларацииСтрокой) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПозицияДня = 1;
	ПозицияМесяца = 3;
	ПозицияГода = 5;
	ДлинаНомера = 2;
	
	НомерДня = ЧислоИзСтроки(Сред(ДатаДекларацииСтрокой, ПозицияДня, ДлинаНомера));
	НомерМесяца = ЧислоИзСтроки(Сред(ДатаДекларацииСтрокой, ПозицияМесяца, ДлинаНомера));
	НомерГода = ЧислоИзСтроки(Сред(ДатаДекларацииСтрокой, ПозицияГода, ДлинаНомера));
	
	Если ЗначениеЗаполнено(НомерГода)
		И ЗначениеЗаполнено(НомерМесяца)
		И ЗначениеЗаполнено(НомерДня) Тогда
		Результат = Дата(НачалоВека() + НомерГода, НомерМесяца, НомерДня);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует текст с первыми пятью кодами маркировки через запятую,
// если кодов больше, например 8, то добавляет текст "и еще 3"
//
// Параметры:
//  КодыМаркировки - Массив, ТаблицаЗначений - таблица содержит колонку КодМаркировки
// 
// Возвращаемое значение:
//  Строка - текст со списком кодов
//
Функция СписокКодовДляТекстаОшибки(КодыМаркировки) Экспорт
	
	МаксимумКодовВСообщении = 5;
	МассивКодов = Новый Массив;
	ВсегоКодов = КодыМаркировки.Количество();
	
	Для Сч = 1 По Мин(ВсегоКодов, МаксимумКодовВСообщении) Цикл
		
		Элемент = КодыМаркировки[Сч - 1];
		
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			КодМаркировки = Элемент;
		Иначе
			КодМаркировки = Элемент.КодМаркировки;
		КонецЕсли;
		
		МассивКодов.Добавить(УдалитьНедопустимыеСимволыXML(КодМаркировки));
		
	КонецЦикла;
	
	Результат = СоединитьСтроку(МассивКодов, ", ");
	
	Если ВсегоКодов > МаксимумКодовВСообщении Тогда
		ЕщеКодов = ВсегоКодов - МаксимумКодовВСообщении;
		СтрокаЕщеКодов = НСтр("ru = 'и еще %1'");
		Результат = Результат + " " + ПараметрыВСтроку(СтрокаЕщеКодов, ЕщеКодов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ОшибкаЗаполнения(ИмяПоля = "", ИмяТаблицы = "", НомерСтроки = 0) Экспорт
	
