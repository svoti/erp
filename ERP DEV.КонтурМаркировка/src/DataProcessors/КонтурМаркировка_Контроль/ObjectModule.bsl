		Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить операцию кодами'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Функция Операция_ТоварыСодержатИдентификаторВСД(ОписаниеОперации)
	
	Отбор = Новый Структура("ИдентификаторВСД", "");
	Возврат (ОписаниеОперации.Товары.Количество() > ОписаниеОперации.Товары.НайтиСтроки(Отбор).Количество());
	
КонецФункции

