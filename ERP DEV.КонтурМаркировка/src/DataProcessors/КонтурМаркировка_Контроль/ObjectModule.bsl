		Ошибка.ТекстОшибки = НСтр("ru = 'В указанной площадке не заполнен КПП'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьПлощадкаФИАС(ОписаниеОперации, ОшибкиЗаполнения)
	
	Площадка = ОписаниеОперации.ДопРеквизиты.Площадка;
	
	Если ЗначениеЗаполнено(Площадка)
		И Не ЗначениеЗаполнено(Площадка.ИдентификаторФИАС) Тогда
