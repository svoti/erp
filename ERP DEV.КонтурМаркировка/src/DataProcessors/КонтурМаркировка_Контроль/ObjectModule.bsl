Процедура Операция_ПроверитьПричинуВыводаИзОборота(ОписаниеОперации, ОшибкиЗаполнения)
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ОбъемноСортовойУчет = ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет;
	ПричинаВыводаИзОборота = ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота;
	
	Если Не ЗначениеЗаполнено(ПричинаВыводаИзОборота) Тогда
		Возврат;
	КонецЕсли;
	
	ДопустимыеПричины = ДопустимыеПричиныВыводаИзОборота(ВидПродукции, ОбъемноСортовойУчет);
	
	Если ДопустимыеПричины.Найти(ПричинаВыводаИзОборота) = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Недопустимая причина вывода из оборота ""%1""'");
		Ошибка = Новый_ОшибкаЗаполнения("ПричинаВыводаИзОборота");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ПричинаВыводаИзОборота);
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьПричинуВыводаИзОборотаВложенныхТоваровНаборов(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	ПричинаВыводаИзОборота = ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота;
	
	Если Не ЗначениеЗаполнено(ПричинаВыводаИзОборота) Тогда
		Возврат;
	КонецЕсли;
	
	МодульМаркировки = МодульМаркировки();
	ОбъемноСортовойУчет = ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет;
	
	ТекстОшибкиОСУ = НСтр("ru = 'Для набора или его вложений недоступен вывод из оборота по ОСУ.
							|Расформируйте набор и выведите вложения из оборота по отдельности'");
	ТекстОшибкиПричина = НСтр("ru = 'Для набора или его вложений недоступна выбранная причина вывода из оборота.
								|Расформируйте набор и выведите вложения из оборота по отдельности'");
	
	КэшТоваров = Новый Соответствие;
	Для Каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		Если Не МодульМаркировки.ЭтоМультитоварныйНабор(СтрТовара.Товар, КэшТоваров) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ВидПродукции Из МодульМаркировки.Товар_ВидыПродукцииСоставаНабора(СтрТовара.Товар) Цикл
			
			ДопустимыеПричины = ДопустимыеПричиныВыводаИзОборота(ВидПродукции, ОбъемноСортовойУчет);
			Если ДопустимыеПричины.Найти(ПричинаВыводаИзОборота) = Неопределено Тогда
				Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиПричина;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
			Если ОбъемноСортовойУчет
				И ДопустимыеВидыПродукцииДляВыводаИзОборота(ОбъемноСортовойУчет).Найти(ВидПродукции) = Неопределено Тогда
				Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
				Ошибка.ТекстОшибки = ТекстОшибкиОСУ;
				ОшибкиЗаполнения.Добавить(Ошибка);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьСтрануПолучателяДляВыводаИзОборота(ОписаниеОперации, ОшибкиЗаполнения)
	
	КодСтраныПолучателя = ОписаниеОперации.ДопРеквизиты.КодСтраныПолучателя;
	
	Если Не ЗначениеЗаполнено(КодСтраныПолучателя) Тогда
		Возврат;
	КонецЕсли;
	
	ВидПродукции = ОписаниеОперации.ВидПродукции;
	ПричинаВыводаИзОборота = ОписаниеОперации.ДопРеквизиты.ПричинаВыводаИзОборота;
	ДопустимыеСтраны = ДопустимыеСтраныДляВыводаИзОборота(ВидПродукции, ПричинаВыводаИзОборота);
	
	Если ДопустимыеСтраны.НайтиПоЗначению(КодСтраныПолучателя) = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Вывод из оборота по причине ""%1"" недоступен для страны ""%2""'");
		Ошибка = Новый_ОшибкаЗаполнения("КодСтраныПолучателя");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ПричинаВыводаИзОборота, НаименованиеСтраны(КодСтраныПолучателя));
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьВесДляВыводаИзОборота(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если Не ОписаниеОперации.ДопРеквизиты.ОбъемноСортовойУчет
		Или ОписаниеОперации.ВидПродукции <> Перечисление_ВидыПродукции().Молоко Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ФичаФлагВключен(Перечисление_ФичаФлаги().КонтрольВесВыводИзОборотаМолокоОСУ) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если Не ЗначениеЗаполнено(Стр.Количество) И Стр.Товар.ПеременныйВес Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Количество", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить вес товара'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьИдентификаторГосКонтракта(ОписаниеОперации, ОшибкиЗаполнения)
	
	ИдентификаторГосКонтракта = ОписаниеОперации.ДопРеквизиты.ИдентификаторГосКонтракта;
	Если Не ЗначениеЗаполнено(ИдентификаторГосКонтракта) Тогда
		Возврат;
	КонецЕсли;
	
	СоответствуетФормату = Истина;
	
	ДопустимаяДлинаИдентификатора = 255;
	Если СтрДлина(ИдентификаторГосКонтракта) > ДопустимаяДлинаИдентификатора Тогда
		СоответствуетФормату = Ложь;
	КонецЕсли;
	ДопустимыеСимволы = ВсеБуквыКириллицы() + ВсеБуквыЛатиницы() + ВсеЦифры() + ВсеСпецСимволы();
	Если Не СтрокаСодержитТолькоДопустимыеСимволы(ИдентификаторГосКонтракта, ДопустимыеСимволы) Тогда
		СоответствуетФормату = Ложь;
	КонецЕсли;
	
	Если Не СоответствуетФормату Тогда
		Ошибка = Новый_ОшибкаЗаполнения("ИдентификаторГосКонтракта");
		Ошибка.ТекстОшибки = НСтр("ru = 'Идентификатор гос. контракта имеет некорректный формат'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьИдентификаторГосКонтрактаГосТайна(ОписаниеОперации, ОшибкиЗаполнения)
	
	ИдентификаторГосКонтракта = ОписаниеОперации.ДопРеквизиты.ИдентификаторГосКонтракта;
	Если Не ЗначениеЗаполнено(ИдентификаторГосКонтракта) Тогда
		Возврат;
	КонецЕсли;
	
	СоответствуетФормату = Истина;
	
	ДопустимаяДлинаИдентификатора = 25;
	Если СтрДлина(ИдентификаторГосКонтракта) > ДопустимаяДлинаИдентификатора Тогда
		СоответствуетФормату = Ложь;
	КонецЕсли;
	
	ДопустимыеСимволы = "123";
	ПозицияПроверяемогоСимвола = 13;
	ПроверяемыйСимвол = Сред(ИдентификаторГосКонтракта, ПозицияПроверяемогоСимвола, 1);
	
	Если Не СтрокаСодержитТолькоДопустимыеСимволы(ПроверяемыйСимвол, ДопустимыеСимволы)
		Или Не СтрокаСодержитТолькоДопустимыеСимволы(ИдентификаторГосКонтракта, ВсеЦифры()) Тогда
		СоответствуетФормату = Ложь;
	КонецЕсли;
	
	Если Не СоответствуетФормату Тогда
		Ошибка = Новый_ОшибкаЗаполнения("ИдентификаторГосКонтракта");
		Ошибка.ТекстОшибки =  НСтр("ru = 'Идентификатор гос. контракта имеет некорректный формат'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьНаличиеКодовМаркировки(ОписаниеОперации, ОшибкиЗаполнения)
	
