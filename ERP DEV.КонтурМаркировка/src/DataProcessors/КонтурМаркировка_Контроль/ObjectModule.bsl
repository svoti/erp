	УдалитьЗначениеИзМассива(Результат, ВидыПродукции.Молоко);
	УдалитьЗначениеИзМассива(Результат, ВидыПродукции.БезалкогольныеНапитки);
	УдалитьЗначениеИзМассива(Результат, ВидыПродукции.Пиво);
