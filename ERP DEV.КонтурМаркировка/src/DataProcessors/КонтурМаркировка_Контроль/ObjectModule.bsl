КонецФункции

// Разбирает номер декларации на части
//
// Параметры:
//  НомерДекларации - Строка - номер декларации;
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * КодТаможни - Строка - код таможни;
//   * ДатаДекларации - Дата - дата декларации;
//   * ПорядковыйНомер - Строка - порядковый номер декларации;
//
Функция СтруктураТаможеннойДекларации(НомерДекларации) Экспорт
	
	ЧастиНомера = РазделитьСтроку(НомерДекларации, "/");
	
	Результат = Новый Структура;
	Результат.Вставить("КодТаможни");
	Результат.Вставить("ДатаДекларации");
	Результат.Вставить("ПорядковыйНомер");
	
	ДопустимоеКоличествоЧастей = 3;
	Если ЧастиНомера.Количество() <> ДопустимоеКоличествоЧастей Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.КодТаможни = ЧастиНомера[0];
	Результат.ДатаДекларации = ДатаТаможеннойДекларацииИзСтроки(ЧастиНомера[1]);
	Результат.ПорядковыйНомер = ЧастиНомера[2];
	
	Возврат Результат;
	
КонецФункции

// Разбирает номер партии на части
//
// Параметры:
//  НомерПартии - Строка - номер партии;
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * НомерПартии                  - Строка - входящий параметр, номер партии;
//   * GTIN                         - Строка - код товара;
//   * ДатаПроизводства             - Дата   - дата производства;
//   * СерийныйНомер                - Строка - серийный номер;
//   * ДлинаБольшеДопустимой        - Булево - Истина, если длина номера партии больше допустимой;
//   * ДлинаМеньшеДопустимой        - Булево - Истина, если длина номера партии меньше допустимой;
//   * ЕстьНедопустимыеСимволы      - Булево - Истина, если номер партии содержит недопустимые символы;
//   * НекорректныйGTIN             - Булево - Истина, если GTIN не соответствует формату;
//   * НекорректнаяДатаПроизводства - Булево - Истина, если дата производства не соответствует формату;
//
Функция СтруктураНомераПартии(НомерПартии)
	
	ДлинаНомера = СтрДлина(НомерПартии);
	ФорматПартии = ФорматНомераПартии();
	
	Результат = Новый Структура;
	Результат.Вставить("GTIN", "");
	Результат.Вставить("ДатаПроизводства", '00010101');
	Результат.Вставить("СерийныйНомер", "");
	Результат.Вставить("НомерПартии", НомерПартии);
	Результат.Вставить("НекорректныйGTIN", Ложь);
	Результат.Вставить("НекорректнаяДатаПроизводства", Ложь);
	
	Результат.Вставить("ДлинаМеньшеДопустимой", ЗначениеЗаполнено(НомерПартии) И ДлинаНомера < ФорматПартии.МинимальнаяДлина);
	Результат.Вставить("ДлинаБольшеДопустимой", ДлинаНомера > ФорматПартии.МаксимальнаяДлина);
	Результат.Вставить("ЕстьНедопустимыеСимволы", Не СтрокаСодержитТолькоДопустимыеСимволы(НомерПартии, ФорматПартии.ДопустимыеСимволы));
	
	Если Не ЗначениеЗаполнено(НомерПартии)
		Или Результат.ДлинаМеньшеДопустимой
		Или Результат.ДлинаБольшеДопустимой
		Или Результат.ЕстьНедопустимыеСимволы Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураНомераПартии_Заполнить_GTIN(Результат, ФорматПартии);
	СтруктураНомераПартии_Заполнить_ДатаПроизводства(Результат, ФорматПартии);
	СтруктураНомераПартии_Заполнить_СерийныйНомер(Результат, ФорматПартии);
	
	Возврат Результат;
	
КонецФункции

Функция ФорматНомераПартии()
	
	КлючКэш = "ФорматНомераПартии";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДлинаGTIN = 14;
	ДлинаДатаПроизводства = 6;
	МинимальнаяДлина = 21;
	МаксимальнаяДлина = 32;
	ДопустимыеСимволы = ВсеБуквыЛатиницы() + ВсеЦифры() + "/.,-";
	
	Результат = Новый Структура;
	Результат.Вставить("ДлинаGTIN", ДлинаGTIN);
	Результат.Вставить("ДлинаДатаПроизводства", ДлинаДатаПроизводства);
	Результат.Вставить("МинимальнаяДлина", МинимальнаяДлина);
	Результат.Вставить("МаксимальнаяДлина", МаксимальнаяДлина);
	Результат.Вставить("ДопустимыеСимволы", ДопустимыеСимволы);
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура СтруктураНомераПартии_Заполнить_GTIN(СтруктураНомера, ФорматПартии)
	
	GTIN = Лев(СтруктураНомера.НомерПартии, ФорматПартии.ДлинаGTIN);
	
	Если ВСтрокеТолькоЦифры(GTIN) Тогда
		СтруктураНомера.GTIN = GTIN;
	Иначе
		СтруктураНомера.НекорректныйGTIN = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура СтруктураНомераПартии_Заполнить_ДатаПроизводства(СтруктураНомера, ФорматПартии)
	
	ПозицияДатаПроизводства = ФорматПартии.ДлинаGTIN + 1;
	ДатаПроизводстваСтрокой = Сред(СтруктураНомера.НомерПартии, ПозицияДатаПроизводства, ФорматПартии.ДлинаДатаПроизводства);
	
	Если Не ЗначениеЗаполнено(ДатаПроизводстваСтрокой) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ВСтрокеТолькоЦифры(ДатаПроизводстваСтрокой) Тогда
		СтруктураНомера.НекорректнаяДатаПроизводства = Истина;
		Возврат;
	КонецЕсли;
	
	ПозицияГода = 1;
	ПозицияМесяца = 3;
	ПозицияДня = 5;
	ДлинаНомера = 2;
	
	НомерГода = ЧислоИзСтроки(Сред(ДатаПроизводстваСтрокой, ПозицияГода, ДлинаНомера));
	НомерМесяца = ЧислоИзСтроки(Сред(ДатаПроизводстваСтрокой, ПозицияМесяца, ДлинаНомера));
	НомерДня = ЧислоИзСтроки(Сред(ДатаПроизводстваСтрокой, ПозицияДня, ДлинаНомера));
	
	Если ЗначениеЗаполнено(НомерГода) И ЗначениеЗаполнено(НомерМесяца) И ЗначениеЗаполнено(НомерДня) Тогда
		Попытка
			СтруктураНомера.ДатаПроизводства = Дата(НачалоВека() + НомерГода, НомерМесяца, НомерДня);
		Исключение
			СтруктураНомера.НекорректнаяДатаПроизводства = Истина;
		КонецПопытки;
	Иначе
		СтруктураНомера.НекорректнаяДатаПроизводства = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура СтруктураНомераПартии_Заполнить_СерийныйНомер(СтруктураНомера, ФорматПартии)
	
	ПозицияСерийныйНомер = ФорматПартии.ДлинаGTIN + ФорматПартии.ДлинаДатаПроизводства + 1;
	
	СтруктураНомера.СерийныйНомер = Сред(СтруктураНомера.НомерПартии, ПозицияСерийныйНомер);
	
КонецПроцедуры

// #КонецОбласти // ПроверкаЗаполненияОперации

// #Область ОбязательныеРеквизитыОпераций

Функция Операция_ОбязательныеРеквизиты_ЗаказКодов(ОписаниеОперации)
	
	Результат = Новый_ОбязательныеРеквизитыОперации();
	
	ПоляШапки = Результат.ПоляШапки;
	ПоляТоваров = Результат.ПоляТоваров;
	
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	
	ПоляШапки.Добавить("Организация");
	ПоляШапки.Добавить("Склад");
	ПоляШапки.Добавить("ВидПродукции");
	ПоляШапки.Добавить("СпособВыпускаТоваров");
	ПоляШапки.Добавить("ТипКодаМаркировки");
	
	ПоляТоваров.Добавить("Товар");
	ПоляТоваров.Добавить("КоличествоУпаковок");
	
	СпособВыпускаТоваров = ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров;
	
	Если СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка Тогда
		ПоляТоваров.Добавить("КодТНВЭД");
	КонецЕсли;
	
	Если ВидПродукцииТребуетТипОплатыКодов(ОписаниеОперации.ВидПродукции) Тогда
		ПоляШапки.Добавить("ТипОплатыКодов");
	КонецЕсли;
	
	Если (СпособВыпускаТоваров = СпособыВыпуска.Остатки
		Или СпособВыпускаТоваров = СпособыВыпуска.Перемаркировка)
		И ОписаниеОперации.ДопРеквизиты.КарточкиТоваровПринадлежатДругойОрганизации Тогда
		ПоляШапки.Добавить("СобственникТовараИНН");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Операция_ОбязательныеРеквизиты_ОтчетОНанесении(ОписаниеОперации)
	
