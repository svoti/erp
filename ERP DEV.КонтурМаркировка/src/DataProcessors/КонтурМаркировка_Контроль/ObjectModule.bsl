Функция ДопустимыеВидыКорректируемыхСведенийОКодах(ВидПродукции) Экспорт
	
	ФичаФлаги = Перечисление_ФичаФлаги();
	ВидыПродукции = Перечисление_ВидыПродукции();
	ВидыКорректируемыхСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Если ЗначениеЗаполнено(ВидПродукции) Тогда
		
		Результат = Новый Массив;
		Отбор = Новый Структура("ВидПродукции, Доступно", ВидПродукции, Истина);
		Для Каждого Стр Из ДопустимыеВидыКорректируемыхСведенийПоВидамПродукции().НайтиСтроки(Отбор) Цикл
			Результат.Добавить(Стр.ВидКорректируемыхСведений);
		КонецЦикла;
		
		Если ВидПродукции = ВидыПродукции.Молоко
			И Не ФичаФлагВключен(ФичаФлаги.КорректировкаНомерПартииМолоко) Тогда
			УдалитьЗначениеИзМассива(Результат, ВидыКорректируемыхСведений.НомерПартии);
		КонецЕсли;
		
	Иначе
		Результат = МассивЗначенийИзСтруктуры(ВидыКорректируемыхСведений);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДопустимыеВидыКорректируемыхСведенийПоВидамПродукции()
	
	КлючКэш = "ДопустимыеВидыКорректируемыхСведенийПоВидамПродукции";
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	ВидыСведений = Перечисление_ВидыКорректируемыхСведений();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидПродукции", ОписаниеТипа_ВидПродукции());
	Результат.Колонки.Добавить("ВидКорректируемыхСведений", ОписаниеТипа_Строка());
	Результат.Колонки.Добавить("Доступно", ОписаниеТипа_Булево());
	
	СтрокаВидаКорректируемыхСведений = 1;
	КолонкаВидаПродукции = 1;
	
	ТабДок = МакетОбработки("ВидыКорректируемыхСведений");
	
	Для Строка = 2 По ТабДок.ВысотаТаблицы Цикл
		
		ВидПродукцииСтр = СокрЛП(ТабДок.ПолучитьОбласть(Строка, КолонкаВидаПродукции).Область().Текст);
		
		Для Колонка = 2 По ТабДок.ШиринаТаблицы Цикл
			
			ВидСведенийСтр = СокрЛП(ТабДок.ПолучитьОбласть(СтрокаВидаКорректируемыхСведений, Колонка).Область().Текст);
			
			Стр = Результат.Добавить();
			Стр.ВидПродукции = ВидыПродукции[ВидПродукцииСтр];
			Стр.ВидКорректируемыхСведений = ВидыСведений[ВидСведенийСтр];
			
			Значение = СокрЛП(ТабДок.ПолучитьОбласть(Строка, Колонка).Область().Текст);
			
			Если Значение = "+" Тогда
				Стр.Доступно = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.Индексы.Добавить("ВидПродукции, Доступно");
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

