Функция УдалитьНедопустимыеСимволыXML(Строка)
	
	Результат = Строка(Строка);
	
	Пока Истина Цикл
		Поз = НайтиНедопустимыеСимволыXML(Результат);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат = Лев(Результат, Поз - 1) + Сред(Результат, Поз + 1);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КаноническийИдентификаторИзСтроки(Строка)
	
	Если Не ЗначениеЗаполнено(Строка)  Тогда
		Возврат СтрокаПустогоИдентификатора();
	КонецЕсли;
	
	ЗначимаяЧастьСтроки = СтрЗаменить(Строка, "-", "");
	ДлинаИдентификатора = 36;
	
	// BSLLS:MagicNumber-off
	Блок1 = Сред(ЗначимаяЧастьСтроки, 1, 8);
	Блок2 = Сред(ЗначимаяЧастьСтроки, 9, 4);
	Блок3 = Сред(ЗначимаяЧастьСтроки, 13, 4);
	Блок4 = Сред(ЗначимаяЧастьСтроки, 17, 4);
	Блок5 = Сред(ЗначимаяЧастьСтроки, 21, 12);
	// BSLLS:MagicNumber-on
	
	Результат = ПараметрыВСтроку("%1-%2-%3-%4-%5", Блок1, Блок2, Блок3, Блок4, Блок5);
	
	ЗначимаяЧастьРезультата = СтрЗаменить(Результат, "-", "");
	
	Если СтрДлина(Результат) < ДлинаИдентификатора Или ЗначимаяЧастьРезультата <> ЗначимаяЧастьСтроки Тогда
		ВызватьИсключение ПараметрыВСтроку(НСтр(
		"ru = 'Не удалось сформировать канонический идентификатор из строки: %1'"), Строка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВСтрокеТолькоЦифры(Строка)
	
	ДлинаСтроки = СтрДлина(Строка);
	
	Если ДлинаСтроки = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Результат = Истина;
	
	КодСимвола0 = КодСимвола("0");
	КодСимвола9 = КодСимвола("9");
	
	Для Сч = 1 По ДлинаСтроки Цикл
		
		КодСимвола = КодСимвола(Строка, Сч);
		
		Если КодСимвола < КодСимвола0
			Или КодСимвола > КодСимвола9 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаСодержитТолькоДопустимыеСимволы(Строка, ДопустимыеСимволы) Экспорт
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		ТекущийСимвол = НРег(Сред(Строка, Позиция, 1));
		Если Найти(ДопустимыеСимволы, ТекущийСимвол) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ДлинаДробнойЧасти(Число) Экспорт
	
	ДробнаяЧасть = Число - Цел(Число);
	
	Если Не ЗначениеЗаполнено(ДробнаяЧасть) Тогда
		Возврат 0;
	КонецЕсли;
	
	НольИЗапятая = 2;
	
	Возврат СтрДлина(ДробнаяЧасть) - НольИЗапятая;
	
КонецФункции

