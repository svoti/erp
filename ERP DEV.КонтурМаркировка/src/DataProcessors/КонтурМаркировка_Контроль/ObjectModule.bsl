	Для Каждого Стр Из КлассификаторСтран().НайтиСтроки(Отбор) Цикл
		Результат.Добавить(Стр.Код);
	КонецЦикла;
	
	УдалитьЗначениеИзМассива(Результат, "643");
	
	Возврат Результат;
	
КонецФункции

