Процедура Операция_ПроверитьСуммуНДС(ОписаниеОперации, ОшибкиЗаполнения)
	
	НеОблагаетсяНДС = ОписаниеОперации.ДопРеквизиты.НеОблагаетсяНДС;
	ТребуетсяСуммаНДС = ВидПродукцииТребуетСуммуНДСПриВводеВОборот(ОписаниеОперации.ВидПродукции);
	
	Для Каждого Стр Из ОписаниеОперации.Товары Цикл
		
		Если ЗначениеЗаполнено(Стр.СуммаНДС) И Стр.СуммаНДС >= Стр.Цена Тогда
			Ошибка = Новый_ОшибкаЗаполнения("СуммаНДС", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Сумма НДС должна быть меньше цены'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если ТребуетсяСуммаНДС И НеОблагаетсяНДС = Ложь И Не ЗначениеЗаполнено(Стр.СуммаНДС) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("СуммаНДС", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Необходимо заполнить сумму НДС'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьИННСобственникаТоваров(ОписаниеОперации, ОшибкиЗаполнения)
	
	ПроизводительИНН = ОписаниеОперации.ДопРеквизиты.ПроизводительИНН;
	СобственникТовараИНН = ОписаниеОперации.ДопРеквизиты.СобственникТовараИНН;
	
	Если Не ЗначениеЗаполнено(СобственникТовараИНН) Тогда
		Возврат;
	КонецЕсли;
	
	Если СобственникТовараИНН = ПроизводительИНН Тогда
		Ошибка = Новый_ОшибкаЗаполнения("СобственникТовараИНН");
		Ошибка.ТекстОшибки = НСтр("ru = 'Собственник товара (ИНН) и Производитель (ИНН) не могут быть одинаковыми'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
	Для каждого Стр Из ОписаниеОперации.Товары Цикл
		Если ЗначениеЗаполнено(Стр.Товар.ВладелецКарточкиТовара)
			И Стр.Товар.ВладелецКарточкиТовара.ИНН <> СобственникТовараИНН Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", Стр.НомерСтроки);
			Ошибка.ТекстОшибки = НСтр("ru = 'Собственник товара (ИНН) отличается от указанного в шапке'");
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Операция_ПроверитьДатуИмпорта(ОписаниеОперации, ОшибкиЗаполнения)
	
	МинимальноеКоличествоМесяцев = 60;
	МаксимальноеКоличествоМесяцев = 12;
	
	МинимальнаяДатаИмпорта = ДобавитьМесяц(ТекущаяДата(), -МинимальноеКоличествоМесяцев);
	МаксимальнаяДатаИмпорта = ДобавитьМесяц(ТекущаяДата(), МаксимальноеКоличествоМесяцев);
	ДатаИмпорта = ОписаниеОперации.ДопРеквизиты.ДатаИмпорта;
	
	Если ДатаИмпорта < МинимальнаяДатаИмпорта Или ДатаИмпорта > МаксимальнаяДатаИмпорта Тогда
		Ошибка = Новый_ОшибкаЗаполнения("ДатаИмпорта");
		Ошибка.ТекстОшибки = НСтр("ru = 'Указана некорректная дата импорта'");
		ОшибкиЗаполнения.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Операция_ПроверитьВидПервичногоДокументаДляВыводаИзОборота(ОписаниеОперации, ОшибкиЗаполнения)
	
