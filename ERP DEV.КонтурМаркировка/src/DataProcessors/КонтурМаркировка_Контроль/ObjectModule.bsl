Функция ДопустимыеТипыКодовМаркировки(СпособВыпускаТоваров, ВидПродукции) Экспорт
	
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	Результат = Новый Массив;
	Результат.Добавить(ТипыКодовМаркировки.ЕдиницаТовара);
	
	Если СпособВыпускаТоваров <> СпособыВыпуска.МаркировкаВнеПроизводстваИлиИмпорта
		И ДопустимыеВидыПродукцииДляЗаказаКомплектов().Найти(ВидПродукции) <> Неопределено Тогда
		Результат.Добавить(ТипыКодовМаркировки.Комплект);
	КонецЕсли;
	
	Если СпособВыпускаТоваров <> СпособыВыпуска.МаркировкаВнеПроизводстваИлиИмпорта
		И ДопустимыеВидыПродукцииДляЗаказаНаборов().Найти(ВидПродукции) <> Неопределено Тогда
		Результат.Добавить(ТипыКодовМаркировки.Набор);
	КонецЕсли;
	
	Если СпособВыпускаТоваров <> СпособыВыпуска.Перемаркировка
		И СпособВыпускаТоваров <> СпособыВыпуска.МаркировкаВнеПроизводстваИлиИмпорта
		И ДопустимыеВидыПродукцииДляЗаказаКИГУ().Найти(ВидПродукции) <> Неопределено Тогда
		Результат.Добавить(ТипыКодовМаркировки.ГрупповаяУпаковка);
	КонецЕсли;
	
