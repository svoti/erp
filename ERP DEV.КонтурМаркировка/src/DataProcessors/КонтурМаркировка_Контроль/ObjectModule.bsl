Функция ДопустимыеВидыПервичногоДокумента(ПричинаВыводаИзОборота) Экспорт
	
	ПричиныВывода = Перечисление_ПричиныВыводаИзОборота();
	ВидыДокументов = Перечисление_ВидыПервичныхДокументов();
	
	Результат = Новый Массив;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.РозничнаяПродажа Тогда
		Результат.Добавить(ВидыДокументов.КассовыйЧек);
		Результат.Добавить(ВидыДокументов.ТоварныйЧек);
	КонецЕсли;
		
	Если ПричинаВыводаИзОборота = ПричиныВывода.ПродажаПоОбразцам
		Или ПричинаВыводаИзОборота = ПричиныВывода.ДистанционныйСпособПродажи Тогда
		Результат.Добавить(ВидыДокументов.УПД);
		Результат.Добавить(ВидыДокументов.КассовыйЧек);
		Результат.Добавить(ВидыДокументов.ТоварныйЧек);
		Результат.Добавить(ВидыДокументов.ТоварнаяНакладная);
	КонецЕсли;
		
	Если ПричинаВыводаИзОборота = ПричиныВывода.Конфискация Тогда
		Результат.Добавить(ВидыДокументов.УПД);
		Результат.Добавить(ВидыДокументов.ТоварнаяНакладная);
	КонецЕсли;
		
	Если ПричинаВыводаИзОборота = ПричиныВывода.Уничтожение Тогда
		Результат.Добавить(ВидыДокументов.АктУничтожения);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ЭкспортЗаПределыЕАЭС Тогда
		Результат.Добавить(ВидыДокументов.ТаможеннаяДекларация);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.БезвозмезднаяПередача Тогда
		Результат.Добавить(ВидыДокументов.ТоварнаяНакладная);
	КонецЕсли;
	
	Если ПричинаВыводаИзОборота = ПричиныВывода.ДляПроизводственныхЦелей Тогда
		Результат.Добавить(ВидыДокументов.ЭлектронныйCертификат);
		Результат.Добавить(ВидыДокументов.АкПротезноОртопедическогоИзделия);
	КонецЕсли;
	
	ИсключенияДляВидаПрочее = Новый Массив;
	ИсключенияДляВидаПрочее.Добавить(ПричиныВывода.ЭкспортЕАЭС);
	ИсключенияДляВидаПрочее.Добавить(ПричиныВывода.ПродажаПоГосКонтракту);
	ИсключенияДляВидаПрочее.Добавить(ПричиныВывода.ПродажаПоСделкеСГосударственнойТайной);
	Если Не МассивСодержитЗначение(ИсключенияДляВидаПрочее, ПричинаВыводаИзОборота) Тогда
		Результат.Добавить(ВидыДокументов.Прочее);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

