Функция ПричинаВыводаИзОборотаТребуетКПППлощадки(ПричинаВыводаИзОборота, ВидПродукции, ИНН)
	
	ДопустимыеПричины = Новый Массив;
	
	ПричиныВыводаИзОборота = Перечисление_ПричиныВыводаИзОборота();
	ВидыПродукции = Перечисление_ВидыПродукции();
	ФичаФлаги = Перечисление_ФичаФлаги();
	
	Если Не ЭтоИП(ИНН) Тогда
		
		Если ЭтоНикотиносодержащаяПродукция(ВидПродукции) Тогда
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.ЭкспортЕАЭС);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.ЭкспортЗаПределыЕАЭС);
		КонецЕсли;
		
		Если ВидПродукции = ВидыПродукции.Пиво Тогда
			
			Для Каждого КлючЗначение Из ПричиныВыводаИзОборота Цикл
				Если КлючЗначение.Значение = ПричиныВыводаИзОборота.ПродажаПоГосКонтракту Тогда
					Продолжить;
				КонецЕсли;
				ДопустимыеПричины.Добавить(КлючЗначение.Значение);
			КонецЦикла;
			
		КонецЕсли;
		
		Если ВидПродукции = ВидыПродукции.Ветпрепараты
			И ФичаФлагВключен(ФичаФлаги.ВыводИзОборотаВетпрепаратыУказаниеМОД) Тогда
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.БезвозмезднаяПередача);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.Прочее);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.ИспользованиеДляВетеринарногоПрименения);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.ДляПроизводственныхЦелей);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.ДляСобственныхНужд);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.ИстечениеСрокаГодности);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.Конфискация);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.Уничтожение);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.Утилизация);
			ДопустимыеПричины.Добавить(ПричиныВыводаИзОборота.Утрата);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат МассивСодержитЗначение(ДопустимыеПричины, ПричинаВыводаИзОборота);
	
КонецФункции

Функция ПричинаВыводаИзОборотаТребуетФИАСПлощадки(ПричинаВыводаИзОборота, ВидПродукции, ИНН)
	
	ПричиныВыводаИзОборота = Перечисление_ПричиныВыводаИзОборота();
	ДопустимыеПричины = Новый Массив;
	
