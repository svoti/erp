// #Область // ФичаФлаги

// Проверяет что фича-флаг включен
//
// Параметры:
//  ФичаФлаг - Строка - см. Перечисление_ФичаФлаги();
// 
// Возвращаемое значение:
//  Булево - Истина, если фича-флаг включен
//
Функция ФичаФлагВключен(ФичаФлаг) Экспорт
	
	КлючКэш = "ФичаФлагВключен: " + ФичаФлаг;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ФичаФлагиВключения = Перечисление_ФичаФлагиВключения();
	ФичаФлагиОтключения = Перечисление_ФичаФлагиОтключения();
	
	Результат = Ложь;
	
	Если ЕстьЗначениеВСтруктуре(ФичаФлагиВключения, ФичаФлаг) Тогда
		Результат = ОтложеннуюФункциюМожноИспользовать(ФичаФлаг);
	КонецЕсли;
	
	Если ЕстьЗначениеВСтруктуре(ФичаФлагиОтключения, ФичаФлаг) Тогда
		Результат = Не ВременнуюФункциюНужноОтключить(ФичаФлаг);
	КонецЕсли;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Добавляет или удаляет значение в массиве в зависимости от того включен фича-флаг или выключен
//
// Параметры:
//  Массив   - Массив - массив значений;
//  Значение - Произвольный - значение, которое нужно добавить или удалить в массиве;
//  ФичаФлаг - Строка - см. Перечисление_ФичаФлаги();
//
Процедура ИзменитьМассивПоФичаФлагу(Массив, Значение, ФичаФлаг) Экспорт
	
	Если ФичаФлагВключен(ФичаФлаг) Тогда
		ДобавитьЗначениеВМассив(Массив, Значение);
	Иначе
		УдалитьЗначениеИзМассива(Массив, Значение);
	КонецЕсли;
	
КонецПроцедуры

Функция ВременнуюФункциюНужноОтключить(ИмяФункции) Экспорт
	
	ДатаОтключения = СвойствоСтруктуры(СписокВременныхФункций().ДатыОтключения, ИмяФункции, '00010101');
	
	Возврат (ТекущаяДатаСеанса() >= ДатаОтключения);
	
КонецФункции

Функция ОтложеннуюФункциюМожноИспользовать(ИмяФункции) Экспорт
	
	ДатаВключения = СвойствоСтруктуры(СписокОтложенныхФункций().ДатыВключения, ИмяФункции, '00010101');
	
	Возврат (ТекущаяДатаСеанса() >= ДатаВключения);
	
