Функция ДокументУчета_ПроверитьЗаполнениеПолей(ОписаниеДокумента) Экспорт
	
	Результат = Новый Массив;
	
	ОбновитьТребуемоеДействие = Ложь;
	Отбор = Новый Структура("КлючСтрокиДокумента");
	Для Каждого СтрДок Из ОписаниеДокумента.ТоварыДокумента Цикл
		
		Если СтрДок.НеПодлежитМаркировке Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрДок.КоличествоУпаковок) Тогда
			
			КоличествоПодобрано = 0;
			Отбор.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
			Для Каждого СтрТов Из ОписаниеДокумента.ТоварыМаркировки.НайтиСтроки(Отбор) Цикл
				КоличествоПодобрано = КоличествоПодобрано + СтрТов.КоличествоУпаковок;
			КонецЦикла;
			
			Если СтрДок.КоличествоУпаковок <> КоличествоПодобрано Тогда
				ТекстОшибки = НСтр("ru = 'Не подобран товар маркировки для номенклатуры %1'");
				Ошибка = Новый_ОшибкаЗаполнения("Номенклатура", "ТоварыДокумента", СтрДок.НомерСтроки);
				Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СтрДок.Номенклатура);
				Результат.Добавить(Ошибка);
				ОбновитьТребуемоеДействие = Истина;
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(СтрДок.Количество) Тогда
				ТекстОшибки = НСтр("ru = 'Не указано количество упаковок для номенклатуры %1'");
				Ошибка = Новый_ОшибкаЗаполнения("КоличествоУпаковок", "ТоварыДокумента", СтрДок.НомерСтроки);
				Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, СтрДок.Номенклатура);
				Результат.Добавить(Ошибка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Склад = ОписаниеДокумента.Склад;
	Организация = ОписаниеДокумента.Организация;
	СкладЗаполнен = ЗначениеЗаполнено(Склад);
	ОрганизацияЗаполнена = ЗначениеЗаполнено(Организация);
	
	Если Не ОрганизацияЗаполнена Тогда
		Ошибка = Новый_ОшибкаЗаполнения("Организация");
		Ошибка.ТекстОшибки = НСтр("ru = 'Не указана организация!'");
		Результат.Добавить(Ошибка);
	КонецЕсли;
	
	Если Не СкладЗаполнен Тогда
		Ошибка = Новый_ОшибкаЗаполнения("Склад");
		Ошибка.ТекстОшибки = НСтр("ru = 'Не указан склад!'");
		Результат.Добавить(Ошибка);
	КонецЕсли;
	
	Если ОрганизацияЗаполнена И СкладЗаполнен И Склад.Организация <> Организация Тогда
		Ошибка = Новый_ОшибкаЗаполнения("Склад");
		ТекстОшибки = НСтр("ru = 'Выбранный склад принадлежит другой организации: %1'");
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Склад.Организация);
		Результат.Добавить(Ошибка);
	КонецЕсли;
	
	Если ДокументУчета_ЕстьРольКорректировкаОтгрузки(ОписаниеДокумента) Тогда
		Если Не ЗначениеЗаполнено(ОписаниеДокумента.ДопРеквизиты.ВидКорректировки) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("ВидКорректировки");
			Ошибка.ТекстОшибки = НСтр("ru = 'Укажите вид корректировки'");
			Результат.Добавить(Ошибка);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОписаниеДокумента.ДопРеквизиты.ИсправляемыйДокумент) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("ИсправляемыйДокумент");
			Ошибка.ТекстОшибки = НСтр("ru = 'Укажите исправляемый документ'");
			Результат.Добавить(Ошибка);
		КонецЕсли;
	КонецЕсли;
	
	Если ОбновитьТребуемоеДействие Тогда
		МодульМаркировки().ДокументУчета_ОбновитьТребуемоеДействие(ОписаниеДокумента.Ссылка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ПроверитьТоварыМаркировки(ОписаниеДокумента) Экспорт
	
	Результат = Новый Массив;
	
	ЭтоВнутреннееПеремещение = ДокументУчета_ТипуДокументаДоступнаРоль(
	ОписаниеДокумента.ТипДокумента, Перечисление_РолиДокументовУчета().ВнутреннееПеремещение);
	ОСУРазрешенАнтисептикиГруппаПлатности1 = ФичаФлагВключен(Перечисление_ФичаФлаги().ПравилоОтраженияОСУАнтисептикиВолна0);
	
	ПараметрыПроверки = Новый_ПараметрыПроверкиТоваровДокумента();
	ПараметрыПроверки.РолиДоступенПартионныйУчет = МодульМаркировки().ДокументУчета_ЕстьРолиДляПартионногоУчета(ОписаниеДокумента.Ссылка);
	ПараметрыПроверки.ЭтоВнутреннееПеремещение = ЭтоВнутреннееПеремещение;
	ПараметрыПроверки.ОСУРазрешенАнтисептикиГруппаПлатности1 = ОСУРазрешенАнтисептикиГруппаПлатности1;
	
	
	КэшТоваров = Новый Соответствие;
	Отбор = Новый Структура("КлючСтрокиДокумента");
	Для Каждого СтрДок Из ОписаниеДокумента.ТоварыДокумента Цикл
		Отбор.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		ТоварыСтроки = ОписаниеДокумента.ТоварыМаркировки.НайтиСтроки(Отбор);
		ОшибкиСтроки = ДокументУчета_ПроверитьСтрокуТовара(СтрДок, ТоварыСтроки, ПараметрыПроверки, КэшТоваров);
		ДополнитьМассив(Результат, ОшибкиСтроки);
	КонецЦикла;
	
	ОшибкиПроверкиФорматаНомераПартии = ДокументУчета_ПроверитьФорматНомераПартии(ОписаниеДокумента);
	ДополнитьМассив(Результат, ОшибкиПроверкиФорматаНомераПартии, Истина, Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ПроверитьСтрокуТовара(СтрокаДокумента, ТоварыСтроки, ПараметрыПроверки, КэшТоваров)
	
	// BSLLS:CognitiveComplexity-off
	ПравилаОтраженияВЭДО = Перечисление_ПравилаОтраженияВЭДО();
	
	Результат = Новый Массив;
	
	ОшибкиНеРазрешенОСУ = Новый Массив;
	ОшибкиНеРазрешенПартионныйУчет = Новый Массив;
	ОшибкиНеДоступноВнутреннееПеремещение = Новый Массив;
	ОшибкиНеЗаполненНомерПартии = Новый Массив;
	ОшибкиНеЗаполненВесПартии = Новый Массив;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	Для Каждого Стр Из ТоварыСтроки Цикл
		
		ОписаниеТовара = Товар_Прочитать(Стр.Товар, КэшТоваров);
		ВидПродукции = ОписаниеТовара.ВидПродукции;
		GTIN = ОписаниеТовара.GTIN;
		
		Если СтрокаДокумента.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ОСУ Тогда
			
			Если Не ВидПродукцииДопускаетОСУ(ВидПродукции) Тогда
				ОшибкиНеРазрешенОСУ.Добавить(GTIN);
			КонецЕсли;
			
			Если Не Товар_ПоддерживаетОСУВДокументе(ОписаниеТовара, ПараметрыПроверки) Тогда
				ОшибкиНеРазрешенОСУ.Добавить(GTIN);
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаДокумента.ОтражениеВЭДО = ПравилаОтраженияВЭДО.ПартионныйУчет
			И ПараметрыПроверки.РолиДоступенПартионныйУчет Тогда
			
			Если Не ВидПродукцииПоддерживаетПартионныйУчет(ВидПродукции) Тогда
				ОшибкиНеРазрешенПартионныйУчет.Добавить(GTIN);
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.НомерПартии) Тогда
				ОшибкиНеЗаполненНомерПартии.Добавить(GTIN);
			КонецЕсли;
			
			Если Стр.Товар.ПеременныйВес И Не ЗначениеЗаполнено(Стр.Количество) Тогда
				ОшибкиНеЗаполненВесПартии.Добавить(GTIN);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПараметрыПроверки.ЭтоВнутреннееПеремещение
			И Не ВидПродукцииДопускаетВнутреннееПеремещение(ВидПродукции) Тогда
			ОшибкиНеДоступноВнутреннееПеремещение.Добавить(ВидПродукции);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОшибкиНеРазрешенОСУ) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("Номенклатура", "ТоварыДокумента", СтрокаДокумента.НомерСтроки);
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения_НеРазрешенОСУ()
		, СоединитьСтроку(ОшибкиНеРазрешенОСУ, ", "));
		Результат.Добавить(Ошибка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОшибкиНеРазрешенПартионныйУчет) Тогда
		Ошибка = Новый_ОшибкаЗаполнения("Номенклатура", "ТоварыДокумента", СтрокаДокумента.НомерСтроки);
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения_НеРазрешенПартионныйУчет()
		, СоединитьСтроку(ОшибкиНеРазрешенПартионныйУчет, ", "));
		Результат.Добавить(Ошибка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОшибкиНеДоступноВнутреннееПеремещение) Тогда
		СвернутьМассивЛок(ОшибкиНеДоступноВнутреннееПеремещение);
		Ошибка = Новый_ОшибкаЗаполнения("Номенклатура", "ТоварыДокумента", СтрокаДокумента.НомерСтроки);
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения_ОшибкаВнутреннееПеремещение()
		, СоединитьСтроку(ОшибкиНеДоступноВнутреннееПеремещение, ", "));
		Результат.Добавить(Ошибка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОшибкиНеЗаполненНомерПартии) Тогда
		СвернутьМассивЛок(ОшибкиНеЗаполненНомерПартии);
		Ошибка = Новый_ОшибкаЗаполнения("Номенклатура", "ТоварыДокумента", СтрокаДокумента.НомерСтроки);
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения_НеЗаполненНомерПартии()
		, СоединитьСтроку(ОшибкиНеЗаполненНомерПартии, ", "));
		Результат.Добавить(Ошибка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОшибкиНеЗаполненВесПартии) Тогда
		СвернутьМассивЛок(ОшибкиНеЗаполненВесПартии);
		Ошибка = Новый_ОшибкаЗаполнения("Номенклатура", "ТоварыДокумента", СтрокаДокумента.НомерСтроки);
		Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстСообщения_НеЗаполненВесПартии()
		, СоединитьСтроку(ОшибкиНеЗаполненВесПартии, ", "));
		Результат.Добавить(Ошибка);
	КонецЕсли;
	
	Возврат Результат;
	
	// BSLLS:CognitiveComplexity-on
	
КонецФункции

Функция ДокументУчета_ЕстьРольКорректировкаОтгрузки(ДокументУчетаИлиОписание) Экспорт
	
	ТипДокумента = ДокументУчетаИлиОписание.ТипДокумента;
	РольКорректировка = Перечисление_РолиДокументовУчета().КорректировкаОтгрузки;
	
	Возврат ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, РольКорректировка);
	
КонецФункции

Функция ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, Роль) Экспорт
	
	КлючКэш = "ТипуДокументаДоступнаРоль: " + ТипДокумента + ", " + Роль;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = МодульМаркировки().ДокументУчета_ТипуДокументаДоступнаРоль(ТипДокумента, Роль);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументУчета_ПроверитьНедопустимыеАнтисептикиОСУ(ОписаниеДокумента) Экспорт
	
	ОтборКлючСтроки = Новый Структура("КлючСтрокиДокумента");
	ОтборОСУ = Новый Структура("ОтражениеВЭДО", Перечисление_ПравилаОтраженияВЭДО().ОСУ);
	Ошибка = НСтр("ru='Для антисептиков передача кодов в УПД в объемно-сортовом учете допустима только для товаров, введенных в оборот до 01.09.2025'");
	
	Для Каждого СтрДок Из ОписаниеДокумента.ТоварыДокумента.НайтиСтроки(ОтборОСУ) Цикл
		ОтборКлючСтроки.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		Для Каждого СтрТов Из ОписаниеДокумента.ТоварыМаркировки.НайтиСтроки(ОтборКлючСтроки) Цикл
			Если ЭтоТоварАнтисептикиГруппаПлатности1(СтрТов.Товар) Тогда
				Возврат Ошибка;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ДокументУчета_ПроверитьФорматНомераПартии(ОписаниеДокумента) Экспорт
	
	ОшибкиЗаполнения = Новый Массив;
	
	ФорматПартии = ФорматНомераПартии();
	ПравилаОтражения = Перечисление_ПравилаОтраженияВЭДО();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	ДопустимыеВидыПродукции = ДопустимыеВидыПродукцииДляПартионногоУчета();
	ДопустимыеТипыКодов = ДопустимыеТипыКодовМаркировкиДляПартионногоУчета();
	
	ТекстОшибкиДлинаБольшеДопустимой = НСтр("ru = 'Длина номера партии не должна превышать %1 символов'");
	ТекстОшибкиДлинаБольшеДопустимой = ПараметрыВСтроку(ТекстОшибкиДлинаБольшеДопустимой, ФорматПартии.МаксимальнаяДлина);
	
	ТекстОшибкиДлинаМеньшеДопустимой = НСтр("ru = 'Длина номера партии не должна быть меньше %1 символов'");
	ТекстОшибкиДлинаМеньшеДопустимой = ПараметрыВСтроку(ТекстОшибкиДлинаМеньшеДопустимой, ФорматПартии.МинимальнаяДлина);
	
	ТекстОшибкиЕстьНедопустимыеСимволы = НСтр("ru = 'Номер партии содержит недопустимые символы'");
	
	ТекстОшибкиНекорректныйGTIN = НСтр("ru = 'В номере партии указан некорректный GTIN'");
	ТекстОшибкиНеСоответствуетGTIN = НСтр("ru = 'GTIN в номере партии не соответствует товару'");
	
	ТекстОшибкиНекорректнаяДатаПроизвод = НСтр("ru = 'В номере партии указана некорректная дата производства'");
	
	Для Каждого СтрТов Из ОписаниеДокумента.ТоварыМаркировки Цикл
		
		Если Не ЗначениеЗаполнено(СтрТов.Товар)
			Или Не ЗначениеЗаполнено(СтрТов.НомерПартии) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрДок = ОписаниеДокумента.ТоварыДокумента.Найти(СтрТов.КлючСтрокиДокумента, "КлючСтрокиДокумента");
		Если СтрДок = Неопределено Или СтрДок.ОтражениеВЭДО <> ПравилаОтражения.ПартионныйУчет Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не МассивСодержитЗначение(ДопустимыеТипыКодов, СтрТов.Товар.ТипКодаМаркировки)
			Или Не МассивСодержитЗначение(ДопустимыеВидыПродукции, СтрТов.Товар.ВидПродукции) Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоКИГУ = (ЗначениеЗаполнено(СтрТов.Товар) И СтрТов.Товар.ТипКодаМаркировки = ТипыКодовМаркировки.ГрупповаяУпаковка);
		НомерСтроки = СтрДок.НомерСтроки;
		СтруктураПартии = СтруктураНомераПартии(СтрТов.НомерПартии);
		
		Если СтруктураПартии.ДлинаБольшеДопустимой Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "ТоварыМаркировки", НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиДлинаБольшеДопустимой;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если СтруктураПартии.ДлинаМеньшеДопустимой Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "ТоварыМаркировки", НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиДлинаМеньшеДопустимой;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если СтруктураПартии.ЕстьНедопустимыеСимволы Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "ТоварыМаркировки", НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиЕстьНедопустимыеСимволы;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если СтруктураПартии.НекорректнаяДатаПроизводства Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "ТоварыМаркировки", НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиНекорректнаяДатаПроизвод;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если СтруктураПартии.НекорректныйGTIN Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "ТоварыМаркировки", НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиНекорректныйGTIN;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если Не ЭтоКИГУ И ЗначениеЗаполнено(СтруктураПартии.GTIN) И СтрТов.Товар.GTIN <> СтруктураПартии.GTIN Тогда
			Ошибка = Новый_ОшибкаЗаполнения("НомерПартии", "ТоварыМаркировки", НомерСтроки);
			Ошибка.ТекстОшибки = ТекстОшибкиНеСоответствуетGTIN;
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОшибкиЗаполнения;
	
КонецФункции

Функция ДокументУчета_ПроверитьТоварыПодлежатПартионномуУчету(ОписаниеДокумента) Экспорт
	
	Результат = "";
	
	РолиДокументов = Перечисление_РолиДокументовУчета();
	Если Не ДокументУчета_ТипуДокументаДоступнаРоль(ОписаниеДокумента.ТипДокумента, РолиДокументов.Отгрузка)
		И Не ДокументУчета_ТипуДокументаДоступнаРоль(ОписаниеДокумента.ТипДокумента, РолиДокументов.КорректировкаОтгрузки) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОтборКлючСтроки = Новый Структура("КлючСтрокиДокумента");
	ОтборОСУ = Новый Структура("ОтражениеВЭДО", Перечисление_ПравилаОтраженияВЭДО().ОСУ);
	
	Для Каждого СтрДок Из ОписаниеДокумента.ТоварыДокумента.НайтиСтроки(ОтборОСУ) Цикл
		ОтборКлючСтроки.КлючСтрокиДокумента = СтрДок.КлючСтрокиДокумента;
		Для Каждого СтрТов Из ОписаниеДокумента.ТоварыМаркировки.НайтиСтроки(ОтборКлючСтроки) Цикл
			Если ТоварПодлежитПартионномуУчету(СтрТов.Товар) Тогда
				Результат = ТекстПодсказки_ТоварПодлежитПартионномуУчету(СтрТов.Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ПараметрыПроверкиТоваровДокумента() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЭтоВнутреннееПеремещение", Ложь);
	Результат.Вставить("РолиДоступенПартионныйУчет", Ложь);
	Результат.Вставить("ОСУРазрешенАнтисептикиГруппаПлатности1", Ложь);
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ПроверкаЗаполненияДокументаУчета

// #Область ПроверкиОпераций

// Проверяет, что указанные типы являются либо служебными, либо интерактивными
//
// Параметры:
//  СписокОпераций - ТаблицаЗначений - колонки:
//   * ТипОперации - Строка - см. функцию Перечисление_ТипыОпераций();
//   * Операция    - СправочникСсылка.КонтурМаркировка_Операции - операция;
//
Процедура Операции_ПроверитьЧтоВсеИзвестны(СписокОпераций) Экспорт
	
	СлужебныеТипы = ТипыСлужебныхОпераций();
	ИнтерактивныеТипы = ТипыИнтерактивныхОпераций();
	
	Для Каждого Стр Из СписокОпераций Цикл
		Если Не МассивСодержитЗначение(СлужебныеТипы, Стр.ТипОперации)
			И Не МассивСодержитЗначение(ИнтерактивныеТипы, Стр.ТипОперации) Тогда
			ТекстОшибки = НСтр("ru = 'Обнаружен неизвестный тип операции: %1'");
			ВызватьИсключение ПараметрыВСтроку(ТекстОшибки, Стр.Операция);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, что все операции в списке завершены
//
// Параметры:
//  СписокОпераций - ТаблицаЗначений - колонки:
//   * Статус - Строка - см. функцию Перечисление_СтатусыОпераций();
//   * Операция - СправочникСсылка.КонтурМаркировка_Операции - операция;
//
Процедура Операции_ПроверитьЧтоВсеЗавершены(СписокОпераций) Экспорт
	
	ЗавершенныеСтатусы = ЗавершенныеСтатусыОпераций();
	
	Для Каждого Стр Из СписокОпераций Цикл
		Если Не МассивСодержитЗначение(ЗавершенныеСтатусы, Стр.Статус) Тогда
			ТекстОшибки = НСтр("ru = 'Обнаружена незавершенная операция: %1'");
			ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, Стр.Операция);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти

// #Область ПроверкаЗаполненияОперации

Функция Операция_Проверить(ОписаниеОперации) Экспорт
	
	Результат = Новый Массив;
	
	Операция_Проверить_ЗаказКодов(ОписаниеОперации, Результат);
	Операция_Проверить_ПечатьКодов(ОписаниеОперации, Результат);
	Операция_Проверить_ОтчетОНанесении(ОписаниеОперации, Результат);
	Операция_Проверить_ВводВОборот(ОписаниеОперации, Результат);
	Операция_Проверить_ВыводИзОборота(ОписаниеОперации, Результат);
	Операция_Проверить_ВозвратВОборот(ОписаниеОперации, Результат);
	Операция_Проверить_Перемаркировка(ОписаниеОперации, Результат);
	Операция_Проверить_РегистрацияНаборов(ОписаниеОперации, Результат);
	Операция_Проверить_НаполнениеНаборовНаТСД(ОписаниеОперации, Результат);
	Операция_Проверить_НаполнениеАгрегатовНаТСД(ОписаниеОперации, Результат);
	Операция_Проверить_РегистрацияАгрегатов(ОписаниеОперации, Результат);
	Операция_Проверить_ТрансформацияАгрегатов(ОписаниеОперации, Результат);
	Операция_Проверить_РасформированиеАгрегатов(ОписаниеОперации, Результат);
	Операция_Проверить_ФормированиеАТК(ОписаниеОперации, Результат);
	Операция_Проверить_ТрансформацияАТК(ОписаниеОперации, Результат);
	Операция_Проверить_РасформированиеАТК(ОписаниеОперации, Результат);
	Операция_Проверить_КорректировкаСведенийОКодах(ОписаниеОперации, Результат);
	Операция_Проверить_ОтчетОВыбытии(ОписаниеОперации, Результат);
	Операция_Проверить_ФормированиеКИГУ(ОписаниеОперации, Результат);
	Операция_Проверить_НаполнениеКИГУНаТСД(ОписаниеОперации, Результат);
	Операция_Проверить_РегистрацияКИГУ(ОписаниеОперации, Результат);
	Операция_Проверить_СообщениеОбОтгрузке(ОписаниеОперации, Результат);
	Операция_Проверить_ПодборКодовНаТСД(ОписаниеОперации, Результат);
	Операция_Проверить_УведомлениеОСостоянииКодов(ОписаниеОперации, Результат);
	Операция_Проверить_РезервированиеПартий(ОписаниеОперации, Результат);
	
	Операция_ПроверитьВидПродукцииДляОперацийАгрегации(ОписаниеОперации, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура Операция_Проверить_ЗаказКодов(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().ЗаказКодов Тогда
		Возврат;
	КонецЕсли;
	
	ВидыПродукции = Перечисление_ВидыПродукции();
	СпособыВыпуска = Перечисление_СпособыВыпускаТоваров();
	ТипыКодовМаркировки = Перечисление_ТипыКодовМаркировки();
	
	Если ЗначениеЗаполнено(ОписаниеОперации.ДопРеквизиты.СервисПровайдер) Тогда
		Операция_ПроверитьВидПродукцииСервисПровайдера(ОписаниеОперации, ОшибкиЗаполнения);
	Иначе
		Операция_ПроверитьВидПродукцииДляЗаказаКодов(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Операция_ПроверитьТипЗаказаКодов(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьТипКодаМаркировкиВШапкеИВТоварах(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьСпособВыпускаТоваров(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьТипКодаМаркировки(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьТипОплатыКодов(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьДопустимоеКоличествоУпаковокВЗаказе(ОписаниеОперации, ОшибкиЗаполнения);
	
	Если ОписаниеОперации.ВидПродукции = ВидыПродукции.Легпром
		И ОписаниеОперации.ДопРеквизиты.СпособВыпускаТоваров = СпособыВыпуска.Остатки
		И ОписаниеОперации.ДопРеквизиты.ТипКодаМаркировки <> ТипыКодовМаркировки.Набор Тогда
		Операция_ПроверитьТоварыЛегпрома_Остатки(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизиты_ЗаказКодов(ОписаниеОперации);
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	Операция_ПроверитьОбязательныеРеквизитыТоваров(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_ПечатьКодов(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().ПечатьКодов Тогда
		Возврат;
	КонецЕсли;
	
	ОбязательныеРеквизиты = Новый_ОбязательныеРеквизитыОперации();
	ОбязательныеРеквизиты.ПоляШапки.Добавить("Организация");
	
	Если ОписаниеОперации.ДопРеквизиты.ПечататьТоварныеЭтикетки Тогда
		ОбязательныеРеквизиты.ПоляШапки.Добавить("ШаблонТоварнойЭтикетки");
	КонецЕсли;
	Если ОписаниеОперации.ДопРеквизиты.ПечататьГрупповыеЭтикетки Тогда
		ОбязательныеРеквизиты.ПоляШапки.Добавить("ШаблонГрупповойЭтикетки");
	КонецЕсли;
	Если ОписаниеОперации.ДопРеквизиты.ПечататьЭтикеткиНаборов Тогда
		ОбязательныеРеквизиты.ПоляШапки.Добавить("ШаблонЭтикеткиНабора");
	КонецЕсли;
	Если ОписаниеОперации.ДопРеквизиты.ПечататьТранспортныеЭтикетки Тогда
		ОбязательныеРеквизиты.ПоляШапки.Добавить("ШаблонТранспортнойЭтикетки");
	КонецЕсли;
	
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_ОтчетОНанесении(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если Не ЭтоОтчетОНанесении(ОписаниеОперации.ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидПродукцииТребуетУказанияКоличестваВОтчетеОНанесении(ОписаниеОперации.ВидПродукции, ОписаниеОперации.ДопРеквизиты.ТипОтчетаОНанесении) Тогда
		
		Если ОписаниеОперации.ДопРеквизиты.ИспользоватьНоминальноеКоличество Тогда
			Операция_ПроверитьНоминальноеКоличествоВТоварах(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
		
		Операция_ПроверитьКоличествоВТоварахОперации(ОписаниеОперации, ОшибкиЗаполнения);
		
	КонецЕсли;
	
	Операция_ПроверитьТипОтчетаОНанесении(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьВидПродукцииДляОтчетаОНанесении(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьДатуСрокаГодности(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьДатуПроизводства(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьАльтернативныеСрокиГодности(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьСодержаниеСпирта(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьДатуИНомерПервичногоДокумента(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьНомерСерии(ОписаниеОперации, ОшибкиЗаполнения);
	
	Если ВидПродукцииТребуетУказатьНомерПартииИлиНомерСерииИлиЗСН(ОписаниеОперации.ВидПродукции) Тогда
		Операция_ПроверитьНомерПартииИНомерСерииИЗаводскиеСерийныеНомера(ОписаниеОперации, ОшибкиЗаполнения);
	Иначе
		Если ВидПродукцииПоддерживаетПартионныйУчет(ОписаниеОперации.ВидПродукции) Тогда
			Операция_ПроверитьНомерПартии(ОписаниеОперации, ОшибкиЗаполнения);
			Операция_ПроверитьФорматНомераПартии_ПартионныйУчет(ОписаниеОперации, ОшибкиЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизиты_ОтчетОНанесении(ОписаниеОперации);
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	Операция_ПроверитьОбязательныеРеквизитыТоваров(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_Перемаркировка(ОписаниеОперации, ОшибкиЗаполнения)
	
	ТипыОпераций = Перечисление_ТипыОпераций();
	
	Если ОписаниеОперации.ТипОперации <> ТипыОпераций.Перемаркировка Тогда
		Возврат;
	КонецЕсли;
	
	Операция_ПроверитьНаличиеКодовМаркировки(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьРазрешительныйДокумент(ОписаниеОперации, ОшибкиЗаполнения);
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизиты_Перемаркировка();
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_РегистрацияНаборов(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().РегистрацияНаборов Тогда
		Возврат;
	КонецЕсли;
	
	Операция_ПроверитьВидПродукцииДляРегистрацииНаборов(ОписаниеОперации, ОшибкиЗаполнения);
	
	Если ВидПродукцииДопускаетВариативныеНаборы(ОписаниеОперации.ВидПродукции) Тогда
		Операция_ПроверитьКоличествоВложенийДляРегистрацииВариативныхНаборов(ОписаниеОперации, ОшибкиЗаполнения);
	Иначе
		Операция_ПроверитьКоличествоВложенийДляРегистрацииНаборов(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Если ОписаниеОперации.ДопРеквизиты.ТипНабора = Перечисление_ТипыНаборов().Мультитоварный Тогда
		Операция_ПроверитьВложенияРегистрацииМультитоварныхНаборов(ОписаниеОперации, ОшибкиЗаполнения);
	КонецЕсли;
	
	Операция_ПроверитьНомерПартии(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьФорматНомераПартии_ПартионныйУчет(ОписаниеОперации, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_НаполнениеНаборовНаТСД(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().НаполнениеНаборовНаТСД Тогда
		Возврат;
	КонецЕсли;
	
	Операция_ПроверитьНомерПартии(ОписаниеОперации, ОшибкиЗаполнения);
	Операция_ПроверитьФорматНомераПартии_ПартионныйУчет(ОписаниеОперации, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура Операция_Проверить_РегистрацияКИГУ(ОписаниеОперации, ОшибкиЗаполнения)
	
	Если ОписаниеОперации.ТипОперации <> Перечисление_ТипыОпераций().РегистрацияКИГУ Тогда
		Возврат;
	КонецЕсли;
	
	Операция_ПроверитьВидПродукцииДляРегистрацииКИГУ(ОписаниеОперации.ВидПродукции, ОшибкиЗаполнения);
	
	ТекстОшибкиКоличество = НСтр("ru = 'Количество кодов не соответствует составу групповой упаковки:
	|%1'");
	
	ТекстОшибкиНомерПартии = НСтр("ru = 'Различаются номера партий кодов, входящих в групповую упаковку:
	|%1'");
	
	ДоступенПартионныйУчет = ВидПродукцииПоддерживаетПартионныйУчет(ОписаниеОперации.ВидПродукции);
	
	КэшТоваров = Новый Соответствие;
	МодульМаркировки = МодульМаркировки();
	
	Для Каждого СтрТовара Из ОписаниеОперации.Товары Цикл
		
		ТаблицаКодов = МодульМаркировки.КодыОпераций_Прочитать(ОписаниеОперации.Ссылка, СтрТовара.КлючСтрокиОперации);
		МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		ТаблицаКИГУ = ТаблицаКодов.Скопировать(, "КлючКода, КодМаркировки, НомерПартии");
		
		МодульМаркировки.ТаблицаКодов_ДобавитьКлючиВложенныхКодов(ТаблицаКодов);
		МодульМаркировки.ТаблицаКодов_ПрочитатьВсюИнформацию(ТаблицаКодов);
		
		ТаблицаКодов.Индексы.Добавить("КлючАгрегата, НомерПартии");
		
		Товар = Товар_Прочитать(СтрТовара.Товар, КэшТоваров);
		КоличествоВложений = Товар.КоличествоВложений;
		
		КодыСОшибкамиКоличество = Новый Массив;
		КодыСОшибкамиНомерПартии = Новый Массив;
		Для Каждого СтрКИГУ Из ТаблицаКИГУ Цикл
			
			ВложенныеКоды = ТаблицаКодов.НайтиСтроки(Новый Структура("КлючАгрегата", СтрКИГУ.КлючКода));
			
			Если ВложенныеКоды.Количество() <> КоличествоВложений Тогда
				КодыСОшибкамиКоличество.Добавить(СтрКИГУ.КодМаркировки);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВложенныеКоды) Тогда
				
				ОтборПоПартии = Новый Структура("КлючАгрегата, НомерПартии", СтрКИГУ.КлючКода, ВложенныеКоды[0].НомерПартии);
				ВложенныеКодыПартии = ТаблицаКодов.НайтиСтроки(ОтборПоПартии);
				
				Если ВложенныеКоды.Количество() <> ВложенныеКодыПартии.Количество() Тогда
					КодыСОшибкамиНомерПартии.Добавить(СтрКИГУ.КодМаркировки);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(КодыСОшибкамиКоличество) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибкиКоличество, СписокКодовДляТекстаОшибки(КодыСОшибкамиКоличество));
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодыСОшибкамиНомерПартии) Тогда
			Ошибка = Новый_ОшибкаЗаполнения("Товар", "Товары", СтрТовара.НомерСтроки);
			Ошибка.ТекстОшибки = ПараметрыВСтроку(ТекстОшибкиНомерПартии, СписокКодовДляТекстаОшибки(КодыСОшибкамиНомерПартии));
			ОшибкиЗаполнения.Добавить(Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбязательныеРеквизиты = Операция_ОбязательныеРеквизитыРегистрацииКИГУ();
	Операция_ПроверитьОбязательныеРеквизитыШапки(ОписаниеОперации, ОбязательныеРеквизиты, ОшибкиЗаполнения);
	
КонецПроцедуры

