Функция Товар_ПоддерживаетОСУВДокументе(ОписаниеТовара, ПараметрыПроверки) Экспорт
	
	Результат = Истина;
	
	ВидПродукции = ОписаниеТовара.ВидПродукции;
	ВидыПродукции = Перечисление_ВидыПродукции();
	
	Если ВидПродукции = ВидыПродукции.Пиво Тогда
		Результат = ПараметрыПроверки.ЭтоВнутреннееПеремещение;
	КонецЕсли;
	
	Если ВидПродукции = ВидыПродукции.Антисептики Тогда
		Результат = Товар_ПоддерживаетОСУАнтисептики(ОписаниеТовара, ПараметрыПроверки.ОСУРазрешенАнтисептикиГруппаПлатности1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Товар_ПоддерживаетОСУАнтисептики(ОписаниеТовара, ОСУРазрешенАнтисептикиГруппаПлатности1)
	
	Результат = Ложь;
	
	ГруппаПлатности_1 = 1;
	ГруппаПлатности_2 = 2;
	
	ГруппаПлатности_1_ПоддерживаетОСУ = ОписаниеТовара.ДопРеквизиты.ГруппаПлатности = ГруппаПлатности_1
	И ОСУРазрешенАнтисептикиГруппаПлатности1;
	ГруппаПлатности_2_ПоддерживаетОСУ = ОписаниеТовара.ДопРеквизиты.ГруппаПлатности = ГруппаПлатности_2
	И ФичаФлагВключен(Перечисление_ФичаФлаги().ПравилоОтраженияОСУАнтисептикиВолна1);
	
	Если ГруппаПлатности_1_ПоддерживаетОСУ Или ГруппаПлатности_2_ПоддерживаетОСУ Тогда
		
		ОтражениеВЭДО = МодульМаркировки().МаркируемыеТоварныеГруппы_ОтражениеВЭДО(ОписаниеТовара.ВидПродукции);
		
		Результат = (ЗначениеЗаполнено(ОтражениеВЭДО)
		И ОтражениеВЭДО = Перечисление_ПравилаОтраженияВЭДО().ОСУ)
		Или Не ЗначениеЗаполнено(ОтражениеВЭДО);
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

