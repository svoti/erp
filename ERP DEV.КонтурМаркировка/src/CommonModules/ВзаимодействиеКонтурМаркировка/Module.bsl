#Если Сервер Или ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Признак "Клиент (управляемое приложение)" и инструкция препроцессора установлены
// для поддержки толстого клиента в управляемом приложении в режиме клиент-сервер
// Смотрите п.2 в статье ИТС https://its.1c.ru/db/v8std#content:680:hdoc

// Возвращает версию модуля маркировки
// 
// Возвращаемое значение:
//  Строка
//
Функция ВерсияМодуля() Экспорт
	
	ОтключитьИнициализацию = Истина;
	Возврат МодульМаркировки(ОтключитьИнициализацию).ВерсияОбработки();
	
КонецФункции

// Создает объект обработки Контур.Маркировка
//
// Параметры:
//  ОтключитьИнициализацию - Булево - (необязательный) Истина, если инициализацию модуля выполнять не нужно;
//  ИдентификаторСеанса - УникальныйИдентификатор - (необязательный) идентификатор сеанса маркировки;
// 
// Возвращаемое значение:
//  ОбработкаОбъект - модуль маркировки
//
Функция МодульМаркировки(ОтключитьИнициализацию = Ложь, Знач ИдентификаторСеанса = Неопределено) Экспорт
	
	Если ИдентификаторСеанса = Неопределено Тогда
		ИдентификаторСеанса = ОбщегоНазначенияКонтурМаркировка.ПрочитатьПараметрСессииМаркировки("ИдентификаторСеанса");
		Если Не ЗначениеЗаполнено(ИдентификаторСеанса) И Не ОтключитьИнициализацию Тогда
			ИдентификаторСеанса = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЕсли;
	
	КлючКэш = Строка(ИдентификаторСеанса);
	КэшОбработки = ВзаимодействиеКонтурМаркировкаПовтИсп.МодульМаркировки(КлючКэш);
	
	Если КэшОбработки.ОбъектОбработки = Неопределено Тогда
		
		НомерЭкземпляра = ОбщегоНазначенияКонтурМаркировка.ПрочитатьПараметрСессииМаркировки("НомерЭкземпляраМодуля", 0);
		КлючКэш = Строка(ИдентификаторСеанса) + "_" + НомерЭкземпляра;
		КэшОбработки = ВзаимодействиеКонтурМаркировкаПовтИсп.МодульМаркировки(КлючКэш);
		
		Если КэшОбработки.ОбъектОбработки = Неопределено Тогда
			НомерЭкземпляра = НомерЭкземпляра + 1;
			КлючКэш = Строка(ИдентификаторСеанса) + "_" + НомерЭкземпляра;
			КэшОбработки = ВзаимодействиеКонтурМаркировкаПовтИсп.МодульМаркировки(КлючКэш);
			ОбщегоНазначенияКонтурМаркировка.ПоместитьПараметрСессииМаркировки("НомерЭкземпляраМодуля", НомерЭкземпляра);
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = КэшОбработки.ОбъектОбработки;
	
	Если Не ОтключитьИнициализацию
		И Не Результат.МодульИнициализирован(ИдентификаторСеанса) Тогда
		Результат.Инициализировать(ИдентификаторСеанса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти // ПрограммныйИнтерфейс

// #Область СлужебныйПрограммныйИнтерфейс

// Выполняет команду обработки без использования БСП, используется для вызова в фоновом задании
//
// Параметры:
//  ПараметрыКоманды - Структура - обязательно содержит:
//   * ИдентификаторКоманды - идентификатор команды;
//  ОписаниеОбработки - Структура - (необязательный) содержит:
//   * ПутьКФайлу - Строка - путь к файлу обработки;
//   * ИмяОбработки - Строка - имя, с которым нужно подключить обработку;
//   * ДвоичныеДанные - ДвоичныеДанные - двоичные данные обработки;
//   * ПутьКФайлуМодуля - Строка - (необязательный) путь к файлу модуля маркировки;
//  АдресРезультата - Строка - (необязательный) адрес из временного хранилища,
//                                              куда нужно поместить результат;
//
Процедура ВыполнитьЗадание(ПараметрыКоманды, ОписаниеОбработки = Неопределено, АдресРезультата = "") Экспорт
	
	Модуль = ОбщегоНазначенияКонтурМаркировка.СоздатьОбработкуМаркировкиПоОписанию(ОписаниеОбработки);
	
	Если Не ПараметрыКоманды.Свойство("РезультатВыполнения") Тогда
		ПараметрыКоманды.Вставить("РезультатВыполнения", Новый Структура);
	КонецЕсли;
	
	Модуль.ВыполнитьКоманду(ПараметрыКоманды.ИдентификаторКоманды, ПараметрыКоманды);
	
	Если ЗначениеЗаполнено(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(ПараметрыКоманды.РезультатВыполнения, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

// Вызывает в ПМ событие ВыполнитьРегламентныеДействия, используется в регламентном задании
//
// Параметры:
//  ДопПараметры - Структура - (необязательный) будут переданы в ПМ;
//  ОписаниеОбработки - Структура - (необязательный) содержит:
//   * ПутьКФайлу - Строка - путь к файлу обработки;
//   * ИмяОбработки - Строка - имя, с которым нужно подключить обработку;
//   * ДвоичныеДанные - ДвоичныеДанные - двоичные данные обработки;
//   * ПутьКФайлуМодуля - Строка - (необязательный) путь к файлу модуля маркировки;
//
Процедура ВыполнитьРегламентныеДействия(ДопПараметры = Неопределено, ОписаниеОбработки = Неопределено) Экспорт
	
	Модуль = ОбщегоНазначенияКонтурМаркировка.СоздатьОбработкуМаркировкиПоОписанию(ОписаниеОбработки);
	ИдентификаторКоманды = Модуль.Перечисление_КомандыОбработки().ВыполнитьРегламентныеДействия;
	
	Модуль.ВыполнитьКоманду(ИдентификаторКоманды, ДопПараметры);
	
КонецПроцедуры

